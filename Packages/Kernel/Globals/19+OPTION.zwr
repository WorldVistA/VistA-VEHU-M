^DIC(19,10927,0)="ORCM ACTIONS^Enter/edit actions^^R^11712^^^^^^^"
^DIC(19,10927,1,0)="^^2^2^2981104^"
^DIC(19,10927,1,1,0)="This option lets you create or change actions that may be placed on Add"
^DIC(19,10927,1,2,0)="Orders menus."
^DIC(19,10927,25)="ACTION^ORCMEDT3"
^DIC(19,10927,"U")="ENTER/EDIT ACTIONS"
^DIC(19,10928,0)="ORCM SEARCH/REPLACE^Search/replace components^^R^11712^^^^^^^"
^DIC(19,10928,1,0)="^^4^4^2981104^^"
^DIC(19,10928,1,1,0)="This option lets you search for specific components on menus"
^DIC(19,10928,1,2,0)="and replace or delete one or more instances of these components."
^DIC(19,10928,1,3,0)="Components include: quick orders, order sets, prompts, protocols,"
^DIC(19,10928,1,4,0)="actions, etc."
^DIC(19,10928,25)="SEARCH^ORCMEDT5"
^DIC(19,10928,"U")="SEARCH/REPLACE COMPONENTS"
^DIC(19,10929,0)="AJK1UB XMIT ACTIVITY^Collections Transmission (Auto)^^R^11600^^^^^^^"
^DIC(19,10929,1,0)="^^6^6^2980818^^^^"
^DIC(19,10929,1,1,0)="This option should be queued to run automatically every night.  It will"
^DIC(19,10929,1,2,0)="search thru file 430 for new activity which means the criteria for being"
^DIC(19,10929,1,3,0)="collectable.  Additionally, any open collectable bills will be checked"
^DIC(19,10929,1,4,0)="against the AR Transaction file for status changes and these will be"
^DIC(19,10929,1,5,0)="transmitted as well.  Site parameters for this option are located in the"
^DIC(19,10929,1,6,0)="AR SITE PARAMETER file."
^DIC(19,10929,25)="AJK1UBT"
^DIC(19,10929,200.9)="y"
^DIC(19,10929,"U")="COLLECTIONS TRANSMISSION (AUTO"
^DIC(19,10930,0)="AJK1UB PARAMETER ENTER/EDIT^Parameter Enter/Edit^^R^11600^^^^^^^"
^DIC(19,10930,1,0)="^^3^3^2971107^"
^DIC(19,10930,1,1,0)="This option is used to update the parameters for the collections module."
^DIC(19,10930,1,2,0)="Such things as the Client Number, which mailgroups receive alerts, who do"
^DIC(19,10930,1,3,0)="we transmit to, etc., are defined with this option."
^DIC(19,10930,25)="AJK1UBCP"
^DIC(19,10930,"U")="PARAMETER ENTER/EDIT"
^DIC(19,10931,0)="AJK1UB TRANSACTION EDIT^Update Transaction Type Status^^R^11600^^^^^^^^^1"
^DIC(19,10931,1,0)="^^5^5^2971107^"
^DIC(19,10931,1,1,0)="This option is used to update the collection transmission status for the"
^DIC(19,10931,1,2,0)="Accounts Receivable Transaction Types.  For whichever transaction types"
^DIC(19,10931,1,3,0)="are to be reported to the collection agency when their status changes"
^DIC(19,10931,1,4,0)="enter the collection status.  If a status is NOT to be transmitted this"
^DIC(19,10931,1,5,0)="field, which is edited through this option, should be left blank."
^DIC(19,10931,20)="S X=$$TRANS^AJK1UBDP(1)"
^DIC(19,10931,25)="TRANS^AJK1UBM"
^DIC(19,10931,"U")="UPDATE TRANSACTION TYPE STATUS"
^DIC(19,10932,0)="AJK1UB FLAG CATEGORY^Flag Category for Collection^^R^11600^^^^^^^^^1"
^DIC(19,10932,1,0)="^^4^4^2971107^"
^DIC(19,10932,1,1,0)="This option is used to flag Account Receivable Categories as being"
^DIC(19,10932,1,2,0)="collectable.  When the flag is turned on, and other search criteria"
^DIC(19,10932,1,3,0)="defined using the Parameter Enter/Edit option are met, only bills flagged"
^DIC(19,10932,1,4,0)="as being ""collectable"" will be included in the transmission process."
^DIC(19,10932,20)="S X=$$CAT^AJK1UBDP(1)"
^DIC(19,10932,25)="CAT^AJK1UBM"
^DIC(19,10932,"U")="FLAG CATEGORY FOR COLLECTION"
^DIC(19,10933,0)="AJK1UB SUPERVISOR MENU^Collection Supervisor Menu^^M^11600^AJK1UB SUPERVISOR^^^^^^"
^DIC(19,10933,1,0)="^^4^4^2990514^^^^"
^DIC(19,10933,1,1,0)="This menu contains those options associated with the collections process"
^DIC(19,10933,1,2,0)="which are determined to be supervisory in nature.  Such options include"
^DIC(19,10933,1,3,0)="those which are used to update parameters associated with the collection"
^DIC(19,10933,1,4,0)="process."
^DIC(19,10933,10,0)="^19.01IP^11^9"
^DIC(19,10933,10,1,0)=10932
