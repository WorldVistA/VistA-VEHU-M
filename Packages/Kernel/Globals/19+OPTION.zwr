^DIC(19,10301,1,0)="^^4^4^2960328^"
^DIC(19,10301,1,1,0)="This option enables the Purchasing Agent to set the status of the"
^DIC(19,10301,1,2,0)="RFQ to 'CLOSED'.  If the RFQ has been transmitted electronically,"
^DIC(19,10301,1,3,0)="this option also sends an 864 Message Text transaction informing"
^DIC(19,10301,1,4,0)="vendors that the RFQ is now closed."
^DIC(19,10301,20)="S:'$$ESIG^PRCHQ1(DUZ) XQUIT="""""
