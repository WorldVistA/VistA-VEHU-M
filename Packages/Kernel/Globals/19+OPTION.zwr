^DIC(19,11313,0)="LR LOINC HL7 SPECIMENS^Specimen HL7 Codes Print^^R^10000000020^^^^^^^26"
^DIC(19,11313,1,0)="^^5^5^2990301^^^^"
^DIC(19,11313,1,1,0)="This option allows you to print a list of SPECIMENS you can use to"
^DIC(19,11313,1,2,0)="enter LEDI HL7 specimens codes in the LAB TOPOGRAPHY FIELD (#61) file."
^DIC(19,11313,1,3,0)=" "
^DIC(19,11313,1,4,0)="Those specimens preceded by a '*' indicate that the origin of these"
^DIC(19,11313,1,5,0)="specimens is from HL7 V2.3 Specimen source codes table 0070."
^DIC(19,11313,25)="LRLNCHL7"
^DIC(19,11313,"U")="SPECIMEN HL7 CODES PRINT"
^DIC(19,11314,0)="PRCHOUT BOC REPORT^BOC Report for OA&MM/Fiscal^^P^11740^^^^^^^121"
^DIC(19,11314,1,0)="^^3^3^2990106^^"
^DIC(19,11314,1,1,0)="This report will allow users to specify a date and name range to print any"
^DIC(19,11314,1,2,0)="Purchase Card transactions which include BOC numbers 2696 to 2699. It is"
^DIC(19,11314,1,3,0)="used by OA&MM/Fiscal to perform Supply Funds reconciliation."
^DIC(19,11314,60)="PRCH(440.6,"
^DIC(19,11314,62)=0
^DIC(19,11314,63)="[PRCH BOC PRINT]"
^DIC(19,11314,64)="[PRCH BOC SORT]"
