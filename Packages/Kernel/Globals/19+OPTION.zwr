^DIC(19,16116,"U")="BUILD HEALTH SUMMARY TYPE MENU"
^DIC(19,16117,0)="EHM-00938^Print Health Summary Menu^^M^1^^^^^^^160^^^^"
^DIC(19,16117,1,0)="^^6^6^3240328^"
^DIC(19,16117,1,1,0)="This menu includes all of the various print options available for Health"
^DIC(19,16117,1,2,0)="Summaries, allowing the user to generate Health Summaries by Patient, by"
^DIC(19,16117,1,3,0)="Patient and a date range, by patient and a outpatient visit or an"
^DIC(19,16117,1,4,0)="admission, by Location, for patients at all clinics, and on an Ad Hoc"
^DIC(19,16117,1,5,0)="basis."
^DIC(19,16117,1,6,0)="Cloned from ""GMTS HS MENU"" option."
^DIC(19,16117,3)=""
^DIC(19,16117,10,0)="^19.01IP^6^6"
^DIC(19,16117,10,1,0)="16118^1^1"
^DIC(19,16117,10,2,0)="16119^5^5"
^DIC(19,16117,10,3,0)="16120^2^2"
^DIC(19,16117,10,4,0)="16121^4^4"
^DIC(19,16117,10,5,0)="16122^6^6"
^DIC(19,16117,10,6,0)="16123^3^3"
