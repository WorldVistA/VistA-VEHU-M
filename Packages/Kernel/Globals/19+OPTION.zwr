^DIC(19,5275,"U")="DISPLAY EXISTING EQUIPMENT REC"
^DIC(19,5276,0)="ECTC STATUS^Construction Project Status^^R^.5^^^^^^^189^^1"
^DIC(19,5276,1,0)="^^2^2^2900928^"
^DIC(19,5276,1,1,0)="This option generates a hardcopy 10-0051 for a specific construction"
^DIC(19,5276,1,2,0)="project."
^DIC(19,5276,20)="S ECT1=""CONS"""
^DIC(19,5276,25)="ECTDIR"
^DIC(19,5276,"U")="CONSTRUCTION PROJECT STATUS"
^DIC(19,5277,0)="ECTC CONS PROJ^Construction Project Profiles^^R^.5^^^^^^^189"
^DIC(19,5277,1,0)="^^5^5^2900929^^^"
^DIC(19,5277,1,1,0)="This option displays brief data about construction projects.  The"
^DIC(19,5277,1,2,0)="user may choose the 'sort by' field.  The following fields are"
^DIC(19,5277,1,3,0)="shown for each project: project number, title, category, funding"
^DIC(19,5277,1,4,0)="year, approval level, amount authorized for construction at the time "
^DIC(19,5277,1,5,0)="the project is approved, status code, and construction method."
^DIC(19,5277,25)="ECTCPP"
^DIC(19,5277,"U")="CONSTRUCTION PROJECT PROFILES"
^DIC(19,5278,0)="ECTC PROJ LIST^List Construction Projects^^R^.5^^^^^^^189"
^DIC(19,5278,1,0)="^^3^3^2900929^"
^DIC(19,5278,1,1,0)="This option lists construction project numbers and titles from the"
^DIC(19,5278,1,2,0)="Construction Project file (#6925).  The user may choose the 'sort by'"
^DIC(19,5278,1,3,0)="field."
^DIC(19,5278,25)="ECTCLP"
^DIC(19,5278,"U")="LIST CONSTRUCTION PROJECTS"
^DIC(19,5279,0)="ECTA ROOM^Display/Edit Room Data^^R^.5^^^^^^^189^^1"
^DIC(19,5279,1,0)="^^2^2^2900929^^"
^DIC(19,5279,1,1,0)="This option will display space data using a screen server."
^DIC(19,5279,1,2,0)="The data is contained in the Engineering Space file (#6928)."
^DIC(19,5279,20)="S ECT1=""SPACE"""
^DIC(19,5279,25)="ECTDIR"
^DIC(19,5279,99)="55018,50063"
