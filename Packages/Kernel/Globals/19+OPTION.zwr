^DIC(19,14380,0)="RG TK POC USER SETUP^ToolKit POC User Setup^^R^1^^^^^^^"
^DIC(19,14380,1,0)="^^10^10^3141218^"
^DIC(19,14380,1,1,0)="This option allows you to create a Visitor Record in the New Person file "
^DIC(19,14380,1,2,0)="on the MPI production account.  The purpose of this action is to"
^DIC(19,14380,1,3,0)="accomplish the first step toward establishing your ToolKit POC remote view"
^DIC(19,14380,1,4,0)="access. Once this action is completed successfully you will have the"
^DIC(19,14380,1,5,0)="ability to use the new tools."
^DIC(19,14380,1,6,0)=" "
^DIC(19,14380,1,7,0)="Note: It is important that prior to using this option you be set up "
^DIC(19,14380,1,8,0)="correctly as a user in your local New Person file (#200).  You should"
^DIC(19,14380,1,9,0)="verify your record has the correct Name, SSN, Network Username and Phone"
^DIC(19,14380,1,10,0)="Contact Number."
^DIC(19,14380,25)="RGTKPOC"
^DIC(19,14380,"U")="TOOLKIT POC USER SETUP"
