^DIC(19,16566,0)="EHM-01387^PCE Code Mapping List^^P^1^^^^^^y^507^^^^"
^DIC(19,16566,1,0)="^^14^14^3240328^"
^DIC(19,16566,1,1,0)="This option allows the user to see the mapping between CPT codes"
^DIC(19,16566,1,2,0)="and a related entry in a PCE supporting file.  For example, the "
^DIC(19,16566,1,3,0)="CPT code 90732 is related to the Immunization file entry PNEUMOCCOCAL."
^DIC(19,16566,1,4,0)="  "
^DIC(19,16566,1,5,0)="PCE uses the code mapping relationships to populate multiple files from"
^DIC(19,16566,1,6,0)="one data entry step.  For example, an entry of PNEUMOCCOCAL in the V"
^DIC(19,16566,1,7,0)="Immunization file will also create a CPT entry, 90732 in the V CPT file"
^DIC(19,16566,1,8,0)="which will then be passed to PIMS for use by IB, Workload, and DSS."
^DIC(19,16566,1,9,0)=" "
^DIC(19,16566,1,10,0)="NOTE: As of patch PX*1.0*215, the PCE CODE MAPPING file (#811.1) has been "
^DIC(19,16566,1,11,0)="superseded. The mappings of immunizations and skin tests to CPT codes are"
^DIC(19,16566,1,12,0)="now contained in the CODING SYSTEM multiple of the IMMUNIZATION "
^DIC(19,16566,1,13,0)="(#9999999.14) and SKIN TEST (#9999999.28) files themselves."
^DIC(19,16566,1,14,0)="Cloned from ""PX PCE CODE MAPPING LIST"" option."
^DIC(19,16566,3)=""
^DIC(19,16566,60)="PXD(811.1,"
^DIC(19,16566,62)=0
^DIC(19,16566,63)="[PX CODE MAPPING PRINT]"
^DIC(19,16566,64)="[PX CODE MAPPING]"
^DIC(19,16566,"U")="PCE CODE MAPPING LIST"
