^DIC(19,13198,0)="SDWL WAIT TIME STATISTICS^EWL Wait Time Statistics^DO NOT USE!! - EWL DECOM - SD*5.3*769^P^1^^^^^^^16"
^DIC(19,13198,1,0)="^19.06^7^7^3061016^^^"
^DIC(19,13198,1,1,0)="This report provides a number of wait time statistics for each patient"
^DIC(19,13198,1,2,0)="listed in the report.  Stats include the number of days elapsed from"
^DIC(19,13198,1,3,0)="the Originating Date to the Scheduled Date of Appointment, from the "
^DIC(19,13198,1,4,0)="Originating Date to the Desired Date of Appointment, from the Scheduled"
^DIC(19,13198,1,5,0)="Date of Appointment to the Desired Date of Appointment, from the"
^DIC(19,13198,1,6,0)="Originating Date to the Date of Disposition, and from the Originating"
^DIC(19,13198,1,7,0)="Date to the actual Date the appointment was made."
