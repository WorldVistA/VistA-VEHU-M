^DIC(19,14524,1,3,0)="synonym."
^DIC(19,14524,25)="SCANNER^PSBMLTS"
^DIC(19,14524,"U")="BCMA DRUG IEN SYNONYM CHECK"
^DIC(19,14525,0)="DSIV NON-ICB IMPORT^DSIV Non-ICB Import^^R^1^^^^^^^"
^DIC(19,14525,1,0)="^^4^4^3140826^"
^DIC(19,14525,1,1,0)="Tasked process to run the DSS Inc ICB Non-ICB Import each night.  This "
^DIC(19,14525,1,2,0)="task sorts through the IB Buffer file for new entries which are not "
^DIC(19,14525,1,3,0)="created by ICB.  Entries not made by ICB will be added as a stub to the "
^DIC(19,14525,1,4,0)="ICB Audit file with a Non-ICB flag."
^DIC(19,14525,25)="N1^DSIVNICB"
^DIC(19,14525,200.9)="y"
^DIC(19,14525,"U")="DSIV NON-ICB IMPORT"
^DIC(19,14527,0)="RCTCSP STOP^Stop/Reactivate TCSP Referral ^^R^1^^^^^^^"
^DIC(19,14527,1,0)="^^2^2^3190325^"
^DIC(19,14527,1,1,0)="This option allows the user to stop or reactivate Cross-Servicing"
^DIC(19,14527,1,2,0)="referral(s) for either a Bill or for a Debtor."
^DIC(19,14527,25)="EN^RCTCS1"
^DIC(19,14527,"U")="STOP/REACTIVATE TCSP REFERRAL "
^DIC(19,14528,0)="RCTCSP RECALLB^Bill Recall/Reactivate TCSP Referral^^R^11720^^^^^^^"
^DIC(19,14528,1,0)="^19.06^3^3^3170308^^"
^DIC(19,14528,1,1,0)="This option is used to allow the user to recall a bill from Cross "
^DIC(19,14528,1,2,0)="Servicing.  It is also used to delete the recall if the recall has not "
^DIC(19,14528,1,3,0)="taken place."
^DIC(19,14528,25)="RCLLSETB^RCTCSPU"
^DIC(19,14528,"U")="BILL RECALL/REACTIVATE TCSP RE"
^DIC(19,14529,0)="RCTCSP RECALLD^Debtor Recall/Reactivate TCSP Referral^^R^11720^^^^^^^"
^DIC(19,14529,1,0)="^19.06^3^3^3170308^^^"
^DIC(19,14529,1,1,0)="This option is used to allow the user to recall a debtor and all of "
^DIC(19,14529,1,2,0)="the associated bills from Cross-Servicing.  It is also used to delete the"
^DIC(19,14529,1,3,0)="recall if the recall has not taken place."
^DIC(19,14529,25)="RCLLSETD^RCTCSPU"
^DIC(19,14529,"U")="DEBTOR RECALL/REACTIVATE TCSP "
