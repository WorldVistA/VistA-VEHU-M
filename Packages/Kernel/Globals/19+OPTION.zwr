^DIC(19,13568,0)="ECXTRYIT^Trial for Setup Extract^^R^10000000020^ECXMGR^^^^^^513^^1"
^DIC(19,13568,1,0)="^^5^5^2950418^^^^"
^DIC(19,13568,1,1,0)="This option uses the logic of the admission setup extract to generate"
^DIC(19,13568,1,2,0)="a printed report of the inpatient population on a selected day. This"
^DIC(19,13568,1,3,0)="report should be compared to reports from MAS to eliminate any"
^DIC(19,13568,1,4,0)="problems in the ADMISSION SETUP EXTRACT file (#727.82) used"
^DIC(19,13568,1,5,0)="to generate the admission setup extract."
^DIC(19,13568,20)="W !!!,""WARNING."",!,""This is very resource intensive and should be queued to run at slack time."",!!!"
