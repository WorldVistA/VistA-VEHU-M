^DIC(19,4593,0)="IB BACKGRND VETS INPT W/INS^Background Vet. Patients with Admissions and Ins^^R^.5^^^^^^^192"
^DIC(19,4593,1,0)="^^2^2^2940207^^^^"
^DIC(19,4593,1,1,0)="This option may be set to be queued once per week to run and generate "
