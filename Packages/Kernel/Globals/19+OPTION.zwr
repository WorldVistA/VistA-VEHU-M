^DIC(19,7393,10,"C",2,3)=""
^DIC(19,7393,10,"C",3,2)=""
^DIC(19,7393,99)="55770,49961"
^DIC(19,7393,"U")="PLANNING SPACE PROGRAM MENU"
^DIC(19,7394,0)="ENSP-PLAN2^Print Building/Project Space Plan ^^R^.5^^^^^^^"
^DIC(19,7394,1,0)="^^2^2^2930423^^^^"
^DIC(19,7394,1,1,0)="Option to print planning data based on building and criteria chapter."
^DIC(19,7394,1,2,0)="Report is sorted by PROJECT NUMBER."
^DIC(19,7394,25)="PP^ENSP6"
^DIC(19,7394,"U")="PRINT BUILDING/PROJECT SPACE P"
^DIC(19,7395,0)="ENSP-PLAN1^Enter/Edit Room Planning Data^^R^.5^^^^^^^"
^DIC(19,7395,1,0)="^^1^1^2930421^^"
^DIC(19,7395,1,1,0)="Option to edit only fields related to space planning criteria"
^DIC(19,7395,25)="EP^ENSP6"
^DIC(19,7395,"U")="ENTER/EDIT ROOM PLANNING DATA"
^DIC(19,7396,0)="ENSPUTL4^Print All Building Data^^P^.5^^^^^^^"
^DIC(19,7396,1,0)="^^1^1^2930421^^^^"
^DIC(19,7396,1,1,0)="Print all Building Data from ENG BUILDING file"
^DIC(19,7396,60)="ENG(6928.3,"
