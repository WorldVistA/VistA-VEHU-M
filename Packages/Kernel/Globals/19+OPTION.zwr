^DIC(19,12554,10,"C",4,4)=""
^DIC(19,12554,99)="59560,59159"
^DIC(19,12554,"U")="CLOSE/DELETE MENU"
^DIC(19,12593,0)="KMPD BACKGROUND DRIVER^CM Tools Background Driver^^R^10000000216^^^^^^^547"
^DIC(19,12593,1,0)="^19.06^6^6^3020220^^^^"
^DIC(19,12593,1,1,0)="This option should be queued to run each night (1:30am recommended).  Each"
^DIC(19,12593,1,2,0)="night it will compress HL7 data into daily statistics and store this data"
^DIC(19,12593,1,3,0)="in file #8973.1 (CM HL7 DATA).  Each Sunday this daily data will be"
^DIC(19,12593,1,4,0)="compiled into weekly stats and shipped (via MailMan) to the CM National"
^DIC(19,12593,1,5,0)="Database.  After the weekly transmission, file #8973.1 will be purged,"
^DIC(19,12593,1,6,0)="leaving only two weeks of data."
^DIC(19,12593,25)="KMPDBD01"
^DIC(19,12593,200.9)="y^y"
^DIC(19,12593,"U")="CM TOOLS BACKGROUND DRIVER"
^DIC(19,12594,0)="KMPD STATUS^CP Environment Check^^R^10000000216^^^^^^^547"
^DIC(19,12594,1,0)="^^2^2^3020220^"
^DIC(19,12594,1,1,0)="This option displays the status of the [KMPD BACKGROUND DRIVER] option, "
^DIC(19,12594,1,2,0)="and information on the CM HL7 DATA file (#8973.1)."
^DIC(19,12594,25)="EN^KMPDSS"
^DIC(19,12594,"U")="CP ENVIRONMENT CHECK"
^DIC(19,12595,0)="KMPD CM TOOLS MANAGER MENU^CP Tools Manager Menu^^M^10000000216^^^^^^^547"
