^DIC(19,14751,99)="65279,68750"
^DIC(19,14751,"U")="WORKLOAD REPORTS"
^DIC(19,14752,0)="RCDMCR4 0-40 PERC SC CHNG RPT^0-40 Percent SC Change Reconciliation Report^^R^1^^^^^^^"
^DIC(19,14752,1,0)="^^45^45^3190405^"
^DIC(19,14752,1,1,0)="This report will assist users in reviewing the legitimacy of first party "
^DIC(19,14752,1,2,0)="bills for veterans who received a new or updated change to a 0-40% Service"
^DIC(19,14752,1,3,0)="Connected (SC) eligibility factor and received the change in VistA during "
^DIC(19,14752,1,4,0)="the report time frame requested.  This report prints information on "
^DIC(19,14752,1,5,0)="veterans with an A/R Bill Status of Active, Suspended, Open, Write-Off,"
^DIC(19,14752,1,6,0)="Collected/Closed or with an IB Bill Status On Hold, for episodes of care"
^DIC(19,14752,1,7,0)="within a user selected time frame."
^DIC(19,14752,1,8,0)=" "
^DIC(19,14752,1,9,0)="The report does not include bills for:"
^DIC(19,14752,1,10,0)="  debtors whose Service Connection is 50% or more, "
^DIC(19,14752,1,11,0)="  debtors who are receiving a VA pension (regardless of their SC%), or "
^DIC(19,14752,1,12,0)="  debtors receiving Aid and Attendance "
^DIC(19,14752,1,13,0)=" "
^DIC(19,14752,1,14,0)="The User is prompted to enter a beginning and ending date related to the "
^DIC(19,14752,1,15,0)="rated disabilities/eligibility change, a beginning and ending date for a"
^DIC(19,14752,1,16,0)="VistA last status update date range, and a beginning and ending date for"
^DIC(19,14752,1,17,0)="an episodes of care date range. Veterans who meet the above criteria, "
^DIC(19,14752,1,18,0)="and whose rated disability eligibility has changed during the selected"
^DIC(19,14752,1,19,0)="timeframe will be included in the report."
^DIC(19,14752,1,20,0)=" "
^DIC(19,14752,1,21,0)="The report allows users to choose whether to print the report in a "
^DIC(19,14752,1,22,0)="detailed format, a summary format, and in screen or Excel Delimited"
^DIC(19,14752,1,23,0)="format. "
^DIC(19,14752,1,24,0)=" "
^DIC(19,14752,1,25,0)="It is recommended that report is to be sent to a 132 character wide device."
^DIC(19,14752,1,26,0)=" "
^DIC(19,14752,1,27,0)="The report will include the following data elements:"
^DIC(19,14752,1,28,0)="   Data Elements                      From File #"
^DIC(19,14752,1,29,0)="   -------------------------------    ---------------------------------"
^DIC(19,14752,1,30,0)="   Veteran's Name                     #2 (Patient File) "
^DIC(19,14752,1,31,0)="   SSN (9 digits)                     #2"
^DIC(19,14752,1,32,0)="   Combined SC Percentage             #2"
^DIC(19,14752,1,33,0)="   VistA Last Status Update Date      #430"
^DIC(19,14752,1,34,0)="   Rated Disability Name              #390"
^DIC(19,14752,1,35,0)="   Original Rated Disability Date     #390"
^DIC(19,14752,1,36,0)="   Bill Number                        #430 (Accounts Receivable)"
^DIC(19,14752,1,37,0)="   Charge Amount                      #430"
^DIC(19,14752,1,38,0)="   Medical Care Date (either Outpatient Visit or Inpatient Discharge)"
^DIC(19,14752,1,39,0)="                                      #350 or #409.68 or #45 or #405"
^DIC(19,14752,1,40,0)=" "
^DIC(19,14752,1,41,0)="   Medication Fill Date               #52 pointed to be File #350"
^DIC(19,14752,1,42,0)="   Prescription Number                #52 pointed to be File #350"
^DIC(19,14752,1,43,0)="   Prescription Name                  #52 pointed to be File #350"
^DIC(19,14752,1,44,0)="   Bill Status                        #430 for AR Status "
^DIC(19,14752,1,45,0)="                                      #350 for IB Status"
^DIC(19,14752,25)="MAIN^RCDMCR4A"
^DIC(19,14752,"U")="0-40 PERCENT SC CHANGE RECONCI"
^DIC(19,14753,0)="RCDMCR5 1ST PARTY IB CANC RPT^First Party Charge IB Cancellation Recon Report^^R^1^^^^^^^"
^DIC(19,14753,1,0)="^^50^50^3201001^"
^DIC(19,14753,1,1,0)="This report will assist users in reviewing first party charges receiving "
^DIC(19,14753,1,2,0)="Integrated Billing (IB) cancellation for potential refund activities or "
^DIC(19,14753,1,3,0)="charge cancellation accuracy, and to identify and monitor cancellation"
^DIC(19,14753,1,4,0)="activity productivity so veteran customers can receive refunds due to them"
^DIC(19,14753,1,5,0)="for retroactive eligibility exemptions.  The report provides data for"
^DIC(19,14753,1,6,0)="first party charges receiving IB cancellation for a user defined bill"
^DIC(19,14753,1,7,0)="cancellation date range."
^DIC(19,14753,1,8,0)=" "
^DIC(19,14753,1,9,0)="The report provides the option to print only bills with payments or print "
^DIC(19,14753,1,10,0)="all bills within the user specified bill cancellation date range.  If "
^DIC(19,14753,1,11,0)="only bills with payments are printed, the report will include bills with"
^DIC(19,14753,1,12,0)="an IB Status of ""Cancelled"" and an AR Status of ""C/C"""
^DIC(19,14753,1,13,0)="(Closed/Collected).  If all bills are printed, the report will include"
^DIC(19,14753,1,14,0)="bills with an IB Status of ""Cancelled"" with any AR Status."
^DIC(19,14753,1,15,0)=" "
^DIC(19,14753,1,16,0)="The report allows user the option to print the report in screen or Excel"
^DIC(19,14753,1,17,0)="Delimited formats.  It is not recommended to print the report to a "
^DIC(19,14753,1,18,0)="printer."
^DIC(19,14753,1,19,0)=" "
^DIC(19,14753,1,20,0)="It is recommended that report is to be sent to a 150 character wide"
^DIC(19,14753,1,21,0)="device."
^DIC(19,14753,1,22,0)=" "
^DIC(19,14753,1,23,0)="Note:  This report does not include bills with third-party AR Category "
^DIC(19,14753,1,24,0)="Types of ""Reimbursable"" or ""Pre-payments""."
^DIC(19,14753,1,25,0)="  "
^DIC(19,14753,1,26,0)="The report output includes veteran name, SSN, bill number, charge amount, "
^DIC(19,14753,1,27,0)="medical care date, medication fill date, prescription number, "
^DIC(19,14753,1,28,0)="prescription name, IB cancellation date, IB cancellation reason, and"
^DIC(19,14753,1,29,0)="cancelled by."
^DIC(19,14753,1,30,0)=" "
^DIC(19,14753,1,31,0)="The report will include the following data elements:"
^DIC(19,14753,1,32,0)=" "
^DIC(19,14753,1,33,0)="   Data Elements                      From File #"
^DIC(19,14753,1,34,0)="   -------------------------------    ---------------------------------"
^DIC(19,14753,1,35,0)="   Veteran's Name                     #2 (Patient File) "
^DIC(19,14753,1,36,0)="   SSN (9 digits)                     #2"
^DIC(19,14753,1,37,0)="   Bill Number                        #430 (Accounts Receivable)"
^DIC(19,14753,1,38,0)="   Charge Amount                      #430"
^DIC(19,14753,1,39,0)="   Fund                               #430"
^DIC(19,14753,1,40,0)="   RSC                                #430"
^DIC(19,14753,1,41,0)="   Medical Care Date (either Outpatient Visit or Inpatient Discharge)"
^DIC(19,14753,1,42,0)="                                      #350 or #409.68 or #45 or #405"
^DIC(19,14753,1,43,0)="   Medication Fill Date               #52 pointed to be File #350"
^DIC(19,14753,1,44,0)="   Prescription Number                #52 pointed to be File #350"
^DIC(19,14753,1,45,0)="   Prescription Name                  #52 pointed to be File #350"
^DIC(19,14753,1,46,0)="   Bill Status                        #430 for AR Status or"
^DIC(19,14753,1,47,0)="                                      #350 for IB Status"
^DIC(19,14753,1,48,0)="   IB Cancellation Date               #350"
^DIC(19,14753,1,49,0)="   IB Cancellation Reason             #350"
^DIC(19,14753,1,50,0)="   Cancelled By                       #350"
^DIC(19,14753,25)="MAIN^RCDMCR5A"
^DIC(19,14753,"U")="FIRST PARTY CHARGE IB CANCELLA"
^DIC(19,14754,0)="RCDMCR6 50-100SC EXMPT RPT^50-100% SC Exempt Charge Reconciliation Report^^R^1^^^^^^^"
^DIC(19,14754,1,0)="^^9^9^3190408^"
^DIC(19,14754,1,1,0)="50-100% SC Exempt Charge Reconciliation Report shows all bills containing"
^DIC(19,14754,1,2,0)="charges with a distinct date of service on or after the co-payment"
^DIC(19,14754,1,3,0)="exemption effective date for Veterans with Primary or Secondary"
^DIC(19,14754,1,4,0)="Eligibility: SC 50-100%"
^DIC(19,14754,1,5,0)=" "
^DIC(19,14754,1,6,0)="The report captures any charges WITHOUT an IB status of cancelled, and "
^DIC(19,14754,1,7,0)="with an AR Status of Active, Open, Suspended, Write-Off, or Collected/"
^DIC(19,14754,1,8,0)="Closed or an IB Status of On-Hold, with a date of service on or"
^DIC(19,14754,1,9,0)="after the exemption effective date."
^DIC(19,14754,25)="MAIN^RCDMCR6A"
^DIC(19,14754,"U")="50-100% SC EXEMPT CHARGE RECON"
^DIC(19,14755,0)="RCDMCR7 10-40% COPAY RPT^10-40% SC Med Care Copay Exempt Chrg Recon Report^^R^1^^^^^^^"
^DIC(19,14755,1,0)="^^10^10^3190315^"
^DIC(19,14755,1,1,0)="10-40% SC Medical Care Copayment Exempt Charge Recon Report shows all"
^DIC(19,14755,1,2,0)="medical care copayment bills containing charges with a distinct date of"
^DIC(19,14755,1,3,0)="service on or after the copayment exemption effective date for Veterans"
^DIC(19,14755,1,4,0)="with SC Percent: 10-40%, and does not show Veterans with 0% SC.  Further,"
^DIC(19,14755,1,5,0)="the report does not capture prescription copayment bills."
^DIC(19,14755,1,6,0)=" "
^DIC(19,14755,1,7,0)="The report captures any medical care copayment charge WITHOUT an IB "
^DIC(19,14755,1,8,0)="status of cancelled, and WITH an AR Status of Active, Open, Suspended, "
^DIC(19,14755,1,9,0)="Write-Off, or Collected/Closed OR an IB Status of On-Hold, with a date of "
^DIC(19,14755,1,10,0)="service on or after the exemption effective date."
^DIC(19,14755,25)="MAIN^RCDMCR7A"
^DIC(19,14755,"U")="10-40% SC MED CARE COPAY EXEMP"
^DIC(19,14756,0)="YSCL DAILY TRANSMISSION^Daily Clozapine Transmission^^R^1^^^^^^^166^^1"
^DIC(19,14756,1,0)="^19.06^2^2^3181017^^"
^DIC(19,14756,1,1,0)="This option is used to transmit the daily Clozapine patient demographics"
^DIC(19,14756,1,2,0)="to the Clozapine Roll-Up database located in Hines."
^DIC(19,14756,20)="D XMIT^YSCLTST5"
^DIC(19,14756,25)="YSCLTST5"
^DIC(19,14756,"U")="DAILY CLOZAPINE TRANSMISSION"
^DIC(19,14757,0)="PSJLAB LIST^Display Inpatient Lab Tests and Results^^R^1^^^^^^^197"
^DIC(19,14757,1,0)="^19.06^3^3^3160329^^"
^DIC(19,14757,1,1,0)="This option displays results of lab tests for patients receiving clozapine"
^DIC(19,14757,1,2,0)="as required by the circular regarding patient management protocol for the"
^DIC(19,14757,1,3,0)="use of clozapine. This is for inpatient pharmacy."
^DIC(19,14757,25)="PSJRXLAB"
^DIC(19,14757,"U")="DISPLAY INPATIENT LAB TESTS AN"
^DIC(19,14758,0)="PSJLIST OVERRIDES^List Inpatient Clozapine Overrides^^R^1^^^^^^^197"
^DIC(19,14758,1,0)="^^2^2^3160407^"
^DIC(19,14758,1,1,0)="This generates a list of inpatient ordered clozapine prescriptions entered"
^DIC(19,14758,1,2,0)="by overriding the lockout."
^DIC(19,14758,25)="PSJCLOLS"
^DIC(19,14758,"U")="LIST INPATIENT CLOZAPINE OVERR"
^DIC(19,14759,0)="PSJL MANAGER^Clozapine Inpatient Medications Manager^^M^1^PSOLOCKCLOZ^^^^^^197"
^DIC(19,14759,1,0)="^19.06^1^1^3160620^^^^"
^DIC(19,14759,1,1,0)="This menu contains options used to control inpatient Clozapine dispensing."
^DIC(19,14759,10,0)="^19.01IP^7^6"
^DIC(19,14759,10,3,0)="14758^^3"
^DIC(19,14759,10,5,0)="14757^^2"
^DIC(19,14759,10,6,0)="5678^^1"
^DIC(19,14759,10,7,0)="5683^^4"
