^DIC(19,10584,0)="PSA UPLOAD PRIME VENDOR DATA^Upload and Process Prime Vendor Invoice Data^^R^10000000020^PSA ORDERS^^^^^^287"
^DIC(19,10584,1,0)="^19.06^4^4^3030429^^^^"
^DIC(19,10584,1,1,0)="The Upload and Process Prime Vendor Invoice Data option uploads invoice"
^DIC(19,10584,1,2,0)="data received from the prime vendor. The invoice data may be processed"
^DIC(19,10584,1,3,0)="after the data is uploaded. It also allows the user to print the invoices"
^DIC(19,10584,1,4,0)="immediately following the upload and immediately following the processing."
^DIC(19,10584,25)="PSAUP"
^DIC(19,10584,"U")="UPLOAD AND PROCESS PRIME VENDO"
^DIC(19,10585,0)="PSA PROCESS PRIME VENDOR DATA^Process Uploaded Prime Vendor Invoice Data^^R^10000000020^PSA ORDERS^^^^^^287^^1^1"
^DIC(19,10585,1,0)="^^2^2^2970507^"
^DIC(19,10585,1,1,0)="The Process Uploaded Prime Vendor Invoice Data option processes uploaded"
^DIC(19,10585,1,2,0)="prime vendor invoice data."
^DIC(19,10585,15)=" "
^DIC(19,10585,20)="S PSAENTRY=1"
^DIC(19,10585,25)="PSAPROC"
^DIC(19,10585,99)="56873,44873"
^DIC(19,10585,"U")="PROCESS UPLOADED PRIME VENDOR "
^DIC(19,10586,0)="PSA VERIFY INVOICES^Verify Invoices^^R^10000000020^PSA ORDERS^^^^^^287^^1"
^DIC(19,10586,1,0)="^^3^3^2970722^"
^DIC(19,10586,1,1,0)="The Verify Invoices option validates processed invoices. The verifier and"
^DIC(19,10586,1,2,0)="processor cannot be the same person. When the invoices are verified, the"
^DIC(19,10586,1,3,0)="drug balances are updated in the pharmacy location and/or master vault."
^DIC(19,10586,20)="Q"
^DIC(19,10586,25)="PSAVER"
^DIC(19,10586,"U")="VERIFY INVOICES"
^DIC(19,10587,0)="PSA PRINT ORDERS^Print Orders^^R^10000000020^PSA ORDERS^^^^^^287^^1"
^DIC(19,10587,1,0)="^^4^4^2970507^"
^DIC(19,10587,1,1,0)="The Print Orders option generates invoices by entering the order number,"
^DIC(19,10587,1,2,0)="invoice number, or invoice status. If the invoice has not been processed, "
^DIC(19,10587,1,3,0)="the PRIME VENDOR UPLOAD REPORT prints. If the invoice has been processed,"
^DIC(19,10587,1,4,0)="the PRIME VENDOR ORDER REPORT prints."
^DIC(19,10587,20)=" "
^DIC(19,10587,25)="PSAORDP"
^DIC(19,10587,"U")="PRINT ORDERS"
