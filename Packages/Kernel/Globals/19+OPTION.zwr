^DIC(19,11513,"U")="REMINDER TERM MANAGEMENT"
^DIC(19,11514,0)="PXRM DIALOG/COMPONENT EDIT^Reminder Dialogs^^R^10000000020^^^^^^^534"
^DIC(19,11514,1,0)="^19.06^57^57^3020604^^"
^DIC(19,11514,1,1,0)="Dialog file entries may be created or amended with this option. The"
^DIC(19,11514,1,2,0)="initial display is by dialog type. Use the CV option to switch between"
^DIC(19,11514,1,3,0)="dialog types. Possible dialog types are:"
^DIC(19,11514,1,4,0)=" "
^DIC(19,11514,1,5,0)="             R - Reminder Dialog"
^DIC(19,11514,1,6,0)="             G - Dialog Group"
^DIC(19,11514,1,7,0)="             E - Dialog Element "
^DIC(19,11514,1,8,0)="             P - Prompt"
^DIC(19,11514,1,9,0)="             F - Forced Value"
^DIC(19,11514,1,10,0)="     "
^DIC(19,11514,1,11,0)="Reminder dialogs are linked to reminders by a field (REMINDER DIALOG) on"
^DIC(19,11514,1,12,0)="the reminder definition. The reminder dialog may be executed by CPRS if"
^DIC(19,11514,1,13,0)="the reminder is due or applicable. "
^DIC(19,11514,1,14,0)="      "
^DIC(19,11514,1,15,0)="A reminder dialog contains questions (dialog elements) and/or groups of"
^DIC(19,11514,1,16,0)="questions (dialog groups) which are related to the reminder findings."
^DIC(19,11514,1,17,0)="      "
^DIC(19,11514,1,18,0)="Dialog groups can contain one or more questions (dialog elements)."
^DIC(19,11514,1,19,0)="      "
^DIC(19,11514,1,20,0)="Each question (dialog element) may have a number of additional prompts"
^DIC(19,11514,1,21,0)="(e.g. date, location) or forced values."
^DIC(19,11514,1,22,0)=" "
^DIC(19,11514,1,23,0)="Reminder Dialogs"
^DIC(19,11514,1,24,0)="----------------"
^DIC(19,11514,1,25,0)="New reminder dialogs can be created using option:"
^DIC(19,11514,1,26,0)=" "
^DIC(19,11514,1,27,0)="          AD - Add Dialog"
^DIC(19,11514,1,28,0)=" "
^DIC(19,11514,1,29,0)="The reminder dialog may be created manually or auto generated from the"
^DIC(19,11514,1,30,0)="reminder definition using the General Finding Type Parameters."
^DIC(19,11514,1,31,0)=" "
^DIC(19,11514,1,32,0)="An existing reminder dialog may be selected. Options available are:"
^DIC(19,11514,1,33,0)="      "
^DIC(19,11514,1,34,0)="          CO - Copy a reminder dialog"
^DIC(19,11514,1,35,0)="          DD - Display details of dialog elements for this reminder dialog"
^DIC(19,11514,1,36,0)="          DP - View progress note text in an approximation to the GUI"
^DIC(19,11514,1,37,0)="          ED - Edit/Delete reminder dialog. This allows adding or deletion"
^DIC(19,11514,1,38,0)="               of questions (dialog elements) to be included in the"
^DIC(19,11514,1,39,0)="               dialog."
^DIC(19,11514,1,40,0)="          EE - Element edit. This allows changes to the individual"
^DIC(19,11514,1,41,0)="               questions (dialog elements) and additional prompts (dialog"
^DIC(19,11514,1,42,0)="               prompts)"
^DIC(19,11514,1,43,0)="          INQ- Print reminder dialog definition (and related reminder"
^DIC(19,11514,1,44,0)="               finding)"
^DIC(19,11514,1,45,0)="          RI - Reminder inquiry"
^DIC(19,11514,1,46,0)="      "
^DIC(19,11514,1,47,0)="The edit options allow changes to the selected reminder dialog. When"
^DIC(19,11514,1,48,0)="making changes to dialog elements and prompts it should be remembered that"
^DIC(19,11514,1,49,0)="dialog elements and prompts may be used in more than one reminder dialog."
^DIC(19,11514,1,50,0)="      "
^DIC(19,11514,1,51,0)="Changing one reminder dialog may affect others."
^DIC(19,11514,1,52,0)=" "
^DIC(19,11514,1,53,0)="Other Dialog Types"
^DIC(19,11514,1,54,0)="------------------"
^DIC(19,11514,1,55,0)=" "
^DIC(19,11514,1,56,0)="Additional prompts, forced values, dialog elements and dialog groups may"
^DIC(19,11514,1,57,0)="be edited or printed"
^DIC(19,11514,25)="START^PXRMDLGZ"
^DIC(19,11514,"U")="REMINDER DIALOGS"
^DIC(19,11515,0)="PXRM DIALOG PARAMETERS^Dialog Parameters^^M^10000000020^^^^^^^534"
^DIC(19,11515,1,0)="^^7^7^3000313^"
^DIC(19,11515,1,1,0)="This menu allows maintenance of parameters used in dialog generation:"
^DIC(19,11515,1,2,0)=" "
^DIC(19,11515,1,3,0)="RS - Resolution Statuses"
^DIC(19,11515,1,4,0)="FP - Finding Type Parameters"
^DIC(19,11515,1,5,0)="FI - Finding Item Parameters   "
^DIC(19,11515,1,6,0)="HR - Health Factor Resolutions"
^DIC(19,11515,1,7,0)="TD - Taxonomy Dialogs"
^DIC(19,11515,10,0)="^19.01IP^4^4"
^DIC(19,11515,10,1,0)="11495^RS^1"
