^DIC(19,13308,1,3,0)="The report will identify patients placed on the Electronic Wait List"
^DIC(19,13308,1,4,0)="after the initializing date/time of the consult for a SERVICE with the"
^DIC(19,13308,1,5,0)="same Stop Code as the consult."
^DIC(19,13308,25)="EN^GMRCONS1"
^DIC(19,13308,"U")="SERVICE CONSULTS SCHEDULE-MANA"
