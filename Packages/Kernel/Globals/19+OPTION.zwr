^DIC(19,14377,1,1,0)="Menu option created by patch XU*8*655 using sort and print templates from "
^DIC(19,14377,1,2,0)="patch XU*8*165. Prints Sign-on log entries from remote users. Added "
^DIC(19,14377,1,3,0)="sign-on Level Of Assurance information in patch XU*8*659 where: "
^DIC(19,14377,1,4,0)="  LOA=1 - little or no confidence in the user identity (self-asserted)"
^DIC(19,14377,1,5,0)="  LOA=2 - confidence in the user identity (access/verify code or"
^DIC(19,14377,1,6,0)="          re-authentication token)"
^DIC(19,14377,1,7,0)="  LOA=3 - high confidence in the user identity (password with hardware or "
^DIC(19,14377,1,8,0)="          software token)"
^DIC(19,14377,1,9,0)="  LOA=4 - very high confidence in the user identity (in-person "
^DIC(19,14377,1,10,0)="          registration with multi-factor authentication or PIV card)"
^DIC(19,14377,60)="XUSEC(0,"
