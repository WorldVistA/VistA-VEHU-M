^DIC(19,12500,0)="AWCM ROLL UP NATIONAL DATA^Roll Up Data to National Database^^R^10000000020^^^^^^^"
^DIC(19,12500,1,0)="^19.06^3^3^3030822^^"
^DIC(19,12500,1,1,0)="This option rolls up data to the National CPRS response time database in "
^DIC(19,12500,1,2,0)="Silver Springs, MD.  It should be run as a tasked job only, at 1205 "
^DIC(19,12500,1,3,0)="am nightly."
