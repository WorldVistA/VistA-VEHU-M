^DIC(19,10417,1,1,0)="Menu for printing Progress Notes."
^DIC(19,10417,10,0)="^19.01IP^4^4"
^DIC(19,10417,10,1,0)="10381^PNPT"
^DIC(19,10417,10,2,0)="10382^PNPA"
^DIC(19,10417,10,3,0)="10388^PNPL"
^DIC(19,10417,10,4,0)="10415^PNPW"
