^DIC(19,12215,0)="FHMNBRPT^Nutrition Monitor Brief Report^^R^10000000020^^^^^^^"
^DIC(19,12215,1,0)="^19.06^3^3^3030709^^^^"
^DIC(19,12215,1,1,0)="This option displays a report given a date range of patients with"
^DIC(19,12215,1,2,0)="admission dates within that range and whether they have any monitors or"
^DIC(19,12215,1,3,0)="not.  Also gives total admissions, number with monitors and a percentage."
^DIC(19,12215,25)="FHMNBRPT"
^DIC(19,12215,"U")="NUTRITION MONITOR BRIEF REPORT"
^DIC(19,12216,0)="FHMNADM^Nutrition Admission/Discharge Monitor Report^^R^10000000020^^^^^^^"
^DIC(19,12216,1,0)="^19.06^2^2^3030530^^^^"
^DIC(19,12216,1,1,0)="Displays a report of admitted or discharged patients with monitors in"
^DIC(19,12216,1,2,0)="a given date range."
^DIC(19,12216,25)="FHMNADM"
^DIC(19,12216,"U")="NUTRITION ADMISSION/DISCHARGE "
^DIC(19,12217,0)="PSJI ACTIVITY LOG VA200^Correct Change User Names in IV activity log^^R^10000000020^^^^^^^"
^DIC(19,12217,1,0)="^19.06^4^4^3011221^^"
^DIC(19,12217,1,1,0)="In Inpatient Medications version 5.0, the Pharmacy Patient file (#55) IV sub file 55.01, field ENTRY CODE (#.03) of the Activity Log sub file (#55.04) was changed from free text to a pointer to the NEW PERSON file (#200).  A new field USER (#.06"
^DIC(19,12217,1,2,0)=") was created. The post init of patch PSJ*5*58 converts these names to there pointer and stores it in the new field.  The conversion also looks for the Free Text names in field ENTRY CODE that don't have exact matches in the NEW PERSON file. The"
^DIC(19,12217,1,3,0)="se names are temporarily stored in ^XTMP(""PSJ NEW PERSON"",NAME,DFN, ORDER NUMBER, ACTIVITY LOG IEN). This option lets a pharmacist go through the bad names and choose the correct user name.  After the correct name is chosen, the IV orders are up"
^DIC(19,12217,1,4,0)="dated with the new pointer to that user.  "
^DIC(19,12217,25)="PSJ200A"
^DIC(19,12217,"U")="CORRECT CHANGE USER NAMES IN I"
^DIC(19,12218,0)="PSJI CONTROL CODES^Test Control Codes (IV)^^A^10000000020^^^^^^^115^^1"
^DIC(19,12218,1,0)="^19.06^3^3^3020104^^"
^DIC(19,12218,1,1,0)="This option allows the user to print an IV label for the purpose of "
^DIC(19,12218,1,2,0)="verifying their control code definition.  An entire label is not printed, "
^DIC(19,12218,1,3,0)="simply a bar code and one line of underscores."
^DIC(19,12218,20)="D ^PSIVXU Q:$D(XQUIT)  D ^PSIVALNC,ENIVKV^PSGSETU K I,Z,ZISI"
^DIC(19,12218,"U")="TEST CONTROL CODES (IV)"
^DIC(19,12219,0)="PSJI RETURN BY BARCODE ID^Barcode ID - Return and Destroy (IV)^^R^10000000020^^^^^^^115"
^DIC(19,12219,1,0)="^19.06^2^2^3020723^^"
^DIC(19,12219,1,1,0)="This option will allow a user to cancel, destroy or recycle an IV bag by "
^DIC(19,12219,1,2,0)="barcode ID."
^DIC(19,12219,25)="EN^PSIVRDC"
^DIC(19,12219,"U")="BARCODE ID - RETURN AND DESTRO"
^DIC(19,12220,0)="OR PATIENT EVENT INQUIRY^Inquire to OE/RR Patient Event File^^R^10000000020^^^^^^^^^"
^DIC(19,12220,1,0)="^19.06^5^5^3020909^^"
^DIC(19,12220,1,1,0)="This option gives a fileman inquiry of an entry from the patient event "
^DIC(19,12220,1,2,0)="file.  This file holds information related to orders placed on delay.  "
^DIC(19,12220,1,3,0)="Included in this information are orders released and auto-dcd due to an "
^DIC(19,12220,1,4,0)="event occurring as well as an audit trail of MAS actions taken related to "
^DIC(19,12220,1,5,0)="this delayed event."
^DIC(19,12220,20)=""
^DIC(19,12220,25)="OREV4"
^DIC(19,12220,"U")="INQUIRE TO OE/RR PATIENT EVENT"
^DIC(19,12221,0)="OR DELAYED ORDERS EDITOR^Delayed Orders/Auto-DC Set-up^^R^10000000020^^^^^^^"
^DIC(19,12221,1,0)="^19.06^7^7^3020910^^^^"
^DIC(19,12221,1,1,0)="This option invokes the auto-dc rules/release events editor.  Use this "
^DIC(19,12221,1,2,0)="option to define and maintain your auto-discontinue rules as well as your "
^DIC(19,12221,1,3,0)="delayed order release events."
^DIC(19,12221,1,4,0)=" "
^DIC(19,12221,1,5,0)="Whether or not orders auto-discontinue will depend on how you have your "
^DIC(19,12221,1,6,0)="rules defined.  In addition, orders that are being written for delayed "
^DIC(19,12221,1,7,0)="release can only be delayed to the release events that you've defined."
^DIC(19,12221,25)="OREV"
^DIC(19,12221,"U")="DELAYED ORDERS/AUTO-DC SET-UP"
^DIC(19,12222,0)="OR EVENT PARAMETERS^Parameters for event delayed orders^^R^10000000020^^^^^^^"
^DIC(19,12222,1,0)="^^2^2^3020911^"
^DIC(19,12222,1,1,0)="This option will allow you to edit the parameters related to event "
^DIC(19,12222,1,2,0)="delayed orders."
^DIC(19,12222,25)="PARAM^OREV3"
^DIC(19,12222,"U")="PARAMETERS FOR EVENT DELAYED O"
^DIC(19,12223,0)="ORCM QO ITEMS^Enter/edit QO restriction^^R^10000000020^^^^^^^170^^"
^DIC(19,12223,1,0)="^19.06^3^3^3021122^^"
^DIC(19,12223,1,1,0)="This option allows a site to mark orderable items for use within pre-"
^DIC(19,12223,1,2,0)="defined quick orders only; these items will not be selectable when"
^DIC(19,12223,1,3,0)="ordering via standard package order dialogs."
^DIC(19,12223,20)=""
^DIC(19,12223,25)="QO^ORCMEDT6"
^DIC(19,12223,"U")="ENTER/EDIT QO RESTRICTION"
^DIC(19,12224,0)="ORCM SEARCH/REPLACE ORDERABLES^Search/replace orderables^^R^10000000020^^^^^^^170"
^DIC(19,12224,1,0)="^19.06^3^3^3021211^^"
^DIC(19,12224,1,1,0)="This option lets you search for specific orderable items saved as"
^DIC(19,12224,1,2,0)="responses within quick orders; a new orderable item may be selected"
^DIC(19,12224,1,3,0)="to automatically replace it, as well."
^DIC(19,12224,25)="SEARCH^ORCMEDT6"
^DIC(19,12224,"U")="SEARCH/REPLACE ORDERABLES"
