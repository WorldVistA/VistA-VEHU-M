^DIC(19,13570,0)="ECX IV DIV PRINT^Print IV Room Worksheet^^R^10000000020^^^^^^^513"
^DIC(19,13570,1,0)="^^5^5^2960319^^"
^DIC(19,13570,1,1,0)="This option will print a worksheet listing all the entries in the "
^DIC(19,13570,1,2,0)="IV Room file (#59.5) of the Inpatient Medications Package.  This "
^DIC(19,13570,1,3,0)="worksheet is intended to be used by the DSS Manager to define the "
^DIC(19,13570,1,4,0)="DIVISION (as a pointer to the Medical Center Division file (#40.8))"
^DIC(19,13570,1,5,0)="for each IV Room for DSS purposes."
^DIC(19,13570,25)="PRT^ECXDIVIV"
^DIC(19,13570,"U")="PRINT IV ROOM WORKSHEET"
^DIC(19,13571,0)="ECXNDC^Pharmacy NDC Lookup^^R^11720^^^^^^^513"
^DIC(19,13571,1,0)="^^15^15^3180529^"
^DIC(19,13571,1,1,0)="This option will allow lookups on the local DRUG file (#50) using "
^DIC(19,13571,1,2,0)="NDCs from DSS Pharmacy Feeder Keys that have been rejected because"
^DIC(19,13571,1,3,0)="the first five characters are zeros in a 17 character Feeder Key."
^DIC(19,13571,1,4,0)="(Ex. ""00000051079014120"")"
^DIC(19,13571,1,5,0)=" "
^DIC(19,13571,1,6,0)="This would occur when a pharmacy item has not been matched to the"
^DIC(19,13571,1,7,0)="the National Drug File (NDF)."
^DIC(19,13571,1,8,0)=" "
^DIC(19,13571,1,9,0)="To use this option, enter the NDC (last twelve characters) from a rejected"
^DIC(19,13571,1,10,0)="feeder key. The NDC can be either 12 digits or the letters ""LCL"" followed "
^DIC(19,13571,1,11,0)="by 9 digits."
^DIC(19,13571,1,12,0)=" "
^DIC(19,13571,1,13,0)="This will display the following information from the local "
^DIC(19,13571,1,14,0)="DRUG file (#50): LOCAL GENERIC NAME, DISPENSE UNIT, and PRICE PER DISPENSE"
^DIC(19,13571,1,15,0)="UNIT."
^DIC(19,13571,25)="EN^ECXNDC"
^DIC(19,13571,"U")="PHARMACY NDC LOOKUP"
