^DIC(19,4018,0)="LRAPDES^Enter/edit lab description file^^R^.5^^^^^^^26"
^DIC(19,4018,1,0)="^^8^8^2880809^"
^DIC(19,4018,1,1,0)="Specimen description for an entry in this file will be"
^DIC(19,4018,1,2,0)=" entered as the gross description for an accession if"
^DIC(19,4018,1,3,0)=" the SPECIMEN name entered at log-in time exactly matches"
^DIC(19,4018,1,4,0)=" the LAB DESCRIPTION NAME."
^DIC(19,4018,1,5,0)=" THe specimen description for an entry in this file will be"
^DIC(19,4018,1,6,0)=" entered as the microscopic description for an accession if a"
^DIC(19,4018,1,7,0)=" '*' preceeds the exact match in the LAB DESCRIPTION FILE when"
^DIC(19,4018,1,8,0)=" an entry is made at the microscopic description prompt."
^DIC(19,4018,25)="D^LRAP"
^DIC(19,4018,"U")="ENTER/EDIT LAB DESCRIPTION FIL"
