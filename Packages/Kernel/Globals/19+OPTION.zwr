^DIC(19,11682,0)="PSO BACKFILL PRESCRIPTIONS^Backfill Prescriptions to CPRS^^R^11740^^^^^^^141"
^DIC(19,11682,1,0)="^^3^3^2991124^"
^DIC(19,11682,1,1,0)="This option can be used to backfill prescriptions to CPRS that were"
^DIC(19,11682,1,2,0)="canceled or expired more than 120 days at the time of CPRS/Pharmacy"
^DIC(19,11682,1,3,0)="installation, so these prescription can be viewed through CPRS."
^DIC(19,11682,25)="PATCH^PSOUTLA1"
^DIC(19,11682,"U")="BACKFILL PRESCRIPTIONS TO CPRS"
^DIC(19,11683,0)="PSO CMOP CS RX DISPENSE REPORT^CMOP Controlled Substance Rx Dispense Report^^R^11740^^^^^^^141"
^DIC(19,11683,1,0)="^^11^11^2991015^"
^DIC(19,11683,1,1,0)="This option prints the status of CMOP Controlled Substance"
^DIC(19,11683,1,2,0)="prescriptions that are of Schedule III-V drugs."
^DIC(19,11683,1,3,0)=" "
^DIC(19,11683,1,4,0)="The user is prompted for:"
^DIC(19,11683,1,5,0)=" "
^DIC(19,11683,1,6,0)="       1) Date range of release"
^DIC(19,11683,1,7,0)="       2) Sort by 'All' or a 'Single' Division"
^DIC(19,11683,1,8,0)="       3) Sort by 'Release Date' or 'Drug'"
^DIC(19,11683,1,9,0)=" "
^DIC(19,11683,1,10,0)="Fields printed are Division, Release Date, Patient, SSN, Drug, Quantity,"
^DIC(19,11683,1,11,0)="Status, and CMOP Facility."
^DIC(19,11683,25)="S^PSOCMOPR"
^DIC(19,11683,"U")="CMOP CONTROLLED SUBSTANCE RX D"
^DIC(19,11684,0)="PSO SUCMOP MENU^CMOP Utilities^^M^11740^^^^^^^141"
^DIC(19,11684,1,0)="^19.06^8^8^3000417^^^^"
^DIC(19,11684,1,1,0)="This menu will contain utilities to help the sites re-suspend those Rxs"
^DIC(19,11684,1,2,0)="that was suspended locally instead of transmission to CMOP.  PSO*7*39."
