^DIC(19,7819,0)="FBUC DISPLAY UNAUTHORIZED^Display Unauthorized Claim^^R^.5^^^^^^y^"
^DIC(19,7819,1,0)="^^12^12^2930528^^^^"
^DIC(19,7819,1,1,0)="This option is used to display an unauthorized claim."
^DIC(19,7819,1,2,0)="You can select the claim by either vendor, veteran or other party name,"
^DIC(19,7819,1,3,0)="and the claim which you would like to view."
^DIC(19,7819,1,4,0)=" The following information is displayed:"
^DIC(19,7819,1,5,0)="   o The unauthorized claim which you have selected."
^DIC(19,7819,1,6,0)="   o The discharge type if the unauthorized claim has been dispositioned"
^DIC(19,7819,1,7,0)="      to either approved or approved to stabilization."
^DIC(19,7819,1,8,0)="   o The pending items if the unauthorized claim has any pending"
^DIC(19,7819,1,9,0)="      information in the FEE BASIS UNAUTHORIZED CLAIMS PENDING INFO file."
^DIC(19,7819,1,10,0)="   o A brief listing of other claims which are associated with the selected"
^DIC(19,7819,1,11,0)="      claim."
^DIC(19,7819,1,12,0)="   o A message which indicates that payments have been made for this claim."
