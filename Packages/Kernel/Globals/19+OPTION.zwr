^DIC(19,10104,0)="SROQADM^Admitted w/in 14 days of Out Surgery If Postop Occ^^R^10000000216^^^^^^^167^^1^1"
^DIC(19,10104,1,0)="^^3^3^3101207^"
^DIC(19,10104,1,1,0)="This option provides a list of patients with completed outpatient surgical"
^DIC(19,10104,1,2,0)="cases which resulted in at least one postoperative occurrence AND a"
^DIC(19,10104,1,3,0)="hospital admission within 14 days of the surgery."
