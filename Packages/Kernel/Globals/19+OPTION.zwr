^DIC(19,3363,10,"B",27,3)=""
^DIC(19,3363,10,"B",131,2)=""
^DIC(19,3363,10,"C","XMM",3)=""
^DIC(19,3363,10,"C","XMN",2)=""
^DIC(19,3363,10,"C","XMU",1)=""
^DIC(19,3363,99)="59254,80393"
^DIC(19,3363,99.1)="67804,41143"
^DIC(19,3363,"U")="MAILMAN MASTER MENU"
^DIC(19,3364,0)="XMUT-REC-FIND^Find Messages for User^^R^11748^^3467^^^^^^^"
^DIC(19,3364,1,0)="^^4^4^2870825^^^"
^DIC(19,3364,1,1,0)="Use this option to find all the messages that a user has ever had and has"
^DIC(19,3364,1,2,0)="not terminated from.  This list of messages can be used as input into two"
^DIC(19,3364,1,3,0)="other processes:  Deliver Found Messages into User's IN Basket, and List"
^DIC(19,3364,1,4,0)="Messages Found."
^DIC(19,3364,25)="A^XMUT1"
^DIC(19,3364,"U")="FIND MESSAGES FOR USER"
^DIC(19,3365,0)="XMUT-REC-RPT^List Messages Found^^R^11748^^3469^^^^^^^"
^DIC(19,3365,1,0)="^^2^2^2870825^"
^DIC(19,3365,1,1,0)="Use this procedure to list the messages found for users with the procedure"
^DIC(19,3365,1,2,0)="'Find Messages for User'."
^DIC(19,3365,25)="LIST^XMUT1A"
^DIC(19,3365,"U")="LIST MESSAGES FOUND"
^DIC(19,3366,0)="XMUT-REC-DELIVER^Deliver Found Messages into User's IN Basket^^R^11748^^3468^^^^^^^"
^DIC(19,3366,1,0)="^^3^3^2870825^"
^DIC(19,3366,1,1,0)="Use this procedure to deliver the messages found with the 'Find Messages"
^DIC(19,3366,1,2,0)="for User' option.  The Messages found with that option will be placed into"
^DIC(19,3366,1,3,0)="the user's IN basket, but only if they are not already in another basket."
^DIC(19,3366,25)="G^XMUT1"
^DIC(19,3366,"U")="DELIVER FOUND MESSAGES INTO US"
^DIC(19,3367,0)="XMSTARTQUE-ALL^Transmit All Queues^^R^11748^^3494^^^^^54^^"
^DIC(19,3367,1,0)="^19.06^5^5^3020312^^^^"
^DIC(19,3367,1,1,0)="If messages are queued in the Postmaster's baskets for a number of domains,"
^DIC(19,3367,1,2,0)="taskmanager jobs that will transmit them over the network can be created"
^DIC(19,3367,1,3,0)="for all of them by using this option.  A Domain's queue will not be requeued"
^DIC(19,3367,1,4,0)="if it is already set up as a scheduled taskmanager job.  Nor will it be"
^DIC(19,3367,1,5,0)="requeued if it is empty or active in the process of transmitting."
^DIC(19,3367,25)="QALL^XMCX"
^DIC(19,3367,"U")="TRANSMIT ALL QUEUES"
^DIC(19,3368,0)="XM-NEW-FEATURES^New Features in MailMan^^A^11748^^^^^^^54^^1^^"
^DIC(19,3368,1,0)="^^3^3^2981019^^^^"
^DIC(19,3368,1,1,0)="Displays a help frame which informs the user about new MailMan features."
^DIC(19,3368,1,2,0)="Many users do not get manuals.  "
^DIC(19,3368,1,3,0)="Therefore it is very important that this sort of documentation be on-line."
^DIC(19,3368,20)="S XQH=""XM-U-NEW FEATURES"" D EN^XQH"
^DIC(19,3368,99)="54870,25976"
^DIC(19,3368,"U")="NEW FEATURES IN MAILMAN"
^DIC(19,3369,0)="XMEDITPERSGROUP^Personal Mail Group Edit^^R^11748^^3249^^^^^54^^"
^DIC(19,3369,1,0)="^^5^5^2971007^^^^"
^DIC(19,3369,1,1,0)="This option allows the user to create or edit a personal group."
^DIC(19,3369,1,2,0)="A personal group is one that only the user can access, to use"
^DIC(19,3369,1,3,0)="in addressing mail.  Members can not remove themselves."
^DIC(19,3369,1,4,0)="The difference between a personal group and a private one is"
^DIC(19,3369,1,5,0)="that the personal group is restricted in its use and joining. "
^DIC(19,3369,25)="PERSONAL^XMVGROUP"
^DIC(19,3369,99)="55469,51715"
^DIC(19,3369,"U")="PERSONAL MAIL GROUP EDIT"
^DIC(19,3370,0)="XMMGR-HELP^New Features for Managing MailMan^^A^11748^^^^^^^^^1^^"
^DIC(19,3370,1,0)="^^1^1^2931206^"
^DIC(19,3370,1,1,0)="This option has help for site management."
^DIC(19,3370,20)="S XQH=""XM-I-NEW FEATURES"" D EN^XQH"
^DIC(19,3370,"U")="NEW FEATURES FOR MANAGING MAIL"
^DIC(19,3371,0)="XMMGR-IN-BASKET-PURGE^IN Basket Purge^^R^11748^^^^^^^54^^"
^DIC(19,3371,1,0)="^19.06^19^19^3020509^^^^"
^DIC(19,3371,1,1,0)="THIS OPTION MAY RUN VIA THE TASKMANAGER."
^DIC(19,3371,1,2,0)=" "
^DIC(19,3371,1,3,0)="This option purges 'IN' Baskets in two steps:"
^DIC(19,3371,1,4,0)=" "
^DIC(19,3371,1,5,0)="1.  In the first step messages are sent to users"
^DIC(19,3371,1,6,0)="    a.  Message will contain a list of messages to be purged in step two."
^DIC(19,3371,1,7,0)="    b.  Message will contain list of actions that will prevent the purging"
^DIC(19,3371,1,8,0)="        of the listed messages."
^DIC(19,3371,1,9,0)="    c.  Message will state how many days later listed messages will be "
^DIC(19,3371,1,10,0)="        purged unless the action is taken on a message by message basis."
^DIC(19,3371,1,11,0)="    d.  The messages listed will not have been referenced for 30 days"
^DIC(19,3371,1,12,0)="        or the number of days in the MAILMAN SITE PARAMETERS file, field"
^DIC(19,3371,1,13,0)="        'IN-BASKET-PURGE DAYS', if it is not null."
^DIC(19,3371,1,14,0)=" "
^DIC(19,3371,1,15,0)="2.  In the second step the messages listed in the message from step 1"
^DIC(19,3371,1,16,0)="    will be purged not less than 30 days later unless they:"
^DIC(19,3371,1,17,0)="    a.  Have been saved into a basket other than the 'IN' basket."
^DIC(19,3371,1,18,0)="    b.  Have been referenced (read or printed) otherwise."
^DIC(19,3371,1,19,0)="    c.  Are marked as NEW."
^DIC(19,3371,25)="ENTER^XMUPIN"
^DIC(19,3371,99)="55501,31333"
^DIC(19,3371,200.9)="y"
^DIC(19,3371,"U")="IN BASKET PURGE"
^DIC(19,3372,0)="XMQHIST^Historical Queue Data/Stats Report^^R^11748^^^^^^y^54^^"
^DIC(19,3372,1,0)="^19.06^5^5^3020312^^^^"
^DIC(19,3372,1,1,0)="Reports on network transmission queues."
^DIC(19,3372,1,2,0)="It includes every domain in the DOMAIN file which has ever had any"
^DIC(19,3372,1,3,0)="activity.  It includes the total number of messages ever received"
^DIC(19,3372,1,4,0)="from or sent to each domain, as well as the number of messages"
^DIC(19,3372,1,5,0)="which are currently queued to be transmitted to each domain."
^DIC(19,3372,25)="ENTER^XMCQH"
^DIC(19,3372,"U")="HISTORICAL QUEUE DATA/STATS RE"
^DIC(19,3373,0)="XMQACTIVE^Actively Transmiting/Receiving Queues Report^^R^11748^^^^^^y^54^^"
^DIC(19,3373,1,0)="^19.06^4^4^3020312^^^^"
^DIC(19,3373,1,1,0)="This report shows only those queues that are currently (right now)"
^DIC(19,3373,1,2,0)="transmitting or receiving messages.  It will state the message"
^DIC(19,3373,1,3,0)="numbers and the approximate line number in progress and the"
^DIC(19,3373,1,4,0)="characters per second."
^DIC(19,3373,20)=""
^DIC(19,3373,25)="ACTIVE^XMCQA"
^DIC(19,3373,"U")="ACTIVELY TRANSMITING/RECEIVING"
^DIC(19,3374,0)="XMQUEUED^Queues with Messages to Transmit Report^^R^11748^^^^^^y^54^^^^"
^DIC(19,3374,1,0)="^19.06^4^4^3020509^^^^"
^DIC(19,3374,1,1,0)="This option produces a report of all those queues that have messages"
^DIC(19,3374,1,2,0)="to go out.  The list does not say whether there is or is not a task"
^DIC(19,3374,1,3,0)="scheduled to send them.  Requeuing them is okay even if there is already"
^DIC(19,3374,1,4,0)="a task to go out."
^DIC(19,3374,15)=""
^DIC(19,3374,20)=""
^DIC(19,3374,25)="ALL^XMCQA"
^DIC(19,3374,"U")="QUEUES WITH MESSAGES TO TRANSM"
^DIC(19,3375,0)="XMSEARCH^Query/Search for Messages^^R^11748^^3111^^^^^54^^1^1"
^DIC(19,3375,1,0)="^19.06^16^16^3020509^^^^"
^DIC(19,3375,1,1,0)="Enables you to find messages sent by you or sent to you,"
^DIC(19,3375,1,2,0)="based on various criteria."
^DIC(19,3375,1,3,0)=""
^DIC(19,3375,1,4,0)="You may search the entire database of existing messages, regardless"
^DIC(19,3375,1,5,0)="of whether they are in one of your baskets or not, or whether you have"
^DIC(19,3375,1,6,0)="terminated them or not.  Such a search may only be made based upon"
^DIC(19,3375,1,7,0)="'Subject start with' a string."
^DIC(19,3375,1,8,0)=""
^DIC(19,3375,1,9,0)="Your search options vastly increase if you confine your search to"
^DIC(19,3375,1,10,0)="messages existing in one (or all) of your baskets.  Such a search"
^DIC(19,3375,1,11,0)="may be based upon any combination of the following:"
^DIC(19,3375,1,12,0)=" 'Subject contains'"
^DIC(19,3375,1,13,0)=" 'Sender is'"
^DIC(19,3375,1,14,0)=" 'Message sent on or after' a certain date"
^DIC(19,3375,1,15,0)=" 'Message sent on or before' a certain date"
^DIC(19,3375,1,16,0)=" 'Message sent to' a certain user"
^DIC(19,3375,15)="D CHECKOUT^XM"
^DIC(19,3375,20)="D CHECKIN^XM"
^DIC(19,3375,25)="FIND^XMJMF"
^DIC(19,3375,"U")="QUERY/SEARCH FOR MESSAGES"
^DIC(19,3376,0)="XMOTHER^Other MailMan Functions^^M^11748^^^^^^^54^^"
^DIC(19,3376,1,0)="^19.06^1^1^2970730^^^^"
^DIC(19,3376,1,0,0,99999999)="^1^99999999"
^DIC(19,3376,1,0,"W")=75
^DIC(19,3376,1,1,0)="This is the mailman option menu for special user activities."
^DIC(19,3376,10,0)="^19.01PI^4^4"
^DIC(19,3376,10,1,0)="6326^^1"
^DIC(19,3376,10,2,0)="6327^^2"
^DIC(19,3376,10,3,0)="3361^^3"
^DIC(19,3376,10,4,0)="149^LML^4"
