^DIC(19,7613,1,5,0)="  Discharge Data Report by Patient  (80) [HBHCRP5]"
^DIC(19,7613,1,6,0)="  Episode of Care/Length of Stay Report  (80) [HBHCRP12]"
^DIC(19,7613,1,7,0)="  Admissions/Discharges by Date Range Report  (132) [HBHCRP7]"
