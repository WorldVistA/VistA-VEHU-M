^DIC(19,7781,0)="FBCH DELETE INVOICE^Delete Inpatient Invoice^^R^1^FBAA LEVEL 1 PMT^^^^^^^^1^1"
^DIC(19,7781,1,0)="^^2^2^2930113^"
^DIC(19,7781,1,1,0)="This option will allow a user to delete an invoice entered in error."
