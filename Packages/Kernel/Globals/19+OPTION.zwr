^DIC(19,16651,"U")="ACTIVATE/INACTIVATE REMINDERS"
^DIC(19,16652,0)="EHM-01473^Add/Edit Reminder Definition^^R^1^^^^^^^534^^^^"
^DIC(19,16652,1,0)="^19.06^19^19^3240328^^^"
^DIC(19,16652,1,1,0)="This option is used to edit the Clinical Reminder Definitions. Several"
^DIC(19,16652,1,2,0)="predefined reminder definitions were distributed with the PCE package"
^DIC(19,16652,1,3,0)="based on the Ambulatory Care EP Preventative Health Maintenance"
^DIC(19,16652,1,4,0)="Guidelines."
^DIC(19,16652,1,5,0)=" "
^DIC(19,16652,1,6,0)="Nationally distributed reminder definitions items all have a ""VA-"""
^DIC(19,16652,1,7,0)="prefix. VA- for Ambulatory Care EP reminders and VA-* for National"
^DIC(19,16652,1,8,0)="Center for Health Promotion reminders. To alter a VA- prefixed reminder"
^DIC(19,16652,1,9,0)="item, first copy it to a different name and then edit the reminder"
^DIC(19,16652,1,10,0)="definition to reflect your site's requirements for the reminder."
^DIC(19,16652,1,11,0)=" "
^DIC(19,16652,1,12,0)="Sites may change anything in a local reminder definition to meet their"
^DIC(19,16652,1,13,0)="needs. Findings at each site may require modification to represent"
^DIC(19,16652,1,14,0)="local use of clinical data."
^DIC(19,16652,1,15,0)=" "
^DIC(19,16652,1,16,0)="The distributed reminder definitions ""Technical Description"" will give"
^DIC(19,16652,1,17,0)="help to the coordinator for ensuring the reminder definition is"
^DIC(19,16652,1,18,0)="modified to reflect local guidelines for reminders."
^DIC(19,16652,1,19,0)="Cloned from ""PXRM DEFINITION EDIT"" option."
^DIC(19,16652,3)=""
^DIC(19,16652,15)=""
^DIC(19,16652,20)=""
^DIC(19,16652,25)="EEDIT^PXRMREDT"
^DIC(19,16652,30)=""
^DIC(19,16652,31)=""
^DIC(19,16652,33)=""
^DIC(19,16652,34)=""
^DIC(19,16652,50)=""
^DIC(19,16652,51)=""
^DIC(19,16652,"U")="ADD/EDIT REMINDER DEFINITION"
^DIC(19,16653,0)="EHM-01474^Inquire about Reminder Definition^^R^1^^^^^^y^534^^^^"
^DIC(19,16653,1,0)="^19.06^3^3^3240328^^^^"
^DIC(19,16653,1,1,0)="Allows a user to display a clinical reminder definition in an easy"
^DIC(19,16653,1,2,0)="to read format."
^DIC(19,16653,1,3,0)="Cloned from ""PXRM DEFINITION INQUIRY"" option."
^DIC(19,16653,3)=""
^DIC(19,16653,25)="REM^PXRMINQ"
^DIC(19,16653,"U")="INQUIRE ABOUT REMINDER DEFINIT"
^DIC(19,16654,0)="EHM-01475^Copy Reminder Definition^^R^1^^^^^^^534^^^^"
^DIC(19,16654,1,0)="^19.06^12^12^3240328^^^^"
^DIC(19,16654,1,1,0)="This option allows the user to copy an existing reminder definition"
^DIC(19,16654,1,2,0)="into a new reminder definition in the Clinical Reminder Definition file"
^DIC(19,16654,1,3,0)="(#811.9). The original reminder definition to be copied is selected"
^DIC(19,16654,1,4,0)="first.  If the original reminder definition is prefixed with ""VA-"", the"
^DIC(19,16654,1,5,0)="""VA-"" will be stripped off the name automatically to create the name"
^DIC(19,16654,1,6,0)="for the new reminder definition. The new name must be unique.  If the"
^DIC(19,16654,1,7,0)="new name is not unique, the user must enter a unique name for the new"
^DIC(19,16654,1,8,0)="reminder definition entry. If no name is provided, the new entry will"
^DIC(19,16654,1,9,0)="not be created.  Once a new name is defined for the new reminder"
^DIC(19,16654,1,10,0)="definition, the new reminder definition can be edited to reflect the"
^DIC(19,16654,1,11,0)="local reminder definition."
^DIC(19,16654,1,12,0)="Cloned from ""PXRM DEFINITION COPY"" option."
^DIC(19,16654,3)=""
^DIC(19,16654,25)="COPYREM^PXRMCOPY"
^DIC(19,16654,"U")="COPY REMINDER DEFINITION"
^DIC(19,16655,0)="EHM-01476^List Reminder Definitions^^R^1^^^^^^^534^^^^"
^DIC(19,16655,1,0)="^^3^3^3240328^"
^DIC(19,16655,1,1,0)="This option provides a brief summary of selected Clinical Reminder"
^DIC(19,16655,1,2,0)="definitions."
