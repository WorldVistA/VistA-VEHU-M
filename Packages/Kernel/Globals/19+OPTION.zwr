^DIC(19,9698,50)="GMRD(126.8,"
^DIC(19,9698,51)=".01;1;2"
^DIC(19,9698,"U")="INTAKE ITEMS"
^DIC(19,9699,0)="GMRY FILE EDIT^Configure I/O Files (ADP Coordinator Only)^^M^10958^^^^^^^502^^1"
^DIC(19,9699,1,0)="^^7^7^2970210^^^^"
^DIC(19,9699,1,1,0)="This menu is provided for the ADP coordinator to configure the following "
^DIC(19,9699,1,2,0)="file entries:"
^DIC(19,9699,1,3,0)="GMRY INPUT TYPE (#126.56), GMRY OUTPUT TYPE (#126.58), GMRY OUTPUT SUBTYPE "
^DIC(19,9699,1,4,0)="(#126.6), GMRY IV SITE (#126.7), GMRY INTAKE ITEMS (#126.8), GMRY NUR IV "
^DIC(19,9699,1,5,0)="SOLUTION (#126.9), GMRY NUR SHIFT/OTHER (#126.95), GMRY IV SITE "
^DIC(19,9699,1,6,0)="DESCRIPTION (#126.72), GMRY IV CATHETER (#126.74) and GMRY IV DC'ED"
^DIC(19,9699,1,7,0)="REASON (#126.76)."
^DIC(19,9699,10,0)="^19.01PI^11^10"
^DIC(19,9699,10,1,0)="9701^1^1"
^DIC(19,9699,10,3,0)="9702^2^2"
