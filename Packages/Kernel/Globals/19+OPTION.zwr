^DIC(19,402,0)="DG REGISTER PATIENT^Register a Patient^^R^1^^^^^^^114^^1^1"
^DIC(19,402,1,0)="^19.06^6^6^3201130^^^^"
^DIC(19,402,1,1,0)="This option is used to process an application for care.  The user"
^DIC(19,402,1,2,0)="may also use this option to establish or edit a specific patient's"
^DIC(19,402,1,3,0)="data base.  After an application for care has been processed the"
^DIC(19,402,1,4,0)="patient should either be dispositioned from care using the DISPOSITION"
^DIC(19,402,1,5,0)="option or the registration should be deleted using the DELETE"
^DIC(19,402,1,6,0)="REGISTRATION option."
