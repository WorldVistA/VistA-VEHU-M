^DIC(19,15137,1,0)="^19.06^8^8^3230908^^^"
^DIC(19,15137,1,1,0)="This report displays data from the Process Insurance Buffer option, "
^DIC(19,15137,1,2,0)="otherwise known as ""the Buffer"". It is real time data that is constantly "
^DIC(19,15137,1,3,0)="changing; therefore, the numbers and dates reflected in this report are "
^DIC(19,15137,1,4,0)="never the same minute to minute, hour by hour, or day by day. This "
^DIC(19,15137,1,5,0)="report output is only accurate to the exact date and time it is produced. "
^DIC(19,15137,1,6,0)="The Insurance Company section of this report is based on free text fields "
^DIC(19,15137,1,7,0)="and may not be reflective of actual category counts due to spelling "
^DIC(19,15137,1,8,0)="errors in the free text Insurance Company field."
^DIC(19,15137,20)=""
^DIC(19,15137,25)="EN^IBCNOR2"
^DIC(19,15137,"U")="DAILY BUFFER REPORT"
