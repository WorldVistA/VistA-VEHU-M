^DIC(19,11501,1,1,0)="Health factors must be mapped to resolution codes using this option if"
^DIC(19,11501,1,2,0)="they are to be included in reminder dialog generated."
^DIC(19,11501,1,3,0)=" "
^DIC(19,11501,1,4,0)="Reminder dialog generation creates a question (dialog element) in the"
^DIC(19,11501,1,5,0)="reminder dialog for each resolution status entered in this file against"
^DIC(19,11501,1,6,0)="the health factor. Question text and additional prompts are derived from"
^DIC(19,11501,1,7,0)="the finding parameters file and may be modified by option PXRM FINDING"
^DIC(19,11501,1,8,0)="PARAMETERS."
