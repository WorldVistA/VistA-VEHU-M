^DIC(19,16975,0)="EHM-01796^Clear Electronic signature code^^R^1^^^^^^^^^^^"
^DIC(19,16975,1,0)="^^3^3^3240328^^"
^DIC(19,16975,1,1,0)="This option allows the site manager to clear (delete) a users electronic"
^DIC(19,16975,1,2,0)=" signature code so they may enter a new one."
^DIC(19,16975,1,3,0)="Cloned from ""XUSESIG CLEAR"" option."
