^DIC(19,8471,1,1,0)="List of veterans who served in the persian gulf with pathology specimens."
^DIC(19,8471,25)="EN^LRAPDPT"
^DIC(19,8471,"U")="PERSIAN GULF VETERANS"
^DIC(19,8472,0)="LRAPAFIP^JPC registries^^M^1^^^^^^^"
