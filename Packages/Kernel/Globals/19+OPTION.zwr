^DIC(19,7367,1,2,0)="The background job updates the admissions in the selected time"
^DIC(19,7367,1,3,0)="frame, by creating IRT entries for the standard deficiencies for"
^DIC(19,7367,1,4,0)="the facility."
^DIC(19,7367,20)="D EN^DGJBGJ"
^DIC(19,7367,"U")="IRT UPDATE STD. DEFICIENCIES"
