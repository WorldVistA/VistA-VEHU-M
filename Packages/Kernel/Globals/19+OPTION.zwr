^DIC(19,8368,"U")="IVM OUTPUT MENU"
^DIC(19,8369,0)="IVM SYS MGR MENU^IVM System Manager's Menu^^M^.5^IVM SYS^^^^^^312"
^DIC(19,8369,1,0)="^^2^2^2940615^^^^"
^DIC(19,8369,1,1,0)="This menu option is used for options which are needed by the IRM staff."
^DIC(19,8369,1,2,0)="The menu is locked with the 'IVM SYS' key."
^DIC(19,8369,10,0)="^19.01PI^3^3"
^DIC(19,8369,10,1,0)="8364^PAR"
^DIC(19,8369,10,2,0)="8365^TRN"
^DIC(19,8369,10,3,0)="8366^PUR"
