^DIC(19,9412,0)="PRCPW MANAGER MENU^Manager For Supply Warehouse Inventory Point Menu^^M^11740^PRCPW MGRKEY^^^^^^^^1"
^DIC(19,9412,1,0)="^^3^3^2920211^^^^"
^DIC(19,9412,1,1,0)="This menu contains options for editing warehouse control parameters,"
^DIC(19,9412,1,2,0)="calculating/updating due-ins and due-outs, reprinting an issue book"
^DIC(19,9412,1,3,0)="picking ticket, and for creating/transmitting ISMS code sheets."
