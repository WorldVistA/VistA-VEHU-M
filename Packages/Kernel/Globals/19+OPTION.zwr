^DIC(19,7370,0)="SDAM PROVIDER/DIAGNOSIS REPORT^Provider/Diagnosis Report^^A^1253^^^^^^^16^^1"
^DIC(19,7370,1,0)="^^9^9^2980122^^^^"
^DIC(19,7370,1,1,0)=" "
^DIC(19,7370,1,2,0)="This report sorts by Division and Outpatient Encounter Date.  It also"
^DIC(19,7370,1,3,0)="permits the selection of two additional sort levels by the user; Provider,"
^DIC(19,7370,1,4,0)="Diagnosis, Patient, Clinic, or Stop Code.  The printed report is formatted"
^DIC(19,7370,1,5,0)="for 132 columns, so output to a terminal will wrap around itself.  Output"
^DIC(19,7370,1,6,0)="is the patients name and last four of his/her SSN, the encounter date and"
^DIC(19,7370,1,7,0)="time, clinic name and stop code, provider's and diagnostic codes.  This"
^DIC(19,7370,1,8,0)="report uses the OUTPATIENT ENCOUNTER File (#409.68), V PROVIDER"
^DIC(19,7370,1,9,0)="File, (#9000010.06), and the V POV File, (#9000010.07)."
^DIC(19,7370,20)="D START^SDAMODO"
^DIC(19,7370,"U")="PROVIDER/DIAGNOSIS REPORT"
