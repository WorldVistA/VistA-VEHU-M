^DIC(19,9400,1,1,0)="This menu contains various reports that allow the user to manage"
^DIC(19,9400,1,2,0)="his/her inventory, and to track distribution of expendable supplies."
^DIC(19,9400,1,3,0)="This menu contains reports which can be used by the secondary"
