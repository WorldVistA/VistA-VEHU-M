^DIC(19,1645,1,2,0)="codes as specified by the 'Diagnostic Code Enter/Edit' function."
^DIC(19,1645,25)="5^RAMAINP"
^DIC(19,1645,"U")="DIAGNOSTIC CODE LIST"
^DIC(19,1646,0)="RA COMPRINT^Complication Type List^^R^11712^^^^^^^"
^DIC(19,1646,1,0)="^^2^2^2890221^^^^"
^DIC(19,1646,1,1,0)="This function allows the user to obtain a list of the complication"
^DIC(19,1646,1,2,0)="types as specified by the 'Complication Type Enter/Edit' function."
^DIC(19,1646,25)="7^RAMAINP"
^DIC(19,1646,"U")="COMPLICATION TYPE LIST"
^DIC(19,1647,0)="RA FLASHFORMP^Label/Header/Footer Format List^^R^11712^^^^^^^"
^DIC(19,1647,1,0)="^^2^2^2890221^^^^"
^DIC(19,1647,1,1,0)="This function allows the user to obtain a list of the flash cards/labels"
^DIC(19,1647,1,2,0)="as specified by the 'Flash Card/Label Formatter' function."
^DIC(19,1647,25)="6^RAMAINP"
^DIC(19,1647,"U")="LABEL/HEADER/FOOTER FORMAT LIS"
^DIC(19,1648,0)="RA SHARINGP^Sharing Agreement/Contract List^^R^11712^^^^^^^"
