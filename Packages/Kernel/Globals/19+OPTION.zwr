^DIC(19,16975,"U")="CLEAR ELECTRONIC SIGNATURE COD"
^DIC(19,16976,0)="EHM-01797^Grant Access by Profile^^R^1^^^^^^^^^^^"
^DIC(19,16976,1,0)="^^12^12^3240328^"
^DIC(19,16976,1,1,0)="This option allows the adding or editing of one or more users according"
^DIC(19,16976,1,2,0)="to an existing user profile.  The complete profile of the actual or"
^DIC(19,16976,1,3,0)="dummy user, menus and keys included, is copied to the other users.  For"
^DIC(19,16976,1,4,0)="new users, security forms will be generated.  (Use the Help Processor"
^DIC(19,16976,1,5,0)="menu to edit the XUSER COMPUTER ACCOUNT help frame containing the text"
^DIC(19,16976,1,6,0)="of the forms.)  To route forms, be sure that the user profile has a"
^DIC(19,16976,1,7,0)="service/section and that the corresponding entry in the Service/Section"
^DIC(19,16976,1,8,0)="file has a Coordinator.  "
^DIC(19,16976,1,9,0)=" "
^DIC(19,16976,1,10,0)="This option is locked with the XUMGR key and is restricted for use by"
^DIC(19,16976,1,11,0)="systems management staff."
^DIC(19,16976,1,12,0)="Cloned from ""XUSERBLK"" option."
