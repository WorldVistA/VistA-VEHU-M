^DIC(19,1694,0)="RA UNVERIFY^Unverify a Report for Amendment^^R^11720^RA RPTMGR^^^^^^"
^DIC(19,1694,1,0)="^19.06^7^7^3180613^^^"
^DIC(19,1694,1,1,0)="This option allows the supervisor to unverify a report.  This option"
^DIC(19,1694,1,2,0)="should not be given to other users.  As the report is unverified, a copy"
^DIC(19,1694,1,3,0)="of it is saved for medical/legal purposes, and the report can be amended"
^DIC(19,1694,1,4,0)="using any option that allows report edit.  After the amended report is"
^DIC(19,1694,1,5,0)="re-verified, displays and printouts of the report will always have a"
^DIC(19,1694,1,6,0)="notation at the top to call attention to the fact that it has been"
^DIC(19,1694,1,7,0)="amended."
^DIC(19,1694,25)="UNVER^RARTE1(0)"
^DIC(19,1694,"U")="UNVERIFY A REPORT FOR AMENDMEN"
