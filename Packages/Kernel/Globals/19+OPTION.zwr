^DIC(19,14430,1,0)="^^5^5^3130425^"
^DIC(19,14430,1,1,0)="This function allows the user to see a list of the patient's registered"
^DIC(19,14430,1,2,0)="exams with radiation dosage information. The exams are presented in"
^DIC(19,14430,1,3,0)="reverse chronological order. A specific exam can be selected from the"
^DIC(19,14430,1,4,0)="list. When an exam is selected, a detailed display of the exam is"
^DIC(19,14430,1,5,0)="presented."
^DIC(19,14430,25)="EN^RADRPT1"
^DIC(19,14430,"U")="EXAM PROFILE WITH RADIATION DO"
