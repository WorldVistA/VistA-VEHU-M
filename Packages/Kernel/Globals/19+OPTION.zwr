^DIC(19,1054,1,0)="^19.06^2^2^3030603^^^^"
^DIC(19,1054,1,1,0)="This option allows for the ordering of a tubefeeding for an"
^DIC(19,1054,1,2,0)="inpatient."
^DIC(19,1054,25)="FHORT1"
^DIC(19,1054,"U")="ORDER TUBEFEEDING"
^DIC(19,1055,0)="FHOREL1^List Early/Late Trays^^R^10000000020^^^^^^^"
^DIC(19,1055,1,0)="^19.06^4^4^3040524^^^^"
^DIC(19,1055,1,1,0)="This option will list, for a specified date and meal, all"
^DIC(19,1055,1,2,0)="early and late tray orders."
^DIC(19,1055,1,3,0)=""
^DIC(19,1055,1,4,0)="As of Version 5.5, this report will list outpatient E/L trays as well."
^DIC(19,1055,25)="FHORE2"
^DIC(19,1055,"U")="LIST EARLY/LATE TRAYS"
^DIC(19,1056,0)="FHOREL2^Order Early/Late Tray^^R^10000000020^^^^^^^"
^DIC(19,1056,1,0)="^19.06^5^5^3030513^^^^"
^DIC(19,1056,1,1,0)="This option will allow the ordering of an early or late tray"
^DIC(19,1056,1,2,0)="for a patient. A series of trays, for specified days of the"
^DIC(19,1056,1,3,0)="week, may also be ordered in the case of patients on chemotherapy"
^DIC(19,1056,1,4,0)="or radiation therapy needing early or late trays on a"
^DIC(19,1056,1,5,0)="consistent basis."
^DIC(19,1056,25)="FHORE1"
^DIC(19,1056,"U")="ORDER EARLY/LATE TRAY"
^DIC(19,1057,0)="FHOREL3^Cancel Early/Late Tray^^R^10000000020^^^^^^^"
^DIC(19,1057,1,0)="^^2^2^2880717^"
^DIC(19,1057,1,1,0)="This option will allow the cancellation of an early or late"
^DIC(19,1057,1,2,0)="tray order. Optionally, all future orders may be cancelled."
^DIC(19,1057,25)="FHORE3"
^DIC(19,1057,"U")="CANCEL EARLY/LATE TRAY"
^DIC(19,1058,0)="FHORTF4^Cancel Tubefeeding Order^^R^10000000020^^^^^^^"
^DIC(19,1058,1,0)="^^2^2^2880717^"
^DIC(19,1058,1,1,0)="This option allows for the cancellation of an existing"
^DIC(19,1058,1,2,0)="tubefeeding order."
^DIC(19,1058,25)="EN3^FHORT2"
^DIC(19,1058,"U")="CANCEL TUBEFEEDING ORDER"
^DIC(19,1059,0)="FHNO8^Enter/Edit Bulk Ward Feedings^^R^10000000020^^^^^^^"
^DIC(19,1059,1,0)="^19.06^2^2^3020729^^^^"
^DIC(19,1059,1,1,0)="This option allows for adding/editing bulk feeding items to be"
^DIC(19,1059,1,2,0)="delivered to each ward."
^DIC(19,1059,25)="FHNO4"
^DIC(19,1059,"U")="ENTER/EDIT BULK WARD FEEDINGS"
^DIC(19,1061,0)="FHPRO2^Enter/Edit Nutrition Locations^^R^10000000020^^^^^^^"
^DIC(19,1061,1,0)="^19.06^4^4^3041109^^^^"
^DIC(19,1061,1,1,0)="This option allows for creating/editing of locations in the Nutrition"
^DIC(19,1061,1,2,0)="Location (#119.6) file. Locations are selected from those in either the"
^DIC(19,1061,1,3,0)="MAS WARD (#42) or HOSPITAL LOCATION (#44) files. As of Version 5.5, this"
^DIC(19,1061,1,4,0)="option allows creation/editing of outpatient locations."
^DIC(19,1061,25)="EN2^FHPRO"
^DIC(19,1061,"U")="ENTER/EDIT NUTRITION LOCATIONS"
^DIC(19,1063,0)="FHORD7^List Diets^^R^10000000020^^^^^^^"
^DIC(19,1063,1,0)="^^2^2^2880714^"
^DIC(19,1063,1,1,0)="This option will list all diets contained in the Diets file (111)"
^DIC(19,1063,1,2,0)="along with all associated data elements."
^DIC(19,1063,25)="EN2^FHORD"
^DIC(19,1063,"U")="LIST DIETS"
^DIC(19,1064,0)="FHORC5^Enter/Edit Ward Assignments^^R^10000000020^^^^^^^"
^DIC(19,1064,1,0)="^^3^3^2880716^^"
^DIC(19,1064,1,1,0)="This option allows for the assignment of clinicians to each"
^DIC(19,1064,1,2,0)="ward. This assignment will be used to assign consults arising"
^DIC(19,1064,1,3,0)="from that ward to the indicated clinician."
^DIC(19,1064,25)="EN9^FHORC5"
^DIC(19,1064,99)="55481,41901"
^DIC(19,1064,"U")="ENTER/EDIT WARD ASSIGNMENTS"
^DIC(19,1066,0)="FHORD9^Patient Profile^^R^10000000020^^^^^^^"
^DIC(19,1066,1,0)="^19.06^8^8^3040908^^^^"
^DIC(19,1066,1,1,0)="This option will produce a comprehensive display of most"
^DIC(19,1066,1,2,0)="dietetic orders and data associated with a patient's"
^DIC(19,1066,1,3,0)="admission. It includes diet orders, active or saved consults,"
^DIC(19,1066,1,4,0)="early/late tray requests for the next 72 hours, standing"
^DIC(19,1066,1,5,0)="orders, tubefeedings, supplemental feedings, etc."
^DIC(19,1066,1,6,0)=""
^DIC(19,1066,1,7,0)="As of Version 5.5, this report will include outpatient data"
^DIC(19,1066,1,8,0)="as well, including recurring meals, special meals and guest meals."
^DIC(19,1066,25)="FHORD6"
^DIC(19,1066,"U")="PATIENT PROFILE"
^DIC(19,1067,0)="FHNO9^Review Bulk Nutrition Location Feedings^^R^10000000020^^^^^^^119"
^DIC(19,1067,1,0)="^19.06^2^2^3040623^^^^"
