^DIC(19,15537,0)="EHM-00358^Clear Current Patient List^^A^1^^^^^^^^^1^^"
^DIC(19,15537,1,0)="^19.06^5^5^3240328^^^^"
^DIC(19,15537,1,1,0)="Use this option to clear the current patient list from your work"
^DIC(19,15537,1,2,0)="area so that you can work with another list.  The list that you"
^DIC(19,15537,1,3,0)="clear with this option will still be available to work with at another"
^DIC(19,15537,1,4,0)="time if it was stored away at the time the list was defined."
^DIC(19,15537,1,5,0)="Cloned from ""ORLP CLEAR"" option."
