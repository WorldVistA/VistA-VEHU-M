^DIC(19,14010,1,0)="^^3^3^3100329^"
^DIC(19,14010,1,1,0)="This option should be scheduled weekly or monthly to purge the error "
^DIC(19,14010,1,2,0)="summary of old errors.  It only purges entries where the last error was "
^DIC(19,14010,1,3,0)="over 90 days ago."
^DIC(19,14010,25)="PURGE^XTERSUM1"
^DIC(19,14010,200.9)="y"
^DIC(19,14010,"U")="PURGE ERROR TRAP SUMMARY"
