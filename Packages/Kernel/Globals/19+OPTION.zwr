^DIC(19,10982,0)="ORK REC PROCESSING FLAG^Enable/Disable My Order Checks^^R^11720^^^^^^^"
^DIC(19,10982,1,0)="^19.06^1^1^3000516^^^"
^DIC(19,10982,1,1,0)="Code indicating the processing flag for the current User and order check."
^DIC(19,10982,25)="PFLAG^ORKREC"
^DIC(19,10982,"U")="ENABLE/DISABLE MY ORDER CHECKS"
^DIC(19,10983,0)="ORK CT LIMIT HT^CT Scanner Height Limit^^R^11712^^^^^^^"
^DIC(19,10983,1,0)="^^3^3^2960815^^^^"
^DIC(19,10983,1,1,0)="This option checks to determine if a patient is too tall to be"
^DIC(19,10983,1,2,0)="examined by the CAT Scanner.  Enter the maximum height (in inches) of"
^DIC(19,10983,1,3,0)="a patient."
^DIC(19,10983,25)="CTLIMH^ORKMGR"
^DIC(19,10983,"U")="CT SCANNER HEIGHT LIMIT"
^DIC(19,10984,0)="ORK CT LIMIT WT^CT Scanner Weight Limit^^R^11712^^^^^^^"
^DIC(19,10984,1,0)="^^3^3^2960815^^"
^DIC(19,10984,1,1,0)="This option checks to determine if a patient weights too much to be safely"
^DIC(19,10984,1,2,0)="examined by the CAT Scanner.  Enter the maximum weight (in pounds) of a"
^DIC(19,10984,1,3,0)="patient."
^DIC(19,10984,25)="CTLIMW^ORKMGR"
^DIC(19,10984,"U")="CT SCANNER WEIGHT LIMIT"
^DIC(19,10985,0)="ORK MRI LIMIT HT^MRI Scanner Height Limit^^R^11712^^^^^^^"
^DIC(19,10985,1,0)="^^3^3^2960815^^^"
^DIC(19,10985,1,1,0)="This option checks to determine if a patient is too tall to be safely"
^DIC(19,10985,1,2,0)="examined by the MRI Scanner.  Enter the maximum height (in inches) of a"
^DIC(19,10985,1,3,0)="patient."
^DIC(19,10985,25)="MRLIMH^ORKMGR"
^DIC(19,10985,"U")="MRI SCANNER HEIGHT LIMIT"
^DIC(19,10986,0)="ORK MRI LIMIT WT^MRI Scanner Weight Limit^^R^11712^^^^^^^"
^DIC(19,10986,1,0)="^^3^3^2960815^^"
^DIC(19,10986,1,1,0)="This option checks to determine if a patient weights too much to be"
^DIC(19,10986,1,2,0)="safely examined by the MRI scanner.  Enter the maximum weight (in pounds) "
^DIC(19,10986,1,3,0)="for the patient."
^DIC(19,10986,25)="MRLIMW^ORKMGR"
^DIC(19,10986,"U")="MRI SCANNER WEIGHT LIMIT"
^DIC(19,10987,0)="ORK DUP ORDER RANGE OI^Orderable Item Duplicate Order Range^^R^11712^^^^^^^"
^DIC(19,10987,1,0)="^^1^1^2960815^^"
^DIC(19,10987,1,1,0)="The number of hours back in time to look for duplicate orders.  "
^DIC(19,10987,25)="DUPOR^ORKMGR"
^DIC(19,10987,"U")="ORDERABLE ITEM DUPLICATE ORDER"
^DIC(19,10988,0)="ORK SYSTEM ENABLE/DISABLE^Enable or Disable Order Checking System^^R^11712^^^^^^^"
^DIC(19,10988,1,0)="^^4^4^2960815^^"
^DIC(19,10988,1,1,0)="Determines if any order checking will occur.  'E' or 'Enable' indicates"
^DIC(19,10988,1,2,0)="order checking is enabled and running.  'D' or 'Disabled' indicates order"
^DIC(19,10988,1,3,0)="checking is disabled and not running.  Can be set at the institution, System "
^DIC(19,10988,1,4,0)="or Package level."
^DIC(19,10988,25)="SYSEN^ORKMGR"
^DIC(19,10988,"U")="ENABLE OR DISABLE ORDER CHECKI"
^DIC(19,10989,0)="OR CPRS GUI CHART^CPRSChart version 1.33.214.1^^B^1^^^^^^^"
^DIC(19,10989,1,0)="2^19.06^2^2^3250929^^^^"
