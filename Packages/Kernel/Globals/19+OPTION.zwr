^DIC(19,6689,0)="PSD DRUG LOC EDIT^Enter/Edit CS Drug Location Codes^^R^11595^^^^^^^276"
^DIC(19,6689,1,0)="^^2^2^2930224^^"
^DIC(19,6689,1,1,0)="This option allows editing of the codes used to define the locations of"
^DIC(19,6689,1,2,0)="stocked drugs in Narcotic Areas of Use or in the pharmacy."
^DIC(19,6689,25)="PSDCODE"
^DIC(19,6689,"U")="ENTER/EDIT CS DRUG LOCATION CO"
^DIC(19,6690,0)="PSD NAOU EDIT^Create/Edit the Narcotic Area of Use^^R^11595^PSD PARAM^^^^^^276"
^DIC(19,6690,1,0)="^^1^1^2930224^^"
^DIC(19,6690,1,1,0)="This option allows the user to initially define the Narcotic Areas of Use."
^DIC(19,6690,25)="PSDEN"
^DIC(19,6690,99)="55232,47281"
^DIC(19,6690,"U")="CREATE/EDIT THE NARCOTIC AREA "
^DIC(19,6691,0)="PSD STOCK DRUG EDIT^Stock CS Drugs - Enter/Edit^^R^11595^^^^^^^276"
^DIC(19,6691,1,0)="^^3^3^2940914^^^^"
^DIC(19,6691,1,1,0)="Provides access to enter or edit drugs stocked in the Narcotic Area of Use."
^DIC(19,6691,1,2,0)="This is how stocked drugs within an NAOU are added or changed."
^DIC(19,6691,1,3,0)="Duplicate entries are not allowed."
^DIC(19,6691,25)="PSDSTK"
^DIC(19,6691,"U")="STOCK CS DRUGS - ENTER/EDIT"
