^DIC(19,16105,"U")="HEALTH SUMMARY OBJECTS MENU"
^DIC(19,16106,0)="EHM-00927^Create/Modify Health Summary Object^^R^1^^^^^^^^^^^"
^DIC(19,16106,1,0)="^19.06^5^5^3240328^^^^"
^DIC(19,16106,1,1,0)="This option allows the user to create or modify a Health "
^DIC(19,16106,1,2,0)="Summary Object.  Objects are Health Summaries that may have "
^DIC(19,16106,1,3,0)="their headers suppressed so they may be inserted into another"
^DIC(19,16106,1,4,0)="document."
^DIC(19,16106,1,5,0)="Cloned from ""GMTS OBJ ENTER/EDIT"" option."
^DIC(19,16106,3)=""
^DIC(19,16106,25)="OBJ^GMTSOBJ"
^DIC(19,16106,"U")="CREATE/MODIFY HEALTH SUMMARY O"
^DIC(19,16107,0)="EHM-00928^Test a Health Summary Object^^R^1^^^^^^^^^^^"
^DIC(19,16107,1,0)="^19.06^4^4^3240328^^^"
^DIC(19,16107,1,1,0)="This option allows the user test a Health Summary Object by "
^DIC(19,16107,1,2,0)="displaying the Object to the screen exactly as it would appear "
^DIC(19,16107,1,3,0)="inserted in another document."
^DIC(19,16107,1,4,0)="Cloned from ""GMTS OBJ TEST"" option."
^DIC(19,16107,3)=""
^DIC(19,16107,25)="TEST^GMTSOBJ"
^DIC(19,16107,"U")="TEST A HEALTH SUMMARY OBJECT"
^DIC(19,16108,0)="EHM-00929^Inquire about a Health Summary Object^^R^1^^^^^^^^^^^"
^DIC(19,16108,1,0)="^19.06^3^3^3240328^^^^"
^DIC(19,16108,1,1,0)="Display a Health Summary Object from file 142.5, to include "
^DIC(19,16108,1,2,0)="an example of the object."
^DIC(19,16108,1,3,0)="Cloned from ""GMTS OBJ INQ"" option."
^DIC(19,16108,3)=""
^DIC(19,16108,25)="INQ^GMTSOBJ"
^DIC(19,16108,"U")="INQUIRE ABOUT A HEALTH SUMMARY"
^DIC(19,16109,0)="EHM-00930^Delete Health Summary Object^^R^1^^^^^^^^^^^"
^DIC(19,16109,1,0)="^19.06^4^4^3240328^^"
^DIC(19,16109,1,1,0)="This option is used to delete a Health Summary Object that"
^DIC(19,16109,1,2,0)="you created.  You may not delete Health Summary Objects "
^DIC(19,16109,1,3,0)="created by other people."
^DIC(19,16109,1,4,0)="Cloned from ""GMTS OBJ DELETE"" option."
^DIC(19,16109,3)=""
^DIC(19,16109,25)="DEL^GMTSOBJ"
^DIC(19,16109,"U")="DELETE HEALTH SUMMARY OBJECT"
^DIC(19,16110,0)="EHM-00931^Export/Import a Health Summary Object^^M^1^^^^^^^^^^^"
^DIC(19,16110,1,0)="^19.06^5^5^3240328^^"
^DIC(19,16110,1,1,0)="This menu contains options used to either export a Health"
^DIC(19,16110,1,2,0)="Summary Object to a Mailman message, or import an Health "
^DIC(19,16110,1,3,0)="Summary Object by reading the data unpacked from a Mainman"
^DIC(19,16110,1,4,0)="message using the Packman Utilities."
^DIC(19,16110,1,5,0)="Cloned from ""GMTS OBJ EXPORT/IMPORT"" option."
^DIC(19,16110,3)=""
^DIC(19,16110,10,0)="^19.01IP^2^2"
^DIC(19,16110,10,1,0)="16111^1^1"
^DIC(19,16110,10,2,0)="16112^2^2"
^DIC(19,16110,10,"B",16111,1)=""
^DIC(19,16110,10,"B",16112,2)=""
^DIC(19,16110,10,"C",1,1)=""
^DIC(19,16110,10,"C",2,2)=""
^DIC(19,16110,99)="67411,49176"
^DIC(19,16110,"U")="EXPORT/IMPORT A HEALTH SUMMARY"
^DIC(19,16111,0)="EHM-00932^Export a Health Summary Object^^R^1^^^^^^^^^^^"
^DIC(19,16111,1,0)="^19.06^5^5^3240328^^^"
^DIC(19,16111,1,1,0)="This option will allow a user to export a Health Summary "
^DIC(19,16111,1,2,0)="Object, and its corresponding Health Summary Type to a "
^DIC(19,16111,1,3,0)="Mailman message which can be sent to other accounts/sites"
^DIC(19,16111,1,4,0)="for import."
^DIC(19,16111,1,5,0)="Cloned from ""GMTS OBJ EXPORT"" option."
^DIC(19,16111,3)=""
^DIC(19,16111,25)="EXP^GMTSOBJ"
^DIC(19,16111,"U")="EXPORT A HEALTH SUMMARY OBJECT"
^DIC(19,16112,0)="EHM-00933^Import/Install a Health Summary Object^^R^1^^^^^^^^^^^"
^DIC(19,16112,1,0)="^19.06^11^11^3240328^^^"
^DIC(19,16112,1,1,0)="This option is used to install a Health Summary Object "
^DIC(19,16112,1,2,0)="exported using the GMTS OBJ EXPORT option.  The incoming "
^DIC(19,16112,1,3,0)="Object must first be unpacked from the incoming Mailman "
^DIC(19,16112,1,4,0)="message using Packman utilities.  Then this option is used "
^DIC(19,16112,1,5,0)="to install the object into the Health Summary files.  "
^DIC(19,16112,1,6,0)="If there is a Health Summary Type with the same name as "
^DIC(19,16112,1,7,0)="the Health Summary being imported, then you will be prompted"
^DIC(19,16112,1,8,0)="to either use the existing Health Summary Type, or to "
^DIC(19,16112,1,9,0)="rename the incoming Health Summary Type.  At no time will "
^DIC(19,16112,1,10,0)="an existing Health Summary Type be over written."
^DIC(19,16112,1,11,0)="Cloned from ""GMTS OBJ IMPORT/INSTALL"" option."
^DIC(19,16112,3)=""
^DIC(19,16112,25)="INS^GMTSOBJ"
^DIC(19,16112,"U")="IMPORT/INSTALL A HEALTH SUMMAR"
^DIC(19,16113,0)="EHM-00934^Check Medication Reconciliation Configuration^^R^1^^^^^^^160^^^^"
^DIC(19,16113,1,0)="^^4^4^3240328^"
^DIC(19,16113,1,1,0)="This option allows a site to confirm that the setup of Health Summary "
^DIC(19,16113,1,2,0)="Types is consistent with the intent of the Medication Reconciliation "
^DIC(19,16113,1,3,0)="approach for use as the 'Essential Med List for Review'."
^DIC(19,16113,1,4,0)="Cloned from ""GMTS PS MED RECON CONFIG CHECK"" option."
^DIC(19,16113,3)=""
^DIC(19,16113,25)="EN1^GMTSPSCK"
^DIC(19,16113,"U")="CHECK MEDICATION RECONCILIATIO"
