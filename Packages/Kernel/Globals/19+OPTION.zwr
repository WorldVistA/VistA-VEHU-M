^DIC(19,16937,1,0)="^19.06^3^3^3240328^^^^"
^DIC(19,16937,1,1,0)="This option lists, by file number, those users who have access to the"
^DIC(19,16937,1,2,0)="range of files selected and what that access is."
^DIC(19,16937,1,3,0)="Cloned from ""XUFILELIST"" option."
