^DIC(19,16795,1,4,0)="reminders drawer is available on the notes tab for selecting reminders."
^DIC(19,16795,1,5,0)="When a reminder is selected, a dialog box opens with the reminders' dialog"
^DIC(19,16795,1,6,0)="for point and click resolution processing."
^DIC(19,16795,1,7,0)="Cloned from ""PXRM GUI REMINDERS ACTIVE"" option."
