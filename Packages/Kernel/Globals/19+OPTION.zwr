^DIC(19,13711,0)="XTMUNIT GROUP EDIT^MUnit Test Group edit^^E^10000000020^^^^^^^349"
^DIC(19,13711,1,0)="^19.06^6^6^3031030^^^"
^DIC(19,13711,1,1,0)="This option can be used to maintain a listing of unit tests related to a "
^DIC(19,13711,1,2,0)="specific topic.  The Group identifies the topic, and the unit tests "
^DIC(19,13711,1,3,0)="related to that topic are added in the multiple.  Unit Tests can be run "
^DIC(19,13711,1,4,0)="by selecting a group, and all unit tests included in the multiple will be "
^DIC(19,13711,1,5,0)="used for the test.  In addition, any other references under the XTROU tag "
^DIC(19,13711,1,6,0)="in any of the included test routines will be included in the run."
^DIC(19,13711,30)="XTV(8992.8,"
^DIC(19,13711,31)="AEMQL"
^DIC(19,13711,50)=8992.8
^DIC(19,13711,51)=".01;1"
^DIC(19,13711,99.1)="59472,40730"
^DIC(19,13711,"U")="MUNIT TEST GROUP EDIT"
^DIC(19,13712,0)="XTMUNIT GROUP RUN^Run MUnit Tests from Test Groups^^R^10000000020^^^^^^^349"
^DIC(19,13712,1,0)="^^2^2^3031030^"
^DIC(19,13712,1,1,0)="Provides a means of initiating a unit test run from the menu system based "
^DIC(19,13712,1,2,0)="on entries in the MUNIT TEST GROUP file (#8992.8)."
^DIC(19,13712,25)="PICKSET^XTMUNIT"
^DIC(19,13712,99.1)="59472,49965"
^DIC(19,13712,"U")="RUN MUNIT TESTS FROM TEST GROU"
