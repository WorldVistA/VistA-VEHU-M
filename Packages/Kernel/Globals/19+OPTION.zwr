^DIC(19,5570,"U")="LIST HEALTH SUMMARY TYPES"
^DIC(19,5571,0)="GMTS HS BY LOC PARAMETERS^Set-up Batch Print Locations^^R^.5^^^^^^^160"
^DIC(19,5571,1,0)="^^15^15^2950816^"
^DIC(19,5571,1,1,0)="Allows the user to set-up Health Summary Types to be batch printed nightly"
^DIC(19,5571,1,2,0)="for all patients at a specified hospital location."
^DIC(19,5571,1,3,0)=" "
^DIC(19,5571,1,4,0)="Location may be a ward or a clinic. If location is a clinic, the user is"
^DIC(19,5571,1,5,0)="asked to specify 'Print Days Ahead.' Health Summaries will then be printed"
^DIC(19,5571,1,6,0)="for all patients with appointments that many days in the future."
^DIC(19,5571,1,7,0)=" "
^DIC(19,5571,1,8,0)="To generate summaries, this option requires that option GMTS TASK STARTUP"
^DIC(19,5571,1,9,0)="be queued to run nightly.  Summaries should then be printed during the"
^DIC(19,5571,1,10,0)="night and be ready for distribution by early morning. Thus, 0 Print Days"
^DIC(19,5571,1,11,0)="Ahead means summaries should be ready to distribute by early morning of"
^DIC(19,5571,1,12,0)="day of clinic appointment."
^DIC(19,5571,1,13,0)=" "
^DIC(19,5571,1,14,0)="For ease in separating printouts queued to the same device, a location"
^DIC(19,5571,1,15,0)="banner appears in front of each locations Health Summaries."
^DIC(19,5571,25)="GMTSPP"
^DIC(19,5571,99)="55689,37491"
^DIC(19,5571,"U")="SET-UP BATCH PRINT LOCATIONS"
^DIC(19,5572,0)="GMTS TASK STARTUP^Startup Task for nightly batch printing^^R^.5^^^^^^^160"
^DIC(19,5572,1,0)="^^24^24^2950816^^"
^DIC(19,5572,1,1,0)="This option should be queued to run nightly by the site manager.  Each"
^DIC(19,5572,1,2,0)="time it runs, it uses parameters set under GMTS HS BY LOC PARAMETERS"
^DIC(19,5572,1,3,0)="option and queues a task to run now for each set of parameters meeting a"
^DIC(19,5572,1,4,0)="certain criterion."
^DIC(19,5572,1,5,0)=" "
^DIC(19,5572,1,6,0)="When this task runs, it generates Health Summaries of the specified Health"
^DIC(19,5572,1,7,0)="Summary Type for each patient at the specified location and prints them on"
^DIC(19,5572,1,8,0)="the specified device.  For ease in separating printout queued to the same"
^DIC(19,5572,1,9,0)="device, a location banner page appears in front of each set of Health"
^DIC(19,5572,1,10,0)="Summaries. "
^DIC(19,5572,1,11,0)=" "
^DIC(19,5572,1,12,0)="A set of parameters consists of Hospital Location, Health Summary Type,"
^DIC(19,5572,1,13,0)="Device for Nightly Print, and if Location is a clinic, Print Days Ahead."
^DIC(19,5572,1,14,0)=" "
^DIC(19,5572,1,15,0)="Criterion for queueing task: if location is a clinic, option will queue a"
^DIC(19,5572,1,16,0)="task for that set of parameters ONLY if clinic meets on Desired"
^DIC(19,5572,1,17,0)="Appointment Day.  Summaries are printed during the night and should be"
^DIC(19,5572,1,18,0)="ready to distribute by early morning. Thus, Desired Appointment Day= (Day"
^DIC(19,5572,1,19,0)="Summaries are ready to distribute)+(Print Days Ahead).  If clinic meets on"
^DIC(19,5572,1,20,0)="Desired Appointment Day, task is queued and Summaries are printed for each"
^DIC(19,5572,1,21,0)="patient with an appointment on that day."
^DIC(19,5572,1,22,0)=" "
^DIC(19,5572,1,23,0)="To see a list of sets of parameters which may spawn tasks, site manager"
^DIC(19,5572,1,24,0)="should run option GMTS TASK LOCATIONS LIST."
^DIC(19,5572,25)="MAIN^GMTSPNJ"
^DIC(19,5572,99)="55691,49119"
^DIC(19,5572,200)="^^"
^DIC(19,5572,200.9)="y"
^DIC(19,5572,"U")="STARTUP TASK FOR NIGHTLY BATCH"
^DIC(19,5573,0)="GMTS HS BY LOC^Hospital Location Health Summary^^R^.5^^^^^n^^160"
^DIC(19,5573,1,0)="^^4^4^2950816^"
^DIC(19,5573,1,1,0)="Allows user to print health summaries interactively for all patients on a"
^DIC(19,5573,1,2,0)="specified ward(s), for all patients with appointments at a specified"
^DIC(19,5573,1,3,0)="outpatient clinic(s), or for all patients scheduled for a specified"
^DIC(19,5573,1,4,0)="operating room(s) on a selected day or range of days."
^DIC(19,5573,2)="y"
^DIC(19,5573,25)="MAIN^GMTSPD"
^DIC(19,5573,99)="55425,54053"
^DIC(19,5573,"U")="HOSPITAL LOCATION HEALTH SUMMA"
^DIC(19,5574,0)="GMTS HS ADHOC^Ad Hoc Health Summary^^R^11597^^^^^^^160^^1"
^DIC(19,5574,1,0)="^^5^5^2950816^"
^DIC(19,5574,1,1,0)="Generates an 'Ad Hoc' Health Summary for specified patients. Instead of"
^DIC(19,5574,1,2,0)="selecting a pre-defined Health Summary Type, the user defines his own ad"
^DIC(19,5574,1,3,0)="hoc Health Summary structure for temporary use while using this option."
^DIC(19,5574,1,4,0)="The user selects Health Summary components, time and occurrence limits"
^DIC(19,5574,1,5,0)="when applicable, and selection items when applicable."
^DIC(19,5574,20)="K ORVP"
^DIC(19,5574,25)="GMTSADH"
^DIC(19,5574,99)="55626,36491"
^DIC(19,5574,"U")="AD HOC HEALTH SUMMARY"
^DIC(19,5575,0)="GMTS TASK LOCATIONS LIST^List Batch Health Summary Locations^^P^.5^^^^^^y^"
^DIC(19,5575,1,0)="^^3^3^2950816^"
^DIC(19,5575,1,1,0)="This option displays a list of all locations which will be checked to see"
^DIC(19,5575,1,2,0)="if health summaries should be printed in the nightly run of GMTS TASK"
^DIC(19,5575,1,3,0)="STARTUP."
^DIC(19,5575,60)="GMT(142,"
^DIC(19,5575,62)=0
^DIC(19,5575,63)="[GMTS TASK LOCATIONS LIST]"
^DIC(19,5575,64)="[GMTS TASK LOCATIONS SORT]"
^DIC(19,5575,65)="A"
^DIC(19,5575,66)="zzz"
^DIC(19,5575,73)=""
^DIC(19,5575,"U")="LIST BATCH HEALTH SUMMARY LOCA"
^DIC(19,5576,0)="GMTS IRM/ADPAC ADHOC LOAD^Rebuild Ad Hoc Health Summary Type^^R^.5^^^^^^y^"
^DIC(19,5576,1,0)="^^3^3^2950816^^^^"
^DIC(19,5576,1,1,0)="Reloads the Ad Hoc Health Summary Type to include ALL Components,"
^DIC(19,5576,1,2,0)="including any defined by the site, and optionally all temporarily"
^DIC(19,5576,1,3,0)="DISABLED components, sequenced alphabetically by name."
^DIC(19,5576,25)="GMTSLOAD"
^DIC(19,5576,"U")="REBUILD AD HOC HEALTH SUMMARY "
^DIC(19,5577,0)="GMTS IRM/ADPAC TYPE RESEQUENCE^Resequence a Health Summary Type^^R^.5^^^^^^y^"
^DIC(19,5577,1,0)="^^3^3^2950816^^^^"
^DIC(19,5577,1,1,0)="Resequence the components of a given Health Summary Type from 5, in"
^DIC(19,5577,1,2,0)="increments of 5 (i.e., 5, 10, 15, 20,...,5n where n is the total"
^DIC(19,5577,1,3,0)="number of components)."
^DIC(19,5577,25)="GMTSRN"
^DIC(19,5577,"U")="RESEQUENCE A HEALTH SUMMARY TY"
^DIC(19,5578,0)="GMTS ENHANCED USER^Health Summary Enhanced Menu^^M^.5^^^^^^^160"
^DIC(19,5578,1,0)="^^5^5^2950816^"
^DIC(19,5578,1,1,0)="This option allows the user to print Health Summaries based on pre-"
^DIC(19,5578,1,2,0)="defined Health Summary Types as well as Ad Hoc Summaries.  The user may"
^DIC(19,5578,1,3,0)="also list existing Health Summary Types and Health Summary Components and"
^DIC(19,5578,1,4,0)="may inquire about the structure of a Health Summary Type. This option also"
^DIC(19,5578,1,5,0)="allows the user to create or delete his own Health Summary Types."
^DIC(19,5578,10,0)="^19.01PI^19^9"
