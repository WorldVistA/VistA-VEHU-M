^DIC(19,16571,10,"C","DX",3)=""
^DIC(19,16571,10,"C","ES",6)=""
^DIC(19,16571,10,"C","LE",2)=""
^DIC(19,16571,10,"C","PA",5)=""
^DIC(19,16571,10,"C","PE",4)=""
^DIC(19,16571,20)=""
^DIC(19,16571,99)="67411,49177"
^DIC(19,16571,"U")="PCE CLINICAL REPORTS"
^DIC(19,16572,0)="EHM-01393^Caseload Profile by Clinic^^R^1^^^^^^y^^^1^^"
^DIC(19,16572,1,0)="^^49^49^3240328^"
^DIC(19,16572,1,1,0)="This report generates a profile of the patients in a clinic's caseload"
^DIC(19,16572,1,2,0)="given a selected date range.  One or more clinics or a stop code may be"
^DIC(19,16572,1,3,0)="selected to represent the caseload. If stop code is selected, a report is"
^DIC(19,16572,1,4,0)="generated for each clinic within that stop code.  The percent and overall"
^DIC(19,16572,1,5,0)="mean calculations are based on the patient data for all of the clinics"
^DIC(19,16572,1,6,0)="selected.  Where only one clinic is selected, these values are not"
^DIC(19,16572,1,7,0)="applicable."
^DIC(19,16572,1,8,0)=" "
^DIC(19,16572,1,9,0)="Note: There must be at least one PCE encounter within the selected date"
^DIC(19,16572,1,10,0)="  range, or the report will not be generated, even though there may be"
^DIC(19,16572,1,11,0)="  lab, radiology, and outpatient pharmacy occasions of service within the"
^DIC(19,16572,1,12,0)="  other timeframes (selected date range plus six and twelve months"
^DIC(19,16572,1,13,0)="  previous to the range)"
^DIC(19,16572,1,14,0)=" "
^DIC(19,16572,1,15,0)="This report combines PCE encounter, Lab, Radiology, Outpatient"
^DIC(19,16572,1,16,0)="Pharmacy and Admissions data.  It provides a profile of the patients"
^DIC(19,16572,1,17,0)="making up a clinic's caseload, over a representative period of time."
^DIC(19,16572,1,18,0)="Clinical staff will decide the appropriate date range.  Report areas are"
^DIC(19,16572,1,19,0)="demographics of clinic caseload, preventive medicine, quality of care"
^DIC(19,16572,1,20,0)="markers, and utilization.   Patient age, diagnosis, gender, Lab assay, RX,"
^DIC(19,16572,1,21,0)="and procedure are all used to generate the patient profile."
^DIC(19,16572,1,22,0)=" "
^DIC(19,16572,1,23,0)="There are three separate timeframes for the report:"
^DIC(19,16572,1,24,0)="      SELECTED DATE RANGE"
^DIC(19,16572,1,25,0)="      SIX MONTHS PREVIOUS TO THE SELECTED ENDING DATE"
^DIC(19,16572,1,26,0)="      TWELVE MONTHS PREVIOUS TO THE SELECTED ENDING DATE"
^DIC(19,16572,1,27,0)=" "
^DIC(19,16572,1,28,0)="Search ranges are listed at the top of each report section:"
^DIC(19,16572,1,29,0)=" "
^DIC(19,16572,1,30,0)="  DEMOGRAPHICS are based on the selected date range. "
^DIC(19,16572,1,31,0)=" "
^DIC(19,16572,1,32,0)="  PREVENTIVE MEDICINE is based on 1)ICD codes recorded in PCE encounter"
^DIC(19,16572,1,33,0)="diagnoses and 2) Radiology results for the twelve months previous to the"
^DIC(19,16572,1,34,0)="selected ending date."
^DIC(19,16572,1,35,0)=" "
^DIC(19,16572,1,36,0)="  QUALITY OF CARE MARKERS are based on Laboratory results, PCE encounter"
^DIC(19,16572,1,37,0)="diagnoses, and Scheduling data for the six months previous to the selected"
^DIC(19,16572,1,38,0)="ending date."
^DIC(19,16572,1,39,0)=" "
^DIC(19,16572,1,40,0)="  UTILIZATION data is based on PCE encounters, and outpatient pharmacy"
^DIC(19,16572,1,41,0)="prescriptions for the twelve months previous to selected ending date in "
^DIC(19,16572,1,42,0)="the selected date range."
^DIC(19,16572,1,43,0)=" "
^DIC(19,16572,1,44,0)="The six and twelve month range profiles would not be expected to change"
^DIC(19,16572,1,45,0)="much from month to month.  How long the report takes to run will vary"
^DIC(19,16572,1,46,0)="depending upon the number of selected clinics, the number of encounters"
^DIC(19,16572,1,47,0)="within that clinic, and the complexity of the patient data for any"
^DIC(19,16572,1,48,0)="selected clinic."
^DIC(19,16572,1,49,0)="Cloned from ""PXRR CASELOAD PROFILE BY CL"" option."
^DIC(19,16572,3)=""
^DIC(19,16572,20)="S PXRRDEMG=1,PXRRCNUM="""""
^DIC(19,16572,25)="PXRRPCE"
^DIC(19,16572,"U")="CASELOAD PROFILE BY CLINIC"
^DIC(19,16573,0)="EHM-01394^Location Encounter Counts^^R^1^^^^^^^^^^^"
^DIC(19,16573,1,0)="^^30^30^3240328^"
^DIC(19,16573,1,1,0)="This report provides the number of PCE outpatient encounters within an"
^DIC(19,16573,1,2,0)="encounter date range, by location."
^DIC(19,16573,1,3,0)=" "
^DIC(19,16573,1,4,0)="The location report selection criteria can be based on facility, hospital"
^DIC(19,16573,1,5,0)="location(s), or clinic stop(s). The selection criteria are:"
^DIC(19,16573,1,6,0)=" "
^DIC(19,16573,1,7,0)="     Facility - select the facilities encounters to include in the report."
^DIC(19,16573,1,8,0)=" "
^DIC(19,16573,1,9,0)="     Service Category - only encounters with the specified service"
^DIC(19,16573,1,10,0)="     category or categories will be used to generate the report. This"
^DIC(19,16573,1,11,0)="     defaults to ""AI"" for Ambulatory encounters and clinic encounters"
^DIC(19,16573,1,12,0)="     where the patient had an inpatient status."
^DIC(19,16573,1,13,0)=" "
^DIC(19,16573,1,14,0)="     Encounter Date Range - only encounters that fall within the specified"
^DIC(19,16573,1,15,0)="     date range will be used to generate the report."
^DIC(19,16573,1,16,0)=" "
^DIC(19,16573,1,17,0)="     Location criteria can specify All Hospital Locations, Selected"
^DIC(19,16573,1,18,0)="     Hospital Locations, All Clinic Stops, or Selected Clinic Stops."
^DIC(19,16573,1,19,0)=" "
^DIC(19,16573,1,20,0)="         Hospital Locations - only encounters, where the"
^DIC(19,16573,1,21,0)="         encounter's hospital location is the same as one of the selected"
^DIC(19,16573,1,22,0)="         hospital locations, will be used to generate the report."
^DIC(19,16573,1,23,0)="         "
^DIC(19,16573,1,24,0)="         Clinic Stops - only encounters, where the encounter's clinic stop"
^DIC(19,16573,1,25,0)="         is the same as one of the selected clinic stops, will be used to"
^DIC(19,16573,1,26,0)="         generate the report."
^DIC(19,16573,1,27,0)=" "
^DIC(19,16573,1,28,0)="The report lists the number of encounters alphabetically by the location"
^DIC(19,16573,1,29,0)="criteria selected. "
^DIC(19,16573,1,30,0)="Cloned from ""PXRR LOCATION ENCOUNTER COUNTS"" option."
^DIC(19,16573,3)=""
^DIC(19,16573,20)=""
^DIC(19,16573,25)="MAIN^PXRRLCD"
^DIC(19,16573,"U")="LOCATION ENCOUNTER COUNTS"
^DIC(19,16574,0)="EHM-01395^Diagnosis Ranked by Frequency^^R^1^^^^^^^^^^^"
^DIC(19,16574,1,0)="^^68^68^3240328^"
^DIC(19,16574,1,1,0)="This report produces two lists: most frequent diagnoses (ICD) and most"
^DIC(19,16574,1,2,0)="frequent diagnostic categories.  The list entries are ordered with the"
^DIC(19,16574,1,3,0)="most frequent encounter diagnosis first.  The most frequent"
^DIC(19,16574,1,4,0)="diagnosis categories list is based on the ICD diagnostic category related"
^DIC(19,16574,1,5,0)="to each diagnosis in the frequent diagnosis list."
^DIC(19,16574,1,6,0)=" "
^DIC(19,16574,1,7,0)="The report can be generated using a number of different selection"
^DIC(19,16574,1,8,0)="criteria. The selection criteria are:"
^DIC(19,16574,1,9,0)=" "
^DIC(19,16574,1,10,0)="  Facility - select the facilities encounters to include in the report."
^DIC(19,16574,1,11,0)=" "
^DIC(19,16574,1,12,0)="  Primary Diagnoses only or All Diagnoses - if primary is selected then"
^DIC(19,16574,1,13,0)="  only primary diagnosis associated with an encounter will be included in"
^DIC(19,16574,1,14,0)="  the report.  All diagnosis will include Primary and secondary diagnoses"
^DIC(19,16574,1,15,0)="  associated with an encounter.  "
^DIC(19,16574,1,16,0)=" "
^DIC(19,16574,1,17,0)="  Encounter Date Range - only encounters that fall within the specified"
^DIC(19,16574,1,18,0)="  date range will be used to generate the report."
^DIC(19,16574,1,19,0)=" "
^DIC(19,16574,1,20,0)="  Number of most frequent diagnoses - this will determine how many"
^DIC(19,16574,1,21,0)="  diagnoses and diagnoses categories will be listed on the report. For"
^DIC(19,16574,1,22,0)="  example, if 20 was input for this criteria, the report would list up to"
^DIC(19,16574,1,23,0)="  20 of the most frequent diagnoses found associated with encounters.  The"
^DIC(19,16574,1,24,0)="  diagnoses are ranked from most frequent to least frequent.  The same is"
^DIC(19,16574,1,25,0)="  true for diagnostic categories.  If the encounters contained less than"
^DIC(19,16574,1,26,0)="  20 different diagnoses, then the report would list all the different"
^DIC(19,16574,1,27,0)="  diagnoses that were found."
^DIC(19,16574,1,28,0)=" "
^DIC(19,16574,1,29,0)="The remaining criteria are optional for singling out diagnosis entries"
^DIC(19,16574,1,30,0)="based on other encounter or patient data. The user can accept the default"
^DIC(19,16574,1,31,0)="""other"" encounter/patient criteria which is all VA Clinic encounters"
^DIC(19,16574,1,32,0)="(Service Category of ""A"" or ""I"") for all patients."
^DIC(19,16574,1,33,0)=" "
^DIC(19,16574,1,34,0)="Other encounter/patient report selection criteria:"
^DIC(19,16574,1,35,0)=" "
^DIC(19,16574,1,36,0)="   Service Category - only encounters with the specified service"
^DIC(19,16574,1,37,0)="   category or categories will be used to generate the report. This"
^DIC(19,16574,1,38,0)="   defaults to ""AI"" for Ambulatory encounters and encounters at a clinic"
^DIC(19,16574,1,39,0)="   where the patient had an inpatient status."
^DIC(19,16574,1,40,0)=" "
^DIC(19,16574,1,41,0)="   Clinic Stop Code - only encounters with the specified list of clinic"
^DIC(19,16574,1,42,0)="   stop codes will be used to generate the report."
^DIC(19,16574,1,43,0)=" "
^DIC(19,16574,1,44,0)="   Provider criteria can specify All Providers, Primary"
^DIC(19,16574,1,45,0)="   Providers, Selected Providers, or Selected Provider Classes."
^DIC(19,16574,1,46,0)=" "
^DIC(19,16574,1,47,0)="        Providers - only encounters, where one of the encounter providers"
^DIC(19,16574,1,48,0)="        is the same as one of the providers selected, will be used to"
^DIC(19,16574,1,49,0)="        generate the report."
^DIC(19,16574,1,50,0)=" "
^DIC(19,16574,1,51,0)="        Primary Providers - only encounters, where one of the encounter"
^DIC(19,16574,1,52,0)="        providers is designated as a Primary provider, will be used to"
^DIC(19,16574,1,53,0)="        generate the report."
^DIC(19,16574,1,54,0)=" "
^DIC(19,16574,1,55,0)="        Provider class - only encounters, where one of the encounter"
^DIC(19,16574,1,56,0)="        providers has the same provider class as one of the providers"
^DIC(19,16574,1,57,0)="        classes selected, will be used to generate the report."
^DIC(19,16574,1,58,0)=" "
^DIC(19,16574,1,59,0)="   Patient Date of Birth Range - only encounters, where the patient's date"
^DIC(19,16574,1,60,0)="   of birth falls in the specified range, will be used to generate the"
^DIC(19,16574,1,61,0)="   report."
^DIC(19,16574,1,62,0)=" "
^DIC(19,16574,1,63,0)="   Patient Sex - only encounters, where the patient's sex matches the"
^DIC(19,16574,1,64,0)="   specified sex, will be used to generate the report."
^DIC(19,16574,1,65,0)=" "
^DIC(19,16574,1,66,0)="To include all encounters, ignoring all defaults for the other criteria,"
^DIC(19,16574,1,67,0)="the user may specify ""A"" for All Encounters at the Other criteria prompt."
^DIC(19,16574,1,68,0)="Cloned from ""PXRR MOST FREQUENT DIAGNOSES"" option."
^DIC(19,16574,3)=""
^DIC(19,16574,20)=""
^DIC(19,16574,25)="MAIN^PXRRFDD"
^DIC(19,16574,"U")="DIAGNOSIS RANKED BY FREQUENCY"
^DIC(19,16575,0)="EHM-01396^Provider Encounter Counts^^R^1^^^^^^^^^^^"
^DIC(19,16575,1,0)="^^47^47^3240328^"
^DIC(19,16575,1,1,0)="This report provides the number of PCE outpatient encounters within an"
^DIC(19,16575,1,2,0)="encounter date range, by provider.  The user specifies report selection"
^DIC(19,16575,1,3,0)="criteria and then chooses either a summary report or detailed report."
^DIC(19,16575,1,4,0)=" "
^DIC(19,16575,1,5,0)="The report can be generated using a number of different selection"
^DIC(19,16575,1,6,0)="criteria. The selection criteria are:"
^DIC(19,16575,1,7,0)=" "
^DIC(19,16575,1,8,0)="    Facility - select the facilities encounters to include in the report."
^DIC(19,16575,1,9,0)=" "
^DIC(19,16575,1,10,0)="    Service Category - only encounters with the specified service"
^DIC(19,16575,1,11,0)="    category or categories will be used to generate the report. This"
^DIC(19,16575,1,12,0)="    defaults to ""AI"" for Ambulatory encounters and clinic encounters"
^DIC(19,16575,1,13,0)="    where the patient had an inpatient status."
^DIC(19,16575,1,14,0)=" "
^DIC(19,16575,1,15,0)="    Provider criteria can specify All Providers, Primary Providers,"
^DIC(19,16575,1,16,0)="    Selected Providers, or Selected Provider Classes."
^DIC(19,16575,1,17,0)=" "
^DIC(19,16575,1,18,0)="        Providers - only encounters, where one of the encounter providers"
^DIC(19,16575,1,19,0)="        is the same as one of the providers selected, will be used to"
^DIC(19,16575,1,20,0)="        generate the report."
^DIC(19,16575,1,21,0)=" "
^DIC(19,16575,1,22,0)="        Primary Providers - only encounters, where one of the encounter"
^DIC(19,16575,1,23,0)="        providers is designated as a Primary provider, will be used to"
^DIC(19,16575,1,24,0)="        generate the report."
^DIC(19,16575,1,25,0)=" "
^DIC(19,16575,1,26,0)="        Provider class - only encounters, where one of the encounter"
^DIC(19,16575,1,27,0)="        providers has the same provider class as one of the providers"
^DIC(19,16575,1,28,0)="        classes selected, will be used to generate the report."
^DIC(19,16575,1,29,0)=" "
^DIC(19,16575,1,30,0)="    Encounter Date Range - only encounters that fall within the specified"
^DIC(19,16575,1,31,0)="    date range will be used to generate the report."
^DIC(19,16575,1,32,0)=" "
^DIC(19,16575,1,33,0)=" "
^DIC(19,16575,1,34,0)="Once the report criteria is specified, the user can request a detailed"
^DIC(19,16575,1,35,0)="or a summary report."
^DIC(19,16575,1,36,0)=" "
^DIC(19,16575,1,37,0)="The detailed report lists the number of encounters by encounter date and"
^DIC(19,16575,1,38,0)="hospital location for each provider. The clinic stop code for the hospital"
^DIC(19,16575,1,39,0)="location is in parenthesis, followed by a string of letters corresponding"
^DIC(19,16575,1,40,0)="to the service categories represented by the encounters found.  The legend"
^DIC(19,16575,1,41,0)="for the service categories is included on the top of the report. For"
^DIC(19,16575,1,42,0)="example, if on a particular day the provider had three ambulatory"
^DIC(19,16575,1,43,0)="encounters and two telecommunications encounters, the string would be ""AT"""
^DIC(19,16575,1,44,0)="and the number of encounters would be five."
^DIC(19,16575,1,45,0)=" "
^DIC(19,16575,1,46,0)="The summary report lists the total number of encounters for each provider."
^DIC(19,16575,1,47,0)="Cloned from ""PXRR PROVIDER ENCOUNTER COUNTS"" option."
^DIC(19,16575,3)=""
^DIC(19,16575,20)=""
^DIC(19,16575,25)="MAIN^PXRRPRD"
^DIC(19,16575,"U")="PROVIDER ENCOUNTER COUNTS"
^DIC(19,16576,0)="EHM-01397^Patient Activity by Location^^R^1^^^^^^^^^^^"
^DIC(19,16576,1,0)="^^77^77^3240328^^^"
^DIC(19,16576,1,1,0)="This report may be run for either selected hospital locations, all"
^DIC(19,16576,1,2,0)="hospital locations, selected clinics, or all clinics. The report format"
^DIC(19,16576,1,3,0)="is a summary by patient for each selected location. For each location,"
^DIC(19,16576,1,4,0)="Scheduling data is used to identify patients with appointments during"
^DIC(19,16576,1,5,0)="the Patient Appointment Date Range. (The user can specify whether or not"
^DIC(19,16576,1,6,0)="each location should be started on a new page.  This is useful for"
^DIC(19,16576,1,7,0)="clerks printing and then distributing the reports to multiple"
^DIC(19,16576,1,8,0)="locations.)"
^DIC(19,16576,1,9,0)=""
^DIC(19,16576,1,10,0)="VISTA data for these patients is then examined for possible patient"
^DIC(19,16576,1,11,0)="activities during the Patient Activity Date Range.  Patient"
^DIC(19,16576,1,12,0)="activities include inpatient stays, emergency room encounters and"
^DIC(19,16576,1,13,0)="critical lab values.  A summary of each of these follows."
^DIC(19,16576,1,14,0)=""
^DIC(19,16576,1,15,0)="Inpatient stays:  All inpatient activities within the Patient Activity Date"
^DIC(19,16576,1,16,0)="Range are reported.  These include admissions and corresponding discharge, if"
^DIC(19,16576,1,17,0)="there is one, discharges and corresponding admission, and current"
^DIC(19,16576,1,18,0)="in-patient status."
^DIC(19,16576,1,19,0)=" "
^DIC(19,16576,1,20,0)="Emergency Room encounters:  All encounters within the Patient Activity"
^DIC(19,16576,1,21,0)="Date Range that have an identified Emergency Room location are"
^DIC(19,16576,1,22,0)="reported. Emergency rooms are identified through the PCE PARAMETERS"
^DIC(19,16576,1,23,0)="file.  This data is entered by the clinical coordinator or IRM staff"
^DIC(19,16576,1,24,0)="through the 'PCE Report Parameter Setup' option."
^DIC(19,16576,1,25,0)=" "
^DIC(19,16576,1,26,0)="Critical Lab Values:  All critical lab values reported within the"
^DIC(19,16576,1,27,0)="Patient Activity Date Range are presented, along with a column to identify"
^DIC(19,16576,1,28,0)="whether the value is critically high or critically low."
^DIC(19,16576,1,29,0)=" "
^DIC(19,16576,1,30,0)="Finally a search for future appointments is made within the Future"
^DIC(19,16576,1,31,0)="Appointment Date Range.  Any future appointments within this date range"
^DIC(19,16576,1,32,0)="are listed."
^DIC(19,16576,1,33,0)=""
^DIC(19,16576,1,34,0)="Within each location the patients are listed alphabetically followed by"
^DIC(19,16576,1,35,0)="a list of their appointments and activities.  Only patients with"
^DIC(19,16576,1,36,0)="activities will be included in the report."
^DIC(19,16576,1,37,0)=" "
^DIC(19,16576,1,38,0)="This report was developed as a measure of continuity of care. If a"
^DIC(19,16576,1,39,0)="provider of record has his or her care-giving interrupted through"
^DIC(19,16576,1,40,0)="clinical rotation, leave, reassignment, or for any other reason, this"
^DIC(19,16576,1,41,0)="report may be used to get an update on patient activities in his/her"
^DIC(19,16576,1,42,0)="caseload. This report is also useful when care is not interrupted."
^DIC(19,16576,1,43,0)="Clinical staff may wish to review patient activity by location for"
^DIC(19,16576,1,44,0)="events  which they may be unaware of."
^DIC(19,16576,1,45,0)=" "
^DIC(19,16576,1,46,0)=" "
^DIC(19,16576,1,47,0)="Technical Description:"
^DIC(19,16576,1,48,0)=" "
^DIC(19,16576,1,49,0)="Patient appointments are found by examining the appointment multiple of"
^DIC(19,16576,1,50,0)="the Hospital Location file for the specified locations during the time"
^DIC(19,16576,1,51,0)="frame specified by the Patient Appointment Date Range."
^DIC(19,16576,1,52,0)=" "
^DIC(19,16576,1,53,0)="Admissions and discharges that occurred during the Patient Activity Date"
^DIC(19,16576,1,54,0)="Range are found using the ATT1 and ATT3 cross-references of the"
^DIC(19,16576,1,55,0)="Patient Movement file.  A search for the corresponding discharge or"
^DIC(19,16576,1,56,0)="admission is made using the IN5^VADPT call.  Current inpatient status"
^DIC(19,16576,1,57,0)="is determined using this same call."
^DIC(19,16576,1,58,0)=" "
^DIC(19,16576,1,59,0)="Emergency room locations must be defined in field 801 of the PCE"
^DIC(19,16576,1,60,0)="PARAMETERS file, which is a multiple pointing to the HOSPITAL LOCATION"
^DIC(19,16576,1,61,0)="file. The ER clinic names are stored permanently at the global"
^DIC(19,16576,1,62,0)="location: ^PX(815,D0,RR1,D1,0). The Visit File is examined for"
^DIC(19,16576,1,63,0)="encounters during the Patient Activity Date Range which have a location"
^DIC(19,16576,1,64,0)="matching one of the defined emergency room locations."
^DIC(19,16576,1,65,0)=" "
^DIC(19,16576,1,66,0)="Laboratory data assessed for critical values is based on the Subfile 63.04"
^DIC(19,16576,1,67,0)="of the Lab DATA file (63), which stores results from Chemistry,"
^DIC(19,16576,1,68,0)="Hematology, Toxicology, RIA, Serology, and others.  Critical values are"
^DIC(19,16576,1,69,0)="identified through a pattern match of a numeric value followed by a ""*""."
^DIC(19,16576,1,70,0)="The global location read is ^LR(LRDFN,""CH"",INVERSE LAB DATE, LAB TEST"
^DIC(19,16576,1,71,0)="FIELD NUMBER). Piece one contains the result. Piece 2 indicates a critical"
^DIC(19,16576,1,72,0)="value and if it is high or low (e.g. *H).  This search is confined to"
^DIC(19,16576,1,73,0)="the Patient Activity Date Range."
^DIC(19,16576,1,74,0)=""
^DIC(19,16576,1,75,0)="Future appointments are found using the SDA^VADPT call for each patient"
^DIC(19,16576,1,76,0)="within the Future Appointment Date Range."
^DIC(19,16576,1,77,0)="Cloned from ""PXRR PATIENT ACTIVITY BY LOC"" option."
^DIC(19,16576,3)=""
^DIC(19,16576,25)="PXRRPAD"
^DIC(19,16576,"U")="PATIENT ACTIVITY BY LOCATION"
^DIC(19,16577,0)="EHM-01398^PCE Encounter Summary^^R^1^^^^^^^507^^^^"
^DIC(19,16577,1,0)="^^37^37^3240328^"
^DIC(19,16577,1,1,0)="This report provides a summary of PCE encounters. For the purposes of this"
^DIC(19,16577,1,2,0)="report an encounter is any entry in the Visit File. The report can be run by"
^DIC(19,16577,1,3,0)="location or by provider. Encounters included in the report"
^DIC(19,16577,1,4,0)="are selected by a combination of date range, service categories, and encounter"
^DIC(19,16577,1,5,0)="types."
^DIC(19,16577,1,6,0)=""
^DIC(19,16577,1,7,0)="Data for the selected encounters is categorized and summarized in several ways."
^DIC(19,16577,1,8,0)="CPT codes associated with encounters are classified by Evaluation and"
^DIC(19,16577,1,9,0)="Management Code. Those falling into the E&M group are"
^DIC(19,16577,1,10,0)="sorted into the categories new, established, consult, and other."
^DIC(19,16577,1,11,0)=""
^DIC(19,16577,1,12,0)="The number of unique patients is determined for each location and for all the"
^DIC(19,16577,1,13,0)="locations selected for the report. The sum of the uniques for each location"
^DIC(19,16577,1,14,0)="will generally be larger than the total number of uniques"
^DIC(19,16577,1,15,0)="because a patient may be counted as a unique in more than one location but will"
^DIC(19,16577,1,16,0)="only be counted once for the entire facility."
^DIC(19,16577,1,17,0)=""
^DIC(19,16577,1,18,0)="Three visit totals are calculated. A visit is defined as any patient activity"
^DIC(19,16577,1,19,0)="at a location in one day.  Thus a patient having multiple encounters at a"
^DIC(19,16577,1,20,0)="location on one day will count as one visit. The three visit totals given are"
^DIC(19,16577,1,21,0)="total visits, inpatient visits, and outpatient visits. The sum of the inpatient"
^DIC(19,16577,1,22,0)="and outpatient visits will not be equal to the total visits if a patient had"
^DIC(19,16577,1,23,0)="both an inpatient and outpatient visit on the same day."
^DIC(19,16577,1,24,0)=""
^DIC(19,16577,1,25,0)="For each selected encounter an attempt is made to find an associated"
^DIC(19,16577,1,26,0)="appointment. This is done using the Outpatient Encounter file which provides a"
^DIC(19,16577,1,27,0)="link between encounters and appointments. Purpose of Visit data is tabulated"
^DIC(19,16577,1,28,0)="for each appointment that is found. Purpose of Visit includes the categories"
^DIC(19,16577,1,29,0)="C&P, 10-10, scheduled, and unscheduled."
^DIC(19,16577,1,30,0)=""
^DIC(19,16577,1,31,0)="If there is an appointment without an associated encounter it will not be"
^DIC(19,16577,1,32,0)="tabulated on this report. Cancelled and no-show appointments do not have an"
^DIC(19,16577,1,33,0)="associated encounter so they cannot be included in this report. Even if they"
^DIC(19,16577,1,34,0)="could, the information on cancelled and no-show appointments stored in"
^DIC(19,16577,1,35,0)="Scheduling is not complete making it impossible to give accurate counts."
^DIC(19,16577,1,36,0)=""
^DIC(19,16577,1,37,0)="Cloned from ""PXRR PCE ENCOUNTER SUMMARY"" option."
^DIC(19,16577,3)=""
^DIC(19,16577,25)="PXRRWLD"
^DIC(19,16577,"U")="PCE ENCOUNTER SUMMARY"
^DIC(19,16578,0)="EHM-01399^PCE Site Parameter Menu^^M^1^^^^^^^507^^^^"
^DIC(19,16578,1,0)="^^23^23^3240328^^^^"
^DIC(19,16578,1,1,0)="This menu includes all options that deal with defining and displaying"
^DIC(19,16578,1,2,0)="entries in the PCE PARAMETERS file (815)."
^DIC(19,16578,1,3,0)=" "
^DIC(19,16578,1,4,0)="The PCE Site Parameters Edit option includes all editable fields,"
^DIC(19,16578,1,5,0)="for IRM/ADPAC use."
^DIC(19,16578,1,6,0)=" "
^DIC(19,16578,1,7,0)="The PCE HS/RPT Parameter Print option can be included on a Health Summary"
^DIC(19,16578,1,8,0)="Coordinator's menu if the coordinator is involved with the definition of"
^DIC(19,16578,1,9,0)="Clinical Reminders to be printed on the Health Summary.  This option is"
^DIC(19,16578,1,10,0)="also included on the PCE Coordinators menu and the PCE Reports option"
^DIC(19,16578,1,11,0)="menu."
^DIC(19,16578,1,12,0)=" "
^DIC(19,16578,1,13,0)="The PCE HS Parameters option can be included on a Health Summary"
^DIC(19,16578,1,14,0)="Coordinators menu, and is included on the PCE Coordinator's menu.  This"
^DIC(19,16578,1,15,0)="user should be familiar with the PCE Reminders and the use of the reminder"
^DIC(19,16578,1,16,0)="disclaimer on the ""Clinical Maintenance"" and ""Clinical Reminder"""
^DIC(19,16578,1,17,0)="components."
^DIC(19,16578,1,18,0)=" "
^DIC(19,16578,1,19,0)="The PCE Report Parameters Setup option can be included on a PCE"
^DIC(19,16578,1,20,0)="Coordinator's menu to setup the local file definitions to use to"
^DIC(19,16578,1,21,0)="represent Emergency Clinics, and various categories of Lab tests by"
^DIC(19,16578,1,22,0)="the PCE Report Module."
^DIC(19,16578,1,23,0)="Cloned from ""PX SITE PARAMETER MENU"" option."
^DIC(19,16578,3)=""
^DIC(19,16578,10,0)="^19.01IP^2^2"
^DIC(19,16578,10,1,0)="16579^SITE^1"
^DIC(19,16578,10,2,0)="16580^RPT^5"
^DIC(19,16578,10,"B",16579,1)=""
^DIC(19,16578,10,"B",16580,2)=""
^DIC(19,16578,10,"C","RPT",2)=""
^DIC(19,16578,10,"C","SITE",1)=""
^DIC(19,16578,99)="67411,49177"
^DIC(19,16578,"U")="PCE SITE PARAMETER MENU"
^DIC(19,16579,0)="EHM-01400^PCE Site Parameters Edit^^E^1^^^^^^n^507^^^^"
^DIC(19,16579,1,0)="^^6^6^3240328^^^"
^DIC(19,16579,1,1,0)="This option is used to edit fields in the PCE PARAMETERS file that impact"
^DIC(19,16579,1,2,0)="the PCE data capture and the PCE user interface processing."
^DIC(19,16579,1,3,0)=" "
^DIC(19,16579,1,4,0)="The parameters that are defined here alter the default view of encounters"
^DIC(19,16579,1,5,0)="that the user will see when the PCE Data Entry options are selected."
^DIC(19,16579,1,6,0)="Cloned from ""PX PCE SITE PARAMETERS EDIT"" option."
^DIC(19,16579,3)=""
^DIC(19,16579,30)="PX(815,"
^DIC(19,16579,31)="QAME"
^DIC(19,16579,33)=""
^DIC(19,16579,41)=815
^DIC(19,16579,50)="PX(815,"
^DIC(19,16579,51)="[PX SITE PARAMETER EDIT]"
^DIC(19,16579,53)="BACKOUTOK"
^DIC(19,16579,"U")="PCE SITE PARAMETERS EDIT"
^DIC(19,16580,0)="EHM-01401^PCE HS/RPT Parameter Menu^^M^1^^^^^^^^^^^"
^DIC(19,16580,1,0)="^^12^12^3240328^"
^DIC(19,16580,1,1,0)="This menu option contains print and edit options for PCE fields related to"
^DIC(19,16580,1,2,0)="the PCE Reports module.  "
^DIC(19,16580,1,3,0)=" "
^DIC(19,16580,1,4,0)="Use the print option to see what the current definition is for these"
^DIC(19,16580,1,5,0)="fields.  "
^DIC(19,16580,1,6,0)=" "
^DIC(19,16580,1,7,0)="The report edit option allows your site to specify which clinics in file"
^DIC(19,16580,1,8,0)="44 represent ""Emergency Room"" clinics, and what Lab tests from file 60"
^DIC(19,16580,1,9,0)="should be used for looking up patient data for Glucose, Cholesterol, LDL"
^DIC(19,16580,1,10,0)="Cholesterol and HBA1C lab results.  These fields are used by the following"
^DIC(19,16580,1,11,0)="reports:  Caseload Profile by Clinic, and Patient Activity by Clinic."
^DIC(19,16580,1,12,0)="Cloned from ""PX HS/RPT PARAMETER MENU"" option."
^DIC(19,16580,3)=""
^DIC(19,16580,10,0)="^19.01IP^2^2"
^DIC(19,16580,10,1,0)="16581^RPT^10"
^DIC(19,16580,10,2,0)="16582^PRNT^1"
^DIC(19,16580,10,"B",16581,1)=""
^DIC(19,16580,10,"B",16582,2)=""
^DIC(19,16580,10,"C","PRNT",2)=""
^DIC(19,16580,10,"C","RPT",1)=""
^DIC(19,16580,99)="67411,49177"
^DIC(19,16580,"U")="PCE HS/RPT PARAMETER MENU"
^DIC(19,16581,0)="EHM-01402^PCE Report Parameter Edit^^E^1^^^^^^^507^^^^"
^DIC(19,16581,1,0)="^^10^10^3240328^"
^DIC(19,16581,1,1,0)="This option is used to define parameters that will be used by the PCE"
^DIC(19,16581,1,2,0)="Report Module.  The user will need to identify which clinics are viewed by"
^DIC(19,16581,1,3,0)="clinicians as being Emergency Room clinics.  The user will also need to"
^DIC(19,16581,1,4,0)="identify the lab test names that are used by your site to identify the"
^DIC(19,16581,1,5,0)="following types of Lab tests: Glucose, Cholesterol, LDL Cholesterol, and"
^DIC(19,16581,1,6,0)="HBA1C."
^DIC(19,16581,1,7,0)=" "
^DIC(19,16581,1,8,0)="To get a print out of current definitions in the PCE Parameters fields for"
^DIC(19,16581,1,9,0)="these fields, use the PCE HS/RPT Parameters Print."
^DIC(19,16581,1,10,0)="Cloned from ""PX REPORT PARAMETER EDIT"" option."
^DIC(19,16581,3)=""
^DIC(19,16581,30)="PX(815,"
^DIC(19,16581,31)="QAMEZL"
^DIC(19,16581,50)="PX(815,"
^DIC(19,16581,51)="801:805"
^DIC(19,16581,53)="BACKOUTOK"
^DIC(19,16581,"U")="PCE REPORT PARAMETER EDIT"
^DIC(19,16582,0)="EHM-01403^PCE HS/RPT Parameters Print^^P^1^^^^^^y^507^^^^"
^DIC(19,16582,1,0)="^^5^5^3240328^"
^DIC(19,16582,1,1,0)="This option prints the current PCE Parameter definitions that are used by"
^DIC(19,16582,1,2,0)="some of the PCE Reports. A brief explanation is included about editing and"
^DIC(19,16582,1,3,0)="viewing health summary disclaimers that are now managed from the Clinical"
^DIC(19,16582,1,4,0)="Reminders package."
^DIC(19,16582,1,5,0)="Cloned from ""PX HS/RPT PARAMETERS PRINT"" option."
