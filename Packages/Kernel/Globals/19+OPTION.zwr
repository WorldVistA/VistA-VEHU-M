^DIC(19,11289,1,0)="^^3^3^3101207^"
^DIC(19,11289,1,1,0)="This option may be used to manually queue the VASQIP transmission process"
^DIC(19,11289,1,2,0)="to run at a selected time.  The VASQIP transmission process is a part of"
^DIC(19,11289,1,3,0)="the nightly maintenance and cleanup process."
^DIC(19,11289,15)=""
^DIC(19,11289,22)=""
^DIC(19,11289,25)="TRANS^SRONITE"
^DIC(19,11289,"U")="QUEUE ASSESSMENT TRANSMISSIONS"
