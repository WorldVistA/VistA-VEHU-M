^DIC(19,13751,10,"C","STAT",7)=""
^DIC(19,13751,99)="61564,56794"
^DIC(19,13751,"U")="UTILITIES USED AFTER THE DATA "
^DIC(19,13752,0)="VBEC TRANS. REACTION UTILITIES^Utilities that manipulate Trans. Reaction data^^M^1^^^^^^^"
^DIC(19,13752,1,0)="^19.06^7^7^3051011^^^^"
^DIC(19,13752,1,1,0)="This menu contains options that manipulate Transfusion Reaction data.  "
^DIC(19,13752,1,2,0)="VistA transfusion reactions must be matched to a standard table prior to "
^DIC(19,13752,1,3,0)="data conversion.  This menu facilitates creating a temporary file with "
^DIC(19,13752,1,4,0)="existing VistA transfusion reaction types, matching them to a standard "
^DIC(19,13752,1,5,0)="table, undoing the matches, printing a list of the matches, updating the "
^DIC(19,13752,1,6,0)="temporary file with VistA changes, and completely deleting the temporary "
^DIC(19,13752,1,7,0)="file."
^DIC(19,13752,10,0)="^19.01IP^5^5"
^DIC(19,13752,10,1,0)=13742
^DIC(19,13752,10,2,0)="13746^2^2"
