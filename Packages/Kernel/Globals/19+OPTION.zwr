^DIC(19,8018,0)="IB MT LIST HELD (RATE) CHARGES^List Charges Awaiting New Copay Rate^^R^.5^^^^^^^192"
^DIC(19,8018,1,0)="^^3^3^2930823^"
^DIC(19,8018,1,1,0)="This option is used to generate a list of all Means Test outpatient"
^DIC(19,8018,1,2,0)="copayment charges which have been placed on hold in Integrated"
^DIC(19,8018,1,3,0)="Billing because the outpatient copay rate is over one year old."
^DIC(19,8018,25)="EN^IBEMTO1"
^DIC(19,8018,"U")="LIST CHARGES AWAITING NEW COPA"
^DIC(19,8019,0)="IB MT REL HELD (RATE) CHARGES^Release Charges Awaiting New Copay Rate^^R^.5^^^^^^^192"
^DIC(19,8019,1,0)="^^7^7^2930823^"
^DIC(19,8019,1,1,0)="This option is used to release charges which have been placed on hold"
^DIC(19,8019,1,2,0)="in Integrated Billing because the outpatient copay rate is over one"
^DIC(19,8019,1,3,0)="year old.  If the new (less than one year old) rate has been entered"
^DIC(19,8019,1,4,0)="into the Billing table, the option will prompt the user to task off"
^DIC(19,8019,1,5,0)="a job which will automatically update the dollar amount and bill"
^DIC(19,8019,1,6,0)="all such charges.  The user will receive a bulletin when the tasked"
^DIC(19,8019,1,7,0)="job has completed."
^DIC(19,8019,25)="ENO^IBEMTO"
^DIC(19,8019,"U")="RELEASE CHARGES AWAITING NEW C"
