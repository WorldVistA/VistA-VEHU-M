^DIC(19,10686,0)="DMSQ PURGE^Purge SQLI Data^^R^1^XUPROGMODE^^^^^^309"
^DIC(19,10686,1,0)="^^23^23^2970806^^^^"
^DIC(19,10686,1,1,0)="This option purges the SQLI projection of VA FileMan data dictionaries."
^DIC(19,10686,1,2,0)="Use this option if you have previously projected your VA FileMan data"
^DIC(19,10686,1,3,0)="dictionaries for use by an M-to-SQL product, but no longer wish to. All"
^DIC(19,10686,1,4,0)="data in the following files are purged:"
^DIC(19,10686,1,5,0)=" "
^DIC(19,10686,1,6,0)="  SQLI_COLUMN"
^DIC(19,10686,1,7,0)="  SQLI_DATA_TYPE"
^DIC(19,10686,1,8,0)="  SQLI_DOMAIN"
^DIC(19,10686,1,9,0)="  SQLI_ERROR_LOG"
^DIC(19,10686,1,10,0)="  SQLI_ERROR_TEXT"
^DIC(19,10686,1,11,0)="  SQLI_FOREIGN_KEY"
^DIC(19,10686,1,12,0)="  SQLI_KEY_FORMAT"
^DIC(19,10686,1,13,0)="  SQLI_OUTPUT_FORMAT"
^DIC(19,10686,1,14,0)="  SQLI_PRIMARY_KEY"
^DIC(19,10686,1,15,0)="  SQLI_SCHEMA"
^DIC(19,10686,1,16,0)="  SQLI_TABLE"
^DIC(19,10686,1,17,0)="  SQLI_TABLE_ELEMENT"
^DIC(19,10686,1,18,0)=" "
^DIC(19,10686,1,19,0)="Data is not purged from the following SQLI file, however:"
^DIC(19,10686,1,20,0)=" "
^DIC(19,10686,1,21,0)="  SQLI_KEY_WORD"
^DIC(19,10686,1,22,0)=" "
^DIC(19,10686,1,23,0)="This option requires programmer mode as well as the progmode key."
^DIC(19,10686,25)="PURGE^DMSQ"
^DIC(19,10686,99)="57167,30963"
^DIC(19,10686,"U")="PURGE SQLI DATA"
^DIC(19,10687,0)="DMSQ PRINT ERRORS^Print Errors from Last Projection^^R^1^^^^^^^309"
^DIC(19,10687,1,0)="^^2^2^2970718^^"
^DIC(19,10687,1,1,0)="Lists errors, sorted by category, generated by the most recent SQLI"
^DIC(19,10687,1,2,0)="projection run."
^DIC(19,10687,25)="MAIN^DMSQE"
^DIC(19,10687,"U")="PRINT ERRORS FROM LAST PROJECT"
^DIC(19,10688,0)="DMSQ PS MENU^Site Statistics Reports^^M^1^^^^^^^"
^DIC(19,10688,1,0)="^^2^2^2970805^"
^DIC(19,10688,1,1,0)="This is a menu of reports that show counts of tables and columns for"
^DIC(19,10688,1,2,0)="this site (where SQLI is installed)."
^DIC(19,10688,10,0)="^19.01IP^9^9"
^DIC(19,10688,10,1,0)="10689^TBL^10"
^DIC(19,10688,10,2,0)="10690^1C^20"
^DIC(19,10688,10,3,0)="10691^INDX^30"
^DIC(19,10688,10,4,0)="10692^ELEM^40"
^DIC(19,10688,10,5,0)="10693^2C^50"
^DIC(19,10688,10,6,0)="10694^3C^60"
^DIC(19,10688,10,7,0)="10696^FLDS^80"
^DIC(19,10688,10,8,0)="10695^4C^70"
^DIC(19,10688,10,9,0)="10708^DOM^90"
^DIC(19,10688,10,"B",10689,1)=""
^DIC(19,10688,10,"B",10690,2)=""
^DIC(19,10688,10,"B",10691,3)=""
^DIC(19,10688,10,"B",10692,4)=""
^DIC(19,10688,10,"B",10693,5)=""
^DIC(19,10688,10,"B",10694,6)=""
^DIC(19,10688,10,"B",10695,8)=""
^DIC(19,10688,10,"B",10696,7)=""
^DIC(19,10688,10,"B",10708,9)=""
^DIC(19,10688,10,"C","1C",2)=""
^DIC(19,10688,10,"C","2C",5)=""
^DIC(19,10688,10,"C","3C",6)=""
^DIC(19,10688,10,"C","4C",8)=""
^DIC(19,10688,10,"C","DOM",9)=""
^DIC(19,10688,10,"C","ELEM",4)=""
^DIC(19,10688,10,"C","FLDS",7)=""
^DIC(19,10688,10,"C","INDX",3)=""
^DIC(19,10688,10,"C","TBL",1)=""
^DIC(19,10688,99)="64176,46884"
^DIC(19,10688,"U")="SITE STATISTICS REPORTS"
^DIC(19,10689,0)="DMSQ PS TOTAL TABLES^Table Total (Excluding Index Tables)^^R^1^^^^^^^"
^DIC(19,10689,1,0)="^^4^4^2970805^^"
^DIC(19,10689,1,1,0)="This report comes back with one number, the total number of tables, not"
^DIC(19,10689,1,2,0)="counting ones based on indexes.  This corresponds with the number of"
^DIC(19,10689,1,3,0)="files and subfiles, with word-processing fields also projected as separate"
^DIC(19,10689,1,4,0)="tables (just as subfiles)."
^DIC(19,10689,25)="EN1^DMSQP1"
^DIC(19,10689,"U")="TABLE TOTAL (EXCLUDING INDEX T"
^DIC(19,10690,0)="DMSQ PS TOTAL COLUMNS^Column Total (All Tables)^^R^1^^^^^^^"
^DIC(19,10690,1,0)="^^3^3^2970805^^"
^DIC(19,10690,1,1,0)="This report calculates one number, the total number of columns in the"
^DIC(19,10690,1,2,0)="SQLI Column file.  This includes columns from tables based on indexes"
^DIC(19,10690,1,3,0)="as well as columns automatically created internal record numbers."
^DIC(19,10690,25)="EN2^DMSQP1"
^DIC(19,10690,"U")="COLUMN TOTAL (ALL TABLES)"
^DIC(19,10691,0)="DMSQ PS TOTAL INDEXES^Index Table Total^^R^1^^^^^^^"
^DIC(19,10691,1,0)="^^3^3^2970805^^"
^DIC(19,10691,1,1,0)="This report shows one number, the total number of tables that are"
^DIC(19,10691,1,2,0)="built from indexes.  (All regular cross-references, either for files"
^DIC(19,10691,1,3,0)="or subfiles, are projected as tables.)"
^DIC(19,10691,25)="EN3^DMSQP1"
^DIC(19,10691,"U")="INDEX TABLE TOTAL"
^DIC(19,10692,0)="DMSQ PS TOTAL TABLE ELEMENTS^Table Element Totals, By Type^^R^1^^^^^^^"
^DIC(19,10692,1,0)="^^3^3^2970805^^"
^DIC(19,10692,1,1,0)="This report shows the total number of table elements along with"
^DIC(19,10692,1,2,0)="subtotals for the three types:  columns, foreign keys, and primary"
^DIC(19,10692,1,3,0)="keys.  "
^DIC(19,10692,25)="EN4^DMSQP1"
^DIC(19,10692,"U")="TABLE ELEMENT TOTALS, BY TYPE"
^DIC(19,10693,0)="DMSQ PS TOTAL TABLE COLS^Column Totals, by Table^^R^1^^^^^^^"
^DIC(19,10693,1,0)="^^3^3^2970805^^"
^DIC(19,10693,1,1,0)="This is a long listing of all tables along with a count of the number"
^DIC(19,10693,1,2,0)="of columns in each one.  It is sorted by the file/subfile number"
^DIC(19,10693,1,3,0)="associated with the table."
^DIC(19,10693,25)="EN5^DMSQP1"
^DIC(19,10693,"U")="COLUMN TOTALS, BY TABLE"
^DIC(19,10694,0)="DMSQ PS TOTAL TABLE COLS A^Column Totals, by Table (Ordered by # of Columns)^^R^1^^^^^^^"
^DIC(19,10694,1,0)="^^3^3^2970805^^"
^DIC(19,10694,1,1,0)="This is a listing of tables by column count.  It shows the table with"
^DIC(19,10694,1,2,0)="the most columns first, so you can easily see which tables have the"
^DIC(19,10694,1,3,0)="most columns."
^DIC(19,10694,25)="EN6^DMSQP1"
^DIC(19,10694,"U")="COLUMN TOTALS, BY TABLE (ORDER"
^DIC(19,10695,0)="DMSQ PS TOTAL COLUMNS REG^Columns in Regular Tables Total^^R^1^^^^^^^"
^DIC(19,10695,1,0)="^^2^2^2970805^^"
^DIC(19,10695,1,1,0)="This report shows one number, the number of columns based on regular"
^DIC(19,10695,1,2,0)="tables.  It excludes columns based on tables created from indexes."
^DIC(19,10695,25)="EN7^DMSQP1"
^DIC(19,10695,"U")="COLUMNS IN REGULAR TABLES TOTA"
^DIC(19,10696,0)="DMSQ PS COLUMNS REG NOID^Columns in Regular Tables, Excluding ID Columns^^R^1^^^^^^^"
^DIC(19,10696,1,0)="^^7^7^2970805^^"
^DIC(19,10696,1,1,0)="This report shows one number, the number of columns that correspond"
^DIC(19,10696,1,2,0)="with regular fields in files.  It excludes columns based on tables"
^DIC(19,10696,1,3,0)="created from indexes.  It also excludes the automatically created"
^DIC(19,10696,1,4,0)="columns based on the internal entry numbers of files and subfiles."
^DIC(19,10696,1,5,0)=" "
^DIC(19,10696,1,6,0)="It is the number of fields in the FileMan database, assuming all files"
^DIC(19,10696,1,7,0)="have been projected as tables."
^DIC(19,10696,25)="EN8^DMSQP1"
^DIC(19,10696,"U")="COLUMNS IN REGULAR TABLES, EXC"
^DIC(19,10697,0)="DMSQ TS PTR PARENT BRIEF^List Pointer and Parent Links (Brief)^^R^1^^^^^^^"
^DIC(19,10697,1,0)="^^4^4^2970805^^"
^DIC(19,10697,1,1,0)="This lists pointed-to files given a file number.  The pointed-to files"
^DIC(19,10697,1,2,0)="may either be connected via a regular pointer or via a subfile link to"
^DIC(19,10697,1,3,0)="a parent file.  The list of file numbers may then be used in other"
^DIC(19,10697,1,4,0)="options to find out more about the table build from that number."
^DIC(19,10697,25)="EN2^DMSQP2"
^DIC(19,10697,"U")="LIST POINTER AND PARENT LINKS "
^DIC(19,10698,0)="DMSQ TS PTR PARENT FULL^List Pointer and Parent Links (Full)^^R^1^^^^^^^"
^DIC(19,10698,1,0)="^^4^4^2970805^^"
^DIC(19,10698,1,1,0)="This option shows the pointer and subfile links that reach outward from"
^DIC(19,10698,1,2,0)="a selected table.  Regular pointers (foreign keys or FKs) as well as"
^DIC(19,10698,1,3,0)="subfile links out and up to parent files (parent foreign keys or PFKs)"
^DIC(19,10698,1,4,0)="are shown."
^DIC(19,10698,25)="EN2^DMSQP"
^DIC(19,10698,"U")="LIST POINTER AND PARENT LINKS "
^DIC(19,10699,0)="DMSQ TS SUBFILE BRIEF^List Subfile Links (Brief)^^R^1^^^^^^^"
^DIC(19,10699,1,0)="^^3^3^2970805^^"
^DIC(19,10699,1,1,0)="This lists subfiles of a selected file number.  The subfile numbers are"
^DIC(19,10699,1,2,0)="also shown.  These number can then be used in other options to find out"
^DIC(19,10699,1,3,0)="what foreign keys are in the tables built from these subfiles."
^DIC(19,10699,25)="EN1^DMSQP2"
^DIC(19,10699,"U")="LIST SUBFILE LINKS (BRIEF)"
^DIC(19,10700,0)="DMSQ TS PTR SUBFILE FULL^List Incoming Pointer/Subfile Links (Full)^^R^1^^^^^^^"
^DIC(19,10700,1,0)="^^4^4^2970805^^"
^DIC(19,10700,1,1,0)="This option shows the foreign key names of incoming links, either from"
^DIC(19,10700,1,2,0)="pointers or subfile links.  It also shows the table that has the link."
^DIC(19,10700,1,3,0)="So, for the selected table, a list of links that exist in other tables"
^DIC(19,10700,1,4,0)="can be determined."
^DIC(19,10700,25)="EN1^DMSQP"
^DIC(19,10700,"U")="LIST INCOMING POINTER/SUBFILE "
^DIC(19,10701,0)="DMSQ TS FIELDS FULL^Field Listing by File (Full)^^R^1^^^^^^^"
^DIC(19,10701,1,0)="^^14^14^2970805^^"
^DIC(19,10701,1,1,0)="This can be used to see how the fields of a file or subfile were"
^DIC(19,10701,1,2,0)="projected as columns in a table.  It only shows regular columns.  It"
^DIC(19,10701,1,3,0)="doesn't include any Table_ID columns, ones automatically created"
^DIC(19,10701,1,4,0)="based on the internal entry numbers of the files and subfiles.  It also"
^DIC(19,10701,1,5,0)="doesn't show foreign keys, links that are automatically created when"
^DIC(19,10701,1,6,0)="there's a pointer or subfile connection.  (Other options can be used to"
^DIC(19,10701,1,7,0)="discover the names of foreign keys.)"
^DIC(19,10701,1,8,0)=" "
^DIC(19,10701,1,9,0)="Don't be surprised when the list of fields seems short.  Remember that"
^DIC(19,10701,1,10,0)="if there are any subfiles associated with the file name that you entered,"
^DIC(19,10701,1,11,0)="there will be separate tables for them.  Use the option that shows"
^DIC(19,10701,1,12,0)="subfiles to get the numbers to use with this option.  That will let you"
^DIC(19,10701,1,13,0)="find all the columns associated with the files in a given file and its"
^DIC(19,10701,1,14,0)="subfiles."
^DIC(19,10701,25)="EN^DMSQP2"
^DIC(19,10701,"U")="FIELD LISTING BY FILE (FULL)"
^DIC(19,10702,0)="DMSQ TS FIELDS BRIEF^Field Listing by File (Brief)^^R^1^^^^^^^"
^DIC(19,10702,1,0)="^^17^17^2970805^^"
^DIC(19,10702,1,1,0)="This option is like a brief data dictionary listing.  Along with the"
^DIC(19,10702,1,2,0)="file and field names are the corresponding table and column names.  It"
^DIC(19,10702,1,3,0)="also shows the field's type, like word-processing or set-of-codes.  If"
^DIC(19,10702,1,4,0)="the field is a pointer, the pointed-to file/subfile number is shown.  If"
^DIC(19,10702,1,5,0)="the field is within a subfile, the number of the parent file is shown."
^DIC(19,10702,1,6,0)=" "
^DIC(19,10702,1,7,0)="In this way, all files and fields can be displayed at one level, without"
^DIC(19,10702,1,8,0)="the indentation needed with the usual hierarchical display format.  But"
^DIC(19,10702,1,9,0)="to find out how files are linked, you may need to follow a long chain"
^DIC(19,10702,1,10,0)="from one link to the next."
^DIC(19,10702,1,11,0)=" "
^DIC(19,10702,1,12,0)="The fields global location is also listed.  The $PIECE syntax is used"
^DIC(19,10702,1,13,0)="when the field is from a particular piece of a global node.  The $EXTRACT"
^DIC(19,10702,1,14,0)="format is used when, like for MUMPS-type fields, the location is an"
^DIC(19,10702,1,15,0)="extracted portion of the entire node, say from character 1 to 245.  For"
^DIC(19,10702,1,16,0)="computed fields, of course, there isn't a global location since these are"
^DIC(19,10702,1,17,0)="virtual fields that only perform calculations."
^DIC(19,10702,25)="EN^DMSQP5"
^DIC(19,10702,"U")="FIELD LISTING BY FILE (BRIEF)"
^DIC(19,10703,0)="DMSQ TS NAMES^Table Name Listing (VA FileMan vs. SQLI)^^R^1^^^^^^^"
^DIC(19,10703,1,0)="^^4^4^2970805^^"
^DIC(19,10703,1,1,0)="This option lists file/subfile names along with their corresponding"
^DIC(19,10703,1,2,0)="table names.  The list is sorted by file number and prompts for a"
^DIC(19,10703,1,3,0)="range.  To see the table names for the files and subfiles of 9.4, the"
^DIC(19,10703,1,4,0)="Package file, for example, you could start from 9.4 and go to 9.5."
^DIC(19,10703,25)="EN3^DMSQP2"
^DIC(19,10703,"U")="TABLE NAME LISTING (VA FILEMAN"
^DIC(19,10704,0)="DMSQ TS PTR STATS^Pointer Statistics by Individual Table^^R^1^^^^^^^^^^1"
^DIC(19,10704,1,0)="^^6^6^2971019^^^^"
^DIC(19,10704,1,1,0)="This option can be used just to see the total number of various kinds"
^DIC(19,10704,1,2,0)="of links for a given table.  You can then use these totals to confirm"
^DIC(19,10704,1,3,0)="that you have found all the actual foreign key links (FKs and PFKs)"
^DIC(19,10704,1,4,0)="by using other options.  (The FKs are regular pointers, or foreign"
^DIC(19,10704,1,5,0)="keys.  The PFKs are subfile links to parent files, or parent foreign"
^DIC(19,10704,1,6,0)="keys.)"
^DIC(19,10704,15)="S XQMM(""N"")="""""
^DIC(19,10704,25)="EN^DMSQP3"
^DIC(19,10704,"U")="POINTER STATISTICS BY INDIVIDU"
^DIC(19,10705,0)="DMSQ TS PTR STATS SUMMARY^Pointer Statistics (Summary)^^R^1^^^^^^^"
^DIC(19,10705,1,0)="^^13^13^2970805^^"
^DIC(19,10705,1,1,0)="This report is about all tables and can take a little while to run.  If"
^DIC(19,10705,1,2,0)="you are interested in finding out how many table links there are among"
^DIC(19,10705,1,3,0)="all tables on your system, this option will tell you.  It divides up"
^DIC(19,10705,1,4,0)="the different types of links with a separate report for each.  "
^DIC(19,10705,1,5,0)=" "
^DIC(19,10705,1,6,0)="The five reports that are joined with this option show the number of"
^DIC(19,10705,1,7,0)="tables with self-referential pointers, upward links from subfiles,"
^DIC(19,10705,1,8,0)="links coming in from subfiles below, pointers going outward, and"
^DIC(19,10705,1,9,0)="pointers coming inward."
^DIC(19,10705,1,10,0)=" "
^DIC(19,10705,1,11,0)="You have a choice of seeing just the total counts or details.  Details"
^DIC(19,10705,1,12,0)="include table names, so you can find out which ones have the most"
^DIC(19,10705,1,13,0)="pointers of a certain type, etc."
^DIC(19,10705,25)="EN1^DMSQP3"
^DIC(19,10705,"U")="POINTER STATISTICS (SUMMARY)"
^DIC(19,10706,0)="DMSQ TS MENU^Table Statistics Reports^^M^1^^^^^^^"
^DIC(19,10706,1,0)="^^5^5^2970805^^^^"
^DIC(19,10706,1,1,0)="For a given file number, this shows column names in the current table"
^DIC(19,10706,1,2,0)="that point to other tables.  The column may be based on a regular"
^DIC(19,10706,1,3,0)="pointer or on a subfile link to a parent table.  (Regular pointers are"
^DIC(19,10706,1,4,0)="indicated as FK, foreign keys.  Subfile links to parents are identified"
^DIC(19,10706,1,5,0)="with PFK, parent foreign keys.)"
^DIC(19,10706,10,0)="^19.01IP^9^9"
^DIC(19,10706,10,1,0)="10702^DD1^10"
^DIC(19,10706,10,2,0)="10701^DD2^11"
^DIC(19,10706,10,3,0)="10703^NAME^50"
^DIC(19,10706,10,4,0)="10697^OUT1^30"
^DIC(19,10706,10,5,0)="10698^OUT2^31"
^DIC(19,10706,10,6,0)="10704^CNT1^40"
^DIC(19,10706,10,7,0)="10705^CNT2^41"
^DIC(19,10706,10,8,0)="10699^IN1^20"
^DIC(19,10706,10,9,0)="10700^IN2^21"
^DIC(19,10706,10,"B",10697,4)=""
^DIC(19,10706,10,"B",10698,5)=""
^DIC(19,10706,10,"B",10699,8)=""
^DIC(19,10706,10,"B",10700,9)=""
^DIC(19,10706,10,"B",10701,2)=""
^DIC(19,10706,10,"B",10702,1)=""
^DIC(19,10706,10,"B",10703,3)=""
^DIC(19,10706,10,"B",10704,6)=""
^DIC(19,10706,10,"B",10705,7)=""
^DIC(19,10706,10,"C","CNT1",6)=""
^DIC(19,10706,10,"C","CNT2",7)=""
^DIC(19,10706,10,"C","DD1",1)=""
^DIC(19,10706,10,"C","DD2",2)=""
^DIC(19,10706,10,"C","IN1",8)=""
^DIC(19,10706,10,"C","IN2",9)=""
^DIC(19,10706,10,"C","NAME",3)=""
^DIC(19,10706,10,"C","OUT1",4)=""
^DIC(19,10706,10,"C","OUT2",5)=""
^DIC(19,10706,99)="64176,46884"
^DIC(19,10706,"U")="TABLE STATISTICS REPORTS"
^DIC(19,10707,0)="DMSQ SUGGEST TABLE GROUPINGS^Suggest Table Groupings^^R^1^^^^^^^"
^DIC(19,10707,1,0)="^^40^40^2971021^^^^"
^DIC(19,10707,1,1,0)="This option can take a few minutes to run.  Use it when you have some"
^DIC(19,10707,1,2,0)="extra time to explore the sharing relationships among files.  With it,"
^DIC(19,10707,1,3,0)="though, you can find out which tables are often referenced by others."
^DIC(19,10707,1,4,0)=" "
^DIC(19,10707,1,5,0)="You will be prompted for a cutoff point.  This is used to subset the"
^DIC(19,10707,1,6,0)="resulting groups.  If you use a high cutoff, like 150, you will get back"
^DIC(19,10707,1,7,0)="a fairly short shared table list, including only those files that have"
^DIC(19,10707,1,8,0)="more interconnections that the cutoff, like New Person and Patient."
^DIC(19,10707,1,9,0)=" "
^DIC(19,10707,1,10,0)="A cutoff around five might give the most useful subdivisions.  That"
^DIC(19,10707,1,11,0)="might put 200-300 tables in the shared group, leaving all the other"
^DIC(19,10707,1,12,0)="tables in fairly small mutually exclusive groups of 30 or so.  This"
^DIC(19,10707,1,13,0)="approach ends up with a large number of small tables, though, like around"
^DIC(19,10707,1,14,0)="700 or more."
^DIC(19,10707,1,15,0)=" "
^DIC(19,10707,1,16,0)="The purpose of this utility is to give you an idea about how to group"
^DIC(19,10707,1,17,0)="tables when assigning access to users by profile.  If you already had a"
^DIC(19,10707,1,18,0)="user profile with access to a set of interrelated tables, you could use"
^DIC(19,10707,1,19,0)="the profile for other users who were interested in the same tables."
^DIC(19,10707,1,20,0)=" "
^DIC(19,10707,1,21,0)="Note that this utility doesn't list tables without any connection to"
^DIC(19,10707,1,22,0)="others (a relatively small set, however!).  Also note that the table that"
^DIC(19,10707,1,23,0)="has the most sharing activity compared with other members of the group"
^DIC(19,10707,1,24,0)="is used to identify the group in this option's printout."
^DIC(19,10707,1,25,0)=" "
^DIC(19,10707,1,26,0)="After entering a cutoff, you are prompted for a table of special"
^DIC(19,10707,1,27,0)="interest.  If you want to see where a particular table ends up in the"
^DIC(19,10707,1,28,0)="final analysis, enter it here.  As a result, after the shared tables"
^DIC(19,10707,1,29,0)="are listed, you will get a special report showing your table and its"
^DIC(19,10707,1,30,0)="group.  After that, all the groups are listed."
^DIC(19,10707,1,31,0)=" "
^DIC(19,10707,1,32,0)="Running this option with several cutoff points might show the following:"
^DIC(19,10707,1,33,0)=" "
^DIC(19,10707,1,34,0)=" Cutoff   Total Shared   Number of other Groups   Member totals"
^DIC(19,10707,1,35,0)=" -----------------------------------------------------------------"
^DIC(19,10707,1,36,0)=" 50        11            227                      3391,32..."
^DIC(19,10707,1,37,0)=" 10       122            534                      275,140,112..."
^DIC(19,10707,1,38,0)=" 5        284            718                      34,33,32,32,26..."
^DIC(19,10707,1,39,0)=" "
^DIC(19,10707,1,40,0)="There isn't any right way; just experiment as you wish!"
^DIC(19,10707,25)="EN^DMSQP6"
^DIC(19,10707,"U")="SUGGEST TABLE GROUPINGS"
^DIC(19,10708,0)="DMSQ PS COLUMNS BY DOMAIN^Columns by Domain^^R^1^^^^^^^"
^DIC(19,10708,1,0)="^^19^19^2970806^^"
^DIC(19,10708,1,1,0)="This report counts the number of columns in each domain category, so"
^DIC(19,10708,1,2,0)="you can see how many are pointers, dates, or numbers.  It only looks at"
^DIC(19,10708,1,3,0)="columns from regular (non-index) tables and excludes the automatically"
^DIC(19,10708,1,4,0)="generated Table_ID columns built from internal entry numbers."
^DIC(19,10708,1,5,0)=" "
^DIC(19,10708,1,6,0)="Here is an example of percentages from a sample account:"
^DIC(19,10708,1,7,0)=" "
^DIC(19,10708,1,8,0)=" Ingeger           7499     22.2%"
^DIC(19,10708,1,9,0)=" Character        10972     32.5%"
^DIC(19,10708,1,10,0)=" Pointer           4730     14.0%"
^DIC(19,10708,1,11,0)=" Set-of-Codes      4575     13.5%"
^DIC(19,10708,1,12,0)=" Number            2429      7.2%"
^DIC(19,10708,1,13,0)=" Moment            1272      3.8%"
^DIC(19,10708,1,14,0)=" Date              1393      4.1%"
^DIC(19,10708,1,15,0)=" Word-processing    687      2.0%"
^DIC(19,10708,1,16,0)=" MUMPS              180       .5%"
^DIC(19,10708,1,17,0)=" Variable pointer    58       .2%"
^DIC(19,10708,1,18,0)=" "
^DIC(19,10708,1,19,0)=" TOTAL            33795"
^DIC(19,10708,25)="EN9^DMSQP1"
^DIC(19,10708,"U")="COLUMNS BY DOMAIN"
^DIC(19,10709,0)="DMSQ DIAGNOSTICS^Find Out SQLI Status^^R^1^^^^^^^^^^1"
^DIC(19,10709,1,0)="^^10^10^2971026^"
^DIC(19,10709,1,1,0)="This option prints a current status report of the SQLI projection"
^DIC(19,10709,1,2,0)="process.  It indicates when the projection was last run and whether"
^DIC(19,10709,1,3,0)="it successfully ran to completion.  If problems were encountered and"
^DIC(19,10709,1,4,0)="the process stopped, it tries to identify where and list the file"
^DIC(19,10709,1,5,0)="or field that might have caused the problem."
^DIC(19,10709,1,6,0)=" "
^DIC(19,10709,1,7,0)="It is intended as the first step in diagnosing problems (hard errors)"
^DIC(19,10709,1,8,0)="that may occur when running the SQLI projection.  The SQLI Site Manual"
^DIC(19,10709,1,9,0)="outlines additional steps (see the Trouble-Shooting section) including"
^DIC(19,10709,1,10,0)="using the RUNONE^DMSQ utility with potential problem files."
^DIC(19,10709,15)="S XQMM(""N"")="""""
^DIC(19,10709,25)="EN^DMSQT"
^DIC(19,10709,"U")="FIND OUT SQLI STATUS"
^DIC(19,10710,0)="TIU DEFINE CONSULTS^Define CONSULTS for TIU/CT Interface^^A^11597^^^^^^y^516^^1"
^DIC(19,10710,1,0)="^^4^4^2971205^"
^DIC(19,10710,1,1,0)="This option should be run by the Clinical Applications Coordinator,"
^DIC(19,10710,1,2,0)="in cooperation with the IRM Staff supporting TIU, to define CONSULTS"
^DIC(19,10710,1,3,0)="as either an independent Class, or as a Document Class under Progress"
^DIC(19,10710,1,4,0)="Notes."
^DIC(19,10710,20)="D MAIN^TIUPS14"
^DIC(19,10710,"U")="DEFINE CONSULTS FOR TIU/CT INT"
^DIC(19,10712,0)="ZZ VSHELL^VPE MAIN MENU^^A^983^^^^^^^^^1"
^DIC(19,10712,20)="X ""N XQY0 X ^%ZVEMS"""
^DIC(19,10712,"U")="VPE MAIN MENU"
^DIC(19,10713,0)="USR USER TERMINATE^USR USER TERMINATE^^A^11712^^^^^^^^^1"
^DIC(19,10713,1,0)="^^3^3^2980115^^"
^DIC(19,10713,1,1,0)="This option is for attaching to the XU USER TERMINATE option so that"
^DIC(19,10713,1,2,0)="when a user is terminated all class memberships will be automatically"
^DIC(19,10713,1,3,0)="expired."
^DIC(19,10713,20)="D TERM^USRLM"
^DIC(19,10713,"U")="USR USER TERMINATE"
^DIC(19,10714,0)="TIU GMRD CONVERSION MENU^Discharge Summary Conversion^^M^11597^^^^^^^516"
^DIC(19,10714,1,0)="^^3^3^2971121^^"
^DIC(19,10714,1,1,0)="Menu containing options for moving Discharge Summaries from the GMR"
^DIC(19,10714,1,2,0)="REPORTS File ^GMR(128 to the Text Integration Utilities Document File"
^DIC(19,10714,1,3,0)="^TIU(8925."
^DIC(19,10714,10,0)="^19.01IP^7^2"
^DIC(19,10714,10,1,0)="10410^CV^1"
^DIC(19,10714,10,7,0)="10715^SG^5"
^DIC(19,10714,10,"B",10410,1)=""
^DIC(19,10714,10,"B",10715,7)=""
^DIC(19,10714,10,"C","CV",1)=""
^DIC(19,10714,10,"C","SG",7)=""
^DIC(19,10714,99)="57462,26880"
^DIC(19,10714,"U")="DISCHARGE SUMMARY CONVERSION"
^DIC(19,10715,0)="TIU GMRD CONVERT SINGLE^Single Discharge Summary Conversion^^A^11597^^^^^^y^516^^1"
^DIC(19,10715,1,0)="^^3^3^2971121^"
^DIC(19,10715,1,1,0)="Option permits conversion of a single Discharge Summary.  This will allow"
^DIC(19,10715,1,2,0)="sites to correct Discharge Summaries which were not converted due to"
^DIC(19,10715,1,3,0)="incomplete data and place them in the TIU files."
^DIC(19,10715,20)="D MOVEONE^TIUDSCN1"
^DIC(19,10715,"U")="SINGLE DISCHARGE SUMMARY CONVE"
^DIC(19,10716,0)="TIU GMRPN FINAL^Final Pass Progress Notes Conversion^^A^11597^^^^^^^516^^1^^^"
^DIC(19,10716,1,0)="^^12^12^2971209^"
^DIC(19,10716,1,1,0)="This option will process all remaining unconverted progress notes. Notes"
^DIC(19,10716,1,2,0)="that cannot be converted will be identified, along with the the reason"
^DIC(19,10716,1,3,0)="they could not be converted, as the process runs. It is HIGHLY RECOMMENDED"
^DIC(19,10716,1,4,0)="that you queue this option to a printer so you can review the notes that"
^DIC(19,10716,1,5,0)="did not convert."
^DIC(19,10716,1,6,0)=" "
^DIC(19,10716,1,7,0)="This option should be run after you have completed the final progress"
^DIC(19,10716,1,8,0)="notes conversion pass.  This will move all remaining notes (including"
^DIC(19,10716,1,9,0)="unsigned and uncosigned) to TIU."
^DIC(19,10716,1,10,0)=" "
^DIC(19,10716,1,11,0)="Notes that are reported as not converting, that you subsequently fix,"
^DIC(19,10716,1,12,0)="should be moved using the SINGLE PROGRES NOTES CONVERSION option."
^DIC(19,10716,20)="W !!,$$CENTER^TIULS(""--- Final PN Conversion Pass ---""),! D EN^TIUPNCVU"
^DIC(19,10716,26)=""
^DIC(19,10716,"U")="FINAL PASS PROGRESS NOTES CONV"
^DIC(19,10739,0)="XUCSX DAILY REPORT^Manual Daily Report^^R^10000000033^^^^^^^477"
^DIC(19,10739,1,0)="^^4^4^2960114^"
^DIC(19,10739,1,1,0)="This is a one-page site summary which is used for the daily report,"
^DIC(19,10739,1,2,0)="automatically sent to recipients specified in the MSM RTHIST SITE file."
^DIC(19,10739,1,3,0)="This entry point will allow an interactively specified site summary"
^DIC(19,10739,1,4,0)="report to be sent to specified recipients."
^DIC(19,10739,25)="XUCSXDR"
^DIC(19,10739,"U")="MANUAL DAILY REPORT"
^DIC(19,10740,0)="XUCSX LOCAL XSTE PREF^Local XSITE Preformance Report^^R^10000000033^^^^^^^477"
^DIC(19,10740,1,0)="^^4^4^2960114^"
^DIC(19,10740,1,1,0)="This is the locally run option of the cross site report.  This preformance"
^DIC(19,10740,1,2,0)="report includes %CPU, %DISK, and JOBs for CS*, FS*, and PS*, as well as"
^DIC(19,10740,1,3,0)="Response Time for CS*.  Altho, this report can be run for a single day, it"
^DIC(19,10740,1,4,0)="is suggested that it be run over a multiple of days."
^DIC(19,10740,25)="XUCSXCD"
^DIC(19,10740,"U")="LOCAL XSITE PREFORMANCE REPORT"
^DIC(19,10741,0)="XUCSX LOCAL XSITE RT^Local XSITE Resp. Time Report^^R^10000000033^^^^^^^477"
^DIC(19,10741,1,0)="^^4^4^2960114^"
^DIC(19,10741,1,1,0)="This is the locally run option for the cross site Response Time Report for"
^DIC(19,10741,1,2,0)="CS*.  It includes the number of responses (events) as well as a frequency"
^DIC(19,10741,1,3,0)="of distribution of responses times. Altho, this option can be run for a"
^DIC(19,10741,1,4,0)="single day, it is suggested that it be run for a multiple of days."
^DIC(19,10741,25)="XUCSXRT"
^DIC(19,10741,"U")="LOCAL XSITE RESP. TIME REPORT"
^DIC(19,10742,0)="XUCSX LOCAL XSITE SYSSTATS^Local XSITE System Stats. Report^^R^10000000033^^^^^^^477"
^DIC(19,10742,1,0)="^^7^7^2960114^"
^DIC(19,10742,1,1,0)="This is a local option to run the system statistics report.  It shows"
^DIC(19,10742,1,2,0)="events/sec for M commands, global gets, global sets and kills, logical"
^DIC(19,10742,1,3,0)="reads, logical writes, disk reads, disk writes, DDP requests, RVG"
^DIC(19,10742,1,4,0)="requests, terminal charachers input, terminal characters out, number of"
^DIC(19,10742,1,5,0)="jopbs, and number of runs contributing to the average, for all nodes"
^DIC(19,10742,1,6,0)="running MPM.  Altho, this option can be run for one day, it is suggest"
^DIC(19,10742,1,7,0)="that it be run over a peroid of time."
^DIC(19,10742,25)="XUCSXST"
^DIC(19,10742,"U")="LOCAL XSITE SYSTEM STATS. REPO"
