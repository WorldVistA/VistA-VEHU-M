^DIC(19,16594,0)="EHM-01415^List Patients with Problem List data^^R^1^^^^^^^402^^^^"
^DIC(19,16594,1,0)="^^3^3^3240328^^"
^DIC(19,16594,1,1,0)="This option will generate a listing of all patients having data"
^DIC(19,16594,1,2,0)="in the Problem file #9000011."
^DIC(19,16594,1,3,0)="Cloned from ""GMPL PATIENT LISTING"" option."
^DIC(19,16594,3)=""
^DIC(19,16594,25)="PAT^GMPLRPTS"
^DIC(19,16594,"U")="LIST PATIENTS WITH PROBLEM LIS"
^DIC(19,16595,0)="EHM-01416^Search for Patients having selected Problem^^R^1^^^^^^^402^^^^"
^DIC(19,16595,1,0)="^^5^5^3240328^"
^DIC(19,16595,1,1,0)="This option will generate a listing of all patients identified as"
^DIC(19,16595,1,2,0)="having a particular problem in the Problem file #9000011; the user"
^DIC(19,16595,1,3,0)="is first prompted for the problem, then the file is searched for"
^DIC(19,16595,1,4,0)="patients having this problem."
^DIC(19,16595,1,5,0)="Cloned from ""GMPL PROBLEM LISTING"" option."
^DIC(19,16595,3)=""
^DIC(19,16595,25)="PROB^GMPLRPTS"
^DIC(19,16595,"U")="SEARCH FOR PATIENTS HAVING SEL"
^DIC(19,16596,0)="EHM-01417^Create Problem Selection Lists^^M^1^^^^^^^402^^^^"
^DIC(19,16596,1,0)="^^6^6^3240328^^"
^DIC(19,16596,1,1,0)="This menu contains options that facilitate building and maintaining"
^DIC(19,16596,1,2,0)="lists of commonly selected problems.  Problem groups are defined, and"
^DIC(19,16596,1,3,0)="these groups are then linked together to form a list; a group may be"
^DIC(19,16596,1,4,0)="reused, as a member of multiple lists, and it may be assigned a sequence"
^DIC(19,16596,1,5,0)="number and header for ordering and clarity within the list."
^DIC(19,16596,1,6,0)="Cloned from ""GMPL BUILD LIST MENU"" option."
^DIC(19,16596,3)=""
^DIC(19,16596,10,0)="^19.01IP^6^6"
^DIC(19,16596,10,1,0)="16597^1^1"
^DIC(19,16596,10,2,0)="16598^3^3"
^DIC(19,16596,10,3,0)="16599^2^2"
^DIC(19,16596,10,4,0)="16600^4^4"
^DIC(19,16596,10,5,0)="16601^5^5"
^DIC(19,16596,10,6,0)="16602^6^6"
^DIC(19,16596,10,"B",16597,1)=""
^DIC(19,16596,10,"B",16598,2)=""
