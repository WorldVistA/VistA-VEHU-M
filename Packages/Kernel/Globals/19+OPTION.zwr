^DIC(19,8456,0)="LR SUPER/WKLD MENU^Supervisor workload menu^^M^.5^^^^^^^26"
^DIC(19,8456,1,0)="^^1^1^2931101^^^"
^DIC(19,8456,1,1,0)="This menu contains the workload options available to the lab supervisor."
^DIC(19,8456,10,0)="^19.01PI^10^10"
