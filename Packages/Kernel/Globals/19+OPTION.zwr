^DIC(19,9374,0)="IBDF VALIDATE FORMS^Validate Forms^** This option is OUT OF ORDER **^R^10000000020^^^^^^^485"
^DIC(19,9374,1,0)="^^3^3^2960523^^"
^DIC(19,9374,1,1,0)="Report used to validate the data that will be passed to PCE"
^DIC(19,9374,1,2,0)="when an Encounter Form is scanned.  The report may be sorted"
^DIC(19,9374,1,3,0)="by Division, Clinic Group, Clinic or Form."
^DIC(19,9374,25)="IBDFFV"
^DIC(19,9374,"U")="VALIDATE FORMS"
^DIC(19,9375,0)="IBDF PRINT SAMPLE ALL CLINICS^Print Sample of all Forms^^R^11720^^^^^^^485"
^DIC(19,9375,1,0)="^^4^4^2960108^^^^"
^DIC(19,9375,1,1,0)="This option will print out one copy of each form currently assigned to a"
^DIC(19,9375,1,2,0)="clinic and that is in use.  Use this to prepare a package of materials"
^DIC(19,9375,1,3,0)="for review or sharing with other facilities."
^DIC(19,9375,1,4,0)=""
^DIC(19,9375,25)="IBDFFSMP"
^DIC(19,9375,"U")="PRINT SAMPLE OF ALL FORMS"
^DIC(19,9376,0)="IBDF EDIT SITE PARAM^Edit Site Parameters^^R^11720^^^^^^^485"
^DIC(19,9376,1,0)="^^3^3^2970414^^^^"
^DIC(19,9376,1,1,0)="This option will allow editing of AICS site parameters that affect"
^DIC(19,9376,1,2,0)="the printing of forms, manual data entry, the purge utility and"
^DIC(19,9376,1,3,0)="scanning."
^DIC(19,9376,25)="IBDFESP"
^DIC(19,9376,"U")="EDIT SITE PARAMETERS"
^DIC(19,9377,0)="IBDF EDIT PRINTERS^Device Edit^^R^11594^^^^^^^485"
^DIC(19,9377,1,0)="^^5^5^2960524^^^^"
^DIC(19,9377,1,1,0)="This option allows editing of the Encounter Form Printers file.  You"
^DIC(19,9377,1,2,0)="can specify whether or not a terminal type is PCL5 compatible and the"
^DIC(19,9377,1,3,0)="proper escape sequences for simplex and duplex.  Only PCL5 compatible"
^DIC(19,9377,1,4,0)="printers can print scannable encounter forms, and must be so indicated."
^DIC(19,9377,1,5,0)="Generally HP laser printers are PCL5 compatible."
^DIC(19,9377,25)="IBDFDVE"
^DIC(19,9377,"U")="DEVICE EDIT"
