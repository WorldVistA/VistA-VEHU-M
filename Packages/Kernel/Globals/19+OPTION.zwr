^DIC(19,11814,0)="ORQP REPORT MGR MENU^GUI Report Parameters^^M^10000000020^^^^^^^"
^DIC(19,11814,1,0)="^^2^2^3001017^"
^DIC(19,11814,1,1,0)="This is a menu of options that allow the editing of various GUI report"
^DIC(19,11814,1,2,0)="parameters."
