^DIC(19,15988,0)="EHM-00809^Edit a User's Options^^R^1^^^^^^^^n^^^"
^DIC(19,15988,1,0)="^^2^2^3240328^^^"
^DIC(19,15988,1,1,0)="Allows user to edit primary and seconday user options."
^DIC(19,15988,1,2,0)="Cloned from ""XQSMD EDIT OPTIONS"" option."
^DIC(19,15988,3)=""
^DIC(19,15988,25)="ENTRY^XQSMD5"
