^DIC(19,13412,1,1,0)="This option allows supervisors to identify any incomplete daily ESRs"
^DIC(19,13412,1,2,0)="that occurred during the part-time physician's memoranda."
^DIC(19,13412,25)="SUP^PRSPEEM"
