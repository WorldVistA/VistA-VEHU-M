^DIC(19,13235,"U")="ROI"
^DIC(19,13236,0)="DGPF ACTION NOT LINKED REPORT^Assignment Action Not Linked Report^^R^11720^^^^^^^114^"
^DIC(19,13236,1,0)="^19.06^2^2^3180629^^"
^DIC(19,13236,1,1,0)="This option will be used to display or print all of the PRF Assignment"
^DIC(19,13236,1,2,0)="History actions that are not linked to a progress note."
^DIC(19,13236,25)="EN^DGPFRAL"
^DIC(19,13236,200.9)="^y"
^DIC(19,13236,"U")="ASSIGNMENT ACTION NOT LINKED R"
^DIC(19,13237,0)="DGPF PATIENT ASSIGNMENT REPORT^Patient Assignments Report^^R^10000000020^^^^^^y^114"
^DIC(19,13237,1,0)="^^2^2^3040617^"
^DIC(19,13237,1,1,0)="This option will be used to display or print all PRF Assignments "
^DIC(19,13237,1,2,0)="of a patient for Category I or Category II Record Flags."
^DIC(19,13237,25)="EN^DGPFRPA"
^DIC(19,13237,200.9)="^y"
^DIC(19,13237,"U")="PATIENT ASSIGNMENTS REPORT"
^DIC(19,13238,0)="DGPF APPROVED BY REPORT^Assignments Approved By Report^^R^10000000020^^^^^^y^114"
^DIC(19,13238,1,0)="^^3^3^3040617^"
^DIC(19,13238,1,1,0)="This option will be used to display or print all of the PRF Assignment"
^DIC(19,13238,1,2,0)="History actions for the person who approved the assignment of the"
^DIC(19,13238,1,3,0)="record flag to the patient."
^DIC(19,13238,25)="EN^DGPFRAB"
^DIC(19,13238,200.9)="^y"
^DIC(19,13238,"U")="ASSIGNMENTS APPROVED BY REPORT"
^DIC(19,13239,0)="DGPF PRINCIPAL INVEST REPORT^Assignments by Principal Investigator Report^^R^10000000020^^^^^^y^114"
^DIC(19,13239,1,0)="^^3^3^3040617^"
^DIC(19,13239,1,1,0)="This option will be used to display or print all of the PRF Assignment "
^DIC(19,13239,1,2,0)="History actions for a Principal Investigator.  Only Research Type"
^DIC(19,13239,1,3,0)="record flags will have a Principal Investigator assigned for that flag."
^DIC(19,13239,25)="EN^DGPFRPI"
^DIC(19,13239,200.9)="^y"
^DIC(19,13239,"U")="ASSIGNMENTS BY PRINCIPAL INVES"
^DIC(19,13240,0)="ORWORB REMOVE NON-OR^GUI Remove Button Enabled for Non-OR Alerts^^A^10000000020^^^^^^^170^^1"
^DIC(19,13240,1,0)="^^13^13^3040831^"
^DIC(19,13240,1,1,0)="This option allows you to set the flag to indicate if a non-OR alert can"
^DIC(19,13240,1,2,0)="be deleted without processing via the GUI alert Remove button. Enter the"
^DIC(19,13240,1,3,0)="Alert identifier (XQAID) or a portion of the Alert identifier for each"
^DIC(19,13240,1,4,0)="type of alert you want to be able to remove in the CPRS GUI via the Remove"
^DIC(19,13240,1,5,0)="button. For example, to remove NOIS alerts enter FSC.  You may enter as"
^DIC(19,13240,1,6,0)="many alert identifiers as desired.  Please note that most alert"
^DIC(19,13240,1,7,0)="identifiers include information specific to the patient or instance which"
^DIC(19,13240,1,8,0)="triggered the alert. For this parameter you should only enter the portion"
^DIC(19,13240,1,9,0)="of alert identifier which is consistent for all alerts of this type.  For"
^DIC(19,13240,1,10,0)="example, a NOIS alert's identifier might actually look like"
^DIC(19,13240,1,11,0)="FSC-M,275546.  Entering the entire alert identifier in this parameter will"
^DIC(19,13240,1,12,0)="only allow removal of this specific alert.  However if the parameter value"
^DIC(19,13240,1,13,0)="is FSC, all NOIS alerts can be removed."
^DIC(19,13240,10.1)="Remove Button Flag Non-OR"
^DIC(19,13240,20)="D EDITPAR^XPAREDIT(""ORB REMOVE NON-OR"")"
^DIC(19,13240,"U")="GUI REMOVE BUTTON ENABLED FOR "
^DIC(19,13241,0)="ORW ALLERGY EIE^GUI Mark Allergy Entered in Error^^A^10000000020^^^^^^^^^1"
^DIC(19,13241,1,0)="^19.06^5^5^3050207^^"
^DIC(19,13241,1,1,0)="The OR ALLERGY ENTERED IN ERROR parameter controls who can mark"
^DIC(19,13241,1,2,0)="an existing allergy as entered in error from the cover sheet.  Set"
^DIC(19,13241,1,3,0)="the appropriate level to ""yes"" if you wish to allow users to mark"
^DIC(19,13241,1,4,0)="allergies as entered in error.  This parameter can be set at"
^DIC(19,13241,1,5,0)="the system, division, class, and user level."
^DIC(19,13241,20)="D EDITPAR^XPAREDIT(""OR ALLERGY ENTERED IN ERROR"")"
^DIC(19,13241,"U")="GUI MARK ALLERGY ENTERED IN ER"
^DIC(19,13242,0)="ORW PFSS SWITCH^PFSS Activation Switch^^R^10000000020^^^^^^^170"
^DIC(19,13242,1,0)="^^2^2^3050726^"
^DIC(19,13242,1,1,0)="This option calls ORWPFSS0. This routine activates / deactivates the PFSS "
^DIC(19,13242,1,2,0)="switch for CPRS."
^DIC(19,13242,25)="ORWPFSS0"
^DIC(19,13242,"U")="PFSS ACTIVATION SWITCH"
^DIC(19,13243,0)="RMPR INV PRINT ORDER/RECEIVE^Print Order/Receive Item^^R^10000000020^^^^^^^249^^"
^DIC(19,13243,1,0)="^^3^3^3020211^"
^DIC(19,13243,1,1,0)="This option prints the Open, Receive or Cancel item in the PIP.  User will"
^DIC(19,13243,1,2,0)="be asked on the number of days back an item was received, opened or "
^DIC(19,13243,1,3,0)="cancelled."
^DIC(19,13243,20)=""
^DIC(19,13243,25)="RMPRPI09"
^DIC(19,13243,"U")="PRINT ORDER/RECEIVE ITEM"
^DIC(19,13244,0)="RMPR INV PRINT ITEM USAGE^Print Item Usage By Location^^R^10000000020^^^^^^^249"
^DIC(19,13244,1,0)="^^4^4^3020802^"
^DIC(19,13244,1,1,0)="This option prints a report that shows the same information as in the PIP"
^DIC(19,13244,1,2,0)="roll-up that is activated by CO, if the date range this report runs is the"
^DIC(19,13244,1,3,0)="same. It displays Stock On Hand for certain date range, sorted by"
^DIC(19,13244,1,4,0)="Location, HCPCS and Item for either NEW or OLD items."
^DIC(19,13244,25)="RMPRPI08"
^DIC(19,13244,"U")="PRINT ITEM USAGE BY LOCATION"
^DIC(19,13245,0)="RMPR INV EDIT LOCATION^Edit Inventory Location^^R^10000000020^^^^^^^"
^DIC(19,13245,1,0)="^19.06^1^1^3050202^^"
^DIC(19,13245,1,1,0)="This option is for editing an existing inventory location."
^DIC(19,13245,25)="EL^RMPRPIYN"
^DIC(19,13245,"U")="EDIT INVENTORY LOCATION"
^DIC(19,13246,0)="RMPR INV PRINT WORK SHEET^Print Stock Work Sheet^^R^10000000020^^^^^^^"
^DIC(19,13246,1,0)="^^3^3^3010924^"
^DIC(19,13246,1,1,0)="This report prints the inventory stock by Location of a particular "
^DIC(19,13246,1,2,0)="station.  It shows the HCPCS, Item descripton, Date, Cost, Vendor "
^DIC(19,13246,1,3,0)="Quantity, Location and a blank column for the Physical Count."
^DIC(19,13246,25)="RMPRPI15"
^DIC(19,13246,"U")="PRINT STOCK WORK SHEET"
^DIC(19,13247,0)="RMPR INV REPRINT BARCODE^Reprint Barcode Label^^R^10000000020^^^^^^^"
^DIC(19,13247,1,0)="^^2^2^3011005^"
^DIC(19,13247,1,1,0)="This option allows inventory users to print barcode labels.  Only HCPCS "
^DIC(19,13247,1,2,0)="in PIP can be printed using this option."
^DIC(19,13247,25)="PB^RMPRPIYS"
^DIC(19,13247,"U")="REPRINT BARCODE LABEL"
^DIC(19,13248,0)="RMPR INV PRINT 30-DAY^Print Items Not Issued Within 30-Day^^R^10000000020^^^^^^^"
^DIC(19,13248,1,0)="^^2^2^3021120^"
^DIC(19,13248,1,1,0)="This report prints items not issued within 30 days period.  Items issued "
^DIC(19,13248,1,2,0)="within 30 days will not be printed in this report."
^DIC(19,13248,25)="RMPRPI14"
^DIC(19,13248,"U")="PRINT ITEMS NOT ISSUED WITHIN "
^DIC(19,13249,0)="RMPR INV PRINT OVER DATE^Print Stock On Hand Over Date Range^^R^10000000020^^^^^^^"
^DIC(19,13249,1,0)="^^3^3^3011219^"
^DIC(19,13249,1,1,0)="This report prints all Items in a particular Location, where the number of"
^DIC(19,13249,1,2,0)="Days On Hand is greater than the number of Date Range selected."
^DIC(19,13249,1,3,0)="Sort creteria are based on Locations and New or Old Items."
^DIC(19,13249,25)="RMPRPI10"
^DIC(19,13249,"U")="PRINT STOCK ON HAND OVER DATE "
^DIC(19,13250,0)="RMPR INV DEACTIVATE^Deactivate Inventory Location^^R^10000000020^^^^^^^"
^DIC(19,13250,1,0)="^19.06^3^3^3050202^^^"
^DIC(19,13250,1,1,0)="This option is only given to the holder of RMPRMANGAER key.  It requires"
^DIC(19,13250,1,2,0)="the electronic signatures of 2 users holding the RMPRMANAGER key to be"
^DIC(19,13250,1,3,0)="entered before a location can be deactivated."
^DIC(19,13250,25)="DL^RMPRPIYL"
^DIC(19,13250,"U")="DEACTIVATE INVENTORY LOCATION"
^DIC(19,13251,0)="RMPR INV PRINT ALL BARCODE^Print All Barcode in a Location^^R^10000000020^RMPRMANAGER^^^^^^249"
^DIC(19,13251,1,0)="^19.06^4^4^3021126^^^"
^DIC(19,13251,1,1,0)="This option prints barcode of all items in a specific location for a "
^DIC(19,13251,1,2,0)="station.  In order to use this option, user must have an RMPRMANAGER "
^DIC(19,13251,1,3,0)="key.  Be sure to have enough labels before using this option, since it "
^DIC(19,13251,1,4,0)="will print labels for all items in a given station."
^DIC(19,13251,25)="PB^RMPRPIYZ"
^DIC(19,13251,"U")="PRINT ALL BARCODE IN A LOCATIO"
^DIC(19,13252,0)="RMPR INV PIP/IFCAP ITEM REPORT^Print PIP/IFCAP Item Report^^R^10000000020^^^^^^^"
^DIC(19,13252,1,0)="^^4^4^3021211^"
^DIC(19,13252,1,1,0)="This report prints all PIP items and the corresponding IFCAP items.  "
^DIC(19,13252,1,2,0)="Prosthetics users must edit the HCPCS/ITEM that has a blank IFCAP ITEM.  "
^DIC(19,13252,1,3,0)="This report is useful for checking if the IFCAP ITEM is correctly link to "
^DIC(19,13252,1,4,0)="the PIP Item."
^DIC(19,13252,25)="RMPRPI16"
^DIC(19,13252,"U")="PRINT PIP/IFCAP ITEM REPORT"
^DIC(19,13253,0)="RMPR INV REMOVE HCPCS/ITEM^Remove/Deactivate HCPCS/Item from Inventory^^R^10000000020^RMPRMANAGER^^^^^^249"
^DIC(19,13253,1,0)="^^4^4^3030102^"
^DIC(19,13253,1,1,0)="This option removes/deactivates inventory item(s) from Prosthetics "
^DIC(19,13253,1,2,0)="Inventory Program.  Once an item has been removed/deactivated, that "
^DIC(19,13253,1,3,0)="item is not accessible.  Only users with RMPRMANAGER key can access this "
^DIC(19,13253,1,4,0)="option."
^DIC(19,13253,25)="RE^RMPRPIXR"
^DIC(19,13253,"U")="REMOVE/DEACTIVATE HCPCS/ITEM F"
^DIC(19,13254,0)="LRED CPT^Test/Specimen/CPT Link^^R^10000000020^^^^^^^"
^DIC(19,13254,1,0)="^19.06^5^5^3030912^^^^"
^DIC(19,13254,1,1,0)="This option is used to update the LABORATORY TEST (#60) file with the"
^DIC(19,13254,1,2,0)="appropriate CPT/HCPCS codes necessary for billing.  For each test, the option"
^DIC(19,13254,1,3,0)="provides entry of CPT codes at the specimen level.  It also allows entry of a"
^DIC(19,13254,1,4,0)="default CPT or default HCPCS code for the test.  If no CPT is entered, the"
^DIC(19,13254,1,5,0)="billing system will use the CPT code located in the WKLD CODE (#64) file."
^DIC(19,13254,25)="LRBEECPT"
^DIC(19,13254,99.1)="59976,39298"
^DIC(19,13254,"U")="TEST/SPECIMEN/CPT LINK"
^DIC(19,13255,0)="LRBE PANEL CPT REPORT^Lab Tests and CPT Report^^R^10000000020^^^^^n^^26"
^DIC(19,13255,1,0)="^19.06^47^47^3060318^^"
^DIC(19,13255,1,1,0)="This option is designed to be reviewed by billing department and/or the"
^DIC(19,13255,1,2,0)="Lab service to determine if laboratory file setup complies with billing"
^DIC(19,13255,1,3,0)="guidelines and regulations. This option should be assigned to persons "
^DIC(19,13255,1,4,0)="involved with lab billing compliance including all applicable lab staff"
^DIC(19,13255,1,5,0)="(e.g. LIM, Lab Manager, AO, etc.)."
^DIC(19,13255,1,6,0)=" "
^DIC(19,13255,1,7,0)="This option will print CPT codes that will be passed to PCE based on the "
^DIC(19,13255,1,8,0)="Laboratory Billing Aware PCE reporting hierarchy. This report should be "
^DIC(19,13255,1,9,0)="used to assist proper CPT coding of laboratory test and panels. This "
^DIC(19,13255,1,10,0)="report will provide an alphabetical list of active laboratory procedures "
^DIC(19,13255,1,11,0)="that have CPT codes. There are multiple report sorting options provided; "
^DIC(19,13255,1,12,0)="all are printed in the same format. The data printed is determined by "
^DIC(19,13255,1,13,0)="certain fields in the Laboratory Test (#60) file and WKLD CODE (#64) file."
^DIC(19,13255,1,14,0)="Consult patch LR*5.2*291 documentation for coding guidelines."
^DIC(19,13255,1,15,0)=" "
^DIC(19,13255,1,16,0)="There are two forms of the report depending if the test is panel or "
^DIC(19,13255,1,17,0)="atomic. This is an example of a AMA Compliant panel test."
^DIC(19,13255,1,18,0)="Legend: IEN of test = Test Name"
^DIC(19,13255,1,19,0)="       CPT code  CPT code name  [Field location where the CPT is located]*"
^DIC(19,13255,1,20,0)="'*' Indicates this is a AMA Compliant panel."
^DIC(19,13255,1,21,0)="If test is a panel: a listing of the atomic tests"
^DIC(19,13255,1,22,0)="*********** r = Required Test [IEN of test] Test Name"
^DIC(19,13255,1,23,0)=" "
^DIC(19,13255,1,24,0)="372  =  LYTES"
^DIC(19,13255,1,25,0)="        80051  ELECTROLYTE PANEL  [DEFAULT SITE/SPECIMEN CPT]*"
^DIC(19,13255,1,26,0)=" "
^DIC(19,13255,1,27,0)="372 = LYTES"
^DIC(19,13255,1,28,0)="**********     r[176]  SODIUM"
^DIC(19,13255,1,29,0)="               r[177]  POTASSIUM"
^DIC(19,13255,1,30,0)="               r[178]  CHLORIDE"
^DIC(19,13255,1,31,0)="               r[179]  CO2"
^DIC(19,13255,1,32,0)=" "
^DIC(19,13255,1,33,0)="The second form is for atomic test. This form includes CPT codes by "
^DIC(19,13255,1,34,0)="specimen if the test has SITE/SPECIMEN  (multiple) entries."
^DIC(19,13255,1,35,0)=" "
^DIC(19,13255,1,36,0)="176 = r SODIUM  "
^DIC(19,13255,1,37,0)="        84295  ASSAY OF SERUM SODIUM  [WKLD CODE-84295.0000]"
^DIC(19,13255,1,38,0)="176 = r SODIUM   (SPEC) = URINE"
^DIC(19,13255,1,39,0)="        84300  ASSAY OF URINE SODIUM  [WKLD CODE-84300.0000]"
^DIC(19,13255,1,40,0)="176 = r SODIUM   (SPEC) = SERUM"
^DIC(19,13255,1,41,0)="        84295  ASSAY OF SERUM SODIUM  [WKLD CODE-84295.0000]"
^DIC(19,13255,1,42,0)="176 = r SODIUM   (SPEC) = PLASMA"
^DIC(19,13255,1,43,0)="        84295  ASSAY OF SERUM SODIUM  [WKLD CODE-84295.0000]"
^DIC(19,13255,1,44,0)=" "
^DIC(19,13255,1,45,0)="If the procedure has SITE/SPECIMEN (#100) field, each specimen will also "
^DIC(19,13255,1,46,0)="be indicated"
^DIC(19,13255,1,47,0)="(SPEC) = Specimen name from TOPOGRAPHY FIELD (#61) file."
^DIC(19,13255,25)="ASK^LRBEPRPT"
^DIC(19,13255,"U")="LAB TESTS AND CPT REPORT"
^DIC(19,13256,0)="LRBE PENDREP^Print AMA CPT Panel Pending List^^R^10000000020^^^^^^^"
^DIC(19,13256,1,0)="^19.06^12^12^3060119^^^^"
^DIC(19,13256,1,1,0)="When one or more of the 'required' atomic tests of an AMA/Billable panel "
^DIC(19,13256,1,2,0)="remain in the PENDING status by the roll-up date, the laboratory sends the "
^DIC(19,13256,1,3,0)="individual atomic level CPT codes for each verified test to PCE.  On the "
^DIC(19,13256,1,4,0)="roll-up date the laboratory software searches the previous calendar month"
^DIC(19,13256,1,5,0)="for panel tests in the pending status. "
^DIC(19,13256,1,6,0)="   "
^DIC(19,13256,1,7,0)="The roll-up date can be found in the PROCESS PANEL DATE field (#620) of the"
^DIC(19,13256,1,8,0)="LABORATORY SITE file (#69.9)."
^DIC(19,13256,1,9,0)="   "
^DIC(19,13256,1,10,0)="This report identifies AMA/Billable panel tests from the previous calendar "
^DIC(19,13256,1,11,0)="month that have one or more 'required' atomic tests that are still in a "
^DIC(19,13256,1,12,0)="pending status and require review."
^DIC(19,13256,25)="EN^LRBEPEND"
^DIC(19,13256,"U")="PRINT AMA CPT PANEL PENDING LI"
^DIC(19,13257,0)="XUPS VISTALINK^XUPS VISTALINK^^B^10000000020^^^^^^^"
^DIC(19,13257,99)="59396,36115"
^DIC(19,13257,99.1)="59396,46750"
