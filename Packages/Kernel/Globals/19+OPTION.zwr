^DIC(19,6719,0)="PSD TRANSACTION MENU^Pharmacist Menu^^M^11595^^^^^^^276"
^DIC(19,6719,1,0)="^^7^7^2940913^^^^"
^DIC(19,6719,1,1,0)="This option provides pharmacy the access to process all Controlled"
^DIC(19,6719,1,2,0)="Substances transactions.  This includes receipts into pharmacy, all"
^DIC(19,6719,1,3,0)="orders dispensed from pharmacy, and outpatient prescriptions."
^DIC(19,6719,1,4,0)="Completing Green Sheets allows pharmacy to complete those Green Sheets"
^DIC(19,6719,1,5,0)="with no discrepancies, math errors, drugs returned to stock, and drugs being"
^DIC(19,6719,1,6,0)="held for destruction.  Returns to stock and holding for destruction must be"
^DIC(19,6719,1,7,0)="drugs associated with the Green Sheet when using this option."
^DIC(19,6719,10,0)="^19.01PI^14^11"
