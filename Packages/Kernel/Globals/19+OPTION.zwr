^DIC(19,3879,25)="EN8^FHREC"
^DIC(19,3879,"U")="LIST EQUIPMENT"
^DIC(19,3880,0)="FHING51^List Ingredients - Purchasing Data^^R^10000000020^^^^^^^"
^DIC(19,3880,1,0)="^19.06^3^3^3021121^^^^"
^DIC(19,3880,1,1,0)="This option will list all ingredients along with data elements"
^DIC(19,3880,1,2,0)="associated with purchasing the item: stock number, unit of"
^DIC(19,3880,1,3,0)="purchase, vendor, purchase price, etc."
^DIC(19,3880,25)="LIS2^FHPRI2"
^DIC(19,3880,"U")="LIST INGREDIENTS - PURCHASING "
^DIC(19,3881,0)="FHPRR1^Projected Usage^^R^10000000020^^^^^^^"
^DIC(19,3881,1,0)="^19.06^5^5^3030512^^"
^DIC(19,3881,1,1,0)="This option will produce, for a specified time period, the"
^DIC(19,3881,1,2,0)="ingredients and amounts needed in order to meet production"
^DIC(19,3881,1,3,0)="requirements. The production requirements are based upon the"
^DIC(19,3881,1,4,0)="menu cycle in effect and a specified average census for the"
^DIC(19,3881,1,5,0)="time period."
^DIC(19,3881,25)="FHPRR1"
^DIC(19,3881,"U")="PROJECTED USAGE"
^DIC(19,3882,0)="FHREC10^Re-cost Recipes^^R^10000000020^^^^^^^"
^DIC(19,3882,1,0)="^^2^2^2880717^^"
