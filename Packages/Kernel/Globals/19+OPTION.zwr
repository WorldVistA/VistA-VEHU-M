^DIC(19,16068,1,0)="^^3^3^3240328^^^^"
^DIC(19,16068,1,1,0)="Generates a Health Summary of a specified pre-defined Health Summary Type"
^DIC(19,16068,1,2,0)="for a specified patient."
^DIC(19,16068,1,3,0)="Cloned from ""GMTS HS BY PATIENT"" option."
