^DIC(19,8041,1,2,0)="different from printing from the Pending Reviews option in that it"
^DIC(19,8041,1,3,0)="will limit the entries to just those you care to see."
^DIC(19,8041,25)="IBTOPW"
^DIC(19,8041,"U")="PENDING WORK REPORT"
