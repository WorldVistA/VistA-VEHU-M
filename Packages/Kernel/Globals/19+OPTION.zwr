^DIC(19,2334,0)="PSJU AMIS^AMIS (Cost per Ward)^^R^11712^^^^^^^117"
^DIC(19,2334,1,0)="^^3^3^2910312^^^^"
^DIC(19,2334,1,1,0)="  Report that shows total units dispensed, total cost, and average cost per"
^DIC(19,2334,1,2,0)="unit dispensed for each MAS ward.  The complete totals for all wards is at"
^DIC(19,2334,1,3,0)="the end of the report.  This report can be run for any date range selected."
^DIC(19,2334,15)=""
^DIC(19,2334,25)="PSGAMS"
^DIC(19,2334,"U")="AMIS (COST PER WARD)"
^DIC(19,2335,0)="PSJU PLAPS^PIck List Auto Purge Set/Reset^^R^11712^^^^^^^117"
^DIC(19,2335,1,0)="^^4^4^2910312^^^^"
^DIC(19,2335,1,1,0)="  Allows the supervisor to start and stop the daily and automatic"
^DIC(19,2335,1,2,0)="deletion of PICK LISTS that have been filed away.  The supervisor"
^DIC(19,2335,1,3,0)="may specify the number of days (1-90) the pick list may stay in the"
^DIC(19,2335,1,4,0)="computer, after it has been filed away."
^DIC(19,2335,25)="ENASK^PSGPLPRG"
^DIC(19,2335,"U")="PICK LIST AUTO PURGE SET/RESET"
^DIC(19,2336,0)="PSJU PLPRG^PUrge Pick Lists^^R^11712^^^^^^^117"
^DIC(19,2336,1,0)="^^2^2^2910312^^^^"
^DIC(19,2336,1,1,0)=" Allows supervisor to PURGE (delete) all PICK LISTS that have been FILED"
^DIC(19,2336,1,2,0)="AWAY and have a start date previous to the date entered in the option."
^DIC(19,2336,25)="PSGPLPRG"
^DIC(19,2336,200)="^^1D"
^DIC(19,2336,"U")="PURGE PICK LISTS"
^DIC(19,2337,0)="PSJU SCT^Service (Total Cost per)^^R^11712^^^^^^^117"
^DIC(19,2337,1,0)="^^4^4^2910312^^^^"
^DIC(19,2337,1,1,0)="  Allows user to run a TOTAL COST PER SERVICE report for a date range"
^DIC(19,2337,1,2,0)="entered.  The report will show the total units dispensed, total cost, and"
^DIC(19,2337,1,3,0)="average cost per unit dispensed for each service.  Totals for all"
^DIC(19,2337,1,4,0)="services are printed at the end of the report."
^DIC(19,2337,25)="PSGSCT"
^DIC(19,2337,"U")="SERVICE (TOTAL COST PER)"
^DIC(19,2338,0)="PSJU DCT^Drug (Cost and/or Amount)^^R^11712^^^^^^^117"
^DIC(19,2338,1,0)="^^6^6^2910312^^^^"
^DIC(19,2338,1,1,0)="  Allows the user to print a report of the cost of dispensed drugs within"
^DIC(19,2338,1,2,0)="a date range entered by the user.  This report can be sorted alphabetically"
^DIC(19,2338,1,3,0)="by drug name, by descending order of total drug cost, or by descending"
^DIC(19,2338,1,4,0)="order of total dispensed amount.  Limits may be employed to show only those"
^DIC(19,2338,1,5,0)="drugs above an entered total cost and/or dispensed amount.  Non-formulary"
^DIC(19,2338,1,6,0)="items are flagged as such."
^DIC(19,2338,25)="PSGDCT"
^DIC(19,2338,"U")="DRUG (COST AND/OR AMOUNT)"
^DIC(19,2339,0)="PSJU TCTD^Total Cost to Date  (Current Patients)^^R^11712^^^^^^^117"
^DIC(19,2339,1,0)="^^3^3^2910312^^^^"
^DIC(19,2339,1,1,0)="  Allow the user to see the total Unit Dose cost to date of patients"
^DIC(19,2339,1,2,0)="currently admitted.  The user can run this report for a ward group, ward,"
^DIC(19,2339,1,3,0)="or number of separate patients."
^DIC(19,2339,25)="PSGTCTD"
^DIC(19,2339,99)="55692,47953"
^DIC(19,2339,"U")="TOTAL COST TO DATE  (CURRENT P"
^DIC(19,2340,0)="PSJU MNGMT REPORTS^MANagement Reports Menu^^M^11712^^^^^^^117"
^DIC(19,2340,1,0)="^^3^3^2940310^^^^"
^DIC(19,2340,1,1,0)="  Various management reports (cost, usage, etc.) that can be run for"
^DIC(19,2340,1,2,0)="the Unit Dose package.  These reports are all QUEUABLE, and it is"
^DIC(19,2340,1,3,0)="strongly suggested that they be queued when run."
