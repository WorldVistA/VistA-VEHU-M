^DIC(19,10630,0)="SCENI IEMM ERROR CORRECTION^Correct Incomplete Encounters^^R^11281^^^^^^^16^^^"
^DIC(19,10630,1,0)="^^6^6^2971205^^^"
^DIC(19,10630,1,1,0)="Entry point for the Incomplete Encounter Management Module List Manager"
^DIC(19,10630,1,2,0)="tool.  Asks for either Patient, Clinic, or error code for selection."
^DIC(19,10630,1,3,0)="Once, selection is made, all encounters with errors in the TRANSMITTED"
^DIC(19,10630,1,4,0)="OUTPATIENT ENCOUNTER ERROR FILE (#409.75) will be displayed.  The user"
^DIC(19,10630,1,5,0)="will then be able to pick an encounter for further display of the specific"
^DIC(19,10630,1,6,0)="errors."
