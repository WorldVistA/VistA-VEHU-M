^DIC(19,9348,0)="LR WKLD CODE EDIT PRINT^Edit or Print WKLD CODES^^R^10958^^^^^^^26"
^DIC(19,9348,1,0)="^^23^23^2960216^"
^DIC(19,9348,1,1,0)=" This option will allow the user to edit or print activated workload"
^DIC(19,9348,1,2,0)="codes. A code automatically becomes activated the first time it is used"
^DIC(19,9348,1,3,0)="by the system to capture workload."
^DIC(19,9348,1,4,0)=" "
^DIC(19,9348,1,5,0)=" The option allows the user to select a WKLD CODE LAB SECTION to limit"
^DIC(19,9348,1,6,0)="the list of WKLD CODES for printing or editing."
^DIC(19,9348,1,7,0)=" "
^DIC(19,9348,1,8,0)="If the user selects the edit function, a selection menu of possible fields"
^DIC(19,9348,1,9,0)="is displayed. Multiple fields maybe selected but one at a time. The edit"
^DIC(19,9348,1,10,0)="selection does not allow all as a valid entry."
^DIC(19,9348,1,11,0)="  During the edit process, the user may select a starting WKLD CODE name"
^DIC(19,9348,1,12,0)="or enter the beginning characters. The option will find the next matching"
^DIC(19,9348,1,13,0)="code in the file. Names are stored in mixed character format. Therefore"
^DIC(19,9348,1,14,0)="to select a specific code to begin editing, upper and lower characters"
^DIC(19,9348,1,15,0)="must be entered."
^DIC(19,9348,1,16,0)="  Before the user is allowed to edit the requested fields, a display of"
^DIC(19,9348,1,17,0)="current values are presented. The user is prompted with fields to edit"
^DIC(19,9348,1,18,0)="in the order they were originally entered."
^DIC(19,9348,1,19,0)=" "
^DIC(19,9348,1,20,0)="The user is able to jump to any field selected."
^DIC(19,9348,1,21,0)=" "
^DIC(19,9348,1,22,0)="The user is able to print the list to home screen. If another device is"
^DIC(19,9348,1,23,0)="selected for printing, the report will be queued to that device."
^DIC(19,9348,25)="LRCAPFDS"
^DIC(19,9348,"U")="EDIT OR PRINT WKLD CODES"
^DIC(19,9349,0)="LA VITEK LITERAL^VITEK LITERAL^^R^10958^^^^^^^"
^DIC(19,9349,1,0)="^^1^1^2960331^"
^DIC(19,9349,1,1,0)="Used for verification of vitek literal interface data."
^DIC(19,9349,25)="LAMIVTL0"
^DIC(19,9349,"U")="VITEK LITERAL"
^DIC(19,9350,0)="LA PRINT ORGANISM^Organism Code Print^^P^10958^^^^^^^53^^^^^"
^DIC(19,9350,1,0)="^^3^3^2960401^^^"
^DIC(19,9350,1,1,0)="This option prints from a template, the organism code, interpretation"
^DIC(19,9350,1,2,0)="and local entry in etiology file. This option operates from the "
^DIC(19,9350,1,3,0)="Laboratory Instrument File field ^LAB(61.39,1,1......."
^DIC(19,9350,26)=""
^DIC(19,9350,60)="LAB(61.39,"
^DIC(19,9350,62)=0
^DIC(19,9350,63)="[LA ASHORG]"
^DIC(19,9350,64)="LA ASHORG]"
^DIC(19,9350,65)=""
^DIC(19,9350,66)=""
^DIC(19,9350,"U")="ORGANISM CODE PRINT"
^DIC(19,9351,0)="LA PRINT ANTIBIOTIC^Antibiotic Code Print^^P^10958^^^^^^^53"
^DIC(19,9351,1,0)="^^1^1^2960401^^"
^DIC(19,9351,1,1,0)="Prints antibiotic codes, interpretation, and etiology field file entry."
^DIC(19,9351,60)="LAB(61.39,"
^DIC(19,9351,62)=0
^DIC(19,9351,63)="[LA ASHANT]"
^DIC(19,9351,64)="[LA ASHANT]"
^DIC(19,9351,65)=""
^DIC(19,9351,66)=""
^DIC(19,9351,"U")="ANTIBIOTIC CODE PRINT"
^DIC(19,9363,0)="IBDF BACKGRD EF PRINT QUEUE^Background EF Print^^R^11594^^^^^^^485^^"
^DIC(19,9363,1,0)="^^3^3^2960528^^^^"
^DIC(19,9363,1,1,0)="This option prints encounter forms in the background. Jobs are run based"
^DIC(19,9363,1,2,0)="on the queuing parameters set up using the option IBDF SETUP AUTO CLINIC"
^DIC(19,9363,1,3,0)="PRINT."
^DIC(19,9363,20)=""
^DIC(19,9363,25)="IBDFQB"
^DIC(19,9363,200)="^^1D"
^DIC(19,9363,"U")="BACKGROUND EF PRINT"
^DIC(19,9364,0)="IBDF SETUP AUTO CLINIC PRINT^Setup Automatic Print Queues^^R^11594^^^^^^^485"
^DIC(19,9364,1,0)="^^2^2^2951205^^"
^DIC(19,9364,1,1,0)="This option allows users to enter Print Manager Queuing Parameters and to"
^DIC(19,9364,1,2,0)="specify automatic queuing parameters."
^DIC(19,9364,25)="IBDFPE"
^DIC(19,9364,"U")="SETUP AUTOMATIC PRINT QUEUES"
^DIC(19,9365,0)="IBDFC CONVERSION UTILITY^Conversion Utility For Scanning^** This option is OUT OF ORDER **^A^10000000020^^^^^^^485^^1"
^DIC(19,9365,1,0)="^^2^2^2950310^"
^DIC(19,9365,1,1,0)="Used to convert a form that was designed for just printing to a form that"
^DIC(19,9365,1,2,0)="can be scanned."
^DIC(19,9365,20)="D ^IBDFC"
^DIC(19,9365,"U")="CONVERSION UTILITY FOR SCANNIN"
^DIC(19,9366,0)="IBDF UTIL MAINTENANCE UTILITY^Maintenance Utility for Active/Inactive Codes^^R^11720^^^^^^^485^^"
^DIC(19,9366,1,0)="^^5^5^2981026^^^^"
^DIC(19,9366,1,1,0)="This is a maintenance utility for the AICS package.  It allows the user"
^DIC(19,9366,1,2,0)="to display and print a listing of the invalid ICD9, CPT and VISIT codes"
^DIC(19,9366,1,3,0)="that are on encounter forms.  It also allows the user to delete the"
^DIC(19,9366,1,4,0)="invalid codes from the forms.  Another action of this option is displaying"
^DIC(19,9366,1,5,0)="a complete listing of all invalid ICD9, CPT, and VISIT codes."
^DIC(19,9366,20)=""
^DIC(19,9366,25)="IBDFUTL"
^DIC(19,9366,99.1)="57734,7762"
^DIC(19,9366,"U")="MAINTENANCE UTILITY FOR ACTIVE"
^DIC(19,9367,0)="IBDF LIST CLINICS WITH NO FORM^Clinics With No Encounter Forms^^A^11720^^^^^^^485^^1"
^DIC(19,9367,1,0)="^^2^2^2951211^^^^"
^DIC(19,9367,1,1,0)="This option gives a report that lists the clinics that do not"
^DIC(19,9367,1,2,0)="have encounter forms."
^DIC(19,9367,20)="D ^IBDFCNOF"
^DIC(19,9367,"U")="CLINICS WITH NO ENCOUNTER FORM"
^DIC(19,9368,0)="IBDF FORMS TRACKING^Forms Tracking^^R^11720^^^^^^^485^^"
^DIC(19,9368,1,0)="^^5^5^2950721^"
^DIC(19,9368,1,1,0)="This option connects the user to the forms tracking"
^DIC(19,9368,1,2,0)="display.  This allows the user to see what encounter"
^DIC(19,9368,1,3,0)="forms have been printed, scanned and those that have not"
^DIC(19,9368,1,4,0)="not.  It also allows the user to get statistics on this"
^DIC(19,9368,1,5,0)="data as well as display forms with a specific status."
^DIC(19,9368,20)=""
^DIC(19,9368,25)="IBDFFT"
^DIC(19,9368,"U")="FORMS TRACKING"
^DIC(19,9369,0)="IBDF SCANNED W/BILL GEN^Scanned Forms w/ Bill Gen^** This option is OUT OF ORDER **^R^10000000020^^^^^^^485"
^DIC(19,9369,1,0)="^^7^7^2980818^^^^"
^DIC(19,9369,1,1,0)="This option prints a report for those encounter forms that have"
^DIC(19,9369,1,2,0)="been scanned that also have bills generated.  The report displays"
^DIC(19,9369,1,3,0)="this data for all clinics using encounter forms for one/many/all"
^DIC(19,9369,1,4,0)="divisions for a specific date range.  The data that is displayed "
^DIC(19,9369,1,5,0)="is the number scanned, number insured, number of bills entered,"
^DIC(19,9369,1,6,0)="number of bills printed, and average days from date of encounter"
^DIC(19,9369,1,7,0)="to date of bill generation (printed)."
^DIC(19,9369,25)="IBDFOSG"
^DIC(19,9369,"U")="SCANNED FORMS W/ BILL GEN"
^DIC(19,9370,0)="IBDF AUTO PURGE FORM TRACKING^Tasked purge of Form Tracking files^^R^11594^^^^^^^485"
^DIC(19,9370,1,0)="^^9^9^2960528^^^"
^DIC(19,9370,1,1,0)="This option should be queued to run at the sites convienence.  It will"
^DIC(19,9370,1,2,0)="purge old data from the ENCOUNTER FORM TRACKING file (357.96), the"
^DIC(19,9370,1,3,0)="ENCOUNTER FORM DEFINITION file (357.95) and the FORM SPECIFICATION file "
^DIC(19,9370,1,4,0)="(359.2).  Two parameters in the ENCOUNTER FORM PARAMETERS file (357.09)"
^DIC(19,9370,1,5,0)="control how this option works."
^DIC(19,9370,1,6,0)=" "
^DIC(19,9370,1,7,0)="The option needs no device and has no output.  It is recommended that"
^DIC(19,9370,1,8,0)="this be tasked to run at least once weekly during a weekend or other"
^DIC(19,9370,1,9,0)="slow time."
^DIC(19,9370,25)="AUTO^IBDFPRG"
^DIC(19,9370,200)="^^7D"
^DIC(19,9370,200.9)="y"
^DIC(19,9370,"U")="TASKED PURGE OF FORM TRACKING "
^DIC(19,9371,0)="IBDF MANUAL PURGE FORM TRACK^Purge Form Tracking files^^R^11594^^^^^^^485"
^DIC(19,9371,1,0)="^^11^11^2960524^^^"
^DIC(19,9371,1,1,0)="This option should be queued to run at the sites convienence.  It will"
^DIC(19,9371,1,2,0)="purge old data from the ENCOUNTER FORM TRACKING file (357.96), the"
^DIC(19,9371,1,3,0)="ENCOUNTER FORM DEFINITION file (357.95) and the FORM SPECIFICATION file "
^DIC(19,9371,1,4,0)="(359.2)."
^DIC(19,9371,1,5,0)=" "
^DIC(19,9371,1,6,0)="The option needs no device and has no output.  It is recommended that"
^DIC(19,9371,1,7,0)="this be tasked to run at least once weekly during a weekend or other"
^DIC(19,9371,1,8,0)="slow time."
^DIC(19,9371,1,9,0)=" "
^DIC(19,9371,1,10,0)="Use the option IBDF AUTO PURGE FORM TRACKING to automatically queue this"
^DIC(19,9371,1,11,0)="option to run on a recurring basis."
^DIC(19,9371,25)="MANUAL^IBDFPRG"
^DIC(19,9371,"U")="PURGE FORM TRACKING FILES"
^DIC(19,9372,0)="IBDF RECOMPILE ALL FORMS^Recompile All Forms^^A^11594^^^^^^^485^^1"
^DIC(19,9372,1,0)="^^2^2^2951017^"
^DIC(19,9372,1,1,0)="Used to recompile all forms. The compiled version of every form and block"
^DIC(19,9372,1,2,0)="is deleted. Each form is compiled the first time it is printed."
^DIC(19,9372,20)="D RECMPALL^IBDF19"
^DIC(19,9372,"U")="RECOMPILE ALL FORMS"
