^DIC(19,623,"U")="SCHEDULING MENU"
^DIC(19,624,0)="SDBUILD^Set up a Clinic^^R^1^SDBUILD^^^^^^16^^1^1"
^DIC(19,624,1,0)="^19.06^2^2^3230215^^^^"
^DIC(19,624,1,1,0)="This option allows the user to create holidays, create/edit basic"
^DIC(19,624,1,2,0)="clinic information, create/change clinic availabilities."
^DIC(19,624,15)="K D,SDONE,CNT,DH,DO,DOW,HHY,SD1,SDJJ,%,A,CTR,ST,X1,X2"
^DIC(19,624,20)="W !!,""OPTION will be decommissioned starting December 2025.  To transition, please use the Clinic Configuration Manager (CCM) website for all needs."""
^DIC(19,624,25)="SDB"
^DIC(19,624,99)="55441,44868"
^DIC(19,624,99.1)="66273,60972"
^DIC(19,624,"U")="SET UP A CLINIC"
^DIC(19,625,0)="SDCANCEL^Cancel Clinic Availability^^R^.5^^^^^^^16^^^1"
^DIC(19,625,1,0)="^^5^5^2850415^^^"
^DIC(19,625,1,1,0)="This option allows the user to cancel a clinic's availability for"
^DIC(19,625,1,2,0)="either a whole day or portion's of a day.  If several portions's"
^DIC(19,625,1,3,0)="of a day are to be cancelled the user must cancel one portion first,"
^DIC(19,625,1,4,0)="re-enter the Cancel Clinic Availability option to cancel the second,"
^DIC(19,625,1,5,0)="etc."
^DIC(19,625,15)="D SDC^SDKILL"
^DIC(19,625,25)="SDC"
^DIC(19,625,"U")="CANCEL CLINIC AVAILABILITY"
^DIC(19,626,0)="SDD^Remap Clinic^^R^.5^^^^^^^16^^^1"
^DIC(19,626,1,0)="^^5^5^2850418^^^"
^DIC(19,626,1,1,0)="This option is used to remap a clinic.  It is used primarily after the"
^DIC(19,626,1,2,0)="entry of a new holiday or deletion of an existing holiday.  It basically"
^DIC(19,626,1,3,0)="updates the pattern to insure that it knows that the holiday now exists"
^DIC(19,626,1,4,0)="or no longer exists.  It must be run for each clinic which meets on the"
^DIC(19,626,1,5,0)="date of the holiday."
^DIC(19,626,15)="K %Y,DUOUT,DISYS"
^DIC(19,626,25)="SDD"
^DIC(19,626,"U")="REMAP CLINIC"
^DIC(19,627,0)="SDSUP^Supervisor Menu^^M^10000000020^^^^^^^16"
^DIC(19,627,1,0)="^19.06^2^2^3051026^^^^"
^DIC(19,627,1,1,0)="This is the primary menu option which allows the user access to all"
^DIC(19,627,1,2,0)="supervisor functions of the scheduling module."
