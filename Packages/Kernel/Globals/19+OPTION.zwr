^DIC(19,16117,10,"B",16123,6)=""
^DIC(19,16117,10,"C",1,1)=""
^DIC(19,16117,10,"C",2,3)=""
^DIC(19,16117,10,"C",3,6)=""
^DIC(19,16117,10,"C",4,4)=""
^DIC(19,16117,10,"C",5,2)=""
^DIC(19,16117,10,"C",6,5)=""
^DIC(19,16117,25)=""
^DIC(19,16117,99)="67411,49176"
^DIC(19,16117,"U")="PRINT HEALTH SUMMARY MENU"
^DIC(19,16118,0)="EHM-00939^Patient Health Summary^^R^1^^^^^^^160^^1^^"
^DIC(19,16118,1,0)="^^3^3^3240328^^^^"
^DIC(19,16118,1,1,0)="Generates a Health Summary of a specified pre-defined Health Summary Type"
^DIC(19,16118,1,2,0)="for a specified patient."
^DIC(19,16118,1,3,0)="Cloned from ""GMTS HS BY PATIENT"" option."
^DIC(19,16118,2)="y"
^DIC(19,16118,3)=""
^DIC(19,16118,20)="K ORVP"
^DIC(19,16118,25)="GMTS"
^DIC(19,16118,72)="W @IOF"
^DIC(19,16118,99)="54858,49206"
^DIC(19,16118,"U")="PATIENT HEALTH SUMMARY"
^DIC(19,16119,0)="EHM-00940^Hospital Location Health Summary^^R^1^^^^^n^^160^^^^"
^DIC(19,16119,1,0)="^^5^5^3240328^"
^DIC(19,16119,1,1,0)="Allows user to print health summaries interactively for all patients on a"
^DIC(19,16119,1,2,0)="specified ward(s), for all patients with appointments at a specified"
^DIC(19,16119,1,3,0)="outpatient clinic(s), or for all patients scheduled for a specified"
^DIC(19,16119,1,4,0)="operating room(s) on a selected day or range of days."
^DIC(19,16119,1,5,0)="Cloned from ""GMTS HS BY LOC"" option."
^DIC(19,16119,2)="y"
^DIC(19,16119,3)=""
^DIC(19,16119,25)="MAIN^GMTSPD"
^DIC(19,16119,99)="55425,54053"
^DIC(19,16119,"U")="HOSPITAL LOCATION HEALTH SUMMA"
^DIC(19,16120,0)="EHM-00941^Ad Hoc Health Summary^^R^1^^^^^^^160^^1^^"
^DIC(19,16120,1,0)="^^6^6^3240328^"
^DIC(19,16120,1,1,0)="Generates an 'Ad Hoc' Health Summary for specified patients. Instead of"
^DIC(19,16120,1,2,0)="selecting a pre-defined Health Summary Type, the user defines his own ad"
^DIC(19,16120,1,3,0)="hoc Health Summary structure for temporary use while using this option."
^DIC(19,16120,1,4,0)="The user selects Health Summary components, time and occurrence limits"
^DIC(19,16120,1,5,0)="when applicable, and selection items when applicable."
^DIC(19,16120,1,6,0)="Cloned from ""GMTS HS ADHOC"" option."
^DIC(19,16120,3)=""
^DIC(19,16120,20)="K ORVP"
^DIC(19,16120,25)="GMTSADH"
^DIC(19,16120,99)="55626,36491"
^DIC(19,16120,"U")="AD HOC HEALTH SUMMARY"
^DIC(19,16121,0)="EHM-00942^Visit Patient Health Summary^^R^1^^^^^^^160^^1^1^"
^DIC(19,16121,1,0)="^^9^9^3240328^^"
^DIC(19,16121,1,1,0)="Generates Health Summaries of a specified pre-defined Health Summary Type"
^DIC(19,16121,1,2,0)="for multiple patients. After a patient is selected, the user can pick an"
^DIC(19,16121,1,3,0)="outpatient visit (based on the VISIT File) or an inpatient hospital"
^DIC(19,16121,1,4,0)="admission (based on the Patient Movement file). If the Patient Care"
^DIC(19,16121,1,5,0)="Encounter (PCE) package isn't installed then the user can only choose an"
^DIC(19,16121,1,6,0)="inpatient visit. Data for summaries is based on a date range from the"
^DIC(19,16121,1,7,0)="outpatient visit or inpatient admission. This Date Range overrides Time"
^DIC(19,16121,1,8,0)="Limits for components which allows this option."
^DIC(19,16121,1,9,0)="Cloned from ""GMTS HS BY PATIENT & VISIT"" option."
^DIC(19,16121,3)=""
^DIC(19,16121,15)="K GMTSPXGO"
^DIC(19,16121,20)="K ORVP S GMTSPXGO=1"
^DIC(19,16121,25)="GMTS"
^DIC(19,16121,"U")="VISIT PATIENT HEALTH SUMMARY"
^DIC(19,16122,0)="EHM-00943^Batch Print of All Clinics by Visit Date^^R^1^^^^^^^160^^^^"
^DIC(19,16122,1,0)="^^9^9^3240328^"
^DIC(19,16122,1,1,0)="Allows user to interactively designate the batch print of all health"
^DIC(19,16122,1,2,0)="summaries for patients with appointments at all outpatient clinics on a"
^DIC(19,16122,1,3,0)="selected day. Summaries will be printed at the print device designated for"
^DIC(19,16122,1,4,0)="that clinic in the Location Parameters. This option is an alternate method"
^DIC(19,16122,1,5,0)="to designate when summaries should be printed for all clinics. The nightly"
^DIC(19,16122,1,6,0)="batch job that prints summaries for wards, clinics and operating rooms"
^DIC(19,16122,1,7,0)="probably should be disable if the user wants to uses this option on a"
^DIC(19,16122,1,8,0)="daily basis."
^DIC(19,16122,1,9,0)="Cloned from ""GMTS HS FOR ALL CLINICS"" option."
^DIC(19,16122,3)=""
^DIC(19,16122,25)="MAIN^GMTSPCD"
^DIC(19,16122,"U")="BATCH PRINT OF ALL CLINICS BY "
^DIC(19,16123,0)="EHM-00944^Range of Dates Patient Health Summary^^R^1^^^^^^^160^^1^1^"
^DIC(19,16123,1,0)="^^6^6^3240328^^^^"
^DIC(19,16123,1,1,0)="Generates Health Summaries of a specified pre-defined Health"
^DIC(19,16123,1,2,0)="Summary Type for multiple patients. After patients are selected."
^DIC(19,16123,1,3,0)="the user can pick a date range. Data for summaries is based on"
^DIC(19,16123,1,4,0)="the date range. This date range overrides Time Limits for"
^DIC(19,16123,1,5,0)="components which allow this option."
^DIC(19,16123,1,6,0)="Cloned from ""GMTS HS BY PATIENT & DATE RANG"" option."
^DIC(19,16123,3)=""
^DIC(19,16123,15)="K GMRANGE"
^DIC(19,16123,20)="K ORVP S GMRANGE=1"
^DIC(19,16123,25)="GMTS"
^DIC(19,16123,"U")="RANGE OF DATES PATIENT HEALTH "
^DIC(19,16124,0)="EHM-00945^Delete Health Summary Type^^E^1^^^^^^^160^^1^1^"
^DIC(19,16124,1,0)="^19.06^9^9^3240328^^^^"
^DIC(19,16124,1,1,0)="This option allows the owner of a Health Summary Type to delete"
^DIC(19,16124,1,2,0)="it. In addition anyone who holds the GMTSMGR key may use this "
^DIC(19,16124,1,3,0)="option. Also, if a Health Summary Type has a lock, anyone who "
^DIC(19,16124,1,4,0)="holds a key with that lock value may delete that Health Summary"
^DIC(19,16124,1,5,0)="Type.  This Option will not allow the deletion of a Health Summary"
^DIC(19,16124,1,6,0)="Type in use by a Health Summary Object.  It will not allow the "
^DIC(19,16124,1,7,0)="deletion of special case Health Summary Types such as GMTS HS "
^DIC(19,16124,1,8,0)="ADHOC OPTION, or REMOTE Health Summary Types."
^DIC(19,16124,1,9,0)="Cloned from ""GMTS TYPE DELETE"" option."
^DIC(19,16124,3)=""
^DIC(19,16124,15)="K %,GMTSMGR"
