^DIC(19,8880,25)="GECSRSTA"
^DIC(19,8880,"U")="STACK STATUS REPORT"
^DIC(19,8881,0)="GECS STACK RETRANSMIT^Retransmit Stack File Document^^R^.5^^^^^^^"
^DIC(19,8881,1,0)="^^4^4^2931222^"
^DIC(19,8881,1,1,0)="This option will retransmit the document located in the stack file."
^DIC(19,8881,1,2,0)="The option should be used to retransmit those documents which have not"
