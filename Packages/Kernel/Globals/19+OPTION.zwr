^DIC(19,11299,0)="FSC TASK AGE^Task to Update Age Fields^^R^11742^^^^^^^"
^DIC(19,11299,1,0)="^^4^4^2980117^^^"
^DIC(19,11299,1,1,0)="This option is a NOIS task that runs every night.  It updates fields that"
^DIC(19,11299,1,2,0)="are computed from data entered into NOIS calls (ex. age of call, age since"
^DIC(19,11299,1,3,0)="last edit, office for development, etc.).  This task should be scheduled to"
^DIC(19,11299,1,4,0)="run every night after midnight."
^DIC(19,11299,2)="y"
