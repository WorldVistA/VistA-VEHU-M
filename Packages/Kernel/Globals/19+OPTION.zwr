^DIC(19,15639,"U")="BUILD PATIENT LIST MENU"
^DIC(19,15640,0)="EHM-00461^Patient        (Add to list)^^A^1^^^^^^^^^1^1^"
^DIC(19,15640,1,0)="^19.06^3^3^3240328^^^^"
^DIC(19,15640,1,1,0)="This option lets you add patients to a list that has already"
^DIC(19,15640,1,2,0)="been created."
^DIC(19,15640,1,3,0)="Cloned from ""ORLP ADD ONE"" option."
^DIC(19,15640,3)=""
^DIC(19,15640,15)="D OKILL^ORLP0"
^DIC(19,15640,20)="D ADD^ORLP0"
^DIC(19,15640,"U")="PATIENT        (ADD TO LIST)"
^DIC(19,15641,0)="EHM-00462^Ward           (Add to list)^^A^1^^^^^^^^^1^1^"
^DIC(19,15641,1,0)="^19.06^5^5^3240328^^^^"
^DIC(19,15641,1,1,0)="You can create a patient list by selecting 1 or more wards or"
^DIC(19,15641,1,2,0)="you can add wards to a currently existing list "
^DIC(19,15641,1,3,0)="using this menu.  After you have added a ward, you can delete"
^DIC(19,15641,1,4,0)="or add patients to customize the list."
^DIC(19,15641,1,5,0)="Cloned from ""ORLP ADD WARD"" option."
^DIC(19,15641,3)=""
^DIC(19,15641,15)="D OKILL^ORLP0"
^DIC(19,15641,20)="D WARD^ORLP01"
^DIC(19,15641,"U")="WARD           (ADD TO LIST)"
^DIC(19,15642,0)="EHM-00463^Clinic         (Add to list)^^A^1^^^^^^^^^1^^"
^DIC(19,15642,1,0)="^19.06^5^5^3240328^^^^"
^DIC(19,15642,1,1,0)="This option lets you add patients to a clinic list that is"
^DIC(19,15642,1,2,0)="already defined, or build a new patient list by clinic."
^DIC(19,15642,1,3,0)="After you have selected a clinic, you can add or delete patients"
^DIC(19,15642,1,4,0)="to further customize your list."
^DIC(19,15642,1,5,0)="Cloned from ""ORLP ADD CLINIC"" option."
^DIC(19,15642,3)=""
^DIC(19,15642,20)="D CLIN^ORLP01"
^DIC(19,15642,"U")="CLINIC         (ADD TO LIST)"
^DIC(19,15643,0)="EHM-00464^Existing Lists (Add to list)^^A^1^^^^^^^^^1^1^"
^DIC(19,15643,1,0)="^19.06^3^3^3240328^^^^"
^DIC(19,15643,1,1,0)="This option lets you add patients to an existing list that"
^DIC(19,15643,1,2,0)="you have defined."
^DIC(19,15643,1,3,0)="Cloned from ""ORLP ADD LIST"" option."
^DIC(19,15643,3)=""
^DIC(19,15643,15)="D OKILL^ORLP0"
^DIC(19,15643,20)="D PERS^ORLP0"
^DIC(19,15643,"U")="EXISTING LISTS (ADD TO LIST)"
^DIC(19,15644,0)="EHM-00465^Show Current Patient List^^A^1^^^^^^^^^1^^"
^DIC(19,15644,1,0)="^19.06^2^2^3240328^^^"
^DIC(19,15644,1,1,0)="This option shows the patient list defined for a CRT session."
^DIC(19,15644,1,2,0)="Cloned from ""ORLP LIST"" option."
^DIC(19,15644,3)=""
^DIC(19,15644,20)="D SHOW^ORLP0"
^DIC(19,15644,"U")="SHOW CURRENT PATIENT LIST"
^DIC(19,15645,0)="EHM-00466^Clear Current Patient List^^A^1^^^^^^^^^1^^"
^DIC(19,15645,1,0)="^19.06^5^5^3240328^^^^"
^DIC(19,15645,1,1,0)="Use this option to clear the current patient list from your work"
^DIC(19,15645,1,2,0)="area so that you can work with another list.  The list that you"
^DIC(19,15645,1,3,0)="clear with this option will still be available to work with at another"
^DIC(19,15645,1,4,0)="time if it was stored away at the time the list was defined."
^DIC(19,15645,1,5,0)="Cloned from ""ORLP CLEAR"" option."
^DIC(19,15645,3)=""
^DIC(19,15645,20)="D CLEAR^ORLP1(.X)"
^DIC(19,15645,"U")="CLEAR CURRENT PATIENT LIST"
^DIC(19,15646,0)="EHM-00467^Remove Patient(s) from Patient List^^A^1^^^^^^^^^1^^"
^DIC(19,15646,1,0)="^19.06^5^5^3240328^^^^"
^DIC(19,15646,1,1,0)="You can remove patients from a list that you have built by patient, ward"
^DIC(19,15646,1,2,0)="or clinic. "
^DIC(19,15646,1,3,0)="This is convenient if you want to add all of the patients from a"
^DIC(19,15646,1,4,0)="ward or clinic except for one or two."
^DIC(19,15646,1,5,0)="Cloned from ""ORLP DELETE PATIENT"" option."
^DIC(19,15646,3)=""
^DIC(19,15646,20)="D DEL^ORLP00"
^DIC(19,15646,"U")="REMOVE PATIENT(S) FROM PATIENT"
^DIC(19,15647,0)="EHM-00468^Provider       (Add to list)^^A^1^^^^^^^^^1^1^"
^DIC(19,15647,1,0)="^19.06^4^4^3240328^^^^"
^DIC(19,15647,1,1,0)="You can create a patient list by selecting 1 or more providers or you can"
^DIC(19,15647,1,2,0)="add providers to a currently existing list using this option.  After you"
^DIC(19,15647,1,3,0)="have added a provider, you can delete or add patients to customize the list."
^DIC(19,15647,1,4,0)="Cloned from ""ORLP ADD PROVIDER"" option."
^DIC(19,15647,3)=""
^DIC(19,15647,15)="D OKILL^ORLP0"
^DIC(19,15647,20)="D PROV^ORLP01"
^DIC(19,15647,"U")="PROVIDER       (ADD TO LIST)"
^DIC(19,15648,0)="EHM-00469^Specialty      (Add to list)^^A^1^^^^^^^^^1^1^"
^DIC(19,15648,1,0)="^19.06^5^5^3240328^^^^"
^DIC(19,15648,1,1,0)="You can create a patient list by selecting 1 or more specialties, or"
^DIC(19,15648,1,2,0)="you can add specialties to a currently existing list using this option."
^DIC(19,15648,1,3,0)="Once you have added a specialty, you can add or delete patients to"
^DIC(19,15648,1,4,0)="customize the list."
^DIC(19,15648,1,5,0)="Cloned from ""ORLP ADD SPECIALTY"" option."
^DIC(19,15648,3)=""
^DIC(19,15648,15)="D OKILL^ORLP0"
^DIC(19,15648,20)="D SPEC^ORLP01"
^DIC(19,15648,"U")="SPECIALTY      (ADD TO LIST)"
^DIC(19,15649,0)="EHM-00470^Merge              Existing Lists^^A^1^^^^^^^^^1^^"
^DIC(19,15649,1,0)="^19.06^3^3^3240328^^^^"
^DIC(19,15649,1,1,0)="This option lets you merge the patients from one or several"
^DIC(19,15649,1,2,0)="lists together to create a bigger or more comprehensive list."
^DIC(19,15649,1,3,0)="Cloned from ""ORLP MERGE"" option."
