^DIC(19,13841,0)="HBHCRP30^Caregiver Age Report  (132)^^R^10000000020^^^^^^^328"
^DIC(19,13841,1,0)="^^5^5^3080318^"
^DIC(19,13841,1,1,0)="This option prints the HBPC Medical Foster Home (MFH) Caregiver Age "
^DIC(19,13841,1,2,0)="Report.  The report is sorted alphabetically by MFH Name & includes:"
^DIC(19,13841,1,3,0)="Medical Foster Home (MFH) Name, Opened Date, Primary Caregiver Name,"
^DIC(19,13841,1,4,0)="Caregiver Date of Birth, & Age.  Total number of MFHs & Average Caregiver"
^DIC(19,13841,1,5,0)="Age are included at end of report.  Report prints in 132 column format."
^DIC(19,13841,25)="HBHCRP30"
^DIC(19,13841,"U")="CAREGIVER AGE REPORT  (132)"
^DIC(19,13842,0)="HBHCRP31^Form Errors Report for MFH  (80)^^R^10000000020^^^^^^^328"
^DIC(19,13842,1,0)="^^5^5^3080318^"
^DIC(19,13842,1,1,0)="This option prints the HBHC Medical Foster Home (MFH) Form Errors Report"
^DIC(19,13842,1,2,0)="for MFH option.  The report is sorted alphabetically by MFH Name &"
^DIC(19,13842,1,3,0)="includes:  MFH File (#633.2) Internal Entry Number (IEN), MFH Name, &"
^DIC(19,13842,1,4,0)="Opened Date.  This option is both freestanding & is called from Form"
^DIC(19,13842,1,5,0)="Errors Report [HBHCRP1] option.  Report prints in 80 column format."
^DIC(19,13842,25)="HBHCRP31"
^DIC(19,13842,"U")="FORM ERRORS REPORT FOR MFH  (8"
^DIC(19,13843,0)="HBHCUPDM^Edit MFH Form Errors Data^^R^10000000020^^^^^^^328"
^DIC(19,13843,1,0)="^^5^5^3080331^"
^DIC(19,13843,1,1,0)="This option allows editing of the HBPC Medical Foster Home (MFH) Form"
^DIC(19,13843,1,2,0)="Errors Data.  The user is prompted for a MFH name, then the routine"
^DIC(19,13843,1,3,0)="prompts for the fields that are missing or invalid in each record.  These"
^DIC(19,13843,1,4,0)="errors are found when the Build/Verify Transmission File [HBHCFILE] option"
^DIC(19,13843,1,5,0)="is run and must be corrected before transmission to Austin is allowed."
^DIC(19,13843,25)="HBHCUPDM"
^DIC(19,13843,"U")="EDIT MFH FORM ERRORS DATA"
