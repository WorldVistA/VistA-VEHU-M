^DIC(19,15804,25)="USRCHKS^ORKMGR"
^DIC(19,15804,"U")="DISPLAY THE ORDER CHECKS A USE"
^DIC(19,15805,0)="EHM-00626^Set Number of Medications for Polypharmacy^^R^1^^^^^^^^^^^"
^DIC(19,15805,1,0)="^^3^3^3240328^"
