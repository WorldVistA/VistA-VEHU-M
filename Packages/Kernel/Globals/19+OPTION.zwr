^DIC(19,11027,1,0)="^^4^4^2961213^^"
^DIC(19,11027,1,1,0)="Enter 'Yes' if the device should always receive this notification. Devices"
^DIC(19,11027,1,2,0)="will receive the notification on a regular basis - despite setting in the"
^DIC(19,11027,1,3,0)="option Enable/Disable Notifications.  These devices will always receive"
^DIC(19,11027,1,4,0)="the notification, regardless of patient."
^DIC(19,11027,25)="REGDEV^ORB3MGR1"
^DIC(19,11027,"U")="SET DEFAULT RECIPIENT DEVICE(S"
^DIC(19,11028,0)="ORE LAB ORDERS CHECK 69=>100^Check Lab orders from file 69 to 100^^A^11712^^^^^^^170^^1"
^DIC(19,11028,1,0)="^^5^5^2990521^"
^DIC(19,11028,1,1,0)="This option checks for inconsistencies between OE/RR and Lab files"
^DIC(19,11028,1,2,0)="and attempts to correct them.  There is no set frequency for running this"
^DIC(19,11028,1,3,0)="option, but it should be run every few months to check for"
^DIC(19,11028,1,4,0)="inconsistencies.  This option will take a long time to run, so run it at"
^DIC(19,11028,1,5,0)="night or over a weekend."
^DIC(19,11028,20)="D EN1^ORELR"
^DIC(19,11028,"U")="CHECK LAB ORDERS FROM FILE 69 "
