^DIC(19,15240,10,"C","TR",4)=""
^DIC(19,15240,99)="67411,49173"
^DIC(19,15240,"U")="IFC MANAGEMENT MENU"
^DIC(19,15241,0)="EHM-00062^IFC Requests^^R^1^^^^^^^294^^^^"
^DIC(19,15241,1,0)="^^30^30^3240328^"
^DIC(19,15241,1,1,0)="This option provides detailed information regarding inter-facility "
^DIC(19,15241,1,2,0)="consults."
^DIC(19,15241,1,3,0)=" "
^DIC(19,15241,1,4,0)="If not specified, all status' are utilized."
^DIC(19,15241,1,5,0)=" "
^DIC(19,15241,1,6,0)="""Routing Facility"" data: If selecting requesting site information, this "
^DIC(19,15241,1,7,0)="refers to the facility the consult is sent to; if selecting consulting "
^DIC(19,15241,1,8,0)="site information, this refers to the facility the consult is sent from."
^DIC(19,15241,1,9,0)=" "
^DIC(19,15241,1,10,0)="""Days Diff"" data: This refers to the (whole number) of days difference "
^DIC(19,15241,1,11,0)="between the COMPLETE activity date/time and one of the following activity "
^DIC(19,15241,1,12,0)="date/time (if one doesn't exist, retrieve the next): RECEIVED, ENTERED IN "
^DIC(19,15241,1,13,0)="CPRS, SERVICE ENTERED, FILE ENTRY DATE. All date/time data must be in the"
^DIC(19,15241,1,14,0)="range selected. Field REMOTE ACTIVITY TIME ZONE is NOT figured into the"
^DIC(19,15241,1,15,0)="calculations."
^DIC(19,15241,1,16,0)=" "
^DIC(19,15241,1,17,0)="""Rec Date"" data: For IFC consulting site report requests only, the option"
^DIC(19,15241,1,18,0)="checks for DATE/TIME OF ACTION ENTRY for activity of REMOTE REQUEST"
^DIC(19,15241,1,19,0)="RECEIVED, and if that doesn't exist it checks for DATE/TIME OF ACTION"
^DIC(19,15241,1,20,0)="ENTRY for the activity of RECEIVED. Only date is listed in the report."
^DIC(19,15241,1,21,0)=" "
^DIC(19,15241,1,22,0)="""Mean Days Completed To Service <service> @ <facility>"" data: For only "
^DIC(19,15241,1,23,0)="those entries in which Days Diff exists, this calculation for each service"
^DIC(19,15241,1,24,0)="at each routing facility is: Days Diff total divided by Number of Days"
^DIC(19,15241,1,25,0)="Diff values."
^DIC(19,15241,1,26,0)=" "
^DIC(19,15241,1,27,0)="""Mean Days Completed To Service <service>"" data: For only those entries in"
^DIC(19,15241,1,28,0)="which Days Diff exists, this calculation for each service is: Days Diff"
^DIC(19,15241,1,29,0)="total divided by Number of Days Diff values."
^DIC(19,15241,1,30,0)="Cloned from ""GMRC IFC RPT CONSULTS"" option."
^DIC(19,15241,3)=""
^DIC(19,15241,25)="EN^GMRCIR"
^DIC(19,15241,"U")="IFC REQUESTS"
^DIC(19,15242,0)="EHM-00063^List incomplete IFC transactions^^R^1^^^^^^^294^^^^"
^DIC(19,15242,1,0)="^19.06^3^3^3240328^^"
^DIC(19,15242,1,1,0)="This option is used to list and/or retransmit any and all Inter-facility"
^DIC(19,15242,1,2,0)="Consult activities that did not complete successfully. "
^DIC(19,15242,1,3,0)="Cloned from ""GMRC IFC INC TRANS"" option."
^DIC(19,15242,3)=""
^DIC(19,15242,25)="EN^GMRCINC"
^DIC(19,15242,"U")="LIST INCOMPLETE IFC TRANSACTIO"
^DIC(19,15243,0)="EHM-00064^Test IFC implementation^^R^1^^^^^^^294^^^^"
^DIC(19,15243,1,0)="^^5^5^3240328^"
^DIC(19,15243,1,1,0)="This option can be used to test the IFC setup for a given procedure or "
^DIC(19,15243,1,2,0)="consult service.  After selection of the service or procedure, the remote "
^DIC(19,15243,1,3,0)="site will be contacted and the procedure or service name will be "
^DIC(19,15243,1,4,0)="confirmed as correct.  Any errors encountered will be listed."
^DIC(19,15243,1,5,0)="Cloned from ""GMRC IFC TEST SETUP"" option."
^DIC(19,15243,3)=""
^DIC(19,15243,25)="EN^GMRCITST"
^DIC(19,15243,"U")="TEST IFC IMPLEMENTATION"
^DIC(19,15244,0)="EHM-00065^IFC Transaction Report^^R^1^^^^^^^294^^^^"
^DIC(19,15244,1,0)="^^6^6^3240328^"
^DIC(19,15244,1,1,0)="This option is used to list any or all Inter-facility Consult entries"
^DIC(19,15244,1,2,0)="from the IFC MESSAGE LOG file (#123.6)."
^DIC(19,15244,1,3,0)="NOTE: The parameter GMRC RETAIN IFC ACTIVITY DAYS controls the number of "
^DIC(19,15244,1,4,0)="days that completed Inter-facility Consult transactions are maintained in"
^DIC(19,15244,1,5,0)="the IFC MESSAGE LOG (#123.6) file."
^DIC(19,15244,1,6,0)="Cloned from ""GMRC IFC TRANS"" option."
^DIC(19,15244,3)=""
^DIC(19,15244,25)="EN^GMRCITR"
^DIC(19,15244,"U")="IFC TRANSACTION REPORT"
^DIC(19,15245,0)="EHM-00066^Locate IFC by Remote Cslt #^^R^1^^^^^^^294^^^^"
^DIC(19,15245,1,0)="^^4^4^3240328^"
^DIC(19,15245,1,1,0)="This option allows the look-up of a local consult/request when only the "
^DIC(19,15245,1,2,0)="remote site and remote consult number are known.  Upon look-up, the option"
^DIC(19,15245,1,3,0)="includes both a brief and detailed display of the request."
^DIC(19,15245,1,4,0)="Cloned from ""GMRC IFC REMOTE NUMBER"" option."
^DIC(19,15245,3)=""
^DIC(19,15245,25)="EN^GMRCILKP"
^DIC(19,15245,"U")="LOCATE IFC BY REMOTE CSLT #"
^DIC(19,15246,0)="EHM-00067^Print IFC Requests^^R^1^^^^^^^294^^^^"
^DIC(19,15246,1,0)="^^4^4^3240328^"
^DIC(19,15246,1,1,0)="Sends the Inter-facility Consult Requests report to a device without going"
^DIC(19,15246,1,2,0)="through the List Manager display of the report and waiting for the list to"
^DIC(19,15246,1,3,0)="be built."
^DIC(19,15246,1,4,0)="Cloned from ""GMRC IFC PRINT RPT NUMBERED"" option."
^DIC(19,15246,3)=""
^DIC(19,15246,25)="PRNTONLY^GMRCIR(120)"
^DIC(19,15246,"U")="PRINT IFC REQUESTS"
^DIC(19,15247,0)="EHM-00068^IFC Requests By Patient^^R^1^^^^^^^294^^1^1^"
^DIC(19,15247,1,0)="^^6^6^3240328^"
^DIC(19,15247,1,1,0)="This option provides actions which a service may use to track "
^DIC(19,15247,1,2,0)="inter-facility consults and requests.  "
^DIC(19,15247,1,3,0)="   "
^DIC(19,15247,1,4,0)="The processing flow is similiar to the OE/RR review screen.  Most of the"
^DIC(19,15247,1,5,0)="actions have the same mnemonics as OE/RR for clinician familiarity."
^DIC(19,15247,1,6,0)="Cloned from ""GMRC IFC RPT CONSULTS BY PT"" option."
^DIC(19,15247,3)=""
^DIC(19,15247,15)="K GMRCIS D ^GMRCREXT"
^DIC(19,15247,20)="S GMRCIS="""""
^DIC(19,15247,25)="EN^GMRCSLM"
^DIC(19,15247,"U")="IFC REQUESTS BY PATIENT"
^DIC(19,15248,0)="EHM-00069^IFC Requests by Remote Ordering Provider^^R^1^^^^^^^294^^1^1^"
^DIC(19,15248,1,0)="^^3^3^3240328^"
^DIC(19,15248,1,1,0)="This option provides detailed information regarding inter-facility"
^DIC(19,15248,1,2,0)="consults by remote ordering provider for consulting sites to utilize."
^DIC(19,15248,1,3,0)="Cloned from ""GMRC IFC RPT CONSULTS BY REMPR"" option."
^DIC(19,15248,3)=""
^DIC(19,15248,15)="K GMRCREMP,GMRCRF"
^DIC(19,15248,20)="S (GMRCREMP,GMRCRF)="""""
^DIC(19,15248,25)="EN^GMRCIR"
^DIC(19,15248,"U")="IFC REQUESTS BY REMOTE ORDERIN"
^DIC(19,15249,0)="EHM-00070^Monitor IFC background job parameters^^R^1^^^^^^^294^^^^"
^DIC(19,15249,1,0)="^^7^7^3240328^"
^DIC(19,15249,1,1,0)="This option allows the viewing of the two parameters involved in the"
^DIC(19,15249,1,2,0)="scheduling and running of the IFC background job. The parameters and their"
^DIC(19,15249,1,3,0)="current setting is listed along with any information the system can tell "
^DIC(19,15249,1,4,0)="from the settings.  From this display the start parameter may be edited "
^DIC(19,15249,1,5,0)="to a date/time in the future which will have the effect of delaying the "
^DIC(19,15249,1,6,0)="next run of the background job until the time defined in this parameter."
^DIC(19,15249,1,7,0)="Cloned from ""GMRC IFC BKG PARAM MON"" option."
^DIC(19,15249,3)=""
^DIC(19,15249,25)="EN^GMRCIBKM"
^DIC(19,15249,"U")="MONITOR IFC BACKGROUND JOB PAR"
^DIC(19,15250,0)="EHM-00071^Configure test account patients for IFC^^R^1^^^^^^^294^^^^"
^DIC(19,15250,1,0)="^^9^9^3240328^"
^DIC(19,15250,1,1,0)="WARNING: This option is for use in test accounts ONLY!"
^DIC(19,15250,1,2,0)="This option will not function in a production VistA environment."
^DIC(19,15250,1,3,0)=" "
^DIC(19,15250,1,4,0)="This option will use the social security number of the patient and create "
^DIC(19,15250,1,5,0)="a pseudo-ICN for the patient selected. If the patient name and social "
^DIC(19,15250,1,6,0)="security number are the same at the local facility and the IFC partnering"
^DIC(19,15250,1,7,0)="facility, the selected patient can be used for IFC testing after this"
^DIC(19,15250,1,8,0)="option is executed on both systems."
^DIC(19,15250,1,9,0)="Cloned from ""GMRC IFC TEST PT MPI"" option."
^DIC(19,15250,3)=""
^DIC(19,15250,25)="EN^GMRCITPI"
^DIC(19,15250,"U")="CONFIGURE TEST ACCOUNT PATIENT"
^DIC(19,15251,0)="EHM-00072^Print All Incomplete IFC Transactions^^R^1^^^^^^^294^^^^"
^DIC(19,15251,1,0)="^19.06^3^3^3240328^^^^"
^DIC(19,15251,1,1,0)="This option will print all incomplete IFC transactions sorted by Consult "
^DIC(19,15251,1,2,0)="number."
^DIC(19,15251,1,3,0)="Cloned from ""GMRC IFC INC RPT"" option."
^DIC(19,15251,3)=""
^DIC(19,15251,15)=""
