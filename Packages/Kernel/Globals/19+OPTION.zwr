^DIC(19,16069,0)="EHM-00890^Delete Health Summary Type^^E^1^^^^^^^160^^1^1^"
^DIC(19,16069,1,0)="^19.06^9^9^3240328^^^^"
^DIC(19,16069,1,1,0)="This option allows the owner of a Health Summary Type to delete"
^DIC(19,16069,1,2,0)="it. In addition anyone who holds the GMTSMGR key may use this "
^DIC(19,16069,1,3,0)="option. Also, if a Health Summary Type has a lock, anyone who "
^DIC(19,16069,1,4,0)="holds a key with that lock value may delete that Health Summary"
^DIC(19,16069,1,5,0)="Type.  This Option will not allow the deletion of a Health Summary"
^DIC(19,16069,1,6,0)="Type in use by a Health Summary Object.  It will not allow the "
^DIC(19,16069,1,7,0)="deletion of special case Health Summary Types such as GMTS HS "
^DIC(19,16069,1,8,0)="ADHOC OPTION, or REMOTE Health Summary Types."
^DIC(19,16069,1,9,0)="Cloned from ""GMTS TYPE DELETE"" option."
^DIC(19,16069,3)=""
^DIC(19,16069,15)="K %,GMTSMGR"
^DIC(19,16069,20)="K DA,DIC,DIE,DIK,DR"
^DIC(19,16069,30)="GMT(142,"
^DIC(19,16069,31)="AEMQ"
^DIC(19,16069,32)="Select Health Summary Type:"
^DIC(19,16069,34)="I +($$DHST^GMTSULT(+($G(Y))))"
^DIC(19,16069,50)="GMT(142,"
^DIC(19,16069,51)="[GMTS DELETE HLTH SUM TYPE]"
^DIC(19,16069,"U")="DELETE HEALTH SUMMARY TYPE"
^DIC(19,16070,0)="EHM-00891^Create/Modify Health Summary Type^^R^1^^^^^^^^^1^^"
^DIC(19,16070,1,0)="^^10^10^3240328^"
^DIC(19,16070,1,1,0)="This option allows the user to create or modify a Health Summary Type. New"
^DIC(19,16070,1,2,0)="types created under this option will automatically define the creator as"
^DIC(19,16070,1,3,0)="the owner unless creator holds the GMTSMGR security key in which case"
^DIC(19,16070,1,4,0)="GMTSMGR-holder may designate owner of his choice. Normally Health Summary"
^DIC(19,16070,1,5,0)="Types may be modified only by their owner. Exceptions are: someone who"
^DIC(19,16070,1,6,0)="holds the GMTSMGR key may modify any Health Summary Type. If a Health"
^DIC(19,16070,1,7,0)="Summary Type has a lock, someone who holds a security key with that lock"
^DIC(19,16070,1,8,0)="value may modify that Health Summary Type. Use the 'Delete Health Summary"
^DIC(19,16070,1,9,0)="Type' option to delete the Health Summary Type."
^DIC(19,16070,1,10,0)="Cloned from ""GMTS TYPE ENTER/EDIT"" option."
^DIC(19,16070,3)=""
^DIC(19,16070,15)=""
^DIC(19,16070,20)="K DA,DIC,DIE,DR"
^DIC(19,16070,25)="GMTSRM"
^DIC(19,16070,30)=""
^DIC(19,16070,31)=""
^DIC(19,16070,50)=""
^DIC(19,16070,51)=""
^DIC(19,16070,"U")="CREATE/MODIFY HEALTH SUMMARY T"
^DIC(19,16071,0)="EHM-00892^Hospital Location Health Summary^^R^1^^^^^n^^160^^^^"
^DIC(19,16071,1,0)="^^5^5^3240328^"
^DIC(19,16071,1,1,0)="Allows user to print health summaries interactively for all patients on a"
^DIC(19,16071,1,2,0)="specified ward(s), for all patients with appointments at a specified"
^DIC(19,16071,1,3,0)="outpatient clinic(s), or for all patients scheduled for a specified"
^DIC(19,16071,1,4,0)="operating room(s) on a selected day or range of days."
^DIC(19,16071,1,5,0)="Cloned from ""GMTS HS BY LOC"" option."
^DIC(19,16071,2)="y"
^DIC(19,16071,3)=""
^DIC(19,16071,25)="MAIN^GMTSPD"
^DIC(19,16071,99)="55425,54053"
^DIC(19,16071,"U")="HOSPITAL LOCATION HEALTH SUMMA"
^DIC(19,16072,0)="EHM-00893^Ad Hoc Health Summary^^R^1^^^^^^^160^^1^^"
^DIC(19,16072,1,0)="^^6^6^3240328^"
^DIC(19,16072,1,1,0)="Generates an 'Ad Hoc' Health Summary for specified patients. Instead of"
^DIC(19,16072,1,2,0)="selecting a pre-defined Health Summary Type, the user defines his own ad"
^DIC(19,16072,1,3,0)="hoc Health Summary structure for temporary use while using this option."
^DIC(19,16072,1,4,0)="The user selects Health Summary components, time and occurrence limits"
^DIC(19,16072,1,5,0)="when applicable, and selection items when applicable."
^DIC(19,16072,1,6,0)="Cloned from ""GMTS HS ADHOC"" option."
