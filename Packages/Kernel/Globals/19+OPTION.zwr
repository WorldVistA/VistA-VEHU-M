^DIC(19,545,0)="DG SCHED ADMIT PURGE^Purge Scheduled Admissions^^R^.5^^^^^^^114"
^DIC(19,545,1,0)="^^2^2^2901022^^"
^DIC(19,545,1,1,0)="This option is used to purge old scheduled admission data from the"
^DIC(19,545,1,2,0)="SCHEDULED ADMISSIONS file."
^DIC(19,545,25)="DGSCHAD1"
^DIC(19,545,"U")="PURGE SCHEDULED ADMISSIONS"
^DIC(19,546,0)="DG SCHED ADMIT CANCEL^Cancel a Scheduled Admission^^R^.5^^^^^^^114"
^DIC(19,546,1,0)="^^3^3^2870513^"
^DIC(19,546,1,1,0)="This option is used to cancel scheduled admissions.  Patients who expire"
^DIC(19,546,1,2,0)="or exceed the maximum number of days specified indicated in ADT Parameters"
^DIC(19,546,1,3,0)="are automatically cancelled by the module."
^DIC(19,546,25)="2^DGSCHAD"
^DIC(19,546,"U")="CANCEL A SCHEDULED ADMISSION"
^DIC(19,547,0)="PSJI ALIGNMENT^Align Labels (IV)^^A^11712^^^^^^^115^^1"
^DIC(19,547,1,0)="^^2^2^2910312^^^^"
^DIC(19,547,1,1,0)="  This option allows the user to align the labels on whatever printer"
^DIC(19,547,1,2,0)="he/she is preparing to print.  Three test labels will always print."
^DIC(19,547,20)="D ^PSIVXU Q:$D(XQUIT)  D ^PSIVALN,ENIVKV^PSGSETU K I,Z,ZISI"
^DIC(19,547,25)=""
^DIC(19,547,99)="54200,48798"
^DIC(19,547,"U")="ALIGN LABELS (IV)"
^DIC(19,549,0)="DG SCHED ADMIT STATS^Scheduled Admission Statistics^^R^.5^^^^^^^114"
^DIC(19,549,1,0)="^^5^5^2870513^"
^DIC(19,549,1,1,0)="This option is used to generate statistics for a specified date range of"
^DIC(19,549,1,2,0)="patients scheduled for admission versus those which were cancelled.  A"
^DIC(19,549,1,3,0)="subtotal of the reasons for cancellation is also provided on this report."
^DIC(19,549,1,4,0)="Report is broken into divisions (where applicable) and ward/treating"
^DIC(19,549,1,5,0)="specialty within each division."
^DIC(19,549,25)="DGSCHAD2"
^DIC(19,549,"U")="SCHEDULED ADMISSION STATISTICS"
^DIC(19,550,0)="PSJI DEVICE^Change Report/Label Devices (IV)^^A^11712^^^^^^^115^^1"
^DIC(19,550,1,0)="^^3^3^2910312^^^^"
^DIC(19,550,1,1,0)="This option simply allows the user to change output devices."
^DIC(19,550,1,2,0)="This option is 'Automatically' called when the user first signs"
^DIC(19,550,1,3,0)="in to the IV PACKAGE."
^DIC(19,550,20)="D ^PSIVXU Q:$D(XQUIT)  S PSIVZION=ION D ENCHK^PSIVSET,ENLD^PSIVSET,ENPD^PSIVSET S IOP=PSIVZION D ^%ZIS,SET^PSIVXU K IOP,PSIVZION,Z,%T D ENIVKV^PSGSETU"
^DIC(19,550,25)=""
^DIC(19,550,99)="54200,45997"
^DIC(19,550,"U")="CHANGE REPORT/LABEL DEVICES (I"
^DIC(19,551,0)="DG SCHED ADMIT^Scheduled Admissions Menu^^M^.5^^^^^^^114"
^DIC(19,551,1,0)="^^1^1^2870513^"
^DIC(19,551,1,1,0)="This menu contains the scheduled admissions options."
^DIC(19,551,10,0)="^19.01PI^5^5"
^DIC(19,551,10,1,0)="546^"
^DIC(19,551,10,2,0)="394^"
^DIC(19,551,10,3,0)="393^"
^DIC(19,551,10,4,0)="545^"
^DIC(19,551,10,5,0)="549^"
^DIC(19,551,10,"B",393,3)=""
^DIC(19,551,10,"B",394,2)=""
^DIC(19,551,10,"B",545,4)=""
^DIC(19,551,10,"B",546,1)=""
^DIC(19,551,10,"B",549,5)=""
^DIC(19,551,99)="62195,28623"
^DIC(19,551,"U")="SCHEDULED ADMISSIONS MENU"
^DIC(19,552,0)="PSJI INDIVIDUAL SUSPENSE^Individual Order Suspension (IV)^^A^1^^^^^^^^^1^1"
^DIC(19,552,1,0)="^^4^4^2920512^^^^"
^DIC(19,552,1,1,0)="  This option allows the user to suspend labels for a specific active order."
^DIC(19,552,1,2,0)="These labels will then be available for release by the IV room for doses"
^DIC(19,552,1,3,0)="due within the present coverage interval, or for the next interval if the "
^DIC(19,552,1,4,0)="Ward list for that batch has already been run."
^DIC(19,552,15)="K FIL,I1,ND,ORIFN,PSGLMT,PSIVUP,PSIVX,PSJIVORF,PSJORL,UL80"
^DIC(19,552,20)="D ^PSIVXU Q:$D(XQUIT)!(DONE=1)  S PSIVAC=""PRO"",PSIVBR=""D ^PSIVSUS"" D ENCHS^PSIV,ENIVKV^PSGSETU K DFN,J,N,N2,P17,P17,PS,PSIVAC,PSIVBR,PSIVNOW,PSIVNOL,SCHED,TN,ZQ7"
^DIC(19,552,25)=""
^DIC(19,552,"U")="INDIVIDUAL ORDER SUSPENSION (I"
^DIC(19,553,0)="DG COLLATERAL PATIENT^Collateral Patient Register^^R^.5^^^^^^^114"
^DIC(19,553,1,0)="^^2^2^2950712^^^^"
^DIC(19,553,1,1,0)="This option is used to enter a collateral patient into the system."
^DIC(19,553,1,2,0)="The patient selected cannot be a veteran."
^DIC(19,553,25)="DGCOL"
^DIC(19,553,"U")="COLLATERAL PATIENT REGISTER"
^DIC(19,554,0)="PSJI ACTIVE^Active Order List (IV)^^A^11712^^^^^^^115^^1^1"
^DIC(19,554,1,0)="^^12^12^2920512^^^^"
^DIC(19,554,1,1,0)="  This report will show all orders that are active from the time that"
^DIC(19,554,1,2,0)="this report is run.  This report is similar to the ward list, since"
^DIC(19,554,1,3,0)="the ward list also contains all active orders when it is run.  However,"
^DIC(19,554,1,4,0)="this report:"
^DIC(19,554,1,5,0)="    - Can be run at any time rather than at a start of coverage time."
^DIC(19,554,1,6,0)="    - Will not affect the calculation of labels after order entry."
^DIC(19,554,1,7,0)="      (After order entry the program will check to see if the ward list"
^DIC(19,554,1,8,0)="      has been run to calculate the # of labels needed for the"
^DIC(19,554,1,9,0)="      'ACTION' prompt.)"
^DIC(19,554,1,10,0)="    - Will contain all types of IV orders (Hyperals, Admixture,"
^DIC(19,554,1,11,0)="      Piggybacks etc.)."
^DIC(19,554,1,12,0)="    - Can be run for specific wards."
^DIC(19,554,15)="K PSIVBEG,PSIVEND,WRDB,WRDE,I1,I"
^DIC(19,554,20)="D ^PSIVXU Q:$D(XQUIT)  D ENTACT^PSIVRNL,ENIVKV^PSGSETU"
^DIC(19,554,25)=""
^DIC(19,554,99)="53926,37652"
^DIC(19,554,"U")="ACTIVE ORDER LIST (IV)"
^DIC(19,555,0)="DG RUG TRANSMISSION^Transmission via VADATS^^R^.5^DG RUG TRANSMISSION^^^^^^114"
^DIC(19,555,1,0)="^^1^1^2870619^"
^DIC(19,555,1,1,0)="TRANSMISSION OF RUG-II PATIENT ASSESSMENT INSTRUMENTS VIA VADATS."
^DIC(19,555,25)="VADATS^DGRUGDR"
^DIC(19,555,"U")="TRANSMISSION VIA VADATS"
^DIC(19,556,0)="PSJI PURGE ORDERS^Purge Expired Orders (IV)^TEMPORARILY UNAVAILABLE^A^11712^^^^^^^115^^1^1"
^DIC(19,556,1,0)="^^8^8^2920512^^^^"
^DIC(19,556,1,1,0)="  This option will allow the user to purge all expired and DC'ed IV orders "
^DIC(19,556,1,2,0)="that are at least 30 days old.  Any orders that are purged from the database"
^DIC(19,556,1,3,0)="CANNOT be retrieved. Orders which have an expiration date following the date"
^DIC(19,556,1,4,0)="selected will remain on file.  Orders which have been inactive for less than"
^DIC(19,556,1,5,0)="30 days cannot be purged.  Because of the large number of orders entered in "
^DIC(19,556,1,6,0)="the IV package, the Purge option should be run at least once a month, to "
^DIC(19,556,1,7,0)="prevent decreased performance caused by compiling orders which are no longer"
^DIC(19,556,1,8,0)="needed."
^DIC(19,556,15)="K %T,CAO,D,DFN,DR,N,ON,ORETURN,ORPV,ORSTOP,ORSTRT,ORSTS,P,P17,PSGTOL,PSGTOO,PSGUOW,PSIV,PSIVREA,PSJS,TN,WCA,Y"
^DIC(19,556,20)="D ^PSIVXU Q:$D(XQUIT)  D ^PSIVPGE"
^DIC(19,556,25)=""
^DIC(19,556,"U")="PURGE EXPIRED ORDERS (IV)"
^DIC(19,557,0)="DG DISPOSITION OUTPUT MENU^Disposition Outputs Menu^^M^.5^^^^^^^114"
^DIC(19,557,1,0)="^^1^1^2901022^^"
^DIC(19,557,1,1,0)="This menu contains the disposition output options."
^DIC(19,557,10,0)="^19.01PI^3^3"
^DIC(19,557,10,1,0)="396^"
^DIC(19,557,10,2,0)="397^"
^DIC(19,557,10,3,0)="559^"
