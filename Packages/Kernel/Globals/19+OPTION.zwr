^DIC(19,15252,0)="EHM-00073^Edit IFC Processing Parameters^^A^1^^^^^^^294^^1^^"
^DIC(19,15252,1,0)="^19.06^3^3^3240328^^"
^DIC(19,15252,1,1,0)="This option allows the editing of parameters related to the processing of "
^DIC(19,15252,1,2,0)="Inter-facility Consult requests."
^DIC(19,15252,1,3,0)="Cloned from ""GMRC IFC PARAMETER EDIT"" option."
^DIC(19,15252,3)=""
^DIC(19,15252,20)="D TED^XPAREDIT(""GMRC IFC PARAMETERS"",""B"")"
^DIC(19,15252,"U")="EDIT IFC PROCESSING PARAMETERS"
^DIC(19,15253,0)="EHM-00074^IFC Possible Erroneous Comments Report^^M^1^^^^^^^^^^^"
^DIC(19,15253,1,0)="^19.06^5^5^3240328^^^^"
^DIC(19,15253,1,1,0)="This option (EC) provides two ways to create a possible erroneous comments report to aid in cleanup of IFC comments belonging to consults for another patient. A formatted version of the report and a delmited version of the report are now "
^DIC(19,15253,1,2,0)="available by selecting the SCR or CSV options. "
^DIC(19,15253,1,3,0)="The reports include interfacility consults of activity type UPDATE/COMPLETE where there are associated or remote-associated results and also comments. These comments are the possible erroneous comments that need to be reviewed and possibly "
^DIC(19,15253,1,4,0)="removed."
^DIC(19,15253,1,5,0)="Cloned from ""GMRC IFC ERR COMM RPT"" option."
^DIC(19,15253,3)=""
^DIC(19,15253,10,0)="^19.01IP^2^2"
^DIC(19,15253,10,1,0)="15254^SCR^1"
^DIC(19,15253,10,2,0)="15255^CSV^2"
^DIC(19,15253,10,"B",15254,1)=""
^DIC(19,15253,10,"B",15255,2)=""
^DIC(19,15253,10,"C","CSV",2)=""
^DIC(19,15253,10,"C","SCR",1)=""
^DIC(19,15253,25)=""
^DIC(19,15253,99)="67411,49173"
^DIC(19,15253,"U")="IFC POSSIBLE ERRONEOUS COMMENT"
^DIC(19,15254,0)="EHM-00075^IFC Possible Erroneous Comments Report^^R^1^^^^^^^^^1^^"
^DIC(19,15254,1,0)="^19.06^1^1^3240328^^^^"
^DIC(19,15254,1,1,0)="Cloned from ""GMRC IFC ERR COMM RPT 1"" option."
^DIC(19,15254,3)=""
^DIC(19,15254,20)="D EN^GMRCICMT"
^DIC(19,15254,"U")="IFC POSSIBLE ERRONEOUS COMMENT"
^DIC(19,15255,0)="EHM-00076^IFC Possible Erroneous Comments Report - Delimited^^R^1^^^^^^^^^1^^"
^DIC(19,15255,1,0)="^19.06^1^1^3240328^^^^"
^DIC(19,15255,1,1,0)="Cloned from ""GMRC IFC ERR COMM RPT 2"" option."
^DIC(19,15255,3)=""
^DIC(19,15255,20)="D EN^GMRCICMX"
^DIC(19,15255,99)="66578,58614"
^DIC(19,15255,"U")="IFC POSSIBLE ERRONEOUS COMMENT"
^DIC(19,15256,0)="EHM-00077^Define Fee Services^^A^1^^^^^^^294^^1^^"
^DIC(19,15256,1,0)="^^4^4^3240328^"
^DIC(19,15256,1,1,0)="This option allows review, adding, and removal of services listed in the "
^DIC(19,15256,1,2,0)="GMRC FEE SERVICES system parameter. Services listed in this parameter are "
^DIC(19,15256,1,3,0)="defined as Non-VA Care (Fee Basis) services."
^DIC(19,15256,1,4,0)="Cloned from ""GMRC FEE PARAM"" option."
^DIC(19,15256,3)=""
^DIC(19,15256,20)="D EN^GMRCFP"
^DIC(19,15256,"U")="DEFINE FEE SERVICES"
^DIC(19,15257,0)="EHM-00078^Menu for Closure Tools^^M^1^^^^^^^294^^^^"
^DIC(19,15257,1,0)="^19.06^2^2^3240328^^"
^DIC(19,15257,1,1,0)="The menu is used to call three consult closure tool options."
^DIC(19,15257,1,2,0)="Cloned from ""GMRC CONSULT CLOSURE TOOL"" option."
^DIC(19,15257,3)=""
^DIC(19,15257,10,0)="^19.01IP^3^3"
