^DIC(19,16202,0)="EHM-01023^Edit 'Health Summary Types List' Parameters^^R^1^^^^^^^^^^^"
^DIC(19,16202,1,0)="^^5^5^3240328^"
^DIC(19,16202,1,1,0)="Use this option to add, edit or delete a Health Summary Type from"
^DIC(19,16202,1,2,0)="the list of Health Summary Types defined by the user.  If you are "
^DIC(19,16202,1,3,0)="a holder of the GMTSMGR Key, you can also use this option to edit"
^DIC(19,16202,1,4,0)="the Health Summary Types defined for the System."
^DIC(19,16202,1,5,0)="Cloned from ""GMTS GUI HS LIST PARAMETERS"" option."
