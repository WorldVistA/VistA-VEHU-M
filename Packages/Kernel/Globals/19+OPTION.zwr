^DIC(19,3106,"U")="COMPILE IV STATISTICS (IV)"
^DIC(19,3107,0)="PSJI SUSLBDEL^Delete Labels from Suspense (IV)^^R^11712^^^^^^^115^^^1"
^DIC(19,3107,1,0)="^^3^3^2910312^^^^"
^DIC(19,3107,1,1,0)="  Allows labels to be deleted from suspense.  This option allows deletion"
^DIC(19,3107,1,2,0)="of labels for orders which have been placed on suspense.  The order is not"
^DIC(19,3107,1,3,0)="affected by this option, only the labels are deleted."
^DIC(19,3107,15)="K I1,PSJORL"
^DIC(19,3107,20)=""
^DIC(19,3107,25)="PSIVLBDL"
^DIC(19,3107,"U")="DELETE LABELS FROM SUSPENSE (I"
^DIC(19,3108,0)="PSJI AMIS^AMIS (IV)^^A^11712^^^^^^^115^^1^1"
^DIC(19,3108,1,0)="^^7^7^2910312^^^^"
^DIC(19,3108,1,1,0)="  This report computes the AMIS data concerning the IV workload of the"
^DIC(19,3108,1,2,0)="pharmacy, by ward.  Only those wards with a dispensing amount will be"
^DIC(19,3108,1,3,0)="included.  You will be prompted for a start date (date to begin capturing"
^DIC(19,3108,1,4,0)="data), and an ending date (date to stop capturing data)."
^DIC(19,3108,1,5,0)=" "
^DIC(19,3108,1,6,0)="**NOTE: Canceled, recycled, or destroyed IV bags are not subtracted out of"
^DIC(19,3108,1,7,0)="the total bag count on the AMIS report."
^DIC(19,3108,15)="K I1,PSIVAMIS"
^DIC(19,3108,20)="D ^PSIVXU Q:$D(XQUIT)  S PSIVAMIS=1 D ^PSIVRQ"
^DIC(19,3108,25)=""
^DIC(19,3108,"U")="AMIS (IV)"
^DIC(19,3109,0)="PSJI PROVIDER REPORT^PRovider Drug Cost Report (132 COLUMNS) (IV)^^A^11712^^^^^^^115^^1^1"
^DIC(19,3109,1,0)="^^2^2^2940309^^^^"
^DIC(19,3109,1,1,0)="Enter a provider's name or ^ALL for all providers. This report calculates"
^DIC(19,3109,1,2,0)="the total cost of drugs prescribed by provider within a specified date range."
^DIC(19,3109,15)="K I1,PSIVPROV"
^DIC(19,3109,20)="D ^PSIVXU Q:$D(XQUIT)  S PSIVPCR=1 D ^PSIVRQ,ENIVKV^PSGSETU"
^DIC(19,3109,25)=""
^DIC(19,3109,"U")="PROVIDER DRUG COST REPORT (132"
^DIC(19,3110,0)="PSJI DRUG COST REPORT^Drug Cost Report (132 COLUMNS) (IV)^^A^11712^^^^^^^115^^1^1"
^DIC(19,3110,1,0)="^^5^5^2940709^^^^"
^DIC(19,3110,1,1,0)="This report lists dispensing information for IV drugs. The report may "
^DIC(19,3110,1,2,0)="be  run for a single drug, all drugs, non-formulary drugs, a specific "
^DIC(19,3110,1,3,0)="category of drugs, a VA class of drugs, a specific IV type, or by cost."
^DIC(19,3110,1,4,0)="The report may be run for a single or all IV Rooms, and may also include "
^DIC(19,3110,1,5,0)="ward and patient dispensing data."
^DIC(19,3110,15)="K I1"
^DIC(19,3110,20)="D ^PSIVXU Q:$D(XQUIT)  S PSIVDCR=1,PQ="""" D ^PSIVRQ"
^DIC(19,3110,25)=""
^DIC(19,3110,"U")="DRUG COST REPORT (132 COLUMNS)"
^DIC(19,3111,0)="PSJI PATIENT COST^Patient Cost Report (132 COLUMNS) (IV)^^A^11712^^^^^^^115^^1^1"
^DIC(19,3111,1,0)="^^7^7^2940309^^^^"
^DIC(19,3111,1,1,0)="  This option generates a report which captures the total IV dispensing"
^DIC(19,3111,1,2,0)="cost for a specific patient.  The user enters the range of dates for"
^DIC(19,3111,1,3,0)="which data is to be captured, and the name of the selected patient.  The"
^DIC(19,3111,1,4,0)="report first lists the patient name, SSN, DOB, ward, weight, diagnosis, "
^DIC(19,3111,1,5,0)="and the date range selected.  For each drug ordered, the drug name, amount  "
^DIC(19,3111,1,6,0)="dispensed, destroyed, recycled, or cancelled is listed, along with the "
^DIC(19,3111,1,7,0)="total cost of each drug and a grand total for the selected patient."
^DIC(19,3111,15)="K I,I1,PSJORL"
^DIC(19,3111,20)="D ^PSIVXU Q:$D(XQUIT)  S PSIVPAT=1 D ^PSIVRQ,ENIVKV^PSGSETU K DGA1,DGT,PSIVPROV"
^DIC(19,3111,25)=""
^DIC(19,3111,"U")="PATIENT COST REPORT (132 COLUM"
^DIC(19,3112,0)="PSJI WARD/DRUG USAGE REPORT^Ward/Drug Usage Report (132 COLUMNS) (IV)^^A^11712^^^^^^^115^^1^1"
^DIC(19,3112,1,0)="^^8^8^2910312^^^^"
^DIC(19,3112,1,1,0)="  This report captures the total IV dispensing cost for a drug, by ward.  "
^DIC(19,3112,1,2,0)="Your are asked to enter the start date (date to start capturing data), and"
^DIC(19,3112,1,3,0)="a stop date (date to stop capturing data). At the ""Select DRUG"" prompt, "
^DIC(19,3112,1,4,0)="you may enter a specific drug, ""^ALL"" for all drugs, ""^NON"" for all"
^DIC(19,3112,1,5,0)="non-formulary drugs, ""^CAT"" for a category of drugs, or ""^VADC"" for a"
^DIC(19,3112,1,6,0)="specific drug class.  At the ""Select WARD"" prompt, you may enter the"
^DIC(19,3112,1,7,0)="name of a specific ward, ""^ALL"" for all wards, or ""^OUTPATIENT"" for"
^DIC(19,3112,1,8,0)="outpatient locations only."
^DIC(19,3112,15)="K I1,PSIVWARD"
^DIC(19,3112,20)="D ^PSIVXU Q:$D(XQUIT)  S PSIVWCR=1 D ^PSIVRQ,ENIVKV^PSGSETU"
^DIC(19,3112,25)=""
^DIC(19,3112,"U")="WARD/DRUG USAGE REPORT (132 CO"
^DIC(19,3113,0)="PSJI MANAGEMENT REPORTS^Management Reports (IV)^^M^11712^^^^^^^115^^^1"
^DIC(19,3113,1,0)="^^8^8^2940310^^^^"
^DIC(19,3113,1,1,0)="  This menu contains options which allow the printing of reports from data"
^DIC(19,3113,1,2,0)="compiled by the IV Medications module.  Access to this option is restricted"
^DIC(19,3113,1,3,0)="to users with the ""PSJI MGR"" security key.  Those reports requiring 132"
^DIC(19,3113,1,4,0)="column paper are so noted in the name of the report.  If no paper width"
^DIC(19,3113,1,5,0)="is indicated, the standard 80 column width is assumed.  At the device"
^DIC(19,3113,1,6,0)="prompt, you may either accept the default printing device by pressing"
^DIC(19,3113,1,7,0)="the return key, or enter the name of the device where the report should"
^DIC(19,3113,1,8,0)="print."
^DIC(19,3113,10,0)="^19.01PI^8^7"
^DIC(19,3113,10,1,0)="3108^^2"
