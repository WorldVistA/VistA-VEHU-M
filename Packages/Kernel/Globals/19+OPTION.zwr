^DIC(19,10770,0)="RA PROCPARENT^Parent Procedure List^^R^11712^^^^^^y^"
^DIC(19,10770,1,0)="^^5^5^2970522^^^"
^DIC(19,10770,1,1,0)="The 'Parent Procedure List' option allows the user to display the data"
^DIC(19,10770,1,2,0)="associated with parent procedures.  This option allows the user to select"
^DIC(19,10770,1,3,0)="the imaging types so parent procedures of the selected imaging types are"
^DIC(19,10770,1,4,0)="displayed.  The user may also specify if active procedures, inactive"
^DIC(19,10770,1,5,0)="procedures, or both inactive and active procedures are to be displayed."
