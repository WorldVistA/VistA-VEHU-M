^DIC(19,15786,25)="SUPPLYNF^ORSPUTIL"
^DIC(19,15786,"U")="CONVERT SUPPLY NON-FORMULARY O"
^DIC(19,15787,0)="EHM-00608^CONVERT SUPPLY OUTPATIENT OIS^^R^1^^^^^^^^^^^"
^DIC(19,15787,1,0)="^^4^4^3240328^"
^DIC(19,15787,1,1,0)="Use this option to set all orderable items that are marked as Supply and "
^DIC(19,15787,1,2,0)="that are set as QO-ONLY=YES for Outpatient Meds, to be QO-ONLY=YES for "
^DIC(19,15787,1,3,0)="Supplies also."
^DIC(19,15787,1,4,0)="Cloned from ""OR SUPPLY OP CONVERSION"" option."
^DIC(19,15787,3)=""
^DIC(19,15787,25)="COPYO2S^ORSPUTIL"
^DIC(19,15787,"U")="CONVERT SUPPLY OUTPATIENT OIS"
^DIC(19,15788,0)="EHM-00609^CONVERT SUPPLY QUICK ORDERS^^R^1^^^^^^^^^^^"
^DIC(19,15788,1,0)="^^4^4^3240328^"
^DIC(19,15788,1,1,0)="Use this option to convert all Outpatient Medication quick orders that"
^DIC(19,15788,1,2,0)="were built for orderable items that are considered supply items, to use"
^DIC(19,15788,1,3,0)="the PSO SUPPLY dialog."
^DIC(19,15788,1,4,0)="Cloned from ""OR SUPPLY QO CONVERSION"" option."
^DIC(19,15788,3)=""
^DIC(19,15788,25)="SUPPLYQO^ORSPUTIL"
^DIC(19,15788,"U")="CONVERT SUPPLY QUICK ORDERS"
