^DIC(19,3205,0)="DVB HMENU-HINQ^HINQ Menu (Version 4.0)^^M^.5^DVBHINQ^^^^^^"
^DIC(19,3205,1,0)="^^3^3^2990204^^^^"
^DIC(19,3205,1,1,0)="This is the main menu for the Hospital Inquiry (HINQ) system.  Options"
^DIC(19,3205,1,2,0)="available from this menu will be displayed based on the HINQ security"
^DIC(19,3205,1,3,0)="held by the user."
^DIC(19,3205,10,0)="^19.01PI^11^9"
^DIC(19,3205,10,1,0)="3206^"
^DIC(19,3205,10,2,0)="3207^"
