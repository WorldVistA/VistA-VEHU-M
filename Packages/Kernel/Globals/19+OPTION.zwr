^DIC(19,15269,0)="EHM-00090^Notification Mgmt Menu^^M^1^^^^^^^^^^^"
^DIC(19,15269,1,0)="^^6^6^3240328^^^^"
^DIC(19,15269,1,1,0)="This menu is used by clinical coordinators and IRM staff to turn"
^DIC(19,15269,1,2,0)="notifications on or off for a provider.  It prompts the coordinator for the"
^DIC(19,15269,1,3,0)="user/provider for whom they are turning on/off notifications then calls "
^DIC(19,15269,1,4,0)="other notification mgmt options.  It also contains options that can"
^DIC(19,15269,1,5,0)="purge exisitng notifications."
^DIC(19,15269,1,6,0)="Cloned from ""ORB NOT COORD MENU"" option."
^DIC(19,15269,3)=""
