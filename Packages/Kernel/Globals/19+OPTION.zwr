^DIC(19,10504,0)="LRACC MERGE^Merge Accessions^^R^10958^^^^^^^"
^DIC(19,10504,1,0)="^^5^5^2970212^"
^DIC(19,10504,1,1,0)="This option will merge 2 accessions into one if the patient and specimen"
^DIC(19,10504,1,2,0)="for the accessions are the same.  This option is the preferred method"
^DIC(19,10504,1,3,0)="for moving tests/accessions rather than the options that independently"
^DIC(19,10504,1,4,0)="add and remove tests from accessions.  Fewer steps are involved and all"
^DIC(19,10504,1,5,0)="the original order information remains intact."
^DIC(19,10504,25)="EN^LR7OMERG"
^DIC(19,10504,"U")="MERGE ACCESSIONS"
^DIC(19,10505,0)="LR7O PAR DOMAIN^Domain Level Parameter Edit^^A^10958^^^^^^^^^1"
