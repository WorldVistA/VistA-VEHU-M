^DIC(19,2128,0)="LRAC A^Mumps A index of the LAB REPORTS file^^A^.5^^^^^^^26^^1"
^DIC(19,2128,1,0)="^^4^4^2851104^^"
^DIC(19,2128,1,1,0)="This option does a re-cross-reference on the mumps ""A"" index on the"
^DIC(19,2128,1,2,0)="LAB TEST subfield of the LAB REPORTS file."
^DIC(19,2128,1,3,0)="The ""A"" cross-reference contains reference ranges, critical ranges, and"
^DIC(19,2128,1,4,0)="units from the LABORATORY TEST file."
^DIC(19,2128,20)="K LR S LR(1)=1 D EN^LRACDIAG"
^DIC(19,2128,"U")="MUMPS A INDEX OF THE LAB REPOR"
^DIC(19,2129,0)="LRAC AC^Mumps AC index of the LAB REPORTS file^^A^.5^^^^^^^26^^1"
^DIC(19,2129,1,0)="^^4^4^2851104^^"
^DIC(19,2129,1,1,0)="This option does a re-cross-reference on the mumps ""AC"" index "
^DIC(19,2129,1,2,0)="on the TEST LOCATION subfield of the LAB REPORTS file."
^DIC(19,2129,1,3,0)="The ""AC"" cross-reference is to identify the tests in the file that"
^DIC(19,2129,1,4,0)="have data names in the LAB DATA file (atomic tests)."
^DIC(19,2129,20)="K LR S LR(2)=1 D EN^LRACDIAG"
^DIC(19,2129,"U")="MUMPS AC INDEX OF THE LAB REPO"
^DIC(19,2130,0)="LRAC AR^Mumps AR index of the LAB REPORTS file^^A^.5^^^^^^^26^^1"
^DIC(19,2130,1,0)="^^4^4^2851104^^"
^DIC(19,2130,1,1,0)="This option does a re-cross-reference on the mumps ""AR"" index"
^DIC(19,2130,1,2,0)="on the LAB TEST subfield of the LAB REPORTS file."
^DIC(19,2130,1,3,0)="The ""AR"" cross-reference holds the site/specimen for each test in the"
^DIC(19,2130,1,4,0)="file."
^DIC(19,2130,20)="K LR S LR(3)=1 D EN^LRACDIAG"
^DIC(19,2130,"U")="MUMPS AR INDEX OF THE LAB REPO"
^DIC(19,2131,0)="LRAC A AC AR^Mumps A, AC, & AR indexes of the LAB REPORTS file^^A^.5^^^^^^^26^^1"
^DIC(19,2131,1,0)="^^3^3^2880418^^"
^DIC(19,2131,1,1,0)="This option does a re-cross-reference on the ""A"" and ""AR"" indexes of "
^DIC(19,2131,1,2,0)="the LAB TEST subfield and the ""AC"" index of the TEST LOCATION subfield"
^DIC(19,2131,1,3,0)="within the LAB REPORTS FILE.  All three indexes are re-cross-referenced."
^DIC(19,2131,20)="K LR S LR(1)=1,LR(2)=1,LR(3)=1 D EN^LRACDIAG"
^DIC(19,2131,"U")="MUMPS A, AC, & AR INDEXES OF T"
