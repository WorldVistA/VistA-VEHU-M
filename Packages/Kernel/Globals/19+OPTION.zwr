^DIC(19,10979,1,0)="^^1^1^2960815^^"
^DIC(19,10979,1,1,0)="Enter the code indicating the clinical danger level of the order check."
^DIC(19,10979,25)="CLINDL^ORKMGR"
^DIC(19,10979,"U")="SET CLINICAL DANGER LEVEL FOR "
