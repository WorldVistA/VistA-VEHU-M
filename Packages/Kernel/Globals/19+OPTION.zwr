^DIC(19,12308,0)="RORMNT EDIT LAB SEARCH^Edit Lab Search Criteria^^E^1^^^^^^^540"
^DIC(19,12308,1,0)="^^3^3^3060131^"
^DIC(19,12308,1,1,0)="This option is used to edit the Lab search criteria (stored in the ROR LAB"
^DIC(19,12308,1,2,0)="SEARCH file (#798.9)) that are used by the registry update process to find"
^DIC(19,12308,1,3,0)="patients with positive registry-specific Lab results."
^DIC(19,12308,2)="y"
^DIC(19,12308,30)="ROR(798.9,"
^DIC(19,12308,31)="AEMQ"
^DIC(19,12308,50)="ROR(798.9,"
