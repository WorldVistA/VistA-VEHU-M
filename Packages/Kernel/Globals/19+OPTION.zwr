^DIC(19,16228,20)=""
^DIC(19,16228,25)="LEXEDF1"
^DIC(19,16228,"U")="EDIT TERM DEFINITION"
^DIC(19,16229,0)="EHM-01050^Edit Shortcuts by Context^^R^1^^^^^^^512^^^^"
^DIC(19,16229,1,0)="^19.06^2^2^3240328^^^"
^DIC(19,16229,1,1,0)="This option lets managers add or delete shortcuts (by context)."
^DIC(19,16229,1,2,0)="Cloned from ""LEX MGR EDIT SHORTCUTS"" option."
^DIC(19,16229,3)=""
^DIC(19,16229,25)="LEXSC"
^DIC(19,16229,"U")="EDIT SHORTCUTS BY CONTEXT"
^DIC(19,16230,0)="EHM-01051^Edit Search Threshold for a Coding System^^R^1^^^^^^^^^^^"
^DIC(19,16230,1,0)="^^5^5^3240328^"
^DIC(19,16230,1,1,0)="This allows a manager to edit the search threshold for"
^DIC(19,16230,1,2,0)="a coding system.  That is the default number of record"
^DIC(19,16230,1,3,0)="to examine before prompting the user to continue or "
^DIC(19,16230,1,4,0)="refine the search."
^DIC(19,16230,1,5,0)="Cloned from ""LEX MGR EDIT SEARCH THRESHOLD"" option."
^DIC(19,16230,3)=""
^DIC(19,16230,25)="EN^LEXDMGS"
^DIC(19,16230,"U")="EDIT SEARCH THRESHOLD FOR A CO"
^DIC(19,16231,0)="EHM-01052^Defaults^^M^1^^^^^^^512^^^^"
^DIC(19,16231,1,0)="^^5^5^3240328^^^^"
^DIC(19,16231,1,1,0)="This menu option contains two sub-options.  The first one is used to modify "
^DIC(19,16231,1,2,0)="user defaults (filter, display, vocabulary and keywords) for a single user or a"
^DIC(19,16231,1,3,0)="user group.  The other sub-option is used to list the users defaults to a "
^DIC(19,16231,1,4,0)="device (for a single user or user group)."
^DIC(19,16231,1,5,0)="Cloned from ""LEX MGR DEFAULTS"" option."
^DIC(19,16231,3)=""
^DIC(19,16231,10,0)="^19.01IP^2^2"
^DIC(19,16231,10,1,0)="16232^1^1"
^DIC(19,16231,10,2,0)="16233^2^2"
