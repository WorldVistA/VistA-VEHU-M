^DIC(19,14463,1,0)="^19.06^3^3^3150706^^"
^DIC(19,14463,1,1,0)="This report allows sites to evaluate and review erroneous problems found "
^DIC(19,14463,1,2,0)="in the Problem file that have a SNOMED CT concept code stored in the"
^DIC(19,14463,1,3,0)="Diagnosis field."
^DIC(19,14463,20)="D VWERRPT^GMPLCLN"
^DIC(19,14463,"U")="SNOMED IN DIAGNOSIS FIELD ERRO"
^DIC(19,14464,0)="GMPL DIAG CLEANUP REPORT^SNOMED in Diagnosis Field Cleanup Report^^A^1^^^^^^^402^^1"
^DIC(19,14464,1,0)="^19.06^4^4^3150706^^"
^DIC(19,14464,1,1,0)="This report allows sites to review a list of records that have been "
^DIC(19,14464,1,2,0)="corrected and cleaned up by patch GMPL*2.0*40 or as a result of running "
^DIC(19,14464,1,3,0)="the Generate SNOMED in Diagnosis Field Err/Cleanup Rpt [GMPL GENERATE "
^DIC(19,14464,1,4,0)="DIAG RPTS] menu option."
^DIC(19,14464,20)="D VWCLRPT^GMPLCLN"
^DIC(19,14464,"U")="SNOMED IN DIAGNOSIS FIELD CLEA"
^DIC(19,14465,0)="GMPL GENERATE DIAG RPTS^Generate SNOMED in Diagnosis Field Err/Cleanup Rpt^^A^1^^^^^^^402^^1"
^DIC(19,14465,1,0)="^^5^5^3150625^"
^DIC(19,14465,1,1,0)="This option allows sites to run a scan of the Problem file for errors "
^DIC(19,14465,1,2,0)="whereby the SNOMED CT concept code is incorrectly stored in the Diagnosis "
^DIC(19,14465,1,3,0)="field. If errors are found, a cleanup of the Problem file is performed and"
^DIC(19,14465,1,4,0)="two separate Mailman messages will be sent to the installer containing "
^DIC(19,14465,1,5,0)="instructions on how to access the error and cleanup reports."
^DIC(19,14465,20)="D EN^GMPLCLNP"
^DIC(19,14465,"U")="GENERATE SNOMED IN DIAGNOSIS F"
