^DIC(19,16538,0)="EHM-01359^Patient List Management^^R^1^^^^^^^534^^^^"
^DIC(19,16538,1,0)="^19.06^8^8^3240328^^^^"
^DIC(19,16538,1,1,0)="This option manages reminder patient lists. Local patient lists may be"
^DIC(19,16538,1,2,0)="created from list rules, copied to OE/RR teams, copied to other patient"
^DIC(19,16538,1,3,0)="lists or deleted."
^DIC(19,16538,1,4,0)=" "
^DIC(19,16538,1,5,0)="Local patient lists and national patient lists (from the extract process) "
^DIC(19,16538,1,6,0)="are listed. Individual lists may be displayed or printed or used to run "
^DIC(19,16538,1,7,0)="health summaries."
^DIC(19,16538,1,8,0)="Cloned from ""PXRM EXTRACT PATIENT LIST"" option."
^DIC(19,16538,3)=""
^DIC(19,16538,25)="START^PXRMLPU(0)"
^DIC(19,16538,"U")="PATIENT LIST MANAGEMENT"
^DIC(19,16539,0)="EHM-01360^List Rule Management^^A^1^^^^^^^534^^1^^"
^DIC(19,16539,1,0)="^^21^21^3240328^"
^DIC(19,16539,1,1,0)="This option allows creation/editing of list rules which are used to build "
^DIC(19,16539,1,2,0)="patient lists and test rule set criteria. "
^DIC(19,16539,1,3,0)="      "
^DIC(19,16539,1,4,0)="There are four types of list rules criteria managed from this list manage "
^DIC(19,16539,1,5,0)="option:"
^DIC(19,16539,1,6,0)=" "
^DIC(19,16539,1,7,0)="       PATIENT LIST RULE   defines an existing patient list to identify "
^DIC(19,16539,1,8,0)="                           patients."
^DIC(19,16539,1,9,0)="       FINDING RULE        defines reminder term findings to identify "
^DIC(19,16539,1,10,0)="                           patients."
^DIC(19,16539,1,11,0)="       REMINDER RULE       defines a reminder, where the patient cohort "
^DIC(19,16539,1,12,0)="                           logic is used to identify applicable patients."
^DIC(19,16539,1,13,0)="       LIST RULE SET       combines multiple list rule criteria (Patient "
^DIC(19,16539,1,14,0)="                           List, Finding Rule, and Reminder Rule) in a"
^DIC(19,16539,1,15,0)="                           specified sequence, where each sequence has"
^DIC(19,16539,1,16,0)="                           an operation (Add, Remove, Select) to "
^DIC(19,16539,1,17,0)="                           create/modify a patient list."
^DIC(19,16539,1,18,0)=" "
^DIC(19,16539,1,19,0)="Nationally released list rules are used by nationally released extract  "
^DIC(19,16539,1,20,0)="definitions for national extract runs."
^DIC(19,16539,1,21,0)="Cloned from ""PXRM LIST RULE MANAGEMENT"" option."
^DIC(19,16539,3)=""
^DIC(19,16539,20)="D START^PXRMLRM"
^DIC(19,16539,"U")="LIST RULE MANAGEMENT"
