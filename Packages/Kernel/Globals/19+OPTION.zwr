^DIC(19,16163,1,0)="^^3^3^3240328^^"
^DIC(19,16163,1,1,0)="This allows the user to display the characteristics of a Health Summary"
^DIC(19,16163,1,2,0)="Component."
^DIC(19,16163,1,3,0)="Cloned from ""GMTS COMP INQ"" option."
