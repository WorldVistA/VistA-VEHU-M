^DIC(19,1569,0)="RA PROFILES^Patient Profile Menu^^M^11712^^^^^^^"
^DIC(19,1569,1,0)="^^3^3^2940606^"
^DIC(19,1569,1,1,0)="This menu provides the user with various functions that allow"
^DIC(19,1569,1,2,0)="the user to view exam and report information about a specific"
^DIC(19,1569,1,3,0)="patient."
^DIC(19,1569,10,0)="^19.01PI^6^6"
^DIC(19,1569,10,1,0)="1581^"
