^DIC(19,13445,25)="CLEREDIT^XUSNPIED"
^DIC(19,13445,"U")="ADD/EDIT NPI VALUES FOR PROVID"
^DIC(19,13446,0)="XUS NPI EXEMPT PROVIDER^Mark/Unmark Provider Exempt from requiring an NPI^^R^10000000020^^^^^^^163"
^DIC(19,13446,1,0)="^^4^4^3060505^"
^DIC(19,13446,1,1,0)="This option is used by support staff to indicate that a provider who has "
^DIC(19,13446,1,2,0)="a Person Class entry relating to a taxonomy value that would normally "
^DIC(19,13446,1,3,0)="require and NPI value, as not needing one (e.g., if the provider were "
^DIC(19,13446,1,4,0)="doing administrative work full time)."
^DIC(19,13446,25)="CLERXMPT^XUSNPIED"
^DIC(19,13446,"U")="MARK/UNMARK PROVIDER EXEMPT FR"
^DIC(19,13447,0)="XUS NPI PROVIDER SELF ENTRY^PROVIDER NPI SELF ENTRY^^R^10000000020^^^^^^^163"
^DIC(19,13447,1,0)="^^4^4^3060508^"
^DIC(19,13447,1,1,0)="This option provides the ability for a Provider to enter his/her own NPI "
^DIC(19,13447,1,2,0)="value and effective date.  It is intended to be attached to the XU COMMON "
^DIC(19,13447,1,3,0)="menu and checks for whether the user selecting it has the need to enter "
^DIC(19,13447,1,4,0)="an NPI value."
^DIC(19,13447,25)="USEREDIT^XUSNPIED"
^DIC(19,13447,"U")="PROVIDER NPI SELF ENTRY"
^DIC(19,13448,0)="XU CHECKSUM REPORT^Compare local/national checksums report^^R^10000000020^^^^^^^163"
^DIC(19,13448,1,0)="^19.06^10^10^3060814^^"
^DIC(19,13448,1,1,0)="Checksums for routines are compared to the values in the ROUTINE file and "
^DIC(19,13448,1,2,0)="a report is provided listing routines that differ by patch or version, "
^DIC(19,13448,1,3,0)="version or patch correct but checksums off, local routines being tracked "
^DIC(19,13448,1,4,0)="and information not on record for a patch (e.g., test patches)."
^DIC(19,13448,1,5,0)=" "
^DIC(19,13448,1,6,0)="Nationally released routines' checksums are sent by Master File Updates "
^DIC(19,13448,1,7,0)="to the local ROUTINE file 9.8 automatically.  Local sites may also record "
^DIC(19,13448,1,8,0)="checksums in the CHECKSUM VALUE field in the ROUTINE file.  To compare "
^DIC(19,13448,1,9,0)="local routines which are being tracked, the CHECKSUM REPORT field should "
^DIC(19,13448,1,10,0)="be set to ""Local - report""."
^DIC(19,13448,25)="REPORT^XUGOT1"
^DIC(19,13448,"U")="COMPARE LOCAL/NATIONAL CHECKSU"
^DIC(19,13449,0)="XU CHECKSUM LOAD^Load/refresh checksum values into ROUTINE file^^R^10000000020^^^^^^^163"
^DIC(19,13449,1,0)="^19.06^2^2^3041108^^"
^DIC(19,13449,1,1,0)="Updates the routine file with the latest checksum values"
^DIC(19,13449,1,2,0)="from FORUM."
^DIC(19,13449,25)="LOAD^XUGOT"
^DIC(19,13449,"U")="LOAD/REFRESH CHECKSUM VALUES I"
^DIC(19,13450,0)="XUMF LOAD NPI^Load Institution NPI values^USE XUMF LOAD INSTITUTION^R^10000000216^^^^^^^163"
^DIC(19,13450,1,0)="^^2^2^3060822^"
^DIC(19,13450,1,1,0)="This option will execute an HL7 query to FORUM to get the NPI values"
^DIC(19,13450,1,2,0)="from the Institution Master File and update the local Institution file."
^DIC(19,13450,25)="EN^XUMF416"
^DIC(19,13450,"U")="LOAD INSTITUTION NPI VALUES"
