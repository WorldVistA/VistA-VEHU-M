^DIC(19,12768,0)="XU PROC CNT CLUP^XUS Process count cleanup^^R^10000000020^^^^^^^163^n"
^DIC(19,12768,1,0)="^^5^5^3040218^"
^DIC(19,12768,1,1,0)="This Option is only needed for GT.M sites."
^DIC(19,12768,1,2,0)="For a GT.M site it should be scheduled to run between every 1 to 8 hours."
^DIC(19,12768,1,3,0)="This is the Kernel process count cleanup routine."
^DIC(19,12768,1,4,0)="It checks the entries in XUTL(""XUSYS"",$J) to see if they are still active"
^DIC(19,12768,1,5,0)="and if not remove the entry."
^DIC(19,12768,25)="CLEAR^XUSCNT(0)"
^DIC(19,12768,200.9)="y"
^DIC(19,12768,"U")="XUS PROCESS COUNT CLEANUP"
