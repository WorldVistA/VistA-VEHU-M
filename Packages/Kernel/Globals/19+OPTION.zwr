^DIC(19,10149,0)="ENDELPM^Delete Old Incomplete PM Work Orders^^R^11596^ENMGR^^^^^^"
^DIC(19,10149,1,0)="^^4^4^2970226^"
^DIC(19,10149,1,1,0)="Will schedule a task to delete any incomplete PM work orders that were"
^DIC(19,10149,1,2,0)="created before a user specified date. The intent is to clear the Work"
^DIC(19,10149,1,3,0)="Order File of old PM worklists that haven't been closed out and aren't"
^DIC(19,10149,1,4,0)="going to be. This will speed up numerous searches and sorts."
^DIC(19,10149,25)="EN^ENWOLD"
^DIC(19,10149,"U")="DELETE OLD INCOMPLETE PM WORK "
^DIC(19,10150,0)="ENPM9^Reassign a Technician's PM Responsibilities^^R^11596^ENMGR^^^^^^33"
^DIC(19,10150,1,0)="^^4^4^2970314^"
^DIC(19,10150,1,1,0)="This option is used to to change the preventive maintenance (PM) schedules"
^DIC(19,10150,1,2,0)="by replacing one technician by a different techinican. This change can be"
^DIC(19,10150,1,3,0)="limited to PMs by one responsible shop or done for all responsible shops."
^DIC(19,10150,1,4,0)="Both the Equipment Category and Equipment Inv. files will be updated."
^DIC(19,10150,25)="RT^ENEQPMP1"
^DIC(19,10150,"U")="REASSIGN A TECHNICIAN'S PM RES"
