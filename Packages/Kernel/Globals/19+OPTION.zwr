^DIC(19,14949,0)="OR FLAG ORDER EXPIRE DEFAULT^Order Flag Expire Default^^A^1^^^^^^^^^1"
^DIC(19,14949,1,0)="^^6^6^3210302^"
^DIC(19,14949,1,1,0)="This option will allow sites to setup a default duration to the 'No Action"
^DIC(19,14949,1,2,0)="Alert' field displayed as part of the Flag Order screen in CPRS. If this"
^DIC(19,14949,1,3,0)="is not set, CPRS will use 24 hours as the default. "
^DIC(19,14949,1,4,0)="When flagging an order in CPRS, if 'Create a No Action Alert' field is "
^DIC(19,14949,1,5,0)="checked then, an 'Order flag expired' notification is generated and sent "
^DIC(19,14949,1,6,0)="to the user who flagged the order."
^DIC(19,14949,20)="D EDITPAR^XPAREDIT(""OR FLAG ORDER EXPIRE DEFAULT"")"
^DIC(19,14949,"U")="ORDER FLAG EXPIRE DEFAULT"
^DIC(19,14950,0)="DG PRESUMP. PSYCH. PAT. DETAIL^Presumptive Psychosis Patient Detail Report^^R^1^^^^^^^"
^DIC(19,14950,1,0)="^^2^2^3210107^"
^DIC(19,14950,1,1,0)="This option generates a report of an individual  patient treated under "
^DIC(19,14950,1,2,0)="Presumptive Psychosis authority within the user specified date range."
^DIC(19,14950,25)="MAIN^DGPPDRPT"
^DIC(19,14950,"U")="PRESUMPTIVE PSYCHOSIS PATIENT "
^DIC(19,14951,0)="OR OTH BTN MSG ADD/EDIT^GUI Add/Edit Local Message for OTH Button^^R^1^^^10^^^^"
^DIC(19,14951,1,0)="^19.06^7^7^3210219^^^"
^DIC(19,14951,1,1,0)=" The OTH button in CPRS currently displays the message ""Call"
^DIC(19,14951,1,2,0)=" Registration Team for Details"" as a default.  If the Clinical Application"
^DIC(19,14951,1,3,0)=" Coordinator wishes to create additional information to the current default,"
^DIC(19,14951,1,4,0)=" this option can be used.  Please note, use of this menu option is entirely"
^DIC(19,14951,1,5,0)=" optional.  If the CAC does not enter any additional information using this"
^DIC(19,14951,1,6,0)=" option, the site will still see ""Call Registration Team for Details"" in the "
^DIC(19,14951,1,7,0)=" OTH button in CPRS."
^DIC(19,14951,10.1)="OTH Add/Edit Local Message"
^DIC(19,14951,25)="LOCMSG^OROTHBTN"
^DIC(19,14951,"U")="GUI ADD/EDIT LOCAL MESSAGE FOR"
