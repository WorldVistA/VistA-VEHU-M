^DIC(19,13552,1,0)="^19.06^3^3^3070816^^"
^DIC(19,13552,1,1,0)="Generate a list of all Internet Refill prescriptions sorted by Patient, "
^DIC(19,13552,1,2,0)="Date, or Result for one division or for all. This report can be printed "
^DIC(19,13552,1,3,0)="in detail or summary format."
