^DIC(19,16729,0)="EHM-01550^Edit Skin Test Reading CPT Code^^A^1^^^^^^^^^1^^"
^DIC(19,16729,1,0)="^^4^4^3240328^"
^DIC(19,16729,1,1,0)="This option is used to edit the CPT code that should be automatically"
^DIC(19,16729,1,2,0)="filed when a skin test reading is recorded. If blank, a CPT code will not "
^DIC(19,16729,1,3,0)="automatically be filed when a skin test reading entry is saved."
