^DIC(19,12949,25)="BEG^ECXTRT"
^DIC(19,12949,"U")="TREATING SPECIALTY CHANGE EXTR"
^DIC(19,12950,0)="ECXSCAPPROV^Approve Reviewed DSS Clinic Worksheet^^R^10000000020^ECXMGR^^^^^^513"
^DIC(19,12950,1,0)="^^6^6^2960717^^^^"
^DIC(19,12950,1,1,0)="This option provides the extract manager a mechanism to approve all"
^DIC(19,12950,1,2,0)="DSS Stop Codes and DSS Credit Stop Codes as site defined in the CLINICS "
^DIC(19,12950,1,3,0)="AND STOP CODES file (#728.44).  Running this option will mark all "
^DIC(19,12950,1,4,0)="currently existing entries in this file as ""reviewed"" with a date.  This "
^DIC(19,12950,1,5,0)="will allow sites to select to print the ""Clinics and DSS Stop Codes "
^DIC(19,12950,1,6,0)="Print"" by ALL or UNREVIEWED."
^DIC(19,12950,25)="APPROVE^ECXSCLD"
^DIC(19,12950,"U")="APPROVE REVIEWED DSS CLINIC WO"
^DIC(19,12951,0)="ECXPAI^PAI File Extract^OUT OF ORDER, DO NOT USE THIS OPTION!!!^R^10000000020^^^^^^^513"
