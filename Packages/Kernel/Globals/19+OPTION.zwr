^DIC(19,11497,52)=""
^DIC(19,11497,"U")="EDIT FINDING PARAMETERS"
^DIC(19,11498,0)="PXRM DIALOG MANAGEMENT^Reminder Dialog Management^^M^10000000020^^^^^^y^534^n"
^DIC(19,11498,1,0)="^19.06^2^2^3040226^^^^"
^DIC(19,11498,1,1,0)="This menu allows maintenance of the parameters used by CPRS for reminder"
^DIC(19,11498,1,2,0)="dialog processing."
^DIC(19,11498,10,0)="^19.01IP^21^3"
^DIC(19,11498,10,18,0)="11514^DI^9"
^DIC(19,11498,10,19,0)="11515^DP^1"
^DIC(19,11498,10,21,0)="13024^DR"
^DIC(19,11498,10,"B",11514,18)=""
^DIC(19,11498,10,"B",11515,19)=""
^DIC(19,11498,10,"B",13024,21)=""
^DIC(19,11498,10,"C","DI",18)=""
^DIC(19,11498,10,"C","DP",19)=""
^DIC(19,11498,10,"C","DR",21)=""
^DIC(19,11498,25)=""
^DIC(19,11498,99)="67131,68795"
^DIC(19,11498,99.1)="67804,41143"
^DIC(19,11498,"U")="REMINDER DIALOG MANAGEMENT"
^DIC(19,11499,0)="PXRM FINDING TYPE PARAMETERS^General Finding Type Parameters^^R^10000000020^^^^^^^534"
^DIC(19,11499,1,0)="^^14^14^3000313^"
^DIC(19,11499,1,1,0)="This option allows display of the finding type parameters file used in"
^DIC(19,11499,1,2,0)="generating reminder dialogs. There is limited edit on this file to allow"
^DIC(19,11499,1,3,0)="customization of prefix and suffix text. Parameters may also be disabled"
^DIC(19,11499,1,4,0)="if not required at your site."
^DIC(19,11499,1,5,0)=" "
^DIC(19,11499,1,6,0)="The file is structured by finding type and within that resolution status."
^DIC(19,11499,1,7,0)="Reminder dialog generated will include a question (dialog element) for"
^DIC(19,11499,1,8,0)="each resolution type enabled in the finding type parameter file. The"
^DIC(19,11499,1,9,0)="question text is constructed as prefix_finding item name_suffix."
^DIC(19,11499,1,10,0)=" "
^DIC(19,11499,1,11,0)="Health factors are treated slightly differently. Health factors are linked"
^DIC(19,11499,1,12,0)="to resolution statuses by the PXRM HEALTH FACTOR RESOLUTIONS option. For"
^DIC(19,11499,1,13,0)="reminders with health factors questions are only generated if there is a"
^DIC(19,11499,1,14,0)="resolution mapping AND an enabled finding type parameter."
^DIC(19,11499,25)="PXRMFIND"
^DIC(19,11499,"U")="GENERAL FINDING TYPE PARAMETER"
^DIC(19,11500,0)="PXRM FINDING ITEM PARAMETERS^Finding Item Parameters^^R^10000000020^^^^^^^534^^^"
^DIC(19,11500,1,0)="^^8^8^2991003^^"
^DIC(19,11500,1,1,0)="If a reminder finding item will always be resolved by the same question"
^DIC(19,11500,1,2,0)="(dialog element) or set of questions (dialog group) then an entry should"
^DIC(19,11500,1,3,0)="be made in the finding item parameter file linking the reminder finding"
^DIC(19,11500,1,4,0)="item to the dialog element or group."
^DIC(19,11500,1,5,0)=" "
^DIC(19,11500,1,6,0)="When a reminder dialog is generated it will include the questions defined"
^DIC(19,11500,1,7,0)="in this file (applicable to the findings on the reminder) instead of"
^DIC(19,11500,1,8,0)="generating dialog using the finding type parameters file."
^DIC(19,11500,15)=""
^DIC(19,11500,20)=""
^DIC(19,11500,25)="PXRMFIP"
^DIC(19,11500,30)=""
