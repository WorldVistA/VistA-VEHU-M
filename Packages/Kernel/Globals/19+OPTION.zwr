^DIC(19,5313,"U")="CLINIC SCHEDULING"
^DIC(19,5314,0)="ECTW UD PRVR^Cost per Provider^^R^.5^^^^^^^189^^1^1"
^DIC(19,5314,1,0)="^^7^7^2901129^^"
^DIC(19,5314,1,1,0)="This option is taken from the Inpatient Meds - Unit Dose module."
^DIC(19,5314,1,2,0)="This report will print the cost of all drugs dispensed within a "
^DIC(19,5314,1,3,0)="user specified length of time, grouped together by the ordering"
^DIC(19,5314,1,4,0)="physician (provider).  The report will show a sub-total for each  "
^DIC(19,5314,1,5,0)="provider, and will show the total cost for all providers at the"
^DIC(19,5314,1,6,0)="end of the report.  Beginning with version 3, the report may be"
^DIC(19,5314,1,7,0)="printed for one or more specific providers or for all providers."
^DIC(19,5314,15)="I $S('$D(^PS(59.7,1,20)):1,1:^(20)<3) D ENKV^PSGSET"
^DIC(19,5314,20)="S ECT1=""UDP"" I $S('$D(^PS(59.7,1,20)):1,1:^(20)<3),'$D(^XUTL(""XQ"",$J,""PSG""_DUZ))!'$D(^XUTL(""PSG"",DUZ)) D ^PSGSET"
^DIC(19,5314,25)="ECTDIR"
^DIC(19,5314,"U")="COST PER PROVIDER"
^DIC(19,5315,0)="ECTW UD SCT^Total Cost per Service^^R^.5^^^^^^^189^^1^1"
^DIC(19,5315,1,0)="^^6^6^2901129^"
^DIC(19,5315,1,1,0)="This option is taken from the Inpatient Meds - Unit Dose module."
^DIC(19,5315,1,2,0)="This report prints the total cost of dispensed medications for"
^DIC(19,5315,1,3,0)="ward services (medicine, surgery, etc.) over a user specified"
^DIC(19,5315,1,4,0)="time frame.  The report provides the total number of units"
^DIC(19,5315,1,5,0)="dispensed, the total cost of those units dispensed, and the average"
^DIC(19,5315,1,6,0)="cost of each unit dispensed on a service by service basis."
^DIC(19,5315,15)="I $S('$D(^PS(59.7,1,20)):1,1:^(20)<3) D ENKV^PSGSET"
^DIC(19,5315,20)="S ECT1=""UDS"" I $S('$D(^PS(59.7,1,20)):1,1:^(20)<3),'$D(^XUTL(""XQ"",$J,""PSG""_DUZ))!'$D(^XUTL(""PSG"",DUZ)) D ^PSGSET"
^DIC(19,5315,25)="ECTDIR"
^DIC(19,5315,"U")="TOTAL COST PER SERVICE"
^DIC(19,5316,0)="ECTW LRCAPS^CAP Statistics Summary^^R^.5^^^^^^^189"
^DIC(19,5316,1,0)="^^7^7^2901129^"
^DIC(19,5316,1,1,0)="This option is taken from the Laboratory software.  The report is a"
^DIC(19,5316,1,2,0)="summary of CAP statistics by user selectable station, lab section and"
^DIC(19,5316,1,3,0)="date.  It gives counts and totals of lab procedures by lab section."
^DIC(19,5316,1,4,0)="Counts are also given for tests on inpatients and outpatients, stat"
^DIC(19,5316,1,5,0)="tests, repeats, QC and standards.  Unit weights (UW) are calculated"
^DIC(19,5316,1,6,0)="by the weight defined in the CAP file (#64) times the specimen count."
^DIC(19,5316,1,7,0)="This report requires 132 columns for display/printout."
^DIC(19,5316,25)="LRCAPS"
^DIC(19,5316,"U")="CAP STATISTICS SUMMARY"
^DIC(19,5317,0)="ECTW LR COUNT ACC TESTS^Count Accessioned Tests^^R^.5^^^^^^^189^^1"
^DIC(19,5317,1,0)="^^6^6^2910105^^^"
^DIC(19,5317,1,1,0)="This option is taken from the Laboratory system.  The report provides"
^DIC(19,5317,1,2,0)="a count of all tests by requesting area and cumulative totals for a"
^DIC(19,5317,1,3,0)="given accession area.  The report will list the number of accessions"
^DIC(19,5317,1,4,0)="and test counts by location and also give a total number of accessions"
^DIC(19,5317,1,5,0)="and total test count by accession area.  The option has two displays -"
^DIC(19,5317,1,6,0)="'counts by location' and 'counts by test'."
^DIC(19,5317,20)="D LR^ECTMENU"
^DIC(19,5317,25)="LRUPACA"
^DIC(19,5317,"U")="COUNT ACCESSIONED TESTS"
^DIC(19,5318,0)="ECTQ RPT BY SERVICE^Occurrences by Service^^R^.5^^^^^^^189^^1"
^DIC(19,5318,1,0)="^^2^2^2901204^"
^DIC(19,5318,1,1,0)="This option produces a report of occurrences sorted by service"
^DIC(19,5318,1,2,0)="with one service per page."
