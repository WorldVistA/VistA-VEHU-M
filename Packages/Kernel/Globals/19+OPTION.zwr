^DIC(19,16088,1,2,0)="including any defined by the site, and optionally all temporarily"
^DIC(19,16088,1,3,0)="DISABLED components, sequenced alphabetically by name."
^DIC(19,16088,1,4,0)="Cloned from ""GMTS IRM/ADPAC ADHOC LOAD"" option."
^DIC(19,16088,3)=""
^DIC(19,16088,25)="GMTSLOAD"
^DIC(19,16088,"U")="REBUILD AD HOC HEALTH SUMMARY "
