^DIC(19,10458,0)="ENFARB^Summary of SGL Balances^^R^11596^^^^^^^33"
^DIC(19,10458,1,0)="^^4^4^2961216^"
^DIC(19,10458,1,1,0)="This option generates a report of closing dollar balances by Standard"
^DIC(19,10458,1,2,0)="General Ledger for a specified month. This data is obtained from FAP"
^DIC(19,10458,1,3,0)="Documents (FA, FB, FC, FD, and FR) that have been sent by the site. The"
^DIC(19,10458,1,4,0)="output is sorted by Station and optionally by Fund."
^DIC(19,10458,25)="ENFARB"
^DIC(19,10458,"U")="SUMMARY OF SGL BALANCES"
^DIC(19,10459,0)="ENFARA^Adjustment Voucher Report^^R^11596^^^^^^^33"
^DIC(19,10459,1,0)="^^8^8^2970630^"
^DIC(19,10459,1,1,0)="This option generates a report of adjustment vouchers for a selected date"
^DIC(19,10459,1,2,0)="range. Adjustment vouchers are used to communicate information to Fiscal"
^DIC(19,10459,1,3,0)="concerning selected FAP Documents. Each adjustment voucher is associated"
^DIC(19,10459,1,4,0)="with one FAP Document. Not all FAP Documents have an adjustment voucher."
^DIC(19,10459,1,5,0)=" "
^DIC(19,10459,1,6,0)="It is recommended that this option be scheduled to automatically print on"
^DIC(19,10459,1,7,0)="a daily basis (via TaskManager). If automatically queued, the report will"
^DIC(19,10459,1,8,0)="include all adjustment vouchers created on the previous day."
^DIC(19,10459,25)="ENFARA"
^DIC(19,10459,200.9)="y"
^DIC(19,10459,"U")="ADJUSTMENT VOUCHER REPORT"
^DIC(19,10460,0)="ENFA AV^Adjustment Voucher Entry^^R^11596^ENFACS^^^^^^33"
^DIC(19,10460,1,0)="^^2^2^2970717^^"
