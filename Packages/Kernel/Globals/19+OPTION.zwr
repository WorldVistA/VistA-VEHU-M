^DIC(19,12447,0)="PSD NM MENU^CS Monitoring Menu^^M^10000000020^^^^^^^276"
^DIC(19,12447,1,0)="^19.06^8^8^3030329^^^^"
^DIC(19,12447,1,1,0)="This standalone menu contains CS Monitoring reports to help"
^DIC(19,12447,1,2,0)="facilitate the monitoring of CS and Schedule II narcotics.  The menu "
^DIC(19,12447,1,3,0)="should be assigned to the appropriate Narcotic Inspectors and "
^DIC(19,12447,1,4,0)="Pharmacy Managers at the site. "
^DIC(19,12447,1,5,0)=" "
^DIC(19,12447,1,6,0)=" "
^DIC(19,12447,1,7,0)="IA 3882 - Gives permission for Kernel's Option Access by User [XUOPTWHO]"
^DIC(19,12447,1,8,0)="           option to be included on this menu."
^DIC(19,12447,10,0)="^19.01IP^7^7"
^DIC(19,12447,10,1,0)=12448
^DIC(19,12447,10,2,0)=12449
^DIC(19,12447,10,3,0)=12450
^DIC(19,12447,10,4,0)=12451
^DIC(19,12447,10,5,0)=12452
^DIC(19,12447,10,6,0)=12453
^DIC(19,12447,10,7,0)=107
