^DIC(19,12308,"U")="EDIT LAB SEARCH CRITERIA"
^DIC(19,12310,0)="RORMNT PENDING ERRORS LIST^List of Pending Errors^^P^1^^^^^^^540"
^DIC(19,12310,1,0)="^^9^9^3060131^"
^DIC(19,12310,1,1,0)=" "
^DIC(19,12310,1,2,0)="The option prints a report containing list of patients (referenced by the"
^DIC(19,12310,1,3,0)="ERROR multiples of the ROR PATIENT EVENTS file (#798.3)) having erroneous"
^DIC(19,12310,1,4,0)="data. The list is sorted by value of the COUNTER field (number of times"
^DIC(19,12310,1,5,0)="that an error was recorded for a patient)."
^DIC(19,12310,1,6,0)=" "
^DIC(19,12310,1,7,0)="This report can be used to find patients ignored by the registry update"
^DIC(19,12310,1,8,0)="(until someone fixes the error(s) and resets value of the COUNTER field to"
^DIC(19,12310,1,9,0)="1)."
^DIC(19,12310,2)="y"
^DIC(19,12310,60)="RORDATA(798.3,"
^DIC(19,12310,62)=0
^DIC(19,12310,63)="[ROR PENDING ERRORS]"
^DIC(19,12310,64)="[ROR PENDING ERRORS]"
^DIC(19,12310,65)=""
^DIC(19,12310,66)=""
^DIC(19,12310,"U")="LIST OF PENDING ERRORS"
^DIC(19,12311,0)="RORMNT PENDING PATIENTS^Pending Patients^^M^1^^^^^^^540"
^DIC(19,12311,1,0)="^^3^3^3060131^"
^DIC(19,12311,1,1,0)=" "
^DIC(19,12311,1,2,0)="This menu groups the options used for maintenance of the ROR PATIENT "
^DIC(19,12311,1,3,0)="EVENTS file (#798.3) containing event and error references."
^DIC(19,12311,2)="y"
^DIC(19,12311,10,0)="^19.01IP^1^1"
^DIC(19,12311,10,1,0)="12310^LPE"
