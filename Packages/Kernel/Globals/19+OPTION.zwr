^DIC(19,3131,0)="PRPF CLEAR LOCK^Clear Account Lock^^R^11596^^^^^^^151"
^DIC(19,3131,1,0)="^^5^5^2870901.2134^"
^DIC(19,3131,1,1,0)="This option allows a supervisor to clear a lock on an account.  Locks "
^DIC(19,3131,1,2,0)="are installed at the time a clerk begins to edit an account.  If the"
^DIC(19,3131,1,3,0)="options terminates abnormally i.e. power failure, line drop; the lock"
^DIC(19,3131,1,4,0)="may not be cleared automatically and will need to be cleared using this"
^DIC(19,3131,1,5,0)="option."
^DIC(19,3131,25)="CLEAR^PRPFED"
^DIC(19,3131,200.9)="n"
^DIC(19,3131,"U")="CLEAR ACCOUNT LOCK"
