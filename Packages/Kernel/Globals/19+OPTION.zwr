^DIC(19,16764,0)="EHM-01585^PCE Encounter Data Entry^^A^1^^^^^^^^^1^^"
^DIC(19,16764,1,0)="^^11^11^3240328^"
^DIC(19,16764,1,1,0)="This option is for users who can document a clinical encounter in the"
^DIC(19,16764,1,2,0)="V-files (visit related files), but can only delete V-File encounter"
^DIC(19,16764,1,3,0)="entries that they have created. The data entered via this option includes"
^DIC(19,16764,1,4,0)="visit information (where and when), and the following clinical data"
^DIC(19,16764,1,5,0)="related to the visit: providers of care, problems treated, procedures and"
^DIC(19,16764,1,6,0)="treatments done, and immunizations, skin tests, and patient education"
^DIC(19,16764,1,7,0)="given."
^DIC(19,16764,1,8,0)=" "
^DIC(19,16764,1,9,0)=" "
^DIC(19,16764,1,10,0)="This option is intended for data entry staff."
^DIC(19,16764,1,11,0)="Cloned from ""PXCE ENCOUNTER DATA ENTRY"" option."
^DIC(19,16764,3)=""
^DIC(19,16764,10.1)="PCE"
^DIC(19,16764,20)="D EN^PXCE(""d"")"
^DIC(19,16764,99.1)="56179,36316"
^DIC(19,16764,"U")="PCE ENCOUNTER DATA ENTRY"
^DIC(19,16765,0)="EHM-01586^PCE Encounter Data Entry and Delete^^A^1^^^^^^^^^1^^"
^DIC(19,16765,1,0)="^^11^11^3240328^"
^DIC(19,16765,1,1,0)="This option is for users who can document a clinical encounter in the"
^DIC(19,16765,1,2,0)="V-files (visit related files), and can also delete any V-File encounter"
^DIC(19,16765,1,3,0)="entries, even though they are not the creator of the entries."
^DIC(19,16765,1,4,0)="The data entered via this option includes visit information"
^DIC(19,16765,1,5,0)="(where and when), and the following clinical data related to the visit:"
^DIC(19,16765,1,6,0)="providers of care, problems treated, procedures and treatments done,"
^DIC(19,16765,1,7,0)="and immunizations, skin tests, and patient education given."
^DIC(19,16765,1,8,0)=" "
^DIC(19,16765,1,9,0)="This option is intended for the Coordinator for PCE and/or supervisor of"
^DIC(19,16765,1,10,0)="the encounter data entry staff."
^DIC(19,16765,1,11,0)="Cloned from ""PXCE ENCOUNTER ENTRY & DELETE"" option."
^DIC(19,16765,3)=""
^DIC(19,16765,10.1)="PCE"
^DIC(19,16765,20)="D EN^PXCE(""D"")"
^DIC(19,16765,99.1)="56179,36316"
^DIC(19,16765,"U")="PCE ENCOUNTER DATA ENTRY AND D"
^DIC(19,16766,0)="EHM-01587^PCE Encounter Data Entry without Delete^^A^1^^^^^^^^^1^^"
^DIC(19,16766,1,0)="^^8^8^3240328^"
^DIC(19,16766,1,1,0)="This option is for users who can document a clinical encounter in the"
^DIC(19,16766,1,2,0)="V-files (visit-related files), but should not be able to delete any"
^DIC(19,16766,1,3,0)="entries, including ones that they have created. The data entered via this"
^DIC(19,16766,1,4,0)="option includes visit information (where and when), and the"
^DIC(19,16766,1,5,0)="following clinical data related to the visit: providers of care, problems"
^DIC(19,16766,1,6,0)="treated, procedures and treatments done, and immunizations, skin tests,"
^DIC(19,16766,1,7,0)="and patient education given."
^DIC(19,16766,1,8,0)="Cloned from ""PXCE ENCOUNTER ENTRY NO DELETE"" option."
^DIC(19,16766,3)=""
^DIC(19,16766,10.1)="PCE"
^DIC(19,16766,20)="D EN^PXCE("""")"
^DIC(19,16766,99.1)="56179,36316"
^DIC(19,16766,"U")="PCE ENCOUNTER DATA ENTRY WITHO"
^DIC(19,16767,0)="EHM-01588^Directions to Patient's Home Add/Edit^^E^1^^^^^^^^^^^"
^DIC(19,16767,1,0)="^^6^6^3240328^^"
^DIC(19,16767,1,1,0)="This option lets you enter directions to a patient's home - especially"
^DIC(19,16767,1,2,0)="useful for Hospital-Based Home Care staff."
^DIC(19,16767,1,3,0)=" "
^DIC(19,16767,1,4,0)="The Health Summary package contains a new PCE component that displays the"
^DIC(19,16767,1,5,0)="directions entered through this option."
^DIC(19,16767,1,6,0)="Cloned from ""PX EDIT LOCATION OF HOME"" option."
^DIC(19,16767,3)=""
^DIC(19,16767,10.1)="Dir. to Pt Home"
^DIC(19,16767,30)="AUPNPAT("
^DIC(19,16767,31)="AEMQ"
^DIC(19,16767,50)="AUPNPAT("
^DIC(19,16767,51)="[PX LOCATION OF HOME]"
^DIC(19,16767,"U")="DIRECTIONS TO PATIENT'S HOME A"
^DIC(19,16768,0)="EHM-01589^PCE Encounter Data Entry - Supervisor^^A^1^^^^^^^507^^1^1^"
^DIC(19,16768,1,0)="^19.06^15^15^3240328^^^^"
^DIC(19,16768,1,1,0)="This option allows for the add/edit/deleting of information on certain"
^DIC(19,16768,1,2,0)="encounters that most users should not be changing and the other PCE"
^DIC(19,16768,1,3,0)="options will not allow to be changed. This option also does not"
^DIC(19,16768,1,4,0)="conditionally not ask some fields, i.e. it always ask all of the fields."
^DIC(19,16768,1,5,0)="In addition this option allows users to document a clinical encounter in"
^DIC(19,16768,1,6,0)="the V-files (visit related files), and can also delete any V-File"
^DIC(19,16768,1,7,0)="encounter entries, even though they are not the creator of the entries."
^DIC(19,16768,1,8,0)="The data entered via this option includes visit information (where and"
^DIC(19,16768,1,9,0)="when), and the following clinical data related to the visit: providers of"
^DIC(19,16768,1,10,0)="care, problems treated, procedures and treatments done, and immunizations,"
^DIC(19,16768,1,11,0)="skin tests, and patient education given."
^DIC(19,16768,1,12,0)=" "
^DIC(19,16768,1,13,0)="This option is intended for the Coordinator for PCE and/or supervisor of"
^DIC(19,16768,1,14,0)="the encounter data entry staff."
^DIC(19,16768,1,15,0)="Cloned from ""PXCE ENCOUNTER ENTRY SUPER"" option."
^DIC(19,16768,3)=""
^DIC(19,16768,10.1)="SUP"
^DIC(19,16768,15)="K SDSCEDIT"
^DIC(19,16768,20)="S SDSCEDIT=1 D EN^PXCE(""S"")"
^DIC(19,16768,99.1)="56179,36316"
^DIC(19,16768,"U")="PCE ENCOUNTER DATA ENTRY - SUP"
^DIC(19,16769,0)="EHM-01590^PCE HS/RPT Parameter Menu^^M^1^^^^^^^^^^^"
^DIC(19,16769,1,0)="^^12^12^3240328^"
^DIC(19,16769,1,1,0)="This menu option contains print and edit options for PCE fields related to"
^DIC(19,16769,1,2,0)="the PCE Reports module.  "
^DIC(19,16769,1,3,0)=" "
^DIC(19,16769,1,4,0)="Use the print option to see what the current definition is for these"
^DIC(19,16769,1,5,0)="fields.  "
^DIC(19,16769,1,6,0)=" "
^DIC(19,16769,1,7,0)="The report edit option allows your site to specify which clinics in file"
^DIC(19,16769,1,8,0)="44 represent ""Emergency Room"" clinics, and what Lab tests from file 60"
^DIC(19,16769,1,9,0)="should be used for looking up patient data for Glucose, Cholesterol, LDL"
^DIC(19,16769,1,10,0)="Cholesterol and HBA1C lab results.  These fields are used by the following"
^DIC(19,16769,1,11,0)="reports:  Caseload Profile by Clinic, and Patient Activity by Clinic."
^DIC(19,16769,1,12,0)="Cloned from ""PX HS/RPT PARAMETER MENU"" option."
^DIC(19,16769,3)=""
^DIC(19,16769,10,0)="^19.01IP^2^2"
^DIC(19,16769,10,1,0)="16770^RPT^10"
^DIC(19,16769,10,2,0)="16771^PRNT^1"
^DIC(19,16769,10,"B",16770,1)=""
^DIC(19,16769,10,"B",16771,2)=""
