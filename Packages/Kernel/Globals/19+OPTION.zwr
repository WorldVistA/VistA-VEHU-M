^DIC(19,12112,"U")="IFC MANAGEMENT MENU"
^DIC(19,12113,0)="GMRC IFC PRINT RPT NUMBERED^Print IFC Requests^^R^11740^^^^^^^294"
^DIC(19,12113,1,0)="^^3^3^3020116^"
^DIC(19,12113,1,1,0)="Sends the Inter-facility Consult Requests report to a device without going"
^DIC(19,12113,1,2,0)="through the List Manager display of the report and waiting for the list to"
^DIC(19,12113,1,3,0)="be built."
^DIC(19,12113,25)="PRNTONLY^GMRCIR(120)"
^DIC(19,12113,"U")="PRINT IFC REQUESTS"
^DIC(19,12114,0)="GMRC IFC RPT CONSULTS BY PT^IFC Requests By Patient^^R^11740^^^^^^^294^^1^1"
^DIC(19,12114,1,0)="^^5^5^3020118^"
^DIC(19,12114,1,1,0)="This option provides actions which a service may use to track "
^DIC(19,12114,1,2,0)="inter-facility consults and requests.  "
^DIC(19,12114,1,3,0)="   "
^DIC(19,12114,1,4,0)="The processing flow is similiar to the OE/RR review screen.  Most of the"
^DIC(19,12114,1,5,0)="actions have the same mnemonics as OE/RR for clinician familiarity."
^DIC(19,12114,15)="K GMRCIS D ^GMRCREXT"
^DIC(19,12114,20)="S GMRCIS="""""
^DIC(19,12114,25)="EN^GMRCSLM"
^DIC(19,12114,"U")="IFC REQUESTS BY PATIENT"
^DIC(19,12115,0)="GMRC IFC RPT CONSULTS BY REMPR^IFC Requests by Remote Ordering Provider^^R^11740^^^^^^^294^^1^1"
^DIC(19,12115,1,0)="^^2^2^3020201^"
^DIC(19,12115,1,1,0)="This option provides detailed information regarding inter-facility"
^DIC(19,12115,1,2,0)="consults by remote ordering provider for consulting sites to utilize."
^DIC(19,12115,15)="K GMRCREMP,GMRCRF"
^DIC(19,12115,20)="S (GMRCREMP,GMRCRF)="""""
^DIC(19,12115,25)="EN^GMRCIR"
^DIC(19,12115,"U")="IFC REQUESTS BY REMOTE ORDERIN"
^DIC(19,12116,0)="GMRC IFC BACKGROUND STARTUP^IFC Background Startup^^R^11740^^^^^^^294"
^DIC(19,12116,1,0)="^^4^4^3020308^"
^DIC(19,12116,1,1,0)="This menu option is not designed for user interaction.  It is defined to"
^DIC(19,12116,1,2,0)="be called upon system startup and when taskman unexpectedly stops. This"
^DIC(19,12116,1,3,0)="option starts the background error processor for Inter-facility Consults"
^DIC(19,12116,1,4,0)="(IFC)."
^DIC(19,12116,25)="EN^GMRCIBKG"
^DIC(19,12116,"U")="IFC BACKGROUND STARTUP"
^DIC(19,12117,0)="GMRC IFC BKG PARAM MON^Monitor IFC background job parameters^^R^11740^^^^^^^294"
^DIC(19,12117,1,0)="^^6^6^3020214^"
^DIC(19,12117,1,1,0)="This option allows the viewing of the two parameters involved in the"
^DIC(19,12117,1,2,0)="scheduling and running of the IFC background job. The parameters and their"
^DIC(19,12117,1,3,0)="current setting is listed along with any information the system can tell "
^DIC(19,12117,1,4,0)="from the settings.  From this display the start parameter may be edited "
^DIC(19,12117,1,5,0)="to a date/time in the future which will have the effect of delaying the "
^DIC(19,12117,1,6,0)="next run of the background job until the time defined in this parameter."
^DIC(19,12117,25)="EN^GMRCIBKM"
^DIC(19,12117,"U")="MONITOR IFC BACKGROUND JOB PAR"
^DIC(19,12118,0)="GMRC IFC TEST PT MPI^Configure test account patients for IFC^^R^11740^^^^^^^294"
^DIC(19,12118,1,0)="^^8^8^3020402^"
^DIC(19,12118,1,1,0)="WARNING: This option is for use in test accounts ONLY!"
^DIC(19,12118,1,2,0)="This option will not function in a production VistA environment."
^DIC(19,12118,1,3,0)=" "
^DIC(19,12118,1,4,0)="This option will use the social security number of the patient and create "
^DIC(19,12118,1,5,0)="a pseudo-ICN for the patient selected. If the patient name and social "
^DIC(19,12118,1,6,0)="security number are the same at the local facility and the IFC partnering"
^DIC(19,12118,1,7,0)="facility, the selected patient can be used for IFC testing after this"
^DIC(19,12118,1,8,0)="option is executed on both systems."
^DIC(19,12118,25)="EN^GMRCITPI"
^DIC(19,12118,"U")="CONFIGURE TEST ACCOUNT PATIENT"
^DIC(19,12119,0)="MAG_IC_RPT_GM^Global Move Inconsistency Report^^R^10000000020^^^^^^^530"
