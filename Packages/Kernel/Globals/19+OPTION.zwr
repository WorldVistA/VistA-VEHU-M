^DIC(19,6752,1,2,0)="information for any Controlled Substances drug being destroyed."
^DIC(19,6752,25)="PSDEST"
^DIC(19,6752,"U")="DESTROY A CONTROLLED SUBSTANCE"
^DIC(19,6753,0)="PSD EDIT/CANC VER ORD RPT^Edited Verified Orders Report^^R^11595^^^^^^^276"
