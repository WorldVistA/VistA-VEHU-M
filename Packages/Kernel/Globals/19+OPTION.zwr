^DIC(19,13720,0)="XUTM SNAPSHOT^Taskman snapshot^^R^10000000020^^^^^^^163^y"
^DIC(19,13720,1,0)="^^9^9^3081104^"
^DIC(19,13720,1,1,0)="Schedule this option (XUTM SNAPSHOT) to grab a snapshot of Taskman work"
^DIC(19,13720,1,2,0)="counts and save them in the TASKMAN SNAPSHOT file (#14.72). When the Task"
^DIC(19,13720,1,3,0)="is scheduled it takes an entry in the TASK PARAMETERS field."
^DIC(19,13720,1,4,0)="This is how many MINUTES to sample for, "","" and how many SECONDS to wait"
^DIC(19,13720,1,5,0)="between samples."
^DIC(19,13720,1,6,0)="It has a limit of 480 minutes (8 hours) and a minimum of 2 seconds to"
^DIC(19,13720,1,7,0)="wait. At these limits it would record 14400 samples.  It will default to"
^DIC(19,13720,1,8,0)="60 minutes with a sample every 60 seconds if the TASK PARAMETERS field is"
^DIC(19,13720,1,9,0)="not filled in."
^DIC(19,13720,25)="SNAP^XUTMHR"
^DIC(19,13720,200.9)="y"
^DIC(19,13720,"U")="TASKMAN SNAPSHOT"
^DIC(19,13721,0)="MD PROCESS NOSHOW/CANCEL^Process No Show/Cancel Studies^^R^1^^^^^^^557"
^DIC(19,13721,1,0)="^19.06^3^3^3080724^^^"
^DIC(19,13721,1,1,0)="This option is tasked to run daily.  It will check for any appointment"
^DIC(19,13721,1,2,0)="that is No Show or Cancelled for CP studies in the ""Pending Instrument"
^DIC(19,13721,1,3,0)="Data"" status."
^DIC(19,13721,25)="EN1^MDWCAN"
^DIC(19,13721,"U")="PROCESS NO SHOW/CANCEL STUDIES"
^DIC(19,13722,0)="PSA RET DRG BATCH WORKLIST^Batch Work List^^R^1^^^^^^^287^^"
^DIC(19,13722,1,0)="^19.06^2^2^3080729^^^^"
^DIC(19,13722,1,1,0)="This option will be used to process open batches, which are assigned a"
^DIC(19,13722,1,2,0)="status of 'AWAITING PICKUP' and 'PICKEP-UP'."
