^DIC(19,15290,1,2,0)="triggering an Unverified Order notification/alert.  The maximum number of"
^DIC(19,15290,1,3,0)="hours is 10,000."
^DIC(19,15290,1,4,0)="Cloned from ""ORB3 UNVERIFIED ORDER"" option."
^DIC(19,15290,3)=""
^DIC(19,15290,25)="UNVER^ORB3MGR1"
^DIC(19,15290,"U")="SET DELAY FOR ALL UNVERIFIED O"
