^DIC(19,16102,1,0)="^19.06^5^5^3240328^^^"
^DIC(19,16102,1,1,0)="Use this option to add or delete an entity (System, Division, User,"
^DIC(19,16102,1,2,0)="etc) from the list of allowable entites for the parameter 'ORWRP "
^DIC(19,16102,1,3,0)="HEALTH SUMMARY TYPE LIST' used on the CPRS Reports Tab to display"
^DIC(19,16102,1,4,0)="the Health Summary Types List."
^DIC(19,16102,1,5,0)="Cloned from ""GMTS GUI SITE PRECEDENCE"" option."
