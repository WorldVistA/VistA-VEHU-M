^DIC(19,7958,1,0)="^^5^5^2930406^^"
^DIC(19,7958,1,1,0)="This option allows Payroll to display or list the Prior Pay Period"
^DIC(19,7958,1,2,0)="Corrections that have been approved by the supervisor. If performed"
^DIC(19,7958,1,3,0)="on a CRT, the Payroll Clerk can indicate that the entry has been"
^DIC(19,7958,1,4,0)="cleared and that appropriate corrective OLDE actions have been"
^DIC(19,7958,1,5,0)="taken."
^DIC(19,7958,25)="PRSAPPP"
^DIC(19,7958,"U")="LIST/CLEAR PRIOR PAY PERIOD CO"
^DIC(19,7959,0)="PRSA SUP UNR^List Un-Certified Employees^^R^.5^^^^^^^"
^DIC(19,7959,1,0)="^^4^4^2930505^^^^"
^DIC(19,7959,1,1,0)="This option will list all employees of a selected T&L Unit"
^DIC(19,7959,1,2,0)="which have not been certified (released to Payroll). For Day"
^DIC(19,7959,1,3,0)="numbers less than 6, it will default to the last Pay Period."
^DIC(19,7959,1,4,0)="Otherwise, it is the current Pay Period."
^DIC(19,7959,25)="SUP^PRSASU"
^DIC(19,7959,"U")="LIST UN-CERTIFIED EMPLOYEES"
