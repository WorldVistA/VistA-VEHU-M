^DIC(19,516,0)="DG PTF TRIM REPORT^Trim Point DRG Report^^A^.5^^^^^^^114^^1"
^DIC(19,516,1,0)="^^5^5^2890404^^"
^DIC(19,516,1,1,0)="This option generates the Trim Point DRG Reports which sort and list"
^DIC(19,516,1,2,0)="patient service transfers and discharges by their appropriate TRANSFER"
^DIC(19,516,1,3,0)="DRG or DISCHARGE DRG.  Trim Point DRG Reports can also be run from the"
^DIC(19,516,1,4,0)="'Batch Multiple DRG Reports' option if other DRG reports for the same"
