^DIC(19,14705,0)="TIUFPC CREATE POST-SIGNATURE^Create Post-Signature Alerts^^R^11720^^^^^^^516"
^DIC(19,14705,1,0)="^^4^4^3171106^"
^DIC(19,14705,1,1,0)="This option allows a user to set the POST-SIGNATURE CODE field of a title"
^DIC(19,14705,1,2,0)="in the TIU DOCUMENT DEFINITION file with MUMPS code. At the completion of"
^DIC(19,14705,1,3,0)="a progress note using the selected title, different alerts will be "
^DIC(19,14705,1,4,0)="generated to designated user(s)."
^DIC(19,14705,25)="EN^TIUPSCS"
^DIC(19,14705,"U")="CREATE POST-SIGNATURE ALERTS"
^DIC(19,14706,0)="TIU DOWNTIME BOOKMARK PN^Contingency Downtime Bookmark Progress Notes^^R^11720^^^^^^^516"
^DIC(19,14706,1,0)="^^5^5^3170706^"
^DIC(19,14706,1,1,0)="This utility is used to add a bookmark to the progress note of each"
^DIC(19,14706,1,2,0)="inpatient's electronic record after a VistA downtime."
^DIC(19,14706,1,3,0)=" "
^DIC(19,14706,1,4,0)="The user is asked a few questions and then the utility places the note in "
^DIC(19,14706,1,5,0)="each affected patient's record."
^DIC(19,14706,25)="START^TIUDTBPN"
^DIC(19,14706,"U")="CONTINGENCY DOWNTIME BOOKMARK "
^DIC(19,14707,0)="MD DICOM^CP - DICOM Interoperability^^E^11720^^^^^^^557"
^DIC(19,14707,1,0)="^^17^17^3180530^"
^DIC(19,14707,1,1,0)="This option improves interoperability between Clinical Procedures and"
^DIC(19,14707,1,2,0)="VistA Imaging CPRS Consult Request Tracking DICOM. There are three"
^DIC(19,14707,1,3,0)="capabilities: "
^DIC(19,14707,1,4,0)=" "
^DIC(19,14707,1,5,0)="First, the VistA Imaging consult accession number sss-GMR-nnnnnnnn can be"
^DIC(19,14707,1,6,0)="used for the Clinical Procedures Instrument Order Number.    "
^DIC(19,14707,1,7,0)=" "
^DIC(19,14707,1,8,0)="Second, the timing of the DICOM Modality Worklist creation is changed from"
^DIC(19,14707,1,9,0)="order release to check-in, making it much more useful.   "
^DIC(19,14707,1,10,0)=" "
^DIC(19,14707,1,11,0)="Third, the VistA Imaging HL7 message body can be used instead of the CP"
^DIC(19,14707,1,12,0)="HL7 message body. (The VistA Imaging HL7 has much more information than"
^DIC(19,14707,1,13,0)="the CP HL7.) "
^DIC(19,14707,1,14,0)=" "
^DIC(19,14707,1,15,0)="Note: This is for bidirectional CP instruments only. Also, the CP must"
^DIC(19,14707,1,16,0)="have an entry in the CLINICAL SPECIALTY DICOM & HL7 file (#2006.5831) to"
^DIC(19,14707,1,17,0)="have DICOM Modality Worklist and HL7."
^DIC(19,14707,30)="MDS(702.09,"
^DIC(19,14707,31)="AEQM"
^DIC(19,14707,50)="MDS(702.09,"
^DIC(19,14707,51)=.19
^DIC(19,14707,"U")="CP - DICOM INTEROPERABILITY"
^DIC(19,14708,0)="MD CARTCL^Keep Consult Open for CART-CL^^E^11720^^^^^^^557"
^DIC(19,14708,1,0)="^^20^20^3180530^"
^DIC(19,14708,1,1,0)="This Clinical Procedures Uni-directional Configuration flag 'CONSULT KEEP "
^DIC(19,14708,1,2,0)="OPEN' provides the following functionality:"
^DIC(19,14708,1,3,0)=" "
^DIC(19,14708,1,4,0)="The CP procedure is automatically placed in Completed status"
^DIC(19,14708,1,5,0)="after the HL7 message is sent, thus preventing an ""inbound"" HL7 message"
^DIC(19,14708,1,6,0)="containing the test results from being sent back to the CPRS Consult"
^DIC(19,14708,1,7,0)="Note."
^DIC(19,14708,1,8,0)=" "
^DIC(19,14708,1,9,0)="The physician can then edit the Consult Note by manually pasting in data"
^DIC(19,14708,1,10,0)="from a test result reporting system to complete the Consult."
^DIC(19,14708,1,11,0)=" "
^DIC(19,14708,1,12,0)="This modification is beneficial for users of reporting systems-such as"
^DIC(19,14708,1,13,0)="the Clinical Assessment, Reporting, and Tracking System for Cardiac"
^DIC(19,14708,1,14,0)="Catheterization Laboratories (CART-CL) application-who do not want the"
^DIC(19,14708,1,15,0)="test results from the medical instrument to populate the CPRS Consult"
^DIC(19,14708,1,16,0)="Note, but prefer to manually paste the test results from the reporting"
^DIC(19,14708,1,17,0)="system into the Consult Note."
^DIC(19,14708,1,18,0)=" "
^DIC(19,14708,1,19,0)="The 'CONSULT KEEP OPEN' flag must be set to Yes for this functionality "
^DIC(19,14708,1,20,0)="to work."
^DIC(19,14708,30)="MDS(702.09,"
^DIC(19,14708,31)="AEQM"
^DIC(19,14708,50)="MDS(702.09,"
^DIC(19,14708,51)=.401
^DIC(19,14708,"U")="KEEP CONSULT OPEN FOR CART-CL"
