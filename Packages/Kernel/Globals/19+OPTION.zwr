^DIC(19,15880,0)="EHM-00701^ePCS Data Validation Reports^^R^1^^^^^^^170^^^^"
^DIC(19,15880,1,0)="^^3^3^3240328^"
^DIC(19,15880,1,1,0)="Allows the user to run a number of reports that will be used to validate "
^DIC(19,15880,1,2,0)="data necessary to ensure proper setup of the ePCS functionality."
^DIC(19,15880,1,3,0)="Cloned from ""OR EPCS VALIDATION REPORTS"" option."
