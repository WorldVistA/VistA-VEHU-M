^DIC(19,2327,0)="PSGW TRANSFER ENTRIES^Transfer AOU Stock Entries^^R^.5^PSGW TRAN^^^^^^"
^DIC(19,2327,1,0)="^^8^8^2871210^^^"
^DIC(19,2327,1,1,0)="This option will ""copy"" the active stock entries from a selected"
^DIC(19,2327,1,2,0)="Area of Use into one or more selected Areas.  As many as 10 Areas"
^DIC(19,2327,1,3,0)="may be chosen for transfer at one time.  You may transfer either"
^DIC(19,2327,1,4,0)="the drug name only, or the drug name, stock level, and location"
^DIC(19,2327,1,5,0)="code.  The ""copy"" process will not copy inactive drugs or duplicate "
^DIC(19,2327,1,6,0)="entries.  The actual transfer takes place in a background job which"
^DIC(19,2327,1,7,0)="is automatically queued.  When the transfer is complete, you will"
^DIC(19,2327,1,8,0)="be notified by a MailMan message."
^DIC(19,2327,25)="PSGWTR"
^DIC(19,2327,"U")="TRANSFER AOU STOCK ENTRIES"
