^DIC(19,3885,1,0)="^^3^3^2880716^^"
^DIC(19,3885,1,1,0)="This option will list a specific menu cycle, showing for each"
^DIC(19,3885,1,2,0)="day of the cycle what meal will be served for breakfast, noon"
^DIC(19,3885,1,3,0)="and evening."
^DIC(19,3885,25)="FHPRC5"
