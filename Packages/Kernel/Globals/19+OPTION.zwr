^DIC(19,8849,1,0)="^^5^5^2930922^"
^DIC(19,8849,1,1,0)="This option is a switch that will allow or disallow the non-managers to "
^DIC(19,8849,1,2,0)="view superseded records from the print options. By switching this option"
^DIC(19,8849,1,3,0)="to on, superseded records can be viewed from the print option.  By"
^DIC(19,8849,1,4,0)="switching this option to off, superseded records will be removed from"
