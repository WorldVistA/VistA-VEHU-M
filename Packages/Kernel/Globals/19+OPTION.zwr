^DIC(19,17030,0)="EHM-01851^Change my Division^^R^1^^^^^^^^y^^^"
^DIC(19,17030,1,0)="^^8^8^3240328^"
^DIC(19,17030,1,1,0)="The Kernel option ""Change my Division"" allows you to change the"
^DIC(19,17030,1,2,0)="division to which you are currently assigned. This option performs"
^DIC(19,17030,1,3,0)="the same function as entering your current division at the signon"
^DIC(19,17030,1,4,0)="prompt ""Select DIVISION: default division //""."
^DIC(19,17030,1,5,0)=" "
^DIC(19,17030,1,6,0)="If you only have one division to select from, XUSER DIV CHG will show you"
^DIC(19,17030,1,7,0)="your current division and indicate that you cannot change it."
^DIC(19,17030,1,8,0)="Cloned from ""XUSER DIV CHG"" option."
^DIC(19,17030,3)=""
^DIC(19,17030,25)="DIVCHG^XUSER1"
^DIC(19,17030,"U")="CHANGE MY DIVISION"
^DIC(19,17031,0)="XUS IAM NPFM BATCH UPDATE^MPI NEW PERSON FIELD MONITOR BATCH UPDATE^^R^1^^^^^^^163"
^DIC(19,17031,1,0)="^19.06^7^7^3210303^^^^"
^DIC(19,17031,1,1,0)="This option is scheduled through Taskman and will monitor the New Person"
^DIC(19,17031,1,2,0)="Field Monitor (#8933.1) file for changes to certain New Person (#200) "
^DIC(19,17031,1,3,0)="fields.  The process will build SPML messages which will be transmitted "
^DIC(19,17031,1,4,0)="to PSIM.  This option is not intended to be run interactively from "
^DIC(19,17031,1,5,0)="programmer mode and no output is generated."
^DIC(19,17031,1,6,0)=" "
^DIC(19,17031,1,7,0)="This process should be scheduled to run about every 10 minutes."
^DIC(19,17031,25)="EN1^XUIAMNPB"
^DIC(19,17031,200.9)="y"
^DIC(19,17031,"U")="MPI NEW PERSON FIELD MONITOR B"
^DIC(19,17032,0)="XUS IAM NPFM PURGE^MPI NEW PERSON FIELD MONITOR PURGE^^R^1^^^^^^^163"
^DIC(19,17032,1,0)="^^8^8^3200624^"
^DIC(19,17032,1,1,0)="This option is scheduled through Taskman and will delete all entries from "
^DIC(19,17032,1,2,0)="the NEW PERSON FIELD MONITOR (#8933.1) file that are older than number of "
^DIC(19,17032,1,3,0)="days specified in the NEW PERSON FIELD MONITOR PURGE (#875) field of the "
^DIC(19,17032,1,4,0)="KERNEL SYSTEM PARAMETERS (#8989.3) file to retain AND if the REQUIRES"
^DIC(19,17032,1,5,0)="TRANSMISSION (#.03) of the NEW PERSON FIELD MONITOR (#8933.1) file does"
^DIC(19,17032,1,6,0)="not equal YES. The number of days will default to 365 if NOT defined."
^DIC(19,17032,1,7,0)=" "
^DIC(19,17032,1,8,0)="This process should be scheduled to run nightly."
^DIC(19,17032,25)="EN2^XUIAMNPB"
^DIC(19,17032,200.9)="y"
^DIC(19,17032,"U")="MPI NEW PERSON FIELD MONITOR P"
^DIC(19,17033,0)="XUS IAM USER TERMINATE^XUS IAM USER TERMINATE^^A^1^^^^^^^163^^1"
^DIC(19,17033,1,0)="^^3^3^3240307^"
^DIC(19,17033,1,1,0)="This option is for attaching to the XU USER TERMINATE option so that when"
^DIC(19,17033,1,2,0)="a user is terminated initially as a future Termination date, to trigger "
^DIC(19,17033,1,3,0)="the termination date to IAM so that it is expired there too."
^DIC(19,17033,20)="D FTOP^XUIAMDD1"
^DIC(19,17033,"U")="XUS IAM USER TERMINATE"
^DIC(19,17034,0)="XUSERTEM^Template User Add^^R^1^^^^^^^163^n"
^DIC(19,17034,1,0)="^^2^2^3240123^"
^DIC(19,17034,1,1,0)="This option is to be used to create template users that are utilized to "
^DIC(19,17034,1,2,0)="create other users in the Grant Access by Profile option."
^DIC(19,17034,25)="XUSERNEW"
^DIC(19,17034,30)=""
^DIC(19,17034,31)=""
^DIC(19,17034,50)=""
^DIC(19,17034,51)=""
^DIC(19,17034,"U")="TEMPLATE USER ADD"
^DIC(19,17035,0)="XUSERBLK TEMPLATE^Template Grant Access by Profile^^R^1^XUMGR^^^^^^163"
^DIC(19,17035,1,0)="^^6^6^3250311^"
^DIC(19,17035,1,1,0)="This option creates or edits a template user based on an existing user"
^DIC(19,17035,1,2,0)="profile. The new template user can then be used as a template profile for"
^DIC(19,17035,1,3,0)="adding or editing users via the Grant Access by Profile [XUSERBLK] option."
^DIC(19,17035,1,4,0)=" "
^DIC(19,17035,1,5,0)="This option is locked with the XUMGR key and is restricted for use by "
^DIC(19,17035,1,6,0)="systems management staff."
^DIC(19,17035,25)="XUSERBLK"
^DIC(19,17035,"U")="TEMPLATE GRANT ACCESS BY PROFI"
^DIC(19,17036,0)="XUXTAD SERVICE/SECTION EDIT^Service/Section Edit^^R^1^^^^^^^163^y"
^DIC(19,17036,1,0)="^19.06^10^10^3241009^^^"
^DIC(19,17036,1,1,0)=" This option was created for the R2 ADPAC CORE MENU and allows the ADPAC "
^DIC(19,17036,1,2,0)=" to edit the CHIEF (OR SUPERVISOR) of the SERVICE/SECTION file (#49) "
^DIC(19,17036,1,3,0)=" entry.  This CHIEF field value is utilized by the Kernel Alert software "
^DIC(19,17036,1,4,0)=" in conjunction with the CPRS PARAMETER DEFINITION 'ORB FORWARD "
^DIC(19,17036,1,5,0)=" SUPERVISOR'."
^DIC(19,17036,1,6,0)=" "
^DIC(19,17036,1,7,0)=" When the user has not processed their clinical alert by the "
^DIC(19,17036,1,8,0)=" instance value of the 'ORB FORWARD SUPERVISOR' parameter, the CHIEF "
^DIC(19,17036,1,9,0)=" (OR SUPERVISOR) documented in the associated SERVICE/SECTION entry "
^DIC(19,17036,1,10,0)=" will receive a notification."
^DIC(19,17036,10.1)="SSE"
^DIC(19,17036,25)="ENTER^XUXTADSSE"
^DIC(19,17036,52)=" "
^DIC(19,17036,"U")="SERVICE/SECTION EDIT"
^DIC(19,17037,0)="PSO DEA/DOJ NIGHTLY DATA UPD^DEA Number Nightly Update with DEA/DOJ Data^^A^1^^^^^^^^^1"
^DIC(19,17037,1,0)="^^4^4^3250209^"
^DIC(19,17037,1,1,0)="This option is used for updating the DEA NUMBER file (#8991.9) file with the"
^DIC(19,17037,1,2,0)="most current information from DEA/DOJ Database. It should be scheduled to run"
^DIC(19,17037,1,3,0)="nightly and it will update DEA Number entries that are 30 days or less from"
^DIC(19,17037,1,4,0)="expiring."
^DIC(19,17037,20)="D DEAUPD^PSODEAUJ"
^DIC(19,17037,200.9)="y"
^DIC(19,17037,"U")="DEA NUMBER NIGHTLY UPDATE WITH"
^DIC(19,17038,0)="PSO ERX BATCH CH REQ/DRUG SWAP^Batch eRx Change Request/VistA Drug Replacement^^A^1^^^^^^^^^1"
^DIC(19,17038,1,0)="^^8^8^3250329^"
^DIC(19,17038,1,1,0)="This option allow users to perform two batch actions:"
^DIC(19,17038,1,2,0)=" "
^DIC(19,17038,1,3,0)="1. Submit the same eRx Change Request to the external prescribers for multiple"
^DIC(19,17038,1,4,0)="   VistA Rx's issued within a date range"
^DIC(19,17038,1,5,0)=" "
^DIC(19,17038,1,6,0)="2. *** Available to Meds-by-Mail only ***"""
^DIC(19,17038,1,7,0)="   Replace the VistA dispense drug for multiple VistA Rx's issued within a"
^DIC(19,17038,1,8,0)="   date range"
^DIC(19,17038,20)="D EN^PSOERBT"
^DIC(19,17038,"U")="BATCH ERX CHANGE REQUEST/VISTA"
^DIC(19,17039,0)="PSS CHECK PGX INTERACTION^Check Pharmacogenomic Interaction^^R^1^^^^^^^517"
^DIC(19,17039,1,0)="^^2^2^3241011^"
^DIC(19,17039,1,1,0)="The PSS CHECK PGX INTERACTION will allow a user to check interactions "
^DIC(19,17039,1,2,0)="between pharmacogenomic genes and drugs."
^DIC(19,17039,25)="EN^PSSPGXTS"
^DIC(19,17039,"U")="CHECK PHARMACOGENOMIC INTERACT"
^DIC(19,17040,0)="RCDPE MANUAL AUD REP^Manual Audit Report for Bills^^R^1^^^^^^^261"
^DIC(19,17040,1,0)="^^3^3^3250128^"
^DIC(19,17040,1,1,0)="The Manual Audit Report for Bills [RCDPE MANUAL AUD REP] may be run from "
^DIC(19,17040,1,2,0)="the menu, so that an end user can obtain a list of claims that were "
^DIC(19,17040,1,3,0)="manually audited within a given date range."
