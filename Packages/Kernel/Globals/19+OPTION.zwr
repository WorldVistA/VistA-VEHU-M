^DIC(19,13903,"U")="FEE BASIS PAYMENTS"
^DIC(19,13904,0)="PSO RECALL LIST^List of Patients/Prescriptions for Recall Notice ^^R^10000000216^^^^^^^"
^DIC(19,13904,1,0)="^^9^9^3100208^"
^DIC(19,13904,1,1,0)="This report identifies medications dispensed and associated with specific "
^DIC(19,13904,1,2,0)="recall criteria, such as particular lot numbers and/or NDC numbers. "
^DIC(19,13904,1,3,0)=" "
^DIC(19,13904,1,4,0)="The report prompts for Division, a range of Release Dates, Exclude/Include"
^DIC(19,13904,1,5,0)="Deceased Patients and a drug identifier. Drug identifiers may be NDC,"
^DIC(19,13904,1,6,0)="Dispense Drug with or without a Lot number, Orderable Item, or Drug Name."
^DIC(19,13904,1,7,0)="The report output is in a delimited output format suitable for export"
^DIC(19,13904,1,8,0)="to a spreadsheet and is sorted primarily by patient name and secondarily"
^DIC(19,13904,1,9,0)="by prescription number. Report output will be delimited by a caret (^)."
^DIC(19,13904,25)="START^PSORLST"
^DIC(19,13904,"U")="LIST OF PATIENTS/PRESCRIPTIONS"
^DIC(19,13905,0)="PSO RX LIST^Prescription List for Drug Warnings^^P^10000000216^^^^^^^141^^1^1"
^DIC(19,13905,1,0)="^19.06^9^9^3100217^^^"
^DIC(19,13905,1,1,0)="This report provides the ability to identify all patients who have "
^DIC(19,13905,1,2,0)="been dispensed a particular medication(s). "
^DIC(19,13905,1,3,0)="             "
^DIC(19,13905,1,4,0)="Prescription List for Drug Warnings [PSO RX LIST] option uses a sort"
^DIC(19,13905,1,5,0)="template PSO DRUG WARNINGS to prompt for user input. Users are prompted"
^DIC(19,13905,1,6,0)="for inclusion or exclusion of deceased Patients, Divisions and a range of"
^DIC(19,13905,1,7,0)="Finish Dates. Print templates PSO DRUG WARNINGS and PSO DRUG WARNINGS"
^DIC(19,13905,1,8,0)="HEADER produce a report in a delimited output format suitable for import"
^DIC(19,13905,1,9,0)="to a spreadsheet. Report output will be delimited by a caret (^)."
^DIC(19,13905,15)="K PSOSHOW,PSOEXC"
^DIC(19,13905,20)="S PSODWFL=1 D MARGIN^PSORLST K DIR S DIR(""A"")=""EXCLUDE DECEASED PATIENTS (Y/N) "",DIR(0)=""SA^Y:YES;N:NO"",DIR(""B"")=""Y"" D ^DIR Q:$D(DUOUT)!$D(DIRUT)  S PSOEXC=$S(Y=""Y"":1,1:0)"
^DIC(19,13905,25)=""
^DIC(19,13905,32)=""
^DIC(19,13905,60)="PSRX("
^DIC(19,13905,62)=0
^DIC(19,13905,63)="[PSO DRUG WARNINGS]"
^DIC(19,13905,64)="[PSO DRUG WARNINGS]"
^DIC(19,13905,65)=""
^DIC(19,13905,66)=""
^DIC(19,13905,67)=""
^DIC(19,13905,69)="S PSOSHOW=$S('$G(PSOEXC):1,$G(PSOEXC)&$G(^DPT(+$P(^PSRX(D0,0),U,2),.35)):0,1:1) S PSODED=$$PSODED^PSORLST(D0) I PSOSHOW"
^DIC(19,13905,70)=""
^DIC(19,13905,72)="D EXCMSG^PSORLST"
^DIC(19,13905,73)=""
^DIC(19,13905,"U")="PRESCRIPTION LIST FOR DRUG WAR"
^DIC(19,13906,0)="LA7 HDR RECOVER^Recover/Transmit Lab HDR Result Messages^^R^10000000216^^^^^^^53"
^DIC(19,13906,1,0)="^19.06^16^16^3090127^^^^"
^DIC(19,13906,1,1,0)="Option to recover from failed Lab HDR ORU Result message"
^DIC(19,13906,1,2,0)="generation and/or transmission failure. This option allows"
^DIC(19,13906,1,3,0)="the user to select those VistA Laboratory accessions that"
^DIC(19,13906,1,4,0)="need to be transmitted to the VA HDR and other subscribers"
^DIC(19,13906,1,5,0)="of the VistA Laboratory Result Available HL7 message"
^DIC(19,13906,1,6,0)="capability via the protocol Lab Results Available Event"
^DIC(19,13906,1,7,0)="[LA7 LAB RESULTS AVAILABLE (EVN)]."
^DIC(19,13906,1,8,0)=" "
^DIC(19,13906,1,9,0)="If the original message generation/transmission failed"
^DIC(19,13906,1,10,0)="due to system or communication problems then using this"
^DIC(19,13906,1,11,0)="option will allow the generation of new HL7 messages with"
^DIC(19,13906,1,12,0)="the results associated with the selected accessions."
^DIC(19,13906,1,13,0)="Accessions can be selected using the human-readable"
^DIC(19,13906,1,14,0)="accession designation (area abbreviation modified date"
^DIC(19,13906,1,15,0)="accession number - ""CH 1225 100"") or the accession's"
^DIC(19,13906,1,16,0)="associated 10 character unique identifier (UID)."
^DIC(19,13906,2)=""
^DIC(19,13906,25)="RECOVER^LA7HDR"
^DIC(19,13906,"U")="RECOVER/TRANSMIT LAB HDR RESUL"
^DIC(19,13907,0)="DSIV DOCMANAGER^DSS DocManager Imaging System^^B^1^^^^^^^"
^DIC(19,13907,1,0)="^19.06^1^1^3141112^^^^"
^DIC(19,13907,1,1,0)="This is the GUI context option for the DSS DocManager application."
^DIC(19,13907,99)="61797,34668"
^DIC(19,13907,99.1)="58290,32371"
