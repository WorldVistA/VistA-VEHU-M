^DIC(19,11521,0)="OR PARAM UNSIGNED ORDERS VIEW^Set Unsigned Orders View on Exit^^A^983^^^^^^^^^1"
^DIC(19,11521,1,0)="^^4^4^3000217^"
^DIC(19,11521,1,1,0)="This option may be used to set the default view of unsigned orders that"
^DIC(19,11521,1,2,0)="ORES key holders will see when exiting a patient's chart; possible views"
^DIC(19,11521,1,3,0)="are only those orders entered during the current session, all of the"
^DIC(19,11521,1,4,0)="current user's unsigned orders, or all unsigned orders for the patient."
^DIC(19,11521,20)="D EDITPAR^XPAREDIT(""OR UNSIGNED ORDERS ON EXIT"")"
^DIC(19,11521,"U")="SET UNSIGNED ORDERS VIEW ON EX"
^DIC(19,11522,0)="ORMTIME MAIN^ORMTIME Main Menu^^M^983^XUPROG^^^^^^"
^DIC(19,11522,1,0)="^^3^3^2991201^^^^"
^DIC(19,11522,1,1,0)=" "
^DIC(19,11522,1,2,0)="  This is the main menu for the management of ORMTIME."
^DIC(19,11522,1,3,0)=" "
^DIC(19,11522,10,0)="^19.01IP^1^1"
^DIC(19,11522,10,1,0)="11523^ST"
