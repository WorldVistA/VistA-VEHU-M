^DIC(19,16236,"U")="RECORD FLAG REPORTS MENU"
^DIC(19,16237,0)="EHM-01058^Flag Assignment Report^^R^1^^^^^^^114^^^^"
^DIC(19,16237,1,0)="^19.06^3^3^3240328^^^^"
^DIC(19,16237,1,1,0)="This option enables a user to display or print all of the patient "
^DIC(19,16237,1,2,0)="assignments for Category I and/or Category II Patient Record Flags."
^DIC(19,16237,1,3,0)="Cloned from ""DGPF FLAG ASSIGNMENT REPORT"" option."
^DIC(19,16237,3)=""
^DIC(19,16237,15)=""
^DIC(19,16237,25)="EN^DGPFRFA"
^DIC(19,16237,99)="59168,40517"
^DIC(19,16237,99.1)="61802,34437"
^DIC(19,16237,200.9)="^y"
^DIC(19,16237,"U")="FLAG ASSIGNMENT REPORT"
^DIC(19,16238,0)="EHM-01059^Assignments Due For Review Report^^R^1^^^^^^y^114^^^^"
^DIC(19,16238,1,0)="^19.06^4^4^3240328^^^^"
^DIC(19,16238,1,1,0)="This option will be used to display or print all Category I or Category II"
^DIC(19,16238,1,2,0)="Patient Record Flag Assignments that are due for review within a given "
^DIC(19,16238,1,3,0)="date range."
^DIC(19,16238,1,4,0)="Cloned from ""DGPF ASSIGNMENT DUE REVIEW RPT"" option."
^DIC(19,16238,3)=""
^DIC(19,16238,15)=""
^DIC(19,16238,25)="EN^DGPFRFR"
^DIC(19,16238,99)="59182,54062"
^DIC(19,16238,200.9)="^y"
^DIC(19,16238,"U")="ASSIGNMENTS DUE FOR REVIEW REP"
^DIC(19,16239,0)="EHM-01060^Assignment Action Not Linked Report^^R^1^^^^^^^114^^^^"
^DIC(19,16239,1,0)="^19.06^3^3^3240328^^"
^DIC(19,16239,1,1,0)="This option will be used to display or print all of the PRF Assignment"
^DIC(19,16239,1,2,0)="History actions that are not linked to a progress note."
^DIC(19,16239,1,3,0)="Cloned from ""DGPF ACTION NOT LINKED REPORT"" option."
^DIC(19,16239,3)=""
^DIC(19,16239,25)="EN^DGPFRAL"
^DIC(19,16239,200.9)="^y"
^DIC(19,16239,"U")="ASSIGNMENT ACTION NOT LINKED R"
^DIC(19,16240,0)="EHM-01061^Patient Assignments Report^^R^1^^^^^^y^114^^^^"
^DIC(19,16240,1,0)="^^3^3^3240328^"
^DIC(19,16240,1,1,0)="This option will be used to display or print all PRF Assignments "
^DIC(19,16240,1,2,0)="of a patient for Category I or Category II Record Flags."
^DIC(19,16240,1,3,0)="Cloned from ""DGPF PATIENT ASSIGNMENT REPORT"" option."
^DIC(19,16240,3)=""
^DIC(19,16240,25)="EN^DGPFRPA"
^DIC(19,16240,200.9)="^y"
^DIC(19,16240,"U")="PATIENT ASSIGNMENTS REPORT"
^DIC(19,16241,0)="EHM-01062^Assignments Approved By Report^^R^1^^^^^^y^114^^^^"
^DIC(19,16241,1,0)="^^4^4^3240328^"
^DIC(19,16241,1,1,0)="This option will be used to display or print all of the PRF Assignment"
^DIC(19,16241,1,2,0)="History actions for the person who approved the assignment of the"
^DIC(19,16241,1,3,0)="record flag to the patient."
^DIC(19,16241,1,4,0)="Cloned from ""DGPF APPROVED BY REPORT"" option."
^DIC(19,16241,3)=""
^DIC(19,16241,25)="EN^DGPFRAB"
^DIC(19,16241,200.9)="^y"
^DIC(19,16241,"U")="ASSIGNMENTS APPROVED BY REPORT"
^DIC(19,16242,0)="EHM-01063^Assignments by Principal Investigator Report^^R^1^^^^^^y^114^^^^"
^DIC(19,16242,1,0)="^^4^4^3240328^"
^DIC(19,16242,1,1,0)="This option will be used to display or print all of the PRF Assignment "
^DIC(19,16242,1,2,0)="History actions for a Principal Investigator.  Only Research Type"
^DIC(19,16242,1,3,0)="record flags will have a Principal Investigator assigned for that flag."
^DIC(19,16242,1,4,0)="Cloned from ""DGPF PRINCIPAL INVEST REPORT"" option."
^DIC(19,16242,3)=""
^DIC(19,16242,25)="EN^DGPFRPI"
^DIC(19,16242,200.9)="^y"
^DIC(19,16242,"U")="ASSIGNMENTS BY PRINCIPAL INVES"
^DIC(19,16243,0)="EHM-01064^Behavioral PRF Disruptive Behavior Data Report^^R^1^^^^^^^114^y^^^"
^DIC(19,16243,1,0)="^^7^7^3240328^"
^DIC(19,16243,1,1,0)="For national Behavioral Flags, one may associate a Disruptive Behavioral "
^DIC(19,16243,1,2,0)="Reporting System (DBRS) number.  This report will prompt for a single "
^DIC(19,16243,1,3,0)="patient.  It will then display the changes over time made to the DBRS "
^DIC(19,16243,1,4,0)="data associated with the Behavioral Flag assignment.  There is no "
^DIC(19,16243,1,5,0)="electronic link between VistA and the DBRS.  The DBRS Number entered is "
^DIC(19,16243,1,6,0)="that link."
^DIC(19,16243,1,7,0)="Cloned from ""DGPF DISRUPT BEHAVIOR REPORT"" option."
^DIC(19,16243,3)=""
^DIC(19,16243,25)="EN^DGPFRDB"
^DIC(19,16243,"U")="BEHAVIORAL PRF DISRUPTIVE BEHA"
^DIC(19,16244,0)="EHM-01065^Record Flag Management^^R^1^^^^^^^^^^^"
^DIC(19,16244,1,0)="^^6^6^3240328^"
^DIC(19,16244,1,1,0)="This option will provide users with the ability to:"
^DIC(19,16244,1,2,0)=" - Create Category II (Local) Patient Record Flags"
^DIC(19,16244,1,3,0)=" - Edit Category II (Local) Patient Record Flags"
^DIC(19,16244,1,4,0)=" - List Category I (National) and Category II (Local) Patient Record Flags"
^DIC(19,16244,1,5,0)=" - Display details of Category I and Category II Patient Record Flags"
^DIC(19,16244,1,6,0)="Cloned from ""DGPF RECORD FLAG MANAGEMENT"" option."
^DIC(19,16244,3)=""
^DIC(19,16244,25)="EN^DGPFLF"
^DIC(19,16244,"U")="RECORD FLAG MANAGEMENT"
^DIC(19,16245,0)="EHM-01066^Record Flag Enable Divisions^^R^1^^^^^^^114^^1^^"
^DIC(19,16245,1,0)="^^8^8^3240328^"
^DIC(19,16245,1,1,0)="This option allows multi-divisional facilities to enable individual "
^DIC(19,16245,1,2,0)="medical center divisions stored in the MEDICAL CENTER DIVISION (#40.8) "
^DIC(19,16245,1,3,0)="file as patient record flag assignment owners.  Once a medical center "
^DIC(19,16245,1,4,0)="division has been enabled as a patient record flag assignment owner, it"
^DIC(19,16245,1,5,0)="may also be disabled through this option.  Disabling a medical center "
^DIC(19,16245,1,6,0)="division will only be allowed if there are no active patient record flag"
^DIC(19,16245,1,7,0)="assignments associated with the division."
^DIC(19,16245,1,8,0)="Cloned from ""DGPF ENABLE DIVISIONS"" option."
^DIC(19,16245,3)=""
^DIC(19,16245,20)="I '$P($G(^DG(43,1,""GL"")),U,2) W !,""Your facility is not multi-divisional."",*7 S XQUIT=1"
^DIC(19,16245,25)="EN^DGPFDIV"
^DIC(19,16245,"U")="RECORD FLAG ENABLE DIVISIONS"
^DIC(19,16246,0)="EHM-01067^Record Flag Transmission Mgmt^^M^1^^^^^^^114^^^^"
^DIC(19,16246,1,0)="^^3^3^3240328^"
^DIC(19,16246,1,1,0)="This option acts as a submenu containing options available to manage "
^DIC(19,16246,1,2,0)="patient record flags transmissions."
^DIC(19,16246,1,3,0)="Cloned from ""DGPF TRANSMISSION MGMT"" option."
^DIC(19,16246,3)=""
^DIC(19,16246,10,0)="^19.01IP^2^2"
^DIC(19,16246,10,1,0)="16247^TE^1"
^DIC(19,16246,10,2,0)="16248^MQ^2"
^DIC(19,16246,10,"B",16247,1)=""
^DIC(19,16246,10,"B",16248,2)=""
^DIC(19,16246,10,"C","MQ",2)=""
^DIC(19,16246,10,"C","TE",1)=""
^DIC(19,16246,99)="67411,49176"
^DIC(19,16246,"U")="RECORD FLAG TRANSMISSION MGMT"
^DIC(19,16247,0)="EHM-01068^Record Flag Transmission Errors^^R^1^^^^^^^114^^1^1^"
^DIC(19,16247,1,0)="^19.06^10^10^3240328^^^^"
^DIC(19,16247,1,1,0)="This option provides a List Manager user interface that can be used to"
^DIC(19,16247,1,2,0)="review and manage Rejected Status (""RJ"") HL7 transmission messages that"
^DIC(19,16247,1,3,0)="are received from Treating Facilities of the patient when trying to share"
^DIC(19,16247,1,4,0)="Category I PRF Assignment information."
^DIC(19,16247,1,5,0)="The following actions are provided within this option."
^DIC(19,16247,1,6,0)=" - Sort List display by patient name alphabetically or date/time received"
^DIC(19,16247,1,7,0)=" - View Message details of the patient's rejected HL7 message record"
^DIC(19,16247,1,8,0)=" - Retransmit all of the patient's PRF Assignment and History records to"
^DIC(19,16247,1,9,0)="   the site that the rejection message occurred at."
^DIC(19,16247,1,10,0)="Cloned from ""DGPF TRANSMISSION ERRORS"" option."
^DIC(19,16247,3)=""
^DIC(19,16247,15)="L -^TMP(""DGPFLMT"")"
