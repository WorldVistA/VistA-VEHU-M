^DIC(19,719,0)="PSGW WARD STOCK MAINT^Supervisor's Menu^^M^.5^PSGWMGR^^^^^^"
^DIC(19,719,1,0)="^^5^5^2930603^^^^"
^DIC(19,719,1,1,0)="This option supports activities to build and maintain the files needed to"
^DIC(19,719,1,2,0)="operate Automatic Replenishment/Ward Stock.  It also contains the necessary"
^DIC(19,719,1,3,0)="options to prepare the files to collect AMIS reporting information, run"
^DIC(19,719,1,4,0)="the AMIS report, and purge the system of obsolete data."
^DIC(19,719,1,5,0)="Additionally, cost management reports are located on this menu."
^DIC(19,719,10,0)="^19.01PI^12^4"
