^DIC(19,10511,1,0)="^^4^4^2970711^^^"
^DIC(19,10511,1,1,0)="This option permits patients that are eligible for care, who are not"
^DIC(19,10511,1,2,0)="enrolled, to be enrolled.  This option is also used to cease enrollment,"
^DIC(19,10511,1,3,0)="expand an enrollment history record and update a patient's preferred"
