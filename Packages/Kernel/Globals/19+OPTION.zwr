^DIC(19,15593,1,0)="^19.06^4^4^3240328^^^^"
^DIC(19,15593,1,1,0)="You can create a patient list by selecting 1 or more providers or you can"
^DIC(19,15593,1,2,0)="add providers to a currently existing list using this option.  After you"
^DIC(19,15593,1,3,0)="have added a provider, you can delete or add patients to customize the list."
^DIC(19,15593,1,4,0)="Cloned from ""ORLP ADD PROVIDER"" option."
