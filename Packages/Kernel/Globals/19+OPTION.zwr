^DIC(19,12054,10,"B",12055,1)=""
^DIC(19,12054,10,"B",12056,2)=""
^DIC(19,12054,10,"B",12058,4)=""
^DIC(19,12054,99)="62088,37770"
^DIC(19,12054,"U")="REPORTS MENU"
^DIC(19,12055,0)="PSXR TURNAROUND TIME REPORT^Turnaround Time Report^^R^10000000020^^^^^^^528"
^DIC(19,12055,1,0)="^^5^5^2941115^^^"
^DIC(19,12055,1,1,0)="This option queues the CMOP Rx Turnaround Time report for the selected"
^DIC(19,12055,1,2,0)="date range. The report is based on the time difference between the "
^DIC(19,12055,1,3,0)="transmission date/time and the date/time the pharmacist at the CMOP marked"
^DIC(19,12055,1,4,0)="the prescription as completed/released. Information includes the average,"
^DIC(19,12055,1,5,0)="minimum, and maximum turnaround times and the total number of Rx's released."
^DIC(19,12055,25)="REMOTE^PSXTNRPT"
^DIC(19,12055,"U")="TURNAROUND TIME REPORT"
^DIC(19,12056,0)="PSXR SUSPENSE COUNT^Count of CMOP Suspended Rx's^^R^10000000020^^^^^^^"
^DIC(19,12056,1,0)="^^3^3^2950117^^^^"
^DIC(19,12056,1,1,0)="This option is used to count suspended CMOP Rx's sorted by day."
^DIC(19,12056,1,2,0)="The suspense date, the number of CMOP Rx's queued, the number transmitted, "
^DIC(19,12056,1,3,0)="the number printed locally, and the total number in suspense are listed."
^DIC(19,12056,25)="PSXSUDCN"
^DIC(19,12056,"U")="COUNT OF CMOP SUSPENDED RX'S"
^DIC(19,12057,0)="PSXR RESUBMIT^Resubmit CMOP Rx^^R^10000000020^PSXRESUB^^^^^^^^"
^DIC(19,12057,1,0)="^^2^2^2970224^^^^"
^DIC(19,12057,1,1,0)="Enables the user to resubmit an Rx for dispensing at a CMOP automated"
^DIC(19,12057,1,2,0)="facility without changing the Rx (as in edit)."
^DIC(19,12057,20)=""
^DIC(19,12057,25)="PSXRESUB"
^DIC(19,12057,99)="56784,51015"
^DIC(19,12057,"U")="RESUBMIT CMOP RX"
^DIC(19,12058,0)="PSXR ACTIVITY^Medical Center Activity Report^^R^10000000020^^^^^^^"
^DIC(19,12058,1,0)="^^3^3^2960918^"
^DIC(19,12058,1,1,0)="Totals by transmission the # of orders and Rx's transmitted to the CMOP"
^DIC(19,12058,1,2,0)="Host facility and the # of those Rxs that are Released, Not Dispensed and"
^DIC(19,12058,1,3,0)="Unreleased."
^DIC(19,12058,25)="PSXRACT"
^DIC(19,12058,"U")="MEDICAL CENTER ACTIVITY REPORT"
^DIC(19,12059,0)="IBARXM NONBILLABLE COPAY^Non-Billable Copay Report^^R^10000000020^^^^^^^192"
^DIC(19,12059,1,0)="^19.06^2^2^3010820^^"
^DIC(19,12059,1,1,0)="This report will show what medication copayments were not billable as a"
^DIC(19,12059,1,2,0)="result of the medication copayment cap for the specified month/year."
^DIC(19,12059,25)="NOBILL^IBARXMO"
^DIC(19,12059,"U")="NON-BILLABLE COPAY REPORT"
^DIC(19,12060,0)="IBARXM PATIENT CAP REPORT^Patient Pharmacy Copay Cap Report^^R^10000000020^^^^^^^192"
^DIC(19,12060,1,0)="^^3^3^3011015^"
^DIC(19,12060,1,1,0)="This option will produce a list of patients that have either met or are"
^DIC(19,12060,1,2,0)="above their cap for the date specified.  You may specify either a"
^DIC(19,12060,1,3,0)="month/year or just a year."
^DIC(19,12060,25)="CAP^IBARXMO"
^DIC(19,12060,"U")="PATIENT PHARMACY COPAY CAP REP"
^DIC(19,12061,0)="FBAA MST REPORT^MST Report^^R^10000000020^^^^^^^344"
^DIC(19,12061,1,0)="^^23^23^3010612^"
^DIC(19,12061,1,1,0)="This option generates a report of veterans that have one or more"
^DIC(19,12061,1,2,0)="outpatient authorizations with a purpose of visit equal to Military"
^DIC(19,12061,1,3,0)="Sexual Trauma Services (MST) for a user-specified date range."
^DIC(19,12061,1,4,0)=" "
^DIC(19,12061,1,5,0)="Totals are provided by gender for"
^DIC(19,12061,1,6,0)=" # Unique Patients - Count of patients that have one or more outpatient"
^DIC(19,12061,1,7,0)="                     MST authorizations that overlap at least a portion"
^DIC(19,12061,1,8,0)="                     of the reported period. For example, an authorization"
^DIC(19,12061,1,9,0)="                     with From Date of 11/1/2000 and To Date of 2/28/2001"
^DIC(19,12061,1,10,0)="                     would be included on a report for 1/1/2001 through"
^DIC(19,12061,1,11,0)="                     3/31/2001."
^DIC(19,12061,1,12,0)=" # Visits          - Count is based on finalized payments that have a date"
^DIC(19,12061,1,13,0)="                     of service within the reported period and are for a"
^DIC(19,12061,1,14,0)="                     MST authorization. Payments for the same veteran and"
^DIC(19,12061,1,15,0)="                     same date of service are counted as a single visit."
^DIC(19,12061,1,16,0)=" Total Payments    - Sum of the amount paid on the finalized payments."
^DIC(19,12061,1,17,0)=" "
^DIC(19,12061,1,18,0)="If a detailed report is requested, the specific veteran, authorization,"
^DIC(19,12061,1,19,0)="and payment data will be included in the output."
^DIC(19,12061,1,20,0)=" "
^DIC(19,12061,1,21,0)="Since payments are reported based on the date of service, the number of"
^DIC(19,12061,1,22,0)="visits and total payments for a given date range will increase over time"
^DIC(19,12061,1,23,0)="as additional payments are finalized."
^DIC(19,12061,25)="FBAAMST"
^DIC(19,12061,"U")="MST REPORT"
^DIC(19,12062,0)="PSS MEDICATION ROUTES EDIT^Medication Route File Enter/Edit^^R^10000000020^^^^^^^"
^DIC(19,12062,1,0)="^^2^2^3071017^"
^DIC(19,12062,1,1,0)="This option provides the ability to edit data for entries in the"
^DIC(19,12062,1,2,0)="MEDICATION ROUTES (#51.2) File."
^DIC(19,12062,25)="MR^PSSDFEE"
