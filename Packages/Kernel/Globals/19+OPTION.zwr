^DIC(19,9481,"U")="INVENTORY POINT MANAGEMENT"
^DIC(19,9482,0)="PRCP DIST ORDER LIST TO/FROM^List Distribution Orders To/From Inventory Points^^R^11740^^^^^^^"
^DIC(19,9482,1,0)="^^7^7^2940815^"
^DIC(19,9482,1,1,0)="The List Distribution Order To/From Inventory Points will display the"
^DIC(19,9482,1,2,0)="distribution orders which have not been posted from the primary to the"
^DIC(19,9482,1,3,0)="secondary inventory point.  This option will allow the primary to print"
^DIC(19,9482,1,4,0)="the picking tickets for all orders which have been released but have"
^DIC(19,9482,1,5,0)="not had a picking ticket previously printed.  The user has the option"
^DIC(19,9482,1,6,0)="to print the orders with or without a breakout of the items on the"
