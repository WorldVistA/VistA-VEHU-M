^DIC(19,8326,0)="ENPL-SRV1^Server Importing Project Communications^^S^.5^^^^^^^"
^DIC(19,8326,1,0)="^^3^3^2940324^^^^"
^DIC(19,8326,1,1,0)="This option imports data from Regional Construction Database MailMan"
^DIC(19,8326,1,2,0)="messages into the ENGINEERING PROJECT FILE (#6925) and creates local mail"
^DIC(19,8326,1,3,0)="messages for the EN PROJECTS mail group."
^DIC(19,8326,25)="ENPLSV"
^DIC(19,8326,220)="^R^^N^Y^E"
^DIC(19,8326,"U")="SERVER IMPORTING PROJECT COMMU"
^DIC(19,8328,0)="ENPLM20^Communication Log Display for a Project^^I^.5^^^^^^^33"
^DIC(19,8328,1,0)="^^5^5^2950524^"
^DIC(19,8328,1,1,0)="This option displays the communication log for a selected project. The"
^DIC(19,8328,1,2,0)="communication log contains information on network messages exchanged"
^DIC(19,8328,1,3,0)="between the site and the regional construction database. '5-Yr' indicates"
^DIC(19,8328,1,4,0)="Five Year Plan related messages and 'Appl' indicates project application"
^DIC(19,8328,1,5,0)="related messages."
^DIC(19,8328,30)="ENG(""PROJ"","
^DIC(19,8328,31)="AEMQ"
^DIC(19,8328,32)="Select PROJECT NUMBER:"
^DIC(19,8328,63)="""PROJECT # :"";X,.01;"""","""";S,301;C1"
^DIC(19,8328,80)="ENG(""PROJ"","
^DIC(19,8328,"U")="COMMUNICATION LOG DISPLAY FOR "
^DIC(19,8356,0)="LRZENTER^LOCAL EM OPTION^^R^10958^LRVERIFY^^^^^^26"
^DIC(19,8356,"U")="LOCAL EM OPTION"
^DIC(19,8357,0)="IVM MAIN MENU^IVM Main Menu^^M^.5^^^^^^y^312"
^DIC(19,8357,1,0)="^^8^8^2940615^^^^"
^DIC(19,8357,1,1,0)="This menu contains all options available with the IVM (Income Verification"
^DIC(19,8357,1,2,0)="Match) software.  These option are grouped in three menus: an upload"
^DIC(19,8357,1,3,0)="menu, an outputs menu, and an IRM menu.  The upload menu contains"
^DIC(19,8357,1,4,0)="options to upload demographics, SSN, and insurance information.  This"
^DIC(19,8357,1,5,0)="menu is locked with the 'IVM UPLOAD' key.  The outputs menu contains"
^DIC(19,8357,1,6,0)="various reports and inquiries.  The IRM menu contains options for"
^DIC(19,8357,1,7,0)="purging, controlling parameters, and viewing transmission statistics."
^DIC(19,8357,1,8,0)="This menu is locked with the 'IVM SYS' key."
^DIC(19,8357,10,0)="^19.01PI^5^5"
^DIC(19,8357,10,1,0)="8367^UPL^1"
^DIC(19,8357,10,2,0)="8368^OUT^2"
^DIC(19,8357,10,3,0)="8369^IRM^3"
^DIC(19,8357,10,4,0)="10677^ERR"
^DIC(19,8357,10,5,0)="11401^IVMC"
^DIC(19,8357,10,"B",8367,1)=""
^DIC(19,8357,10,"B",8368,2)=""
^DIC(19,8357,10,"B",8369,3)=""
^DIC(19,8357,10,"B",10677,4)=""
^DIC(19,8357,10,"B",11401,5)=""
^DIC(19,8357,10,"C","ERR",4)=""
^DIC(19,8357,10,"C","IRM",3)=""
^DIC(19,8357,10,"C","IVMC",5)=""
^DIC(19,8357,10,"C","OUT",2)=""
^DIC(19,8357,10,"C","UPL",1)=""
^DIC(19,8357,99)="60274,50765"
^DIC(19,8357,"U")="IVM MAIN MENU"
^DIC(19,8358,0)="IVM UPLOAD SSN^SSN Upload^^R^.5^IVM UPLOAD^^^^^^312"
^DIC(19,8358,1,0)="^^31^31^2940825^^^^"
^DIC(19,8358,1,1,0)="This option will utilize the List Manager utilities to list the SSNs"
^DIC(19,8358,1,2,0)="available for uploading to DHCP.  The IVM Center has sent the SSNs for the"
^DIC(19,8358,1,3,0)="patient and his/her spouse to SSA for review.  In some cases, they were"
^DIC(19,8358,1,4,0)="unable to match the SSN and found a likely SSN based on name, sex, and"
^DIC(19,8358,1,5,0)="date of birth."
^DIC(19,8358,1,6,0)=" "
^DIC(19,8358,1,7,0)="This list will give the name of the patient, the DHCP SSN, the suggested"
^DIC(19,8358,1,8,0)="SSN from SSA, the spouse's name, the spouse's DHCP SSN, and the suggested"
^DIC(19,8358,1,9,0)="SSN for the spouse.  If no spouse is listed, it does not necessarily mean"
^DIC(19,8358,1,10,0)="that the patient is not married, but rather there is no new suggested SSN"
^DIC(19,8358,1,11,0)="for uploading.  In cases where there are suggested SSNs in both the"
^DIC(19,8358,1,12,0)="veteran and spouse columns, you will be able to choose to upload one or"
^DIC(19,8358,1,13,0)="both of the SSNs."
^DIC(19,8358,1,14,0)=" "
^DIC(19,8358,1,15,0)="There are two options available:  The first is UP or Upload.  This will"
^DIC(19,8358,1,16,0)="allow you to put the data in the SSA SSN columns into the DHCP fields for"
^DIC(19,8358,1,17,0)="the veteran and/or spouse.  If both the veteran and the spouse columns"
^DIC(19,8358,1,18,0)="contain data in the SSA SSN column, you will be asked if you want to"
^DIC(19,8358,1,19,0)="upload the veteran SSN, the spouse SSN, or both.  Once you upload the SSNs"
^DIC(19,8358,1,20,0)="for a patient, the uploadable data will be deleted and the line will no"
^DIC(19,8358,1,21,0)="longer display on the screen."
^DIC(19,8358,1,22,0)=" "
^DIC(19,8358,1,23,0)="The second option is PU or Purge.  If you feel the SSA SSNs for a patient"
^DIC(19,8358,1,24,0)="and/or spouse are not the correct ones, you may choose this option to"
^DIC(19,8358,1,25,0)="purge the upload data from the file and remove the line from the list."
^DIC(19,8358,1,26,0)=" "
^DIC(19,8358,1,27,0)="Also available are several standard List Manager options.  To get a list"
^DIC(19,8358,1,28,0)="of the options available in these 'hidden' options, enter a '??' at the"
^DIC(19,8358,1,29,0)="action prompt.  One option of particular interest would be PRINT.  This"
^DIC(19,8358,1,30,0)="will allow you to print the entire list to a printer for review before you"
^DIC(19,8358,1,31,0)="begin uploading data."
^DIC(19,8358,25)="IVMLSU"
^DIC(19,8358,"U")="SSN UPLOAD"
^DIC(19,8359,0)="IVM UPLOAD DEM^Demographics Upload^^R^.5^IVM UPLOAD^^^^^^312"
^DIC(19,8359,1,0)="^^11^11^2940825^^^^"
^DIC(19,8359,1,1,0)="This option is used to upload demographic information which has"
^DIC(19,8359,1,2,0)="been transmitted to the facility from the IVM Center.  This information"
^DIC(19,8359,1,3,0)="was collected during the Means Test verification process by IVM"
^DIC(19,8359,1,4,0)="personnel."
^DIC(19,8359,1,5,0)=" "
^DIC(19,8359,1,6,0)="The demographic information is classified as either 'uploadable' or"
^DIC(19,8359,1,7,0)="'non-uploadable.'  Uploadable information may automatically be loaded"
^DIC(19,8359,1,8,0)="into the DHCP database upon review.  Non-uploadable information must"
^DIC(19,8359,1,9,0)="be manually entered into DHCP if the information is judged to be"
^DIC(19,8359,1,10,0)="accurate.  Either type of data may be rejected and purged from"
^DIC(19,8359,1,11,0)="the IVM database where it is temporarily stored."
^DIC(19,8359,25)="IVMLDEM"
^DIC(19,8359,99.1)="56125,25210"
^DIC(19,8359,"U")="DEMOGRAPHICS UPLOAD"
^DIC(19,8360,0)="IVM UPLOAD INS^Insurance Upload^^R^.5^IVM UPLOAD^^^^^^312"
^DIC(19,8360,1,0)="^^11^11^2940825^^^"
^DIC(19,8360,1,1,0)="This option is used to upload patient insurance information which has"
^DIC(19,8360,1,2,0)="been transmitted to the facility from the IVM Center.  This information"
^DIC(19,8360,1,3,0)="was provided to IVM from an employer while contacting the employer to"
^DIC(19,8360,1,4,0)="verify income."
^DIC(19,8360,1,5,0)=" "
^DIC(19,8360,1,6,0)="The user has the option to accept or reject this information.  Once"
^DIC(19,8360,1,7,0)="action has been taken on the data, a confirmation message, in HL7"
^DIC(19,8360,1,8,0)="format, is sent back to the IVM Center which contains the decision"
^DIC(19,8360,1,9,0)="that was made at the site level.  If the information was rejected,"
^DIC(19,8360,1,10,0)="a reason for not uploading the data (from file #301.91) is included"
^DIC(19,8360,1,11,0)="in the confirmation message."
^DIC(19,8360,25)="IVMLINS"
^DIC(19,8360,"U")="INSURANCE UPLOAD"
^DIC(19,8361,0)="IVM OUTPUT CASE INQ^IVM Case Inquiry^^R^10000000020^^^^^^^312"
^DIC(19,8361,1,0)="^^2^2^2940825^^"
^DIC(19,8361,1,1,0)="This option is used to display all information regarding an income"
^DIC(19,8361,1,2,0)="case which has been transmitted to the IVM Center for verification."
^DIC(19,8361,25)="IVMRNQ"
^DIC(19,8361,"U")="IVM CASE INQUIRY"
^DIC(19,8362,0)="IVM OUTPUT BILL TRANS^Billing Transmission Report^^R^10000000020^^^^^^^312"
^DIC(19,8362,1,0)="^^2^2^2940614^"
^DIC(19,8362,1,1,0)="This option is used to display all billing activity which has been, or"
^DIC(19,8362,1,2,0)="needs to be transmitted to the IVM Center."
^DIC(19,8362,25)="IVMRBT"
^DIC(19,8362,"U")="BILLING TRANSMISSION REPORT"
^DIC(19,8363,0)="IVM OUTPUT MT COMPARISON^Means Test Comparison Report^^R^10000000020^^^^^^^312"
^DIC(19,8363,1,0)="^^2^2^2940825^^"
^DIC(19,8363,1,1,0)="This option is used to compare Means Test Category data for"
^DIC(19,8363,1,2,0)="consecutive income years."
^DIC(19,8363,25)="IVMRMCR"
^DIC(19,8363,"U")="MEANS TEST COMPARISON REPORT"
^DIC(19,8364,0)="IVM SYS PAR ENTER/EDIT^IVM Parameter Enter/Edit^^R^.5^IVM SYS^^^^^^312"
^DIC(19,8364,1,0)="^^3^3^2980306^^^^"
^DIC(19,8364,1,1,0)="This option is used to update the paramters which control the"
^DIC(19,8364,1,2,0)="generation of mailman messages when SSN, demographic, or insurance"
^DIC(19,8364,1,3,0)="information is received from the IVM Center."
^DIC(19,8364,25)="IVMUPAR"
^DIC(19,8364,"U")="IVM PARAMETER ENTER/EDIT"
^DIC(19,8365,0)="IVM SYS TRANSMISSION REPORT^IVM Transmission Report^^R^.5^IVM SYS^^^^^^312"
^DIC(19,8365,1,0)="^^16^16^2940825^^^^"
^DIC(19,8365,1,1,0)="This report will allow the user to display a report of Income Verification"
^DIC(19,8365,1,2,0)="Match transmissions for a single date or a date range."
^DIC(19,8365,1,3,0)=" "
^DIC(19,8365,1,4,0)="If a single date is chosen, the report will include: total number of"
^DIC(19,8365,1,5,0)="transmissions, total number of retransmissions, total Category A's with"
^DIC(19,8365,1,6,0)="insurance, total Category A's without insurance, and total Category C's"
^DIC(19,8365,1,7,0)="without insurance."
^DIC(19,8365,1,8,0)=" "
^DIC(19,8365,1,9,0)="If a date range is chosen, the report will include: total number of"
^DIC(19,8365,1,10,0)="days for the date range, total number of transmissions, average number of"
^DIC(19,8365,1,11,0)="transmissions per day, average number of retransmissions per day,"
^DIC(19,8365,1,12,0)="percentage of Category A's with insurance, percentage of Category A's"
^DIC(19,8365,1,13,0)="without insurance, and percentage of Category C's without insurance."
^DIC(19,8365,1,14,0)=" "
^DIC(19,8365,1,15,0)="If no data can be found for the selected date or date range, a message"
^DIC(19,8365,1,16,0)="will be displayed notifying the user that no data was found."
^DIC(19,8365,25)="IVMRTSR"
^DIC(19,8365,"U")="IVM TRANSMISSION REPORT"
^DIC(19,8366,0)="IVM SYS PURGE TRANSMISSIONS^Purge IVM Transmissions^^R^.5^IVM SYS^^^^^^312"
^DIC(19,8366,1,0)="^^3^3^2940825^^"
^DIC(19,8366,1,1,0)="This option is used to purge entries from the IVM TRANSMISSION LOG"
^DIC(19,8366,1,2,0)="(#301.6) file.  Only those transmission entries for closed case"
^DIC(19,8366,1,3,0)="records from the previous income year may be purged."
^DIC(19,8366,25)="IVMUPUR"
^DIC(19,8366,"U")="PURGE IVM TRANSMISSIONS"
^DIC(19,8367,0)="IVM UPLOAD MENU^IVM Upload Menu^^M^.5^IVM UPLOAD^^^^^^312"
^DIC(19,8367,1,0)="^^3^3^2940825^^^^"
^DIC(19,8367,1,1,0)="This menu option contains all options which may be used to upload"
^DIC(19,8367,1,2,0)="demographic, SSN, and insurance information transmitted to the facility "
^DIC(19,8367,1,3,0)="from the IVM Center.  This menu is locked with the 'IVM UPLOAD' key."
^DIC(19,8367,10,0)="^19.01PI^4^4"
^DIC(19,8367,10,1,0)="8360^INS"
