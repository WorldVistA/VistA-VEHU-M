^DIC(19,15192,0)="EHM-00013^Alert Management^^M^1^^^^^^^^^^^"
^DIC(19,15192,1,0)="^19.06^4^4^3240328^^"
^DIC(19,15192,1,1,0)="This option provides a menu of options for managing alerts.  These options"
^DIC(19,15192,1,2,0)="include the ability to delete options based on time or a particular user,"
^DIC(19,15192,1,3,0)="to generate a new alert, etc."
^DIC(19,15192,1,4,0)="Cloned from ""XQALERT MGR"" option."
^DIC(19,15192,3)=""
^DIC(19,15192,10,0)="^19.01IP^7^7"
^DIC(19,15192,10,1,0)=15193
^DIC(19,15192,10,2,0)=15194
^DIC(19,15192,10,3,0)=15195
^DIC(19,15192,10,4,0)="15196^SURO"
^DIC(19,15192,10,5,0)=15197
^DIC(19,15192,10,6,0)=15198
^DIC(19,15192,10,7,0)=15199
