^DIC(19,15755,1,0)="^^4^4^3240328^"
^DIC(19,15755,1,1,0)="This is used to generate reports from the ALERT TRACKING FILE (#8992.1) "
^DIC(19,15755,1,2,0)="based on a date range supplied by the user.  OR and TIU alerts will be "
^DIC(19,15755,1,3,0)="returned for a given date range."
^DIC(19,15755,1,4,0)="Cloned from ""ORB3 ALERT TRACKING REPORT"" option."
