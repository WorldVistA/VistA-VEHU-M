^DIC(19,10683,0)="DDMP IMPORT^Import Data^^R^1^^^^^^^"
^DIC(19,10683,1,0)="^^2^2^2960724^^^^"
^DIC(19,10683,1,1,0)="This option gathers specification from the user for the import of data from "
^DIC(19,10683,1,2,0)="a host ascii file.  The import is done and a report generated."
