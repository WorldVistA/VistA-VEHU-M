^DIC(19,3289,"U")="BATCH MANAGEMENT"
^DIC(19,3290,0)="A3FOUT^Outgoing FSMB Entries^^R^.5^^^^^^^"
^DIC(19,3290,1,0)="^^2^2^2890414^"
^DIC(19,3290,1,1,0)="This option will print the letter to send to FSMB as well as"
^DIC(19,3290,1,2,0)="the list of applicant names for a selected batch number."
^DIC(19,3290,25)="A3FOUT"
^DIC(19,3290,"U")="OUTGOING FSMB ENTRIES"
^DIC(19,3291,0)="A3FSMBIN^Input FSMB Results/Print Station Letters^^R^.5^^^^^^^"
^DIC(19,3291,1,0)="^^7^7^2890419^"
^DIC(19,3291,1,1,0)="This option allows you to enter the FSMB results for a selected batch."
^DIC(19,3291,1,2,0)="You may choose to: (1) Mark the entire batch as 'No Disciplinary"
^DIC(19,3291,1,3,0)="Action Found', (2) Mark selected names as 'Further Review Required',"
^DIC(19,3291,1,4,0)="and all others as no disciplinary action found, or (3) Mark selected"
^DIC(19,3291,1,5,0)="names as 'Disciplinary Action Found', and all others as no disciplinary"
^DIC(19,3291,1,6,0)="action found.  The appropriate letter will then be printed for"
^DIC(19,3291,1,7,0)="each station."
^DIC(19,3291,25)="A3FSMBIN"
^DIC(19,3291,"U")="INPUT FSMB RESULTS/PRINT STATION LETTERS"
^DIC(19,3292,0)="A3FDUP^Print Duplicate Request Letter^^R^.5^^^^^^^"
^DIC(19,3292,1,0)="^^4^4^2890504^"
^DIC(19,3292,1,1,0)="During the FSMB station input process, if a station enters an applicant"
^DIC(19,3292,1,2,0)="name which has been screened within the last 30 days by FSMB, the name"
^DIC(19,3292,1,3,0)="does not have to be resubmitted.  Using this option, a 'duplicate"
^DIC(19,3292,1,4,0)="entry' letter will be printed to the submitting station."
^DIC(19,3292,25)="A3FDUP"
^DIC(19,3292,"U")="PRINT DUPLICATE REQUEST LETTER"
^DIC(19,3293,0)="A3FEDIT^Change FSMB Results/Print Station Letters^^R^.5^^^^^^^"
^DIC(19,3293,1,0)="^^5^5^2890508^^^"
^DIC(19,3293,1,1,0)="In some cases, the FSMB needed additional time to screen applicants."
^DIC(19,3293,1,2,0)="The FSMB status of these applicants was marked 'Further Review Required'."
^DIC(19,3293,1,3,0)="After the FSMB screens the names further, this option should be used to"
^DIC(19,3293,1,4,0)="change the FSMB status to either 'No Disciplinary Action Found' or"
^DIC(19,3293,1,5,0)="'Disciplinary Action Found'.  The appropriate letter is also printed."
^DIC(19,3293,25)="A3FEDIT"
^DIC(19,3293,"U")="CHANGE FSMB RESULTS/PRINT STATION LETTERS"
^DIC(19,3294,0)="A3FEMERG^Enter/Edit FSMB Entry (Emergent)^^E^.5^^^^^^^"
^DIC(19,3294,1,0)="^^2^2^2890508^"
^DIC(19,3294,1,1,0)="Using this option, you may enter or edit any FSMB entry.  The option"
^DIC(19,3294,1,2,0)="would specifically be used to enter data for an Emergent Screening."
^DIC(19,3294,30)="DIZ(131000,"
^DIC(19,3294,31)="AEMQL"
^DIC(19,3294,50)="DIZ(131000,"
^DIC(19,3294,51)="[A3FEMERG]"
^DIC(19,3294,"U")="ENTER/EDIT FSMB ENTRY (EMERGENT)"
^DIC(19,3295,0)="A3FMO^Monthly VACO Report^^R^.5^^^^^^^"
^DIC(19,3295,1,0)="^^2^2^2890508^"
^DIC(19,3295,1,1,0)="This option prints the monthly letter to VACO giving the total number"
^DIC(19,3295,1,2,0)="of applicants submitted to the FSMB during a selected month."
^DIC(19,3295,25)="A3FMO"
^DIC(19,3295,"U")="MONTHLY VACO REPORT"
^DIC(19,3296,0)="A3FHIRE^Date FSMB Applicant Hired^^R^.5^^^^^^^"
^DIC(19,3296,1,0)="^^2^2^2890509^"
^DIC(19,3296,1,1,0)="This option is used to enter the date FSMB applicants were hired"
^DIC(19,3296,1,2,0)="by submitting stations."
^DIC(19,3296,25)="A3FHIRE"
^DIC(19,3296,"U")="DATE FSMB APPLICANT HIRED"
^DIC(19,3297,0)="A3FQTR^Quarterly VACO Report^^R^.5^^^^^^^"
^DIC(19,3297,1,0)="^^7^7^2890511^"
^DIC(19,3297,1,1,0)="This option produces information which may be used for the quarterly"
^DIC(19,3297,1,2,0)="letter to VACO.  The report supplies total physicians screened and"
^DIC(19,3297,1,3,0)="number of screens employed for a selected date range.  Additionally,"
^DIC(19,3297,1,4,0)="applicants will be listed for the following categories (if found):"
^DIC(19,3297,1,5,0)="those with disciplinary action found, those with further review required,"
^DIC(19,3297,1,6,0)="those with disciplinary action found that were hired, and those applicants"
^DIC(19,3297,1,7,0)="who were hired by the station before the FSMB results were returned."
^DIC(19,3297,25)="A3FQTR"
^DIC(19,3297,"U")="QUARTERLY VACO REPORT"
^DIC(19,3298,0)="A3FLIST^List Batch Applicants^^R^.5^^^^^^^"
^DIC(19,3298,1,0)="^^2^2^2890707^"
^DIC(19,3298,1,1,0)="This option will print the list of FSMB applicants for selected"
^DIC(19,3298,1,2,0)="batch numbers."
^DIC(19,3298,25)="A3FLIST"
^DIC(19,3298,"U")="LIST BATCH APPLICANTS"
^DIC(19,3299,0)="DG GECS READY FOR BATCHING LIS^Code Sheets Ready for Batching^^A^1602^^^^^^^^^1"
^DIC(19,3299,1,0)="^^1^1^2890411^"
^DIC(19,3299,1,1,0)="This option will list code sheets which are ready for batching."
^DIC(19,3299,15)="K GECSSYS"
^DIC(19,3299,20)="S GECSSYS=""MAS"" D RCODEBA^GECSCALL"
^DIC(19,3299,"U")="CODE SHEETS READY FOR BATCHING"
^DIC(19,3300,0)="PSJU 7D MAR^7 Day MAR^^R^11712^^^^^^^117"
^DIC(19,3300,1,0)="^^4^4^2940308^^^^"
^DIC(19,3300,1,1,0)="  Allows the user to print selected patients' orders on a Medication"
^DIC(19,3300,1,2,0)="Administration Record (MAR) for the charting of the administration of the"
^DIC(19,3300,1,3,0)="orders over a seven day period.  Designed to replace the manual Continuing"
^DIC(19,3300,1,4,0)="Medication Record (CMR)."
^DIC(19,3300,25)="EN7^PSGMMAR"
^DIC(19,3300,99)="57034,54317"
^DIC(19,3300,"U")="7 DAY MAR"
^DIC(19,3301,0)="PSJU 14D MAR^14 Day MAR^^R^11712^^^^^^^117"
^DIC(19,3301,1,0)="^^4^4^2940126^^^^"
^DIC(19,3301,1,1,0)="  Allows the user to print selected patients' orders on a Medication"
^DIC(19,3301,1,2,0)="Administration Record (MAR) for the charting of the administration of the"
^DIC(19,3301,1,3,0)="orders over a fourteen day period.  Designed to replace the manual"
^DIC(19,3301,1,4,0)="Continuing Medication Record (CMR)."
^DIC(19,3301,25)="EN14^PSGMMAR"
^DIC(19,3301,"U")="14 DAY MAR"
^DIC(19,3302,0)="ZZCPTEST^CASTLE POINT PSO ACTION PROFILES TEST^^M^121"
^DIC(19,3302,10,0)="^19.01IP^1^1"
