^DIC(19,3249,10,"B",3336,3)=""
^DIC(19,3249,10,"C","BAT",2)=""
^DIC(19,3249,10,"C","PUR",4)=""
^DIC(19,3249,10,"C","TRAN",3)=""
^DIC(19,3249,10,"C","USR",1)=""
^DIC(19,3249,99)="62195,28623"
^DIC(19,3249,"U")="MAS CODE SHEET MANAGER MENU"
^DIC(19,3250,0)="DG GECS GENERATE^Generate a Code Sheet^^R^1253^^^^^^^114"
^DIC(19,3250,1,0)="^^11^11^2980406^^^^"
^DIC(19,3250,1,1,0)="This option will allow a user to generate code sheets for"
^DIC(19,3250,1,2,0)="AMIS segments 334-341, 345-346 and 401-420. The AMIS"
^DIC(19,3250,1,3,0)="information is pulled from a select month/year for which the"
^DIC(19,3250,1,4,0)="AMIS has already been generated. Code sheets will only"
^DIC(19,3250,1,5,0)="be generated for balanced AMIS segments."
^DIC(19,3250,1,6,0)=" "
^DIC(19,3250,1,7,0)="If you are a multi-divisional facility the information for"
^DIC(19,3250,1,8,0)="AMIS segments 334-341 and 345-346 are combined for all"
^DIC(19,3250,1,9,0)="divisions and a code sheet is created, for each segment,"
^DIC(19,3250,1,10,0)="for the primary division containing the combined statistics"
^DIC(19,3250,1,11,0)="for all divisions."
^DIC(19,3250,25)="DGGECS"
^DIC(19,3250,"U")="GENERATE A CODE SHEET"
^DIC(19,3251,0)="DG GECS PRINT^Print a Code Sheet^^R^.5^^^^^^^114"
^DIC(19,3251,1,0)="^^2^2^2890928^^^^"
^DIC(19,3251,1,1,0)="This option will allow the 223, 334-341, 345-346, 401-420,"
^DIC(19,3251,1,2,0)="167 and the 290 AMIS segments to be printed."
^DIC(19,3251,20)=""
^DIC(19,3251,25)="PRINT^DGGECSB"
^DIC(19,3251,"U")="PRINT A CODE SHEET"
^DIC(19,3259,0)="GECS CREATE^Create a Code Sheet^^R^.5^^^^^^^"
^DIC(19,3259,1,0)="^^2^2^2940408^^^"
^DIC(19,3259,1,1,0)="This option allows users to input data into the fields set up in"
^DIC(19,3259,1,2,0)="file 2100 for creating code sheets."
^DIC(19,3259,25)="GECSEDIT"
^DIC(19,3259,99)="55819,31463"
^DIC(19,3259,"U")="CREATE A CODE SHEET"
^DIC(19,3260,0)="GECS TRANSMIT^Transmit Code Sheets^^R^.5^^^^^^^"
^DIC(19,3260,1,0)="^^1^1^2890411^"
^DIC(19,3260,1,1,0)="This option will transmit a batch."
^DIC(19,3260,25)="GECSTRAN"
^DIC(19,3260,"U")="TRANSMIT CODE SHEETS"
^DIC(19,3261,0)="GECS BATCH^Batch Code Sheets^^R^.5^^^^^^^"
^DIC(19,3261,1,0)="^^1^1^2960313^^"
^DIC(19,3261,1,1,0)="This option will batch all code sheets by batch type (file 2101.1)."
^DIC(19,3261,25)="GECSBATC"
^DIC(19,3261,"U")="BATCH CODE SHEETS"
