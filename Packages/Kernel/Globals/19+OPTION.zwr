^DIC(19,12713,0)="RORMNT ACL REINDEX^Re-index the ACL cross-reference^^R^1^^^^^^^540"
^DIC(19,12713,1,0)="^19.06^9^9^3030714^^"
^DIC(19,12713,1,1,0)=" "
^DIC(19,12713,1,2,0)="The 'Re-index the ACL cross-reference' option lets users re-index the"
^DIC(19,12713,1,3,0)="""ACL"" cross-reference of the ROR REGISTRY PARAMETERS file (#798.1). This"
^DIC(19,12713,1,4,0)="cross-reference should be rebuilt after changes in the allocation of the"
^DIC(19,12713,1,5,0)="security keys associated with any registry."
^DIC(19,12713,1,6,0)=" "
^DIC(19,12713,1,7,0)="Usually, this is done by the nightly task (the [ROR TASK] option).  "
^DIC(19,12713,1,8,0)="However, if you want the changes to be in effect immediately, you should"
^DIC(19,12713,1,9,0)="rebuild this cross-reference manually."
^DIC(19,12713,2)="y"
^DIC(19,12713,10.1)="Reindex the ACL xref"
^DIC(19,12713,25)="RNDXACL^RORVM001"
^DIC(19,12713,"U")="RE-INDEX THE ACL CROSS-REFEREN"
^DIC(19,12714,0)="RORICR VERSION COMPARISON^ICR Version Comparison Report^^R^1^^^^^^^540"
^DIC(19,12714,1,0)="^19.06^10^10^3030722^^^"
^DIC(19,12714,1,1,0)=" "
^DIC(19,12714,1,2,0)="This option schedules a task, which generates the version comparison"
^DIC(19,12714,1,3,0)="report. The report is used during the installation of the Immunology Case"
^DIC(19,12714,1,4,0)="Registry V.3.0 software."
^DIC(19,12714,1,5,0)=" "
^DIC(19,12714,1,6,0)="The first part of the report details all living patients that exist within"
^DIC(19,12714,1,7,0)="the V.2.1 patient list but are not in the V.3.0 list. The second part of"
^DIC(19,12714,1,8,0)="the report details all living patients that exist in the V.3.0 list but do"
^DIC(19,12714,1,9,0)="not appear in the V.2.1 list. The third part of the report will list all"
^DIC(19,12714,1,10,0)="patients that are both in V.2.1 and V.3.0."
^DIC(19,12714,2)="y"
^DIC(19,12714,25)="BEGIN^RORREP01"
^DIC(19,12714,200.9)="^y"
^DIC(19,12714,"U")="ICR VERSION COMPARISON REPORT"
^DIC(19,12715,0)="ROR SETUP^Registry Setup^^R^1^^^^^^^540"
^DIC(19,12715,1,0)="^19.06^3^3^3030714^^"
^DIC(19,12715,1,1,0)="  "
^DIC(19,12715,1,2,0)="This option allows the user to enter parameters of the registry setup "
^DIC(19,12715,1,3,0)="process and schedule the task that will populate the registry."
^DIC(19,12715,2)="y"
^DIC(19,12715,25)="RORSET01"
^DIC(19,12715,200.9)="n^y"
^DIC(19,12715,"U")="REGISTRY SETUP"
