^DIC(19,16894,0)="EHM-01715^Manage Business Rules^^A^1^^^^^^^515^^1^^"
^DIC(19,16894,1,0)="^^4^4^3240328^^"
^DIC(19,16894,1,1,0)="This option allows you to list the Business rules defined by"
^DIC(19,16894,1,2,0)="Authorization/Subscription, and to add, edit, or delete them, as"
^DIC(19,16894,1,3,0)="appropriate."
^DIC(19,16894,1,4,0)="Cloned from ""USR BUSINESS RULE MANAGEMENT"" option."
^DIC(19,16894,3)=""
^DIC(19,16894,20)="D EN^USRRUL"
^DIC(19,16894,99.1)="57025,18084"
^DIC(19,16894,"U")="MANAGE BUSINESS RULES"
^DIC(19,16895,0)="EHM-01716^Document Definitions (Manager)^^M^1^^^^^^y^516^^^^^1"
^DIC(19,16895,1,0)="^19.06^11^11^3240328^^^^"
^DIC(19,16895,1,1,0)="Document Definition menu for Managers/IRM.  Lets you create new"
^DIC(19,16895,1,2,0)="entries, delete appropriate entries, copy entries, and edit entries,"
^DIC(19,16895,1,3,0)="including Technical M fields and Upload fields."
^DIC(19,16895,1,4,0)=" "
^DIC(19,16895,1,5,0)="Editing Exception: National Standard entries cannot be edited/deleted on"
^DIC(19,16895,1,6,0)="ANY menu."
^DIC(19,16895,1,7,0)=" "
^DIC(19,16895,1,8,0)="The Manager menu overrides Ownership for editing, but not for deleting"
^DIC(19,16895,1,9,0)="entries; a manager can edit any entry regardless of owner, but must own"
^DIC(19,16895,1,10,0)="an entry in order to delete it."
^DIC(19,16895,1,11,0)="Cloned from ""TIUF DOCUMENT DEFINITION MGR"" option."
^DIC(19,16895,3)=""
^DIC(19,16895,10,0)="^19.01IP^6^6"
^DIC(19,16895,10,1,0)="16896^2^2"
^DIC(19,16895,10,2,0)="16897^1^1"
^DIC(19,16895,10,3,0)="16898^3^3"
^DIC(19,16895,10,4,0)="16899^4^4"
^DIC(19,16895,10,5,0)="16900^5"
^DIC(19,16895,10,6,0)="16901^6"
^DIC(19,16895,10,"B",16896,1)=""
^DIC(19,16895,10,"B",16897,2)=""
^DIC(19,16895,10,"B",16898,3)=""
^DIC(19,16895,10,"B",16899,4)=""
^DIC(19,16895,10,"B",16900,5)=""
^DIC(19,16895,10,"B",16901,6)=""
^DIC(19,16895,10,"C",1,2)=""
^DIC(19,16895,10,"C",2,1)=""
^DIC(19,16895,10,"C",3,3)=""
^DIC(19,16895,10,"C",4,4)=""
^DIC(19,16895,10,"C",5,5)=""
^DIC(19,16895,10,"C",6,6)=""
^DIC(19,16895,20)=""
^DIC(19,16895,26)="W !!,$$CENTER^TIULS(""--- Manager Document Definition Menu ---"")"
^DIC(19,16895,99)="67411,49178"
^DIC(19,16895,"U")="DOCUMENT DEFINITIONS (MANAGER)"
^DIC(19,16896,0)="EHM-01717^Sort Document Definitions^^A^1^^^^^^n^516^^1^^^"
^DIC(19,16896,1,0)="^19.06^6^6^3240328^^"
^DIC(19,16896,1,1,0)="The Sort Document Definitions Option lets you select sort criteria.  It"
^DIC(19,16896,1,2,0)="then displays selected entries in alphabetic order by Name, rather than in"
^DIC(19,16896,1,3,0)="hierarchy order.  Depending on sort criteria, entries can include Objects."
^DIC(19,16896,1,4,0)=" "
^DIC(19,16896,1,5,0)="The Sort Option lets you view and edit entries."
^DIC(19,16896,1,6,0)="Cloned from ""TIUFA SORT DDEFS MGR"" option."
^DIC(19,16896,3)=""
^DIC(19,16896,15)=""
^DIC(19,16896,20)="N TIUFWHO S TIUFWHO=""M"" D EN^TIUFA"
^DIC(19,16896,26)=""
^DIC(19,16896,99)="56434,81210"
^DIC(19,16896,99.1)="56725,54266"
^DIC(19,16896,"U")="SORT DOCUMENT DEFINITIONS"
^DIC(19,16897,0)="EHM-01718^Edit Document Definitions^^A^1^^^^^^n^516^^1^1^^"
^DIC(19,16897,1,0)="^^7^7^3240328^^^^"
^DIC(19,16897,1,1,0)="The Edit Document Definitions Option lets you view and edit entries."
^DIC(19,16897,1,2,0)=" "
^DIC(19,16897,1,3,0)="Entries are presented in hierarchy order.  ITEMS of an entry are in"
^DIC(19,16897,1,4,0)="Sequence order, or if they have no Sequence, in alphabetic order by Menu"
^DIC(19,16897,1,5,0)="Text, and are indented below the entry.  Since Objects do not belong to"
^DIC(19,16897,1,6,0)="the hierarchy, they cannot be viewed/edited using the Edit Option."
^DIC(19,16897,1,7,0)="Cloned from ""TIUFH EDIT DDEFS MGR"" option."
^DIC(19,16897,3)=""
^DIC(19,16897,15)="I $G(TIUFWHO)'=""N"",'$G(TIUFZZ8) K ^TMP(""TIUFMOVE"",$J)"
^DIC(19,16897,20)="N TIUFWHO S TIUFWHO=""M"" D EN^TIUFH"
^DIC(19,16897,26)=""
^DIC(19,16897,99)="56434,85597"
^DIC(19,16897,"U")="EDIT DOCUMENT DEFINITIONS"
^DIC(19,16898,0)="EHM-01719^Create Document Definitions^^A^1^^^^^^n^516^^1^^"
^DIC(19,16898,1,0)="^^12^12^3240328^"
^DIC(19,16898,1,1,0)="The Create Document Definitions Option lets you create new entries of any"
^DIC(19,16898,1,2,0)="type except Object, placing them where they belong in the hierarchy."
^DIC(19,16898,1,3,0)=" "
^DIC(19,16898,1,4,0)="Although entries can be created using the Edit and Sort Options, the"
^DIC(19,16898,1,5,0)="Create Option streamlines the process. This option presents entries in"
^DIC(19,16898,1,6,0)="hierarchy order, traversing ONE line of descent, starting from Clinical"
^DIC(19,16898,1,7,0)="Documents at the top."
^DIC(19,16898,1,8,0)=" "
^DIC(19,16898,1,9,0)="The Create Option permits you to view, edit, and create entries, but only"
^DIC(19,16898,1,10,0)="from within the current line of descent.  The Create Option does not let"
^DIC(19,16898,1,11,0)="you copy an entry."
^DIC(19,16898,1,12,0)="Cloned from ""TIUFC CREATE DDEFS MGR"" option."
^DIC(19,16898,3)=""
^DIC(19,16898,20)="N TIUFWHO S TIUFWHO=""M"" D EN^TIUFC"
^DIC(19,16898,99)="56434,85597"
^DIC(19,16898,"U")="CREATE DOCUMENT DEFINITIONS"
^DIC(19,16899,0)="EHM-01720^Create Objects^^A^1^^^^^^n^516^^1^^"
^DIC(19,16899,1,0)="^19.06^4^4^3240328^^^^"
^DIC(19,16899,1,1,0)="The Create/Edit Objects Option lets you select Start With and Go to"
^DIC(19,16899,1,2,0)="values. It then displays Objects within those values in alphabetic order"
^DIC(19,16899,1,3,0)="by Name.  User can create new objects or edit existing objects."
^DIC(19,16899,1,4,0)="Cloned from ""TIUFJ CREATE OBJECTS MGR"" option."
^DIC(19,16899,3)=""
^DIC(19,16899,20)="N TIUFWHO S TIUFWHO=""M"" D EN^TIUFJ"
^DIC(19,16899,99)="56434,81210"
^DIC(19,16899,99.1)="56725,54266"
^DIC(19,16899,"U")="CREATE OBJECTS"
^DIC(19,16900,0)="EHM-01721^Create TIU/Health Summary Objects^^R^1^^^^^^^516^^^^"
^DIC(19,16900,1,0)="^19.06^1^1^3240328^^^^"
^DIC(19,16900,1,1,0)="Cloned from ""TIUHS LIST MANAGER"" option."
^DIC(19,16900,3)=""
^DIC(19,16900,25)="TIUHSL"
^DIC(19,16900,99.1)="59023,27548"
^DIC(19,16900,"U")="CREATE TIU/HEALTH SUMMARY OBJE"
^DIC(19,16901,0)="EHM-01722^Create Post-Signature Alerts^^R^1^^^^^^^516^^^^"
^DIC(19,16901,1,0)="^^5^5^3240328^"
^DIC(19,16901,1,1,0)="This option allows a user to set the POST-SIGNATURE CODE field of a title"
^DIC(19,16901,1,2,0)="in the TIU DOCUMENT DEFINITION file with MUMPS code. At the completion of"
^DIC(19,16901,1,3,0)="a progress note using the selected title, different alerts will be "
^DIC(19,16901,1,4,0)="generated to designated user(s)."
^DIC(19,16901,1,5,0)="Cloned from ""TIUFPC CREATE POST-SIGNATURE"" option."
^DIC(19,16901,3)=""
^DIC(19,16901,25)="EN^TIUPSCS"
^DIC(19,16901,"U")="CREATE POST-SIGNATURE ALERTS"
^DIC(19,16902,0)="EHM-01723^TIU Parameters Menu^^M^1^^^^^^^516^^^^"
^DIC(19,16902,1,0)="^^4^4^3240328^^^"
^DIC(19,16902,1,1,0)="This option allows the Clinical Coordinator or IRM Application Specialist"
^DIC(19,16902,1,2,0)="to set up either the Basic or Upload Parameters for Text Integration"
^DIC(19,16902,1,3,0)="Utilities (TIU)."
^DIC(19,16902,1,4,0)="Cloned from ""TIU SET-UP MENU"" option."
^DIC(19,16902,3)=""
^DIC(19,16902,10,0)="^19.01IP^5^5"
^DIC(19,16902,10,1,0)="16903^2^2"
^DIC(19,16902,10,2,0)="16904^1^1"
^DIC(19,16902,10,3,0)="16905^3^3"
^DIC(19,16902,10,4,0)="16906^4^4"
^DIC(19,16902,10,5,0)="16907^5^5"
