^DIC(19,13753,"U")="UTILITIES THAT MANIPULATE ANTI"
^DIC(19,13754,0)="VBEC DELETE CONV. STATS^Delete data conversion and anomaly check histories^^R^1^^^^^^^"
^DIC(19,13754,1,0)="^^2^2^3040414^"
^DIC(19,13754,1,1,0)="This option deletes all data conversion and anomaly check histories from"
^DIC(19,13754,1,2,0)="the VBECS DATA INTEGRITY/CONVERSION STATISTICS (#6001) file."
^DIC(19,13754,25)="DEL6001^VBECDCU2"
^DIC(19,13754,"U")="DELETE DATA CONVERSION AND ANO"
^DIC(19,13755,0)="VBEC DATA CONVERSION STATS^Display data conversion statistics^^R^1^^^^^^^"
^DIC(19,13755,1,0)="^19.06^19^19^3040420^^^"
^DIC(19,13755,1,1,0)="This option displays the number of data elements converted per Lab Data "
^DIC(19,13755,1,2,0)="(#63) file record and/or the total number of data elements converted for "
^DIC(19,13755,1,3,0)="all Lab Data file records."
^DIC(19,13755,1,4,0)=" "
^DIC(19,13755,1,5,0)="Some of the data elements converted are: SEX, DOB, ABO, RBC ANTIGENS"
^DIC(19,13755,1,6,0)="PRESENT, RBC ANTIGENS PRESENT COMMENTS, RBC ANTIGENS PRESENT CHARS, "
^DIC(19,13755,1,7,0)="BLOOD BANK COMMENTS, & BLOOD BANK COMMENT CHARS."
^DIC(19,13755,1,8,0)=" "
^DIC(19,13755,1,9,0)="The entire set of data elements converted can identified when the FileMan"
^DIC(19,13755,1,10,0)="'LIST FILE ATTRIBUTES' option is run on the VBECS DATA "
^DIC(19,13755,1,11,0)="INTEGRITY/CONVERSION STATISTICS (#6001) file. The data elements "
^DIC(19,13755,1,12,0)="converted are those fields which reside in the DATA CONVERSION STATISTICS"
^DIC(19,13755,1,13,0)="multiple (field: 200, sub-file: 6001.02)."
^DIC(19,13755,1,14,0)=" "
^DIC(19,13755,1,15,0)="The values passed reflect the number of times the data element exists"
^DIC(19,13755,1,16,0)="for a qualifying Lab Data record. For example, if a Lab Data file record "
^DIC(19,13755,1,17,0)="has an instance of BLOOD BANK COMMENTS, which is a word processing field, "
^DIC(19,13755,1,18,0)="then one instance of that data element is attributed to our Lab Data file "
^DIC(19,13755,1,19,0)="record."
^DIC(19,13755,25)="VBECDCDC"
^DIC(19,13755,"U")="DISPLAY DATA CONVERSION STATIS"
