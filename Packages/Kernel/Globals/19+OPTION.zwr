^DIC(19,16938,1,0)="^19.06^5^5^3240328^^^^"
^DIC(19,16938,1,1,0)="This option is used to give one or more users access to selected files."
^DIC(19,16938,1,2,0)="You may enter an individual file number, a range of numbers, and/or a"
^DIC(19,16938,1,3,0)="list of file numbers.  Remember, you can only give out access to files"
^DIC(19,16938,1,4,0)="to which you have access."
^DIC(19,16938,1,5,0)="Cloned from ""XUFILEGRANT"" option."
^DIC(19,16938,3)=""
^DIC(19,16938,15)="K V,W,C,DI,DISYS,DQ,%X,%Y,DLAYGO S DUZ(0)=$G(R2DUZ)"
^DIC(19,16938,20)="S R2DUZ=$G(DUZ(0)),DUZ(0)=""@"""
