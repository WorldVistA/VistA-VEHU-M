^DIC(19,15587,15)="D OKILL^ORLP0"
^DIC(19,15587,20)="D WARD^ORLP01"
^DIC(19,15587,"U")="WARD           (ADD TO LIST)"
^DIC(19,15588,0)="EHM-00409^Clinic         (Add to list)^^A^1^^^^^^^^^1^^"
^DIC(19,15588,1,0)="^19.06^5^5^3240328^^^^"
^DIC(19,15588,1,1,0)="This option lets you add patients to a clinic list that is"
^DIC(19,15588,1,2,0)="already defined, or build a new patient list by clinic."
^DIC(19,15588,1,3,0)="After you have selected a clinic, you can add or delete patients"
^DIC(19,15588,1,4,0)="to further customize your list."
^DIC(19,15588,1,5,0)="Cloned from ""ORLP ADD CLINIC"" option."
^DIC(19,15588,3)=""
^DIC(19,15588,20)="D CLIN^ORLP01"
^DIC(19,15588,"U")="CLINIC         (ADD TO LIST)"
