^DIC(19,13543,"U")="CLINIC SERVICE TOTAL SUMMARY R"
^DIC(19,13544,0)="SDSC USER TOTAL REPORT^User Total Summary Report^^R^1^^^^^^^16"
^DIC(19,13544,1,0)="^^14^14^3070327^"
^DIC(19,13544,1,1,0)="This report will provide user edit type totals of encounters under the"
^DIC(19,13544,1,2,0)="following categories per user:"
^DIC(19,13544,1,3,0)=" "
^DIC(19,13544,1,4,0)="1. REVIEW - Number of outpatient encounters set to Clinical Review."
^DIC(19,13544,1,5,0)=" "
^DIC(19,13544,1,6,0)="2. SC to NSC - Number of outpatient encounters marked as 'Service"
^DIC(19,13544,1,7,0)="               Connected=YES' but were changed to 'Service Connected =NO'."
^DIC(19,13544,1,8,0)=" "
^DIC(19,13544,1,9,0)="3. NSC to SC - Number of outpatient encounters marked as 'Service"
^DIC(19,13544,1,10,0)="               Connected=NO' but were changed to 'Service Connected=YES'."
^DIC(19,13544,1,11,0)=" "
^DIC(19,13544,1,12,0)="4. SC KEPT - Number of outpatient encounters marked as 'Service"
^DIC(19,13544,1,13,0)="             Connected=YES' or 'Service Connected = No' that were not"
^DIC(19,13544,1,14,0)="             changed."
^DIC(19,13544,25)="EN^SDSCUSR"
^DIC(19,13544,"U")="USER TOTAL SUMMARY REPORT"
^DIC(19,13545,0)="SDSC PURGE NSC ENC^Purge ASCD NSC Encounters^^R^1^SDSC SUPER^^^^^^16^^"
^DIC(19,13545,1,0)="^19.06^4^4^3070521^^"
^DIC(19,13545,1,1,0)="This option will purge encounters with a status of NEW where the "
^DIC(19,13545,1,2,0)="Encounter SC value equals the ASCD value of ""NO"" for a specified"
^DIC(19,13545,1,3,0)="division(s) within a user defined date range. Users must have the SDSC"
^DIC(19,13545,1,4,0)="SUPER key to run this option."
^DIC(19,13545,20)=""
^DIC(19,13545,25)="EN^SDSCNSCP"
^DIC(19,13545,"U")="PURGE ASCD NSC ENCOUNTERS"
^DIC(19,13546,0)="BPS RPT CLAIMS RESPONSE^ECME Claims-Response Inquiry^^R^1^BPS REPORTS^^^^^^553^^"
^DIC(19,13546,1,0)="^^5^5^3070517^"
