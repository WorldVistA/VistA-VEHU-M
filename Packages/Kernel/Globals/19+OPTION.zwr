^DIC(19,5458,0)="PSJ OR PAT MENU^Inpatient Medications Patient Reports^^Q^.5^^^^^^^197"
^DIC(19,5458,1,0)="^^3^3^2910312^^^^"
^DIC(19,5458,1,1,0)="  Contains Inpatient (Unit Dose and IV) Medications reports for use with"
^DIC(19,5458,1,2,0)="the OE/RR package.  These reports assume that the patient has already"
^DIC(19,5458,1,3,0)="been selected when the option is selected."
^DIC(19,5458,10,0)="^19.01PI^0^0"
^DIC(19,5458,99)="56116,37069"
^DIC(19,5458,"U")="INPATIENT MEDICATIONS PATIENT "
^DIC(19,5482,0)="PSJI BACKGROUND JOB^Compile IV Costs in Background^^A^11712^^^^^^^^^1"
^DIC(19,5482,1,0)="^^4^4^2910312^"
^DIC(19,5482,1,1,0)="  Statistical data is stored in a ""holding area"" each time an IV label is"
^DIC(19,5482,1,2,0)="printed.  This option should be queued to run nightly to compile and merge"
^DIC(19,5482,1,3,0)="this information into the IV statistics file (50.8), and delete any data"
^DIC(19,5482,1,4,0)="which is over 100 days old."
^DIC(19,5482,20)="D EN^PSIVSTAT,NOW^%DTC S ^PS(50.8,1,.2)=%"
^DIC(19,5482,200.9)="y"
^DIC(19,5482,"U")="COMPILE IV COSTS IN BACKGROUND"
^DIC(19,5485,0)="PSJI LBLR^Reprint Scheduled Labels (IV)^^R^11712^^^^^^^^^^1"
^DIC(19,5485,1,0)="^^6^6^2940709^^^^"
^DIC(19,5485,1,1,0)="  This option allows the user to reprint IV labels which failed to print"
^DIC(19,5485,1,2,0)="during the running of the Scheduled Labels (IV) option (PSJI LBLS). This "
^DIC(19,5485,1,3,0)="option may not be used to reprint labels for dates and IV type which "
^DIC(19,5485,1,4,0)="printing has not been attempted through the Scheduled Labels (IV) option. "
^DIC(19,5485,1,5,0)="Labels prepared with this option will only be counted as usage if they "
^DIC(19,5485,1,6,0)="were not added during the running of Scheduled Labels."
^DIC(19,5485,15)="K I1"
^DIC(19,5485,25)="PSIVRP"
^DIC(19,5485,"U")="REPRINT SCHEDULED LABELS (IV)"
