^DIC(19,13519,1,0)="^19.06^5^5^3070820^^"
^DIC(19,13519,1,1,0)="Running this option will go thru all inpatients and check if each patient"
^DIC(19,13519,1,2,0)="has any existing GMRA Allergies without the corresponding Food Preference."
^DIC(19,13519,1,3,0)="If there are any missing and the link between the GMRA Allergy and the"
^DIC(19,13519,1,4,0)="Food Preference exists, this option will add the necessary Food "
^DIC(19,13519,1,5,0)="Preferences."
^DIC(19,13519,25)="UPDATE^FHSELA1"
^DIC(19,13519,"U")="UPDATE ALL PATIENTS ALLERGY/FO"
