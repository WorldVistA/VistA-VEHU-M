^DIC(19,12442,0)="PSS CS DRUGS INCON WITH DEA^CS (DRUGS) Inconsistent with DEA Spec Hdlg^^R^10000000020^^^^^^^^^1"
^DIC(19,12442,1,0)="^^2^2^3021121^"
^DIC(19,12442,1,1,0)="Active drugs that are defined as Controlled Substances, but not classified"
^DIC(19,12442,1,2,0)="correctly as Narcotics or Non-Narcotics."
^DIC(19,12442,20)="S OP=3"
^DIC(19,12442,25)="PSSPKIPR"
^DIC(19,12442,"U")="CS (DRUGS) INCONSISTENT WITH D"
^DIC(19,12443,0)="PSS CS (OI) INCON WITH DEA^CS (Ord. Item) Inconsistent with DEA Spec Hdlg^^R^10000000020^^^^^^^^^1"
^DIC(19,12443,1,0)="^^2^2^3021226^"
^DIC(19,12443,1,1,0)="Discrepancy within the DEA Special Hdlg field of active dispense drugs"
^DIC(19,12443,1,2,0)="that are associated to the same pharmacy orderable item."
^DIC(19,12443,20)="S OP=4"
^DIC(19,12443,25)="PSSPKIPR"
^DIC(19,12443,"U")="CS (ORD. ITEM) INCONSISTENT WI"
^DIC(19,12444,0)="PSS CS NOT MATCHED TO NDF^Controlled Substances Not Matched to NDF^^R^10000000020^^^^^^^^^1"
^DIC(19,12444,1,0)="^^1^1^3021226^"
^DIC(19,12444,1,1,0)="Active Controlled Substances that are not been matched to NDF."
^DIC(19,12444,20)="S OP=2"
^DIC(19,12444,25)="PSSPKIPR"
^DIC(19,12444,"U")="CONTROLLED SUBSTANCES NOT MATC"
^DIC(19,12445,0)="PSS DEA VS CS FED. SCH. DISCR.^DEA Spec Hdlg & CS Fed Sch Discrepancy^^R^10000000020^^^^^^^^^1"
^DIC(19,12445,1,0)="^^3^3^3021226^"
^DIC(19,12445,1,1,0)="Identifies active Controlled Substances having a discrepancy between the"
^DIC(19,12445,1,2,0)="CS FEDERAL SCHEDULE in the VA PRODUCT file (#50.68) and the DEA,SPECIAL"
^DIC(19,12445,1,3,0)="HDLG code in the DRUG file (#50)."
^DIC(19,12445,20)="S OP=1"
^DIC(19,12445,25)="PSSPKIPR"
^DIC(19,12445,"U")="DEA SPEC HDLG & CS FED SCH DIS"
