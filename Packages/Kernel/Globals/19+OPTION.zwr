^DIC(19,6729,99)="62208,45161"
^DIC(19,6729,"U")="DISPENSING MENU"
^DIC(19,6730,0)="PSD PRINT 2321^Dispensing/Receiving Report (VA FORM 10-2321)^^R^11595^^^^^^^276"
^DIC(19,6730,1,0)="^^7^7^2940926^^^^"
^DIC(19,6730,1,1,0)="This report lists all CS orders dispensed to a Narcotic Area"
^DIC(19,6730,1,2,0)="of Use.  This report requires the Dispensing Pharmacist signature"
^DIC(19,6730,1,3,0)="and the signature of the nurse receiving the CS drugs.  This report"
^DIC(19,6730,1,4,0)="will be retained within pharmacy after the controlled substances are"
^DIC(19,6730,1,5,0)="delivered to the ward."
^DIC(19,6730,1,6,0)="  "
^DIC(19,6730,1,7,0)="This report replaces the VA FORM 10-2321."
^DIC(19,6730,25)="PSDPDR"
^DIC(19,6730,"U")="DISPENSING/RECEIVING REPORT (V"
^DIC(19,6731,0)="PSD PRINT PHARM DISP^Pharmacy Dispensing Report^^R^11595^^^^^^^276"
^DIC(19,6731,1,0)="^^5^5^2930727^^^"
^DIC(19,6731,1,1,0)="This report lists by dispensing site and date range the drug name,"
^DIC(19,6731,1,2,0)="pharmacy dispensing number (Green Sheet #), quantity dispensed, date"
^DIC(19,6731,1,3,0)="dispensed, and dispensing pharmacist.  Also there's a summary by"
^DIC(19,6731,1,4,0)="drug of total number dispensed.  The summary may be generated without the"
^DIC(19,6731,1,5,0)="individual dispensing data."
^DIC(19,6731,25)="PSDPND"
^DIC(19,6731,"U")="PHARMACY DISPENSING REPORT"
^DIC(19,6732,0)="PSD PRINT INSPECTOR LOG^Inspector's Log for Controlled Substances^^R^11595^^^^^^^276"
^DIC(19,6732,1,0)="^^4^4^2930224^^^"
^DIC(19,6732,1,1,0)="This report lists all active Green Sheets by Narcotic Area of Use.  The"
^DIC(19,6732,1,2,0)="data includes Green Sheet number, drug name, date dispensed, quantity"
^DIC(19,6732,1,3,0)="dispensed, expiration date (if available), blanks for quantity on hand,"
^DIC(19,6732,1,4,0)="and a signature blank for verification."
^DIC(19,6732,25)="PSDPLOG"
^DIC(19,6732,99)="55707,39068"
^DIC(19,6732,"U")="INSPECTOR'S LOG FOR CONTROLLED"
^DIC(19,6733,0)="PSD REPRINT 2321^Reprint Disp/Receiving Report (VA FORM 10-2321)^^R^11595^^^^^^^276"
^DIC(19,6733,1,0)="^^3^3^2941027^^^^"
^DIC(19,6733,1,1,0)="The Dispensing/Receiving Report (in lieu of the VA FORM 10-2321) may be"
^DIC(19,6733,1,2,0)="reprinted.  This report may be generated for a single Green Sheet or for"
^DIC(19,6733,1,3,0)="a single NAOU within a specified date and time frame."
^DIC(19,6733,25)="PSDRDR"
^DIC(19,6733,99)="55297,68588"
^DIC(19,6733,"U")="REPRINT DISP/RECEIVING REPORT "
^DIC(19,6734,0)="PSD REPRINT MENU^Reprint Reports Menu^^M^11595^^^^^^^276"
^DIC(19,6734,1,0)="^^4^4^2940913^^^^"
^DIC(19,6734,1,1,0)="This menu allows various narcotic reports and forms to be reprinted."
^DIC(19,6734,1,2,0)="To ensure drug accountability, certain Controlled Substances documents"
^DIC(19,6734,1,3,0)="should only be printed once.  This option allows the reprinting of"
^DIC(19,6734,1,4,0)="these controlled records."
^DIC(19,6734,10,0)="^19.01PI^5^5"
