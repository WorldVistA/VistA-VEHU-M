^DIC(19,7789,25)="FBNHAMIE"
^DIC(19,7789,"U")="REPORT OF ADMISSIONS/DISCHARGE"
^DIC(19,7790,0)="FBAA COST REPORT^Outpatient Cost Report^^R^.5^^^^^^^344"
^DIC(19,7790,1,0)="^^2^2^2930223^"
^DIC(19,7790,1,1,0)="Cost report for Outpatient payments for a user specified date range."
