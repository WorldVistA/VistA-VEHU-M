^DIC(19,10579,0)="IBDF EF FORM COMPONENTS^Form Components^^R^11720^^^^^^^485"
^DIC(19,10579,1,0)="^^12^12^2961202^^"
^DIC(19,10579,1,1,0)="This new display lists the contents of a form ( without displaying them)."
^DIC(19,10579,1,2,0)="It list the contents of each block,  the name of the block,  starting row"
^DIC(19,10579,1,3,0)="and column,  width and height of the block.  Two actions are included on"
^DIC(19,10579,1,4,0)="this screen ,  EX Expand Item and BC Block Components.  Expand Item"
^DIC(19,10579,1,5,0)="allows the user to do an inquiry of the block and its components  listed in"
^DIC(19,10579,1,6,0)="the Block file #357.1.   The Block Components action gives the user a"
^DIC(19,10579,1,7,0)="more exact makeup of the block and the data it displays.  It lists the"
^DIC(19,10579,1,8,0)="component, type it is (selection list, hand print field or data field)  row,"
^DIC(19,10579,1,9,0)="column and block separators.   For selection lists it also lists the"
^DIC(19,10579,1,10,0)="subcolumn information.  The Type  ( text or marking), Data"
^DIC(19,10579,1,11,0)="(code, short description) ,  Width of the subcolumn, Qualifier,"
^DIC(19,10579,1,12,0)="Selection Rule and if it is editable."
^DIC(19,10579,25)="IBDFCMP"
^DIC(19,10579,"U")="FORM COMPONENTS"
^DIC(19,10580,0)="IBDF PRINT ERROR LIST^Scanning Error and Warning Listing^^R^11720^^^^^^^485"
^DIC(19,10580,1,0)="^^3^3^2970314^^"
^DIC(19,10580,1,1,0)="During scanning errors reported by AICS or PCE are stored in the AICS Error"
^DIC(19,10580,1,2,0)="Log file.  This report will allow printing a list of the errors so that the"
^DIC(19,10580,1,3,0)="encounter forms can be retrieved and the data validated."
^DIC(19,10580,25)="PRT^IBDF18E2"
^DIC(19,10580,"U")="SCANNING ERROR AND WARNING LIS"
