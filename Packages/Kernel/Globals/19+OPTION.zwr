^DIC(19,8990,0)="XUTM SCHEDULE^Schedule/Unschedule Options^^C^1039^^^^^^^^^"
^DIC(19,8990,1,0)="3^^3^3^2940310^^^^"
^DIC(19,8990,1,0,"LE")=1
^DIC(19,8990,1,1,0)="This option allows the editing of the background job fields in the"
^DIC(19,8990,1,2,0)="option schedule file.  The result of this action is to schedule or unschedule"
^DIC(19,8990,1,3,0)="Task Manager tasks."
^DIC(19,8990,30)="DIC(19.2,"
^DIC(19,8990,31)="AEMQL"
^DIC(19,8990,32)="Select OPTION to schedule or reschedule:"
^DIC(19,8990,35)="W ""  (""_$P(^DIC(19,+^(0),0),U,4)_"")"""
