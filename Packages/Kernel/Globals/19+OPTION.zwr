^DIC(19,1643,1,2,0)="codes as specified by the 'Major AMIS Code Entry/Edit' function."
^DIC(19,1643,25)="3^RAMAINP"
^DIC(19,1643,"U")="MAJOR AMIS CODE LIST"
^DIC(19,1644,0)="RA FILMP^Film Sizes List^^R^11712^^^^^^^"
^DIC(19,1644,1,0)="^^2^2^2890221^^^^"
^DIC(19,1644,1,1,0)="This function allows the user to obtain a list of the film sizes as"
^DIC(19,1644,1,2,0)="specified by the 'Film Type Enter/Edit' function."
^DIC(19,1644,25)="4^RAMAINP"
^DIC(19,1644,"U")="FILM SIZES LIST"
