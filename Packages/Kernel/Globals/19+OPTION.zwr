^DIC(19,9700,0)="GMRY IV SOL^IV Solution^^E^10958^^^^^^^502^^1^1"
^DIC(19,9700,1,0)="^^3^3^2960123^^^^"
^DIC(19,9700,1,1,0)="The ADP coordinator can enter IV solutions into the GMRY NUR IV SOLUTION"
^DIC(19,9700,1,2,0)="file (#126.9) through this option.  The IV solutions include admixtures, "
^DIC(19,9700,1,3,0)="hyperals, intralipids, piggybacks and blood/blood products."
^DIC(19,9700,15)="K DIDEL,DLAYGO"
^DIC(19,9700,20)="S (DIDEL,DLAYGO)=126.9"
^DIC(19,9700,30)="GMRD(126.9,"
