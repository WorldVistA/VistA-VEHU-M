^DIC(19,6231,1,0)="^19.06^2^2^3010401^^^^"
^DIC(19,6231,1,1,0)="This option will allow the user to directly cancel, edit, or add"
^DIC(19,6231,1,2,0)="to patient charges."
^DIC(19,6231,25)="IBECEA"
^DIC(19,6231,99)="55629,58522"
^DIC(19,6231,"U")="CANCEL/EDIT/ADD PATIENT CHARGE"
