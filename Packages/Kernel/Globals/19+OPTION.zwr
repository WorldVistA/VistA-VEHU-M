^DIC(19,8911,"U")="SURVEY PARTICIPANT MENU"
^DIC(19,8912,0)="QAP DELETE SURVEY^Delete a Survey, Questions and Responses^Option has been placed out of order^R^.5^^^^^^^268"
^DIC(19,8912,1,0)="^^2^2^2941110^"
^DIC(19,8912,1,1,0)="This option completely deletes a survey, its associated questions"
^DIC(19,8912,1,2,0)="as well as all the responses."
^DIC(19,8912,25)="QAPSDEL"
^DIC(19,8912,"U")="DELETE A SURVEY, QUESTIONS AND"
^DIC(19,8913,0)="QAP CLEAR SURVEY^Clear a Survey of Responses^Option has been placed out of order^R^.5^^^^^^^"
^DIC(19,8913,1,0)="^^5^5^2941110^"
^DIC(19,8913,1,1,0)="This option will remove all responses associated with a survey.  Responses"
^DIC(19,8913,1,2,0)="are typically removed so a survey may be used again.  For instance a"
^DIC(19,8913,1,3,0)="service may have a survey they take once a year and since it might be"
^DIC(19,8913,1,4,0)="lengthy, it is desirable to clear the previous year's responses and allow"
^DIC(19,8913,1,5,0)="new input the current year."
^DIC(19,8913,25)="QAPCLEAR"
^DIC(19,8913,"U")="CLEAR A SURVEY OF RESPONSES"
^DIC(19,8914,0)="QAP DEMOGRAPHIC PRINT^Print Statistics by a Demographic Data Item^Option has been placed out of order^R^.5^^^^^^^268"
^DIC(19,8914,1,0)="^^1^1^2941115^"
^DIC(19,8914,1,1,0)="Prints the demographics for a survey."
^DIC(19,8914,25)="QAPDEMS"
^DIC(19,8914,"U")="PRINT STATISTICS BY A DEMOGRAP"
^DIC(19,8915,0)="QAP POPULATE DEMOGRAPHIC FILE^Populate the Demographic Reference File^Option has been placed out of order^R^.5^QAP MANAGER^^^^^^268"
^DIC(19,8915,1,0)="^^2^2^2941116^^"
^DIC(19,8915,1,1,0)="Allows entry of files into the DEMOGRAPHIC REFERENCE file, which then may"
^DIC(19,8915,1,2,0)="be selected for demographic purposes."
^DIC(19,8915,25)="QAPFILE"
^DIC(19,8915,"U")="POPULATE THE DEMOGRAPHIC REFER"
^DIC(19,8916,0)="QAP RELEASE/DISABLE A SURVEY^Release/Disable a Survey for Participation^Option has been placed out of order^R^.5^^^^^^^268"
^DIC(19,8916,1,0)="^^2^2^2950102^^"
^DIC(19,8916,1,1,0)="This option will release (open) a survey to participants.  It is usually "
^DIC(19,8916,1,2,0)="kept closed until it is reviewed for accuracy."
^DIC(19,8916,25)="QAPRELS"
^DIC(19,8916,"U")="RELEASE/DISABLE A SURVEY FOR P"
^DIC(19,8917,0)="QAP PRINT ALL INDIV RESPONSES^Print all Survey Responses Individually^Option has been placed out of order^R^.5^^^^^^^268"
^DIC(19,8917,1,0)="^^5^5^2950206^"
^DIC(19,8917,1,1,0)="This option will print ALL reponses to a particular survey individually."
^DIC(19,8917,1,2,0)=" "
^DIC(19,8917,1,3,0)="Each response will be treated as a separate printout and will include all"
^DIC(19,8917,1,4,0)="answers (true, false, multiple choice, word processing) given by the"
^DIC(19,8917,1,5,0)="respondents."
^DIC(19,8917,25)="QAPPRALL"
^DIC(19,8917,"U")="PRINT ALL SURVEY RESPONSES IND"
^DIC(19,8918,0)="QAP USER PRINT HARDCOPY^User Hardcopy Print of Survey^Option has been placed out of order^R^.5^^^^^^^268"
^DIC(19,8918,1,0)="^^2^2^2950206^"
^DIC(19,8918,1,1,0)="This option will allow the survey participant to print a hardcopy of the"
^DIC(19,8918,1,2,0)="survey before he actually takes it."
^DIC(19,8918,25)="QAPPTUSR"
^DIC(19,8918,"U")="USER HARDCOPY PRINT OF SURVEY"
^DIC(19,8919,0)="QAP EXPORT A SURVEY^Export a Survey^Option has been placed out of order^R^.5^^^^^^^268"
^DIC(19,8919,1,0)="^^2^2^2950215^"
^DIC(19,8919,1,1,0)="This option allows the creator/author of a survey to export it to another"
^DIC(19,8919,1,2,0)="site.  All that is needed is to select a survey."
