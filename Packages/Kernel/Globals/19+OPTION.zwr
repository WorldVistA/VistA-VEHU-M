^DIC(19,3113,"U")="MANAGEMENT REPORTS (IV)"
^DIC(19,3115,0)="PSJI RECOMPILE^Recompile Stats File (IV)^^A^11712^^^^^^^115^^1^1"
^DIC(19,3115,1,0)="^^2^2^2991006^^^^"
^DIC(19,3115,1,1,0)="  Allows the statistics file to be recompiled for a given drug within a "
