^DIC(19,16893,0)="EHM-01714^List Membership by Class^^A^1^^^^^^^^^1^^"
^DIC(19,16893,1,0)="^^3^3^3240328^^^^"
^DIC(19,16893,1,1,0)="This option allows review, addition, editing, and removal of individual"
^DIC(19,16893,1,2,0)="members to and from User Classes."
^DIC(19,16893,1,3,0)="Cloned from ""USR LIST MEMBERSHIP BY CLASS"" option."
