^DIC(19,13056,1,1,0)="This option provides the extract manager the ability to extract blood bank"
^DIC(19,13056,1,2,0)="data for a selected date range. This data is stored in the BLOOD BANK"
^DIC(19,13056,1,3,0)="EXTRACT file (#727.829) until the data is transmitted to the commercial"
^DIC(19,13056,1,4,0)="vendor."
^DIC(19,13056,25)="BEG^ECXLBB1"
^DIC(19,13056,"U")="BLOOD BANK EXTRACT"
^DIC(19,13057,0)="ECX LBB PRE-EXTRACT^LBB Pre-Extract Audit Report^^R^10000000020^^^^^^^513^^"
^DIC(19,13057,1,0)="^19.06^5^5^3041213^^"
^DIC(19,13057,1,1,0)="This report is to provide DSS on-site support with a list of unmatched "
^DIC(19,13057,1,2,0)="blood products.  The report will contain those records that do not have a "
^DIC(19,13057,1,3,0)="value in either the DSS Product Dept or DSS IP # fields.  The result "
^DIC(19,13057,1,4,0)="report will enable the DSS on-site support team to correct the unmatched "
^DIC(19,13057,1,5,0)="blood products prior to running the LBB Extract."
^DIC(19,13057,20)=""
^DIC(19,13057,25)="ECXPLBB"
^DIC(19,13057,"U")="LBB PRE-EXTRACT AUDIT REPORT"
