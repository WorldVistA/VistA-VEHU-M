^DIC(19,16826,0)="EHM-01647^Copy Location List^^R^1^^^^^^^534^^^^"
^DIC(19,16826,1,0)="^19.06^13^13^3240328^^"
^DIC(19,16826,1,1,0)="This option allows the user to copy an existing location list into a"
^DIC(19,16826,1,2,0)="new location list; file #810.9.  The original location list to be"
^DIC(19,16826,1,3,0)="copied is selected first.  If the original location list is "
^DIC(19,16826,1,4,0)="prefixed with ""VA-"", the ""VA-"" will be stripped off the name"
^DIC(19,16826,1,5,0)="automatically to create the name for the new location list entry. "
^DIC(19,16826,1,6,0)="The new name must be unique.  If the new name is not unique, the"
^DIC(19,16826,1,7,0)="user must enter a unique name for the new location list entry.  If"
^DIC(19,16826,1,8,0)="no name is provided, the new entry will not be created.  Once a new"
^DIC(19,16826,1,9,0)="name is defined for the new location list entry, the new location"
^DIC(19,16826,1,10,0)="list entry can be edited to reflect the local location list"
^DIC(19,16826,1,11,0)="definition."
^DIC(19,16826,1,12,0)=""
^DIC(19,16826,1,13,0)="Cloned from ""PXRM LOCATION LIST COPY"" option."
^DIC(19,16826,3)=""
^DIC(19,16826,25)="COPYLL^PXRMCOPY"
^DIC(19,16826,"U")="COPY LOCATION LIST"
