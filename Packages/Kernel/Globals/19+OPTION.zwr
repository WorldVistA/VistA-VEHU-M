^DIC(19,14502,1,0)="^^7^7^3160311^"
^DIC(19,14502,1,1,0)="This option provides the capability to issue prosthetics stock that is"
^DIC(19,14502,1,2,0)="maintained by the IFCAP Generic Inventory Package (GIP).  This option"
^DIC(19,14502,1,3,0)="will automatically update inventory in IFCAP GIP.  However, when the "
^DIC(19,14502,1,4,0)="items issued are from an INVENTORY POINT that is linked to a Point of"
^DIC(19,14502,1,5,0)="Use (POU) supply cabinet then this option does not update the inventory,"
^DIC(19,14502,1,6,0)="since these are special cabinets that automatically update GIP inventory"
^DIC(19,14502,1,7,0)="balances, via HL7 messaging, when stock is removed."
^DIC(19,14502,10.1)="GIP Issue Stock"
