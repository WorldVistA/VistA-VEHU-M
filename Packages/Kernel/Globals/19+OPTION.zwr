^DIC(19,4020,"U")="AUTOPSY SUPPLEMENTARY REPORT"
^DIC(19,4021,0)="LRAC PURGE^Purge the Cumulative file^^R^.5^LRSUPER^^^^^^26"
^DIC(19,4021,1,0)="^^4^4^2881102^^^^"
^DIC(19,4021,1,1,0)="This option should be queued to run during an off-peak time and not while"
^DIC(19,4021,1,2,0)="the cumulative is running.  It will determine which entries can be cleaned"
^DIC(19,4021,1,3,0)="out of the cumulative file, using the # of days entered in the ""GRACE"
^DIC(19,4021,1,4,0)="PERIOD FOR CUMULATIVE"" field in the Laboratory Site file."
^DIC(19,4021,25)="QUEUE^LRACP"
^DIC(19,4021,"U")="PURGE THE CUMULATIVE FILE"
