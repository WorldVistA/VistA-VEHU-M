^DIC(19,9452,0)="PRCP IK MENU^Instrument Kit Menu^^M^11740^^^^^^^"
^DIC(19,9452,1,0)="^^2^2^2940126^^"
^DIC(19,9452,1,1,0)="This is the main menu for the primary and secondary inventory point"
^DIC(19,9452,1,2,0)="instrument kit system."
