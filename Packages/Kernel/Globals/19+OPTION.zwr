^DIC(19,13727,10,"B",13750,2)=""
^DIC(19,13727,10,"B",13751,3)=""
^DIC(19,13727,10,"C","CONV",2)=""
^DIC(19,13727,10,"C","POST",3)=""
^DIC(19,13727,10,"C","PRE",1)=""
^DIC(19,13727,99)="61564,56794"
^DIC(19,13727,99.1)="60198,14408"
^DIC(19,13727,"U")="VBECS DATA MATCHING/CONVERSION"
^DIC(19,13728,0)="VBEC DELETE EXTRACTED DATA^Delete all Blood Bank Data in Temporary Globals^^R^1^^^^^^^^^"
^DIC(19,13728,1,0)="^19.06^10^10^3050809^^^^"
^DIC(19,13728,1,1,0)="This option deletes the site's production account of the ^TMP(""VBEC""*,$J) "
^DIC(19,13728,1,2,0)="name spaced global.  This deletes at the namespace level without regard to"
^DIC(19,13728,1,3,0)="the job number ($J).  The data deleted is temporarily staged data "
^DIC(19,13728,1,4,0)="extracted from VistA Blood Bank prior to writing the data out to system "
^DIC(19,13728,1,5,0)="host files.  The temporary staging global is used to accumulate data, and "
^DIC(19,13728,1,6,0)="prepare it appropriate for relational tables."
^DIC(19,13728,1,7,0)=" "
^DIC(19,13728,1,8,0)="When running the database conversion features in a test mode, this option "
^DIC(19,13728,1,9,0)="must be run prior to running the data conversion option.  It cleans out "
^DIC(19,13728,1,10,0)="the previously extracted data, so that test results will be accurate."
^DIC(19,13728,20)=""
^DIC(19,13728,25)="DELETE^VBECDCU(0)"
^DIC(19,13728,"U")="DELETE ALL BLOOD BANK DATA IN "
^DIC(19,13729,0)="VBEC DELETE SYSTEM LEVEL FILES^Delete Blood Bank Data in System Level Files^^R^1^^^^^^^^^"
^DIC(19,13729,1,0)="^^11^11^3050215^"
^DIC(19,13729,1,1,0)="This option can be used while testing the data base conversion to delete "
^DIC(19,13729,1,2,0)="the host system files to which the VistA Blood Bank conversion data has "
^DIC(19,13729,1,3,0)="been written.  This makes it possible to retest and rewrite these files "
^DIC(19,13729,1,4,0)="through the data conversion option, ensuring accurate test results."
^DIC(19,13729,1,5,0)=" "
^DIC(19,13729,1,6,0)="In a production environment, these files should NOT be deleted "
^DIC(19,13729,1,7,0)="immediately after the data conversion is complete.  They should be left "
^DIC(19,13729,1,8,0)="in place for enough time to guarantee that the there are no data "
^DIC(19,13729,1,9,0)="conversion problems on the VBECS side.  These files can be used by "
^DIC(19,13729,1,10,0)="programmers in debugging, to determine whether there are problems due to"
^DIC(19,13729,1,11,0)="converted data."
^DIC(19,13729,20)=""
^DIC(19,13729,25)="DEL^VBECDCU2"
^DIC(19,13729,99)="59260,41339"
^DIC(19,13729,"U")="DELETE BLOOD BANK DATA IN SYST"
^DIC(19,13730,0)="VBEC DATA CONV. TO HOST FILES^Convert VistA Blood Bank data to host files^^R^1^^^^^^^"
^DIC(19,13730,1,0)="^19.06^7^7^3050830^^^^"
^DIC(19,13730,1,1,0)="This option will collect legacy VistA Blood Bank data and move it to host"
^DIC(19,13730,1,2,0)="system files. A separate process, outside of the scope of the VistA side "
^DIC(19,13730,1,3,0)="of the data conversion, will transfer those host files to VBECS tables.  "
^DIC(19,13730,1,4,0)=" "
^DIC(19,13730,1,5,0)="The data matching work must be complete before this option can be run. "
^DIC(19,13730,1,6,0)="This option uses the VistA Blood Bank data and the matching files to "
^DIC(19,13730,1,7,0)="determine data values to write to host system files."
^DIC(19,13730,25)="EN^VBECDC01(1)"
^DIC(19,13730,"U")="CONVERT VISTA BLOOD BANK DATA "
^DIC(19,13731,0)="VBEC DATA VALIDATION^Run Legacy VistA Blood Bank Data Validation^^R^1^^^^^^^"
^DIC(19,13731,1,0)="^19.06^4^4^3050607^^"
^DIC(19,13731,1,1,0)="This option performs a data validation check on legacy VistA Blood Bank"
^DIC(19,13731,1,2,0)="data based on pre-defined business rules.  If there are issues with"
^DIC(19,13731,1,3,0)="invalid data, they'll need to be resolved before data can be converted to"
^DIC(19,13731,1,4,0)="VBECS table attributes."
^DIC(19,13731,25)="EN^VBECDC01(0)"
^DIC(19,13731,"U")="RUN LEGACY VISTA BLOOD BANK DA"
^DIC(19,13732,0)="VBEC SITE PARAMETER ENTER/EDIT^Enter/Edit Site Parameter Data ^^R^1^^^^^^^"
^DIC(19,13732,1,0)="^19.06^5^5^3051011^^^"
^DIC(19,13732,1,1,0)="This option allows the user to input the name of the facility, the "
^DIC(19,13732,1,2,0)="default directory where the system level data extract files are to "
^DIC(19,13732,1,3,0)="reside, and the VBECS mail group where data conversion information is to "
^DIC(19,13732,1,4,0)="be routed. Sites must assign users to the mail group in order to receive "
^DIC(19,13732,1,5,0)="information."
^DIC(19,13732,25)="EN^VBECDCSP"
^DIC(19,13732,"U")="ENTER/EDIT SITE PARAMETER DATA"
^DIC(19,13733,0)="VBEC INVALID DATA REPORT^Invalid Blood Bank Data Report^^R^1^^^^^^^"
^DIC(19,13733,1,0)="^19.06^9^9^3051101^^^"
^DIC(19,13733,1,1,0)="This option displays or prints the results of the VistA Blood Bank data"
^DIC(19,13733,1,2,0)="pre-conversion integrity check.  It should be used as necessary while "
^DIC(19,13733,1,3,0)="performing data matching work prior to data conversion.  Problems listed "
^DIC(19,13733,1,4,0)="on the report should be addressed before continuing with the data "
^DIC(19,13733,1,5,0)="conversion.  Unmatched data will not be converted."
^DIC(19,13733,1,6,0)=" "
^DIC(19,13733,1,7,0)="This report should also be run immediately before data conversion to "
^DIC(19,13733,1,8,0)="verify that all desired matches have been made, and data issues have been "
^DIC(19,13733,1,9,0)="addressed."
^DIC(19,13733,25)="EN^VBECDCR"
^DIC(19,13733,"U")="INVALID BLOOD BANK DATA REPORT"
^DIC(19,13734,0)="VBEC STANDARD ANTIBODIES^Standard Antigens and Antibodies Print^^R^1^^^^^^^^^1^1"
^DIC(19,13734,1,0)="^^1^1^3020604^"
^DIC(19,13734,1,1,0)="This option displays the list of standard antigens and antibodies."
^DIC(19,13734,15)="K VBECFILE"
^DIC(19,13734,20)="S VBECFILE=61.3"
^DIC(19,13734,25)="EN^VBECDCST"
^DIC(19,13734,668000,0)="^19.0668"
^DIC(19,13734,"U")="STANDARD ANTIGENS AND ANTIBODI"
^DIC(19,13735,0)="VBEC STANDARD TRANS. REACTIONS^Standard Transfusion Reactions Print^^R^1^^^^^^^^^1^1"
^DIC(19,13735,1,0)="^^1^1^3020604^"
^DIC(19,13735,1,1,0)="This option displays the list of standard transfusion reactions."
^DIC(19,13735,15)="K VBECFILE"
^DIC(19,13735,20)="S VBECFILE=65.4"
^DIC(19,13735,25)="EN^VBECDCST"
^DIC(19,13735,"U")="STANDARD TRANSFUSION REACTIONS"
^DIC(19,13736,0)="VBEC PRINT SQL/VISTA MATCHES^Matched Blood Bank data report^^R^1^^^^^^^"
^DIC(19,13736,1,0)="^^2^2^3020923^"
^DIC(19,13736,1,1,0)="This option displays all of the VistA data elements matched to their "
^DIC(19,13736,1,2,0)="equivalent VBECS entries."
^DIC(19,13736,25)="EN^VBECDCMP"
^DIC(19,13736,"U")="MATCHED BLOOD BANK DATA REPORT"
^DIC(19,13737,0)="VBEC UNMATCHED VISTA DATA RPT^Unmatched VistA Blood Bank Data Report^^R^1^^^^^^^"
^DIC(19,13737,1,0)="^^5^5^3021117^"
^DIC(19,13737,1,1,0)="This option displays all of the VistA data elements that have not yet "
^DIC(19,13737,1,2,0)="been matched to VBECS entries.  This option should be used during the "
^DIC(19,13737,1,3,0)="manual data matching work prior to data conversion to determine which "
^DIC(19,13737,1,4,0)="entries still need to be matched.  If not matched, the entry will not be "
^DIC(19,13737,1,5,0)="converted to VBECS."
^DIC(19,13737,25)="EN^VBECDCNM"
^DIC(19,13737,"U")="UNMATCHED VISTA BLOOD BANK DAT"
^DIC(19,13738,0)="VBEC UNDO ANTIBODY/ANTIGEN^Undo all antibody/antigen matches^^R^1^^^^^^^"
^DIC(19,13738,1,0)="^^2^2^3020826^"
^DIC(19,13738,1,1,0)="Use this option with caution.  It deletes all the matches between the"
^DIC(19,13738,1,2,0)="VistA antibody/antigen records and the matched antibody/antigen records."
^DIC(19,13738,25)="EN613^VBECDCM1"
^DIC(19,13738,"U")="UNDO ALL ANTIBODY/ANTIGEN MATC"
^DIC(19,13739,0)="VBEC UNDO TRANS. REACTIONS^Undo all transfusion reaction matches^^R^1^^^^^^^"
^DIC(19,13739,1,0)="^19.06^3^3^3040823^^"
^DIC(19,13739,1,1,0)="Use this option with caution.  It deletes all the mappings between the"
^DIC(19,13739,1,2,0)="VistA transfusion reaction records and the matched transfusion reaction"
^DIC(19,13739,1,3,0)="records."
^DIC(19,13739,25)="EN654^VBECDCM1"
^DIC(19,13739,"U")="UNDO ALL TRANSFUSION REACTION "
^DIC(19,13740,0)="VBEC UNDO SINGLE MATCHING^Unmatch a single matched VistA record ^^R^1^^^^^^^"
^DIC(19,13740,1,0)="^^2^2^3020827^"
^DIC(19,13740,1,1,0)="This option allows the user to delete a single VistA record that is"
^DIC(19,13740,1,2,0)="matched."
^DIC(19,13740,25)="SINGLE^VBECDCM1"
^DIC(19,13740,"U")="UNMATCH A SINGLE MATCHED VISTA"
^DIC(19,13741,0)="VBEC DELETE ANTIBODY/ANTIGEN^Delete Antibody/Antigen temporary matching files ^^R^1^^^^^^^"
^DIC(19,13741,1,0)="^19.06^4^4^3040727^^"
^DIC(19,13741,1,1,0)="Deletes all antibody/antigen data from the VBECS MATCHING TABLE (#6005)"
^DIC(19,13741,1,2,0)="file.  File 6005 is a temporary file, designed for population and use for "
^DIC(19,13741,1,3,0)="the purpose of matching VistA data to standard data prior to database "
^DIC(19,13741,1,4,0)="conversion."
^DIC(19,13741,25)="ENP613^VBECDCM1"
^DIC(19,13741,"U")="DELETE ANTIBODY/ANTIGEN TEMPOR"
^DIC(19,13742,0)="VBEC DELETE TRANS. REACTION^Delete Transfusion Reaction temporary match files^^R^1^^^^^^^"
^DIC(19,13742,1,0)="^19.06^4^4^3040823^^^"
^DIC(19,13742,1,1,0)="Deletes transfusion reaction data from the VBECS MATCHING TABLE (#6005)"
^DIC(19,13742,1,2,0)="file. File 6005 is a temporary file designed for population and use for "
^DIC(19,13742,1,3,0)="the purpose of matching VistA data to standard data prior to database "
^DIC(19,13742,1,4,0)="conversion."
^DIC(19,13742,25)="ENP654^VBECDCM1"
^DIC(19,13742,"U")="DELETE TRANSFUSION REACTION TE"
^DIC(19,13743,0)="VBEC UPDATE ANTIBODY/ANTIGEN^Update antibody/antigen records in matching file^^R^1^^^^^^^"
^DIC(19,13743,1,0)="^19.06^7^7^3021126^^"
^DIC(19,13743,1,1,0)="Update VistA antibody/antigen data in our VBECS MATCHING TABLE (#6005)"
^DIC(19,13743,1,2,0)="file.  The data on the VistA side may have changed due to the addition,"
^DIC(19,13743,1,3,0)="deletion, or the editing of data.  This option non-destructively adds "
^DIC(19,13743,1,4,0)="anything added to VistA since the last creation or update.  The report of "
^DIC(19,13743,1,5,0)="unmatched items, and the report of matched items should be run after "
^DIC(19,13743,1,6,0)="running this option to get a  list of new matching work created as a "
^DIC(19,13743,1,7,0)="result of the update."
^DIC(19,13743,25)="EN613^VBECDCM0"
^DIC(19,13743,"U")="UPDATE ANTIBODY/ANTIGEN RECORD"
^DIC(19,13744,0)="VBEC UPDATE TRANS. REACT. REC^Update trans. reaction records in matching file^^R^1^^^^^^^"
^DIC(19,13744,1,0)="^19.06^7^7^3051011^^"
^DIC(19,13744,1,1,0)="Update VistA transfusion reaction data in our VBECS MATCHING TABLE (#6005)"
^DIC(19,13744,1,2,0)="file.  The data on the VistA side may have changed due to the addition,"
^DIC(19,13744,1,3,0)="deletion, or the editing of data. This option non-destructively adds"
^DIC(19,13744,1,4,0)="anything added to VistA since the last creation or update.  The report of "
^DIC(19,13744,1,5,0)="unmatched items, and the report of matched items should be run after "
^DIC(19,13744,1,6,0)="running this option to get a  list of new matching work created as a "
^DIC(19,13744,1,7,0)="result of the update."
^DIC(19,13744,25)="EN654^VBECDCM2"
^DIC(19,13744,"U")="UPDATE TRANS. REACTION RECORDS"
^DIC(19,13745,0)="VBEC MATCH ANTIBODY/ANTIGEN^Match VistA antibody/antigen data^^R^1^^^^^^^"
^DIC(19,13745,1,0)="^19.06^5^5^3050913^^^^"
^DIC(19,13745,1,1,0)="This option is used to match VistA antibody/antigen data to standardized"
^DIC(19,13745,1,2,0)="entries. The matches will be used during the data conversion to determine "
^DIC(19,13745,1,3,0)="which data values to write to host system files.  The standardized entries"
^DIC(19,13745,1,4,0)="will be used in VBECS.  Each VistA entry must be matched to a standard "
^DIC(19,13745,1,5,0)="entry.  If not matched, the VistA data will not be converted."
^DIC(19,13745,25)="EN613^VBECDCM"
^DIC(19,13745,"U")="MATCH VISTA ANTIBODY/ANTIGEN D"
^DIC(19,13746,0)="VBEC MATCH TRANSFUS REACTION^Match VistA transfusion reaction data^^R^1^^^^^^^"
^DIC(19,13746,1,0)="^19.06^6^6^3051011^^^^"
^DIC(19,13746,1,1,0)="This option is used to match VistA transfusion reaction types to"
^DIC(19,13746,1,2,0)="standardized entries. The matches will be used during the data conversion"
^DIC(19,13746,1,3,0)="to determine which data values to write to host system files.  The"
^DIC(19,13746,1,4,0)="standardized entries will be used in VBECS.  Each VistA entry must be"
^DIC(19,13746,1,5,0)="matched to a standard entry.  If not matched, the VistA data will not be"
^DIC(19,13746,1,6,0)="converted."
^DIC(19,13746,25)="EN654^VBECDCM"
^DIC(19,13746,"U")="MATCH VISTA TRANSFUSION REACTI"
^DIC(19,13747,0)="VBEC BB COMPONENTS DISABLE^Disable VistA Blood Bank components^^R^1^^^^^^^^^1^1"
^DIC(19,13747,1,0)="^^5^5^3021117^"
^DIC(19,13747,1,1,0)="This option will allow the user to disable VistA Blood Bank options,"
^DIC(19,13747,1,2,0)="files, and fields. The program automatically disables all options, files,"
^DIC(19,13747,1,3,0)="and fields necessary so that users cannot enter or edit data in the VistA"
^DIC(19,13747,1,4,0)="Blood Bank application.  This option should be run just before starting"
^DIC(19,13747,1,5,0)="the data conversion."
^DIC(19,13747,15)="K VBECECHO"
^DIC(19,13747,20)="S VBECECHO="""""
^DIC(19,13747,25)="EN^VBECDC19(1)"
^DIC(19,13747,"U")="DISABLE VISTA BLOOD BANK COMPO"
^DIC(19,13748,0)="VBEC BB COMPONENTS ENABLE^Enable VistA Blood Bank components^^R^1^^^^^^^^^1^1"
^DIC(19,13748,1,0)="^^10^10^3050215^"
^DIC(19,13748,1,1,0)="This option will allow the user to re-enable specific VistA Blood Bank"
^DIC(19,13748,1,2,0)="options, files, and fields that have been disabled by running the option "
^DIC(19,13748,1,3,0)="to Disable VistA Blood Bank components.  It should NOT be run on a "
^DIC(19,13748,1,4,0)="production system after the data conversion is started.  The VistA Blood "
^DIC(19,13748,1,5,0)="Bank options should remain disabled after the data conversion. "
^DIC(19,13748,1,6,0)=" "
^DIC(19,13748,1,7,0)="This option can be run when operating in test mode, after testing the "
^DIC(19,13748,1,8,0)="database conversion on a test system.  It will make the VistA Blood Bank "
^DIC(19,13748,1,9,0)="menus and options accessible once again to anyone testing the data "
^DIC(19,13748,1,10,0)="conversion."
^DIC(19,13748,15)="K VBECECHO"
^DIC(19,13748,20)="S VBECECHO="""""
^DIC(19,13748,25)="EN^VBECDC19(0)"
^DIC(19,13748,"U")="ENABLE VISTA BLOOD BANK COMPON"
^DIC(19,13749,0)="VBEC PRE-CONVERSION UTILITIES^Utilities used prior to the data conversion^^M^1^^^^^^^"
^DIC(19,13749,1,0)="^19.06^7^7^3040128^^^"
^DIC(19,13749,1,1,0)="This menu contains options that must be used prior to data conversion. "
^DIC(19,13749,1,2,0)="Work prior to data conversion consists of matching VistA Blood Bank data "
^DIC(19,13749,1,3,0)="to standard data, entering data conversion site parameters, and validating"
^DIC(19,13749,1,4,0)="data matches. Data to be matched includes antibodies/antigens, blood "
^DIC(19,13749,1,5,0)="products, blood suppliers, and transfusion reaction types. The options in "
^DIC(19,13749,1,6,0)="this menu automatically set up temporary files containing the VistA Blood "
^DIC(19,13749,1,7,0)="Bank data that must be matched, and facilitate manual matching."
^DIC(19,13749,10,0)="^19.01IP^10^8"
^DIC(19,13749,10,1,0)=13731
^DIC(19,13749,10,2,0)=13732
^DIC(19,13749,10,3,0)=13737
^DIC(19,13749,10,4,0)=13733
^DIC(19,13749,10,5,0)=13736
^DIC(19,13749,10,6,0)=13740
^DIC(19,13749,10,7,0)="13753^AA"
^DIC(19,13749,10,10,0)="13752^TR^"
^DIC(19,13749,10,"B",13731,1)=""
^DIC(19,13749,10,"B",13732,2)=""
^DIC(19,13749,10,"B",13733,4)=""
^DIC(19,13749,10,"B",13736,5)=""
^DIC(19,13749,10,"B",13737,3)=""
^DIC(19,13749,10,"B",13740,6)=""
^DIC(19,13749,10,"B",13752,10)=""
^DIC(19,13749,10,"B",13753,7)=""
^DIC(19,13749,10,"C","AA",7)=""
^DIC(19,13749,10,"C","TR",10)=""
^DIC(19,13749,99)="61564,56794"
^DIC(19,13749,"U")="UTILITIES USED PRIOR TO THE DA"
^DIC(19,13750,0)="VBEC CONVERSION UTILITIES^Utilities used for the data conversion^^M^1^^^^^^^"
^DIC(19,13750,1,0)="^19.06^14^14^3030701^^^"
^DIC(19,13750,1,1,0)="This menu contains options used during data conversion from VistA Blood "
^DIC(19,13750,1,2,0)="Bank to VBECS.  All data matching must be accounted for prior to running "
^DIC(19,13750,1,3,0)="the data conversion.  The data conversion moves VistA Blood Bank data to "
^DIC(19,13750,1,4,0)="temporary host system files, using match data stored in other temporary "
^DIC(19,13750,1,5,0)="files to determine values for blood products, transfusion reactions, blood"
^DIC(19,13750,1,6,0)="suppliers, antibodies and antigens."
^DIC(19,13750,1,7,0)=" "
^DIC(19,13750,1,8,0)="The VistA Blood Bank options and menus must be placed out of order before "
^DIC(19,13750,1,9,0)="running the data conversion.  This prevents blood bank users from "
^DIC(19,13750,1,10,0)="entering and editing data during the data conversion."
^DIC(19,13750,1,11,0)=" "
^DIC(19,13750,1,12,0)="The data conversion functionality does not move data into the VBECS "
^DIC(19,13750,1,13,0)="tables.  Moving data into the VBECS tables is outside of the scope of the "
^DIC(19,13750,1,14,0)="VistA side of the data conversion."
^DIC(19,13750,10,0)="^19.01IP^1^1"
^DIC(19,13750,10,1,0)="13730^^"
^DIC(19,13750,10,"B",13730,1)=""
^DIC(19,13750,99)="61564,56794"
^DIC(19,13750,"U")="UTILITIES USED FOR THE DATA CO"
^DIC(19,13751,0)="VBEC POST-CONVERSION UTILITIES^Utilities used after the data conversion has run^^M^1^^^^^^^"
^DIC(19,13751,1,0)="^19.06^12^12^3040414^^^^"
^DIC(19,13751,1,1,0)="This menu contains options that should be run after the data conversion"
^DIC(19,13751,1,2,0)="has successfully completed. They can also be used to test the data "
^DIC(19,13751,1,3,0)="conversion repeatedly prior to running it in a production account.  These "
^DIC(19,13751,1,4,0)="options perform clean-up functions, such as deleting data in temporary "
^DIC(19,13751,1,5,0)="files used to stage the conversion data prior to writing it out to host "
^DIC(19,13751,1,6,0)="system files, and deleting the host system files.  If running in test "
^DIC(19,13751,1,7,0)="mode, the option to enable VistA Blood Bank options can be run to make "
^DIC(19,13751,1,8,0)="the options accessible to users again after the data conversion is run.  "
^DIC(19,13751,1,9,0)="If running on a production system, the option to enable VistA Blood Bank "
^DIC(19,13751,1,10,0)="options should NOT be run after the data conversion because users should "
^DIC(19,13751,1,11,0)="never be allowed to enter data on the VistA Blood Bank system after the "
^DIC(19,13751,1,12,0)="production data conversion is run."
^DIC(19,13751,10,0)="^19.01IP^7^7"
^DIC(19,13751,10,2,0)=13728
^DIC(19,13751,10,3,0)=13748
^DIC(19,13751,10,4,0)=13747
^DIC(19,13751,10,5,0)=13729
^DIC(19,13751,10,6,0)="13754^HIST"
^DIC(19,13751,10,7,0)="13755^STAT"
