^DIC(19,13727,0)="VBEC MAIN MENU^VBECS Data Matching/Conversion Menu^^M^1^LRLIASON^^^^^^"
^DIC(19,13727,1,0)="^19.06^4^4^3040128^^^"
^DIC(19,13727,1,1,0)="This is the top level menu to facilitate data matching and data conversion"
^DIC(19,13727,1,2,0)="from VistA Blood Bank v5.2 files to VistA Blood Establishment Computer"
^DIC(19,13727,1,3,0)="Software (VBECS) tables.  It is the top of a menu tree to which all other "
^DIC(19,13727,1,4,0)="menus are attached."
^DIC(19,13727,10,0)="^19.01IP^3^3"
^DIC(19,13727,10,1,0)="13749^PRE^1"
^DIC(19,13727,10,2,0)="13750^CONV^2"
^DIC(19,13727,10,3,0)="13751^POST^3"
