^DIC(19,14996,0)="TIU COPY/PASTE TRACKING REPORT^Copy/Paste Tracking Report (Export)^^R^1^^^^^^^516^^^^^"
^DIC(19,14996,1,0)="^^4^4^3210201^"
^DIC(19,14996,1,1,0)="This option allows a user to run the TIU COPY/PASTE TRACKING REPORT. "
^DIC(19,14996,1,2,0)="This report is designed to create a carat (^) delimited output for "
^DIC(19,14996,1,3,0)="export. This report may take a considerable amount of time to complete. It"
^DIC(19,14996,1,4,0)="is HIGHLY recommended to queue this report!"
^DIC(19,14996,10.1)=""
^DIC(19,14996,20)=""
^DIC(19,14996,25)="EN^TIUCOPR"
^DIC(19,14996,26)=""
^DIC(19,14996,99)="65772,84474"
^DIC(19,14996,"U")="COPY/PASTE TRACKING REPORT (EX"
^DIC(19,14996,"W")="^"
^DIC(19,14997,0)="TIU ANALYZE/UPDATE FILE 8927^Analyze/Update the TIU TEMPLATE File^^R^1^^^^^^^"
^DIC(19,14997,1,0)="^19.06^9^9^3210519^^^^"
^DIC(19,14997,1,1,0)="This option provides functionality to allow a user to find entries in "
^DIC(19,14997,1,2,0)="File #8927 that contain boilerplate lines of text >80 characters and "
^DIC(19,14997,1,3,0)="entries that do not have any items, text, or dialogs, etc."
^DIC(19,14997,1,4,0)=" "
^DIC(19,14997,1,5,0)="The generated report may be viewed, printed, or emailed for verification "
^DIC(19,14997,1,6,0)="purposes."
^DIC(19,14997,1,7,0)=" "
^DIC(19,14997,1,8,0)="The user may also choose to update the entries in the file to fix long "
^DIC(19,14997,1,9,0)="lines and unlinked entries."
^DIC(19,14997,25)="EN^TIUFWRAP"
^DIC(19,14997,99.1)="65923,50064"
^DIC(19,14997,"U")="ANALYZE/UPDATE THE TIU TEMPLAT"
^DIC(19,14998,0)="OR CS ORDER ANOMALIES^Controlled Substance Order Anomalies^^R^1^^^^^^^"
^DIC(19,14998,1,0)="^^11^11^3200803^"
^DIC(19,14998,1,1,0)="This report will find all orders for controlled substances for Schedule"
^DIC(19,14998,1,2,0)="2-5 medications that are missing a Digital Signature. All orders for these"
^DIC(19,14998,1,3,0)="controlled substances require a Digital Signature to comply with DEA"
^DIC(19,14998,1,4,0)="regulations. The purpose of this report is to determine the extent of this"
^DIC(19,14998,1,5,0)="problem in hopes to determine how these orders are placed into the system"
^DIC(19,14998,1,6,0)="without a Digital Signature.  "
^DIC(19,14998,1,7,0)="  "
^DIC(19,14998,1,8,0)="CPRS version 29 is when the ability to order Controlled Substances with"
^DIC(19,14998,1,9,0)="Digital Signatures began. This report looks up the date that CPRS v29 was"
^DIC(19,14998,1,10,0)="installed and presents that date as a default start date for the report. "
^DIC(19,14998,1,11,0)="Any date range can be entered to do the lookup."
^DIC(19,14998,25)="EN^ORS100C"
^DIC(19,14998,"U")="CONTROLLED SUBSTANCE ORDER ANO"
^DIC(19,14999,0)="ONCO RCRS EXTRACT^Create RCRS extract^^R^1^^^^^^^"
^DIC(19,14999,1,0)="^^1^1^3210812^"
^DIC(19,14999,1,1,0)="This option will create an RCRS (Rapid Cancer Reporting System) extract."
^DIC(19,14999,25)="EN1^ONCACD0(0,3)"
^DIC(19,14999,"U")="CREATE RCRS EXTRACT"
