^DIC(19,13463,0)="MAG IMAGE INDEX VAL CHECK^Check Image File for missing Index values^^R^10000000049^^^^^^^"
^DIC(19,13463,1,0)="^19.06^10^10^3051007^^"
^DIC(19,13463,1,1,0)="Starts or Resumes a check of all entries in the Image File."
^DIC(19,13463,1,2,0)="Checks for missing index values that are required."
^DIC(19,13463,1,3,0)="Checks for invalid Origin Index values."
^DIC(19,13463,1,4,0)="Checks for incorrectly stored pointers to CR when CT was intended."
^DIC(19,13463,1,5,0)="Checks for invalid associations between:"
^DIC(19,13463,1,6,0)="   Type, Procedure/Event and Specialty/SubSpecialty Index values"
^DIC(19,13463,1,7,0)="Checks for Image Groups with 1 image."
^DIC(19,13463,1,8,0)="Checks for Image Groups with 0 images."
^DIC(19,13463,1,9,0)="Checks for Images with missing Patient Pointer."
^DIC(19,13463,1,10,0)="Checks for Corrupt enties in Image File: No '0' node."
^DIC(19,13463,25)="CHECK^MAGGTUX"
^DIC(19,13463,"U")="CHECK IMAGE FILE FOR MISSING I"
^DIC(19,13464,0)="MAG IMAGE INDEX VAL FIX^Fix missing Index values in Image File^^R^10000000049^^^^^^^"
^DIC(19,13464,1,0)="^^14^14^3051007^"
^DIC(19,13464,1,1,0)="Starts or Resumes a process that will fix missing index terms and"
^DIC(19,13464,1,2,0)="certain invalid index terms."
^DIC(19,13464,1,3,0)="  "
^DIC(19,13464,1,4,0)="For missing index values that are required, values are Generated"
^DIC(19,13464,1,5,0)="and Commited to the database using image index conversion utilities."
^DIC(19,13464,1,6,0)="Fixes invalid entries for field Origin Index."
^DIC(19,13464,1,7,0)="Fixes incorrectly stored pointers to CR when CT was intended."
^DIC(19,13464,1,8,0)=" "
^DIC(19,13464,1,9,0)="Reports on invalid associations between:"
