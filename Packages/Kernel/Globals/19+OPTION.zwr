^DIC(19,12761,0)="XUSEC UP ARROW TERM REPORT^Up Arrow Delimited Termination Report^^R^10000000020^^^^^^^163^^1"
^DIC(19,12761,1,0)="^^4^4^3040423^"
^DIC(19,12761,1,1,0)="The report produced by this option is a up arrow(^) delimited termination "
^DIC(19,12761,1,2,0)="report that can be used is a spread sheet.  It is suggested that the "
^DIC(19,12761,1,3,0)="report be sent to an HFS device.  If the screen is used, it will require"
^DIC(19,12761,1,4,0)="132 column width."
^DIC(19,12761,20)="S XUSECU="""""
^DIC(19,12761,25)="EP1^XUSECAD"
^DIC(19,12761,"U")="UP ARROW DELIMITED TERMINATION"
^DIC(19,12762,0)="PX V File Repair^PCE V File Cross Reference Repair^^R^10000000020^^^^^^y^507"
^DIC(19,12762,1,0)="^^6^6^3031203^"
^DIC(19,12762,1,1,0)="This option provides a number of options that allow the user to"
^DIC(19,12762,1,2,0)=" both report and fix broken V File Cross References. The V Files include V"
^DIC(19,12762,1,3,0)=" PROVIDER (9000010.06), V CPT(9000010.18), diagnosis V POV (9000010.07), "
^DIC(19,12762,1,4,0)=" VISIT(9000010), V IMMUNIZATION(9000010.11), V SKIN TEST(9000010.12), V"
^DIC(19,12762,1,5,0)=" EXAM(9000010.13), V TREATMENT(9000010.15), V PATIENT ED(9000010.16), and V"
^DIC(19,12762,1,6,0)=" HEALTH FACTOR(9000010.23)."
^DIC(19,12762,10.1)="V File Repair"
^DIC(19,12762,25)="T^PXQUTL3"
^DIC(19,12762,"U")="PCE V FILE CROSS REFERENCE REP"
^DIC(19,12763,0)="IBJD PERCENT PREREGISTERED^Percentage of Patients Pre-Registered Report^^R^10000000020^^^^^^^192"
^DIC(19,12763,1,0)="^19.06^5^5^3040521^^^"
^DIC(19,12763,1,1,0)="This report provides number of patients treated, the number of"
^DIC(19,12763,1,2,0)="patients pre-registered, % of patients pre-registered, number of"
^DIC(19,12763,1,3,0)="patients pre-registered past the pre-registration time frame,"
^DIC(19,12763,1,4,0)="number of patients never pre-registered, the clinic exclusions,"
^DIC(19,12763,1,5,0)="and the eligibility exclusions."
^DIC(19,12763,25)="EN^IBJDIPR"
^DIC(19,12763,"U")="PERCENTAGE OF PATIENTS PRE-REG"
^DIC(19,12766,0)="DG PRINT PATIENT LABEL^Print Patient Label^^R^10000000020^^^^^^^114"
^DIC(19,12766,1,0)="^19.06^3^3^3040408^^"
^DIC(19,12766,1,1,0)="This option prints patient labels that contain the Patient Name, Social "
^DIC(19,12766,1,2,0)="Security Number, and Date of Birth.  An optional fourth line contains the "
^DIC(19,12766,1,3,0)="Inpatient Location of the patient."
^DIC(19,12766,25)="EN^DGPLBL"
^DIC(19,12766,"U")="PRINT PATIENT LABEL"
