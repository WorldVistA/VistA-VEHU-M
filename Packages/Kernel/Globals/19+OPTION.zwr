^DIC(19,8977,1,1,0)="To List Census file global [#41.9]"
^DIC(19,8977,25)="LRGLOBAL"
^DIC(19,8977,"U")="ZZCENSUS GLOBAL"
^DIC(19,8978,0)="XTRMONITOR^Monitor Routines for Changes^^R^1039^^^^^^^"
^DIC(19,8978,1,0)="^^8^8^2940825^^"
^DIC(19,8978,1,1,0)="This option is used to Schedule the XTRMON routine to Monitor routines"
^DIC(19,8978,1,2,0)="for changes.  It uses the Routine Monitor field in the KSP file to"
^DIC(19,8978,1,3,0)="control if all routines or just selected N-spaces should be monitored."
^DIC(19,8978,1,4,0)="The Checksum that is calculated is stored in the routine file along with"
^DIC(19,8978,1,5,0)="the date that it changed.  It also goes thru the routine file and"
^DIC(19,8978,1,6,0)="checks that all the routines are still in the UCI.  This will keep the"
^DIC(19,8978,1,7,0)="routine file current for KIDS.  The output of the routine is a Bulletin"
^DIC(19,8978,1,8,0)="(XTRMON) that is sent to the attached mail group."
^DIC(19,8978,25)="XTRMON"
^DIC(19,8978,200.9)="y"
^DIC(19,8978,"U")="MONITOR ROUTINES FOR CHANGES"
^DIC(19,8979,0)="XQALERT BY USER DELETE^Purge Alerts for a User^^R^1039^XQAL-DELETE^^^^^^"
^DIC(19,8979,1,0)="^^4^4^2940728^"
^DIC(19,8979,1,1,0)="This option is provided to permit users holding the correct key to delete"
^DIC(19,8979,1,2,0)="alerts for another user.  This is intended for when a user has been"
^DIC(19,8979,1,3,0)="inactive for a period of time (e.g., vacation, etc.) and has accumulated a"
^DIC(19,8979,1,4,0)="number of alerts which should not need processing."
^DIC(19,8979,25)="USERDEL^XQALERT"
^DIC(19,8979,"U")="PURGE ALERTS FOR A USER"
