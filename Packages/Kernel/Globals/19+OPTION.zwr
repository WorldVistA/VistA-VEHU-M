^DIC(19,10570,0)="LR LAB LIM FILE^Edit lab LIM file^^A^10958^LRLIASON^^^^^^^^1"
^DIC(19,10570,1,0)="^^2^2^2970826^^^"
^DIC(19,10570,1,1,0)="This option enables the Laboratory Information Manager (LIM) to"
^DIC(19,10570,1,2,0)="enter persons that receive location abbreviation messages."
^DIC(19,10570,20)="S DIE=67.11 D EN^DIB"
