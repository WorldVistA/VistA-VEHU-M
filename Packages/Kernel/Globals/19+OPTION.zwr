^DIC(19,6126,20)="D HDR^ENEQRP"
^DIC(19,6126,99)="57097,29941"
^DIC(19,6126,"U")="EQUIPMENT REPORTS"
^DIC(19,6127,0)="ENEQINV1^CMR Inventory (EIL)^^R^11740^^^^^^^33"
^DIC(19,6127,1,0)="^^11^11^2991012^"
^DIC(19,6127,1,1,0)="This option generates the Equipment Inventory Listing (EIL) report."
^DIC(19,6127,1,2,0)="Equipment that is belongs to the user-specified CMR and is accountable"
^DIC(19,6127,1,3,0)="will be printed on this report. A page suitable for the signature of the"
^DIC(19,6127,1,4,0)="Responsible Official is printed when the output is directed to a printer."
^DIC(19,6127,1,5,0)=" "
^DIC(19,6127,1,6,0)="Accountable equipment is equipment with an Investment Category of either"
^DIC(19,6127,1,7,0)="CAPITALIZED/ACCOUNTABLE or NOT CAPITALIZED/ACCOUNTABLE."
^DIC(19,6127,1,8,0)=" "
^DIC(19,6127,1,9,0)="See the Non-EIL Inventory report to print equipment that belongs to a CMR"
^DIC(19,6127,1,10,0)="but does not meet the other criteria for inclusion on the Equipment"
^DIC(19,6127,1,11,0)="Inventory Listing report."
^DIC(19,6127,25)="CMR^ENEQRPI"
^DIC(19,6127,99)="55693,39812"
^DIC(19,6127,"U")="CMR INVENTORY (EIL)"
^DIC(19,6128,0)="ENEQINV2^Equipment Category Inventory^^R^.5^^^^^^^"
^DIC(19,6128,1,0)="^^1^1^2880906^^"
^DIC(19,6128,1,1,0)="Inventory listing by device type (cf: File 6911)."
^DIC(19,6128,25)="DTYP^ENEQRPI"
^DIC(19,6128,"U")="EQUIPMENT CATEGORY INVENTORY"
^DIC(19,6129,0)="ENEQINV3^Location Inventory^^R^.5^^^^^^^"
^DIC(19,6129,1,0)="^^1^1^2880516^"
^DIC(19,6129,1,1,0)="Inventory listing by device location."
^DIC(19,6129,25)="LOC^ENEQRPI"
^DIC(19,6129,"U")="LOCATION INVENTORY"
^DIC(19,6130,0)="ENEQINV4^Using Service Inventory^^R^.5^^^^^^^"
^DIC(19,6130,1,0)="^^4^4^2920420^^"
^DIC(19,6130,1,1,0)="Inventory listing by using service.  Note that the using service"
^DIC(19,6130,1,2,0)="is not necessarily the owning service (ex: a VCR may be used in"
^DIC(19,6130,1,3,0)="Dental but owned by Medical Media Production).  Owning service"
^DIC(19,6130,1,4,0)="is established via the CMR."
^DIC(19,6130,25)="SRV^ENEQRPI"
^DIC(19,6130,"U")="USING SERVICE INVENTORY"
^DIC(19,6131,0)="ENEQINV5^Responsible Shop Inventory^^R^.5^^^^^^^"
^DIC(19,6131,1,0)="^^1^1^2880516^"
^DIC(19,6131,1,1,0)="Inventory listing by responsible shop."
^DIC(19,6131,25)="SHOP^ENEQRPI"
^DIC(19,6131,"U")="RESPONSIBLE SHOP INVENTORY"
^DIC(19,6132,0)="ENEQINV6^Use Status Inventory^^R^.5^^^^^^^"
^DIC(19,6132,1,0)="^^1^1^2880516^"
^DIC(19,6132,1,1,0)="Inventory listing by use status."
^DIC(19,6132,25)="STUS^ENEQRPI"
^DIC(19,6132,"U")="USE STATUS INVENTORY"
