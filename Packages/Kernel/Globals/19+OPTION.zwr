^DIC(19,7424,1,0)="^^3^3^2910417^^"
^DIC(19,7424,1,1,0)="Patients With Multiple Fall Outs:  Allows the user to choose a group "
^DIC(19,7424,1,2,0)="of monitors, range of dates and minimum number of fall outs that "
^DIC(19,7424,1,3,0)="should show up on the report."
