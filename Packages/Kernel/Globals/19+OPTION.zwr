^DIC(19,12899,0)="DG UNSUPPORTED CV END DATE RPT^Unsupported CV End Dates Report^^R^10000000020^^^^^^^114^y"
^DIC(19,12899,1,0)="^19.06^14^14^3040528^^"
^DIC(19,12899,1,1,0)="This option will produce a list of veterans with CV End Dates"
^DIC(19,12899,1,2,0)="that are not supported by Military Service Data."
^DIC(19,12899,1,3,0)="There are two parts to this option:"
^DIC(19,12899,1,4,0)=" "
^DIC(19,12899,1,5,0)="Extract Unsupported CV End Dates - this process will scan the"
^DIC(19,12899,1,6,0)="veterans' records in the Patient File and find records with CV"
^DIC(19,12899,1,7,0)="End Dates that are not supported by Military Service Data. At the"
^DIC(19,12899,1,8,0)="completion of this process a mail message will be sent"
^DIC(19,12899,1,9,0)="indicating that the extract is complete and the number of records"
^DIC(19,12899,1,10,0)="to print.  This process must be run before the list can be printed."
^DIC(19,12899,1,11,0)=" "
^DIC(19,12899,1,12,0)="Print Veterans with Unsupported CV End Dates Report - this process"
^DIC(19,12899,1,13,0)="will produce a list of veterans with unsupported CV End Dates."
^DIC(19,12899,1,14,0)="The report can be sorted by veteran name or SSN (terminal digits)."
^DIC(19,12899,25)="EN^DGCVRPT"
^DIC(19,12899,"U")="UNSUPPORTED CV END DATES REPOR"
^DIC(19,12900,0)="XU SID STARTUP^Startup PROD check^^R^10000000020^^^^^^^163^n"
^DIC(19,12900,1,0)="^^4^4^3030630^"
^DIC(19,12900,1,1,0)="This option should run at every startup to check if the current SID "
^DIC(19,12900,1,2,0)="matches the stored SID."
^DIC(19,12900,1,3,0)="To do this the option needs to be in the Option Scheduling file with the "
^DIC(19,12900,1,4,0)="SPECIAL QUEUEING field set to Startup Persistent."
^DIC(19,12900,25)="CHECK^XUPROD"
^DIC(19,12900,"U")="STARTUP PROD CHECK"
