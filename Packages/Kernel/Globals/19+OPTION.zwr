^DIC(19,9480,0)="PRCP PATIENT DISTR COST REPORT^Patient Distribution Cost Report^^R^11740^^^^^^^"
^DIC(19,9480,1,0)="^^3^3^2940310^"
^DIC(19,9480,1,1,0)="This option will print a report showing the items and costs distributed"
^DIC(19,9480,1,2,0)="to patients.  The report will break out costs by patient, inpatients and"
^DIC(19,9480,1,3,0)="outpatients, surgical specialty, procedure/operation code, and surgeon."
