^DIC(19,14602,0)="PXRM HT DEFINITION EDIT^Edit HT PERIODIC Reminder Definition Frequency^^R^11720^^^^^^^534"
^DIC(19,14602,1,0)="^^6^6^3160506^"
^DIC(19,14602,1,1,0)="This option will allow an edit of the REMINDER FREQUENCY value of the "
^DIC(19,14602,1,2,0)="VA-HT PERIODIC EVALUATION reminder definition. This option will also use "
^DIC(19,14602,1,3,0)="the new frequency value to automatically update both of the function"
^DIC(19,14602,1,4,0)="findings defined for this reminder definition. The default frequency for"
^DIC(19,14602,1,5,0)="this reminder is 180D. These are the frequencies available via this"
^DIC(19,14602,1,6,0)="option: 90D (or 3M), 120D (or 4M), 180D (or 6M)"
^DIC(19,14602,25)="EDIT^PXRMHTED"
^DIC(19,14602,"U")="EDIT HT PERIODIC REMINDER DEFI"
