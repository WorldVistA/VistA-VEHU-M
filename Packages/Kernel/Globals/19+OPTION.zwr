^DIC(19,4597,0)="DGPT SET XMIT FLAG^Set Transmit Flag on Movements^^R^.5^DG PTFSUP^^^^^^114"
^DIC(19,4597,1,0)="^^12^12^2900810^^"
^DIC(19,4597,1,1,0)="This option allows the supervisor to flag(or unflag) a 501"
^DIC(19,4597,1,2,0)="or a 535 movement so it will not be transmitted to Austin."
^DIC(19,4597,1,3,0)=" "
^DIC(19,4597,1,4,0)="Only PTF records that have more than twenty-five 501 movements or"
^DIC(19,4597,1,5,0)="more than twenty-five 535 movements can be selected."
^DIC(19,4597,1,6,0)=" "
^DIC(19,4597,1,7,0)="PTF records with more than 25 of either type of movement can not"
^DIC(19,4597,1,8,0)="be closed or transmitted.  Some of the movements must be flagged"
^DIC(19,4597,1,9,0)="not to be transmitted.  This is an Austin DPC limitation."
^DIC(19,4597,1,10,0)=" "
^DIC(19,4597,1,11,0)="The situation, where more than twenty-five 501's or 535's"
^DIC(19,4597,1,12,0)="are present in a PTF record, is very rare."
^DIC(19,4597,25)="FLAG^DGPTUTL1"
^DIC(19,4597,"U")="SET TRANSMIT FLAG ON MOVEMENTS"
^DIC(19,4598,0)="DGPT MPCR INQUIRY^MPCR INQUIRY^^R^.5^^^^^^^114"
^DIC(19,4598,1,0)="^^8^8^2900810^^"
^DIC(19,4598,1,1,0)="This option allows the user to view the MPCR information related"
^DIC(19,4598,1,2,0)="to a particular PTF record.  The information display is same"
^DIC(19,4598,1,3,0)="as the data shown on the 'MPCR' screen of the 'Load/Edit PTF Record'"
^DIC(19,4598,1,4,0)="option."
^DIC(19,4598,1,5,0)=" "
^DIC(19,4598,1,6,0)="If the PTF record selected is not closed, then the PTF record is"
^DIC(19,4598,1,7,0)="automatically updated using the latest specialty and ward movement"
^DIC(19,4598,1,8,0)="information."
^DIC(19,4598,25)="EN^DGPTFM71"
^DIC(19,4598,"U")="MPCR INQUIRY"
