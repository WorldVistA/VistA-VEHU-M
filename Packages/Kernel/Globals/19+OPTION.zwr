^DIC(19,10907,0)="LREPI ENHANCE MANUAL RUN^Lab EPI Manual Run (Enhanced)^^R^10000000020^^^^^^^26"
^DIC(19,10907,1,0)="^19.06^8^8^3040122^^^^"
^DIC(19,10907,1,1,0)="This option is used ONLY to manually extract national EPI data and transmit to"
^DIC(19,10907,1,2,0)="the Austin Automation Center (AAC). When this option is run, an EPI Summary"
^DIC(19,10907,1,3,0)="Verification Report is generated and automatically sent to the EPI-Report mail"
^DIC(19,10907,1,4,0)="group. Also, a Detailed Verification Report is generated and can be printed"
^DIC(19,10907,1,5,0)="using the new Print Detailed Verification Report [LREPI VERIFICATION REPORT]"
^DIC(19,10907,1,6,0)="option. This option has been RENAMED from Lab Search/Extract Manual Run"
^DIC(19,10907,1,7,0)="(Enhanced) [LREPI SEARCH/EXTRACT ENHANCED MANUAL RUN] to EPI Manual Run"
^DIC(19,10907,1,8,0)="(Enhanced) [LREPI ENHANCE MANUAL RUN] option."
^DIC(19,10907,25)="LREPIRM"
^DIC(19,10907,99.1)="59114,51724"
^DIC(19,10907,"U")="LAB EPI MANUAL RUN (ENHANCED)"
^DIC(19,10908,0)="LREPI PROTOCOL EDIT^Lab EPI Protocol Edit^^C^10000000020^^^^^^^26"
^DIC(19,10908,1,0)="^^1^1^2990706^^^^"
^DIC(19,10908,1,1,0)="Use this option to edit the LAB SEARCH/EXTRACT PROTOCOL file."
^DIC(19,10908,30)="LAB(69.4,"
^DIC(19,10908,31)="AEQM"
^DIC(19,10908,40)="[LREPIPROT]"
