^DIC(19,9918,0)="SCDX AMBCAR NIGHTLY XMIT^Ambulatory Care Nightly Transmission to NPCDB^This functionality is now accomplished by CDW/VSSC.^R^11289^^^^^^n^16"
^DIC(19,9918,1,0)="^^5^5^2960802^^^^"
^DIC(19,9918,1,1,0)="Nightly background job which transmits outpatient encounter data, as"
^DIC(19,9918,1,2,0)="stored in the Outpatient Encounter (#409.68) and Deleted Outpatient"
^DIC(19,9918,1,3,0)="Encounter (#409.74) files, to the National Patient Care Database."
^DIC(19,9918,1,4,0)="Administrative data concerning the transmission of this data is stored in"
^DIC(19,9918,1,5,0)="the Transmitted Outpatient Encounter file (#409.73)."
^DIC(19,9918,10.1)="Amb Care Background Job"
^DIC(19,9918,25)="SNDZ00^SCDXMSG"
^DIC(19,9918,200.9)="y"
^DIC(19,9918,"U")="AMBULATORY CARE NIGHTLY TRANSM"
^DIC(19,9919,0)="SCDX AMBCAR RETRANS BY DATE^Retransmit Ambulatory Care Data by Date Range^This functionality is now accomplished by CDW/VSSC.^R^10000000216^SD SUPERVISOR^^^^^n^16"
^DIC(19,9919,1,0)="^19.06^6^6^3120307^^^"
^DIC(19,9919,1,1,0)="Retransmission option which will gather data from the Outpatient Encounter"
^DIC(19,9919,1,2,0)="(#409.68) and Deleted Outpatient Encounter (#409.74) files within a"
^DIC(19,9919,1,3,0)="specified date range and mark the corresponding entry in the Transmitted"
^DIC(19,9919,1,4,0)="Outpatient Encounter file (#409.73) for retransmission.  The nightly"
^DIC(19,9919,1,5,0)="background job 'SCDX AMBCAR NIGHTLY XMIT' will then transmit this data to"
^DIC(19,9919,1,6,0)="the National Patient Care Database."
^DIC(19,9919,10.1)="Amb Care Retrans by Date"
^DIC(19,9919,25)="RTRNRNG^SCDXRT01"
^DIC(19,9919,"U")="RETRANSMIT AMBULATORY CARE DAT"
^DIC(19,9920,0)="SCDX AMBCAR REPORTING^Ambulatory Care Reporting Menu^^M^11289^^^^^^^16"
^DIC(19,9920,1,0)="^^3^3^2960621^^^^"
^DIC(19,9920,1,1,0)="This menu option contains all menus and options needed to collect, edit,"
^DIC(19,9920,1,2,0)="maintain and transmit Ambulitory Care information to the National Patient"
^DIC(19,9920,1,3,0)="Care Database."
