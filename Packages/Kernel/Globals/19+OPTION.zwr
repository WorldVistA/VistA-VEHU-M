^DIC(19,1375,200.9)="y"
^DIC(19,1375,"U")="PATIENT LAB DISCHARGE SUMMARY"
^DIC(19,1376,0)="LRAC DISCHARGE^Patient Lab Discharge Summary (Manual)^^R^10000000020^^^^^^^26"
