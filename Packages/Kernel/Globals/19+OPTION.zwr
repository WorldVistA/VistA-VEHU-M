^DIC(19,13071,0)="PSS WARNING BUILDER^Warning Builder^^R^10000000020^^^^^^^517"
^DIC(19,13071,1,0)="^19.06^3^3^3040521^^^"
^DIC(19,13071,1,1,0)="This option will allow you to define a custom warning label list "
^DIC(19,13071,1,2,0)="containing entries from both the new warning label source and the old Rx "
^DIC(19,13071,1,3,0)="Consult file entries."
^DIC(19,13071,25)="PSSWRNB"
^DIC(19,13071,"U")="WARNING BUILDER"
^DIC(19,13072,0)="PSS WARNING MAPPING^Warning Mapping^^R^10000000020^^^^^^^517"
^DIC(19,13072,1,0)="^^9^9^3040521^"
^DIC(19,13072,1,1,0)="This option is used to match an entry from the old Rx Consult file to the"
^DIC(19,13072,1,2,0)="new commercial data source warning file to aid in using the Warning "
^DIC(19,13072,1,3,0)="Builder (to identify local warnings that do not have an equivalent entry "
^DIC(19,13072,1,4,0)="in the new commercial data source)."
^DIC(19,13072,1,5,0)=" "
^DIC(19,13072,1,6,0)="The user can also enter a Spanish translation for an Rx Consult file "
^DIC(19,13072,1,7,0)="entry, if desired, but whenever possible, the new commercial data source's"
^DIC(19,13072,1,8,0)="warnings (English or Spanish depending on the patient setting) should be"
^DIC(19,13072,1,9,0)="used."
^DIC(19,13072,25)="EDIT^PSSWMAP"
^DIC(19,13072,"U")="WARNING MAPPING"
^DIC(19,13073,0)="PSO LM MULTI-RX PRINT^Manual Print of Multi-Rx Forms^^A^10000000020^^^^^^^141^^1^1"
^DIC(19,13073,1,0)="^19.06^2^2^3041110^^^^"
^DIC(19,13073,1,1,0)="This option is used to print a patient's Multi-Rx refill request form "
