^DIC(19,5274,1,0)="^^2^2^2901012^^"
^DIC(19,5274,1,1,0)="This option displays all available data for a user selected"
^DIC(19,5274,1,2,0)="item from the VAMC Planned Equipment file."
^DIC(19,5274,25)="ECTEQT"
