^DIC(19,405,1,0)="^19.06^4^4^3021125^^^^"
^DIC(19,405,1,1,0)="This option is used to define your ADT parameters.  It is used"
^DIC(19,405,1,2,0)="by the station to customize the ADT module to the individual"
^DIC(19,405,1,3,0)="stations needs and must be run prior to using any portion of"
^DIC(19,405,1,4,0)="ADT or scheduling."
