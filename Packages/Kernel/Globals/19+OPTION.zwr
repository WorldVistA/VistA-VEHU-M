^DIC(19,15690,0)="EHM-00511^Allocate OE/RR Security Keys^^A^1^^^^^^^^^1^^"
^DIC(19,15690,1,0)="^^3^3^3240328^^"
^DIC(19,15690,1,1,0)="This option is to assist the OE/RR Clinical Coordinator when allocating"
^DIC(19,15690,1,2,0)="Security keys to users of the OE/RR system."
^DIC(19,15690,1,3,0)="Cloned from ""ORCL KEY ALLOCATION"" option."
