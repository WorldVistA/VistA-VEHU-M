^DIC(19,7432,0)="QAM INQ AUDIT FILE^Audit File Inquire^^R^.5^^^^^^^"
^DIC(19,7432,1,0)="^^4^4^2911108^"
^DIC(19,7432,1,1,0)="This option allows the user to pick a fall out record and view its"
^DIC(19,7432,1,2,0)="audit file entry.  The audit file data includes information on who"
^DIC(19,7432,1,3,0)="modified the record, when it was modified, and what modification"
^DIC(19,7432,1,4,0)="was performed."
^DIC(19,7432,25)="QAMPINQ5"
^DIC(19,7432,"U")="AUDIT FILE INQUIRE"
^DIC(19,7433,0)="QAM RPT MONITOR ADHOC^Ad Hoc Monitor Report^^R^.5^^^^^^^"
^DIC(19,7433,1,0)="^^2^2^2920515^"
^DIC(19,7433,1,1,0)="Ad Hoc Monitor Report:  Allows the user to design their own reports"
^DIC(19,7433,1,2,0)="from data in the Monitor file."
^DIC(19,7433,25)="QAMAHOC"
^DIC(19,7433,"U")="AD HOC MONITOR REPORT"
^DIC(19,7434,0)="QAM BUILD PATIENT GROUP^Patient Group^^R^.5^^^^^^^"
^DIC(19,7434,1,0)="^^8^8^2920928^"
^DIC(19,7434,1,1,0)=" "
^DIC(19,7434,1,2,0)="This option allows the user to build a group of patients to monitor using"
^DIC(19,7434,1,3,0)="the VA FileMan search option.  Once the search and sort parameters have"
^DIC(19,7434,1,4,0)="been input the QAMDFM function must be used at one of the 'print field'"
^DIC(19,7434,1,5,0)="prompts.  This function should be used on a field that is a pointer, free"
^DIC(19,7434,1,6,0)="text pointer, or free text patient name field."
^DIC(19,7434,1,7,0)="Usage: QAMDFN(Patient_name_Field) or"
^DIC(19,7434,1,8,0)="       QAMDFN(#Patient_name_Field_number)"
^DIC(19,7434,25)="QAMGPOP0"
^DIC(19,7434,"U")="PATIENT GROUP"
^DIC(19,7435,0)="QAM RPT BUILD MON WORKSHEET^Build a Monitor Worksheet^^R^.5^^^^^^^"
^DIC(19,7435,1,0)="^^2^2^2930409^"
^DIC(19,7435,1,1,0)="This option prints a blank worksheet to aid in the development and entry"
^DIC(19,7435,1,2,0)="of a monitor."
^DIC(19,7435,25)="QAMPBMW0"
^DIC(19,7435,"U")="BUILD A MONITOR WORKSHEET"
^DIC(19,7436,0)="QAOS FINAL DISPOSITION^Final Disposition^^R^.5^^^^^^^^^^"
^DIC(19,7436,1,0)="^^3^3^2921013^"
^DIC(19,7436,1,1,0)="This option allows the user to enter the final disposition for an"
^DIC(19,7436,1,2,0)="occurrence.  The user is prompted for final disposition date and the"
^DIC(19,7436,1,3,0)="review level at which the final disposition was reached."
^DIC(19,7436,15)=""
^DIC(19,7436,20)=""
^DIC(19,7436,25)="EN3^QAOEDT2"
^DIC(19,7436,99)="55556,51236"
^DIC(19,7436,"U")="FINAL DISPOSITION"
^DIC(19,7437,0)="QAOS RPT REVIEW SUMMARY^Statistical Review Summary^^R^.5^^^^^^^"
^DIC(19,7437,1,0)="^^5^5^2930610^"
^DIC(19,7437,1,1,0)="This option produces a statistical report showing:"
^DIC(19,7437,1,2,0)=" 1) The Clinical review findings"
^DIC(19,7437,1,3,0)=" 2) The Peer review findings by service"
^DIC(19,7437,1,4,0)=" 3) The Management review actions by service"
^DIC(19,7437,1,5,0)=" 4) The Committee confirmed issue statistics"
^DIC(19,7437,25)="QAOSPRS0"
^DIC(19,7437,"U")="STATISTICAL REVIEW SUMMARY"
^DIC(19,7438,0)="QAOS PURGE DELETED RECORDS^Purge Deleted Occurrence Screen Records^^R^.5^^^^^^^"
^DIC(19,7438,1,0)="^^3^3^2920420^"
^DIC(19,7438,1,1,0)="This option is used to delete the Occurrence Screen records that have"
^DIC(19,7438,1,2,0)="been marked as deleted.  The user is prompted for a date range and"
^DIC(19,7438,1,3,0)="which screens should be deleted."
^DIC(19,7438,25)="QAOSDELT"
^DIC(19,7438,"U")="PURGE DELETED OCCURRENCE SCREE"
^DIC(19,7439,0)="QAOS GENERATE SUMM OS BULLETIN^Summary of Occurrence Screen Transmission^^R^.5^^^^^^^"
^DIC(19,7439,1,0)="^^8^8^2930413^"
^DIC(19,7439,1,1,0)="This option generates a MailMan message that contains the statistical"
^DIC(19,7439,1,2,0)="information found in parts one and two of the Summary of Occurrence"
^DIC(19,7439,1,3,0)="Screening (Semi-Annual) report.  The user will be prompted for those data"
^DIC(19,7439,1,4,0)="elements that are not saved in the Occurrence Screen database: reviewer"
^DIC(19,7439,1,5,0)="reliability assessment and workload data. The message is automatically"
^DIC(19,7439,1,6,0)="sent to the National Quality Assurance Data Base (NQADB) at the Hines"
^DIC(19,7439,1,7,0)="ISC.  Once the data has been loaded into the NQADB it may be viewed and"
^DIC(19,7439,1,8,0)="used by the facility, region, and VACO as appropriate."
^DIC(19,7439,25)="QAOSUPL0"
^DIC(19,7439,"U")="SUMMARY OF OCCURRENCE SCREEN T"
