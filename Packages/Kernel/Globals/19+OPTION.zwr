^DIC(19,13413,0)="PRSP SUP UNLOCK^Unlock Daily ESR^^R^1^^^^^^^230"
^DIC(19,13413,1,0)="^^10^10^3050715^"
^DIC(19,13413,1,1,0)="This option allows supervisors to unlock prior pay period ESRs, so the"
^DIC(19,13413,1,2,0)="part-time physician can change or complete any incomplete daily ESRs."
^DIC(19,13413,1,3,0)="If a timecard has a status of payroll or transmitted, the unlock option"
^DIC(19,13413,1,4,0)="will only return the ESR to the physician, by way of setting the status to"
^DIC(19,13413,1,5,0)="resubmit.  The timecard will not be modified.  If the re-approval of the"
^DIC(19,13413,1,6,0)="ESR will impact the timecard (i.e. change to leave on a scheduled day)"
^DIC(19,13413,1,7,0)="then either a corrected timecard will be required prior to approval or the"
^DIC(19,13413,1,8,0)="timecard may be returned to timekeeper.  If a timecard has a status of"
^DIC(19,13413,1,9,0)="timekeeper, then the option, Unlock Daily ESR, will clear any timecard"
^DIC(19,13413,1,10,0)="postings and reset the status to not posted."
^DIC(19,13413,25)="SUP^PRSPUE"
^DIC(19,13413,"U")="UNLOCK DAILY ESR"
