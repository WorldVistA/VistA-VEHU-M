^DIC(19,7962,"U")="PRINT STRENGTH REPORT"
^DIC(19,7963,0)="PRSA TK EMP-HOL^Set Holiday Benefit Day^^R^.5^^^^^^^"
^DIC(19,7963,1,0)="^^6^6^2950711^^^"
^DIC(19,7963,1,1,0)="This option allows the Timekeeper to select an open posting date"
^DIC(19,7963,1,2,0)="and mark that date as a Holiday Benefit day so that HX and/or HW"
^DIC(19,7963,1,3,0)="can be posted. It is designed for use only in those cases"
^DIC(19,7963,1,4,0)="where the automatic determination of the holiday has selected"
^DIC(19,7963,1,5,0)="an incorrect date or for those cases where a part-time worker"
^DIC(19,7963,1,6,0)="is unable to work because of a Holiday."
^DIC(19,7963,25)="PRSAPEH"
^DIC(19,7963,"U")="SET HOLIDAY BENEFIT DAY"
