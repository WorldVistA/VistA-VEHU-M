^DIC(19,9907,0)="PX SITE PARAMETER MENU^PCE Site Parameter Menu^^M^10958^^^^^^^507"
^DIC(19,9907,1,0)="^^22^22^2960723^^^^"
^DIC(19,9907,1,1,0)="This menu includes all options that deal with defining and displaying"
^DIC(19,9907,1,2,0)="entries in the PCE PARAMETERS file (815)."
^DIC(19,9907,1,3,0)=" "
^DIC(19,9907,1,4,0)="The PCE Site Parameters Edit option includes all editable fields,"
^DIC(19,9907,1,5,0)="for IRM/ADPAC use."
^DIC(19,9907,1,6,0)=" "
^DIC(19,9907,1,7,0)="The PCE HS/RPT Parameter Print option can be included on a Health Summary"
^DIC(19,9907,1,8,0)="Coordinator's menu if the coordinator is involved with the definition of"
^DIC(19,9907,1,9,0)="Clinical Reminders to be printed on the Health Summary.  This option is"
^DIC(19,9907,1,10,0)="also included on the PCE Coordinators menu and the PCE Reports option"
^DIC(19,9907,1,11,0)="menu."
^DIC(19,9907,1,12,0)=" "
^DIC(19,9907,1,13,0)="The PCE HS Parameters option can be included on a Health Summary"
^DIC(19,9907,1,14,0)="Coordinators menu, and is included on the PCE Coordinator's menu.  This"
^DIC(19,9907,1,15,0)="user should be familiar with the PCE Reminders and the use of the reminder"
^DIC(19,9907,1,16,0)="disclaimer on the ""Clinical Maintenance"" and ""Clinical Reminder"""
^DIC(19,9907,1,17,0)="components."
^DIC(19,9907,1,18,0)=" "
^DIC(19,9907,1,19,0)="The PCE Report Parameters Setup option can be included on a PCE"
^DIC(19,9907,1,20,0)="Coordinator's menu to setup the local file definitions to use to"
^DIC(19,9907,1,21,0)="represent Emergency Clinics, and various categories of Lab tests by"
^DIC(19,9907,1,22,0)="the PCE Report Module."
^DIC(19,9907,10,0)="^19.01IP^2^2"
^DIC(19,9907,10,1,0)="9886^SITE^1"
^DIC(19,9907,10,2,0)="9909^RPT^5"
^DIC(19,9907,10,"B",9886,1)=""
^DIC(19,9907,10,"B",9909,2)=""
^DIC(19,9907,10,"C","RPT",2)=""
^DIC(19,9907,10,"C","SITE",1)=""
^DIC(19,9907,99)="59715,37391"
^DIC(19,9907,"U")="PCE SITE PARAMETER MENU"
^DIC(19,9908,0)="PX HS/RPT PARAMETERS PRINT^PCE HS/RPT Parameters Print^^P^11740^^^^^^y^507"
^DIC(19,9908,1,0)="^^4^4^3000509^"
^DIC(19,9908,1,1,0)="This option prints the current PCE Parameter definitions that are used by"
^DIC(19,9908,1,2,0)="some of the PCE Reports. A brief explanation is included about editing and"
^DIC(19,9908,1,3,0)="viewing health summary disclaimers that are now managed from the Clinical"
^DIC(19,9908,1,4,0)="Reminders package."
^DIC(19,9908,60)="PX(815,"
^DIC(19,9908,61)=""
^DIC(19,9908,62)=0
^DIC(19,9908,63)="[PX HS/RPT PARAMETERS PRINT]"
^DIC(19,9908,64)="[PX PARAMETERS PRINT]"
^DIC(19,9908,"U")="PCE HS/RPT PARAMETERS PRINT"
^DIC(19,9909,0)="PX HS/RPT PARAMETER MENU^PCE HS/RPT Parameter Menu^^M^11740^^^^^^^"
^DIC(19,9909,1,0)="^^11^11^3000509^"
^DIC(19,9909,1,1,0)="This menu option contains print and edit options for PCE fields related to"
^DIC(19,9909,1,2,0)="the PCE Reports module.  "
^DIC(19,9909,1,3,0)=" "
^DIC(19,9909,1,4,0)="Use the print option to see what the current definition is for these"
^DIC(19,9909,1,5,0)="fields.  "
^DIC(19,9909,1,6,0)=" "
^DIC(19,9909,1,7,0)="The report edit option allows your site to specify which clinics in file"
^DIC(19,9909,1,8,0)="44 represent ""Emergency Room"" clinics, and what Lab tests from file 60"
^DIC(19,9909,1,9,0)="should be used for looking up patient data for Glucose, Cholesterol, LDL"
^DIC(19,9909,1,10,0)="Cholesterol and HBA1C lab results.  These fields are used by the following"
^DIC(19,9909,1,11,0)="reports:  Caseload Profile by Clinic, and Patient Activity by Clinic."
^DIC(19,9909,10,0)="^19.01IP^3^2"
^DIC(19,9909,10,1,0)="9908^PRNT^1"
^DIC(19,9909,10,3,0)="9902^RPT^10"
^DIC(19,9909,10,"B",9902,3)=""
^DIC(19,9909,10,"B",9908,1)=""
^DIC(19,9909,10,"C","PRNT",1)=""
^DIC(19,9909,10,"C","RPT",3)=""
^DIC(19,9909,99)="58365,41115"
^DIC(19,9909,"U")="PCE HS/RPT PARAMETER MENU"
^DIC(19,9910,0)="PXTT COPY EDUCATION TOPIC^Education Topic Copy^^R^10000000020^^^^^^^^^^1"
^DIC(19,9910,1,0)="^19.06^6^6^3010806^^^^"
^DIC(19,9910,1,1,0)="This option allows the user to copy an existing education topic into a new"
^DIC(19,9910,1,2,0)="education topic entry in the Educatin Topics file (#9999999.09). The"
^DIC(19,9910,1,3,0)="original education topic to be copied is selected first.  If the topic is"
^DIC(19,9910,1,4,0)="prefixed with ""VA-"", the ""VA-"" will be stripped off the name"
^DIC(19,9910,1,5,0)="automatically. The new name must be unique.  If the name is not unique,"
^DIC(19,9910,1,6,0)="the user must enter a unique name for the new education topic."
^DIC(19,9910,15)="K PXNAT"
^DIC(19,9910,20)=""
^DIC(19,9910,25)="PXTTEDC"
^DIC(19,9910,"U")="EDUCATION TOPIC COPY"
