^DIC(19,13513,0)="RG PRIMARY VIEW FROM MPI^Primary View Display from MPI^^R^1^^^^^^^525"
^DIC(19,13513,1,0)="^^6^6^3070517^"
^DIC(19,13513,1,1,0)="For a selected patient, this option sends a remote request for data to "
^DIC(19,13513,1,2,0)="the Master Patient Index, using a Remote Procedure Call (RPC).  When the "
^DIC(19,13513,1,3,0)="RPC returns the information, the user can review Primary View data as it "
^DIC(19,13513,1,4,0)="currently exists on the MPI Patient Data Inquiry (PDAT) report."
^DIC(19,13513,1,5,0)="  "
^DIC(19,13513,1,6,0)="Be sure that HISTORY is enabled to capture the information."
^DIC(19,13513,25)="RGPVMPI"
^DIC(19,13513,"U")="PRIMARY VIEW DISPLAY FROM MPI"
