^DIC(19,10886,0)="LA7S EDIT 62.91^Edit Shipping Container^^R^11712^^^^^^^480"
^DIC(19,10886,1,0)="^^3^3^2970717^^"
^DIC(19,10886,1,1,0)="This option sets up the LAB SHIPPING CONTAINER file (#62.91)."
^DIC(19,10886,1,2,0)="Sites use this option to define and edit lab shipping containers used by"
