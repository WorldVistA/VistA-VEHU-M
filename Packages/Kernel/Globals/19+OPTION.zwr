^DIC(19,9712,"U")="PATIENT INTAKE/OUTPUT MENU"
^DIC(19,9713,0)="GMRV TPR EXT B/P^Temp, Detailed PR and B/P^GMRV*5*19 - shutdown Vitals CHUI^A^1^^^^^^^503^^1^1"
^DIC(19,9713,1,0)="2^^6^6^2970109^^^^"
^DIC(19,9713,1,1,0)="This option allows data to be entered for temperature, pulse, respiration"
^DIC(19,9713,1,2,0)="and detailed blood pressure.  Detailed blood pressure captures the numeric"
^DIC(19,9713,1,3,0)="value of both the systolic and diastolic pressures and also associates"
^DIC(19,9713,1,4,0)="(a) the site where the pressure was taken (e.g., left arm vs right arm),"
^DIC(19,9713,1,5,0)="and (b) the position of the patient when the reading was taken (e.g., "
^DIC(19,9713,1,6,0)="sitting vs standing)."
^DIC(19,9713,15)="D EXITACT^GMRVED4"
^DIC(19,9713,20)="D ENTACT^GMRVED4 I $D(GMRVDBA) S GMRENTY=5 D EN2^GMRVED0"
^DIC(19,9713,"U")="TEMP, DETAILED PR AND B/P"
^DIC(19,9714,0)="GMRV EXT B/P^Detailed B/P and Associated Pulse^GMRV*5*19 - shutdown Vitals CHUI^A^1^^^^^^^503^^1^1"
^DIC(19,9714,1,0)="^^6^6^2990427^^^"
^DIC(19,9714,1,1,0)="This option allows users to enter detailed blood pressure and"
^DIC(19,9714,1,2,0)="associated pulse information. In addition to the numeric values of the"
^DIC(19,9714,1,3,0)="blood pressure and pulse readings, the site/location where the blood"
^DIC(19,9714,1,4,0)="pressure and pulse were taken (e.g., left arm vs right arm), the position"
^DIC(19,9714,1,5,0)="of the patient (e.g., sitting, standing) and other qualifiers are"
^DIC(19,9714,1,6,0)="documented."
^DIC(19,9714,15)="D EXITACT^GMRVED4"
^DIC(19,9714,20)="D ENTACT^GMRVED4 I $D(GMRVDBA) S GMRENTY=6 D EN2^GMRVED0"
^DIC(19,9714,99)="55273,53545"
^DIC(19,9714,"U")="DETAILED B/P AND ASSOCIATED PU"
^DIC(19,9715,0)="GMRV VMSITE^Enter/Edit Vitals Qualifiers^GMRV*5*19 - shutdown Vitals CHUI^R^1^^^^^^^503"
^DIC(19,9715,1,0)="^^4^4^2991007^^^^"
^DIC(19,9715,1,1,0)="This option is used by the application coordinator to create and edit"
^DIC(19,9715,1,2,0)="hospital-wide qualifiers associated with vital signs and other patient"
^DIC(19,9715,1,3,0)="measurements captured in the Vitals/Measurements application.  Data is"
^DIC(19,9715,1,4,0)="stored in the GMRV Vital Qualifier (#120.52) file."
^DIC(19,9715,25)="CHAR^GMRVSITE"
^DIC(19,9715,"U")="ENTER/EDIT VITALS QUALIFIERS"
^DIC(19,9716,0)="GMRV VMQUALTY^Change Default Qualifiers for Temp./Pulse^GMRV*5*19 - shutdown Vitals CHUI^R^1^^^^^^^503"
^DIC(19,9716,1,0)="^^2^2^2980812^^^"
^DIC(19,9716,1,1,0)="This option is for the ADP coordinator to change default qualifiers for"
^DIC(19,9716,1,2,0)="temperature/pulse in GMRV Vital Category file (#120.53)."
^DIC(19,9716,25)="DEFAULT^GMRVSITE"
^DIC(19,9716,"U")="CHANGE DEFAULT QUALIFIERS FOR "
^DIC(19,9732,0)="GMRV PULSE^Pulse^GMRV*5*19 - shutdown Vitals CHUI^A^1^^^^^^^^^1^1"
^DIC(19,9732,1,0)="^^1^1^2970109^^^^"
^DIC(19,9732,1,1,0)="This option allows users to enter a patient's pulse rate."
^DIC(19,9732,15)="D EXITACT^GMRVED4"
^DIC(19,9732,20)="D ENTACT^GMRVED4 I $D(GMRVDBA) S GMRENTY=7 D EN2^GMRVED0"
^DIC(19,9732,"U")="PULSE"
