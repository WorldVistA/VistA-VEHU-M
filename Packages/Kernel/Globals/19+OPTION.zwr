^DIC(19,14023,0)="MAGQ BPMONITOR^Monitor Background Processor Activity^^R^10000000216^^^^^^^530"
^DIC(19,14023,1,0)="^19.06^20^20^3100406^^^^"
^DIC(19,14023,1,1,0)="This menu option is used to monitor the queue processing activities on"
^DIC(19,14023,1,2,0)="the Background Processor. Inactivity by this application will be reported"
^DIC(19,14023,1,3,0)="to the mail groups: G.MAG SERVER and G.MAG_nn_VI_BP_Queue_Processo."
^DIC(19,14023,1,4,0)="Inactivity is determined by the timestamp on the last queue processed and"
^DIC(19,14023,1,5,0)="if there are queues still to be processed.  If the time is greater than"
^DIC(19,14023,1,6,0)="the time specified in the calling routine than a mail message will be"
^DIC(19,14023,1,7,0)="sent.   Time specified is passed in a parameter when calling the routine."
^DIC(19,14023,1,8,0)="     CBP^MAGQCBP(15)"
^DIC(19,14023,1,9,0)="In the above example, the time lapsed to be determined since the last"
^DIC(19,14023,1,10,0)="queue was processed is 15 minutes.   This parameter can be modified by"
^DIC(19,14023,1,11,0)="editing this menu option and changing the '(15)' in the ROUTINE field."
^DIC(19,14023,1,12,0)=" "
^DIC(19,14023,1,13,0)="Recommend scheduling this task using the Kernel's Schedule\Unschedule Options."
^DIC(19,14023,1,14,0)="The following are optional parameters that can be defined when scheduling this task:"
^DIC(19,14023,1,15,0)=" "
^DIC(19,14023,1,16,0)="     MAGMIN - determines the lapse time between processing tasks.  If the variable is undefined, then the default value is 15 minutes.  If an active queue has not processed with specified minutes then a mail message is sent. "
^DIC(19,14023,1,17,0)=" "
^DIC(19,14023,1,18,0)="     MAGFQ - determines if failed queues have reached this limit.  If the variable is undefined, then the default value is 1,000.  If failed queues are above this limit, then a mail message is sent. "
^DIC(19,14023,1,19,0)=" "
^DIC(19,14023,1,20,0)="   MAGEVAL - determines if EVAL queues have reached this limit. If the variable is undefined, then the default value is 10,000.  If EVAL queues are above this limit, then a mail message is sent."
^DIC(19,14023,25)="CBP^MAGQCBP(15)"
^DIC(19,14023,83)="Y"
^DIC(19,14023,200.9)="y^y"
^DIC(19,14023,"U")="MONITOR BACKGROUND PROCESSOR A"
^DIC(19,14024,0)="HL PURGE QUEUE (TCP)^Purge Outgoing Queue (TCP Only)^^A^10000000216^^^^^^y^304^^1"
^DIC(19,14024,1,0)="^^3^3^3101207^"
^DIC(19,14024,1,1,0)="This option will purge an outgoing TCP/IP client link of messages pending "
^DIC(19,14024,1,2,0)="transmission. "
^DIC(19,14024,1,3,0)=""
^DIC(19,14024,20)="D ASKPURGE^HLQPURGE"
^DIC(19,14024,"U")="PURGE OUTGOING QUEUE (TCP ONLY"
^DIC(19,14025,0)="HL RESET COUNTERS (TCP ONLY)^Reset Link's Counters (TCP Only)^^A^10000000216^^^^^^y^304^^1"
^DIC(19,14025,1,0)="^19.06^6^6^3101229^^"
^DIC(19,14025,1,1,0)="This option will not purge any messages from a queue.  It does count the "
^DIC(19,14025,1,2,0)="messages pending on the queue and re-initializes the count of messages sent"
^DIC(19,14025,1,3,0)="and received for the link to 0 and the count of messages to send or still to"
^DIC(19,14025,1,4,0)="processed to the actual count."
^DIC(19,14025,1,5,0)=""
^DIC(19,14025,1,6,0)=""
^DIC(19,14025,20)="D RESET^HLQPURGE"
^DIC(19,14025,"U")="RESET LINK'S COUNTERS (TCP ONL"
^DIC(19,14026,0)="HL DISPLAY LINKS (TCP ONLY)^Display Client and Server Links (TCP Only)^^A^10000000216^^^^^^y^304^^1"
^DIC(19,14026,1,0)="^^5^5^3101207^"
^DIC(19,14026,1,1,0)="This option was requested by Product Support to troubleshoot problems with"
^DIC(19,14026,1,2,0)="TCP links.  It will dispay all TCP/IP links that have pending incoming or"
^DIC(19,14026,1,3,0)="outgoing messages with the link's state, the first pending message, and a"
^DIC(19,14026,1,4,0)="count of the pending messages. "
^DIC(19,14026,1,5,0)=""
^DIC(19,14026,20)="D SHOWTCP^HLQPURGE"
^DIC(19,14026,"U")="DISPLAY CLIENT AND SERVER LINK"
^DIC(19,14027,0)="HL DISPLAY ONE LINK (TCP ONLY)^Display One Link (TCP Only)^^A^10000000216^^^^^^y^^^1"
^DIC(19,14027,1,0)="^^4^4^3101207^"
^DIC(19,14027,1,1,0)="Asks the user to select a TCP link.  It then displays the link, a count"
^DIC(19,14027,1,2,0)="of the messages pending on its incoming and outgoing queues, along with"
^DIC(19,14027,1,3,0)="the first message on the queue."
^DIC(19,14027,1,4,0)=""
^DIC(19,14027,20)="D ONETCP^HLQPURGE"
^DIC(19,14027,"U")="DISPLAY ONE LINK (TCP ONLY)"
^DIC(19,14028,0)="PRCFD INVOICE CERT SOD RPT^Invoice Certification Seg Duties Violation Rpt^^R^10000000216^^^^^^^121"
^DIC(19,14028,1,0)="^^6^6^3101208^"
^DIC(19,14028,1,1,0)="This report shows requestors, approvers, obligators, and certifiers in"
^DIC(19,14028,1,2,0)="IFCAP's Invoice/Tracking module of 1358s and identifies violations of"
^DIC(19,14028,1,3,0)="segregation of duties policy.  This report identifies 1358s based"
^DIC(19,14028,1,4,0)="on certified invoices in the IFCAP invoice/tracking module and does"
^DIC(19,14028,1,5,0)="not present 1358s which are certified in other VistA packages or other"
^DIC(19,14028,1,6,0)="systems."
^DIC(19,14028,25)="PRCFSDR"
