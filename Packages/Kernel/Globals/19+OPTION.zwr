^DIC(19,9452,"U")="INSTRUMENT KIT MENU"
^DIC(19,9453,0)="PRCP IK ENTER/EDIT^Enter/Edit/Create A Instrument Kit^^R^11740^^^^^^^"
^DIC(19,9453,1,0)="^^5^5^2940727^^"
^DIC(19,9453,1,1,0)="The Enter/Edit/Create A Instrument Kit option will allow the user"
^DIC(19,9453,1,2,0)="to define which items and quantity should be used in assembling the"
^DIC(19,9453,1,3,0)="instrument kit.  The user can also enter the method of sterilization,"
^DIC(19,9453,1,4,0)="method of wrapping/packaging, and special instructions or remarks for"
^DIC(19,9453,1,5,0)="the instrument kit."
^DIC(19,9453,25)="INSTRKIT^PRCPCED0"
^DIC(19,9453,"U")="ENTER/EDIT/CREATE A INSTRUMENT"
^DIC(19,9454,0)="PRCP IK DEFINITION REPORT^Instrument Kit Report^^R^11740^^^^^^^"
^DIC(19,9454,1,0)="^^8^8^2940727^^"
^DIC(19,9454,1,1,0)="The Instrument Kit Report will print a list of selected"
^DIC(19,9454,1,2,0)="instrument kits displaying the items and quantities needed to"
^DIC(19,9454,1,3,0)="assemble the instrument kit."
^DIC(19,9454,1,3,2)="R;"
^DIC(19,9454,1,4,0)=""
^DIC(19,9454,1,4,2)="R;"
^DIC(19,9454,1,5,0)="The report will print the items needed, description, quantity needed,"
^DIC(19,9454,1,6,0)="whether the item is reusable or disposable, mandatory source vendor"
^DIC(19,9454,1,7,0)="for reordering, catalog number for the mandatory source, and storage"
^DIC(19,9454,1,8,0)="location."
^DIC(19,9454,25)="PRCPCRDK"
^DIC(19,9454,"U")="INSTRUMENT KIT REPORT"
^DIC(19,9455,0)="PRCP IK ASSEMBLE^Assemble Instrument Kit^^R^11740^^^^^^^"
^DIC(19,9455,1,0)="^^14^14^2940126^^"
^DIC(19,9455,1,1,0)="The Assemble Instrument Kit option will build selected instrument"
^DIC(19,9455,1,2,0)="kits by the instrument kit definition.  The instrument kit definition"
^DIC(19,9455,1,3,0)="describes the items and quantities which are used in building the"
^DIC(19,9455,1,4,0)="instrument kit."
^DIC(19,9455,1,4,2)="R;"
^DIC(19,9455,1,5,0)=""
^DIC(19,9455,1,5,2)="R;"
^DIC(19,9455,1,6,0)="The user will have the option to select the number of instrument kits"
^DIC(19,9455,1,7,0)="to build.  After selecting the number, a screen display will show the"
^DIC(19,9455,1,8,0)="current quantity on-hand and new quantity on-hand (after building)"
^DIC(19,9455,1,9,0)="for the items which make up the instrument kit definition.  The new"
^DIC(19,9455,1,10,0)="quantity on-hand is calculated by subtracting the current quantity"
^DIC(19,9455,1,11,0)="on-hand by the quantity needed for disposable items (reusable items"
^DIC(19,9455,1,12,0)="are not removed from the inventory point during assembly).  If any"
^DIC(19,9455,1,13,0)="item's new quantity on-hand falls below zero, a warning message will"
^DIC(19,9455,1,14,0)="be displayed on the screen."
^DIC(19,9455,1,14,2)="R;"
^DIC(19,9455,25)="PRCPCASK"
^DIC(19,9455,"U")="ASSEMBLE INSTRUMENT KIT"
^DIC(19,9456,0)="PRCP IK DISASSEMBLE^Disassemble Instrument Kit^^R^11740^^^^^^^"
^DIC(19,9456,1,0)="^^6^6^2940126^^"
^DIC(19,9456,1,1,0)="The Disassemble Instrument Kit option will break down the instrument"
^DIC(19,9456,1,2,0)="kit and return the individual disposable items back to stock.  When"
^DIC(19,9456,1,3,0)="an instrument kit is disassembled, the quantity on-hand for the"
^DIC(19,9456,1,4,0)="instrument kit will be decremented and the quantity on-hand for the"
^DIC(19,9456,1,5,0)="disposable items will be incremented.  The quantity on-hand for"
^DIC(19,9456,1,6,0)="reusable items will not change."
^DIC(19,9456,1,6,2)="R;"
^DIC(19,9456,25)="PRCPCDIK"
^DIC(19,9456,"U")="DISASSEMBLE INSTRUMENT KIT"
^DIC(19,9457,0)="PRCP CC/IK LOCATOR REPORT^Specific Item Or Instrument Kit Locator Report^^R^11740^^^^^^^"
^DIC(19,9457,1,0)="^^7^7^2940614^^^"
^DIC(19,9457,1,1,0)="The Specific Item Or Instrument Kit Locator Report will print which"
^DIC(19,9457,1,2,0)="case carts contain a specified item or instrument kit and which"
^DIC(19,9457,1,3,0)="instrument kits contain a specified item."
^DIC(19,9457,1,3,2)="R;"
^DIC(19,9457,1,4,0)=""
^DIC(19,9457,1,4,2)="R;"
^DIC(19,9457,1,5,0)="The report will print the case cart or instrument kit, the inventory"
^DIC(19,9457,1,6,0)="point which created the case cart or instrument kit and the quantity"
^DIC(19,9457,1,7,0)="needed to assemble the case cart or instrument kit."
^DIC(19,9457,25)="PRCPCRLO"
^DIC(19,9457,"U")="SPECIFIC ITEM OR INSTRUMENT KI"
^DIC(19,9458,0)="PRCP SURGERY MENU^Surgery Supply Ordering Menu^^M^11740^^^^^^^^^1^1"
^DIC(19,9458,1,0)="^^4^4^2940126^^"
^DIC(19,9458,1,1,0)="This is the main menu for the surgery users.  This menu will allow"
^DIC(19,9458,1,2,0)="surgery users to tie operation codes to specific case carts and"
^DIC(19,9458,1,3,0)="instrument kits.  It will also allow the surgery user to quickly"
^DIC(19,9458,1,4,0)="complete orders to SPD for scheduled surgical procedures."
^DIC(19,9458,10,0)="^19.01PI^7^7"
^DIC(19,9458,10,1,0)="9450^^3"
^DIC(19,9458,10,2,0)="9454^^6"
^DIC(19,9458,10,3,0)="9457^^9"
^DIC(19,9458,10,4,0)="9459^^15"
^DIC(19,9458,10,5,0)="9471^^12"
^DIC(19,9458,10,6,0)="9472^^12"
^DIC(19,9458,10,7,0)="9482^"
^DIC(19,9458,10,"B",9450,1)=""
^DIC(19,9458,10,"B",9454,2)=""
^DIC(19,9458,10,"B",9457,3)=""
^DIC(19,9458,10,"B",9459,4)=""
^DIC(19,9458,10,"B",9471,5)=""
^DIC(19,9458,10,"B",9472,6)=""
^DIC(19,9458,10,"B",9482,7)=""
^DIC(19,9458,15)="K PRCP,PRC"
^DIC(19,9458,20)="K:$G(PRCP(""DPTYPE""))'=""S"" PRCP S PRCP(""DPTYPE"")=""S"" D DISPLAY^PRCPUSEL I '$G(PRCP(""I"")) S XQUIT=1 D NOMENU^PRCPUSEL"
^DIC(19,9458,99)="62195,30816"
^DIC(19,9458,"U")="SURGERY SUPPLY ORDERING MENU"
^DIC(19,9459,0)="PRCP SURGERY ORDER^Enter/Edit Surgical Case Cart Request^^R^11740^^^^^^^"
^DIC(19,9459,1,0)="^^7^7^2940727^^"
^DIC(19,9459,1,1,0)="The Enter/Edit Surgical Case Cart Request option will allow a Surgery"
^DIC(19,9459,1,2,0)="user to quickly place orders to SPD for scheduled operation"
^DIC(19,9459,1,3,0)="procedures.  The Surgery user can specify the patient and scheduled"
^DIC(19,9459,1,4,0)="operation.  If there are case carts tied to the operation, the user"
^DIC(19,9459,1,5,0)="can quickly release the order to SPD and the picking ticket will"
^DIC(19,9459,1,6,0)="automatically print in SPD."
^DIC(19,9459,1,7,0)=""
^DIC(19,9459,25)="PRCPCSOR"
^DIC(19,9459,"U")="ENTER/EDIT SURGICAL CASE CART "
^DIC(19,9460,0)="PRCP AVAILABILITY LISTING^Availability Listing^^R^11740^^^^^^^"
^DIC(19,9460,1,0)="^^18^18^2940126^^"
^DIC(19,9460,1,1,0)="The Availability Listing will print the item master number,"
^DIC(19,9460,1,2,0)="description, nsn, unit per issue, group category, quantity on-hand,"
^DIC(19,9460,1,3,0)="quantity due-in, quantity due-out, reorder point, issue multiple,"
^DIC(19,9460,1,4,0)="average unit cost, total value, and if the item is set to 'kill when"
^DIC(19,9460,1,5,0)="zero.'"
^DIC(19,9460,1,5,2)="R;"
^DIC(19,9460,1,6,0)=" "
^DIC(19,9460,1,7,0)="The warehouse will have the option to sort by the selected nsn or"
^DIC(19,9460,1,8,0)="account code.  The report will sort by account code and nsn."
^DIC(19,9460,1,8,2)="R;"
^DIC(19,9460,1,9,0)=" "
^DIC(19,9460,1,9,2)="R;"
^DIC(19,9460,1,10,0)="The primary will have the option to select specific group categories"
^DIC(19,9460,1,11,0)="to display.  The report will sort by group category and description."
^DIC(19,9460,1,11,2)="R;"
^DIC(19,9460,1,12,0)=""
^DIC(19,9460,1,12,2)="R;"
^DIC(19,9460,1,13,0)="The user has the option to print a summary of the report data.  By"
^DIC(19,9460,1,14,0)="printing the summary, the report will not display each item.  In the"
^DIC(19,9460,1,15,0)="warehouse inventory point, the inventory value by account code will"
^DIC(19,9460,1,16,0)="be summarized.  In the primary and secondary inventory points, the"
^DIC(19,9460,1,17,0)="inventory value by group category will be summarized."
^DIC(19,9460,1,17,2)="R;"
^DIC(19,9460,1,18,0)=""
^DIC(19,9460,25)="PRCPRAVL"
^DIC(19,9460,"U")="AVAILABILITY LISTING"
^DIC(19,9461,0)="PRCP INVENTORY SALES REPORT^Inventory Sales Report^^R^11740^^^^^^^326"
^DIC(19,9461,1,0)="^^20^20^3001102^"
^DIC(19,9461,1,1,0)="The Inventory Sales Report will print the item master number,"
^DIC(19,9461,1,2,0)="description, nsn (for whse), date issued, quantity sold, selling"
^DIC(19,9461,1,3,0)="cost, and total value sold."
^DIC(19,9461,1,4,0)=" "
^DIC(19,9461,1,5,0)="The warehouse will have the option to select specific item nsn's and"
^DIC(19,9461,1,6,0)="distribution points to display.  The user can also specify the issue"
^DIC(19,9461,1,7,0)="date range for sales.  The report will sort by distribution point"
^DIC(19,9461,1,8,0)="and nsn."
^DIC(19,9461,1,9,0)=" "
^DIC(19,9461,1,10,0)="The primary will have the option to select specific distribution"
^DIC(19,9461,1,11,0)="points and the issue date range for sales.  The report will sort by"
^DIC(19,9461,1,12,0)="distribution point and description."
^DIC(19,9461,1,13,0)=" "
^DIC(19,9461,1,14,0)="The secondary has the option to select specific recipients and the date"
^DIC(19,9461,1,15,0)="range.  The report will sort by recipient and item description."
^DIC(19,9461,1,16,0)=" "
^DIC(19,9461,1,17,0)="Additionally, the user of any of these reports has the option to print a"
^DIC(19,9461,1,18,0)="summary of the report data.  By printing the summary, the report will"
^DIC(19,9461,1,19,0)="eliminate the print of each item and only print the total sales to"
^DIC(19,9461,1,20,0)="selected distribution points or recipients."
^DIC(19,9461,25)="PRCPRISR"
^DIC(19,9461,99)="55908,26912"
^DIC(19,9461,"U")="INVENTORY SALES REPORT"
^DIC(19,9462,0)="PRCP ADJUSTMENT VOUCHER RECAP^Adjustment Voucher Recap^^R^11740^^^^^^^"
^DIC(19,9462,1,0)="^^17^17^2940126^^"
^DIC(19,9462,1,1,0)="The Adjustment Voucher Recap will print all adjustments to the"
^DIC(19,9462,1,2,0)="inventory point for the specified month and year.  The report will"
^DIC(19,9462,1,3,0)="print the item master number, description, nsn (for whse), and unit"
^DIC(19,9462,1,4,0)="per issue.  The report will break out each transaction register entry"
^DIC(19,9462,1,5,0)="and print the reference number, transaction number, date of"
^DIC(19,9462,1,6,0)="adjustment, adjustment units, quantity adjusted, value adjusted,"
^DIC(19,9462,1,7,0)="selling value, fund control point, reason code, and user."
^DIC(19,9462,1,7,2)="R;"
^DIC(19,9462,1,8,0)=" "
^DIC(19,9462,1,9,0)="The inventory points will have the option to specify the month and"
^DIC(19,9462,1,10,0)="year for adjustments.  The warehouse report will sort by nsn.  The"
^DIC(19,9462,1,11,0)="primary and secondary report will sort by description."
^DIC(19,9462,1,11,2)="R;"
^DIC(19,9462,1,12,0)=""
^DIC(19,9462,1,12,2)="R;"
^DIC(19,9462,1,13,0)="The user has the option to print a summary of the report data.  By"
^DIC(19,9462,1,14,0)="printing the summary, the report will not display each item and"
^DIC(19,9462,1,15,0)="transaction register entry.  It will only print a summary of account"
^DIC(19,9462,1,16,0)="code adjustments broken out by positive and negative adjustments."
^DIC(19,9462,1,16,2)="R;"
^DIC(19,9462,1,17,0)=""
^DIC(19,9462,25)="PRCPRADJ"
^DIC(19,9462,"U")="ADJUSTMENT VOUCHER RECAP"
^DIC(19,9463,0)="PRCP COST TREND ANALYSIS^Cost Trend Analysis Report^^R^11740^^^^^^^"
^DIC(19,9463,1,0)="^^23^23^2940126^^"
^DIC(19,9463,1,1,0)="The Cost Trend Analysis Report will compute the average item cost"
^DIC(19,9463,1,2,0)="for the specified period based on the monthly opening balance last"
^DIC(19,9463,1,3,0)="receipt cost.  It will compare the computed average item cost with"
^DIC(19,9463,1,4,0)="the current monthly opening balance average cost and display the"
^DIC(19,9463,1,5,0)="percent increase or decrease change.  The report will print the item"
^DIC(19,9463,1,6,0)="master number, description, nsn (for whse), unit per issue,"
^DIC(19,9463,1,7,0)="cumulative average cost, current month average item cost, and percent"
^DIC(19,9463,1,8,0)="change.  It will break out each month and year in the selected date"
^DIC(19,9463,1,9,0)="range and display the last cost opening balance."
^DIC(19,9463,1,9,2)="R;"
^DIC(19,9463,1,10,0)=" "
^DIC(19,9463,1,11,0)="The user will have the option to specify the date range which should"
^DIC(19,9463,1,12,0)="be used in computing the average item cost.  The user can also"
^DIC(19,9463,1,13,0)="specify which items to display and to print only a summary of the"
^DIC(19,9463,1,14,0)="report.  If the user selects to print only a summary, the report"
^DIC(19,9463,1,15,0)="will not break out each month and year on the report."
^DIC(19,9463,1,15,2)="R;"
^DIC(19,9463,1,16,0)=""
^DIC(19,9463,1,16,2)="R;"
^DIC(19,9463,1,17,0)="The warehouse can select specific nsn's to display and the report"
^DIC(19,9463,1,18,0)="will sort by nsn.  The primary and secondary can select specific"
^DIC(19,9463,1,19,0)="item master numbers to display and the report will sort by"
^DIC(19,9463,1,20,0)="description."
^DIC(19,9463,1,20,2)="R;"
^DIC(19,9463,1,21,0)=" "
^DIC(19,9463,1,22,0)="The primary will have the option to select specific group categories"
^DIC(19,9463,1,23,0)="to display.  The report will sort by group category and description."
^DIC(19,9463,25)="PRCPRCTA"
^DIC(19,9463,"U")="COST TREND ANALYSIS REPORT"
^DIC(19,9464,0)="PRCP DIETETIC COST REPORT^Dietetic Cost Report^^R^11740^^^^^^^"
^DIC(19,9464,1,0)="^^4^4^2940126^^"
^DIC(19,9464,1,1,0)="The Dietetic Cost Report will print items received into specified"
^DIC(19,9464,1,2,0)="inventory points.  The report is sorted by selected inventory point,"
^DIC(19,9464,1,3,0)="food group (from the item master file), nsn, and selected date"
^DIC(19,9464,1,4,0)="received."
^DIC(19,9464,25)="PRCPRDCR"
^DIC(19,9464,"U")="DIETETIC COST REPORT"
^DIC(19,9465,0)="PRCP SUBSTITUTE LISTING^Substitute Listing Report^^R^11740^^^^^^^"
^DIC(19,9465,1,0)="^^7^7^2940126^^"
^DIC(19,9465,1,1,0)="The Substitute Listing Report will print the item master number,"
^DIC(19,9465,1,2,0)="description, nsn, unit per issue, quantity on-hand, and substitute"
^DIC(19,9465,1,3,0)="items."
^DIC(19,9465,1,3,2)="R;"
^DIC(19,9465,1,4,0)=" "
^DIC(19,9465,1,4,2)="R;"
^DIC(19,9465,1,5,0)="The warehouse will have the option to select specific item nsn's to"
^DIC(19,9465,1,6,0)="display.  The report will sort by nsn."
^DIC(19,9465,1,7,0)=""
^DIC(19,9465,25)="PRCPRSUB"
^DIC(19,9465,"U")="SUBSTITUTE LISTING REPORT"
^DIC(19,9466,0)="PRCP ABBREVIATED ITEM REPORT^Abbreviated Item Report^^R^11740^^^^^^^"
^DIC(19,9466,1,0)="^^10^10^2940126^^"
^DIC(19,9466,1,1,0)="The Abbreviated Item Report will print the item master number,"
^DIC(19,9466,1,2,0)="description, nsn (for whse), unit per issue, quantity on-hand, main"
^DIC(19,9466,1,3,0)="storage location, and additional storage locations."
^DIC(19,9466,1,3,2)="R;"
^DIC(19,9466,1,4,0)=" "
^DIC(19,9466,1,5,0)="The warehouse will have the option to select specific item nsn's to"
^DIC(19,9466,1,6,0)="display.  The report will sort by nsn."
^DIC(19,9466,1,7,0)=" "
^DIC(19,9466,1,8,0)="The primary and secondary will have the option to select specific"
^DIC(19,9466,1,9,0)="group categories to display.  The report will sort by group category"
^DIC(19,9466,1,10,0)="and description."
^DIC(19,9466,25)="PRCPRAIR"
^DIC(19,9466,99)="55908,24860"
^DIC(19,9466,"U")="ABBREVIATED ITEM REPORT"
^DIC(19,9467,0)="PRCP CONVERSION FACTOR REPORT^Conversion Factor Report^^R^11740^^^^^^^"
^DIC(19,9467,1,0)="^^12^12^2940614^^^"
^DIC(19,9467,1,1,0)="The Conversion Factor Report will display the inventory point items"
^DIC(19,9467,1,2,0)="with procurement sources and conversion factors.  The report will"
^DIC(19,9467,1,3,0)="print the item master number, description, nsn, unit per issue,"
^DIC(19,9467,1,4,0)="quantity on-hand, procurement sources, unit per receipt and"
^DIC(19,9467,1,5,0)="conversion factor."
^DIC(19,9467,1,5,2)="R;"
^DIC(19,9467,1,6,0)=" "
^DIC(19,9467,1,6,2)="R;"
^DIC(19,9467,1,7,0)="The warehouse will have the option to select specific item nsn's to"
^DIC(19,9467,1,8,0)="display.  The report will sort by nsn."
^DIC(19,9467,1,9,0)=" "
^DIC(19,9467,1,10,0)="The primary and secondary will have the option to select specific"
^DIC(19,9467,1,11,0)="group categories to display.  The report will sort by group category"
^DIC(19,9467,1,12,0)="and description."
^DIC(19,9467,25)="PRCPRCFR"
^DIC(19,9467,"U")="CONVERSION FACTOR REPORT"
^DIC(19,9468,0)="PRCP QUANTITY DISTRIBUTION^Quantity Distribution Report^^R^11740^^^^^^^326"
^DIC(19,9468,1,0)="^^19^19^3001102^"
^DIC(19,9468,1,1,0)="The Quantity Distribution Report will print a comparison between the"
^DIC(19,9468,1,2,0)="normal stock level (entered by the user) and the calculated average"
^DIC(19,9468,1,3,0)="stock distributed for the past year.  This report will help in making"
^DIC(19,9468,1,4,0)="adjustments to the stock levels (temporary, emergency, and normal)."
^DIC(19,9468,1,5,0)="The report will break out the quantity distributed by month which will"
^DIC(19,9468,1,6,0)="help in determining usage trends for items."
^DIC(19,9468,1,7,0)=" "
^DIC(19,9468,1,8,0)="The report will print the item master number, description, nsn (for"
^DIC(19,9468,1,9,0)="whse), unit per issue, standard reorder point, optional reorder point,"
^DIC(19,9468,1,10,0)="temporary stock level, emergency stock level, and normal stock level."
^DIC(19,9468,1,11,0)=" "
^DIC(19,9468,1,12,0)="The warehouse will have the option to select specific item nsn's to"
^DIC(19,9468,1,13,0)="display.  The report will sort by nsn."
^DIC(19,9468,1,14,0)=" "
^DIC(19,9468,1,15,0)="The primary will have the option to select specific Master Item numbers"
^DIC(19,9468,1,16,0)="to display.  The report will sort by description."
^DIC(19,9468,1,17,0)=" "
^DIC(19,9468,1,18,0)="The secondary will have options similar to the primary but the report will"
^DIC(19,9468,1,19,0)="display recipients instead of distribution points."
^DIC(19,9468,25)="PRCPRQDR"
^DIC(19,9468,"U")="QUANTITY DISTRIBUTION REPORT"
^DIC(19,9469,0)="PRCP STOCK STATUS REPORT^Stock Status Report^^R^11740^^^^^^^"
^DIC(19,9469,1,0)="^^11^11^2940126^^"
^DIC(19,9469,1,1,0)="The Stock Status Report will print a summary of all issues,"
^DIC(19,9469,1,2,0)="receipts, and adjustments with the opening and closing balances by"
^DIC(19,9469,1,3,0)="account codes.  It will calculate the turnover rate, inactive item"
^DIC(19,9469,1,4,0)="percent, long supply percent, and non-issuable percent."
^DIC(19,9469,1,4,2)="R;"
^DIC(19,9469,1,5,0)=" "
^DIC(19,9469,1,6,0)="All inventory points will have the option to select the specified"
^DIC(19,9469,1,7,0)="month and year for the report.  Also, users can enter the item"
^DIC(19,9469,1,8,0)="inactivity cutoff month and year.  Items which have not had activity"
^DIC(19,9469,1,9,0)="after the specified cutoff date, will be used to calculate the"
^DIC(19,9469,1,10,0)="inactive item percent on the report."
^DIC(19,9469,1,10,2)="R;"
^DIC(19,9469,1,11,0)=""
^DIC(19,9469,25)="PRCPRSSR"
^DIC(19,9469,"U")="STOCK STATUS REPORT"
^DIC(19,9470,0)="PRCP DAYS STOCK ON HAND REPORT^Days Of Stock On Hand Report^^R^11740^^^^^^^"
^DIC(19,9470,1,0)="^^17^17^2940211^^^"
^DIC(19,9470,1,1,0)="The Days Of Stock On Hand Report will print the item master number,"
^DIC(19,9470,1,2,0)="description, nsn (for whse), unit per issue, total usage for the"
^DIC(19,9470,1,3,0)="period, average usage per day, current quantity on-hand, number of"
^DIC(19,9470,1,4,0)="days of quantity on-hand remaining, and the total selling value of"
^DIC(19,9470,1,5,0)="stock on hand.  The total selling value of stock on-hand will be"
^DIC(19,9470,1,6,0)="totaled at the end of the report."
^DIC(19,9470,1,7,0)=" "
^DIC(19,9470,1,7,2)="R;"
^DIC(19,9470,1,8,0)="The warehouse will have the option to select specific item nsn's to"
^DIC(19,9470,1,8,2)="R;"
^DIC(19,9470,1,9,0)="display and the number of days stock on-hand.  Items which are"
^DIC(19,9470,1,10,0)="greater or less than the specified number of days stock on-hand will"
^DIC(19,9470,1,11,0)="be printed.  The report will sort ny nsn."
^DIC(19,9470,1,12,0)=" "
^DIC(19,9470,1,12,2)="R;"
^DIC(19,9470,1,13,0)="The primary and secondary will have the option to select specific"
^DIC(19,9470,1,13,2)="R;"
^DIC(19,9470,1,14,0)="group categories to display and the number of days stock on-hand. "
^DIC(19,9470,1,15,0)="Items which are greater than or less than the specified number of days"
^DIC(19,9470,1,16,0)="stock on-hand will be printed.  The report will sort by group category"
^DIC(19,9470,1,17,0)="and description."
^DIC(19,9470,25)="PRCPRSOH"
^DIC(19,9470,99)="55908,27598"
^DIC(19,9470,"U")="DAYS OF STOCK ON HAND REPORT"
^DIC(19,9471,0)="PRCP CC LINK OPCODES^Link Operation Codes to Case Carts^^R^11740^^^^^^^"
^DIC(19,9471,1,0)="^^4^4^2940126^^"
^DIC(19,9471,1,1,0)="The Link Operation Codes to Case Carts option will allow the user to"
^DIC(19,9471,1,2,0)="link operation codes to specific case carts.  When a patient is"
^DIC(19,9471,1,3,0)="scheduled for an operation code, the system will recommend the case"
^DIC(19,9471,1,4,0)="carts which should be ordered."
^DIC(19,9471,25)="OPCODES^PRCPCED0"
^DIC(19,9471,"U")="LINK OPERATION CODES TO CASE C"
^DIC(19,9472,0)="PRCP CC OPCODE-CC LINK REPORT^Operation Code-Case Cart Link Report^^R^11740^^^^^^^"
^DIC(19,9472,1,0)="^^8^8^2940126^^"
^DIC(19,9472,1,1,0)="The Operation Code-Case Cart Link Report will print a list of"
^DIC(19,9472,1,2,0)="selected case carts displaying the operation codes linked to the case"
^DIC(19,9472,1,3,0)="cart."
^DIC(19,9472,1,3,2)="R;"
^DIC(19,9472,1,4,0)=""
^DIC(19,9472,1,4,2)="R;"
^DIC(19,9472,1,5,0)="The report will print the case cart description, item master number,"
^DIC(19,9472,1,6,0)="the inventory point which the case cart should be ordered from, and"
^DIC(19,9472,1,7,0)="the current quantity on-hand."
^DIC(19,9472,1,7,2)="R;"
^DIC(19,9472,1,8,0)=""
^DIC(19,9472,25)="PRCPCROC"
^DIC(19,9472,"U")="OPERATION CODE-CASE CART LINK "
^DIC(19,9473,0)="PRCP DIST ORDER PROCESSING^Distribution Order Processing^^R^11740^^^^^^^"
^DIC(19,9473,1,0)="^^3^3^2940126^^"
^DIC(19,9473,1,1,0)="The Distribution Order Processing option is the main option for"
^DIC(19,9473,1,2,0)="entering, releasing, and posting distribution orders from the primary"
^DIC(19,9473,1,3,0)="inventory point to the secondary inventory point."
^DIC(19,9473,25)="PRCPOPL"
^DIC(19,9473,"U")="DISTRIBUTION ORDER PROCESSING"
^DIC(19,9474,0)="PRCP AUTOMATIC LEVEL SETTER^Automatic Level Setter^^R^11740^^^^^^^"
^DIC(19,9474,1,0)="^^4^4^2931229^"
^DIC(19,9474,1,1,0)="This report will print the current inventory levels versus the computer"
^DIC(19,9474,1,2,0)="estimated levels.  If you have the manager key for the inventory point,"
^DIC(19,9474,1,3,0)="you will have the option to automatically update the current levels to"
^DIC(19,9474,1,4,0)="the estimated levels."
^DIC(19,9474,25)="PRCPRALS"
^DIC(19,9474,99)="55908,51585"
^DIC(19,9474,"U")="AUTOMATIC LEVEL SETTER"
^DIC(19,9475,0)="PRCP EDIT MASTER ITEM FILE^Master Item File Edit^^R^11740^^^^^^^"
^DIC(19,9475,1,0)="^^3^3^2940209^^"
^DIC(19,9475,1,1,0)="This option is used to edit the fields in the item master file which"
^DIC(19,9475,1,2,0)="are used by the SPD inventory point for case carts and instrument"
^DIC(19,9475,1,3,0)="kits."
^DIC(19,9475,25)="PRCPE441"
^DIC(19,9475,"U")="MASTER ITEM FILE EDIT"
^DIC(19,9476,0)="PRCP INQUIRE FILE ENTRIES^File Inquiry^^R^11740^^^^^^^"
^DIC(19,9476,1,0)="^^3^3^2940210^"
^DIC(19,9476,1,1,0)="This option will allow the user to inquire to VA FileMan file entries."
^DIC(19,9476,1,2,0)="The option will display selected entry data on the screen for the user"
^DIC(19,9476,1,3,0)="to review."
^DIC(19,9476,25)="PRCPRINQ"
^DIC(19,9476,"U")="FILE INQUIRY"
