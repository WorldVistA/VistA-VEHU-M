^DIC(19,3876,0)="FHREC6^Enter/Edit Serving Utensils^^R^10000000020^^^^^^^"
^DIC(19,3876,1,0)="^^2^2^2880717^^"
^DIC(19,3876,1,1,0)="This option allows for the addition/editing of serving"
^DIC(19,3876,1,2,0)="utensil names contained in the Serving Utensil file (114.3)."
^DIC(19,3876,25)="EN5^FHREC"
