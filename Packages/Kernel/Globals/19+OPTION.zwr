^DIC(19,7943,1,0)="4^19.06^4^4^3020430^^"
^DIC(19,7943,1,1,0)="This option will allow a Timekeeper to list all unresolved timecard exceptions"
^DIC(19,7943,1,2,0)="from prior pay periods for any T&L assigned to them.  The employee's name, time"
^DIC(19,7943,1,3,0)="and leave unit, date of the exception and a short message are displayed."
^DIC(19,7943,1,4,0)=""
