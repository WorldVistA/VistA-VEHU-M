^DIC(19,6917,0)="ORCL KEY ALLOCATION^Allocate OE/RR Security Keys^^A^11712^^^^^^^^^1"
^DIC(19,6917,1,0)="^^2^2^2920226^^"
^DIC(19,6917,1,1,0)="This option is to assist the OE/RR Clinical Coordinator when allocating"
^DIC(19,6917,1,2,0)="Security keys to users of the OE/RR system."
^DIC(19,6917,20)="D KEY^ORUPREF1"
^DIC(19,6917,99)="55455,36684"
^DIC(19,6917,"U")="ALLOCATE OE/RR SECURITY KEYS"
^DIC(19,6918,0)="ORCL PRINT FORMAT^Print Formats^^A^11712^^^^^^^^^1"
^DIC(19,6918,1,0)="^^2^2^2960618^^^^"
^DIC(19,6918,1,1,0)="This option allows the user to define formats for printing labels and"
^DIC(19,6918,1,2,0)="requisitions for orders."
^DIC(19,6918,20)="D EN^ORPR00"
^DIC(19,6918,"U")="PRINT FORMATS"
^DIC(19,6920,0)="ORLP ADD PROVIDER^Provider       (Add to list)^^A^11720^^^^^^^^^1^1"
^DIC(19,6920,1,0)="^19.06^3^3^3000516^^^^"
^DIC(19,6920,1,1,0)="You can create a patient list by selecting 1 or more providers or you can"
^DIC(19,6920,1,2,0)="add providers to a currently existing list using this option.  After you"
^DIC(19,6920,1,3,0)="have added a provider, you can delete or add patients to customize the list."
^DIC(19,6920,15)="D OKILL^ORLP0"
^DIC(19,6920,20)="D PROV^ORLP01"
^DIC(19,6920,"U")="PROVIDER       (ADD TO LIST)"
^DIC(19,6921,0)="ORLP ADD SPECIALTY^Specialty      (Add to list)^^A^11720^^^^^^^^^1^1"
^DIC(19,6921,1,0)="^19.06^4^4^3000516^^^^"
^DIC(19,6921,1,1,0)="You can create a patient list by selecting 1 or more specialties, or"
^DIC(19,6921,1,2,0)="you can add specialties to a currently existing list using this option."
^DIC(19,6921,1,3,0)="Once you have added a specialty, you can add or delete patients to"
^DIC(19,6921,1,4,0)="customize the list."
^DIC(19,6921,15)="D OKILL^ORLP0"
^DIC(19,6921,20)="D SPEC^ORLP01"
^DIC(19,6921,"U")="SPECIALTY      (ADD TO LIST)"
^DIC(19,6926,0)="ORTASK 24HR SUMMARY^Task 24hr Order Summary by Location^^R^11712^^^^^^^"
^DIC(19,6926,1,0)="^^3^3^2970224^^^^"
^DIC(19,6926,1,1,0)="This queued option tasks 24-hr. order summaries by location to the device"
^DIC(19,6926,1,2,0)="specified by the parameter ORPF DAILY ORDER SUMMARY DEVC for each location."
^DIC(19,6926,1,3,0)="The parameter ORPF PRINT DAILY ORDER SUMMARY must also be set."
^DIC(19,6926,25)="MAIN^ORPRS08"
^DIC(19,6926,200)="^^1D"
^DIC(19,6926,200.9)="y"
^DIC(19,6926,"U")="TASK 24HR ORDER SUMMARY BY LOC"
^DIC(19,6927,0)="OR ADD ORDERS^Add New Orders^^A^11712^^^^^^^^^1^1"
^DIC(19,6927,1,0)="^^7^7^2920226^^^^"
^DIC(19,6927,1,1,0)="This menu allows patient orders to be entered."
^DIC(19,6927,1,2,0)=" "
^DIC(19,6927,1,3,0)="TECHNICAL NOTE:"
^DIC(19,6927,1,4,0)="This option is used to transfer control of menus and options used in"
^DIC(19,6927,1,5,0)="the OE/RR package to the Protocol file (101).  Items should NOT be"
^DIC(19,6927,1,6,0)="placed on this menu.  The counterpart of this menu in file 101 is"
^DIC(19,6927,1,7,0)="ORADD where menu items used with OE/RR are placed."
^DIC(19,6927,15)="D KILL^ORCMENU"
^DIC(19,6927,20)="K ORVP,ORTAB D EN^ORQPT,EN^ORCMENU"
^DIC(19,6927,99)="54035,74852"
^DIC(19,6927,"U")="ADD NEW ORDERS"
^DIC(19,6928,0)="OR REVIEW ORDERS^Act On Existing Orders^^A^11712^^^^^^^170^^1^"
^DIC(19,6928,1,0)="^^7^7^2920226^^^^"
^DIC(19,6928,1,1,0)="This menu allows patient orders to be reviewed."
^DIC(19,6928,1,2,0)=" "
^DIC(19,6928,1,3,0)="TECHNICAL NOTE:"
^DIC(19,6928,1,4,0)="This option is used to transfer control of menus and options used in"
^DIC(19,6928,1,5,0)="the OE/RR package to the Protocol file (101).  Items should NOT be"
^DIC(19,6928,1,6,0)="placed on this menu.  The counterpart of this menu in file 101 is"
^DIC(19,6928,1,7,0)="ORREV where menu items used with OE/RR are placed."
^DIC(19,6928,2)="y"
^DIC(19,6928,15)=""
^DIC(19,6928,20)="S ORTAB=""ORDERS"" D ^ORCHART"
^DIC(19,6928,99)="54035,74852"
^DIC(19,6928,"U")="ACT ON EXISTING ORDERS"
^DIC(19,6929,0)="OR PROFILES^Package Profiles^^A^11712^^^^^^^^^1^1"
^DIC(19,6929,1,0)="^^7^7^2920226^^^^"
^DIC(19,6929,1,1,0)="This menu allows patient profiles to be displayed"
^DIC(19,6929,1,2,0)=" "
^DIC(19,6929,1,3,0)="TECHNICAL NOTE:"
^DIC(19,6929,1,4,0)="This option is used to transfer control of menus and options used in"
^DIC(19,6929,1,5,0)="the OE/RR package to the Protocol file (101).  Items should NOT be"
^DIC(19,6929,1,6,0)="placed on this menu.  The counterpart of this menu in file 101 is"
^DIC(19,6929,1,7,0)="OROPRO where menu items used with OE/RR are placed."
^DIC(19,6929,15)="K ORLIST,ORINDX"
^DIC(19,6929,20)="D ^ORCHART"
^DIC(19,6929,99)="54035,74852"
^DIC(19,6929,"U")="PACKAGE PROFILES"
^DIC(19,6930,0)="ORLP TEAM ADD^Create/Add to      Team List^^A^11712^^^^^^^^^1^1"
^DIC(19,6930,1,0)="^^2^2^2940505^^^^"
^DIC(19,6930,1,1,0)="This option allows team list creation or the addition of autolinks, "
^DIC(19,6930,1,2,0)="providers, and/or patients to existing lists."
^DIC(19,6930,15)="D OKILL^ORLP0"
^DIC(19,6930,20)="D TM^ORLP"
^DIC(19,6930,99)="55425,44216"
^DIC(19,6930,"U")="CREATE/ADD TO      TEAM LIST"
^DIC(19,6931,0)="ORTASK 24HR CHART COPIES^Task 24hr Chart Copy Print by Location^^R^11712^^^^^^^170"
^DIC(19,6931,1,0)="^^3^3^2970327^^^^"
^DIC(19,6931,1,1,0)="This queued option tasks the 24-hr chart copy print by location to the"
^DIC(19,6931,1,2,0)="device specified for each hospital location by the parameter"
^DIC(19,6931,1,3,0)="ORPF PRINT CHART COPY SUMMARY."
^DIC(19,6931,25)="MAIN^ORPRS06"
^DIC(19,6931,200)="^^1D"
^DIC(19,6931,200.9)="y"
^DIC(19,6931,"U")="TASK 24HR CHART COPY PRINT BY "
