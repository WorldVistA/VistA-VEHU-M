^DIC(19,15663,"U")="LAB ORDER CHECKS"
^DIC(19,15664,0)="EHM-00485^Check Lab orders from file 100 to 69^^A^1^^^^^^^170^^1^^"
^DIC(19,15664,1,0)="^^6^6^3240328^"
^DIC(19,15664,1,1,0)="This option checks for inconsistencies between OE/RR and Lab files"
^DIC(19,15664,1,2,0)="and attempts to correct them.  There is no set frequency for running this"
^DIC(19,15664,1,3,0)="option, but it should be run every few months to check for"
^DIC(19,15664,1,4,0)="inconsistencies.  This option will take a long time to run, so run it at"
^DIC(19,15664,1,5,0)="night or over a weekend."
^DIC(19,15664,1,6,0)="Cloned from ""ORE LAB ORDERS CHECK 100=>69"" option."
^DIC(19,15664,3)=""
^DIC(19,15664,20)="D EN^ORELR"
^DIC(19,15664,"U")="CHECK LAB ORDERS FROM FILE 100"
^DIC(19,15665,0)="EHM-00486^Check Lab orders from file 69 to 100^UNDER CONSTRUCTION^A^1^^^^^^^170^^1^^"
^DIC(19,15665,1,0)="^^6^6^3240328^"
^DIC(19,15665,1,1,0)="This option checks for inconsistencies between OE/RR and Lab files"
^DIC(19,15665,1,2,0)="and attempts to correct them.  There is no set frequency for running this"
^DIC(19,15665,1,3,0)="option, but it should be run every few months to check for"
^DIC(19,15665,1,4,0)="inconsistencies.  This option will take a long time to run, so run it at"
^DIC(19,15665,1,5,0)="night or over a weekend."
^DIC(19,15665,1,6,0)="Cloned from ""ORE LAB ORDERS CHECK 69=>100"" option."
^DIC(19,15665,3)=""
^DIC(19,15665,20)="D EN1^ORELR"
^DIC(19,15665,"U")="CHECK LAB ORDERS FROM FILE 69 "
^DIC(19,15666,0)="EHM-00487^Orderable Items Records Validation^^R^1^^^^^^^170^^^^"
^DIC(19,15666,1,0)="^^22^22^3240328^"
^DIC(19,15666,1,1,0)="A utility to scan the Orderable Items file and confirm the records in "
^DIC(19,15666,1,2,0)="this file have matching source file records. The source files checked for "
^DIC(19,15666,1,3,0)="are documented in the OE/RR Version 3 Package Interface Specifications "
^DIC(19,15666,1,4,0)="July, 2001 document. This utility creates a report documenting the "
^DIC(19,15666,1,5,0)="following:"
^DIC(19,15666,1,6,0)="        1. Orderable Item records without a source IEN stored in the ID "
^DIC(19,15666,1,7,0)="           field."
^DIC(19,15666,1,8,0)="        2. Orderable Item records without a source Package code stored "
^DIC(19,15666,1,9,0)="           in the ID field."
^DIC(19,15666,1,10,0)="        3. Orderable Item records with an improperly formatted source"
^DIC(19,15666,1,11,0)="           Package code in the ID field."
^DIC(19,15666,1,12,0)="        4. Gives a summary of valid records by package."
^DIC(19,15666,1,13,0)="        5. Gives a detail of records without matching source records "
^DIC(19,15666,1,14,0)="           sorted by:"
^DIC(19,15666,1,15,0)="                5.1 Currently active records, will be flagged as "
^DIC(19,15666,1,16,0)="                    inactive, and subsorted by package."
^DIC(19,15666,1,17,0)="                5.2 Currently inactive records and subsorted by package."
^DIC(19,15666,1,18,0)="        6. A list of records with properly created ID field, but the "
^DIC(19,15666,1,19,0)="           package code is not on the package list in the Package "
^DIC(19,15666,1,20,0)="           Interface Specifications of July 2001. These will be listed as "
^DIC(19,15666,1,21,0)="           needing manual confirmation."
^DIC(19,15666,1,22,0)="Cloned from ""ORE ORDERABLE ITEMS VALIDATION"" option."
^DIC(19,15666,3)=""
^DIC(19,15666,25)="OREORV"
^DIC(19,15666,"U")="ORDERABLE ITEMS RECORDS VALIDA"
