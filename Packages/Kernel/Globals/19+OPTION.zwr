^DIC(19,6898,"U")="BUILD PATIENT LIST MENU"
^DIC(19,6899,0)="ORLP ADD ONE^Patient        (Add to list)^^A^11720^^^^^^^^^1^1"
^DIC(19,6899,1,0)="^19.06^2^2^3000516^^^^"
^DIC(19,6899,1,1,0)="This option lets you add patients to a list that has already"
^DIC(19,6899,1,2,0)="been created."
^DIC(19,6899,15)="D OKILL^ORLP0"
^DIC(19,6899,20)="D ADD^ORLP0"
^DIC(19,6899,"U")="PATIENT        (ADD TO LIST)"
^DIC(19,6900,0)="ORLP ADD WARD^Ward           (Add to list)^^A^11720^^^^^^^^^1^1"
^DIC(19,6900,1,0)="^19.06^4^4^3000516^^^^"
^DIC(19,6900,1,1,0)="You can create a patient list by selecting 1 or more wards or"
^DIC(19,6900,1,2,0)="you can add wards to a currently existing list "
^DIC(19,6900,1,3,0)="using this menu.  After you have added a ward, you can delete"
^DIC(19,6900,1,4,0)="or add patients to customize the list."
^DIC(19,6900,15)="D OKILL^ORLP0"
^DIC(19,6900,20)="D WARD^ORLP01"
^DIC(19,6900,"U")="WARD           (ADD TO LIST)"
^DIC(19,6901,0)="ORLP ADD CLINIC^Clinic         (Add to list)^^A^11720^^^^^^^^^1"
^DIC(19,6901,1,0)="^19.06^4^4^3000516^^^^"
^DIC(19,6901,1,1,0)="This option lets you add patients to a clinic list that is"
^DIC(19,6901,1,2,0)="already defined, or build a new patient list by clinic."
^DIC(19,6901,1,3,0)="After you have selected a clinic, you can add or delete patients"
^DIC(19,6901,1,4,0)="to further customize your list."
^DIC(19,6901,20)="D CLIN^ORLP01"
^DIC(19,6901,"U")="CLINIC         (ADD TO LIST)"
^DIC(19,6902,0)="ORLP MERGE^Merge              Existing Lists^^A^11720^^^^^^^^^1"
^DIC(19,6902,1,0)="^19.06^2^2^3000516^^^^"
^DIC(19,6902,1,1,0)="This option lets you merge the patients from one or several"
^DIC(19,6902,1,2,0)="lists together to create a bigger or more comprehensive list."
^DIC(19,6902,20)="D MERG^ORLP1"
^DIC(19,6902,"U")="MERGE              EXISTING LI"
^DIC(19,6903,0)="ORLP ADD LIST^Existing Lists (Add to list)^^A^11720^^^^^^^^^1^1"
^DIC(19,6903,1,0)="^19.06^2^2^3000516^^^^"
^DIC(19,6903,1,1,0)="This option lets you add patients to an existing list that"
^DIC(19,6903,1,2,0)="you have defined."
^DIC(19,6903,15)="D OKILL^ORLP0"
^DIC(19,6903,20)="D PERS^ORLP0"
^DIC(19,6903,"U")="EXISTING LISTS (ADD TO LIST)"
^DIC(19,6904,0)="ORLP LIST^Show Current Patient List^^A^11720^^^^^^^^^1"
^DIC(19,6904,1,0)="^19.06^1^1^3000516^^^"
^DIC(19,6904,1,1,0)="This option shows the patient list defined for a CRT session."
^DIC(19,6904,20)="D SHOW^ORLP0"
^DIC(19,6904,"U")="SHOW CURRENT PATIENT LIST"
^DIC(19,6905,0)="ORLP DELETE^Delete             Existing List(s)^^A^11720^^^^^^^^^1"
^DIC(19,6905,1,0)="^19.06^2^2^3000516^^^^"
^DIC(19,6905,1,1,0)="When you no longer need a patient list that you have built, you"
^DIC(19,6905,1,2,0)="can use this option to delete the list."
^DIC(19,6905,20)="S ORLST=1 D DEL^ORLP1"
^DIC(19,6905,99)="55455,36139"
^DIC(19,6905,"U")="DELETE             EXISTING LI"
^DIC(19,6906,0)="ORLP CLEAR^Clear Current Patient List^^A^11720^^^^^^^^^1"
^DIC(19,6906,1,0)="^19.06^4^4^3000516^^^^"
^DIC(19,6906,1,1,0)="Use this option to clear the current patient list from your work"
^DIC(19,6906,1,2,0)="area so that you can work with another list.  The list that you"
^DIC(19,6906,1,3,0)="clear with this option will still be available to work with at another"
^DIC(19,6906,1,4,0)="time if it was stored away at the time the list was defined."
^DIC(19,6906,20)="D CLEAR^ORLP1(.X)"
^DIC(19,6906,"U")="CLEAR CURRENT PATIENT LIST"
