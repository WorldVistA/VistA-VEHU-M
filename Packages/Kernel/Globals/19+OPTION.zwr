^DIC(19,16137,"U")="EXPORT/IMPORT A HEALTH SUMMARY"
^DIC(19,16138,0)="EHM-00959^Export a Health Summary Object^^R^1^^^^^^^^^^^"
^DIC(19,16138,1,0)="^19.06^5^5^3240328^^^"
^DIC(19,16138,1,1,0)="This option will allow a user to export a Health Summary "
^DIC(19,16138,1,2,0)="Object, and its corresponding Health Summary Type to a "
^DIC(19,16138,1,3,0)="Mailman message which can be sent to other accounts/sites"
^DIC(19,16138,1,4,0)="for import."
^DIC(19,16138,1,5,0)="Cloned from ""GMTS OBJ EXPORT"" option."
^DIC(19,16138,3)=""
^DIC(19,16138,25)="EXP^GMTSOBJ"
^DIC(19,16138,"U")="EXPORT A HEALTH SUMMARY OBJECT"
^DIC(19,16139,0)="EHM-00960^Import/Install a Health Summary Object^^R^1^^^^^^^^^^^"
^DIC(19,16139,1,0)="^19.06^11^11^3240328^^^"
^DIC(19,16139,1,1,0)="This option is used to install a Health Summary Object "
^DIC(19,16139,1,2,0)="exported using the GMTS OBJ EXPORT option.  The incoming "
^DIC(19,16139,1,3,0)="Object must first be unpacked from the incoming Mailman "
^DIC(19,16139,1,4,0)="message using Packman utilities.  Then this option is used "
^DIC(19,16139,1,5,0)="to install the object into the Health Summary files.  "
^DIC(19,16139,1,6,0)="If there is a Health Summary Type with the same name as "
^DIC(19,16139,1,7,0)="the Health Summary being imported, then you will be prompted"
^DIC(19,16139,1,8,0)="to either use the existing Health Summary Type, or to "
^DIC(19,16139,1,9,0)="rename the incoming Health Summary Type.  At no time will "
^DIC(19,16139,1,10,0)="an existing Health Summary Type be over written."
^DIC(19,16139,1,11,0)="Cloned from ""GMTS OBJ IMPORT/INSTALL"" option."
^DIC(19,16139,3)=""
^DIC(19,16139,25)="INS^GMTSOBJ"
^DIC(19,16139,"U")="IMPORT/INSTALL A HEALTH SUMMAR"
^DIC(19,16140,0)="EHM-00961^Print Health Summary Menu^^M^1^^^^^^^160^^^^"
^DIC(19,16140,1,0)="^^6^6^3240328^"
^DIC(19,16140,1,1,0)="This menu includes all of the various print options available for Health"
^DIC(19,16140,1,2,0)="Summaries, allowing the user to generate Health Summaries by Patient, by"
^DIC(19,16140,1,3,0)="Patient and a date range, by patient and a outpatient visit or an"
^DIC(19,16140,1,4,0)="admission, by Location, for patients at all clinics, and on an Ad Hoc"
^DIC(19,16140,1,5,0)="basis."
^DIC(19,16140,1,6,0)="Cloned from ""GMTS HS MENU"" option."
