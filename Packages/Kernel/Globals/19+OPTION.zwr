^DIC(19,11304,0)="TIUFZZ43 CLEANUP AFTER PTCH 43^Correct 'All' in Existing Menu Text^^A^755^^^^^^^^^1^^^"
^DIC(19,11304,1,0)="^^7^7^2990121^^"
^DIC(19,11304,1,1,0)="Should be run AFTER patch TIU*1*43 has been installed. Goes through TIU"
^DIC(19,11304,1,2,0)="DOCUMENT DEFINITION file (8925.1).  Checks all entries which have a parent"
^DIC(19,11304,1,3,0)="for Menu Text beginning with 'All' (upper, lower, or mixed case) or with a"
^DIC(19,11304,1,4,0)="space.  Changes such Menu Text to begin with 'AlX' in place of 'All' or"
^DIC(19,11304,1,5,0)="with the first letters of the entry NAME if Menu Text starts with a space."
^DIC(19,11304,1,6,0)="Printout shows any changes made.  Should be deleted when finished.  May be"
^DIC(19,11304,1,7,0)="run over itself."
^DIC(19,11304,20)="D WRITE^TIUFZZ43"
^DIC(19,11304,26)=""
^DIC(19,11304,"U")="CORRECT 'ALL' IN EXISTING MENU"
^DIC(19,11305,0)="LR LOINC MAP^Map Lab Tests to LOINC Codes^^R^1^^^^^^^26"
^DIC(19,11305,1,0)="^^8^8^3070301^"
^DIC(19,11305,1,1,0)="This option allows you to map Vista lab tests to LOINC codes."
^DIC(19,11305,1,2,0)="This option allows you to enter the Result NLT Code for a"
^DIC(19,11305,1,3,0)="lab test and/or LEDI HL7 Code for a specimen so that the test"
^DIC(19,11305,1,4,0)="can be mapped to a LOINC code."
^DIC(19,11305,1,5,0)=" "
^DIC(19,11305,1,6,0)="With patch LR*5.2*334, modification of NATIONAL VA LAB CODE (#64) field of"
^DIC(19,11305,1,7,0)="the LABORATORY TEST (#60) file, the user is able to select suffixed WKLD"
^DIC(19,11305,1,8,0)="CODE as test's NLT order code."
^DIC(19,11305,25)="LRLNC0"
^DIC(19,11305,"U")="MAP LAB TESTS TO LOINC CODES"
^DIC(19,11306,0)="LR LOINC TOPOGRAPHY^Topography Print With/Without LEDI HL7 Codes ^^R^10000000020^^^^^^n^26"
^DIC(19,11306,1,0)="^^4^4^3010806^"
^DIC(19,11306,1,1,0)="This option allows you to print a list of lab tests with or without"
^DIC(19,11306,1,2,0)="LEDI HL7 Codes/Time aspect. The specimen must have a LEDI HL7 Code and"
^DIC(19,11306,1,3,0)="time aspect before the test is mapped to a LOINC code.  This list will"
^DIC(19,11306,1,4,0)="show the specimens that need a LEDI HL7 Code, time aspect or both."
^DIC(19,11306,3.91,0)="^19.391"
^DIC(19,11306,25)="LRLNCTOP"
^DIC(19,11306,"U")="TOPOGRAPHY PRINT WITH/WITHOUT "
^DIC(19,11307,0)="LR LOINC PRINT NLT/LOINC^NLT/LOINC Codes Print^^R^10000000020^^^^^^^26"
^DIC(19,11307,1,0)="^^2^2^2990304^^^^"
^DIC(19,11307,1,1,0)="This option allows you to print a list of LOINC codes in the NLT file"
^DIC(19,11307,1,2,0)="(#64). Only the NLT with corresponding LOINC codes are printed."
^DIC(19,11307,25)="LRLNCPRT"
^DIC(19,11307,"U")="NLT/LOINC CODES PRINT"
^DIC(19,11308,0)="LR LOINC LEDI HL7 CODE^Add/Edit Topography Specimen HL7 Code^^R^10000000020^^^^^^^26"
^DIC(19,11308,1,0)="^^3^3^2990119^^^"
^DIC(19,11308,1,1,0)="This option allows you to add or edit LEDI HL7 Codes.  "
^DIC(19,11308,1,2,0)="We recommend that you have a listing of LEDI HL7 Codes"
^DIC(19,11308,1,3,0)="handy when adding or editing LEDI HL7 Codes.  "
^DIC(19,11308,25)="LRLNCUTL"
^DIC(19,11308,"U")="ADD/EDIT TOPOGRAPHY SPECIMEN H"
^DIC(19,11309,0)="LR LOINC LOOKUP^Find LOINC for Vista Lab Test^^R^10000000020^^^^^^^26"
^DIC(19,11309,1,0)="^19.06^8^8^3000419^^^^"
^DIC(19,11309,1,1,0)="This option allows you to lookup a LOINC code for a lab test and"
^DIC(19,11309,1,2,0)="specimen.  You can use it to match a VistA lab test to a LOINC"
^DIC(19,11309,1,3,0)="code.  You will be prompted to enter a lab test name and specimen."
^DIC(19,11309,1,4,0)="This will be used as a default lookup value.  If there are no"
^DIC(19,11309,1,5,0)="matches, then you will see two question marks, ""??"", and you will"
^DIC(19,11309,1,6,0)="return to the ""LOINC Name..Specimen"" prompt.  Now you can enter"
^DIC(19,11309,1,7,0)="the first few characters of the test name or some value to "
^DIC(19,11309,1,8,0)="find the LOINC code."
^DIC(19,11309,25)="LRLNC1"
^DIC(19,11309,"U")="FIND LOINC FOR VISTA LAB TEST"
^DIC(19,11310,0)="LR LOINC PRINT RESULT NLT^Lab Tests With/Without Result NLT Codes Print ^^R^10000000020^^^^^^^26"
^DIC(19,11310,1,0)="^^5^5^2990311^^^^"
^DIC(19,11310,1,1,0)="This option allows you to print a list of Lab Tests with or without Result"
^DIC(19,11310,1,2,0)="NLT Codes.  Lab tests must have a Result NLT Code before it"
^DIC(19,11310,1,3,0)="is mapped to a LOINC code.  To enter or edit a Result NLT Code,"
^DIC(19,11310,1,4,0)="you may use the Link Result NLT Manual option under the National Laboratory"
^DIC(19,11310,1,5,0)="File menu."
^DIC(19,11310,25)="LRLNCNLT"
^DIC(19,11310,"U")="LAB TESTS WITH/WITHOUT RESULT "
^DIC(19,11311,0)="LR LOINC PRINT 60/LOINC MAP^Print Lab Tests Mapped/Not Mapped to LOINC Codes^^R^10000000020^^^^^^^26"
^DIC(19,11311,1,0)="^^3^3^2990309^^^^"
^DIC(19,11311,1,1,0)="This option allows you to print a list of Lab Tests mapped or not mapped"
^DIC(19,11311,1,2,0)="to LOINC Codes.  You can use this list to determine which tests you need"
^DIC(19,11311,1,3,0)="to map and which tests are already mapped."
^DIC(19,11311,25)="LRLNCPMP"
^DIC(19,11311,"U")="PRINT LAB TESTS MAPPED/NOT MAP"
