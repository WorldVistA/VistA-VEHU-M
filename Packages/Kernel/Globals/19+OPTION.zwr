^DIC(19,11326,99)="59561,41684"
^DIC(19,11326,"U")="DIAGNOSTIC MEASURES EXTRACT ME"
^DIC(19,11327,0)="IBJD DM MANUAL START^Manually Start DM Extraction^^R^10000000033^^^^^^^192"
^DIC(19,11327,1,0)="^^3^3^2990421^"
^DIC(19,11327,1,1,0)="This option allows a user to restart the Diagnostic Measures "
^DIC(19,11327,1,2,0)="Extraction background job if the DM report data has not been"
^DIC(19,11327,1,3,0)="successfully extracted for the previous month."
^DIC(19,11327,25)="MAN^IBJDE1"
^DIC(19,11327,"U")="MANUALLY START DM EXTRACTION"
^DIC(19,11328,0)="PSS REPORT LOCAL INTERACTIONS^Report of Locally Entered Interactions^^R^10000000020^^^^^^^"
^DIC(19,11328,1,0)="^^2^2^2990310^^"
^DIC(19,11328,1,1,0)="This option allows sites to print a report of locally entered drug"
^DIC(19,11328,1,2,0)="interactions and their severity."
^DIC(19,11328,25)="PSSDRINT"
^DIC(19,11328,"U")="REPORT OF LOCALLY ENTERED INTE"
^DIC(19,11336,0)="AJK1UB PAYER RESTRICTION^Restrict Payer Transmission^^R^11600^^^^^^^"
^DIC(19,11336,1,0)="^^3^3^2990514^"
^DIC(19,11336,1,1,0)="This option is used to restrict transmissions, by payer, to bills over a"
^DIC(19,11336,1,2,0)="specified dollar amount.  Additionally, one can completely exclude a payer"
^DIC(19,11336,1,3,0)="from the transmission process by entering an asterisk at the prompt."
^DIC(19,11336,25)="F36^AJK1UBM"
^DIC(19,11336,"U")="RESTRICT PAYER TRANSMISSION"
^DIC(19,11337,0)="GMRCSTSU^Group update of consult/procedure requests^^R^11712^^^^^^^294"
^DIC(19,11337,1,0)="^^16^16^2990503^"
^DIC(19,11337,1,1,0)="This option will allow a search of the REQUEST/CONSULTATION (#123) file "
^DIC(19,11337,1,2,0)="for requests to a particular service within a date range. The status of"
^DIC(19,11337,1,3,0)="the entries meeting the selected criteria may be updated to COMPLETE or"
^DIC(19,11337,1,4,0)="DISCONTINUED. A comment of up to 256 characters may be entered once and"
^DIC(19,11337,1,5,0)="attached to each of the entries. "
^DIC(19,11337,1,6,0)=" "
^DIC(19,11337,1,7,0)="A report of those records to be updated may be printed without performing"
^DIC(19,11337,1,8,0)="the status updates. The option also allows printing of the records along"
^DIC(19,11337,1,9,0)="with the status updates."
^DIC(19,11337,1,10,0)=" "
^DIC(19,11337,1,11,0)="The status of the corresponding order in CPRS will be updated to match"
^DIC(19,11337,1,12,0)="that in file 123."
^DIC(19,11337,1,13,0)=" "
^DIC(19,11337,1,14,0)="Only the user entered in the SPECIAL UPDATES INDIVIDUAL field #123.5 of"
^DIC(19,11337,1,15,0)="the REQUEST SERVICES (#123.5) file will be allowed to perform the updates"
^DIC(19,11337,1,16,0)="for the chosen service."
^DIC(19,11337,25)="GMRCSTS"
^DIC(19,11337,"U")="GROUP UPDATE OF CONSULT/PROCED"
