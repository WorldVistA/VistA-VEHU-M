^DIC(19,3886,1,1,0)="This option will list the nutrition locations contained in the Nutrition"
^DIC(19,3886,1,2,0)="Location (#119.6) file along with all of the associated data elements."
^DIC(19,3886,25)="FHPRW"
^DIC(19,3886,"U")="LIST NUTRITION LOCATIONS"
^DIC(19,3887,0)="FHPRC9^Edit Meal Production Diets^^R^10000000020^^^^^^^"
^DIC(19,3887,1,0)="^^4^4^2880716^^"
^DIC(19,3887,1,1,0)="This option allows for editing the production diets associated"
^DIC(19,3887,1,2,0)="with a recipe in a meal. It is designed for rapid and easy"
^DIC(19,3887,1,3,0)="modification of the production diet string associated with"
^DIC(19,3887,1,4,0)="the recipes."
^DIC(19,3887,25)="FHPRC6"
^DIC(19,3887,"U")="EDIT MEAL PRODUCTION DIETS"
^DIC(19,3888,0)="FHX1^Check Integrity of Routines^^R^10000000020^^^^^^^"
^DIC(19,3888,1,0)="^^4^4^2890223^^"
^DIC(19,3888,1,1,0)="This option will check the integrity of all dietetic system"
^DIC(19,3888,1,2,0)="routines. An error will be shown for any routine which has been"
^DIC(19,3888,1,3,0)="modified. Routines for which patches have been issued will"
^DIC(19,3888,1,4,0)="normally show an error."
^DIC(19,3888,25)="FHNTEG"
^DIC(19,3888,"U")="CHECK INTEGRITY OF ROUTINES"
^DIC(19,3889,0)="FHX2^Recode Diets for all Inpatients^^R^10000000020^^^^^^^"
^DIC(19,3889,1,0)="^19.06^5^5^3050113^^"
^DIC(19,3889,1,1,0)="This option will automatically recode the production diet based"
^DIC(19,3889,1,2,0)="upon the clinical diet order for all inpatients using the current"
^DIC(19,3889,1,3,0)="data in the production diet file. It is used whenever significant"
^DIC(19,3889,1,4,0)="alterations have been made to the production diet file which"
^DIC(19,3889,1,5,0)="will affect the recoding of diets."
^DIC(19,3889,25)="INP^FHORDR"
^DIC(19,3889,"U")="RECODE DIETS FOR ALL INPATIENT"
^DIC(19,3890,0)="FHX3^Check File Pointers^^R^10000000020^^^^^^^"
^DIC(19,3890,1,0)="^^5^5^2920605^^"
^DIC(19,3890,1,1,0)="This option will check all of the file relationships to ensure"
^DIC(19,3890,1,2,0)="that no entry has been deleted which is used by another file."
^DIC(19,3890,1,3,0)="Since the patient file 'points' to many of these files it is"
^DIC(19,3890,1,4,0)="also checked if requested but may require a considerable"
^DIC(19,3890,1,5,0)="period of time."
^DIC(19,3890,25)="FHXDB"
^DIC(19,3890,"U")="CHECK FILE POINTERS"
^DIC(19,3891,0)="FHX4^Create Dietetic File entry for all Inpatients^^R^10000000020^^^^^^^"
^DIC(19,3891,1,0)="^^4^4^2950121^^^^"
^DIC(19,3891,1,1,0)="This option will verify that all inpatients have a Dietetic"
^DIC(19,3891,1,2,0)="Patient file entry for the current admission. It is primarily"
^DIC(19,3891,1,3,0)="used when link failures have resulted in new admissions not"
^DIC(19,3891,1,4,0)="having a file entry created."
^DIC(19,3891,25)="EN1^FHXIN"
^DIC(19,3891,"U")="CREATE DIETETIC FILE ENTRY FOR"
