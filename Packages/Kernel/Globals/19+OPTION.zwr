^DIC(19,10773,0)="RA NM RADIOPHARM USAGE^Radiopharmaceutical Usage Report^^R^11712^^^^^^^31"
^DIC(19,10773,1,0)="^^5^5^2970820^"
^DIC(19,10773,1,1,0)="This report includes all exams where radiopharmaceuticals are entered"
^DIC(19,10773,1,2,0)="within a selected exam date range.  It can be sorted by technologist"
^DIC(19,10773,1,3,0)="or by exam date/time.  Separate sections are printed for each division"
^DIC(19,10773,1,4,0)="and imaging type (only imaging types using radioharmaceuticals can be"
^DIC(19,10773,1,5,0)="included).  A summary only can be generated."
^DIC(19,10773,25)="RADUSE^RANMUSE1"
^DIC(19,10773,"U")="RADIOPHARMACEUTICAL USAGE REPO"
^DIC(19,10774,0)="RA NM RADIOPHARM ADMIN^Radiopharmaceutical Administration Report^^R^11712^^^^^^^31"
^DIC(19,10774,1,0)="^^5^5^2970820^"
^DIC(19,10774,1,1,0)="This report includes exams where radiopharmaceuticals are entered for the"
^DIC(19,10774,1,2,0)="date range selected.  It can be sorted by radiopharmaceutical or by"
^DIC(19,10774,1,3,0)="exam date/time.  Separate sections are printed for each division and"
^DIC(19,10774,1,4,0)="imaging type (only imaging types using radiopharmaceuticals can be"
^DIC(19,10774,1,5,0)="included).  A summary only can be generated."
^DIC(19,10774,25)="RADADM^RANMUSE1"
^DIC(19,10774,"U")="RADIOPHARMACEUTICAL ADMINISTRA"
^DIC(19,10776,0)="IB MRA EDIT INS CO LIST^Edit List of Ins. Co. Withholding Payments^^R^10000000033^^^^^^^192"
^DIC(19,10776,1,0)="^^5^5^2971030^"
^DIC(19,10776,1,1,0)="Use this option to create a list of Insurance Companies that are primarily"
^DIC(19,10776,1,2,0)="Medicare supplimental carriers and they have consistently denied payments"
^DIC(19,10776,1,3,0)="to the VA due to the VA's inability to produce an EOB from Medicare"
^DIC(19,10776,1,4,0)="showing the Medicare allowable charges and the patients responsibility"
^DIC(19,10776,1,5,0)="for the claim, for example, USAA."
^DIC(19,10776,25)="IBCNSMRE"
^DIC(19,10776,"U")="EDIT LIST OF INS. CO. WITHHOLD"
^DIC(19,10777,0)="IB MRA BACKBILLING REPORT^Print MRA Back Billing Potential Report^^R^10000000033^IB SUPERVISOR^^^^^^192"
^DIC(19,10777,1,0)="^^3^3^2971030^"
^DIC(19,10777,1,1,0)="This option is to be used to produce a report and/or send data on the"
^DIC(19,10777,1,2,0)="potential recoveries of old claims to carriers that have consistently"
^DIC(19,10777,1,3,0)="refused to reimburse the VA for Medicare supplimental policies."
^DIC(19,10777,25)="IBCNSMRA"
^DIC(19,10777,"U")="PRINT MRA BACK BILLING POTENTI"
^DIC(19,10778,0)="PSJI IVCATEGORY^CAtegory File (IV)^^R^11712^^^^^^^115^^^1"
^DIC(19,10778,1,0)="^^7^7^2980330^"
^DIC(19,10778,1,1,0)="This option allows the user to group drugs from the IV ADDITIVES (52.6)"
^DIC(19,10778,1,2,0)="and/or IV SOLUTIONS (52.7) file so that management cost reports may be run"
^DIC(19,10778,1,3,0)="for this group. This is like a report generator as it allows the user to"
^DIC(19,10778,1,4,0)="customize reports to the ir needs. Examples of groupings may br"
^DIC(19,10778,1,5,0)="antibiotics, restricted drugs by provider, chemotherapy drugs, or any"
^DIC(19,10778,1,6,0)="thing else the user wants to group such as a number of drugs for drug"
^DIC(19,10778,1,7,0)="utilization studies."
^DIC(19,10778,15)="K I1"
^DIC(19,10778,20)=""
^DIC(19,10778,25)="ENC^PSIVDRG"
^DIC(19,10778,99)="57040,46189"
^DIC(19,10778,"U")="CATEGORY FILE (IV)"
^DIC(19,10779,0)="SR BLOOD PRODUCT VERIFICATION^Blood Product Verification^^R^11595^^^^^^^167^^1^1"
^DIC(19,10779,1,0)="^^9^9^2980114^^^^"
^DIC(19,10779,1,1,0)=" "
^DIC(19,10779,1,2,0)=" This option is contained on the Surgery ""Operations Menu"". After scanning"
^DIC(19,10779,1,3,0)=" the blood unit ID, the software will check for an association with the"
^DIC(19,10779,1,4,0)=" patient identified. If there are multiple entries with the Unit ID"
^DIC(19,10779,1,5,0)=" scanned, these entries will be listed along with the Blood Component,"
^DIC(19,10779,1,6,0)=" Patient Associated, and Expiration Date. The user will then be prompted"
^DIC(19,10779,1,7,0)=" to select the one that matches the blood product about to be"
^DIC(19,10779,1,8,0)=" administered.  If the selected product is not associated with the patient"
^DIC(19,10779,1,9,0)=" identified, the warning message will be displayed."
^DIC(19,10779,15)="D EXIT^SROVAR"
^DIC(19,10779,20)="D ^SROVAR I '$D(SRTN) D ^SROPS S:'$D(SRTN) XQUIT="""" Q:$D(XQUIT)"
^DIC(19,10779,22)="Q"
^DIC(19,10779,25)="SRBLOOD"
^DIC(19,10779,"U")="BLOOD PRODUCT VERIFICATION"
^DIC(19,10780,0)="SR BLOOD PRODUCT VERIFY AUDIT^Print Blood Product Verification Audit Log^^R^10000000216^^^^^^^167^^1^1"
^DIC(19,10780,1,0)="^^2^2^2980513^"
^DIC(19,10780,1,1,0)="This option is used to print the KERNEL audit log for the Surgery option, "
^DIC(19,10780,1,2,0)="[SR BLOOD PRODUCT VERIFICATION]."
^DIC(19,10780,15)="D EXIT^SROVAR D PAGE^SRBLOOD"
^DIC(19,10780,20)="D ^SROVAR W !!,?9,""Enter a date range to print the Blood Verification Audit Log."",!"
^DIC(19,10780,22)="Q"
^DIC(19,10780,25)="AUDIT^SRBLOOD"
^DIC(19,10780,"U")="PRINT BLOOD PRODUCT VERIFICATI"
