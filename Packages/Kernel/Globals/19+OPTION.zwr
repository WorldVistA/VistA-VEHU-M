^DIC(19,12048,0)="PSXR AUTO TRANSMIT^Setup Auto-transmission^^R^10000000020^PSXAUTOX^^^^^^"
^DIC(19,12048,1,0)="^^5^5^2960701^^^^"
^DIC(19,12048,1,1,0)="This options schedules or unschedules the CMOP data transmission"
^DIC(19,12048,1,2,0)="to run automatically in the background. The user is asked to enter a"
^DIC(19,12048,1,3,0)="re-scheduling frequency, in hours. The job automatically re-schedules to "
^DIC(19,12048,1,4,0)="run for the time interval selected. The job will continue to run "
^DIC(19,12048,1,5,0)="for the selected time intervals until it is unscheduled by the user."
^DIC(19,12048,25)="PSXAUTO"
^DIC(19,12048,99)="55662,56222"
^DIC(19,12048,"U")="SETUP AUTO-TRANSMISSION"
^DIC(19,12049,0)="PSXR TRANSMIT MENU^Transmission Menu^^M^10000000020^PSX XMIT^^^^^^528"
