^DIC(19,6104,1,1,0)="Prints all NSC (non-service connected) items issued to patients for"
^DIC(19,6104,1,2,0)="billing purposes."
^DIC(19,6104,25)="RMPRBIL"
^DIC(19,6104,99.1)="58946,32766"
^DIC(19,6104,"U")="PRINT PROSTHETIC BILLINGS FOR "
^DIC(19,6105,0)="RMPR HIS DEL^Delete Historical Data Entry^^R^.5^^^^^^^249"
^DIC(19,6105,1,0)="^^1^1^2911210^^^"
^DIC(19,6105,1,1,0)="Deletes historical data entry."
^DIC(19,6105,25)="RMPRHISD"
^DIC(19,6105,"U")="DELETE HISTORICAL DATA ENTRY"
^DIC(19,6106,0)="RMPR 2319 EDT^Edit/Delete 2237 from 10-2319^^A^.5^^^^^^^^^1"
^DIC(19,6106,1,0)="^^2^2^2950519^"
^DIC(19,6106,1,1,0)="This option will edit or delete information posted from a VAF 2237 record"
^DIC(19,6106,1,2,0)="to a patient's VAF 10-2319."
^DIC(19,6106,20)="D EN10^RMPROP"
^DIC(19,6106,"U")="EDIT/DELETE 2237 FROM 10-2319"
^DIC(19,6107,0)="RMPR AUTO ADD^Add Equipment to Current Vehicle of Record^^A^.5^^^^^^^^^1"
^DIC(19,6107,1,0)="^^2^2^2950519^"
^DIC(19,6107,1,1,0)="This option adds newly purchased equipment to the patient's Vehicle of"
^DIC(19,6107,1,2,0)="Record."
^DIC(19,6107,20)="S RMPRAM=""21B"" D ^RMPRAVR1"
^DIC(19,6107,"U")="ADD EQUIPMENT TO CURRENT VEHIC"
^DIC(19,6108,0)="RMPR AUTO NEW^Enter A New Vehicle^^A^.5^^^^^^^^^1"
^DIC(19,6108,1,0)="^^1^1^2920508^^^"
^DIC(19,6108,1,1,0)="This option allows the entering of a new vehicle for a patient."
^DIC(19,6108,20)="D ^RMPRAUT"
^DIC(19,6108,"U")="ENTER A NEW VEHICLE"
^DIC(19,6109,0)="RMPR AUTO REP^Enter A Repair^^A^.5^^^^^^^^^1"
^DIC(19,6109,1,0)="^^1^1^2950519^"
^DIC(19,6109,1,1,0)="This option adds a repair to the patient's Vehicle of Record."
^DIC(19,6109,20)="S RMPRAM=""R16"",RMPREP=1 D ^RMPRAVR1"
^DIC(19,6109,"U")="ENTER A REPAIR"
^DIC(19,6110,0)="RMPR VAN MOD^Enter Van Modifications^^A^.5^^^^^^^^^1"
^DIC(19,6110,1,0)="^^2^2^2950519^^"
^DIC(19,6110,1,1,0)="This option allows the recording of van modifications for a patient's"
^DIC(19,6110,1,2,0)="Vehicle of Record."
^DIC(19,6110,20)="S RMPRAM=""21A"" D ^RMPRAVR1"
^DIC(19,6110,"U")="ENTER VAN MODIFICATIONS"
^DIC(19,6111,0)="RMPR AUTO EDIT^Edit/Delete Equipment Transaction^^A^.5^^^^^^^^^1"
^DIC(19,6111,1,0)="^^2^2^2950519^^"
^DIC(19,6111,1,1,0)="This option allows editing of any recorded repairs, van modifications,"
^DIC(19,6111,1,2,0)="or new items added to the patient's Vehicle of Record."
^DIC(19,6111,20)="S RMPRED=1 D ^RMPRAVR1"
^DIC(19,6111,"U")="EDIT/DELETE EQUIPMENT TRANSACT"
^DIC(19,6112,0)="RMPR AUTO INQ^Inquire to Patient Vehicle of Record^^A^.5^^^^^^^^^1"
^DIC(19,6112,1,0)="^^2^2^2950522^"
^DIC(19,6112,1,1,0)="This is a printout of all auto-adaptive information recorded for a"
^DIC(19,6112,1,2,0)="patient."
^DIC(19,6112,20)="D ^RMPRAINQ"
^DIC(19,6112,"U")="INQUIRE TO PATIENT VEHICLE OF "
^DIC(19,6113,0)="RMPR EDIT 2319^Edit 2319^^A^.5^^^^^^^^^1"
^DIC(19,6113,1,0)="^^2^2^2950519^"
^DIC(19,6113,1,1,0)="This option will allow limited editing of purchasing and stock issue"
^DIC(19,6113,1,2,0)="transactions recorded on a patient's VAF 10-2319."
^DIC(19,6113,20)="D ^RMPRE29"
^DIC(19,6113,"U")="EDIT 2319"
^DIC(19,6114,0)="RMPR ELG INQ^Eligibility Inquiry^^R^.5^^^^^^^249"
^DIC(19,6114,1,0)="^^1^1^2950519^"
^DIC(19,6114,1,1,0)="This option is an eligibility inquiry into the MAS PATIENT file (#2)."
^DIC(19,6114,25)="RMPRELG1"
^DIC(19,6114,"U")="ELIGIBILITY INQUIRY"
^DIC(19,6115,0)="RMPR AUTO ITM^Enter/Edit Auto Adaptive Equipment^^R^.5^^^^^^^"
^DIC(19,6115,1,0)="^^1^1^2950522^^"
^DIC(19,6115,1,1,0)="This option allows the user to change or add auto-adaptive equipment."
^DIC(19,6115,25)="EIT^RMPRAVR"
^DIC(19,6115,"U")="ENTER/EDIT AUTO ADAPTIVE EQUIP"
^DIC(19,6116,0)="RMPR AUTO MAN^Enter/Edit Auto Adaptive Manufacturer^^R^.5^^^^^^^"
^DIC(19,6116,1,0)="^^2^2^2950522^"
^DIC(19,6116,1,1,0)="This file allows the user to enter and edit the names of auto-adaptive"
^DIC(19,6116,1,2,0)="manufacturers."
^DIC(19,6116,25)="EMN^RMPRAVR"
^DIC(19,6116,"U")="ENTER/EDIT AUTO ADAPTIVE MANUF"
^DIC(19,6117,0)="RMPR AUTO RECALL^Recall Auto Adaptive Equipment By Serial Number^^A^.5^^^^^^^249^^1"
^DIC(19,6117,1,0)="^^1^1^2950522^"
^DIC(19,6117,1,1,0)="This option recalls auto-adaptive equipment transaction by serial number."
^DIC(19,6117,20)="D AUT^RMPRSEA"
^DIC(19,6117,"U")="RECALL AUTO ADAPTIVE EQUIPMENT"
^DIC(19,6120,0)="ENPM10^Delete PM Work Orders^^R^.5^^^^^^^"
^DIC(19,6120,1,0)="^^7^7^2880513^"
^DIC(19,6120,1,1,0)="Intended to enable you to delete PM work orders in order to conserve"
^DIC(19,6120,1,2,0)="disk space. Deletion of PM work orders via this option will not remove"
^DIC(19,6120,1,3,0)="an existing record of the PMI from the equipment history. Deletion"
^DIC(19,6120,1,4,0)="of any work order via the EDIT WORK ORDER option WILL remove the"
^DIC(19,6120,1,5,0)="corresponding entry from the equipment history."
^DIC(19,6120,1,6,0)="If you intend to record PMI's in the equipment history, you should"
^DIC(19,6120,1,7,0)="not delete PM work orders until after they have been recorded."
^DIC(19,6120,25)="DEL^ENEQPMS4"
^DIC(19,6120,"U")="DELETE PM WORK ORDERS"
^DIC(19,6121,0)="ENPMR1^Close Out PM Work Orders^^R^.5^^^^^^^"
^DIC(19,6121,1,0)="^^3^3^2880516^"
^DIC(19,6121,1,1,0)="Close out a PM work list entry by entry. User is asked for a complete"
^DIC(19,6121,1,2,0)="specification of the first PM work order; after that the system assumes"
^DIC(19,6121,1,3,0)="the shop, month, and type (MONTHLY or WEEKLY) of work list."
^DIC(19,6121,25)="CO^ENEQPMR1"
^DIC(19,6121,99)="55723,58240"
^DIC(19,6121,"U")="CLOSE OUT PM WORK ORDERS"
^DIC(19,6122,0)="ENPMR2^Rapid Closeout of PM Work Orders^^R^.5^^^^^^^"
^DIC(19,6122,1,0)="^^9^9^2920427^^^^"
^DIC(19,6122,1,1,0)="Closes out an entire PM worklist. User is prompted for any PM work orders"
^DIC(19,6122,1,2,0)="that are to be closed out individually. All work orders on the specified"
^DIC(19,6122,1,3,0)="list which are not closed out individually will be assigned a PM status"
^DIC(19,6122,1,4,0)="of PASSED and default values (if any) for time and materials. This option"
^DIC(19,6122,1,5,0)="may take a while to run, so the user is given the opportunity to free his"
^DIC(19,6122,1,6,0)="terminal. Freeing the terminal causes this option to begin to run"
^DIC(19,6122,1,7,0)="immediately as a background job. This option may slow the system"
^DIC(19,6122,1,8,0)="noticeably and it may be desireable to assign this task a lower priority"
^DIC(19,6122,1,9,0)="than interactive jobs."
^DIC(19,6122,25)="RCO^ENEQPMR2"
^DIC(19,6122,"U")="RAPID CLOSEOUT OF PM WORK ORDE"
^DIC(19,6123,0)="ENPMR3^Record Single Device PMI^^R^.5^^^^^^^"
^DIC(19,6123,1,0)="^^6^6^2890123^^"
^DIC(19,6123,1,1,0)="May be used to record a PMI on any specified device, irregardless of"
^DIC(19,6123,1,2,0)="whether or not it is on an active PMI list. One use envisioned for this"
^DIC(19,6123,1,3,0)="is recording the results of 'area sweeps'. If the specified device is"
^DIC(19,6123,1,4,0)="in the scheduled PMI program and it appears that a PMI recorded via this"
^DIC(19,6123,1,5,0)="option may make it desireable to change the scheduled FREQUENCY or"
^DIC(19,6123,1,6,0)="the STARTING MONTH, the user will be afforded an opportunity to do so."
^DIC(19,6123,25)="SDPM^ENEQPMR4"
^DIC(19,6123,"U")="RECORD SINGLE DEVICE PMI"
^DIC(19,6124,0)="ENPMS^Generate PM Schedule^^M^.5^^^^^^^^^1"
^DIC(19,6124,1,0)="^^2^2^2880601^^^"
^DIC(19,6124,1,1,0)="Contains options for printing PMI work sheets and for deletion of PM"
^DIC(19,6124,1,2,0)="work orders."
^DIC(19,6124,10,0)="^19.01PI^4^3"
^DIC(19,6124,10,1,0)="342^1"
