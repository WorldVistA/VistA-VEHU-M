^DIC(19,16215,1,0)="^19.06^5^5^3240328^^^"
^DIC(19,16215,1,1,0)="This option will allow a user to export a Health Summary "
^DIC(19,16215,1,2,0)="Object, and its corresponding Health Summary Type to a "
^DIC(19,16215,1,3,0)="Mailman message which can be sent to other accounts/sites"
^DIC(19,16215,1,4,0)="for import."
^DIC(19,16215,1,5,0)="Cloned from ""GMTS OBJ EXPORT"" option."
^DIC(19,16215,3)=""
