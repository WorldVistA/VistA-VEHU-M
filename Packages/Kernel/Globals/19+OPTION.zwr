^DIC(19,12125,"U")="MAGJ VISTARAD RPC'S"
^DIC(19,12126,0)="MAGJ LIST INQUIRY^Print VistaRad List Definition^^R^10000000049^^^^^^^"
^DIC(19,12126,1,0)="^^1^1^2990507^^"
^DIC(19,12126,1,1,0)="Use this option to display the list definition for the VistARad Lists."
^DIC(19,12126,25)="LSTINQ^MAGJMN1"
^DIC(19,12126,"U")="PRINT VISTARAD LIST DEFINITION"
^DIC(19,12127,0)="MAGJ VISTARAD SITE PARAMETERS^E/E VistaRad Site Parameters^^R^10000000049^^^^^^^"
^DIC(19,12127,1,0)="^^2^2^2990507^"
^DIC(19,12127,1,1,0)="Use this option to define various system settings that control VistaRad"
^DIC(19,12127,1,2,0)="functionality."
^DIC(19,12127,25)="VRSIT^MAGJMN1"
^DIC(19,12127,"U")="E/E VISTARAD SITE PARAMETERS"
^DIC(19,12128,0)="MAGJ E/E PREFETCH LOGIC^E/E VistaRad PreFetch Logic^^R^10000000049^^^^^^^530"
^DIC(19,12128,1,0)="^19.06^5^5^3050804^^"
^DIC(19,12128,1,1,0)="Use this option to define or edit prefetch logic.  The logic consists of"
^DIC(19,12128,1,2,0)="mapping the Current Exam CPT code to Prior exams of interest by their CPT"
^DIC(19,12128,1,3,0)="codes.  For each mapping, you will indicate the number of prior exams to"
^DIC(19,12128,1,4,0)="prefetch, and optionally also specify an age cutoff (i.e., to ignore exams"
^DIC(19,12128,1,5,0)="older than the specified number or days)."
^DIC(19,12128,25)="EEPREF^MAGJMN1"
^DIC(19,12128,"U")="E/E VISTARAD PREFETCH LOGIC"
^DIC(19,12129,0)="MAGJ PREFETCH PRINT^Print VistaRad Prefetch Logic Table^^R^10000000049^^^^^^^"
^DIC(19,12129,25)="PRPREF^MAGJMN1"
^DIC(19,12129,"U")="PRINT VISTARAD PREFETCH LOGIC "
^DIC(19,12130,0)="MAGJ INQUIRE PREFETCH LOGIC^Inquire Prefetch Logic^^R^10000000049^^^^^^^"
^DIC(19,12130,25)="INPREF^MAGJMN1"
^DIC(19,12130,"U")="INQUIRE PREFETCH LOGIC"
^DIC(19,12131,0)="MAGJ SCHED RECENT LIST COMPILE^VISTARAD RECENT LIST COMPILE -- TMSCHEDULE^^R^20095^^^^^^^"
^DIC(19,12131,1,0)="^19.06^6^6^3001006^^^"
^DIC(19,12131,1,1,0)="Use this option to SCHEDULE a TaskMan job to Compile VistaRad RECENT Exams"
^DIC(19,12131,1,2,0)="in the background.  For proper VistaRad functionality, this job should be"
^DIC(19,12131,1,3,0)="scheduled to start at Startup, and run once every 2 to 3 hours.  After"
^DIC(19,12131,1,4,0)="defining this Scheduled Option in Taskman, be sure to let VistaRad know"
^DIC(19,12131,1,5,0)="what the interval between compiles is (update the VistaRad Site Parameters"
^DIC(19,12131,1,6,0)="field RECENT BKGND COMPILE INTERVAL)."
^DIC(19,12131,2)="y"
^DIC(19,12131,10.1)="SCHED VISTARAD RECENT COMPILE"
^DIC(19,12131,25)="BKGND2^MAGJLS2"
^DIC(19,12131,83)="Y"
^DIC(19,12131,200.9)="y^y"
^DIC(19,12131,220)="^I^"
^DIC(19,12131,"U")="VISTARAD RECENT LIST COMPILE -"
^DIC(19,12132,0)="OR BCMA ORDER COM^OR BCMA ORDER COM VERSION 1.0^^B^1^^^^^^^"
^DIC(19,12132,99.1)="63592,52298"
^DIC(19,12132,"RPC",0)="^19.05P^151^151"
