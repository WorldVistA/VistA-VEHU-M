^DIC(19,11638,0)="DGRUG RAI/MDS BUILD ASCII FILE^Build Patient ASCII File^^R^11740^^^^^^^"
^DIC(19,11638,1,0)="^^7^7^2991116^"
^DIC(19,11638,1,1,0)="This option will create an ASCII file which will contain patient"
^DIC(19,11638,1,2,0)="demographic and admission data.  It will create a file based on station "
^DIC(19,11638,1,3,0)="number as part of the name.  The fortmat for the file name is:"
^DIC(19,11638,1,4,0)="""VA""_station number_"".TXT"".  Therefore, if this were run at Albany NY, "
^DIC(19,11638,1,5,0)="which has a station number of 500, the file name assigned would be:"
^DIC(19,11638,1,6,0)="VA500.TXT.  This is a deliminated file, and will be used by the vendor"
^DIC(19,11638,1,7,0)="for seeding their data base."
^DIC(19,11638,25)="EN^DGRUGPRP"
^DIC(19,11638,"U")="BUILD PATIENT ASCII FILE"
