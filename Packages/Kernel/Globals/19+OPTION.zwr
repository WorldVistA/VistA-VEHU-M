^DIC(19,11460,0)="XMRONT^Start XMRONT TCP Listener^^R^11748^^^^^^^54"
^DIC(19,11460,1,0)="^^6^6^2980428^^^^"
^DIC(19,11460,1,1,0)="This is the TCP/IP Listener for MailMan. This option should NOT be on"
^DIC(19,11460,1,2,0)="any Menu and should NOT be run directly. It must be scheduled to start"
^DIC(19,11460,1,3,0)="every time the system is rebooted. You can schedule this option by using"
^DIC(19,11460,1,4,0)="the 'Schedule/Unschedule Options' option under the 'Taskman Management'"
^DIC(19,11460,1,5,0)="menu. You must specify the option XMRONT and then enter 'STARTUP' in the"
^DIC(19,11460,1,6,0)="SPECIAL QUEUING field."
^DIC(19,11460,25)="GO^XMRONT"
^DIC(19,11460,200.9)="y"
^DIC(19,11460,"U")="START XMRONT TCP LISTENER"
