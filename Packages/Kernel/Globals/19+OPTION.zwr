^DIC(19,3761,0)="SROSRPT^Operation Report^^R^10000000020^^^^^^^^^1^1"
^DIC(19,3761,1,0)="^^3^3^3030908^"
^DIC(19,3761,1,1,0)="This option generates the Operation Report. This report consists of the"
^DIC(19,3761,1,2,0)="electronically signed operative summary (surgeon's dictation) stored in"
^DIC(19,3761,1,3,0)="the Text Integration Utilities (TIU) software."
^DIC(19,3761,15)="D EXIT^SROVAR"
^DIC(19,3761,20)="D ^SROVAR"
^DIC(19,3761,22)="Q"
^DIC(19,3761,25)="SROPRPT"
^DIC(19,3761,99)="58854,48522"
^DIC(19,3761,"U")="OPERATION REPORT"
^DIC(19,3762,0)="SROARPT^Anesthesia Report^^R^10000000020^SROANES^^^^^^167^^1^1"
^DIC(19,3762,1,0)="^^9^9^3010830^"
^DIC(19,3762,1,1,0)="This option, locked by the SROANES security key, generates the Anesthesia"
^DIC(19,3762,1,2,0)="Report containing anesthesia information for a surgical case.  Before the"
^DIC(19,3762,1,3,0)="report is electronically signed, the option displays information directly"
^DIC(19,3762,1,4,0)="from the SURGERY file (#130) with the choice to edit the information on"
^DIC(19,3762,1,5,0)="the report, to print/view the report from the beginning, and to sign the"
^DIC(19,3762,1,6,0)="report electronically if appropriate for the user.  After the report is"
^DIC(19,3762,1,7,0)="electronically signed, this option allows the signed report to be edited"
^DIC(19,3762,1,8,0)="by updating the information in the SURGERY file (#130) and by creating"
^DIC(19,3762,1,9,0)="addenda and this option allows the report to be viewed or printed."
^DIC(19,3762,15)="K:'$D(SRTNK) SRTN K SRTNK D EXIT^SROVAR"
^DIC(19,3762,20)="D ^SROVAR Q:$D(XQUIT)  S:$D(SRTN) SRTNK=SRTN"
^DIC(19,3762,22)="Q"
^DIC(19,3762,25)="SROARPT"
^DIC(19,3762,99)="55656,29519"
^DIC(19,3762,"U")="ANESTHESIA REPORT"
^DIC(19,3763,0)="SRONRPT^Nurse Intraoperative Report^^R^10000000020^^^^^^^^^1^1"
^DIC(19,3763,1,0)="^19.06^9^9^3010830^^"
^DIC(19,3763,1,1,0)="This option generates the Nurse Intraoperative Report containing surgical"
^DIC(19,3763,1,2,0)="case information documented by nursing staff.  Before the report is"
^DIC(19,3763,1,3,0)="electronically signed, the option displays information directly from the"
^DIC(19,3763,1,4,0)="SURGERY file (#130) with the choice to edit the information on the report,"
^DIC(19,3763,1,5,0)="to print/view the report from the beginning, and to sign the report"
^DIC(19,3763,1,6,0)="electronically if appropriate for the user.  After the report is"
^DIC(19,3763,1,7,0)="electronically signed, this option allows the signed report to be edited"
^DIC(19,3763,1,8,0)="by updating the information in the SURGERY file (#130) and by creating"
^DIC(19,3763,1,9,0)="addenda and this option allows the signed report to be viewed or printed."
^DIC(19,3763,15)="D EXIT^SROVAR"
^DIC(19,3763,20)="D ^SROVAR"
^DIC(19,3763,22)="Q"
^DIC(19,3763,25)="SRONIN"
^DIC(19,3763,99)="55612,39567"
^DIC(19,3763,"U")="NURSE INTRAOPERATIVE REPORT"
