^DIC(19,16950,1,0)="^^4^4^3240328^^^^"
^DIC(19,16950,1,1,0)="This option is used to assign a set of security keys to an individual"
^DIC(19,16950,1,2,0)="user or a single key to a set of users.  To be eligible a key must be"
^DIC(19,16950,1,3,0)="in existence and owned by the user of this option."
