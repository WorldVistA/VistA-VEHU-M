^DIC(19,13586,0)="DENTV INACTIVATE PATIENTS^Inactivate Dental Patients^^R^1^^^^^^^"
^DIC(19,13586,1,0)="^^8^8^3070322^"
^DIC(19,13586,1,1,0)="This option will queue a background job to traverse the Dental Patient "
^DIC(19,13586,1,2,0)="file to see which patients have not had a visit within the user specified "
^DIC(19,13586,1,3,0)="time frame.  The time frame is defaulted to T-270 days (2 years), and "
^DIC(19,13586,1,4,0)="cannot be within the last 365 days (1 year).  Patient's without a visit "
^DIC(19,13586,1,5,0)="will have the DAS DISPOSITION field in the Dental History file set to an "
^DIC(19,13586,1,6,0)="inactive status, either Complete or Terminated, based on whether there is "
^DIC(19,13586,1,7,0)="existing planned transactions.  All of the associated transactions in "
^DIC(19,13586,1,8,0)="file 228.2 will be resent to the AAC by setting the HL7 Status flag=""P""."
^DIC(19,13586,25)="INACT^DENTVIN"
^DIC(19,13586,"U")="INACTIVATE DENTAL PATIENTS"
^DIC(19,13587,0)="SD WAIT LIST 30>30>120 REPORT^30, Over 30, Over 120 Day Report^DO NOT USE!! - EWL DECOM - SD*5.3*769^R^1^^^^^^^"
^DIC(19,13587,25)="EN^SDWLR30"
^DIC(19,13587,"U")="30, OVER 30, OVER 120 DAY REPO"
^DIC(19,13588,0)="IBCR ENTER RC NATIONAL CHARGES^National Reasonable Charges Enter^^R^1^IB SUPERVISOR^^^^^^192"
^DIC(19,13588,1,0)="^19.06^4^4^3070223^^^"
^DIC(19,13588,1,1,0)="This option is used to enter the National Interim Reasonable Charges.  "
^DIC(19,13588,1,2,0)="These non-site specific charges are provided when new CPT/HCPCS codes "
^DIC(19,13588,1,3,0)="are released as interim charges until the next full release of Reasonable "
^DIC(19,13588,1,4,0)="Charges."
^DIC(19,13588,25)="IBCRER"
^DIC(19,13588,"U")="NATIONAL REASONABLE CHARGES EN"
^DIC(19,13589,0)="PRCHPM CS PURGE ALL^Purge All Code Sheets^^R^1^PRCHPM CS PURGE CODE SHEETS^^^^^^121"
^DIC(19,13589,1,0)="^^3^3^3060927^"
^DIC(19,13589,1,1,0)="This option allows the user to delete all code sheets from the code sheet "
^DIC(19,13589,1,2,0)="file, which have been transmitted to Austin or DLA and which exceed a "
^DIC(19,13589,1,3,0)="selectable number of days in age."
^DIC(19,13589,25)="PURGE2^PRCFALOG"
^DIC(19,13589,"U")="PURGE ALL CODE SHEETS"
^DIC(19,13590,0)="PXRM TIU DIALOG TEMPLATE^TIU Template Reminder Dialog Parameter^^A^10000000020^^^^^^^534^^1"
^DIC(19,13590,20)="D EDITPAR^XPAREDIT(""TIU TEMPLATE REMINDER DIALOGS"")"
^DIC(19,13590,"U")="TIU TEMPLATE REMINDER DIALOG P"
^DIC(19,13591,0)="PXRM MH QUESTIONS^Edit Number of MH Questions^^A^10000000020^^^^^^^534^^1"
^DIC(19,13591,1,0)="^19.06^3^3^3071129^^"
^DIC(19,13591,1,1,0)="This option allows the site to select the Maximum number of MH questions to be "
^DIC(19,13591,1,2,0)="used as a Reminder Dialog Finding Items."
^DIC(19,13591,1,3,0)=""
^DIC(19,13591,20)="D MH^PXRMPARS(1)"
^DIC(19,13591,"U")="EDIT NUMBER OF MH QUESTIONS"
^DIC(19,13592,0)="PXRM LOCATION LIST COPY^Copy Location List^^R^10000000020^^^^^^^534"
^DIC(19,13592,1,0)="^19.06^12^12^3071129^^"
^DIC(19,13592,1,1,0)="This option allows the user to copy an existing location list into a"
^DIC(19,13592,1,2,0)="new location list; file #810.9.  The original location list to be"
^DIC(19,13592,1,3,0)="copied is selected first.  If the original location list is "
^DIC(19,13592,1,4,0)="prefixed with ""VA-"", the ""VA-"" will be stripped off the name"
^DIC(19,13592,1,5,0)="automatically to create the name for the new location list entry. "
^DIC(19,13592,1,6,0)="The new name must be unique.  If the new name is not unique, the"
^DIC(19,13592,1,7,0)="user must enter a unique name for the new location list entry.  If"
^DIC(19,13592,1,8,0)="no name is provided, the new entry will not be created.  Once a new"
^DIC(19,13592,1,9,0)="name is defined for the new location list entry, the new location"
^DIC(19,13592,1,10,0)="list entry can be edited to reflect the local location list"
^DIC(19,13592,1,11,0)="definition."
^DIC(19,13592,1,12,0)=""
^DIC(19,13592,25)="COPYLL^PXRMCOPY"
^DIC(19,13592,"U")="COPY LOCATION LIST"
^DIC(19,13593,0)="XQOCGCANALYSIS^CPRS GUI CHART DISTRIBUTION ANALYSIS^^S^10000000020^^^^^^^"
^DIC(19,13593,1,0)="^^9^9^3080122^"
^DIC(19,13593,1,1,0)="This option is a SERVER option which will run the routine XQ55SPEC when "
^DIC(19,13593,1,2,0)="a mail message is received with this option name.  The routine XQ55SPEC "
^DIC(19,13593,1,3,0)="generates a summary mail message indicating the number of active users "
^DIC(19,13593,1,4,0)="with the OR CPRS GUI CHART option and the total number of active users.  "
^DIC(19,13593,1,5,0)="This mail message is sent to Field Operations and the local Information "
^DIC(19,13593,1,6,0)="Security Officer (ISO) and the local IRM Chief.  A detailed mail message"
^DIC(19,13593,1,7,0)="indicating all users who have access to the option and the paths by which "
^DIC(19,13593,1,8,0)="they can access is also generated and is sent to the local ISO and IRM "
^DIC(19,13593,1,9,0)="Chief (it is not sent to Field Operations)."
^DIC(19,13593,25)="XQ55SPEC"
^DIC(19,13593,220)="^R^"
^DIC(19,13593,"RPC",0)="^19.05P^1^1"
