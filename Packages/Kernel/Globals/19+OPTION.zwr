^DIC(19,85,0)="XUSEREDITSELF^Edit User Characteristics^^R^1039^^52^^^^^^^"
^DIC(19,85,1,0)="^^5^5^2880401^^^^"
^DIC(19,85,1,1,0)="This option allows the user to edit certain attributes as defined"
^DIC(19,85,1,2,0)="by the Kernel Site Parameter file.  At most, the user can edit"
^DIC(19,85,1,3,0)="their own VERIFY CODE, AUTO-MENU, TYPE-AHEAD, and NICKNAME.  This"
^DIC(19,85,1,4,0)="can vary in your site."
^DIC(19,85,1,5,0)="A user may also edit the 'SUBTYPE' of their device."
^DIC(19,85,25)="EUC^XUS5"
