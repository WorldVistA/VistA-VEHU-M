^DIC(19,9885,0)="PX EDIT LOCATION OF HOME^Directions to Patient's Home Add/Edit^^E^10958^^^^^^^"
^DIC(19,9885,1,0)="^^5^5^2950817^^"
^DIC(19,9885,1,1,0)="This option lets you enter directions to a patient's home - especially"
^DIC(19,9885,1,2,0)="useful for Hospital-Based Home Care staff."
^DIC(19,9885,1,3,0)=" "
^DIC(19,9885,1,4,0)="The Health Summary package contains a new PCE component that displays the"
^DIC(19,9885,1,5,0)="directions entered through this option."
^DIC(19,9885,10.1)="Dir. to Pt Home"
^DIC(19,9885,30)="AUPNPAT("
^DIC(19,9885,31)="AEMQ"
^DIC(19,9885,50)="AUPNPAT("
^DIC(19,9885,51)="[PX LOCATION OF HOME]"
