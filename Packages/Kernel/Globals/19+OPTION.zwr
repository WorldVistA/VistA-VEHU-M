^DIC(19,15292,0)="EHM-00113^Erase Notifications^^R^1^^^^^^^^^^^"
^DIC(19,15292,1,0)="^^3^3^3240328^"
^DIC(19,15292,1,1,0)="Erase all notifications for a User, erase all notifications for a Patient,"
^DIC(19,15292,1,2,0)="or erase a specific Notification."
^DIC(19,15292,1,3,0)="Cloned from ""ORB3 ERASE NOTIFICATIONS"" option."
^DIC(19,15292,3)=""
^DIC(19,15292,25)="ERASE^ORB3MGR1"
