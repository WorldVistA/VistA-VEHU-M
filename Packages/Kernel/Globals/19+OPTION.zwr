^DIC(19,6184,0)="QAQ SITE PARAMETERS^Combined Site Parameters Edit^^R^.5^^^^^^^"
^DIC(19,6184,1,0)="^^2^2^2920807^^"
^DIC(19,6184,1,1,0)="This option allows you to edit the site parameters for all the QM"
^DIC(19,6184,1,2,0)="packages installed at your site."
^DIC(19,6184,25)="QAQSITE"
^DIC(19,6184,99)="55466,60180"
^DIC(19,6184,"U")="COMBINED SITE PARAMETERS EDIT"
^DIC(19,6185,0)="QAQ PACKAGES INQUIRE^QM Packages Inquire^^R^.5^^^^^^^"
^DIC(19,6185,1,0)="^^2^2^2920723^"
^DIC(19,6185,1,1,0)="This option produces a report showing which QM packages are installed"
^DIC(19,6185,1,2,0)="at your site and their version numbers."
^DIC(19,6185,25)="QAQPKGVR"
^DIC(19,6185,"U")="QM PACKAGES INQUIRE"
^DIC(19,6186,0)="QAOS QUICK EXCEPTION EDIT^Quick Exception Edit^^R^.5^^^^^^^"
^DIC(19,6186,1,0)="^^5^5^2910731^"
^DIC(19,6186,1,1,0)="This option allows the user to enter exceptions more quickly than the"
^DIC(19,6186,1,2,0)="Review: Clinical, Peer, Manager option.  The user is prompted for a"
^DIC(19,6186,1,3,0)="clinical reviewer, a patient, and the specific exception(s) (optional);"
^DIC(19,6186,1,4,0)="the occurrence is then automatically marked as an exception and closed"
^DIC(19,6186,1,5,0)="out."
^DIC(19,6186,25)="QAOEDT1"
^DIC(19,6186,99)="55558,33108"
^DIC(19,6186,"U")="QUICK EXCEPTION EDIT"
^DIC(19,6187,0)="QAOS GENERATE EWS BULLETIN^Early Warning System Transmission^^R^.5^^^^^^^"
^DIC(19,6187,1,0)="^^4^4^2930610^"
^DIC(19,6187,1,1,0)="This option allows the user to manually generate the Early Warning"
^DIC(19,6187,1,2,0)="System messages for any specific date range.  The data contained in"
^DIC(19,6187,1,3,0)="the messages is the same as the data for screens 101.1 and 109 on"
^DIC(19,6187,1,4,0)="the Summary of Occurrence Screening (Semi-Annual) report."
^DIC(19,6187,25)="EN1^QAOSEWS0"
^DIC(19,6187,"U")="EARLY WARNING SYSTEM TRANSMISS"
^DIC(19,6188,0)="QAOS RPT SERVICE STATS^Service Statistics^^R^.5^^^^^^^"
^DIC(19,6188,1,0)="^^2^2^2920527^^"
^DIC(19,6188,1,1,0)="This option produces a report showing the total number of occurrences"
^DIC(19,6188,1,2,0)="per service over a user selected date range."
^DIC(19,6188,25)="QAOSPSS"
^DIC(19,6188,"U")="SERVICE STATISTICS"
^DIC(19,6189,0)="QAOS TASKED EWS^Auto Generate Early Warning System Message^^R^.5^^^^^^^"
^DIC(19,6189,1,0)="^^5^5^2930413^"
^DIC(19,6189,1,1,0)="This option automatically produces the Early Warning System messagess"
^DIC(19,6189,1,2,0)="on a monthly schedule.  The data contained in the messagess is the same"
^DIC(19,6189,1,3,0)="as the data for screens 101.1 and 109 on the Summary of Occurrence"
^DIC(19,6189,1,4,0)="Screening (Semi-Annual) report. This option should be queued to run"
^DIC(19,6189,1,5,0)="once a month."
^DIC(19,6189,25)="EN2^QAOSEWS0"
^DIC(19,6189,200)="^^^"
^DIC(19,6189,"U")="AUTO GENERATE EARLY WARNING SY"
^DIC(19,6190,0)="QAOS AUDIT INQUIRY^Audit File Inquiry^^R^.5^^^^^^^"
^DIC(19,6190,1,0)="^^4^4^2910806^"
^DIC(19,6190,1,1,0)="This option allows the user to pick an Occurrence Screen record and"
^DIC(19,6190,1,2,0)="view the audit file entry for this occurrence.  The audit file data"
^DIC(19,6190,1,3,0)="includes information on who modified the record, when it was modified,"
^DIC(19,6190,1,4,0)="and what modification was performed."
^DIC(19,6190,25)="QAOSPAUD"
^DIC(19,6190,"U")="AUDIT FILE INQUIRY"
^DIC(19,6193,0)="DGJ IRT TRANS PROD^Transcription Productivity Report^^R^10000000033^^^^^^^"
^DIC(19,6193,1,0)="^^18^18^2941013^^^^"
^DIC(19,6193,1,1,0)="This option allows for the printing of a report to track the"
^DIC(19,6193,1,2,0)="number of days it takes to complete a record from the Event Date"
^DIC(19,6193,1,3,0)="to the date that the record is coded. Its major sorts are by"
^DIC(19,6193,1,4,0)="Physician or Service/Specialty. It also sorts"
^DIC(19,6193,1,5,0)="for Inpatient, outpatients or both and the report gives you the "
^DIC(19,6193,1,6,0)="option to print a totals after the patient list or a totals page"
^DIC(19,6193,1,7,0)="without the patient list. If a facility is multidivisional the "
^DIC(19,6193,1,8,0)="Division prompt is asked."
^DIC(19,6193,1,9,0)=" "
^DIC(19,6193,1,10,0)="The data elements that are displayed on the report are Patient name; PT ID;"
^DIC(19,6193,1,11,0)="Event Date; location; when sorting by Service/Specialty the physicians"
^DIC(19,6193,1,12,0)="name will be displayed; type of report (discharge summary, interim"
^DIC(19,6193,1,13,0)="and OP report); status (Undictated, dictated, transcribed, signed)"
^DIC(19,6193,1,14,0)="dictation date; D/C-DIC (number of days from discharge to dictation)"
^DIC(19,6193,1,15,0)="DIC-TRN (number of days from dictation to transcription); TRN-COD (number "
^DIC(19,6193,1,16,0)="of days from transcription to coding); TOT DAYS (total days it took for"
^DIC(19,6193,1,17,0)="the record to be completed); DELQ>30 (number of days over 30 that the "
^DIC(19,6193,1,18,0)="record is delinquent)."
^DIC(19,6193,25)="DGJOTP"
^DIC(19,6193,99)="55643,52130"
^DIC(19,6193,"U")="TRANSCRIPTION PRODUCTIVITY REP"
^DIC(19,6195,0)="SDAM BACKGROUND JOB^Appointment Status Update (Background)^^A^1253^^^^^^^16^^1"
^DIC(19,6195,1,0)="^^25^25^2980406^^^^"
^DIC(19,6195,1,1,0)="This option will update the appointment status for today's outpatient"
^DIC(19,6195,1,2,0)="encounters. If an encounter has not been checked-in, no-showed or cancelled,"
^DIC(19,6195,1,3,0)="then it will be given the status of 'NO ACTION TAKEN'.  Such encounters"
^DIC(19,6195,1,4,0)="will not be used as part of NPCDB workload reporting."
^DIC(19,6195,1,5,0)=" "
^DIC(19,6195,1,6,0)="This option should be queued to be run daily."
^DIC(19,6195,1,7,0)=" "
^DIC(19,6195,1,8,0)="Also, this option will update any encounter date in the last thirty days"
^DIC(19,6195,1,9,0)="that has not been updated.  This will help keep the encounter dates"
^DIC(19,6195,1,10,0)="updated in case the option does not execute, for any reason, on a"
^DIC(19,6195,1,11,0)="particular date."
^DIC(19,6195,1,12,0)=" "
^DIC(19,6195,1,13,0)="Note: Inpatient encounters and encounters for 'non-count' clinics are"
^DIC(19,6195,1,14,0)="      not updated since they are not reported to Austin for workload"
^DIC(19,6195,1,15,0)="      credit."
^DIC(19,6195,1,16,0)=" "
^DIC(19,6195,1,17,0)="A Mailman message will be sent to the mail group specified by "
^DIC(19,6195,1,18,0)="the APPT. UPDATE MAIL GROUP site parameter. The message will "
^DIC(19,6195,1,19,0)="indicate the overall results of this background job by providing the"
^DIC(19,6195,1,20,0)="following information:"
^DIC(19,6195,1,21,0)="            o  clinic"
^DIC(19,6195,1,22,0)="            o  number of encounters that flagged as 'no action taken'"
^DIC(19,6195,1,23,0)="            o  the total number of encounters"
^DIC(19,6195,1,24,0)="            o  percentage flagged as 'no action taken'"
^DIC(19,6195,1,25,0)=" "
^DIC(19,6195,20)="D AUTO^SDAMQ"
^DIC(19,6195,200.9)="y"
^DIC(19,6195,"U")="APPOINTMENT STATUS UPDATE (BAC"
^DIC(19,6196,0)="SDAM APPT UPDATE^Appointment Status Update^^A^1253^^^^^^^^^1"
^DIC(19,6196,1,0)="^^18^18^2980406^^^^"
^DIC(19,6196,1,1,0)="This option will update the appointment status for a date range"
^DIC(19,6196,1,2,0)="of oupatient encounters specified by the user. If an encounter has not"
^DIC(19,6196,1,3,0)="been checked-in, no-showed or cancelled, then it will be given the"
^DIC(19,6196,1,4,0)="status of 'NO ACTION TAKEN'.  Such encounters will not be used"
^DIC(19,6196,1,5,0)="as part of NPCDB workload reporting."
^DIC(19,6196,1,6,0)=" "
^DIC(19,6196,1,7,0)="Note: Inpatient encounters and encounters for 'non-count' clinics are"
^DIC(19,6196,1,8,0)="      not updated since they are not reported to Austin for workload"
^DIC(19,6196,1,9,0)="      credit."
^DIC(19,6196,1,10,0)=" "
^DIC(19,6196,1,11,0)="A mailman message will be sent to the mail group specified in the"
^DIC(19,6196,1,12,0)="APPT UPDATE MAIL GROUP (#215) of the scheduling parameters."
^DIC(19,6196,1,13,0)=" "
^DIC(19,6196,1,14,0)="The bulletin will show  the following:"
^DIC(19,6196,1,15,0)="         o  clinic"
^DIC(19,6196,1,16,0)="         o  number of encounters flagged as 'NO ACTION TAKEN'"
^DIC(19,6196,1,17,0)="         o  the total number of encounters"
^DIC(19,6196,1,18,0)="         o  percentage flagged as 'no action taken'"
^DIC(19,6196,20)="D EN^SDAMQ"
^DIC(19,6196,99)="55503,42349"
^DIC(19,6196,200)="^^^"
^DIC(19,6196,"U")="APPOINTMENT STATUS UPDATE"
^DIC(19,6197,0)="SDAM APPT MGT^Appointment Management^^A^.5^^^^^^^16^^1^1"
^DIC(19,6197,1,0)="^^22^22^2980930^^^^"
^DIC(19,6197,1,1,0)="This option allows the user to view appointments and take appropriate"
^DIC(19,6197,1,2,0)="actions against those appointments, such as check-in and cancel."
^DIC(19,6197,1,3,0)=" "
^DIC(19,6197,1,4,0)="The user is allowed to view/act on appointments either by patient or by"
^DIC(19,6197,1,5,0)="clinic."
^DIC(19,6197,1,6,0)=" "
^DIC(19,6197,1,7,0)="When a patient is selected, 'all' appointments for the patient for a"
^DIC(19,6197,1,8,0)="date range are displayed.  The date range used is determined by using"
^DIC(19,6197,1,9,0)="today's date and the new APPT SEARCH THRESHOLD parameter, specified"
^DIC(19,6197,1,10,0)="using the 'Scheduling Parameters' option:"
^DIC(19,6197,1,11,0)="     o lower limit:  today - parameter"
^DIC(19,6197,1,12,0)="     o upper limit:  today + 999 days"
^DIC(19,6197,1,13,0)=" "
^DIC(19,6197,1,14,0)="When a clinic is selected, the user is prompted for a beginning and"
^DIC(19,6197,1,15,0)="ending date. This date range is used to search for appointments in"
^DIC(19,6197,1,16,0)="the clinic with a status of 'no action taken'."
^DIC(19,6197,1,17,0)=" "
^DIC(19,6197,1,18,0)=" "
^DIC(19,6197,1,19,0)="Note: The user can use the barcodes produced by the Record Tracking"
^DIC(19,6197,1,20,0)="      system, that are on the patient's medical record, to identify a"
^DIC(19,6197,1,21,0)="      patient while using this option."
^DIC(19,6197,1,22,0)=" "
^DIC(19,6197,15)="D HDLKILL^SDAMEVT"
^DIC(19,6197,20)="D HDLKILL^SDAMEVT,EN^SDAM"
^DIC(19,6197,99)="55714,81618"
^DIC(19,6197,99.1)="60640,46858"
^DIC(19,6197,"U")="APPOINTMENT MANAGEMENT"
^DIC(19,6198,0)="SDAM APPT CHECK IN/OUT^Appointment Check-in/Check-out^^A^.5^^^^^^^16^^1^1"
^DIC(19,6198,1,0)="^^32^32^2970721^^^^"
^DIC(19,6198,1,1,0)="This option allows the user to check-in/check-out appointments by date "
^DIC(19,6198,1,2,0)="for a selected clinic.  After a date and a clinic has been "
^DIC(19,6198,1,3,0)="specified, the user is then prompted for patients to be "
^DIC(19,6198,1,4,0)="checked in/checked out."
^DIC(19,6198,1,5,0)=" "
^DIC(19,6198,1,6,0)="After a patient is selected, the system will determine if the "
^DIC(19,6198,1,7,0)="patient had any appointments on that date for the clinic.  If "
^DIC(19,6198,1,8,0)="there were no appointments for the clinic, the system will "
^DIC(19,6198,1,9,0)="display a message and then ask for the next patient."
^DIC(19,6198,1,10,0)=" "
^DIC(19,6198,1,11,0)="If there was an appointment, the system will display the "
^DIC(19,6198,1,12,0)="clinic name, date/time of apppointment and the status of the "
^DIC(19,6198,1,13,0)="appointment.  Next, the user will be asked to confirm that "
^DIC(19,6198,1,14,0)="this is the correct appointment.  If the user answers 'yes', "
^DIC(19,6198,1,15,0)="the check-in/check-out process is invoked."
^DIC(19,6198,1,16,0)=" "
^DIC(19,6198,1,17,0)="If there was more than one appointment on the date for that "
^DIC(19,6198,1,18,0)="clinic, the user will be asked to select an appointment."
^DIC(19,6198,1,19,0)=" "
^DIC(19,6198,1,20,0)="After the user finishes processing one clinic, another clinic "
^DIC(19,6198,1,21,0)="may be selected.  The user is also allowed to select another "
^DIC(19,6198,1,22,0)="date."
^DIC(19,6198,1,23,0)=" "
^DIC(19,6198,1,24,0)=" "
^DIC(19,6198,1,25,0)="This option is designed to allow input from a CRT's keyboard "
^DIC(19,6198,1,26,0)="and from a barcode reader.  In order to use the barcode "
^DIC(19,6198,1,27,0)="capibilities, the clinic's appointment list must be printed "
^DIC(19,6198,1,28,0)="on a device that supports the printing of barcodes."
^DIC(19,6198,1,29,0)=" "
^DIC(19,6198,1,30,0)="Also, the user can use the barcodes produced by the Record Tracking "
^DIC(19,6198,1,31,0)="system, that are on the patient's medical record, to identify "
^DIC(19,6198,1,32,0)="the patient."
^DIC(19,6198,15)="D HDLKILL^SDAMEVT"
^DIC(19,6198,20)="D HDLKILL^SDAMEVT,EN^SDAMEX"
^DIC(19,6198,"U")="APPOINTMENT CHECK-IN/CHECK-OUT"
^DIC(19,6199,0)="SDAM RPT MANAGEMENT^Appointment Management Report^^A^1253^^^^^^^16^^1"
^DIC(19,6199,1,0)="^^18^18^2980417^^^^"
^DIC(19,6199,1,1,0)="The following outputs can be obtained using this option:"
^DIC(19,6199,1,2,0)="        o  statistical report for appointments with statuses of checked-in,"
^DIC(19,6199,1,3,0)="           checked-out, cancelled, no-showed, no action taken/action required"
^DIC(19,6199,1,4,0)="           and inpatient"
^DIC(19,6199,1,5,0)=" "
^DIC(19,6199,1,6,0)="        o  statistical report on all outpatient encounters with statuses of"
^DIC(19,6199,1,7,0)="           checked-out, action required and inpatient"
^DIC(19,6199,1,8,0)=" "
^DIC(19,6199,1,9,0)="        o  division(s) only statistical report for appointments with statuses"
^DIC(19,6199,1,10,0)="           of checked-in, checked-out, cancelled, no-showed, no action taken/"
^DIC(19,6199,1,11,0)="           action required and inpatient"
^DIC(19,6199,1,12,0)=" "
^DIC(19,6199,1,13,0)="        o  division(s) only statistical report on all outpatient encounters"
^DIC(19,6199,1,14,0)="           with statuses of checked-out, action required and inpatient"
^DIC(19,6199,1,15,0)=" "
^DIC(19,6199,1,16,0)=" "
^DIC(19,6199,1,17,0)="For these reports, the user will be prompted for a date range that will"
^DIC(19,6199,1,18,0)="be used to search for appointments."
^DIC(19,6199,20)="D EN^SDAMO"
^DIC(19,6199,"U")="APPOINTMENT MANAGEMENT REPORT"
^DIC(19,6200,0)="SDAM APPT UPDATE VIEW^View Appointment Status Update Date (Single Date)^^A^1253^^^^^^^^^1"
^DIC(19,6200,1,0)="^^6^6^2980406^^^^"
^DIC(19,6200,1,1,0)="This option allows the user to view a single day in the Appointment Status"
^DIC(19,6200,1,2,0)="Update Log File.  The default for the Appointment Date is LAST//, allowing"
^DIC(19,6200,1,3,0)="the user to select the last date the update process was run."
^DIC(19,6200,1,4,0)=" "
^DIC(19,6200,1,5,0)="Displayed is the Appointment Date, Date Last Update Started, Update Method,"
^DIC(19,6200,1,6,0)="User, Date Last Update Completed."
^DIC(19,6200,20)="D 2^SDAMLD"
^DIC(19,6200,"U")="VIEW APPOINTMENT STATUS UPDATE"
^DIC(19,6201,0)="SDAM APPT UPDATE PRINT^Print Appointment Status Update (Date Range)^^A^1253^^^^^^^^^1"
^DIC(19,6201,1,0)="^^5^5^2980406^^^"
^DIC(19,6201,1,1,0)="This option allows the user to print a date range of the Appointment Status"
^DIC(19,6201,1,2,0)="Update Log File."
^DIC(19,6201,1,3,0)=" "
^DIC(19,6201,1,4,0)="Displayed is the Appointment Date, Date Last Update Started, Update Method,"
^DIC(19,6201,1,5,0)="User, Date Last Update Completed."
^DIC(19,6201,20)="D 3^SDAMLD"
^DIC(19,6201,"U")="PRINT APPOINTMENT STATUS UPDAT"
^DIC(19,6202,0)="SDAM APPT UPDATE PURGE^Purge Appointment Status Update Log File^^A^.5^^^^^^^^^1"
^DIC(19,6202,1,0)="^^7^7^2920318^^"
^DIC(19,6202,1,1,0)="This option allows the user to purge a date range from the Appointment"
^DIC(19,6202,1,2,0)="Status Update Log File."
^DIC(19,6202,1,3,0)=" "
^DIC(19,6202,1,4,0)="Only dates later than the current plus one fiscal year will be purged."
^DIC(19,6202,1,5,0)=" "
^DIC(19,6202,1,6,0)="At the end of the purge there will be a mailman message generated and "
^DIC(19,6202,1,7,0)="sent to the user's IN mail box."
^DIC(19,6202,20)="D 4^SDAMLD"
^DIC(19,6202,"U")="PURGE APPOINTMENT STATUS UPDAT"
^DIC(19,6203,0)="SDAM APPT UPDATE MENU^Appointment Status Update Menu^^M^.5^^^^^^^"
^DIC(19,6203,1,0)="^^2^2^2921028^^^^"
^DIC(19,6203,1,1,0)="This menu option allows the user to access the Appointment Status Update"
^DIC(19,6203,1,2,0)="Log options."
^DIC(19,6203,10,0)="^19.01PI^4^4"
^DIC(19,6203,10,1,0)="6196^AU^"
^DIC(19,6203,10,2,0)="6200^VU^"
^DIC(19,6203,10,3,0)="6202^PU^"
^DIC(19,6203,10,4,0)="6201^PRU^"
^DIC(19,6203,10,"B",6196,1)=""
^DIC(19,6203,10,"B",6200,2)=""
^DIC(19,6203,10,"B",6201,4)=""
^DIC(19,6203,10,"B",6202,3)=""
^DIC(19,6203,10,"C","AU",1)=""
^DIC(19,6203,10,"C","PRU",4)=""
^DIC(19,6203,10,"C","PU",3)=""
^DIC(19,6203,10,"C","VU",2)=""
^DIC(19,6203,99)="57712,54867"
^DIC(19,6203,"U")="APPOINTMENT STATUS UPDATE MENU"
^DIC(19,6204,0)="SD PARM PARAMETERS^Scheduling Parameters^^A^.5^^^^^^^16^^1"
^DIC(19,6204,1,0)="^^3^3^2920612^^^"
^DIC(19,6204,1,1,0)="This option displays the scheduling related Site and Division Parameters."
^DIC(19,6204,1,2,0)="It also allows the user to edit the appropriate MAS and Division"
^DIC(19,6204,1,3,0)="parameters."
^DIC(19,6204,20)="D START^SDPARM"
^DIC(19,6204,99)="55685,37652"
^DIC(19,6204,"U")="SCHEDULING PARAMETERS"
^DIC(19,6205,0)="SDAM RPT RETROACTIVE LIST^Retroactive Visits List^^R^1253^^^^^^^16"
^DIC(19,6205,1,0)="^^32^32^2980211^^^^"
^DIC(19,6205,1,1,0)="This option provides output of appointments and/or standalone encounters"
^DIC(19,6205,1,2,0)="that have been entered past the date transmission for workload credit is"
^DIC(19,6205,1,3,0)="allowed."
^DIC(19,6205,1,4,0)=" "
^DIC(19,6205,1,5,0)="The user will be prompted for a date range.  This date range will be"
^DIC(19,6205,1,6,0)="used to look at the visit dates."
^DIC(19,6205,1,7,0)=" "
^DIC(19,6205,1,8,0)="The user will be allowed to select one/many/all division(s).  It will"
^DIC(19,6205,1,9,0)="also allow the use to find the input either by stop code or clinic."
^DIC(19,6205,1,10,0)=" "
^DIC(19,6205,1,11,0)="If the stop code is selected, it will allow the selection of one/many"
^DIC(19,6205,1,12,0)="all stop codes.  It will look at all clinics in specified division"
^DIC(19,6205,1,13,0)="that match the stop codes, then look at the standalones for the specified"
^DIC(19,6205,1,14,0)="stop code."
^DIC(19,6205,1,15,0)=" "
^DIC(19,6205,1,16,0)="If the clinic is selected, it will allow the selection of one/many/all"
^DIC(19,6205,1,17,0)="clinic(s).  It will look at the clinics specified, then look at the"
^DIC(19,6205,1,18,0)="add/edits for any associated clinics that match the specified clinic."
^DIC(19,6205,1,19,0)=" "
^DIC(19,6205,1,20,0)="The user will then receive an output of the following information:"
^DIC(19,6205,1,21,0)=" "
^DIC(19,6205,1,22,0)="      o Appointment Date/Time"
^DIC(19,6205,1,23,0)="      o Date Entered"
^DIC(19,6205,1,24,0)="      o Date Transmitted"
^DIC(19,6205,1,25,0)="     *o Clinic"
^DIC(19,6205,1,26,0)="      o Patient"
^DIC(19,6205,1,27,0)="      o Patient ID"
^DIC(19,6205,1,28,0)="      o Type (either APPT or ADD/EDIT)"
^DIC(19,6205,1,29,0)="      o User who entered appointment or add/edit"
^DIC(19,6205,1,30,0)=" "
^DIC(19,6205,1,31,0)="*Clinic name will only appear for add/edits when an associated clinic"
^DIC(19,6205,1,32,0)="has been specified."
^DIC(19,6205,25)="SDAMOL"
^DIC(19,6205,99)="55265,41748"
^DIC(19,6205,"U")="RETROACTIVE VISITS LIST"
^DIC(19,6206,0)="PRCAY RELEASE HOLDS^Release Holds on AR^^A^.5^^^^^^^261^^1"
^DIC(19,6206,1,0)="^^8^8^2920819^^"
^DIC(19,6206,1,1,0)="This option allows the agent cashier to release 'holds' on"
^DIC(19,6206,1,2,0)="Means Test bills.  There may be some requirements for the"
^DIC(19,6206,1,3,0)="VA to ""hold-off"" billing the patient until payment is received from"
^DIC(19,6206,1,4,0)="the insurance company.  When a payment is received from an"
^DIC(19,6206,1,5,0)="insurance company, any ""holds"" on bills to be sent to the patient"
^DIC(19,6206,1,6,0)="need to be removed and the patient should be billed.  This option"
^DIC(19,6206,1,7,0)="allows the user to forward the bills from MCCR to AR to start"
^DIC(19,6206,1,8,0)="the collection process."
^DIC(19,6206,20)="D ^IBRREL"
^DIC(19,6206,99)="55563,65225"
^DIC(19,6206,"U")="RELEASE HOLDS ON AR"
^DIC(19,6207,0)="IB OUTPUT PATIENT REPORT MENU^Patient Billing Reports Menu^^M^10000000216^^^^^^^192"
^DIC(19,6207,1,0)="^19.06^3^3^3110804^^^^"
^DIC(19,6207,1,1,0)="This menu contains the Billing reports that deal with one"
^DIC(19,6207,1,2,0)="or a group of patients.   This includes all billing lists of patients and"
^DIC(19,6207,1,3,0)="billing inquiries."
