^DIC(19,13552,25)="PSOATRP"
^DIC(19,13552,"U")="INTERNET REFILL REPORT"
^DIC(19,13553,0)="PSO RX QUEUE CMOP^Queue CMOP Prescription^^R^1^^^^^^^141"
^DIC(19,13553,1,0)="^19.06^3^3^3070726^^"
^DIC(19,13553,1,1,0)="This is the Queue Prescription to CMOP Suspense option. It will allow"
^DIC(19,13553,1,2,0)="the users (including pharmacy technicians) to put mail-routed"
^DIC(19,13553,1,3,0)="prescription(s) for CMOP drugs on suspense for CMOP."
^DIC(19,13553,25)="PSORESUS"
^DIC(19,13553,"U")="QUEUE CMOP PRESCRIPTION"
^DIC(19,13554,0)="PRSA RECESS ENTER/EDIT^Recess Enter/Edit for 9 Month AWS^^R^1^^^^^^^"
^DIC(19,13554,1,0)="^19.06^12^12^3070104^^"
^DIC(19,13554,1,1,0)="This option provides timekeepers the ability to enter and edit recess"
^DIC(19,13554,1,2,0)="schedules for nurses working a 9 month/3 month alternative work schedule "
^DIC(19,13554,1,3,0)="(AWS). Timekeepers may only enter or edit recess schedules for nurses on"
^DIC(19,13554,1,4,0)="the 9-month/3-month AWS that are within T&L units assigned to them.  When"
^DIC(19,13554,1,5,0)="entering a new recess schedule the date that the AWS becomes effective is"
^DIC(19,13554,1,6,0)="required. If a date is entered that is not the first Sunday of the pay"
^DIC(19,13554,1,7,0)="period then the option assumes the first Sunday for the pay period in"
^DIC(19,13554,1,8,0)="which the user supplied date falls.  The option limits the available "
^DIC(19,13554,1,9,0)="recess schedules for entry and editing to the current, next and last "
^DIC(19,13554,1,10,0)="fiscal years.  The option invokes the ListManager to produce a list of"
^DIC(19,13554,1,11,0)="weeks in calendar format from the first week of the AWS through the end of"
^DIC(19,13554,1,12,0)="the fiscal year."
^DIC(19,13554,25)="ENEDIT^PRSARC"
^DIC(19,13554,"U")="RECESS ENTER/EDIT FOR 9 MONTH "
^DIC(19,13555,0)="PRSA RECESS VIEWER-HR^Review FY Recess for 9 Month AWS Employee^^R^1^^^^^^^230"
^DIC(19,13555,1,0)="^^8^8^3070530^"
^DIC(19,13555,1,1,0)="This is a view only option that provides a display of the recess schedule"
^DIC(19,13555,1,2,0)="for nurses on the 9 month/3 month alternate work schedule (AWS).  To"
^DIC(19,13555,1,3,0)="select a 9 month/3 month AWS recess schedule to view, enter either a"
^DIC(19,13555,1,4,0)="fiscal year or the nurses name.  Once the schedule is selected, the user"
^DIC(19,13555,1,5,0)="may enter actions at the select action prompt to navigate through the"
^DIC(19,13555,1,6,0)="recess schedule, print the recess schedule and display a summary.  Enter"
^DIC(19,13555,1,7,0)="?? at the select action prompt to see the complete list of available"
^DIC(19,13555,1,8,0)="actions."
^DIC(19,13555,10.1)="Recess Viewer"
^DIC(19,13555,25)="HR^PRSARC"
^DIC(19,13555,"U")="REVIEW FY RECESS FOR 9 MONTH A"
^DIC(19,13556,0)="PRSA RECESS VIEWER-SUP^Review FY Recess for 9 Month AWS Employee^^R^1^^^^^^^"
^DIC(19,13556,1,0)="^^8^8^3070530^"
^DIC(19,13556,1,1,0)="This is a view only option that provides a display of the recess schedule"
^DIC(19,13556,1,2,0)="for nurses on the 9 month/3 month alternate work schedule (AWS).  To"
^DIC(19,13556,1,3,0)="select a 9 month/3 month AWS recess schedule to view, first enter the T&L"
^DIC(19,13556,1,4,0)="unit of the nurse, then enter either a fiscal year or the nurses name.  "
^DIC(19,13556,1,5,0)="Once the schedule is selected, the user may enter actions at the select"
^DIC(19,13556,1,6,0)="action prompt to navigate through the recess schedule, print the recess"
^DIC(19,13556,1,7,0)="schedule and display a summary.  Enter ?? at the select action prompt to"
^DIC(19,13556,1,8,0)="see the complete list of available actions."
^DIC(19,13556,10.1)="Recess Viewer"
^DIC(19,13556,25)="SUP^PRSARC"
^DIC(19,13556,"U")="REVIEW FY RECESS FOR 9 MONTH A"
^DIC(19,13557,0)="PRSA RECESS VIEWER-NURSE^Review FY Recess for 9 Month AWS Employee^^R^1^PRSAWS9^^^^^^"
^DIC(19,13557,1,0)="^^6^6^3070625^"
^DIC(19,13557,1,1,0)="This is a view only option that provides a display of the recess schedule"
^DIC(19,13557,1,2,0)="for a 9 month/3 month alternate work schedule (AWS).  To select a 9"
^DIC(19,13557,1,3,0)="month/3 month AWS recess schedule, enter a fiscal year.  Once the schedule"
^DIC(19,13557,1,4,0)="is selected, enter actions at the Select Action prompt to navigate through"
^DIC(19,13557,1,5,0)="the recess schedule, print the recess schedule and display a summary.  "
^DIC(19,13557,1,6,0)="Nurses must hold the PRSAWS9 security key to access this option."
^DIC(19,13557,10.1)="Recess Viewer"
^DIC(19,13557,25)="NURSE^PRSARC"
^DIC(19,13557,"U")="REVIEW FY RECESS FOR 9 MONTH A"
^DIC(19,13558,0)="PRSA RECESS VIEWER-TK^Review FY Recess for 9 Month AWS Employee^^R^1^^^^^^^"
^DIC(19,13558,1,0)="^^7^7^3070625^"
^DIC(19,13558,1,1,0)="This is a view only option that provides a display of the recess schedule"
^DIC(19,13558,1,2,0)="for nurses on the 9 month/3 month alternate work schedule (AWS).  To"
^DIC(19,13558,1,3,0)="select a 9 month/3 month AWS recess schedule to view, first enter the T&L"
^DIC(19,13558,1,4,0)="unit of the nurse, then enter either a fiscal year or the nurse's name.  "
^DIC(19,13558,1,5,0)="Once the schedule is selected, the user may enter actions at the select"
^DIC(19,13558,1,6,0)="action prompt to navigate through the recess schedule, print the recess"
^DIC(19,13558,1,7,0)="schedule and display a summary."
^DIC(19,13558,10.1)="Recess Viewer"
