^DIC(19,8065,0)="IBT EDIT REASON NOT BILLABLE^Assign Reason Not Billable^^R^.5^^^^^^^192"
^DIC(19,8065,1,0)="^^3^3^2931027^^"
^DIC(19,8065,1,1,0)="This option allows entry of a reason not billable.  Entry of a reason "
^DIC(19,8065,1,2,0)="will automatically be printed on the Patients with Insurance Reports"
^DIC(19,8065,1,3,0)="and will cause the annotated care not to be automatically billed."
^DIC(19,8065,25)="IBTRED2"
^DIC(19,8065,"U")="ASSIGN REASON NOT BILLABLE"
^DIC(19,8066,0)="IBT EDIT BI TRACKING ENTRY^Claims Tracking Edit^^A^.5^^^^^^^192^^1"
^DIC(19,8066,1,0)="^^2^2^2931027^"
^DIC(19,8066,1,1,0)="This option allows entry and display of claims tracking information"
^DIC(19,8066,1,2,0)="that is needed to perform billing functions."
^DIC(19,8066,20)="S IBTRPRF=3 D ^IBTRE K IBTRPRF"
^DIC(19,8066,"U")="CLAIMS TRACKING EDIT"
^DIC(19,8067,0)="IBT OUTPUT BILLING SHEET^Print CT Summary for Billing^^R^.5^^^^^^^192"
^DIC(19,8067,1,0)="^^8^8^2940307^^^^"
^DIC(19,8067,1,1,0)="This option allows printing of information from Claims Tracking about"
^DIC(19,8067,1,2,0)="a specific visit.  Included on the report is Visit Information, Insurance"
^DIC(19,8067,1,3,0)="Information, Billing information (from Claims Tracking), Hospital Review"
^DIC(19,8067,1,4,0)="information and Insurance Review information.  Also included is provider,"
^DIC(19,8067,1,5,0)="diagnosis, and procedure information."
^DIC(19,8067,1,6,0)=" "
^DIC(19,8067,1,7,0)="This report is the most complete summary of information about a single"
^DIC(19,8067,1,8,0)="visit available in Claims Tracking."
^DIC(19,8067,25)="IBTOBI"
^DIC(19,8067,"U")="PRINT CT SUMMARY FOR BILLING"
^DIC(19,8068,0)="IBT OUTPUT REVIEW WORKSHEET^Review Worksheet Print^^R^.5^^^^^^^"
^DIC(19,8068,1,0)="^^3^3^2931110^^"
^DIC(19,8068,1,1,0)="This option will print an Insurance Review worksheet for the selected "
^DIC(19,8068,1,2,0)="patient.  If the patient is currently an inpatient, it will contain"
^DIC(19,8068,1,3,0)="the current inpatient information.  "
^DIC(19,8068,25)="RWM^IBTRC4"
^DIC(19,8068,"U")="REVIEW WORKSHEET PRINT"
^DIC(19,8070,0)="IBDF MISCELLANEOUS CLEANUP^Miscellaneous Cleanup^^A^11594^^^^^^^485^^1"
^DIC(19,8070,1,0)="^^6^6^2960311^^^"
^DIC(19,8070,1,1,0)="This option is intended to delete various data structures that are no longer"
^DIC(19,8070,1,2,0)="in use.  The Encounter Form Utilties were designed to automatically delete all"
^DIC(19,8070,1,3,0)="data structures when no longer needed, so this option is a backup that should"
^DIC(19,8070,1,4,0)="rarely be needed.  Currently, the option deletes the compiled version of forms"
^DIC(19,8070,1,5,0)="where the form itself no longer exists.  It also deletes blocks that do not"
^DIC(19,8070,1,6,0)="belong to any form."
^DIC(19,8070,20)="D GARBAGE^IBDF19"
^DIC(19,8070,"U")="MISCELLANEOUS CLEANUP"
^DIC(19,8071,0)="IBCN LIST NEW NOT VER^List New not Verified Policies^^R^.5^^^^^^^192"
^DIC(19,8071,1,0)="^^4^4^2931129^"
^DIC(19,8071,1,1,0)="This option will list by patient new insurance entries that have never"
^DIC(19,8071,1,2,0)="been verified.  Run this report and then use the Patient Insurance Info"
^DIC(19,8071,1,3,0)="View/Edit option and choose the Verify Coverage action to verify "
^DIC(19,8071,1,4,0)="coverage for individual patients."
^DIC(19,8071,25)="IBCOC1"
^DIC(19,8071,"U")="LIST NEW NOT VERIFIED POLICIES"
^DIC(19,8072,0)="IB PRINT BILL ADDENDUM^Print Bill Addendum Sheet^^R^1^^^^^^^192"
^DIC(19,8072,1,0)="^^3^3^3060927^"
^DIC(19,8072,1,1,0)="Prints the Addendum sheets that may accompany CMS-1500 Rx Refill"
^DIC(19,8072,1,2,0)="or Prosthetics bills.  The addendum contains information that"
^DIC(19,8072,1,3,0)="could not fit on the bill form."
^DIC(19,8072,25)="IBCF4"
^DIC(19,8072,"U")="PRINT BILL ADDENDUM SHEET"
^DIC(19,8073,0)="IB BATCH PRINT BILLS^Print Authorized Bills^^R^10000000020^^^^^^^"
^DIC(19,8073,1,0)="^^2^2^2960220^^^"
^DIC(19,8073,1,1,0)="Queues all authorized bills that have not been flagged for transmission"
^DIC(19,8073,1,2,0)="to print in user specified order."
^DIC(19,8073,25)="IBCFP"
^DIC(19,8073,"U")="PRINT AUTHORIZED BILLS"
^DIC(19,8074,0)="IBT OUTPUT LIST VISITS^List Visits Requiring Reviews^^R^.5^^^^^^^192"
^DIC(19,8074,1,0)="^^8^8^2940124^^^^"
^DIC(19,8074,1,1,0)="This option will print a list of visits that require either an insurance"
^DIC(19,8074,1,2,0)="review, hospital review or both.  In addition only visits that are"
^DIC(19,8074,1,3,0)="admissions may be printed.   The user may select the date range of visits"
^DIC(19,8074,1,4,0)="to print."
^DIC(19,8074,1,5,0)=" "
^DIC(19,8074,1,6,0)="This option can be used to list the Random Sample cases being tracked"
^DIC(19,8074,1,7,0)="for Hospital Reviews by answering the prompts that only hospital reviews for"
^DIC(19,8074,1,8,0)="admissions are wanted."
^DIC(19,8074,25)="IBTOLR"
^DIC(19,8074,"U")="LIST VISITS REQUIRING REVIEWS"
^DIC(19,8075,0)="XMMGR-RESPONSE-TIME-TOGGLER^Log Response Time Toggler^^R^11748^^^^^^^54"
^DIC(19,8075,1,0)="^^11^11^2920926^^^"
^DIC(19,8075,1,1,0)="This option will do the following:"
^DIC(19,8075,1,2,0)=" "
^DIC(19,8075,1,3,0)="1.  At a little after each half-hour, it will turn on the Kernel"
^DIC(19,8075,1,4,0)="Site Parameter for response time logging."
^DIC(19,8075,1,5,0)=" "
^DIC(19,8075,1,6,0)="2.  It will then schedule another task to turn off the Kernel Site"
^DIC(19,8075,1,7,0)="Parameter for response time logging unless the time is between"
^DIC(19,8075,1,8,0)="4PM and 8AM .  During these hours, response time logging will remain"
^DIC(19,8075,1,9,0)="on unless site management interferes by canceling the tasks "
^DIC(19,8075,1,10,0)="associated with this phenomenon and edits the LOG RESPONSE TIME"
^DIC(19,8075,1,11,0)="field for the appropriate VOLUME SET to be 'off' ."
^DIC(19,8075,25)="LOGON^XMUT5C"
^DIC(19,8075,99)="55472,33528"
^DIC(19,8075,"U")="LOG RESPONSE TIME TOGGLER"
^DIC(19,8076,0)="XMMGR-NEWMESS/LOGON-STATS^New Messages and Logon Statistics^^R^11748^^^^^^^54"
^DIC(19,8076,1,0)="^^2^2^2940407^^^^"
^DIC(19,8076,1,1,0)="This option prints the number of new messages created, logons, and"
^DIC(19,8076,1,2,0)="logon minutes for a specified time period."
^DIC(19,8076,25)="STATS^XMUT5R1"
^DIC(19,8076,99)="55421,58724"
^DIC(19,8076,"U")="NEW MESSAGES AND LOGON STATIST"
^DIC(19,8077,0)="XMMGR-BKFILER-ACT^Active Users/Deliveries Report^^R^11748^^^^^^^54"
^DIC(19,8077,1,0)="^^3^3^2940423^^^"
^DIC(19,8077,1,1,0)="This report lists in 1/2 hours intervals (that is what is in the file)"
^DIC(19,8077,1,2,0)="active users and messages deliveries made.  The information comes from"
^DIC(19,8077,1,3,0)="file 4.2998 (Message Delivery Stats)."
^DIC(19,8077,25)="ACT^XMUT5R2"
^DIC(19,8077,"U")="ACTIVE USERS/DELIVERIES REPORT"
^DIC(19,8078,0)="XMMGR-BKFILER-EDIT-NORMALIZED^Edit numbers to Normalize Reports^^R^11748^^^^^^^54"
^DIC(19,8078,1,0)="^^1^1^2920926^"
^DIC(19,8078,1,1,0)="This option allows the user to customize the normalized report."
^DIC(19,8078,25)="ASK^XMUT5R2"
^DIC(19,8078,"U")="EDIT NUMBERS TO NORMALIZE REPO"
^DIC(19,8079,0)="XMMGR-BKFILER-GROUP^Deliveries by Group^^R^11748^^^^^^^54"
^DIC(19,8079,1,0)="^^2^2^2920926^"
^DIC(19,8079,1,1,0)="This report lists in 1/2 hour intervals, deliveries made for each distinct "
^DIC(19,8079,1,2,0)="delivery queue."
^DIC(19,8079,25)="GROUP^XMUT5R2"
^DIC(19,8079,"U")="DELIVERIES BY GROUP"
^DIC(19,8080,0)="XMMGR-BKFILER-STAT^Mail Delivery Statistics Report^^R^11748^^^^^^^54"
^DIC(19,8080,1,0)="^^2^2^2920926^"
^DIC(19,8080,1,1,0)="This report list in 1/2 hour intervals:  active users, queue waits,"
^DIC(19,8080,1,2,0)="average response time, number of lines displayed to users..."
^DIC(19,8080,25)="STAT^XMUT5R2"
^DIC(19,8080,99)="55432,33299"
^DIC(19,8080,"U")="MAIL DELIVERY STATISTICS REPOR"
^DIC(19,8081,0)="XMMGR-BKFILER-TABBED-STATS^Graphics Download (TAB separators)^^R^11748^^^^^^^54"
^DIC(19,8081,1,0)="^^3^3^2930804^^^"
^DIC(19,8081,1,1,0)="This option can be used to capture a report and use the captured file in"
^DIC(19,8081,1,2,0)="EXCEL or other graphics packages.  The data has TABS between the fields"
^DIC(19,8081,1,3,0)="as delimiters."
