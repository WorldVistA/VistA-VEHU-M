^DIC(19,4022,25)="LRAPSA"
^DIC(19,4022,"U")="ACCESSION LIST WITH STAINS"
^DIC(19,4023,0)="LRAPDPT^Prisoner of war veterans^^R^.5^^^^^^^26"
^DIC(19,4023,1,0)="^^2^2^2940318^^^"
^DIC(19,4023,1,1,0)="Lists prisoner of war veterans that have anatomic pathology"
^DIC(19,4023,1,2,0)=" specimens for the time specified."
^DIC(19,4023,25)="LRAPDPT"
^DIC(19,4023,"U")="PRISONER OF WAR VETERANS"
^DIC(19,4024,0)="LRAPDFS^Delete free text specimen entries^^R^.5^LRLIASON^^^^^^26"
^DIC(19,4024,1,0)="^^4^4^2881031^^^"
^DIC(19,4024,1,1,0)="This option allows deletion of free text specimen entries"
^DIC(19,4024,1,2,0)=" for surgical path, cytopath and electron microscopy for"
^DIC(19,4024,1,3,0)=" time selected.  Workload data associated with the specimens"
^DIC(19,4024,1,4,0)=" will also be deleted."
^DIC(19,4024,25)="EN^LRAPDEL"
^DIC(19,4024,"U")="DELETE FREE TEXT SPECIMEN ENTR"
^DIC(19,4025,0)="LRAPEDC^Edit anat path comments^^R^.5^^^^^^^26"
^DIC(19,4025,1,0)="^^3^3^2881031^^^^"
^DIC(19,4025,1,1,0)="This option allows editing the accession comments for"
^DIC(19,4025,1,2,0)=" surg path, cytopath, and electron microscopy sections."
^DIC(19,4025,1,3,0)=" The comments will appear on the log book for the appropriate section."
^DIC(19,4025,25)="LRAPEDC"
^DIC(19,4025,"U")="EDIT ANAT PATH COMMENTS"
^DIC(19,4026,0)="LRAC FORCE^Force cumulative data to Permanent Page^^R^.5^LRSUPER^^^^^^26"
^DIC(19,4026,1,0)="^^4^4^2890309^^^"
^DIC(19,4026,1,1,0)="This option will identify patients who have been inactive in laboratory "
^DIC(19,4026,1,2,0)="for the specified period of time in the GRACE PERIOD FOR INACTIVITY field"
^DIC(19,4026,1,3,0)="of the Laboratory Site File and force their lab data onto a permanent"
^DIC(19,4026,1,4,0)="cumulative page, making the data eligible for archiving."
^DIC(19,4026,25)="QUEUE^LRACF"
^DIC(19,4026,"U")="FORCE CUMULATIVE DATA TO PERMA"
^DIC(19,4027,0)="LROWRP^Reprint a Ward Collect Order^^R^.5^^^^^^^26"
^DIC(19,4027,1,0)="^^1^1^2881103^"
^DIC(19,4027,1,1,0)="This option allows the user to reprint a lab order for ward collect."
^DIC(19,4027,25)="LROW2RP"
^DIC(19,4027,"U")="REPRINT A WARD COLLECT ORDER"
^DIC(19,4028,0)="LRLLPA^Active Load Work Listing^^R^.5^^^^^^^26"
^DIC(19,4028,1,0)="^^5^5^2940328^^^"
^DIC(19,4028,1,1,0)="This option will print a listing of all active [Load/Work which have not been UNLOADED ]."
^DIC(19,4028,1,2,0)="The listing shows the Load List Name, the date built, user who requested"
^DIC(19,4028,1,3,0)="the work list to be built and the Accession Area."
^DIC(19,4028,1,4,0)=" "
^DIC(19,4028,1,5,0)="  Note -- The ""*"" after the date indicates list has existed for more than 1 Day"
^DIC(19,4028,25)="ASK^LRLL"
^DIC(19,4028,"U")="ACTIVE LOAD WORK LISTING"
^DIC(19,4029,0)="LRUPACT^Test counts by treating specialty^^R^.5^^^^^^^26"
^DIC(19,4029,1,0)="^^2^2^2881106^"
^DIC(19,4029,1,1,0)="This option lists tests and counts by treating speciality"
^DIC(19,4029,1,2,0)=" for time specified."
^DIC(19,4029,25)="LRUPACT"
^DIC(19,4029,"U")="TEST COUNTS BY TREATING SPECIA"
^DIC(19,4030,0)="LR CAPTT^Lab test turnaround time^^R^.5^^^^^^^26"
^DIC(19,4030,1,0)="^^6^6^2881229^^^^"
^DIC(19,4030,1,1,0)="Provides counts of selected tests for a hospital location for"
^DIC(19,4030,1,2,0)=" a selected time."
^DIC(19,4030,1,3,0)=" Test must have date and times for receipt in lab and completion"
^DIC(19,4030,1,4,0)=" of test to be included in the report."
^DIC(19,4030,1,5,0)=" Turnaround time=LAB ARRIVAL TIME(field 69.01,20)-COMPLETE DATE"
^DIC(19,4030,1,6,0)="                                                  (field 68.04,4)"
^DIC(19,4030,25)="LRUTT"
^DIC(19,4030,"U")="LAB TEST TURNAROUND TIME"
^DIC(19,4031,0)="LRNDLST^List of orders not collected (Long form)^^R^.5^^^^^^n^26"
^DIC(19,4031,1,0)="^^3^3^2890329^"
^DIC(19,4031,1,1,0)="  This option is a complete display of orders in file 69 which"
^DIC(19,4031,1,2,0)="do not have a status of ""C"" (collected) and have a collect type"
^DIC(19,4031,1,3,0)="of LC,SP OR WC. In other words a full display LRNODRAW option."
^DIC(19,4031,20)=""
^DIC(19,4031,25)="LRNDLST"
^DIC(19,4031,"U")="LIST OF ORDERS NOT COLLECTED ("
^DIC(19,4032,0)="LR INTEGRITY LOAD^Load Integrity File^^R^.5^^^^^^^26"
^DIC(19,4032,1,0)="^^9^9^2890613^"
^DIC(19,4032,1,1,0)=" This option is used to load L* routines into LR ROUTINE INTEGRITY CHECKER"
^DIC(19,4032,1,2,0)="file (69.91). This option is sensitive to the version number of the"
^DIC(19,4032,1,3,0)="routine located on the second line of each routine. Once a version number"
^DIC(19,4032,1,4,0)="has been selected, each routine will be checked for that version number."
^DIC(19,4032,1,5,0)="If the routine begins with a 'L' and has the corrected version number, it"
^DIC(19,4032,1,6,0)="is entered to the file. Routines size ($L) and total ASCII ($A) for each"
^DIC(19,4032,1,7,0)="routine is entered in to the file. Once the file is loaded any changes to"
^DIC(19,4032,1,8,0)="loaded routine can be detected. This has many uses, eg. checking patch"
^DIC(19,4032,1,9,0)="application, or determining routine map size."
^DIC(19,4032,25)="LRNITEGL"
^DIC(19,4032,"U")="LOAD INTEGRITY FILE"
^DIC(19,4033,0)="LR INTEGRITY SINGLE^Check a single routine size^^R^.5^^^^^^^26"
^DIC(19,4033,1,0)="^^7^7^2890613^"
^DIC(19,4033,1,1,0)="  This option is used to check a routine against data stored in the"
^DIC(19,4033,1,2,0)="LR ROUTINE INTEGRITY CHECKER file (69.91). After the file has been loaded"
^DIC(19,4033,1,3,0)="using LR INTEGRITY LOAD option, use of this option will check for integrity"
^DIC(19,4033,1,4,0)="of that routine. The size and ASCII value of the selected routine will be"
^DIC(19,4033,1,5,0)="compared to the date in the file. A message will then display the value(s)"
^DIC(19,4033,1,6,0)="of the selected routine and indicate if the routine has changed."
^DIC(19,4033,1,7,0)="   The routine are stored by version numbers."
^DIC(19,4033,25)="SING^LRNITEG"
^DIC(19,4033,"U")="CHECK A SINGLE ROUTINE SIZE"
^DIC(19,4034,0)="LR INTEGRITY LOOP^Loop thru LR INTEGRITY^^R^.5^^^^^^^26"
^DIC(19,4034,1,0)="^^5^5^2890613^^"
^DIC(19,4034,1,1,0)="  This option will you to select a version number, starting routine and a"
^DIC(19,4034,1,2,0)="ending routine to be check for integrity. This option uses the LR ROUTINE"
^DIC(19,4034,1,3,0)="INTEGRITY CHECKER file (69.91). After entering your selection the option"
^DIC(19,4034,1,4,0)="will loop thru the file printing a '.' for every record checked."
^DIC(19,4034,1,5,0)="When a routine fails the integrity checked it is printed out."
^DIC(19,4034,25)="LOOP^LRNITEG"
^DIC(19,4034,"U")="LOOP THRU LR INTEGRITY"
^DIC(19,4035,0)="LR INTEGRITY^LAB ROUTINE INTEGRITY MENU^^M^.5^^^^^^^26"
^DIC(19,4035,1,0)="^^3^3^2930513^^"
^DIC(19,4035,1,1,0)="  This menu should be assigned to the persons(s) who maintain the L*"
^DIC(19,4035,1,2,0)="routines. The menu allows loading of LR INTEGRITY CHECKER file as "
^DIC(19,4035,1,3,0)="well checking it contents for consistancy."
^DIC(19,4035,10,0)="^19.01PI^3^3"
^DIC(19,4035,10,1,0)="4032^LD"
^DIC(19,4035,10,2,0)="4034^LP"
^DIC(19,4035,10,3,0)="4033^"
