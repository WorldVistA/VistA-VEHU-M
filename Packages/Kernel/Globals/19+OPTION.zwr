^DIC(19,15205,"U")="CONSULT MANAGEMENT"
^DIC(19,15206,0)="EHM-00027^Set up Consult Services^^R^1^^^^^^^^^^^"
^DIC(19,15206,1,0)="^^10^10^3240328^^^^"
^DIC(19,15206,1,1,0)="This option is used to setup the Hospital hierarchy of services and"
^DIC(19,15206,1,2,0)="specialties.  Each service/specialty defined in this file may be"
^DIC(19,15206,1,3,0)="setup to have a consult print at its own service printer when the"
^DIC(19,15206,1,4,0)="consult is entered and signed using the ""Add orders"" menus in OE/RR."
^DIC(19,15206,1,5,0)="  "
^DIC(19,15206,1,6,0)="Teams of clinicians may also be associated with each Service/Specialty."
^DIC(19,15206,1,7,0)="The team members will be notified when a new consult is ordered"
^DIC(19,15206,1,8,0)="from their service/specialty."
^DIC(19,15206,1,9,0)="  "
^DIC(19,15206,1,10,0)="Cloned from ""GMRC SETUP REQUEST SERVICES"" option."
^DIC(19,15206,3)=""
^DIC(19,15206,15)=""
^DIC(19,15206,25)="EN^GMRCSRVS"
^DIC(19,15206,30)=""
^DIC(19,15206,31)=""
^DIC(19,15206,32)=""
^DIC(19,15206,33)=""
^DIC(19,15206,34)=""
^DIC(19,15206,50)=""
^DIC(19,15206,51)=""
^DIC(19,15206,99)="55473,52504"
^DIC(19,15206,"U")="SET UP CONSULT SERVICES"
^DIC(19,15207,0)="EHM-00028^Consult Service Tracking^^R^1^^^^^^^^^^1^"
^DIC(19,15207,1,0)="^^6^6^3240328^^^^"
^DIC(19,15207,1,1,0)="This option provides actions which a service may use to track "
^DIC(19,15207,1,2,0)="consults and requests."
^DIC(19,15207,1,3,0)="  "
^DIC(19,15207,1,4,0)="The processing flow is similiar to the OE/RR review screen.  Most of"
^DIC(19,15207,1,5,0)="the actions have the same mnemonics as OE/RR for clinician familiarity."
^DIC(19,15207,1,6,0)="Cloned from ""GMRC SERVICE TRACKING"" option."
^DIC(19,15207,3)=""
^DIC(19,15207,15)="D ^GMRCREXT"
^DIC(19,15207,25)="EN^GMRCSLM"
^DIC(19,15207,99)="55068,85713"
^DIC(19,15207,"U")="CONSULT SERVICE TRACKING"
^DIC(19,15208,0)="EHM-00029^Pharmacy TPN Consults^^R^1^^^^^^^^^^^"
^DIC(19,15208,1,0)="^19.06^1^1^3240328^^^^"
^DIC(19,15208,1,1,0)="Cloned from ""GMRC PHARMACY TPN CONSULTS"" option."
^DIC(19,15208,3)=""
^DIC(19,15208,15)=""
^DIC(19,15208,20)=""
^DIC(19,15208,25)="EN^GMRCPZ"
^DIC(19,15208,"U")="PHARMACY TPN CONSULTS"
^DIC(19,15209,0)="EHM-00030^Service User Management^^E^1^^^^^^^^^^^"
^DIC(19,15209,1,0)="^^13^13^3240328^^^^"
^DIC(19,15209,1,1,0)="This option is used to identify individuals or teams which should be "
^DIC(19,15209,1,2,0)="notified when a Consult/Request is being sent to their receiving service."
^DIC(19,15209,1,3,0)="  "
^DIC(19,15209,1,4,0)="It is also used to identify individuals who will not be notified when"
^DIC(19,15209,1,5,0)="consults are being sent to the service, but DO have update/tracking"
^DIC(19,15209,1,6,0)="capabilities for the service."
^DIC(19,15209,1,7,0)=" "
^DIC(19,15209,1,8,0)="Individuals or teams may also be notified of a new consult based on the"
^DIC(19,15209,1,9,0)="Patient's Location.  When a Consult/Request is sent to a service, the"
^DIC(19,15209,1,10,0)="Patient Location will be checked.  If the receiving service has broken"
^DIC(19,15209,1,11,0)="down their service notification by Hospital location, the notification "
^DIC(19,15209,1,12,0)="will be sent to the individual and/or a team defined in this option."
^DIC(19,15209,1,13,0)="Cloned from ""GMRC SERVICE USER MGMT"" option."
^DIC(19,15209,3)=""
^DIC(19,15209,30)="GMR(123.5,"
^DIC(19,15209,31)="AEMQZ"
