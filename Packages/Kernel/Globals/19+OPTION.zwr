^DIC(19,3134,1,0)="^^2^2^2870901.2134^"
^DIC(19,3134,1,1,0)="This option surveys ALL accounts within the Patient Funds system"
^DIC(19,3134,1,2,0)="and updates the account status (ACTIVE/INACTIVE) when necessary."
