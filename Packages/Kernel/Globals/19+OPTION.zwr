^DIC(19,6228,0)="IB MT CLOCK MAINTENANCE^Patient Billing Clock Maintenance^^R^.5^IB AUTHORIZE^^^^^^192"
^DIC(19,6228,1,0)="^^1^1^2920722^^^^"
^DIC(19,6228,1,1,0)="This option will allow adding or editing of Patient Billing Clocks."
^DIC(19,6228,20)=""
^DIC(19,6228,25)="IBEMTBC"
^DIC(19,6228,"U")="PATIENT BILLING CLOCK MAINTENA"
^DIC(19,6229,0)="IB FLAG CONTINUOUS PATIENTS^Add/Edit Pts. Continuously Hospitalized Since 1986^^R^.5^IB AUTHORIZE^^^^^^192"
^DIC(19,6229,1,0)="^^7^7^2920722^^^"
^DIC(19,6229,1,1,0)="This option can be used to add or edit entries in the file of patient"
^DIC(19,6229,1,2,0)="continuously hospitalized since 1986.  These patients are exempt from"
^DIC(19,6229,1,3,0)="the co-payment portion of the means test but may still be charged the"
^DIC(19,6229,1,4,0)="per diem.  The automated category C billing software will exempt these"
^DIC(19,6229,1,5,0)="patients from the co-payments.  In order to be considered continuously "
^DIC(19,6229,1,6,0)="hospitalized the patient must not have changed levels of care, i.e., gone"
^DIC(19,6229,1,7,0)="from a NHCU to the hospital."
^DIC(19,6229,25)="IBECPF"
^DIC(19,6229,"U")="ADD/EDIT PTS. CONTINUOUSLY HOS"
^DIC(19,6230,0)="IB MT CLOCK INQUIRY^Patient Billing Clock Inquiry^^R^10000000020^^^^^^^192"
^DIC(19,6230,1,0)="^19.06^2^2^3010907^^^^"
^DIC(19,6230,1,1,0)="Allows inquiry to the Means Test copay patients number of inpatient days"
^DIC(19,6230,1,2,0)="and amounts billed."
^DIC(19,6230,25)="IBOBCRT"
^DIC(19,6230,"U")="PATIENT BILLING CLOCK INQUIRY"
