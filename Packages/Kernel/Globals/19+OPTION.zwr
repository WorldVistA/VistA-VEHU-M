^DIC(19,15453,0)="EHM-00274^GUI ePCS Management Menu^^M^1^^^^^^^170^^^^"
^DIC(19,15453,1,0)="^19.06^3^3^3240328^^"
^DIC(19,15453,1,1,0)="This menu contains all of the options needed to manage the electronic "
^DIC(19,15453,1,2,0)="Prescribing of Controlled Substances (ePCS) functionality in CPRS."
^DIC(19,15453,1,3,0)="Cloned from ""OR EPCS MENU"" option."
^DIC(19,15453,3)=""
^DIC(19,15453,10,0)="^19.01IP^4^4"
