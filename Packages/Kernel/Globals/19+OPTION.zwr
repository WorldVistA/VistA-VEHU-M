^DIC(19,15989,0)="EHM-00810^Limited File Manager Options (Build)^^R^1^^^^^^^^^^^"
^DIC(19,15989,1,0)="^^12^12^3240328^"
^DIC(19,15989,1,1,0)="This option permits a user to build limited PRINT, EDIT, or INQUIRE"
^DIC(19,15989,1,2,0)="options.  The user must have one or more ALLOWABLE MENU PREFIX, and"
^DIC(19,15989,1,3,0)="the XQSMDFM key.  To build an edit option the user must have an"
^DIC(19,15989,1,4,0)="edit template to use.  To build a print option, the user must"
^DIC(19,15989,1,5,0)="have both a sort template and a print template.  For an inquire"
^DIC(19,15989,1,6,0)="option the user may have a print template, or can specify the file to use."
^DIC(19,15989,1,7,0)="The option is entered among the user's delegated options, so that they"
^DIC(19,15989,1,8,0)="may be included on a menu built under the Secure Menu Delegation and/or"
^DIC(19,15989,1,9,0)="given to other users as secondary options.  The name of the option is"
^DIC(19,15989,1,10,0)="restricted to the namespace designated in the ALLOWABLE MENU PREFIX"
^DIC(19,15989,1,11,0)="followed by a 'Z', and then identifying text."
^DIC(19,15989,1,12,0)="Cloned from ""XQSMD LIMITED FM OPTIONS"" option."
^DIC(19,15989,3)=""
^DIC(19,15989,25)="XQSMDFM"
^DIC(19,15989,"U")="LIMITED FILE MANAGER OPTIONS ("
^DIC(19,15990,0)="EHM-00811^Copy One Users Menus and Keys to others^^R^1^^^^^^^^^^^"
^DIC(19,15990,1,0)="^^10^10^3240328^"
^DIC(19,15990,1,1,0)="This option is used to copy the primary menu and secondary menu options"
^DIC(19,15990,1,2,0)="from one user to one or more others.  The only options transferred will"
^DIC(19,15990,1,3,0)="be those which have been delegated to the current user.  Likewise, keys"
^DIC(19,15990,1,4,0)="which are held by the selected user may be copied to the receipient"
^DIC(19,15990,1,5,0)="users if the current user has been delegated this capacity as well."
^DIC(19,15990,1,6,0)=" "
^DIC(19,15990,1,7,0)="This option provides an application coordinator the ability to produce"
^DIC(19,15990,1,8,0)="users which have the capabilities of a current user, e.g., a ward"
^DIC(19,15990,1,9,0)="clerk, scheduling clerk, etc."
^DIC(19,15990,1,10,0)="Cloned from ""XQSMD COPY USER"" option."
^DIC(19,15990,3)=""
^DIC(19,15990,25)="XQSMDCPY"
^DIC(19,15990,"U")="COPY ONE USERS MENUS AND KEYS "
