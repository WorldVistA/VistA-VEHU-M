^DIC(19,9678,20)="W @IOF"
^DIC(19,9678,25)="EDITC^ECDSS2"
^DIC(19,9678,"U")="LOCAL CATEGORY (ENTER/EDIT)"
^DIC(19,9679,0)="ECDS CATEGORY DEAC^Activate/Inactivate Local Category ^OPTION NO LONGER SUPPORTED. USE THE ECS GUI INTERFACE.^R^11596^^2942^^^^^499^^^1"
^DIC(19,9679,1,0)="^^3^3^2960401^^"
^DIC(19,9679,1,1,0)="This option provides the mechanism to inactivate categories that exist"
^DIC(19,9679,1,2,0)="in the EVENT CAPTURE CATEGORY file (#726). You have the ability to"
^DIC(19,9679,1,3,0)="reactivate a category using this option."
^DIC(19,9679,15)="W @IOF"
^DIC(19,9679,25)="SETDEAC^ECDSS2"
^DIC(19,9679,"U")="ACTIVATE/INACTIVATE LOCAL CATE"
