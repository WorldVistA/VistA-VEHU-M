^DIC(19,15803,"U")="EDIT SITE LOCAL TERMS"
^DIC(19,15804,0)="EHM-00625^Display the Order Checks a User Can Receive^^R^1^^^^^^^170^^^^"
^DIC(19,15804,1,0)="^^4^4^3240328^"
^DIC(19,15804,1,1,0)="This option prompts for a user/recipient then processes each order check"
^DIC(19,15804,1,2,0)="to determine if and why the user will receive the order check message"
^DIC(19,15804,1,3,0)="during the ordering process."
^DIC(19,15804,1,4,0)="Cloned from ""ORK RECIP ORDER CHECKS"" option."
