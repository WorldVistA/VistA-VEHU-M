^DIC(19,16629,25)="USER^PXRMXD"
^DIC(19,16629,"U")="REMINDERS DUE REPORT (USER)"
^DIC(19,16630,0)="EHM-01451^Review Date Report^^R^1^^^^^^y^534^^^^"
^DIC(19,16630,1,0)="^19.06^12^12^3240328^^^^"
^DIC(19,16630,1,1,0)="The Review Date Report is may be run for the following files:"
^DIC(19,16630,1,2,0)=" "
^DIC(19,16630,1,3,0)="        Reminder Computed Findings"
^DIC(19,16630,1,4,0)="        Reminder Definition"
^DIC(19,16630,1,5,0)="        Reminder Dialog"
^DIC(19,16630,1,6,0)="       Reminder Location List"
^DIC(19,16630,1,7,0)="        Reminder Sponsor"
^DIC(19,16630,1,8,0)="        Reminder Taxonomy"
^DIC(19,16630,1,9,0)=" "
^DIC(19,16630,1,10,0)="A cutoff date may be entered and all review dates prior or equal to that"
^DIC(19,16630,1,11,0)="date in the file selected are reported."
^DIC(19,16630,1,12,0)="Cloned from ""PXRM REVIEW DATES"" option."
^DIC(19,16630,3)=""
^DIC(19,16630,25)="START^PXRMREV"
^DIC(19,16630,99)="58608,54651"
^DIC(19,16630,"U")="REVIEW DATE REPORT"
^DIC(19,16631,0)="EHM-01452^Extract QUERI Totals^^P^1^^^^^^y^534^^^^"
^DIC(19,16631,1,0)="^19.06^3^3^3240328^^^^"
^DIC(19,16631,1,1,0)="This option prints reminder and finding totals for extract summaries "
