^DIC(19,15879,0)="EHM-00700^Check Provider ePCS Configuration^^R^1^^^^^^^170^^^^"
^DIC(19,15879,1,0)="^19.06^4^4^3240328^^"
^DIC(19,15879,1,1,0)="This option will prompt the user to select a person from the NEW PERSON "
^DIC(19,15879,1,2,0)="FILE (#200) and will detail whether that user can or cannot sign "
^DIC(19,15879,1,3,0)="controlled substance orders."
^DIC(19,15879,1,4,0)="Cloned from ""OR EPCS PROVIDER CONFIG CHECK"" option."
^DIC(19,15879,3)=""
