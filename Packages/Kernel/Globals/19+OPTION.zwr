^DIC(19,7444,0)="QAOS RPT RELIABILITY ASSMT^Reliability Assessment Worksheets^^R^.5^^^^^^^"
^DIC(19,7444,1,0)="^^5^5^2921006^"
^DIC(19,7444,1,1,0)="This option randomly selects occurrences, within user specified"
^DIC(19,7444,1,2,0)="parameters, and prints worksheets for the assessment of inter-reviewer"
^DIC(19,7444,1,3,0)="reliability.  The user may select a date range, the type of screens to"
^DIC(19,7444,1,4,0)="include (National, Local, Inactive) and, the number of occurrences to"
^DIC(19,7444,1,5,0)="capture."
^DIC(19,7444,25)="EN^QAOSPRD0"
^DIC(19,7444,"U")="RELIABILITY ASSESSMENT WORKSHE"
^DIC(19,7445,0)="QAOS RPT TXSP CARE TYPE^Display Treating Specialty Care Types^^R^.5^^^^^^^"
^DIC(19,7445,1,0)="^^5^5^2930421^"
^DIC(19,7445,1,1,0)="This option produces a report showing all the treating specialties in use"
^DIC(19,7445,1,2,0)="at your facility and their associated care type (acute, special,"
^DIC(19,7445,1,3,0)="intermediate, NHCU, psych.).  If a specialty is not associated with a care"
^DIC(19,7445,1,4,0)="type it will be flagged as ""NOT SPECIFIED"".  The report may be sorted by"
^DIC(19,7445,1,5,0)="care type or specialty."
^DIC(19,7445,25)="QAOSPTX0"
^DIC(19,7445,99)="55628,55292"
^DIC(19,7445,"U")="DISPLAY TREATING SPECIALTY CAR"
