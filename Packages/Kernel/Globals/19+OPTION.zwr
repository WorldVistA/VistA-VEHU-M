^DIC(19,7961,1,0)="^^3^3^2950418^^"
^DIC(19,7961,1,1,0)="This option will compile the strength report statistics, store them"
^DIC(19,7961,1,2,0)="in the PAID COST CENTER/ORGANIZATION file and allow the user to print"
^DIC(19,7961,1,3,0)="the strength report."
