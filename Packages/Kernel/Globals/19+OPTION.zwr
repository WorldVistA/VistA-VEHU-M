^DIC(19,15454,0)="EHM-00275^ePCS Site Enable/Disable^^R^1^^^^^^^170^^^^"
^DIC(19,15454,1,0)="^19.06^3^3^3240328^^"
^DIC(19,15454,1,1,0)="Allows users to enable or disable CPRS' ePCS functionality at the site "
^DIC(19,15454,1,2,0)="level."
^DIC(19,15454,1,3,0)="Cloned from ""OR EPCS SITE PARAMETER"" option."
^DIC(19,15454,3)=""
^DIC(19,15454,20)=""
^DIC(19,15454,25)="SITE^ORDEA01"
^DIC(19,15454,"U")="EPCS SITE ENABLE/DISABLE"
^DIC(19,15455,0)="EHM-00276^ePCS User Enable/Disable^^R^1^^^^^^^170^^^^"
^DIC(19,15455,1,0)="^19.06^3^3^3240328^^^"
^DIC(19,15455,1,1,0)="Allows users to enable or disable CPRS' ePCS functionality at the user "
^DIC(19,15455,1,2,0)="level."
^DIC(19,15455,1,3,0)="Cloned from ""OR EPCS USERS PARAMETER"" option."
^DIC(19,15455,3)=""
^DIC(19,15455,20)=""
^DIC(19,15455,25)="USER^ORDEA01"
^DIC(19,15455,"U")="EPCS USER ENABLE/DISABLE"
^DIC(19,15456,0)="EHM-00277^Check Provider ePCS Configuration^^R^1^^^^^^^170^^^^"
^DIC(19,15456,1,0)="^19.06^4^4^3240328^^"
^DIC(19,15456,1,1,0)="This option will prompt the user to select a person from the NEW PERSON "
^DIC(19,15456,1,2,0)="FILE (#200) and will detail whether that user can or cannot sign "
^DIC(19,15456,1,3,0)="controlled substance orders."
^DIC(19,15456,1,4,0)="Cloned from ""OR EPCS PROVIDER CONFIG CHECK"" option."
^DIC(19,15456,3)=""
^DIC(19,15456,25)="PRVCHK^ORDEA01"
^DIC(19,15456,"U")="CHECK PROVIDER EPCS CONFIGURAT"
^DIC(19,15457,0)="EHM-00278^ePCS Data Validation Reports^^R^1^^^^^^^170^^^^"
^DIC(19,15457,1,0)="^^3^3^3240328^"
^DIC(19,15457,1,1,0)="Allows the user to run a number of reports that will be used to validate "
^DIC(19,15457,1,2,0)="data necessary to ensure proper setup of the ePCS functionality."
^DIC(19,15457,1,3,0)="Cloned from ""OR EPCS VALIDATION REPORTS"" option."
^DIC(19,15457,3)=""
^DIC(19,15457,25)="REPORTS^ORDEA01"
^DIC(19,15457,"U")="EPCS DATA VALIDATION REPORTS"
^DIC(19,15458,0)="EHM-00279^GUI Consults DST/CTB Configuration^^M^1^^^^^^^170^^^^"
^DIC(19,15458,1,0)="^19.06^6^6^3240328^^^"
^DIC(19,15458,1,1,0)="This main menu contains the options for configuring the Decision Support "
^DIC(19,15458,1,2,0)="Tool (DST) and Consult Toolbox (CTB) environment for CPRS GUI. The "
^DIC(19,15458,1,3,0)="options include things like setting which consult actions will display the"
^DIC(19,15458,1,4,0)="Open Consult Toolbox button and completely disabling the DST/CTB features "
^DIC(19,15458,1,5,0)="within CPRS GUI."
^DIC(19,15458,1,6,0)="Cloned from ""OR DST/CTB CPRS CONFIGURATION"" option."
^DIC(19,15458,3)=""
^DIC(19,15458,10,0)="^19.01IP^2^2"
^DIC(19,15458,10,1,0)="15459^ACT^15"
^DIC(19,15458,10,2,0)="15460^FSW^5"
^DIC(19,15458,10,"B",15459,1)=""
^DIC(19,15458,10,"B",15460,2)=""
^DIC(19,15458,10,"C","ACT",1)=""
^DIC(19,15458,10,"C","FSW",2)=""
^DIC(19,15458,99)="67411,49174"
^DIC(19,15458,"U")="GUI CONSULTS DST/CTB CONFIGURA"
^DIC(19,15459,0)="EHM-00280^Enable Toolbox on Consult Actions^^A^1^^^^^^^170^^1^^"
^DIC(19,15459,1,0)="^^9^9^3240328^"
^DIC(19,15459,1,1,0)="This option allows you to enable or disable the Launch DST/Open Consult "
^DIC(19,15459,1,2,0)="Toolbox button on the individual consult action dialogs of CPRS GUI. The"
^DIC(19,15459,1,3,0)="option invokes a parameter template which is used to guide you through"
^DIC(19,15459,1,4,0)="setting the on/off parameter for each consult action."
^DIC(19,15459,1,5,0)=" "
^DIC(19,15459,1,6,0)="The parameter values set by this option may be overridden by the ORQQCN "
^DIC(19,15459,1,7,0)="DST/CTB FEATURE SWITCH parameter. If the feature switch parameter is set "
^DIC(19,15459,1,8,0)="to OFF, then no button will be displayed on the consult action dialogs."
^DIC(19,15459,1,9,0)="Cloned from ""OR ENABLE CTB CONS ACT DLGS"" option."
^DIC(19,15459,3)=""
^DIC(19,15459,20)="D TED^XPAREDIT(""ORQQCN CTB ACTION ENABLE"",""B"")"
^DIC(19,15459,"U")="ENABLE TOOLBOX ON CONSULT ACTI"
^DIC(19,15460,0)="EHM-00281^DST/CTB Feature Switch^^A^1^^^^^^^170^^1^^"
^DIC(19,15460,1,0)="^^11^11^3240328^"
^DIC(19,15460,1,1,0)="This option allows you to control the state of the built-in Decision"
^DIC(19,15460,1,2,0)="Support Tool or Consult Toolbox features of CPRS GUI."
^DIC(19,15460,1,3,0)=" "
^DIC(19,15460,1,4,0)="There are three possible values: OFF, DST, and CTB."
^DIC(19,15460,1,5,0)=" "
^DIC(19,15460,1,6,0)="OFF: All integrated DST/CTB features are disabled."
^DIC(19,15460,1,7,0)=" "
^DIC(19,15460,1,8,0)="DST: Only Decision Support Tool features are available."
^DIC(19,15460,1,9,0)=" "
^DIC(19,15460,1,10,0)="CTB: Only Consult Toolbox features are available."
^DIC(19,15460,1,11,0)="Cloned from ""OR DST/CTB FEATURE SWITCH"" option."
^DIC(19,15460,3)=""
^DIC(19,15460,20)="D EDITPAR^XPAREDIT(""ORQQCN DST/CTB FEATURE SWITCH"")"
^DIC(19,15460,"U")="DST/CTB FEATURE SWITCH"
^DIC(19,15461,0)="EHM-00282^GUI Add/Edit Local Message for OTH Button^^R^1^^^10^^^^^^^^"
^DIC(19,15461,1,0)="^19.06^8^8^3240328^^^"
^DIC(19,15461,1,1,0)=" The OTH button in CPRS currently displays the message ""Call"
^DIC(19,15461,1,2,0)=" Registration Team for Details"" as a default.  If the Clinical Application"
^DIC(19,15461,1,3,0)=" Coordinator wishes to create additional information to the current default,"
^DIC(19,15461,1,4,0)=" this option can be used.  Please note, use of this menu option is entirely"
^DIC(19,15461,1,5,0)=" optional.  If the CAC does not enter any additional information using this"
^DIC(19,15461,1,6,0)=" option, the site will still see ""Call Registration Team for Details"" in the "
^DIC(19,15461,1,7,0)=" OTH button in CPRS."
^DIC(19,15461,1,8,0)="Cloned from ""OR OTH BTN MSG ADD/EDIT"" option."
^DIC(19,15461,3)=""
^DIC(19,15461,10.1)="OTH Add/Edit Local Message"
^DIC(19,15461,25)="LOCMSG^OROTHBTN"
^DIC(19,15461,"U")="GUI ADD/EDIT LOCAL MESSAGE FOR"
^DIC(19,15462,0)="EHM-00283^GUI Order Flagging/Unflagging Setup^^M^1^^^^^^^^^^^"
^DIC(19,15462,1,0)="^19.06^3^3^3240328^^"
^DIC(19,15462,1,1,0)="This menu contains the options needed to manage the Flagging/Unflagging"
^DIC(19,15462,1,2,0)="functionalities in CPRS."
^DIC(19,15462,1,3,0)="Cloned from ""OR FLAG/UNFLAG SETUP"" option."
^DIC(19,15462,3)=""
^DIC(19,15462,10,0)="^19.01IP^4^4"
^DIC(19,15462,10,1,0)="15463^KEY^2"
^DIC(19,15462,10,2,0)="15464^REST^1"
^DIC(19,15462,10,3,0)="15465^MESS^3"
^DIC(19,15462,10,4,0)="15466^EXP^4"
^DIC(19,15462,10,"B",15463,1)=""
^DIC(19,15462,10,"B",15464,2)=""
^DIC(19,15462,10,"B",15465,3)=""
^DIC(19,15462,10,"B",15466,4)=""
^DIC(19,15462,10,"C","EXP",4)=""
^DIC(19,15462,10,"C","KEY",1)=""
^DIC(19,15462,10,"C","MESS",3)=""
^DIC(19,15462,10,"C","REST",2)=""
^DIC(19,15462,99)="67411,49174"
^DIC(19,15462,"U")="GUI ORDER FLAGGING/UNFLAGGING "
^DIC(19,15463,0)="EHM-00284^Order Unflagging Key Setup^^A^1^^^^^^^170^^1^^"
^DIC(19,15463,1,0)="^^4^4^3240328^"
^DIC(19,15463,1,1,0)="This option provides the ability to perform the unflagging action by "
^DIC(19,15463,1,2,0)="'Display Groups'. Each display group can specify what key (example ORELSE,"
^DIC(19,15463,1,3,0)="OREMAS, etc.) can do the unflagging in CPRS."
^DIC(19,15463,1,4,0)="Cloned from ""OR UNFLAGGING KEY SETUP"" option."
^DIC(19,15463,3)=""
^DIC(19,15463,20)="S DIC=""^ORD(100.98,"",DIC(0)=""AEMQ"" D ^DIC K DIC Q:Y=-1  S DA=+Y,DR=""1:5"",DIE=""^ORD(100.98,"" D ^DIE"
^DIC(19,15463,"U")="ORDER UNFLAGGING KEY SETUP"
^DIC(19,15464,0)="EHM-00285^Order Unflagging Restrictions^^A^1^^^^^^^^^1^^"
^DIC(19,15464,1,0)="^19.06^6^6^3240328^^"
^DIC(19,15464,1,1,0)="This option can be used to setup the OR UNFLAGGING RESTRICTIONS parameter."
^DIC(19,15464,1,2,0)="This parameter is for the CPRS GUI application to enable/disable "
^DIC(19,15464,1,3,0)="unflagging restrictions on flagged orders. It's marked enabled"
^DIC(19,15464,1,4,0)="at the Package level. The sites can disable it at System level or at"
^DIC(19,15464,1,5,0)="Division level."
^DIC(19,15464,1,6,0)="Cloned from ""OR UNFLAGGING RESTRICTIONS"" option."
^DIC(19,15464,3)=""
^DIC(19,15464,10.1)="OR Unflagging Restrictions"
^DIC(19,15464,20)="D EDITPAR^XPAREDIT(""OR UNFLAGGING RESTRICTIONS"")"
^DIC(19,15464,25)=""
^DIC(19,15464,"U")="ORDER UNFLAGGING RESTRICTIONS"
^DIC(19,15465,0)="EHM-00286^Order Unflagging Message^^A^1^^^^^^^^^1^^"
^DIC(19,15465,1,0)="^19.06^7^7^3240328^^"
^DIC(19,15465,1,1,0)="This option can be used to setup the OR UNFLAGGING MESSAGE parameter.  "
^DIC(19,15465,1,2,0)="This parameter is for the CPRS GUI application to setup a customized"
^DIC(19,15465,1,3,0)="message to display to users who do not have the proper security key to"
^DIC(19,15465,1,4,0)="unflag an order. At the Package level, it's set to ""You are not allowed to"
^DIC(19,15465,1,5,0)="un-flag this order based on your security keys and the order type."""
^DIC(19,15465,1,6,0)="Sites can customize this message at System level or at Division level."
^DIC(19,15465,1,7,0)="Cloned from ""OR UNFLAGGING MESSAGE"" option."
^DIC(19,15465,3)=""
^DIC(19,15465,20)="D EDITPAR^XPAREDIT(""OR UNFLAGGING MESSAGE"")"
^DIC(19,15465,"U")="ORDER UNFLAGGING MESSAGE"
^DIC(19,15466,0)="EHM-00287^Order Flag Expire Default^^A^1^^^^^^^^^1^^"
^DIC(19,15466,1,0)="^^7^7^3240328^"
^DIC(19,15466,1,1,0)="This option will allow sites to setup a default duration to the 'No Action"
^DIC(19,15466,1,2,0)="Alert' field displayed as part of the Flag Order screen in CPRS. If this"
^DIC(19,15466,1,3,0)="is not set, CPRS will use 24 hours as the default. "
^DIC(19,15466,1,4,0)="When flagging an order in CPRS, if 'Create a No Action Alert' field is "
^DIC(19,15466,1,5,0)="checked then, an 'Order flag expired' notification is generated and sent "
^DIC(19,15466,1,6,0)="to the user who flagged the order."
^DIC(19,15466,1,7,0)="Cloned from ""OR FLAG ORDER EXPIRE DEFAULT"" option."
^DIC(19,15466,3)=""
^DIC(19,15466,20)="D EDITPAR^XPAREDIT(""OR FLAG ORDER EXPIRE DEFAULT"")"
^DIC(19,15466,"U")="ORDER FLAG EXPIRE DEFAULT"
^DIC(19,15467,0)="EHM-00288^Enter/Edit Missing ZIP Code Message Parameter^^R^1^^^^^^^^^^^"
^DIC(19,15467,1,0)="^^4^4^3240328^"
^DIC(19,15467,1,1,0)="This option will allow sites to set up the parameter message"
^DIC(19,15467,1,2,0)="for controlled substance orders when the patient is missing"
^DIC(19,15467,1,3,0)="a ZIP code."
^DIC(19,15467,1,4,0)="Cloned from ""OR ZIP CODE MESSAGE"" option."
^DIC(19,15467,3)=""
^DIC(19,15467,25)="ZIPM^ORWDPS11"
^DIC(19,15467,"U")="ENTER/EDIT MISSING ZIP CODE ME"
^DIC(19,15468,0)="EHM-00289^Edit DC Reasons^^R^1^^^^^^^170^^^^"
^DIC(19,15468,1,0)="^^3^3^3240328^"
^DIC(19,15468,1,1,0)="This option allows access to the Order Reason file to enter or edit"
^DIC(19,15468,1,2,0)="reasons for discontinuing an order."
^DIC(19,15468,1,3,0)="Cloned from ""ORCL ORDER REASON"" option."
^DIC(19,15468,3)=""
^DIC(19,15468,25)="EDITDCR^ORX1"
^DIC(19,15468,"U")="EDIT DC REASONS"
^DIC(19,15469,0)="EHM-00290^Set Unsigned Orders View on Exit^^A^1^^^^^^^^^1^^"
^DIC(19,15469,1,0)="^^5^5^3240328^"
^DIC(19,15469,1,1,0)="This option may be used to set the default view of unsigned orders that"
^DIC(19,15469,1,2,0)="ORES key holders will see when exiting a patient's chart; possible views"
^DIC(19,15469,1,3,0)="are only those orders entered during the current session, all of the"
^DIC(19,15469,1,4,0)="current user's unsigned orders, or all unsigned orders for the patient."
^DIC(19,15469,1,5,0)="Cloned from ""OR PARAM UNSIGNED ORDERS VIEW"" option."
^DIC(19,15469,3)=""
^DIC(19,15469,20)="D EDITPAR^XPAREDIT(""OR UNSIGNED ORDERS ON EXIT"")"
^DIC(19,15469,"U")="SET UNSIGNED ORDERS VIEW ON EX"
^DIC(19,15470,0)="EHM-00291^Unsigned orders search^^R^1^^^^^^^170^^^^"
^DIC(19,15470,1,0)="^^14^14^3240328^"
^DIC(19,15470,1,1,0)="This option will allow the user to search for either RELEASED but UNSIGNED"
^DIC(19,15470,1,2,0)="orders or just UNSIGNED orders and sort them by Service/section, Provider,"
^DIC(19,15470,1,3,0)="Patient, or Location."
^DIC(19,15470,1,4,0)=" "
^DIC(19,15470,1,5,0)="A start date entry will allow the site to ignore unsigned orders that fall"
^DIC(19,15470,1,6,0)="within their allowed grace period. For example: the site allows the"
^DIC(19,15470,1,7,0)="clinician 48 hours to sign unsigned orders, you would enter T-2 for a"
^DIC(19,15470,1,8,0)="start date."
^DIC(19,15470,1,9,0)=" "
^DIC(19,15470,1,10,0)="A stop date entry will allow the site to ignore orders older than the date"
^DIC(19,15470,1,11,0)="entered. An example of this would be, if you wanted to ignore unsigned"
^DIC(19,15470,1,12,0)="orders that were placed prior to CPRS and you installed CPRS on Jan 1,"
^DIC(19,15470,1,13,0)="1999, you would enter 010199."
^DIC(19,15470,1,14,0)="Cloned from ""OR UNSIGNED ORDERS"" option."
^DIC(19,15470,3)=""
^DIC(19,15470,25)="EN^ORS100"
^DIC(19,15470,"U")="UNSIGNED ORDERS SEARCH"
^DIC(19,15471,0)="EHM-00292^Search orders by Nature or Status^^R^1^^^^^^^^^^^"
^DIC(19,15471,1,0)="^^9^9^3240328^"
^DIC(19,15471,1,1,0)="This option will allow the user to search orders for a specific NATURE OF"
^DIC(19,15471,1,2,0)="ORDER or order STATUS. There are two formats available. one is a detailed"
^DIC(19,15471,1,3,0)="display that is printed in real time as the order number that meets the"
^DIC(19,15471,1,4,0)="search criteria is encountered. There is no further sort capability for"
^DIC(19,15471,1,5,0)="this format. The second format is the columnar format which will allow the"
^DIC(19,15471,1,6,0)="sort by ENTERING person or by SERVICE/SECTION. This format works best if"
^DIC(19,15471,1,7,0)="sending the output to a 132 column compressed printer or to the BROWSER"
^DIC(19,15471,1,8,0)="device."
^DIC(19,15471,1,9,0)="Cloned from ""OR NATURE/STATUS ORDER SEARCH"" option."
^DIC(19,15471,3)=""
^DIC(19,15471,25)="EN^ORSNAST"
^DIC(19,15471,99)="57865,60196"
^DIC(19,15471,"U")="SEARCH ORDERS BY NATURE OR STA"
^DIC(19,15472,0)="EHM-00293^Performance Monitor Report^^R^1^^^^^^^170^^^^"
^DIC(19,15472,1,0)="^^9^9^3240328^"
^DIC(19,15472,1,1,0)="This option produces a report showing the number of orders entered by"
^DIC(19,15472,1,2,0)="provider.  The report includes a detailed listing as well as a summary."
^DIC(19,15472,1,3,0)="The detail listing includes pertinent information about each order"
^DIC(19,15472,1,4,0)="associated with the listed provider.  The summary report shows the number"
^DIC(19,15472,1,5,0)="of orders entered for a provider, the number of orders entered by an ORES"
^DIC(19,15472,1,6,0)="key holder, the percentage of orders entered by an ORES key holder for the"
^DIC(19,15472,1,7,0)="given provider and a break down of the orders by nature of order for those"
^DIC(19,15472,1,8,0)="that were entered by a non-ORES key holder."
^DIC(19,15472,1,9,0)="Cloned from ""OR PERFORMANCE MONITOR"" option."
^DIC(19,15472,3)=""
^DIC(19,15472,25)="ORPRPM"
^DIC(19,15472,"U")="PERFORMANCE MONITOR REPORT"
^DIC(19,15473,0)="EHM-00294^Event Delayed Orders Menu^^M^1^^^^^^^^^^^"
^DIC(19,15473,1,0)="^^3^3^3240328^"
^DIC(19,15473,1,1,0)="This menu contains all the options for setting up and maintaining the "
^DIC(19,15473,1,2,0)="event delayed orders functionality."
^DIC(19,15473,1,3,0)="Cloned from ""OR DELAYED ORDERS"" option."
^DIC(19,15473,3)=""
^DIC(19,15473,10,0)="^19.01IP^3^3"
^DIC(19,15473,10,1,0)="15474^IN"
^DIC(19,15473,10,2,0)="15475^DO"
^DIC(19,15473,10,3,0)="15476^EP"
^DIC(19,15473,10,"B",15474,1)=""
^DIC(19,15473,10,"B",15475,2)=""
^DIC(19,15473,10,"B",15476,3)=""
^DIC(19,15473,10,"C","DO",2)=""
^DIC(19,15473,10,"C","EP",3)=""
^DIC(19,15473,10,"C","IN",1)=""
^DIC(19,15473,25)=""
^DIC(19,15473,99)="67411,49174"
^DIC(19,15473,"U")="EVENT DELAYED ORDERS MENU"
^DIC(19,15474,0)="EHM-00295^Inquire to OE/RR Patient Event File^^R^1^^^^^^^^^^^"
^DIC(19,15474,1,0)="^19.06^6^6^3240328^^"
^DIC(19,15474,1,1,0)="This option gives a fileman inquiry of an entry from the patient event "
^DIC(19,15474,1,2,0)="file.  This file holds information related to orders placed on delay.  "
^DIC(19,15474,1,3,0)="Included in this information are orders released and auto-dcd due to an "
^DIC(19,15474,1,4,0)="event occurring as well as an audit trail of MAS actions taken related to "
^DIC(19,15474,1,5,0)="this delayed event."
^DIC(19,15474,1,6,0)="Cloned from ""OR PATIENT EVENT INQUIRY"" option."
^DIC(19,15474,3)=""
^DIC(19,15474,20)=""
^DIC(19,15474,25)="OREV4"
^DIC(19,15474,"U")="INQUIRE TO OE/RR PATIENT EVENT"
^DIC(19,15475,0)="EHM-00296^Delayed Orders/Auto-DC Set-up^^R^1^^^^^^^^^^^"
^DIC(19,15475,1,0)="^19.06^8^8^3240328^^^^"
^DIC(19,15475,1,1,0)="This option invokes the auto-dc rules/release events editor.  Use this "
^DIC(19,15475,1,2,0)="option to define and maintain your auto-discontinue rules as well as your "
^DIC(19,15475,1,3,0)="delayed order release events."
^DIC(19,15475,1,4,0)=" "
^DIC(19,15475,1,5,0)="Whether or not orders auto-discontinue will depend on how you have your "
^DIC(19,15475,1,6,0)="rules defined.  In addition, orders that are being written for delayed "
^DIC(19,15475,1,7,0)="release can only be delayed to the release events that you've defined."
^DIC(19,15475,1,8,0)="Cloned from ""OR DELAYED ORDERS EDITOR"" option."
^DIC(19,15475,3)=""
^DIC(19,15475,25)="OREV"
^DIC(19,15475,"U")="DELAYED ORDERS/AUTO-DC SET-UP"
^DIC(19,15476,0)="EHM-00297^Parameters for event delayed orders^^R^1^^^^^^^^^^^"
^DIC(19,15476,1,0)="^^3^3^3240328^"
^DIC(19,15476,1,1,0)="This option will allow you to edit the parameters related to event "
^DIC(19,15476,1,2,0)="delayed orders."
^DIC(19,15476,1,3,0)="Cloned from ""OR EVENT PARAMETERS"" option."
^DIC(19,15476,3)=""
^DIC(19,15476,25)="PARAM^OREV3"
^DIC(19,15476,"U")="PARAMETERS FOR EVENT DELAYED O"
^DIC(19,15477,0)="EHM-00298^GUI Access - Tabs, RPL^^E^1^^^^^^^170^^^^"
^DIC(19,15477,1,0)="^^54^54^3240328^"
^DIC(19,15477,1,1,0)="This option provides input template access for editing CPRS GUI access "
^DIC(19,15477,1,2,0)="restrictions in the NEW PERSON file [^VA(200,] for cover sheet tabs and "
^DIC(19,15477,1,3,0)="user-specific restricted patient selection lists."
^DIC(19,15477,1,4,0)=" "
^DIC(19,15477,1,5,0)="Note that there is a logic path followed by the GUI application with "
^DIC(19,15477,1,6,0)="regard to the entries in all of these fields under discussion.  The "
^DIC(19,15477,1,7,0)="possible scenarios are:"
^DIC(19,15477,1,8,0)=" "
^DIC(19,15477,1,9,0)="Scenario A - The user is restricted to, and sees only, the REPORTS tab of "
^DIC(19,15477,1,10,0)="the CPRS GUI application.  In addition, the Tools/Options menu restricts "
^DIC(19,15477,1,11,0)="access to patient selection settings.  "
^DIC(19,15477,1,12,0)=" "
^DIC(19,15477,1,13,0)="Scenario B - The user sees all tabs and can select from all patients.  "
^DIC(19,15477,1,14,0)=" "
^DIC(19,15477,1,15,0)="Scenario C - The user has no access to the CPRS GUI.  "
^DIC(19,15477,1,16,0)=" "
^DIC(19,15477,1,17,0)="Scenario D - The user has access to the Reports Tab only, and all "
^DIC(19,15477,1,18,0)="patients."
^DIC(19,15477,1,19,0)=" "
^DIC(19,15477,1,20,0)="The following matrix should indicate what to expect:"
^DIC(19,15477,1,21,0)=" "
^DIC(19,15477,1,22,0)="    Restr. Pt. List     OE/RR Team           Tab(s)      Scenario"
^DIC(19,15477,1,23,0)="    = = = = = = = =     = = = = = =          = = = =     = = = = ="
^DIC(19,15477,1,24,0)="    (blank)             (none)               (none)      C"
^DIC(19,15477,1,25,0)="    (blank)             XYZ Team             (none)      C"
^DIC(19,15477,1,26,0)="    (blank)             XYZ Team             RPT         C"
^DIC(19,15477,1,27,0)="    Y                   (none/invalid)       RPT         C"
^DIC(19,15477,1,28,0)="    N                   XYZ Team             RPT         D"
^DIC(19,15477,1,29,0)="    Y                   XYZ Team             RPT         A"
^DIC(19,15477,1,30,0)="    N                   N/A                  COR         B"
^DIC(19,15477,1,31,0)="    N                   N/A                  COR, RPT    B"
^DIC(19,15477,1,32,0)="    Y                   N/A                  COR         B"
^DIC(19,15477,1,33,0)="    Y                   N/A                  COR, RPT    B"
^DIC(19,15477,1,34,0)="    (blank)             N/A                  COR         C"
^DIC(19,15477,1,35,0)="    (blank)             N/A                  COR, RPT    C"
^DIC(19,15477,1,36,0)=" "
^DIC(19,15477,1,37,0)="It will be seen that the ""COR"" tab overrules other tab settings, allows "
^DIC(19,15477,1,38,0)="access to all tabs, and also allows access to all patients - except when "
^DIC(19,15477,1,39,0)="the ""RESTRICTED PATIENT SELECTION"" entry is left blank.  "
^DIC(19,15477,1,40,0)=" "
^DIC(19,15477,1,41,0)="Note that more than one entry can be made for the same tab.  For example, "
^DIC(19,15477,1,42,0)="a ""RPT"" tab entry could be made for a user with valid dates equating to "
^DIC(19,15477,1,43,0)="the second week of the current month, then another ""RPT"" entry made with "
^DIC(19,15477,1,44,0)="dates allowing access for the first week of the next month.  To create a "
^DIC(19,15477,1,45,0)="duplicate entry of the same tab, the user must select ""No"" when prompted "
^DIC(19,15477,1,46,0)="for the new entry on a blank line.  Some users may not be familiar with "
^DIC(19,15477,1,47,0)="this standard Fileman behavior.  "
^DIC(19,15477,1,48,0)=" "
^DIC(19,15477,1,49,0)="The ruling logic for multiple entries of the same tab is:"
^DIC(19,15477,1,50,0)=" "
^DIC(19,15477,1,51,0)="    If any entry for a given tab allows access to the tab "
^DIC(19,15477,1,52,0)="    as of the date of login, then the tab is allowed, regardless  "
^DIC(19,15477,1,53,0)="    of any other entries which may exist for that tab.  "
^DIC(19,15477,1,54,0)="Cloned from ""ORCL CPRS ACCESS"" option."
^DIC(19,15477,3)=""
^DIC(19,15477,30)="VA(200,"
^DIC(19,15477,31)="AEMQ"
^DIC(19,15477,50)="VA(200,"
^DIC(19,15477,51)="[OR USER ACCESS OPTIONS]"
^DIC(19,15477,53)="BACK"
^DIC(19,15477,"U")="GUI ACCESS - TABS, RPL"
^DIC(19,15478,0)="EHM-00299^Lapsed Orders search^^R^1^^^^^^^170^^^^"
^DIC(19,15478,1,0)="^^11^11^3240328^"
^DIC(19,15478,1,1,0)="This option will allow the user to search for LAPSED orders and sort them "
^DIC(19,15478,1,2,0)="by Service/Section, Provider, Patient, or Location."
^DIC(19,15478,1,3,0)=" "
^DIC(19,15478,1,4,0)="A start date entry will allow the site to ignore lapsed orders that "
^DIC(19,15478,1,5,0)="fall within their allowed grace period. For example: the site allows the "
^DIC(19,15478,1,6,0)="clinician 48 hours to sign unsigned orders, you would enter T-2 for a "
^DIC(19,15478,1,7,0)="start date.  A stop date entry will allow the site to ignore orders older "
^DIC(19,15478,1,8,0)="than the date entered. An example of this would be, if you wanted to "
^DIC(19,15478,1,9,0)="ignore lapsed orders that were placed prior to CPRS and you installed "
^DIC(19,15478,1,10,0)="CPRS on Jan 1, 1999, you would enter 010199."
^DIC(19,15478,1,11,0)="Cloned from ""OR LAPSED ORDERS"" option."
^DIC(19,15478,3)=""
^DIC(19,15478,25)="EN^ORLPSR"
^DIC(19,15478,"U")="LAPSED ORDERS SEARCH"
^DIC(19,15479,0)="EHM-00300^Consults Clinically Indicated Date Default^^A^1^^^^^^^170^^1^^"
^DIC(19,15479,1,0)="^^5^5^3240328^"
^DIC(19,15479,1,1,0)="This option allows you to set the default value for the ORCDGMRC "
^DIC(19,15479,1,2,0)="CLIN IND DATE DEFAULT parameter at the DIVISION or SYSTEM level.  This "
^DIC(19,15479,1,3,0)="parameter is used to control the default value for the Clinically "
^DIC(19,15479,1,4,0)="Indicated Date used in consult orders."
^DIC(19,15479,1,5,0)="Cloned from ""ORW CLIN IND DATE DFLT"" option."
^DIC(19,15479,3)=""
^DIC(19,15479,20)="D EDITPAR^XPAREDIT(""ORCDGMRC CLIN IND DATE DEFAULT"")"
^DIC(19,15479,"U")="CONSULTS CLINICALLY INDICATED "
^DIC(19,15480,0)="EHM-00301^Controlled Substance Order Anomalies^^R^1^^^^^^^^^^^"
^DIC(19,15480,1,0)="^^12^12^3240328^"
^DIC(19,15480,1,1,0)="This report will find all orders for controlled substances for Schedule"
^DIC(19,15480,1,2,0)="2-5 medications that are missing a Digital Signature. All orders for these"
^DIC(19,15480,1,3,0)="controlled substances require a Digital Signature to comply with DEA"
^DIC(19,15480,1,4,0)="regulations. The purpose of this report is to determine the extent of this"
^DIC(19,15480,1,5,0)="problem in hopes to determine how these orders are placed into the system"
^DIC(19,15480,1,6,0)="without a Digital Signature.  "
^DIC(19,15480,1,7,0)="  "
^DIC(19,15480,1,8,0)="CPRS version 29 is when the ability to order Controlled Substances with"
^DIC(19,15480,1,9,0)="Digital Signatures began. This report looks up the date that CPRS v29 was"
^DIC(19,15480,1,10,0)="installed and presents that date as a default start date for the report. "
^DIC(19,15480,1,11,0)="Any date range can be entered to do the lookup."
^DIC(19,15480,1,12,0)="Cloned from ""OR CS ORDER ANOMALIES"" option."
^DIC(19,15480,3)=""
^DIC(19,15480,25)="EN^ORS100C"
^DIC(19,15480,"U")="CONTROLLED SUBSTANCE ORDER ANO"
^DIC(19,15481,0)="EHM-00302^Immunization/Skin Test Data Entry parameters^^M^1^^^^^^^^^^^"
