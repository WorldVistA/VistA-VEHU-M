^DIC(19,4589,1,0)="^^1^1^2900529^^"
^DIC(19,4589,1,1,0)="This option will list all bills related to an episode of care"
^DIC(19,4589,25)="IBOBL"
^DIC(19,4589,"U")="EPISODE OF CARE BILL LIST"
^DIC(19,4590,0)="IB LIST OF BILLING RATES^Billing Rates List^^R^.5^^^^^^^192"
^DIC(19,4590,1,0)="^^1^1^2920304^^^"
^DIC(19,4590,1,1,0)="This option will print a list of Billing Rates by Effective date."
