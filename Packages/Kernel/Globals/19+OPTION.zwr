^DIC(19,9924,0)="IBD MANUAL DATA ENTRY BY CLIN^Clinic based Data Entry^** This option is OUT OF ORDER **^R^10000000020^^^^^^^485"
^DIC(19,9924,1,0)="^^5^5^2970129^^"
^DIC(19,9924,1,1,0)="This option allows manual data entry of encounter data for the Ambulatory"
^DIC(19,9924,1,2,0)="Data Capture project.  The user selects a clinic, an appointment date, a"
^DIC(19,9924,1,3,0)="patient and can then do data entry for the encounter.  All forms for the"
^DIC(19,9924,1,4,0)="encounter will be asked.  If no forms were printed for the encounter the"
^DIC(19,9924,1,5,0)="user can select the form to for data entry without having to print the form."
^DIC(19,9924,25)="IBDFDE6"
^DIC(19,9924,"U")="CLINIC BASED DATA ENTRY"
^DIC(19,9925,0)="IBD MANUAL DATA ENTRY BY FORM^Data Entry by Form^** This option is OUT OF ORDER **^R^10000000020^^^^^^^485"
^DIC(19,9925,1,0)="^^3^3^2960507^"
^DIC(19,9925,1,1,0)="This option allows manual data entry of encounter data for the Ambulatory"
^DIC(19,9925,1,2,0)="Data Capture project.  This option allows a user to do data entry on a single"
^DIC(19,9925,1,3,0)="form at a time.  Input is based on the form design."
^DIC(19,9925,25)="IBDFDE"
^DIC(19,9925,"U")="DATA ENTRY BY FORM"
^DIC(19,9926,0)="IBD MANUAL DATA ENTRY GROUP^Group Clinic Data entry^** This option is OUT OF ORDER **^R^10000000020^^^^^^^485"
^DIC(19,9926,1,0)="^^7^7^2960507^"
^DIC(19,9926,1,1,0)="This option allows manual data entry of encounter data for the Ambulatory"
^DIC(19,9926,1,2,0)="Data Capture project.  The user selects a clinic and appointment date/time,"
^DIC(19,9926,1,3,0)="and may de-select specific patient, otherwise after completing data entry"
^DIC(19,9926,1,4,0)="for a single patient, the data will then be entered for all patients with"
^DIC(19,9926,1,5,0)="the same appointment date/time.  All forms for the"
^DIC(19,9926,1,6,0)="encounter will be asked.  If no forms were printed for the encounter the"
^DIC(19,9926,1,7,0)="user can select the form to for data entry without having to print the form."
^DIC(19,9926,25)="IBDFDE7"
^DIC(19,9926,"U")="GROUP CLINIC DATA ENTRY"
