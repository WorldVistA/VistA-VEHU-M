^DIC(19,13351,0)="MDCVT SETUP^Conversion Setup^^R^1^^^^^^^557^^^1"
^DIC(19,13351,1,0)="^19.06^5^5^3041109^^^^"
^DIC(19,13351,1,1,0)="This option will bring up a setup screen for the site"
^DIC(19,13351,1,2,0)="to setup the Medicine Report Conversion parameter setup."
^DIC(19,13351,1,3,0)="This parameter setup allows the site to control which Medicine"
^DIC(19,13351,1,4,0)="reports will be converted and which CP Definition and TIU title"
^DIC(19,13351,1,5,0)="to link to."
^DIC(19,13351,15)="K DDSFILE,DR,DA"
^DIC(19,13351,20)=""
^DIC(19,13351,25)="SETUP^MDCVT"
^DIC(19,13351,"U")="CONVERSION SETUP"
^DIC(19,13352,0)="MDCVT DISK SPACE^Disk Space Requirements^^R^1^^^^^^^557"
^DIC(19,13352,1,0)="^19.06^5^5^3060508^^^^"
^DIC(19,13352,1,1,0)="This option will generate a summary of the Medicine report"
^DIC(19,13352,1,2,0)="conversion.  This summary consists of a list of the files"
^DIC(19,13352,1,3,0)="converted to Clinical Procedures, the count of the records converted,"
^DIC(19,13352,1,4,0)="and the total lines and Bytes of the records that were converted"
^DIC(19,13352,1,5,0)="in each file."
^DIC(19,13352,25)="SUMMARY^MDCVT"
^DIC(19,13352,"U")="DISK SPACE REQUIREMENTS"
^DIC(19,13353,0)="MDCVT SUMMARY^Summary of Conversion Process^^P^1^^^^^^^557"
^DIC(19,13353,1,0)="^19.06^8^8^3050105^^^^"
^DIC(19,13353,1,1,0)="This option will generate a Medicine Report Conversion report.  This"
^DIC(19,13353,1,2,0)="report consists of a listing of all Medicine records that were processed"
^DIC(19,13353,1,3,0)="in the conversion in variable pointer format and the status of the"
^DIC(19,13353,1,4,0)="conversion whether the record was converted, skipped, or errored."
^DIC(19,13353,1,5,0)="If the record was converted, the total number of lines and bytes that"
^DIC(19,13353,1,6,0)="the record was converted to in a TIU document will be displayed."
^DIC(19,13353,1,7,0)="If the record errored, the reason why it errored will be displayed."
^DIC(19,13353,1,8,0)="If the record was skipped, the reason why it was skipped will be displayed."
^DIC(19,13353,60)="MDD(703.9,"
^DIC(19,13353,62)=0
^DIC(19,13353,63)="[MD CONVERSION SUMMARY]"
^DIC(19,13353,64)="[MD CONVERSION SUMMARY]"
^DIC(19,13353,65)=""
^DIC(19,13353,66)=""
^DIC(19,13353,"U")="SUMMARY OF CONVERSION PROCESS"
^DIC(19,13354,0)="MDCVT RUN^Run the Conversion Process^^R^1^^^^^^^557"
^DIC(19,13354,1,0)="^19.06^4^4^3060508^^^^"
^DIC(19,13354,1,1,0)="This option will start the Medicine Report conversion to Clinical"
^DIC(19,13354,1,2,0)="Procedures.  This option will only convert reports for procedures that "
^DIC(19,13354,1,3,0)="have the ""CONVERT Y/N"" field set to ""Yes"" under the MEDICINE FILE"
^DIC(19,13354,1,4,0)="PARAMETERS field in the CP CONVERSION file (#703.9)."
^DIC(19,13354,25)="EN^MDCVT"
^DIC(19,13354,"U")="RUN THE CONVERSION PROCESS"
^DIC(19,13355,0)="MDCVT LIST OF TIU TITLES^List of TIU Titles Needed^^R^1^^^^^^^557"
^DIC(19,13355,1,0)="^19.06^7^7^3060508^^^^"
^DIC(19,13355,1,1,0)="This option will allow the user to generate a list of Medicine procedures"
^DIC(19,13355,1,2,0)="and the TIU titles needed to be created for the procedures that will be"
^DIC(19,13355,1,3,0)="used for the Medicine report conversion.  The PRINT NAME of the procedures"
^DIC(19,13355,1,4,0)="in the PROCEDURE/SUBSPECIALTY file (#697.2) will be used in the display."
^DIC(19,13355,1,5,0)="This list will list the procedures and titles for a Medicine Package"
^DIC(19,13355,1,6,0)="Procedure if the ""Convert Y/N"" parameter is set to ""Yes"" and the ""Use"
^DIC(19,13355,1,7,0)="TIU Note Title"" parameter is blank in the Conversion Setup option."
^DIC(19,13355,25)="DISP^MDSTATU"
^DIC(19,13355,"U")="LIST OF TIU TITLES NEEDED"
^DIC(19,13356,0)="MDCVT TOTALS^Conversion Totals By Status^^R^1^^^^^^^557"
^DIC(19,13356,1,0)="^19.06^2^2^3040708^^^^"
^DIC(19,13356,1,1,0)="This option will verify that the Medicine reports conversion is complete"
^DIC(19,13356,1,2,0)="and are in appropriate statuses."
^DIC(19,13356,25)="TOTALS^MDCVT"
^DIC(19,13356,"U")="CONVERSION TOTALS BY STATUS"
^DIC(19,13357,0)="MDCVT ERROR LOG^Error Log^^P^1^^^^^^^557"
^DIC(19,13357,1,0)="^19.06^5^5^3041109^^"
^DIC(19,13357,1,1,0)="This option generates a log of all the errors that occurred with each"
^DIC(19,13357,1,2,0)="Medicine report during the conversion.  The listing consists of the"
^DIC(19,13357,1,3,0)="CONVERSION ID and ERROR MESSAGE.  The CONVERSION ID consists of"
^DIC(19,13357,1,4,0)="the record # concatenated with a "";"" and the global location"
^DIC(19,13357,1,5,0)="(e.g.,""345;MCAR(699,"")."
^DIC(19,13357,60)="MDD(703.9,"
^DIC(19,13357,62)=0
^DIC(19,13357,63)="[MD CONVERSION ERRORS]"
^DIC(19,13357,64)="[MD CONVERSION ERRORS]"
^DIC(19,13357,"U")="ERROR LOG"
^DIC(19,13358,0)="MDCVT CONVERSION LOCKOUT^Conversion Lockout^^R^1^^^^^^^557"
^DIC(19,13358,1,0)="^19.06^6^6^3060508^^^^"
^DIC(19,13358,1,1,0)="This option will let the user place a specialty/procedure or ALL"
^DIC(19,13358,1,2,0)="specialty/procedures Enter/Edit and Report options 'OUT OF SERVICE'"
^DIC(19,13358,1,3,0)="in the Medicine package.  It will also set Kernel site parameter"
^DIC(19,13358,1,4,0)="MD MEDICINE CONVERTED to ""YES"" when all specialties/procedures enter/edit"
^DIC(19,13358,1,5,0)="and report options are disabled or when the user indicated that all"
^DIC(19,13358,1,6,0)="Medicine reports have been converted."
^DIC(19,13358,25)="LOCKOUT^MDCVT"
^DIC(19,13358,"U")="CONVERSION LOCKOUT"
^DIC(19,13359,0)="MDCVT BUILD CONVERSION LIST^Build Conversion List^^A^1^^^^^^^557^^1^1"
^DIC(19,13359,1,0)="^19.06^11^11^3041109^^^^"
^DIC(19,13359,1,1,0)="The user will need to run this option before using the [MDCVT RUN],"
^DIC(19,13359,1,2,0)="Run the Conversion Process, option.  This option will let the user"
^DIC(19,13359,1,3,0)="build the conversion list of the Medicine file records for the CP"
^DIC(19,13359,1,4,0)="CONVERSION file (#703.9).  It will populate the CONVERSION LOG"
^DIC(19,13359,1,5,0)="sub-file (#703.92) with all entries in the ""AC"" cross reference in"
^DIC(19,13359,1,6,0)="the MEDICAL PATIENT file (#690) and set the STATUS field as"
^DIC(19,13359,1,7,0)="""Ready to Convert"" for each entry.  This option can be queued."
^DIC(19,13359,1,8,0)="Once the conversion list is built, this option can also be used"
^DIC(19,13359,1,9,0)="to add new additional entries in the Medicine file into the conversion"
^DIC(19,13359,1,10,0)="list.  This option will not overwrite the existing entries in the"
^DIC(19,13359,1,11,0)="CONVERSION LOG but add to the list."
^DIC(19,13359,15)="K MDS"
^DIC(19,13359,20)="S MDS=$$BLD^MDCVT1()"
^DIC(19,13359,25)=""
^DIC(19,13359,"U")="BUILD CONVERSION LIST"
