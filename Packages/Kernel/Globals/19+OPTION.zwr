^DIC(19,11536,1,0)="^^4^4^3000315^"
^DIC(19,11536,1,1,0)="This option will allow the Consult Service hierarchy to be printed. The"
^DIC(19,11536,1,2,0)="listing will include all disabled and tracking only services. Any services"
^DIC(19,11536,1,3,0)="in the REQUEST SERVICES (#123.5) file that are not part of the hierarchy"
^DIC(19,11536,1,4,0)="will be listed at the end. "
^DIC(19,11536,25)="LISTOPT^GMRCASV"
^DIC(19,11536,"U")="LIST CONSULT SERVICE HIERARCHY"
