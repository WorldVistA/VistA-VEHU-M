^DIC(19,16569,0)="EHM-01390^PCE Encounter Data Entry and Delete^^A^1^^^^^^^^^1^^"
^DIC(19,16569,1,0)="^^11^11^3240328^"
^DIC(19,16569,1,1,0)="This option is for users who can document a clinical encounter in the"
^DIC(19,16569,1,2,0)="V-files (visit related files), and can also delete any V-File encounter"
^DIC(19,16569,1,3,0)="entries, even though they are not the creator of the entries."
^DIC(19,16569,1,4,0)="The data entered via this option includes visit information"
^DIC(19,16569,1,5,0)="(where and when), and the following clinical data related to the visit:"
^DIC(19,16569,1,6,0)="providers of care, problems treated, procedures and treatments done,"
^DIC(19,16569,1,7,0)="and immunizations, skin tests, and patient education given."
^DIC(19,16569,1,8,0)=" "
^DIC(19,16569,1,9,0)="This option is intended for the Coordinator for PCE and/or supervisor of"
^DIC(19,16569,1,10,0)="the encounter data entry staff."
^DIC(19,16569,1,11,0)="Cloned from ""PXCE ENCOUNTER ENTRY & DELETE"" option."
^DIC(19,16569,3)=""
^DIC(19,16569,10.1)="PCE"
