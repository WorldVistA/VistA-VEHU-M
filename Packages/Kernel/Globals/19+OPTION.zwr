^DIC(19,12210,0)="IVMB SEED HEC WITH MPI^Seed HEC with MPI data^^A^10000000020^^^^^^^312^^1"
^DIC(19,12210,1,0)="^19.06^3^3^3020416^^^"
^DIC(19,12210,1,1,0)="This option will extract the MPI's ICN and CMOR from the Patient File (#2)"
^DIC(19,12210,1,2,0)="for seeding the HEC and transmit the extracted records to a processing"
^DIC(19,12210,1,3,0)="server at the HEC."
^DIC(19,12210,20)="D EN^DGEN408"
^DIC(19,12210,"U")="SEED HEC WITH MPI DATA"
^DIC(19,12211,0)="IVMB SEED HEC MAIL GROUP SETUP^Setup Mail Group for Seed HEC Notifications^^A^10000000020^^^^^^^^^1"
^DIC(19,12211,1,0)="^^5^5^3020416^"
^DIC(19,12211,1,1,0)="This option allows the authorized user to add members to the IVMB HEC MPI "
^DIC(19,12211,1,2,0)="NOTIFICATION mail group that receives messages on the status of sending "
^DIC(19,12211,1,3,0)="and receipt of Seed messages to the HEC.  This option should be run as a "
^DIC(19,12211,1,4,0)="Post Install to patch DGEN*5.3*408 and prior to executing the option IVMB "
^DIC(19,12211,1,5,0)="SEED HEC WITH MPI."
^DIC(19,12211,20)="D EN^DGEN408T"
^DIC(19,12211,25)=""
^DIC(19,12211,"U")="SETUP MAIL GROUP FOR SEED HEC "
^DIC(19,12212,0)="PSO ADDRESS CHANGE REPORT^Patient Address Changes Report^^R^10000000020^^^^^^^141"
^DIC(19,12212,1,0)="^^3^3^3021029^"
^DIC(19,12212,1,1,0)="This option prints a report that displays address changes made in the "
^DIC(19,12212,1,2,0)="PATIENT file (#2). It can either be run for one patient or for all "
^DIC(19,12212,1,3,0)="patients over the specified date range."
