^DIC(19,16234,"U")="PATIENT RECORD FLAGS MAIN MENU"
^DIC(19,16235,0)="EHM-01056^Record Flag Assignment^^R^1^^^^^^^114^^^^"
^DIC(19,16235,1,0)="^19.06^11^11^3240328^^"
^DIC(19,16235,1,1,0)="This option provides a List Manager user interface for assigning Patient "
^DIC(19,16235,1,2,0)="Record Flags to patients.  Additionally, this option provides the "
^DIC(19,16235,1,3,0)="ability to review and manage Patient Record Flag assignments.  The "
^DIC(19,16235,1,4,0)="following actions are provided within the patient Record Flag Assignment"
^DIC(19,16235,1,5,0)="option."
^DIC(19,16235,1,6,0)=" - Assign a Patient Record Flag to a patient."
^DIC(19,16235,1,7,0)=" - Display the details of a patient's record flag assignments including"
^DIC(19,16235,1,8,0)="   the history of the assignment."
^DIC(19,16235,1,9,0)=" - Review/Edit a patient's record flag assignment."
^DIC(19,16235,1,10,0)=" - Change the site ownership of a patient's record flag assignment."
^DIC(19,16235,1,11,0)="Cloned from ""DGPF RECORD FLAG ASSIGNMENT"" option."
^DIC(19,16235,3)=""
^DIC(19,16235,20)=""
^DIC(19,16235,25)="EN^DGPFLMA"
^DIC(19,16235,"U")="RECORD FLAG ASSIGNMENT"
^DIC(19,16236,0)="EHM-01057^Record Flag Reports Menu^^M^1^^^^^^^114^^^^"
^DIC(19,16236,1,0)="^19.06^2^2^3240328^^"
^DIC(19,16236,1,1,0)="This menu contains patient record flag report functions."
^DIC(19,16236,1,2,0)="Cloned from ""DGPF RECORD FLAG REPORTS MENU"" option."
