^DIC(19,15261,0)="EHM-00082^Define FSC HCP Mail Group^^A^1^^^^^^^294^^1^^"
^DIC(19,15261,1,0)="^^13^13^3240328^"
^DIC(19,15261,1,1,0)="This option is used to edit the GMRC FSC HCP MAIL GROUP parameter. This "
^DIC(19,15261,1,2,0)="parameter stores an email address for the VA FSC HCP Support group"
^DIC(19,15261,1,3,0)="(Financial Services Center, Healthcare Claims Processing). This mail group"
^DIC(19,15261,1,4,0)="will receive mail messages regarding transmission-related errors in"
^DIC(19,15261,1,5,0)="sending consults to HCPS. These mail messages are the same as those sent "
^DIC(19,15261,1,6,0)="to the VistA mail group GMRC HCP HL7 MESSAGES."
^DIC(19,15261,1,7,0)=" "
^DIC(19,15261,1,8,0)="This option was created to provide facilities with the ability to update"
^DIC(19,15261,1,9,0)="the mail group without the need for a new Consult/Request Tracking (GMRC)"
^DIC(19,15261,1,10,0)="patch. Ordinarily, the mail group value should not be edited. If an edit "
^DIC(19,15261,1,11,0)="is required, facilities will be advised of the need via national-level "
^DIC(19,15261,1,12,0)="communication."
^DIC(19,15261,1,13,0)="Cloned from ""GMRC FSC HCP MAIL GROUP"" option."
^DIC(19,15261,3)=""
^DIC(19,15261,20)="D TEDH^XPAREDIT(""GMRC FSC HCP MAIL GROUP"")"
^DIC(19,15261,"U")="DEFINE FSC HCP MAIL GROUP"
^DIC(19,15262,0)="EHM-00083^GMRC CX TO DC PARAMETER EDIT^^R^1^^^1^^^y^294^^^^"
^DIC(19,15262,1,0)="^^7^7^3240328^"
^DIC(19,15262,1,1,0)="This option calls the routine that allows the editing of the CSLT "
^DIC(19,15262,1,2,0)="CANCELLED TO DISCONTINUE parameter which has three fields:"
^DIC(19,15262,1,3,0)=" "
^DIC(19,15262,1,4,0)="1. Is the overnight cancel to discontinue job active? Y or N"
^DIC(19,15262,1,5,0)="2. How many days back to start with? Example 31"
^DIC(19,15262,1,6,0)="3. How many days back to end with?   Example 365"
^DIC(19,15262,1,7,0)="Cloned from ""GMRC CX TO DC PARAMETER EDIT"" option."
^DIC(19,15262,3)=""
^DIC(19,15262,25)="UPDPARM^GMRCCXDC"
^DIC(19,15262,"U")="GMRC CX TO DC PARAMETER EDIT"
^DIC(19,15263,0)="EHM-00084^GUI Consults DST/CTB Configuration^^M^1^^^^^^^170^^^^"
^DIC(19,15263,1,0)="^19.06^6^6^3240328^^^"
^DIC(19,15263,1,1,0)="This main menu contains the options for configuring the Decision Support "
^DIC(19,15263,1,2,0)="Tool (DST) and Consult Toolbox (CTB) environment for CPRS GUI. The "
^DIC(19,15263,1,3,0)="options include things like setting which consult actions will display the"
^DIC(19,15263,1,4,0)="Open Consult Toolbox button and completely disabling the DST/CTB features "
^DIC(19,15263,1,5,0)="within CPRS GUI."
^DIC(19,15263,1,6,0)="Cloned from ""OR DST/CTB CPRS CONFIGURATION"" option."
^DIC(19,15263,3)=""
^DIC(19,15263,10,0)="^19.01IP^2^2"
^DIC(19,15263,10,1,0)="15264^ACT^15"
^DIC(19,15263,10,2,0)="15265^FSW^5"
^DIC(19,15263,10,"B",15264,1)=""
^DIC(19,15263,10,"B",15265,2)=""
^DIC(19,15263,10,"C","ACT",1)=""
^DIC(19,15263,10,"C","FSW",2)=""
^DIC(19,15263,99)="67411,49173"
^DIC(19,15263,"U")="GUI CONSULTS DST/CTB CONFIGURA"
^DIC(19,15264,0)="EHM-00085^Enable Toolbox on Consult Actions^^A^1^^^^^^^170^^1^^"
^DIC(19,15264,1,0)="^^9^9^3240328^"
^DIC(19,15264,1,1,0)="This option allows you to enable or disable the Launch DST/Open Consult "
^DIC(19,15264,1,2,0)="Toolbox button on the individual consult action dialogs of CPRS GUI. The"
^DIC(19,15264,1,3,0)="option invokes a parameter template which is used to guide you through"
^DIC(19,15264,1,4,0)="setting the on/off parameter for each consult action."
^DIC(19,15264,1,5,0)=" "
^DIC(19,15264,1,6,0)="The parameter values set by this option may be overridden by the ORQQCN "
^DIC(19,15264,1,7,0)="DST/CTB FEATURE SWITCH parameter. If the feature switch parameter is set "
^DIC(19,15264,1,8,0)="to OFF, then no button will be displayed on the consult action dialogs."
^DIC(19,15264,1,9,0)="Cloned from ""OR ENABLE CTB CONS ACT DLGS"" option."
^DIC(19,15264,3)=""
^DIC(19,15264,20)="D TED^XPAREDIT(""ORQQCN CTB ACTION ENABLE"",""B"")"
^DIC(19,15264,"U")="ENABLE TOOLBOX ON CONSULT ACTI"
^DIC(19,15265,0)="EHM-00086^DST/CTB Feature Switch^^A^1^^^^^^^170^^1^^"
^DIC(19,15265,1,0)="^^11^11^3240328^"
^DIC(19,15265,1,1,0)="This option allows you to control the state of the built-in Decision"
^DIC(19,15265,1,2,0)="Support Tool or Consult Toolbox features of CPRS GUI."
^DIC(19,15265,1,3,0)=" "
^DIC(19,15265,1,4,0)="There are three possible values: OFF, DST, and CTB."
^DIC(19,15265,1,5,0)=" "
^DIC(19,15265,1,6,0)="OFF: All integrated DST/CTB features are disabled."
^DIC(19,15265,1,7,0)=" "
^DIC(19,15265,1,8,0)="DST: Only Decision Support Tool features are available."
^DIC(19,15265,1,9,0)=" "
^DIC(19,15265,1,10,0)="CTB: Only Consult Toolbox features are available."
^DIC(19,15265,1,11,0)="Cloned from ""OR DST/CTB FEATURE SWITCH"" option."
^DIC(19,15265,3)=""
^DIC(19,15265,20)="D EDITPAR^XPAREDIT(""ORQQCN DST/CTB FEATURE SWITCH"")"
^DIC(19,15265,"U")="DST/CTB FEATURE SWITCH"
^DIC(19,15266,0)="EHM-00087^CPRS Configuration (Clin Coord)^^M^1^^^^^^^^^^^"
