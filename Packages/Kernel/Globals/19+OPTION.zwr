^DIC(19,11917,0)="AFJX PATID REPORT^Network Health Exchange Check Messages^^R^10000000020^^^^^^^454"
^DIC(19,11917,1,0)="^19.06^10^10^3011019^^^^"
^DIC(19,11917,1,1,0)="This option goes through all the messages in the Mailbox belonging to"
^DIC(19,11917,1,2,0)="NETWORK,HEALTH EXCHANGE, and checks to see if any contain ""bad data""."
^DIC(19,11917,1,3,0)="Among the things checked is patient age, in an attempt to ensure that"
^DIC(19,11917,1,4,0)="the message contains data from the correct requested patient."
^DIC(19,11917,1,5,0)=" "
^DIC(19,11917,1,6,0)="A report on the results is produced."
^DIC(19,11917,1,7,0)=" "
^DIC(19,11917,1,8,0)="Note that this option is only needed to check messages received at"
^DIC(19,11917,1,9,0)="your site before you installed patch AFJX*5.1*26.  Messages received"
^DIC(19,11917,1,10,0)="afterwards are checked as they are received."
^DIC(19,11917,20)=""
^DIC(19,11917,25)="AFJXVER"
^DIC(19,11917,"U")="NETWORK HEALTH EXCHANGE CHECK "
