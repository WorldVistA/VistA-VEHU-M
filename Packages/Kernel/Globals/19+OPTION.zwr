^DIC(19,6805,0)="PSA UNLINKED REPORT^Report of Unlinked DRUG/ITEM MASTER file Entries^^R^11595^^^^^^^287"
^DIC(19,6805,1,0)="^^5^5^2970923^"
^DIC(19,6805,1,1,0)="The Report of Unlinked DRUG/ITEM MASTER file Entries option scans the DRUG"
^DIC(19,6805,1,2,0)="file (#50) for entries that do not yet have an ITEM MASTER file (#441)"
^DIC(19,6805,1,3,0)="link. It lists the Federal Stock Number (FSN), National Drug Code (NDC),"
^DIC(19,6805,1,4,0)="and indicates whether or not the drug is linked to the NATIONAL DRUG file"
^DIC(19,6805,1,5,0)="(#50.6)."
^DIC(19,6805,25)="PSAUNM"
^DIC(19,6805,"U")="REPORT OF UNLINKED DRUG/ITEM M"
^DIC(19,6806,0)="PSA UNLINKED LOOP^Connect Unlinked DRUG/ITEM MASTER file Entries^^R^11595^^^^^^^287"
^DIC(19,6806,1,0)="^^4^4^2970923^"
^DIC(19,6806,1,1,0)="The Connect Unlinked DRUG/ITEM MASTER file Entries option loops through"
^DIC(19,6806,1,2,0)="the DRUG file (#50) for entries that do not yet have ITEM MASTER file"
^DIC(19,6806,1,3,0)="(#441) entries and uses the Single Drug Match [PSA SINGLE DRUG MATCH]"
^DIC(19,6806,1,4,0)="option to attempt a link."
^DIC(19,6806,25)="PSAUNL"
^DIC(19,6806,"U")="CONNECT UNLINKED DRUG/ITEM MAS"
^DIC(19,6807,0)="PSA GIP LINK REPORT^Report of Inventory Items' Link to DRUG file^^R^11595^^^^^^^287"
^DIC(19,6807,1,0)="^^3^3^2970923^"
^DIC(19,6807,1,1,0)="The Report of Inventory Items' Link to DRUG file option generates a"
^DIC(19,6807,1,2,0)="listing of all inventory items and whether or not they are linked to the"
^DIC(19,6807,1,3,0)="DRUG file (#50). If they are linked, the link is shown."
^DIC(19,6807,25)="PSAVIN"
^DIC(19,6807,"U")="REPORT OF INVENTORY ITEMS' LIN"
^DIC(19,6808,0)="PSA GIP REPORT^Loadable Inventory Items Report^^R^11595^^^^^^^287"
^DIC(19,6808,1,0)="^^3^3^2970923^"
^DIC(19,6808,1,1,0)="The Loadable Inventory Items Report option generates a report of inventory"
^DIC(19,6808,1,2,0)="items with DRUG file (#50) links that have yet to be added to a selected"
^DIC(19,6808,1,3,0)="pharmacy location."
^DIC(19,6808,25)="PSARIN"
^DIC(19,6808,"U")="LOADABLE INVENTORY ITEMS REPOR"
^DIC(19,6809,0)="PSA GIP POPULATE^Populate Pharmacy Location with Inventory Items^^R^11595^^^^^^^287"
^DIC(19,6809,1,0)="^^3^3^2970923^"
^DIC(19,6809,1,1,0)="The Populate Pharmacy Location with Inventory Items option loads each item"
^DIC(19,6809,1,2,0)="from the inventory point that has a DRUG file (#50) link into a selected"
^DIC(19,6809,1,3,0)="pharmacy location."
