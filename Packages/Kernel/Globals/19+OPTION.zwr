^DIC(19,2330,1,0)="^^3^3^2920630^^^^"
^DIC(19,2330,1,1,0)="  Allows any user to view any item in the Drug file (#50).  The user will be"
^DIC(19,2330,1,2,0)="shown the fields pertaining to the Unit Dose package.  This option is"
^DIC(19,2330,1,3,0)="a ""view"" option only, and affects no data."
^DIC(19,2330,25)="ENDL^PSGSICHK"
^DIC(19,2330,"U")="DISPENSE DRUG LOOK-UP"
