^DIC(19,10453,0)="HBHCRP18^Active Census with ICD Code/Text Report  (132)^^R^1^^^^^^^"
^DIC(19,10453,1,0)="^^5^5^3120302^"
^DIC(19,10453,1,1,0)="This option prints the HBPC Active Census with ICD Codes/Text Report."
^DIC(19,10453,1,2,0)="The user is prompted to enter the date range for inclusion on the"
^DIC(19,10453,1,3,0)="report.  The report is sorted by patient name, then by admission date,"
^DIC(19,10453,1,4,0)="and includes:  Patient Name, Last Four, Admission Date, ICD Code, and"
^DIC(19,10453,1,5,0)="ICD Text.  Report prints in 132 column format."
^DIC(19,10453,25)="HBHCRP18"
^DIC(19,10453,598000)=2
^DIC(19,10453,"U")="ACTIVE CENSUS WITH ICD CODE/TE"
^DIC(19,10454,0)="HBHCR15A^Print Transmit History Report  (80)^^R^10000000020^^^^^^^"
^DIC(19,10454,1,0)="^19.06^11^11^3030814^^^^"
^DIC(19,10454,1,1,0)="This option prints the HBPC Transmit History Report.  The user is prompted"
^DIC(19,10454,1,2,0)="for date from within last 12 transmit batches & also selects forms for"
^DIC(19,10454,1,3,0)="inclusion on the report.  The report includes:  form number, patient name,"
^DIC(19,10454,1,4,0)="last four, form date, plus Action on form 3 (admission), Provider Number &"
^DIC(19,10454,1,5,0)="Provider Name on visits (form 4), & Admission or Discharge on form 6"
^DIC(19,10454,1,6,0)="(corrections). "
^DIC(19,10454,1,7,0)=" "
^DIC(19,10454,1,8,0)="A Transmit History Report for the current transmission batch can be"
^DIC(19,10454,1,9,0)="generated automatically from the Transmit File to Austin option [HBHCXMT]"
^DIC(19,10454,1,10,0)="if a default printer is defined in System Parameters file (631.9).  If no"
^DIC(19,10454,1,11,0)="printer is defined, no report will be generated at transmit time. "
^DIC(19,10454,25)="HBHCR15A"
^DIC(19,10454,598000)=3
^DIC(19,10454,"U")="PRINT TRANSMIT HISTORY REPORT "
^DIC(19,10455,0)="HBHCRP16^Rejections from HBPC Program Report  (132)^^R^10000000020^^^^^^^"
^DIC(19,10455,1,0)="^^5^5^3050921^"
^DIC(19,10455,1,1,0)="This option prints the HBPC Rejections from Program Report.  (Admit/Reject"
^DIC(19,10455,1,2,0)="Action field = Reject)  The user is prompted to enter the date range for"
^DIC(19,10455,1,3,0)="inclusion on the report.  The report is sorted by patient name and"
^DIC(19,10455,1,4,0)="includes:  Patient Name, Last Four, Date, and Reject/Withdraw Reason.  "
^DIC(19,10455,1,5,0)="Report prints in 132 column format."
^DIC(19,10455,25)="HBHCRP16"
^DIC(19,10455,598000)=3
^DIC(19,10455,"U")="REJECTIONS FROM HBPC PROGRAM R"
^DIC(19,10456,0)="HBHCRP17^CPT Code Summary Report  (80)^^R^10000000020^^^^^^^328"
^DIC(19,10456,1,0)="^^4^4^2980707^^^"
^DIC(19,10456,1,1,0)="This option prints the HBPC CPT Code Summary Report.  The user is prompted"
^DIC(19,10456,1,2,0)="to enter the date range, and CPT Code(s) or range of codes for inclusion on"
^DIC(19,10456,1,3,0)="the report.  The report is sorted by CPT Code with totals for each CPT Code"
^DIC(19,10456,1,4,0)="plus a grand total.  Report prints in 80 column format. "
^DIC(19,10456,25)="HBHCRP17"
^DIC(19,10456,598000)=3
^DIC(19,10456,"U")="CPT CODE SUMMARY REPORT  (80)"
