^DIC(19,14404,"U")="HMP APPLICATION PROXY"
^DIC(19,14405,0)="HMP APPOINTMENTS^Return List of Tomorrow's Patients^^A^1^^^^^^^^^1"
^DIC(19,14405,1,0)="^19.06^3^3^3151124^^"
^DIC(19,14405,1,1,0)="This option is intended to be scheduled to run nightly, to notify the"
^DIC(19,14405,1,2,0)="Enterprise Health Management Platform (HMP) of patients that are "
^DIC(19,14405,1,3,0)="expected to be seen tomorrow."
^DIC(19,14405,20)="D APPT^HMPPATS"
^DIC(19,14405,200.9)="y"
^DIC(19,14405,"U")="RETURN LIST OF TOMORROW'S PATI"
^DIC(19,14406,0)="HMP PATIENT DATA MONITOR^HMP Patient Data Monitor^^A^1^^^^^^^^^1"
^DIC(19,14406,1,0)="^19.06^4^4^3160726^^^"
^DIC(19,14406,1,1,0)="This option manages the HMP Patient Data Monitor background job.  It first"
^DIC(19,14406,1,2,0)="checks to see if the job is running, and will prompt the user to start it"
^DIC(19,14406,1,3,0)="if it's stopped. It may also be used to stop the job, but the eHMP client"
^DIC(19,14406,1,4,0)="may not display up-to-date data until it is started again."
^DIC(19,14406,20)="D EN^HMPHTTP"
^DIC(19,14406,"U")="HMP PATIENT DATA MONITOR"
^DIC(19,14407,0)="HMP XU EVENTS^New Person Events for HMP^^A^1^^^^^^^^^1"
^DIC(19,14407,1,0)="^^1^1^3130116^"
^DIC(19,14407,1,1,0)="This protocol will track New Person updates for HMP."
^DIC(19,14407,20)="D XU^HMPEVNT(XUIEN,"""")"
^DIC(19,14407,"U")="NEW PERSON EVENTS FOR HMP"
^DIC(19,14408,0)="HMPM ADD HMP USER^Add Health Management Platform User^^A^1^^^^^^^^^1"
^DIC(19,14408,1,0)="^^4^4^3140326^"
^DIC(19,14408,1,1,0)="This option allows a user to be given access to use the Health Management"
^DIC(19,14408,1,2,0)="Platform.  The selected user will be given the HMP UI CONTEXT option."
^DIC(19,14408,1,3,0)="Additionally, their default patient list my be set up for automatic"
^DIC(19,14408,1,4,0)="synchronization with the Health Management Platform (HMP)."
^DIC(19,14408,20)="D OPTASGN^HMPCAC"
^DIC(19,14408,"U")="ADD HEALTH MANAGEMENT PLATFORM"
^DIC(19,14409,0)="HMPM EXTRACT MONITOR^Monitor HMP Server Synchronization^^A^1^^^^^^^^^1"
^DIC(19,14409,1,0)="^^2^2^3140402^"
^DIC(19,14409,1,1,0)="This option allow one to monitor the polls from an HMP server and any "
^DIC(19,14409,1,2,0)="currently executing HMP extracts."
^DIC(19,14409,20)="D EN^HMPDJFSM"
^DIC(19,14409,"U")="MONITOR HMP SERVER SYNCHRONIZA"
^DIC(19,14410,0)="HMPM EMERGENCY STOP^Emergency Stop HMP Freshness Updates^^A^1^^^^^^^^^1"
^DIC(19,14410,1,0)="^^5^5^3140403^"
^DIC(19,14410,1,1,0)="This option should be used with caution.  It will stop the freshness "
^DIC(19,14410,1,2,0)="events for the ENTERPRISE HEALTH MANAGEMENT PLATFORM (HMP) from being called.  Once the "
^DIC(19,14410,1,3,0)="freshness events are stopped, patient data must be re-synchronized with"
^DIC(19,14410,1,4,0)="the HMP to ensure completeness.  Only stop freshness updates if there is a"
^DIC(19,14410,1,5,0)="problem with system operation."
^DIC(19,14410,20)="D EMERSTOP^HMPDJFSM"
^DIC(19,14410,"U")="EMERGENCY STOP HMP FRESHNESS U"
