^DIC(19,6753,1,1,0)="This report lists all verified orders that have been edited or"
^DIC(19,6753,1,2,0)="cancelled within a specified date range.  Data listed includes pharmacy"
^DIC(19,6753,1,3,0)="dispensing # (Green Sheet #), date edited, drug, type of action (edited"
^DIC(19,6753,1,4,0)="or cancelled), original quantity, new quantity, and name of the pharmacist."
^DIC(19,6753,1,5,0)="The manufacturer, lot #, or expiration date fields will also be listed"
^DIC(19,6753,1,6,0)="if edited."
^DIC(19,6753,25)="PSDEVOR"
^DIC(19,6753,"U")="EDITED VERIFIED ORDERS REPORT"
