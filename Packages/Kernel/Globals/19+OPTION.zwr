^DIC(19,6420,1,1,0)="Used to transfer work orders entered via CRT by non-Engineering personnel"
^DIC(19,6420,1,2,0)="from a 'receiving area' (essentially a fictitious shop) to a working"
^DIC(19,6420,1,3,0)="shop."
