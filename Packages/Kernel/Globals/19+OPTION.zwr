^DIC(19,7780,0)="FBCH REIMBURSEMENT INVOICE^Reimbursement for Inpatient Hospital Invoice^^R^1^FBAA LEVEL 1 PMT^^^^^^"
^DIC(19,7780,1,0)="^^5^5^2921013^"
^DIC(19,7780,1,1,0)="This option is used to enter a patient reimbursement for an inpatient"
^DIC(19,7780,1,2,0)="hospital stay."
^DIC(19,7780,1,3,0)="The payment will be sent through the Austin Pricer just like a direct"
^DIC(19,7780,1,4,0)="vendor invoice and the patient is reimbursed the same as "
^DIC(19,7780,1,5,0)="the private facility."
