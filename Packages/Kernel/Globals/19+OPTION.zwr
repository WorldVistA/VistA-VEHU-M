^DIC(19,11441,20)="D TSTINTRO^GMRCT"
^DIC(19,11441,25)="TEST^GMRCT"
^DIC(19,11441,99)="57911,75462"
^DIC(19,11441,"U")="DETERMINE IF USER IS NOTIFICAT"
