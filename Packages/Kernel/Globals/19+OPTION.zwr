^DIC(19,14461,1,1,0)="This option allows the user to view and customize the American Society for"
^DIC(19,14461,1,2,0)="Automation in Pharmacy (ASAP) data definition format used to report outpatient"
^DIC(19,14461,1,3,0)="controlled substance prescription data to the states. It provides detailed"
^DIC(19,14461,1,4,0)="information about each segment and data element for each ASAP version."
^DIC(19,14461,20)="D ^PSOSPML3"
^DIC(19,14461,"U")="VIEW/EDIT ASAP DEFINITIONS"
