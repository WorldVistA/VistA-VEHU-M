^DIC(19,14185,1,0)="^^5^5^3061218^"
^DIC(19,14185,1,1,0)="Use this option to map, for a specific HL7 interface, SNOMED CT codes"
^DIC(19,14185,1,2,0)="required by an external system to VistA Laboratory files."
^DIC(19,14185,1,3,0)="Currently used to map VistA Laboratory files:"
^DIC(19,14185,1,4,0)=" TOPOGRAPHY (#61)"
^DIC(19,14185,1,5,0)=" COLLECTION SAMPLE (#62)"
^DIC(19,14185,30)="LAHM(62.48,"
