^DIC(19,610,0)="SDCHART^Chart Request^^R^.5^^^^^^^16^^^1"
^DIC(19,610,1,0)="^^8^8^2950224^^^^"
^DIC(19,610,1,1,0)="This option is used to request a patient's chart for review without"
^DIC(19,610,1,2,0)="actually scheduling the patient for an appointment.  It would be used,"
^DIC(19,610,1,3,0)="for instance, in a case where a physician has ordered lab tests for"
^DIC(19,610,1,4,0)="a particular patient and wishes to review those results say in one"
^DIC(19,610,1,5,0)="week but not see the patient for another two weeks.  No appointment"
^DIC(19,610,1,6,0)="is scheduled for the patient and no appointment letters are generated."
^DIC(19,610,1,7,0)="The patient will appear on the File Room list though but the appointment"
^DIC(19,610,1,8,0)="time will not be indicated since there is none."
^DIC(19,610,15)="K DIC,DIE,SDIN,SDRE,DA,DR,DO,D1,Y"
^DIC(19,610,25)="4^SDAPP"
^DIC(19,610,"U")="CHART REQUEST"
^DIC(19,611,0)="SDNOSHOW^No-Shows^^R^.5^^^^^^^16^^1^1"
^DIC(19,611,1,0)="^^2^2^2850415^^"
^DIC(19,611,1,1,0)="Allows user to record no-shows by Clinic and date.  Also allows"
^DIC(19,611,1,2,0)="printing of No-show letters for a given date."
^DIC(19,611,15)="D HDLKILL^SDAMEVT"
^DIC(19,611,20)="D HDLKILL^SDAMEVT"
^DIC(19,611,25)="SDN"
^DIC(19,611,"U")="NO-SHOWS"
