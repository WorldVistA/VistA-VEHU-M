^DIC(19,16482,10.1)="Device Interface Error Report"
^DIC(19,16482,25)="PXEDIM"
^DIC(19,16482,"U")="PCE DEVICE INTERFACE ERROR REP"
^DIC(19,16483,0)="EHM-01304^PCE Encounter Viewer^^A^1^^^^^^^507^^1^^"
^DIC(19,16483,1,0)="^^7^7^3240328^"
^DIC(19,16483,1,1,0)="This option is for users who can view a clinical encounter in the V-files"
^DIC(19,16483,1,2,0)="(visit-related files) with out being able to add, edit or delete any"
^DIC(19,16483,1,3,0)="information. The data viewable via this option includes visit information"
^DIC(19,16483,1,4,0)="(where and when), and the following clinical data related to the visit:"
^DIC(19,16483,1,5,0)="providers of care, problems treated, procedures and treatments done, and"
^DIC(19,16483,1,6,0)="immunizations, skin tests, and patient education given."
^DIC(19,16483,1,7,0)="Cloned from ""PXCE ENCOUNTER VIEWER"" option."
^DIC(19,16483,3)=""
^DIC(19,16483,10.1)="VIEW"
^DIC(19,16483,20)="D EN^PXCE(""V"")"
^DIC(19,16483,99.1)="56179,36316"
^DIC(19,16483,"U")="PCE ENCOUNTER VIEWER"
^DIC(19,16484,0)="EHM-01305^CIDC Missing Data Report^^R^1^^^^^^^507^^^^"
^DIC(19,16484,1,0)="^^3^3^3240328^"
^DIC(19,16484,1,1,0)="This produces a report of missing Clinical Indicator Data"
^DIC(19,16484,1,2,0)="Collection (CIDC) data"
^DIC(19,16484,1,3,0)="Cloned from ""PXRRMDR"" option."
^DIC(19,16484,3)=""
^DIC(19,16484,10.1)="CIDC Missing Data Report"
^DIC(19,16484,25)="EN^PXRRMDR"
^DIC(19,16484,"U")="CIDC MISSING DATA REPORT"
^DIC(19,16485,0)="EHM-01306^Accounting Of Immunization Disclosures Report^^R^1^^^^^^^^^^^"
^DIC(19,16485,1,0)="^^9^9^3240328^"
^DIC(19,16485,1,1,0)="This option is used for generating a list of immunization administration"
^DIC(19,16485,1,2,0)="records transmitted to external agencies. This option allows for a date"
^DIC(19,16485,1,3,0)="range selection as well as one, multiple or all agencies and one, multiple"
^DIC(19,16485,1,4,0)="or all patients. The list is sorted by disclosure date/time, agency, and"
^DIC(19,16485,1,5,0)="then by patient."
^DIC(19,16485,1,6,0)=" "
^DIC(19,16485,1,7,0)="Note: This report must be printed to a 132 column device in order to view "
^DIC(19,16485,1,8,0)="the entire data set."
^DIC(19,16485,1,9,0)="Cloned from ""PXV IMM DISCLOSURE REPORT"" option."
^DIC(19,16485,3)=""
^DIC(19,16485,25)="MAIN^PXVDIS"
^DIC(19,16485,"U")="ACCOUNTING OF IMMUNIZATION DIS"
^DIC(19,16486,0)="EHM-01307^Enter/edit quick orders^^R^1^^^^^^^^^^^"
^DIC(19,16486,1,0)="^^6^6^3240328^^"
^DIC(19,16486,1,1,0)="This option lets you create or change quick orders. The dialog for"
^DIC(19,16486,1,2,0)="creating a quick order is similar to a dialog for entering an"
^DIC(19,16486,1,3,0)="order. The responses you enter will become the pre-defined responses"
^DIC(19,16486,1,4,0)="for this quick order. End users will have the opportunity to edit"
^DIC(19,16486,1,5,0)="these pre-defined responses, if desired."
^DIC(19,16486,1,6,0)="Cloned from ""ORCM QUICK ORDERS"" option."
^DIC(19,16486,3)=""
^DIC(19,16486,25)="QUICK^ORCMEDT1"
^DIC(19,16486,"U")="ENTER/EDIT QUICK ORDERS"
