^DIC(19,13453,0)="HLO ERROR STATISTICS REPORT^HLO ERROR STATISTICS^^A^10000000020^^^^^^y^304^^1"
^DIC(19,13453,1,0)="^19.06^5^5^3070212^^^^"
^DIC(19,13453,1,1,0)="This option is a report that displays by period the counts of messgage errors"
^DIC(19,13453,1,2,0)="that occurred while sending and recieivng messages via HLO.  The counts are"
^DIC(19,13453,1,3,0)="sub-categorized by application and message type."
^DIC(19,13453,1,4,0)=""
^DIC(19,13453,1,5,0)=""
^DIC(19,13453,10.1)="HLO MESSAGE STATISTICS REPORT"
^DIC(19,13453,20)="D REPORT^HLOESTAT"
^DIC(19,13453,"U")="HLO ERROR STATISTICS"
^DIC(19,13454,0)="HLO DAILY STARTUP^HLO DAILY STARTUP^^A^1^^^^^^n^304^^1"
^DIC(19,13454,1,0)="^19.06^5^5^3070503^^^^"
^DIC(19,13454,1,1,0)="This option should be scheduled daily to insure that HLO stays up and running."
^DIC(19,13454,1,2,0)="It does NOT override the HLO ON/OFF SWITCH, i.e., if HLO was deliberately"
^DIC(19,13454,1,3,0)="shutdown this option will not start it.  It is meant to re-start HLO if"
^DIC(19,13454,1,4,0)="it unexpectely stops."
^DIC(19,13454,1,5,0)=""
^DIC(19,13454,20)="D:'$$CHKSTOP^HLOPROC STARTHL7^HLOPROC1"
^DIC(19,13454,200.9)="y"
^DIC(19,13454,"U")="HLO DAILY STARTUP"
