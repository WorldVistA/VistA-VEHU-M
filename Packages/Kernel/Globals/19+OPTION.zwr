^DIC(19,15805,3)=""
^DIC(19,15805,25)="POLYRX^ORKMGR"
^DIC(19,15805,"U")="SET NUMBER OF MEDICATIONS FOR "
^DIC(19,15806,0)="EHM-00627^Set Creatinine Date Range for Glucophage-Lab Rslts^^R^1^^^^^^^170^^^^"
^DIC(19,15806,1,0)="^^4^4^3240328^^"
^DIC(19,15806,1,1,0)="Use this option to set the number of hours back in time to search for the"
^DIC(19,15806,1,2,0)="most recent creatinine lab results.  This value is used in the the order"
^DIC(19,15806,1,3,0)="check Glucophage-Lab Results."
^DIC(19,15806,1,4,0)="Cloned from ""ORK GLUCOPHAGE CREATININE"" option."
^DIC(19,15806,3)=""
^DIC(19,15806,25)="GLUCREAT^ORKMGR"
^DIC(19,15806,"U")="SET CREATININE DATE RANGE FOR "
^DIC(19,15807,0)="EHM-00628^Set Order Checks to be Uneditable By Users^^R^1^^^^^^^170^^^^"
^DIC(19,15807,1,0)="^^21^21^3240328^"
^DIC(19,15807,1,1,0)="   This option enters values for the parameter ORK EDITABLE BY USER.  "
^DIC(19,15807,1,2,0)="IRM and Clinical Coordinators can use this option to set one or more order"
^DIC(19,15807,1,3,0)="checks to be uneditable by end users.  An order check with an Editable By"
^DIC(19,15807,1,4,0)="User value of ""No"" prevents end users from changing or setting that order"
^DIC(19,15807,1,5,0)="check's enabled/disabled parameter value. If the order check's"
^DIC(19,15807,1,6,0)="enabled/disabled value is ""enabled"", in combination with an Editable By"
^DIC(19,15807,1,7,0)="User value of ""No"", that order check is effectively ""mandatory"". (In the"
^DIC(19,15807,1,8,0)="GUI option to enable/disable order checks, the order check will appear"
^DIC(19,15807,1,9,0)="with a ""Mandatory"" flag.)"
^DIC(19,15807,1,10,0)="   Editable By User values only apply to end users.  An order check with"
^DIC(19,15807,1,11,0)="a ""No"" value does not prevent IRM and Clinical Coordinators from setting"
^DIC(19,15807,1,12,0)="or changing the order check's enabled/disabled values.  The order check"
^DIC(19,15807,1,13,0)="can still be edited by users (presumably IRM and Clinical Coordinators)"
^DIC(19,15807,1,14,0)="with access to the Order Checking Mgmt menu option ""Enable/Disable an"
^DIC(19,15807,1,15,0)="Order Check"".  An order check with no entry for this option/parameter will"
^DIC(19,15807,1,16,0)="be treated as ""editable by user"" (as if it had a ""Yes"" value.) In other"
^DIC(19,15807,1,17,0)="words, the default for this option/parameter is ""Yes""."
^DIC(19,15807,1,18,0)="   This option is used by the List Manager option ""Enable/Disable My Order"
^DIC(19,15807,1,19,0)="Checks"" [ORK REC PROCESSING FLAG].  In the GUI, these settings can be"
^DIC(19,15807,1,20,0)="accessed from the Tools|Options menu then selecting the Order Checks tab."
^DIC(19,15807,1,21,0)="Cloned from ""ORK EDITABLE BY USER"" option."
^DIC(19,15807,3)=""
^DIC(19,15807,25)="EDITUSER^ORKMGR"
^DIC(19,15807,"U")="SET ORDER CHECKS TO BE UNEDITA"
^DIC(19,15808,0)="EHM-00629^Set Creatinine Date Range for Contrst Media Orders^^R^1^^^^^^^170^^^^"
^DIC(19,15808,1,0)="^^5^5^3240328^"
^DIC(19,15808,1,1,0)="Use this option to set the number of days back in time for the patient's"
^DIC(19,15808,1,2,0)="most recent  lab serum creatinine results when Imaging procedures using"
^DIC(19,15808,1,3,0)="contrast media are ordered.  This value is used in the Biochem Abnormality"
^DIC(19,15808,1,4,0)="for Contrast Media order check."
^DIC(19,15808,1,5,0)="Cloned from ""ORK CONTRAST MEDIA CREATININE"" option."
^DIC(19,15808,3)=""
^DIC(19,15808,25)="CMCREAT^ORKMGR"
^DIC(19,15808,"U")="SET CREATININE DATE RANGE FOR "
^DIC(19,15809,0)="EHM-00630^Order Check Override Reason Report^^R^1^^^^^^^170^^^^"
^DIC(19,15809,1,0)="^^5^5^3240328^"
^DIC(19,15809,1,1,0)="Provides a reporting utility that enables facilities to review critical "
^DIC(19,15809,1,2,0)="order check override reasons. Allow for reports to be extracted, "
^DIC(19,15809,1,3,0)="filtered, and sorted by DATE/TIME ORDERED, DIVISION, DISPLAY GROUP, ORDER "
