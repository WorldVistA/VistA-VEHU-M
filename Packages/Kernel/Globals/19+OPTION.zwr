^DIC(19,563,"U")="INCONSISTENCY SUPERVISOR MENU"
^DIC(19,564,0)="PSJI LBLI^Individual Labels (IV)^^A^1^^^^^^^115^^1^1"
^DIC(19,564,1,0)="^^4^4^2920512^^^^"
^DIC(19,564,1,1,0)="  This option allows the printing of labels for a patient's order."
^DIC(19,564,1,2,0)="The user may choose whether or not the labels are to be counted as"
^DIC(19,564,1,3,0)="daily usage.  This is often used for on-call orders or those not auto-"
^DIC(19,564,1,4,0)="matically delivered without a written request."
^DIC(19,564,15)="D KILL^XUSCLEAN"
^DIC(19,564,20)="D ^PSIVXU Q:$D(XQUIT)!(DONE=1)  S PSIVAC=""PROL"",PSIVBR=""D ENLBLI^PSIVLBL1"" D ENCHS^PSIV,ENIVKV^PSGSETU K J,N,J2,P17,PS,PSIVAC,PSIVBR,PSIVCT,PSIVNOL,PSIVNOW,TN,ZQ7"
^DIC(19,564,25)=""
