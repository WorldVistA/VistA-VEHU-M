^DIC(19,16163,"U")="INQUIRE ABOUT A HEALTH SUMMARY"
^DIC(19,16164,0)="EHM-00985^Visit Patient Health Summary^^R^1^^^^^^^160^^1^1^"
^DIC(19,16164,1,0)="^^9^9^3240328^^"
^DIC(19,16164,1,1,0)="Generates Health Summaries of a specified pre-defined Health Summary Type"
^DIC(19,16164,1,2,0)="for multiple patients. After a patient is selected, the user can pick an"
^DIC(19,16164,1,3,0)="outpatient visit (based on the VISIT File) or an inpatient hospital"
^DIC(19,16164,1,4,0)="admission (based on the Patient Movement file). If the Patient Care"
^DIC(19,16164,1,5,0)="Encounter (PCE) package isn't installed then the user can only choose an"
^DIC(19,16164,1,6,0)="inpatient visit. Data for summaries is based on a date range from the"
^DIC(19,16164,1,7,0)="outpatient visit or inpatient admission. This Date Range overrides Time"
^DIC(19,16164,1,8,0)="Limits for components which allows this option."
^DIC(19,16164,1,9,0)="Cloned from ""GMTS HS BY PATIENT & VISIT"" option."
^DIC(19,16164,3)=""
^DIC(19,16164,15)="K GMTSPXGO"
^DIC(19,16164,20)="K ORVP S GMTSPXGO=1"
^DIC(19,16164,25)="GMTS"
^DIC(19,16164,"U")="VISIT PATIENT HEALTH SUMMARY"
^DIC(19,16165,0)="EHM-00986^Range of Dates Patient Health Summary^^R^1^^^^^^^160^^1^1^"
^DIC(19,16165,1,0)="^^6^6^3240328^^^^"
^DIC(19,16165,1,1,0)="Generates Health Summaries of a specified pre-defined Health"
^DIC(19,16165,1,2,0)="Summary Type for multiple patients. After patients are selected."
^DIC(19,16165,1,3,0)="the user can pick a date range. Data for summaries is based on"
^DIC(19,16165,1,4,0)="the date range. This date range overrides Time Limits for"
^DIC(19,16165,1,5,0)="components which allow this option."
^DIC(19,16165,1,6,0)="Cloned from ""GMTS HS BY PATIENT & DATE RANG"" option."
^DIC(19,16165,3)=""
^DIC(19,16165,15)="K GMRANGE"
^DIC(19,16165,20)="K ORVP S GMRANGE=1"
^DIC(19,16165,25)="GMTS"
^DIC(19,16165,"U")="RANGE OF DATES PATIENT HEALTH "
^DIC(19,16166,0)="EHM-00987^CPRS Reports Tab 'Health Summary Types List' Menu^^M^1^^^^^^^^^^^"
^DIC(19,16166,1,0)="^^5^5^3240328^"
^DIC(19,16166,1,1,0)="Use the options in the CPRS Reports Tab Health Summary Types List"
^DIC(19,16166,1,2,0)="Menu to select the Health Summary Types to list on the Reports Tab,"
^DIC(19,16166,1,3,0)="arrange the order of these Health Summaries on the list, and to "
^DIC(19,16166,1,4,0)="view the user s preferences."
^DIC(19,16166,1,5,0)="Cloned from ""GMTS GUI REPORTS LIST MENU"" option."
^DIC(19,16166,3)=""
^DIC(19,16166,10,0)="^19.01IP^4^4"
^DIC(19,16166,10,1,0)="16167^1^1"
^DIC(19,16166,10,2,0)="16168^2^2"
^DIC(19,16166,10,3,0)="16169^3^3"
^DIC(19,16166,10,4,0)="16170^4^4"
^DIC(19,16166,10,"B",16167,1)=""
^DIC(19,16166,10,"B",16168,2)=""
^DIC(19,16166,10,"B",16169,3)=""
^DIC(19,16166,10,"B",16170,4)=""
^DIC(19,16166,10,"C",1,1)=""
^DIC(19,16166,10,"C",2,2)=""
^DIC(19,16166,10,"C",3,3)=""
^DIC(19,16166,10,"C",4,4)=""
^DIC(19,16166,99)="67411,49176"
^DIC(19,16166,99.1)="59171,34704"
^DIC(19,16166,"U")="CPRS REPORTS TAB 'HEALTH SUMMA"
^DIC(19,16167,0)="EHM-00988^Display 'Health Summary Types List' Defaults^^R^1^^^^^^^^^^^"
^DIC(19,16167,1,0)="^19.06^6^6^3240328^^^^"
^DIC(19,16167,1,1,0)="Use this option to display the list of Health Summary Types that "
^DIC(19,16167,1,2,0)="will be contained in the 'Health Summary Types' section on the "
^DIC(19,16167,1,3,0)="Reports Tab in CPRS.  The display includes the precedence of "
^DIC(19,16167,1,4,0)="parameters, the method for building the list, and finally the list"
^DIC(19,16167,1,5,0)="that will actually appear on the Reports Tab in CPRS."
^DIC(19,16167,1,6,0)="Cloned from ""GMTS GUI HS LIST DEFAULTS"" option."
^DIC(19,16167,3)=""
^DIC(19,16167,25)="DISP^GMTSXA"
^DIC(19,16167,"U")="DISPLAY 'HEALTH SUMMARY TYPES "
^DIC(19,16168,0)="EHM-00989^Precedence of 'Health Summary Types List'^^R^1^^^^^^^^^^^"
^DIC(19,16168,1,0)="^^18^18^3240328^"
^DIC(19,16168,1,1,0)="Use this option to select the defined Health Summary Types to include"
^DIC(19,16168,1,2,0)="on the list and arrange them in the order (precedence) that they "
^DIC(19,16168,1,3,0)="should appear on the list.  The three most common groups of Health "
^DIC(19,16168,1,4,0)="Summary Types are:"
^DIC(19,16168,1,5,0)=""
^DIC(19,16168,1,6,0)=" SYS  Health Summary Types may be defined for all users on the system."
^DIC(19,16168,1,7,0)=""
^DIC(19,16168,1,8,0)=" USR  Health Summary Types may be defined for a single user on the"
^DIC(19,16168,1,9,0)="      system."
^DIC(19,16168,1,10,0)=""
^DIC(19,16168,1,11,0)=" NAT  Nationally exported Health Summary Types (NAT) defined for "
^DIC(19,16168,1,12,0)="      system users or a single user are treated independently to"
^DIC(19,16168,1,13,0)="      keep them together in the list box."
^DIC(19,16168,1,14,0)=""
^DIC(19,16168,1,15,0)="In this option, you must first select those Health Summary Type groups"
^DIC(19,16168,1,16,0)="(SYS, USR, NAT, etc.) to include on the Reports Tab, then specify the"
^DIC(19,16168,1,17,0)="order in which they will appear on the Reports Tab."
^DIC(19,16168,1,18,0)="Cloned from ""GMTS GUI HS LIST PRECEDENCE"" option."
^DIC(19,16168,3)=""
^DIC(19,16168,25)="PREC^GMTSXA"
^DIC(19,16168,"U")="PRECEDENCE OF 'HEALTH SUMMARY "
^DIC(19,16169,0)="EHM-00990^Method of compiling 'Health Summary Types List'^^R^1^^^^^^^^^^^"
^DIC(19,16169,1,0)="^19.06^14^14^3240328^^^"
^DIC(19,16169,1,1,0)="Use this option to edit the method used to build the list of Health"
^DIC(19,16169,1,2,0)="Summary Types displayed on the Reports Tab in CPRS.  There are 2 "
^DIC(19,16169,1,3,0)="methods:"
^DIC(19,16169,1,4,0)=""
^DIC(19,16169,1,5,0)="   Overwrite   System-defined Health Summary Types are added "
^DIC(19,16169,1,6,0)="               to the list.  If there are User-defined Health"
^DIC(19,16169,1,7,0)="               Summary Types, then they will replace the System"
^DIC(19,16169,1,8,0)="               defined Health Summary Types already on the list."
^DIC(19,16169,1,9,0)=""
^DIC(19,16169,1,10,0)="   Append      System-defined Health Summary Types are added to"
^DIC(19,16169,1,11,0)="               the list.  If there are User-defined Health Summary"
^DIC(19,16169,1,12,0)="               Types, then they will added to the list along with "
^DIC(19,16169,1,13,0)="               the System-defined types."
^DIC(19,16169,1,14,0)="Cloned from ""GMTS GUI HS LIST METHOD"" option."
^DIC(19,16169,3)=""
^DIC(19,16169,25)="METH^GMTSXA"
^DIC(19,16169,"U")="METHOD OF COMPILING 'HEALTH SU"
^DIC(19,16170,0)="EHM-00991^Edit 'Health Summary Types List' Parameters^^R^1^^^^^^^^^^^"
^DIC(19,16170,1,0)="^^5^5^3240328^"
^DIC(19,16170,1,1,0)="Use this option to add, edit or delete a Health Summary Type from"
^DIC(19,16170,1,2,0)="the list of Health Summary Types defined by the user.  If you are "
^DIC(19,16170,1,3,0)="a holder of the GMTSMGR Key, you can also use this option to edit"
^DIC(19,16170,1,4,0)="the Health Summary Types defined for the System."
^DIC(19,16170,1,5,0)="Cloned from ""GMTS GUI HS LIST PARAMETERS"" option."
^DIC(19,16170,3)=""
^DIC(19,16170,25)="EDIT^GMTSXA"
^DIC(19,16170,"U")="EDIT 'HEALTH SUMMARY TYPES LIS"
^DIC(19,16171,0)="EHM-00992^Health Summary Enhanced Menu^^M^1^^^^^^^160^^^^"
^DIC(19,16171,1,0)="^^6^6^3240328^"
^DIC(19,16171,1,1,0)="This option allows the user to print Health Summaries based on pre-"
^DIC(19,16171,1,2,0)="defined Health Summary Types as well as Ad Hoc Summaries.  The user may"
^DIC(19,16171,1,3,0)="also list existing Health Summary Types and Health Summary Components and"
^DIC(19,16171,1,4,0)="may inquire about the structure of a Health Summary Type. This option also"
^DIC(19,16171,1,5,0)="allows the user to create or delete his own Health Summary Types."
^DIC(19,16171,1,6,0)="Cloned from ""GMTS ENHANCED USER"" option."
^DIC(19,16171,3)=""
^DIC(19,16171,10,0)="^19.01IP^9^9"
^DIC(19,16171,10,1,0)="16172^1^1"
