^DIC(19,6372,1,1,0)=" "
^DIC(19,6372,1,2,0)="This option will display all the holders of a certain key."
^DIC(19,6372,25)="SHOW^XQ6"
^DIC(19,6372,"U")="LIST USERS HOLDING A CERTAIN K"
^DIC(19,6373,0)="XQLISTKEY^Show the keys of a particular user^^R^11748^^^^^^y^"
^DIC(19,6373,1,0)="^^1^1^2910620^"
^DIC(19,6373,1,1,0)="This option will list the keys held by a particular user."
^DIC(19,6373,25)="LIST^XQ6"
^DIC(19,6373,"U")="SHOW THE KEYS OF A PARTICULAR "
^DIC(19,6374,0)="XMHELP-ON-LINE-USER_MANUAL^Manual for MailMan Users^^A^11748^^^^^^^54^^1"
^DIC(19,6374,1,0)="^^1^1^2970730^^^^"
^DIC(19,6374,1,1,0)="Displays the MailMan on-line user manual."
^DIC(19,6374,3.91,0)="^19.391^^0"
^DIC(19,6374,20)="S XQHFY=""XMHELP-MANUAL"" D ACTION^XQH4"
^DIC(19,6374,"U")="MANUAL FOR MAILMAN USERS"
^DIC(19,6375,0)="XQKEYDEL^Delegate keys^^R^1039^^^^^^^"
^DIC(19,6375,1,0)="^^3^3^2910626^"
^DIC(19,6375,1,1,0)=" "
^DIC(19,6375,1,2,0)="This option will delegate keys to a user so that that user can then give them"
^DIC(19,6375,1,3,0)="out to other users, and even allow other users to delegate them in return."
^DIC(19,6375,25)="EN3^XQ6"
^DIC(19,6375,"U")="DELEGATE KEYS"
^DIC(19,6376,0)="XQKEYRDEL^Remove delegated keys^^R^1039^^^^^^^"
^DIC(19,6376,1,0)="^^2^2^2910626^"
^DIC(19,6376,1,1,0)=" "
^DIC(19,6376,1,2,0)="This option removes keys previously delegated to a user."
^DIC(19,6376,25)="EN4^XQ6"
^DIC(19,6376,99)="55552,47282"
^DIC(19,6376,"U")="REMOVE DELEGATED KEYS"
^DIC(19,6377,0)="XQKEYALTODEL^Change user's allocated keys to delegated keys^^R^1039^^^^^^^"
^DIC(19,6377,1,0)="^^3^3^2910627^"
^DIC(19,6377,1,1,0)=" "
^DIC(19,6377,1,2,0)="This option will prompt for a user and use %XY^%RCR to make all keys the user"
^DIC(19,6377,1,3,0)="holds delegated keys so that the user can give them to others."
^DIC(19,6377,25)="ATOD^XQ6"
^DIC(19,6377,"U")="CHANGE USER'S ALLOCATED KEYS T"
^DIC(19,6378,0)="XTVR MOST RECENT CHANGE DATE^Last Routine Change Date Recorded^^R^.5^^^^^^^163"
^DIC(19,6378,1,0)="^^10^10^2910801^^"
^DIC(19,6378,1,1,0)="This option will list the most recent date on which a change was"
^DIC(19,6378,1,2,0)="recorded for the selected routine(s).  The date piece of the first"
^DIC(19,6378,1,3,0)="line of the routine and version and patch information are also"
^DIC(19,6378,1,4,0)="displayed.  The version number may be changed and the routine"
^DIC(19,6378,1,5,0)="recorded after that date, but the last change date recorded will be"
^DIC(19,6378,1,6,0)="that date involving a change in more than the second (version number)"
^DIC(19,6378,1,7,0)="line."
^DIC(19,6378,1,8,0)=" "
^DIC(19,6378,1,9,0)="The Update Routine.. option must have been used one or more times to"
^DIC(19,6378,1,10,0)="record the routine and changes to the routine."
^DIC(19,6378,25)="XTVRC1A"
^DIC(19,6378,"U")="LAST ROUTINE CHANGE DATE RECOR"
^DIC(19,6379,0)="XQAB AUTO SEND^Send Alpha/Beta Usage to Developers^^R^1039^^^^^^^"
^DIC(19,6379,1,0)="^^5^5^2910802^"
^DIC(19,6379,1,1,0)="This option is set up to automatically send to the developing ISC's"
^DIC(19,6379,1,2,0)="information on the usage of options in those packages currently"
^DIC(19,6379,1,3,0)="in test status."
^DIC(19,6379,1,4,0)=" "
^DIC(19,6379,1,5,0)="If it is selected manually, it will send a similar message(s) as well."
^DIC(19,6379,25)="DOMAIL^XQABLIST"
^DIC(19,6379,"U")="SEND ALPHA/BETA USAGE TO DEVEL"
^DIC(19,6380,0)="XUSESIG BLOCK^Electronic Signature Block Edit^^R^11720^^^^^^^^y"
^DIC(19,6380,1,0)="^19.06^5^5^3170213^^"
^DIC(19,6380,1,1,0)="This option gives access to the Signature Block of the Electronic"
^DIC(19,6380,1,2,0)="Signature.  This is automatically set by a cross reference of the name"
^DIC(19,6380,1,3,0)="field. If it is changed with this option, it must contain the last name"
^DIC(19,6380,1,4,0)="from the name field. Also, if the name field is changed this field will be"
^DIC(19,6380,1,5,0)="changed also and may need to be re-edited."
^DIC(19,6380,25)="EN^XUSESIG2"
^DIC(19,6380,30)=""
^DIC(19,6380,31)=""
^DIC(19,6380,50)=""
^DIC(19,6380,51)=""
