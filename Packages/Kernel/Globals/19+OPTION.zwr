^DIC(19,14734,0)="GMRC CX TO DC PARAMETER EDIT^GMRC CX TO DC PARAMETER EDIT^^R^11720^^^1^^^y^294"
^DIC(19,14734,1,0)="^^6^6^3180818^"
^DIC(19,14734,1,1,0)="This option calls the routine that allows the editing of the CSLT "
^DIC(19,14734,1,2,0)="CANCELLED TO DISCONTINUE parameter which has three fields:"
^DIC(19,14734,1,3,0)=" "
^DIC(19,14734,1,4,0)="1. Is the overnight cancel to discontinue job active? Y or N"
^DIC(19,14734,1,5,0)="2. How many days back to start with? Example 31"
^DIC(19,14734,1,6,0)="3. How many days back to end with?   Example 365"
^DIC(19,14734,25)="UPDPARM^GMRCCXDC"
^DIC(19,14734,"U")="GMRC CX TO DC PARAMETER EDIT"
