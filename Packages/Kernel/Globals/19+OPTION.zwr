^DIC(19,3099,0)="PRCM COMPENSATION COST SUMMARY^Compensation Cost  Report^^P^.5^^^"
^DIC(19,3099,1,0)="^^17^17^2890206^^^^"
^DIC(19,3099,1,1,0)="Sorts PAID Personnel Compensation (Payroll Analysis Account 11--) by"
^DIC(19,3099,1,2,0)="employee, listing Base, Overtime, Night Duty, Holiday, Saturday,"
^DIC(19,3099,1,3,0)="Sunday, Standby, On-Call, Physicians & Dentists Special Pay, Award and"
^DIC(19,3099,1,4,0)="SES Bonus, Terminal Leave (Lump Sum) and Gross Pay.  The cost of Re-  "
^DIC(19,3099,1,5,0)="employed Annuitants refunded to the CSR Fund is not included in the"
^DIC(19,3099,1,6,0)="Gross Pay figure in PAID.  You may determine amounts paid CSR Fund"
^DIC(19,3099,1,7,0)="for Reemployed Annuitants by searching employee NAME, or a custom"
^DIC(19,3099,1,8,0)="Print request.  The costs are for the current pay period only, and are"
^DIC(19,3099,1,9,0)="sorted by control point (to separate by appropriation/analysis account),"
^DIC(19,3099,1,10,0)="cost center (103, 201, 544) and sub-account (last two digits only, ""90"""
^DIC(19,3099,1,11,0)="for 1090, ""60"" for 1060).  The report may be used for comparison and"
^DIC(19,3099,1,12,0)="analysis of overtime or holiday costs; projected awards and actual, and"
^DIC(19,3099,1,13,0)="budget formulation/execution variance.  The RAM Earned/Spent analysis"
^DIC(19,3099,1,14,0)="by cost center may be compared with current costs and desired outcomes."
^DIC(19,3099,1,15,0)="Users are encouraged to select the ""Range"" required for analysis or"
^DIC(19,3099,1,16,0)="review when possible to limit time required to search and print the "
^DIC(19,3099,1,17,0)="report from the PAID EXTRACT file."
^DIC(19,3099,60)="PRCM(401,"
^DIC(19,3099,62)=0
^DIC(19,3099,63)="[PRCM COMPENSATION COST & TOTAL]"
^DIC(19,3099,64)="[PRCM COMPENSATION COST & GROSS]"
^DIC(19,3099,"U")="COMPENSATION COST  REPORT"
^DIC(19,3100,0)="PRCM BENEFIT COST^Benefit Costs Report^^P^.5^^^"
^DIC(19,3100,1,0)="^^13^13^2890202^^^^"
^DIC(19,3100,1,1,0)="Lists the PAID Personnel Benefits (Payroll Analysis Accounts 12--)"
^DIC(19,3100,1,2,0)="by Control Point (to differentiate appropriation and analysis account)"
^DIC(19,3100,1,3,0)="Cost Center (103, 201, 540) and Sub-Account (""90"" for 1090, ""60"" for"
^DIC(19,3100,1,4,0)="1060, ""81"" for 1081) for each employee in the Control Point, Cost Center,"
^DIC(19,3100,1,5,0)="Sub-Account selected.  Reports the Sub-Total, Sub-Count and Sub-Mean for"
^DIC(19,3100,1,6,0)="the benefits by Sub-Account, and may be used to determine changes in aver-"
^DIC(19,3100,1,7,0)="age salaries, average salaries by sub-account and cost center.  The User "
^DIC(19,3100,1,8,0)="is asked ""range"" of report for Fund Control, Cost Center and Sub-Account."
^DIC(19,3100,1,9,0)="Failure to select a specific, or range of ""Sort By's"" may result in excess"
^DIC(19,3100,1,10,0)="search time due to the number of entries in the PAID EXTRACT file."
^DIC(19,3100,1,11,0)="Includes Uniform Allowance, Moving Expenses, Severance, VA Medicare Costs,"
^DIC(19,3100,1,12,0)="VA Life Insurance Costs, VA Health Benefit Costs, VA FICA Costs, and"
^DIC(19,3100,1,13,0)="VA Retirements Costs and TOTAL VA Cost per employee."
^DIC(19,3100,60)="PRCM(401,"
^DIC(19,3100,62)=0
^DIC(19,3100,63)="[PRCM BENEFIT COST & TOTAL ]"
^DIC(19,3100,64)="[PRCM BENEFIT COST & TOTAL ]"
^DIC(19,3100,"U")="BENEFIT COSTS REPORT"
^DIC(19,3101,0)="PRCM COST BY SUB-ACCOUNT^Cost by Sub-Account Report^^P^.5^^^"
^DIC(19,3101,1,0)="^^13^13^2890206^^^^"
^DIC(19,3101,1,1,0)="This report allows the User to select a salary control point (003,009,012)"
^DIC(19,3101,1,2,0)="and Sub-Account (""90"" = 1090, ""31"" = 1031, ""60"" = 1060), and lists the"
^DIC(19,3101,1,3,0)="costs by Employee for: Gross Pay; Gross Pay & Benefits, - variable costs"
^DIC(19,3101,1,4,0)="of Overtime, Holiday, Awards; FTE calculated for the Pay Period; projects"
^DIC(19,3101,1,5,0)="an Annual Cost for the Employee, excluding O/T, Hol., and Awards, using a "
^DIC(19,3101,1,6,0)="26 pay period, 2080 hour year; and Cost/FTEE excluding O/T, Hol. Awd. for"
^DIC(19,3101,1,7,0)="a 26 pay period, 2080 hour year.  Trainee sub-accounts 1041,42,43,44,50"
^DIC(19,3101,1,8,0)="51,52,63,73, and 83 will not calculate due to the PAID system reporting"
^DIC(19,3101,1,9,0)="""0"" normal hours for.  Normal hours 1071, 1076, 1081, 1086 and SES are"
^DIC(19,3101,1,10,0)="computed to provide this data.  The Report may be used for current and"
^DIC(19,3101,1,11,0)="projected sub-account and FTEE cost, Budget Formulation, FTEE program"
^DIC(19,3101,1,12,0)="costs, deficit analysis, variance analysis, accession/separation cost   "
^DIC(19,3101,1,13,0)="projections."
^DIC(19,3101,60)="PRCM(401,"
^DIC(19,3101,62)=0
^DIC(19,3101,63)="[PRCM COSTS BY SUB-ACCOUNT ]"
^DIC(19,3101,64)="[PRCM COSTS BY SUB-ACCOUNT]"
^DIC(19,3101,"U")="COST BY SUB-ACCOUNT REPORT"
^DIC(19,3102,0)="PRCM EMPLOYEE TIME & LEAVE^Employee Time & Leave Report^^P^.5^^^"
^DIC(19,3102,1,0)="^^8^8^2890206^^^^"
^DIC(19,3102,1,1,0)="User is asked to select salary control point, T&L Unit, and Sub-Account"
^DIC(19,3102,1,2,0)="to report each employees normal hours, unscheduled hours, non-pay hours,"
^DIC(19,3102,1,3,0)="overtime hours, comp time earned, comp time used, annual leave used, sick"
^DIC(19,3102,1,4,0)="leave used, military hours used, balance of military hours, LWOP charged,"
^DIC(19,3102,1,5,0)="current balance of LWOP for this step and an FTE calculation for the "
^DIC(19,3102,1,6,0)="hours reported (Normal Hours + Unscheduled Hours-LWOP/80).  May be used "
^DIC(19,3102,1,7,0)="for duty and leave analysis, workload/work measurement calculations,"
^DIC(19,3102,1,8,0)="leave abuse analysis, or productivity and available/duty hours by T&L unit."
^DIC(19,3102,60)="PRCM(401,"
^DIC(19,3102,62)=0
^DIC(19,3102,63)="[PRCM EMPLOYEE TIME & LEAVE]"
^DIC(19,3102,64)="[PRCM EMPLOYEE TIME & LEAVE]"
^DIC(19,3102,"U")="EMPLOYEE TIME & LEAVE REPORT"
^DIC(19,3103,0)="PRCM GROSS TO NET CP/CC^Cost Center Gross to Net Cost Report^^P^.5^^^"
^DIC(19,3103,1,0)="^^10^10^2890206^^^^"
^DIC(19,3103,1,1,0)="User is asked to select salary control point and cost center.  Prints out"
^DIC(19,3103,1,2,0)="by employee name; sub-account, T&L Unit, Gross Pay, Benefits, Total Cost,"
^DIC(19,3103,1,3,0)="FTE (Normal hours+unscheduled hours-non pay time-LWOP/80), duty hours "
^DIC(19,3103,1,4,0)="(normal hours+unscheduled hours+overtime+comp time earned), and non-duty"
^DIC(19,3103,1,5,0)="hours (non pay time+annual leave+sick leave+comp time used+LWOP+military"
^DIC(19,3103,1,6,0)="hours).  May be used with the RAM Earned/Spent Analysis to compare current"
^DIC(19,3103,1,7,0)="costs with prior year costs by cost center, and the projected impact of "
^DIC(19,3103,1,8,0)="changes on WWU costs.  Cost Center variances from VA wide averages may be"
^DIC(19,3103,1,9,0)="reviewed using the Earned/Spent analysis and RAM WWU's, and analyzed for"
^DIC(19,3103,1,10,0)="productivity and effectiveness evaluations using duty/non-duty hours."
^DIC(19,3103,60)="PRCM(401,"
^DIC(19,3103,62)=0
^DIC(19,3103,63)="[PRCM GROSS TO NET COST BY CC]"
^DIC(19,3103,64)="[PRCM GROSS TO NET COST BY CC]"
^DIC(19,3103,"U")="COST CENTER GROSS TO NET COST REPORT"
^DIC(19,3104,0)="PRCM GROSS TO NET BY T&L^T&L Unit Gross to Net Cost Report^^P^.5^^^"
^DIC(19,3104,1,0)="^^10^10^2890206^^^^"
^DIC(19,3104,1,1,0)="User may select salary control point and T&L unit, to report Gross to Net"
^DIC(19,3104,1,2,0)="costs by employee, showing sub-account, cost center, gross pay, benefits,"
^DIC(19,3104,1,3,0)="total cost, and calculates FTE for the pay period.  Also shows duty hours"
^DIC(19,3104,1,4,0)="as the sum of normal hours, unscheduled hours, overtime hours and comp time"
^DIC(19,3104,1,5,0)="hours; and non-duty hours as the sum of non-pay time, annual leave used,"
^DIC(19,3104,1,6,0)="sick leave used, comp time used, military duty hours and LWOP.  May be used"
^DIC(19,3104,1,7,0)="for work and cost productivity analysis by T&L unit in conjunction with RAM"
^DIC(19,3104,1,8,0)="analysis and WWU productivity.  Use as a RAM analytical tool is enhanced "
^DIC(19,3104,1,9,0)="by the assignment of employees to T&L units which correspond to RAM recog-"
^DIC(19,3104,1,10,0)="nized Bed Sections, Clinics, or Models."
^DIC(19,3104,60)="PRCM(401,"
^DIC(19,3104,62)=0
^DIC(19,3104,63)="[PRCM GROSS TO NET COST-CP/T&L]"
^DIC(19,3104,64)="[PRCM GROSS TO NET COST-CP/T&L]"
^DIC(19,3104,"U")="T&L UNIT GROSS TO NET COST REPORT"
