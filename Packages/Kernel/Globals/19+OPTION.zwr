^DIC(19,6291,0)="RA CPTSTATS^Procedure/CPT Statistics Report^^R^11712^^^^^^y^"
^DIC(19,6291,1,0)="^^3^3^2911218^^^"
^DIC(19,6291,1,1,0)="This report will generate statistics on the numbers of"
^DIC(19,6291,1,2,0)="each procedure performed for a date range. You can also"
^DIC(19,6291,1,3,0)="break the report out by Inpatient, Outpatient or Both."
^DIC(19,6291,25)="CHK^RACPT"
^DIC(19,6291,"U")="PROCEDURE/CPT STATISTICS REPOR"
^DIC(19,6292,0)="RA TRANSCRIP REPORT^Transcription Report^^R^11712^^^^^^y^"
^DIC(19,6292,1,0)="^^13^13^2940824^"
^DIC(19,6292,1,1,0)="This option allows you to print the number of lines transcribed for a date"
^DIC(19,6292,1,2,0)="range. The user is prompted to select the divisions to include in the"
^DIC(19,6292,1,3,0)="report. The user may select one, many or all divisions. Next, the user is"
^DIC(19,6292,1,4,0)="prompted to select the transcriptionists to include in the report. The"
^DIC(19,6292,1,5,0)="user may select one, many or all transcriptionists. If the user does not"
^DIC(19,6292,1,6,0)="want all the transcriptionists to appear in the report, then s/he may"
^DIC(19,6292,1,7,0)="choose which persons will appear. The choices are limited to those persons"
^DIC(19,6292,1,8,0)="who are classified as Radiology/Nuclear Medicine users AND have actually"
^DIC(19,6292,1,9,0)="entered report text in a Radiology/Nuclear Medicine report. Last, the user"
^DIC(19,6292,1,10,0)="is prompted to enter a date range."
^DIC(19,6292,1,11,0)=" "
^DIC(19,6292,1,12,0)="The report lists the name of the transcriptionist, number of lines"
^DIC(19,6292,1,13,0)="transcribed, and the number of reports written for each division selected."
^DIC(19,6292,25)="RATRAN"
^DIC(19,6292,"U")="TRANSCRIPTION REPORT"
^DIC(19,6294,0)="RA PROCMSGEDIT^Procedure Message Entry/Edit^^R^11712^^^^^^^"
^DIC(19,6294,1,0)="^^3^3^2940606^"
^DIC(19,6294,1,1,0)="This option is used to enter, edit and delete messages related to"
^DIC(19,6294,1,2,0)="procedures.  These messages are used to alert the requestor at the time they"
^DIC(19,6294,1,3,0)="enter their request of special requirements relating to the procedure."
^DIC(19,6294,25)="12^RAMAIN"
^DIC(19,6294,"U")="PROCEDURE MESSAGE ENTRY/EDIT"
^DIC(19,6295,0)="RA PROCMSGPRINT^Procedure Message List^^R^11712^^^^^^^"
^DIC(19,6295,1,0)="^^2^2^2940606^"
^DIC(19,6295,1,1,0)="This option prints a list of procedure messages that have been entered"
^DIC(19,6295,1,2,0)="into the Rad/Nuc Med Procedure Message file (#71.4)."
^DIC(19,6295,25)="17^RAMAINP"
^DIC(19,6295,"U")="PROCEDURE MESSAGE LIST"
^DIC(19,6296,0)="RA ORDERPENDING^Pending/Hold Rad/Nuc Med Request Log^^R^1^^^^^^y^31^^1^1"
^DIC(19,6296,1,0)="^19.06^15^15^3220915^^^^"
^DIC(19,6296,1,1,0)="This option will print a list of requests in the 'pending' or 'hold'"
^DIC(19,6296,1,2,0)="status for the imaging location(s) chosen. The user is prompted for the"
^DIC(19,6296,1,3,0)="request status (pending or hold) and for the imaging location(s)."
^DIC(19,6296,1,4,0)=" "
^DIC(19,6296,1,5,0)="The output will give patient name, last 4 digits of patient ID number,"
^DIC(19,6296,1,6,0)="procedure, patient location and date ordered sorted by request date. The"
^DIC(19,6296,1,7,0)="report contains an updated patient location with the requesting location"
^DIC(19,6296,1,8,0)="printing below the patient location if the requesting location is"
^DIC(19,6296,1,9,0)="different from the patient location."
^DIC(19,6296,1,10,0)=" "
^DIC(19,6296,1,11,0)="If a request exists in the date range selected by the user that does not"
^DIC(19,6296,1,12,0)="have a value for imaging location, then a separate page is printed listing"
^DIC(19,6296,1,13,0)="that request. The imaging location will be labelled as ""Unknown"" in the"
^DIC(19,6296,1,14,0)="header of the page. This will identify orders that have not been submitted"
^DIC(19,6296,1,15,0)="to an imaging location."
^DIC(19,6296,15)="K RAOPT(""P/H"")"
^DIC(19,6296,20)="S RAOPT(""P/H"")="""""
^DIC(19,6296,25)="RAORDP"
^DIC(19,6296,"U")="PENDING/HOLD RAD/NUC MED REQUE"
^DIC(19,6297,0)="RA COMMON PROCEDURE^Common Procedure Enter/Edit^^R^11712^^^^^^^^^^"
^DIC(19,6297,1,0)="^^15^15^2940606^"
^DIC(19,6297,1,1,0)="This menu option may be used to add and or remove procedures from"
^DIC(19,6297,1,2,0)="the display used to enter requests. Procedures should"
^DIC(19,6297,1,3,0)="not be deleted from this file but just inactivated. When you"
^DIC(19,6297,1,4,0)="enter 'YES' to the 'Inactive' field it will automaticly remove"
^DIC(19,6297,1,5,0)="it's sequence number."
^DIC(19,6297,1,6,0)=" "
^DIC(19,6297,1,7,0)="You may enter as many procedures into the Common Procedure file as you"
^DIC(19,6297,1,8,0)="wish, however, you may only assign sequence numbers from 1 to 40.  Only"
^DIC(19,6297,1,9,0)="procedures with sequence numbers are displayed, therefore the maximum"
^DIC(19,6297,1,10,0)="number of common procedures that can be displayed is 40."
^DIC(19,6297,1,11,0)=" "
^DIC(19,6297,1,12,0)="Any procedures entered into this file (with or without a sequence number)"
^DIC(19,6297,1,13,0)="can be converted into an Order Entry/Results Reporting protocol, thus"
^DIC(19,6297,1,14,0)="making the procedure an orderable item that can be selected by anyone"
^DIC(19,6297,1,15,0)="requesting an exam in OE/RR."
^DIC(19,6297,15)=""
^DIC(19,6297,20)=""
^DIC(19,6297,25)="13^RAMAIN2"
^DIC(19,6297,30)=""
^DIC(19,6297,31)=""
^DIC(19,6297,50)=""
^DIC(19,6297,51)=""
^DIC(19,6297,"U")="COMMON PROCEDURE ENTER/EDIT"
^DIC(19,6298,0)="RA DISPLAY COMMON PROCEDURES^Display Common Procedure List^^R^11712^^^^^^y^^^^1"
^DIC(19,6298,1,0)="^^3^3^2940606^"
^DIC(19,6298,1,1,0)="This option allows you to look at what the common procedure"
^DIC(19,6298,1,2,0)="list will look like to the user, when using the request a"
^DIC(19,6298,1,3,0)="procedure either through OE/RR or the Rad/Nuc Med option."
^DIC(19,6298,15)="K RACNT,RAPRC,RAPRI,RAIMGTYI,X,Y"
^DIC(19,6298,25)="DISP^RAPRI"
^DIC(19,6298,"U")="DISPLAY COMMON PROCEDURE LIST"
^DIC(19,6299,0)="RA ORDER DISPLAY MENU^Order Entry Procedure Display Menu^^M^11712^^^^^^^"
^DIC(19,6299,1,0)="^^2^2^2940607^^"
^DIC(19,6299,1,1,0)="This menu contains the options to manage the common procedure"
^DIC(19,6299,1,2,0)="display used in either OE/RR or in the Request an Exam option."
