^DIC(19,7206,0)="XUERTRP PRINT ERRS^Interactive Print of Error Messages^^R^1039^^^^^^^"
^DIC(19,7206,1,0)="^^2^2^2920901^"
^DIC(19,7206,1,1,0)="This option provides for an interactive print of the first N occurrences"
^DIC(19,7206,1,2,0)="of an error (where N is user selectable) over the specified date range."
^DIC(19,7206,25)="INTRACT^XTER1A"
^DIC(19,7206,"U")="INTERACTIVE PRINT OF ERROR MES"
^DIC(19,7207,0)="XUERTRP PRINT T-1 1 ERR^Print 1 occurence of each error for T-1 (QUEUE)^^R^1039^^^^^^^"
^DIC(19,7207,1,0)="7^^7^7^2960423^^^^"
^DIC(19,7207,1,1,0)="This option is used to obtain a listing of the first occurrence of each"
^DIC(19,7207,1,2,0)="error recorded on the previous day.  It may be QUEUED to run shortly"
^DIC(19,7207,1,3,0)="after midnight.  If a device is specified, the output will be to the"
^DIC(19,7207,1,4,0)="specified device.  If a device is NOT specified, the output will be"
^DIC(19,7207,1,5,0)="in a mail message sent to the individual who QUEUED the option to run."
^DIC(19,7207,1,6,0)="It should be set to automatically requeue at a 1 D interval."
