^DIC(19,9425,20)="K:$G(PRCP(""DPTYPE""))'=""W"" PRCP S PRCP(""DPTYPE"")=""W"" D DISPLAY^PRCPUSEL I '$G(PRCP(""I"")) S XQUIT=1 D NOMENU^PRCPUSEL"
^DIC(19,9425,99)="62195,30816"
^DIC(19,9425,"U")="RECEIVING AND DISTRIBUTION MEN"
^DIC(19,9426,0)="PRCP PACKAGING DISCREP PRINT^Packaging/Procurement Source Discrepancy Report^^R^11740^^^^^^^"
^DIC(19,9426,1,0)="^^3^3^2920211^"
^DIC(19,9426,1,1,0)="This option will print a report of discrepancies found with items"
^DIC(19,9426,1,2,0)="stored in the inventory point.  Discrepancies include packaging"
^DIC(19,9426,1,3,0)="and unit discrepancies and vendor discrepancies."
^DIC(19,9426,25)="PRCPRPKG"
^DIC(19,9426,"U")="PACKAGING/PROCUREMENT SOURCE D"
^DIC(19,9427,0)="PRCP2 AUTOGENERATE SECONDARY^Auto-generate Orders^^R^11740^^^^^^^"
^DIC(19,9427,1,0)="^^20^20^2921217^^^^"
^DIC(19,9427,1,1,0)="This option will auto-generate a secondary inventory point distribution"
^DIC(19,9427,1,2,0)="order.  The auto-generation will use the selected primary distribution"
^DIC(19,9427,1,3,0)="points (stored in the mandatory or suggested source field in the"
^DIC(19,9427,1,4,0)="secondary) for selecting the items.  When an item's available quantity"
^DIC(19,9427,1,5,0)="(quantity on hand plus quantity due-in minus quantity due-out) falls"
^DIC(19,9427,1,6,0)="below or equal to the standard reorder point, the item will be ordered."
^DIC(19,9427,1,7,0)="When an item's available quantity falls below or equal to the optional"
^DIC(19,9427,1,8,0)="reorder point, the item will be ordered if there are other items for"
^DIC(19,9427,1,9,0)="the same vendor which are being ordered due to the available quantity"
^DIC(19,9427,1,10,0)="falling below the standard reorder point (if items only fall below the"
^DIC(19,9427,1,11,0)="optional order point for a vendor, the order will not be generated)."
^DIC(19,9427,1,12,0)=" "
^DIC(19,9427,1,13,0)="The quantity to order is the difference between the available quantity"
^DIC(19,9427,1,14,0)="and the normal stock level.  Conversion factors (primary to secondary),"
^DIC(19,9427,1,15,0)="primary minimal issue quantity, and primary issue multiple also factor"
^DIC(19,9427,1,16,0)="into the total quantity of an item to order."
^DIC(19,9427,1,17,0)=" "
^DIC(19,9427,1,18,0)="At completion of auto-generation, a series of reports can be generated."
^DIC(19,9427,1,19,0)="Each item in the inventory point will appear on one of the reports."
^DIC(19,9427,1,20,0)="This will aid in determining why an item was or was not ordered."
^DIC(19,9427,20)=""
^DIC(19,9427,25)="PRCPAGS0"
^DIC(19,9427,99)="55497,27436"
^DIC(19,9427,"U")="AUTO-GENERATE ORDERS"
^DIC(19,9428,0)="PRCP PICK TKT REPRINT (POSTED)^Reprint Posted Picking Ticket^^R^11740^^^^^^^"
^DIC(19,9428,1,0)="^^3^3^2920211^^"
^DIC(19,9428,1,1,0)="This option can be used by the manager of the warehouse inventory"
^DIC(19,9428,1,2,0)="point to reprint a picking ticket from an issue book request"
^DIC(19,9428,1,3,0)="posted at a specific time."
^DIC(19,9428,25)="PRCPRPIT"
^DIC(19,9428,"U")="REPRINT POSTED PICKING TICKET"
^DIC(19,9429,0)="PRCP UNIT COSTING REPORT^Unit Costing Report^^R^11740^^^^^^^"
^DIC(19,9429,1,0)="^^4^4^2920211^^"
^DIC(19,9429,1,1,0)="This option will print a report of items stored in the inventory"
^DIC(19,9429,1,2,0)="point showing the item information, unit per issue, SKU, average"
^DIC(19,9429,1,3,0)="cost, last cost, and unit cost.  This report can be used to verify"
^DIC(19,9429,1,4,0)="the correct costing information in the warehouse."
^DIC(19,9429,25)="PRCPRCOS"
^DIC(19,9429,"U")="UNIT COSTING REPORT"
^DIC(19,9430,0)="PRCP DIST HISTORY REPORT^History Of Distribution Report^^R^11740^^^^^^^"
^DIC(19,9430,1,0)="^^3^3^2920828^^"
^DIC(19,9430,1,1,0)="This option will print a report showing the distribution history"
^DIC(19,9430,1,2,0)="to or from the inventory point by cost center and by MIS costing"
^DIC(19,9430,1,3,0)="section."
^DIC(19,9430,25)="PRCPRPDH"
^DIC(19,9430,99)="55656,47370"
^DIC(19,9430,"U")="HISTORY OF DISTRIBUTION REPORT"
^DIC(19,9431,0)="PRCPW ADJUST QUANTITY^Adjust Inventory Quantity^^R^11740^^^^^^^"
^DIC(19,9431,1,0)="^^5^5^2920518^^^^"
^DIC(19,9431,1,1,0)="This option can be used to adjust the warehouse quantity on-hand for"
^DIC(19,9431,1,2,0)="selected items.  The adjustments can be four types: an issue adjustment,"
^DIC(19,9431,1,3,0)="a purchase order adjustment, to/from non-issuable, or an other type"
^DIC(19,9431,1,4,0)="adjustment (actual count, etc.).  After an adjustment is made, the"
^DIC(19,9431,1,5,0)="correct code sheets are automatically created and transmitted."
^DIC(19,9431,25)="PRCPAWA0"
^DIC(19,9431,99)="55913,51894"
^DIC(19,9431,"U")="ADJUST INVENTORY QUANTITY"
^DIC(19,9432,0)="PRCPW ADJUST APPROVAL^Approve Adjustments^^R^11740^PRCPW ADJAPPR^^^^^^"
^DIC(19,9432,1,0)="^^6^6^2920518^^^^"
^DIC(19,9432,1,1,0)="This option can be used to approve entire adjustments (all items) or"
^DIC(19,9432,1,2,0)="single items on an adjustment.  When an item adjustment is approved,"
^DIC(19,9432,1,3,0)="the item adjustment will no longer appear on the 'Unapproved Adjustment"
^DIC(19,9432,1,4,0)="Report.'"
^DIC(19,9432,1,5,0)=" "
^DIC(19,9432,1,6,0)="This option is locked with the 'PRCPW ADJAPPR' security key."
^DIC(19,9432,25)="PRCPAWAP"
^DIC(19,9432,"U")="APPROVE ADJUSTMENTS"
^DIC(19,9433,0)="PRCPW ADJUST UNAPPROVE REPORT^Unapproved Adjustment Report^^R^11740^^^^^^^"
^DIC(19,9433,1,0)="^^3^3^2920518^^^^"
^DIC(19,9433,1,1,0)="This option will print a report showing the adjustments and items"
^DIC(19,9433,1,2,0)="which have not been approved.  Adjustments can be approved using the"
^DIC(19,9433,1,3,0)="option 'Approve Adjustments.'"
^DIC(19,9433,25)="PRCPAWR0"
^DIC(19,9433,"U")="UNAPPROVED ADJUSTMENT REPORT"
^DIC(19,9434,0)="PRCPW ADJUST NONISSUE REPORT^Non-Issuable Stock Report^^R^11740^^^^^^^"
^DIC(19,9434,1,0)="^^6^6^2940211^^"
^DIC(19,9434,1,1,0)="This option will print a report showing the items and quantities"
^DIC(19,9434,1,2,0)="which have been placed in non-issuable.  An item can be placed"
^DIC(19,9434,1,3,0)="in non-issuable using the option 'Adjust Inventory Quantity.'"
^DIC(19,9434,1,4,0)="When an item is placed into non-issuable, it is subtracted from"
^DIC(19,9434,1,5,0)="the quantity on-hand.  When an item is placed back into issuable"
^DIC(19,9434,1,6,0)="(from non-issuable), it is added back to the quantity on-hand."
^DIC(19,9434,25)="PRCPRNON"
^DIC(19,9434,"U")="NON-ISSUABLE STOCK REPORT"
^DIC(19,9435,0)="PRCPW ADJUST MENU^Adjust Inventory Quantity Menu^^M^11740^^^^^^^"
^DIC(19,9435,1,0)="^^4^4^2920518^^^^"
^DIC(19,9435,1,1,0)="This menu contains the options which will adjust inventory item"
^DIC(19,9435,1,2,0)="quantities on-hand.  It also contains the option to move item"
^DIC(19,9435,1,3,0)="quantities to and from non-issuable status, and the report to"
^DIC(19,9435,1,4,0)="track items which are in non-issuable."
^DIC(19,9435,10,0)="^19.01PI^4^4"
^DIC(19,9435,10,1,0)="9431^"
^DIC(19,9435,10,2,0)="9432^"
^DIC(19,9435,10,3,0)="9433^"
^DIC(19,9435,10,4,0)="9444^"
^DIC(19,9435,10,"B",9431,1)=""
^DIC(19,9435,10,"B",9432,2)=""
^DIC(19,9435,10,"B",9433,3)=""
^DIC(19,9435,10,"B",9444,4)=""
^DIC(19,9435,99)="62195,30816"
^DIC(19,9435,"U")="ADJUST INVENTORY QUANTITY MENU"
^DIC(19,9436,0)="PRCP POSTED DIETETIC REPORT^Posted Dietetic Cost Report^^P^11740^^^^^^^"
^DIC(19,9436,1,0)="^^2^2^2921229^^^"
^DIC(19,9436,1,1,0)="This report prints posted items i.e. items with 'Log Voucher No.'. The"
^DIC(19,9436,1,2,0)="report is sorted by 'Food Group' and 'Date Of Transaction'."
^DIC(19,9436,60)="PRCP(445.2,"
^DIC(19,9436,62)=0
^DIC(19,9436,63)="[PRCP POSTED DIETETIC PRINT]"
^DIC(19,9436,64)="[PRCP POSTED DIETETIC SORT]"
^DIC(19,9436,"U")="POSTED DIETETIC COST REPORT"
^DIC(19,9437,0)="PRCP VOUCHER SUMMARY REPORT^Voucher Summary Report^^R^11740^^^^^^^"
^DIC(19,9437,1,0)="^^2^2^2920804^"
^DIC(19,9437,1,1,0)="This option will print the voucher summary report which can be"
^DIC(19,9437,1,2,0)="used to reconcile the warehouse inventory point for the month."
^DIC(19,9437,25)="PRCPRVSR"
^DIC(19,9437,"U")="VOUCHER SUMMARY REPORT"
^DIC(19,9438,0)="PRCP DIST ORDER PRIM DUEOUTS^Calculated Due-Out Quantity Report^^R^11740^^^^^^^"
^DIC(19,9438,1,0)="^^3^3^2921022^^^^"
^DIC(19,9438,1,1,0)="This option will print a list of due-outs from the distribution orders."
^DIC(19,9438,1,2,0)="If you have the manager key, you will also have the option to update"
^DIC(19,9438,1,3,0)="the inventory point with the calculated quantity due-out."
^DIC(19,9438,25)="PRCPRDOR"
^DIC(19,9438,"U")="CALCULATED DUE-OUT QUANTITY RE"
^DIC(19,9439,0)="PRCP DIST COST EDIT^Distribution Costs Enter/Edit^^R^11740^^^^^^^"
^DIC(19,9439,1,0)="^^2^2^2921109^"
^DIC(19,9439,1,1,0)="This option allows the costing data displayed on the 'History of"
^DIC(19,9439,1,2,0)="Distribution Report' to be entered or changed."
^DIC(19,9439,25)="EDIT^PRCPUCC"
^DIC(19,9439,99)="55789,32982"
^DIC(19,9439,"U")="DISTRIBUTION COSTS ENTER/EDIT"
^DIC(19,9440,0)="PRCP ISMS BALANCE UPDATE^Balance Update Transaction (IM-6)^^R^11740^^^^^^^"
^DIC(19,9440,1,0)="^^3^3^2921208^"
^DIC(19,9440,1,1,0)="This ISMS transaction will send a snapshot of the current warehouse"
^DIC(19,9440,1,2,0)="inventory balances to ISMS.  ISMS will use the balances contained in"
^DIC(19,9440,1,3,0)="this transaction to overlay the current ISMS balances."
^DIC(19,9440,25)="PRCPSMB0"
^DIC(19,9440,99)="55494,35693"
^DIC(19,9440,"U")="BALANCE UPDATE TRANSACTION (IM"
^DIC(19,9441,0)="PRCP AUTOGENERATE PRIM/WHSE^Auto-generate Orders^^R^11740^^^^^^^^^"
^DIC(19,9441,1,0)="^^22^22^2921217^"
^DIC(19,9441,1,1,0)="This option will auto-generate a primary or warehouse inventory point"
^DIC(19,9441,1,2,0)="repetitive item list.  The auto-generation will use the selected group"
^DIC(19,9441,1,3,0)="categories and vendors (stored in the mandatory or suggested source"
^DIC(19,9441,1,4,0)="field in the primary and warehouse inventory points) for selecting"
^DIC(19,9441,1,5,0)="the items.  When an item's available quantity (quantity on hand plus"
^DIC(19,9441,1,6,0)="quantity due-in minus quantity due-out) falls below or equal to the"
^DIC(19,9441,1,7,0)="standard reorder point, the item will be ordered.  When an item's"
^DIC(19,9441,1,8,0)="available quantity falls below or equal to the optional reorder point,"
^DIC(19,9441,1,9,0)="the item will be ordered if there are other items for the same vendor"
^DIC(19,9441,1,10,0)="which are being ordered due to the available quantity falling below"
^DIC(19,9441,1,11,0)="the standard reorder point (if items only fall below the optional"
^DIC(19,9441,1,12,0)="order point for a vendor, the order will not be generated)."
^DIC(19,9441,1,13,0)=" "
^DIC(19,9441,1,14,0)="The quantity to order is the difference between the available quantity"
^DIC(19,9441,1,15,0)="and the normal stock level.  Conversion factors (warehouse to primary,"
^DIC(19,9441,1,16,0)="vendor to primary, or vendor to warehouse), vendor minimal issue"
^DIC(19,9441,1,17,0)="quantity, and vendor issue multiple also factor into the total quantity"
^DIC(19,9441,1,18,0)="of an item to order."
^DIC(19,9441,1,19,0)=" "
^DIC(19,9441,1,20,0)="At completion of auto-generation, a series of reports can be generated."
^DIC(19,9441,1,21,0)="Each item in the inventory point will appear on one of the reports."
^DIC(19,9441,1,22,0)="This will aid in determining why an item was or was not ordered."
^DIC(19,9441,20)=""
^DIC(19,9441,25)="PRCPAGP0"
^DIC(19,9441,99)="55558,35880"
^DIC(19,9441,"U")="AUTO-GENERATE ORDERS"
^DIC(19,9442,0)="PRCP GROUP CATEGORY EDIT^Group Category Enter/Edit^^R^11740^^^^^^^"
^DIC(19,9442,1,0)="^^2^2^2921223^^"
^DIC(19,9442,1,1,0)="This option will allow the manager of an inventory point to change or"
^DIC(19,9442,1,2,0)="remove group categories which have been set up for the inventory point."
^DIC(19,9442,25)="PRCPEGRP"
^DIC(19,9442,"U")="GROUP CATEGORY ENTER/EDIT"
^DIC(19,9443,0)="PRCP STORAGE LOCATION EDIT^Storage Location Enter/Edit^^R^11740^^^^^^^"
^DIC(19,9443,1,0)="^^2^2^2921223^^"
^DIC(19,9443,1,1,0)="This option will allow the manager of an inventory point to change or"
^DIC(19,9443,1,2,0)="remove storage locations which have been set up for the inventory point."
^DIC(19,9443,25)="PRCPESTO"
^DIC(19,9443,"U")="STORAGE LOCATION ENTER/EDIT"
^DIC(19,9444,0)="PRCPW PHYSICAL COUNT FORM^Physical Count Form^^R^11740^^^^^^^"
^DIC(19,9444,1,0)="^^2^2^2930209^"
^DIC(19,9444,1,1,0)="This option will print the physical count form for the warehouse"
^DIC(19,9444,1,2,0)="sorted by main storage location, account code, and nsn."
^DIC(19,9444,25)="PRCPRPHW"
^DIC(19,9444,"U")="PHYSICAL COUNT FORM"
^DIC(19,9445,0)="PRCP PHYSICAL COUNT FORM^Physical Count Form^^R^11740^^^^^^^"
^DIC(19,9445,1,0)="^^3^3^2930209^"
^DIC(19,9445,1,1,0)="This option will print the physical count form for a primary or"
^DIC(19,9445,1,2,0)="secondary inventory point sorted by main storage location, group"
^DIC(19,9445,1,3,0)="category, and description."
^DIC(19,9445,25)="PRCPRPHP"
^DIC(19,9445,99)="55669,39419"
^DIC(19,9445,"U")="PHYSICAL COUNT FORM"
^DIC(19,9446,0)="PRCP ISMS BALANCE TASKMAN^Taskman Sends ISMS Balance Update^^R^11740^^^^^^^"
^DIC(19,9446,1,0)="^^6^6^2930427^^"
^DIC(19,9446,1,1,0)="This option can be set up through TaskManager to automatically send"
^DIC(19,9446,1,2,0)="the ISMS Balance Update Transaction at a specified time."
^DIC(19,9446,1,3,0)=" "
^DIC(19,9446,1,4,0)="This ISMS transaction will send a snapshot of the current warehouse"
^DIC(19,9446,1,5,0)="inventory balances to ISMS.  ISMS will use the balances contained in"
^DIC(19,9446,1,6,0)="this transaction to overlay the current ISMS balances."
^DIC(19,9446,25)="TASKMAN^PRCPSMB0"
^DIC(19,9446,99)="55494,35693"
^DIC(19,9446,"U")="TASKMAN SENDS ISMS BALANCE UPD"
^DIC(19,9447,0)="PRCP CC ENTER/EDIT DEFINITION^Enter/Edit/Create A Case Cart^^R^11740^^^^^^^"
^DIC(19,9447,1,0)="^^4^4^2940727^^"
^DIC(19,9447,1,1,0)="The Enter/Edit/Create A Case Cart option will allow the user to"
^DIC(19,9447,1,2,0)="define which items and quantity should be used in assembling the"
^DIC(19,9447,1,3,0)="case cart.  The user can also enter special instructions or remarks"
^DIC(19,9447,1,4,0)="for the case cart."
^DIC(19,9447,25)="CASECART^PRCPCED0"
^DIC(19,9447,"U")="ENTER/EDIT/CREATE A CASE CART"
^DIC(19,9448,0)="PRCP CC ASSEMBLE^Assemble Case Cart^^R^11740^^^^^^^"
^DIC(19,9448,1,0)="^^13^13^2940126^^"
^DIC(19,9448,1,1,0)="The Assemble Case Cart option will build selected case carts by the"
^DIC(19,9448,1,2,0)="case cart definition.  The case cart definition describes the items"
^DIC(19,9448,1,3,0)="and quantities which are used in building the case cart."
^DIC(19,9448,1,3,2)="R;"
^DIC(19,9448,1,4,0)=""
^DIC(19,9448,1,4,2)="R;"
^DIC(19,9448,1,5,0)="The user will have the option to select the number of case carts to"
^DIC(19,9448,1,6,0)="build.  After selecting the number, a screen display will show the"
^DIC(19,9448,1,7,0)="current quantity on-hand and new quantity on-hand (after building)"
^DIC(19,9448,1,8,0)="for the items which make up the case cart definition.  The new"
^DIC(19,9448,1,9,0)="quantity on-hand is calculated by subtracting the current quantity"
^DIC(19,9448,1,10,0)="on-hand by the quantity needed for disposable items (reusable items"
^DIC(19,9448,1,11,0)="are not removed from the inventory point during assembly).  If any"
^DIC(19,9448,1,12,0)="item's new quantity on-hand falls below zero, a warning message will"
^DIC(19,9448,1,13,0)="be displayed on the screen."
^DIC(19,9448,1,13,2)="R;"
^DIC(19,9448,25)="PRCPCASC"
^DIC(19,9448,"U")="ASSEMBLE CASE CART"
^DIC(19,9449,0)="PRCP CC DISASSEMBLE^Disassemble Case Cart^^R^11740^^^^^^^"
^DIC(19,9449,1,0)="^^7^7^2940126^^"
^DIC(19,9449,1,1,0)="The Disassemble Case Cart option will break down the case cart and"
^DIC(19,9449,1,2,0)="return the individual disposable items back to stock.  When a case"
^DIC(19,9449,1,3,0)="cart is disassembled, the quantity on-hand for the case cart will be"
^DIC(19,9449,1,4,0)="decremented and the quantity on-hand for the disposable items will be"
^DIC(19,9449,1,5,0)="incremented.  The quantity on-hand for reusable items will not"
^DIC(19,9449,1,6,0)="change."
^DIC(19,9449,1,7,0)=""
^DIC(19,9449,25)="PRCPCDIC"
^DIC(19,9449,"U")="DISASSEMBLE CASE CART"
^DIC(19,9450,0)="PRCP CC DEFINITION REPORT^Case Cart Report^^R^11740^^^^^^^"
^DIC(19,9450,1,0)="^^8^8^2940727^^"
^DIC(19,9450,1,1,0)="The Case Cart Report will print a list of selected case"
^DIC(19,9450,1,2,0)="carts displaying the items and quantities needed to assemble the case"
^DIC(19,9450,1,3,0)="cart."
^DIC(19,9450,1,4,0)=""
^DIC(19,9450,1,5,0)="The report will print the items needed, description, quantity needed,"
^DIC(19,9450,1,6,0)="whether the item is reusable or disposable, mandatory source vendor"
^DIC(19,9450,1,7,0)="for reordering, catalog number for the mandatory source, and storage"
^DIC(19,9450,1,8,0)="location."
^DIC(19,9450,25)="PRCPCRDC"
^DIC(19,9450,"U")="CASE CART REPORT"
^DIC(19,9451,0)="PRCP CC MENU^Case Cart Menu^^M^11740^^^^^^^"
