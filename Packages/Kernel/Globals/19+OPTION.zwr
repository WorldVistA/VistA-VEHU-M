^DIC(19,9696,1,0)="^^3^3^2960119^^^^"
^DIC(19,9696,1,1,0)="This option allows the ADP coordinator to enter the entries for the GMRY "
^DIC(19,9696,1,2,0)="OUTPUT SUBTYPE file (#126.6) pointed to by the GMRY PATIENT I/O FILE file "
^DIC(19,9696,1,3,0)="(#126).  VOID, FOLEY and STRAIGHT CATH, for example, are subtypes of URINE."
