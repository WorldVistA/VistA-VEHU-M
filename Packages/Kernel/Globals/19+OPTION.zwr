^DIC(19,11508,0)="PXRM CPRS LOOKUP CATEGORIES^CPRS Lookup Categories^^A^10000000020^^^^^^^534^^1"
^DIC(19,11508,1,0)="^^6^6^3000403^"
^DIC(19,11508,1,1,0)="This option allows a user to modify the ""Reminder Categories for Lookup"""
^DIC(19,11508,1,2,0)="CPRS parameter.  This parameter defines reminder categories to display in"
^DIC(19,11508,1,3,0)="the ""reminders available"" window and the note tabs' reminder drawer under"
^DIC(19,11508,1,4,0)="""OTHER"". The reminders that are defined in the categories are available to"
^DIC(19,11508,1,5,0)="the CPRS GUI user to selectively evaluate and process. They are not"
^DIC(19,11508,1,6,0)="automatically evaluated when the cover sheet is built."
^DIC(19,11508,20)="D EDITPAR^XPAREDIT(""PXRM CPRS LOOKUP CATEGORIES"")"
^DIC(19,11508,"U")="CPRS LOOKUP CATEGORIES"
^DIC(19,11510,0)="PXRM TERM COPY^Copy Reminder Term^^R^10000000020^^^^^^^"
^DIC(19,11510,1,0)="^^2^2^2991108^"
^DIC(19,11510,1,1,0)="This option allows a user to copy an existing reminder term into a new"
^DIC(19,11510,1,2,0)="one. The new term must have a unique name."
^DIC(19,11510,25)="COPYTERM^PXRMCOPY"
^DIC(19,11510,"U")="COPY REMINDER TERM"
^DIC(19,11511,0)="PXRM TERM EDIT^Add/Edit Reminder Term^^R^1^^^^^^^534"
^DIC(19,11511,1,0)="^19.06^1^1^3040304^^^"
^DIC(19,11511,1,1,0)="This option is used to edit reminder terms."
^DIC(19,11511,25)="PXRMTMED"
^DIC(19,11511,"U")="ADD/EDIT REMINDER TERM"
^DIC(19,11512,0)="PXRM TERM INQUIRY^Inquire about Reminder Term^^R^10000000020^^^^^^^"
^DIC(19,11512,1,0)="^19.06^2^2^3040426^^"
^DIC(19,11512,1,1,0)="This option allows a user to display the contents of a reminder term in"
^DIC(19,11512,1,2,0)="an easy to read format."
^DIC(19,11512,25)="TERM^PXRMINQ"
^DIC(19,11512,"U")="INQUIRE ABOUT REMINDER TERM"
