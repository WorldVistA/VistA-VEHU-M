^DIC(19,6726,"U")="TECHNICIAN (CS PHARMACY) MENU"
^DIC(19,6727,0)="PSD WORKSHEET PRINT^Print CS Dispensing Worksheet^^R^10000000216^^^^^^^276"
^DIC(19,6727,1,0)="^^16^16^2941006^^^^"
^DIC(19,6727,1,1,0)="Pharmacy personnel use this option to print a dispensing worksheet."
^DIC(19,6727,1,2,0)="This worksheet MUST be printed prior to pharmacy dispensing"
^DIC(19,6727,1,3,0)="Controlled Substances orders.  Pharmacy may sort this report within"
^DIC(19,6727,1,4,0)="a dispensing site, by NAOU (one, some, or ALL), or by inventory group."
^DIC(19,6727,1,5,0)="Next, the orders are sorted by either (1) drug, then all NAOUs, or"
^DIC(19,6727,1,6,0)="(2) NAOU, then all drugs.  The worksheet lists a worksheet number assigned"
^DIC(19,6727,1,7,0)="to this order, drug, quantity ordered, dispense to location,"
^DIC(19,6727,1,8,0)="ordered by, comments, and blanks for manufacturer, lot #, and"
^DIC(19,6727,1,9,0)="expiration date.  When using the Fill/Dispense CS Orders from Worksheet"
^DIC(19,6727,1,10,0)="option, pharmacy may process orders by individual request number"
^DIC(19,6727,1,11,0)="(the assigned worksheet number) or by worksheet.  If the worksheet"
^DIC(19,6727,1,12,0)="method of dispensing is selected, the software will display each"
^DIC(19,6727,1,13,0)="order to the pharmacist in the sequence the order was printed."
^DIC(19,6727,1,14,0)="Each time this report is run, a new worksheet will be built and"
^DIC(19,6727,1,15,0)="all new CS orders will be included.  The printed sequence of CS orders"
^DIC(19,6727,1,16,0)="will change with each new worksheet."
^DIC(19,6727,25)="PSDPWK"
^DIC(19,6727,99)="55452,23943"
^DIC(19,6727,"U")="PRINT CS DISPENSING WORKSHEET"
^DIC(19,6728,0)="PSD WORKSHEET DISPENSING^Fill/Dispense CS Orders from Worksheet^^R^10000000216^^^^^^^276"
^DIC(19,6728,1,0)="^19.06^10^10^3010914^^^^"
^DIC(19,6728,1,1,0)="Pharmacy personnel use this option to process and verify Controlled"
^DIC(19,6728,1,2,0)="Substances orders.  The Pharmacy Dispensing Worksheet should be printed"
^DIC(19,6728,1,3,0)="first using the Print CS Dispensing Worksheet option. Controlled"
^DIC(19,6728,1,4,0)="Substances orders may be dispensed by selecting an individual worksheet"
^DIC(19,6728,1,5,0)="number or by sort order on the worksheet.  The pharmacist will be prompted"
^DIC(19,6728,1,6,0)="for dispensing pharmacist, dispensing site, quantity dispensed,"
^DIC(19,6728,1,7,0)="manufacturer, lot #, and expiration date.  The prompt for pharmacy"
^DIC(19,6728,1,8,0)="dispensing number will only appear if your site has elected to"
^DIC(19,6728,1,9,0)="enter these control numbers manually.  Otherwise, the software"
^DIC(19,6728,1,10,0)="will automatically generate the next available dispensing number."
^DIC(19,6728,25)="PSDDWK"
^DIC(19,6728,"U")="FILL/DISPENSE CS ORDERS FROM W"
^DIC(19,6729,0)="PSD DISPENSING MENU^Dispensing Menu^^M^10000000216^^^^^^^276"
^DIC(19,6729,1,0)="^^2^2^2961001^^^^"
^DIC(19,6729,1,1,0)="This menu contains access to all options associated with the dispensing"
^DIC(19,6729,1,2,0)="of Controlled Substances."
^DIC(19,6729,10,0)="^19.01PI^8^8"
^DIC(19,6729,10,1,0)="6727^^1"
