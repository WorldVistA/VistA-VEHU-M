^DIC(19,13215,0)="ONC TNM FORMS COMPLETE %^Compute percentage of TNM forms completed^^R^1^^^^^^^"
^DIC(19,13215,1,0)="^19.06^3^3^3060919^^"
^DIC(19,13215,1,1,0)="This option will prompt for a ""Start Date DX"" and ""End Date DX"" and "
^DIC(19,13215,1,2,0)="compute the percentage of TNM FORMS ASSIGNED which have been completed "
^DIC(19,13215,1,3,0)="within the selected DATE DX range."
^DIC(19,13215,25)="ONCTNMC"
^DIC(19,13215,"U")="COMPUTE PERCENTAGE OF TNM FORM"
^DIC(19,13216,0)="SCMC PCMM NIGHTLY TASK^PCMM NIGHTLY TASK^This functionality is now accomplished by the PCMM Web Application.^R^1^SC PCMM SETUP^^^^^^^^1^1"
^DIC(19,13216,1,0)="^19.06^7^7^3080314^^"
^DIC(19,13216,1,1,0)="This option should be scheduled once a day. It reviews Patient team assignments"
^DIC(19,13216,1,2,0)="and flaggs them for inactivation if their assignment is NEW and they "
^DIC(19,13216,1,3,0)="have not been seen in the last year. It also flaggs ESTABLISHED patients "
^DIC(19,13216,1,4,0)="if they have not been seen more than two years. If there are not "
^DIC(19,13216,1,5,0)="appointments within 30 days since flagging the related patients are "
^DIC(19,13216,1,6,0)="inactivated on the closest 15th or the end of month process. Messages are "
^DIC(19,13216,1,7,0)="generated both on the 15th and on the last day of a month."
^DIC(19,13216,15)="N DTT S DTT=+$D(^XTMP(""SCMCTSK2-""_$$HTFM^XLFDT($H,1),$J,""START"")) N DT1 S DT1=$S(DTT>0:$$HTFM^XLFDT($H,1),1:$$HTFM^XLFDT($H-1,1)) S ^XTMP(""SCMCTSK2-""_DT1,$J,""STOP"")=$$HTE^XLFDT($H)"
^DIC(19,13216,20)="S ^XTMP(""SCMCTSK2-""_$$HTFM^XLFDT($H,1),0)=$$HTFM^XLFDT($H+7,1)_U_$$HTFM^XLFDT($H,1)_U_$J,^XTMP(""SCMCTSK2-""_$$HTFM^XLFDT($H,1),$J,""START"")=$$HTE^XLFDT($H)"
^DIC(19,13216,25)="NIGHT^SCMCTSK2"
^DIC(19,13216,"U")="PCMM NIGHTLY TASK"
