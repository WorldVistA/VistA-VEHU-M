^DIC(19,7539,1,0)=2
^DIC(19,7539,1,1,0)="This option is controlled by taskmanager.  This option should be set up"
^DIC(19,7539,1,2,0)="to run the first day of each month starting around 1:00am."
^DIC(19,7539,25)="DQ^PRCPXALL"
^DIC(19,7539,200)="^^1M"
