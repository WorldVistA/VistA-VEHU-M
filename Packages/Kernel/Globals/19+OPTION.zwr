^DIC(19,3875,1,0)="^^3^3^2930713^^^^"
^DIC(19,3875,1,1,0)="This menu allows access to options needed frequently in"
^DIC(19,3875,1,2,0)="food production, including most recipe and menu cycle file management"
^DIC(19,3875,1,3,0)="options as well as all production reports."
