^DIC(19,9384,"U")="REPORTS MENU"
^DIC(19,9385,0)="PRCP RECEIVE PURCHASE ORDER^Purchase Order Receiving To Inventory Point^^R^11740^^^^^^^"
^DIC(19,9385,1,0)="^^13^13^2940614^^^^"
^DIC(19,9385,1,1,0)="  ** For receiving from any source other than Supply Whse. (Issues) **"
^DIC(19,9385,1,2,0)="  User enters a P.O. and the partial number received.  For recurring items,"
^DIC(19,9385,1,3,0)="the process updates inventory quantity. The process also recalculates"
^DIC(19,9385,1,4,0)="the average unit cost for the item, based on a weighted average between the"
^DIC(19,9385,1,5,0)="quantity on hand at the old average price, and the quantity received at"
^DIC(19,9385,1,6,0)="a new price.  It also updates the last unit cost, and the date last"
^DIC(19,9385,1,7,0)="received, as well as receiving history showing the date and quantity"
^DIC(19,9385,1,8,0)="received, and the percentage of normal stock level on hand before the"
^DIC(19,9385,1,9,0)="receipt was posted to the inventory.  If the operator has specified"
^DIC(19,9385,1,10,0)="that s/he wishes to keep a detailed inventory transaction history, this"
^DIC(19,9385,1,11,0)="file is also updated."
^DIC(19,9385,1,12,0)="  For nonrecurring items, the process updates only the distribution"
^DIC(19,9385,1,13,0)="history for the inventory point receiving the item."
^DIC(19,9385,20)=""
^DIC(19,9385,25)="PRCPPOLM"
^DIC(19,9385,99)="53837,30347"
^DIC(19,9385,"U")="PURCHASE ORDER RECEIVING TO IN"
^DIC(19,9386,0)="PRCP PURGE MENU^Purge History Files Menu^^M^11740^^^^^^^^^1"
^DIC(19,9386,1,0)="^^2^2^2920211^^^^"
^DIC(19,9386,1,1,0)="This menu contains options allowing the user to purge various history"
^DIC(19,9386,1,2,0)="files, in order to free up disk space."
^DIC(19,9386,10,0)="^19.01PI^5^4"
^DIC(19,9386,10,1,0)="9387^^"
^DIC(19,9386,10,2,0)="9389^^"
^DIC(19,9386,10,4,0)="9390^^"
^DIC(19,9386,10,5,0)="9402^^"
