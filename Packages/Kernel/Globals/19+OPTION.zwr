^DIC(19,12214,0)="DGRU ENTER/EDIT WARD RAI DATA^Enter/Edit Ward RAI Data^^E^10000000020^^^^^^y^114^y"
^DIC(19,12214,1,0)="^^2^2^3020125^"
^DIC(19,12214,1,1,0)="Used to enter the RAI/MDS Ward field and Intermediate Medicine - LTC"
^DIC(19,12214,1,2,0)="field, in the Ward Location file."
^DIC(19,12214,10.1)="Enter/Edit Ward RAI Data"
^DIC(19,12214,30)="DIC(42,"
^DIC(19,12214,31)="AEQM"
^DIC(19,12214,32)="Select Ward:"
^DIC(19,12214,50)=42
