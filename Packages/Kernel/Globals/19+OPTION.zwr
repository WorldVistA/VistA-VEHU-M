^DIC(19,3385,0)="XT-VERSION NUMBER^Version Number Update^^R^11748^XUPROGMODE^^^^^^^y^"
^DIC(19,3385,1,0)="^^2^2^2891015^^^^"
^DIC(19,3385,1,1,0)="This option runs XTVNUM that will update or set the version"
^DIC(19,3385,1,2,0)="number into a set of routines."
^DIC(19,3385,25)="XTVNUM"
^DIC(19,3385,"U")="VERSION NUMBER UPDATE"
^DIC(19,3386,0)="XT-VARIABLE CHANGER^Variable changer^^R^.5^XUPROGMODE^^^^^^^^"
^DIC(19,3386,1,0)="^^3^3^2880401^^"
^DIC(19,3386,1,1,0)="This option runs routine XTVCHG that does a fair job of changing"
^DIC(19,3386,1,2,0)="all occurrences of a variable to another.  It changes DO's and GOTO's"
^DIC(19,3386,1,3,0)="also but doesn't change the TAG."
^DIC(19,3386,25)="XTVCHG"
^DIC(19,3386,99)="54808,50981"
^DIC(19,3386,"U")="VARIABLE CHANGER"
^DIC(19,3387,0)="XT-NUMBER BASE CHANGER^Number base changer^^R^.5^XUPROGMODE^^^^^^^^"
^DIC(19,3387,1,0)="^^2^2^2880401^^"
^DIC(19,3387,1,1,0)="This option runs a number base calculator.  It allows input in"
^DIC(19,3387,1,2,0)="base 2,8,10,16 and displays the number in all 4 bases."
^DIC(19,3387,25)="XTBASE"
^DIC(19,3387,"U")="NUMBER BASE CHANGER"
^DIC(19,3388,0)="XT-ROUTINE COMPARE^Compare two routines^^R^.5^^^^^^^^^"
^DIC(19,3388,1,0)="^^3^3^2910722^"
^DIC(19,3388,1,1,0)="This option will allow you to compare two routines located in the current"
^DIC(19,3388,1,2,0)="account and print a list of differences.  It uses the MailMan compare routine"
^DIC(19,3388,1,3,0)="to do the work."
^DIC(19,3388,25)="XTRCMP"
^DIC(19,3388,"U")="COMPARE TWO ROUTINES"
^DIC(19,3389,0)="XT-DDMAP^DD pointer relations map^^R^.5^^^^^^^"
^DIC(19,3389,1,0)="3^^3^3^2880401^^"
^DIC(19,3389,1,1,0)="This option prints a map of the pointer relations between a group of"
^DIC(19,3389,1,2,0)="files. The file selection is from the package file or entered"
^DIC(19,3389,1,3,0)="individually."
^DIC(19,3389,25)="DDMAP"
^DIC(19,3389,136)=""
^DIC(19,3389,"U")="DD POINTER RELATIONS MAP"
^DIC(19,3390,0)="XUFILELIST^List Access to Files by File number^^R^11748^^^^^^^^n^^"
^DIC(19,3390,1,0)="^19.06^2^2^3021204^^^^"
^DIC(19,3390,1,1,0)="This option lists, by file number, those users who have access to the"
^DIC(19,3390,1,2,0)="range of files selected and what that access is."
^DIC(19,3390,25)="ACC^XUFILE1"
^DIC(19,3390,"U")="LIST ACCESS TO FILES BY FILE N"
^DIC(19,3392,0)="XQHELPFIX^Fix Help Frame File Pointers^^A^1039^^^^^^^^^1^^"
^DIC(19,3392,1,0)="4^^2^2^2880504^^"
^DIC(19,3392,1,1,0)="This option scans thru the help frame file for dangling pointers."
^DIC(19,3392,1,2,0)="It deletes keywords which point to help frames that no longer exist."
^DIC(19,3392,20)="S %=0 D ENASK^XQ3"
^DIC(19,3392,155)=""
^DIC(19,3392,"U")="FIX HELP FRAME FILE POINTERS"
^DIC(19,3393,0)="XUVERSIONEW-HELP^Kernel New Features Help^^A^1039^^^^^^^^^1^^"
^DIC(19,3393,1,0)="^^2^2^2900313^^^^"
^DIC(19,3393,1,0,"LE")=1
^DIC(19,3393,1,1,0)="This option will direct you to a series of help frames describing the"
^DIC(19,3393,1,2,0)="new features of the Kernel."
^DIC(19,3393,20)="S XQH=""XUDOC NEW FEATURES*"" D EN^XQH"
^DIC(19,3393,"U")="KERNEL NEW FEATURES HELP"
^DIC(19,3395,0)="XUFAIL^Failed Access Attempts Log^^P^11748^^^^^^^^n^^"
^DIC(19,3395,1,0)="^^2^2^2881222^^^^"
^DIC(19,3395,1,1,0)="Prints list by date/time of those users who have failed access"
^DIC(19,3395,1,2,0)="into the system."
^DIC(19,3395,60)="%ZUA(3.05,"
^DIC(19,3395,62)=0
^DIC(19,3395,63)="[XUUFAA]"
^DIC(19,3395,64)="[XUUFAA]"
^DIC(19,3395,65)=""
^DIC(19,3395,66)=""
^DIC(19,3395,"U")="FAILED ACCESS ATTEMPTS LOG"
^DIC(19,3396,0)="XUFDISP^User Failed Access Attempts^^P^11748^^^^^^^^n^^"
^DIC(19,3396,1,0)="^^3^3^2880401^^^"
^DIC(19,3396,1,1,0)="Display of user failed access attempts, sorts on name then date/time"
^DIC(19,3396,1,2,0)="of attempt.  Prompts for device.  Gives subtotals by user, total for"
^DIC(19,3396,1,3,0)="all failed access attempts."
^DIC(19,3396,60)="%ZUA(3.05,"
^DIC(19,3396,62)=0
^DIC(19,3396,63)="[XUFDISPLAY]"
^DIC(19,3396,64)="[XUFDISPS]"
^DIC(19,3396,99.1)="56665,39870"
^DIC(19,3396,"U")="USER FAILED ACCESS ATTEMPTS"
^DIC(19,3397,0)="XUFPURGE^Failed Access Attempts Log Purge^^R^11748^^^^^^^^n^^"
^DIC(19,3397,1,0)="^^3^3^2880401^^"
^DIC(19,3397,1,1,0)="Asks for a beginning and ending date to purge all those entries"
^DIC(19,3397,1,2,0)="in that range.  Also asks for a date/time when this task will"
^DIC(19,3397,1,3,0)="be queued to run."
^DIC(19,3397,25)="FAPURGE^XUAPURGE"
^DIC(19,3397,99.1)="56665,39870"
^DIC(19,3397,"U")="FAILED ACCESS ATTEMPTS LOG PUR"
^DIC(19,3398,0)="XUFDEV^Device Failed Access Attempts^^P^11748^^^^^^^^n^^"
^DIC(19,3398,1,0)="^^4^4^2880714^^^"
^DIC(19,3398,1,1,0)="This display sorts on device then date/time of attempt."
^DIC(19,3398,1,2,0)="Gives subtotal of attempts for each device and a total of all"
^DIC(19,3398,1,3,0)="those attempts requested in sort.  Prompts for a print device "
^DIC(19,3398,1,4,0)="to generate a hard copy if desired."
^DIC(19,3398,60)="%ZUA(3.05,"
^DIC(19,3398,62)=0
^DIC(19,3398,63)="[XUDFDISPLAY]"
^DIC(19,3398,64)="[XUDFDISPS]"
^DIC(19,3398,"U")="DEVICE FAILED ACCESS ATTEMPTS"
^DIC(19,3399,0)="XUPMDISP^Display of Programmer Mode Entry List^^P^11748^^^^^^y^^n^^"
^DIC(19,3399,1,0)="^^3^3^2880401^^^^"
^DIC(19,3399,1,1,0)="This displays which users entered into programmer mode, sorts"
^DIC(19,3399,1,2,0)="by user name then date/time.  Prompts for print device to"
^DIC(19,3399,1,3,0)="generate a hard copy if desired.  Gives count of entries by user."
^DIC(19,3399,60)="%ZUA(3.07,"
^DIC(19,3399,62)=0
^DIC(19,3399,63)="[XUPMDISPLAY]"
^DIC(19,3399,64)="[XUPMDISPS]"
^DIC(19,3399,"U")="DISPLAY OF PROGRAMMER MODE ENT"
^DIC(19,3400,0)="XUPMPURGE^Programmer Mode Entry Log Purge^^R^11748^^^^^^^^n^^"
^DIC(19,3400,1,0)="^^2^2^2880401^"
^DIC(19,3400,1,1,0)="This option runs the routine XUPMPURG to purge the log of programmer"
^DIC(19,3400,1,2,0)="mode entry."
^DIC(19,3400,25)="PMPURGE^XUAPURGE"
^DIC(19,3400,"U")="PROGRAMMER MODE ENTRY LOG PURG"
^DIC(19,3401,0)="XUOPTLOG^Audited Options Log^^P^11748^^^^^^^^n^^"
^DIC(19,3401,1,0)="^^2^2^2880401^^"
^DIC(19,3401,1,1,0)="This report sorts on date/time then option, prints all data"
^DIC(19,3401,1,2,0)="elements of each entry requested."
^DIC(19,3401,60)="XUSEC(19,"
^DIC(19,3401,62)=0
^DIC(19,3401,63)="[XUOPTLOGP]"
^DIC(19,3401,64)="[XUOPTLOGS]"
^DIC(19,3401,"U")="AUDITED OPTIONS LOG"
^DIC(19,3402,0)="XUOPTDISP^Option Audit Display^^P^11748^^^^^^y^^n^^"
^DIC(19,3402,1,0)="^^2^2^2880401^^"
^DIC(19,3402,1,1,0)="This display sorts on option then date/time.  Also prompts for"
^DIC(19,3402,1,2,0)="print device to generate a hard copy of listing."
^DIC(19,3402,60)="XUSEC(19,"
^DIC(19,3402,62)=0
^DIC(19,3402,63)="[XUOPTDISPLAY]"
^DIC(19,3402,64)="[XUOPTDISPS]"
^DIC(19,3402,"U")="OPTION AUDIT DISPLAY"
^DIC(19,3403,0)="XUUSEROPT^User Audit Display^^P^11748^^^^^^y^^n^^"
^DIC(19,3403,1,0)="^^2^2^2880401^^"
^DIC(19,3403,1,1,0)="This display sorts by user then by option.  Also prompts for"
^DIC(19,3403,1,2,0)="print device to generate a hard copy listing."
^DIC(19,3403,60)="XUSEC(19,"
^DIC(19,3403,62)=0
^DIC(19,3403,63)="[XUUSEROPTP]"
^DIC(19,3403,64)="[XUUSEROPTS]"
^DIC(19,3403,"U")="USER AUDIT DISPLAY"
^DIC(19,3404,0)="XUOPTPURGE^Audited Options Purge^^R^11748^^^^^^^^n^^"
^DIC(19,3404,1,0)="^^2^2^2881112^^^"
^DIC(19,3404,1,1,0)="This prompts for a beginning and ending date AND time to purge the"
^DIC(19,3404,1,2,0)="Option Audit entries.  Also prompts for when the task will be run."
^DIC(19,3404,25)="OPTPURGE^XUAPURGE"
^DIC(19,3404,"U")="AUDITED OPTIONS PURGE"
^DIC(19,3405,0)="XUAUDIT^Establish System Audit Parameters^^A^11748^^^^^^^^n^1^"
^DIC(19,3405,1,0)="^^3^3^2941117^^^"
^DIC(19,3405,1,1,0)="This establishes the audit parameters for which option, namespace,"
^DIC(19,3405,1,2,0)="user, device and failed access attempt to audit.  Includes date to"
^DIC(19,3405,1,3,0)="initiate and terminate this audit function."
^DIC(19,3405,20)="S DA=1,DIE=""^XTV(8989.3,"",DR=""[XUAUDIT]"" D XUDIE^XUS5 K DA,DIE,DR"
^DIC(19,3405,30)=""
^DIC(19,3405,31)=""
^DIC(19,3405,50)=""
^DIC(19,3405,51)=""
^DIC(19,3405,"U")="ESTABLISH SYSTEM AUDIT PARAMET"
^DIC(19,3406,0)="DIVERIFY^Verify Fields^^A^1^^^^^^y^^n^1^^"
^DIC(19,3406,1,0)="^^4^4^2890316^^^"
^DIC(19,3406,1,1,0)="This option is used to double check the data that exists in a field"
^DIC(19,3406,1,2,0)="to see that it matches the Data Dictionary specifications.  The user"
^DIC(19,3406,1,3,0)="is allowed to store the discrepancies in a search template so that they"
^DIC(19,3406,1,4,0)="can easily be retrieved for examination and correction."
^DIC(19,3406,20)="S DI=1 G EN^DIU"
^DIC(19,3406,"U")="VERIFY FIELDS"
^DIC(19,3407,0)="DIXREF^Cross-Reference A Field^^A^1^^^^^^^^n^1^^"
^DIC(19,3407,1,0)="^^5^5^2980908^^"
^DIC(19,3407,1,1,0)="The Cross-Reference a Field sub-option of the Utility Functions option"
^DIC(19,3407,1,2,0)="allows you to identify a field or sub-field for cross-referencing or"
^DIC(19,3407,1,3,0)="for removing cross-referencing from an identified field."
^DIC(19,3407,1,4,0)="VA FileMan currently has seven types of cross-references -- Regular,"
^DIC(19,3407,1,5,0)="KWIC, Mnemonic, MUMPS, Soundex, Trigger and Bulletin."
^DIC(19,3407,20)="S DI=2 G EN^DIU"
^DIC(19,3407,"U")="CROSS-REFERENCE A FIELD"
^DIC(19,3408,0)="DIIDENT^Identifier^^A^1^^^^^^^^n^1^^"
^DIC(19,3408,1,0)="^^4^4^2890316^"
^DIC(19,3408,1,1,0)="Use the Identifier sub-option of the Utility Functions option to associate"
^DIC(19,3408,1,2,0)="a field with the .01 (or NAME) field of a file.  The field designated as"
^DIC(19,3408,1,3,0)="an identifier can be displayed along with the selected entry to help"
^DIC(19,3408,1,4,0)="a user positively identify the entry."
^DIC(19,3408,20)="S DI=3 G EN^DIU"
^DIC(19,3408,"U")="IDENTIFIER"
^DIC(19,3409,0)="DIRDEX^Re-Index File^^A^1^^^^^^^^n^1^^"
^DIC(19,3409,1,0)="^^4^4^2890316^"
^DIC(19,3409,1,1,0)="The Re-index a File sub-option of the Utility Functions option allows"
^DIC(19,3409,1,2,0)="you to re-index a file.  This VA FileMan feature is especially helpful"
^DIC(19,3409,1,3,0)="when you create a new cross reference on a field that already contains"
^DIC(19,3409,1,4,0)="data."
^DIC(19,3409,20)="S DI=4 G EN^DIU"
^DIC(19,3409,"U")="RE-INDEX FILE"
^DIC(19,3410,0)="DIITRAN^Input Transform (Syntax)^^A^1^^^^^^^^n^1^^"
^DIC(19,3410,1,0)="^^4^4^2901212^^^"
^DIC(19,3410,1,1,0)="The Input Transform sub-option of the Utility Functions option allows"
^DIC(19,3410,1,2,0)="you to enter an executable string of MUMPS code which is used to check"
^DIC(19,3410,1,3,0)="the validity of user input and will then convert the input into an"
^DIC(19,3410,1,4,0)="internal form for storage."
^DIC(19,3410,20)="Q:DUZ(0)'=""@""  S DI=5 G EN^DIU"
^DIC(19,3410,"U")="INPUT TRANSFORM (SYNTAX)"
^DIC(19,3411,0)="DIEDFILE^Edit File^^A^1^^^^^^^^n^1^^"
^DIC(19,3411,1,0)="^^3^3^2890316^^"
^DIC(19,3411,1,1,0)="This option allows the user to document and control a file.  The user"
^DIC(19,3411,1,2,0)="may describe the purpose of the file, assign it security, indicate"
^DIC(19,3411,1,3,0)="application groups which use the file, and change the name of the file."
^DIC(19,3411,20)="S DI=6 G EN^DIU"
^DIC(19,3411,"U")="EDIT FILE"
^DIC(19,3412,0)="DIOTRAN^Output Transform^^A^1^^^^^^^^n^1^^"
^DIC(19,3412,1,0)="^^3^3^2890316^"
^DIC(19,3412,1,1,0)="The Output Transform sub-option of the Utility Functions option allows"
^DIC(19,3412,1,2,0)="you to enter an executable string of MUMPS code which converts internally"
^DIC(19,3412,1,3,0)="stored data into a readable display."
^DIC(19,3412,20)="S DI=7 G EN^DIU"
^DIC(19,3412,"U")="OUTPUT TRANSFORM"
^DIC(19,3413,0)="DITEMP^Template Edit^^A^1^^^^^^^^n^1^^"
^DIC(19,3413,1,0)="^^4^4^2890316^"
^DIC(19,3413,1,1,0)="The Template Edit sub-option of the Utility Functions option allows you"
^DIC(19,3413,1,2,0)="to enter a description of any sort, print or input templates in a selected"
^DIC(19,3413,1,3,0)="file.  These descriptions will be printed when you request a Templates"
^DIC(19,3413,1,4,0)="Only data dictionary listing."
^DIC(19,3413,20)="S DI=8 G EN^DIU"
^DIC(19,3413,99.1)="61968,50667"
^DIC(19,3413,"U")="TEMPLATE EDIT"
^DIC(19,3414,0)="DIUNEDIT^Uneditable Data^^A^1^^^^^^^^n^1^^"
^DIC(19,3414,1,0)="^19.06^4^4^3150720^^"
^DIC(19,3414,1,1,0)="The Uneditable Data sub-option of the Utility Functions option allows you"
^DIC(19,3414,1,2,0)="to specify a particular field that CANNOT be edited or deleted by a user."
^DIC(19,3414,1,3,0)="If an uneditable data field is edited, VA FileMan will display the field"
^DIC(19,3414,1,4,0)="value along with one of the famous 'No Editing' messages."
^DIC(19,3414,20)="S DI=9 G EN^DIU"
^DIC(19,3414,"U")="UNEDITABLE DATA"
^DIC(19,3415,0)="XUFILEGRANT^Grant Users' Access to a Set of Files^^R^1^XUMGR^^^^^^^n^1^1^"
^DIC(19,3415,1,0)="^19.06^4^4^3230724^^^^"
^DIC(19,3415,1,1,0)="This option is used to give one or more users access to selected files."
^DIC(19,3415,1,2,0)="You may enter an individual file number, a range of numbers, and/or a"
^DIC(19,3415,1,3,0)="list of file numbers.  Remember, you can only give out access to files"
^DIC(19,3415,1,4,0)="to which you have access."
^DIC(19,3415,3)=""
^DIC(19,3415,15)="K V,W,C,DI,DISYS,DQ,%X,%Y,DLAYGO S DUZ(0)=$G(R2DUZ)"
^DIC(19,3415,20)="S R2DUZ=$G(DUZ(0)),DUZ(0)=""@"""
^DIC(19,3415,25)="XUFILE"
^DIC(19,3415,99.1)="62537,37533"
^DIC(19,3415,"U")="GRANT USERS' ACCESS TO A SET O"
^DIC(19,3416,0)="XUFILESETDELETE^Delete Users' Access to a Set of Files^^R^11748^^^^^^^^n^^"
^DIC(19,3416,1,0)="^19.06^3^3^3021204^^^^"
^DIC(19,3416,1,1,0)="This option deletes the access to files held by one or more users."
^DIC(19,3416,1,2,0)="You may enter an individual file number, a range of numbers, and/or"
^DIC(19,3416,1,3,0)="a list of file numbers."
^DIC(19,3416,25)="XUDEL^XUFILE"
^DIC(19,3416,"U")="DELETE USERS' ACCESS TO A SET "
^DIC(19,3417,0)="XUFILEPRINT^Print Users Files^^P^11748^^^^^^^^^^1^^"
^DIC(19,3417,1,0)="^19.06^2^2^3021205^^^^"
^DIC(19,3417,1,1,0)="This option lists, by user, each file the user has access to and what"
^DIC(19,3417,1,2,0)="that access is.  Users who have no access are not listed."
^DIC(19,3417,15)="K %ZISI,B,P,DIJ,DISYS"
^DIC(19,3417,60)="VA(200,"
^DIC(19,3417,62)=0
^DIC(19,3417,63)="[XUFILEOFILES]"
^DIC(19,3417,64)=""
^DIC(19,3417,65)=""
^DIC(19,3417,66)=""
^DIC(19,3417,69)="I '$P(^VA(200,D0,0),U,11),$P(^(0),U,4)=""@""!($N(^(""FOF"",0))>0)"
^DIC(19,3417,71)=""
^DIC(19,3417,"U")="PRINT USERS FILES"
