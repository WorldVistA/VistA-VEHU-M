^DIC(19,7888,"U")="FIZZIES"
^DIC(19,7889,0)="ENXL-LOC-REPORT^Report Free-Text Locations^^R^.5^^^^^^^33^^1"
^DIC(19,7889,1,0)="^^16^16^2931206^^^"
^DIC(19,7889,1,1,0)="This option generates a report of any free-text values that reside"
^DIC(19,7889,1,2,0)="in the location field of a user-specified file. Either the Work Order"
^DIC(19,7889,1,3,0)="file (#6920) or the Equipment Inventory file (#6914) can be selected."
^DIC(19,7889,1,4,0)=" "
^DIC(19,7889,1,5,0)="The location field in both these files became a pointer type field to"
^DIC(19,7889,1,6,0)="the Space file during installation of Engineering version 7. Some"
^DIC(19,7889,1,7,0)="location values in these files may not have been converted to pointers."
^DIC(19,7889,1,8,0)=" "
^DIC(19,7889,1,9,0)="The report will list each unique free-text location, the number of"
^DIC(19,7889,1,10,0)="records in the file with that location, and if the location would"
^DIC(19,7889,1,11,0)="be converted to a pointer by the 'Convert Free-Text Locations'"
^DIC(19,7889,1,12,0)="option. A free-text location can be converted to a pointer if it matches"
^DIC(19,7889,1,13,0)="a Space file Room Number or Synonym field. A leading '*' in the free"
^DIC(19,7889,1,14,0)="text value will be ignored when checking for a match."
^DIC(19,7889,1,15,0)=" "
^DIC(19,7889,1,16,0)="See the 'Convert Free-Text Locations' option for more information."
^DIC(19,7889,20)="S ENCVTM=0"
^DIC(19,7889,25)="EN^ENXLFIX"
^DIC(19,7889,99.1)="55852,41677"
^DIC(19,7889,"U")="REPORT FREE-TEXT LOCATIONS"
^DIC(19,7890,0)="ENXL-LOC-CONVERT^Convert Free-Text Locations^^R^.5^^^^^^^33^^1"
^DIC(19,7890,1,0)="^^21^21^2931206^^"
^DIC(19,7890,1,1,0)="This option converts free-text values that reside in the location"
^DIC(19,7890,1,2,0)="field of a user-specified file to Space file pointers. Either the"
^DIC(19,7890,1,3,0)="Work Order file (#6920) or the Equipment Inventory file (#6914)"
^DIC(19,7890,1,4,0)="can be selected."
^DIC(19,7890,1,5,0)=" "
^DIC(19,7890,1,6,0)="The location field in both these files became a pointer type field"
^DIC(19,7890,1,7,0)="to the Space file during installation of Engineering Version 7. Some"
^DIC(19,7890,1,8,0)="location values in these files may not have been converted to pointers."
^DIC(19,7890,1,9,0)=" "
^DIC(19,7890,1,10,0)="A free-text location will be converted to a pointer if it matches"
^DIC(19,7890,1,11,0)="a value in the Space file Room Number or Synonym fields. A leading"
^DIC(19,7890,1,12,0)="'*' will be ignored when checking for a match."
^DIC(19,7890,1,13,0)=" "
^DIC(19,7890,1,14,0)="Any free-text locations that cannot be converted will be marked with"
^DIC(19,7890,1,15,0)="a leading astrisk '*'. The leading '*' ensures that these values will"
^DIC(19,7890,1,16,0)="not be inappropriately evaluated as pointers. This will solve the"
^DIC(19,7890,1,17,0)="'illegal number' errors and bogus displays that could result from"
^DIC(19,7890,1,18,0)="free-text locations that began with a numeric value."
^DIC(19,7890,1,19,0)=" "
^DIC(19,7890,1,20,0)="This option can be run multiple times if desired."
^DIC(19,7890,1,21,0)="See the 'Report Free-Text Locations' option for more information."
^DIC(19,7890,20)="S ENCVTM=1"
^DIC(19,7890,25)="EN^ENXLFIX"
^DIC(19,7890,99)="55854,58900"
^DIC(19,7890,99.1)="55852,41677"
^DIC(19,7890,"U")="CONVERT FREE-TEXT LOCATIONS"
^DIC(19,7893,0)="PRSA TD EDIT^Enter/Edit Tour of Duty^^R^.5^^^^^^^"
^DIC(19,7893,1,0)="^^8^8^2931118^^^^"
^DIC(19,7893,1,1,0)="This option allows the user to create a new tour or to select an"
^DIC(19,7893,1,2,0)="existing tour. The user may enter the data for the new tour or edit"
^DIC(19,7893,1,3,0)="the data on the existing tour."
^DIC(19,7893,1,4,0)=" "
^DIC(19,7893,1,5,0)="The user will be asked for the tour description, length of meal time,"
^DIC(19,7893,1,6,0)="whether the meal time is subject to premium pay, whether the tour"
^DIC(19,7893,1,7,0)="spans two calendar days, whether the tour is available to all time"
^DIC(19,7893,1,8,0)="and leave units and the start/stop times for each segment of the tour."
^DIC(19,7893,25)="EDIT^PRSATD1"
^DIC(19,7893,99)="55500,49765"
^DIC(19,7893,"U")="ENTER/EDIT TOUR OF DUTY"
^DIC(19,7894,0)="PRSA TD DISP^Display Tour of Duty^^R^.5^^^^^^^"
^DIC(19,7894,1,0)="^^8^8^2930202^^^^"
^DIC(19,7894,1,1,0)="This option will prompt the user to select an established tour of"
^DIC(19,7894,1,2,0)="duty. It will display the tour description, length of meal time,"
^DIC(19,7894,1,3,0)="whether meal time is subject to premium pay, whether the tour spans"
^DIC(19,7894,1,4,0)="two calendar days, whether the tour is available to all time and leave"
^DIC(19,7894,1,5,0)="units, and the start/stop times for each segment of the tour."
^DIC(19,7894,1,6,0)=" "
^DIC(19,7894,1,7,0)="This option merely displays the tour information. You may not edit"
^DIC(19,7894,1,8,0)="the tour with this option."
^DIC(19,7894,25)="DISP^PRSATD1"
^DIC(19,7894,99)="55500,48170"
^DIC(19,7894,"U")="DISPLAY TOUR OF DUTY"
^DIC(19,7895,0)="PRSA OT REQ^Enter OT and CT/CH Requests^^R^11596^^^^^^^230"
^DIC(19,7895,1,0)="5^^7^7^2980518^^^^"
^DIC(19,7895,1,1,0)="This option allows the user to enter a request for an employee to"
^DIC(19,7895,1,2,0)="work overtime or compensatory time/credit hours.  Select an employee"
^DIC(19,7895,1,3,0)="and enter date the work is to be performed, type of time worked,"
^DIC(19,7895,1,4,0)="number of hours to be worked, time and leave unit where the work"
^DIC(19,7895,1,5,0)="will be performed, and the justification for making this request. "
^DIC(19,7895,1,6,0)="For compensatory time/credit hours the justification should include"
^DIC(19,7895,1,7,0)="whether the requests is for comp time or credit hours. "
^DIC(19,7895,25)="PRSAOTR"
^DIC(19,7895,99)="55525,57784"
^DIC(19,7895,"U")="ENTER OT AND CT/CH REQUESTS"
