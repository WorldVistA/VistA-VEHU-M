^DIC(19,8427,0)="LR WKLD COMMENTS^Edit workload comments^^E^.5^^^^^^^26"
^DIC(19,8427,1,0)="^^7^7^2940328^^^"
^DIC(19,8427,1,1,0)="  This option permits the editing of Workload Comments. This "
^DIC(19,8427,1,2,0)="should be used to record special situation or changes in methods of"
^DIC(19,8427,1,3,0)="doing or recording workload."
^DIC(19,8427,1,4,0)="  You may edit comments for following :"
^DIC(19,8427,1,5,0)="    1) The institution (Lab)"
^DIC(19,8427,1,6,0)="    2) The WKLD Code itself"
^DIC(19,8427,1,7,0)="    3) Make comments for a specific date(s)"
^DIC(19,8427,30)="LRO(64.1,"
^DIC(19,8427,31)="AEMQL"
^DIC(19,8427,50)="LRO(64.1,"
^DIC(19,8427,51)="[LR WKLD COMMENTS]"
