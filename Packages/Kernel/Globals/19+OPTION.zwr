^DIC(19,16344,0)="EHM-01165^HT Previous Enrollment Health Factor Search^^R^1^^^^^^^534^^^^"
^DIC(19,16344,1,0)="^19.06^5^5^3240328^^^"
^DIC(19,16344,1,1,0)="This option will search the Clinical Reminders Index for any "
^DIC(19,16344,1,2,0)="occurrences of the CCHT ENROLLMENT-START DATE (PREV ENROLL) and HT "
^DIC(19,16344,1,3,0)="ENROLLMENT-START DATE (PREV ENROLL) health factors.  For any occurrence "
^DIC(19,16344,1,4,0)="found, the report will output the patient name, SSN, and visit date."
^DIC(19,16344,1,5,0)="Cloned from ""PXRM HT HEALTH FACTOR"" option."
