^DIC(19,7792,25)="FBCHVP"
^DIC(19,7792,"U")="CH DELETE VOID PAYMENT"
^DIC(19,7793,0)="FBCNH VOID PAYMENT^CNH Void Payment^^R^1^FBAA LEVEL 2^^^^^^344^^1"
^DIC(19,7793,1,0)="^19.06^3^3^3140516^^"
^DIC(19,7793,1,1,0)="Searches all finalized payments that do not contain a VOID status for"
^DIC(19,7793,1,2,0)="a specific patient and vendor.  Provides user with a list of payments from"
^DIC(19,7793,1,3,0)="which they may choose to void one/many/all."
^DIC(19,7793,20)="S FBTYPE=7"
^DIC(19,7793,25)="FBCHVP"
^DIC(19,7793,"U")="CNH VOID PAYMENT"
^DIC(19,7794,0)="FBCNH DELETE VOID^CNH Delete Void Payment^^R^1^FBAA LEVEL 2^^^^^^344^^1"
^DIC(19,7794,1,0)="^19.06^3^3^3140516^^^"
^DIC(19,7794,1,1,0)="Searches all finalized payments that contain a VOID status for a"
^DIC(19,7794,1,2,0)="specific patient and vendor.  Provides user with a list of Voided payments"
^DIC(19,7794,1,3,0)="from which they may choose to cancel the void on one/many/all."
^DIC(19,7794,20)="S FBTYPE=7,FBVOID=1"
^DIC(19,7794,25)="FBCHVP"
^DIC(19,7794,"U")="CNH DELETE VOID PAYMENT"
^DIC(19,7795,0)="FBAA MRA PURGE AUTO^Automatically Purge MRA's^^R^.5^^^^^^^"
^DIC(19,7795,1,0)="^^7^7^2960222^"
^DIC(19,7795,1,1,0)="This option is taskable, and will purge transmitted MRA's.  It should be"
^DIC(19,7795,1,2,0)="used only when you are sure Austin has received your MRA transmissions,"
^DIC(19,7795,1,3,0)="since use of this option will prevent you from being able to re-transmit"
^DIC(19,7795,1,4,0)="MRA's."
^DIC(19,7795,1,5,0)="Upon successful completion of the purge, a mail message will be sent to"
^DIC(19,7795,1,6,0)="a mail group confirming the purge specifics."
^DIC(19,7795,1,7,0)="Remember to add a mail group to the FBAA PURGE TRANSMITTED MRA'S bulletin."
^DIC(19,7795,25)="FBAAMPG1"
^DIC(19,7795,"U")="AUTOMATICALLY PURGE MRA'S"
^DIC(19,7796,0)="FBAA MRA SERVER^Fee Basis MRA Mail Message Server^^S^.5^^^^^^^344"
^DIC(19,7796,1,0)="^^2^2^2940222^^^^"
^DIC(19,7796,1,1,0)="This server processes all incoming MRA messages received"
^DIC(19,7796,1,2,0)="through Mailman from Austin."
^DIC(19,7796,25)="FBMRASVR"
^DIC(19,7796,220)="^R^20^N^N^N"
^DIC(19,7796,"U")="FEE BASIS MRA MAIL MESSAGE SER"
^DIC(19,7797,0)="FBCNH CANCEL 7078^Cancel Authorization Entered in Error^^R^1^FBAA LEVEL 2^^^^^^"
^DIC(19,7797,1,0)="^19.06^3^3^3140513^^^"
^DIC(19,7797,1,1,0)="This option should be used when an authorization has been set up and"
^DIC(19,7797,1,2,0)="has been determined that it was entered in error.  Once cancelled,"
^DIC(19,7797,1,3,0)="a user can re-enter the correct authorization."
^DIC(19,7797,25)="CNH^FBCHC78"
^DIC(19,7797,99)="55610,33111"
^DIC(19,7797,"U")="CANCEL AUTHORIZATION ENTERED I"
^DIC(19,7798,0)="FBUC ENTER^Enter Unauthorized Claim^^R^1^FBAA LEVEL 1 AUTH^^^^^^"
^DIC(19,7798,1,0)="^19.06^7^7^3070404^^^^"
^DIC(19,7798,1,1,0)="Enter a new unauthorized claim.  If you have indicated that you will be"
^DIC(19,7798,1,2,0)="tracking incomplete claims in your Fee Basis Site Parameters file, you may "
^DIC(19,7798,1,3,0)="enter an incomplete claim.  If you have not entered anything in the "
^DIC(19,7798,1,4,0)="parameter, you can only enter complete unauthorized claims."
^DIC(19,7798,1,5,0)="  "
^DIC(19,7798,1,6,0)="A claim is considered complete when a VA form 10-583 and all documentation"
^DIC(19,7798,1,7,0)="has been received in order to determine legal and medical entitlement."
^DIC(19,7798,25)="FBUCEN"
^DIC(19,7798,99)="55647,57709"
^DIC(19,7798,"U")="ENTER UNAUTHORIZED CLAIM"
^DIC(19,7799,0)="FBUC MODIFY UNAUTHORIZED CLAIM^Modify Unauthorized Claim^^R^1^FBAA LEVEL 1 AUTH^^^^^^"
^DIC(19,7799,1,0)="^19.06^2^2^3070403^^^"
^DIC(19,7799,1,1,0)="Edit an unauthorized claim.  Only claims which were never dispositioned"
^DIC(19,7799,1,2,0)="may be edited."
^DIC(19,7799,25)="EDT^FBUCED"
^DIC(19,7799,"U")="MODIFY UNAUTHORIZED CLAIM"
^DIC(19,7800,0)="FBUC DISPOSITION UNAUTH CLAIM^Disposition Unauthorized Claim^^R^1^FBAA LEVEL 1 AUTH^^^^^^"
^DIC(19,7800,1,0)="^19.06^4^4^3070403^^^^"
^DIC(19,7800,1,1,0)="Disposition an unauthorized claim.  Any claim may be selected."
^DIC(19,7800,1,2,0)="If the disposition reason is changed from APPROVED to a reason other than"
^DIC(19,7800,1,3,0)="APPROVED, and payments have been made, only a user who holds the"
^DIC(19,7800,1,4,0)="supervisor's security key may change the disposition."
^DIC(19,7800,25)="DIS^FBUCED"
^DIC(19,7800,99)="55787,64747"
^DIC(19,7800,"U")="DISPOSITION UNAUTHORIZED CLAIM"
^DIC(19,7801,0)="FBUC REOPEN^Re-open Unauthorized Claim^^R^1^FBAA LEVEL 1 AUTH^^^^^^"
^DIC(19,7801,1,0)="^19.06^4^4^3070403^^^^"
^DIC(19,7801,1,1,0)="Reopen a claim which has been dispositioned.  This is essentially the same"
^DIC(19,7801,1,2,0)="as the MODIFY UNAUTHORIZED CLAIM option, only selection is limited to claims"
^DIC(19,7801,1,3,0)="with a status of DISPOSITIONED, and the date the claim was reopened is"
^DIC(19,7801,1,4,0)="entered."
^DIC(19,7801,25)="REO^FBUCED"
^DIC(19,7801,99)="55644,52684"
^DIC(19,7801,"U")="RE-OPEN UNAUTHORIZED CLAIM"
^DIC(19,7802,0)="FBUC INITIATE APPEAL^Initiate Appeal for Unauthorized Claim^^R^1^FBAA LEVEL 1 AUTH DISABLE 2^^^^^^^^"
^DIC(19,7802,1,0)="^19.06^3^3^3260331^^^^"
^DIC(19,7802,1,1,0)="Initiate an appeal to Board of Veterans Appeals (BVA)."
^DIC(19,7802,1,2,0)="  "
^DIC(19,7802,1,3,0)="Selection of claims is limited to only those claims which have a status of DISPOSITIONED."
^DIC(19,7802,20)=""
^DIC(19,7802,25)="APL^FBUCED"
^DIC(19,7802,"U")="INITIATE APPEAL FOR UNAUTHORIZ"
^DIC(19,7803,0)="FBUC APPEAL EDIT^Appeal Edit for Unauthorized Claim^^R^1^FBAA LEVEL 2^^^^^^"
^DIC(19,7803,1,0)="^19.06^5^5^3070403^^^^"
^DIC(19,7803,1,1,0)="Edit a claim which has been appealed to the Board of Veterans Appeals (BVA)."
^DIC(19,7803,1,2,0)="  "
^DIC(19,7803,1,3,0)="Selection of claims is limited to only those claims which have a status"
^DIC(19,7803,1,4,0)="of APPEAL/NOTICE OF DISAGREE RECV, APPEAL/ISSUED STATMENT OF CASE,"
^DIC(19,7803,1,5,0)="APPEAL COMPLETE/PENDING REVIEW or APPEAL DISPOSITIONED."
^DIC(19,7803,25)="AED^FBUCED"
^DIC(19,7803,"U")="APPEAL EDIT FOR UNAUTHORIZED C"
^DIC(19,7804,0)="FBUC COVA APPEAL^COVA Appeal Enter/Edit^^R^1^FBAA LEVEL 2^^^^^^"
^DIC(19,7804,1,0)="^19.06^6^6^3070403^^^^"
^DIC(19,7804,1,1,0)="This option is used to enter or edit an appeal to the Court of Veterans"
^DIC(19,7804,1,2,0)="Affairs (COVA).  This is an appeal of the Board of Veterans Affairs (BVA)"
^DIC(19,7804,1,3,0)="decision."
^DIC(19,7804,1,4,0)="  "
^DIC(19,7804,1,5,0)="Selection of claims is limited to those claims which have a status"
^DIC(19,7804,1,6,0)="of APPEAL DISPOSITIONED, COVA APPEAL or COVA DISPOSITION."
^DIC(19,7804,25)="COVA^FBUCED"
^DIC(19,7804,99)="55633,36628"
^DIC(19,7804,"U")="COVA APPEAL ENTER/EDIT"
^DIC(19,7805,0)="FBUC REQUEST INFORMATION^Request Information on Unauthorized Claim^^R^1^FBAA LEVEL 1 AUTH DISABLE 3^^^^^^^^"
^DIC(19,7805,1,0)="^19.06^8^8^3260401^^^"
^DIC(19,7805,1,1,0)="Request information on an unauthorized claim.  Selection of claims"
^DIC(19,7805,1,2,0)="is limited to those claims which have a status of INCOMPLETE UNAUTHORIZED"
^DIC(19,7805,1,3,0)="CLAIM, PENDING - REASON UNKNOWN, COMPLETE/PENDING REVIEW,"
^DIC(19,7805,1,4,0)="APPEAL/NOTICE OF DISAGREE RECV or APPEAL/ISSUED STATMENT OF CASE."
^DIC(19,7805,1,5,0)="  "
^DIC(19,7805,1,6,0)="A letter will print or be flagged for printing (depending upon your"
^DIC(19,7805,1,7,0)="parameter set-up) if the request causes the status to change, or "
^DIC(19,7805,1,8,0)="requests additional information."
^DIC(19,7805,20)=""
^DIC(19,7805,25)="REQ^FBUCED"
^DIC(19,7805,"U")="REQUEST INFORMATION ON UNAUTHO"
^DIC(19,7806,0)="FBUC RECEIVE INFORMATION^Receive Requested Information^^R^1^FBAA LEVEL 1 AUTH^^^^^^"
^DIC(19,7806,1,0)="^^4^4^2930923^^"
^DIC(19,7806,1,1,0)="Receive information which was requested for a claim.  Selection of claims"
^DIC(19,7806,1,2,0)="is limited to those claims which have a status of INCOMPLETE"
^DIC(19,7806,1,3,0)="UNAUTHORIZED CLAIM, APPEAL/NOTICE OF DISAGREE RECV or"
^DIC(19,7806,1,4,0)="APPEAL/ISSUED STATMENT OF CASE."
^DIC(19,7806,25)="REC^FBUCED"
^DIC(19,7806,"U")="RECEIVE REQUESTED INFORMATION"
