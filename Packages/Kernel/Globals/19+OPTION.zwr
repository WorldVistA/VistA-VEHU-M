^DIC(19,10444,"U")="PROGRESS NOTES BATCH PRINT LOC"
^DIC(19,10445,0)="TIU PRINT PN DIV PARAMS^Division - Progress Notes Print Params^^R^11740^^^^^^^516"
^DIC(19,10445,1,0)="^^5^5^2970103^^"
^DIC(19,10445,1,1,0)="These parameters are used by the [TIU PRINT PN BATCH INTERACTIVE] and"
^DIC(19,10445,1,2,0)="[TIU PRINT PN BATCH SCHEDULED] options.  If the site wants a header"
^DIC(19,10445,1,3,0)="other than what is returned by $$SITE^VASITE, the .02 field of the 1st"
^DIC(19,10445,1,4,0)="entry in this file will be used.  For example, Waco-Temple-Marlin can have"
^DIC(19,10445,1,5,0)="the institution of their progress notes as 'CENTRAL TEXAS HCF.'"
^DIC(19,10445,25)="DIV^TIUPRPN4"
