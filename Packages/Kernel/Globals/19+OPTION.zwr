^DIC(19,4385,0)="PRCB SINGLE TRANSFER^Transfer From/To Control Point^^R^11740^^2916^^^^^"
^DIC(19,4385,1,0)="^^6^6^2941108^^^^"
^DIC(19,4385,1,1,0)="This option will allow transferring of funds from control point to control"
