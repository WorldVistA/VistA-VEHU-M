^DIC(19,13629,0)="DGHT HOME TELEHEALTH^Home Telehealth Menu^Activation of option requires OCC approval.^M^1^^^^^^^114"
^DIC(19,13629,1,0)="^^4^4^3070920^"
^DIC(19,13629,1,1,0)="This option is used to sign-up and deactivate patients that are eligible "
^DIC(19,13629,1,2,0)="for Home Telehealth care provided by a vendor.  This option is also used "
^DIC(19,13629,1,3,0)="to generate HL7 messages to send to the appropriate Home Telehealth "
^DIC(19,13629,1,4,0)="vendor server system via the Austin Interface Engine."
^DIC(19,13629,10,0)="^19.01IP^4^4"
^DIC(19,13629,10,1,0)="13630^SU^10"
^DIC(19,13629,10,2,0)="13631^IN^20"
^DIC(19,13629,10,3,0)="13632^PR^30"
^DIC(19,13629,10,4,0)="13633^TR^40"
^DIC(19,13629,10,"B",13630,1)=""
^DIC(19,13629,10,"B",13631,2)=""
^DIC(19,13629,10,"B",13632,3)=""
^DIC(19,13629,10,"B",13633,4)=""
^DIC(19,13629,10,"C","IN",2)=""
^DIC(19,13629,10,"C","PR",3)=""
^DIC(19,13629,10,"C","SU",1)=""
^DIC(19,13629,10,"C","TR",4)=""
^DIC(19,13629,99)="61150,47970"
^DIC(19,13629,"U")="HOME TELEHEALTH MENU"
^DIC(19,13630,0)="DGHT PATIENT SIGNUP^Patient Sign-Up/Activation^Activation of option requires OCC approval.^R^1^^^^^^^114"
^DIC(19,13630,1,0)="^19.06^4^4^3070920^^^^"
^DIC(19,13630,1,1,0)="This option is used to sign-up patients eligible for Home Telehealth care "
^DIC(19,13630,1,2,0)="provided by a vendor.  Once okayed for transmission, an A04 type HL7 "
^DIC(19,13630,1,3,0)="messages will be generated and sent to the appropriate Home Telehealth "
^DIC(19,13630,1,4,0)="vendor server via the Austin Interface Engine."
^DIC(19,13630,25)="DGHTENR"
^DIC(19,13630,"U")="PATIENT SIGN-UP/ACTIVATION"
^DIC(19,13631,0)="DGHT PATIENT INACTIVATION^Patient Inactivation^Activation of option requires OCC approval.^R^1^^^^^^^114"
^DIC(19,13631,1,0)="^19.06^4^4^3050608^^"
^DIC(19,13631,1,1,0)="This option is used to deactivate patients from Home Telehealth care"
^DIC(19,13631,1,2,0)="provided by a vendor.  Once okayed for transmission, A03 type HL7 message"
^DIC(19,13631,1,3,0)="will be generated and sent to the appropriate Home Telehealth vendor server "
^DIC(19,13631,1,4,0)="via the Austin Interface Engine."
^DIC(19,13631,25)="EN^DGHTINAC"
^DIC(19,13631,"U")="PATIENT INACTIVATION"
^DIC(19,13632,0)="DGHT SUMMARY REPORT^Patient Summary Report^Activation of option requires OCC approval.^R^1^^^^^^^114"
^DIC(19,13632,1,0)="^19.06^7^7^3050316^^^^"
^DIC(19,13632,1,1,0)="This report gives a summary of all patients that have been signed up for "
^DIC(19,13632,1,2,0)="Home Telehealth for a specified date range.  The report includes:-"
^DIC(19,13632,1,3,0)="      o  Patient Name"
^DIC(19,13632,1,4,0)="      o  Status (Active/Inactivate)"
^DIC(19,13632,1,5,0)="      o  Date of Last Change"
^DIC(19,13632,1,6,0)="      o  Vendor"
^DIC(19,13632,1,7,0)="      o  Total # of Home Telehealth patients"
^DIC(19,13632,25)="DGHTRPT1"
^DIC(19,13632,"U")="PATIENT SUMMARY REPORT"
^DIC(19,13633,0)="DGHT TRANSMISSION REPORT^Transmission Report^Activation of option requires OCC approval.^R^1^^^^^^^114"
^DIC(19,13633,1,0)="^^2^2^3050223^"
^DIC(19,13633,1,1,0)="This report provides detail information of patient information transmitted to "
^DIC(19,13633,1,2,0)="Home Telehealth vendor servers for a specified date range."
^DIC(19,13633,25)="DGHTRPT"
^DIC(19,13633,"U")="TRANSMISSION REPORT"
^DIC(19,13634,0)="DGHT HL7 MESSAGE MONITOR^Home Telehealth HL7 Message Monitor^^R^1^^^^^^^114^^"
^DIC(19,13634,1,0)="^19.06^7^7^3060522^^"
^DIC(19,13634,1,1,0)="This option monitors HL7 messages that were transmitted to home telehealth"
^DIC(19,13634,1,2,0)="vendors. The rescheduling frequency should coincide with the Parameters"
^DIC(19,13634,1,3,0)="Definition file (#8989.51). The default value is 15 minutes, but it can be"
^DIC(19,13634,1,4,0)="changed by the site. The option orders thru the Home Telehealth file "
^DIC(19,13634,1,5,0)="(#391.31) and tries to find messages that have not received AAs within a"
^DIC(19,13634,1,6,0)="predetermined amount of time. If it finds any HL7 messages that meet the"
^DIC(19,13634,1,7,0)="criteria, it retransmits the messages."
^DIC(19,13634,20)=""
^DIC(19,13634,25)="EN^DGHTRTX"
^DIC(19,13634,"U")="HOME TELEHEALTH HL7 MESSAGE MO"
^DIC(19,13635,0)="IBCED EDI CLAIM STATUS REPORT^EDI Claim Status Report^^R^1^^^^^^^"
^DIC(19,13635,1,0)="^^3^3^3071224^"
^DIC(19,13635,1,1,0)="This report shows information about transmitted electronic claims.  "
^DIC(19,13635,1,2,0)="Selection criteria includes division, payer, date last transmitted, and "
^DIC(19,13635,1,3,0)="current EDI status.  This report has 3 sort levels and 8 sorting criteria."
^DIC(19,13635,25)="EN^IBCEDS"
^DIC(19,13635,"U")="EDI CLAIM STATUS REPORT"
^DIC(19,13639,0)="DGEN NEACL REQUEST MGT EDIT^Management Edit^^R^1^^^^^^^114"
^DIC(19,13639,1,0)="^19.06^3^3^3080326^^^^"
^DIC(19,13639,1,1,0)="Option will provide the user a means to remove patients from the call "
^DIC(19,13639,1,2,0)="list (by updating the status to 'Cancelled' or 'Filled'), update the "
^DIC(19,13639,1,3,0)="status to 'In Process' and add comments to the veterans on the Call List."
^DIC(19,13639,25)="EDIT^DGENACL"
^DIC(19,13639,"U")="MANAGEMENT EDIT"
^DIC(19,13640,0)="DGEN NEACL REQUEST MGT MENU^New Enrollee Appointment Request Management Menu^^M^1^^^^^^^114"
^DIC(19,13640,1,0)="^19.06^6^6^3130717^^"
^DIC(19,13640,1,1,0)="This menu assists with tracking of new enrollee's who request an"
^DIC(19,13640,1,2,0)="appointment. When an enrollee request is made, the request will stay on"
^DIC(19,13640,1,3,0)="the 'Call List' until an appointment is made/'filled' or the request is"
^DIC(19,13640,1,4,0)="cancelled. The 'Tracking Report' is a managerial review of requests"
^DIC(19,13640,1,5,0)="collected within a date range. The 'Edit' option allows the user to "
^DIC(19,13640,1,6,0)="comment on the request and update the request status."
^DIC(19,13640,10,0)="^19.01IP^3^3"
^DIC(19,13640,10,1,0)="13639^ED^1"
^DIC(19,13640,10,2,0)="13641^CL^2"
^DIC(19,13640,10,3,0)="13642^TR^3"
