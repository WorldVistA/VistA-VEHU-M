^DIC(19,15408,1,0)="^19.06^8^8^3240328^^"
^DIC(19,15408,1,1,0)="Allow team lists to be designated to be used by GUI applications for:"
^DIC(19,15408,1,2,0)=" "
^DIC(19,15408,1,3,0)="  0 = OWNER - only viewable by the owner "
^DIC(19,15408,1,4,0)="  1 = ALLUSERS - viewable by anyone"
^DIC(19,15408,1,5,0)=" "
^DIC(19,15408,1,6,0)="This allows for exclusion of teams from these GUI applications and "
^DIC(19,15408,1,7,0)="would prevent users from viewing some information that is not appropriate."
^DIC(19,15408,1,8,0)="Cloned from ""ORLP TEAM LIST VISIBILITY"" option."
