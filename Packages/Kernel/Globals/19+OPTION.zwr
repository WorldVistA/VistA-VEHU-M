^DIC(19,11515,"U")="DIALOG PARAMETERS"
^DIC(19,11516,0)="PXRM PROGRESS NOTE HEADERS^Progress Note Headers^^A^10000000020^^^^^^^534^^1"
^DIC(19,11516,1,0)="^^2^2^3000110^"
^DIC(19,11516,1,1,0)="The header inserted into the progress note when processing a reminder may"
^DIC(19,11516,1,2,0)="be modified for user, location, service."
^DIC(19,11516,20)="D EDITPAR^XPAREDIT(""PXRM PROGRESS NOTE HEADERS"")"
^DIC(19,11516,"U")="PROGRESS NOTE HEADERS"
