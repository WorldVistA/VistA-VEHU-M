^DIC(19,3359,0)="XMUT-CHKFIL^Check MailMan Files for Errors^^R^11748^XUPROG^^^^^^54^^"
^DIC(19,3359,1,0)="^19.06^13^13^3010419^^^^"
^DIC(19,3359,1,1,0)="This option checks for and corrects errors in the MAILBOX file 3.7 and"
^DIC(19,3359,1,2,0)="the MESSAGE file 3.9.  It checks important fields and cross references."
^DIC(19,3359,1,3,0)=""
^DIC(19,3359,1,4,0)="It is recommended that this option be run monthly or every few months,"
^DIC(19,3359,1,5,0)="or whenever there seems to be a database problem."
^DIC(19,3359,1,6,0)=" "
^DIC(19,3359,1,7,0)="It produces a report of the errors detected, and what, if anything, it"
^DIC(19,3359,1,8,0)="did to fix them.  If it didn't fix them, it tells you what you can do"
^DIC(19,3359,1,9,0)="to fix them."
^DIC(19,3359,1,10,0)=" "
^DIC(19,3359,1,11,0)="Although the system will not fail because of errors detected, your users"
^DIC(19,3359,1,12,0)="may call you about the problems they experience.  This utility will allow"
^DIC(19,3359,1,13,0)="you to detect them first and correct them before anyone knows."
^DIC(19,3359,25)="CHKFILES^XMUT4"
^DIC(19,3359,200)="^"
^DIC(19,3359,200.9)="y"
^DIC(19,3359,"U")="CHECK MAILMAN FILES FOR ERRORS"
^DIC(19,3360,0)="XMUT-REC-MENU^Recover Messages into User's IN Basket^^M^11748^^3466^^^^^^^"
^DIC(19,3360,1,0)="^^4^4^2931206^^^^"
^DIC(19,3360,1,1,0)="This menu is about recovering messages for a user who has inadvertently"
^DIC(19,3360,1,2,0)="lost messages.  It will recover all the messages a user has ever received"
^DIC(19,3360,1,3,0)="and is not terminated from.  The steps are reviewed in the help"
^DIC(19,3360,1,4,0)="documentation.  (Enter '?HELP' to see the HELP documentation.)"
^DIC(19,3360,10,0)="^19.01PI^4^4"
