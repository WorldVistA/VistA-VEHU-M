^DIC(19,17066,1,6,0)=" "
^DIC(19,17066,1,7,0)="Appointment status will be marked as cancelled with a cancellation reason "
^DIC(19,17066,1,8,0)="of ""Duplicate in Oracle Health"". (Bulk appointment cleanup) "
^DIC(19,17066,25)="CANCAPPT^EHMAPPT1"
