^DIC(19,9671,0)="ECCP^Print Category and Procedure Summary^OPTION NO LONGER SUPPORTED. USE THE ECS GUI INTERFACE.^R^11596^^2952^^^^^499^^^1"
^DIC(19,9671,1,0)="^^2^2^2960401^^^^"
^DIC(19,9671,1,1,0)="This option is used to print categories and procedures that have"
^DIC(19,9671,1,2,0)="been defined within the DSS units in the Event Capture software."
^DIC(19,9671,15)="W @IOF"
^DIC(19,9671,25)="ECSUM"
^DIC(19,9671,"U")="PRINT CATEGORY AND PROCEDURE S"
^DIC(19,9672,0)="EC PRO SUM^Provider (1-7) Summary Report^OPTION NO LONGER SUPPORTED. USE THE ECS GUI INTERFACE.^R^10000000020^^2962^^^^^499^^^1"
^DIC(19,9672,1,0)="^^3^3^3051118^"
^DIC(19,9672,1,1,0)="A summary report, by provider, of the number of procedures each provider"
^DIC(19,9672,1,2,0)="has performed as first, second, third to seven. This report could be used"
^DIC(19,9672,1,3,0)="as a training summary."
^DIC(19,9672,15)="W @IOF"
^DIC(19,9672,25)="ECPRSUM1"
^DIC(19,9672,"U")="PROVIDER (1-7) SUMMARY REPORT"
^DIC(19,9673,0)="EC OS SUM^Ordering Section Summary Report^OPTION NO LONGER SUPPORTED. USE THE ECS GUI INTERFACE.^R^11596^^2961^^^^^499^^^1"
^DIC(19,9673,1,0)="^^2^2^2940806^"
^DIC(19,9673,1,1,0)="A summary report of procedures ordered by each ordering section,"
^DIC(19,9673,1,2,0)="including providers."
^DIC(19,9673,15)="W @IOF"
^DIC(19,9673,25)="ECOSSUM"
^DIC(19,9673,"U")="ORDERING SECTION SUMMARY REPOR"
^DIC(19,9674,0)="ECDSSYN^Procedure Synonym/Default Volume (Enter/Edit)^OPTION NO LONGER SUPPORTED. USE THE ECS GUI INTERFACE.^R^11596^^2948^^^^^499^^^1"
^DIC(19,9674,1,0)="^^2^2^2960401^^^^"
^DIC(19,9674,1,1,0)="This option allows the user to change the synonym and/or default volume"
^DIC(19,9674,1,2,0)="associated with procedures defined within the event code screens."
^DIC(19,9674,15)="W @IOF"
^DIC(19,9674,25)="ECDSSYN"
^DIC(19,9674,"U")="PROCEDURE SYNONYM/DEFAULT VOLU"
^DIC(19,9675,0)="ECDSDEAC^Activate/Inactivate Local Procedures^OPTION NO LONGER SUPPORTED. USE THE ECS GUI INTERFACE.^R^11596^^2946^^^^^499^^^1"
^DIC(19,9675,1,0)="^^3^3^2960402^^^^"
^DIC(19,9675,1,1,0)="This option allows the user to enter an inactivation date for local"
^DIC(19,9675,1,2,0)="procedures. The user may also reactivate any inactive local procedures"
^DIC(19,9675,1,3,0)="using this option."
^DIC(19,9675,15)="W @IOF"
^DIC(19,9675,25)="SETDEAC^ECDSSA"
^DIC(19,9675,"U")="ACTIVATE/INACTIVATE LOCAL PROC"
^DIC(19,9676,0)="ECDSS PROCEDURE^Local Procedure (Enter/Edit)^OPTION NO LONGER SUPPORTED. USE THE ECS GUI INTERFACE.^R^11596^^2949^^^^^499^^^1"
^DIC(19,9676,1,0)="^^3^3^2960402^^^^"
^DIC(19,9676,1,1,0)="This option allows the user to enter and edit new local procedures"
^DIC(19,9676,1,2,0)="as appendicies to the EC NATIONAL PROCEDURE file (#725). It does"
^DIC(19,9676,1,3,0)="not permit procedures to be deleted."
^DIC(19,9676,15)="W @IOF"
^DIC(19,9676,25)="NEWED^ECDSS"
^DIC(19,9676,"U")="LOCAL PROCEDURE (ENTER/EDIT)"
