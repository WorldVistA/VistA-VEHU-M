^DIC(19,6370,1,1,0)=" "
^DIC(19,6370,1,2,0)="This options does a %RCR copy of one option's fields into a new option.  It"
^DIC(19,6370,1,3,0)="also trys to enforce namespacing rules when the new option is named."
^DIC(19,6370,25)="XQ11"
^DIC(19,6370,99.1)="54881,47404"
^DIC(19,6370,"U")="COPY EVERYTHING ABOUT AN OPTIO"
