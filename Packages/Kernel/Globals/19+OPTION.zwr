^DIC(19,15260,0)="EHM-00081^Consult Closure Tool Run Configuration^^R^1^^^^^^^294^^^^"
^DIC(19,15260,1,0)="^19.06^3^3^3240328^^^^"
^DIC(19,15260,1,1,0)="This option is used by the Consult Closure Tool to print the tracking"
^DIC(19,15260,1,2,0)="report, build team lists, and to close consults."
^DIC(19,15260,1,3,0)="Cloned from ""GMRC CONSULT CLOSE TOOL RUN"" option."
^DIC(19,15260,3)=""
^DIC(19,15260,25)="EN^GMRCCA"
