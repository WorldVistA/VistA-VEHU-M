^DIC(19,15449,1,0)="^19.06^1^1^3240328^^^^"
^DIC(19,15449,1,1,0)="Cloned from ""OR INPT CLOZAPINE MESSAGE"" option."
^DIC(19,15449,3)=""
^DIC(19,15449,20)="D EDITPAR^XPAREDIT(""OR CLOZ INPT MSG"")"
^DIC(19,15449,"U")="GUI EDIT INPATIENT CLOZAPINE M"
