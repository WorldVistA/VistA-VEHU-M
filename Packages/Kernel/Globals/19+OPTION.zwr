^DIC(19,11719,0)="WV SEXUAL TRAUMA LIST^List Sexual Trauma Data^^R^11720^^^^^^^522"
^DIC(19,11719,1,0)="^^17^17^3010402^"
^DIC(19,11719,1,1,0)="This option displays a list of patients, their Civilian Sexual Trauma"
^DIC(19,11719,1,2,0)="value from the WH package and the Military Sexual Trauma (MST) value from"
^DIC(19,11719,1,3,0)="the MST module of the Registration package. The patient's name, SSN, case"
^DIC(19,11719,1,4,0)="manager, age, veteran status and eligibility code are displayed, too."
^DIC(19,11719,1,5,0)=" "
^DIC(19,11719,1,6,0)="Patients are sorted by case manager first, then MST status and finally"
^DIC(19,11719,1,7,0)="patient name. The MST status order is:"
^DIC(19,11719,1,8,0)=" 1) Yes, Screened reports MST"
^DIC(19,11719,1,9,0)=" 2) No, Screened does not report MST"
^DIC(19,11719,1,10,0)=" 3) Screened Declines to answer"
^DIC(19,11719,1,11,0)=" 4) Unknown, not screened   "
^DIC(19,11719,1,12,0)=" "
^DIC(19,11719,1,13,0)="Non-veteran patients are displayed after the veterans."
^DIC(19,11719,1,14,0)=" "
^DIC(19,11719,1,15,0)="The user may choose to see the patients for one case manager or all case"
^DIC(19,11719,1,16,0)="managers. Patients who are deceased or have an Inactive Date (prior to"
^DIC(19,11719,1,17,0)="today's date) will not appear on the listing."
^DIC(19,11719,25)="WVMSTL"
^DIC(19,11719,"U")="LIST SEXUAL TRAUMA DATA"
