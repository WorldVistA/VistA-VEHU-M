^DIC(19,14653,1,0)="^19.06^11^11^3170823^^^^"
^DIC(19,14653,1,1,0)="This option allows entries from the RACE file(#10)  MARITAL STATUS (#11) "
^DIC(19,14653,1,2,0)="file, and RELIGION file to be associated with an entry from a "
^DIC(19,14653,1,3,0)="corresponding MASTER file containing a set of standard entries."
^DIC(19,14653,1,4,0)="The files and associated Master files"
^DIC(19,14653,1,5,0)=" "
^DIC(19,14653,1,6,0)=" "
^DIC(19,14653,1,7,0)=" 'Local' File         ->  Corresponding Master File"
