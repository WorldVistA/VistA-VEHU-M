^DIC(19,9862,"U")="PCE TABLE MAINTENANCE"
^DIC(19,9863,0)="PXTT LIST ACTIVE EDUC TOPICS^Active Educ. Topic List - Detailed^^P^1^^^^^^y^"
^DIC(19,9863,1,0)="^^2^2^2960606^^"
^DIC(19,9863,1,1,0)="This lists the current detailed definition of the goals and standards"
^DIC(19,9863,1,2,0)="defined for the active education topics."
^DIC(19,9863,60)="AUTTEDT("
^DIC(19,9863,62)=""
^DIC(19,9863,63)="[PXTT EDUCATION TOPICS-DETAILED]"
^DIC(19,9863,64)="[PXTT ACTIVE EDUCATION TOPICS]"
^DIC(19,9863,65)=""
^DIC(19,9863,66)=""
^DIC(19,9863,"U")="ACTIVE EDUC. TOPIC LIST - DETA"
^DIC(19,9864,0)="PXTT LIST ALL EDUC TOPICS^Education Topic List^^P^1^^^^^^y^"
^DIC(19,9864,1,0)="^^2^2^2951122^"
^DIC(19,9864,1,1,0)="This option prints a brief list of ALL Education Topics using only two"
^DIC(19,9864,1,2,0)="fields: Inactive Flag status and Topic Name."
^DIC(19,9864,60)="AUTTEDT("
^DIC(19,9864,63)="[PXTT EDUCATION TOPICS-BRIEF]"
^DIC(19,9864,64)="[PXTT ALL TOPICS]"
^DIC(19,9864,"U")="EDUCATION TOPIC LIST"
^DIC(19,9865,0)="PXTT EDIT EXAM^Examinations Add/Edit^Do not use! Placed out of order by PX*1*211.^E^1^^^^^^n^^^1^1"
^DIC(19,9865,1,0)="^19.06^22^22^3010806^^^^"
^DIC(19,9865,1,1,0)="This option allows the user to create a new name to represent an"
^DIC(19,9865,1,2,0)="examination type or edit an examination type that was originally created"
^DIC(19,9865,1,3,0)="at your site. "
^DIC(19,9865,1,4,0)=" "
^DIC(19,9865,1,5,0)="The examination types originally distributed by PCE are a breakdown of"
^DIC(19,9865,1,6,0)="potential categories of exams within a Physical Exam. The exams"
^DIC(19,9865,1,7,0)="distributed with the PCE package can be inactivated using the PCE"
^DIC(19,9865,1,8,0)="""Activate/Inactivate Table Items"" menu."
^DIC(19,9865,1,9,0)=" "
^DIC(19,9865,1,10,0)="Once exam names are defined in this table, they should not be deleted if"
^DIC(19,9865,1,11,0)="there is any encounter form definitions which may be referencing the exam"
^DIC(19,9865,1,12,0)="name, or if there is any patient encounter data which may be referencing"
^DIC(19,9865,1,13,0)="this exam historically. Use the ""Inactive Flag"" field to make an exam"
^DIC(19,9865,1,14,0)="""INACTIVE"" for selection in the Encounter form definition process and the"
^DIC(19,9865,1,15,0)="PCE Encounter Data Entry process. Enter ""@"" at the ""Inactive Flag"" field"
^DIC(19,9865,1,16,0)="to reactivate an inactivated exam."
^DIC(19,9865,1,17,0)=" "
^DIC(19,9865,1,18,0)="If exam names are to be included on the clinic's encounter form, the exams"
^DIC(19,9865,1,19,0)="must first be defined in the Exam file using this option."
^DIC(19,9865,1,20,0)=" "
^DIC(19,9865,1,21,0)="The scanning of encounter forms with the AICS package will provide PCE"
^DIC(19,9865,1,22,0)="with patient exam information which is stored in the V EXAM file."
^DIC(19,9865,15)="K PXTDUZ,PXNAT,PXB"
^DIC(19,9865,20)="D ZERO^PXTTU1(""^AUTTEXAM("",$G(PXNAT))"
^DIC(19,9865,30)="AUTTEXAM("
^DIC(19,9865,31)="QAMEZL"
^DIC(19,9865,34)="S PXTDUZ=+$P($$SITE^VASITE,U,3) I $S($G(PXNAT):1,(+$G(Y)>100000):1,1:0)"
^DIC(19,9865,40)=".01;.04;.03"
^DIC(19,9865,41)=9999999.15
^DIC(19,9865,50)="AUTTEXAM("
^DIC(19,9865,51)=".01;.04;.03"
^DIC(19,9865,53)="BACK"
^DIC(19,9865,"U")="EXAMINATIONS ADD/EDIT"
^DIC(19,9866,0)="PXTT PCE INFORMATION ONLY^PCE Information Only^^M^10000000020^^^^^^y^507"
^DIC(19,9866,1,0)="^19.06^15^15^3040212^^^^"
^DIC(19,9866,1,1,0)="This is a menu of options that list information about the files/tables"
^DIC(19,9866,1,2,0)="used by the Patient Care Encounter (PCE) package.  Some of the"
^DIC(19,9866,1,3,0)="files/tables determine what clinical data will be collected as the sites'"
^DIC(19,9866,1,4,0)="clinical terminology for specific categories of data such as"
^DIC(19,9866,1,5,0)="Immunizations, Skin Tests, Patient Education, and Treatments."
^DIC(19,9866,1,6,0)=" "
^DIC(19,9866,1,7,0)="The PCE Code Mapping file determines whether two entries should be made"
^DIC(19,9866,1,8,0)="from one clinical data item entered.  For example, if an immunization is"
^DIC(19,9866,1,9,0)="entered into the V Immunization file, a CPT code is generated in the V CPT"
^DIC(19,9866,1,10,0)="file for billing and workload.  The mapping definition of the CPT"
^DIC(19,9866,1,11,0)="relationship with the Immunization type is viewable from the PCE Code"
^DIC(19,9866,1,12,0)="Mapping list option."
^DIC(19,9866,1,13,0)="  "
^DIC(19,9866,1,14,0)="The reminder lists allow the user to see what the clinical reminders"
^DIC(19,9866,1,15,0)="definitions are for use with the Health Summary package."
^DIC(19,9866,10,0)="^19.01PI^16^16"
^DIC(19,9866,10,1,0)="9863^EDA^1"
^DIC(19,9866,10,2,0)="9864^EDL^2"
^DIC(19,9866,10,7,0)="9868^EX^4"
^DIC(19,9866,10,8,0)="9869^HF^5"
^DIC(19,9866,10,9,0)="9867^IM^6"
