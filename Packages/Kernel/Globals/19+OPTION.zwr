^DIC(19,7406,"U")="BUILD MONITOR MENU"
^DIC(19,7407,0)="QAM PGMR CONDITIONS EDIT^Condition File Edit^^R^.5^^^^^^^"
^DIC(19,7407,1,0)="^^2^2^2930903^"
^DIC(19,7407,1,1,0)="Condition File Edit:  Allows the programmer to add new conditions"
^DIC(19,7407,1,2,0)="to the Condition file."
^DIC(19,7407,25)="EN2^QAMEDT3"
^DIC(19,7407,"U")="CONDITION FILE EDIT"
^DIC(19,7408,0)="QAM PGMR DATA ELEMENTS EDIT^Data Element File Edit^^R^.5^^^^^^^"
^DIC(19,7408,1,0)="^^4^4^2930903^"
^DIC(19,7408,1,1,0)="Data Element File Edit:  Allows the programmer to add new data"
^DIC(19,7408,1,2,0)="elements to the Data Element file for capture.  Note:  Data elements"
^DIC(19,7408,1,3,0)="can be added to a monitor at any time, but the program will not"
^DIC(19,7408,1,4,0)="retroactively capture this data."
^DIC(19,7408,25)="QAMEDT7"
^DIC(19,7408,"U")="DATA ELEMENT FILE EDIT"
^DIC(19,7409,0)="QAM RATIONALE FILE EDIT^Rationale Edit^^R^.5^^^^^^^"
^DIC(19,7409,1,0)="^^4^4^2910417^^"
^DIC(19,7409,1,1,0)="Rationale Edit:  Allows the user to enter new rationales (High "
^DIC(19,7409,1,2,0)="Volume, Problem Prone, High Risk, Other) or change existing "
^DIC(19,7409,1,3,0)="rationales.  Also allows the user to set the explanation "
^DIC(19,7409,1,4,0)="field to ""Yes"" or ""No"" to allow for an explanation of the rationale."
^DIC(19,7409,25)="EN4^QAMEDT3"
^DIC(19,7409,"U")="RATIONALE EDIT"
^DIC(19,7410,0)="QAM PGMR TIME FRAME EDIT^Time Frame File Edit^^R^.5^^^^^^^"
^DIC(19,7410,1,0)="^^2^2^2910417^^"
^DIC(19,7410,1,1,0)="Time Frame File Edit:  Allows the programmer to add new or change "
^DIC(19,7410,1,2,0)="old time frames.  "
^DIC(19,7410,25)="EN5^QAMEDT3"
^DIC(19,7410,"U")="TIME FRAME FILE EDIT"
^DIC(19,7411,0)="QAM SITE PARAMETERS EDIT^Site Parameters Edit^^E^.5^^^^^^^^^1^1"
^DIC(19,7411,1,0)="^^5^5^2910417^^"
^DIC(19,7411,1,1,0)="Site Parameters Edit:  The user configures the program to the site "
^DIC(19,7411,1,2,0)="through this option.  Edits include 1) the date the weekly time frame "
^DIC(19,7411,1,3,0)="begins, 2) use of the ""contains"" operator (Yes or No) in the group edit, "
^DIC(19,7411,1,4,0)="fields that control the manual run of auto enroll, and the "
^DIC(19,7411,1,5,0)="device that auto enroll will print to.  "
^DIC(19,7411,10,0)="^19.01IP^0^0"
^DIC(19,7411,15)="K %X,%Y,DI,DLAYGO,DQ"
^DIC(19,7411,20)="S DLAYGO=740"
^DIC(19,7411,30)="QA(740,"
^DIC(19,7411,31)="AELMNQ"
^DIC(19,7411,50)="QA(740,"
^DIC(19,7411,51)="[QAQA QAM SITE PARAMETERS]"
^DIC(19,7411,"U")="SITE PARAMETERS EDIT"
^DIC(19,7412,0)="QAM PURGE HISTORY FILE^History File Purge^^R^.5^^^^^^^"
^DIC(19,7412,1,0)="^^3^3^2910417^^"
^DIC(19,7412,1,1,0)="Purge History File:  Prompts the user for the monitor or a group of "
^DIC(19,7412,1,2,0)="monitors that the user wants to purge and a date range.  There is a "
^DIC(19,7412,1,3,0)="warning message to the user before the data is purged."
^DIC(19,7412,25)="EN1^QAMARCH0"
^DIC(19,7412,"U")="HISTORY FILE PURGE"
^DIC(19,7413,0)="QAM PURGE FALL OUT FILE^Fall Out File Purge^^R^.5^^^^^^^"
^DIC(19,7413,1,0)="^^3^3^2910417^^"
^DIC(19,7413,1,1,0)="Purge Fall Out File:  Prompts the user for the monitor or a group of "
^DIC(19,7413,1,2,0)="monitors that the user wants to purge and a date range.  There is a "
^DIC(19,7413,1,3,0)="warning message to the user before the data is purged."
^DIC(19,7413,25)="EN2^QAMARCH0"
^DIC(19,7413,"U")="FALL OUT FILE PURGE"
^DIC(19,7414,0)="QAM RPT MONITOR DESCRIPTION^Monitor Description Report^^R^.5^^^^^^^"
^DIC(19,7414,1,0)="^^4^4^2910417^^"
^DIC(19,7414,1,1,0)="Monitor Description Report:  Shows the user the Title, code, "
^DIC(19,7414,1,2,0)="Threshold, Start/End Dates, etc of selected monitors.  Also shows the "
^DIC(19,7414,1,3,0)="Clinical Indicator, Standard of Care, and rationale/explanation for the "
^DIC(19,7414,1,4,0)="monitor."
^DIC(19,7414,25)="QAMPMON0"
^DIC(19,7414,"U")="MONITOR DESCRIPTION REPORT"
^DIC(19,7415,0)="QAM RPT ADHOC^Ad Hoc Fall Out Report^^A^.5^^^^^^^320^^1"
^DIC(19,7415,1,0)="^^6^6^2920515^^^^"
^DIC(19,7415,1,1,0)="Ad Hoc Fall Out Report:  Allows the users to design their own reports "
^DIC(19,7415,1,2,0)="from data in the Fall Out file.  The data elements present in the Fall"
^DIC(19,7415,1,3,0)="Out file are determined by the data elements selected when the monitor"
^DIC(19,7415,1,4,0)="was built.  An attempt to sort/print a data element that was not entered"
^DIC(19,7415,1,5,0)="into the monitor's OTHER DATA TO CAPTURE will produce no data for that"
^DIC(19,7415,1,6,0)="element."
^DIC(19,7415,20)="D ^QAMAHO1"
^DIC(19,7415,99)="55565,37318"
^DIC(19,7415,"U")="AD HOC FALL OUT REPORT"
^DIC(19,7416,0)="QAM MANUAL AUTO ENROLL RUN^Manually Run Auto Enroll^^R^.5^^^^^^^"
^DIC(19,7416,1,0)="^^7^7^2920518^^^"
^DIC(19,7416,1,1,0)="Manually Run Auto Enroll:  Allows the uer to choose run of selected "
^DIC(19,7416,1,2,0)="monitors or selected services.  Example:  Medical Service can request, "
^DIC(19,7416,1,3,0)="through this option, a manual run of the auto enroll for the monitors "
^DIC(19,7416,1,4,0)="belonging just to Medical Service.  The option asks the user for a date "
^DIC(19,7416,1,5,0)="range and when the auto enroll should be queued to run.  The user "
^DIC(19,7416,1,6,0)="also has the choice of having a report printed out of when those date "
^DIC(19,7416,1,7,0)="ranges will be run."
^DIC(19,7416,25)="QAMAUTO4"
^DIC(19,7416,"U")="MANUALLY RUN AUTO ENROLL"
^DIC(19,7417,0)="QAM PURGE AUTO RUN DATES FILE^Auto Enroll Run Dates File Purge^^R^.5^^^^^^^"
^DIC(19,7417,1,0)="^^3^3^2910417^^"
^DIC(19,7417,1,1,0)="Purge Auto Enroll Run Dates File:  Prompts the user for the monitor "
^DIC(19,7417,1,2,0)="or a group of monitors that the user wants to purge and a date range.  "
^DIC(19,7417,1,3,0)="There is a warning message to the user before the data is purged."
^DIC(19,7417,25)="EN3^QAMARCH0"
^DIC(19,7417,"U")="AUTO ENROLL RUN DATES FILE PUR"
^DIC(19,7418,0)="QAM TASKED AUTO ENROLL RUN^Tasked Run of Auto Enroll^^A^.5^^^^^^^^^1"
^DIC(19,7418,1,0)="^^4^4^2921217^^^^"
^DIC(19,7418,1,1,0)="Tasked Run of Auto Enroll:  This option runs the active monitors in the"
^DIC(19,7418,1,2,0)="QA Monitor file (#743) and auto enrolls any fall outs into the Fall Out"
^DIC(19,7418,1,3,0)="file (#743.1).  It should be queued to run every night sometime after"
^DIC(19,7418,1,4,0)="midnight."
^DIC(19,7418,20)="K QAMTODAY,^UTILITY($J,""QAM MONITOR""),^(""QAM SERVICE"") D ^QAMAUTO0"
^DIC(19,7418,200.9)="y"
^DIC(19,7418,"U")="TASKED RUN OF AUTO ENROLL"
^DIC(19,7419,0)="QAM RPT AUTO/MAN MONITORS RUN^Auto/Manual Enroll Monitors Run^^R^.5^^^^^^^"
^DIC(19,7419,1,0)="^^2^2^2920518^^^^"
^DIC(19,7419,1,1,0)="Auto/Manual Enroll Monitors Run:  Tells the user whether or not "
^DIC(19,7419,1,2,0)="auto enroll ran and if it did which monitors were run."
^DIC(19,7419,25)="EN1^QAMPRUN0"
^DIC(19,7419,"U")="AUTO/MANUAL ENROLL MONITORS RU"
^DIC(19,7420,0)="QAM PGMR APP GROUP EDIT^Application Group Edit^^R^.5^^^^^^^"
^DIC(19,7420,1,0)="^^3^3^2910417^^"
^DIC(19,7420,1,1,0)="Application Group Edit:  Pertains to group edit.  The user can only "
^DIC(19,7420,1,2,0)="create groups from the QAM application group.  This option allows "
^DIC(19,7420,1,3,0)="the programmer to set up other files in the QAM application group."
^DIC(19,7420,25)="EN2^QAMAPGRP"
^DIC(19,7420,"U")="APPLICATION GROUP EDIT"
^DIC(19,7421,0)="QAM SAMPLE SIZE EDIT^Sample Size Edit^^R^.5^^^^^^^"
^DIC(19,7421,1,0)="^^2^2^2910417^^"
^DIC(19,7421,1,1,0)="Sample Size Edit:  allows the user to edit the sample size for a "
^DIC(19,7421,1,2,0)="selected date and and selected monitor."
^DIC(19,7421,25)="QAMEDT4"
^DIC(19,7421,"U")="SAMPLE SIZE EDIT"
^DIC(19,7422,0)="QAM FALL OUT EDIT^Fall Out Edit^^R^.5^^^^^^^"
^DIC(19,7422,1,0)="^^2^2^2910417^^"
^DIC(19,7422,1,1,0)="Fall Out Edit:  Allows the user to add a new or edit an existing fall "
^DIC(19,7422,1,2,0)="out.  Can be used when adding a new data element to a monitor."
^DIC(19,7422,25)="QAMEDT5"
^DIC(19,7422,99)="55724,35800"
^DIC(19,7422,"U")="FALL OUT EDIT"
^DIC(19,7423,0)="QAM USER MENU^Monitoring System User Menu^^M^.5^^^^^^^"
^DIC(19,7423,10,0)="^19.01PI^3^3"
^DIC(19,7423,10,1,0)="7422^^1"
^DIC(19,7423,10,2,0)="7421^^2"
^DIC(19,7423,10,3,0)="7431^^3"
