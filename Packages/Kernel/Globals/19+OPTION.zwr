^DIC(19,1199,"U")="CUMULATIVE MENU"
^DIC(19,1200,0)="LRAC PT^Reprint cumulative on a given patient^^R^10000000020^^^^^^^26"
^DIC(19,1200,1,0)="^19.06^7^7^3021105^^^^"
^DIC(19,1200,1,1,0)="THIS OPTION PRINTS IN THE INTERIM REPORT FORMAT.  The report prints site codes for"
^DIC(19,1200,1,2,0)="tests and prints a separate page(s) at the end of the report which lists the"
^DIC(19,1200,1,3,0)="performing lab name, address and site code."
^DIC(19,1200,1,4,0)="This option will print interim reports for a selected patient within a given "
^DIC(19,1200,1,5,0)="time period.  The printout will go inverse date order.  This report will output"
^DIC(19,1200,1,6,0)="all tests for the time period specified.  This option will only print verified"
^DIC(19,1200,1,7,0)="results."
^DIC(19,1200,25)="CUM^LRRP2"
^DIC(19,1200,"U")="REPRINT CUMULATIVE ON A GIVEN "
^DIC(19,1201,0)="LRAC LOC^Reprint cumulative on a given location^^R^10000000020^^^^^^^26"
^DIC(19,1201,1,0)="^19.06^4^4^3021105^^^^"
^DIC(19,1201,1,1,0)="THIS OPTION NOW PRINTS IN THE INTERIM FORMAT.    The report prints site codes for"
^DIC(19,1201,1,2,0)="tests and prints a separate page(s) at the end of the report which lists the"
^DIC(19,1201,1,3,0)="performing lab name, address and site code."
^DIC(19,1201,1,4,0)="  This option reports all verified results from one location for one day."
^DIC(19,1201,25)="CUMSGLE^LRRS"
^DIC(19,1201,"U")="REPRINT CUMULATIVE ON A GIVEN "
^DIC(19,1202,0)="LRAC LOC-LOC^Reprint cumulative from location to location^^R^10000000020^^2221^^^^^26"
^DIC(19,1202,1,0)="^19.06^7^7^3021105^^^^"
^DIC(19,1202,1,1,0)="THIS OPTION PRINTS IN THE INTERIM REPORT FORMAT.  The report prints site codes"
^DIC(19,1202,1,2,0)="for tests and prints a separate page(s) at the end of the report which lists the"
^DIC(19,1202,1,3,0)="performing lab name, address and site code."
^DIC(19,1202,1,4,0)="Detailed report format for all data for one day sorted by location. This option"
^DIC(19,1202,1,5,0)="will only print verified results.  The date chosen for this report is the"
^DIC(19,1202,1,6,0)="collection date.  If a test is ordered on one day and verified on the next day,"
^DIC(19,1202,1,7,0)="you must select the order date to see the report with this option."
^DIC(19,1202,25)="CUM^LRRS"
^DIC(19,1202,"U")="REPRINT CUMULATIVE FROM LOCATI"
^DIC(19,1203,0)="LRAC INITIALIZE^Initialize LAC global & X references^^R^.5^LRLIASON^^^^^^26"
^DIC(19,1203,1,0)="^^7^7^2870203^^^^"
^DIC(19,1203,1,1,0)="This function is used on the occasion the hospital is ready to begin"
^DIC(19,1203,1,2,0)="actual charting of the daily cummulative.  It may be run multiple times"
^DIC(19,1203,1,3,0)="to restart the page numbering during the testing phase of implementation."
^DIC(19,1203,1,4,0)="Once actual charting has begun, it should never be run again!  While"
^DIC(19,1203,1,5,0)="all pages are numbered and dated, the potential for confusion should be"
^DIC(19,1203,1,6,0)="obvious.  If you have access to this function, you are considered by"
^DIC(19,1203,1,7,0)="those who have given you access to be a professional; act accordingly."
^DIC(19,1203,25)="KILL^LRACM"
^DIC(19,1203,"U")="INITIALIZE LAC GLOBAL & X REFE"
^DIC(19,1204,0)="LRLL TYPE^Change Load/Work list type.^^E^.5^LRLIASON^^^^^^26"
^DIC(19,1204,1,0)="^^2^2^2870203^^^^"
^DIC(19,1204,1,1,0)="Allows the user to change the load/work list"
^DIC(19,1204,1,2,0)=" from load list to work list or vice versa."
^DIC(19,1204,30)="LRO(68.2,"
^DIC(19,1204,31)="AEMQ"
^DIC(19,1204,50)="LRO(68.2,"
^DIC(19,1204,51)=".03;.04;.06;.08"
^DIC(19,1204,"U")="CHANGE LOAD/WORK LIST TYPE."
^DIC(19,1206,0)="LRTASK ACS^SUPERVISOR'S SUMMARY REPORT FOR TASKMAN^^R^.5^^^^^^^26"
^DIC(19,1206,1,0)="^^5^5^2940519^^^^"
^DIC(19,1206,1,1,0)="Supervisor's daily summary report based on file 64.5."
^DIC(19,1206,1,2,0)="The format is by location, by patient.  If a summary is desired"
^DIC(19,1206,1,3,0)="by accession number, use the option LR SUP SUMMARY.  LR SUP SUMMARY"
^DIC(19,1206,1,4,0)="is more comprehensive and more bulky.  This option should be chosen"
^DIC(19,1206,1,5,0)="only if the job failed to run."
^DIC(19,1206,25)="LRACS"
^DIC(19,1206,200)="^^"
^DIC(19,1206,200.9)="y"
^DIC(19,1206,"U")="SUPERVISOR'S SUMMARY REPORT FO"
^DIC(19,1207,0)="LRLL CONTROLS^Edit control placement on load/work list^^E^.5^LRSUPER^^^^^^26^^^1"
^DIC(19,1207,1,0)="^^2^2^2870203^^^^"
^DIC(19,1207,1,1,0)="This option allows the user to specify where on the load/work list"
^DIC(19,1207,1,2,0)="controls are to be placed and what tests they are to be."
^DIC(19,1207,15)="K %,A,D2,D3,DIC,DLAYGO,DQ,K,X,Y,Z"
^DIC(19,1207,30)="LRO(68.2,"
^DIC(19,1207,31)="AEMQ"
^DIC(19,1207,50)="LRO(68.2,"
^DIC(19,1207,51)="[LRLL CONTROLS]"
^DIC(19,1207,"U")="EDIT CONTROL PLACEMENT ON LOAD"
^DIC(19,1208,0)="LRPHMAN^Add to collection list^^R^.5^LRPHSUPER^^^^^^26"
^DIC(19,1208,1,0)="^^2^2^2870203^^^^"
^DIC(19,1208,1,1,0)="Creates collection file (the same as LRPHSET), allows user to add more"
^DIC(19,1208,1,2,0)="to a existing file or start a new one."
^DIC(19,1208,25)="LRPHSET"
^DIC(19,1208,"U")="ADD TO COLLECTION LIST"
^DIC(19,1209,0)="LRADD TO ACC^Add tests to a given accession.^^R^.5^LRLAB^^^^^^26"
^DIC(19,1209,1,0)="^^3^3^2870203^^"
^DIC(19,1209,1,1,0)="This function allows the laboratory to add additional tests to an"
^DIC(19,1209,1,2,0)="ALREADY EXISTING accession.  If the accession does not exist, it can't"
^DIC(19,1209,1,3,0)="be done."
^DIC(19,1209,25)="ADD^LRTSTJAM"
^DIC(19,1209,"U")="ADD TESTS TO A GIVEN ACCESSION"
^DIC(19,1210,0)="LRADD TO ORDER^Add tests to an already existing order number.^^R^.5^^^^^^^26"
^DIC(19,1210,1,0)="^^4^4^2870203^^"
^DIC(19,1210,1,1,0)="This function allows tests to be ordered on an already existing"
^DIC(19,1210,1,2,0)="order number.  If any of the tests are already accessioned, this"
^DIC(19,1210,1,3,0)="function cannot be used to add any additional tests; the function"
^DIC(19,1210,1,4,0)="'Add tests to an existing accession' in the lab must be used."
^DIC(19,1210,25)="LRAD2ORD"
^DIC(19,1210,"U")="ADD TESTS TO AN ALREADY EXISTI"
^DIC(19,1211,0)="LRAC FULL PATIENT SUMMARY^Print a full patient summary^^R^10000000020^^^^^^^26"
^DIC(19,1211,1,0)="4^19.06^3^3^3021105^^^^"
^DIC(19,1211,1,1,0)="Prints a full patient summary using the interim report format."
^DIC(19,1211,1,2,0)="It simply captures all lab data on a patient and"
^DIC(19,1211,1,3,0)="prints the performing lab sites and addresses on a separate page(s)."
^DIC(19,1211,25)="SUM^LRACM2"
^DIC(19,1211,"U")="PRINT A FULL PATIENT SUMMARY"
