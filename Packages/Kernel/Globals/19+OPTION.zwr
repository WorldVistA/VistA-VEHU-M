^DIC(19,4570,0)="DGPT CENSUS TRANSMIT^Transmit Census Records^^R^.5^DG PTFTRANS^^^^^^114"
^DIC(19,4570,1,0)="^^2^2^2900810^^^^"
^DIC(19,4570,1,1,0)="This option allows a supervisor to transmit released CENSUS records"
^DIC(19,4570,1,2,0)="to Austin."
^DIC(19,4570,25)="4^DGPTC"
^DIC(19,4570,"U")="TRANSMIT CENSUS RECORDS"
^DIC(19,4571,0)="DGPT CENSUS TRANSMITTED^Transmitted Census Records List^^R^.5^^^^^^^114"
^DIC(19,4571,1,0)="^^4^4^2900613^^^^"
^DIC(19,4571,1,1,0)="This option allows the user to print a list of CENSUS records"
^DIC(19,4571,1,2,0)="that have been transmitted to Austin."
^DIC(19,4571,1,3,0)=" "
^DIC(19,4571,1,4,0)="The user is prompted for a transmission date range."
^DIC(19,4571,25)="3^DGPTCO"
^DIC(19,4571,"U")="TRANSMITTED CENSUS RECORDS LIS"
^DIC(19,4572,0)="DGPT CENSUS OPEN RECORD^Open Closed Census Records^^R^.5^DG PTFREL^^^^^^114"
^DIC(19,4572,1,0)="2^^2^2^2900613^"
^DIC(19,4572,1,1,0)="This option allows the user to re-open a previously closed"
^DIC(19,4572,1,2,0)="CENSUS record."
^DIC(19,4572,25)="3^DGPTC"
^DIC(19,4572,"U")="OPEN CLOSED CENSUS RECORDS"
^DIC(19,4573,0)="DGPT CENSUS INQUIRE^Inquire Census Record^^R^.5^^^^^^^114"
^DIC(19,4573,1,0)="^^10^10^2900802^^^^"
^DIC(19,4573,1,1,0)="This option allows the user to print the CENSUS record for an"
^DIC(19,4573,1,2,0)="admission."
^DIC(19,4573,1,3,0)=" "
^DIC(19,4573,1,4,0)="When a PTF record is 'closed for census' a snap shot of the PTF"
^DIC(19,4573,1,5,0)="record is taken.  This snap shot is the census record that is"
^DIC(19,4573,1,6,0)="transmitted to Austin and is used by this option."
^DIC(19,4573,1,7,0)=" "
^DIC(19,4573,1,8,0)="If the PTF record has not yet been 'closed for census' then the"
^DIC(19,4573,1,9,0)="PTF record is displayed/printed since the census record will not"
^DIC(19,4573,1,10,0)="exist."
^DIC(19,4573,25)="CEN^DGPTFMO1"
^DIC(19,4573,99)="54534,76286"
^DIC(19,4573,"U")="INQUIRE CENSUS RECORD"
^DIC(19,4574,0)="DGPT CENSUS RECORD REPORT^Comprehensive Census Report^^P^.5^^^^^^^114^^^1"
^DIC(19,4574,1,0)="2^^10^10^2900808^^^^"
^DIC(19,4574,1,1,0)="This option will allow the user to print all CENSUS records for "
^DIC(19,4574,1,2,0)="an admission date range."
^DIC(19,4574,1,3,0)=" "
^DIC(19,4574,1,4,0)="When a PTF record is 'closed for census' a snap shot of the PTF"
^DIC(19,4574,1,5,0)="record is taken.  This snap shot is the census record that is"
^DIC(19,4574,1,6,0)="transmitted to Austin and is used by this option."
^DIC(19,4574,1,7,0)=" "
^DIC(19,4574,1,8,0)="If the PTF record has not yet been 'closed for census' then the"
^DIC(19,4574,1,9,0)="PTF record is displayed/printed since the census record will not"
^DIC(19,4574,1,10,0)="exist."
^DIC(19,4574,15)="K DG1,DGCI,DGCN,DGCST,DGPTFMT"
^DIC(19,4574,60)="DGPT("
^DIC(19,4574,62)=0
^DIC(19,4574,63)="[DGPT CENSUS INQUIRY]"
^DIC(19,4574,64)="[DGPTF]"
^DIC(19,4574,65)=""
^DIC(19,4574,66)=""
^DIC(19,4574,69)="D OPT^DGPTFMO1"
^DIC(19,4574,"U")="COMPREHENSIVE CENSUS REPORT"
^DIC(19,4575,0)="DGPT CENSUS OPEN RELEASED^Open Released or Transmitted Census Records^^R^.5^DG PTFTRANS^^^^^^114"
^DIC(19,4575,1,0)="^^2^2^2900810^^^^"
^DIC(19,4575,1,1,0)="This option allows the supervisor to open CENSUS records that have"
^DIC(19,4575,1,2,0)="been released or transmitted to Austin."
^DIC(19,4575,25)="5^DGPTC"
^DIC(19,4575,"U")="OPEN RELEASED OR TRANSMITTED C"
^DIC(19,4576,0)="DGPT CENSUS SUPERVISOR^Supervisor Menu^^M^10000000020^DG PTFSUP^^^^^^114"
^DIC(19,4576,1,0)="^^3^3^3060317^"
^DIC(19,4576,1,1,0)="This menu contains options needed to manage the PTF Census"
^DIC(19,4576,1,2,0)="module.  Options include, displaying a Census Date and"
^DIC(19,4576,1,3,0)="regenerating the CENSUS WORKFILE."
^DIC(19,4576,10,0)="^19.01IP^2^2"
^DIC(19,4576,10,1,0)="13313^"
^DIC(19,4576,10,2,0)="4578^"
^DIC(19,4576,10,"B",4578,2)=""
^DIC(19,4576,10,"B",13313,1)=""
^DIC(19,4576,99)="62195,28623"
^DIC(19,4576,"U")="SUPERVISOR MENU"
^DIC(19,4577,0)="DGPT CENSUS DATE EDIT^Edit Census Date Parameters^^R^.5^DG PTFSUP^^^^^^114"
^DIC(19,4577,1,0)="^^9^9^2900613^^^^"
^DIC(19,4577,1,1,0)="This option allows the supervisor to edit Census Date specific"
^DIC(19,4577,1,2,0)="parameters, like CLOSE-OUT date."
^DIC(19,4577,1,3,0)=" "
^DIC(19,4577,1,4,0)="Also, there is a 'Quick Parameter Profile' displayed at the"
^DIC(19,4577,1,5,0)="beginning of this option.  This profile can be used to view"
^DIC(19,4577,1,6,0)="the parameters.  One parameter, WORKFILE LAST UPDATE, is a"
^DIC(19,4577,1,7,0)="parameter that is updated at the end of the 'Regenerate"
^DIC(19,4577,1,8,0)="Census Workfile'.  This profile can be used to monitor the completion"
^DIC(19,4577,1,9,0)="of the regeneration."
^DIC(19,4577,25)="7^DGPTC"
^DIC(19,4577,"U")="EDIT CENSUS DATE PARAMETERS"
^DIC(19,4578,0)="DGPT CENSUS REGEN WORKFILE^Regenerate Census Workfile^^R^10000000020^DG PTFSUP^^^^^^114"
^DIC(19,4578,1,0)="^^39^39^3060317^"
^DIC(19,4578,1,1,0)="This options allows the supervisor to regenerate the CENSUS WORKFILE"
^DIC(19,4578,1,2,0)="entries for a particular census date."
^DIC(19,4578,1,3,0)=" "
^DIC(19,4578,1,4,0)="This option places one entry in the CENSUS WORKFILE for each"
^DIC(19,4578,1,5,0)="admission needing a census record for that selected census date."
^DIC(19,4578,1,6,0)=" "
^DIC(19,4578,1,7,0)="The workfile is an extract of data from the admission data for the"
^DIC(19,4578,1,8,0)="patients who were inpatients as of 11:59 on the census date.  This"
^DIC(19,4578,1,9,0)="workfile makes the printing of the 'Census Status Report' faster "
^DIC(19,4578,1,10,0)="than otherwise would be possible.  Without this workfile, it"
^DIC(19,4578,1,11,0)="would be neccessary to scan all admissions prior to the census "
^DIC(19,4578,1,12,0)="date to determine if the admission was still active on the census date."
^DIC(19,4578,1,13,0)=" "
^DIC(19,4578,1,14,0)="This option only needs to be run at the beginning of the census process "
^DIC(19,4578,1,15,0)="and at the end of the process to ensure that no admissions have been "
^DIC(19,4578,1,16,0)="added via bed control.  However, this option can be run at anytime"
^DIC(19,4578,1,17,0)="if desired. "
^DIC(19,4578,1,18,0)=" "
^DIC(19,4578,1,19,0)="NOTE:  The 'Census Status Report' uses the the CENSUS WORKFILE. "
^DIC(19,4578,1,20,0)="       As a result, the 'Census Status Report' should not be run until "
^DIC(19,4578,1,21,0)="       after the regeneration is complete."
^DIC(19,4578,1,22,0)=" "
^DIC(19,4578,1,23,0)="NOTE:  The first time the 'Census Status Report' is run for a"
^DIC(19,4578,1,24,0)="       particular census date, the CENSUS WORKFILE is automatically"
^DIC(19,4578,1,25,0)="       generated."
^DIC(19,4578,1,26,0)=" "
^DIC(19,4578,1,27,0)="At the end of the regeneration process, the WORKFILE LAST UPDATED"
^DIC(19,4578,1,28,0)="field in the PTF CENSUS DATE file is updated with the current"
^DIC(19,4578,1,29,0)="date and time."
^DIC(19,4578,1,30,0)=" "
^DIC(19,4578,1,31,0)="The 'Display Census Date Parameters' option displays all the "
^DIC(19,4578,1,32,0)="parameters associated with a census date, including WORKFILE "
^DIC(19,4578,1,33,0)="LAST UPDATED. A supervisor can use this option to"
^DIC(19,4578,1,34,0)="monitor the completion of a regeneration."
^DIC(19,4578,1,35,0)=" "
^DIC(19,4578,1,36,0)="Also, at the end of the regeneration process, a Mailman bulletin"
^DIC(19,4578,1,37,0)="is sent to the user requesting the regeneration.  This bulletin"
^DIC(19,4578,1,38,0)="will indicate any changes that may have occurred as a result of"
^DIC(19,4578,1,39,0)="regeneration."
^DIC(19,4578,25)="GEN^DGPTCR"
^DIC(19,4578,"U")="REGENERATE CENSUS WORKFILE"
^DIC(19,4579,0)="DG MEANS TEST VIEW TEST^View a Past Means Test^^A^.5^^^^^^^114^^1^1"
^DIC(19,4579,1,0)="^^1^1^2920403^^^"
^DIC(19,4579,1,1,0)="This option allows view only of past means tests."
^DIC(19,4579,15)="K DGMTYPT"
^DIC(19,4579,20)="S DGMTYPT=1 D EN^DGMTV"
^DIC(19,4579,25)=""
^DIC(19,4579,"U")="VIEW A PAST MEANS TEST"
