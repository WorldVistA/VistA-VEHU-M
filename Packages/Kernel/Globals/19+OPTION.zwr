^DIC(19,13954,0)="HLO TROUBLESHOOTING MENU^TROUBLESHOOTING MENU^^M^10000000216^^^^^^y^304"
^DIC(19,13954,1,0)="^19.06^4^4^3100318^^^^"
^DIC(19,13954,1,1,0)="This option contains a menu of toolS used to troubleshoot"
^DIC(19,13954,1,2,0)="HLO."
^DIC(19,13954,1,3,0)=""
^DIC(19,13954,1,4,0)=""
^DIC(19,13954,10,0)="^19.01IP^4^4"
