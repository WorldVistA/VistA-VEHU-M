^DIC(19,16902,10,"B",16904,2)=""
^DIC(19,16902,10,"B",16905,3)=""
^DIC(19,16902,10,"B",16906,4)=""
^DIC(19,16902,10,"B",16907,5)=""
^DIC(19,16902,10,"C",1,2)=""
^DIC(19,16902,10,"C",2,1)=""
^DIC(19,16902,10,"C",3,3)=""
^DIC(19,16902,10,"C",4,4)=""
^DIC(19,16902,10,"C",5,5)=""
^DIC(19,16902,99)="67411,49178"
^DIC(19,16902,"U")="TIU PARAMETERS MENU"
^DIC(19,16903,0)="EHM-01724^Modify Upload Parameters^^A^1^^^^^^y^516^^1^^"
^DIC(19,16903,1,0)="^^3^3^3240328^^^"
^DIC(19,16903,1,1,0)="This option allows the definition and modification of parameters for the"
^DIC(19,16903,1,2,0)="batch upload of documents into DHCP."
^DIC(19,16903,1,3,0)="Cloned from ""TIU UPLOAD PARAMETER EDIT"" option."
^DIC(19,16903,3)=""
^DIC(19,16903,20)="D MAIN^TIUUPEDT"
^DIC(19,16903,99.1)="57055,56051"
^DIC(19,16903,"U")="MODIFY UPLOAD PARAMETERS"
^DIC(19,16904,0)="EHM-01725^Basic TIU Parameters^^A^1^^^^^^y^516^^1^^"
^DIC(19,16904,1,0)="^^3^3^3240328^^"
^DIC(19,16904,1,1,0)="This option allows the user to enter the basic, or general parameters which"
^DIC(19,16904,1,2,0)="govern the behavior of the Text Integration Utilities."
^DIC(19,16904,1,3,0)="Cloned from ""TIU BASIC PARAMETER EDIT"" option."
^DIC(19,16904,3)=""
^DIC(19,16904,20)="D MAIN^TIUBPEDT"
^DIC(19,16904,99.1)="57887,55877"
^DIC(19,16904,"U")="BASIC TIU PARAMETERS"
^DIC(19,16905,0)="EHM-01726^Document Parameter Edit^^A^1^^^^^^y^516^^1^^"
^DIC(19,16905,1,0)="^^4^4^3240328^^"
^DIC(19,16905,1,1,0)="This option allows the user to enter the parameters which apply to specific"
^DIC(19,16905,1,2,0)="documents (i.e., Titles), or groups of documents (i.e., Classes, or"
^DIC(19,16905,1,3,0)="Document Classes). "
^DIC(19,16905,1,4,0)="Cloned from ""TIU DOCUMENT PARAMETER EDIT"" option."
^DIC(19,16905,3)=""
^DIC(19,16905,20)="D MAIN^TIUDPEDT"
^DIC(19,16905,"U")="DOCUMENT PARAMETER EDIT"
^DIC(19,16906,0)="EHM-01727^Progress Notes Batch Print Locations^^R^1^^^^^^^516^^^^"
^DIC(19,16906,1,0)="^^4^4^3240328^^"
^DIC(19,16906,1,1,0)="Option for entering hospital locations used for [TIU PRINT PN OUTPT LOC]"
^DIC(19,16906,1,2,0)="and [TIU PRINT PN WARD] options.  If locations are not entered in this"
^DIC(19,16906,1,3,0)="file they will not be selectable from these options."
^DIC(19,16906,1,4,0)="Cloned from ""TIU PRINT PN LOC PARAMS"" option."
^DIC(19,16906,3)=""
^DIC(19,16906,15)=""
^DIC(19,16906,25)="ADD^TIUPRPN4"
^DIC(19,16906,"U")="PROGRESS NOTES BATCH PRINT LOC"
^DIC(19,16907,0)="EHM-01728^Division - Progress Notes Print Params^^R^1^^^^^^^516^^^^"
^DIC(19,16907,1,0)="^^6^6^3240328^^"
^DIC(19,16907,1,1,0)="These parameters are used by the [TIU PRINT PN BATCH INTERACTIVE] and"
^DIC(19,16907,1,2,0)="[TIU PRINT PN BATCH SCHEDULED] options.  If the site wants a header"
^DIC(19,16907,1,3,0)="other than what is returned by $$SITE^VASITE, the .02 field of the 1st"
^DIC(19,16907,1,4,0)="entry in this file will be used.  For example, Waco-Temple-Marlin can have"
^DIC(19,16907,1,5,0)="the institution of their progress notes as 'CENTRAL TEXAS HCF.'"
^DIC(19,16907,1,6,0)="Cloned from ""TIU PRINT PN DIV PARAMS"" option."
^DIC(19,16907,3)=""
^DIC(19,16907,25)="DIV^TIUPRPN4"
^DIC(19,16907,"U")="DIVISION - PROGRESS NOTES PRIN"
^DIC(19,16908,0)="EHM-01729^TIU Template Mgmt Functions^^M^1^^^^^^^516^^^^"
^DIC(19,16908,1,0)="^19.06^4^4^3240328^^"
^DIC(19,16908,1,1,0)="This option is a menu option which contains other options providing TIU"
^DIC(19,16908,1,2,0)="template management functions to CACs or other managers with access to the"
^DIC(19,16908,1,3,0)="TIU IRM MAINTENANCE MENU option."
^DIC(19,16908,1,4,0)="Cloned from ""TIU IRM TEMPLATE MGMT"" option."
^DIC(19,16908,3)=""
^DIC(19,16908,10,0)="^19.01IP^5^5"
^DIC(19,16908,10,1,0)="16909^1^1"
^DIC(19,16908,10,2,0)="16910^2^2"
^DIC(19,16908,10,3,0)="16911^3^3"
^DIC(19,16908,10,4,0)="16912^4^4"
^DIC(19,16908,10,5,0)="16913^5"
^DIC(19,16908,10,"B",16909,1)=""
^DIC(19,16908,10,"B",16910,2)=""
^DIC(19,16908,10,"B",16911,3)=""
^DIC(19,16908,10,"B",16912,4)=""
^DIC(19,16908,10,"B",16913,5)=""
^DIC(19,16908,10,"C",1,1)=""
^DIC(19,16908,10,"C",2,2)=""
^DIC(19,16908,10,"C",3,3)=""
^DIC(19,16908,10,"C",4,4)=""
^DIC(19,16908,10,"C",5,5)=""
^DIC(19,16908,99)="67411,49178"
^DIC(19,16908,"U")="TIU TEMPLATE MGMT FUNCTIONS"
^DIC(19,16909,0)="EHM-01730^Delete TIU templates for selected user.^^A^1^^^^^^^516^^1^^"
^DIC(19,16909,1,0)="^19.06^3^3^3240328^^"
^DIC(19,16909,1,1,0)="This option accepts user input for an individual from the NEW PERSON file,"
^DIC(19,16909,1,2,0)="then deletes non-shared TIU templates for that user."
^DIC(19,16909,1,3,0)="Cloned from ""TIU TEMPLATE CAC USER DELETE"" option."
^DIC(19,16909,3)=""
^DIC(19,16909,20)="D SELUSR^TIUSRVT3"
^DIC(19,16909,"U")="DELETE TIU TEMPLATES FOR SELEC"
^DIC(19,16910,0)="EHM-01731^Edit auto template cleanup parameter.^^A^1^^^^^^^516^^1^^"
^DIC(19,16910,1,0)="^19.06^5^5^3240328^^"
^DIC(19,16910,1,1,0)="This option accesses the TIU TEMPLATE USER AUTO DELETE parameter and"
^DIC(19,16910,1,2,0)="toggles the entry on or off, providing for automatic deletion of"
^DIC(19,16910,1,3,0)="non-shared TIU templates for a user upon termination - or skipping any"
^DIC(19,16910,1,4,0)="such automatic action."
^DIC(19,16910,1,5,0)="Cloned from ""TIU TEMPLATE USER DELETE PARAM"" option."
^DIC(19,16910,3)=""
^DIC(19,16910,20)="D PARSET^TIUSRVT4"
^DIC(19,16910,"U")="EDIT AUTO TEMPLATE CLEANUP PAR"
^DIC(19,16911,0)="EHM-01732^Delete templates for ALL terminated users.^^A^1^^^^^^^516^^1^^"
^DIC(19,16911,1,0)="^^4^4^3240328^"
^DIC(19,16911,1,1,0)="This option allows a CAC or other manager to remove all non-shared TIU"
^DIC(19,16911,1,2,0)="templates for all users who have been terminated.  It orders through the"
^DIC(19,16911,1,3,0)="files recursively and then deletes those that have not been shared."
^DIC(19,16911,1,4,0)="Cloned from ""TIU TEMPLATE DELETE TERM ALL"" option."
^DIC(19,16911,3)=""
^DIC(19,16911,20)="D CTRL^TIUSRVT4"
^DIC(19,16911,"U")="DELETE TEMPLATES FOR ALL TERMI"
^DIC(19,16912,0)="EHM-01733^Set consult templates to read-only.^^R^1^^^^^^^516^^^^"
^DIC(19,16912,1,0)="^19.06^17^17^3240328^^^^"
^DIC(19,16912,1,1,0)="This option allows the user to lock down a consult TIU Template, and it's "
^DIC(19,16912,1,2,0)="associated Template Fields. Once the template and fields are locked down,"
^DIC(19,16912,1,3,0)="they cannot be edited in the CPRS GUI Template Editor."
^DIC(19,16912,1,4,0)="Certain consult services depend on template content that should not be"
^DIC(19,16912,1,5,0)="edited at the local facility. For example, the NON VA CARE HCPS"
^DIC(19,16912,1,6,0)="HEMODIALYSIS and NON VA CARE HCPS PERITONEAL DIALYSIS templates should"
^DIC(19,16912,1,7,0)="never be edited at the facility. These templates are used in HL7"
^DIC(19,16912,1,8,0)="transmissions to the Referral & Authorization System (RAS) and those"
^DIC(19,16912,1,9,0)="transmissions may be disrupted if the template has been edited."
^DIC(19,16912,1,10,0)=" "
^DIC(19,16912,1,11,0)="When using this option, the user is prompted for the name of a TIU "
^DIC(19,16912,1,12,0)="Template. The selected template must have already been linked to a consult"
^DIC(19,16912,1,13,0)="service via the Template Editor. Unlinked templates are not avaiable for"
^DIC(19,16912,1,14,0)="selection. Adding or removing templates via this option is actually "
^DIC(19,16912,1,15,0)="setting/removing values into the TIU TEMPLATE CONSULT LOCK parameter."
^DIC(19,16912,1,16,0)="These parameter values are set at the System level."
^DIC(19,16912,1,17,0)="Cloned from ""TIU TEMPLATE CONSULT LOCK"" option."
^DIC(19,16912,3)=""
^DIC(19,16912,25)="SETCNLOK^TIUSRVT5"
^DIC(19,16912,"U")="SET CONSULT TEMPLATES TO READ-"
^DIC(19,16913,0)="EHM-01734^Analyze/Update the TIU TEMPLATE File^^R^1^^^^^^^^^^^"
^DIC(19,16913,1,0)="^19.06^10^10^3240328^^^^"
^DIC(19,16913,1,1,0)="This option provides functionality to allow a user to find entries in "
^DIC(19,16913,1,2,0)="File #8927 that contain boilerplate lines of text >80 characters and "
^DIC(19,16913,1,3,0)="entries that do not have any items, text, or dialogs, etc."
^DIC(19,16913,1,4,0)=" "
^DIC(19,16913,1,5,0)="The generated report may be viewed, printed, or emailed for verification "
^DIC(19,16913,1,6,0)="purposes."
^DIC(19,16913,1,7,0)=" "
^DIC(19,16913,1,8,0)="The user may also choose to update the entries in the file to fix long "
^DIC(19,16913,1,9,0)="lines and unlinked entries."
^DIC(19,16913,1,10,0)="Cloned from ""TIU ANALYZE/UPDATE FILE 8927"" option."
^DIC(19,16913,3)=""
^DIC(19,16913,25)="EN^TIUFWRAP"
^DIC(19,16913,99.1)="65923,50064"
^DIC(19,16913,"U")="ANALYZE/UPDATE THE TIU TEMPLAT"
