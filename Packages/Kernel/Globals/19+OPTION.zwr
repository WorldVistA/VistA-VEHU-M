^DIC(19,16232,0)="EHM-01053^Edit User/User Group Defaults^^R^1^^^^^^^512^^^^"
^DIC(19,16232,1,0)="^^3^3^3240328^^^"
^DIC(19,16232,1,1,0)="This option allows a manager to modify user defaults for either a single"
^DIC(19,16232,1,2,0)="user or a user group (based on service or location)."
^DIC(19,16232,1,3,0)="Cloned from ""LEX MGR USER DEFAULTS"" option."
