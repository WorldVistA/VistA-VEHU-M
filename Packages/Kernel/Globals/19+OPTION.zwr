^DIC(19,7953,1,0)="^^8^8^2931213^^^^"
^DIC(19,7953,1,1,0)="The user selects a pay period and an employee. The data on that time"
^DIC(19,7953,1,2,0)="card is checked by a series of computer routines that apply payroll rules"
^DIC(19,7953,1,3,0)="and builds an 8B record that will be sent to the Austin Automation"
^DIC(19,7953,1,4,0)="Center (AAC)."
^DIC(19,7953,1,5,0)=" "
^DIC(19,7953,1,6,0)="The pay period, employee name, social security number, time card"
^DIC(19,7953,1,7,0)="""stub record"", and any data values that will be sent to the AAC are"
^DIC(19,7953,1,8,0)="displayed."
