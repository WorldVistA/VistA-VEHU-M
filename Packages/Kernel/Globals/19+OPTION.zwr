^DIC(19,7792,0)="FBCH DELETE VOID^CH Delete Void Payment^^R^1^FBAA LEVEL 2^^^^^^344^^1"
^DIC(19,7792,1,0)="^19.06^3^3^3140516^^"
^DIC(19,7792,1,1,0)="Searches all finalized payments that contain a VOID status for a"
^DIC(19,7792,1,2,0)="specified patient and vendor.  Provides user with a list of voided"
