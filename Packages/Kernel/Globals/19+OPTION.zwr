^DIC(19,3376,"U")="OTHER MAILMAN FUNCTIONS"
^DIC(19,3377,0)="XMR-UCI-RCV^Receive Messages from Another UCI^^R^11748^^^^^^^54^^"
^DIC(19,3377,1,0)="^19.06^18^18^3020509^^^^"
^DIC(19,3377,1,1,0)="This option is the converse to another called ""SEND MESSAGES TO OTHER UCI""."
^DIC(19,3377,1,2,0)="The SEND side loads messages into the %ZISL(4.281 global."
^DIC(19,3377,1,3,0)="The RECEIVE side reads messages from the %ZISL(4.281 global."
^DIC(19,3377,1,4,0)=" "
^DIC(19,3377,1,5,0)="To use:"
^DIC(19,3377,1,6,0)=" "
^DIC(19,3377,1,7,0)=" 1.  Log onto the UCI you wish to transmit message from."
^DIC(19,3377,1,8,0)=" 2.  Use the SEND option.  It will load all the messages for a particular"
^DIC(19,3377,1,9,0)="     domain into ^%ZISL(4.281."
^DIC(19,3377,1,10,0)=" 3.  Log onto the UCI you wish to receive the messages into."
^DIC(19,3377,1,11,0)=" 4.  Use this option.  It will read through the %ZISL(4.281 global looking"
^DIC(19,3377,1,12,0)="     for a message to receive (don't worry, it only checks the first line"
^DIC(19,3377,1,13,0)="     of each potential message/task) and creates a message for them."
^DIC(19,3377,1,14,0)=" "
^DIC(19,3377,1,15,0)="Requirements:"
^DIC(19,3377,1,16,0)=" "
^DIC(19,3377,1,17,0)=" 1.  The receive side needs to have been set up as a domain."
^DIC(19,3377,1,18,0)=" 2.  The %ZISL(4.281 global must be translated and accessible from both UCIs."
^DIC(19,3377,25)="GLBIN^XMCB"
^DIC(19,3377,"U")="RECEIVE MESSAGES FROM ANOTHER "
^DIC(19,3378,0)="XMR-UCI-SEND^Send Messages to Another UCI^^R^11748^^^^^^^54^^"
^DIC(19,3378,1,0)="^19.06^2^2^3020312^^"
^DIC(19,3378,1,1,0)="This option is the converse to one called ""RECEIVE MESSAGES FROM ANOTHER UCI."""
^DIC(19,3378,1,2,0)="Please see the description of that option for further information."
^DIC(19,3378,25)="GLBOUT^XMCB"
^DIC(19,3378,"U")="SEND MESSAGES TO ANOTHER UCI"
^DIC(19,3379,0)="XMUT-REC-DELETE^Delete Found Messages from Found Messages List^^R^11748^^^^^^^^^"
