^DIC(19,525,0)="DG CONSISTENCY PURGE^Purge Inconsistent Data Elements^^R^10000000020^DG CONSISTENCY^^^^^^114"
^DIC(19,525,1,0)="^^5^5^3040827^"
^DIC(19,525,1,1,0)="This option is used to purge data from the INCONSISTENT DATA file."
^DIC(19,525,1,2,0)="The user selects a date from which the option will check each patient"
^DIC(19,525,1,3,0)="to see if he/she has been admitted or registered since that date."
^DIC(19,525,1,4,0)="If not, the inconsistent data elements for that patient will be "
^DIC(19,525,1,5,0)="removed from the file."
^DIC(19,525,25)="DGRPCK"
^DIC(19,525,"U")="PURGE INCONSISTENT DATA ELEMEN"
^DIC(19,526,0)="DG CONSISTENCY REBUILD^Rebuild Inconsistency File^^R^.5^DG CONSISTENCY^^^^^^114"
^DIC(19,526,1,0)="^^7^7^2870311^"
^DIC(19,526,1,1,0)="This option is used to rebuild (or add onto) the INCONSISTENT DATA file."
^DIC(19,526,1,2,0)="The user will be asked if he wishes to delete all existing data and"
^DIC(19,526,1,3,0)="rebuild the file or simply add to the existing file.  The user will be"
^DIC(19,526,1,4,0)="asked to select a date.  The routine will then check all persons"
^DIC(19,526,1,5,0)="admitted or registered on or after that date for inconsistencies.  If"
^DIC(19,526,1,6,0)="any are found to exist they will be stored in the INCONSISTENT DATA"
^DIC(19,526,1,7,0)="file."
^DIC(19,526,25)="DGRPCR"
^DIC(19,526,"U")="REBUILD INCONSISTENCY FILE"
