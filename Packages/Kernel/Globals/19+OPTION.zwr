^DIC(19,16585,0)="EHM-01406^PCE V File Cross Reference Repair^^R^1^^^^^^y^507^^^^"
^DIC(19,16585,1,0)="^^7^7^3240328^"
^DIC(19,16585,1,1,0)="This option provides a number of options that allow the user to"
^DIC(19,16585,1,2,0)=" both report and fix broken V File Cross References. The V Files include V"
^DIC(19,16585,1,3,0)=" PROVIDER (9000010.06), V CPT(9000010.18), diagnosis V POV (9000010.07), "
^DIC(19,16585,1,4,0)=" VISIT(9000010), V IMMUNIZATION(9000010.11), V SKIN TEST(9000010.12), V"
^DIC(19,16585,1,5,0)=" EXAM(9000010.13), V TREATMENT(9000010.15), V PATIENT ED(9000010.16), and V"
^DIC(19,16585,1,6,0)=" HEALTH FACTOR(9000010.23)."
^DIC(19,16585,1,7,0)="Cloned from ""PX V File Repair"" option."
