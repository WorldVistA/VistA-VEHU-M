^DIC(19,16099,"U")="CPRS HEALTH SUMMARY DISPLAY/ED"
^DIC(19,16100,0)="EHM-00921^Display Site Health Summary List Defaults^^R^1^^^^^^^^^^^"
^DIC(19,16100,1,0)="^^6^6^3240328^"
^DIC(19,16100,1,1,0)="Use this option to display the site defaults for building the list"
^DIC(19,16100,1,2,0)="of Health Summary Types on the Reports Tab in CPRS. The display "
^DIC(19,16100,1,3,0)="includes the method for building the list and the precedence of "
^DIC(19,16100,1,4,0)="parameters. These default values will be used in the event that the"
^DIC(19,16100,1,5,0)="user has not established user preferences."
^DIC(19,16100,1,6,0)="Cloned from ""GMTS GUI SITE DISPLAY DEFAULTS"" option."
^DIC(19,16100,3)=""
^DIC(19,16100,25)="DS^GMTSXA"
^DIC(19,16100,"U")="DISPLAY SITE HEALTH SUMMARY LI"
^DIC(19,16101,0)="EHM-00922^Edit Default HS Type List Compile Method^^R^1^^^^^^^160^^^^"
^DIC(19,16101,1,0)="^^14^14^3240328^"
^DIC(19,16101,1,1,0)="Use this option to modifiy how the list of Health Summary Types "
^DIC(19,16101,1,2,0)="is to be built for the site.  This method will be used for all "
^DIC(19,16101,1,3,0)="users who do not have user preferences set. "
^DIC(19,16101,1,4,0)="  "
^DIC(19,16101,1,5,0)="  Overwrite  System-defined Health Summary Types are added to "
^DIC(19,16101,1,6,0)="             the list. If there are User-defined Health Summary"
^DIC(19,16101,1,7,0)="             Types, then they will replace the System defined "
^DIC(19,16101,1,8,0)="             Health Summary Types already on the list."
^DIC(19,16101,1,9,0)="  "
^DIC(19,16101,1,10,0)="  Append     System-defined Health Summary Types are added to "
^DIC(19,16101,1,11,0)="             the list. If there are User-defined Health Summary"
^DIC(19,16101,1,12,0)="             Types, then they will added to the list along"
^DIC(19,16101,1,13,0)="             with the System defined types."
^DIC(19,16101,1,14,0)="Cloned from ""GMTS GUI SITE COMPILE METHOD"" option."
^DIC(19,16101,3)=""
^DIC(19,16101,25)="MS^GMTSXA"
^DIC(19,16101,"U")="EDIT DEFAULT HS TYPE LIST COMP"
