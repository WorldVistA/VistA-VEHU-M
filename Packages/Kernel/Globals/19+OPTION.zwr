^DIC(19,2321,"U")="PRINT SET UP LISTS"
^DIC(19,2322,0)="PSGW ZERO USAGE^Zero Usage Report (80 column)^^R^.5^^^^^^^"
^DIC(19,2322,1,0)="^^3^3^2910206^^^"
^DIC(19,2322,1,1,0)="For a user selected time frame, this report prints all items with no"
^DIC(19,2322,1,2,0)="usage.  The report may be printed for a one AOU, several AOUs, or"
^DIC(19,2322,1,3,0)="for ALL AOUs."
^DIC(19,2322,25)="PSGWNU"
^DIC(19,2322,"U")="ZERO USAGE REPORT (80 COLUMN)"
^DIC(19,2323,0)="PSGW RETURNS BREAKDOWN^Returns Analysis Report (80 column)^^R^.5^^^^^^^"
^DIC(19,2323,1,0)="^^4^4^2910212^^^^"
^DIC(19,2323,1,1,0)="For a user selected date range, this report shows the break down of"
^DIC(19,2323,1,2,0)="returns information.  The report may be printed for one AOU, several"
^DIC(19,2323,1,3,0)="AOUs or for all AOUs.  Return date, return quantity, and return"
^DIC(19,2323,1,4,0)="reason are shown for each drug."
^DIC(19,2323,25)="PSGWDR"
^DIC(19,2323,"U")="RETURNS ANALYSIS REPORT (80 CO"
