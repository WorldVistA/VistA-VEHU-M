^DIC(19,11199,0)="HBHCRP21^Total Visits by Date Range Report  (80)^^R^1^^^^^^^328"
^DIC(19,11199,1,0)="^19.06^22^22^3150408^^"
^DIC(19,11199,1,1,0)="This option prints HBPC Total Visits by Date Range Report.  User is prompted to"
^DIC(19,11199,1,2,0)="enter date range for inclusion on report.  Visit is omitted from report if"
^DIC(19,11199,1,3,0)="contains any of the following CPT codes: "
^DIC(19,11199,1,4,0)=" "
^DIC(19,11199,1,5,0)="    Active                               Inactive/Historical"
^DIC(19,11199,1,6,0)="  98966  HC PRO PHONE CALL 5-10 MIN    99361  PHYSICIAN/TEAM CONFERENCE"
^DIC(19,11199,1,7,0)="  98967  HC PRO PHONE CALL 11-20 MIN   99362  PHYSICIAN/TEAM CONFERENCE"
^DIC(19,11199,1,8,0)="  98968  HC PRO PHONE CALL 21-30 MIN   99371  PHYSICIAN PHONE CONSULTATION"
^DIC(19,11199,1,9,0)="  99358  PROLONGED SERV, W/O CONTACT   99372  PHYSICIAN PHONE CONSULTATION"
^DIC(19,11199,1,10,0)="  99359  PROLONGED SERV, W/O CONTACT   99373  PHYSICIAN PHONE CONSULTATION"
^DIC(19,11199,1,11,0)="  99367  TEAM CONF W/O PAT BY PHYS     99376  CARE PLAN OVERSIGHT/OVER 60"
^DIC(19,11199,1,12,0)="  99368  TEAM CONF W/O PAT BY HC PRO"
^DIC(19,11199,1,13,0)="  99374  HOME HEALTH CARE SUPERVISION"
^DIC(19,11199,1,14,0)="  99375  HOME HEALTH CARE SUPERVISION"
^DIC(19,11199,1,15,0)="  99441  PHONE E/M PHYS/QHP 5-10 MIN"
^DIC(19,11199,1,16,0)="  99442  PHONE E/M PHYS/QHP 11-20 MIN"
^DIC(19,11199,1,17,0)="  99443  PHONE E/M PHYS/QHP 21-30 MIN"
^DIC(19,11199,1,18,0)=" "
^DIC(19,11199,1,19,0)="User can also select additional CPT codes to omit from report.  Report"
^DIC(19,11199,1,20,0)="includes:  Patient Name, SSN Last Four, Total Visits per patient, Date"
^DIC(19,11199,1,21,0)="(admitted to HBPC program) & Discharge Date (if applicable), with grand totals"
^DIC(19,11199,1,22,0)="of patients & visits.  Report prints in 80 column format. "
^DIC(19,11199,25)="HBHCRP21"
^DIC(19,11199,"U")="TOTAL VISITS BY DATE RANGE REP"
