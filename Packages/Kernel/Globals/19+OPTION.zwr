^DIC(19,5313,0)="ECTW SD MENU^Clinic Scheduling^^M^.5^^^^^^^"
^DIC(19,5313,1,0)="^^1^1^2901129^"
^DIC(19,5313,1,1,0)="This sub-menu contains clinic scheduling workload reports."
^DIC(19,5313,10,0)="^19.01PI^2^2"
^DIC(19,5313,10,1,0)="2694^1"
^DIC(19,5313,10,2,0)="653^2"
