^DIC(19,7336,0)="SR NORMAL HOURS^Normal Daily Hours (Enter/Edit)^^R^.5^^^^^^^167^^1^1"
^DIC(19,7336,1,0)="^^5^5^2920925^"
^DIC(19,7336,1,1,0)="This option is used to enter or edit the daily start and end "
^DIC(19,7336,1,2,0)="times for each operating room.  The information will be used to"
^DIC(19,7336,1,3,0)="set up the start and end times, for operating room utilization,"
^DIC(19,7336,1,4,0)="on a weekly basis."
^DIC(19,7336,1,5,0)=" "
^DIC(19,7336,15)="D EXIT^SROVAR"
^DIC(19,7336,20)="D ^SROVAR"
^DIC(19,7336,22)="Q"
^DIC(19,7336,25)="SROOPRM"
^DIC(19,7336,"U")="NORMAL DAILY HOURS (ENTER/EDIT"
^DIC(19,7337,0)="XMMGR-RESPONSE-TIME-COMPILER^Compile Response Time Statistics^^R^11748^^^^^^^54"
^DIC(19,7337,1,0)="4^^4^4^2920926^"
^DIC(19,7337,1,1,0)="This option will be used as a background job scheduled every day"
^DIC(19,7337,1,2,0)="to collect statistics on the previous day's response time and put"
^DIC(19,7337,1,3,0)="the data into file 4.2998 .  It will then KILL off the associated"
^DIC(19,7337,1,4,0)="%ZRTL global nodes."
^DIC(19,7337,25)="GO^XMUT5C"
^DIC(19,7337,"U")="COMPILE RESPONSE TIME STATISTI"
^DIC(19,7338,0)="DDXP DEFINE FORMAT^Define Foreign File Format^^A^1^DDXP-DEFINE^^^^^^^^1"
^DIC(19,7338,1,0)="^^5^5^2930108^"
^DIC(19,7338,1,1,0)="Use this option to define formats.  Formats are entries in the Foreign"
^DIC(19,7338,1,2,0)="Format file.  They are used to control the exporting of data to a"
^DIC(19,7338,1,3,0)="non-MUMPS application.  You can alter an existing format only before it has"
^DIC(19,7338,1,4,0)="been used to create an Export template.  After it has been used, you can"
^DIC(19,7338,1,5,0)="clone a format.  This option is locked with the DDXP-DEFINE key."
^DIC(19,7338,20)="D 1^DDXP"
^DIC(19,7338,"U")="DEFINE FOREIGN FILE FORMAT"
^DIC(19,7339,0)="DDXP SELECT EXPORT FIELDS^Select Fields for Export^^A^1^^^^^^^^^1"
^DIC(19,7339,1,0)="^^1^1^2921207^^"
^DIC(19,7339,1,1,0)="Use this option to choose fields to be exported."
^DIC(19,7339,20)="D 2^DDXP"
^DIC(19,7339,"U")="SELECT FIELDS FOR EXPORT"
^DIC(19,7340,0)="DDXP CREATE EXPORT TEMPLATE^Create Export Template^^A^1^^^^^^^^^1"
^DIC(19,7340,1,0)="^^2^2^2940519^^^"
^DIC(19,7340,1,1,0)="This option creates an Export template by applying the specifications in a"
^DIC(19,7340,1,2,0)="Foreign Format with the fields in a Selected Fields for Export template."
^DIC(19,7340,20)="D 3^DDXP"
^DIC(19,7340,"U")="CREATE EXPORT TEMPLATE"
^DIC(19,7341,0)="DDXP EXPORT DATA^Export Data^^A^1^^^^^^^^^1"
^DIC(19,7341,1,0)="^^4^4^2921207^^"
^DIC(19,7341,1,1,0)="This option sends data to a specified device for export to a foreign"
^DIC(19,7341,1,2,0)="application.  You have the opportunity to choose entries for export with"
^DIC(19,7341,1,3,0)="VA FileMan's Search dialogue.  You use an Export template to control the"
^DIC(19,7341,1,4,0)="export."
^DIC(19,7341,20)="D 4^DDXP"
^DIC(19,7341,"U")="EXPORT DATA"
^DIC(19,7342,0)="DDXP EXPORT MENU^Data Export to Foreign Format^^M^1^^^^^^^"
^DIC(19,7342,1,0)="^^1^1^2960722^^"
^DIC(19,7342,1,1,0)="Submenu for the Export tool."
^DIC(19,7342,10,0)="^19.01PI^5^5"
^DIC(19,7342,10,1,0)="7338^^1"
