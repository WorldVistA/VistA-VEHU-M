^DIC(19,3302,10,"B",282,1)=""
^DIC(19,3302,15)=""
^DIC(19,3302,20)=""
^DIC(19,3302,99)="62088,37770"
^DIC(19,3302,99.1)="60530,28814"
^DIC(19,3302,"U")="CASTLE POINT PSO ACTION PROFILES TEST"
^DIC(19,3303,0)="RA DAISTATS^Examination Statistics^^R^11712^^^^^^y^^^^"
^DIC(19,3303,1,0)="^^9^9^2941114^"
^DIC(19,3303,1,1,0)="This option allows the user to generate a report which contains statistics"
^DIC(19,3303,1,2,0)="for examinations performed within a specified date range. The report can"
^DIC(19,3303,1,3,0)="be printed by location (which includes location, imaging type, division"
^DIC(19,3303,1,4,0)="and total statistics), or by imaging type (which includes imaging type,"
^DIC(19,3303,1,5,0)="division and total statistics) division (which includes division and total"
^DIC(19,3303,1,6,0)="statistics), or just by total (which includes only total statistics). The"
^DIC(19,3303,1,7,0)="report contains each registered exam date followed by the number of"
^DIC(19,3303,1,8,0)="visits, the number of completed exams, and the number of examinations in"
^DIC(19,3303,1,9,0)="each corresponding exam category."
^DIC(19,3303,15)=""
^DIC(19,3303,20)=""
^DIC(19,3303,25)="ASK^RAESR"
^DIC(19,3303,"U")="EXAMINATION STATISTICS"
^DIC(19,3304,0)="RA DAIUVR^Unverified Reports^^R^11712^^^^^^y^"
^DIC(19,3304,1,0)="^^14^14^2940715^"
^DIC(19,3304,1,1,0)="This option allows the user to generate a report which contains the total"
^DIC(19,3304,1,2,0)="number of unverified reports for the division and imaging type(s) chosen"
^DIC(19,3304,1,3,0)="by the user. The user may select only those divisions and imaging types"
^DIC(19,3304,1,4,0)="he/she has access to."
^DIC(19,3304,1,5,0)=" "
^DIC(19,3304,1,6,0)="For each division and imaging type combination the output is divided into"
^DIC(19,3304,1,7,0)="two sections, the first section shows the total number of unverified"
^DIC(19,3304,1,8,0)="reports for each interpreting staff physician. The second section shows"
^DIC(19,3304,1,9,0)="the total number of unverified reports for each interpreting resident"
^DIC(19,3304,1,10,0)="physician."
^DIC(19,3304,1,11,0)=" "
^DIC(19,3304,1,12,0)="If there are no unverified reports for the division and imaging type"
^DIC(19,3304,1,13,0)="combination, then the message 'No Unverified Reports' appears instead of"
^DIC(19,3304,1,14,0)="the two sections mentioned above."
^DIC(19,3304,25)="RARTUVR"
^DIC(19,3304,99.1)="60640,49698"
^DIC(19,3304,"U")="UNVERIFIED REPORTS"
^DIC(19,3305,0)="RA RPTDIST^Distribution Queue Menu^^M^11712^^^^^^^"
^DIC(19,3305,1,0)="^^5^5^2940603^"
^DIC(19,3305,1,1,0)="This menu contains the options which allow the user to print reports"
^DIC(19,3305,1,2,0)="sorted for distribution to the wards, clinics and file rooms."
^DIC(19,3305,1,3,0)=" "
^DIC(19,3305,1,4,0)="Other options on the menu include printing the activity logs for the"
^DIC(19,3305,1,5,0)="various distribution queues and displaying a report's print status."
^DIC(19,3305,10,0)="^19.01PI^11^8"
^DIC(19,3305,10,1,0)="3306^"
^DIC(19,3305,10,5,0)="3307^"
^DIC(19,3305,10,6,0)="3308^"
^DIC(19,3305,10,7,0)="3318^"
^DIC(19,3305,10,8,0)="3314^"
^DIC(19,3305,10,9,0)="3319^"
^DIC(19,3305,10,10,0)="3320^"
^DIC(19,3305,10,11,0)="3321^"
^DIC(19,3305,10,"B",3306,1)=""
^DIC(19,3305,10,"B",3307,5)=""
^DIC(19,3305,10,"B",3308,6)=""
^DIC(19,3305,10,"B",3314,8)=""
^DIC(19,3305,10,"B",3318,7)=""
^DIC(19,3305,10,"B",3319,9)=""
^DIC(19,3305,10,"B",3320,10)=""
^DIC(19,3305,10,"B",3321,11)=""
^DIC(19,3305,99)="59924,36533"
^DIC(19,3305,99.1)="53663,69998"
^DIC(19,3305,"U")="DISTRIBUTION QUEUE MENU"
^DIC(19,3306,0)="RA RPTDISTQUE^Print By Routing Queue^^R^11712^^^^^^^"
^DIC(19,3306,1,0)="^^5^5^2950607^"
^DIC(19,3306,1,1,0)="This option allows the user to print the reports for the respective"
^DIC(19,3306,1,2,0)="distribution queues. The user is prompted for the routing queue, division,"
^DIC(19,3306,1,3,0)="imaging type, sort sequence and unprinted or reprint reports. The"
^DIC(19,3306,1,4,0)="reports are then printed (preceded and followed by the queue banner). The"
^DIC(19,3306,1,5,0)="header of each report includes the distribution queue name."
^DIC(19,3306,25)="1^RARTST1"
^DIC(19,3306,"U")="PRINT BY ROUTING QUEUE"
^DIC(19,3307,0)="RA RPTDISTSINGLEWARD^Individual Ward^^R^11712^^^^^^^"
^DIC(19,3307,1,0)="^^6^6^2940603^"
^DIC(19,3307,1,1,0)="This option allows the user to print the reports for"
^DIC(19,3307,1,2,0)="a select ward. The user is prompted for ward, division, sort"
^DIC(19,3307,1,3,0)="sequence (Terminal Digits, SSN, Patient) and unprinted or"
^DIC(19,3307,1,4,0)="reprint reports. The reports are then printed preceded and"
^DIC(19,3307,1,5,0)="followed by the Ward Reports queue banner. The header of each"
^DIC(19,3307,1,6,0)="report includes ""***** Ward Distribution *****""."
^DIC(19,3307,25)="2^RARTST1"
^DIC(19,3307,"U")="INDIVIDUAL WARD"
^DIC(19,3308,0)="RA RPTDISTSINGLECLINIC^Single Clinic^^R^11712^^^^^^^"
^DIC(19,3308,1,0)="^^6^6^2940603^"
^DIC(19,3308,1,1,0)="This option allows the user to print the reports"
^DIC(19,3308,1,2,0)="for a select clinic. The user is prompted for clinic, division,"
^DIC(19,3308,1,3,0)="sort sequence (Terminal Digits, SSN, Patient) and unprinted or"
^DIC(19,3308,1,4,0)="reprint reports. The reports are then printed preceded and"
^DIC(19,3308,1,5,0)="followed by the Clinic Reports queue banner. The header of"
^DIC(19,3308,1,6,0)="each report includes ""***** Clinic Distribution *****""."
^DIC(19,3308,25)="3^RARTST1"
^DIC(19,3308,"U")="SINGLE CLINIC"
^DIC(19,3309,0)="RA DISTEDIT^Reports Distribution Edit^^R^11712^^^^^^^"
^DIC(19,3309,1,0)="^^8^8^2881229^^^^"
^DIC(19,3309,1,1,0)="This option allows the user to edit the report distribution"
^DIC(19,3309,1,2,0)="queues. The types of distribution queues which can be edited"
^DIC(19,3309,1,3,0)="include: Clinic Reports, File Room, Medical Records, Ward"
^DIC(19,3309,1,4,0)="Reports and Other than Ward or Clinic. Information which may"
^DIC(19,3309,1,5,0)="be edited for the distribution queues include a top of page"
^DIC(19,3309,1,6,0)="message, the category of reports which includes inpatient,"
^DIC(19,3309,1,7,0)="outpatient, non ward or clinic, and all reports. Also there"
^DIC(19,3309,1,8,0)="is an inactivation date for the queue."
^DIC(19,3309,25)="11^RAMAIN"
^DIC(19,3309,"U")="REPORTS DISTRIBUTION EDIT"
^DIC(19,3310,0)="RA DISTP^Report Distribution Lists^^R^11712^^^^^^^"
^DIC(19,3310,1,0)="^^5^5^2890221^^^^"
^DIC(19,3310,1,1,0)="This option allows the user to generate a report which"
^DIC(19,3310,1,2,0)="contains information corresponding to each distribution"
^DIC(19,3310,1,3,0)="queue. The report contains the distribution queue name,"
^DIC(19,3310,1,4,0)="the top of page message, the category of reports included"
^DIC(19,3310,1,5,0)="in the queue and the inactivation date."
^DIC(19,3310,25)="16^RAMAINP"
^DIC(19,3310,"U")="REPORT DISTRIBUTION LISTS"
^DIC(19,3311,0)="RA RPTDISTPURGE^Distribution Queue Purge^^R^11712^^^^^^^"
^DIC(19,3311,1,0)="^^10^10^2940607^"
^DIC(19,3311,1,1,0)="This option allows IRM to schedule the purging"
^DIC(19,3311,1,2,0)="of the distribution queue files. The user is prompted"
^DIC(19,3311,1,3,0)="for a date. Any report printed prior to the specified"
^DIC(19,3311,1,4,0)="date is purged from the Report Distribution file and the"
^DIC(19,3311,1,5,0)="activity log in the Report Distribution Queue file."
^DIC(19,3311,1,6,0)="Output for the purge contains the date the"
^DIC(19,3311,1,7,0)="purge is started and finished."
^DIC(19,3311,1,8,0)=" "
^DIC(19,3311,1,9,0)="Again, only information printed prior to the scheduled date"
^DIC(19,3311,1,10,0)="is purged."
^DIC(19,3311,25)="PURGE^RARTST"
^DIC(19,3311,"U")="DISTRIBUTION QUEUE PURGE"
^DIC(19,3312,0)="RA RPTDISTREBUILD^Rebuild Distribution Queues^^R^11712^^^^^^^"
^DIC(19,3312,1,0)="^^13^13^2940607^"
^DIC(19,3312,1,1,0)="This option allows IRM to rebuild the distribution queues."
^DIC(19,3312,1,2,0)="The user is prompted for a date and any reports verified"
^DIC(19,3312,1,3,0)="on or after the specified date are placed in the Report"
^DIC(19,3312,1,4,0)="Distribution file. Depending on the category of the report and"
^DIC(19,3312,1,5,0)="the requirements of the distribution queue, there is an entry"
^DIC(19,3312,1,6,0)="in the Report Distribution file for each report and the"
^DIC(19,3312,1,7,0)="corresponding queue. In other words, if a report has a category"
^DIC(19,3312,1,8,0)="of outpatient and the Clinic Reports Queue includes outpatient"
^DIC(19,3312,1,9,0)="reports and the File Room Queue includes outpatient reports, there"
^DIC(19,3312,1,10,0)="will be two entries in the Report Distribution file. This option"
^DIC(19,3312,1,11,0)="will print the time the rebuild began and ended, the total number"
^DIC(19,3312,1,12,0)="of reports on file and the total number used to rebuild the"
^DIC(19,3312,1,13,0)="distribution file."
^DIC(19,3312,25)="RESET^RARTST"
^DIC(19,3312,"U")="REBUILD DISTRIBUTION QUEUES"
^DIC(19,3313,0)="RA RPTDISTAUTOPURGE^Autopurge of Distribution Queues^^R^11712^^^^^^^"
^DIC(19,3313,1,0)="^^15^15^2890215^^^^"
^DIC(19,3313,1,1,0)="This option allows the Site Manager to schedule the purging of"
^DIC(19,3313,1,2,0)="the distribution queue files as a background job. It is"
^DIC(19,3313,1,3,0)="recommended this option be scheduled for an off hour. This"
^DIC(19,3313,1,4,0)="option must be scheduled via Fileman or Kernel. The option"
^DIC(19,3313,1,5,0)="must be scheduled for a specific date and a device"
^DIC(19,3313,1,6,0)="must be specified for the output. The scheduling frequency"
^DIC(19,3313,1,7,0)="recommended is daily. The scheduled date is used when"
^DIC(19,3313,1,8,0)="purging. Any report printed prior to the scheduled date,"
^DIC(19,3313,1,9,0)="is purged from the Report Distribution file and the activity"
^DIC(19,3313,1,10,0)="log in the Report Distribution Queue file ."
^DIC(19,3313,1,11,0)="Output for the purge contains the date the purge is"
^DIC(19,3313,1,12,0)="started and finished."
^DIC(19,3313,1,13,0)=" "
^DIC(19,3313,1,14,0)="Again, only information printed prior to the scheduled date"
^DIC(19,3313,1,15,0)="is purged."
^DIC(19,3313,25)="PURGE1^RARTST"
^DIC(19,3313,200)="^^1D"
^DIC(19,3313,"U")="AUTOPURGE OF DISTRIBUTION QUEU"
^DIC(19,3314,0)="RA RPTDISTACTIVITY^Activity Logs^^R^11712^^^^^^^"
^DIC(19,3314,1,0)="^^4^4^2881230^^"
^DIC(19,3314,1,1,0)="This option allows the user to generate a report which contains"
^DIC(19,3314,1,2,0)="the activity logs for the various distribution queues. The report"
^DIC(19,3314,1,3,0)="is printed for a select routing queue and contains the log date,"
^DIC(19,3314,1,4,0)="activity, user, comment and quantity printed."
^DIC(19,3314,25)="4^RARTST1"
^DIC(19,3314,"U")="ACTIVITY LOGS"
^DIC(19,3315,0)="RA RPTONLINEVERIFY^On-line Verifying of Reports^^R^11740^RA VERIFY^^^^^^^^1^1"
^DIC(19,3315,1,0)="^19.06^21^21^3000615^^"
^DIC(19,3315,1,1,0)="This option allows the interpreting physician to verify reports on-line."
^DIC(19,3315,1,2,0)="To use this option an Electronic Signature Code is required and the user"
^DIC(19,3315,1,3,0)="must also be assigned the RA VERIFY security key.  An interpreting staff"
^DIC(19,3315,1,4,0)="physician may verify reports associated with his/her name. If the division"
^DIC(19,3315,1,5,0)="parameter 'ALLOW VERIFYING BY RESIDENTS' is set to 'YES' and the personnel"
^DIC(19,3315,1,6,0)="parameter 'ALLOW VERIFYING OF OTHERS' is set to 'YES', the resident may"
^DIC(19,3315,1,7,0)="also verify reports associated with other interpreting physicians. If the"
^DIC(19,3315,1,8,0)="division parameter is set to 'NO', then all residents can only verify"
^DIC(19,3315,1,9,0)="reports associated with his/her name."
^DIC(19,3315,1,10,0)=" "
^DIC(19,3315,1,11,0)="The interpreting physician can review reports by one of six categories:"
^DIC(19,3315,1,12,0)="1) reports pre-verified by an interpreting resident which have a status of"
^DIC(19,3315,1,13,0)="'Draft' or 'Released/Not Verified', 2) reports that are not pre-verified"
^DIC(19,3315,1,14,0)="which have a status of 'Released/Not Verified"", 3) reports with a status"
^DIC(19,3315,1,15,0)="of 'Draft', 4) reports with a status of 'Problem Draft', 5) all reports,"
^DIC(19,3315,1,16,0)="or 6) the user enters a list of selections. Once verified, the legal"
^DIC(19,3315,1,17,0)="signature may be printed in the footer of the report, provided the package"
^DIC(19,3315,1,18,0)="coordinator has added this field to the footer. This option, at the"
^DIC(19,3315,1,19,0)="request of the Expert Panel, does NOT prohibit verification of reports"
^DIC(19,3315,1,20,0)="without an impression even if an impression is required by the Division"
^DIC(19,3315,1,21,0)="site parameter in this package."
^DIC(19,3315,15)="K RAPBRPT,RATECHCO"
^DIC(19,3315,20)="S (RAPBRPT,RATECHCO)="""""
^DIC(19,3315,25)="RARTVER"
^DIC(19,3315,99.1)="60640,49651"
^DIC(19,3315,"U")="ON-LINE VERIFYING OF REPORTS"
^DIC(19,3316,0)="RA NOPURGE^Indicate No Purging of an Exam/report^RA*5.0*198: Radiology data purge not allowed.^R^11712^^^^^^^"
^DIC(19,3316,1,0)="^^5^5^2940606^^^^"
^DIC(19,3316,1,1,0)="This option allows the user to indicate whether or not the"
^DIC(19,3316,1,2,0)="data for a specific exam can be purged or archived. If an"
^DIC(19,3316,1,3,0)="exam can not be purged or archived and a report is associated"
^DIC(19,3316,1,4,0)="with the exam, then the report also can not be purged or"
^DIC(19,3316,1,5,0)="archived."
^DIC(19,3316,25)="SAVE^RAEDCN"
^DIC(19,3316,"U")="INDICATE NO PURGING OF AN EXAM"
^DIC(19,3318,0)="RA RPTDISTLISTUNPRINTED^Unprinted Reports List^^R^11712^^^^^^^"
^DIC(19,3318,1,0)="^^5^5^2881230^^^"
^DIC(19,3318,1,1,0)="This option allows the user to generate a report which contains"
^DIC(19,3318,1,2,0)="information about all the unprinted reports in the Report"
^DIC(19,3318,1,3,0)="Distribution file. The report contains the day/case #, patient"
^DIC(19,3318,1,4,0)="name, social security number, date verified, ward/clinic and"
^DIC(19,3318,1,5,0)="routing queue."
^DIC(19,3318,25)="5^RARTST1"
^DIC(19,3318,"U")="UNPRINTED REPORTS LIST"
^DIC(19,3319,0)="RA RPTDISTLISTCLINIC^Clinic Distribution List^^R^11712^^^^^^^"
^DIC(19,3319,1,0)="^^10^10^2881230^^^^"
^DIC(19,3319,1,1,0)="This option allows the user to generate a report which contains"
^DIC(19,3319,1,2,0)="information about the reports in the clinic distribution queue."
^DIC(19,3319,1,3,0)="The report can be generated for all clinics or a select clinic."
^DIC(19,3319,1,4,0)="It can also be generated for 'PRINTED' or 'UNPRINTED' reports."
^DIC(19,3319,1,5,0)="If the report is generated for 'PRINTED' reports, the user is"
^DIC(19,3319,1,6,0)="prompted for a date range. The report then contains the day/"
^DIC(19,3319,1,7,0)="case #, patient name, social security number,"
^DIC(19,3319,1,8,0)="date printed, printed by and clinic. If the report is generated"
^DIC(19,3319,1,9,0)="for 'UNPRINTED' reports, the report contains day/case #, patient"
^DIC(19,3319,1,10,0)="name, social security number, date verified and clinic."
^DIC(19,3319,25)="6^RARTST1"
^DIC(19,3319,"U")="CLINIC DISTRIBUTION LIST"
^DIC(19,3320,0)="RA RPTDISTLISTWARD^Ward Distribution List^^R^11712^^^^^^^"
^DIC(19,3320,1,0)="^^10^10^2881230^^^^"
^DIC(19,3320,1,1,0)="This option allows the user to generate a report which contains"
^DIC(19,3320,1,2,0)="information about the reports in the ward distribution queue."
^DIC(19,3320,1,3,0)="The report can be generated for all wards or a select ward. It"
^DIC(19,3320,1,4,0)="can also be generated for 'PRINTED' or 'UNPRINTED' reports. If"
^DIC(19,3320,1,5,0)="the report is generated for 'PRINTED' reports, the user is"
^DIC(19,3320,1,6,0)="prompted for a date range. The report then contains the day/"
^DIC(19,3320,1,7,0)="case #, patient name, social security number, date printed,"
^DIC(19,3320,1,8,0)="printed by and ward. If the report is generated for 'UNPRINTED'"
^DIC(19,3320,1,9,0)="reports, the report contains day/case #, patient name, social"
^DIC(19,3320,1,10,0)="security number, date verified and ward."
^DIC(19,3320,25)="7^RARTST1"
^DIC(19,3320,"U")="WARD DISTRIBUTION LIST"
^DIC(19,3321,0)="RA RPTDISTPRINTSTATUS^Report's Print Status^^R^11712^^^^^^y^"
^DIC(19,3321,1,0)="^^5^5^2890103^^^"
^DIC(19,3321,1,1,0)="This option allows the user to inquire about the print status of"
^DIC(19,3321,1,2,0)="a specific report. The print status can only be checked for"
^DIC(19,3321,1,3,0)="verified reports. The inquiry lists the reports' day/case #,"
^DIC(19,3321,1,4,0)="patient name, social security number, procedure, date verified,"
^DIC(19,3321,1,5,0)="routing queue, date printed, printed by and ward/clinic."
^DIC(19,3321,25)="8^RARTST1"
^DIC(19,3321,"U")="REPORT'S PRINT STATUS"
^DIC(19,3322,0)="RA ORDER^Radiology/Nuclear Med Order Entry Menu^^M^11712^^^^^^^"
^DIC(19,3322,1,0)="^^4^4^2960222^^^^"
^DIC(19,3322,1,1,0)="This menu provides the user with functions to request an exam, cancel an "
^DIC(19,3322,1,2,0)="exam, hold a requested exam, schedule a request, access a 'detailed' report"
^DIC(19,3322,1,3,0)="of the requested exam, to print a log report of scheduled requests by"
^DIC(19,3322,1,4,0)="procedure, and to print a list of 'pending' requests by date."
^DIC(19,3322,10,0)="^19.01PI^15^15"
^DIC(19,3322,10,1,0)="3325^"
^DIC(19,3322,10,2,0)="3323^"
^DIC(19,3322,10,3,0)="3326^"
^DIC(19,3322,10,4,0)="3324^"
^DIC(19,3322,10,7,0)="3328^"
^DIC(19,3322,10,8,0)="3330^"
^DIC(19,3322,10,10,0)="3333^"
^DIC(19,3322,10,12,0)=10757
^DIC(19,3322,10,13,0)=14568
^DIC(19,3322,10,14,0)="14740^REF"
^DIC(19,3322,10,15,0)="14931^LOG"
^DIC(19,3322,10,"B",3323,2)=""
^DIC(19,3322,10,"B",3324,4)=""
