^DIC(19,11983,0)="DGNT PENDING VERIFICATION LIST^N/T Radium Treatment Pending Verification List^^A^10000000020^^^^^^^114^^1^1"
^DIC(19,11983,1,0)="^19.06^3^3^3010829^^"
^DIC(19,11983,1,1,0)="This option provides a list of patients that have claimed Nose/Throat"
^DIC(19,11983,1,2,0)="Radium Treatment exposure and are pending document verification or pending"
^DIC(19,11983,1,3,0)="Cancer of the Head and/or Neck verification."
