^DIC(19,6308,0)="PRCAY ACCOUNT PROFILE^Brief Account Profile^^A^.5^^^^^^^261^^1"
^DIC(19,6308,1,0)="^^2^2^2920409^^^^"
^DIC(19,6308,1,1,0)="This option will display an Account Profile for Patient, Vendors,"
^DIC(19,6308,1,2,0)="Insurance Companies, etc."
