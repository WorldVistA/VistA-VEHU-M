^DIC(19,3335,1,0)="^^8^8^2890928^^^^"
^DIC(19,3335,1,1,0)="This menu contains all the MAS batch type options which"
^DIC(19,3335,1,2,0)="are used to coordinate and group all the MAS AMIS Code"
^DIC(19,3335,1,3,0)="Sheets so that they can be transmitted."
^DIC(19,3335,1,4,0)=" "
^DIC(19,3335,1,5,0)="Options on this menu include a report of code sheets"
^DIC(19,3335,1,6,0)="ready for batching, an option to batch the code sheets,"
^DIC(19,3335,1,7,0)="an option to edit the priority and batch number of a code"
^DIC(19,3335,1,8,0)="sheet and an option to mark code sheets for rebatching."
