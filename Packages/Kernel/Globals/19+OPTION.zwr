^DIC(19,12709,0)="SD-PAIT MANUAL BATCH REJECT^Manual Batch Reject^This functionality is now accomplished by CDW/VSSC.^R^10000000020^^^^^^^"
^DIC(19,12709,1,0)="^^6^6^3040304^"
^DIC(19,12709,1,1,0)="This option allows to 'reject' a batch that was created and its all "
^DIC(19,12709,1,2,0)="records have to be retransmitted. The transmission date has to be enter "
^DIC(19,12709,1,3,0)="to proceed with this option. Only batch control ID numbers are accepted "
^DIC(19,12709,1,4,0)="that have not been acknowledged. More that one batch number can be "
^DIC(19,12709,1,5,0)="entered. After rejection the related recors will be sent with the "
^DIC(19,12709,1,6,0)="followed up transmission."
^DIC(19,12709,25)="SDRPA09"
^DIC(19,12709,"U")="MANUAL BATCH REJECT"
^DIC(19,12710,0)="RA PERFORMIN TASKLM^Run Previous Quarter's Summary Report^^R^10000000020^^^^^^^31"
^DIC(19,12710,1,0)="^^5^5^3090319^"
^DIC(19,12710,1,1,0)="This option is used to run the 'Summary Performance Indicator Report' for"
^DIC(19,12710,1,2,0)="the previous quarter as a background task.  It will send the output to"
^DIC(19,12710,1,3,0)="Outlook mail groups defined in File 79's PERF INDC SMTP E-MAIL ADDRESS"
^DIC(19,12710,1,4,0)="multiple field.  There is only one user prompt:"
^DIC(19,12710,1,5,0)="    Requested Start Time: NOW//"
^DIC(19,12710,25)="TASKLM^RAPM3"
^DIC(19,12710,"U")="RUN PREVIOUS QUARTER'S SUMMARY"
^DIC(19,12711,0)="RA PERFORMIN SCHEDULE^Schedule Perf. Indic. Summary for 15th of month^^R^10000000020^^^^^^^31"
^DIC(19,12711,1,0)="^^3^3^3040112^"
^DIC(19,12711,1,1,0)="This option should be used to put the option, RA PERFORMIN TASKLM, back"
^DIC(19,12711,1,2,0)="on the Taskman queue to run on the 15th of the current month or the next "
^DIC(19,12711,1,3,0)="month, whichever is the closest date in the future."
^DIC(19,12711,25)="RESCH^RAPM3"
^DIC(19,12711,"U")="SCHEDULE PERF. INDIC. SUMMARY "
