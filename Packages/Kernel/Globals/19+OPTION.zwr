^DIC(19,12304,0)="RORMNT PRINT LOGS^Print Log Files^^P^1^^^^^^^540"
^DIC(19,12304,1,0)="^^2^2^3060131^"
^DIC(19,12304,1,1,0)=" "
^DIC(19,12304,1,2,0)="This option can be used to print messages recorded by the CCR software."
^DIC(19,12304,2)="y"
