^DIC(19,15757,20)="D EN^OREOR0"
^DIC(19,15757,"U")="CHECK FOR MULTIPLE KEYS"
^DIC(19,15758,0)="EHM-00579^Order Menu Management^^M^1^^^^^^^^^^^"
^DIC(19,15758,1,0)="^19.06^9^9^3240328^^^^"
^DIC(19,15758,1,1,0)="Options on this menu can be used for editing and modifying options"
^DIC(19,15758,1,2,0)="and menus for CPRS. If your site used OE/RR 2.5, most of your menus,"
^DIC(19,15758,1,3,0)="quick orders, and generic orders are converted to CPRS with the"
^DIC(19,15758,1,4,0)="installation of CPRS. Order Menu Management options can help you"
^DIC(19,15758,1,5,0)="convert protocols that weren't automatically converted, edit or"
^DIC(19,15758,1,6,0)="create quick orders and generic orders, create order sets, and"
^DIC(19,15758,1,7,0)="assign primary order menus. If your site hasn't used OE/RR 2.5,"
