^DIC(19,16251,0)="EHM-01072^PCE Table Maintenance^^M^1^^^^^^^507^^^^"
^DIC(19,16251,1,0)="^19.06^10^10^3240328^^^^"
^DIC(19,16251,1,1,0)="The options on this menu are used to manage the clinical terminology"
^DIC(19,16251,1,2,0)="defined in PCE. There are management systems for Education Topics,"
^DIC(19,16251,1,3,0)="Exams, and Health Factors. Immunizations and Skin Tests are standardized"
^DIC(19,16251,1,4,0)="nationally and cannot be edited by sites. National Education Topics,"
^DIC(19,16251,1,5,0)="Exams, and Health Factors cannot be edited by sites."
^DIC(19,16251,1,6,0)="  "
^DIC(19,16251,1,7,0)="The PCE Information Only menu options can be used to list the defined"
^DIC(19,16251,1,8,0)="data types."
^DIC(19,16251,1,9,0)=""
^DIC(19,16251,1,10,0)="Cloned from ""PXTT TABLE MAINTENANCE"" option."
^DIC(19,16251,3)=""
