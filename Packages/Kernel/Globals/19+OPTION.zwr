^DIC(19,1160,10,"B",1163,6)=""
^DIC(19,1160,10,"B",1179,9)=""
^DIC(19,1160,99)="56214,30312"
^DIC(19,1160,"U")="SMAC SUPPORT MENU"
^DIC(19,1161,0)="LRSMAC3^Flagged Specimens^^R^.5^^^^^^^26"
^DIC(19,1161,1,0)="^^1^1^2870203^^^"
^DIC(19,1161,1,1,0)="Reviews the specimens which have been flagged by the SMAC."
^DIC(19,1161,25)="LRFLAG"
^DIC(19,1161,"U")="FLAGGED SPECIMENS"
^DIC(19,1162,0)="LRSMAC5^Run Smac^^R^.5^^^^^^^26"
^DIC(19,1162,1,0)="^^2^2^2870204^"
^DIC(19,1162,1,1,0)="This option starts a new SMAC run.  You must first build the load list"
^DIC(19,1162,1,2,0)="before this option will run."
^DIC(19,1162,25)="LASMAC4"
^DIC(19,1162,"U")="RUN SMAC"
^DIC(19,1163,0)="LRSMAC6^Halt Smac Run^^R^.5^^^^^^^26"
^DIC(19,1163,1,0)="^^2^2^2870203^^^^"
^DIC(19,1163,1,1,0)="Terminates the interactive link between the interface and the tied"
^DIC(19,1163,1,2,0)="terminal for the SMAC run."
^DIC(19,1163,25)="HALT^LASMAC4"
^DIC(19,1163,"U")="HALT SMAC RUN"
^DIC(19,1164,0)="LRLLCT^Unload Load/Work List^^R^.5^^^^^^^26"
^DIC(19,1164,1,0)="^^2^2^2870204^^"
^DIC(19,1164,1,1,0)="Remove the samples from the Load/Work list so they may be added"
^DIC(19,1164,1,2,0)=" to another Load/Work list."
^DIC(19,1164,25)="CLRBYTRY^LRLLS"
