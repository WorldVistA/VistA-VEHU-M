^DIC(19,9413,20)="K:$G(PRCP(""DPTYPE""))'=""W"" PRCP S PRCP(""DPTYPE"")=""W"" D DISPLAY^PRCPUSEL I '$G(PRCP(""I"")) S XQUIT=1 D NOMENU^PRCPUSEL"
^DIC(19,9413,99)="62195,30816"
^DIC(19,9413,"U")="REPORTS MENU"
^DIC(19,9414,0)="PRCP DIST ORDER SECOND DUEINS^Calculated Due-In Quantity Report^^R^11740^^^^^^^"
^DIC(19,9414,1,0)="^^3^3^2921022^^^^"
^DIC(19,9414,1,1,0)="This option will print a list of due-ins from the distribution orders."
^DIC(19,9414,1,2,0)="If you have the manager key, you will also have the option to update"
^DIC(19,9414,1,3,0)="the inventory point with the calculated quantity due-in."
^DIC(19,9414,25)="PRCPRDOR"
^DIC(19,9414,"U")="CALCULATED DUE-IN QUANTITY REP"
^DIC(19,9415,0)="PRCP NIGHTLY EMER STK LVL^Night Task Flag Inventory at Emergency Stock Lvl^^R^11740^^^^^^^"
^DIC(19,9415,1,0)="^^7^7^2930707^^^^"
^DIC(19,9415,1,1,0)="This option should be set up as a background job by the site manager"
^DIC(19,9415,1,2,0)="to run once nightly.  The job searches the inventory file, and if any items"
^DIC(19,9415,1,3,0)="are found that have a quantity on hand less than or equal to the emergency"
^DIC(19,9415,1,4,0)="stock level assigned to the item, a flag will be set on the inventory, so"
^DIC(19,9415,1,5,0)="that the next time a user signs on to that inventory, they will see a"
^DIC(19,9415,1,6,0)="message notifying them that they have stock at emergency reorder level and"
^DIC(19,9415,1,7,0)="will be allowed to run a report showing them which items are at that level."
^DIC(19,9415,25)="PRCPUEMS"
^DIC(19,9415,200)="^^"
^DIC(19,9415,"U")="NIGHT TASK FLAG INVENTORY AT E"
^DIC(19,9416,0)="PRCP COPY PRIMARY TO SECONDARY^Copy Primary To Secondary^^R^11740^^^^^^^"
^DIC(19,9416,1,0)="^^2^2^2941206^^^^"
^DIC(19,9416,1,1,0)="This option copies all items from a primary inventory point to any secondary"
^DIC(19,9416,1,2,0)="inventory point managed by the primary."
^DIC(19,9416,25)="PRCPECPP"
^DIC(19,9416,"U")="COPY PRIMARY TO SECONDARY"
^DIC(19,9417,0)="PRCP COPY SECOND TO SECOND^Copy Secondary To Secondary^^R^11740^^^^^^^"
^DIC(19,9417,1,0)="^^2^2^2941206^^^^"
^DIC(19,9417,1,1,0)="This option copies all items from one secondary to another secondary"
^DIC(19,9417,1,2,0)="inventory point managed by the same primary inventory point."
^DIC(19,9417,25)="PRCPECPS"
^DIC(19,9417,"U")="COPY SECONDARY TO SECONDARY"
^DIC(19,9418,0)="PRCP DUEIN CALCULATE/UPDATE^Update Calculated Due-Ins/Outstanding Transaction^^R^11740^^^^^^^"
^DIC(19,9418,1,0)="^^19^19^2940124^^^^"
^DIC(19,9418,1,1,0)="This option will print a report showing the calculated due-ins or"
^DIC(19,9418,1,2,0)="will update the inventory point with the calculated due-ins."
^DIC(19,9418,1,3,0)=" "
^DIC(19,9418,1,4,0)="The calculated due-ins are based on transactions (2237's) and"
^DIC(19,9418,1,5,0)="purchase orders which have not been received in after a specified"
^DIC(19,9418,1,6,0)="date.  The date entered should represent the date the last"
^DIC(19,9418,1,7,0)="transaction or purchase order was received in (probably no later"
^DIC(19,9418,1,8,0)="than 6 to 9 months in the past)."
^DIC(19,9418,1,9,0)=" "
^DIC(19,9418,1,10,0)="The report should be run before doing the update so the results"
^DIC(19,9418,1,11,0)="can be verified first.  The report will show a listing of the"
^DIC(19,9418,1,12,0)="calculated due-ins compared to the total due-in quantity stored"
^DIC(19,9418,1,13,0)="in the inventory point.  If the due-ins disagree, the update"
^DIC(19,9418,1,14,0)="should be performed.  The report may not agree with the 'Due-In"
^DIC(19,9418,1,15,0)="Item Report' since the 'Due-In Item Report' uses the stored values"
^DIC(19,9418,1,16,0)="and not the calculated values."
^DIC(19,9418,1,17,0)=" "
^DIC(19,9418,1,18,0)="The update will remove all due-ins stored in the inventory point"
^DIC(19,9418,1,19,0)="and reset the due-ins to the newly calculated values."
^DIC(19,9418,25)="PRCPRDI0"
^DIC(19,9418,"U")="UPDATE CALCULATED DUE-INS/OUTS"
^DIC(19,9419,0)="PRCP DUEOUT/OUTST TRAN CLEAN^Clean Up Old Transactions And Due-Outs^^R^11740^^^^^^^"
^DIC(19,9419,1,0)="^^18^18^2920211^^^^"
^DIC(19,9419,1,1,0)="This option can be used to recalculate the due-outs from the warehouse"
^DIC(19,9419,1,2,0)="inventory point for issue book requests not posted."
^DIC(19,9419,1,3,0)=" "
^DIC(19,9419,1,4,0)="The due-out quantity is calculated from issue book request ordered"
^DIC(19,9419,1,5,0)="after a specified date.  The date selected should be the date"
^DIC(19,9419,1,6,0)="the last issue book request has NOT been posted (probably 6 to"
^DIC(19,9419,1,7,0)="9 months in the past).  All issue book request before the specified"
^DIC(19,9419,1,8,0)="date will be made final and can no longer be selected for posting."
^DIC(19,9419,1,9,0)="The due-out quantity stored in the inventory point will be updated"
^DIC(19,9419,1,10,0)="to the newly calculated due-out quantity."
^DIC(19,9419,1,11,0)=" "
^DIC(19,9419,1,12,0)="This option should be run at NIGHT since it will lock the transaction"
^DIC(19,9419,1,13,0)="(2237) file, and services will be unable to create ANY orders."
^DIC(19,9419,1,14,0)=" "
^DIC(19,9419,1,15,0)="After the option has calculated the due-outs, a report will print"
^DIC(19,9419,1,16,0)="displaying the outstanding issue book request, line item numbers"
^DIC(19,9419,1,17,0)="due-out, date of the request, primary inventory point making the"
^DIC(19,9419,1,18,0)="request, and the outstanding due-out quantity."
^DIC(19,9419,25)="PRCPWDOU"
^DIC(19,9419,"U")="CLEAN UP OLD TRANSACTIONS AND "
^DIC(19,9420,0)="PRCP DUEOUT/OUTST TRAN REPORT^Outstanding (Due-Outs) Transaction Listing^^R^11740^^^^^^^"
^DIC(19,9420,1,0)="^19.06^18^18^3000608^^^^"
^DIC(19,9420,1,1,0)="This option can be used to recalculate the due-outs from the warehouse"
^DIC(19,9420,1,2,0)="inventory point for issue book requests not posted."
^DIC(19,9420,1,3,0)=" "
^DIC(19,9420,1,4,0)="The due-out quantity is calculated from issue book requests which"
^DIC(19,9420,1,5,0)="have not been posted to the primary inventory point."
^DIC(19,9420,1,6,0)=" "
^DIC(19,9420,1,7,0)="This option should be run at NIGHT since it is cpu intensive."
^DIC(19,9420,1,8,0)=" "
^DIC(19,9420,1,9,0)="After the option has calculated the due-outs, a report will print"
^DIC(19,9420,1,10,0)="displaying the outstanding issue book request, line item numbers"
^DIC(19,9420,1,11,0)="due-out, date of the request, primary inventory point making the"
^DIC(19,9420,1,12,0)="request, and the outstanding due-out quantity."
^DIC(19,9420,1,13,0)=" "
^DIC(19,9420,1,14,0)="The report will also show the warehouse quantity on-hand and stored"
^DIC(19,9420,1,15,0)="quantity due-out compared to the total calculated quantity outstanding"
^DIC(19,9420,1,16,0)="(due-out).  If the quantity due-out and the quantity outstanding"
^DIC(19,9420,1,17,0)="disagree, the 'Clean Up Old Transactions And Due-Outs' option"
^DIC(19,9420,1,18,0)="should be used."
^DIC(19,9420,25)="PRCPWDOR"
^DIC(19,9420,"U")="OUTSTANDING (DUE-OUTS) TRANSAC"
^DIC(19,9421,0)="PRCP RECEIVING/DISTR MENU^Receiving And Distribution Menu^^M^11740^^^^^^^^^1"
^DIC(19,9421,1,0)="^^2^2^2910719^"
^DIC(19,9421,1,1,0)="This menu contains all the options related to receiving and distribution in"
^DIC(19,9421,1,2,0)="an inventory point."
^DIC(19,9421,10,0)="^19.01PI^23^13"
