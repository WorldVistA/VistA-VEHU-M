^DIC(19,16812,0)="EHM-01633^Reminder Extract Menu^^M^1^^^^^^^534^^^^"
^DIC(19,16812,1,0)="^19.06^3^3^3240328^^^"
^DIC(19,16812,1,1,0)="This option allows management of extract definitions, extract runs, and "
^DIC(19,16812,1,2,0)="extract transmissions."
^DIC(19,16812,1,3,0)="Cloned from ""PXRM EXTRACT MENU"" option."
^DIC(19,16812,3)=""
^DIC(19,16812,10,0)="^19.01IP^5^5"
^DIC(19,16812,10,1,0)="16813^MA^10"
^DIC(19,16812,10,2,0)="16814^LR^40"
^DIC(19,16812,10,3,0)="16815^ED^30"
^DIC(19,16812,10,4,0)="16816^EC^35"
^DIC(19,16812,10,5,0)="16817^EG^36"
