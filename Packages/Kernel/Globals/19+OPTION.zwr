^DIC(19,9003,"U")="SHOW ERROR LOG"
^DIC(19,9004,0)="XUTM ERROR PURGE TYPE^Purge Error Log Of Type Of Error^^R^1039^^^^^^^^^"
^DIC(19,9004,1,0)="^^9^9^2890127^"
^DIC(19,9004,1,1,0)="This option provides a way to clean Task Manager's log of errors.  The"
^DIC(19,9004,1,2,0)="site manager can enter a string, and this option will then delete every"
^DIC(19,9004,1,3,0)="entry in the log that contains that string.  For example, if the site"
^DIC(19,9004,1,4,0)="manager enters ""<UNDEF>"" then every error that contains this string"
^DIC(19,9004,1,5,0)="will be deleted.  Two other examples are ""ZTSK+3^XQ1:4"" and ""E"".  The"
^DIC(19,9004,1,6,0)="first removes all errors that occurred on the line and command indicated"
^DIC(19,9004,1,7,0)="while the second removes ALL errors whose $ZE value contains an ""E""."
^DIC(19,9004,1,8,0)="Note that this does not edit the system's main error log, only Task"
^DIC(19,9004,1,9,0)="Manager's Error Log in the ^%ZTSCH global."
^DIC(19,9004,25)="TYPE^XUTMKE"
^DIC(19,9004,"U")="PURGE ERROR LOG OF TYPE OF ERR"
^DIC(19,9005,0)="XUTM ERROR LOG CLEAN RANGE^Clean Error Log Over Range Of Dates^^R^1039^^^^^^^^^"
^DIC(19,9005,1,0)="^^4^4^2890127^"
^DIC(19,9005,1,1,0)="This option allows the site manager to remove from Task Manager's error"
^DIC(19,9005,1,2,0)="log all entries that occur on or between two dates.  The site manager"
^DIC(19,9005,1,3,0)="enters the two dates, FIRST THE EARLIER DATE AND THEN THE LATER DATE,"
^DIC(19,9005,1,4,0)="and then the option removes the appropriate entries."
^DIC(19,9005,25)="RANGE^XUTMKE"
^DIC(19,9005,"U")="CLEAN ERROR LOG OVER RANGE OF "
^DIC(19,9006,0)="XUTM PARAMETER EDIT^Edit Taskman Parameters^^M^1039^^^^^^^^^"
^DIC(19,9006,1,0)="^^1^1^2910225^^^^"
^DIC(19,9006,1,1,0)="This menu collects the options that edit the TaskMan parameter files."
^DIC(19,9006,10,0)="^19.01IP^3^3"
^DIC(19,9006,10,1,0)=9013
^DIC(19,9006,10,2,0)=9014
^DIC(19,9006,10,3,0)=9015
^DIC(19,9006,10,"B",9013,1)=""
^DIC(19,9006,10,"B",9014,2)=""
^DIC(19,9006,10,"B",9015,3)=""
^DIC(19,9006,99)="56915,53747"
^DIC(19,9006,"U")="EDIT TASKMAN PARAMETERS"
^DIC(19,9007,0)="XUTM QCLEAN^Queuable Task Log Cleanup^^R^1039^^^^^^^^^"
^DIC(19,9007,1,0)="^^5^5^2941102^"
^DIC(19,9007,1,1,0)="This option is equivalent to ZTMCLEAN except that this can be scheduled"
^DIC(19,9007,1,2,0)="through the option ZTMSCHEDULE to run periodically.  This option only"
^DIC(19,9007,1,3,0)="keeps completed entries from the last seven days, unless overridden by"
^DIC(19,9007,1,4,0)="the days to keep old tasks field in the volume set file, as well as all"
^DIC(19,9007,1,5,0)="queued entries."
^DIC(19,9007,2)="n"
^DIC(19,9007,25)="XUTMK"
^DIC(19,9007,200.9)="y"
^DIC(19,9007,"U")="QUEUABLE TASK LOG CLEANUP"
^DIC(19,9008,0)="XUTM ERROR SCREEN LIST^List Error Screens^^R^1039^^^^^^^^^"
^DIC(19,9008,1,0)="^^6^6^2890713^"
^DIC(19,9008,1,1,0)="This option allows the user to see the error screens that are currently"
^DIC(19,9008,1,2,0)="in place.  An error screen is a string of characters.  Any error that"
^DIC(19,9008,1,3,0)="Task Manager logs will be checked against the list of error screens."
^DIC(19,9008,1,4,0)="If an error occurs whose $ZE string contains a screen as a substring,"
^DIC(19,9008,1,5,0)="then that error will not be logged.  Some error screens count the number"
^DIC(19,9008,1,6,0)="of errors that they prevent from being logged."
^DIC(19,9008,25)="SCLIST^XUTMKE1"
^DIC(19,9008,"U")="LIST ERROR SCREENS"
^DIC(19,9009,0)="XUTM ERROR SCREEN ADD^Add Error Screens^^R^1039^^^^^^^^^"
^DIC(19,9009,1,0)="^^5^5^2890713^"
^DIC(19,9009,1,1,0)="Allows the user to add more error screens.  An error screen is a string"
^DIC(19,9009,1,2,0)="of characters that Taskman compares to the $ZE value of every error it"
^DIC(19,9009,1,3,0)="traps.  Taskman only logs those trapped errors whose $ZE values do not"
^DIC(19,9009,1,4,0)="contain an error screen as a substring.  The system manager can choose"
^DIC(19,9009,1,5,0)="to have the screen count the number of errors it screens out."
^DIC(19,9009,25)="SCRAD^XUTMKE2"
^DIC(19,9009,"U")="ADD ERROR SCREENS"
^DIC(19,9010,0)="XUTM ERROR SCREEN EDIT^Edit Error Screens^^R^1039^^^^^^^^^"
^DIC(19,9010,1,0)="^^7^7^2890713^"
^DIC(19,9010,1,1,0)="Allows user to edit error screens.  This involves deciding whether or not"
^DIC(19,9010,1,2,0)="each edited screen should count the errors that occur while the screen"
^DIC(19,9010,1,3,0)="is in place, and whether to reset counters for screens that have already"
^DIC(19,9010,1,4,0)="counted some screened errors.  The screens themselves are just strings"
^DIC(19,9010,1,5,0)="of characters that Task Manager compares against the $ZE values of all"
^DIC(19,9010,1,6,0)="errors it traps.  Those errors whose $ZE values do not contain any screens"
^DIC(19,9010,1,7,0)="as substrings are logged, but those that do are not logged."
^DIC(19,9010,25)="SCRED^XUTMKE2"
^DIC(19,9010,"U")="EDIT ERROR SCREENS"
^DIC(19,9011,0)="XUTM ERROR SCREEN REMOVE^Remove Error Screens^^R^1039^^^^^^^^^"
^DIC(19,9011,1,0)="^^7^7^2890713^"
^DIC(19,9011,1,1,0)="Allows the user to remove error screens.  Error screens provide the"
^DIC(19,9011,1,2,0)="system manager with a way to prevent certain errors from being logged."
^DIC(19,9011,1,3,0)="Task Manager traps every error caused by its own code or by the code"
^DIC(19,9011,1,4,0)="of the tasks it runs, but the only errors logged in the system error log"
^DIC(19,9011,1,5,0)="and in Task Manager's error log are those errors whose $ZE values do"
^DIC(19,9011,1,6,0)="not contain an error screen as a substring.  The system manager can decide"
^DIC(19,9011,1,7,0)="whether to count the number of errors screened out."
^DIC(19,9011,25)="SCREM^XUTMKE1"
^DIC(19,9011,"U")="REMOVE ERROR SCREENS"
^DIC(19,9012,0)="XUTM USER^TaskMan User^^R^1039^^^10^^^^^^"
^DIC(19,9012,1,0)="^^2^2^2951109^^"
^DIC(19,9012,1,1,0)="This option provides end users with information about their current tasks"
^DIC(19,9012,1,2,0)="and with the ability to stop or modify and reschedule those tasks."
^DIC(19,9012,25)="XUTMUSE"
^DIC(19,9012,99.1)="54447,34035"
^DIC(19,9012,"U")="TASKMAN USER"
