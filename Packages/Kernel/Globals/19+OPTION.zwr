^DIC(19,5668,0)="DGJ IRT INCOMPLETE^Incomplete Reports Print^^R^10000000033^^^^^^^"
^DIC(19,5668,1,0)="^^5^5^2930409^^^^"
^DIC(19,5668,1,1,0)="This option allows you to print incomplete reports sorting by Division if"
^DIC(19,5668,1,2,0)="multi-divisional, (Patient, Event Date, Doctor, Service/Specialty). The"
^DIC(19,5668,1,3,0)="outputs display data for Patient name, PT ID, event date, discharge type"
^DIC(19,5668,1,4,0)="Physician, ward and type of delinquency of the report (undicated, not trans-"
^DIC(19,5668,1,5,0)="cribed, not signed, not reviewed)."
^DIC(19,5668,25)="EN1^DGJOPRT"
^DIC(19,5668,"U")="INCOMPLETE REPORTS PRINT"
^DIC(19,5669,0)="DGJ IRT UNDICTATED^Undictated Reports Print^^R^10000000033^^^^^^^"
^DIC(19,5669,1,0)="^^5^5^2930409^^^^"
^DIC(19,5669,1,1,0)="This option allows you to print undictated reports sorting by"
^DIC(19,5669,1,2,0)="Division if multi-divisional, (Patient, Event Date, Doctor, Service/"
^DIC(19,5669,1,3,0)="Specialty). The outputs display data for Patient name, PT ID, "
^DIC(19,5669,1,4,0)="event date, discharge type, physician, ward and type of report"
^DIC(19,5669,1,5,0)="(OP report, Discharge Summary, Interim Summary)."
^DIC(19,5669,25)="EN^DGJOPRT"
^DIC(19,5669,200)="^"
^DIC(19,5669,"U")="UNDICTATED REPORTS PRINT"
