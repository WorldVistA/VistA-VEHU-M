^DIC(19,719,"U")="SUPERVISOR'S MENU"
^DIC(19,720,0)="PSGW INVENTORY SHEET^Inventory Sheet Print (132 column)^^R^.5^^^^^^^"
^DIC(19,720,1,0)="^^2^2^2930608^^^^"
^DIC(19,720,1,1,0)="This option prints the AOU inventory reporting sheet.  This contains a"
^DIC(19,720,1,2,0)="listing, by AOU, of all the items for specific inventory types."
^DIC(19,720,25)="ASKINV^PSGWL"
