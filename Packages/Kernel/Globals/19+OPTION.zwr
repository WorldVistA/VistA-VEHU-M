^DIC(19,6754,1,0)="^^5^5^2940908^^^^"
^DIC(19,6754,1,1,0)="The Daily Activity Log lists all transactions for a Controlled"
^DIC(19,6754,1,2,0)="Substances dispensing site (vault).  It includes a forwarding"
^DIC(19,6754,1,3,0)="balance on each transaction.  This document may be generated for"
^DIC(19,6754,1,4,0)="a single drug, some drugs, or ALL drugs within a specified date"
^DIC(19,6754,1,5,0)="range."
