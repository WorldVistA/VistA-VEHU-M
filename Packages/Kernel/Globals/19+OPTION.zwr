^DIC(19,16182,0)="EHM-01003^Inquire about a Health Summary Component^^R^1^^^^^^y^^^^^"
^DIC(19,16182,1,0)="^^3^3^3240328^^"
^DIC(19,16182,1,1,0)="This allows the user to display the characteristics of a Health Summary"
^DIC(19,16182,1,2,0)="Component."
^DIC(19,16182,1,3,0)="Cloned from ""GMTS COMP INQ"" option."
^DIC(19,16182,3)=""
^DIC(19,16182,25)="GMTSCI"
^DIC(19,16182,"U")="INQUIRE ABOUT A HEALTH SUMMARY"
^DIC(19,16183,0)="EHM-01004^Visit Patient Health Summary^^R^1^^^^^^^160^^1^1^"
^DIC(19,16183,1,0)="^^9^9^3240328^^"
^DIC(19,16183,1,1,0)="Generates Health Summaries of a specified pre-defined Health Summary Type"
^DIC(19,16183,1,2,0)="for multiple patients. After a patient is selected, the user can pick an"
^DIC(19,16183,1,3,0)="outpatient visit (based on the VISIT File) or an inpatient hospital"
^DIC(19,16183,1,4,0)="admission (based on the Patient Movement file). If the Patient Care"
^DIC(19,16183,1,5,0)="Encounter (PCE) package isn't installed then the user can only choose an"
^DIC(19,16183,1,6,0)="inpatient visit. Data for summaries is based on a date range from the"
^DIC(19,16183,1,7,0)="outpatient visit or inpatient admission. This Date Range overrides Time"
^DIC(19,16183,1,8,0)="Limits for components which allows this option."
