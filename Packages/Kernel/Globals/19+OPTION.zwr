^DIC(19,12945,"U")="EXTRACT MANAGER'S OPTIONS"
^DIC(19,12946,0)="ECXPURG^Purge Extract Holding Files^^R^1^ECXMGR^^^^^^513"
^DIC(19,12946,1,0)="^^23^23^3130806^"
^DIC(19,12946,1,1,0)="This option purges data that resides in the ""holding files"" for the IVP,"
^DIC(19,12946,1,2,0)="UDP and VBECS extracts."
^DIC(19,12946,1,3,0)=" "
^DIC(19,12946,1,4,0)="Care must be taken for several reasons:"
^DIC(19,12946,1,5,0)=" "
^DIC(19,12946,1,6,0)="-  Choosing a broad date range for the holding files could mean an"
^DIC(19,12946,1,7,0)="   excessively large number of records and be very CPU intensive.  Please"
^DIC(19,12946,1,8,0)="   be sure to queue this purge for off-hours and limit the number of"
^DIC(19,12946,1,9,0)="   holding files to be purged per a single queued session."
^DIC(19,12946,1,10,0)="-  The IVP, UDP and VBECS """"holding"""" files are intermediate files that"
^DIC(19,12946,1,11,0)="   are populated """"realtime"""" by inpatient pharmacy and VBECS activity."
^DIC(19,12946,1,12,0)="   These files are then used to generate the IVP, UDP and VBECS extracts."
^DIC(19,12946,1,13,0)="   NOTE:    The VBECS files CANNOT be regenerated."
^DIC(19,12946,1,14,0)="   Once it is purged for a date range, extracts can no longer be"
^DIC(19,12946,1,15,0)="   generated for that time period."""
^DIC(19,12946,1,16,0)=" "
^DIC(19,12946,1,17,0)=" "
^DIC(19,12946,1,18,0)=" "
^DIC(19,12946,1,19,0)="PURGE RECOMMENDATIONS:"
^DIC(19,12946,1,20,0)="Purging of any local holding files is not recommended until your facility"
^DIC(19,12946,1,21,0)="has successfully created  extracts, transmitted to the Austin Automation"
^DIC(19,12946,1,22,0)="Center, audited the counts,loaded the data into DSS AND ARE CONTENT WITH"
^DIC(19,12946,1,23,0)="THE RESULTS."
^DIC(19,12946,25)="EN^ECXPURG"
^DIC(19,12946,"U")="PURGE EXTRACT HOLDING FILES"
^DIC(19,12947,0)="ECXTRANS^Transmit Data from Extract Files^^R^10000000020^ECXMGR^^^^^^513"
^DIC(19,12947,1,0)="^^3^3^2950418^^^^"
^DIC(19,12947,1,1,0)="This option allows messages containing the data from an individual"
^DIC(19,12947,1,2,0)="extract to be sent to the Austin Automation Center in a series of mail"
^DIC(19,12947,1,3,0)="messages."
^DIC(19,12947,25)="EN^ECXTRANS"
^DIC(19,12947,"U")="TRANSMIT DATA FROM EXTRACT FIL"
^DIC(19,12948,0)="ECXIV^IV Extract^^R^10000000020^^^^^^^513"
^DIC(19,12948,1,0)="^19.06^4^4^3070313^^^^"
