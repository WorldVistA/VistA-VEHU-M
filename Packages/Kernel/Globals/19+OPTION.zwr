^DIC(19,2654,1,2,0)="codes and procedure codes for an admission from the patient's PTF record."
^DIC(19,2654,1,3,0)="The output may be run to include up to 20 PTF records."
^DIC(19,2654,25)="DGPTOLC1"
^DIC(19,2654,"U")="PATIENT SUMMARY BY ADMISSION"
