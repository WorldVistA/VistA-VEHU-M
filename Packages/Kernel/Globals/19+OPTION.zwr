^DIC(19,10202,0)="RC RC SERV^RC SERVER DRIVER^^S^10000000033^^^^^^^261^^1"
^DIC(19,10202,1,0)="^^6^6^2970404^^"
^DIC(19,10202,1,1,0)="Messages will be sent to this server from the Regional Counsel data"
^DIC(19,10202,1,2,0)="base.  These messages will contain a data line for every Reimbursable"
^DIC(19,10202,1,3,0)="Health bill that was referred from this medical center.  These messages"
^DIC(19,10202,1,4,0)="may be very long.  This server will also create and send confirmation"
^DIC(19,10202,1,5,0)="and error messages. The tasked job will be set to run at the time of the"
^DIC(19,10202,1,6,0)="server execution."
^DIC(19,10202,20)="D SERVER^RCRCSRV"
^DIC(19,10202,220)="^R^170^^^N^1^^7"
^DIC(19,10202,"U")="RC SERVER DRIVER"
^DIC(19,10203,0)="PRCAC RC RRR^Reconciliation Rollup Request for RC^^R^10000000033^^^^^^^261"
^DIC(19,10203,1,0)="^^7^7^2980303^^^^"
^DIC(19,10203,1,1,0)="Use this option to send an E-mail request for a roll-up of Reimbursable"
^DIC(19,10203,1,2,0)="Health Third Party bills listed on the supporting Regional Counsel"
^DIC(19,10203,1,3,0)="system as referred from this site.  This request may take over a day to"
^DIC(19,10203,1,4,0)="fill as it is relying on the network mail delivery time and system"
^DIC(19,10203,1,5,0)="response time of this medical center and the supporting Regional Counsel."
^DIC(19,10203,1,6,0)="The members of the RC RC REFERRALS Mail Group will receive four "
^DIC(19,10203,1,7,0)="Reconciliation mail messages."
^DIC(19,10203,25)="RRR^RCRCRR"
^DIC(19,10203,"U")="RECONCILIATION ROLLUP REQUEST "
^DIC(19,10204,0)="LA7 ADL START/STOP^Start/Stop Auto Download Background Job^^R^10958^^^^^^^480"
^DIC(19,10204,1,0)="^^8^8^2960826^"
^DIC(19,10204,1,1,0)="Option to allow user to start/restart/stop the lab messaging pacakge's"
^DIC(19,10204,1,2,0)="auto download background job. This option can be used to restart the auto"
^DIC(19,10204,1,3,0)="download job after changes have been made to the auto instrument file and"
^DIC(19,10204,1,4,0)="the auto download job needs to be updated to reflect the changes."
^DIC(19,10204,1,5,0)=" "
^DIC(19,10204,1,6,0)="It can also be used to temporarily suspend auto downloading while making"
^DIC(19,10204,1,7,0)="changes. It will then keep a list of accessions to process and use this"
^DIC(19,10204,1,8,0)="list when auto downloading is resumed."
^DIC(19,10204,25)="EN^LA7ADL2"
^DIC(19,10204,"U")="START/STOP AUTO DOWNLOAD BACKG"
^DIC(19,10205,0)="LA7 ADL SEND^Download to Universal Interface^^R^10958^^^^^^^480"
^DIC(19,10205,1,0)="^^10^10^2960827^"
^DIC(19,10205,1,1,0)="This option should be used to schedule for downloading an accession or"
^DIC(19,10205,1,2,0)="group of accessions by the Lab Universal Interface. It will create"
^DIC(19,10205,1,3,0)="messages containing orders for those instrument designated for auto"
^DIC(19,10205,1,4,0)="downloading. This option can be used in those situations where accessions"
^DIC(19,10205,1,5,0)="need to be re-downloaded because of changes to the auto instrument file"
^DIC(19,10205,1,6,0)="setup, recovery from a system interruption or switch to an"
^DIC(19,10205,1,7,0)="alternate/backup system."
^DIC(19,10205,1,8,0)=" "
^DIC(19,10205,1,9,0)="If auto downloading is not being used then use option LA DOWN to download"
^DIC(19,10205,1,10,0)="a loadlist to an instrument."
^DIC(19,10205,25)="EN^LA7ADLS"
^DIC(19,10205,"U")="DOWNLOAD TO UNIVERSAL INTERFAC"
^DIC(19,10206,0)="LA7 PRINT LAB UI MESSAGE^Display Lab Universal Interface Message^^R^10958^^^^^^^480"
^DIC(19,10206,1,0)="^^5^5^2961113^^"
^DIC(19,10206,1,1,0)="Option allows user to select a range of messages, up to 20, for printing"
^DIC(19,10206,1,2,0)="or displaying on a terminal. When displaying on terminal that supports"
^DIC(19,10206,1,3,0)="screen handling, the Kernel Browser is used to display the message(s)."
^DIC(19,10206,1,4,0)=" "
^DIC(19,10206,1,5,0)="Printing to a hardcopy device or mail message (P-MESSAGE) is also supported."
^DIC(19,10206,25)="EN^LA7UTILA"
^DIC(19,10206,"U")="DISPLAY LAB UNIVERSAL INTERFAC"
