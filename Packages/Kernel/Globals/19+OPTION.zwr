^DIC(19,16223,"U")="DISPLAY"
^DIC(19,16224,0)="EHM-01045^Filter^^R^1^^^^^^^512^^^^"
^DIC(19,16224,1,0)="^^4^4^3240328^^"
^DIC(19,16224,1,1,0)="This option lets the user either select or create their own filter to use"
^DIC(19,16224,1,2,0)="while conducting searches in the Lexicon.  This filter will limit the "
^DIC(19,16224,1,3,0)="response of the look-up based on the conditions found in the filter."
^DIC(19,16224,1,4,0)="Cloned from ""LEX USER FILTER"" option."
^DIC(19,16224,3)=""
^DIC(19,16224,10.1)="Filter"
^DIC(19,16224,25)="EN^LEXDFL"
^DIC(19,16224,"U")="FILTER"
^DIC(19,16225,0)="EHM-01046^List Defaults^^R^1^^^^^^^512^^^^"
^DIC(19,16225,1,0)="^^3^3^3240328^^^"
^DIC(19,16225,1,1,0)="This option lets the user list their current defaults to a device (terminal or"
^DIC(19,16225,1,2,0)="printer)."
^DIC(19,16225,1,3,0)="Cloned from ""LEX USER DEFAULT LIST"" option."
^DIC(19,16225,3)=""
^DIC(19,16225,25)="EN^LEXDDS"
^DIC(19,16225,"U")="LIST DEFAULTS"
^DIC(19,16226,0)="EHM-01047^Look-up Term^^R^1^^^^^^^512^^^^"
^DIC(19,16226,1,0)="^^5^5^3240328^^^^"
^DIC(19,16226,1,1,0)="This option lets a user perform a simple look-up in the Lexicon (outside "
^DIC(19,16226,1,2,0)="of an application) and displays all the information known about the "
^DIC(19,16226,1,3,0)="expression selected (i.e., definitions, classification codes, semantic"
^DIC(19,16226,1,4,0)="classifications, etc)."
^DIC(19,16226,1,5,0)="Cloned from ""LEX LOOK-UP"" option."
^DIC(19,16226,3)=""
^DIC(19,16226,25)="LEXLK"
^DIC(19,16226,"U")="LOOK-UP TERM"
^DIC(19,16227,0)="EHM-01048^Edit Lexicon^^M^1^^^^^^^512^^^^"
^DIC(19,16227,1,0)="^19.06^3^3^3240328^^^^"
^DIC(19,16227,1,1,0)="Very few fields in the Lexicon may be edited.  This menu option contains "
^DIC(19,16227,1,2,0)="sub-options which allows managers to edit those [few] fields."
^DIC(19,16227,1,3,0)="Cloned from ""LEX MGR EDIT LEXICON"" option."
