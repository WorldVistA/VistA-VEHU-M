^DIC(19,13799,0)="SDRR CONVERT ENTRIES^Convert Retired Providers/Clinic Recalls^^R^10000000020^SDRR MANAGER^^^^^^16"
^DIC(19,13799,1,0)="^^3^3^3090817^"
^DIC(19,13799,1,1,0)="This option will allow an approved user to convert Recall providers"
^DIC(19,13799,1,2,0)="and clinics.  If a provider leaves and there are Clinic Recalls already "
^DIC(19,13799,1,3,0)="scheduled, you can convert these recalls to the new provider."
^DIC(19,13799,25)="SDRR5"
^DIC(19,13799,"U")="CONVERT RETIRED PROVIDERS/CLIN"
^DIC(19,13800,0)="SDRR RECALL DELINQUENCIES^Recall List Delinquencies^^R^10000000020^^^^^^^16"
^DIC(19,13800,1,0)="^^7^7^3090817^"
^DIC(19,13800,1,1,0)="This option is essentially the same report as those produced by the two"
^DIC(19,13800,1,2,0)="""Delinquent  Recall"" reports, except it provides better control of"
^DIC(19,13800,1,3,0)="clinic selection and it reports on how many days delinquent each patient"
^DIC(19,13800,1,4,0)="is. The user is asked for the recall date range, a set of clinics, and"
^DIC(19,13800,1,5,0)="whether the report should break on clinic. It reports on patients who have"
^DIC(19,13800,1,6,0)="been sent recall reminders, but haven't yet called to schedule an"
^DIC(19,13800,1,7,0)="appointment."
^DIC(19,13800,25)="EN^SDRRISRD"
^DIC(19,13800,99.1)="60939,58069"
^DIC(19,13800,"U")="RECALL LIST DELINQUENCIES"
^DIC(19,13801,0)="SDRR RECALL DELETIONS^Recall List Deletions^^R^10000000020^^^^^^^16"
^DIC(19,13801,1,0)="^19.06^3^3^3080227^^^"
^DIC(19,13801,1,1,0)="This option reports on the patients who were deleted from the Recall List"
^DIC(19,13801,1,2,0)="by a clerk."
^DIC(19,13801,1,3,0)=""
^DIC(19,13801,25)="EN^SDRRISRX"
^DIC(19,13801,99.1)="60939,32780"
^DIC(19,13801,"U")="RECALL LIST DELETIONS"
^DIC(19,13802,0)="SDRR RECALL APPOINTMENTS^Scheduled Recall Appointments^^R^10000000020^^^^^^^16"
^DIC(19,13802,1,0)="^19.06^3^3^3080227^^^"
^DIC(19,13802,1,1,0)="This option lists the patient appointments which caused patients to drop off"
^DIC(19,13802,1,2,0)="the Recall List."
^DIC(19,13802,1,3,0)=""
^DIC(19,13802,25)="EN^SDRRISRA"
^DIC(19,13802,99.1)="60941,31045"
^DIC(19,13802,"U")="SCHEDULED RECALL APPOINTMENTS"
^DIC(19,13803,0)="SDRR RECALL LIST^Recall List w/Available Slots^^R^10000000020^^^^^^^16"
^DIC(19,13803,1,0)="^^5^5^3090817^"
^DIC(19,13803,1,1,0)="This option is essentially the same report as that produced by the"
^DIC(19,13803,1,2,0)="""Recall List Print"" [SDRR PATIENT LIST], except it also reports"
^DIC(19,13803,1,3,0)="on slot availability by month for each clinic.  The user is asked for a"
^DIC(19,13803,1,4,0)="date range, a set of clinics, and whether the report should page break on"
^DIC(19,13803,1,5,0)="clinic.  It reports on patients who are on the RECALL LIST."
^DIC(19,13803,25)="EN^SDRRISRL"
^DIC(19,13803,99.1)="60939,32806"
^DIC(19,13803,"U")="RECALL LIST W/AVAILABLE SLOTS"
^DIC(19,13804,0)="SDRR PATIENT LIST^Recall List Print^^R^10000000020^^^^^^^16"
^DIC(19,13804,1,0)="^^3^3^3090817^"
^DIC(19,13804,1,1,0)="This menu allows users to print Recall Reminders by division, clinic or "
^DIC(19,13804,1,2,0)="Recall Reminder teams. It will ask for a date range and must be "
^DIC(19,13804,1,3,0)="queued to a printer."
^DIC(19,13804,25)="SDRRCRR"
^DIC(19,13804,"U")="RECALL LIST PRINT"
^DIC(19,13805,0)="SDRR PRINT MENU^Clinic Recall Print Menu^^R^10000000020^SDRR MANAGER^^^^^^16"
^DIC(19,13805,1,0)="^^2^2^3090817^"
^DIC(19,13805,1,1,0)="This menu allows users to print either Recall Letters or Cards for"
^DIC(19,13805,1,2,0)="patients who have been entered into the Recall Reminders file."
^DIC(19,13805,25)="SDRRLRP"
^DIC(19,13805,"U")="CLINIC RECALL PRINT MENU"
^DIC(19,13806,0)="SDRR TASK JOB^Auto Print for Recall Reminder^^R^10000000020^^^^^^^16"
^DIC(19,13806,1,0)="^^2^2^3090817^"
^DIC(19,13806,1,1,0)="This option should be queued to print every night. It does not need to be"
^DIC(19,13806,1,2,0)="queued to a device."
^DIC(19,13806,25)="SDRRTSK"
^DIC(19,13806,200.9)="y"
^DIC(19,13806,"U")="AUTO PRINT FOR RECALL REMINDER"
