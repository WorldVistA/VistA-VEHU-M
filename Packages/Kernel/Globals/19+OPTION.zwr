^DIC(19,16954,1,0)="^^4^4^3240328^"
^DIC(19,16954,1,1,0)=" "
^DIC(19,16954,1,2,0)="This option will delegate keys to a user so that that user can then give them"
^DIC(19,16954,1,3,0)="out to other users, and even allow other users to delegate them in return."
