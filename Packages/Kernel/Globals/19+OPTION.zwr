^DIC(19,12207,10,4,0)=12209
^DIC(19,12207,10,"B",12205,1)=""
^DIC(19,12207,10,"B",12206,3)=""
^DIC(19,12207,10,"B",12208,2)=""
^DIC(19,12207,10,"B",12209,4)=""
^DIC(19,12207,99)="62088,37608"
^DIC(19,12207,"U")="LTC COPAY EXEMPTION TEST MENU"
