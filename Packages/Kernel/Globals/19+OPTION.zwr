^DIC(19,4567,0)="DGPT CENSUS STATUS REPORT^Census Status Report^^R^.5^^^^^^^114"
^DIC(19,4567,1,0)="^^24^24^2900810^^^^"
^DIC(19,4567,1,1,0)="This options prints a report of all active admissions as of"
^DIC(19,4567,1,2,0)="11:59pm for a specified census date.  The report will indicate the status"
^DIC(19,4567,1,3,0)="of the census record for each admission.  This report uses the"
^DIC(19,4567,1,4,0)="data stored in the CENSUS WORKFILE."
^DIC(19,4567,1,5,0)=" "
^DIC(19,4567,1,6,0)="This workfile is an extract of data from the admission data for the"
^DIC(19,4567,1,7,0)="patients who were inpatients as of 11:59 on the census date.  This"
^DIC(19,4567,1,8,0)="workfile makes the printing of this report much faster than otherwise"
^DIC(19,4567,1,9,0)="would be possible.  Without this workfile, it would be neccessary"
^DIC(19,4567,1,10,0)="to scan all admissions prior to the census date to determine if"
^DIC(19,4567,1,11,0)="the admission was still active on the census date."
^DIC(19,4567,1,12,0)=" "
^DIC(19,4567,1,13,0)="NOTE:  The first time the 'Census Status Report' is run for a"
^DIC(19,4567,1,14,0)="       particular census date, the CENSUS WORKFILE is automatically"
^DIC(19,4567,1,15,0)="       generated."
^DIC(19,4567,1,16,0)=" "
^DIC(19,4567,1,17,0)="The user is allowed to select one, many or all divisions and"
^DIC(19,4567,1,18,0)="one census status."
^DIC(19,4567,1,19,0)=" "
^DIC(19,4567,1,20,0)="The report is sorted by:"
^DIC(19,4567,1,21,0)="         1) division"
^DIC(19,4567,1,22,0)="         2) then status"
^DIC(19,4567,1,23,0)="         3) then ward on census date"
^DIC(19,4567,1,24,0)="         4) then patient name."
^DIC(19,4567,25)="EN^DGPTCO1"
^DIC(19,4567,"U")="CENSUS STATUS REPORT"
^DIC(19,4568,0)="DGPT CENSUS UNRELEASED^UnReleased Census Records Report^^P^.5^^^^^^^114"
