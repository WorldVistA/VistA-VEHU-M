^DIC(19,7036,"U")="EDI RETRANSMIT"
^DIC(19,7037,0)="PRCO EDI VENDOR^EDI Vendor Edit^^E^1^^^^^^^121"
^DIC(19,7037,1,0)="^19.06^2^2^3030910^^"
^DIC(19,7037,1,1,0)="This option allows the application coordinator to update the EDI VENDOR"
^DIC(19,7037,1,2,0)="and the VENDOR ID NUMBER fields in the VENDOR file, file 440."
