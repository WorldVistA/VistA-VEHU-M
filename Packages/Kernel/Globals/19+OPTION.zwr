^DIC(19,6726,0)="PSD PHARM TECH^Technician (CS Pharmacy) Menu^^M^10000000216^^^^^^^276"
^DIC(19,6726,1,0)="^19.06^4^4^3110103^^^^"
^DIC(19,6726,1,1,0)="This menu provides the pharmacy technicians access to options"
^DIC(19,6726,1,2,0)="associated with requesting, receiving, and processing Controlled Substances"
^DIC(19,6726,1,3,0)="orders handled by pharmacy and nursing.  This menu is a combination of"
^DIC(19,6726,1,4,0)="Controlled Substances options used by both pharmacy technicians and RPhs."
