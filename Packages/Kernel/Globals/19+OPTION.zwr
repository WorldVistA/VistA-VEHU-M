^DIC(19,7997,0)="XMYB-BROADCAST-VA-WIDE^Server / not for a menu^^S^11748^XMMGR^^^^^^54"
^DIC(19,7997,1,0)="^^12^12^2971003^^^^"
^DIC(19,7997,1,1,0)="This option is set up as a server.  When a message is addressed to this"
^DIC(19,7997,1,2,0)="server (S.XMYB-BROADCAST-VA-WIDE), it runs routine ENT^XMGAPI3 to send"
^DIC(19,7997,1,3,0)="the message to all users."
^DIC(19,7997,1,4,0)=""
^DIC(19,7997,1,5,0)="The message is marked 'closed' (may not forward) and"
^DIC(19,7997,1,6,0)="'information only' (may not reply)."
^DIC(19,7997,1,7,0)=""
^DIC(19,7997,1,8,0)="The message is marked with a vaporization date of 7 days from the date"
^DIC(19,7997,1,9,0)="of receipt."
^DIC(19,7997,1,10,0)=""
^DIC(19,7997,1,11,0)="Note that server XMR-BROADCAST-VA-WIDE is similar to this one, except"
^DIC(19,7997,1,12,0)="that it sends the message to SHARED,MAIL."
^DIC(19,7997,25)="ENT^XMGAPI3(""*"")"
^DIC(19,7997,220)="^R^^N^Y^N"
^DIC(19,7997,"U")="SERVER / NOT FOR A MENU"
