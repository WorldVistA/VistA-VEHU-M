^DIC(19,7542,0)="PRCP OPEN BALANCES TASKMAN SET^Automatically Set Inventory Opening Balances^^R^11740^^^^^^^^^"
^DIC(19,7542,1,0)=3
^DIC(19,7542,1,1,0)="This option should be run by taskmanager on the first day of the month"
^DIC(19,7542,1,2,0)="at 00:05 am to set the opening inventory balances for the inventory"
^DIC(19,7542,1,3,0)="points."
^DIC(19,7542,20)=""
^DIC(19,7542,25)="TASKSET^PRCPUBAL"
^DIC(19,7542,200)="^^1M"
^DIC(19,7542,200.9)="y"
^DIC(19,7542,"U")="AUTOMATICALLY SET INVENTORY OP"
^DIC(19,7550,0)="PRCEF BUILD LIST^Build List of 1358's Printed in Fiscal by Date^^R^11740^^^^^^^"
^DIC(19,7550,1,0)="^^4^4^2870324^^"
^DIC(19,7550,1,1,0)="Operator is allowed to enter a Beginning and Ending date and time."
^DIC(19,7550,1,2,0)="The computer will build a list of all 1358's previously printed in"
^DIC(19,7550,1,3,0)="Fiscal within the date/time range, then will print the list on the"
^DIC(19,7550,1,4,0)="device selected."
^DIC(19,7550,25)="EN2^PRCHRPT5"
^DIC(19,7550,"U")="BUILD LIST OF 1358'S PRINTED I"
^DIC(19,7551,0)="PRCEF PRINT FROM LIST^Print/Reprint 1358s from List^^R^11740^^^^^^^"
^DIC(19,7551,1,0)="^^3^3^2870324^^^^"
^DIC(19,7551,1,1,0)="This option allows the operator to reprint in Fiscal, some or all"
^DIC(19,7551,1,2,0)="of the 1358s from a list created using the option 'Build List"
^DIC(19,7551,1,3,0)="of 1358s Printed in Fiscal by Date'."
^DIC(19,7551,25)="EN2^PRCHRPT6"
^DIC(19,7551,"U")="PRINT/REPRINT 1358S FROM LIST"
^DIC(19,7552,0)="PRCEF RETURN TO SERVICE^Send 1358 back to Service without action^^R^11740^^^^^^^"
^DIC(19,7552,1,0)="^^5^5^2920206^^"
^DIC(19,7552,1,1,0)="This option enables the accounting tech to return a 1358 to a service"
^DIC(19,7552,1,2,0)="without action.  It removes the electronic signature code from the"
^DIC(19,7552,1,3,0)="transaction, adjusts the control point records and sends a bulletin to"
^DIC(19,7552,1,4,0)="both the approving official and the requestor indicating that the transaction"
^DIC(19,7552,1,5,0)="has not been processed in fiscal."
^DIC(19,7552,25)="PRCEFIS1"
^DIC(19,7552,99.1)="54254,48255"
^DIC(19,7552,"U")="SEND 1358 BACK TO SERVICE WITH"
