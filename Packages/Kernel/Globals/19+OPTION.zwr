^DIC(19,3952,0)="LRAPC^Anatomic pathology topography counts^^R^.5^^^^^^^26"
^DIC(19,3952,1,0)="^^6^6^2870204^^^"
^DIC(19,3952,1,1,0)="Prints counts of organ/tissues (SNOMED topography) specified by code from "
^DIC(19,3952,1,2,0)="one date to another.  Also shows # of patients, # of accessions, and # of"
^DIC(19,3952,1,3,0)="organ/tissues for the time specified."
^DIC(19,3952,1,4,0)=" More than one topography can be requested.  For each topography "
^DIC(19,3952,1,5,0)="there will be a count and percentage of the total organ/tissues within"
^DIC(19,3952,1,6,0)="the time period."
^DIC(19,3952,25)="LRAPC"
^DIC(19,3952,"U")="ANATOMIC PATHOLOGY TOPOGRAPHY "
^DIC(19,3953,0)="LRAPSPSGL^Print surgical pathology report for a patient^^R^.5^^^^^^^26"
