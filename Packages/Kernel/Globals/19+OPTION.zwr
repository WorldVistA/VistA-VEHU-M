^DIC(19,10426,0)="TIU LIST NOTES BY TITLE^List Notes By Title^^A^10000000020^^^^^^n^516^^1^1"
^DIC(19,10426,1,0)="^^1^1^2960410^^^"
^DIC(19,10426,1,1,0)="Drives Text Intgration Utilities Progress Notes Review Screen."
