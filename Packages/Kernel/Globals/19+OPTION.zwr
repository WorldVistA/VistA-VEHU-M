^DIC(19,570,"U")="ADT THIRD PARTY OUTPUT MENU"
^DIC(19,571,0)="PSJI PROFILE^Profile (IV)^^A^11712^^^^^^^115^^1^1"
^DIC(19,571,1,0)=3
^DIC(19,571,1,1,0)="This option shows all medications a patient has received during his"
^DIC(19,571,1,2,0)="most recent episode of care.  The user is allowed to view all information"
^DIC(19,571,1,3,0)="on file for any or all orders in the profile."
^DIC(19,571,15)="K I1,PSGLMT,PSIVUP,PSJORL,UL80"
^DIC(19,571,20)="D ^PSIVXU Q:$D(XQUIT)  S PSIVAC=""PRO"",PSIVBR=""D ^PSIVVW1"" D ENCHS^PSIV,ENIVKV^PSGSETU K D,DA,DFN,Y,ORLOG,P1,PS,PSIVAC,PSIVBR,PSIVLAB,PSIVLOG,SCRNPRO"
^DIC(19,571,25)=""
^DIC(19,571,99)="54200,45590"
^DIC(19,571,"U")="PROFILE (IV)"
^DIC(19,572,0)="DG PTF 099 TRANSMISSION^099 Transmission^^R^.5^DG PTFTRANS^^^^^^114"
^DIC(19,572,1,0)="^^11^11^2930415^^^^"
^DIC(19,572,1,1,0)="This option is used when it is necessary to reopen a previously"
^DIC(19,572,1,2,0)="transmitted PTF record and transmit an 099 deletion transaction to"
^DIC(19,572,1,3,0)="the Austin DPC to delete the DPC's master record."
^DIC(19,572,1,4,0)=" "
^DIC(19,572,1,5,0)="Also, this option will allow the user to transmit a 'free-form' 099"
^DIC(19,572,1,6,0)="to delete an Austin master record for an entry with bad control data"
^DIC(19,572,1,7,0)="not represented in the DHCP database."
^DIC(19,572,1,8,0)=" "
^DIC(19,572,1,9,0)="This bad control data could have resulted from keypunch error or a"
^DIC(19,572,1,10,0)="change in a patient's social security number or admission date and/or"
^DIC(19,572,1,11,0)="time."
^DIC(19,572,25)="DGPTF099"
^DIC(19,572,"U")="099 TRANSMISSION"
^DIC(19,573,0)="PSJI RNL^Renewal List (IV)^^R^11712^^^^^^^115^^^1"
^DIC(19,573,1,0)="^^3^3^2910312^^^^"
