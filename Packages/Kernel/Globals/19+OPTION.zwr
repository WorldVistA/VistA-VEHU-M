^DIC(19,9000,"U")="STOP TASK MANAGER"
^DIC(19,9001,0)="XUTM ZTMON^Monitor Taskman^^R^1039^^^^^^^^^"
^DIC(19,9001,1,0)="^^2^2^2890215^^^^"
^DIC(19,9001,1,1,0)="This option will continually monitor the status of Taskman"
^DIC(19,9001,1,2,0)="and its queues."
^DIC(19,9001,25)="ZTMON"
^DIC(19,9001,99)="55381,33575"
^DIC(19,9001,"U")="MONITOR TASKMAN"
^DIC(19,9002,0)="XUTM CHECK ENV^Check Taskman's Environment^^R^1039^^^^^^^^^"
^DIC(19,9002,1,0)="^^4^4^2890215^^"
^DIC(19,9002,1,1,0)="This option checks Taskman's environment to make sure that links"
^DIC(19,9002,1,2,0)="and global nodes required by Taskman are present.  These checks are"
^DIC(19,9002,1,3,0)="the same checks that Taskman performs every time it is started or"
^DIC(19,9002,1,4,0)="restarted."
^DIC(19,9002,25)="ZTMCHK"
^DIC(19,9002,"U")="CHECK TASKMAN'S ENVIRONMENT"
^DIC(19,9003,0)="XUTM ERROR SHOW^Show Error Log^^R^1039^^^^^^^^^"
