^DIC(19,1238,0)="LRCKPTR^Check patient and lab data cross pointers^^R^.5^LRLIASON^^^^^^26"
^DIC(19,1238,1,0)="^^4^4^2870203^^^^"
^DIC(19,1238,1,1,0)="This routine will look at all patients and check that the"
^DIC(19,1238,1,2,0)="lab data entry pointed to points back to it."
^DIC(19,1238,1,3,0)="The routine then looks at all entries in the lab data file"
^DIC(19,1238,1,4,0)="and checks that the pointed to file points back."
^DIC(19,1238,25)="LRCKPTR"
^DIC(19,1238,"U")="CHECK PATIENT AND LAB DATA CRO"
^DIC(19,1239,0)="LRUPT^Show list of accessions for a patient^^R^.5^^^^^^^26"
^DIC(19,1239,1,0)="^^3^3^2870204^^^"
^DIC(19,1239,1,1,0)="If you need to find all the accession numbers (in one accession area)"
^DIC(19,1239,1,2,0)="for one patient, you may do so with this option.  The information is "
^DIC(19,1239,1,3,0)="displayed on the screen only.  You cannot print the list with this option."
^DIC(19,1239,25)="LRUPT"
^DIC(19,1239,"U")="SHOW LIST OF ACCESSIONS FOR A "
^DIC(19,1247,0)="LRAC 1 PAGE^Reprint a permanent page from cumulative^^R^10000000020^^^^^^^26"
^DIC(19,1247,1,0)="^19.06^7^7^3021105^^^^"
^DIC(19,1247,1,1,0)="THIS OPTION PRINTS IN THE INTERIM REPORT FORMAT.  The report prints site codes for"
^DIC(19,1247,1,2,0)="tests and prints a separate page(s) at the end of the report which lists the"
^DIC(19,1247,1,3,0)="performing lab name, address and site code."
^DIC(19,1247,1,4,0)="This option will print interim reports for a selected patient within a given "
^DIC(19,1247,1,5,0)="time period.  The printout will go inverse date order.  This report will output"
^DIC(19,1247,1,6,0)="all tests for the time period specified.  This option will only print verified"
^DIC(19,1247,1,7,0)="results."
^DIC(19,1247,25)="CUM^LRRP2"
^DIC(19,1247,"U")="REPRINT A PERMANENT PAGE FROM "
