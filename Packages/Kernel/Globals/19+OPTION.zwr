^DIC(19,16450,1,0)="^^3^3^3240328^"
^DIC(19,16450,1,1,0)="This option can be used to print the definition of a specific Education"
^DIC(19,16450,1,2,0)="Topic definition."
^DIC(19,16450,1,3,0)="Cloned from ""PXTT INQUIRE EDUC TOPIC"" option."
