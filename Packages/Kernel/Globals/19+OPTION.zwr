^DIC(19,9696,51)=".01;1"
^DIC(19,9696,"U")="OUTPUT SUBTYPE"
^DIC(19,9697,0)="GMRY IV SITE^IV Site^^E^10958^^^^^^^502^^1^1"
^DIC(19,9697,1,0)="^^4^4^2960123^^^^"
^DIC(19,9697,1,1,0)="This option allows the ADP coordinator to enter IV sites into the GMRY IV"
^DIC(19,9697,1,2,0)="SITE file (#126.7).  This information is used to track the IV insertion "
^DIC(19,9697,1,3,0)="site and assist with documentation of the site's status and surrounding "
^DIC(19,9697,1,4,0)="skin integrity."
^DIC(19,9697,15)="K DIDEL,DLAYGO"
^DIC(19,9697,20)="S (DIDEL,DLAYGO)=126.7"
