^DIC(19,3166,0)="DGBT BENE TRAVEL RATES^Parameter Rates Enter/Edit^Option is no longer available. Please use BTSSS.^R^10000000020^DGBT SUPERVISOR^^^^^^546"
^DIC(19,3166,1,0)="^^9^9^3011001^"
^DIC(19,3166,1,1,0)="This is an enter/edit option for the parameters in Beneficiary Travel."
^DIC(19,3166,1,2,0)="The name of the BT CERTIFYING OFFICIAL is to be used if the site wants"
^DIC(19,3166,1,3,0)="a specific name printed on every form 70-3542d, or if left blank, the"
^DIC(19,3166,1,4,0)="name of the user who prints the form will be followed by DESIGNEE OF"
^DIC(19,3166,1,5,0)="CERTIFYING OFFICIAL.  BT OTHER EXPENSES ASKED is used to determine whether"
^DIC(19,3166,1,6,0)="the prompts MEALS & LODGING and FERRY, BRIDGES, ETC. will be asked in the"
^DIC(19,3166,1,7,0)="Beneficiary Travel Claim Enter/Edit Option.  Monetary rates"
^DIC(19,3166,1,8,0)="DEDUCTIBLE/VISIT, DEDUCTIBLE/MONTH, MILEAGE RATE, C&P REVISIT MILEAGE RATE"
^DIC(19,3166,1,9,0)="are also set up in this option."
^DIC(19,3166,25)="RATES^DGBTEF1"
^DIC(19,3166,"U")="PARAMETER RATES ENTER/EDIT"
