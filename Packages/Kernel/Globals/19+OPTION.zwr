^DIC(19,14008,0)="XUER UPDATE DEMAND/BATCH^Update Error Trap Summary^^R^10000000216^^^^^^^163^y"
^DIC(19,14008,1,0)="^^5^5^3071217^"
^DIC(19,14008,1,1,0)="This option is used to run by demand or by batch to update the Error "
^DIC(19,14008,1,2,0)="Trap Summary global from the current Error Trap.  This will only proccess "
^DIC(19,14008,1,3,0)="the errors for the current day. DO ADD^XTERSUM to add error from the last"
^DIC(19,14008,1,4,0)="30 days."
^DIC(19,14008,1,5,0)="See the code to reach back even further.  "
^DIC(19,14008,25)="TODAY^XTERSUM"
^DIC(19,14008,30)="%ZTER(3.077,"
^DIC(19,14008,200.9)="y"
^DIC(19,14008,"U")="UPDATE ERROR TRAP SUMMARY^ERROR TRAP SUMMARY UPDATE"
^DIC(19,14009,0)="XUER NOTE^Annotate an Error^^E^10000000216^^^^^^y^^y"
^DIC(19,14009,1,0)="^19.06^2^2^3000524^^^"
^DIC(19,14009,1,1,0)="This option should provide a means of letting a programmer annotate an"
^DIC(19,14009,1,2,0)="error which has been logged automatically."
^DIC(19,14009,30)="%ZTER(3.077,"
^DIC(19,14009,31)="AEMQL"
^DIC(19,14009,50)="%ZTER(3.077,"
^DIC(19,14009,51)=30
^DIC(19,14009,52)="[XTER NOTES]"
^DIC(19,14009,80)="XTERSUM("
^DIC(19,14009,81)="[XTER NOTES]"
^DIC(19,14009,"U")="ANNOTATE AN ERROR"
