^DIC(19,2651,0)="DG PATIENT TYPE PARAMETER EDIT^Patient Type Update^^E^1^DG SUPERVISOR^^^^^^114"
^DIC(19,2651,1,0)="^^10^10^2920324^^^"
^DIC(19,2651,1,1,0)="This option is used to update the PATIENT TYPE (#391) file.  The"
^DIC(19,2651,1,2,0)="prompts which are preceded by the word SHOW are used to determine"
^DIC(19,2651,1,3,0)="which registration screens should be shown for that specific patient"
^DIC(19,2651,1,4,0)="type.  The prompts which are preceded by the word ASK are used to"
^DIC(19,2651,1,5,0)="identify those data groups within the SHOW screens which are editable."
^DIC(19,2651,1,6,0)="The IGNORE VETERAN PROMPTS prompt is used to permit users to answer"
^DIC(19,2651,1,7,0)="'veteran' only questions during registration even if that patient type"
^DIC(19,2651,1,8,0)="may be identified as not being a veteran, i.e., military retireee."
^DIC(19,2651,1,9,0)="All prompts are answerable by entering either a '1' for YES or a '0'"
^DIC(19,2651,1,10,0)="for NO.  A NULL response is assumed to mean NO."
^DIC(19,2651,25)=""
