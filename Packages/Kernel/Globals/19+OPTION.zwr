^DIC(19,12396,0)="DGPF BACKGROUND PROCESSING^Patient Record Flag Background^^R^10000000020^^^^^^^114"
^DIC(19,12396,1,0)="^^6^6^3030708^"
^DIC(19,12396,1,1,0)="This option should be scheduled to run once a day.  The following"
^DIC(19,12396,1,2,0)="functions are processed by this background option:  "
^DIC(19,12396,1,3,0)="1. Send review notification messages for pending Patient Record Flag"
^DIC(19,12396,1,4,0)="Assignment reviews."
^DIC(19,12396,1,5,0)="2. Auto retransmitting of rejected HL7 Patient Record Flag Assignment"
