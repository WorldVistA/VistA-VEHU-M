^DIC(19,9677,1,0)="^^2^2^2960401^^"
^DIC(19,9677,1,1,0)="This option prints custom reports from the EC NATIONAL PROCEDURE"
^DIC(19,9677,1,2,0)="file (#725) which may include local procedures."
^DIC(19,9677,15)="W @IOF"
^DIC(19,9677,20)="W @IOF"
^DIC(19,9677,25)="ECDSS1"
^DIC(19,9677,"U")="NATIONAL/LOCAL PROCEDURE REPOR"
^DIC(19,9678,0)="ECDS CATEGORY^Local Category (Enter/Edit)^OPTION NO LONGER SUPPORTED. USE THE ECS GUI INTERFACE.^R^11596^^2941^^^^^499^^1^1"
^DIC(19,9678,1,0)="^^3^3^2960401^^^"
^DIC(19,9678,1,1,0)="This option allows users to create new entries in the EVENT"
^DIC(19,9678,1,2,0)="CAPTURE CATEGORY file (#726). The ability to edit existing"
^DIC(19,9678,1,3,0)="categories is provided in this option."
