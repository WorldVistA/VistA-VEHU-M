^DIC(19,14990,1,0)="^^2^2^3200402^"
^DIC(19,14990,1,1,0)="Delete all of the Radiololgy entries in the DICOM BATCH Q/R RUN"
^DIC(19,14990,1,2,0)=" STATISTICS file."
^DIC(19,14990,25)="KILLRAD^MAGDSTA"
^DIC(19,14990,"U")="DELETE THE STATS FOR AUTOMATIC"
^DIC(19,14991,0)="MAGD STOP AUTOMATIC PROCESSES^Stop automatic Q/R processes^^R^1^MAGD QR REPORT^^^^^^"
^DIC(19,14991,1,0)="^^3^3^3200616^"
^DIC(19,14991,1,1,0)="Stop all automatic compare image count on PACS with VistA and"
^DIC(19,14991,1,2,0)="retrieval of missing radiology study and CPRS consult/procedure"
^DIC(19,14991,1,3,0)="images."
^DIC(19,14991,25)="STOP^MAGDSTAA"
^DIC(19,14991,"U")="STOP AUTOMATIC Q/R PROCESSES"
^DIC(19,14992,0)="PSO BYPASS 3/4 DAY SUPPLY^Bypass 3/4 Day Supply^^R^1^^^^^^^141"
^DIC(19,14992,1,0)="^^3^3^3210107^"
^DIC(19,14992,1,1,0)="This option allows the user to bypass the 3/4 days supply validation and"
^DIC(19,14992,1,2,0)="transmit a prescription(s) to CMOP.  This option only applies to ePharmacy"
^DIC(19,14992,1,3,0)="billable prescriptions."
^DIC(19,14992,25)="BYPASSOPT^PSOBPSU4"
^DIC(19,14992,"U")="BYPASS 3/4 DAY SUPPLY"
^DIC(19,14993,0)="SD PROVIDER ADD/EDIT^Provider Add/Edit^^R^1^SDTOOL^^^^^^"
^DIC(19,14993,1,0)="^^2^2^3210628^"
^DIC(19,14993,1,1,0)="This option provides users with the ability to add or edit the providers"
^DIC(19,14993,1,2,0)="associated with a selected clinic."
^DIC(19,14993,25)="PROVID^SDTMPEDT"
^DIC(19,14993,"U")="PROVIDER ADD/EDIT"
