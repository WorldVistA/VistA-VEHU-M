^DIC(19,8092,0)="XMMGR-PURGE-AI-XREF^AI x-Ref Purge of Received Network Messages^^R^11748^^^^^^^54"
^DIC(19,8092,1,0)="^^5^5^2930615^"
^DIC(19,8092,1,1,0)="This option maintains the ""AI"" cross reference of mail messages."
^DIC(19,8092,1,2,0)="This is the cross reference of messages received across the network"
^DIC(19,8092,1,3,0)="and it prevents duplicate messages from being received again.  The"
^DIC(19,8092,1,4,0)="default number of days kept is 730 (about 2 years == the amount of"
^DIC(19,8092,1,5,0)="days messages can exist before being purged on FORUM)."
^DIC(19,8092,25)="PURGE^XMUTPUR0"
^DIC(19,8092,200.9)="y"
^DIC(19,8092,"U")="AI X-REF PURGE OF RECEIVED NET"
^DIC(19,8093,0)="XMMGR-MAIL-GRP-COORDINATOR^Mail Group Coordinator's Edit^^R^11748^^^^^^^54"
^DIC(19,8093,1,0)="^^6^6^2980519^^^^"
^DIC(19,8093,1,1,0)="This option allows a mail group coordinator to edit the mail groups that"
^DIC(19,8093,1,2,0)="he or she is the coordinator of (and no others).  It does not allow edit of"
^DIC(19,8093,1,3,0)="remote recipients."
^DIC(19,8093,1,4,0)=" "
^DIC(19,8093,1,5,0)="Some mail group coordinators might be given the corresponding option,"
^DIC(19,8093,1,6,0)="XMMGR-MAIL-GRP-COORD-W/REMOTE."
^DIC(19,8093,25)="LCOORD^XMVGROUP"
^DIC(19,8093,"U")="MAIL GROUP COORDINATOR'S EDIT"
^DIC(19,8094,0)="XMMGR-MAIL-GRP-COORD-W/REMOTES^Mail Group Coordinator's Edit W/Remotes^^R^11748^^^^^^^54"
^DIC(19,8094,1,0)="^^8^8^2971007^^^^"
^DIC(19,8094,1,1,0)="This option allows a mail group coordinator to edit the mail groups that"
^DIC(19,8094,1,2,0)="he or she is the coordinator of (and no others).  It allows edit of"
^DIC(19,8094,1,3,0)="remote recipients."
^DIC(19,8094,1,4,0)=" "
^DIC(19,8094,1,5,0)="Most mail group coordinators should be given the corresponding option,"
^DIC(19,8094,1,6,0)="XMMGR-MAIL-GRP-COORDINATOR that does not allow them to edit remote"
^DIC(19,8094,1,7,0)="recipients in the mail group to limit the responsibility for problems"
^DIC(19,8094,1,8,0)="delivering to incorrect addresses."
^DIC(19,8094,25)="RCOORD^XMVGROUP"
^DIC(19,8094,"U")="MAIL GROUP COORDINATOR'S EDIT "
^DIC(19,8095,0)="XMEDIT-DOMAIN-VALIDATION#^Validation Number Edit^^R^11748^^^^^^^54"
^DIC(19,8095,1,0)="^^5^5^2930729^"
^DIC(19,8095,1,1,0)="This option allows sites to edit the validation numbers so that they can be"
^DIC(19,8095,1,2,0)="synchronized.  The sender and the receiver must edit the numbers concurrently. "
^DIC(19,8095,1,3,0)="At S1.VA.GOV they edit S2.VA.GOV's validation number.  At S2.VA.GOV they edit"
^DIC(19,8095,1,4,0)="S1.VA.GOV's validation number.  The same number is used for input at both"
^DIC(19,8095,1,5,0)="sites.  "
^DIC(19,8095,25)="VAL^XMCE"
^DIC(19,8095,"U")="VALIDATION NUMBER EDIT"
^DIC(19,8107,0)="PRCA CO-PAY WAIVER REPORT^Co-Pay Waiver Report^^R^.5^^^^^^^"
^DIC(19,8107,1,0)="^^5^5^2940314^^^^"
^DIC(19,8107,1,1,0)="This option allows the user to enter data for lines 9-20 of the co-pay"
^DIC(19,8107,1,2,0)="waiver report.  After the user accepts this data entry, a background"
^DIC(19,8107,1,3,0)="job is queued to compile data for lines 1-8.  After compilation of the"
^DIC(19,8107,1,4,0)="data, the report is sent to G.PCWMCCR at FORUM (in string format).  The"
^DIC(19,8107,1,5,0)="report also is delivered to the senders in box in a printed format."
^DIC(19,8107,25)="RCCPW"
^DIC(19,8107,"U")="CO-PAY WAIVER REPORT"
^DIC(19,8110,0)="HBHXRP14^Pseudo Social Security Number Report  (80)^^R^10000000020^^^^^^^"
^DIC(19,8110,1,0)="^^8^8^2940315^^"
^DIC(19,8110,1,1,0)="This option prints the HBHC Pseudo Social Security Number (SSN) Report."
^DIC(19,8110,1,2,0)="Patients possessing a pseudo SSN have been selected in error, or their"
^DIC(19,8110,1,3,0)="SSN is invalid due to being a pseudo SSN & should be updated by MAS, or"
^DIC(19,8110,1,4,0)="the patient is a collateral & should not be tracked in the HBHC"
^DIC(19,8110,1,5,0)="Information System.  This report can be used to determine which case"
^DIC(19,8110,1,6,0)="scenario applies to the patient & appropriate corrective action taken"
^DIC(19,8110,1,7,0)="to eliminate the pseudo SSN from HBHC records.  Report includes patient"
^DIC(19,8110,1,8,0)="name & SSN & prints in 80 column format."
^DIC(19,8110,25)="HBHCRP14"
^DIC(19,8110,598000)=3
^DIC(19,8110,"U")="PSEUDO SOCIAL SECURITY NUMBER "
