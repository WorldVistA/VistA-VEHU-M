^DIC(19,3531,0)="XQ XUTL $J NODES^Clean old Job Nodes in XUTL^^R^1039^^^^^^^^^"
^DIC(19,3531,1,0)="^^12^12^2910110^"
^DIC(19,3531,1,1,0)="This option will cause old job related nodes which may remain in the"
^DIC(19,3531,1,2,0)="XUTL(""XQ"",$J, and UTILITY($J, globals to be removed.  An old job node is one"
^DIC(19,3531,1,3,0)="which was started two days prior to the current day, irrespective of the time"
^DIC(19,3531,1,4,0)="of day."
^DIC(19,3531,1,5,0)=" "
^DIC(19,3531,1,6,0)="This option is provided for those systems in which the job numbers are"
^DIC(19,3531,1,7,0)="normally not reused, in which case leaving the system in an abnormal"
^DIC(19,3531,1,8,0)="manner (mainly halting from programmer's mode) may leave an accumulation"
^DIC(19,3531,1,9,0)="of these nodes."
^DIC(19,3531,1,10,0)=" "
^DIC(19,3531,1,11,0)="The ""CUR"" X-ref of the sign-on log can get left defined in a similar manner"
^DIC(19,3531,1,12,0)="and this routine will clean this up also."
^DIC(19,3531,25)="XQ82"
^DIC(19,3531,200.9)="y"
^DIC(19,3531,"U")="CLEAN OLD JOB NODES IN XUTL"
