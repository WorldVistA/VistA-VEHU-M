^DIC(19,9506,0)="PRCD DOC REQUIRED DATA^Required Fields Edit^^R^11740^^^^^^^121"
^DIC(19,9506,1,0)="^19.06^4^4^3000606^^^^"
^DIC(19,9506,1,1,0)="This option allows the user to edit the Required Field file settings,"
^DIC(19,9506,1,2,0)="which allow IFCAP to determine the fields that must be prompted for during"
^DIC(19,9506,1,3,0)="various processes that collect data for FMS documents.  See also, ""Required"
^DIC(19,9506,1,4,0)="Fields List""."
^DIC(19,9506,25)="EN^PRCD1D"
^DIC(19,9506,"U")="REQUIRED FIELDS EDIT"
^DIC(19,9507,0)="PRC RPT DOC REQUIRED DATA^Required Fields List^^R^11740^^^^^^^121"
^DIC(19,9507,1,0)="^^7^7^2940630^^^^"
^DIC(19,9507,1,1,0)="This option allows the user to list the Required Field file settings, which"
^DIC(19,9507,1,2,0)="allow IFCAP to determine the items which must be prompted during"
^DIC(19,9507,1,3,0)="various processes that collect data for FMS documents.  The file"
^DIC(19,9507,1,4,0)="tells IFCAP, for a given FMS document type and fund, what FMS fields"
^DIC(19,9507,1,5,0)="must be included on that FMS document.  If IFCAP did not, before V.5.0, "
^DIC(19,9507,1,6,0)="prompt for these fields, and if it cannot derive them from data stored"
^DIC(19,9507,1,7,0)="in the FCP file, IFCAP will prompt the user for these fields."
^DIC(19,9507,25)="EN1^PRCD1D"
^DIC(19,9507,"U")="REQUIRED FIELDS LIST"
^DIC(19,9508,0)="PRCS EXCEPTION REPORT^FMS Exception Transaction Report^^R^11740^^^^^^^"
^DIC(19,9508,1,0)="^19.06^4^4^3000608^^^^"
^DIC(19,9508,1,1,0)="This option is used by the IFCAP application coordinator"
^DIC(19,9508,1,2,0)="to generate a report of FMS transactions"
^DIC(19,9508,1,3,0)="that did not post to control points at their site."
^DIC(19,9508,1,4,0)="This option may also be used by budget analysts."
^DIC(19,9508,25)="EXCEPT^PRCSREC1"
^DIC(19,9508,"U")="FMS EXCEPTION TRANSACTION REPO"
