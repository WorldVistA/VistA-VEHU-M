^DIC(19,9192,0)="XUTM REPNT^Repoint waiting tasks to a new port/device^^R^11247^^^^^^^163"
^DIC(19,9192,1,0)="^^4^4^2950905^^"
^DIC(19,9192,1,1,0)="This option will allow the site staff to take all tasks waiting for a"
^DIC(19,9192,1,2,0)="given port/LTA device and reschedule them to some new device and/or to a"
^DIC(19,9192,1,3,0)="new time.  This is useful when a port stops working and the tasks backed"
^DIC(19,9192,1,4,0)="up waiting for it can be sent to another device untill it is fixed."
^DIC(19,9192,25)="REPNT^XUTMRP"
^DIC(19,9192,"U")="REPOINT WAITING TASKS TO A NEW"
