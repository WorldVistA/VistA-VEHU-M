^DIC(19,16094,"U")="CPRS REPORTS TAB 'HEALTH SUMMA"
^DIC(19,16095,0)="EHM-00916^Display 'Health Summary Types List' Defaults^^R^1^^^^^^^^^^^"
^DIC(19,16095,1,0)="^19.06^6^6^3240328^^^^"
^DIC(19,16095,1,1,0)="Use this option to display the list of Health Summary Types that "
^DIC(19,16095,1,2,0)="will be contained in the 'Health Summary Types' section on the "
^DIC(19,16095,1,3,0)="Reports Tab in CPRS.  The display includes the precedence of "
^DIC(19,16095,1,4,0)="parameters, the method for building the list, and finally the list"
^DIC(19,16095,1,5,0)="that will actually appear on the Reports Tab in CPRS."
^DIC(19,16095,1,6,0)="Cloned from ""GMTS GUI HS LIST DEFAULTS"" option."
^DIC(19,16095,3)=""
^DIC(19,16095,25)="DISP^GMTSXA"
^DIC(19,16095,"U")="DISPLAY 'HEALTH SUMMARY TYPES "
^DIC(19,16096,0)="EHM-00917^Precedence of 'Health Summary Types List'^^R^1^^^^^^^^^^^"
^DIC(19,16096,1,0)="^^18^18^3240328^"
^DIC(19,16096,1,1,0)="Use this option to select the defined Health Summary Types to include"
^DIC(19,16096,1,2,0)="on the list and arrange them in the order (precedence) that they "
^DIC(19,16096,1,3,0)="should appear on the list.  The three most common groups of Health "
^DIC(19,16096,1,4,0)="Summary Types are:"
^DIC(19,16096,1,5,0)=""
^DIC(19,16096,1,6,0)=" SYS  Health Summary Types may be defined for all users on the system."
^DIC(19,16096,1,7,0)=""
^DIC(19,16096,1,8,0)=" USR  Health Summary Types may be defined for a single user on the"
^DIC(19,16096,1,9,0)="      system."
^DIC(19,16096,1,10,0)=""
^DIC(19,16096,1,11,0)=" NAT  Nationally exported Health Summary Types (NAT) defined for "
^DIC(19,16096,1,12,0)="      system users or a single user are treated independently to"
^DIC(19,16096,1,13,0)="      keep them together in the list box."
^DIC(19,16096,1,14,0)=""
^DIC(19,16096,1,15,0)="In this option, you must first select those Health Summary Type groups"
^DIC(19,16096,1,16,0)="(SYS, USR, NAT, etc.) to include on the Reports Tab, then specify the"
^DIC(19,16096,1,17,0)="order in which they will appear on the Reports Tab."
^DIC(19,16096,1,18,0)="Cloned from ""GMTS GUI HS LIST PRECEDENCE"" option."
^DIC(19,16096,3)=""
^DIC(19,16096,25)="PREC^GMTSXA"
^DIC(19,16096,"U")="PRECEDENCE OF 'HEALTH SUMMARY "
^DIC(19,16097,0)="EHM-00918^Method of compiling 'Health Summary Types List'^^R^1^^^^^^^^^^^"
^DIC(19,16097,1,0)="^19.06^14^14^3240328^^^"
^DIC(19,16097,1,1,0)="Use this option to edit the method used to build the list of Health"
^DIC(19,16097,1,2,0)="Summary Types displayed on the Reports Tab in CPRS.  There are 2 "
^DIC(19,16097,1,3,0)="methods:"
^DIC(19,16097,1,4,0)=""
^DIC(19,16097,1,5,0)="   Overwrite   System-defined Health Summary Types are added "
^DIC(19,16097,1,6,0)="               to the list.  If there are User-defined Health"
^DIC(19,16097,1,7,0)="               Summary Types, then they will replace the System"
^DIC(19,16097,1,8,0)="               defined Health Summary Types already on the list."
^DIC(19,16097,1,9,0)=""
^DIC(19,16097,1,10,0)="   Append      System-defined Health Summary Types are added to"
^DIC(19,16097,1,11,0)="               the list.  If there are User-defined Health Summary"
^DIC(19,16097,1,12,0)="               Types, then they will added to the list along with "
^DIC(19,16097,1,13,0)="               the System-defined types."
^DIC(19,16097,1,14,0)="Cloned from ""GMTS GUI HS LIST METHOD"" option."
^DIC(19,16097,3)=""
^DIC(19,16097,25)="METH^GMTSXA"
^DIC(19,16097,"U")="METHOD OF COMPILING 'HEALTH SU"
^DIC(19,16098,0)="EHM-00919^Edit 'Health Summary Types List' Parameters^^R^1^^^^^^^^^^^"
^DIC(19,16098,1,0)="^^5^5^3240328^"
^DIC(19,16098,1,1,0)="Use this option to add, edit or delete a Health Summary Type from"
^DIC(19,16098,1,2,0)="the list of Health Summary Types defined by the user.  If you are "
^DIC(19,16098,1,3,0)="a holder of the GMTSMGR Key, you can also use this option to edit"
^DIC(19,16098,1,4,0)="the Health Summary Types defined for the System."
^DIC(19,16098,1,5,0)="Cloned from ""GMTS GUI HS LIST PARAMETERS"" option."
^DIC(19,16098,3)=""
^DIC(19,16098,25)="EDIT^GMTSXA"
^DIC(19,16098,"U")="EDIT 'HEALTH SUMMARY TYPES LIS"
^DIC(19,16099,0)="EHM-00920^CPRS Health Summary Display/Edit Site Defaults^^M^1^^^^^^^^^^^"
^DIC(19,16099,1,0)="^^9^9^3240328^"
^DIC(19,16099,1,1,0)="Use the options in the CPRS Health Summary Display/Edit Site "
^DIC(19,16099,1,2,0)="Defaults Menu to display the site defaults, select the Health "
^DIC(19,16099,1,3,0)="Summary Types to list on the Reports Tab, edit the method of "
^DIC(19,16099,1,4,0)="building the list (append/overwrite), edit allowable entities"
^DIC(19,16099,1,5,0)="for the list (i.e., User, System, Division, etc.), or resequence"
^DIC(19,16099,1,6,0)="the allowable entities in the order they should be appear on "
^DIC(19,16099,1,7,0)="the list."
^DIC(19,16099,1,8,0)=""
^DIC(19,16099,1,9,0)="Cloned from ""GMTS GUI SITE DEFAULTS"" option."
^DIC(19,16099,3)=""
