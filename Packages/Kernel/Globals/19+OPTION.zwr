^DIC(19,12375,0)="XQAL REPORTS MENU^Report Menu for Alerts^^M^10000000020^^^^^^^163"
^DIC(19,12375,1,0)="^19.06^2^2^3030805^^^"
^DIC(19,12375,1,1,0)="This menu provides several options for generating reports on alerts for "
^DIC(19,12375,1,2,0)="users or patients."
^DIC(19,12375,10,0)="^19.01IP^5^5"
^DIC(19,12375,10,1,0)=12376
^DIC(19,12375,10,2,0)=12377
^DIC(19,12375,10,3,0)=12378
^DIC(19,12375,10,4,0)=12379
^DIC(19,12375,10,5,0)=12380
^DIC(19,12375,10,"B",12376,1)=""
^DIC(19,12375,10,"B",12377,2)=""
^DIC(19,12375,10,"B",12378,3)=""
^DIC(19,12375,10,"B",12379,4)=""
^DIC(19,12375,10,"B",12380,5)=""
^DIC(19,12375,99)="59470,42380"
^DIC(19,12375,"U")="REPORT MENU FOR ALERTS"
^DIC(19,12376,0)="XQAL USER ALERTS COUNT^User Alerts Count Report^^R^10000000020^^^^^^^163"
^DIC(19,12376,1,0)="^^10^10^3030731^"
^DIC(19,12376,1,1,0)="This option is used to generate a report on users who have more than a "
^DIC(19,12376,1,2,0)="specified number of alerts in the ALERTS file (#8992).  The report covers "
^DIC(19,12376,1,3,0)="a specified range of dates, and can be sorted by user name, number of "
^DIC(19,12376,1,4,0)="alerts, or by service/section.  In addition, the report in each of these "
^DIC(19,12376,1,5,0)="formats may be generated by Divisions if desired."
^DIC(19,12376,1,6,0)=" "
^DIC(19,12376,1,7,0)="For each user who has the specified number of alerts or more, the report"
^DIC(19,12376,1,8,0)="includes the user name, the section/service for the user, the number of"
^DIC(19,12376,1,9,0)="alerts in the ALERTS file, the last sign-on date, the number of Critical "
^DIC(19,12376,1,10,0)="alerts or Abnormal Imaging alerts, and the date of the oldest alert."
^DIC(19,12376,25)="EN1^XQARPRT1"
^DIC(19,12376,"U")="USER ALERTS COUNT REPORT"
^DIC(19,12377,0)="XQAL CRITICAL ALERT COUNT^Critical Alerts Count Report^^R^10000000020^^^^^^^163"
^DIC(19,12377,1,0)="^^11^11^3030731^"
^DIC(19,12377,1,1,0)="This option is used to generate a report of users who have more than a "
^DIC(19,12377,1,2,0)="specified number of alerts containing the word 'critical' or the words "
^DIC(19,12377,1,3,0)="'abnormal imaging' between the specified start and end dates. The report"
^DIC(19,12377,1,4,0)="is presented in descending order for the number of critical/abnormal"
^DIC(19,12377,1,5,0)="imaging alerts present."
^DIC(19,12377,1,6,0)=" "
^DIC(19,12377,1,7,0)="For each user who has the specified number of critical/abnormal "
^DIC(19,12377,1,8,0)="imaging alerts or more, the report includes the user name, the"
^DIC(19,12377,1,9,0)="section/service for the user, the number of alerts in the ALERTS file, the"
^DIC(19,12377,1,10,0)="last sign-on date, the number of Critical alerts or Abnormal Imaging"
^DIC(19,12377,1,11,0)="alerts, and the date of the oldest alert."
^DIC(19,12377,25)="CRITICAL^XQARPRT1"
^DIC(19,12377,"U")="CRITICAL ALERTS COUNT REPORT"
^DIC(19,12378,0)="XQAL ALERT LIST FROM DATE^List Alerts for a user from a specified date^^R^10000000020^^^^^^^163"
^DIC(19,12378,1,0)="^^8^8^3030731^"
^DIC(19,12378,1,1,0)="This option is used to obtain an interactive list of alerts from the "
^DIC(19,12378,1,2,0)="ALERT TRACKING file (#8992.1) for a specified user starting from a "
^DIC(19,12378,1,3,0)="specified date."
^DIC(19,12378,1,4,0)=" "
^DIC(19,12378,1,5,0)="The listing includes the internal entry number for the alert in the ALERT "
^DIC(19,12378,1,6,0)="TRACKING file, the date and time the alert was generated, the message "
^DIC(19,12378,1,7,0)="text of the alert, and information about any option or routine to be "
^DIC(19,12378,1,8,0)="executed for processing the alert."
^DIC(19,12378,25)="EN^XQARPRT2"
^DIC(19,12378,"U")="LIST ALERTS FOR A USER FROM A "
^DIC(19,12379,0)="XQAL PATIENT ALERT LIST^Patient Alert List for specified date^^R^10000000020^^^^^^^163"
^DIC(19,12379,1,0)="^^12^12^3030731^"
^DIC(19,12379,1,1,0)="This option is used to obtain a list of alerts for a specified patient "
^DIC(19,12379,1,2,0)="from the ALERT TRACKING file (#8992.1) for a selected date."
^DIC(19,12379,1,3,0)=" "
^DIC(19,12379,1,4,0)="A prompt is provided to obtain a quick scan listing of dates with at least"
^DIC(19,12379,1,5,0)="some alerts for the patient on it based on OR and DVB alerts (other"
^DIC(19,12379,1,6,0)="patient related alerts need to be identified by looking at each alert's"
^DIC(19,12379,1,7,0)="message text and are included in the full list, but not the quick scan)."
^DIC(19,12379,1,8,0)=" "
^DIC(19,12379,1,9,0)="The listing includes the internal entry number for the alert in the ALERT"
^DIC(19,12379,1,10,0)="TRACKING file, the date and time the alert was generated, the message"
^DIC(19,12379,1,11,0)="text of the alert, and information about any option or routine to be"
^DIC(19,12379,1,12,0)="executed for processing the alert."
^DIC(19,12379,25)="DTPT^XQARPRT2"
^DIC(19,12379,"U")="PATIENT ALERT LIST FOR SPECIFI"
^DIC(19,12380,0)="XQAL VIEW ALERT TRACKING ENTRY^View data for Alert Tracking file entry^^R^10000000020^^^^^^^163"
^DIC(19,12380,1,0)="^^3^3^3030805^"
^DIC(19,12380,1,1,0)="This option can be used to view data for one or more entries in the Alert "
^DIC(19,12380,1,2,0)="Tracking file (#8992.1) in captioned format. The internal entry numbers"
^DIC(19,12380,1,3,0)="for the entries to be displayed must be entered individually."
^DIC(19,12380,25)="VIEWTRAK^XQARPRT2"
^DIC(19,12380,"U")="VIEW DATA FOR ALERT TRACKING F"
