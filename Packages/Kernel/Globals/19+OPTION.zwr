^DIC(19,9698,1,1,0)="This option allows the ADP coordinator to enter items into the GMRY INTAKE "
^DIC(19,9698,1,2,0)="ITEMS file (#126.8) pointed to by the GMRY PATIENT I/O FILE file (#126)."
^DIC(19,9698,15)="K DLAYGO"
^DIC(19,9698,20)="S DLAYGO=126.8"
^DIC(19,9698,30)="GMRD(126.8,"
