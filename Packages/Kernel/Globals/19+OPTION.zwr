^DIC(19,10441,0)="TIU NIGHTLY TASK^Text Integration Utility Nightly Task^^A^11712^^^^^^^516^^1"
^DIC(19,10441,1,0)="^^6^6^2960611^"
^DIC(19,10441,1,1,0)="This is a nightly task that will selectively traverse the TEXT INTEGRATION"
^DIC(19,10441,1,2,0)="UTILITIES (TIU) database, and send alerts when a document is overdue for"
^DIC(19,10441,1,3,0)="signature summaries, update missing Discharge Dates now available"
^DIC(19,10441,1,4,0)="through Bed Control, purge documents for which the Grace Period for"
^DIC(19,10441,1,5,0)="Purge has been exceeded, and delete all records in the Upload Buffer file"
^DIC(19,10441,1,6,0)="that are older than 30 days."
^DIC(19,10441,20)="D MAIN^TIUTSK"
^DIC(19,10441,99)="55684,29409"
^DIC(19,10441,200.9)="y"
^DIC(19,10441,"U")="TEXT INTEGRATION UTILITY NIGHT"
