^DIC(19,1655,0)="RA PROCSERIES^Series of Procedures List^^R^11712^^^^^^^"
^DIC(19,1655,1,0)="^^6^6^2940606^"
^DIC(19,1655,1,1,0)="This option allows the supervisor to generate a list"
^DIC(19,1655,1,2,0)="of procedures which are classified as 'SERIES'.  The"
^DIC(19,1655,1,3,0)="following information is included: CPT code, procedure, AMIS code,"
^DIC(19,1655,1,4,0)="multiplier, bilateral, CT Head/Body, type of procedure, required"
^DIC(19,1655,1,5,0)="flash card printer, required flash card format, and staff review of"
^DIC(19,1655,1,6,0)="reports required."
^DIC(19,1655,25)="12^RAMAINP"
^DIC(19,1655,"U")="SERIES OF PROCEDURES LIST"
^DIC(19,1656,0)="RA LWKL^Functional Area Workload Reports^^M^11712^^^^^^^"
^DIC(19,1656,1,0)="^^3^3^2940606^^"
^DIC(19,1656,1,1,0)="This menu provides the supervisor with a list of options available to"
^DIC(19,1656,1,2,0)="generate workload reports for Clinics, PTF Bedsections, Radiology/Nuclear"
^DIC(19,1656,1,3,0)="Medicine Service, Sharing Agreement/Contracts and Wards."
^DIC(19,1656,10,0)="^19.01PI^5^5"
^DIC(19,1656,10,1,0)="1657^"
^DIC(19,1656,10,2,0)="1658^"
^DIC(19,1656,10,3,0)="1659^"
^DIC(19,1656,10,4,0)="1660^"
^DIC(19,1656,10,5,0)="1661^"
^DIC(19,1656,10,"B",1657,1)=""
^DIC(19,1656,10,"B",1658,2)=""
^DIC(19,1656,10,"B",1659,3)=""
^DIC(19,1656,10,"B",1660,4)=""
^DIC(19,1656,10,"B",1661,5)=""
^DIC(19,1656,99)="59924,36533"
^DIC(19,1656,"U")="FUNCTIONAL AREA WORKLOAD REPOR"
^DIC(19,1657,0)="RA LWKLWARD^Ward Report^^R^11712^^^^^^y^"
^DIC(19,1657,1,0)="^^17^17^2940830^"
^DIC(19,1657,1,1,0)="This option allows the supervisor to generate a listing of ward workloads."
^DIC(19,1657,1,2,0)="The supervisor is prompted to generate a 'detailed' or 'summary' report."
^DIC(19,1657,1,3,0)="If the supervisor has access to more than one division or imaging type,"
^DIC(19,1657,1,4,0)="s/he is prompted to select the divisions and imaging types to include in"
^DIC(19,1657,1,5,0)="the report. The supervisor is prompted to select the wards to include in"
^DIC(19,1657,1,6,0)="the report. The supervisor may select one, many or all wards. The"
^DIC(19,1657,1,7,0)="supervisor is prompted to enter a date range for the exams to be included"
^DIC(19,1657,1,8,0)="in the report. The exam status values that will be included in the report"
^DIC(19,1657,1,9,0)="will be displayed by imaging type."
^DIC(19,1657,1,10,0)=" "
^DIC(19,1657,1,11,0)="The reports are listed by division, imaging type within the division, and"
^DIC(19,1657,1,12,0)="then by ward within the imaging type. The report contains the following"
^DIC(19,1657,1,13,0)="information: procedure, number of examinations, weighted work units, and"
^DIC(19,1657,1,14,0)="percent of total weighted work units. A 'summary' report groups all"
^DIC(19,1657,1,15,0)="examinations together by ward for each imaging type and division. A"
^DIC(19,1657,1,16,0)="'detailed' report gives information for each individual procedure"
^DIC(19,1657,1,17,0)="performed within the ward."
^DIC(19,1657,25)="WARD^RALWKL"
^DIC(19,1657,"U")="WARD REPORT"
^DIC(19,1658,0)="RA LWKLSERVICE^Service Report^^R^11712^^^^^^y^"
^DIC(19,1658,1,0)="^^18^18^2940830^"
^DIC(19,1658,1,1,0)="This option allows the supervisor to generate a listing of"
^DIC(19,1658,1,2,0)="Radiology/Nuclear Medicine Service workloads. The supervisor is prompted"
^DIC(19,1658,1,3,0)="to generate a 'detailed' or 'summary' report. If the supervisor has access"
^DIC(19,1658,1,4,0)="to more than one division or imaging type, s/he is prompted to select the"
^DIC(19,1658,1,5,0)="divisions and imaging types to include in the report. The supervisor is"
^DIC(19,1658,1,6,0)="prompted to select the services to include in the report. The supervisor"
^DIC(19,1658,1,7,0)="may select one, many or all services. The supervisor is prompted to enter"
^DIC(19,1658,1,8,0)="a date range for the exams to be included in the report. The exam status"
^DIC(19,1658,1,9,0)="values that will be included in the report will be displayed by imaging"
^DIC(19,1658,1,10,0)="type."
^DIC(19,1658,1,11,0)=" "
^DIC(19,1658,1,12,0)="The reports are listed by division, imaging type within the division, and"
^DIC(19,1658,1,13,0)="then by service within the imaging type. The report contains the following"
^DIC(19,1658,1,14,0)="information: procedure, number of examinations, weighted work units, and"
^DIC(19,1658,1,15,0)="percent of total weighted work units. A 'summary' report groups all"
^DIC(19,1658,1,16,0)="examinations together by Service for each imaging type and division. A"
^DIC(19,1658,1,17,0)="'detailed' report gives information for each individual procedure"
^DIC(19,1658,1,18,0)="performed within the service."
^DIC(19,1658,25)="SERV^RALWKL"
^DIC(19,1658,"U")="SERVICE REPORT"
^DIC(19,1659,0)="RA LWKLBEDSEC^PTF Bedsection Report^^R^11712^^^^^^y^"
^DIC(19,1659,1,0)="^^17^17^2940908^^"
^DIC(19,1659,1,1,0)="This option allows the supervisor to generate a listing of PTF Bedsection"
^DIC(19,1659,1,2,0)="workloads. The supervisor is prompted to generate a 'detailed' or"
^DIC(19,1659,1,3,0)="'summary' report. If the supervisor has access to more than one division"
^DIC(19,1659,1,4,0)="or imaging type, s/he is prompted to select the divisions and imaging"
^DIC(19,1659,1,5,0)="types to include in the report. The supervisor is prompted to select the"
^DIC(19,1659,1,6,0)="bedsections to include in the report. The supervisor may select one, many"
^DIC(19,1659,1,7,0)="or all bedsections. The supervisor is prompted to enter a date range for"
^DIC(19,1659,1,8,0)="the exams to be included in the report. The exam status values that will"
^DIC(19,1659,1,9,0)="be included in the report will be displayed by imaging type."
^DIC(19,1659,1,10,0)=" "
^DIC(19,1659,1,11,0)="The reports are listed by division, imaging type within the division, and"
^DIC(19,1659,1,12,0)="then by bedsection within the imaging type. The report contains the"
^DIC(19,1659,1,13,0)="following information: procedure, number of examinations, weighted work"
^DIC(19,1659,1,14,0)="units, and percent of total weighted work units. A 'summary' report groups"
^DIC(19,1659,1,15,0)="all examinations together by bedsection for each imaging type and"
^DIC(19,1659,1,16,0)="division. A 'detailed' report gives information for each individual"
^DIC(19,1659,1,17,0)="procedure performed within the bedsection."
^DIC(19,1659,25)="BEDSEC^RALWKL"
^DIC(19,1659,"U")="PTF BEDSECTION REPORT"
^DIC(19,1660,0)="RA LWKLCLINIC^Clinic Report^^R^11712^^^^^^y^"
^DIC(19,1660,1,0)="^^17^17^2940830^"
^DIC(19,1660,1,1,0)="This option allows the supervisor to generate a listing of clinic"
^DIC(19,1660,1,2,0)="workloads. The supervisor is prompted to generate a 'detailed' or"
^DIC(19,1660,1,3,0)="'summary' report. If the supervisor has access to more than one division"
^DIC(19,1660,1,4,0)="or imaging type, s/he is prompted to select the divisions and imaging"
^DIC(19,1660,1,5,0)="types to include in the report. The supervisor is prompted to select the"
^DIC(19,1660,1,6,0)="clinics to include in the report. The supervisor may select one, many or"
^DIC(19,1660,1,7,0)="all clinics. The supervisor is prompted to enter a date range for the"
^DIC(19,1660,1,8,0)="exams to be included in the report. The exam status values that will be"
^DIC(19,1660,1,9,0)="included in the report will be displayed by imaging type."
^DIC(19,1660,1,10,0)=" "
^DIC(19,1660,1,11,0)="The reports are listed by division, imaging type within the division, and"
^DIC(19,1660,1,12,0)="then by clinic within the imaging type. The report contains the following"
^DIC(19,1660,1,13,0)="information: procedure, number of examinations, weighted work units, and"
^DIC(19,1660,1,14,0)="percent of total weighted work units. A 'summary' report groups all"
^DIC(19,1660,1,15,0)="examinations together by clinic for each imaging type and division. A"
^DIC(19,1660,1,16,0)="'detailed' report gives information for each individual procedure"
^DIC(19,1660,1,17,0)="performed within the clinic."
^DIC(19,1660,25)="CLINIC^RALWKL"
^DIC(19,1660,"U")="CLINIC REPORT"
^DIC(19,1661,0)="RA LWKLSHARING^Sharing Agreement/Contract Report^^R^11712^^^^^^y^"
^DIC(19,1661,1,0)="^^18^18^2940830^"
^DIC(19,1661,1,1,0)="This option allows the supervisor to generate a listing of Sharing"
^DIC(19,1661,1,2,0)="Agreement/Contract workloads. The supervisor is prompted to generate a"
^DIC(19,1661,1,3,0)="'detailed' or 'summary' report. If the supervisor has access to more than"
^DIC(19,1661,1,4,0)="one division or imaging type, s/he is prompted to select the divisions and"
^DIC(19,1661,1,5,0)="imaging types to include in the report. The supervisor is prompted to"
^DIC(19,1661,1,6,0)="select the Sharing Agreements/Contracts to include in the report. The"
^DIC(19,1661,1,7,0)="supervisor may select one, many or all Sharing Agreements/Contracts . The"
^DIC(19,1661,1,8,0)="supervisor is prompted to enter a date range for the exams to be included"
^DIC(19,1661,1,9,0)="in the report. The exam status values that will be included in the report"
^DIC(19,1661,1,10,0)="will be displayed by imaging type."
^DIC(19,1661,1,11,0)=" "
^DIC(19,1661,1,12,0)="The reports are listed by division, imaging type within the division, and"
^DIC(19,1661,1,13,0)="then by Sharing Agreement/Contract within the imaging type. The report"
^DIC(19,1661,1,14,0)="contains the following information: procedure, number of examinations,"
^DIC(19,1661,1,15,0)="weighted work units, and percent of total weighted work units. A 'summary'"
^DIC(19,1661,1,16,0)="report groups all examinations together by bedsection for each imaging"
^DIC(19,1661,1,17,0)="type and division. A 'detailed' report gives information for each"
^DIC(19,1661,1,18,0)="individual procedure performed within the Sharing Agreement/Contract."
^DIC(19,1661,25)="SHAR^RALWKL"
^DIC(19,1661,"U")="SHARING AGREEMENT/CONTRACT REP"
^DIC(19,1662,0)="RA STANDRPTS^Standard Reports Entry/Edit^^R^11712^^^^^^^"
^DIC(19,1662,1,0)="^^14^14^2940606^"
^DIC(19,1662,1,1,0)="This function allows the coordinator to enter new standard"
^DIC(19,1662,1,2,0)="reports or to edit existing ones."
^DIC(19,1662,1,3,0)=" "
^DIC(19,1662,1,4,0)="These standard reports are used by the transcriptionist in the"
^DIC(19,1662,1,5,0)="'Report Enter/Edit' function."
^DIC(19,1662,1,6,0)=" "
^DIC(19,1662,1,7,0)="If the transcriptionist selects a standard report for a specific exam,"
^DIC(19,1662,1,8,0)="the report and impression fields will also be filled in for that"
^DIC(19,1662,1,9,0)="exam."
^DIC(19,1662,1,10,0)=" "
^DIC(19,1662,1,11,0)=" "
^DIC(19,1662,1,12,0)="The transcriptionist will only be given the 'Select STANDARD REPORTS'"
^DIC(19,1662,1,13,0)="prompt during the 'Report Enter/Edit' function, if the 'division'"
^DIC(19,1662,1,14,0)="parameter controlling standard reports use is set to 'yes'."
^DIC(19,1662,25)="9^RAMAIN"
^DIC(19,1662,"U")="STANDARD REPORTS ENTRY/EDIT"
^DIC(19,1663,0)="RA STANDPRINT^Standard Reports Print^^R^11712^^^^^^^"
^DIC(19,1663,1,0)="^^2^2^2890221^^^"
^DIC(19,1663,1,1,0)="This function allows the user to obtain a list of the standard reports,"
^DIC(19,1663,1,2,0)="as specified by the 'Standard Reports Entry/Edit' function."
^DIC(19,1663,25)="13^RAMAINP"
^DIC(19,1663,"U")="STANDARD REPORTS PRINT"
^DIC(19,1664,0)="RA RPTVERIFY^Verify Report Only^^R^11712^RA VERIFY^^^^^^^^1^1"
^DIC(19,1664,1,0)="^^4^4^2940713^"
^DIC(19,1664,1,1,0)="This function allows the user to verify a report without having to"
^DIC(19,1664,1,2,0)="access the 'Report Enter/Edit' option. This function is often used when a"
^DIC(19,1664,1,3,0)="report has been edited, but the report status has not been updated to"
^DIC(19,1664,1,4,0)="reflect the 'verified' status."
^DIC(19,1664,15)="K RANOSCRN,^TMP($J,""RA D-TYPE""),^TMP($J,""RA I-TYPE"")"
^DIC(19,1664,20)="S RANOSCRN="""""
^DIC(19,1664,25)="3^RART"
^DIC(19,1664,99.1)="60640,51763"
^DIC(19,1664,"U")="VERIFY REPORT ONLY"
^DIC(19,1665,0)="RA STATLOOK^Exam Status Display^^R^11712^^^^^^^"
^DIC(19,1665,1,0)="^^4^4^2940606^^"
^DIC(19,1665,1,1,0)="This function allows the user to view the status of exams for"
^DIC(19,1665,1,2,0)="his/her location currently entered in the system. The number"
^DIC(19,1665,1,3,0)="of exam statuses is dependent upon how many have been configured"
^DIC(19,1665,1,4,0)="into the system by the package coordinator."
^DIC(19,1665,25)="EN1^RASTEXT"
^DIC(19,1665,"U")="EXAM STATUS DISPLAY"
^DIC(19,1666,0)="RA CANCEL^Cancel an Exam^^R^11720^^^^^^^^^1^1"
^DIC(19,1666,1,0)="^19.06^11^11^3050719^^^^"
^DIC(19,1666,1,1,0)="This function allows the user to cancel an exam on record if a report has"
^DIC(19,1666,1,2,0)="not already been filed for that exam.  An exam is"
^DIC(19,1666,1,3,0)="often cancelled if the patient cannot have the exam performed.  "
^DIC(19,1666,1,4,0)="For example, the patient may become ill while waiting to have the"
^DIC(19,1666,1,5,0)="procedure performed."
^DIC(19,1666,1,6,0)=" "
^DIC(19,1666,1,7,0)="Once the examination is 'CANCELLED', the user will be prompted to"
^DIC(19,1666,1,8,0)="answer with a 'YES' or 'NO' to cancel the request associated with"
^DIC(19,1666,1,9,0)="this exam. If 'YES', the request will also be cancelled and the request "
^DIC(19,1666,1,10,0)="status updated to 'CANCELLED'. If 'NO', the request status will be updated"
^DIC(19,1666,1,11,0)="to 'HOLD' and may be selected for registration at a future date."
^DIC(19,1666,15)="K RACAN124"
^DIC(19,1666,20)="S RACAN124="""""
^DIC(19,1666,25)="CANCEL^RAEDCN"
^DIC(19,1666,"U")="CANCEL AN EXAM"
^DIC(19,1667,0)="RA RPTPAT^Select Report to Print by Patient^^R^11712^^^^^^^^^1^1"
^DIC(19,1667,1,0)="^^5^5^2970310^^^^"
^DIC(19,1667,1,1,0)="This function allows the user to print reports by patient name."
^DIC(19,1667,1,2,0)="If the report has not been filed, then a warning message is displayed."
^DIC(19,1667,1,3,0)="   "
^DIC(19,1667,1,4,0)="This function is often used to print a report that is lost or when a"
^DIC(19,1667,1,5,0)="duplicate is needed."
^DIC(19,1667,15)="K RANOSCRN,RAOPT(""RPTPAT"")"
^DIC(19,1667,20)="S RANOSCRN="""",RAOPT(""RPTPAT"")="""""
^DIC(19,1667,25)="4^RART2"
^DIC(19,1667,99)="56383,35214"
^DIC(19,1667,"U")="SELECT REPORT TO PRINT BY PATI"
^DIC(19,1668,0)="RA MODIFIER^Procedure Modifier Entry^^R^11712^^^^^^^"
^DIC(19,1668,1,0)="^^2^2^2940606^^^^"
^DIC(19,1668,1,1,0)="This option allows the entry of new modifiers to the 'Procedure Modifier' "
^DIC(19,1668,1,2,0)="file (#71.2)."
^DIC(19,1668,25)="10^RAMAIN"
^DIC(19,1668,"U")="PROCEDURE MODIFIER ENTRY"
^DIC(19,1669,0)="RA MODIFIERP^Modifier List^^R^11712^^^^^^^"
^DIC(19,1669,1,0)="^^2^2^2890221^^^^"
^DIC(19,1669,1,1,0)="This option lists all entries in the 'Procedure Modifiers' file"
^DIC(19,1669,1,2,0)="(#71.2)."
^DIC(19,1669,25)="14^RAMAINP"
^DIC(19,1669,"U")="MODIFIER LIST"
^DIC(19,1670,0)="RA REPRINT^Draft Report (Reprint)^^R^11712^^^^^^^"
^DIC(19,1670,1,0)="^^5^5^2940606^^"
^DIC(19,1670,1,1,0)="This option should only be given to those users in the department"
^DIC(19,1670,1,2,0)="who need to reprint a draft report. For example, the transcriptionist"
^DIC(19,1670,1,3,0)="should have access to this option, but ward clerks should not. Instead, the"
^DIC(19,1670,1,4,0)="ward clerks should be given access to the 'Select Report to Print by"
^DIC(19,1670,1,5,0)="Patient' option."
^DIC(19,1670,25)="5^RART1"
^DIC(19,1670,99)="56111,44666"
^DIC(19,1670,"U")="DRAFT REPORT (REPRINT)"
^DIC(19,1671,0)="RA ALPHALIST^Alpha Listing of Active Procedures^^R^11712^^^^^^^"
^DIC(19,1671,1,0)="^^2^2^2881229^^^^"
^DIC(19,1671,1,1,0)="This option lists only those procedures that are currently active."
^DIC(19,1671,1,2,0)="The print is sorted by the name of the procedures."
^DIC(19,1671,25)="15^RAMAINP"
^DIC(19,1671,"U")="ALPHA LISTING OF ACTIVE PROCED"
^DIC(19,1672,0)="RA PROCLISTS^Procedure File Listings^^M^11712^^^^^^^"
^DIC(19,1672,1,0)="^^2^2^2970522^^^^"
^DIC(19,1672,1,1,0)="This menu contains all the various print options relating to the"
^DIC(19,1672,1,2,0)="Rad/Nuc Med Procedures file."
