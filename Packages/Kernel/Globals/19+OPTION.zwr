^DIC(19,14687,0)="OR QUICK ORDER NIGHTLY BG^OR Quick Order Nightly Background Task^^R^11720^^^1^^^n^170^n"
^DIC(19,14687,1,0)="^19.06^7^7^3171213^^^^"
^DIC(19,14687,1,1,0)="This option loops through recent additions to the Quick Order Audit file"
^DIC(19,14687,1,2,0)="and searches the Order file for the corresponding order.  If found, the"
^DIC(19,14687,1,3,0)="ORDER field is populated."
^DIC(19,14687,1,4,0)="  "
^DIC(19,14687,1,5,0)=" This option should be run at least once every 24 hours and is intended to"
^DIC(19,14687,1,6,0)="set up as a recurring nightly task.  However, it can also be run"
^DIC(19,14687,1,7,0)="interactively when more immediate turnaround is desired."
^DIC(19,14687,10.1)="QUICK ORDER NIGHTLY"
^DIC(19,14687,25)="START^ORQOAUIA"
^DIC(19,14687,200.9)="y^y"
^DIC(19,14687,"U")="OR QUICK ORDER NIGHTLY BACKGRO"
^DIC(19,14688,0)="OR QUICK ORDER AUDIT MONTHLY^OR Quick Order Audit Monthly^^R^11720^^^1^^^y^170"
^DIC(19,14688,1,0)="^19.06^6^6^3171213^^^"
^DIC(19,14688,1,1,0)="Can only go back 30 days. It lists orders for a given timeframe for"
^DIC(19,14688,1,2,0)="Orderable Items marked as anti-microbial in the Orderable Items file.  "
^DIC(19,14688,1,3,0)="This list breaks these down by those ordered through Antimicrobial order"
^DIC(19,14688,1,4,0)="dialogs and those that were not.  This helps us monitor compliance on the"
^DIC(19,14688,1,5,0)="use of Antimicrobial order dialogs. For multiple division sites reports"
^DIC(19,14688,1,6,0)="can be made for each division."
^DIC(19,14688,10.1)="antimicrobial order list"
^DIC(19,14688,25)="ORQOAUIB"
^DIC(19,14688,"U")="OR QUICK ORDER AUDIT MONTHLY"
^DIC(19,14689,0)="OR QUICK ORDER DIVISION GROUPS^OR Quick Order Division Groups Edit^^R^11720^^^^^^y^170"
