^DIC(19,311,"U")="PRINT PM PROCEDURE"
^DIC(19,312,0)="ENPM4^Enter/Edit Specific Device PM Schedule^^R^.5^^^^^^^"
^DIC(19,312,1,0)="^^3^3^2880513^"
^DIC(19,312,1,1,0)="Enter or change the PM schedule for a specified device (discrete entry in"
^DIC(19,312,1,2,0)="File 6914, EQUIPMENT INV.). This option will have no affect on other"
^DIC(19,312,1,3,0)="entries of the same device type."
^DIC(19,312,25)="PMSE^ENEQPMP"
^DIC(19,312,"U")="ENTER/EDIT SPECIFIC DEVICE PM "
^DIC(19,313,0)="ENPM5^Enter/Edit Equipment Category PM Schedule^^R^.5^^^^^^^"
^DIC(19,313,1,0)="^^6^6^2900724^^"
^DIC(19,313,1,1,0)="Enter or change the PM schedule for a specified device type (such as"
^DIC(19,313,1,2,0)="DEFIBRILLATORS, GENERATORS-ELECTRICAL, etc.). A device type is formally"
^DIC(19,313,1,3,0)="defined as a discrete entry in the Equipment Category File. When a"
^DIC(19,313,1,4,0)="device type PM schedule is entered or changed, the user will be given the"
^DIC(19,313,1,5,0)="opportunity to apply the new schedule to all existing devices of the"
^DIC(19,313,1,6,0)="specified type."
^DIC(19,313,25)="DTE^ENEQPMP1"
^DIC(19,313,"U")="ENTER/EDIT EQUIPMENT CATEGORY "
^DIC(19,314,0)="ENPM6^Enter/Edit PM Procedure^^R^.5^^^^^^^"
^DIC(19,314,1,0)="^^5^5^2880513^"
^DIC(19,314,1,1,0)="Enter procedures to be followed in performing PMI's. The procedure"
^DIC(19,314,1,2,0)="identifier will be printed on PM worksheets as a reminder to the tech,"
^DIC(19,314,1,3,0)="and will become a part of the equipment history whenever a scheduled"
^DIC(19,314,1,4,0)="PMI is recorded. It is recommended that the full text of PM procedures"
^DIC(19,314,1,5,0)="be stored in this file if time and disk space permit."
^DIC(19,314,25)="PROCE^ENEQPMP2"
^DIC(19,314,"U")="ENTER/EDIT PM PROCEDURE"
