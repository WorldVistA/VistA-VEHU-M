^DIC(19,7819,"U")="DISPLAY UNAUTHORIZED CLAIM"
^DIC(19,7820,0)="FBUC PAYMENTS^Payments for Unauthorized Claims^^R^1^FBAA LEVEL 1 PMT^^^^^^"
^DIC(19,7820,1,0)="^19.06^2^2^3081002^^^^"
^DIC(19,7820,1,1,0)="This option should be used to enter payments for an unauthorized claim"
^DIC(19,7820,1,2,0)="which has been dispositioned to approved or approved to stabilization."
^DIC(19,7820,25)="FBUCPAY"
^DIC(19,7820,99)="55640,35436"
^DIC(19,7820,"U")="PAYMENTS FOR UNAUTHORIZED CLAI"
^DIC(19,7821,0)="FBCNH RATE CHANGE^Change Existing Contract Rate for a Patient^^R^1^FBAA LEVEL 1 AUTH^^^^^^^^1^1"
^DIC(19,7821,1,0)="^19.06^6^6^3091110^^^^"
^DIC(19,7821,1,1,0)="Selection of a patient and an authorization will allow the user to"
^DIC(19,7821,1,2,0)="see all rates associated with that authorization.  If they wish to change"
^DIC(19,7821,1,3,0)="the rate for this patient, they are prompted to enter an effective date"
^DIC(19,7821,1,4,0)="of the change and to choose a new rate.  If the rates are the same, the"
^DIC(19,7821,1,5,0)="change will not take effect.  The user will see the new rates for this"
^DIC(19,7821,1,6,0)="authorization upon completion of the change."
^DIC(19,7821,15)="K FBSSNRF"
^DIC(19,7821,20)="S FBSSNRF=1"
^DIC(19,7821,25)="FBNHRC"
^DIC(19,7821,99)="55797,36376"
^DIC(19,7821,"U")="CHANGE EXISTING CONTRACT RATE "
^DIC(19,7822,0)="FBUC ADD NEW PERSON^Add New Person for Unauthorized Claim^^R^1^FBAA LEVEL 1 AUTH^^^^^^"
^DIC(19,7822,1,0)="^^6^6^2930628^^"
^DIC(19,7822,1,1,0)="This option allows entry to the New Person file."
^DIC(19,7822,1,2,0)="  "
^DIC(19,7822,1,3,0)="If an Unauthorized Claim is submitted by an other party (ie not veteran or"
^DIC(19,7822,1,4,0)="not vendor), name and address of submitter needs to be entered into the"
^DIC(19,7822,1,5,0)="New Person file if it does not already exist.  This will allow correspondence"
^DIC(19,7822,1,6,0)=" and/or payments to efficiently reach the appropriate party."
^DIC(19,7822,25)="ADD^FBUCUTL3"
^DIC(19,7822,99)="55634,39955"
^DIC(19,7822,"U")="ADD NEW PERSON FOR UNAUTHORIZE"
^DIC(19,7823,0)="FBCNH ACTIVITY REPORT^Activity Report for CNH^^R^.5^^^^^^^344"
^DIC(19,7823,1,0)="^^3^3^2930504^"
^DIC(19,7823,1,1,0)="This option prompts the user for input of a date range.  The output"
^DIC(19,7823,1,2,0)="includes all activity (admissions transfers and discharges) that fall"
^DIC(19,7823,1,3,0)="within the date range."
^DIC(19,7823,25)="FBNHACT"
^DIC(19,7823,"U")="ACTIVITY REPORT FOR CNH"
^DIC(19,7824,0)="FBUC ASSOCIATE^Associate an Unauthorized Claim to a Primary^^R^1^FBAA LEVEL 1 AUTH^^^^^^"
^DIC(19,7824,1,0)="^^3^3^2930514^"
^DIC(19,7824,1,1,0)="This option should be used when you wish to associate unauthorized claims"
^DIC(19,7824,1,2,0)="to a primary claim.  The primary claim is the first claim which was entered"
^DIC(19,7824,1,3,0)="for a veteran and episode of care (same treatment from and to dates)."
^DIC(19,7824,25)="EDIT^FBUCLINK"
^DIC(19,7824,"U")="ASSOCIATE AN UNAUTHORIZED CLAI"
^DIC(19,7825,0)="FBUC UTILITIES^Utilities for Unauthorized Claims^^M^.5^^^^^^^"
^DIC(19,7825,1,0)="^^2^2^2930911^^"
^DIC(19,7825,1,1,0)="This menu option contains miscellaneous utility options related to"
^DIC(19,7825,1,2,0)="processing unauthorized claims."
^DIC(19,7825,10,0)="^19.01PI^7^7"
^DIC(19,7825,10,1,0)="5827^^1"
^DIC(19,7825,10,2,0)="7822^^2"
^DIC(19,7825,10,3,0)="7824^^3"
^DIC(19,7825,10,4,0)="7835^^5"
^DIC(19,7825,10,5,0)="7839^^4"
^DIC(19,7825,10,6,0)="7840^^6"
^DIC(19,7825,10,7,0)=12078
^DIC(19,7825,10,"B",5827,1)=""
^DIC(19,7825,10,"B",7822,2)=""
^DIC(19,7825,10,"B",7824,3)=""
^DIC(19,7825,10,"B",7835,4)=""
^DIC(19,7825,10,"B",7839,5)=""
^DIC(19,7825,10,"B",7840,6)=""
^DIC(19,7825,10,"B",12078,7)=""
^DIC(19,7825,99)="64239,43203"
^DIC(19,7825,"U")="UTILITIES FOR UNAUTHORIZED CLA"
^DIC(19,7826,0)="FBUC ABANDONED^Abandoned Unauthorized Claims Update^^R^.5^^^^^^^"
^DIC(19,7826,1,0)="^^8^8^2930702^^^"
^DIC(19,7826,1,1,0)="This option should be queued to run daily.  A device needs to be specified."
^DIC(19,7826,1,2,0)="It will search the unauthorized claims file for those claims that have the"
^DIC(19,7826,1,3,0)="status of INCOMPLETE UNAUTHORIZED CLAIM or APPEAL/ISSUED STATMENT OF CASE,"
^DIC(19,7826,1,4,0)="beginning with the prior date."
^DIC(19,7826,1,5,0)="   "
^DIC(19,7826,1,6,0)="If the expiration date for these claims is met, the claim will be"
^DIC(19,7826,1,7,0)="dispositioned to ABANDONED.  A printout of those claims which were updated"
^DIC(19,7826,1,8,0)="will print to the specified device."
^DIC(19,7826,25)="ABAND^FBUCEX"
^DIC(19,7826,99)="55686,57685"
^DIC(19,7826,200)="^^1D"
^DIC(19,7826,"U")="ABANDONED UNAUTHORIZED CLAIMS "
^DIC(19,7827,0)="FBUC EXPIRE OUTPUT^Expiration Display/Print^^R^.5^^^^^^^"
^DIC(19,7827,1,0)="^^2^2^2930528^"
^DIC(19,7827,1,1,0)="This option will display/print those unauthorized claims which will"
^DIC(19,7827,1,2,0)="expire within the selected time frame."
^DIC(19,7827,25)="EXPIRE^FBUCEX"
^DIC(19,7827,"U")="EXPIRATION DISPLAY/PRINT"
^DIC(19,7828,0)="FBUC ALL CLAIMS OUTPUT^All Claims by Vendor/Veteran/Other^^R^1^FBUC DISABLE 1^^^^^^^^"
^DIC(19,7828,1,0)="^19.06^15^15^3260326^^^^"
^DIC(19,7828,1,1,0)="This option allows the user to display/print all unauthorized claims for"
^DIC(19,7828,1,2,0)="a single vendor or veteran or other party."
^DIC(19,7828,1,3,0)="The output is sorted by episode of care, grouping claims which are associated"
^DIC(19,7828,1,4,0)="with one another.  Since the primary may not be the first to display, the"
^DIC(19,7828,1,5,0)="secondaries are flagged with an asterisk ('*'), which preceeds the name."
^DIC(19,7828,1,6,0)="If you select a vendor, the output will display veteran, otherwise it"
^DIC(19,7828,1,7,0)="will display vendor.  The Fee program, status and disposition codes are"
^DIC(19,7828,1,8,0)="also displayed."
^DIC(19,7828,1,9,0)="  "
^DIC(19,7828,1,10,0)="  (Note:  The disposition code will only display if the unauthorized claim"
^DIC(19,7828,1,11,0)="has a status of either DISPOSITIONED, APPEAL DISPOSITIONED or"
^DIC(19,7828,1,12,0)="BVA DISPOSITION.)"
^DIC(19,7828,1,13,0)="  The codes are:"
^DIC(19,7828,1,14,0)=" AP for Approved, AS for Approved to Stabilization, DA for Disapproved,"
^DIC(19,7828,1,15,0)="    CW for Canceled/Withdrawn,  AB for Abandoned"
^DIC(19,7828,20)=""
^DIC(19,7828,25)="ONE^FBUCOUT1"
^DIC(19,7828,"U")="ALL CLAIMS BY VENDOR/VETERAN/O"
^DIC(19,7829,0)="FBUC STATUS OUTPUT^Status Display/Print of Unauthorized Claims^^R^.5^^^^^^^"
^DIC(19,7829,1,0)="^^17^17^2930608^^^"
^DIC(19,7829,1,1,0)="This option displays/prints unauthorized claims by PSA and status."
^DIC(19,7829,1,2,0)="You have the option to sort by either vendor or veteran for the primary"
^DIC(19,7829,1,3,0)="sort.  The report will then sort by what you did not select.  You have"
^DIC(19,7829,1,4,0)="the option to group all veterans within a vendor or all vendors which"
^DIC(19,7829,1,5,0)="serviced a veteran.  The output also subtototals the number of claims"
^DIC(19,7829,1,6,0)="within a status, and displays the expiration date, if one exists.  If"
^DIC(19,7829,1,7,0)="the unauthorized claim is due to expire within thirty days of the date"
^DIC(19,7829,1,8,0)="the output was generated an asterisk ('*') will follow the expiration date."
^DIC(19,7829,1,9,0)="  "
^DIC(19,7829,1,10,0)="A disposition code will appear after those unauthorized claims having"
^DIC(19,7829,1,11,0)="a dispositioned status."
^DIC(19,7829,1,12,0)="  (Note:  The disposition code will only display if the unauthorized claim"
^DIC(19,7829,1,13,0)="has a status of either DISPOSITIONED, APPEAL DISPOSITIONED or"
^DIC(19,7829,1,14,0)="BVA DISPOSITION.)"
^DIC(19,7829,1,15,0)="  The codes are:"
^DIC(19,7829,1,16,0)=" AP for Approved, AS for Approved to Stabilization, DA for Disapproved,"
^DIC(19,7829,1,17,0)="    CW for Canceled/Withdrawn,  AB for Abandoned"
^DIC(19,7829,25)="ASK^FBUCOUT"
^DIC(19,7829,99)="55676,44625"
^DIC(19,7829,"U")="STATUS DISPLAY/PRINT OF UNAUTH"
^DIC(19,7830,0)="FBUC STATS OUTPUT^Disposition/Status Statistics Display/Print^^R^.5^^^^^^^"
^DIC(19,7830,1,0)="^^6^6^2930608^^"
^DIC(19,7830,1,1,0)="This option provides a statistical report on unauthorized claims within"
^DIC(19,7830,1,2,0)="a selected date range.   It provides totals of dispositioned unauthorized"
^DIC(19,7830,1,3,0)="claims by disposition type (approved,disapproved, etc.) as well as"
^DIC(19,7830,1,4,0)="disposition status.  The report also supplies the total of unauthorized"
^DIC(19,7830,1,5,0)="claims which have not been dispositioned, with a subtotal breakdown by"
^DIC(19,7830,1,6,0)="the claims status.  Total approved dollars by PSA are also provided."
^DIC(19,7830,25)="FBUCSTAT"
^DIC(19,7830,"U")="DISPOSITION/STATUS STATISTICS "
^DIC(19,7831,0)="FBCNH ADMISSIONS > 90 DAYS^CNH Stays in Excess of 90 Days^^R^1^^^^^^^^^1^1"
^DIC(19,7831,1,0)="5^19.06^5^5^3001128^^"
^DIC(19,7831,1,1,0)="This option will prompt the user for an effective date.  This date should"
^DIC(19,7831,1,2,0)="be representative of the day the user wishes to see all ACTIVE CNH stays"
^DIC(19,7831,1,3,0)="for a patient that meet or exceed 90 days.  The Length of Stay (LOS) will"
^DIC(19,7831,1,4,0)="be displayed for all records that meet the above criteria.  It should be"
^DIC(19,7831,1,5,0)="noted that the length of stay is as of the effective date only."
^DIC(19,7831,15)="K FBSSNRF"
^DIC(19,7831,20)="S FBSSNRF=1"
^DIC(19,7831,25)="FBNHAMI2"
^DIC(19,7831,"U")="CNH STAYS IN EXCESS OF 90 DAYS"
^DIC(19,7832,0)="FBCNH DELETE RATE^Delete CNH Rate^^R^1^FBAA LEVEL 2^^^^^^"
^DIC(19,7832,1,0)="^^7^7^2930614^"
^DIC(19,7832,1,1,0)="This option allows the deletion of a CNH Rate, only if the rate has not"
^DIC(19,7832,1,2,0)="been used by a patient yet (i.e. found in the Fee Basis CNH Authorization"
^DIC(19,7832,1,3,0)="Rate File 161.23).  The option prompts for the contract number, and will"
^DIC(19,7832,1,4,0)="display all valid rates for that contract.  The user may choose from the"
^DIC(19,7832,1,5,0)="rates displayed.  If successful, the rate will be deleted from the file."
^DIC(19,7832,1,6,0)="If the rate is found to be in use, a message will display to the user,"
^DIC(19,7832,1,7,0)="indicating that the rate may not be deleted."
^DIC(19,7832,25)="FBNHRDEL"
^DIC(19,7832,"U")="DELETE CNH RATE"
^DIC(19,7833,0)="FBUC REPRINT LETTER(S)^Reprint Letter(s)^^R^1^FBAA LEVEL 1 AUTH^^^^^^"
^DIC(19,7833,1,0)="^^9^9^2930628^^"
^DIC(19,7833,1,1,0)="This option allows you to reprint letters which were already printed,"
^DIC(19,7833,1,2,0)="provided that the current status of the unauthorized claim involves a "
^DIC(19,7833,1,3,0)="letter."
^DIC(19,7833,1,4,0)="  "
^DIC(19,7833,1,5,0)="You have the option to reprint for a date range (probably useful in the"
^DIC(19,7833,1,6,0)="event of a printer jam or malfunction when the original letters were"
^DIC(19,7833,1,7,0)="printed) or selective claims.  You also have the option to update the "
^DIC(19,7833,1,8,0)="expiration date.  (You would want to update the expiration date if the "
^DIC(19,7833,1,9,0)="original letters were never mailed, in the case of hardware problems.)"
^DIC(19,7833,25)="REPRINT^FBUCLET"
^DIC(19,7833,99)="55686,68126"
^DIC(19,7833,"U")="REPRINT LETTER(S)"
^DIC(19,7834,0)="FBCH UC COST REPORT^Unauthorized Claims Cost Report for Civil Hospital^^R^1^FBCH DISABLE 3^^^^^^^^1"
^DIC(19,7834,1,0)="^19.06^5^5^3260401^^^^"
^DIC(19,7834,1,1,0)="Output report to display the unauthorized claims payments for Civil Hospital"
^DIC(19,7834,1,2,0)="for a user date range selected.  Report does not list any payment which"
^DIC(19,7834,1,3,0)="does not have a date finalized.  Output includes both payments and"
^DIC(19,7834,1,4,0)="ancillary payments sorted by treating specialty.  Included in output is"
^DIC(19,7834,1,5,0)="the Patient ID, Date Claim Received, Amount Paid, Final DRG and LOS."
^DIC(19,7834,20)="S FBTP=6,FBREF=""FB583"""
^DIC(19,7834,25)="FBCHCR"
^DIC(19,7834,"U")="UNAUTHORIZED CLAIMS COST REPOR"
^DIC(19,7835,0)="FBUC DELETE UNAUTHORIZED CLAIM^Delete Unauthorized Claim^^R^.5^^^^^^^"
^DIC(19,7835,1,0)="^^6^6^2930702^"
^DIC(19,7835,1,1,0)="This options allows you to delete unauthorized claims which have not been"
^DIC(19,7835,1,2,0)="dispositioned.  Dispostioned claims should edited to a disposition status "
^DIC(19,7835,1,3,0)="of Canceled/Withdrawn."
^DIC(19,7835,1,4,0)="  "
^DIC(19,7835,1,5,0)="If an unauthorized claim is deleted, any pending information on file is"
^DIC(19,7835,1,6,0)="also deleted."
^DIC(19,7835,25)="DEL^FBUCED1"
^DIC(19,7835,99)="55734,55541"
^DIC(19,7835,"U")="DELETE UNAUTHORIZED CLAIM"
^DIC(19,7836,0)="FBAA BATCH DELETE^Batch Delete^^R^1^FBAA LEVEL 1 PMT^^^^^^"
^DIC(19,7836,1,0)="^19.06^8^8^3140714^^^"
^DIC(19,7836,1,1,0)="This option allows the user who opened a batch, or any user who holds"
^DIC(19,7836,1,2,0)="the 'FBAA LEVEL 2' security key, the ability to delete a batch from"
^DIC(19,7836,1,3,0)="the system.  The batch must meet the following criteria in order"
^DIC(19,7836,1,4,0)="to be deleted."
^DIC(19,7836,1,5,0)="    1. Total Dollars equal zero"
^DIC(19,7836,1,6,0)="    2. Invoice Count equal zero"
^DIC(19,7836,1,7,0)="    3. Payment Line Count equal zero"
^DIC(19,7836,1,8,0)="    4. Rejects Pending flag not set to yes"
^DIC(19,7836,25)="FBAABDL"
^DIC(19,7836,"U")="BATCH DELETE"
^DIC(19,7837,0)="FBAA FMS UPDATE^Update FMS Vendor File in Austin^^R^1^FBAA LEVEL 2^^^^^^"
^DIC(19,7837,1,0)="^19.06^13^13^3071001^^^^"
^DIC(19,7837,1,1,0)="This option creates a Master Record Adjustment (MRA) transaction which"
^DIC(19,7837,1,2,0)="results in the updating of selected vendor demographic data in the FMS"
^DIC(19,7837,1,3,0)="vendor file in Austin."
^DIC(19,7837,1,4,0)="  "
^DIC(19,7837,1,5,0)="This option should only be used if a vendor entry is correctly entered into"
^DIC(19,7837,1,6,0)="the DHCP Fee Basis Vendor file but needs to update the FMS vendor file"
^DIC(19,7837,1,7,0)="with the appropriate information."
^DIC(19,7837,1,8,0)=" (NOTE:  The vendor may not exist on the FMS system or may exist, but"
^DIC(19,7837,1,9,0)="         the information does not reflect accurate information.)"
^DIC(19,7837,1,10,0)="  "
^DIC(19,7837,1,11,0)="Use of this option should update the FMS vendor file to reflect what is"
^DIC(19,7837,1,12,0)="currently in the DHCP system.  Information at all other VA Medical Centers"
^DIC(19,7837,1,13,0)="using this vendor will also be updated."
^DIC(19,7837,25)="UPDATE^FBAAAV"
^DIC(19,7837,99)="55743,65034"
^DIC(19,7837,"U")="UPDATE FMS VENDOR FILE IN AUST"
^DIC(19,7838,0)="FBCNH UPDATE VENDOR CONTRACT^Update Vendor Contract/Rates - CNH^^R^1^FBAA LEVEL 2^^^^^^^^^1"
^DIC(19,7838,1,0)="^19.06^2^2^3090102^^^"
^DIC(19,7838,1,1,0)="This option allows the user to enter/edit Community Nursing Home"
^DIC(19,7838,1,2,0)="vendor contracts and rates."
^DIC(19,7838,15)="K FBCIEN,FBCNUM,FBEXDT,FBEXNDT,FBX"
^DIC(19,7838,25)="GETVEN^FBAAVD2"
^DIC(19,7838,99)="55797,39877"
^DIC(19,7838,"U")="UPDATE VENDOR CONTRACT/RATES -"
^DIC(19,7839,0)="FBUC DISASSOCIATE^Disassociate an Unauthorized Claim^^R^1^FBAA LEVEL 1 AUTH^^^^^^"
^DIC(19,7839,1,0)="^^2^2^2930911^"
^DIC(19,7839,1,1,0)="This option will allow you to disassociate an unauthorized claim which"
^DIC(19,7839,1,2,0)="has been associated to others."
^DIC(19,7839,25)="DISASSOC^FBUCLINK"
^DIC(19,7839,"U")="DISASSOCIATE AN UNAUTHORIZED C"
^DIC(19,7840,0)="FBUC RETURN ADDRESS DIS/ED^Return Address Display/Edit^^R^1^FBAA LEVEL 2^^^^^y^"
^DIC(19,7840,1,0)="^^3^3^2930911^"
^DIC(19,7840,1,1,0)="This option will display the return address which will appear on an"
^DIC(19,7840,1,2,0)="Unauthorized Claim letter, if letterhead is not used.  You can also edit"
^DIC(19,7840,1,3,0)="the return address using this option."
^DIC(19,7840,25)="RETURN^FBUCDIS"
^DIC(19,7840,"U")="RETURN ADDRESS DISPLAY/EDIT"
^DIC(19,7842,0)="FBCH CENSUS REPORT^Civil Hospital Census Report^^R^.5^^^^^^^^^1"
^DIC(19,7842,1,0)="^^4^4^2930915^"
^DIC(19,7842,1,1,0)="This output provides a listing for all Civil Hospital patients"
^DIC(19,7842,1,2,0)="for a user specified census date.  Output includes the vendor name and"
^DIC(19,7842,1,3,0)="Participation Code, veteran specifics such as DOB and ID, as well as"
^DIC(19,7842,1,4,0)="the Primary Service Area and the Authorization To Date."
^DIC(19,7842,20)="S FBI=6"
^DIC(19,7842,25)="FBCNHCEN"
^DIC(19,7842,"U")="CIVIL HOSPITAL CENSUS REPORT"
^DIC(19,7843,0)="FBAA MRA'S AWAITING APPROVAL^MRA'S Awaiting Austin Approval^^R^1^FBAA LEVEL 2^^^^^^"
^DIC(19,7843,1,0)="5^19.06^5^5^3080718^"
^DIC(19,7843,1,1,0)="This option will output the vendors that have an MRA action pending, and"
^DIC(19,7843,1,2,0)="therefore are still awaiting Austin approval.  The output lists the"
^DIC(19,7843,1,3,0)="vendor and the date the MRA was transmitted to Austin.  Records with"
^DIC(19,7843,1,4,0)="no date transmitted indicate an MRA has just been initiated, but the"
^DIC(19,7843,1,5,0)="transmission has not left the local station yet."
^DIC(19,7843,25)="FBAAPV"
^DIC(19,7843,"U")="MRA'S AWAITING AUSTIN APPROVAL"
^DIC(19,7844,0)="ONCO #SITE-CREATE ACOS DISK^Create ACOS Data Download^^R^1^^^^^^^150^^^"
^DIC(19,7844,1,0)="^^3^3^2970725^^^^"
^DIC(19,7844,1,1,0)="This option will allow for the creation of a disk to be submitted"
^DIC(19,7844,1,2,0)="to the American College of Surgeons (ACOS) in response to the "
^DIC(19,7844,1,3,0)="annual call for data.  FOR USE BY IRM ONLY."
^DIC(19,7844,10.1)="Non-Confidential ACOS Tape"
^DIC(19,7844,15)=""
^DIC(19,7844,20)=""
^DIC(19,7844,25)="EN1^ONCACD0(0,0)"
^DIC(19,7844,"U")="CREATE ACOS DATA DOWNLOAD"
^DIC(19,7845,0)="ONCO #SITE-RESTAGE PRIMARY^Recompute AJCC TNM Staging^^R^11595^^^^^^y^150^y"
^DIC(19,7845,1,0)="^^4^4^2950214^^^"
^DIC(19,7845,1,1,0)="This option will recompute TNM staging according to the appropriate"
^DIC(19,7845,1,2,0)="edition of the AJCC Manual on Staging of Cancer.  It will sweep the"
^DIC(19,7845,1,3,0)="entire primary file, or will work only on primaries diagnosed after"
^DIC(19,7845,1,4,0)="a certain year."
^DIC(19,7845,25)="STAGEM^ONCOU55A"
