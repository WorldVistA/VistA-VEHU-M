^DIC(19,9840,0)="YSCL WEEKLY TRANSMISSION^Weekly Clozapine Report^Replaced by YSCL DAILY TRANSMISSION^R^1^^^^^^^"
^DIC(19,9840,1,0)="^19.06^3^3^3160726^^"
^DIC(19,9840,1,1,0)="This option should be queued once to run every 7 days (on Tuesday morning"
^DIC(19,9840,1,2,0)="prior to the start of business) to transmit Clozapine dispensing data to"
^DIC(19,9840,1,3,0)="the Clozapine Roll-Up database located in Hines."
^DIC(19,9840,25)="YSCLTEST"
^DIC(19,9840,"U")="WEEKLY CLOZAPINE REPORT"
^DIC(19,9841,0)="YSCL RETRANSMIT DATA^Retransmit Clozapine Roll-up Data^^R^755^^^^^^^"
^DIC(19,9841,1,0)="^^7^7^2960611^"
^DIC(19,9841,1,1,0)="Use this option to retransmit data to the national clozapine data"
^DIC(19,9841,1,2,0)="base when the weekly transmission report fails.  This option will"
^DIC(19,9841,1,3,0)="ask for an ending date for data collection. Use the previous Tuesday"
^DIC(19,9841,1,4,0)="as the ending date."
^DIC(19,9841,1,5,0)=""
^DIC(19,9841,1,6,0)="Place this option on the secondary menu of the person responsible"
^DIC(19,9841,1,7,0)="for maintaining the Clozapine Roll-up software."
^DIC(19,9841,25)="REXMIT^YSCLTST2"
^DIC(19,9841,99.1)="59164,31868"
^DIC(19,9841,"U")="RETRANSMIT CLOZAPINE ROLL-UP D"
^DIC(19,9842,0)="YSCL TRANSMIT DEMOGRAPHICS^Transmit Clozapine Demographics^Replaced by YSCL DAILY TRANSMISSION.^R^1^^^^^^^"
^DIC(19,9842,1,0)="^^3^3^2981130^"
^DIC(19,9842,1,1,0)="This option should be queued to run on Tuesday morning prior to the start"
^DIC(19,9842,1,2,0)="of business to transmit Clozapine patient demographics to the Clozpaine"
^DIC(19,9842,1,3,0)="Roll-Up database located in Hines."
^DIC(19,9842,25)="YSCLTST3"
^DIC(19,9842,"U")="TRANSMIT CLOZAPINE DEMOGRAPHIC"
^DIC(19,9843,0)="YSCLSERVER^Clozapine Data Server^^S^11740^^^^^^^"
^DIC(19,9843,1,0)="^^3^3^3000317^^^^"
^DIC(19,9843,1,1,0)="This is a server to allow the National Clozapine Coordinating Center"
^DIC(19,9843,1,2,0)="(NCCC) in Dallas to authorize Clozapine registration numbers for use at"
^DIC(19,9843,1,3,0)="individual sites."
^DIC(19,9843,25)="YSCLSERV"
^DIC(19,9843,220)="^R^^^Y^N"
^DIC(19,9843,"U")="CLOZAPINE DATA SERVER"
^DIC(19,9844,0)="SDOQM CLINIC NEXT AVAIL REPORT^Clinic Next Available Appt. Monitoring Report^^A^11289^^^^^^^16^^1"
^DIC(19,9844,1,0)="^^2^2^2960729^^^^"
^DIC(19,9844,1,1,0)="Provides an appointment monitoring tool which reflects the data collected"
^DIC(19,9844,1,2,0)="for the access performance measure, plus additional information."
^DIC(19,9844,10.1)="Next Avail. Appt. Monitoring"
^DIC(19,9844,20)="D EN1^SDOQMP"
^DIC(19,9844,"U")="CLINIC NEXT AVAILABLE APPT. MO"
^DIC(19,9845,0)="SDOQM PM NIGHTLY JOB^Nightly job for PM data extract^This functionality is now accomplished by CDW/VSSC.^R^11289^^^^^^^16"
^DIC(19,9845,1,0)="^^6^6^2960815^"
^DIC(19,9845,1,1,0)="This option collects the next avaialable appointment data for"
^DIC(19,9845,1,2,0)="selected clincis and transmits the data to a central database.  This option"
^DIC(19,9845,1,3,0)="should be scheduled to run nightly.  Currently, the Performance Management"
^DIC(19,9845,1,4,0)="Office is requiring the colletion if this data for the month of September."
^DIC(19,9845,1,5,0)="The option will need to manually scheduled, and will unschedule itself after"
^DIC(19,9845,1,6,0)="the end of September."
^DIC(19,9845,25)="EN^SDOQMP"
^DIC(19,9845,200.9)="y"
^DIC(19,9845,"U")="NIGHTLY JOB FOR PM DATA EXTRAC"
^DIC(19,9846,0)="RA SIGN-ON MSG^RAD/NM SIGN-ON MSG^^A^11712^^^^^^^31^^1"
^DIC(19,9846,1,0)="^^10^10^2960830^"
^DIC(19,9846,1,1,0)="Inform the user if he/she has any imaging reports to pre-verify or verify."
^DIC(19,9846,1,2,0)="This option should be entered as an ""ITEM"" on the XU USER SIGN-ON option."
^DIC(19,9846,1,3,0)="When physicians classified as Rad/Nuc Med Residents or Staff within"
^DIC(19,9846,1,4,0)="the Radiology/Nuclear Medicine package sign on to the system, a routine"
^DIC(19,9846,1,5,0)="finds the total number of Radiology/Nuclear Medicine reports that are"
^DIC(19,9846,1,6,0)="waiting for this physician to review.  If the interpreting physician's"
^DIC(19,9846,1,7,0)="name is entered in one of the Resident fields of the exam record, the"
^DIC(19,9846,1,8,0)="message will state 'You have n reports to pre-verify'.  If the"
^DIC(19,9846,1,9,0)="interpreting physician's name is entered in one of the Staff fields of the"
^DIC(19,9846,1,10,0)="exam record, the message will state 'You have n reports to verify'."
^DIC(19,9846,20)="D SIGNON^RAUTL3"
^DIC(19,9846,"U")="RAD/NM SIGN-ON MSG"
