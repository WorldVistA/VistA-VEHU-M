^DIC(19,15192,99)="67411,49173"
^DIC(19,15192,"U")="ALERT MANAGEMENT"
^DIC(19,15193,0)="EHM-00014^Purge Alerts for a User^^R^1^^^^^^^^^^^"
^DIC(19,15193,1,0)="^^5^5^3240328^"
^DIC(19,15193,1,1,0)="This option is provided to permit users holding the correct key to delete"
^DIC(19,15193,1,2,0)="alerts for another user.  This is intended for when a user has been"
^DIC(19,15193,1,3,0)="inactive for a period of time (e.g., vacation, etc.) and has accumulated a"
^DIC(19,15193,1,4,0)="number of alerts which should not need processing."
^DIC(19,15193,1,5,0)="Cloned from ""XQALERT BY USER DELETE"" option."
^DIC(19,15193,3)=""
^DIC(19,15193,25)="USERDEL^XQALERT"
^DIC(19,15193,"U")="PURGE ALERTS FOR A USER"
^DIC(19,15194,0)="EHM-00015^Delete Old (>14 d) Alerts^^R^1^^^^^^^^^^^"
^DIC(19,15194,1,0)="^^5^5^3240328^^"
^DIC(19,15194,1,1,0)="This option is used to remove Alerts which remain in the User file after"
^DIC(19,15194,1,2,0)="a period of at least two weeks.  It is assummed that if a user has not"
^DIC(19,15194,1,3,0)="either seen or performed an action associated with an alert for this"
^DIC(19,15194,1,4,0)="period, that it can not be an urgent item for the user."
^DIC(19,15194,1,5,0)="Cloned from ""XQALERT DELETE OLD"" option."
^DIC(19,15194,3)=""
^DIC(19,15194,25)="OLDDEL^XQALERT"
^DIC(19,15194,"U")="DELETE OLD (>14 D) ALERTS"
^DIC(19,15195,0)="EHM-00016^Make an alert on the fly^^R^1^^^^^^^^^^^"
^DIC(19,15195,1,0)="^^3^3^3240328^"
^DIC(19,15195,1,1,0)="This option will allow the user to create an ALERT and send it to"
^DIC(19,15195,1,2,0)="users or mail groups on the fly."
^DIC(19,15195,1,3,0)="Cloned from ""XQALERT MAKE"" option."
^DIC(19,15195,3)=""
^DIC(19,15195,25)="XQALMAKE"
^DIC(19,15195,"U")="MAKE AN ALERT ON THE FLY"
^DIC(19,15196,0)="EHM-00017^Alerts - Set/Remove Surrogate for User^^R^1^^^^^^^163^^^^"
^DIC(19,15196,1,0)="^^10^10^3240328^"
^DIC(19,15196,1,1,0)="This option is provided so that IRM or ADPAC personnel can set or remove a"
^DIC(19,15196,1,2,0)="surrogate for receiving alerts for a user.  The option asks for a user to"
^DIC(19,15196,1,3,0)="be selected, then is ready to specify a new surrogate for the selected"
^DIC(19,15196,1,4,0)="user, or to remove the current surrogate for that user."
^DIC(19,15196,1,5,0)=" "
^DIC(19,15196,1,6,0)="This option is NOT needed by the individual users who may select to name"
^DIC(19,15196,1,7,0)="or remove a surrogate as one of the options while processing alerts (or if"
^DIC(19,15196,1,8,0)="no alerts are present for the user, as his only option on selecting alert"
^DIC(19,15196,1,9,0)="processing)."
^DIC(19,15196,1,10,0)="Cloned from ""XQALERT SURROGATE SET/REMOVE"" option."
^DIC(19,15196,3)=""
^DIC(19,15196,25)="OTHRSURO^XQALSURO"
^DIC(19,15196,"U")="ALERTS - SET/REMOVE SURROGATE "
^DIC(19,15197,0)="EHM-00018^Surrogate for which Users?^^R^1^^^^^^^163^^^^"
^DIC(19,15197,1,0)="^^3^3^3240328^"
^DIC(19,15197,1,1,0)="This option provides a view of which users have specified"
^DIC(19,15197,1,2,0)="a selected user as surrogates for themselves."
^DIC(19,15197,1,3,0)="Cloned from ""XQAL SURROGATE FOR WHICH USERS"" option."
^DIC(19,15197,3)=""
^DIC(19,15197,25)="GETFOR^XQALSURO"
^DIC(19,15197,"U")="SURROGATE FOR WHICH USERS?"
^DIC(19,15198,0)="EHM-00019^Set Backup Reviewer for Alerts^^R^1^^^^^^^163^^^^"
^DIC(19,15198,1,0)="^^9^9^3240328^"
^DIC(19,15198,1,1,0)="This option provides a mechanism for a user to set entries into the"
^DIC(19,15198,1,2,0)="Parameter file which will assign an individual as Backup Reviewer"
^DIC(19,15198,1,3,0)="for Alerts if there is a date specified for Days For Backup Reviewer"
^DIC(19,15198,1,4,0)="in the Alert.  If this is the case, an alert which remains unread"
^DIC(19,15198,1,5,0)="for the indicated number of days will be forwarded to the Backup"
^DIC(19,15198,1,6,0)="Reviewer found for the lowest level for the user in the Parameter"
^DIC(19,15198,1,7,0)="file starting with User, and progressing through OERR Team, Team,"
^DIC(19,15198,1,8,0)="Service, Division, up to System."
^DIC(19,15198,1,9,0)="Cloned from ""XQAL SET BACKUP REVIEWER"" option."
^DIC(19,15198,3)=""
^DIC(19,15198,25)="BKUPREVW^XQALDEL"
^DIC(19,15198,"U")="SET BACKUP REVIEWER FOR ALERTS"
^DIC(19,15199,0)="EHM-00020^Report Menu for Alerts^^M^1^^^^^^^163^^^^"
^DIC(19,15199,1,0)="^19.06^3^3^3240328^^^^"
^DIC(19,15199,1,1,0)="This menu provides several options for generating reports on alerts for "
^DIC(19,15199,1,2,0)="users or patients."
^DIC(19,15199,1,3,0)="Cloned from ""XQAL REPORTS MENU"" option."
^DIC(19,15199,3)=""
^DIC(19,15199,10,0)="^19.01IP^5^5"
^DIC(19,15199,10,1,0)=15200
^DIC(19,15199,10,2,0)=15201
^DIC(19,15199,10,3,0)=15202
^DIC(19,15199,10,4,0)=15203
^DIC(19,15199,10,5,0)=15204
^DIC(19,15199,10,"B",15200,1)=""
^DIC(19,15199,10,"B",15201,2)=""
^DIC(19,15199,10,"B",15202,3)=""
^DIC(19,15199,10,"B",15203,4)=""
^DIC(19,15199,10,"B",15204,5)=""
^DIC(19,15199,99)="67411,49173"
^DIC(19,15199,"U")="REPORT MENU FOR ALERTS"
^DIC(19,15200,0)="EHM-00021^User Alerts Count Report^^R^1^^^^^^^163^^^^"
^DIC(19,15200,1,0)="^^11^11^3240328^"
^DIC(19,15200,1,1,0)="This option is used to generate a report on users who have more than a "
^DIC(19,15200,1,2,0)="specified number of alerts in the ALERTS file (#8992).  The report covers "
^DIC(19,15200,1,3,0)="a specified range of dates, and can be sorted by user name, number of "
^DIC(19,15200,1,4,0)="alerts, or by service/section.  In addition, the report in each of these "
^DIC(19,15200,1,5,0)="formats may be generated by Divisions if desired."
^DIC(19,15200,1,6,0)=" "
^DIC(19,15200,1,7,0)="For each user who has the specified number of alerts or more, the report"
^DIC(19,15200,1,8,0)="includes the user name, the section/service for the user, the number of"
^DIC(19,15200,1,9,0)="alerts in the ALERTS file, the last sign-on date, the number of Critical "
^DIC(19,15200,1,10,0)="alerts or Abnormal Imaging alerts, and the date of the oldest alert."
^DIC(19,15200,1,11,0)="Cloned from ""XQAL USER ALERTS COUNT"" option."
^DIC(19,15200,3)=""
^DIC(19,15200,25)="EN1^XQARPRT1"
^DIC(19,15200,"U")="USER ALERTS COUNT REPORT"
^DIC(19,15201,0)="EHM-00022^Critical Alerts Count Report^^R^1^^^^^^^163^^^^"
^DIC(19,15201,1,0)="^^12^12^3240328^"
^DIC(19,15201,1,1,0)="This option is used to generate a report of users who have more than a "
^DIC(19,15201,1,2,0)="specified number of alerts containing the word 'critical' or the words "
^DIC(19,15201,1,3,0)="'abnormal imaging' between the specified start and end dates. The report"
^DIC(19,15201,1,4,0)="is presented in descending order for the number of critical/abnormal"
^DIC(19,15201,1,5,0)="imaging alerts present."
^DIC(19,15201,1,6,0)=" "
^DIC(19,15201,1,7,0)="For each user who has the specified number of critical/abnormal "
^DIC(19,15201,1,8,0)="imaging alerts or more, the report includes the user name, the"
^DIC(19,15201,1,9,0)="section/service for the user, the number of alerts in the ALERTS file, the"
^DIC(19,15201,1,10,0)="last sign-on date, the number of Critical alerts or Abnormal Imaging"
^DIC(19,15201,1,11,0)="alerts, and the date of the oldest alert."
^DIC(19,15201,1,12,0)="Cloned from ""XQAL CRITICAL ALERT COUNT"" option."
^DIC(19,15201,3)=""
^DIC(19,15201,25)="CRITICAL^XQARPRT1"
^DIC(19,15201,"U")="CRITICAL ALERTS COUNT REPORT"
^DIC(19,15202,0)="EHM-00023^List Alerts for a user from a specified date^^R^1^^^^^^^163^^^^"
^DIC(19,15202,1,0)="^^9^9^3240328^"
^DIC(19,15202,1,1,0)="This option is used to obtain an interactive list of alerts from the "
^DIC(19,15202,1,2,0)="ALERT TRACKING file (#8992.1) for a specified user starting from a "
^DIC(19,15202,1,3,0)="specified date."
^DIC(19,15202,1,4,0)=" "
^DIC(19,15202,1,5,0)="The listing includes the internal entry number for the alert in the ALERT "
^DIC(19,15202,1,6,0)="TRACKING file, the date and time the alert was generated, the message "
^DIC(19,15202,1,7,0)="text of the alert, and information about any option or routine to be "
^DIC(19,15202,1,8,0)="executed for processing the alert."
^DIC(19,15202,1,9,0)="Cloned from ""XQAL ALERT LIST FROM DATE"" option."
^DIC(19,15202,3)=""
^DIC(19,15202,25)="EN^XQARPRT2"
^DIC(19,15202,"U")="LIST ALERTS FOR A USER FROM A "
^DIC(19,15203,0)="EHM-00024^Patient Alert List for specified date^^R^1^^^^^^^163^^^^"
^DIC(19,15203,1,0)="^^13^13^3240328^"
^DIC(19,15203,1,1,0)="This option is used to obtain a list of alerts for a specified patient "
^DIC(19,15203,1,2,0)="from the ALERT TRACKING file (#8992.1) for a selected date."
^DIC(19,15203,1,3,0)=" "
^DIC(19,15203,1,4,0)="A prompt is provided to obtain a quick scan listing of dates with at least"
^DIC(19,15203,1,5,0)="some alerts for the patient on it based on OR and DVB alerts (other"
^DIC(19,15203,1,6,0)="patient related alerts need to be identified by looking at each alert's"
^DIC(19,15203,1,7,0)="message text and are included in the full list, but not the quick scan)."
^DIC(19,15203,1,8,0)=" "
^DIC(19,15203,1,9,0)="The listing includes the internal entry number for the alert in the ALERT"
^DIC(19,15203,1,10,0)="TRACKING file, the date and time the alert was generated, the message"
^DIC(19,15203,1,11,0)="text of the alert, and information about any option or routine to be"
^DIC(19,15203,1,12,0)="executed for processing the alert."
^DIC(19,15203,1,13,0)="Cloned from ""XQAL PATIENT ALERT LIST"" option."
^DIC(19,15203,3)=""
^DIC(19,15203,25)="DTPT^XQARPRT2"
^DIC(19,15203,"U")="PATIENT ALERT LIST FOR SPECIFI"
^DIC(19,15204,0)="EHM-00025^View data for Alert Tracking file entry^^R^1^^^^^^^163^^^^"
^DIC(19,15204,1,0)="^^4^4^3240328^"
^DIC(19,15204,1,1,0)="This option can be used to view data for one or more entries in the Alert "
^DIC(19,15204,1,2,0)="Tracking file (#8992.1) in captioned format. The internal entry numbers"
^DIC(19,15204,1,3,0)="for the entries to be displayed must be entered individually."
^DIC(19,15204,1,4,0)="Cloned from ""XQAL VIEW ALERT TRACKING ENTRY"" option."
^DIC(19,15204,3)=""
^DIC(19,15204,25)="VIEWTRAK^XQARPRT2"
^DIC(19,15204,"U")="VIEW DATA FOR ALERT TRACKING F"
^DIC(19,15205,0)="EHM-00026^Consult Management^^M^1^^^^^^^294^^^^"
