^DIC(19,1560,0)="RA REG^Register Patient for Exams^^R^11712^^^^^^^^^1^1"
^DIC(19,1560,1,0)="^^7^7^2940606^^"
^DIC(19,1560,1,1,0)="This function allows the user to register a patient for one or"
^DIC(19,1560,1,2,0)="more procedures."
^DIC(19,1560,1,3,0)=" "
^DIC(19,1560,1,4,0)="When Radiology/Nuclear Med Order Entry is utilized, the user may select"
^DIC(19,1560,1,5,0)="the requested exam to be registered. Only requested exams in the 'HOLD',"
^DIC(19,1560,1,6,0)="'PENDING', or 'SCHEDULED' statuses are valid choices. If a request is not"
^DIC(19,1560,1,7,0)="available, the user will be prompted to request an exam."
^DIC(19,1560,15)="K RAOPT(""REG"")"
^DIC(19,1560,20)="S RAOPT(""REG"")="""""
^DIC(19,1560,25)="RAREG"
^DIC(19,1560,33)=""
^DIC(19,1560,99)="56337,55241"
^DIC(19,1560,99.1)="56981,36773"
^DIC(19,1560,"U")="REGISTER PATIENT FOR EXAMS"
^DIC(19,1561,0)="RA EDITPT^Edit Exam by Patient^^R^11712^^^^^^^^^1^1"
^DIC(19,1561,1,0)="^^17^17^2960411^"
^DIC(19,1561,1,1,0)="This function can be used to edit exams for patients by patient name.  The"
^DIC(19,1561,1,2,0)="fields edited are the same as in the 'Case No. Exam Edit' function,"
^DIC(19,1561,1,3,0)="however, this function allows selection of a patient, displays open cases"
^DIC(19,1561,1,4,0)="for the patient, then asks you to select one of the patient's registered"
^DIC(19,1561,1,5,0)="exams to edit.  This function should be used to re-edit fields that have"
^DIC(19,1561,1,6,0)="already been entered, but need correction.  Only fields with previously"
^DIC(19,1561,1,7,0)="entered data will appear for re-edit. The Status Tracking functions should"
^DIC(19,1561,1,8,0)="be used to enter case data and insure that exams progress to a 'Complete'"
^DIC(19,1561,1,9,0)="status."
^DIC(19,1561,1,10,0)=" "
^DIC(19,1561,1,11,0)="The user can use this function to edit an exam that has been"
^DIC(19,1561,1,12,0)="completed, however, the user must have the 'manager' key to edit"
^DIC(19,1561,1,13,0)="a 'completed' exam."
^DIC(19,1561,1,14,0)=" "
^DIC(19,1561,1,15,0)="Once an exam is edited and in the 'COMPLETE' status, the associated"
^DIC(19,1561,1,16,0)="request will display a message as follows: ""** Note: Request has been"
^DIC(19,1561,1,17,0)="changed by Radiology/Nuclear Medicine**""."
^DIC(19,1561,15)="K RAOPT(""EDITPT"")"
^DIC(19,1561,20)="S RAOPT(""EDITPT"")="""""
^DIC(19,1561,25)="RAEDPT"
^DIC(19,1561,"U")="EDIT EXAM BY PATIENT"
