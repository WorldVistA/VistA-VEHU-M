^DIC(19,8456,"U")="SUPERVISOR WORKLOAD MENU"
^DIC(19,8457,0)="LRCAPF^Etiology WKLD Codes (Force)^^R^.5^LRSUPER^^^^^^26"
^DIC(19,8457,1,0)="^^6^6^2940509^^^^"
^DIC(19,8457,1,1,0)=" This option is used to automatically add WKLD codes into the"
^DIC(19,8457,1,2,0)="Etiology File (#61.2). A sort template must be created using the"
^DIC(19,8457,1,3,0)="standard Fileman option. This option will utilize the selected"
^DIC(19,8457,1,4,0)="template and then add WKLD codes."
^DIC(19,8457,1,5,0)=" This feature can be used to speed up implementation of WLDK module."
^DIC(19,8457,1,6,0)="It also can be used to change existing/added WKLD codes."
^DIC(19,8457,25)="LRCAPF"
^DIC(19,8457,"U")="ETIOLOGY WKLD CODES (FORCE)"
^DIC(19,8458,0)="LRUV^Edit referral patient file^^R^.5^LRAPSUPER^^^^^^26"
^DIC(19,8458,1,0)="^^1^1^2930709^"
^DIC(19,8458,1,1,0)="  Edit referral patient file fields."
^DIC(19,8458,25)="LRUV"
^DIC(19,8458,"U")="EDIT REFERRAL PATIENT FILE"
^DIC(19,8459,0)="LR ROLLOVER^Rollover Accession (Manual)^^R^.5^^^^^^^26^^1^^^"
^DIC(19,8459,1,0)="^^11^11^2940331^^^^"
^DIC(19,8459,1,1,0)=" This option should be used if the task option LRTASK ROLLOVER does"
^DIC(19,8459,1,2,0)="not run for some reason. This option should not be the normal method"
^DIC(19,8459,1,3,0)="for transferring incomplete accession from the previous day to the"
^DIC(19,8459,1,4,0)="present day's accession file."
^DIC(19,8459,1,5,0)="  If if becomes necessary to use this option, there has probably been"
^DIC(19,8459,1,6,0)="a problem with TASK MANAGER. IRM Service should be notified if this "
^DIC(19,8459,1,7,0)="option is required to move accession onto day's list."
^DIC(19,8459,1,8,0)=" "
^DIC(19,8459,1,9,0)=" NOTE: This option can be ran multiple times with out harm. It checks"
^DIC(19,8459,1,10,0)="to see if the DATE ROLLOVER LAST RUN field is set correctly before "
^DIC(19,8459,1,11,0)="actually preforming the rollover function."
^DIC(19,8459,15)=""
^DIC(19,8459,20)="W !!,""NOTIFY IRM SERVICE OF A POTENTIAL TASK MAN PROBLEM"",!!,$C(7)"
^DIC(19,8459,25)="LROLOVER"
^DIC(19,8459,26)=""
^DIC(19,8459,"U")="ROLLOVER ACCESSION (MANUAL)"
^DIC(19,8460,0)="LRBLSRQ^Edit Blood Component Request File^out-of-order^R^10958^^^^^^^"
^DIC(19,8460,1,0)="^^1^1^2960614^^^^"
^DIC(19,8460,1,1,0)="Edit requests for blood components"
^DIC(19,8460,25)="CR^LRBLS"
^DIC(19,8460,"U")="EDIT BLOOD COMPONENT REQUEST F"
^DIC(19,8461,0)="LR WKLD LMIP 5^PHASE 5: Purge monthly WKLD data from 67.9.^^R^.5^LRLIASON^^^^^^26"
^DIC(19,8461,1,0)="^^7^7^2930724^"
^DIC(19,8461,1,1,0)=" This option is used to purge LMIP data from the LAB MONTHLY WORKLOADS"
^DIC(19,8461,1,2,0)="file after data has been sent to the national database. It can also be"
^DIC(19,8461,1,3,0)="used to purge data which is incorrect before building Workload Mail"
^DIC(19,8461,1,4,0)="messages."
^DIC(19,8461,1,5,0)="  Care should be taken that data is not deleted prematurely. If the"
^DIC(19,8461,1,6,0)="site elects to archive this file, this should be done before this option"
^DIC(19,8461,1,7,0)="is used to delete data."
^DIC(19,8461,25)="LRCAP67"
^DIC(19,8461,"U")="PHASE 5: PURGE MONTHLY WKLD DA"
^DIC(19,8464,0)="LRAUMLK^Autopsy Slide Labels (generic)^^R^.5^^^^^^^26"
^DIC(19,8464,1,0)="^^3^3^2930804^"
^DIC(19,8464,1,1,0)="Allows a user to print slide labels for an autopsy EVEN IF no"
^DIC(19,8464,1,2,0)="generic labels have been entered AND no data has been entered through the"
^DIC(19,8464,1,3,0)="[LRSPDAT] option for specific blocks."
^DIC(19,8464,25)="LRAUMLK"
^DIC(19,8464,"U")="AUTOPSY SLIDE LABELS (GENERIC)"
^DIC(19,8466,0)="LR WKLD LMIP 1 REPEAT^Recompile Phase 1 LMIP Data.^^R^.5^LRSUPER^^^^^^26^^1"
^DIC(19,8466,1,0)="^^16^16^2940331^^^^"
^DIC(19,8466,1,1,0)="Allows the user to rerun Phase 1 of LMIP data collection."
^DIC(19,8466,1,2,0)="If for some reason, it becomes necessary to recompile the LMIP report"
^DIC(19,8466,1,3,0)="this option will delete the data in ^LRO(67.9 for the selected"
^DIC(19,8466,1,4,0)="reporting period (Month) and then reset the pointers in ^LRO(64.1"
^DIC(19,8466,1,5,0)="to allow the date to be recompiled again."
^DIC(19,8466,1,6,0)=" "
^DIC(19,8466,1,7,0)="PHASE 1 LMIP MUST BE RE-RUN AFTER THIS OPTION IS USED."
^DIC(19,8466,1,8,0)=" "
^DIC(19,8466,1,9,0)="NOTE:  THIS OPTION SHOULD NOT BE USED AFTER DATA HAS BEEN SUBMITTED TO THE"
^DIC(19,8466,1,10,0)="NATIONAL DATA CENTER."
^DIC(19,8466,1,11,0)=" "
^DIC(19,8466,1,12,0)="THIS OPTION SHOULD BE USED AFTER LMIP DATA HAS BEEN REVIEWED AND ERRORS"
^DIC(19,8466,1,13,0)="OR DISCREPANCIES ARE NOTED."
^DIC(19,8466,1,14,0)=" "
^DIC(19,8466,1,15,0)="THIS OPTION MAY USE LARGE AMOUNTS OF JOURNAL SPACE. COORDINATE"
^DIC(19,8466,1,16,0)="WITH IRM BEFORE USING."
^DIC(19,8466,20)="W !!?10,""CHECK WITH IRM CONCERNING AVAILABLE JOURNAL SPACE"",!!"
^DIC(19,8466,25)="LRCAPAMP"
^DIC(19,8466,"U")="RECOMPILE PHASE 1 LMIP DATA."
^DIC(19,8467,0)="LRBLVAL^Blood bank validation documentation^out-of-order^R^.5^LRBLSUPER^^^^^^"
^DIC(19,8467,1,0)="^^1^1^2931012^"
^DIC(19,8467,1,1,0)="Documents validation testing of blood bank options."
^DIC(19,8467,25)="LRBLVAL"
