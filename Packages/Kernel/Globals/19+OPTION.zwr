^DIC(19,11611,0)="OR TERMINATE CLEANUP^User Terminate Cleanup^^A^11740^^^^^^^170^y^1"
^DIC(19,11611,1,0)="^^4^4^2990929^^^"
^DIC(19,11611,1,1,0)="This option runs KUSER^ORLPTU, which removes pointers to terminated"
^DIC(19,11611,1,2,0)="users from file(s) listed in the text section at the end of the routine."
^DIC(19,11611,1,3,0)="It relies on Kernel's XU USER TERMINATE option to set the variable XUIFN"
^DIC(19,11611,1,4,0)="in order to identify the terminated user."
