^DIC(19,14266,0)="OR EPCS PROVIDER CONFIG CHECK^Check Provider ePCS Configuration^^R^1^^^^^^^170"
^DIC(19,14266,1,0)="^19.06^3^3^3130214^^"
^DIC(19,14266,1,1,0)="This option will prompt the user to select a person from the NEW PERSON "
^DIC(19,14266,1,2,0)="FILE (#200) and will detail whether that user can or cannot sign "
^DIC(19,14266,1,3,0)="controlled substance orders."
^DIC(19,14266,25)="PRVCHK^ORDEA01"
^DIC(19,14266,"U")="CHECK PROVIDER EPCS CONFIGURAT"
^DIC(19,14267,0)="OR EPCS VALIDATION REPORTS^ePCS Data Validation Reports^^R^1^^^^^^^170"
^DIC(19,14267,1,0)="^^2^2^3130214^"
^DIC(19,14267,1,1,0)="Allows the user to run a number of reports that will be used to validate "
^DIC(19,14267,1,2,0)="data necessary to ensure proper setup of the ePCS functionality."
^DIC(19,14267,25)="REPORTS^ORDEA01"
^DIC(19,14267,"U")="EPCS DATA VALIDATION REPORTS"
^DIC(19,14268,0)="PSD CS PRESCRIPTIONS REPORT^Controlled Substance Prescriptions Report^^R^1^^^^^^^276^^1^1"
^DIC(19,14268,1,0)="^19.06^6^6^3110815^^^^"
^DIC(19,14268,1,1,0)="This option will provide a report of digitally signed orders that have been "
^DIC(19,14268,1,2,0)="filled for Schedules I-V controlled substances. The report will be for a date "
^DIC(19,14268,1,3,0)="range with the option of including discontinued and/or expired orders and "
^DIC(19,14268,1,4,0)="various sort criteria, list by patient, by provider, by drug and by schedule, "
^DIC(19,14268,1,5,0)="etc. It will be an 80-column report and will be queued to a printer."
^DIC(19,14268,1,6,0)=""
^DIC(19,14268,15)="K PSDCSRX"
^DIC(19,14268,20)="S PSDCSRX=1"
^DIC(19,14268,25)="PSDDSOR"
^DIC(19,14268,"U")="CONTROLLED SUBSTANCE PRESCRIPT"
^DIC(19,14269,0)="PSD DEA SUBOXONE^DEA DATA - Waived Practitioner Report^PLACED OUT OF ORDER BY PSD*3*94^R^1^^^^^^^276"
^DIC(19,14269,1,0)="^19.06^5^5^3120110^^"
^DIC(19,14269,1,1,0)="This report provides a list of patients that were prescribed suboxone"
^DIC(19,14269,1,2,0)="drugs. Two views are available, one with details, and another with just the "
^DIC(19,14269,1,3,0)="counts of suboxone patients per prescriber. "
^DIC(19,14269,1,4,0)=""
^DIC(19,14269,1,5,0)=""
^DIC(19,14269,25)="PSDSUBOX"
^DIC(19,14269,"U")="DEA DATA - WAIVED PRACTITIONER"
^DIC(19,14270,0)="GMPL NTRT F/U RPT^Problem List NTRT Follow-up Report^^A^1^^^^^^^402^^1"
^DIC(19,14270,1,0)="^^5^5^3120510^"
^DIC(19,14270,1,1,0)="This report allows sites to evaluate problems with valid SNOMED CT Concept"
^DIC(19,14270,1,2,0)="codes, which were unmapped to ICD at the time of entry."
^DIC(19,14270,1,3,0)=" "
^DIC(19,14270,1,4,0)="The report may be filtered by Medical Center Division, Provider(s), and "
^DIC(19,14270,1,5,0)="Time Interval."
^DIC(19,14270,20)="D MAIN^GMPLNTRT"
^DIC(19,14270,"U")="PROBLEM LIST NTRT FOLLOW-UP RE"
^DIC(19,14271,0)="GMPL FREETEXT F/U REPORT^Problem List Freetext Follow-up Report^^A^1^^^^^^^402^^1"
^DIC(19,14271,1,0)="^^2^2^3120510^"
^DIC(19,14271,1,1,0)="This report allows sites to evaluate uncoded freetext problems that have"
^DIC(19,14271,1,2,0)="been entered by one or more providers over a specified time interval."
^DIC(19,14271,20)="D MAIN^GMPLNTFT"
^DIC(19,14271,"U")="PROBLEM LIST FREETEXT FOLLOW-U"
^DIC(19,14272,0)="OR EPCS CS RX BY PROVIDER^ePCS Controlled Subs by Provider^^R^1^^^^^^^170"
^DIC(19,14272,1,0)="^^3^3^3121209^"
^DIC(19,14272,1,1,0)="This is the option to be scheduled in TaskMan to run the monthly report "
^DIC(19,14272,1,2,0)="for controlled substances prescriptions issues by a provider. This report "
^DIC(19,14272,1,3,0)="is required by the Drug Enforcement Agency to be delivered once a month."
^DIC(19,14272,25)="EN^ORDEA02"
^DIC(19,14272,"U")="EPCS CONTROLLED SUBS BY PROVID"
^DIC(19,14273,0)="ECXDELEF^Delete Extract Files^^R^1^ECXMGR^^^^^^513"
^DIC(19,14273,1,0)="^^17^17^3130806^"
^DIC(19,14273,1,1,0)="This option deletes individual or a range of DSS extracts."
^DIC(19,14273,1,2,0)=" "
^DIC(19,14273,1,3,0)="Care must be taken for several reasons:"
^DIC(19,14273,1,4,0)=" "
^DIC(19,14273,1,5,0)="-  You can delete ANY existing extract.  This includes transmitted and"
^DIC(19,14273,1,6,0)="   non- transmitted extracts as well as extracts that did not run to"
^DIC(19,14273,1,7,0)="   completion due to errors or system problems."
^DIC(19,14273,1,8,0)="-  Choosing a range of extracts could mean an excessively large number of"
^DIC(19,14273,1,9,0)="   records and be very CPU intensive.  Please be sure to queue this delete"
^DIC(19,14273,1,10,0)="   for off-hours and limit the number of extracts to be deleted per a"
^DIC(19,14273,1,11,0)="   single queued session."
^DIC(19,14273,1,12,0)=" "
^DIC(19,14273,1,13,0)="DELETE RECOMMENDATIONS:"
^DIC(19,14273,1,14,0)="Deletion of any local DHCP extracts or DHCP ""source of extracts"" (i.e., "
^DIC(19,14273,1,15,0)="lab  data, etc.) is not recommended until your facility has successfully"
^DIC(19,14273,1,16,0)="created  extracts, transmitted to the Austin Automation Center, audited"
^DIC(19,14273,1,17,0)="the  counts, loaded the data into DSS AND ARE CONTENT WITH THE RESULTS."
^DIC(19,14273,25)="ENDEL^ECXPURG"
^DIC(19,14273,"U")="DELETE EXTRACT FILES"
^DIC(19,14274,0)="ECX PHA COST^Pharmacy Pre-Extract Unusual Cost Reports^^R^1^^^^^^^513"
^DIC(19,14274,25)="COST^ECXAPHA"
^DIC(19,14274,"U")="PHARMACY PRE-EXTRACT UNUSUAL C"
^DIC(19,14275,0)="LRJ SYS MAP HL TASKMAN RPT^LRJ SYS MAP HL Change Management TaskMan Report^^R^1^^^^^^^26^^1"
^DIC(19,14275,1,0)="^19.06^3^3^3110725^^"
^DIC(19,14275,1,1,0)="This option is scheduled and run from VA TaskManager.  It generates"
^DIC(19,14275,1,2,0)="a report of changes to the Hospital Locations, Ward Locations, and"
^DIC(19,14275,1,3,0)="Room-Bed entries since the task last ran."
^DIC(19,14275,20)="D TSKMMARY^LRJSML2(""^TMP($J,""""LRJ SYS"""")"",""^TMP($J,""""LRDATA"""")"")"
^DIC(19,14275,99)="61325,51255"
^DIC(19,14275,200.9)="y"
^DIC(19,14275,"U")="LRJ SYS MAP HL CHANGE MANAGEME"
^DIC(19,14276,0)="LRJ BACKGROUND F60 AUDIT^TaskMan File 60 Audit in Display Format^^R^1^^^^^^^26^^1"
^DIC(19,14276,1,0)="^19.06^2^2^3091125^^^^"
