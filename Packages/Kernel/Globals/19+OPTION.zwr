^DIC(19,10409,"U")="PERSONAL PREFERENCES"
^DIC(19,10410,0)="TIU DISCHARGE SUMMARY CONVERT^Run/Restart DS Conversion (*** BE CERTAIN ***)^^A^11597^^^^^^^516^^1"
^DIC(19,10410,1,0)="^^7^7^2971121^^^"
^DIC(19,10410,1,1,0)="This option is used to invoke the process which converts Discharge"
^DIC(19,10410,1,2,0)="Summaries from the Discharge Summary version 1 database and format to that"
^DIC(19,10410,1,3,0)="supported by TIU."
^DIC(19,10410,1,4,0)=" "
^DIC(19,10410,1,5,0)="CAUTION:  BE CERTAIN YOU ARE READY TO IMPLEMENT DISCHARGE SUMMARIES UNDER"
^DIC(19,10410,1,6,0)="          TIU BEFORE INVOKING THIS OPTION...ALTHOUGH REVERSAL IS POSSIBLE,"
^DIC(19,10410,1,7,0)="          IT MAY PROVE TO BE QUITE COMPLICATED."
