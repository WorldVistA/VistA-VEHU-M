^DIC(19,11607,0)="RG EXCEPTION PURGE^MPI/PD Exception Purge ^^R^1^^^^^^^525"
^DIC(19,11607,1,0)="^^9^9^3070522^"
^DIC(19,11607,1,1,0)="The MPI/PD Exception Purge [RG EXCEPTION PURGE] option purges entries "
^DIC(19,11607,1,2,0)="from the CIRN HL7 EXCEPTION LOG (#991.1) file.  Entries that are purged "
^DIC(19,11607,1,3,0)="include duplicate entries, resolved entries over 30 days old, and entries "
^DIC(19,11607,1,4,0)="for patients were the name field is null or the patient has been merge "
^DIC(19,11607,1,5,0)="(i.e., has a -9 node.)  Additionally, only the most recent Primary View "
^DIC(19,11607,1,6,0)="Reject exception for a given patient/date is retained."
^DIC(19,11607,1,7,0)="  "
^DIC(19,11607,1,8,0)="This option should be scheduled to run via Taskman once an hour.  (This "
^DIC(19,11607,1,9,0)="recommendation was added in patch RG*1*48.)"
^DIC(19,11607,25)="MAIN^RGEVPRG"
^DIC(19,11607,"U")="MPI/PD EXCEPTION PURGE "
