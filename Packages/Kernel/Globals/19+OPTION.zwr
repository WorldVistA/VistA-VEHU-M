^DIC(19,13268,0)="RMPR FILE CLEANSING^RMPR file cleansing for field lengths^^R^10000000020^^^^^^^249^^"
^DIC(19,13268,1,0)="^19.06^7^7^3060119^^^^"
^DIC(19,13268,1,1,0)="This option was created temporarily to be used by sites that"
^DIC(19,13268,1,2,0)="enter fields in the GUI Purchasing module that exceeded the defined"
^DIC(19,13268,1,3,0)="length in the VISTA data dictionary for Fileman.  This option runs"
^DIC(19,13268,1,4,0)="through file #664 to determine what fields, if any, exceed the"
^DIC(19,13268,1,5,0)="maximum allowable lengths in files #664 and #660.  Any field length"
^DIC(19,13268,1,6,0)="discrepancies are displayed and the user is asked to enter a valid"
^DIC(19,13268,1,7,0)="length response in lieu of the found incorrect data."
^DIC(19,13268,10.1)="CLEANSE FILES 664/661"
