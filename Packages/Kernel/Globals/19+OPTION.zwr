^DIC(19,16348,99)="67411,49177"
^DIC(19,16348,"U")="DIALOG PARAMETERS"
^DIC(19,16349,0)="EHM-01170^Reminder Resolution Statuses^^R^1^^^^^^^534^^^^"
^DIC(19,16349,1,0)="^^2^2^3240328^^"
^DIC(19,16349,1,1,0)="This option lists the hierarchy of resolution status values used by CPRS."
^DIC(19,16349,1,2,0)="Cloned from ""PXRM RESOLUTION EDIT/INQUIRE"" option."
^DIC(19,16349,3)=""
^DIC(19,16349,25)="PXRMRESN"
^DIC(19,16349,"U")="REMINDER RESOLUTION STATUSES"
^DIC(19,16350,0)="EHM-01171^General Finding Type Parameters^^R^1^^^^^^^534^^^^"
^DIC(19,16350,1,0)="^^15^15^3240328^"
^DIC(19,16350,1,1,0)="This option allows display of the finding type parameters file used in"
^DIC(19,16350,1,2,0)="generating reminder dialogs. There is limited edit on this file to allow"
^DIC(19,16350,1,3,0)="customization of prefix and suffix text. Parameters may also be disabled"
^DIC(19,16350,1,4,0)="if not required at your site."
^DIC(19,16350,1,5,0)=" "
^DIC(19,16350,1,6,0)="The file is structured by finding type and within that resolution status."
^DIC(19,16350,1,7,0)="Reminder dialog generated will include a question (dialog element) for"
^DIC(19,16350,1,8,0)="each resolution type enabled in the finding type parameter file. The"
^DIC(19,16350,1,9,0)="question text is constructed as prefix_finding item name_suffix."
^DIC(19,16350,1,10,0)=" "
^DIC(19,16350,1,11,0)="Health factors are treated slightly differently. Health factors are linked"
^DIC(19,16350,1,12,0)="to resolution statuses by the PXRM HEALTH FACTOR RESOLUTIONS option. For"
^DIC(19,16350,1,13,0)="reminders with health factors questions are only generated if there is a"
^DIC(19,16350,1,14,0)="resolution mapping AND an enabled finding type parameter."
^DIC(19,16350,1,15,0)="Cloned from ""PXRM FINDING TYPE PARAMETERS"" option."
^DIC(19,16350,3)=""
^DIC(19,16350,25)="PXRMFIND"
^DIC(19,16350,"U")="GENERAL FINDING TYPE PARAMETER"
^DIC(19,16351,0)="EHM-01172^Finding Item Parameters^^R^1^^^^^^^534^^^^"
^DIC(19,16351,1,0)="^^9^9^3240328^^"
^DIC(19,16351,1,1,0)="If a reminder finding item will always be resolved by the same question"
^DIC(19,16351,1,2,0)="(dialog element) or set of questions (dialog group) then an entry should"
^DIC(19,16351,1,3,0)="be made in the finding item parameter file linking the reminder finding"
^DIC(19,16351,1,4,0)="item to the dialog element or group."
^DIC(19,16351,1,5,0)=" "
^DIC(19,16351,1,6,0)="When a reminder dialog is generated it will include the questions defined"
^DIC(19,16351,1,7,0)="in this file (applicable to the findings on the reminder) instead of"
^DIC(19,16351,1,8,0)="generating dialog using the finding type parameters file."
^DIC(19,16351,1,9,0)="Cloned from ""PXRM FINDING ITEM PARAMETERS"" option."
^DIC(19,16351,3)=""
^DIC(19,16351,15)=""
^DIC(19,16351,20)=""
^DIC(19,16351,25)="PXRMFIP"
^DIC(19,16351,30)=""
^DIC(19,16351,31)=""
^DIC(19,16351,32)=""
^DIC(19,16351,33)=""
^DIC(19,16351,34)=""
^DIC(19,16351,50)=""
^DIC(19,16351,51)=""
^DIC(19,16351,"U")="FINDING ITEM PARAMETERS"
^DIC(19,16352,0)="EHM-01173^Health Factor Resolutions^^R^1^^^^^^^534^^^^"
^DIC(19,16352,1,0)="^^9^9^3240328^^^^"
^DIC(19,16352,1,1,0)="Health factors must be mapped to resolution codes using this option if"
^DIC(19,16352,1,2,0)="they are to be included in reminder dialog generated."
^DIC(19,16352,1,3,0)=" "
^DIC(19,16352,1,4,0)="Reminder dialog generation creates a question (dialog element) in the"
^DIC(19,16352,1,5,0)="reminder dialog for each resolution status entered in this file against"
^DIC(19,16352,1,6,0)="the health factor. Question text and additional prompts are derived from"
^DIC(19,16352,1,7,0)="the finding parameters file and may be modified by option PXRM FINDING"
^DIC(19,16352,1,8,0)="PARAMETERS."
^DIC(19,16352,1,9,0)="Cloned from ""PXRM HEALTH FACTOR RESOLUTIONS"" option."
^DIC(19,16352,3)=""
^DIC(19,16352,15)=""
