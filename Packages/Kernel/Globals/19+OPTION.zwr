^DIC(19,16587,0)="EHM-01408^Provider Narrative Repair Menu^^M^1^^^^^^^507^^^^"
^DIC(19,16587,1,0)="^^2^2^3240328^"
^DIC(19,16587,1,1,0)="Menu for V CPT and V POV Provider Narrative repair."
