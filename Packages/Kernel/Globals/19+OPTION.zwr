^DIC(19,11389,0)="DGMST PRIMARY MENU^Military Sexual Trauma Menu^^M^11281^^^^^^^114"
^DIC(19,11389,1,0)="^^3^3^2990108^^^"
^DIC(19,11389,1,1,0)="This is the primary menu containing the MST status enter and reporting"
^DIC(19,11389,1,2,0)="options.  This menu should be assigned to selected staff members who"
^DIC(19,11389,1,3,0)="have overall responsibility at the site for the Women Veterans Program."
^DIC(19,11389,10,0)="^19.01IP^2^2"
