^DIC(19,9395,0)="PRCP INV CONTROL PARAM PRINT^Inventory Control Parameters Print^^R^11740^^^^^^^"
^DIC(19,9395,1,0)="^^5^5^2920211^^^^"
^DIC(19,9395,1,1,0)="This option will print the control parameters for the inventory"
^DIC(19,9395,1,2,0)="point or a selected distribution point.  The parameters include"
^DIC(19,9395,1,3,0)="the number of items stored in the inventory point, the cost center,"
^DIC(19,9395,1,4,0)="fund control points, inventory point users (showing managers),"
^DIC(19,9395,1,5,0)="distribution points, etc."
^DIC(19,9395,20)=""
^DIC(19,9395,25)="PRCPRINV"
^DIC(19,9395,"U")="INVENTORY CONTROL PARAMETERS P"
^DIC(19,9396,0)="PRCP POSTED STOCK ITEMS REPORT^Posted Stock Items Report^^R^11740^^^^^^^"
^DIC(19,9396,1,0)="^^4^4^2920211^^^^"
^DIC(19,9396,1,1,0)="This option will print a report of items stored in the inventory"
^DIC(19,9396,1,2,0)="point which are designated as posted stock (distribution from the"
^DIC(19,9396,1,3,0)="warehouse).  The report will show the item information, quantity"
^DIC(19,9396,1,4,0)="on-hand, unit per issue, unit per receipt, and conversion factor."
^DIC(19,9396,20)=""
^DIC(19,9396,25)="PRCPRPOS"
^DIC(19,9396,"U")="POSTED STOCK ITEMS REPORT"
^DIC(19,9397,0)="PRCP LAST PROC SOURCE REPORT^Last Procurement Source For Item Report^^R^11740^^^^^^^"
^DIC(19,9397,1,0)="^^5^5^2920211^^^^"
^DIC(19,9397,1,1,0)="This option will print a report showing the items in the inventory"
^DIC(19,9397,1,2,0)="point and the last vendor the item was ordered from.  The report"
^DIC(19,9397,1,3,0)="will display the item information, unit per issue, quantity on-hand,"
^DIC(19,9397,1,4,0)="last vendor, purchase order number, unit per receipt, unit price,"
^DIC(19,9397,1,5,0)="and quantity ordered."
^DIC(19,9397,20)=""
^DIC(19,9397,25)="PRCPRLAS"
^DIC(19,9397,"U")="LAST PROCUREMENT SOURCE FOR IT"
^DIC(19,9398,0)="PRCP TRANSACTION REG REPORT^Transaction Register Report^^R^11740^^^^^^^"
^DIC(19,9398,1,0)="^^4^4^2920211^^^^"
^DIC(19,9398,1,1,0)="This option will print the transaction register, which stores all"
^DIC(19,9398,1,2,0)="transactions which affect the inventory, for a specified month-year."
^DIC(19,9398,1,3,0)="The report allows the selection of a single item, multiple items, or"
^DIC(19,9398,1,4,0)="all items stored in the inventory point."
^DIC(19,9398,20)=""
^DIC(19,9398,25)="PRCPRTRA"
^DIC(19,9398,"U")="TRANSACTION REGISTER REPORT"
^DIC(19,9399,0)="PRCP2 INVENTORY MENU^Inventory File Maintenance Menu^^M^11740^^^^^^^^^1"
^DIC(19,9399,1,0)="^^2^2^2920506^^^^"
^DIC(19,9399,1,1,0)="This menu includes the options for a secondary to maintain the items"
^DIC(19,9399,1,2,0)="stored in the inventory point."
^DIC(19,9399,10,0)="^19.01PI^5^4"
