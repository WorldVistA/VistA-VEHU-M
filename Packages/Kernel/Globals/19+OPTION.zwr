^DIC(19,12708,0)="SD-PAIT TRANSMISSION SUMMARY^Transmission Summary^^P^10000000020^^^^^^^"
^DIC(19,12708,1,0)="^^3^3^3040304^"
^DIC(19,12708,1,1,0)="This option generate a detailed report for eatch transmission, with batch "
^DIC(19,12708,1,2,0)="control IDs, message control IDs, and date/time the batches were created."
^DIC(19,12708,1,3,0)="This option may be used for verification of batches recived by AAC. "
