^DIC(19,12171,"U")="EXPORT/IMPORT A HEALTH SUMMARY"
^DIC(19,12172,0)="RA HL7 MESSAGE RESEND^Resend Radiology HL7 Message^^R^10000000216^RA MGR^^^^^y^31^^1^1"
^DIC(19,12172,1,0)="^19.06^2^2^3100128^^^^"
^DIC(19,12172,1,1,0)="This option can be used to resend HL7 messages to all subscribers for"
^DIC(19,12172,1,2,0)="selected cases."
^DIC(19,12172,15)="K RAOPT(""RESEND"")"
^DIC(19,12172,20)="S RAOPT(""RESEND"")="""""
^DIC(19,12172,25)="RAHLRS"
^DIC(19,12172,"U")="RESEND RADIOLOGY HL7 MESSAGE"
