^DIC(19,8936,"U")="FIVE YEAR FACILITY PLAN (FYFP)"
^DIC(19,8937,0)="ENPLMFX^Transmit 5-Yr Plan Projects^^R^.5^ENPLK003^^^^^^33"
^DIC(19,8937,1,0)="^^6^6^2950512^"
^DIC(19,8937,1,1,0)="This option transmits construction and lease project data to the Regional"
^DIC(19,8937,1,2,0)="Construction Database for selected projects. Only data which is pertinent"
^DIC(19,8937,1,3,0)="to the Five Year Facility Plan (FYFP) is sent. Selected projects are"
^DIC(19,8937,1,4,0)="automatically validated prior to the actual transmission. The transmitter"
^DIC(19,8937,1,5,0)="is a receipient of any created mail messages that are sent to the Regional"
^DIC(19,8937,1,6,0)="Construction Database."
^DIC(19,8937,25)="EN^ENPLX(""F"")"
^DIC(19,8937,"U")="TRANSMIT 5-YR PLAN PROJECTS"
^DIC(19,8938,0)="ENPLMFV^Validate 5-Yr Plan Projects^^A^.5^^^^^^^33^^1"
^DIC(19,8938,1,0)="^^3^3^2950512^"
^DIC(19,8938,1,1,0)="This option validates selected construction and lease projects. Only data"
^DIC(19,8938,1,2,0)="which pertains to the Five Year Facility Plan (FYFP) is checked. Any"
^DIC(19,8938,1,3,0)="validation errors or warnings are listed in a detailed report."
^DIC(19,8938,20)="D EN^ENPLS(""F""),EN^ENPLV(""F"",1):$D(^TMP($J,""L"")) K ^TMP($J,""L"")"
^DIC(19,8938,"U")="VALIDATE 5-YR PLAN PROJECTS"
^DIC(19,8939,0)="ENPLMAV^Validate Project Applications^^A^.5^^^^^^^33^^1"
^DIC(19,8939,1,0)="^^3^3^2950512^"
^DIC(19,8939,1,1,0)="This option validates selected construction and lease projects. Only data"
^DIC(19,8939,1,2,0)="which pertains to a project application is checked. Any validation errors"
^DIC(19,8939,1,3,0)="or warnings are listed on a detailed report."
^DIC(19,8939,20)="D EN^ENPLS(""A""),EN^ENPLV(""A"",1):$D(^TMP($J,""L"")) K ^TMP($J,""L"")"
^DIC(19,8939,"U")="VALIDATE PROJECT APPLICATIONS"
^DIC(19,8940,0)="ENPLMAX^Transmit Project Applications^^R^.5^ENPLK003^^^^^^33"
^DIC(19,8940,1,0)="^^5^5^2950512^"
^DIC(19,8940,1,1,0)="This option transmits construction and lease project data to the Regional"
^DIC(19,8940,1,2,0)="Construction Database for selected projects. All data pertinent to a"
^DIC(19,8940,1,3,0)="project application is sent. Selected projects are automatically validated"
^DIC(19,8940,1,4,0)="prior to the actual transmission. The transmitter is a receipent of any"
^DIC(19,8940,1,5,0)="created mail messages that are sent to the Regional Contruction Database."
^DIC(19,8940,25)="EN^ENPLX(""A"")"
^DIC(19,8940,"U")="TRANSMIT PROJECT APPLICATIONS"
