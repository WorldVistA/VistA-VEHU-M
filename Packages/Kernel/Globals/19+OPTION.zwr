^DIC(19,11135,20)="D MENUT^WVUTL5(""MANAGER'S PATIENT MANAGEMENT"")"
^DIC(19,11135,99)="66269,8714"
^DIC(19,11135,"U")="MANAGER'S PATIENT MANAGEMENT"
^DIC(19,11136,0)="WV EDIT PAP REGIMEN LOG^Edit PAP Regimen Log^^R^11597^^^^^^^522"
^DIC(19,11136,1,0)="^^4^4^2980610^"
^DIC(19,11136,1,1,0)="Any changes made to a patient's PAP Regimen on the ""Edit Patient Case Data"""
^DIC(19,11136,1,2,0)="screen are logged automatically and are displayed on the Patient Profile."
^DIC(19,11136,1,3,0)="If a log entry is in error, it can be edited by the program manager using"
^DIC(19,11136,1,4,0)="this option."
^DIC(19,11136,25)="PLOG^WVMGRP"
^DIC(19,11136,99)="56522,34340"
^DIC(19,11136,"U")="EDIT PAP REGIMEN LOG"
^DIC(19,11137,0)="WV EDIT PREG/LAC STATUS DATA^Edit Pregnancy/Lactation Status Data^^R^1^^^^^^^522"
^DIC(19,11137,1,0)="^^4^4^3150701^"
^DIC(19,11137,1,1,0)="Any changes made to a patient's pregnancy or lactation status by the"
^DIC(19,11137,1,2,0)="Clinical Reminders package are documented and displayed on the Patient"
^DIC(19,11137,1,3,0)="Profile.  If a data entry is assigned to the wrong patient, the program "
^DIC(19,11137,1,4,0)="manager can move the data to the correct patient or delete the data."
^DIC(19,11137,25)="PLSDATA^WVMGRP"
^DIC(19,11137,"U")="EDIT PREGNANCY/LACTATION STATU"
^DIC(19,11138,0)="WV PRINT A PROCEDURE^Print a Procedure^^R^11597^^^^^^^522^^"
^DIC(19,11138,1,0)="^^2^2^2980610^"
^DIC(19,11138,1,1,0)="This option allows you to print information pertaining to a patient's "
^DIC(19,11138,1,2,0)="procedure."
^DIC(19,11138,20)=""
^DIC(19,11138,25)="JUSTPRT^WVPRPCD"
^DIC(19,11138,99)="56394,58148"
^DIC(19,11138,"U")="PRINT A PROCEDURE"
^DIC(19,11139,0)="WV ADD AN HISTORICAL PROCEDURE^Add an HISTORICAL Procedure^^R^11597^^^^^^^522^^^^"
^DIC(19,11139,1,0)="^^2^2^2980615^"
^DIC(19,11139,1,1,0)="This option allows you to add procedures done in years past, in order to "
^DIC(19,11139,1,2,0)="make the Patient Profile more complete."
^DIC(19,11139,3)=""
^DIC(19,11139,25)="HISTORIC^WVPROC"
^DIC(19,11139,"U")="ADD AN HISTORICAL PROCEDURE"
^DIC(19,11140,0)="WV PRINT PROCEDURE STATS^Procedure Statistics Report^^R^11597^^^^^^^522"
^DIC(19,11140,1,0)="^^4^4^2980610^"
^DIC(19,11140,1,1,0)="This option provides a report for each Procedure Type, the number of "
^DIC(19,11140,1,2,0)="procedures which have had results of Normal, Abnormal, and No Result."
^DIC(19,11140,1,3,0)="It also provides the number of patients who have had Procedures with these"
^DIC(19,11140,1,4,0)="results, and their veteran status."
^DIC(19,11140,25)="WVRPPCD"
^DIC(19,11140,"U")="PROCEDURE STATISTICS REPORT"
^DIC(19,11141,0)="WV BROWSE NEEDS PAST DUE^Browse Patients With Needs Past Due^^R^11597^^^^^^^522"
^DIC(19,11141,1,0)="^^2^2^2980610^"
^DIC(19,11141,1,1,0)="This option allows you to search and browse through patients whose treatment"
^DIC(19,11141,1,2,0)="needs are past due."
^DIC(19,11141,25)="WVBRNED"
^DIC(19,11141,"U")="BROWSE PATIENTS WITH NEEDS PAS"
^DIC(19,11142,0)="WV PRINT SNAPSHOT^Snapshot of the Program Today^^R^11597^^^^^^^522"
^DIC(19,11142,1,0)="^^2^2^2980923^"
^DIC(19,11142,1,1,0)="This option provides a year-to-date (fiscal or calendar) report that gives"
^DIC(19,11142,1,2,0)="program statistics at a glance."
^DIC(19,11142,25)="WVRPSNP"
^DIC(19,11142,"U")="SNAPSHOT OF THE PROGRAM TODAY"
^DIC(19,11143,0)="WV PRINT/RETRIEVE SNAPSHOT^Retrieve/Print Earlier Snapshots^^R^11597^^^^^^^522"
^DIC(19,11143,1,0)="^^1^1^2980610^"
^DIC(19,11143,1,1,0)="This option allows you to display or print previous snapshot reports. "
^DIC(19,11143,25)="WVRPSNPR"
^DIC(19,11143,"U")="RETRIEVE/PRINT EARLIER SNAPSHO"
^DIC(19,11144,0)="WV EDIT NOTIF TYPE SYNONYM^Edit Synonyms for Notification Types^^R^11597^^^^^^^522"
^DIC(19,11144,1,0)="^^3^3^2980610^"
^DIC(19,11144,1,1,0)="Notification types are letters, phone calls, messages, conversations, etc."
^DIC(19,11144,1,2,0)="It is possible to assign synonyms to each type using this option.  This "
^DIC(19,11144,1,3,0)="provides a user defined quick method of selecting the desired type."
^DIC(19,11144,25)="TYPE^WVPURP"
^DIC(19,11144,"U")="EDIT SYNONYMS FOR NOTIFICATION"
^DIC(19,11145,0)="WV ADD/EDIT NOTIF OUTCOME^Add/Edit Notification Outcomes^^R^11597^^^^^^^522"
^DIC(19,11145,1,0)="^^3^3^2980923^^"
^DIC(19,11145,1,1,0)="Each notification, be it a letter, phone call, or other, may be given an "
