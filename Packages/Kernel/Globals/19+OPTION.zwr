^DIC(19,15786,1,0)="^^4^4^3240328^"
^DIC(19,15786,1,1,0)="Use this option to set all orderable items marked as Supply and "
^DIC(19,15786,1,2,0)="Non-Formulary in the Orderable Items File (101.43) to be QO-ONLY set to "
^DIC(19,15786,1,3,0)="yes."
