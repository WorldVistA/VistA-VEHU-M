^DIC(19,2854,0)="PRAP PRINT FILE 491^Fileman Print on initiative file^^R^.5^^^"
^DIC(19,2854,1,0)="^^3^3^2880620^^"
^DIC(19,2854,1,1,0)="This option is given to the facility user, so that they may formay their"
^DIC(19,2854,1,2,0)="own output reports. Their is an endless possibility of reports that can"
^DIC(19,2854,1,3,0)="be generated, so with this option, some of them may be constructed."
^DIC(19,2854,25)="PRAPDIP"
^DIC(19,2854,"U")="FILEMAN PRINT ON INITIATIVE FILE"
^DIC(19,2855,0)="PRAP INITIATIVE SUMMARY LIST^Initiative Summary listing^^R^.5^^^"
^DIC(19,2855,1,0)="^^4^4^2881006^^^"
^DIC(19,2855,1,1,0)="This option will show each initiative in a facility, the output will "
^DIC(19,2855,1,2,0)="consist of, the initiative's;"
^DIC(19,2855,1,3,0)="total .900/ total Non-.900, combined total of .900 & Non-.900, as well"
^DIC(19,2855,1,4,0)="as the approving action and approving official."
^DIC(19,2855,25)="PRAPSUM"
^DIC(19,2855,"U")="INITIATIVE SUMMARY LISTING"
^DIC(19,2856,0)="PRAP NEW SUBACCOUNT^Breakdown by subaccount^^R^.5^^^"
^DIC(19,2856,1,0)="^^4^4^2880912^^"
^DIC(19,2856,1,1,0)="This option provides a breakdown by subaccount of each facility's .900"
^DIC(19,2856,1,2,0)="and Non-.900 data. On the MIRMO level, there is the option to do either"
^DIC(19,2856,1,3,0)="Regional or National totals."
^DIC(19,2856,1,4,0)="Regional personnel can access their region's data only."
^DIC(19,2856,25)="PRAPO5"
^DIC(19,2856,"U")="BREAKDOWN BY SUBACCOUNT"
^DIC(19,2858,0)="PRAP FIND PRIMARY INIT^Find Primary Program office initiatives^^R^.5^^^"
^DIC(19,2858,1,0)="^^3^3^2881118^"
^DIC(19,2858,1,1,0)="This option will search through the national file and show you which "
^DIC(19,2858,1,2,0)="initiatives for each facility have your program office designated as "
^DIC(19,2858,1,3,0)="the primary program office."
^DIC(19,2858,25)="PRAPPRO"
^DIC(19,2858,"U")="FIND PRIMARY PROGRAM OFFICE INITIATIVES"
