^DIC(19,9221,0)="RA WASTED FILM RPT^Wasted Film Report^^R^11712^^^^^^y^31"
^DIC(19,9221,1,0)="^^5^5^2940606^"
^DIC(19,9221,1,1,0)="     This option allows the user to generate a record of wasted"
^DIC(19,9221,1,2,0)="film according to size, imaging type and division.  This report calculates"
^DIC(19,9221,1,3,0)="the number of all films used, the number of films wasted, and the"
^DIC(19,9221,1,4,0)="percentage of wasted film.  This listing may be generated as a detailed or"
^DIC(19,9221,1,5,0)="summary report."
^DIC(19,9221,25)="RAWFR1"
^DIC(19,9221,"U")="WASTED FILM REPORT"
^DIC(19,9222,0)="RA RESIDENT PRE-VERIFY^Resident On-Line Pre-Verification^^R^11740^^^^^^^^^1^1"
^DIC(19,9222,1,0)="^19.06^6^6^3000721^^^"
^DIC(19,9222,1,1,0)="This option allows interpreting residents to pre-verify their reports."
^DIC(19,9222,1,2,0)=" "
^DIC(19,9222,1,3,0)="If the interpreting resident answers YES to the question, WANT TO"
^DIC(19,9222,1,4,0)="PRE-VERIFY THIS REPORT?, then the Resident's identification number,"
^DIC(19,9222,1,5,0)="electronic signature code, and the date and time will be stored with the"
^DIC(19,9222,1,6,0)="report entry."
^DIC(19,9222,15)="K RAPBRPT,RATECHCO"
^DIC(19,9222,20)="S (RAPBRPT,RATECHCO)="""""
^DIC(19,9222,25)="RARTRPV"
^DIC(19,9222,"U")="RESIDENT ON-LINE PRE-VERIFICAT"
^DIC(19,9223,0)="RA BTCHDEL DATE^Delete Printed Batches By Date^^R^11712^RA MGR^^^^^^31"
^DIC(19,9223,1,0)="^^4^4^2940214^"
^DIC(19,9223,1,1,0)="     This option allows the user to delete batches after they have been"
^DIC(19,9223,1,2,0)="printed.  The option purges all records up to a user defined date.  This"
^DIC(19,9223,1,3,0)="purges records by date printed, not by the users who created the batch."
^DIC(19,9223,1,4,0)="This option can only be accessed by those users who hold the 'RA MGR' key."
^DIC(19,9223,25)="RABTCH2"
^DIC(19,9223,"U")="DELETE PRINTED BATCHES BY DATE"
^DIC(19,9224,0)="RA LOC SWITCH^Switch Locations^^R^11712^^^^^^^31^^1^1"
^DIC(19,9224,1,0)="^^4^4^2940606^"
^DIC(19,9224,1,1,0)="This option will allow the user to select a new location as a parameter"
^DIC(19,9224,1,2,0)="without first logging out, then logging back into the package. This option"
^DIC(19,9224,1,3,0)="will kill the variable 'RAMLC' then reset the variable by calling the SET"
^DIC(19,9224,1,4,0)="subroutine in RAPSET1."
^DIC(19,9224,15)="K RASWLOC"
^DIC(19,9224,20)="K RAMLC S RASWLOC="""""
^DIC(19,9224,25)="SET^RAPSET1"
^DIC(19,9224,99)="55962,50289"
^DIC(19,9224,"U")="SWITCH LOCATIONS"
^DIC(19,9225,0)="RA INVALID EXAM STATUSES^List Exams with Inactive/Invalid Statuses^^R^11712^^^^^^^31"
^DIC(19,9225,1,0)="^^3^3^2940316^"
^DIC(19,9225,1,1,0)="     This option will list all exams which are linked to an exam status"
^DIC(19,9225,1,2,0)="which is invalid.  An exam status is inactive/invalid if the value in the"
^DIC(19,9225,1,3,0)="'Order' field is null."
^DIC(19,9225,25)="ORDELSH^RAUTL11"
^DIC(19,9225,"U")="LIST EXAMS WITH INACTIVE/INVAL"
^DIC(19,9226,0)="RA VALID STOP CODES^Valid Imaging Stop Codes Edit^^E^11712^RA MGR^^^^^^^^^1"
^DIC(19,9226,1,0)="^^2^2^2940907^^^"
^DIC(19,9226,1,1,0)="This option allows the Radiology/Nuclear Medicine ADPAC to select a set"
^DIC(19,9226,1,2,0)="of clinic stop codes that are currently valid for Imaging procedures."
^DIC(19,9226,15)="K %,%W,%Y,C,DDC,DI,DQ,I,POP,DG,DISYS"
^DIC(19,9226,30)="RAMIS(71.5,"
^DIC(19,9226,31)="AELMQ"
^DIC(19,9226,35)=""
^DIC(19,9226,50)="RAMIS(71.5,"
^DIC(19,9226,51)=.01
^DIC(19,9226,"U")="VALID IMAGING STOP CODES EDIT"
^DIC(19,9227,0)="RA INVALID CPT/STOP^Invalid CPT/Stop Code List^^R^11712^^^^^^^"
^DIC(19,9227,1,0)="^^2^2^2960830^^"
^DIC(19,9227,1,1,0)="This report shows all Radiology/Nuclear Med procedures (File 71) with"
^DIC(19,9227,1,2,0)="missing or invalid CPT codes and Credit Stop codes."
^DIC(19,9227,25)="RAPERR"
^DIC(19,9227,"U")="INVALID CPT/STOP CODE LIST"
^DIC(19,9228,0)="RA COMPILE TEMPLATES^Template Compilation^^R^11712^^^^^^^31"
^DIC(19,9228,1,0)="^^4^4^2950201^^"
^DIC(19,9228,1,1,0)="     This option will compile all input and print templates which are"
^DIC(19,9228,1,2,0)="currently compiled.  It is advised that all Radiology/Nuclear Medicine"
^DIC(19,9228,1,3,0)="users be off the system during the compilation process.  Compilation"
^DIC(19,9228,1,4,0)="should also taken place when system activity is at a minimum."
^DIC(19,9228,25)="RACMPLE"
^DIC(19,9228,"U")="TEMPLATE COMPILATION"
^DIC(19,9229,0)="RA EXAM/STATUS ITYPE MISMATCH^Imaging Type Mismatch Report^^R^11712^^^^^^^"
^DIC(19,9229,1,0)="^^8^8^2940930^"
^DIC(19,9229,1,1,0)="This report will print each case where the imaging type of the visit does"
^DIC(19,9229,1,2,0)="not match the imaging type of the current exam status.  These cases should"
^DIC(19,9229,1,3,0)="be edited to complete as soon as possible to correct the exam status.  The"
^DIC(19,9229,1,4,0)="mismatch condition should only exist on cases not yet completed at the"
^DIC(19,9229,1,5,0)="time Version 4.5 is installed.  If not corrected, the mismatches will lead"
^DIC(19,9229,1,6,0)="to inaccurate counts on workload reports that depend on the examination"
^DIC(19,9229,1,7,0)="status parameters to determine which statuses are included in which"
^DIC(19,9229,1,8,0)="reports."
^DIC(19,9229,25)="RAUTL16"
^DIC(19,9229,"U")="IMAGING TYPE MISMATCH REPORT"
^DIC(19,9231,0)="ENXK FAP BLANK^FAP PREP. - EQUIP WITH TYPE BLANK^^P^.5^^^^^^^33"
^DIC(19,9231,1,0)="^^11^11^2960222^"
^DIC(19,9231,1,1,0)="This report will assist sites to prepare for installation of patch"
^DIC(19,9231,1,2,0)="EN*7*25. Patch EN*7*25 will use the TYPE ENTRY, CAPITALIZED, CMR, and"
^DIC(19,9231,1,3,0)="CATEGORY STOCK NUMBER fields to automatically populate new data fields."
^DIC(19,9231,1,4,0)="This report lists equipment which may be of interest to Fixed Assets so"
^DIC(19,9231,1,5,0)="sites can ensure that the data which will be used in the patch EN*7*25"
^DIC(19,9231,1,6,0)="conversion is appropriate."
^DIC(19,9231,1,7,0)=" "
^DIC(19,9231,1,8,0)="Equipment meeting the following criteria will be listed on the report:"
^DIC(19,9231,1,9,0)=" TYPE OF ENTRY = """""
^DIC(19,9231,1,10,0)=" ACQUISITION VALUE greater than 4999.99"
^DIC(19,9231,1,11,0)=" DISPOSITION DATE = """""
^DIC(19,9231,60)="ENG(6914,"
^DIC(19,9231,62)=0
^DIC(19,9231,63)="[ENXKFAP]"
^DIC(19,9231,64)="[ENXKBLANK]"
^DIC(19,9231,65)=""
^DIC(19,9231,66)=""
^DIC(19,9231,"U")="FAP PREP. - EQUIP WITH TYPE BL"
^DIC(19,9232,0)="ENXK FAP NX^FAP PREP. - EQUIP WITH TYPE NX^^P^.5^^^^^^^33"
^DIC(19,9232,1,0)="^^11^11^2960222^^"
^DIC(19,9232,1,1,0)="This reprot will assist sites to prepare for installation of patch"
^DIC(19,9232,1,2,0)="EN*7*25. Patch EN*7*25 will use the TYPE ENTRY, CAPITALIZED, CMR, and"
^DIC(19,9232,1,3,0)="CATEGORY STOCK NUMBER fields to automatically populate new data fields."
^DIC(19,9232,1,4,0)="This reprot lists equipment which may be of interest to FIxed Assets so"
^DIC(19,9232,1,5,0)="sites can ensure that the data which will be used in the patch EN*7*25"
^DIC(19,9232,1,6,0)="conversion is appropriate."
^DIC(19,9232,1,7,0)=" "
^DIC(19,9232,1,8,0)="Equipment meeting the following criteria will be listed on the report:"
^DIC(19,9232,1,9,0)=" TYPE OF ENTRY = ""NX"""
^DIC(19,9232,1,10,0)=" ACQUISITION VALUE greater than 4999.99"
^DIC(19,9232,1,11,0)=" DISPOSITION DATE = """""
^DIC(19,9232,60)="ENG(6914,"
^DIC(19,9232,62)=0
^DIC(19,9232,63)="[ENXKFAP]"
^DIC(19,9232,64)="[ENXKNX]"
^DIC(19,9232,65)=""
^DIC(19,9232,66)=""
^DIC(19,9232,"U")="FAP PREP. - EQUIP WITH TYPE NX"
^DIC(19,9307,0)="XT-KERMIT RECEIVE^Receive KERMIT file^^R^.5^^^^^^^^^"
^DIC(19,9307,1,0)="^^2^2^2890526^^^"
^DIC(19,9307,1,1,0)="This option receives a file over the terminal line from a remote"
^DIC(19,9307,1,2,0)="system in the KERMIT protocol."
^DIC(19,9307,25)="R^XTKERMIT"
^DIC(19,9307,"U")="RECEIVE KERMIT FILE"
^DIC(19,9308,0)="XTVR MENU^Verifier Tools Menu^^M^.5^^^^^^^^^"
^DIC(19,9308,1,0)="^^2^2^2901220^^"
^DIC(19,9308,1,1,0)="This menu contains options which are available as tools for verification"
^DIC(19,9308,1,2,0)="during program development."
^DIC(19,9308,10,0)="^19.01PI^2^2"
^DIC(19,9308,10,1,0)="6325^^20"
^DIC(19,9308,10,2,0)="6324^^5"
^DIC(19,9308,10,"B",6324,2)=""
^DIC(19,9308,10,"B",6325,1)=""
^DIC(19,9308,99)="56686,60872"
^DIC(19,9308,"U")="VERIFIER TOOLS MENU"
^DIC(19,9335,0)="ENFA VALCHK BY CMR^FAP Validity Check By CMR (FA Documents)^^A^.5^^^^^^^33^^1"
^DIC(19,9335,1,0)="^^5^5^2960318^"
^DIC(19,9335,1,1,0)="This option will perform validity checks on equipment belonging to a"
^DIC(19,9335,1,2,0)="specified CMR to determine if FA Documents (code sheets) can be created"
^DIC(19,9335,1,3,0)="for those equipment entries. Only capitalized (CAPITALIZED field = YES)"
^DIC(19,9335,1,4,0)="equipent will be considered. Equipment which is already established in"
^DIC(19,9335,1,5,0)="Fixed Assets will not be checked."
^DIC(19,9335,20)="S ENBAT(""XMT"")=0 D CMR^ENFAXMTM K ENBAT(""XMT"")"
^DIC(19,9335,25)="VALCMR^ENFAXMTM"
^DIC(19,9335,"U")="FAP VALIDITY CHECK BY CMR (FA "
^DIC(19,9336,0)="ENFA VALCHK SINGLE^FAP Validity Check For A Single Item (FA Document)^^A^.5^^^^^^^33^^1"
^DIC(19,9336,1,0)="^^3^3^2960318^"
^DIC(19,9336,1,1,0)="This option will perform a validity check on an entry in the Equipment"
^DIC(19,9336,1,2,0)="file to determine if a FA Document (code sheet) can be created for that"
^DIC(19,9336,1,3,0)="entry."
^DIC(19,9336,20)="S ENBAT(""XMT"")=0 D EQUIP^ENFAXMTM K ENBAT(""XMT"")"
^DIC(19,9336,25)="SINGLE^ENFAXMTM"
^DIC(19,9336,"U")="FAP VALIDITY CHECK FOR A SINGL"
^DIC(19,9337,0)="ENFAR1^Capitalized Equipment List for CMR^^R^.5^^^^^^^33"
^DIC(19,9337,1,0)="^^4^4^2951109^"
^DIC(19,9337,1,1,0)="This option generates a list of capitalized equipment sorted by category"
^DIC(19,9337,1,2,0)="stock number for a specified CMR. This report can be used to reconcile the"
^DIC(19,9337,1,3,0)="equipment file with the LOG I corporate database. The report is similar to"
^DIC(19,9337,1,4,0)="the Consolidated Memorandum Receipt (Report 049) from LOG I."
^DIC(19,9337,25)="ENFAR1"
^DIC(19,9337,"U")="CAPITALIZED EQUIPMENT LIST FOR"
^DIC(19,9338,0)="ENFAR2^Summary of Capitalized NX Equipment Assets^^R^.5^^^^^^^33"
^DIC(19,9338,1,0)="^^5^5^2951113^^"
^DIC(19,9338,1,1,0)="This option generates a summary report of all capitalized NX equipment"
^DIC(19,9338,1,2,0)="assets in the Engineering Equipment Inv. file. Equipment items with a"
^DIC(19,9338,1,3,0)="disposition date are excluded from this report. The output will contain"
^DIC(19,9338,1,4,0)="the item count and asset value by station, fund, and standard general"
^DIC(19,9338,1,5,0)="ledger. This report may take some time to run."
^DIC(19,9338,25)="ENFAR2"
^DIC(19,9338,"U")="SUMMARY OF CAPITALIZED NX EQUI"
^DIC(19,9339,0)="ENFAR3^Check of Equipment Capitalization^^R^.5^^^^^^^33"
^DIC(19,9339,1,0)="^^11^11^2951109^"
^DIC(19,9339,1,1,0)="This option generates a report of equipment items which appear to have"
^DIC(19,9339,1,2,0)="unusual combinations in the TOTAL ASSET VALUE and CAPITALIZED? fields."
^DIC(19,9339,1,3,0)="Capitalized equipment is reported when it's Type Entry is blank."
^DIC(19,9339,1,4,0)="Capitalized NX equipment is reported when it's CMR does not begin with one"
^DIC(19,9339,1,5,0)="of the standard two digit values, or it's Standard General Ledger is"
^DIC(19,9339,1,6,0)="blank. Equipment items with a disposition date are excluded from the"
^DIC(19,9339,1,7,0)="report. This report searches the entire equipment file and may take some"
^DIC(19,9339,1,8,0)="time to run."
^DIC(19,9339,1,9,0)=" "
^DIC(19,9339,1,10,0)="These equipment items should be checked to ensure that the data in the"
^DIC(19,9339,1,11,0)="Equipment file is accurate."
^DIC(19,9339,25)="ENFAR3"
^DIC(19,9339,"U")="CHECK OF EQUIPMENT CAPITALIZAT"
^DIC(19,9341,0)="ENFAR4^Capitalized Equipment List for Station^^R^.5^^^^^^^33"
^DIC(19,9341,1,0)="^^6^6^2951109^"
^DIC(19,9341,1,1,0)="This option generates a list of capitalized equipment sorted by category"
^DIC(19,9341,1,2,0)="stock number and CMR for a specified station. Equipment must be on a CMR"
^DIC(19,9341,1,3,0)="in order to be included in this report. This report can be used to"
^DIC(19,9341,1,4,0)="reconcile the equipment file with the LOG I corporate database. The report"
^DIC(19,9341,1,5,0)="is similar to the Nonexpendable Property Locator Listing (Report 051) from"
^DIC(19,9341,1,6,0)="LOG I."
^DIC(19,9341,25)="ENFAR4"
^DIC(19,9341,"U")="CAPITALIZED EQUIPMENT LIST FOR"
