^DIC(19,3361,1,1,0)="Prints/Displays a list of all messages in all/one of your mail baskets."
^DIC(19,3361,1,2,0)=""
^DIC(19,3361,1,3,0)="The list is sorted by basket name, and within basket by message index"
^DIC(19,3361,1,4,0)="number."
^DIC(19,3361,20)=""
^DIC(19,3361,25)="LISTMBOX^XMJBL"
^DIC(19,3361,99)="55614,50948"
^DIC(19,3361,"U")="MAILBOX CONTENTS LIST"
^DIC(19,3362,0)="XMTALK^TalkMan^^R^11748^XMTALK^3463^^^^^54^^"
^DIC(19,3362,1,0)="^19.06^6^6^3020312^^^^"
^DIC(19,3362,1,1,0)="TalkMan allows the user to communicate with another domain through the"
^DIC(19,3362,1,2,0)="script processing ability of MailMan.  Since the Script Processing"
^DIC(19,3362,1,3,0)="mode is transparent, the user need not know any security passwords..."
^DIC(19,3362,1,4,0)="He only needs to know the name of the Domain and have access to the"
^DIC(19,3362,1,5,0)="option.  In addition, the script for the domain must have a 'T' command"
^DIC(19,3362,1,6,0)="and the FLAGS field must contain a 'T'."
^DIC(19,3362,25)="TALK^XMCTLK"
^DIC(19,3362,99)="55504,52838"
^DIC(19,3362,99.1)="55615,38578"
^DIC(19,3362,"U")="TALKMAN"
^DIC(19,3363,0)="XMMASTER^MailMan Master Menu^^M^11748^^2530^^^^^^^"
^DIC(19,3363,1,0)="^^4^4^2870825^^^"
^DIC(19,3363,1,1,0)="This is the MailMan menu with all the addressable options:"
^DIC(19,3363,1,2,0)="   Manage MailMan (Utilities)"
^DIC(19,3363,1,3,0)="   Network Management"
^DIC(19,3363,1,4,0)="   User Options"
^DIC(19,3363,10,0)="^19.01PI^3^3"
^DIC(19,3363,10,1,0)="22^XMU"
^DIC(19,3363,10,2,0)="131^XMN"
^DIC(19,3363,10,3,0)="27^XMM"
