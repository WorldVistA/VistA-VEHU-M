^DIC(19,14120,"U")="NURSE POC STAFF MENU"
^DIC(19,14121,0)="PRSNR MISMATCHES ETA POC-COORD^Mismatch Report-Point of Care vs. ETA Timecard^^R^10000000216^^^^^^^"
^DIC(19,14121,1,0)="^^5^5^3100302^"
^DIC(19,14121,1,1,0)="This option provides the site coordinator the ability to report any "
^DIC(19,14121,1,2,0)="mismatches between the ETA timecard and the Nurse's Point of Care (POC) "
^DIC(19,14121,1,3,0)="record.  Mismatches are reported when there is a discrepancy between "
^DIC(19,14121,1,4,0)="the two records for either the type of time or start and stop times for a "
^DIC(19,14121,1,5,0)="particular type of time."
^DIC(19,14121,25)="COORD^PRSNRMM1"
^DIC(19,14121,"U")="MISMATCH REPORT-POINT OF CARE "
^DIC(19,14122,0)="PRSNR MISMATCHES ETA POC-DAP^Mismatch Report-Point of Care vs. ETA Timecard^^R^10000000216^^^^^^^"
^DIC(19,14122,1,0)="^^5^5^3100302^"
^DIC(19,14122,1,1,0)="This option provides POC data approval personnel the ability to report any"
^DIC(19,14122,1,2,0)="mismatches between the ETA timecard and the Nurse's Point of Care (POC) "
^DIC(19,14122,1,3,0)="record.  Mismatches are reported when there is a discrepancy between the"
^DIC(19,14122,1,4,0)="two records for either the type of time or start and stop times for a "
^DIC(19,14122,1,5,0)="particular type of time."
^DIC(19,14122,25)="DAP^PRSNRMM1"
^DIC(19,14122,"U")="MISMATCH REPORT-POINT OF CARE "
^DIC(19,14123,0)="PRSNR MISMATCHES ETA POC-DEP^Mismatch Report-Point of Care vs. ETA Timecard^^R^10000000216^^^^^^^"
^DIC(19,14123,1,0)="^^5^5^3100302^"
^DIC(19,14123,1,1,0)="This option provides POC data entry personnel the ability to report any"
^DIC(19,14123,1,2,0)="mismatches between the ETA timecard and the Nurse's Point of Care (POC) "
^DIC(19,14123,1,3,0)="record.  Mismatches are reported when there is a discrepancy between the"
^DIC(19,14123,1,4,0)="two records for either the type of time or start and stop times for a "
^DIC(19,14123,1,5,0)="particular type of time."
^DIC(19,14123,25)="DEP^PRSNRMM1"
^DIC(19,14123,"U")="MISMATCH REPORT-POINT OF CARE "
^DIC(19,14124,0)="PRSNR MISMATCHES ETA POC-NURSE^Mismatch Report-Point of Care vs. ETA Timecard^^R^10000000216^^^^^^^"
^DIC(19,14124,1,0)="^^5^5^3100302^"
^DIC(19,14124,1,1,0)="This option provides a nurse the ability to report any mismatches between"
^DIC(19,14124,1,2,0)="their ETA timecard and their Nurse's Point of Care (POC) record.  "
^DIC(19,14124,1,3,0)="Mismatches are reported when there is a discrepancy between the"
^DIC(19,14124,1,4,0)="two records for either the type of time or start and stop times for a "
^DIC(19,14124,1,5,0)="particular type of time."
^DIC(19,14124,25)="NURSE^PRSNRMM1"
^DIC(19,14124,"U")="MISMATCH REPORT-POINT OF CARE "
^DIC(19,14125,0)="PRSNR EDU VALIDATION-COORD^Nursing Education Validation^^R^10000000216^^^^^^^"
^DIC(19,14125,1,0)="^^3^3^3091015^"
^DIC(19,14125,1,1,0)="This report provides nursing job codes, roles, assignments,education "
^DIC(19,14125,1,2,0)="level and year degree earned over a date range, by location or T&L unit "
^DIC(19,14125,1,3,0)="within a division."
^DIC(19,14125,25)="COORD^PRSNREV0"
^DIC(19,14125,"U")="NURSING EDUCATION VALIDATION"
^DIC(19,14126,0)="PRSN CORRECT RELEASED POC DATA^Correct Released Nurse POC Data^^R^10000000216^^^^^^^230"
^DIC(19,14126,1,0)="^^3^3^3091022^"
^DIC(19,14126,1,1,0)="This option provides the functionality to enter correction to nurse POC "
^DIC(19,14126,1,2,0)="data for direct care nurses for a prior date that has already been "
^DIC(19,14126,1,3,0)="released to VANOD."
^DIC(19,14126,25)="ENT^PRSNEC"
^DIC(19,14126,"U")="CORRECT RELEASED NURSE POC DAT"
^DIC(19,14127,0)="PRSNR SKILL MIX GRP SUMM-DAP^Nurse Group Work Summary by Skill Mix^^R^10000000216^^^^^^^"
^DIC(19,14127,1,0)="^19.06^2^2^3091029^^"
^DIC(19,14127,1,1,0)="This report provides nursing group work summary by skill mix over a date "
^DIC(19,14127,1,2,0)="range, by default location or T&L unit within a division."
^DIC(19,14127,25)="DAP^PRSNRSM0"
^DIC(19,14127,"U")="NURSE GROUP WORK SUMMARY BY SK"
^DIC(19,14128,0)="PRSNR SKILL MIX GRP SUMM-COORD^Nurse Group Work Summary by Skill Mix^^R^10000000216^^^^^^^"
^DIC(19,14128,1,0)="^^2^2^3091029^"
^DIC(19,14128,1,1,0)="This report provides nursing group work summary by skill mix over a date"
^DIC(19,14128,1,2,0)="range, by default location or T&L unit within a division."
^DIC(19,14128,25)="COORD^PRSNRSM0"
^DIC(19,14128,"U")="NURSE GROUP WORK SUMMARY BY SK"
^DIC(19,14129,0)="PRSN POC RELEASE^Release Pay Period POC Data for VANOD Extract^^R^10000000216^^^^^^^"
^DIC(19,14129,1,0)="^19.06^7^7^3091103^^"
^DIC(19,14129,1,1,0)="This option provides ability to review POC data for a pay period and "
^DIC(19,14129,1,2,0)="release that data for extraction to VANOD.  Select a single division or"
^DIC(19,14129,1,3,0)="all divisions for release, and optionally view all POC/ETA mismatches for"
^DIC(19,14129,1,4,0)="the selected release group."
^DIC(19,14129,1,5,0)=" "
^DIC(19,14129,1,6,0)="The option transfers records from the POC Daily Time Records (#451) file"
^DIC(19,14129,1,7,0)="to the POC Daily Activity Extraction (#451.7) file."
^DIC(19,14129,25)="RELEASE^PRSNCGR"
^DIC(19,14129,"U")="RELEASE PAY PERIOD POC DATA FO"
^DIC(19,14130,0)="PRSN RET APPROVED POC RECORD^Return Approved Nurse POC Daily Time Record^^R^10000000216^^^^^^^"
^DIC(19,14130,1,0)="^^17^17^3111109^"
^DIC(19,14130,1,1,0)="This option allows the ADPAC/VANOD Site Coordinator to return previously "
^DIC(19,14130,1,2,0)="approved POC time records for additional editing by data entry personnel."
^DIC(19,14130,1,3,0)=" "
^DIC(19,14130,1,4,0)="The following types of records can be returned:"
^DIC(19,14130,1,5,0)="1.  An Approved Nurse POC Daily Time record, that has never been Released."
^DIC(19,14130,1,6,0)="2.  An Approved Nurse POC Daily Time record that has been Released and "
^DIC(19,14130,1,7,0)="has subsequently been Corrected. "
^DIC(19,14130,1,8,0)=" "
^DIC(19,14130,1,9,0)="When returning records of type 1 above, the system will change the status "
^DIC(19,14130,1,10,0)="of the Nurse POC Daily Time record for that nurse and date to POC record "
^DIC(19,14130,1,11,0)="exists and pay period status will be Open.  This will allow the POC Data "
^DIC(19,14130,1,12,0)="Entry Personnel to edit or delete any records during that pay period."
^DIC(19,14130,1,13,0)=" "
^DIC(19,14130,1,14,0)="When returning records of type 2 above, the system will change the status "
^DIC(19,14130,1,15,0)="of the Nurse POC Daily Time record for that nurse and date to Corrected.  "
^DIC(19,14130,1,16,0)="This will allow the POC Data Entry Personnel to edit or delete the "
^DIC(19,14130,1,17,0)="correction for that day."
^DIC(19,14130,25)="RETPOC^PRSNCR1"
^DIC(19,14130,"U")="RETURN APPROVED NURSE POC DAIL"
^DIC(19,14131,0)="PRSNR NURSE POSITION AND PAY^Nurse Position and Pay Information^^R^10000000216^^^^^^^230"
^DIC(19,14131,1,0)="^19.06^4^4^3100305^^"
^DIC(19,14131,1,1,0)="This report provides costing data of all active nurse staff.  The report"
^DIC(19,14131,1,2,0)="includes Name, SSN (last 4), Skill Mix, BOC, OCC, Assignment Code, "
^DIC(19,14131,1,3,0)="CC, Nurse Role, Grade/Step, Next Step Due Date, Years of Service and "
^DIC(19,14131,1,4,0)="Salary.  Payroll personnel can run this report for any division."
^DIC(19,14131,25)="COORDNPP^PRSNREV0"
^DIC(19,14131,"U")="NURSE POSITION AND PAY INFORMA"
^DIC(19,14132,0)="PRSNR NONDIR CARE SUMM-COORD^Non-direct Care Summary by Skill Mix^^R^10000000216^^^^^^^"
^DIC(19,14132,1,0)="^19.06^3^3^3091119^^^"
^DIC(19,14132,1,1,0)="This report provides a summary of non direct care hours performed by "
^DIC(19,14132,1,2,0)="nurses and unlicensed personnel over a date range, by location or T&L "
^DIC(19,14132,1,3,0)="unit within a division."
^DIC(19,14132,25)="COORD^PRSNRND0"
^DIC(19,14132,"U")="NON-DIRECT CARE SUMMARY BY SKI"
^DIC(19,14133,0)="PRSNR NONDIR CARE SUMM-DAP^Nondirect Care Summary by Skillmix^^R^10000000216^^^^^^^"
^DIC(19,14133,1,0)="^19.06^3^3^3091119^^"
^DIC(19,14133,1,1,0)="This report provides a summary of non direct care hours performed by"
^DIC(19,14133,1,2,0)="nurses and unlicensed personnel over a date range, by location or T&L"
^DIC(19,14133,1,3,0)="unit within a division."
^DIC(19,14133,25)="DAP^PRSNRND0"
^DIC(19,14133,"U")="NONDIRECT CARE SUMMARY BY SKIL"
^DIC(19,14134,0)="PRSN TL POC^Edit Update T&L Unit POC Users^^R^10000000216^^^^^^^230^^"
^DIC(19,14134,1,0)="^19.06^2^2^3091124^^^"
^DIC(19,14134,1,1,0)="This option allows the PEV ADPAC to enter and edit POC Entry and Approval "
^DIC(19,14134,1,2,0)="personnel for a T&L Unit."
^DIC(19,14134,20)=""
^DIC(19,14134,25)="EDIT^PRSNCTL"
^DIC(19,14134,"U")="EDIT UPDATE T&L UNIT POC USERS"
^DIC(19,14135,0)="PRSN APPROV POC PAYPD^Approve Pay Period POC Records^^R^10000000216^^^^^^^"
^DIC(19,14135,1,0)="^19.06^1^1^3110711^^"
^DIC(19,14135,1,1,0)="This option is used to approve pay period Nurse POC records."
^DIC(19,14135,25)="EN^PRSNAA01"
^DIC(19,14135,"U")="APPROVE PAY PERIOD POC RECORDS"
^DIC(19,14136,0)="PRSN APPROV CORR POC^Approve Corrected Daily POC Records^^R^10000000216^^^^^^^"
^DIC(19,14136,1,0)="^19.06^1^1^3110923^^^"
^DIC(19,14136,1,1,0)="This option is used to approve corrected daily POC records."
^DIC(19,14136,25)="EN^PRSNAC01"
^DIC(19,14136,"U")="APPROVE CORRECTED DAILY POC RE"
^DIC(19,14137,0)="PRSN POC CORRECT RELEASE^Release Corrected POC Data for VANOD Extract^^R^10000000216^^^^^^^"
^DIC(19,14137,1,0)="^^7^7^3091207^"
^DIC(19,14137,1,1,0)="This option provides the VANOD Site Coordinator or designee the ability "
^DIC(19,14137,1,2,0)="to review and release POC data that has been released in the past and has "
^DIC(19,14137,1,3,0)="subsequently been corrected and approved.  The option releases all "
^DIC(19,14137,1,4,0)="records for the day that has been corrected and may release additional "
^DIC(19,14137,1,5,0)="days if they have been impacted by the correction.  E.g., a two day tour "
^DIC(19,14137,1,6,0)="that is corrected may impact the following day and that day would also "
^DIC(19,14137,1,7,0)="need to be rebuilt and released."
^DIC(19,14137,25)="CRELEASE^PRSNCGP"
^DIC(19,14137,"U")="RELEASE CORRECTED POC DATA FOR"
