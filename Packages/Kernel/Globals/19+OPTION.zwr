^DIC(19,16938,99.1)="62537,37533"
^DIC(19,16938,"U")="GRANT USERS' ACCESS TO A SET O"
^DIC(19,16939,0)="EHM-01760^Delete Users' Access to a Set of Files^ACCESS DISABLED^R^1^^^^^^^^n^^^"
^DIC(19,16939,1,0)="^19.06^4^4^3240328^^^^"
^DIC(19,16939,1,1,0)="This option deletes the access to files held by one or more users."
^DIC(19,16939,1,2,0)="You may enter an individual file number, a range of numbers, and/or"
^DIC(19,16939,1,3,0)="a list of file numbers."
^DIC(19,16939,1,4,0)="Cloned from ""XUFILESETDELETE"" option."
