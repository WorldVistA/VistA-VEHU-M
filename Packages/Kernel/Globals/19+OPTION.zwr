^DIC(19,14710,0)="MD CONCONVERT^Consult to Clinical Procedure conversion utility^^R^11720^MD ADMINISTRATOR^^^^^^557^^1^1"
^DIC(19,14710,1,0)="^^5^5^3180907^"
^DIC(19,14710,1,1,0)="This utility will convert existing (non-CP) consults in a pending active "
^DIC(19,14710,1,2,0)="or scheduled status to a GMRC procedure."
^DIC(19,14710,1,3,0)=" "
^DIC(19,14710,1,4,0)="Note that consults setup with DICOM cannot be converted to Clinical "
^DIC(19,14710,1,5,0)="Procedures with this utility."
^DIC(19,14710,15)="K MDOPT(""CONCONVERT"")"
^DIC(19,14710,20)="S MDOPT(""CONCONVERT"")="""""
^DIC(19,14710,25)="CONVERT^MDCONUTL"
^DIC(19,14710,"U")="CONSULT TO CLINICAL PROCEDURE "
^DIC(19,14711,0)="MD PROCONVERT^Procedure to Clinical Procedure conversion utility^^R^11720^MD ADMINISTRATOR^^^^^^557^^1^1"
^DIC(19,14711,1,0)="^^5^5^3180907^"
^DIC(19,14711,1,1,0)="This utility will get all the pending, active and scheduled procedures "
^DIC(19,14711,1,2,0)="for the selected REQUEST SERVICE and convert them to Clinical Procedures."
^DIC(19,14711,1,3,0)=" "
^DIC(19,14711,1,4,0)="Note that procedures setup with DICOM cannot be converted to Clinical "
^DIC(19,14711,1,5,0)="Procedures wth this utility."
^DIC(19,14711,15)="K MDOPT(""PROCONVERT"")"
^DIC(19,14711,20)="S MDOPT(""PROCONVERT"")="""""
^DIC(19,14711,25)="CONVERT^MDCONUTL"
^DIC(19,14711,"U")="PROCEDURE TO CLINICAL PROCEDUR"
