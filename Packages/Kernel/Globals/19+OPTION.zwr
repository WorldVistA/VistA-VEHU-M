^DIC(19,12306,0)="RORMNT EDIT REG PARAMS^Edit Registry Parameters^^E^1^^^^^^^540"
^DIC(19,12306,1,0)="^19.06^3^3^3020729^^^"
^DIC(19,12306,1,1,0)=" "
^DIC(19,12306,1,2,0)="This option can be used to edit registry parameters in the 'ROR REGISTRY "
^DIC(19,12306,1,3,0)="PARAMETERS' file."
^DIC(19,12306,2)="y"
