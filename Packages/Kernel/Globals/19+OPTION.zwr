^DIC(19,8212,0)="PSU PBM AUTO^Automatic Pharmacy Statistics^^R^10000000020^^^^^^^367^^"
^DIC(19,8212,1,0)="^^22^22^3020206^"
^DIC(19,8212,1,1,0)="This option is used to gather statistics for the previous month from the"
^DIC(19,8212,1,2,0)="following files:"
^DIC(19,8212,1,3,0)=" "
^DIC(19,8212,1,4,0)=" 1. Pharmacy Patient IV Sub-file            File # 55.01"
^DIC(19,8212,1,5,0)=" 2. Pharmacy Patient UD Sub-file            File # 55.06"
^DIC(19,8212,1,6,0)=" 3. AR/WS Stats File                        File # 58.5"
^DIC(19,8212,1,7,0)=" 4. Prescription                            File # 52"
^DIC(19,8212,1,8,0)=" 5. Procurement                             File # 442,# 58.811,# 58.81"
^DIC(19,8212,1,9,0)=" 6. Controlled Substances                   File # 58.81"
^DIC(19,8212,1,10,0)=" 7. Laboratory                              File # 60,# 63"
^DIC(19,8212,1,11,0)=" 8. Patient Demographics                    File # 2"
^DIC(19,8212,1,12,0)=" 9. Outpatient Visits                       File # 9000010,# 9000010.07"
^DIC(19,8212,1,13,0)=" 10. Inpatient PTF Record                   File # 45"
^DIC(19,8212,1,14,0)=" 11. Provider Data                          File # 200,# 7,# 49,# 8932.1 "
^DIC(19,8212,1,15,0)=" "
^DIC(19,8212,1,16,0)="This option is executed as a background job each month. The statistics"
^DIC(19,8212,1,17,0)="are gathered and then sent to the National PBM section via MailMan"
^DIC(19,8212,1,18,0)="messages."
^DIC(19,8212,1,19,0)=" "
^DIC(19,8212,1,20,0)="When scheduling the monthly frequency for this option to be executed,"
^DIC(19,8212,1,21,0)="please remember to schedule it to run after the PSGW UPDATE AMIS STATS"
^DIC(19,8212,1,22,0)="option has been executed for the previous month."
^DIC(19,8212,20)=""
^DIC(19,8212,25)="AUTO^PSUCP"
^DIC(19,8212,31)=""
^DIC(19,8212,200)="^^"
^DIC(19,8212,200.9)="y"
^DIC(19,8212,"U")="AUTOMATIC PHARMACY STATISTICS"
^DIC(19,8213,0)="PSU PBM MANUAL^Manual Pharmacy Statistics^^R^10000000020^^^^^^^367"
^DIC(19,8213,1,0)="^19.06^18^18^3040204^^"
^DIC(19,8213,1,1,0)="This option is used to gather the statistical information for a selected"
^DIC(19,8213,1,2,0)="date range from the following files:"
^DIC(19,8213,1,3,0)=" "
^DIC(19,8213,1,4,0)=" 1. Pharmacy Patient IV Sub-file           File # 55.01"
^DIC(19,8213,1,5,0)=" 2. Pharmacy Patient UD Sub-file           File # 55.06"
^DIC(19,8213,1,6,0)=" 3. AR/WS Stats File                       File # 58.5"
^DIC(19,8213,1,7,0)=" 4. Prescription                           File # 52"
^DIC(19,8213,1,8,0)=" 5. Procurement                            File # 442,# 58.811,# 58.81"
^DIC(19,8213,1,9,0)=" 6. Controlled Substances                  File # 58.81"
^DIC(19,8213,1,10,0)=" 7. Laboratory                             File # 60,# 63"
^DIC(19,8213,1,11,0)=" 8. Patient Demographics                   File # 2"
^DIC(19,8213,1,12,0)=" 9. Outpatient Visits                      File # 9000010,# 9000010.07"
^DIC(19,8213,1,13,0)=" 10. Inpatient PTF Record                  File # 45"
^DIC(19,8213,1,14,0)=" 11. Provider Data                         File # 200,# 7,# 49,# 8932.1"
^DIC(19,8213,1,15,0)=" "
^DIC(19,8213,1,16,0)="This data can be collected for ALL of the files listed or for one or more"
^DIC(19,8213,1,17,0)="specific file.  A summary of data or a detailed report by drug can be"
^DIC(19,8213,1,18,0)="delivered to you in a mail message or in a hard copy report."
^DIC(19,8213,25)="PSUCP"
^DIC(19,8213,99)="55684,35938"
^DIC(19,8213,200)="^^"
^DIC(19,8213,"U")="MANUAL PHARMACY STATISTICS"
^DIC(19,8235,0)="PSJZ OE^Local Inpatient Order Entry^^R^755^^^^^^^197^^^1"
^DIC(19,8235,1,0)="^^53^53^2940705^"
^DIC(19,8235,1,1,0)="  Allows the entry of IV and Unit Dose orders.  Will also give the user the"
^DIC(19,8235,1,2,0)="opportunity to view and possibly edit previously entered orders."
^DIC(19,8235,1,3,0)=" "
^DIC(19,8235,1,4,0)="1. Create, using FM Transfer option, a local option, PSJZ OE, from the"
^DIC(19,8235,1,5,0)="option PSJ OE."
^DIC(19,8235,1,6,0)="2. The PSJZ OE option should call the rtn. PSJZOE"
^DIC(19,8235,1,7,0)="3. Edit line +5 PSJOE as follows:"
^DIC(19,8235,1,8,0)=" "
^DIC(19,8235,1,9,0)="Edit line: +5  (PSJOE+4)"
^DIC(19,8235,1,10,0)="         F  W ! D ^PSJP Q:PSGP'>0  D HK,^PSJOE0"
^DIC(19,8235,1,11,0)="  Replace: JOE  With: JZOE   Replace:"
^DIC(19,8235,1,12,0)="         F  W ! D ^PSJP Q:PSGP'>0  D HK,^PSJZOE0"
^DIC(19,8235,1,13,0)=" "
^DIC(19,8235,1,14,0)="ZS PSJOE as PSJZOE"
^DIC(19,8235,1,15,0)=" "
^DIC(19,8235,1,16,0)="4. Edit line START+1 PSJOE0 as follows:"
^DIC(19,8235,1,17,0)=" "
^DIC(19,8235,1,18,0)="Edit line: START+1"
^DIC(19,8235,1,19,0)="         W:X]"""" $P(""^PROFILE"",X,2) D ENL^PSJO3 G:PSJOL=""^"" DONE"
^DIC(19,8235,1,20,0)="G:PSJOL=""N"" ASK"
^DIC(19,8235,1,21,0)=".........   K PSJPR S PSGOEAV=0 D ^PSJO I 'PSJON G ASK"
^DIC(19,8235,1,22,0)="  Replace: D ^PSJO  With: D ^PSJZO   Replace:"
^DIC(19,8235,1,23,0)="         W:X]"""" $P(""^PROFILE"",X,2) D ENL^PSJO3 G:PSJOL=""^"" DONE"
^DIC(19,8235,1,24,0)="G:PSJOL=""N"" ASK"
^DIC(19,8235,1,25,0)=".........   K PSJPR S PSGOEAV=0 D ^PSJZO I 'PSJON G ASK"
^DIC(19,8235,1,26,0)=" "
^DIC(19,8235,1,27,0)="ZS PSJOE0 as PSJZOE0"
^DIC(19,8235,1,28,0)=" "
^DIC(19,8235,1,29,0)="5. Edit line +4 PSJO as follows:"
^DIC(19,8235,1,30,0)=" "
^DIC(19,8235,1,31,0)="Edit line: +4  (PSJO+3)"
^DIC(19,8235,1,32,0)="         K ^TMP(""ON"",$J) D EN^PSJO1"
^DIC(19,8235,1,33,0)="  Replace: SJ  With: SJZ   Replace:"
^DIC(19,8235,1,34,0)="         K ^TMP(""ON"",$J) D EN^PSJZO1"
^DIC(19,8235,1,35,0)=" "
^DIC(19,8235,1,36,0)="ZS PSJO as PSJZO"
^DIC(19,8235,1,37,0)=" "
^DIC(19,8235,1,38,0)="6. Insert after line ENUNM in rtn. PSJO1 the following:"
^DIC(19,8235,1,39,0)=" "
^DIC(19,8235,1,40,0)="Edit line: ENUNM // .Insert after line: ENUNM //   (ENUNM)"
^DIC(19,8235,1,41,0)="Insert line: <TAB>   S PSJPAD=""2940705"""
^DIC(19,8235,1,42,0)="Insert line:"
^DIC(19,8235,1,43,0)="Edit line: ENUNM+1 //   (ENUNM+1)"
^DIC(19,8235,1,44,0)="         S PSJPAD=""2940705"""
^DIC(19,8235,1,45,0)=" where the ""2940705"" is the date you want profiles to start being shown"
^DIC(19,8235,1,46,0)="for patients."
^DIC(19,8235,1,47,0)=" "
^DIC(19,8235,1,48,0)="ZS PSJO1 as PSJZO1"
^DIC(19,8235,1,49,0)=" "
^DIC(19,8235,1,50,0)="7.  This new `local' Inpatient Order option [PSJZ OE] should only be give"
^DIC(19,8235,1,51,0)="to users who know what is going on, and how to `re-instate' orders.  as"
^DIC(19,8235,1,52,0)="soon as orders are re-instated for patients, the Class I package option,"
^DIC(19,8235,1,53,0)="PSJ OE, should be returned as the option of choice."
^DIC(19,8235,15)="K ORELECT,OROLOC,ORPKG,PDM,PSGPXN,PSIV,PSIVAC,PSIVACT,PSIVCHG,PSIVE,PSIVUP,PSIVX,PSJORIFN,UL80,FIL,ND4,PSGNESDO,PSIVSC1,PSIVWAT,PSJNOO,PSJNOON,PSJORNP,TDRG,I1"
^DIC(19,8235,25)="PSJZOE"
^DIC(19,8235,99)="55319,35037"
^DIC(19,8235,"U")="LOCAL INPATIENT ORDER ENTRY"
^DIC(19,8237,0)="XMMGR-LARGE-MESSAGE-REPORT^Large Message Report^^R^11748^^^^^^^54^^"
^DIC(19,8237,1,0)="^19.06^4^4^3020509^^^^"
^DIC(19,8237,1,1,0)="This report lists messages that either are longer than a specified"
^DIC(19,8237,1,2,0)="number of lines (see field 8.14 in the MailMan Site Parameters - file 4.3),"
^DIC(19,8237,1,3,0)="or which have either no or only one owner, or no text,"
^DIC(19,8237,1,4,0)="or no subject, as such messages are of interest to site management."
^DIC(19,8237,20)=""
^DIC(19,8237,25)="ENTER^XMUT2"
^DIC(19,8237,200.9)="y"
^DIC(19,8237,"U")="LARGE MESSAGE REPORT"
^DIC(19,8238,0)="XMMGR-DIRECTORY-ALL^Remote Directory from all Domains^^R^11748^^^^^^^54"
^DIC(19,8238,1,0)="^^3^3^2930823^"
^DIC(19,8238,1,1,0)="This option schedules tasks to run in background to update MailLink"
^DIC(19,8238,1,2,0)="directory ^XMD(4.2997).  Use this option cautiously because it sends"
^DIC(19,8238,1,3,0)="requests to all the Domains for soliciting remote user directories."
^DIC(19,8238,25)="ALL^XMDIRQST"
^DIC(19,8238,"U")="REMOTE DIRECTORY FROM ALL DOMA"
^DIC(19,8239,0)="XMMGR-DIRECTORY-VACO^Load Remote VACO (Wang/Noava) Directory^^R^11748^^^^^^^54"
^DIC(19,8239,1,0)="^^4^4^2930823^"
^DIC(19,8239,1,1,0)=" "
^DIC(19,8239,1,2,0)="This option will load a file from Host File Server.  User has choice"
^DIC(19,8239,1,3,0)="whether to run this task interactively or schedule a batch job to"
^DIC(19,8239,1,4,0)="update the MailLink directory."
^DIC(19,8239,25)="OPTION^XMDIR1"
^DIC(19,8239,"U")="LOAD REMOTE VACO (WANG/NOAVA) "
^DIC(19,8240,0)="XMMGR-DIRECTORY-MAIN^Remote MailLink Directory Menu^^M^11748^XMMGR^^^^^^54"
^DIC(19,8240,1,0)="^^4^4^2940201^^^"
^DIC(19,8240,1,1,0)=" "
