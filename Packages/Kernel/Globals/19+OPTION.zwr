^DIC(19,557,"U")="DISPOSITION OUTPUTS MENU"
^DIC(19,558,0)="PSJI RETURNS^RETurns and Destroyed Entry (IV)^^R^11712^^^^^^^115"
^DIC(19,558,1,0)="^^2^2^2910312^^^^"
^DIC(19,558,1,1,0)="  This option allows the entry of returned, recycled, cancelled, or "
^DIC(19,558,1,2,0)="destroyed items per day in IV room or satellite."
^DIC(19,558,15)=""
^DIC(19,558,20)=""
^DIC(19,558,25)="PSIVRD"
^DIC(19,558,30)=""
^DIC(19,558,31)=""
^DIC(19,558,32)=""
^DIC(19,558,50)=""
^DIC(19,558,51)=""
^DIC(19,558,99)="55640,46790"
^DIC(19,558,"U")="RETURNS AND DESTROYED ENTRY (I"
^DIC(19,559,0)="DG DISPOSITION TIME STATS^Disposition Time Processing Statistics^^R^.5^^^^^^^114"
^DIC(19,559,1,0)="^^5^5^2870515^"
^DIC(19,559,1,1,0)="This option generates a reports of average processing time for patients"
^DIC(19,559,1,2,0)="registered during a specified timeframe.  Any patients not dispositioned"
^DIC(19,559,1,3,0)="during that timeframe are not included in the report.  The user can"
^DIC(19,559,1,4,0)="elect to generate a listing of those ""undispositioned"" registrations"
^DIC(19,559,1,5,0)="at the end of the report."
^DIC(19,559,25)="DGDIST"
^DIC(19,559,"U")="DISPOSITION TIME PROCESSING ST"
^DIC(19,560,0)="PSJI SITE PARAMETERS^SIte Parameters (IV)^^A^11712^^^^^^^115^^1^1"
^DIC(19,560,1,0)="^^4^4^2920512^^^^"
^DIC(19,560,1,1,0)="  This option allows the application coordinator to define the "
^DIC(19,560,1,2,0)="characteristics of the IV room and satellites to the package. "
^DIC(19,560,1,3,0)="Such things as manufacturing and delivery times, label size, use of "
^DIC(19,560,1,4,0)="suspense, and same day expiration are identified."
^DIC(19,560,15)="K I1"
^DIC(19,560,20)="D ^PSIVXU Q:$D(XQUIT)  S (DIC,DLAYGO)=59.5,DIC(0)=""AEQMLZ"" D ^DIC S:Y>0 DIE=DIC,DA=+Y,DR=""[PSJI SITE PARAMETERS]"" D:Y>0 ^DIE,ENCHK^PSIVSET,SET^PSIVXU D ENIVKV^PSGSETU K CHK,DLAYGO,DIOV,DTOUT,PSGDT,Z"
^DIC(19,560,25)=""
^DIC(19,560,30)=""
^DIC(19,560,31)=""
^DIC(19,560,50)=""
^DIC(19,560,51)=""
^DIC(19,560,"U")="SITE PARAMETERS (IV)"
^DIC(19,561,0)="DG BULLETIN LOCAL^Bulletin Selection^^R^11748^^^^^^^"
^DIC(19,561,1,0)="^19.06^4^4^3021125^^^^"
^DIC(19,561,1,1,0)="This option is used to define the local mailgroup to which you want"
^DIC(19,561,1,2,0)="certain notifications made.  If you do not wish to utilize a"
^DIC(19,561,1,3,0)="specific notification type DO NOT enter a mailgroup name otherwise"
^DIC(19,561,1,4,0)="select from the available listing the mailgroup you want notified."
^DIC(19,561,25)="EDIT^DGBUL"
^DIC(19,561,99)="55657,51615"
^DIC(19,561,"U")="BULLETIN SELECTION"
