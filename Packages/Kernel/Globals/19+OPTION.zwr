^DIC(19,10891,1,2,0)="This option allows sites to add or edit their method of shipping"
^DIC(19,10891,1,3,0)="lab specimens."
^DIC(19,10891,25)="SCME^LA7SCE"
^DIC(19,10891,"U")="EDIT SHIPPING METHOD"
^DIC(19,10892,0)="LA7S CATALOG MENU^Electronic Catalog Menu^^M^11712^^^^^^^480"
^DIC(19,10892,1,0)="^^3^3^2970717^^^^"
^DIC(19,10892,1,1,0)="The new Electronic Catalog Menu contains options that maintain,"
^DIC(19,10892,1,2,0)="produce, and print the laboratory test available for the collection"
^DIC(19,10892,1,3,0)="site to order."
^DIC(19,10892,10,0)="^19.01IP^3^3"
^DIC(19,10892,10,1,0)="10881^ENT^1"
^DIC(19,10892,10,2,0)="10890^IND^2"
^DIC(19,10892,10,3,0)="10882^ALL^3"
^DIC(19,10892,10,"B",10881,1)=""
^DIC(19,10892,10,"B",10882,3)=""
^DIC(19,10892,10,"B",10890,2)=""
^DIC(19,10892,10,"C","ALL",3)=""
^DIC(19,10892,10,"C","ENT",1)=""
^DIC(19,10892,10,"C","IND",2)=""
^DIC(19,10892,99)="57562,34574"
^DIC(19,10892,"U")="ELECTRONIC CATALOG MENU"
^DIC(19,10893,0)="LA7 CHECK FILES^Lab Messaging File Integrity Checker^^R^11712^^^^^^^480"
^DIC(19,10893,1,0)="^^6^6^2970717^^^^"
^DIC(19,10893,1,1,0)="This option is used to check the integrity of the LA7 MESSAGE QUEUE"
^DIC(19,10893,1,2,0)="file (#62.49). It checks that entries have the proper cross-references"
^DIC(19,10893,1,3,0)="and the cross-references point to the correct entry."
^DIC(19,10893,1,4,0)="  "
^DIC(19,10893,1,5,0)="The user can select for the option to check or fix bad entries. A"
^DIC(19,10893,1,6,0)="printed report of errors found can also be printed."
^DIC(19,10893,25)="EN^LA7CHKF"
^DIC(19,10893,"U")="LAB MESSAGING FILE INTEGRITY C"
^DIC(19,10894,0)="LA7 PRINT INTEGRITY CHECK^Print Lab Messaging Integrity Check Report^^R^11712^^^^^^^480"
^DIC(19,10894,1,0)="^^1^1^2970717^^^^"
^DIC(19,10894,1,1,0)="This option prints a Lab Mesaging Integrity Check Report."
^DIC(19,10894,25)="EN^LA7CHKFP"
^DIC(19,10894,"U")="PRINT LAB MESSAGING INTEGRITY "
^DIC(19,10895,0)="LA7S PENDING PRINT LEDI^Print LEDI Pending Orders^^R^10000000020^^^^^^^53"
^DIC(19,10895,1,0)="^19.06^8^8^3011210^^^^"
^DIC(19,10895,1,1,0)="This option is used by the host facility to print a collecting"
^DIC(19,10895,1,2,0)="facility's LEDI shipping manifest from the host facility's LAB"
^DIC(19,10895,1,3,0)="PENDING ORDERS ENTRY file (#69.6). It's used to reprint a"
^DIC(19,10895,1,4,0)="shipping manifest which is lost or damaged during shipment."
^DIC(19,10895,1,5,0)="The user is prompted for the shipping manifest number and prints"
^DIC(19,10895,1,6,0)="a barcoded shipping manifest containing all of the patients on"
^DIC(19,10895,1,7,0)="that manifest. The format is similiar to the regular shipping"
^DIC(19,10895,1,8,0)="manifest received from the collecting (shipping) facility."
^DIC(19,10895,25)="LA7SMPXL"
^DIC(19,10895,"U")="PRINT LEDI PENDING ORDERS"
^DIC(19,10896,0)="LA7S MANIFEST RETRANSMIT^Retransmit Shipping Manifest^^R^11712^^^^^^^480"
^DIC(19,10896,1,0)="^^3^3^2970829^"
^DIC(19,10896,1,1,0)="Allows user to retransmit a shipping manifest electronically to the host"
^DIC(19,10896,1,2,0)="facility. Manifest needs to be in status of ""SHIPPED"" to be able to select"
^DIC(19,10896,1,3,0)="and the shipping configuration associated with the manifest must be ""ACTIVE""."
^DIC(19,10896,25)="RETRANS^LA7SM1"
^DIC(19,10896,"U")="RETRANSMIT SHIPPING MANIFEST"
^DIC(19,10897,0)="LRLEDI^Referral Patient Multi-purpose Accession^^R^11712^^^^^^^26"
^DIC(19,10897,1,0)="^^7^7^2970717^^^^"
^DIC(19,10897,1,1,0)="This option is used to accession referral patients from another medical"
^DIC(19,10897,1,2,0)="center. The patient must already exist in the Patient file (#2) in order"
^DIC(19,10897,1,3,0)="to be selectable. The option will accession the patient into the REFERRAL"
^DIC(19,10897,1,4,0)="PATIENT file (#67) if it doesn't already exist."
^DIC(19,10897,1,5,0)=" "
^DIC(19,10897,1,6,0)="The user will be prompted or the Unique Identifier. The user will then be"
^DIC(19,10897,1,7,0)="able to order tests for that patient."
^DIC(19,10897,25)="LEDI^LRORD"
^DIC(19,10897,"U")="REFERRAL PATIENT MULTI-PURPOSE"
^DIC(19,10898,0)="LR7O AUTO RESULT NLT^Result NLT Auto Linker^^R^10000000020^^^^^^^26"
^DIC(19,10898,1,0)="^^10^10^2970717^^"
^DIC(19,10898,1,1,0)="This option assists the user in assigning Result NLT codes to Atomic"
^DIC(19,10898,1,2,0)="tests in the LABORATORY TEST file (#60). The RESULT NLT CODE is used"
^DIC(19,10898,1,3,0)="by the LEDI software to identify tests. The site receiving test"
^DIC(19,10898,1,4,0)="results uses this code to identify and link test names locally."
^DIC(19,10898,1,5,0)=" "
^DIC(19,10898,1,6,0)="The RESULT NLT CODE can only be assigned to Atomic tests and it can"
^DIC(19,10898,1,7,0)="only be assigned to a single Atomic test."
^DIC(19,10898,1,8,0)=" "
^DIC(19,10898,1,9,0)="You may choose to have the system prompt with RESULT NLT CODE or it"
^DIC(19,10898,1,10,0)="can be automatically stuffed for those having exact match of the names."
^DIC(19,10898,25)="LR7OU64"
^DIC(19,10898,"U")="RESULT NLT AUTO LINKER"
^DIC(19,10899,0)="LR7O MAN RESULT NLT^Link Result NLT Manual^^R^10000000020^^^^^^^26"
^DIC(19,10899,1,0)="^^8^8^2990119^^^"
^DIC(19,10899,1,1,0)=" This option allows the user to manually select an Atomic test and assign"
^DIC(19,10899,1,2,0)="a RESULT NLT CODE to it."
^DIC(19,10899,1,3,0)=" "
^DIC(19,10899,1,4,0)="This option can also be used to change or delete RESULT NLT CODES."
^DIC(19,10899,1,5,0)=" "
^DIC(19,10899,1,6,0)="RESULT NLT CODES are required by the LEDI software to identify test names."
^DIC(19,10899,1,7,0)="The receiving site will use the RESULT NLT CODE to link to local test"
^DIC(19,10899,1,8,0)="names."
^DIC(19,10899,25)="LR7OU641"
^DIC(19,10899,"U")="LINK RESULT NLT MANUAL"
^DIC(19,10900,0)="LR TAT URGENCY^Turnaround times By Urgency^^R^11712^^^^^^^26"
^DIC(19,10900,1,0)="^^12^12^2970717^^^^"
^DIC(19,10900,1,1,0)="This opton generates a report of the turnaround times for selected lab"
^DIC(19,10900,1,2,0)="test for selected urgencies. WKLD urgencies will be included for each"
^DIC(19,10900,1,3,0)="normal urgency selected. The report format can be specified, i.e., summary"
^DIC(19,10900,1,4,0)="report of a detailed report showing the data used to compute the"
^DIC(19,10900,1,5,0)="turnaround times."
^DIC(19,10900,1,6,0)=" "
^DIC(19,10900,1,7,0)="Hours for tours of duty can not be changed by the user. They are:"
^DIC(19,10900,1,8,0)="Regular Tour of duty :  7AM to 5Pm"
^DIC(19,10900,1,9,0)="Irregular Tour of duty: 5:01PM to 6:59AM, Saturaday, Sunday, and Holidays"
^DIC(19,10900,1,10,0)=" "
^DIC(19,10900,1,11,0)="The reports extracts data from the ACCESSION file (#68). Therefore if data"
^DIC(19,10900,1,12,0)="as been purged, no report is possible."
^DIC(19,10900,25)="LRTT5"
^DIC(19,10900,"U")="TURNAROUND TIMES BY URGENCY"
^DIC(19,10901,0)="LR ORDERED TESTS BY PHY^ORDERED TEST COST BY PROVIDER^^R^11712^^^^^^^26"
^DIC(19,10901,1,0)="^^32^32^2971125^"
^DIC(19,10901,1,1,0)="This option provides a listing of tests sorted by combination of ordering"
^DIC(19,10901,1,2,0)="providers and locations. The user can select any date range."
^DIC(19,10901,1,3,0)="The option will list for each sort criteria the test, test price/cost,"
^DIC(19,10901,1,4,0)="and urgency subtotals and totals. A detailed listing is also available."
^DIC(19,10901,1,5,0)=" "
^DIC(19,10901,1,6,0)="NOTE: This option uses the data stored in LAB ORDER ENTRY (#69) to produce"
^DIC(19,10901,1,7,0)="the report. If Orders and Accessions have been purged for the date range"
^DIC(19,10901,1,8,0)="selected, a report will not be generated. Selected date range should be"
^DIC(19,10901,1,9,0)="within the limits of stored data."
^DIC(19,10901,1,10,0)=" "
^DIC(19,10901,1,11,0)="This report can be generated using either test price or cost. The value"
^DIC(19,10901,1,12,0)="for price or cost is determined locally and the appropriate file is"
^DIC(19,10901,1,13,0)="populated with a dollar figure."
^DIC(19,10901,1,14,0)=" "
^DIC(19,10901,1,15,0)="The report's price or cost is determined by using series of fields to"
^DIC(19,10901,1,16,0)="identify the price/cost. The first field is the SP COST field (#1) or SP"
^DIC(19,10901,1,17,0)="PRICE (#2) of the SPECIMEN subfile multiple (#64.01) of the WKLD CODE file"
^DIC(19,10901,1,18,0)="(#64). If no price or cost is found, the next fields checked are the COST"
^DIC(19,10901,1,19,0)="field (#7) or COST (#8) of the File #64. If no price/cost is found in"
^DIC(19,10901,1,20,0)="these fields, the last field checked is the TEST COST field (#1) of the"
^DIC(19,10901,1,21,0)="LABORATORY TEST file (#60). Default value for PRICE/COST is $1.00."
^DIC(19,10901,1,22,0)=" "
^DIC(19,10901,1,23,0)="Depending on the sort scheme, locations can be either Hospital Location or"
^DIC(19,10901,1,24,0)="Institutions. The user is also allowed to enter FREE TEXT non-standard"
^DIC(19,10901,1,25,0)="locations. If the"
^DIC(19,10901,1,26,0)="report should contain all locations or providers, bypass the prompt for"
^DIC(19,10901,1,27,0)="specific data."
^DIC(19,10901,1,28,0)="   "
^DIC(19,10901,1,29,0)="There are several methods available to sort the data for the report."
^DIC(19,10901,1,30,0)="   "
^DIC(19,10901,1,31,0)="This report maybe useful to track tests done by hosptial locations,"
^DIC(19,10901,1,32,0)="institutions or providers."
^DIC(19,10901,25)="LRTOCOST"
^DIC(19,10901,"U")="ORDERED TEST COST BY PROVIDER"
^DIC(19,10902,0)="LRCAPD2^Workload code sorted list^^R^11712^^^^^^^26"
^DIC(19,10902,1,0)="^^3^3^2970729^"
^DIC(19,10902,1,1,0)="This option allows the user to print NLT codes from the WKLD CODE file"
^DIC(19,10902,1,2,0)="using various sort patterns. Useful to print a list of NLT codes that are"
^DIC(19,10902,1,3,0)="active at the site."
^DIC(19,10902,25)="LRCAPD2"
^DIC(19,10902,"U")="WORKLOAD CODE SORTED LIST"
^DIC(19,10903,0)="LR CAP ELROY^NLT Monthly Workload Detail^^P^11712^^^^^^^26^y"
^DIC(19,10903,1,0)="^^16^16^2980407^"
^DIC(19,10903,1,1,0)="This option can be used to obtain a report of monthly compiled data stored"
^DIC(19,10903,1,2,0)="in 'LAB MONTHLY WORKLOAD' (#67.9) file. The LAB MONTHLY WORKLOAD file"
^DIC(19,10903,1,3,0)="contains workload totals by division by WKLD CODE by month. Totals by"
^DIC(19,10903,1,4,0)="specific days are not stored in the file."
^DIC(19,10903,1,5,0)=" "
^DIC(19,10903,1,6,0)="This option is a FileMan driven search and print function. The format of"
^DIC(19,10903,1,7,0)="the report is sized to fit a 80 column printer. Because of space"
^DIC(19,10903,1,8,0)="constraints WKLD CODE names have been truncated to 30 characters."
^DIC(19,10903,1,9,0)=" "
^DIC(19,10903,1,10,0)="The report grouped by division, listing WKLD CODE number, WKLD CODE name,"
^DIC(19,10903,1,11,0)="and the month. Sub totals and totals for each month by each WKLD CODE for"
^DIC(19,10903,1,12,0)="In-Patients (INPT), Out-Patient (OUTPT), Other, Manual Entry (MANUAL) and"
^DIC(19,10903,1,13,0)="if the WKLD CODE is billable."
^DIC(19,10903,1,14,0)=" "
^DIC(19,10903,1,15,0)="This report is suitable for monthly comparison of workload a current"
^DIC(19,10903,1,16,0)="billable status."
^DIC(19,10903,10.1)="WKLD Monthly Detail"
^DIC(19,10903,60)="LRO(67.9,"
^DIC(19,10903,62)=0
^DIC(19,10903,63)="[LR CAP ELROY]"
^DIC(19,10903,64)="[LR CAP ELROY]"
^DIC(19,10903,65)=""
^DIC(19,10903,66)=""
^DIC(19,10903,"U")="NLT MONTHLY WORKLOAD DETAIL"
^DIC(19,10904,0)="ESP CONVERSION FOR ES*1*22^Conversion Management for ES*1*22^PATCH ES*1*46^R^1^^^^^^^"
^DIC(19,10904,1,0)="^^3^3^2980414^"
^DIC(19,10904,1,1,0)="This option will provide a menu item that can be assigned to appropriate"
^DIC(19,10904,1,2,0)="users responsible for POLICE & SECURITY package management in order to"
^DIC(19,10904,1,3,0)="access the conversion utilities available through ES*1*22."
^DIC(19,10904,25)="EN^ESP122PM"
^DIC(19,10904,99.1)="59023,34073"
^DIC(19,10904,"U")="CONVERSION MANAGEMENT FOR ES*1"
^DIC(19,10905,0)="LREPI PARAMETER SETUP^Lab EPI Parameter Setup^^R^1^^^^^^^26^^"
^DIC(19,10905,1,0)="^19.06^3^3^3120821^^^^"
^DIC(19,10905,1,1,0)="This option is used to define the search criteria along with additional "
^DIC(19,10905,1,2,0)="information associated with the EPI extracts.  This option only allows "
^DIC(19,10905,1,3,0)="editing.  You are not allowed to add local pathogens with this option."
^DIC(19,10905,20)=""
^DIC(19,10905,25)="EN^LREPIPI"
^DIC(19,10905,30)="LAB(69.5,"
^DIC(19,10905,31)="AEMQ"
^DIC(19,10905,40)=""
^DIC(19,10905,41)=69.5
^DIC(19,10905,"U")="LAB EPI PARAMETER SETUP"
