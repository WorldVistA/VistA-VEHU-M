^DIC(19,133,"U")="MAILMAN ECHO SERVER"
^DIC(19,134,0)="XMDXSMTP^Simple Mail Transfer Protocol^^R^11748^^^^^^^"
^DIC(19,134,1,0)="^^3^3^2850423^^"
^DIC(19,134,1,1,0)="This option allows the user to enter information directly into the"
^DIC(19,134,1,2,0)="SMTP protocol receiver from the keyboard.  See the ARPA manual for"
^DIC(19,134,1,3,0)="further description of the protocol, or type HELP during the protocol."
^DIC(19,134,25)="SMTP^XMCD"
^DIC(19,134,"U")="SIMPLE MAIL TRANSFER PROTOCOL"
^DIC(19,135,0)="XMDXPROT^Physical link protocol^^A^11748^^^^^^^^^1"
^DIC(19,135,1,0)="^^2^2^2850226^"
^DIC(19,135,1,1,0)="This message will send a line of text to the terminal, allowing the user"
^DIC(19,135,1,2,0)="to respond with the appropriate response."
^DIC(19,135,15)=""
^DIC(19,135,20)="Q"
^DIC(19,135,25)="C^XML"
^DIC(19,135,"U")="PHYSICAL LINK PROTOCOL"
^DIC(19,136,0)="XMDXSCRIPT^Script processor^^R^11748^^^^^^^"
^DIC(19,136,1,0)="^^2^2^2850424^^"
^DIC(19,136,1,1,0)="This will test a script, sending a dummy message and measuring error"
^DIC(19,136,1,2,0)="rates and transmission speeds."
^DIC(19,136,25)="TRAN^XMCD"
^DIC(19,136,"U")="SCRIPT PROCESSOR"
^DIC(19,139,0)="XMPROU^Routine load^^R^11748^^^^^^^"
^DIC(19,139,1,0)="^^2^2^2900806^^^"
^DIC(19,139,1,1,0)="This option loads routines from the routine library to the message."
^DIC(19,139,1,2,0)="Routines may be named individually, or with the traditional ""*"" notation."
^DIC(19,139,25)="LOAD^XMPH"
^DIC(19,139,"U")="ROUTINE LOAD"
^DIC(19,140,0)="XMPGLO^Global load^^R^11748^^^^^^^"
^DIC(19,140,1,0)="^^1^1^2870814^^"
^DIC(19,140,1,1,0)="This option loads data into the message from the global subtree indicated."
^DIC(19,140,25)="LOAD^XMPG"
^DIC(19,140,"U")="GLOBAL LOAD"
^DIC(19,142,0)="XMPSUM^Summarize message^^R^11748^^^^^^^"
^DIC(19,142,1,0)="^^3^3^2850226^"
^DIC(19,142,1,1,0)="This option summarizes the message, listing each packet in the package,"
^DIC(19,142,1,2,0)="along with its line number.  It does not list the contents in each packet;"
^DIC(19,142,1,3,0)="the Print option does that."
^DIC(19,142,25)="XS^XMP2"
^DIC(19,142,"U")="SUMMARIZE MESSAGE"
^DIC(19,143,0)="XMPPRT^Print message (formatted)^^R^11748^^^^^^^"
^DIC(19,143,1,0)="^^3^3^2850226^"
^DIC(19,143,1,1,0)="This option prints the message in a neatly formatted form.  Global data"
^DIC(19,143,1,2,0)="is preceded by its subscript, routines are wrapped around, and fitted one"
^DIC(19,143,1,3,0)="per page."
^DIC(19,143,25)="XP^XMP2"
^DIC(19,143,"U")="PRINT MESSAGE (FORMATTED)"
^DIC(19,144,0)="XMPINS^Install Package & Run Inits^^R^11748^^^^^^^"
^DIC(19,144,1,0)="^^3^3^2921230^^"
^DIC(19,144,1,1,0)="This option installs the package contained in the message into the active"
^DIC(19,144,1,2,0)="area.  It permanently updates the routines, globals, and files in doing"
^DIC(19,144,1,3,0)="so."
^DIC(19,144,25)="XI^XMP2"
^DIC(19,144,"U")="INSTALL PACKAGE & RUN INITS"
^DIC(19,145,0)="XMPCOM^Compare message^^R^11748^^^^^^^"
^DIC(19,145,1,0)="^^3^3^2850226^"
^DIC(19,145,1,1,0)="This option compares the message with the currently installed version of"
^DIC(19,145,1,2,0)="the package, informing the user of the differences on a line by line"
^DIC(19,145,1,3,0)="basis."
^DIC(19,145,25)="XC^XMP2"
^DIC(19,145,99.1)="55615,38578"
^DIC(19,145,"U")="COMPARE MESSAGE"
^DIC(19,146,0)="XMCHRIS^Christen a domain^^R^11748^^^^^^^54^^"
^DIC(19,146,1,0)="^^5^5^2940312^^^^"
^DIC(19,146,1,0,"LE")=1
^DIC(19,146,1,1,0)="This option is used to christen a domain, which is required"
^DIC(19,146,1,2,0)="before that domain may send or receive networked mail.  The subordinate"
^DIC(19,146,1,3,0)="domain must first be initialized with the ""initialize site"" option at the "
^DIC(19,146,1,4,0)="local domain.  Then this option must be selected in order to establish the"
^DIC(19,146,1,5,0)="network relationship."
^DIC(19,146,25)="CHRISTEN^XMUDCHR"
^DIC(19,146,99)="55475,28244"
^DIC(19,146,"U")="CHRISTEN A DOMAIN"
^DIC(19,148,0)="XMPRECV^Package recieved^^M^11748^^^^^^^"
^DIC(19,148,1,0)="^^1^1^2850628^"
^DIC(19,148,1,1,0)="This menu will let you print, compare, and load an packman message."
^DIC(19,148,10,0)="^19.01PI^4^4"
^DIC(19,148,10,1,0)="145^"
^DIC(19,148,10,2,0)="143^"
^DIC(19,148,10,3,0)="142^"
^DIC(19,148,10,4,0)="144^"
^DIC(19,148,10,"B",142,3)=""
^DIC(19,148,10,"B",143,2)=""
^DIC(19,148,10,"B",144,4)=""
^DIC(19,148,10,"B",145,1)=""
^DIC(19,148,99)="59254,80393"
^DIC(19,148,"U")="PACKAGE RECIEVED"
^DIC(19,149,0)="XMPACK^Load PackMan Message^^R^11748^XUPROGMODE^3462^^^^^54^^1^1^"
^DIC(19,149,1,0)="^^1^1^2971002^^^^"
^DIC(19,149,1,1,0)="Enables the user to create a PackMan message."
^DIC(19,149,15)="D CHECKOUT^XM"
^DIC(19,149,20)="D CHECKIN^XM"
^DIC(19,149,25)="PAKMAN^XMJMS"
^DIC(19,149,99)="54082,25317"
^DIC(19,149,99.1)="54447,33482"
^DIC(19,149,"U")="LOAD PACKMAN MESSAGE"
^DIC(19,150,0)="XQOPTFIX^Fix Option File Pointers^^A^1039^^^^^^^^^1^^"
^DIC(19,150,1,0)="^^2^2^2871204^^"
^DIC(19,150,1,1,0)="This option scans thru the option file for dangling pointers.  It deletes"
^DIC(19,150,1,2,0)="menu items which point to options that no longer exist."
^DIC(19,150,20)="S %=1 D ENASK^XQ3"
^DIC(19,150,"U")="FIX OPTION FILE POINTERS"
^DIC(19,151,0)="XMPOLL^POLL REMOTE NODES^^R^11748^^^^^^^54^^"
^DIC(19,151,1,0)="^19.06^17^17^3020508^^^^"
^DIC(19,151,1,1,0)="The poller schedules tasks to transmit to domains whose flags contain a 'P'. "
^DIC(19,151,1,2,0)="The tasks will play scripts to those domains whether or not there are messages"
^DIC(19,151,1,3,0)="in the queues for those domains.  The TURN command (assuming it isn't disabled"
^DIC(19,151,1,4,0)="(field 1.7 of file 4.2) will ""pull"" any messages queued at that domain waiting"
^DIC(19,151,1,5,0)="to be transmitted to this one."
^DIC(19,151,1,6,0)=""
^DIC(19,151,1,7,0)="One of the FLAGS (file 4.2, field 1) that can be set for a particular domain"
^DIC(19,151,1,8,0)="is 'P' for poller.  If FLAGS includes a 'P', the domain will be polled."
^DIC(19,151,1,9,0)=""
^DIC(19,151,1,10,0)="XMPOLL can be scheduled through 'Schedule Tasks' on the Taskman menu.  Set a"
^DIC(19,151,1,11,0)="time for transmission such as an off-peak evening hour.  The device for output"
^DIC(19,151,1,12,0)="may be null, the default being the device on which the Taskman was started."
^DIC(19,151,1,13,0)="Rescheduling frequency may also be null.  XMPOLL will then open the link for"
^DIC(19,151,1,14,0)="transmission at the designated time."
^DIC(19,151,1,15,0)=""
^DIC(19,151,1,16,0)="Playing a script will also open the link.  So, domains with 'P' and without"
^DIC(19,151,1,17,0)="'S' flags can be transmitted by playing the script to them."
^DIC(19,151,2)="n"
^DIC(19,151,25)="POLL^XMCP"
^DIC(19,151,200)="^^"
^DIC(19,151,200.9)="y"
^DIC(19,151,"U")="POLL REMOTE NODES"
^DIC(19,152,0)="XMSUBEDIT^Subroutine editor^^R^11748^^^^^^^54^^^^"
^DIC(19,152,1,0)="^19.06^1^1^3020312^^^"
^DIC(19,152,1,1,0)="This option edits transmission script subroutines in file 4.6."
^DIC(19,152,15)=""
^DIC(19,152,20)=""
^DIC(19,152,25)="EDIT46^XMCE"
^DIC(19,152,"U")="SUBROUTINE EDITOR"
^DIC(19,153,0)="XMQSHOW^Show a queue^^R^11748^^^^^^y^54^^^^"
^DIC(19,153,1,0)="^19.06^1^1^3020312^^^^"
^DIC(19,153,1,1,0)="Show all of the messages waiting transmission for a given queue."
^DIC(19,153,15)=""
^DIC(19,153,20)=""
^DIC(19,153,25)="SHOWQ^XMCQ"
^DIC(19,153,"U")="SHOW A QUEUE"
^DIC(19,155,0)="XMSTARTQUE^Transmit a Single Queue^^R^11748^^3494^^^^^54^^"
^DIC(19,155,1,0)="^19.06^6^6^3020312^^^^"
^DIC(19,155,1,1,0)="If messages are queued in the Postmaster box for a given domain, that"
^DIC(19,155,1,2,0)="domain can begin transmitting those messages by invoking this option."
^DIC(19,155,1,3,0)="Messages may be sitting in a queue for a variety of reasons (transmission"
^DIC(19,155,1,4,0)="failure, waiting for poller to run, etc.).  This option will attempt"
^DIC(19,155,1,5,0)="to send these messages by creating a taskmanager job which will deliver"
^DIC(19,155,1,6,0)="the messages for the domain requested."
^DIC(19,155,25)="Q1^XMCX"
^DIC(19,155,"U")="TRANSMIT A SINGLE QUEUE"
