^DIC(19,10139,0)="ENWOMULTI^Multiple Work Order Entry^^R^11596^^^^^^^33"
^DIC(19,10139,1,0)="^^8^8^2950215^"
^DIC(19,10139,1,1,0)="Create (and optionally close) multiple work orders for equipment. First a"
^DIC(19,10139,1,2,0)="new work order is entered in full and then additional equipment is"
^DIC(19,10139,1,3,0)="selected. Equipment can be selected by equipment category, manufacturer,"
^DIC(19,10139,1,4,0)="and/or model. Alternatively, equipment can be individually specified. The"
^DIC(19,10139,1,5,0)="computer will create new work orders for each selected equipment item by"
^DIC(19,10139,1,6,0)="copying the original work order. Equipment specific data on the work"
^DIC(19,10139,1,7,0)="orders (e.g. location, serial number, etc.) will be obtained from the"
^DIC(19,10139,1,8,0)="equipment file."
^DIC(19,10139,25)="ENWOME"
^DIC(19,10139,"U")="MULTIPLE WORK ORDER ENTRY"
