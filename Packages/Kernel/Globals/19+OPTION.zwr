^DIC(19,4328,1,0)="^^4^4^2890524^^^"
^DIC(19,4328,1,1,0)="This option allows the user to remove a code sheet from a batch prior to"
^DIC(19,4328,1,2,0)="transmission and it adjusts the Batch Header Code Sheet accordingly.  This"
^DIC(19,4328,1,3,0)="option must be used first when moving a code sheet from one batch to"
^DIC(19,4328,1,4,0)="another."
^DIC(19,4328,25)="DELETE^PRCFALOG"
^DIC(19,4328,"U")="DELETE CODE SHEET FROM PRINTED"
