^DIC(19,9129,"U")="HEALTH SUMMARY OVERALL MENU"
^DIC(19,9130,0)="GMTS HS BY PATIENT & VISIT^Visit Patient Health Summary^^R^11597^^^^^^^160^^1^1"
^DIC(19,9130,1,0)="^^8^8^2951019^^"
^DIC(19,9130,1,1,0)="Generates Health Summaries of a specified pre-defined Health Summary Type"
^DIC(19,9130,1,2,0)="for multiple patients. After a patient is selected, the user can pick an"
^DIC(19,9130,1,3,0)="outpatient visit (based on the VISIT File) or an inpatient hospital"
^DIC(19,9130,1,4,0)="admission (based on the Patient Movement file). If the Patient Care"
^DIC(19,9130,1,5,0)="Encounter (PCE) package isn't installed then the user can only choose an"
^DIC(19,9130,1,6,0)="inpatient visit. Data for summaries is based on a date range from the"
^DIC(19,9130,1,7,0)="outpatient visit or inpatient admission. This Date Range overrides Time"
^DIC(19,9130,1,8,0)="Limits for components which allows this option."
^DIC(19,9130,15)="K GMTSPXGO"
^DIC(19,9130,20)="K ORVP S GMTSPXGO=1"
^DIC(19,9130,25)="GMTS"
^DIC(19,9130,"U")="VISIT PATIENT HEALTH SUMMARY"
^DIC(19,9131,0)="GMTS HS FOR ALL CLINICS^Batch Print of All Clinics by Visit Date^^R^.5^^^^^^^160"
^DIC(19,9131,1,0)="^^8^8^2950816^"
^DIC(19,9131,1,1,0)="Allows user to interactively designate the batch print of all health"
^DIC(19,9131,1,2,0)="summaries for patients with appointments at all outpatient clinics on a"
^DIC(19,9131,1,3,0)="selected day. Summaries will be printed at the print device designated for"
^DIC(19,9131,1,4,0)="that clinic in the Location Parameters. This option is an alternate method"
^DIC(19,9131,1,5,0)="to designate when summaries should be printed for all clinics. The nightly"
^DIC(19,9131,1,6,0)="batch job that prints summaries for wards, clinics and operating rooms"
^DIC(19,9131,1,7,0)="probably should be disable if the user wants to uses this option on a"
^DIC(19,9131,1,8,0)="daily basis."
^DIC(19,9131,25)="MAIN^GMTSPCD"
^DIC(19,9131,"U")="BATCH PRINT OF ALL CLINICS BY "
^DIC(19,9132,0)="GMTS HS BY PATIENT & DATE RANG^Range of Dates Patient Health Summary^^R^11597^^^^^^^160^^1^1"
^DIC(19,9132,1,0)="^^5^5^2950816^^^^"
^DIC(19,9132,1,1,0)="Generates Health Summaries of a specified pre-defined Health"
^DIC(19,9132,1,2,0)="Summary Type for multiple patients. After patients are selected."
^DIC(19,9132,1,3,0)="the user can pick a date range. Data for summaries is based on"
