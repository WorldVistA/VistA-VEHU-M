^DIC(19,11491,0)="PXRM DEFINITION EDIT^Add/Edit Reminder Definition^^R^10000000020^^^^^^^534^^^"
^DIC(19,11491,1,0)="^19.06^18^18^3020520^^^"
^DIC(19,11491,1,1,0)="This option is used to edit the Clinical Reminder Definitions. Several"
^DIC(19,11491,1,2,0)="predefined reminder definitions were distributed with the PCE package"
^DIC(19,11491,1,3,0)="based on the Ambulatory Care EP Preventative Health Maintenance"
^DIC(19,11491,1,4,0)="Guidelines."
^DIC(19,11491,1,5,0)=" "
^DIC(19,11491,1,6,0)="Nationally distributed reminder definitions items all have a ""VA-"""
^DIC(19,11491,1,7,0)="prefix. VA- for Ambulatory Care EP reminders and VA-* for National"
^DIC(19,11491,1,8,0)="Center for Health Promotion reminders. To alter a VA- prefixed reminder"
^DIC(19,11491,1,9,0)="item, first copy it to a different name and then edit the reminder"
^DIC(19,11491,1,10,0)="definition to reflect your site's requirements for the reminder."
^DIC(19,11491,1,11,0)=" "
^DIC(19,11491,1,12,0)="Sites may change anything in a local reminder definition to meet their"
^DIC(19,11491,1,13,0)="needs. Findings at each site may require modification to represent"
^DIC(19,11491,1,14,0)="local use of clinical data."
^DIC(19,11491,1,15,0)=" "
^DIC(19,11491,1,16,0)="The distributed reminder definitions ""Technical Description"" will give"
^DIC(19,11491,1,17,0)="help to the coordinator for ensuring the reminder definition is"
^DIC(19,11491,1,18,0)="modified to reflect local guidelines for reminders."
^DIC(19,11491,15)=""
^DIC(19,11491,20)=""
^DIC(19,11491,25)="EEDIT^PXRMREDT"
^DIC(19,11491,30)=""
^DIC(19,11491,31)=""
^DIC(19,11491,33)=""
^DIC(19,11491,34)=""
^DIC(19,11491,50)=""
^DIC(19,11491,51)=""
^DIC(19,11491,"U")="ADD/EDIT REMINDER DEFINITION"
^DIC(19,11492,0)="PXRM DEFINITION INQUIRY^Inquire about Reminder Definition^^R^10000000020^^^^^^y^534"
^DIC(19,11492,1,0)="^19.06^2^2^3040506^^^^"
^DIC(19,11492,1,1,0)="Allows a user to display a clinical reminder definition in an easy"
^DIC(19,11492,1,2,0)="to read format."
^DIC(19,11492,25)="REM^PXRMINQ"
^DIC(19,11492,"U")="INQUIRE ABOUT REMINDER DEFINIT"
^DIC(19,11493,0)="PXRM DEFINITION COPY^Copy Reminder Definition^^R^10000000020^^^^^^^534"
^DIC(19,11493,1,0)="^19.06^11^11^3000608^^^^"
^DIC(19,11493,1,1,0)="This option allows the user to copy an existing reminder definition"
^DIC(19,11493,1,2,0)="into a new reminder definition in the Clinical Reminder Definition file"
^DIC(19,11493,1,3,0)="(#811.9). The original reminder definition to be copied is selected"
^DIC(19,11493,1,4,0)="first.  If the original reminder definition is prefixed with ""VA-"", the"
^DIC(19,11493,1,5,0)="""VA-"" will be stripped off the name automatically to create the name"
^DIC(19,11493,1,6,0)="for the new reminder definition. The new name must be unique.  If the"
^DIC(19,11493,1,7,0)="new name is not unique, the user must enter a unique name for the new"
^DIC(19,11493,1,8,0)="reminder definition entry. If no name is provided, the new entry will"
^DIC(19,11493,1,9,0)="not be created.  Once a new name is defined for the new reminder"
^DIC(19,11493,1,10,0)="definition, the new reminder definition can be edited to reflect the"
^DIC(19,11493,1,11,0)="local reminder definition."
^DIC(19,11493,25)="COPYREM^PXRMCOPY"
^DIC(19,11493,"U")="COPY REMINDER DEFINITION"
^DIC(19,11494,0)="PXRM REMINDERS DUE^Reminders Due Report^^R^1^^^^^^^534^^"
^DIC(19,11494,1,0)="^19.06^19^19^3051103^^^^"
^DIC(19,11494,1,1,0)="For a selected reminder the report lists any reminders which are currently "
^DIC(19,11494,1,2,0)="due. Available report options are: "
^DIC(19,11494,1,3,0)=" "
^DIC(19,11494,1,4,0)="- Individual Patient"
^DIC(19,11494,1,5,0)="- Reminder Patient List"
^DIC(19,11494,1,6,0)="- Hospital Location  (all patients with encounters)"
^DIC(19,11494,1,7,0)="- OE/RR Team (all patients in team)"
^DIC(19,11494,1,8,0)="- PCMM Provider (all practitioner patients)"
^DIC(19,11494,1,9,0)="- PCMM Team (all patients in team)"
^DIC(19,11494,1,10,0)=" "
^DIC(19,11494,1,11,0)="A SUMMARY report  displays totals of how many patients of those selected "
^DIC(19,11494,1,12,0)="have reminders due. "
^DIC(19,11494,1,13,0)=" "
^DIC(19,11494,1,14,0)="Alternatively, a DETAILED report displays patients with reminders due in "
^DIC(19,11494,1,15,0)="alphabetical order. The report displays for each patient the date the "
^DIC(19,11494,1,16,0)="reminder is due, the date the reminder was last done and next appointment "
^DIC(19,11494,1,17,0)="date. The detailed report also (optionally) lists all future appointments."
^DIC(19,11494,1,18,0)=" "
^DIC(19,11494,1,19,0)="DETAILED reports may be saved as a local patient list."
^DIC(19,11494,20)=""
^DIC(19,11494,25)="PXRMXD"
^DIC(19,11494,99)="60096,35982"
^DIC(19,11494,"U")="REMINDERS DUE REPORT"
^DIC(19,11495,0)="PXRM RESOLUTION EDIT/INQUIRE^Reminder Resolution Statuses^^R^10000000020^^^^^^^534"
^DIC(19,11495,1,0)="^^1^1^2990805^^"
^DIC(19,11495,1,1,0)="This option lists the hierarchy of resolution status values used by CPRS."
^DIC(19,11495,25)="PXRMRESN"
^DIC(19,11495,"U")="REMINDER RESOLUTION STATUSES"
^DIC(19,11496,0)="PXRM CATEGORY EDIT/INQUIRE^Add/Edit Reminder Categories^^R^10000000020^^^^^^^534"
^DIC(19,11496,1,0)="^^4^4^2991202^"
^DIC(19,11496,1,1,0)="Reminder categories used by CPRS GUI may be added or changed."
^DIC(19,11496,1,2,0)=" "
^DIC(19,11496,1,3,0)="A reminder category may contain a list of reminders and/or other"
^DIC(19,11496,1,4,0)="sub-categories."
^DIC(19,11496,25)="PXRMCAT"
^DIC(19,11496,"U")="ADD/EDIT REMINDER CATEGORIES"
^DIC(19,11497,0)="PXRM PARAMETER EDIT^Edit Finding Parameters^^E^10000000020^^^^^^^534^^1^1"
^DIC(19,11497,1,0)="^19.06^2^2^3021205^^^^"
^DIC(19,11497,1,1,0)="This option is used to modify the finding parameter file which used in the"
^DIC(19,11497,1,2,0)="option 'Create Dialog from Reminder Definition'."
^DIC(19,11497,15)="K DLAYGO"
^DIC(19,11497,20)="K DLAYGO"
^DIC(19,11497,30)="PXRMD(801.45,"
^DIC(19,11497,31)="AEMQ"
^DIC(19,11497,32)="Select FINDING TYPE to edit:"
