^DIC(19,3210,0)="DVB HSUSP-UTILITY^Utilities for Suspense File^^M^.5^DVBHINQ^^^^^^"
^DIC(19,3210,1,0)="^^3^3^2920310^^^^"
^DIC(19,3210,1,1,0)="This option is the main menu for the suspense file utility functions."
^DIC(19,3210,1,2,0)="Seven functions are available through this option including printing"
^DIC(19,3210,1,3,0)="and purging suspense file entries and editing suspense file parameters."
^DIC(19,3210,10,0)="^19.01PI^10^7"
^DIC(19,3210,10,3,0)="3211^"
^DIC(19,3210,10,4,0)="3212^"
^DIC(19,3210,10,6,0)="3213^"
^DIC(19,3210,10,7,0)="3216^"
^DIC(19,3210,10,8,0)="4470^"
^DIC(19,3210,10,9,0)="4464^"
^DIC(19,3210,10,10,0)="5923^"
^DIC(19,3210,10,"B",3211,3)=""
^DIC(19,3210,10,"B",3212,4)=""
^DIC(19,3210,10,"B",3213,6)=""
^DIC(19,3210,10,"B",3216,7)=""
^DIC(19,3210,10,"B",4464,9)=""
^DIC(19,3210,10,"B",4470,8)=""
^DIC(19,3210,10,"B",5923,10)=""
^DIC(19,3210,31)=""
^DIC(19,3210,99)="55726,42062"
^DIC(19,3210,"U")="UTILITIES FOR SUSPENSE FILE"
^DIC(19,3211,0)="DVB HSUSP-EDPARAMETERS^Edit HINQ Suspense File Parameters^^R^.5^^^^^^^"
^DIC(19,3211,1,0)="^^2^2^2920205^^^^"
^DIC(19,3211,1,1,0)="This suspense file utility option allows users who are holders of"
^DIC(19,3211,1,2,0)="the HINQ security key to view and edit sixteen HINQ parameters."
^DIC(19,3211,25)="EDIT^DVBHQTM"
^DIC(19,3211,30)=""
^DIC(19,3211,31)=""
^DIC(19,3211,36)=""
^DIC(19,3211,50)=""
^DIC(19,3211,51)=""
^DIC(19,3211,"U")="EDIT HINQ SUSPENSE FILE PARAME"
^DIC(19,3212,0)="DVB HNET-WORK^Network Enable/Disable^^M^.5^^^^^^^"
^DIC(19,3212,1,0)="^^12^12^2920117^^^^"
^DIC(19,3212,1,1,0)="This option enables/disables the options which allow the user to"
^DIC(19,3212,1,2,0)="transmit HINQ requests, 'PROCESS THE HINQ SUSPENSE FILE' and "
^DIC(19,3212,1,3,0)="'GENERATE A HINQ REQUEST'."
^DIC(19,3212,1,4,0)=" "
^DIC(19,3212,1,5,0)="The network is disabled automatically during VBA computer non-workday"
^DIC(19,3212,1,6,0)="hours.  It should also be disabled if there are known problems with"
^DIC(19,3212,1,7,0)="the communication link as indicated by failure of the HINQ"
^DIC(19,3212,1,8,0)="transaction test.  Network error messages also indicate a "
^DIC(19,3212,1,9,0)="transmission problem so the network should be disabled."
^DIC(19,3212,1,10,0)=" "
^DIC(19,3212,1,11,0)="This option merely disables the transmitting functions and not"
^DIC(19,3212,1,12,0)="actually the DHCP-IDCU link."
^DIC(19,3212,10,0)="^19.01PI^2^2"
^DIC(19,3212,10,1,0)="3214^"
^DIC(19,3212,10,2,0)="3215^"
^DIC(19,3212,10,"B",3214,1)=""
^DIC(19,3212,10,"B",3215,2)=""
^DIC(19,3212,20)=""
^DIC(19,3212,30)=""
^DIC(19,3212,31)=""
^DIC(19,3212,33)=""
^DIC(19,3212,50)=""
^DIC(19,3212,51)=""
^DIC(19,3212,99)="55726,42019"
^DIC(19,3212,"U")="NETWORK ENABLE/DISABLE"
^DIC(19,3213,0)="DVB HSUSP-PURGEFILE^Purge Suspense File (retain 30 days)^^A^.5^^^^^^^^^1"
^DIC(19,3213,1,0)="^^4^4^2960222^"
^DIC(19,3213,1,1,0)="This suspense file utility function allows users who are holders"
^DIC(19,3213,1,2,0)="of the HINQ key to delete entries in the suspense file.  All entries"
^DIC(19,3213,1,3,0)="whose last status update date is before the last 30 days will be"
^DIC(19,3213,1,4,0)="deleted."
^DIC(19,3213,20)="D ASK^DVBHQPU Q:'$D(DVBSTOP)  K DVBSTOP D 30^DVBHQPU"
^DIC(19,3213,25)=""
^DIC(19,3213,200)="^89"
^DIC(19,3213,"U")="PURGE SUSPENSE FILE (RETAIN 30"
^DIC(19,3214,0)="DVB HNET-ENABLE^Enable HINQ Network^^A^.5^^^^^^^^^1"
^DIC(19,3214,1,0)="^^3^3^2920117^^^^"
^DIC(19,3214,1,1,0)="This option enables the HINQ options which allow the user to transmit"
^DIC(19,3214,1,2,0)="requests to the VBA computer, 'PROCESS THE HINQ SUSPENSE FILE' and"
^DIC(19,3214,1,3,0)="'GENERATE A HINQ REQUEST', and 'INDIVIDUAL HINQ REQUESTS'."
^DIC(19,3214,20)="D UP^DVBHQTM"
^DIC(19,3214,30)=""
^DIC(19,3214,50)=""
^DIC(19,3214,51)=""
^DIC(19,3214,99)="55587,50277"
^DIC(19,3214,"U")="ENABLE HINQ NETWORK"
^DIC(19,3215,0)="DVB HNET-DISABLE^Disable HINQ Network^^A^.5^^^^^^^^^1"
^DIC(19,3215,1,0)="^^4^4^2920117^^^^"
^DIC(19,3215,1,1,0)="This option should be selected to disable the HINQ options which"
^DIC(19,3215,1,2,0)="allow the user to transmit HINQ requests to the VBA computer, 'PROCESS"
^DIC(19,3215,1,3,0)="THE HINQ SUSPENSE FILE' and 'GENERATE A HINQ REQUEST',"
^DIC(19,3215,1,4,0)="and 'INDIVIDUAL HINQ REQUEST'."
^DIC(19,3215,20)="D DOWN^DVBHQTM"
^DIC(19,3215,30)=""
^DIC(19,3215,50)=""
^DIC(19,3215,51)=""
^DIC(19,3215,"U")="DISABLE HINQ NETWORK"
^DIC(19,3216,0)="DVB HSUSP-SELVIEWFILE^Select View Suspense File^^R^.5^^^^^^^"
^DIC(19,3216,1,0)="^^3^3^2920117^^^^"
^DIC(19,3216,1,1,0)="This utility function allows users who are holders of the"
^DIC(19,3216,1,2,0)="HINQ security key to view the HINQ suspense file by suspense"
^DIC(19,3216,1,3,0)="file status, (PENDING, NEW, ERROR, or IDCU)."
^DIC(19,3216,25)="DVBHQSE"
^DIC(19,3216,"U")="SELECT VIEW SUSPENSE FILE"
^DIC(19,3217,0)="DVB HREQ-TRANSTEST^HINQ Transaction Test^^R^.5^^^^^^^"
^DIC(19,3217,1,0)="^^3^3^2920117^^^^"
^DIC(19,3217,1,1,0)="This option sends a test HINQ request to the remote VBA computer"
^DIC(19,3217,1,2,0)="and returns to the sender with an error message from the remote"
^DIC(19,3217,1,3,0)="computer:   Error in social security number"
^DIC(19,3217,25)="DVBHQDX"
^DIC(19,3217,99)="55566,30504"
^DIC(19,3217,"U")="HINQ TRANSACTION TEST"
^DIC(19,3218,0)="DVB HREQ-INDIVHREQ^Individual HINQ Request^DO NOT USE!! - HINQ DECOM - DVB*4.0*71^A^.5^DVBHINQ^^^^^^^^1^1"
^DIC(19,3218,1,0)="^^8^8^2920117^^^^"
^DIC(19,3218,1,1,0)="This option allows the user to access the VBA computer"
^DIC(19,3218,1,2,0)="directly and request a HINQ.  Access to VBA is through the"
^DIC(19,3218,1,3,0)="DHCP-IDCU network.  The HINQ response"
^DIC(19,3218,1,4,0)="will return within 20 seconds formatted on the screen"
^DIC(19,3218,1,5,0)="the same as the HINQ response mail message. The response"
^DIC(19,3218,1,6,0)="will also be sent to the IN basket of the requestor, the"
^DIC(19,3218,1,7,0)="HINQ mail group, and users with the DVBHINQ key who have"
^DIC(19,3218,1,8,0)="requested a HINQ in the Suspense file."
^DIC(19,3218,15)="K DVBSTOP"
^DIC(19,3218,20)="D EN^DVBHQTM D:'$D(DVBSTOP) ^DVBHQDL"
^DIC(19,3218,25)=""
^DIC(19,3218,"U")="INDIVIDUAL HINQ REQUEST"
^DIC(19,3219,0)="DVB HSUSP-PROCESSFILE^Process the HINQ Suspense File^DO NOT USE!! - HINQ DECOM - DVB*4.0*71^A^.5^DVBHINQ^^^^^^^^1^1"
^DIC(19,3219,1,0)="^^7^7^2921102^^^^"
^DIC(19,3219,1,1,0)="This option queues a TaskMan job which logs onto the remote"
^DIC(19,3219,1,2,0)="VBA computer via the DHCP-IDCU and generates"
^DIC(19,3219,1,3,0)="HINQ requests for all 'P'ending entries in the suspense file."
^DIC(19,3219,1,4,0)=" "
^DIC(19,3219,1,5,0)="HINQ responses will go to the person who requested the Batch"
^DIC(19,3219,1,6,0)="process, members of the DVBHINQ mail group, and requestors"
^DIC(19,3219,1,7,0)="in the Suspense file with the DVBHINQ key"
^DIC(19,3219,15)="K DVBSTOP"
^DIC(19,3219,20)="D EN^DVBHQTM I '$D(DVBSTOP) W:'$P(^DVB(395,1,""HQ""),U,5) !,""Batch processing disabled "" I $P(^(""HQ""),U,5) D ^DVBHQDB"
^DIC(19,3219,25)=""
^DIC(19,3219,"U")="PROCESS THE HINQ SUSPENSE FILE"
^DIC(19,3220,0)="DVB HMENU-USER^HINQ User Menu (Version 4.0)^^M^.5^^^^^^^"
^DIC(19,3220,1,0)="^^3^3^2920117^^^^"
^DIC(19,3220,1,1,0)="This is the limited HINQ Menu for the general user.  It does not contain"
^DIC(19,3220,1,2,0)="all the HINQ options available with this package.  Options in this menu"
^DIC(19,3220,1,3,0)="will be displayed based on the security held by the user."
^DIC(19,3220,10,0)="^19.01PI^7^7"
^DIC(19,3220,10,1,0)="3218^"
^DIC(19,3220,10,2,0)="3208^"
^DIC(19,3220,10,3,0)="3219^"
^DIC(19,3220,10,4,0)="3207^"
^DIC(19,3220,10,5,0)="3206^"
^DIC(19,3220,10,6,0)="3221^"
^DIC(19,3220,10,7,0)="3209^"
^DIC(19,3220,10,"B",3206,5)=""
^DIC(19,3220,10,"B",3207,4)=""
^DIC(19,3220,10,"B",3208,2)=""
^DIC(19,3220,10,"B",3209,7)=""
^DIC(19,3220,10,"B",3218,1)=""
^DIC(19,3220,10,"B",3219,3)=""
^DIC(19,3220,10,"B",3221,6)=""
^DIC(19,3220,99)="66286,41999"
^DIC(19,3220,"U")="HINQ USER MENU (VERSION 4.0)"
^DIC(19,3221,0)="DVB HREQ-GENERHREQ^Generate HINQ Requests^DO NOT USE!! - HINQ DECOM - DVB*4.0*71^A^.5^DVBHINQ^^^^^^^^1^1"
^DIC(19,3221,1,0)="^^3^3^2920311^^^^"
^DIC(19,3221,1,1,0)=" This option allows multiple selection of patient names followed"
^DIC(19,3221,1,2,0)=" by input of the HINQ password for transmission of HINQ requests"
^DIC(19,3221,1,3,0)=" to VBA."
^DIC(19,3221,15)="K DVBSTOP"
^DIC(19,3221,20)="D EN^DVBHQTM D:'$D(DVBSTOP) HINQ^DVBHQZ4"
^DIC(19,3221,"U")="GENERATE HINQ REQUESTS"
^DIC(19,3222,0)="DENTTYPE^Type of Service Report^^R^.5^^^^^^^"
^DIC(19,3222,1,0)="^^1^1^2881101^^^^"
^DIC(19,3222,1,1,0)="Prints/displays all information in the Type of Service file."
^DIC(19,3222,25)="TOS^DENTP1"
^DIC(19,3222,"U")="TYPE OF SERVICE REPORT"
^DIC(19,3223,0)="DENTRELEASE ALL^Release All Service Reports^DAS turned off^R^.5^^^^^^^"
^DIC(19,3223,1,0)="^^1^1^2881101^^^^"
^DIC(19,3223,1,1,0)="Release all valid Service reports without reviewing the data on the screen."
^DIC(19,3223,25)="DENTARA"
^DIC(19,3223,200.9)=""
^DIC(19,3223,"U")="RELEASE ALL SERVICE REPORTS"
^DIC(19,3224,0)="DENTDUP^Check Duplicate Sittings^^R^.5^^^^^^^"
^DIC(19,3224,1,0)="^^2^2^2881101^^^^"
^DIC(19,3224,1,1,0)="Checks the treatment data file for duplicate records and prints a list"
^DIC(19,3224,1,2,0)="of any discrepancies found."
^DIC(19,3224,25)="DENTDUP"
^DIC(19,3224,"U")="CHECK DUPLICATE SITTINGS"
^DIC(19,3225,0)="DENT SERVICE TAPE^Generate Monthly Dental Service Tape^DAS turned off^R^.5^^^^^^^"
^DIC(19,3225,1,0)="^^3^3^2881101^^^^"
^DIC(19,3225,1,1,0)="Generates a Dental Service tape from data stored in the ^UTILITY(""DENTV"""
^DIC(19,3225,1,2,0)="global. Tape is in standard IBM format.  The tape is then mailed to"
^DIC(19,3225,1,3,0)="Austin, TX DPC."
^DIC(19,3225,25)="DENTAT"
^DIC(19,3225,200.9)=""
^DIC(19,3225,"U")="GENERATE MONTHLY DENTAL SERVICE TAPE"
^DIC(19,3226,0)="DENT SERVICE DELETE^Delete Dental Service (Temporary) Global^DAS turned off^R^.5^^58^^^^^"
^DIC(19,3226,1,0)="^^5^5^2901217^^^^"
^DIC(19,3226,1,1,0)="Delete the ^UTILITY(""DENTV"" global after the monthly Dental Service tape"
^DIC(19,3226,1,2,0)="has been produced.  A new global is then built as the dental application"
^DIC(19,3226,1,3,0)="coordinator releases Dental Service data during the month.  This option"
^DIC(19,3226,1,4,0)="must be run after a tape has been produced and before the dental"
^DIC(19,3226,1,5,0)="coordinator begins releasing data for the next month."
^DIC(19,3226,10,0)="^19.01IP^0^0"
^DIC(19,3226,25)="ATDEL^DENTE3"
^DIC(19,3226,200.9)=""
^DIC(19,3226,"U")="DELETE DENTAL SERVICE (TEMPORARY) GLOBAL"
^DIC(19,3227,0)="DENT SERVICE REPORTS^Service Reports^^M^.5^^^^^^^^^^1"
^DIC(19,3227,1,0)="^^2^2^2881101^"
^DIC(19,3227,1,1,0)="Menu containing all service report options: Treatment Data, Personnel Info,"
^DIC(19,3227,1,2,0)="Class I-VI Admin Info, Applications and Dental Fee and Non Clinical Time."
^DIC(19,3227,10,0)="^19.01PI^8^5"
^DIC(19,3227,10,1,0)="187^2"
^DIC(19,3227,10,5,0)="172^3"
^DIC(19,3227,10,6,0)="177^1"
^DIC(19,3227,10,7,0)="176^5"
^DIC(19,3227,10,8,0)="214^4"
^DIC(19,3227,10,"B",172,5)=""
^DIC(19,3227,10,"B",176,7)=""
^DIC(19,3227,10,"B",177,6)=""
^DIC(19,3227,10,"B",187,1)=""
^DIC(19,3227,10,"B",214,8)=""
^DIC(19,3227,10,"C",1,6)=""
^DIC(19,3227,10,"C",2,1)=""
^DIC(19,3227,10,"C",3,5)=""
^DIC(19,3227,10,"C",4,8)=""
^DIC(19,3227,10,"C",5,7)=""
^DIC(19,3227,15)="D EXIT^DENTA"
^DIC(19,3227,99)="60619,50213"
^DIC(19,3227,"U")="SERVICE REPORTS"
^DIC(19,3228,0)="DENTTREAT LINE EDIT^Treatment Data Enter/Edit (Line By Line)^DAS turned off^R^.5^^^^^^^"
^DIC(19,3228,1,0)="^^1^1^2881101^^^^"
^DIC(19,3228,1,1,0)="Enter/edit Treatment Data using a line editor on a CRT."
^DIC(19,3228,10,0)="^19.01IP^0^0"
^DIC(19,3228,25)="TREAT^DENTE1"
^DIC(19,3228,200.9)=""
^DIC(19,3228,"U")="TREATMENT DATA ENTER/EDIT (LINE BY LINE)"
^DIC(19,3229,0)="DENTTREATM RE-RELEASE ^Enable Edit/Re-Release of Treatment Data (Line)^^R^.5^^^^^^^"
^DIC(19,3229,1,0)="^^1^1^2881101^^^^"
^DIC(19,3229,1,1,0)="Review/edit dental Treatment Data using a line editor."
^DIC(19,3229,25)="TDRR^DENTE2"
^DIC(19,3229,"U")="ENABLE EDIT/RE-RELEASE OF TREATMENT DATA (LINE)"
^DIC(19,3230,0)="DENTCDR^Cost Distribution Report^DAS turned off^R^.5^^^^^^^"
^DIC(19,3230,1,0)="^^2^2^2881101^^^^"
^DIC(19,3230,1,1,0)="This routine runs the Dental Cost Distribution Report.  This report is used"
^DIC(19,3230,1,2,0)="to provide Fiscal Service with information for distributing Dental costs."
^DIC(19,3230,25)="DENTPCD"
^DIC(19,3230,200.9)=""
^DIC(19,3230,"U")="COST DISTRIBUTION REPORT"
^DIC(19,3231,0)="DG WAITING LIST DELETE^Delete Waiting List Entry^^R^.5^^^^^^^114"
^DIC(19,3231,1,0)="^^1^1^2940628^^^"
^DIC(19,3231,1,1,0)="This option should be used to remove a patient from the waiting list."
^DIC(19,3231,25)="DIVK^DGWAIT"
^DIC(19,3231,"U")="DELETE WAITING LIST ENTRY"
^DIC(19,3232,0)="DG GECS BATCH^Batch Code Sheets^^A^.5^^^^^^^114^^1"
^DIC(19,3232,1,0)="^^4^4^2890928^^^^"
^DIC(19,3232,1,1,0)="This option allows the user to batch any of the MAS code sheets"
^DIC(19,3232,1,2,0)="created for the AMIS segments 167, 223, 290, 334-341, 345-346"
^DIC(19,3232,1,3,0)="and 401-420 which have been marked as ready for batching and"
^DIC(19,3232,1,4,0)="whose scheduled transmission date is before or equal to today."
^DIC(19,3232,15)="K GECSSYS"
^DIC(19,3232,20)="S GECSSYS=""MAS"" D BATCH^GECSCALL"
^DIC(19,3232,"U")="BATCH CODE SHEETS"
^DIC(19,3233,0)="DG GECS BATCH EDIT^Batch Edit^^A^.5^^^^^^^114^^1"
^DIC(19,3233,1,0)="^^5^5^2890928^^^^"
^DIC(19,3233,1,1,0)="This option allows the user to edit the batch number and priority for"
^DIC(19,3233,1,2,0)="MAS code sheets created for the AMIS segments 167, 223, 290, 334-341,"
^DIC(19,3233,1,3,0)="345-346 and 401-420 which have been batched. If the batch number"
^DIC(19,3233,1,4,0)="is deleted the code sheet is removed from the batch and assigned"
^DIC(19,3233,1,5,0)="the status of 'Code Sheet Retained in File'."
^DIC(19,3233,15)="K GECSSYS"
^DIC(19,3233,20)="S GECSSYS=""MAS"" D EDITBAT^GECSCALL"
^DIC(19,3233,"U")="BATCH EDIT"
^DIC(19,3234,0)="DG GECS BATCHES STATUS^Status of all Batches^^A^.5^^^^^^^114^^1"
^DIC(19,3234,1,0)="^^4^4^2890928^^^^"
^DIC(19,3234,1,1,0)="This option allows the user to print a report of the generic"
^DIC(19,3234,1,2,0)="code sheet transmission record. This report contains the"
^DIC(19,3234,1,3,0)="system identifier, batch number, date given to mailman and"
^DIC(19,3234,1,4,0)="message number."
^DIC(19,3234,15)="K GECSSYS"
^DIC(19,3234,20)="S GECSSYS=""MAS"" D RSTATUS^GECSCALL"
^DIC(19,3234,"U")="STATUS OF ALL BATCHES"
^DIC(19,3235,0)="DG GECS BATCHES WAITING TRANS^Batches Waiting to be Transmitted^^A^.5^^^^^^^114^^1"
^DIC(19,3235,1,0)="^^7^7^2890928^^^^"
^DIC(19,3235,1,1,0)="This option allows the user to print batches waiting to be"
^DIC(19,3235,1,2,0)="transmitted by batch number, including detailed information"
^DIC(19,3235,1,3,0)="about the code sheets in the batch. The report contains the"
^DIC(19,3235,1,4,0)="batch number, system identifier, date created and user who"
^DIC(19,3235,1,5,0)="created the batch. If the user chooses a detailed print out"
^DIC(19,3235,1,6,0)="the code sheet ID or the entire code sheet can also be printed."
^DIC(19,3235,1,7,0)="The code sheet is printed in transmission format."
^DIC(19,3235,15)="K GECSSYS"
^DIC(19,3235,20)="S GECSSYS=""MAS"" D RBATWA^GECSCALL"
^DIC(19,3235,"U")="BATCHES WAITING TO BE TRANSMIT"
^DIC(19,3236,0)="DG GECS CODE EDIT^Code Sheet Edit^^A^.5^^^^^^^114^^1"
^DIC(19,3236,1,0)="^^15^15^2890928^^^^"
^DIC(19,3236,1,1,0)="This option allows the user to edit code sheets created for"
^DIC(19,3236,1,2,0)="AMIS segments 167, 223, 290, 334-341, 345-346 and 401-420."
^DIC(19,3236,1,3,0)="When editing the code sheet the first field displayed is a"
^DIC(19,3236,1,4,0)="status field code sheets typically will have one of the"
^DIC(19,3236,1,5,0)="following statuses:"
^DIC(19,3236,1,6,0)=" "
^DIC(19,3236,1,7,0)=" -CODE SHEET RETAINED IN FILE!"
^DIC(19,3236,1,8,0)=" -CODE SHEET READY FOR BATCHING!"
^DIC(19,3236,1,9,0)=" -CODE SHEET READY FOR TRANSMISSION IN BATCH {batch #}!"
^DIC(19,3236,1,10,0)=" -CODE SHEET TRANSMITTED IN BATCH {batch #} on {date transmitted}!"
^DIC(19,3236,1,11,0)=" "
^DIC(19,3236,1,12,0)="The status field can not be edited, it is only displayed. The"
^DIC(19,3236,1,13,0)="remaining fields pertain directly to the code sheet being"
^DIC(19,3236,1,14,0)="edited. These are followed by the option to print, mark"
^DIC(19,3236,1,15,0)="the code sheet for batching, delete and edit the code sheet."
^DIC(19,3236,15)="K GECSSYS"
^DIC(19,3236,20)="S GECSSYS=""MAS"" D EDITCOD^GECSCALL"
^DIC(19,3236,"U")="CODE SHEET EDIT"
^DIC(19,3237,0)="DG GECS CREATE^Create a Code Sheet^^A^.5^^^^^^^114^^1"
^DIC(19,3237,1,0)="^^12^12^2890928^^^^"
^DIC(19,3237,1,1,0)="This option will allow the user to create code sheets for the AMIS"
^DIC(19,3237,1,2,0)="segments 167 and 290. The option can also be used to create"
^DIC(19,3237,1,3,0)="code sheets for the other types of MAS segments (223, 334-341,"
^DIC(19,3237,1,4,0)="345-346 and 401-420) but typically the code sheets for these"
^DIC(19,3237,1,5,0)="segments should be built using the 'Generate a Code Sheet'"
^DIC(19,3237,1,6,0)="option."
^DIC(19,3237,1,7,0)=" "
^DIC(19,3237,1,8,0)="If you are a multi-divisional facility the information for"
^DIC(19,3237,1,9,0)="AMIS segments 334-341 and 345-346 should be combined for"
^DIC(19,3237,1,10,0)="all divisions and a code sheet should be created, for each segment,"
^DIC(19,3237,1,11,0)="for the primary division containing the combined statistics"
^DIC(19,3237,1,12,0)="for all divisions."
^DIC(19,3237,15)="K GECSSYS"
^DIC(19,3237,20)="S GECSSYS=""MAS"" D CREATE^GECSCALL"
^DIC(19,3237,"U")="CREATE A CODE SHEET"
^DIC(19,3238,0)="DG GECS DELETE^Delete a Code Sheet^^A^.5^^^^^^^114^^1"
^DIC(19,3238,1,0)="^^2^2^2890928^^^^"
^DIC(19,3238,1,1,0)="This option allows the user to delete code sheets created for"
^DIC(19,3238,1,2,0)="AMIS segments 167, 223, 290, 334-341, 345-346 and 401-420."
^DIC(19,3238,15)="K GECSSYS"
^DIC(19,3238,20)="S GECSSYS=""MAS"" D DELCODE^GECSCALL"
^DIC(19,3238,"U")="DELETE A CODE SHEET"
^DIC(19,3239,0)="DG GECS KEYPUNCH^Keypunch a Code Sheet^^A^.5^^^^^^^114^^1"
^DIC(19,3239,1,0)="^^4^4^2890928^^^^"
^DIC(19,3239,1,1,0)="This option allows the user to create a code sheet using the exact"
^DIC(19,3239,1,2,0)="format that is used for transmission. This option would typically"
^DIC(19,3239,1,3,0)="only be used for prior data corrections to AMIS segments 167, 223,"
^DIC(19,3239,1,4,0)="290, 334-341, 345-346 and 401-420."
^DIC(19,3239,15)="K GECSSYS"
^DIC(19,3239,20)="S GECSSYS=""MAS"" D KEY^GECSCALL"
^DIC(19,3239,"U")="KEYPUNCH A CODE SHEET"
^DIC(19,3240,0)="DG GECS PURGE^Purge Transmission Records/Code Sheets^^A^.5^^^^^^^114^^1"
^DIC(19,3240,1,0)="^^6^6^2890928^^^^"
^DIC(19,3240,1,1,0)="This option allows the user to purge code sheets created"
^DIC(19,3240,1,2,0)="for AMIS segments 167, 223, 290, 334-341, 345-346 and"
^DIC(19,3240,1,3,0)="401-420. The user is first asked the number of days to"
^DIC(19,3240,1,4,0)="retain the code sheets. The date, based upon the number"
^DIC(19,3240,1,5,0)="of days selected, is then determined and all code sheets"
^DIC(19,3240,1,6,0)="and batches created prior to this date are purged."
^DIC(19,3240,15)="K GECSSYS"
^DIC(19,3240,20)="S GECSSYS=""MAS"" D PURGE^GECSCALL"
^DIC(19,3240,"U")="PURGE TRANSMISSION RECORDS/COD"
^DIC(19,3241,0)="DG GECS REBATCH^Mark Code Sheets for Rebatching^^A^.5^^^^^^^114^^1"
^DIC(19,3241,1,0)="^^3^3^2890928^^^^"
^DIC(19,3241,1,1,0)="This option allows the user to mark code sheets created for"
^DIC(19,3241,1,2,0)="AMIS segments 167, 223, 290, 334-341, 345-346 and 401-420"
^DIC(19,3241,1,3,0)="which have already been batched; so that they can be rebatched."
^DIC(19,3241,15)="K GECSSYS"
^DIC(19,3241,20)="S GECSSYS=""MAS"" D REBAT^GECSCALL"
^DIC(19,3241,"U")="MARK CODE SHEETS FOR REBATCHIN"
^DIC(19,3242,0)="DG GECS RETRANSMIT^Mark Batch for Retransmission^^A^.5^^^^^^^114^^1"
^DIC(19,3242,1,0)="^^3^3^2890928^^^^"
^DIC(19,3242,1,1,0)="This option allows the user to mark any of the MAS"
^DIC(19,3242,1,2,0)="Code Sheet batches which have already been transmitted;"
^DIC(19,3242,1,3,0)="so that they can be retransmitted."
^DIC(19,3242,15)="K GECSSYS"
^DIC(19,3242,20)="S GECSSYS=""MAS"" D RETRAN^GECSCALL"
^DIC(19,3242,"U")="MARK BATCH FOR RETRANSMISSION"
^DIC(19,3243,0)="DG GECS REVIEW CODE SHEET^Review a Code Sheet^^A^.5^^^^^^^114^^1"
^DIC(19,3243,1,0)="^^5^5^2890928^^^^"
^DIC(19,3243,1,1,0)="This option allows the user to review code sheets created for"
^DIC(19,3243,1,2,0)="AMIS segments 167, 223, 290, 334-341, 345-346 and 401-420."
^DIC(19,3243,1,3,0)="The option first displays the code sheet in transmission"
^DIC(19,3243,1,4,0)="format followed by the option to print, mark the code"
^DIC(19,3243,1,5,0)="sheet for batching, delete and edit the code sheet."
^DIC(19,3243,15)="K GECSSYS"
^DIC(19,3243,20)="S GECSSYS=""MAS"" D REVCODE^GECSCALL"
^DIC(19,3243,"U")="REVIEW A CODE SHEET"
^DIC(19,3244,0)="DG GECS TRANSMIT^Transmit Code Sheets^^A^.5^^^^^^^114^^1"
^DIC(19,3244,1,0)="^^6^6^2920605^^^^"
^DIC(19,3244,1,1,0)="This option will allow the user to transmit any of the MAS"
^DIC(19,3244,1,2,0)="Code Sheet batches which have not yet been transmitted or"
^DIC(19,3244,1,3,0)="that have been marked for retransmission. Code Sheets are"
^DIC(19,3244,1,4,0)="transmitted to Austin.  Members of the AMD"
^DIC(19,3244,1,5,0)="mail group will receive the confirmation and summary"
^DIC(19,3244,1,6,0)="messages from Austin."
^DIC(19,3244,15)="K GECSSYS"
^DIC(19,3244,20)="S GECSSYS=""MAS"" D TRANS^GECSCALL"
^DIC(19,3244,"U")="TRANSMIT CODE SHEETS"
^DIC(19,3245,0)="DG GECS MAINTENANCE USER MENU^Maintenance Menu^^M^.5^^^"
^DIC(19,3245,1,0)="^^2^2^2890411^"
^DIC(19,3245,1,1,0)="This menu is for the users (under the GECS USER MENU) for maintenance of"
^DIC(19,3245,1,2,0)="the code sheets."
^DIC(19,3245,10,0)="^19.01IP^5^5"
^DIC(19,3245,10,1,0)=3233
