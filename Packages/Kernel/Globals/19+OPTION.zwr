^DIC(19,4327,1,5,0)="removed from the original batch before it can be assigned to a new batch."
^DIC(19,4327,1,6,0)=""
^DIC(19,4327,1,7,0)="The option also adjusts the Batch Header Code Sheet to account for the"
^DIC(19,4327,1,8,0)="addition."
