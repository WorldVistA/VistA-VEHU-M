^DIC(19,10652,0)="XWB LISTENER STARTER^Start All RPC Broker Listeners^^R^10000000020^^^^^^^501^y"
^DIC(19,10652,1,0)="^19.06^10^10^3040325^^^"
^DIC(19,10652,1,1,0)="This option will Start/Restart all the RPC Broker listeners under the"
^DIC(19,10652,1,2,0)="control of the RPC BROKER SITE PARAMETERS file."
^DIC(19,10652,1,3,0)="It is normally setup as a STARTUP type option in the taskman option"
^DIC(19,10652,1,4,0)="scheduling file. This option will first STOP ALL listeners and then START"
^DIC(19,10652,1,5,0)="ALL the listeners through Taskman.  (VMS sites need to be running Taskman"
^DIC(19,10652,1,6,0)="in DCL context)."
^DIC(19,10652,1,7,0)="The XWB LISTENER STARTER cannot be used to start one particular listener."
^DIC(19,10652,1,8,0)="To do this, in programmer mode, use STRT^XWBTCP(portnumber) on the node"
^DIC(19,10652,1,9,0)="the listener needs to run on. Or use the XWB LISTENER EDIT option to"
^DIC(19,10652,1,10,0)="change the status of the one listener."
^DIC(19,10652,25)="RESTART^XWBTCP"
^DIC(19,10652,200.9)="s"
^DIC(19,10652,"U")="START ALL RPC BROKER LISTENERS"
