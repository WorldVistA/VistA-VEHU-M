^DIC(19,16473,0)="EHM-01294^PCE File Inquiry^^R^1^^^^^^^507^^^^"
^DIC(19,16473,1,0)="^^12^12^3240328^"
^DIC(19,16473,1,1,0)="This option allows a user to lookup an entry from one of the PCE source "
^DIC(19,16473,1,2,0)="files. The selectable files are limited to:"
^DIC(19,16473,1,3,0)=" "
^DIC(19,16473,1,4,0)="EDUCATION TOPICS (#9999999.09)"
