^DIC(19,10478,0)="IBCR HOST FILE LOAD^Load Host File into Charge Master^^R^1253^^^^^^^192"
^DIC(19,10478,1,0)="^^2^2^2961107^"
^DIC(19,10478,1,1,0)="This option includes functions necessary to load charges from a Host"
^DIC(19,10478,1,2,0)="file into the Charge Master."
^DIC(19,10478,25)="OPTION^IBCRHD"
^DIC(19,10478,"U")="LOAD HOST FILE INTO CHARGE MAS"
^DIC(19,10479,0)="IBCR INACTIVE CODES^Inactivate/List Inactive Codes in Charge Master^^R^1253^^^^^^^192"
^DIC(19,10479,1,0)="^^2^2^2961202^^"
^DIC(19,10479,1,1,0)="Reports and inactivates the charges in the Charge Master for all currently"
^DIC(19,10479,1,2,0)="inactive CPT codes."
^DIC(19,10479,25)="IBCREC"
^DIC(19,10479,"U")="INACTIVATE/LIST INACTIVE CODES"
^DIC(19,10480,0)="IBCR DELETE CHARGE ITEMS^Delete Charges from the Charge Master^^R^1253^IB SUPERVISOR^^^^^^192"
^DIC(19,10480,1,0)="^^3^3^2970528^^^^"
^DIC(19,10480,1,1,0)="Reports and deletes Charge Items in a Charge Set based on date."
^DIC(19,10480,1,2,0)="All charges that become inactive before a user specified date may be "
^DIC(19,10480,1,3,0)="deleted allowing old, no longer used charges to be removed from the system."
^DIC(19,10480,25)="IBCRED"
^DIC(19,10480,"U")="DELETE CHARGES FROM THE CHARGE"
^DIC(19,10482,0)="SD SHARING AGREEMENT UPDATE^Sharing Agreement Category Update^^R^1253^^^^^^^16"
^DIC(19,10482,1,0)="^^3^3^2970117^^^"
^DIC(19,10482,1,1,0)="This option is used to associate sub-catgeories with Appointment Types. If"
^DIC(19,10482,1,2,0)="a sub-category is defined for an Appointment Type then when it is selected,"
^DIC(19,10482,1,3,0)="an additional prompt will appear asking the user to select a sub-category."
^DIC(19,10482,25)="EN^DGSAUTL(""SD"")"
^DIC(19,10482,"U")="SHARING AGREEMENT CATEGORY UPD"
^DIC(19,10483,0)="DG SHARING AGREEMENT UPDATE^Sharing Agreement Category Update^^R^1253^^^^^^^114"
^DIC(19,10483,1,0)="^^4^4^2970117^^"
^DIC(19,10483,1,1,0)="This option will allow for the association of Sharing Agreements with the"
^DIC(19,10483,1,2,0)="Admitting Regulation file. For each Admitting Regulation a sub-category can"
^DIC(19,10483,1,3,0)="be established so that when the admitting regulation is entered in ADT and"
^DIC(19,10483,1,4,0)="additional prompt will appear to select the sub-category."
^DIC(19,10483,25)="EN^DGSAUTL(""DG"")"
^DIC(19,10483,"U")="SHARING AGREEMENT CATEGORY UPD"
^DIC(19,10484,0)="MCESTONGEN^Turn On Release Control/Elec. Signature^^R^755^^^^^^^^^1^1"
^DIC(19,10484,1,0)="^^5^5^2970701^^^^"
^DIC(19,10484,1,1,0)="This is a one time option that will turn on Release Control/Electronic "
^DIC(19,10484,1,2,0)="Signature.  It should only be used by the Manager of this department."
^DIC(19,10484,1,3,0)="Once this option is executed there is no way to turn it off.  Once"
^DIC(19,10484,1,4,0)="this is turned on the non-key holders will not be able to print"
^DIC(19,10484,1,5,0)="a record until it is released."
^DIC(19,10484,15)="D ^MCDIEDIE"
^DIC(19,10484,20)="S MCFILE=699.5,MCPRO=""GEN"""
^DIC(19,10484,25)="ESTOON^MCESCONV"
^DIC(19,10484,"U")="TURN ON RELEASE CONTROL/ELEC. "
^DIC(19,10485,0)="PSOCP CHAMPUS EXEMPTION^CHAMPUS Billing Exemption^^R^11712^^^^^^^141"
