^DIC(19,12447,99.1)="59172,37813"
^DIC(19,12447,"U")="CS MONITORING MENU"
^DIC(19,12448,0)="PSD NM RX REPRINT^Label Reprint for CS RXs Report^^A^10000000020^^^^^^^276^^1"
^DIC(19,12448,1,0)="^19.06^6^6^3030205^^^"
^DIC(19,12448,1,1,0)="This option lists controlled substance prescriptions for which a prescription"
^DIC(19,12448,1,2,0)="label reprint was requested.  An individual could fill the same prescription "
^DIC(19,12448,1,3,0)="more than once and be diverting prescription drugs.  Narcotic Inspectors and"
^DIC(19,12448,1,4,0)="Pharmacy managers should monitor this activity. "
^DIC(19,12448,1,5,0)=" "
^DIC(19,12448,1,6,0)="This report should be queued to run during non-peak hours."
^DIC(19,12448,20)="D ST^PSDNMRP"
^DIC(19,12448,"U")="LABEL REPRINT FOR CS RXS REPOR"
^DIC(19,12449,0)="PSD NM RX PARTIAL^Partial Request for CS RXs Report^^A^10000000020^^^^^^^276^^1"
^DIC(19,12449,1,0)="^19.06^6^6^3030205^^"
^DIC(19,12449,1,1,0)="This option lists controlled substance prescriptions for which a prescription"
^DIC(19,12449,1,2,0)="partial fill was requested.  An individual could partially fill the same"
^DIC(19,12449,1,3,0)="prescription more than once and be diverting prescription drugs.  Narcotic"
^DIC(19,12449,1,4,0)="Inspectors and Pharmacy managers should monitor this activity. "
^DIC(19,12449,1,5,0)=" "
^DIC(19,12449,1,6,0)="This report should be queued to run during non-peak hours."
^DIC(19,12449,20)="D ST^PSDNMPR"
^DIC(19,12449,"U")="PARTIAL REQUEST FOR CS RXS REP"
^DIC(19,12450,0)="PSD NM CS ADJ^CS Balance Adjustments Report^^A^10000000020^^^^^^^276^^1"
^DIC(19,12450,1,0)="^19.06^5^5^3030204^^^^"
^DIC(19,12450,1,1,0)="This option lists Drug Accountability Transactions in which the Controlled"
^DIC(19,12450,1,2,0)="Substance vault inventory balance was adjusted manually during the date range"
^DIC(19,12450,1,3,0)="entered.  The adjuster and reason will display on the report for the"
^DIC(19,12450,1,4,0)="Narcotic Inspectors and Pharmacy Managers to review regularly for"
^DIC(19,12450,1,5,0)="appropriateness and authorization. "
^DIC(19,12450,20)="D ST^PSDNMBA"
^DIC(19,12450,"U")="CS BALANCE ADJUSTMENTS REPORT"
^DIC(19,12451,0)="PSD NM RX SAME PERSON^CS RXs by Same Person Report^^A^10000000020^^^^^^^276^^1"
^DIC(19,12451,1,0)="^19.06^7^7^3030204^^^^"
^DIC(19,12451,1,1,0)="This option lists CS prescriptions that were entered, finished and"
^DIC(19,12451,1,2,0)="released by the same person for the date range entered.  Different pharmacists"
^DIC(19,12451,1,3,0)="in the prescription filling process normally perform these functions.  "
^DIC(19,12451,1,4,0)="Although frequently necessary on off-shifts and weekends, inspectors and"
^DIC(19,12451,1,5,0)="pharmacy managers should monitor this activity. "
^DIC(19,12451,1,6,0)="    "
^DIC(19,12451,1,7,0)="This report should be queue to run during non-peak hours."
^DIC(19,12451,20)="D ST^PSDNMSP"
^DIC(19,12451,"U")="CS RXS BY SAME PERSON REPORT"
^DIC(19,12452,0)="PSD NM RX WITHOUT VA^Patients Without VA Visit Report^^A^10000000020^^^^^^^276^^1"
^DIC(19,12452,1,0)="^19.06^11^11^3030211^^^^"
^DIC(19,12452,1,1,0)="This option lists patients that receive prescriptions but have not had a"
^DIC(19,12452,1,2,0)="VA clinic visit within one year of a RX release date for the date range"
^DIC(19,12452,1,3,0)="entered.  Excluding RXs released on the same day as a discharge and within"
^DIC(19,12452,1,4,0)="a user defined discharge date range.  Patients in Fee Basis and Aid and"
^DIC(19,12452,1,5,0)="Attendance programs may be included on the list and should be reviewed."
^DIC(19,12452,1,6,0)="A message will display for RXs that meet the sort criteria and were"
^DIC(19,12452,1,7,0)="released after the entered date of death for that patient. "
^DIC(19,12452,1,8,0)="This lists represents a potential diversion tactic that could be "
^DIC(19,12452,1,9,0)="employed to prevent detection and suspicion. "
^DIC(19,12452,1,10,0)="    "
^DIC(19,12452,1,11,0)="This report should be queued to run during non-peak hours."
^DIC(19,12452,20)="D ST^PSDNMWE"
^DIC(19,12452,"U")="PATIENTS WITHOUT VA VISIT REPO"
^DIC(19,12453,0)="PSD NM SECURITY KEY^CS Application Security Key Report^^A^10000000020^^^^^^^276^^1"
^DIC(19,12453,1,0)="^19.06^5^5^3030203^^^"
^DIC(19,12453,1,1,0)="This option list holders of the PSJ RPHARM and/or PSDMGR security keys. "
^DIC(19,12453,1,2,0)="Holders of these keys have the ability to override discrepancies, make"
^DIC(19,12453,1,3,0)="controlled substance vault inventory adjustments and transfer medications"
^DIC(19,12453,1,4,0)="between vaults.  The list requires routine monitoring and validation for"
^DIC(19,12453,1,5,0)="accuracy. "
^DIC(19,12453,20)="D ST^PSDNMKY"
^DIC(19,12453,"U")="CS APPLICATION SECURITY KEY RE"
^DIC(19,12454,0)="PSD DIGITALLY SIGNED ORDERS^OP CS Orders Report^^R^1^^^^^^^276"
^DIC(19,12454,1,0)="^^6^6^3020903^"
^DIC(19,12454,1,1,0)="This will provide a report of digitally signed orders for Schedule II"
^DIC(19,12454,1,2,0)="controlled substances. "
^DIC(19,12454,1,3,0)="The report will be for a date range with the option of including "
^DIC(19,12454,1,4,0)="discontinued and/or expired orders and various sort criteria, like by "
^DIC(19,12454,1,5,0)="patient, by provider, by drug and by schedule etc."
^DIC(19,12454,1,6,0)="It will be an 80-column report and will be queued to a printer."
^DIC(19,12454,25)="PSDDSOR"
^DIC(19,12454,99)="59129,34023"
^DIC(19,12454,"U")="OP CS ORDERS REPORT"
^DIC(19,12455,0)="PSD DIG. SIGNED RELEASED RX^OP Released Rx Report^^R^1^^^^^^^276"
^DIC(19,12455,1,0)="^^5^5^3030522^"
^DIC(19,12455,1,1,0)="This will provide a list of digitally signed released prescriptions, "
^DIC(19,12455,1,2,0)="sorted by released date, by drug and by Prescription file (#52) IEN."
^DIC(19,12455,1,3,0)="The report will be for a given date range with the option of selecting a"
^DIC(19,12455,1,4,0)="single drug, several drugs or all drugs. It will generate an 80-column"
^DIC(19,12455,1,5,0)="report that can be viewed on the screen or queued to a printer."
^DIC(19,12455,25)="PSDDSOR2"
^DIC(19,12455,99)="65715,62314"
^DIC(19,12455,"U")="OP RELEASED RX REPORT"
^DIC(19,12457,0)="PSB PRN DOCUMENTING^Documenting Backlog PRNs^OUT OF ORDER - NOT SUPPORTED IN BCMA V3^R^10000000020^^^^^^^"
^DIC(19,12457,25)="PSBPRNS^PSBPRND"
^DIC(19,12457,"U")="DOCUMENTING BACKLOG PRNS"
^DIC(19,12458,0)="PSB BCBU LINK ASSOCIATIONS^Associate Backup Workstations with a Division^^R^10000000020^^^^^^^533"
^DIC(19,12458,1,0)="^19.06^8^8^3030808^^"
^DIC(19,12458,1,1,0)="For sites running the REALTIME BCMA BACKUP interface, use this option to "
^DIC(19,12458,1,2,0)="assign your backup workstations to specific divisions. If you are not a "
^DIC(19,12458,1,3,0)="multidivisional site, associate all backup workstations with a single "
^DIC(19,12458,1,4,0)="division."
^DIC(19,12458,1,5,0)=" "
^DIC(19,12458,1,6,0)="When HL7 events occur, the division associated with the patient will be "
^DIC(19,12458,1,7,0)="used to determine which workstations will get the message."
^DIC(19,12458,1,8,0)="(Vista Menu)"
^DIC(19,12458,25)="ALPBPARM"
^DIC(19,12458,"U")="ASSOCIATE BACKUP WORKSTATIONS "
^DIC(19,12459,0)="PSB BCBU WARD LIST^List of Wards in BCMA Backup File^^R^10000000020^^^^^^^533"
^DIC(19,12459,1,0)="^19.06^2^2^3030808^^^^"
^DIC(19,12459,1,1,0)="This option will display all the wards available on the workstation."
^DIC(19,12459,1,2,0)="(Workstation Menu)"
^DIC(19,12459,25)="WARDLIST^ALPBUTL(""C"")"
^DIC(19,12459,"U")="LIST OF WARDS IN BCMA BACKUP F"
^DIC(19,12460,0)="PSB BCBU WRKSTN MAIN^BCMA Backup System (Wrkstn)^^M^10000000020^^^^^^^533^^1"
^DIC(19,12460,1,0)="^19.06^2^2^3030808^^^^"
^DIC(19,12460,1,1,0)="This is the main menu for the BCMA Backup system -- the ward workstation"
^DIC(19,12460,1,2,0)="containing the BCMA backup/contingency data. (Workstation Menu)"
