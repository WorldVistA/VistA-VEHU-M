^DIC(19,6324,0)="XTVR UPDATE^Update with current routines^^R^.5^^^^^^^^^"
^DIC(19,6324,1,0)="^^7^7^2900117^"
^DIC(19,6324,1,1,0)="This option records the text of the routines indicated in the file used"
^DIC(19,6324,1,2,0)="to maintain changes in routines.  Only the last version entered is kept"
^DIC(19,6324,1,3,0)="completely, previous entries reflect only the changes in lines added"
^DIC(19,6324,1,4,0)="and/or deleted to make the next version.  This option is used to record"
^DIC(19,6324,1,5,0)="the current routine structure so that it can be compared with future"
^DIC(19,6324,1,6,0)="versions of the routined using the 'Routine Compare - Current with"
^DIC(19,6324,1,7,0)="Previous' option."
^DIC(19,6324,25)="XTVRC1"
^DIC(19,6324,"U")="UPDATE WITH CURRENT ROUTINES"
^DIC(19,6325,0)="XTVR COMPARE^Routine Compare - Current with Previous^^R^.5^^^^^^^^^"
^DIC(19,6325,1,0)="^^4^4^2900117^^"
^DIC(19,6325,1,1,0)="This option is used to compare one or more current routines to previous"
^DIC(19,6325,1,2,0)="versions which have been recorded using the 'Update with current routines'"
^DIC(19,6325,1,3,0)="option.  Differences between the current version and the indicated number"
^DIC(19,6325,1,4,0)="of prior versions will be noted."
^DIC(19,6325,25)="XTVRC2"
^DIC(19,6325,"U")="ROUTINE COMPARE - CURRENT WITH"
