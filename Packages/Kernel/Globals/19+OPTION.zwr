^DIC(19,10102,0)="SROQD^Deaths Within 30 Days of Surgery^^R^10000000216^^^^^^^167^^1^1"
^DIC(19,10102,1,0)="^^23^23^3110831^"
^DIC(19,10102,1,1,0)="This option lists patients who had surgery within the selected date range "
^DIC(19,10102,1,2,0)="and who died within 30 days of surgery. Two separate reports are  "
^DIC(19,10102,1,3,0)="available through this option.  "
^DIC(19,10102,1,4,0)="  "
^DIC(19,10102,1,5,0)=" 1. Total Cases Summary "
^DIC(19,10102,1,6,0)="    This report may be printed in one of three ways.  "
^DIC(19,10102,1,7,0)="    a. All Cases "
^DIC(19,10102,1,8,0)="       The report will list all patients who had surgery within the "
^DIC(19,10102,1,9,0)="       selected date range and who died within 30 days of surgery, along "
^DIC(19,10102,1,10,0)="       with all of the patients' operations that were performed during the"
^DIC(19,10102,1,11,0)="       selected date range.  "
^DIC(19,10102,1,12,0)="    b. Outpatient Cases Only The report will list only the surgical cases"
^DIC(19,10102,1,13,0)="       that are associated with deaths that are counted as outpatient"
^DIC(19,10102,1,14,0)="       (ambulatory) deaths.  "
^DIC(19,10102,1,15,0)="    c. Inpatient Cases Only"
^DIC(19,10102,1,16,0)="       The report will list only the surgical cases that are associated "
^DIC(19,10102,1,17,0)="       with deaths that are counted as inpatient deaths.  "
^DIC(19,10102,1,18,0)="  "
^DIC(19,10102,1,19,0)=" 2. Specialty Procedures "
^DIC(19,10102,1,20,0)="    This report will list the surgical cases that are associated with "
^DIC(19,10102,1,21,0)="    deaths that are counted for the national surgical specialty linked to "
^DIC(19,10102,1,22,0)="    the local surgical specialty. Cases are listed by national surgical "
^DIC(19,10102,1,23,0)="    specialty."
^DIC(19,10102,15)="D EXIT^SROVAR"
^DIC(19,10102,20)="D ^SROVAR"
^DIC(19,10102,22)="Q"
^DIC(19,10102,25)="SROQD"
^DIC(19,10102,"U")="DEATHS WITHIN 30 DAYS OF SURGE"
