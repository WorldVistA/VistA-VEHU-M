^DIC(19,566,0)="PSJI LBLS^Scheduled Labels (IV)^^A^1^^^^^^^^^1^1"
^DIC(19,566,1,0)="^^5^5^2920512^^^^"
^DIC(19,566,1,1,0)="  This option prints labels for a particular scheduled manufacturing"
^DIC(19,566,1,2,0)="time.  Usually a manufacturing list has been run prior to the printing"
^DIC(19,566,1,3,0)="of the labels.  If this has been done, the labels will print immediately"
^DIC(19,566,1,4,0)="and in the same order as on the manufacturing list.  The use of this option"
^DIC(19,566,1,5,0)="also causes workload counts in the IV STATS file."
^DIC(19,566,15)="K I1"
^DIC(19,566,20)="D ^PSIVXU Q:$D(XQUIT)!(DONE=1)  D ^PSIVLBL1,ENIVKV^PSGSETU"
^DIC(19,566,25)=""
^DIC(19,566,"U")="SCHEDULED LABELS (IV)"
^DIC(19,567,0)="PSJI MAN^Manufacturing List (IV)^^A^1^^^^^^^^^1^1"
^DIC(19,567,1,0)="^^4^4^2910312^^^^"
^DIC(19,567,1,1,0)="  This option produces a listing by additive, strength and solution"
^DIC(19,567,1,2,0)="of all orders due to be mixed at a scheduled manufacturing time."
^DIC(19,567,1,3,0)="The total number of IVs to be made is shown as well as how many go to"
^DIC(19,567,1,4,0)="each patient."
^DIC(19,567,15)="K I1"
^DIC(19,567,20)="D ^PSIVXU Q:$D(XQUIT)!(DONE=1)  D ^PSIVMAN"
^DIC(19,567,25)=""
^DIC(19,567,"U")="MANUFACTURING LIST (IV)"
