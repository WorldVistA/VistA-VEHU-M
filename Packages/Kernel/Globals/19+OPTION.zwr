^DIC(19,4035,99)="56214,30150"
^DIC(19,4035,"U")="LAB ROUTINE INTEGRITY MENU"
^DIC(19,4036,0)="LROPTLST^Listing of Laboratory Menus/Options^^R^.5^^^^^^^26"
^DIC(19,4036,1,0)="^^13^13^2890809^^"
^DIC(19,4036,1,1,0)="This option is used to provide a listing of options for a given Menu."
^DIC(19,4036,1,2,0)="The option will print by menu all of the options for that menu, including"
^DIC(19,4036,1,3,0)="any sub menus. This listing can be used as a checklist of options tested."
^DIC(19,4036,1,4,0)="The listing will provide the the following:"
^DIC(19,4036,1,5,0)="  Menu Text                 Option Name (Program name if any)"
^DIC(19,4036,1,6,0)="       The description of the option from the option file #19"
^DIC(19,4036,1,7,0)=" "
^DIC(19,4036,1,8,0)="         ---------------------------------------------"
^DIC(19,4036,1,9,0)=" "
^DIC(19,4036,1,10,0)="Generally LRMENU option is entered; however any menu can be used."
^DIC(19,4036,1,11,0)="This option is a simplified version of diagram menus."
^DIC(19,4036,1,12,0)="Very helpful when checking off options when testing a new release, or"
^DIC(19,4036,1,13,0)="when comparing local menus to distributed versions."
^DIC(19,4036,25)="QUE^LROPTLST"
^DIC(19,4036,99)="55725,32963"
^DIC(19,4036,99.1)="54345,38017"
^DIC(19,4036,"U")="LISTING OF LABORATORY MENUS/OP"
