^DIC(19,5293,0)="ECTD UD STATS^Unit Dose AMIS - Inpatient Pharmacy^^R^.5^^^^^^^189^^1^1"
^DIC(19,5293,1,0)="^^3^3^2901126^^^^"
^DIC(19,5293,1,1,0)="For a user selected date range, this option pulls data from the"
^DIC(19,5293,1,2,0)="Unit Dose Pick List Stats file.  The report displays the total"
^DIC(19,5293,1,3,0)="units dispensed, total cost, and average cost per unit."
^DIC(19,5293,15)="I $S('$D(^PS(59.7,1,20)):1,1:^(20)<3) D ENKV^PSGSET"
^DIC(19,5293,20)="S ECT1=""UD"" I $S('$D(^PS(59.7,1,20)):1,1:^(20)<3),'$D(^XUTL(""XQ"",$J,""PSG""_DUZ))!'$D(^XUTL(""PSG"",DUZ)) D ^PSGSET"
^DIC(19,5293,25)="ECTDIR"
^DIC(19,5293,"U")="UNIT DOSE AMIS - INPATIENT PHA"
^DIC(19,5294,0)="ECTD DENT STATS^Dental Sittings/Visits^^R^.5^^^^^^^189^^1"
^DIC(19,5294,1,0)="^^4^4^2900928^^"
^DIC(19,5294,1,1,0)="Report of all sittings and visits to the Dental clinic during a"
^DIC(19,5294,1,2,0)="specified timeframe.  The user must select the station division"
^DIC(19,5294,1,3,0)="and date range for the report.  Also, the user may select to"
^DIC(19,5294,1,4,0)="review released data only."
^DIC(19,5294,20)="S ECT1=""DENT"""
^DIC(19,5294,25)="ECTDIR"
^DIC(19,5294,99)="54738,54490"
^DIC(19,5294,"U")="DENTAL SITTINGS/VISITS"
^DIC(19,5295,0)="ECTE INPUT^Enter/Edit Planned Equipment Data^^R^.5^^^^^^^189"
^DIC(19,5295,1,0)="^^2^2^2901011^^"
^DIC(19,5295,1,1,0)="Using this option, the user may enter or edit planned equipment items,"
^DIC(19,5295,1,2,0)="edit the priority of any item, or edit the status of any item."
^DIC(19,5295,25)="ECTEIN"
^DIC(19,5295,"U")="ENTER/EDIT PLANNED EQUIPMENT D"
^DIC(19,5296,0)="ECTE PRIORITY^Display Planned Equipment Priority^^R^.5^^^^^^^189"
^DIC(19,5296,1,0)="^^3^3^2901012^"
^DIC(19,5296,1,1,0)="A prioritized report is printed for a selected equipment group."
^DIC(19,5296,1,2,0)="This group may be: additional equipment, replacement equipment,"
^DIC(19,5296,1,3,0)="regional high technology equipment, or IRM/ADP equipment."
^DIC(19,5296,25)="ECTEPR"
^DIC(19,5296,"U")="DISPLAY PLANNED EQUIPMENT PRIO"
^DIC(19,5297,0)="ECTE STATUS^Display Planned Equipment Status^^R^.5^^^^^^^189"
^DIC(19,5297,1,0)="^^3^3^2901012^"
^DIC(19,5297,1,1,0)="This option produces an equipment listing by status.  The status"
^DIC(19,5297,1,2,0)="may be: requested, but not approved or purchased, approved to be"
^DIC(19,5297,1,3,0)="purchased, or approved and purchased."
^DIC(19,5297,25)="ECTEST"
^DIC(19,5297,"U")="DISPLAY PLANNED EQUIPMENT STAT"
^DIC(19,5298,0)="ECTP LOCAL SERVICES^Identify Local Services from National File^^R^.5^^^^^^^189"
^DIC(19,5298,1,0)="^^6^6^2901128^^^"
^DIC(19,5298,1,1,0)="Use this option to indicate which of the services from the National"
^DIC(19,5298,1,2,0)="Service file are 'local' services.  The option allows four choices:"
^DIC(19,5298,1,3,0)="(1) Enter and/or edit the station's services; (2) List all services"
^DIC(19,5298,1,4,0)="from the National Service file; (3) List the services from the National"
^DIC(19,5298,1,5,0)="Service file which have been identified as 'local' station services;"
^DIC(19,5298,1,6,0)="and (4) Edit a single service."
^DIC(19,5298,25)="ECTPSRV"
^DIC(19,5298,"U")="IDENTIFY LOCAL SERVICES FROM N"
^DIC(19,5299,0)="ECTP INPUT PP^Enter/Edit Staffing Data for Pay Period^^R^.5^^^^^^^189"
^DIC(19,5299,1,0)="^^2^2^2901022^^"
^DIC(19,5299,1,1,0)="This option is used to enter, edit or delete data from the"
^DIC(19,5299,1,2,0)="VAMC Staffing file (#731.7)."
^DIC(19,5299,25)="ECTPP"
^DIC(19,5299,"U")="ENTER/EDIT STAFFING DATA FOR P"
^DIC(19,5300,0)="ECTP PAY PERIOD^VAMC Staffing Report by Pay Period^^R^.5^^^^^^^189"
^DIC(19,5300,1,0)="^^3^3^2901024^^"
^DIC(19,5300,1,1,0)="For a selected pay period/year, this report prints the assigned FTEE,"
^DIC(19,5300,1,2,0)="noncumulative FTEE, cumulative FTEE fiscal year to date, and the"
^DIC(19,5300,1,3,0)="variance for all local services."
^DIC(19,5300,25)="ECTPRPT"
^DIC(19,5300,"U")="VAMC STAFFING REPORT BY PAY PE"
^DIC(19,5301,0)="ECTP INPUT FY^Enter/Edit Staffing Data for Fiscal Year^^R^.5^^^^^^^189"
^DIC(19,5301,1,0)="^^2^2^2901022^"
^DIC(19,5301,1,1,0)="This option is used to enter, edit or delete data from the service"
^DIC(19,5301,1,2,0)="subfile of the VAMC Management file (#731)."
^DIC(19,5301,25)="ECTPFY"
^DIC(19,5301,"U")="ENTER/EDIT STAFFING DATA FOR F"
^DIC(19,5302,0)="ECTF INPUT CONTRACT^Enter/Edit Contract Data for Fiscal Year^^R^.5^^^^^^^189"
^DIC(19,5302,1,0)="^^4^4^2901214^^^"
^DIC(19,5302,1,1,0)="This option is used to enter or edit data in the contract subfile"
^DIC(19,5302,1,2,0)="of the VAMC Management file - #731.  Fields include the contract"
^DIC(19,5302,1,3,0)="number, description, type (maintenance, service, or sharing),"
^DIC(19,5302,1,4,0)="amount, vendor, and responsible service."
^DIC(19,5302,25)="ECTFCON"
^DIC(19,5302,"U")="ENTER/EDIT CONTRACT DATA FOR F"
^DIC(19,5303,0)="ECTS INPUT WKLD^Enter/Edit Workload Data by Fiscal Year^^R^.5^^^^^^^189"
^DIC(19,5303,1,0)="^^2^2^2901128^^"
^DIC(19,5303,1,1,0)="For a user selected fiscal year, this option controls input into"
^DIC(19,5303,1,2,0)="the inpatient and outpatient workload subfiles."
^DIC(19,5303,25)="ECTSIN"
^DIC(19,5303,"U")="ENTER/EDIT WORKLOAD DATA BY FI"
^DIC(19,5304,0)="ECTP ONE T&L^PAID Data for One T&L Unit^^R^.5^^^^^^^189"
^DIC(19,5304,1,0)="^^5^5^2901112^^"
^DIC(19,5304,1,1,0)="This option produces a report for a selected T&L unit.  The user may"
^DIC(19,5304,1,2,0)="choose the pay period/date range.  For the selected time-frame,"
^DIC(19,5304,1,3,0)="the following PAID totals will be displayed: annual leave, sick leave,"
^DIC(19,5304,1,4,0)="leave without pay, authorized absence, earned comp time, used comp"
^DIC(19,5304,1,5,0)="time, unscheduled regular time, and over time."
^DIC(19,5304,25)="ECTP1TL"
^DIC(19,5304,99)="56382,35459"
^DIC(19,5304,"U")="PAID DATA FOR ONE T&L UNIT"
^DIC(19,5305,0)="ECTQ QA SCREENS^List QA Screens^^R^.5^^^^^^^189"
^DIC(19,5305,1,0)="^^3^3^2901123^"
^DIC(19,5305,1,1,0)="This option displays the QA screen codes and their descriptions."
^DIC(19,5305,1,2,0)="Most QA reports display only the code.  Users may use this option"
^DIC(19,5305,1,3,0)="to determine the code definition."
^DIC(19,5305,25)="ECTQSCR"
^DIC(19,5305,"U")="LIST QA SCREENS"
^DIC(19,5306,0)="ECTF ACT REC^Accounts Receivable^^R^.5^^^^^^^189"
^DIC(19,5306,1,0)="^^3^3^2901127^"
^DIC(19,5306,1,1,0)="This option displays data from the 'Accounts Receivable' file.  For a"
^DIC(19,5306,1,2,0)="selected fiscal year, the data is sorted by category.  Data elements"
^DIC(19,5306,1,3,0)="displayed include category, principal balance, and total paid principal."
^DIC(19,5306,25)="ECTFAR"
^DIC(19,5306,"U")="ACCOUNTS RECEIVABLE"
^DIC(19,5307,0)="ECT PKG COORDINATOR^IMS Data Input Menu^^M^.5^^^^^^^189"
^DIC(19,5307,1,0)="^^4^4^2901128^"
^DIC(19,5307,1,1,0)="This option is the main menu option for data input/edit for the"
^DIC(19,5307,1,2,0)="Interim Management Support software.  Specific options may be"
^DIC(19,5307,1,3,0)="allocated by IRM to individuals designated by the Director's"
^DIC(19,5307,1,4,0)="office for data input."
