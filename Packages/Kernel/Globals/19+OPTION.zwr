^DIC(19,9421,99)="62195,30816"
^DIC(19,9421,"U")="RECEIVING AND DISTRIBUTION MEN"
^DIC(19,9422,0)="PRCP KWZ REPORT^Items Flagged 'Kill When Zero' Report^^R^11740^^^^^^^"
^DIC(19,9422,1,0)="^^3^3^2920211^^"
^DIC(19,9422,1,1,0)="This option will print a report showing the items in the inventory"
^DIC(19,9422,1,2,0)="which are flagged 'delete item when inventory 0.'  The report will"
^DIC(19,9422,1,3,0)="show the item information, unit per issue, and quantity on-hand."
^DIC(19,9422,25)="PRCPRKWZ"
^DIC(19,9422,"U")="ITEMS FLAGGED 'KILL WHEN ZERO'"
^DIC(19,9423,0)="PRCP2 STOCK REPLENISHMENT MENU^Stock Replenishment Menu^^M^11740^^^^^^^^^1"
^DIC(19,9423,1,0)="^^2^2^2921102^^^"
^DIC(19,9423,1,1,0)="This menu provides options for requesting supplies from a Primary Inventory"
^DIC(19,9423,1,2,0)="point."
^DIC(19,9423,10,0)="^19.01PI^11^8"
^DIC(19,9423,10,1,0)="9414^"
