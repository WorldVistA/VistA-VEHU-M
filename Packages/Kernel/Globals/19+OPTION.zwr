^DIC(19,8145,0)="ESP RESUME AN OFFENSE REPORT^Resume an Offense Report Entry^PATCH ES*1*46^R^1^^^^^^^366^^^1"
^DIC(19,8145,1,0)="^^8^8^2940311^^^^"
^DIC(19,8145,1,1,0)="This submenu option allows VA Police staff to continue entering data"
^DIC(19,8145,1,2,0)="into an Offense Report that has not been designated as complete.  VA"
^DIC(19,8145,1,3,0)="Police staff can only gain access of Offense Reports that they have"
^DIC(19,8145,1,4,0)="originated.  Once the VA Police staff designates the entry as complete,"
^DIC(19,8145,1,5,0)="a bulletin is sent to the Chief or designated supervisor that the"
^DIC(19,8145,1,6,0)="report is ready for review.  The Resume an Offense Report Entry option"
^DIC(19,8145,1,7,0)="can also be used to complete an entry of a Offense Report when"
^DIC(19,8145,1,8,0)="necessary."
^DIC(19,8145,15)="D ^ESPCLEAN"
^DIC(19,8145,25)="ESPOFFC"
^DIC(19,8145,"U")="RESUME AN OFFENSE REPORT ENTRY"
^DIC(19,8146,0)="ESP CLOSE AN OFFENSE REPORT^Close an Offense Report^PATCH ES*1*46^R^1^ESP SUPERVISOR^^^^^^366^^^1"
^DIC(19,8146,1,0)="^^3^3^2940311^^^^"
^DIC(19,8146,1,1,0)="This submenu option allows designated supervisors, holding the ESP"
^DIC(19,8146,1,2,0)="SUPERVISOR key to review and close an offense report.  The offense report"
^DIC(19,8146,1,3,0)="must be designated as complete before it can be closed."
^DIC(19,8146,15)="D ^ESPCLEAN"
^DIC(19,8146,25)="ESPOFFCL"
^DIC(19,8146,"U")="CLOSE AN OFFENSE REPORT"
