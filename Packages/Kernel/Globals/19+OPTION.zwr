^DIC(19,11290,1,0)="^^2^2^2990127^"
^DIC(19,11290,1,1,0)="This report will chronologically list Non-OR Procedures sorted by Medical"
^DIC(19,11290,1,2,0)="Specialty, by provider or by location."
^DIC(19,11290,15)="D EXIT^SROVAR"
^DIC(19,11290,20)="D ^SROVAR"
^DIC(19,11290,22)="Q"
^DIC(19,11290,25)="SRONOR"
^DIC(19,11290,"U")="REPORT OF NON-O.R. PROCEDURES"
^DIC(19,11291,0)="WV HS-USER DEFINED^Health Summary^^R^11597^^^^^^^522"
^DIC(19,11291,1,0)="^^10^10^2990208^"
^DIC(19,11291,1,1,0)="This option allows the user to create a health summary report for the"
^DIC(19,11291,1,2,0)="patient selected. The user may select multiple health summary components"
^DIC(19,11291,1,3,0)="to create the health summary report."
^DIC(19,11291,1,4,0)=" "
^DIC(19,11291,1,5,0)="The health summary components offer default values for the number of"
^DIC(19,11291,1,6,0)="occurences to return and time span to cover. The user may edit these"
^DIC(19,11291,1,7,0)="defaults by entering the component at the ""Select COMPONENT(S) to EDIT or"
^DIC(19,11291,1,8,0)="other COMPONENT(S) to ADD:"" prompt and then changing the defaults for the"
^DIC(19,11291,1,9,0)="""OCCURRENCE LIMIT"" and ""TIME LIMIT:"" prompts. Also, a special ""HEADER"
^DIC(19,11291,1,10,0)="NAME"" may be assigned to the report output."
^DIC(19,11291,25)="UD^WVHS"
^DIC(19,11291,"U")="HEALTH SUMMARY"
^DIC(19,11292,0)="FSC QUERY CALLS^Query Calls^^A^11742^^^^^^^^^1"
^DIC(19,11292,1,0)="^^5^5^2940420^^"
^DIC(19,11292,1,1,0)="This option selects calls meeting a specific criteria for display"
^DIC(19,11292,1,2,0)="on the List Screen.  Queries are made by specifying a field, condition,"
^DIC(19,11292,1,3,0)="and value for a call.  This is useful for finding calls that are similar"
^DIC(19,11292,1,4,0)="to a problem being reported.  You may also use queries within the List"
^DIC(19,11292,1,5,0)="Screen to add calls to a list or to remove or select calls from a list."
^DIC(19,11292,2)="y"
^DIC(19,11292,20)="D OPT^FSCOP(""QUERY"")"
^DIC(19,11292,25)=""
^DIC(19,11292,99.1)="56489,55516"
^DIC(19,11292,"U")="QUERY CALLS"
