^DIC(19,13350,0)="MDCVT MANAGER^Medicine to CP Conversion Manager^^M^1^^^^^^^557"
^DIC(19,13350,1,0)="^19.06^3^3^3041109^^^^"
^DIC(19,13350,1,1,0)="This is the Medicine to CP Manager menu option.  This menu option"
