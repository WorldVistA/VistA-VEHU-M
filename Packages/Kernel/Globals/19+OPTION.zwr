^DIC(19,6240,0)="IB PURGE/FIND BILLING DATA^Find Billing Data to Archive^^R^.5^XUMGR^^^^^^192"
^DIC(19,6240,1,0)="^^9^9^2920519^^"
^DIC(19,6240,1,1,0)="This option may be used to identify records to be archived and purged"
^DIC(19,6240,1,2,0)="from the following files:"
^DIC(19,6240,1,3,0)=" "
^DIC(19,6240,1,4,0)="  #350  INTEGRATED BILLING ACTION"
^DIC(19,6240,1,5,0)="  #351  CATEGORY C BILLING CLOCK"
^DIC(19,6240,1,6,0)="  #399  BILL/CLAIMS"
^DIC(19,6240,1,7,0)=" "
^DIC(19,6240,1,8,0)="Entries which are selected to be archived and then purged are placed"
^DIC(19,6240,1,9,0)="into a Search (Sort) template."
^DIC(19,6240,25)="FIND^IBP"
^DIC(19,6240,"U")="FIND BILLING DATA TO ARCHIVE"
^DIC(19,6241,0)="IB PURGE/ARCHIVE BILLING DATA^Archive Billing Data^^R^.5^XUMGR^^^^^^192"
^DIC(19,6241,1,0)="^^8^8^2920519^^^^"
^DIC(19,6241,1,1,0)="This option may be used to archive data from the following files:"
^DIC(19,6241,1,2,0)=" "
^DIC(19,6241,1,3,0)="  #350  INTEGRATED BILLING ACTION"
^DIC(19,6241,1,4,0)="  #351  CATEGORY C BILLING CLOCK"
^DIC(19,6241,1,5,0)="  #399  BILL/CLAIMS"
^DIC(19,6241,1,6,0)=" "
^DIC(19,6241,1,7,0)="Entries from these files must be found, and placed in the appropriate"
^DIC(19,6241,1,8,0)="Search (Sort) template, before they may be archived."
^DIC(19,6241,25)="ARCHIVE^IBP"
^DIC(19,6241,"U")="ARCHIVE BILLING DATA"
^DIC(19,6242,0)="IB PURGE BILLING DATA^Purge Billing Data^^R^.5^XUMGR^^^^^^192"
^DIC(19,6242,1,0)="^^7^7^2940207^^^"
^DIC(19,6242,1,1,0)="This option may be used to purge data from the following files:"
^DIC(19,6242,1,2,0)=" "
^DIC(19,6242,1,3,0)="  #350  INTEGRATED BILLING ACTION"
^DIC(19,6242,1,4,0)="  #351  CATEGORY C BILLING CLOCK"
^DIC(19,6242,1,5,0)="  #399  BILL/CLAIMS"
^DIC(19,6242,1,6,0)=" "
^DIC(19,6242,1,7,0)="Entries from these files must be archived before they may be purged."
^DIC(19,6242,25)="PURGE^IBP"
^DIC(19,6242,"U")="PURGE BILLING DATA"
^DIC(19,6243,0)="IB MT RELEASE CHARGES^Release Charges 'On Hold'^^R^10000000020^IB AUTHORIZE^^^^^^192"
^DIC(19,6243,1,0)="^19.06^9^9^3010910^^^^"
^DIC(19,6243,1,1,0)="This option is used to release Means Test charges which are 'on hold'"
^DIC(19,6243,1,2,0)="awaiting claim disposition from the patient's insurance company.  Any"
^DIC(19,6243,1,3,0)="held up charges for a patient (which is specified by the user) may be"
^DIC(19,6243,1,4,0)="selected and passed to Accounts Receivable.  This option will also be"
^DIC(19,6243,1,5,0)="accessed from the 'Enter a Payment' option in the Accounts Receivable"
^DIC(19,6243,1,6,0)="package.  If the user posts a payment from an insurance company for a"
^DIC(19,6243,1,7,0)="bill which has any 'held' charges associated with it, the user may opt"
^DIC(19,6243,1,8,0)="to select any of the charges to pass to Accounts Receivable in order to"
^DIC(19,6243,1,9,0)="post a portion of the insurance company's payment to the patient's bill."
^DIC(19,6243,25)="IBRREL"
^DIC(19,6243,99)="55613,50130"
^DIC(19,6243,"U")="RELEASE CHARGES 'ON HOLD'"
^DIC(19,6244,0)="IB OUTPUT HELD CHARGES^Held Charges Report^^R^10000000033^^^^^^^192"
^DIC(19,6244,1,0)="^^5^5^2980115^"
^DIC(19,6244,1,1,0)="This option produces the Held Charges Report.  The report lists all"
^DIC(19,6244,1,2,0)="charges having the status of ON HOLD.  With each charge is listed bills"
^DIC(19,6244,1,3,0)="that are for the same outpatient visit or the same inpatient admission"
^DIC(19,6244,1,4,0)="with an overlap in the period covered.  Users have the option of printing"
^DIC(19,6244,1,5,0)="the report with or without Insurance information."
^DIC(19,6244,25)="MAIN^IBOHLD1"
^DIC(19,6244,"U")="HELD CHARGES REPORT"
^DIC(19,6246,0)="IB OUTPUT EVENTS REPORT^Outpatient/Registration Events Report^^R^.5^^^^^n^^192"
