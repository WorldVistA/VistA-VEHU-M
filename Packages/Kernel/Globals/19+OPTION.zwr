^DIC(19,7159,1,0)="^^5^5^2911003^^"
^DIC(19,7159,1,1,0)="This option is used to edit the site specific information related to DHCP"
^DIC(19,7159,1,2,0)="application parameters.  The active/inactive field is the only information"
^DIC(19,7159,1,3,0)="that the local site needs to complete.  All other information in this file"
