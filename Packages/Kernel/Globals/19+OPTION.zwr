^DIC(19,1372,"U")="EDIT/PRINT/DISPLAY PRESELECTED"
^DIC(19,1373,0)="LRUMDD^Delete user selected lab test/patient lists^^R^.5^^^^^^^26"
^DIC(19,1373,1,0)="^^2^2^2870203^^^"
^DIC(19,1373,1,1,0)="Deletes users from lab temporary print file (69.2 field 7) if they"
^DIC(19,1373,1,2,0)=" haven't used option LRUMD since a specified date."
^DIC(19,1373,25)="EN2^LRUMD"
^DIC(19,1373,"U")="DELETE USER SELECTED LAB TEST/"
^DIC(19,1374,0)="LRUMDLM^User selected lab test/patient list edits^^M^.5^^^^^^^26"
^DIC(19,1374,1,0)="^^1^1^2871231^^^^"
^DIC(19,1374,1,1,0)="User selected lab tests and patient lists option"
^DIC(19,1374,10,0)="^19.01PI^2^2"
^DIC(19,1374,10,1,0)="1371^1^1"
^DIC(19,1374,10,2,0)="1373^2^2"
^DIC(19,1374,10,"B",1371,1)=""
