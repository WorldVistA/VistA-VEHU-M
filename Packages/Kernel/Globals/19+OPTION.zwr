^DIC(19,10424,0)="TIU GMRPN SINGLE^Single Progress Note Conversion^^A^11597^^^^^^^516^^1"
^DIC(19,10424,1,0)="^^3^3^2961121^^^^"
^DIC(19,10424,1,1,0)="Option permits conversion of a single progress note.  This will"
