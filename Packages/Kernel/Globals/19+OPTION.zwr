^DIC(19,16522,"U")="REMINDER EXTRACT MENU"
^DIC(19,16523,0)="EHM-01344^Reminder Extract Management^^R^1^^^^^^^534^^^^"
^DIC(19,16523,1,0)="^^41^41^3240328^"
^DIC(19,16523,1,1,0)="This option uses list manager to view an extract definition, examine and "
^DIC(19,16523,1,2,0)="schedule an extract run or transmission run, view extract summary results "
^DIC(19,16523,1,3,0)="and view extract patient lists."
^DIC(19,16523,1,4,0)=" "
^DIC(19,16523,1,5,0)="Each extract definition is identified by an Extract Name.  Extract names"
^DIC(19,16523,1,6,0)="are displayed as selectable items. When an extract name is selected,"
^DIC(19,16523,1,7,0)="the list manager actions allow the user to "
^DIC(19,16523,1,8,0)="- view and edit the extract definition"
^DIC(19,16523,1,9,0)="- view the existing history of extract run information, with the most "
^DIC(19,16523,1,10,0)="recent extract runs displayed first.  "
^DIC(19,16523,1,11,0)=" "
^DIC(19,16523,1,12,0)="Viewing the existing history of extract runs, provides a list of extract "
^DIC(19,16523,1,13,0)="runs. When selecting a particular extract run, list manager actions allow "
^DIC(19,16523,1,14,0)="the user to:"
^DIC(19,16523,1,15,0)="-- Change the view"
^DIC(19,16523,1,16,0)="-- View the extract results stored in the Extract Summary file"
^DIC(19,16523,1,17,0)="-- Schedule a Manual Extract run"
^DIC(19,16523,1,18,0)="-- Schedule a Manual Transmission run for an existing national extract run"
^DIC(19,16523,1,19,0)="-- View the Transmission History "
^DIC(19,16523,1,20,0)=" "
^DIC(19,16523,1,21,0)="When the Extract Summary action is selected, the user can "
^DIC(19,16523,1,22,0)="--- view patient lists used for the run or "
^DIC(19,16523,1,23,0)="--- view the extract summary results. "
^DIC(19,16523,1,24,0)=" "
^DIC(19,16523,1,25,0)="The extract summary results will contain compliance totals, similar to a "
^DIC(19,16523,1,26,0)="reminder due report.  The extract results may optionally contain finding "
^DIC(19,16523,1,27,0)="totals if the extract definition contains counting rules for a particular "
^DIC(19,16523,1,28,0)="reminder.   "
^DIC(19,16523,1,29,0)=" "
^DIC(19,16523,1,30,0)="Prior extract summaries for a given extract type can be displayed with "
^DIC(19,16523,1,31,0)="their HL7 transmission status and history. Reminder and finding totals of "
^DIC(19,16523,1,32,0)="individual extract summaries may be displayed or printed if required. The "
^DIC(19,16523,1,33,0)="patient lists generated by each extract may be displayed or used to print "
^DIC(19,16523,1,34,0)="health summaries if required."
^DIC(19,16523,1,35,0)="      "
^DIC(19,16523,1,36,0)="National extract runs and transmissions to the Austin Automation Center "
^DIC(19,16523,1,37,0)="(AAC) can be monitored from the actions. National extracts are the only "
^DIC(19,16523,1,38,0)="extracts that can be transmitted to the AAC. Actions allow extracts and "
^DIC(19,16523,1,39,0)="transmissions runs to be initiated for a selected prior period manually. "
^DIC(19,16523,1,40,0)="Existing extracts may also be re-transmitted if required.         "
^DIC(19,16523,1,41,0)="Cloned from ""PXRM EXTRACT MANAGEMENT"" option."
^DIC(19,16523,3)=""
^DIC(19,16523,25)="PXRMETM"
^DIC(19,16523,"U")="REMINDER EXTRACT MANAGEMENT"
^DIC(19,16524,0)="EHM-01345^List Rule Management^^A^1^^^^^^^534^^1^^"
^DIC(19,16524,1,0)="^^21^21^3240328^"
^DIC(19,16524,1,1,0)="This option allows creation/editing of list rules which are used to build "
^DIC(19,16524,1,2,0)="patient lists and test rule set criteria. "
^DIC(19,16524,1,3,0)="      "
^DIC(19,16524,1,4,0)="There are four types of list rules criteria managed from this list manage "
^DIC(19,16524,1,5,0)="option:"
^DIC(19,16524,1,6,0)=" "
^DIC(19,16524,1,7,0)="       PATIENT LIST RULE   defines an existing patient list to identify "
^DIC(19,16524,1,8,0)="                           patients."
^DIC(19,16524,1,9,0)="       FINDING RULE        defines reminder term findings to identify "
^DIC(19,16524,1,10,0)="                           patients."
^DIC(19,16524,1,11,0)="       REMINDER RULE       defines a reminder, where the patient cohort "
^DIC(19,16524,1,12,0)="                           logic is used to identify applicable patients."
^DIC(19,16524,1,13,0)="       LIST RULE SET       combines multiple list rule criteria (Patient "
^DIC(19,16524,1,14,0)="                           List, Finding Rule, and Reminder Rule) in a"
^DIC(19,16524,1,15,0)="                           specified sequence, where each sequence has"
^DIC(19,16524,1,16,0)="                           an operation (Add, Remove, Select) to "
^DIC(19,16524,1,17,0)="                           create/modify a patient list."
^DIC(19,16524,1,18,0)=" "
^DIC(19,16524,1,19,0)="Nationally released list rules are used by nationally released extract  "
^DIC(19,16524,1,20,0)="definitions for national extract runs."
^DIC(19,16524,1,21,0)="Cloned from ""PXRM LIST RULE MANAGEMENT"" option."
^DIC(19,16524,3)=""
^DIC(19,16524,20)="D START^PXRMLRM"
^DIC(19,16524,"U")="LIST RULE MANAGEMENT"
^DIC(19,16525,0)="EHM-01346^Extract Definition Management^^A^1^^^^^^^534^^1^^"
^DIC(19,16525,1,0)="^19.06^6^6^3240328^^"
^DIC(19,16525,1,1,0)="This option allows creation/editing of extract definitions for use in "
^DIC(19,16525,1,2,0)="extract processing. Each extract definition identifies what list rules "
^DIC(19,16525,1,3,0)="should be used to create patient lists, what reminders should be run "
^DIC(19,16525,1,4,0)="against each patient list, and what counting rules should be used to "
^DIC(19,16525,1,5,0)="count findings found during reminder evaluation."
^DIC(19,16525,1,6,0)="Cloned from ""PXRM EXTRACT DEFINITION"" option."
^DIC(19,16525,3)=""
^DIC(19,16525,20)="D START^PXRMEPM"
^DIC(19,16525,"U")="EXTRACT DEFINITION MANAGEMENT"
^DIC(19,16526,0)="EHM-01347^Extract Counting Rule Management^^A^1^^^^^^^534^^1^^"
^DIC(19,16526,1,0)="^^5^5^3240328^"
^DIC(19,16526,1,1,0)="This option allows creation/editing of extract counting rules used in the "
^DIC(19,16526,1,2,0)="extract process. The counting rules define how to count the findings "
^DIC(19,16526,1,3,0)="defined in an extract counting group (most recent for each finding, most "
^DIC(19,16526,1,4,0)="recent finding in the group, utilization counts for the reporting period)."
^DIC(19,16526,1,5,0)="Cloned from ""PXRM EXTRACT COUNTING RULES"" option."
^DIC(19,16526,3)=""
^DIC(19,16526,20)="D START^PXRMEFM(0)"
^DIC(19,16526,"U")="EXTRACT COUNTING RULE MANAGEME"
^DIC(19,16527,0)="EHM-01348^Extract Counting Group Management^^A^1^^^^^^^534^^1^^"
^DIC(19,16527,1,0)="^^8^8^3240328^"
^DIC(19,16527,1,1,0)="This option allows creation/editing of extract counting groups.  Each "
^DIC(19,16527,1,2,0)="group defines reminder terms. Counting groups are used when an extract "
^DIC(19,16527,1,3,0)="definition is defined to accumulate COMPLIANCE and FINDING TOTALS (TYPE "
^DIC(19,16527,1,4,0)="OF TOTALS).  The counting groups are used in a counting rule during the "
^DIC(19,16527,1,5,0)="extract process to count findings within a group. The reminder term, "
^DIC(19,16527,1,6,0)="related counting group, and finding total counts are stored in the "
^DIC(19,16527,1,7,0)="Extract Reminder Summary file."
^DIC(19,16527,1,8,0)="Cloned from ""PXRM EXTRACT COUNTING GROUPS"" option."
^DIC(19,16527,3)=""
^DIC(19,16527,20)="D START^PXRMEGM(0)"
^DIC(19,16527,"U")="EXTRACT COUNTING GROUP MANAGEM"
