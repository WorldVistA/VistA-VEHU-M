^DIC(19,2956,0)="PRMR OSM AUTO ENROLL^Occurrence Screen Automatic Enrollment^PLEASE CONTACT YOUR SITE MANAGER REGARDING THE NEW OCCURRENCE SCREEN PACKAGE^R^.5^^^^^^^"
^DIC(19,2956,1,0)="^^5^5^2890503^^^^"
^DIC(19,2956,1,1,0)="This option searches the Patient file (#2) for patients who fit all"
^DIC(19,2956,1,2,0)="occurrence screens except 107 and 108.  Patients who are found to fit a screen"
^DIC(19,2956,1,3,0)="are entered into the Patient QA Event file (#513.72).  This option is"
^DIC(19,2956,1,4,0)="queued to run every night after midnight and searches for patients from"
^DIC(19,2956,1,5,0)="the previous day's Admissions/Transfers/Deaths."
