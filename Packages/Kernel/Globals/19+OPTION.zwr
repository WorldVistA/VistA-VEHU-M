^DIC(19,6770,0)="PSD CORRECTION LOG REPORT^Correction Log Report^^R^11595^^^^^^^276"
^DIC(19,6770,1,0)="^^3^3^2920911^^"
^DIC(19,6770,1,1,0)="This report lists all corrective actions logged for a selected date"
^DIC(19,6770,1,2,0)="range.  This report may be generated by order status changes or"
^DIC(19,6770,1,3,0)="by Green Sheet deletions."
^DIC(19,6770,25)="PSDCORP"
^DIC(19,6770,"U")="CORRECTION LOG REPORT"
^DIC(19,6771,0)="PSD NURSE REPRINT 2321^Reprint Transfer Between NAOUs (VA FORM 10-2321)^^R^11595^^^^^^^276"
^DIC(19,6771,1,0)="^^5^5^2940926^^^^"
^DIC(19,6771,1,1,0)="Nurses may reprint the transfer between NAOUs form (in lieu of"
^DIC(19,6771,1,2,0)="VA FORM 10-2321) for any Green Sheet and drug transferred from their"
^DIC(19,6771,1,3,0)="NAOU.  The form may be reprinted only if the transferred Green"
^DIC(19,6771,1,4,0)="Sheet and drug has not been received into the NAOU receiving"
^DIC(19,6771,1,5,0)="the transfer."
^DIC(19,6771,25)="PSDRPT"
^DIC(19,6771,"U")="REPRINT TRANSFER BETWEEN NAOUS"
^DIC(19,6772,0)="PSD NAOU USAGE^NAOU Usage Report^^R^11595^^^^^^^276"
^DIC(19,6772,1,0)="^^6^6^2941027^^^^"
^DIC(19,6772,1,1,0)="This report will print an NAOU drug usage report for a selected date"
^DIC(19,6772,1,2,0)="range.  The report may be sorted by drug (one, some, or ALL) or by"
^DIC(19,6772,1,3,0)="NAOU (one, some, or ALL).  A detailed list of orders, including the"
^DIC(19,6772,1,4,0)="pharmacy dispensing # (Green Sheet #), date filled, quantity, and who"
^DIC(19,6772,1,5,0)="ordered the drug will be printed.  Summary totals by order and quantity"
^DIC(19,6772,1,6,0)="are also generated."
^DIC(19,6772,25)="PSDNU"
^DIC(19,6772,"U")="NAOU USAGE REPORT"
