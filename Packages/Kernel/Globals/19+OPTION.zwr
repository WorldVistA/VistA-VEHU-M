^DIC(19,12733,0)="ORWOR EXPIRED ORDERS^GUI Expired Orders Search Hours^^A^10000000020^^^^^^^170^^1"
^DIC(19,12733,1,0)="^^6^6^3031202^"
^DIC(19,12733,1,1,0)="This option allows you to set the number of hours to search for a"
^DIC(19,12733,1,2,0)="patient's expired orders.  For example, a value of ""24"" hours will search"
^DIC(19,12733,1,3,0)="for all of the patient's orders that have expired within the past 24 "
^DIC(19,12733,1,4,0)="hours. The number of hours determines what expired orders are displayed in"
^DIC(19,12733,1,5,0)="the Recently Expired Orders view.  This can be selected on the Orders tab"
^DIC(19,12733,1,6,0)="under the View menu."
^DIC(19,12733,10.1)="Expired Orders Hours"
^DIC(19,12733,20)="D EDITPAR^XPAREDIT(""ORWOR EXPIRED ORDERS"")"
^DIC(19,12733,"U")="GUI EXPIRED ORDERS SEARCH HOUR"
