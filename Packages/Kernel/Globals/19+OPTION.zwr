^DIC(19,15771,1,0)="^^3^3^3240328^^^^"
^DIC(19,15771,1,1,0)="This option lets you create or change the things that are orderable via"
^DIC(19,15771,1,2,0)="generic text orders at your site."
^DIC(19,15771,1,3,0)="Cloned from ""ORCM ORDERABLES"" option."
