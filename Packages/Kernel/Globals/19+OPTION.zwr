^DIC(19,13394,"U")="EXTENDED ABSENCE"
^DIC(19,13395,0)="PRSP EA DISPLAY^Display Extended Absence^^R^1^^^^^^^230"
^DIC(19,13395,1,0)="^19.06^2^2^3041025^^"
^DIC(19,13395,1,1,0)="This option allows a user to display a list of their extended absence "
^DIC(19,13395,1,2,0)="records that end on or after a specified date."
^DIC(19,13395,25)="PRSPEAD"
^DIC(19,13395,"U")="DISPLAY EXTENDED ABSENCE"
^DIC(19,13396,0)="PRSP HR EM^Enter Memoranda^^R^1^^^^^^^230"
^DIC(19,13396,1,0)="^^2^2^3050302^"
^DIC(19,13396,1,1,0)="This option allows Human Resources to enter Memoranda of Service Level"
^DIC(19,13396,1,2,0)="Expectations for part-time physicians."
^DIC(19,13396,25)="MAIN^PRSPEM"
^DIC(19,13396,"U")="ENTER MEMORANDA"
^DIC(19,13397,0)="PRSP HR TM^Terminate Memoranda^^R^1^^^^^^^230"
^DIC(19,13397,1,0)="^^2^2^3050302^"
^DIC(19,13397,1,1,0)="This option allows Human Resources to terminate Memoranda of Service"
^DIC(19,13397,1,2,0)="Level Expectations for part-time physicians."
^DIC(19,13397,25)="MAIN^PRSPTM"
^DIC(19,13397,"U")="TERMINATE MEMORANDA"
^DIC(19,13398,0)="PRSP HR DFM^Delete Future Memoranda^^R^1^^^^^^^230"
^DIC(19,13398,1,0)="^^4^4^3050302^"
^DIC(19,13398,1,1,0)="This option allows Human Resources to delete Memoranda of Service Level"
^DIC(19,13398,1,2,0)="Expectations for part-time physicians.  The first pay period covered must"
^DIC(19,13398,1,3,0)="either not be open or if opened, the part-time physician's timecard must"
^DIC(19,13398,1,4,0)="be in the status of TIMEKEEPER."
^DIC(19,13398,25)="MAIN^PRSPDFM"
^DIC(19,13398,"U")="DELETE FUTURE MEMORANDA"
^DIC(19,13399,0)="PRSP HR BRP^Begin Reconciliation Process^^R^1^^^^^^^230"
^DIC(19,13399,1,0)="^19.06^2^2^3050122^^^"
^DIC(19,13399,1,1,0)="This option allows Human Resources to review part-time physician"
^DIC(19,13399,1,2,0)="Memoranda and to begin its reconciliation."
^DIC(19,13399,25)="MAIN^PRSPBRP"
^DIC(19,13399,"U")="BEGIN RECONCILIATION PROCESS"
^DIC(19,13400,0)="PRSP HR MAIN^PT Physician Menu^^M^1^^^^^^^230"
