^DIC(19,8504,0)="NURSING PROBLEM LIST^Nursing Problem list^^^11278"
^DIC(19,8504,"U")="NURSING PROBLEM LIST"
^DIC(19,8505,0)="IBT MONTHLY AUTO GEN AVE BILL^Auto-Build Average Bill Amounts^^R^.5^^^^^^^192"
^DIC(19,8505,1,0)="^^12^12^2941101^"
^DIC(19,8505,1,1,0)="This option will calculate the number of bills and the average bill"
^DIC(19,8505,1,2,0)="amounts for a month and store the data in the CLAIMS TRACKING UNBILLED"
^DIC(19,8505,1,3,0)="AMOUNTS file (356.19).  This data will then be used by the scheduled"
^DIC(19,8505,1,4,0)="option Auto-Build Unbilled Amounts Report (IBT MONTHLY AUTO GEN UNBILLED)"
^DIC(19,8505,1,5,0)="to generate the unbilled amounts data that needs to be reported by the 3rd"
^DIC(19,8505,1,6,0)="work day of the month."
^DIC(19,8505,1,7,0)=" "
^DIC(19,8505,1,8,0)="Queue this option to run once monthly.  Sites may choose the date it"
^DIC(19,8505,1,9,0)="should run but it is suggested that it run after the 15th of the month"
^DIC(19,8505,1,10,0)="when user activity is low  (i.e. November 19, 1994 @ 2:00am).  No device"
^DIC(19,8505,1,11,0)="is necessary, the results are stored and a completion mail message is sent"
^DIC(19,8505,1,12,0)="to the mail group specified in the IB SITE PARAMETERS file."
^DIC(19,8505,25)="AUTO^IBTUBAV"
^DIC(19,8505,200.9)="y"
^DIC(19,8505,"U")="AUTO-BUILD AVERAGE BILL AMOUNT"
^DIC(19,8506,0)="IBT MONTHLY AUTO GEN UNBILLED^Auto-build Unbilled Amounts Report^^R^.5^^^^^^^192"
^DIC(19,8506,1,0)="^^7^7^2941103^^"
^DIC(19,8506,1,1,0)="This option will automatically generate the unbilled amounts report that"
^DIC(19,8506,1,2,0)="contains the data that needs to be input to our general ledger accounts by"
^DIC(19,8506,1,3,0)="the 3rd work day of the month.  Schedule this option to run once monthly"
^DIC(19,8506,1,4,0)="on the 1st or 2nd day of the month."
^DIC(19,8506,1,5,0)=" "
^DIC(19,8506,1,6,0)="No device is needed, the results are sent in a mail message to the"
^DIC(19,8506,1,7,0)="mailgroup specified in the IB SITE PARAMETERS file."
^DIC(19,8506,25)="AUTO^IBTUBO"
^DIC(19,8506,200.9)="y"
^DIC(19,8506,"U")="AUTO-BUILD UNBILLED AMOUNTS RE"
^DIC(19,8507,0)="IBT UNBILLED MENU^Unbilled Amounts Menu^^M^.5^^^^^^^192"
^DIC(19,8507,1,0)="^^2^2^2941006^"
^DIC(19,8507,1,1,0)="This menu contains the 4 user options available to regenerate and "
^DIC(19,8507,1,2,0)="view the Unbilled Amounts report."
^DIC(19,8507,10,0)="^19.01PI^4^4"
^DIC(19,8507,10,1,0)="8508^"
^DIC(19,8507,10,2,0)="8509^"
^DIC(19,8507,10,3,0)="8510^"
^DIC(19,8507,10,4,0)="8511^"
^DIC(19,8507,10,"B",8508,1)=""
^DIC(19,8507,10,"B",8509,2)=""
^DIC(19,8507,10,"B",8510,3)=""
^DIC(19,8507,10,"B",8511,4)=""
^DIC(19,8507,99)="56232,40015"
^DIC(19,8507,99.1)="67804,41143"
^DIC(19,8507,"U")="UNBILLED AMOUNTS MENU"
^DIC(19,8508,0)="IBT VIEW UNBILLED AMOUNTS^View Unbilled Amounts^^R^.5^^^^^^^192"
^DIC(19,8508,1,0)="^^2^2^2941006^"
^DIC(19,8508,1,1,0)="This option can be used to view previously computed unbilled amounts "
^DIC(19,8508,1,2,0)="without having to re-compile the data."
^DIC(19,8508,25)="IBTUBV"
^DIC(19,8508,"U")="VIEW UNBILLED AMOUNTS"
^DIC(19,8509,0)="IBT RE-GEN UNBILLED REPORT^Re-Generate Unbilled Amounts Report^^R^.5^^^^^^^192"
^DIC(19,8509,1,0)="^^4^4^2941017^^"
^DIC(19,8509,1,1,0)="This option can be used to re-generate the Unbilled amounts report for"
^DIC(19,8509,1,2,0)="a single month.  This will re-compute the unbilled care for the month"
^DIC(19,8509,1,3,0)="and update the unbilled amounts.  To simply view previously computed "
^DIC(19,8509,1,4,0)="data use the View option."
^DIC(19,8509,25)="IBTUBO"
^DIC(19,8509,"U")="RE-GENERATE UNBILLED AMOUNTS R"
^DIC(19,8510,0)="IBT RE-GEN AVE BILL AMOUNT^Re-Generate Average Bill Amounts^^R^.5^^^^^^^192"
^DIC(19,8510,1,0)="^^13^13^2941103^^"
^DIC(19,8510,1,1,0)="This option can be used to re-generate the monthly and"
^DIC(19,8510,1,2,0)="yearly counts and amounts of inpatient and outpatient bills"
^DIC(19,8510,1,3,0)="for a single month. If the month selected for input requires"
^DIC(19,8510,1,4,0)="the calculation of previous months data in order to obtain"
^DIC(19,8510,1,5,0)="its yearly values, this will be done when the option is"
^DIC(19,8510,1,6,0)="executed.  If the month selected has 12 prior months worth"
^DIC(19,8510,1,7,0)="of data, the month selected will be recalculated.  The"
^DIC(19,8510,1,8,0)="months subsequent to the month select (up to 12) will have"
^DIC(19,8510,1,9,0)="their yearly data recalculated.  This information is used to"
^DIC(19,8510,1,10,0)="compute the average bill amount for the Unbilled Amounts"
^DIC(19,8510,1,11,0)="Report.  The unbilled amount report is automatically"
^DIC(19,8510,1,12,0)="generated for only the month selected after the average bill"
^DIC(19,8510,1,13,0)="amounts are calculated."
^DIC(19,8510,25)="IBTUBAV"
^DIC(19,8510,"U")="RE-GENERATE AVERAGE BILL AMOUN"
^DIC(19,8511,0)="IBT SEND TEST UNBILLED MESS^Send Test Unbilled Amounts Bulletin^^R^.5^^^^^^^192"
^DIC(19,8511,1,0)="^^5^5^2941101^"
^DIC(19,8511,1,1,0)="This option allows for sending of a test mail message to the mail group to"
^DIC(19,8511,1,2,0)="receive the Unbilled Amounts messages.  Using this prior to reporting"
^DIC(19,8511,1,3,0)="problems can assist sites in determining whether the mail groups are set"
^DIC(19,8511,1,4,0)="up correctly. The mail group to get the message should be specified in"
^DIC(19,8511,1,5,0)="field UNBILLED MAIL GROUP (6.25) in the IB SITE PARAMETERS file (350.9)."
^DIC(19,8511,25)="TEST^IBTUBUL"
^DIC(19,8511,"U")="SEND TEST UNBILLED AMOUNTS BUL"
^DIC(19,8512,0)="ZLLRFIX FOR CENSUS DUPS^Duplicate Census Records^^^11273"
^DIC(19,8512,1,0)="^^1^1^2941219^"
^DIC(19,8512,1,1,0)="Report to print duplicate census records"
^DIC(19,8512,25)="ZLLRFIX"
^DIC(19,8512,"U")="DUPLICATE CENSUS RECORDS"
^DIC(19,8514,0)="PRCA TRAN TYPE HISTORY^Transaction History^^A^.5^^^^^^^^^1"
^DIC(19,8514,1,0)="^^3^3^2941103^^"
^DIC(19,8514,1,1,0)="This option will create a report that will list all transactions sorted"
^DIC(19,8514,1,2,0)="by type of transaction, category of bill and date for the specified"
^DIC(19,8514,1,3,0)="type of transaction, category of bill and date range."
^DIC(19,8514,20)="D ^RCTRAN"
^DIC(19,8514,"U")="TRANSACTION HISTORY"
^DIC(19,8515,0)="ENEQINV7^Non-EIL Inventory^^R^11740^^^^^^^33^^1^1"
^DIC(19,8515,1,0)="^^6^6^2991012^"
^DIC(19,8515,1,1,0)="This option generates the Non-EIL Inventory report. Equipment that belongs"
^DIC(19,8515,1,2,0)="to the user-specified CMR and is not required to be accountable by VHA"
^DIC(19,8515,1,3,0)="Directive will be printed on this report."
^DIC(19,8515,1,4,0)=" "
^DIC(19,8515,1,5,0)="See the CMR Inventory (EIL) report to print accountable equipment that"
^DIC(19,8515,1,6,0)="belongs to a CMR."
^DIC(19,8515,15)="K ENNXEXP"
^DIC(19,8515,20)="S ENNXEXP=1"
^DIC(19,8515,25)="CMR^ENEQRPI"
^DIC(19,8515,"U")="NON-EIL INVENTORY"
^DIC(19,8516,0)="PRSA PAY CY^Remove CY Code From 8B string^^R^10652"
^DIC(19,8516,25)="PRSCY"
^DIC(19,8516,"U")="REMOVE CY CODE FROM 8B STRING"
^DIC(19,8517,0)="PSD REPRINT WORKSHEET^Dispensing Worksheet Reprint^^R^11595^^^^^^^276"
^DIC(19,8517,1,0)="^^10^10^2940913^^^^"
^DIC(19,8517,1,1,0)="Pharmacy personnel use this option to reprint a dispensing worksheet."
^DIC(19,8517,1,2,0)="The previously printed dispensing worksheet, for a given dispensing"
^DIC(19,8517,1,3,0)="site, is utilized in reprinting this listing.  These orders are"
^DIC(19,8517,1,4,0)="sequenced by the sort selected during the original printing of the"
^DIC(19,8517,1,5,0)="worksheet.  The reprinted worksheet lists a worksheet number assigned"
^DIC(19,8517,1,6,0)="to this order, drug, quantity ordered, dispense to location, ordered"
^DIC(19,8517,1,7,0)="by, comments and blanks for manufacturer, lot #, and expiration date."
^DIC(19,8517,1,8,0)="If this order has been processed by pharmacy since the original printing,"
^DIC(19,8517,1,9,0)="the worksheet number will display as asterisk (*).  A new worksheet will"
^DIC(19,8517,1,10,0)="not be generated during the reprinting process."
^DIC(19,8517,25)="PSDRWK"
^DIC(19,8517,"U")="DISPENSING WORKSHEET REPRINT"
