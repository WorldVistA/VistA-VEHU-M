^DIC(19,14514,0)="HMPMON SET SYS DASHBOARD RATE^Set System's Dashboard Auto-update Rate^^R^1^HMP ADMIN^^^^^^"
^DIC(19,14514,1,0)="^^5^5^3160329^"
^DIC(19,14514,1,1,0)="Option HMPMON SET SYS DASHBOARD RATE lets the eHMP coordinator for this "
^DIC(19,14514,1,2,0)="Vista system set a system-level value for parameter HMPMON DASHBOARD "
^DIC(19,14514,1,3,0)="UPDATE to override the package-level default set by the eHMP primary "
^DIC(19,14514,1,4,0)="developers. This parameter controls the auto-update rate of the screens "
^DIC(19,14514,1,5,0)="in the eHMP Dashboard [HMPMON DASHBOARD]."
^DIC(19,14514,25)="SETSYS^HMPMONC"
^DIC(19,14514,"U")="SET SYSTEM'S DASHBOARD AUTO-UP"
^DIC(19,14515,0)="HMPMON SET PKG DASHBOARD RATE^Set Package's Dashboard Auto-update Rate^^R^1^HMP ADMIN^^^^^^"
^DIC(19,14515,1,0)="^^8^8^3160329^"
^DIC(19,14515,1,1,0)="Option HMPMON SET PKG DASHBOARD RATE lets the eHMP primary developers"
^DIC(19,14515,1,2,0)="set a package-level value for parameter HMPMON DASHBOARD UPDATE that"
^DIC(19,14515,1,3,0)="ships with the eHMP software. This parameter controls the auto-update rate"
^DIC(19,14515,1,4,0)="of the screens in the eHMP Dashboard [HMPMON DASHBOARD]. It can be "
^DIC(19,14515,1,5,0)="overridden by the eHMP coordinator for a Vista system or by individual "
^DIC(19,14515,1,6,0)="Dashboard users using the system-level or user-level parameters, but the "
^DIC(19,14515,1,7,0)="package-level parameter should not be changed outside the development "
^DIC(19,14515,1,8,0)="environments of the eHMP primary developers."
^DIC(19,14515,25)="SETPKG^HMPMONC"
^DIC(19,14515,"U")="SET PACKAGE'S DASHBOARD AUTO-U"
^DIC(19,14516,0)="HMPMON DASHBOARD^HMP Dashboard^^R^1^^^^^^^"
^DIC(19,14516,1,0)="^^5^5^3160413^"
^DIC(19,14516,1,1,0)="Option HMPMON DASHBOARD is a high-level system-management and "
^DIC(19,14516,1,2,0)="troubleshooting dashboard for monitoring the health of the Vista-side "
^DIC(19,14516,1,3,0)="eHMP software, including polling jobs, batch extracts, progress of "
^DIC(19,14516,1,4,0)="patients through the synchronization queue, errors generated by eHMP, and "
^DIC(19,14516,1,5,0)="usage of the ^XTMP and ^TMP globals."
^DIC(19,14516,25)="OPTION^HMPMON"
^DIC(19,14516,"U")="HMP DASHBOARD"
