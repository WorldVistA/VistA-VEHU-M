^DIC(19,8064,0)="IBT USER MENU (BI)^Claims Tracking Menu for Billing^^M^.5^^^^^^^192"
^DIC(19,8064,1,0)="^^6^6^2931027^"
^DIC(19,8064,1,1,0)="This menu contains the options in Claims tracking designed specifically"
^DIC(19,8064,1,2,0)="for billing clerks and billing supervisors who do not need to have any"
^DIC(19,8064,1,3,0)="Utilization Review Input.  Options include the ability to flag  care as"
^DIC(19,8064,1,4,0)="not billable, UR reports on billing case, and a claims tracking update"
^DIC(19,8064,1,5,0)="option."
^DIC(19,8064,1,6,0)=" "
