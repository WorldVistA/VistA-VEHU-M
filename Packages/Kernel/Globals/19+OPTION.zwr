^DIC(19,7583,0)="IB OUTPUT RANK CARRIERS^Rank Insurance Carriers By Amount Billed^^R^.5^^^^^^^192"
^DIC(19,7583,1,0)="^^14^14^2930908^^^^"
^DIC(19,7583,1,1,0)="This option is used to generate a listing of insurance carriers ranked"
^DIC(19,7583,1,2,0)="by the total amount billed.  The user may specify a date range from"
^DIC(19,7583,1,3,0)="which bills should be selected, as well as the number of carriers to"
^DIC(19,7583,1,4,0)="be ranked."
^DIC(19,7583,1,5,0)=" "
^DIC(19,7583,1,6,0)="This output must be transmitted to the MCCR Program Office after the"
^DIC(19,7583,1,7,0)="beginning of the fiscal year.  The selected date range should be the"
^DIC(19,7583,1,8,0)="entire fiscal year (i.e., 10/1/92 through 9/30/93) and 30 carriers"
^DIC(19,7583,1,9,0)="should be ranked.  You should first run the report without transmitting"
^DIC(19,7583,1,10,0)="in order to first review the results.  When the report is being run"
^DIC(19,7583,1,11,0)="in the Production account, the user will always have the opportunity"
^DIC(19,7583,1,12,0)="to transmit the report centrally.  The central mailgroup is"
^DIC(19,7583,1,13,0)="G.MCCR DATA@FORUM.VA.GOV, which is stored as a parameter in field"
^DIC(19,7583,1,14,0)="#4.05 in the IB SITE PARAMETERS (#350.9) file."
^DIC(19,7583,25)="IBCORC"
^DIC(19,7583,"U")="RANK INSURANCE CARRIERS BY AMO"
