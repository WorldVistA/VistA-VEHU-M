^DIC(19,15034,0)="RC PENSION REPORT^Pension Exemption Reconciliation Report (PERR)^^R^1^^^^^^^"
^DIC(19,15034,1,0)="^19.06^15^15^3210915^^^^"
^DIC(19,15034,1,1,0)=" The Pension Exempt Chg Recon Report provides a list of Veterans with an"
^DIC(19,15034,1,2,0)=" eligibility of VA Pension who have bills containing charges with a"
^DIC(19,15034,1,3,0)=" distinct Date of Service that has occurred on or after the Veteran's"
^DIC(19,15034,1,4,0)=" Co-payment Exemption Effective date."
^DIC(19,15034,1,5,0)=" "
^DIC(19,15034,1,6,0)="  The report criteria:"
^DIC(19,15034,1,7,0)=" "
^DIC(19,15034,1,8,0)="+ captures any charges WITHOUT an IB status of cancelled."
^DIC(19,15034,1,9,0)="+ ignores AR category of CC URGENT CARE ."
^DIC(19,15034,1,10,0)="+ identifies charges with an AR Status of Active, Open, Suspended, "
^DIC(19,15034,1,11,0)="  Write-Off, or Collected/ Closed, or an IB Status of On Hold."
^DIC(19,15034,1,12,0)="+ includes a feature to include ALL, which includes all of the previously"
^DIC(19,15034,1,13,0)="  listed statuses as well as AR Cancellations."
^DIC(19,15034,1,14,0)="+ Identifies charges with the statuses listed above, along with a date of "
^DIC(19,15034,1,15,0)="  service on or after the Veteran's exemption effective date."
^DIC(19,15034,25)="MAIN^RCDMCR8A"
^DIC(19,15034,"U")="PENSION EXEMPTION RECONCILIATI"
