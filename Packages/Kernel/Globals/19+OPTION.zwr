^DIC(19,3248,0)="DG GECS TRANSMIT USER^MAS Code Sheet Transmission Menu^^M^.5^^^"
^DIC(19,3248,1,0)="^^1^1^2890411^^"
^DIC(19,3248,1,1,0)="This menu is designated for users who transmit code sheets (batches)."
^DIC(19,3248,10,0)="^19.01IP^4^4"
