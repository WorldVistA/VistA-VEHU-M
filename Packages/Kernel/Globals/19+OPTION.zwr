^DIC(19,10744,0)="XUCSXGR LOCAL XSITE GREF VG^Local XSITE Global Reference Report By VG^^R^10000000033^^^^^^^477"
^DIC(19,10744,1,0)="^^4^4^2960227^"
^DIC(19,10744,1,1,0)="This report shows the number of global references/second ranked from"
^DIC(19,10744,1,2,0)="High-Low, by Volume Group.  A display of 'VAH,xxx' means the Volume Group"
^DIC(19,10744,1,3,0)="of where the global ""lives"" was not captured by MPM.  Any global data"
^DIC(19,10744,1,4,0)="stored in file #8987.2 prior to patch XT*7.3*14 will display this way."
^DIC(19,10744,25)="VG^XUCSXGR"
