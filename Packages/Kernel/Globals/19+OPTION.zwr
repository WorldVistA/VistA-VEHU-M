^DIC(19,15712,1,0)="^^4^4^3240328^"
^DIC(19,15712,1,1,0)="Enter the number of hours delay to wait after a medication order is placed"
^DIC(19,15712,1,2,0)="before triggering an Unverified Medication Order notification/alert.  The"
^DIC(19,15712,1,3,0)="maximum number of hours is 10,000."
^DIC(19,15712,1,4,0)="Cloned from ""ORB3 UNVERIFIED MED ORDER"" option."
