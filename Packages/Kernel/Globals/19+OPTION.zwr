^DIC(19,6699,"U")="CONTROLLED SUBSTANCES MENU"
^DIC(19,6700,0)="PSD MARK^Mark/Unmark Drugs for Controlled Substances Use^^R^11595^^^^^^^276"
^DIC(19,6700,1,0)="^^2^2^2940908^^^^"
^DIC(19,6700,1,1,0)="This option provides the ability to mark/unmark entries in the"
^DIC(19,6700,1,2,0)="DRUG file (#50) for use with the Controlled Substances package."
^DIC(19,6700,25)="PSDAPU"
^DIC(19,6700,99)="55657,35933"
^DIC(19,6700,"U")="MARK/UNMARK DRUGS FOR CONTROLL"
^DIC(19,6701,0)="PSD INACTIVATE NAOU STOCK DRUG^Inactivate NAOU Stock Drug^^R^11595^^^^^^^276"
^DIC(19,6701,1,0)="^^2^2^2940908^^^^"
^DIC(19,6701,1,1,0)="This option is used to inactivate a drug that is currently on an NAOUs"
^DIC(19,6701,1,2,0)="stock list.  Drugs should not be deleted, but simply inactivated."
^DIC(19,6701,25)="PSDNSTK"
^DIC(19,6701,99)="57545,57160"
^DIC(19,6701,"U")="INACTIVATE NAOU STOCK DRUG"
^DIC(19,6702,0)="PSD WARD CONVERSION^Ward (for Drug) Transfer^^R^11595^^^^^^^276"
^DIC(19,6702,1,0)="^^6^6^2940929^^^^"
^DIC(19,6702,1,1,0)="This option will enable a user to change a ward (for drug) designation"
^DIC(19,6702,1,2,0)="from the old ward to a new ward for all drugs in all NAOUs or in a "
^DIC(19,6702,1,3,0)="single NAOU.  This can be used, for example, when a ward is closed down"
^DIC(19,6702,1,4,0)="for construction.  A background job can be queued for a later time"
^DIC(19,6702,1,5,0)="to do the conversion and a MailMan message will be sent to the person"
^DIC(19,6702,1,6,0)="who queued the job when it has run to completion."
^DIC(19,6702,25)="PSDWCHG"
^DIC(19,6702,99)="56496,39609"
^DIC(19,6702,"U")="WARD (FOR DRUG) TRANSFER"
^DIC(19,6703,0)="PSD NAOU PRINT^Show Narcotic Area of Use^^R^11595^^^^^^^276"
^DIC(19,6703,1,0)="^^2^2^2941027^^^^"
^DIC(19,6703,1,1,0)="This option allows the user to print the NAOUs/Location Type/Primary"
^DIC(19,6703,1,2,0)="Dispensing Site created in the Create/Edit the Narcotic Area of Use option."
^DIC(19,6703,25)="NAOU^PSDPRT"
^DIC(19,6703,"U")="SHOW NARCOTIC AREA OF USE"
^DIC(19,6704,0)="PSD WARD ADD/DEL^Add/Delete Ward (for Drug)^^R^11595^^^^^^^276"
^DIC(19,6704,1,0)="^^2^2^2940929^^^"
^DIC(19,6704,1,1,0)="This option will allow a user to add or delete a ward (for drug)"
^DIC(19,6704,1,2,0)="assignment for all stock drugs in one or more active NAOUs."
^DIC(19,6704,25)="PSDWADD"
^DIC(19,6704,"U")="ADD/DELETE WARD (FOR DRUG)"
^DIC(19,6705,0)="PSD NAOU INV GROUP EDIT^NAOU Inventory Group - Enter/Edit^^R^11595^^^^^^^276"
^DIC(19,6705,1,0)="^^5^5^2920915^^"
^DIC(19,6705,1,1,0)="This option allows the user to enter and edit inventory groups.  These"
^DIC(19,6705,1,2,0)="groups define a cluster of NAOUs.  For each of these NAOUs, one or more"
^DIC(19,6705,1,3,0)="inventory types may be defined.  This lets pharmacy detail a list of"
^DIC(19,6705,1,4,0)="standard NAOUs and inventory types that can be easily selected when"
^DIC(19,6705,1,5,0)="doing inventory."
^DIC(19,6705,25)="PSDGEN"
^DIC(19,6705,"U")="NAOU INVENTORY GROUP - ENTER/E"
^DIC(19,6706,0)="PSD DEA LIST^DEA Special Handling List^^R^11595^^^^^^^276"
^DIC(19,6706,1,0)="^^4^4^2950821^^^^"
^DIC(19,6706,1,1,0)="This report alphabetically lists the drug name, DEA Special Handling,"
^DIC(19,6706,1,2,0)="and NDC data for all drugs within the DRUG file (#50) marked for"
^DIC(19,6706,1,3,0)="Controlled Substances package use.  This report will be helpful in"
^DIC(19,6706,1,4,0)="researching drugs incorrectly marked for CS package use."
^DIC(19,6706,25)="PSDEA"
^DIC(19,6706,99)="55657,32945"
^DIC(19,6706,"U")="DEA SPECIAL HANDLING LIST"
^DIC(19,6707,0)="PSD DRUG FILE DATA^Drug File Stats for CS Drugs^^R^11595^^^^^^^276"
^DIC(19,6707,1,0)="^^5^5^2940908^^^^"
^DIC(19,6707,1,1,0)="This report lists the drug name, order unit, price per order unit, dispense"
^DIC(19,6707,1,2,0)="unit, dispense units per order unit, and price per dispense unit.  These"
^DIC(19,6707,1,3,0)="statistics are compiled from the DRUG file (#50) and may be used when"
^DIC(19,6707,1,4,0)="loading stock drugs into a Narcotic Area of Use. All drugs marked for"
^DIC(19,6707,1,5,0)="CS package use will print on this report."
^DIC(19,6707,25)="PSDCSL"
^DIC(19,6707,99)="55601,32123"
^DIC(19,6707,"U")="DRUG FILE STATS FOR CS DRUGS"
^DIC(19,6708,0)="PSD STOCK PRINT^Stock Drug Print (Stock Level and Location)^^R^11595^^^^^^^276"
^DIC(19,6708,1,0)="^^4^4^2940913^^^^"
^DIC(19,6708,1,1,0)="This report prints an alphabetic listing of all active drugs you have"
^DIC(19,6708,1,2,0)="defined in the DRUG ACCOUNTABILITY STATS file (#58.8).  This report"
^DIC(19,6708,1,3,0)="lists NAOU, drug name, location, stock levels, all ward (for drug)"
^DIC(19,6708,1,4,0)="assignments, and all inventory types."
^DIC(19,6708,25)="PSDPSTK"
^DIC(19,6708,99)="56349,57044"
^DIC(19,6708,"U")="STOCK DRUG PRINT (STOCK LEVEL "
^DIC(19,6709,0)="PSD STOCK LIST^Stock Drug List (Inventory Type and Location)^^R^11595^^^^^^^276"
^DIC(19,6709,1,0)="^^6^6^2940913^^^^"
^DIC(19,6709,1,1,0)="This report lists all active stocked drugs you have defined in the"
^DIC(19,6709,1,2,0)="DRUG ACCOUNTABILITY STATS file (#58.8).  This report can be"
^DIC(19,6709,1,3,0)="sorted alphabetically or by inventory type/location/drug.  The data"
^DIC(19,6709,1,4,0)="includes NAOU, location, drug name, stock level, and reorder level."
^DIC(19,6709,1,5,0)="The report sorted by inventory type/location/drug will include the"
^DIC(19,6709,1,6,0)="type as printed data."
^DIC(19,6709,25)="PSDLSTK"
^DIC(19,6709,"U")="STOCK DRUG LIST (INVENTORY TYP"
^DIC(19,6710,0)="PSD NAOU INV GROUP SORT^Sort NAOUs in Inventory Group^^R^11595^^^^^^^276"
^DIC(19,6710,1,0)="^^3^3^2930224^^"
^DIC(19,6710,1,1,0)="This option allows the user to change the order in which the NAOUs"
^DIC(19,6710,1,2,0)="will sort within an inventory group.  NAOUs should sort in the order"
^DIC(19,6710,1,3,0)="that they will be visited."
^DIC(19,6710,25)="PSDGSK"
^DIC(19,6710,"U")="SORT NAOUS IN INVENTORY GROUP"
^DIC(19,6711,0)="PSD NAOU INV GROUP PRINT^Inventory Group List (80 column)^^R^11595^^^^^^^276"
^DIC(19,6711,1,0)="^^2^2^2920227^"
^DIC(19,6711,1,1,0)="This option prints a list of the currently defined NAOU inventory"
^DIC(19,6711,1,2,0)="groups with their associated inventory types."
^DIC(19,6711,25)="PSDGPR"
^DIC(19,6711,"U")="INVENTORY GROUP LIST (80 COLUM"
^DIC(19,6712,0)="PSD NARC EDIT^Narcotic Breakdown Unit/Package Size - Enter/Edit^^R^11595^^^^^^^276"
^DIC(19,6712,1,0)="^^2^2^2930224^^^^"
^DIC(19,6712,1,1,0)="This option allows the user to enter or edit narcotic breakdown unit"
^DIC(19,6712,1,2,0)="and narcotic package size for stocked drugs in an active NAOU."
^DIC(19,6712,25)="PSDNARC"
^DIC(19,6712,"U")="NARCOTIC BREAKDOWN UNIT/PACKAG"
^DIC(19,6713,0)="PSD TRANSFER MENU^Transfer Stock Entries^^M^11595^PSD TRAN^^^^^^276"
^DIC(19,6713,1,0)="^^5^5^2940919^^^^"
^DIC(19,6713,1,1,0)="This menu option supports two distinct methods of transferring active"
^DIC(19,6713,1,2,0)="stock.  The first ""copies"" active stock from a Narcotic Area of Use"
^DIC(19,6713,1,3,0)="into another Narcotic Area of Use.  The second ""copies"" active stock"
^DIC(19,6713,1,4,0)="from a AR/WS Area of Use into a Controlled Substances Narcotic Area"
^DIC(19,6713,1,5,0)="of Use."
^DIC(19,6713,10,0)="^19.01PI^2^2"
^DIC(19,6713,10,1,0)="6714^^1"
^DIC(19,6713,10,2,0)="6715^^2"
^DIC(19,6713,10,"B",6714,1)=""
^DIC(19,6713,10,"B",6715,2)=""
^DIC(19,6713,99)="62088,37770"
^DIC(19,6713,"U")="TRANSFER STOCK ENTRIES"
^DIC(19,6714,0)="PSD TRANSFER NAOU^NAOU to NAOU Transfer Stock Entries^^R^11595^^^^^^^276"
^DIC(19,6714,1,0)="^^8^8^2940926^^^^"
^DIC(19,6714,1,1,0)="This option will ""copy"" the active stock entries from a selected Narcotic"
^DIC(19,6714,1,2,0)="Area of Use into one or more selected NAOUs.  As many as 10 NAOUs may be"
^DIC(19,6714,1,3,0)="chosen for transfer at one time.  You may transfer either drug name only,"
^DIC(19,6714,1,4,0)="or drug name, stock level, and location code, or drug name, stock level,"
^DIC(19,6714,1,5,0)="location code, and inventory types.  The ""copy"" process will not copy"
^DIC(19,6714,1,6,0)="inactive drugs.  The actual transfer takes place in a background job"
^DIC(19,6714,1,7,0)="which is automatically queued.  When the transfer is complete, you will"
^DIC(19,6714,1,8,0)="be notified by a MailMan message."
^DIC(19,6714,25)="PSDTRN"
^DIC(19,6714,"U")="NAOU TO NAOU TRANSFER STOCK EN"
^DIC(19,6715,0)="PSD TRANSFER AOU^AOU to NAOU Transfer Entries^^R^11595^^^^^^^276"
^DIC(19,6715,1,0)="^^9^9^2941027^^^^"
^DIC(19,6715,1,1,0)="This option will ""copy"" the active stock entries from a selected AR/WS"
^DIC(19,6715,1,2,0)="Area of Use into one or more selected Controlled Substances Narcotic"
^DIC(19,6715,1,3,0)="Areas of Use.  As many as 10 NAOUs may be chosen for transfer at one"
^DIC(19,6715,1,4,0)="time.  You may transfer either the drug name only, or the drug name, stock"
^DIC(19,6715,1,5,0)="level, and location code, or drug name, stock level, location code, and"
^DIC(19,6715,1,6,0)="inventory types.  The ""copy"" process will not copy inactive drugs."
^DIC(19,6715,1,7,0)="The actual transfer takes place in a background job which is queued"
^DIC(19,6715,1,8,0)="automatically.  When the transfer is complete, you will be notified by"
^DIC(19,6715,1,9,0)="a MailMan message."
^DIC(19,6715,25)="PSDTRA"
^DIC(19,6715,"U")="AOU TO NAOU TRANSFER ENTRIES"
^DIC(19,6716,0)="PSD MFG REPORT PRINT^Manufacturer and Narcotic Information Report^^R^11595^^^^^^^276"
^DIC(19,6716,1,0)="^^6^6^2941027^^^^"
^DIC(19,6716,1,1,0)="This report prints an alphabetical listing of all ACTIVE drugs within an"
^DIC(19,6716,1,2,0)="ACTIVE NAOU that have been defined in the DRUG ACCOUNTABILITY STATS file"
^DIC(19,6716,1,3,0)="(#58.8). This report lists NAOU, drug name, manufacturer, lot #, expiration"
^DIC(19,6716,1,4,0)="date, narcotic breakdown unit, and narcotic package size.  This report may"
^DIC(19,6716,1,5,0)="be sorted alphabetically by NAOU, then drug name or drug name, then NAOU."
^DIC(19,6716,1,6,0)="The user may select one NAOU, several NAOUs, or all NAOUs to print."
^DIC(19,6716,25)="PSDPMFG"
^DIC(19,6716,"U")="MANUFACTURER AND NARCOTIC INFO"
^DIC(19,6717,0)="PSD DRUG CHECK^Check Stocked Drugs for CS Use^^R^11595^^^^^^^276"
^DIC(19,6717,1,0)="^^5^5^2930224^^^"
^DIC(19,6717,1,1,0)="This option queues a background job to check all ACTIVE drugs stocked,"
^DIC(19,6717,1,2,0)="within an ACTIVE NAOU, for use with the Controlled Substances package."
^DIC(19,6717,1,3,0)="If a stocked drug has been unmarked for CS use the drug will then be"
^DIC(19,6717,1,4,0)="inactivated.  At job completion a MailMan message will be sent listing"
^DIC(19,6717,1,5,0)="any drug discrepancies."
^DIC(19,6717,25)="PSDMAPU"
^DIC(19,6717,"U")="CHECK STOCKED DRUGS FOR CS USE"
^DIC(19,6718,0)="PSD MGR REPORTS^Management Reports^^M^11595^^^^^^^276"
^DIC(19,6718,1,0)="^^2^2^2940908^^^^"
^DIC(19,6718,1,1,0)="This option contains all reports or lists associated with drug"
^DIC(19,6718,1,2,0)="accountability for narcotics."
^DIC(19,6718,10,0)="^19.01PI^16^16"
^DIC(19,6718,10,1,0)="6743^^10"
^DIC(19,6718,10,2,0)="6738^^15"
