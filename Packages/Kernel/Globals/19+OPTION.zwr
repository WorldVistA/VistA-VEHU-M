^DIC(19,6143,10,"B",6142,1)=""
^DIC(19,6143,10,"B",6144,3)=""
^DIC(19,6143,10,"B",6406,4)=""
^DIC(19,6143,10,"C",1,2)=""
^DIC(19,6143,10,"C",2,1)=""
^DIC(19,6143,10,"C",3,3)=""
^DIC(19,6143,10,"C",4,4)=""
^DIC(19,6143,99)="57097,29934"
^DIC(19,6143,99.1)="53998,40903"
^DIC(19,6143,"U")="ELECTRONIC WORK REQUESTS"
^DIC(19,6144,0)="ENWOSTATUS-WARD^Electronic Work Order Status Check^^R^.5^^^^^^^"
^DIC(19,6144,1,0)="^^3^3^2901101^^^^"
^DIC(19,6144,1,1,0)="Enables users outside of Engineering Service to view the status of work"
^DIC(19,6144,1,2,0)="orders, including those entered as Electronic Work Order Requests. This"
^DIC(19,6144,1,3,0)="option does not allow any changes to be made to the work order record."
^DIC(19,6144,25)="WRDCK^ENWARD"
^DIC(19,6144,"U")="ELECTRONIC WORK ORDER STATUS C"
^DIC(19,6145,0)="ENSITE^ENG SITE PARAMETERS Enter/Edit^^E^.5^^^^^^^"
^DIC(19,6145,1,0)="^^4^4^2911008^^^"
^DIC(19,6145,1,1,0)="Used to set up the Engineering Site parameters. Certain entries in this"
^DIC(19,6145,1,2,0)="file are mandatory if a site intends to transmit 10-0051's (Construction"
^DIC(19,6145,1,3,0)="Project Tracking Reports) electronically and/or allow computerized entry"
^DIC(19,6145,1,4,0)="of work requests non-Engineering personnel."
^DIC(19,6145,30)="DIC(6910,"
^DIC(19,6145,31)="AEMQ"
^DIC(19,6145,50)="DIC(6910,"
^DIC(19,6145,51)="1:99"
^DIC(19,6145,"U")="ENG SITE PARAMETERS ENTER/EDIT"
^DIC(19,6148,0)="ENSWOPT^SOFTWARE OPTIONS Enter/Edit^^E^.5^^^^^^^"
^DIC(19,6148,1,0)="^^2^2^2890727^"
^DIC(19,6148,1,1,0)="Enables user to choose the manner in which selected AEMS/MERS features"
^DIC(19,6148,1,2,0)="will operate at his/her site."
^DIC(19,6148,30)="ENG(6910.2,"
^DIC(19,6148,31)="AEQM"
^DIC(19,6148,50)="ENG(6910.2,"
^DIC(19,6148,51)="[ENSWOPT]"
^DIC(19,6148,"U")="SOFTWARE OPTIONS ENTER/EDIT"
