^DIC(19,11743,0)="LR BAR ZEBRA UTILITY^Lab Zebra Label Utility^^R^11740^^^^^^^26"
^DIC(19,11743,1,0)="^19.06^18^18^3000517^^^^"
^DIC(19,11743,1,1,0)="This option is used to perform several configuration functions that"
^DIC(19,11743,1,2,0)="relate to the Zebra label printers."
^DIC(19,11743,1,3,0)=" "
^DIC(19,11743,1,4,0)="It allows the user to:"
^DIC(19,11743,1,5,0)=" "
^DIC(19,11743,1,6,0)="          1         Configuration Update"
^DIC(19,11743,1,7,0)="          2         Print Configuration Label"
^DIC(19,11743,1,8,0)="          3         Adjust Tear Off Position"
^DIC(19,11743,1,9,0)="          4         Label Top Position"
^DIC(19,11743,1,10,0)="          5         Set Darkness"
^DIC(19,11743,1,11,0)="          6         Mode Protection (Stripe printers only)"
^DIC(19,11743,1,12,0)=" "
^DIC(19,11743,1,13,0)="Note: Some functions are applicable to specific models of Zebra"
^DIC(19,11743,1,14,0)="      printers. Based on the firmware version installed in a printer,"
^DIC(19,11743,1,15,0)="      the effect of these functions may vary. Parameters allowed by"
^DIC(19,11743,1,16,0)="      these functions may be different due to changes in firmware."
^DIC(19,11743,1,17,0)="      Consult the ZPL II Programming Guide, specific model User's Guide"
^DIC(19,11743,1,18,0)="      and Firmware Release Notes for specific information."
^DIC(19,11743,25)="EN^LRBARCFA"
^DIC(19,11743,"U")="LAB ZEBRA LABEL UTILITY"
