^DIC(19,10417,"U")="PROGRESS NOTES PRINT OPTIONS"
^DIC(19,10418,0)="TIU PRINT PN OUTPT LOC^Outpatient Location- Print Progress Notes^^R^11712^^^^^^^516"
^DIC(19,10418,1,0)="^^4^4^2960228^^^"
^DIC(19,10418,1,1,0)="This option is designed to be used primarily by MAS.  It produces"
^DIC(19,10418,1,2,0)="CHARTABLE notes and tracks the last note prted for the selected"
^DIC(19,10418,1,3,0)="outpatient location.  Output is sorted in alphabetical by patient"
^DIC(19,10418,1,4,0)="order."
^DIC(19,10418,25)="LOC^TIUPRPN5"
^DIC(19,10418,"U")="OUTPATIENT LOCATION- PRINT PRO"
^DIC(19,10419,0)="TIU PRINT PN BATCH SCHEDULED^Scheduled Print Outpt PNs by Division^^R^11712^^^^^^^516"
^DIC(19,10419,1,0)="^^12^12^2960227^"
^DIC(19,10419,1,1,0)="This option will batch print outpatient progress notes in terminal digit"
^DIC(19,10419,1,2,0)="order by division.  This option is designed to print as a scheduled tasked"
^DIC(19,10419,1,3,0)="job at an interval selected by the sight.  Some sites may want to print"
^DIC(19,10419,1,4,0)="these notes weekly, other sites may opt for a monthly print.  Each"
^DIC(19,10419,1,5,0)="division will need to set up a separate job in the OPTION SCHEDULED"
^DIC(19,10419,1,6,0)="(#19.2) file.  The DIVISION is the required variable.  The starting point"
^DIC(19,10419,1,7,0)="will be extracted from file #8925.94.  If the date in field #1.01 is not"
^DIC(19,10419,1,8,0)="filled in, the job will terminate."
^DIC(19,10419,1,9,0)=" "
^DIC(19,10419,1,10,0)="When setting up the task in file #19.2, SET the variable TIUDIV equal to"
^DIC(19,10419,1,11,0)="the IEN of the division in file #8925.94 (TIU DIVISION PRINT PARAMETERS"
^DIC(19,10419,1,12,0)="FILE)."
^DIC(19,10419,25)="PRINT^TIUPRPN7"
^DIC(19,10419,200.9)="y"
^DIC(19,10419,"U")="SCHEDULED PRINT OUTPT PNS BY D"
^DIC(19,10420,0)="TIU PRINT PN BATCH INTERACTIVE^Batch Print Outpt PNs by Division^^R^11712^^^^^^^516"
^DIC(19,10420,1,0)="^^10^10^2960228^^^"
^DIC(19,10420,1,1,0)="This option will batch print outpatient progress notes in terminal digit"
^DIC(19,10420,1,2,0)="order by division.  Locations that the site would like excluded from this"
^DIC(19,10420,1,3,0)="job may edit field #3 in file #8925.93.  If the location is not entered in"
^DIC(19,10420,1,4,0)="file #8925.93, it WILL be included."
^DIC(19,10420,1,5,0)=" "
^DIC(19,10420,1,6,0)="For sites that would like to schedule this job to run non-interactively,"
^DIC(19,10420,1,7,0)="in file #19.2 (OPTION SCHEDULING) please see option [TIU PRINT PN BATCH"
^DIC(19,10420,1,8,0)="SCHEDULED].  If this option is scheduled in file #19.2 it should not be"
^DIC(19,10420,1,9,0)="run from the menu, unless, the file room clerks run out of work.  In this"
^DIC(19,10420,1,10,0)="case, a fresh batch of PNs would keep them busy."
^DIC(19,10420,25)="BATCH^TIUPRPN7"
^DIC(19,10420,"U")="BATCH PRINT OUTPT PNS BY DIVIS"
^DIC(19,10421,0)="TIU PRINT PN MAS MENU^MAS Progress Notes Print Options^^M^11712^^^^^^^516^^^^^1"
^DIC(19,10421,1,0)="^^2^2^2960227^^"
^DIC(19,10421,1,1,0)="This is a menu with the print options intended for use by MAS; not PNs end"
^DIC(19,10421,1,2,0)="users."
^DIC(19,10421,10,0)="^19.01IP^4^4"
