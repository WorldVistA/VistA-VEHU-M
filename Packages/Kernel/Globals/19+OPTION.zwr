^DIC(19,14189,1,0)="^^3^3^3070301^"
^DIC(19,14189,1,1,0)="Displays the SCT Overrides on file for a Message Parameter (#62.48) file "
^DIC(19,14189,1,2,0)="entry.  It can also display all SCT Overrides on file for all Message "
^DIC(19,14189,1,3,0)="Parameter (#62.48) entries."
^DIC(19,14189,25)="SCTOVER^LA7SRPT"
^DIC(19,14189,"U")="DISPLAY SCT OVERRIDES"
^DIC(19,14190,0)="LA7S LOAD MAPPING SCT^Load SNOMED SCT Mapping^^R^10000000216^LRLIASON^^^^^^53"
^DIC(19,14190,1,0)="^^13^13^3090623^"
^DIC(19,14190,1,1,0)="This option allows the user to load SNOMED CT (SCT) mappings and term"
^DIC(19,14190,1,2,0)="disposition into the target file entry. This mapping is usually provided "
^DIC(19,14190,1,3,0)="by STS after they have extracted and mapped the site's local terms to the "
^DIC(19,14190,1,4,0)="appropriate SCT code. If no mapping is provided then a disposition is "
^DIC(19,14190,1,5,0)="stored with the reason. A SCT mapping can also be provided as part of the "
^DIC(19,14190,1,6,0)="mediation process that occurs when a new term is added either by the site "
^DIC(19,14190,1,7,0)="or via an HL7 interface with the new term."
^DIC(19,14190,1,8,0)=" "
^DIC(19,14190,1,9,0)="The SCT mapping file is a text file that is usually provided via an FTP "
^DIC(19,14190,1,10,0)="transfer. This option prompts the user to specify the location of the "
^DIC(19,14190,1,11,0)="file, loads the contents of the file into a temporary holding LAB MAPPING"
^DIC(19,14190,1,12,0)="TRANSPORT file (#95.4) and then allows the user to apply the mappings to "
^DIC(19,14190,1,13,0)="the target entries."
^DIC(19,14190,25)="LOADSCT^LRSRVR8"
^DIC(19,14190,"U")="LOAD SNOMED SCT MAPPING"
