^DIC(19,16977,1,0)="^19.06^6^6^3240328^^"
^DIC(19,16977,1,1,0)="This option gives access to the Signature Block of the Electronic"
^DIC(19,16977,1,2,0)="Signature.  This is automatically set by a cross reference of the name"
^DIC(19,16977,1,3,0)="field. If it is changed with this option, it must contain the last name"
^DIC(19,16977,1,4,0)="from the name field. Also, if the name field is changed this field will be"
^DIC(19,16977,1,5,0)="changed also and may need to be re-edited."
^DIC(19,16977,1,6,0)="Cloned from ""XUSESIG BLOCK"" option."
