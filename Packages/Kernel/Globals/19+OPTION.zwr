^DIC(19,9077,0)="IBQL NATIONAL ROLLUP^Create Rollup File for National Transmition^^R^.5^^^^^^^456^^1"
^DIC(19,9077,1,0)="^^6^6^2950911^"
^DIC(19,9077,1,1,0)="This option will load the UTILIZATION MANAGEMENT ROLLUP file with"
^DIC(19,9077,1,2,0)="Random and Disease specific data for the national rollup.  This option is"
^DIC(19,9077,1,3,0)="queued to run at a site selected date between May 15 and June 15 and"
^DIC(19,9077,1,4,0)="requeued every six months. This data is pulled from the Hospital Review"
^DIC(19,9077,1,5,0)="file (#356.1) based on discharged dates in the Claims Tracking file"
