^DIC(19,4586,1,1,0)="This option allows enter/edit of Billing Rates that will be used in the"
^DIC(19,4586,1,2,0)="automatic calculation of costs when preparing a third party bill."
^DIC(19,4586,25)="IBEBR"
^DIC(19,4586,"U")="ENTER/EDIT BILLING RATES"
^DIC(19,4587,0)="IB RETURN BILL LIST^Returned Bill List^^R^.5^^^^^^^192"
