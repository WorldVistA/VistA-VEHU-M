^DIC(19,11262,1,0)="^19.06^4^4^3020122^^^^"
^DIC(19,11262,1,1,0)="This is an option to transfer an Item to a different Location.  In order"
^DIC(19,11262,1,2,0)="to transfer an Item, it must be set-up to both Location.  User can"
^DIC(19,11262,1,3,0)="transfer all Quantities or certain Quantities.  This option does not"
^DIC(19,11262,1,4,0)="remove an item from a location if all quantities have been transferred."
