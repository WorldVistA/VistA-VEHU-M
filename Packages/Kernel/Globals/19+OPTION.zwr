^DIC(19,3559,0)="PRCAC DCDOJ REFER^Refer to RC/DOJ^^A^10000000033^^^^^^^^^1"
^DIC(19,3559,1,0)="^^8^8^2971210^^^^"
^DIC(19,3559,1,1,0)="This option is used to refer the selected bills to Regional Counsel or the"
^DIC(19,3559,1,2,0)="Department of Justice.  This option should not be used for Third Party"
^DIC(19,3559,1,3,0)="Bills which are electronically transferred.  The referral process consists"
^DIC(19,3559,1,4,0)="of creating the appropriate AR Transaction and updating the bill"
^DIC(19,3559,1,5,0)="information."
^DIC(19,3559,1,6,0)=" "
^DIC(19,3559,1,7,0)="If the bill is currently referred, the user may cancel the referral,"
^DIC(19,3559,1,8,0)="using this option. "
