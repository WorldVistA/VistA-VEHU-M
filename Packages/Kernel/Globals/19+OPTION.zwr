^DIC(19,9764,"U")="INTAKE/OUTPUT DATA ENTRY MENU"
^DIC(19,9765,0)="NURCPE-I/O-IV CARE^Start/Add/DC IV and Maintenance^^R^10958^^^^^^^28"
^DIC(19,9765,1,0)="^^17^17^2961219^"
^DIC(19,9765,1,1,0)="This option contains seven protocols associated with intravenous therapy:"
^DIC(19,9765,1,2,0)="   1. Start IV - Starts a new IV line or heparin/saline lock/port."
^DIC(19,9765,1,3,0)="   2. Solution: Replace/DC/Convert/Finish Solution - DC's the current"
^DIC(19,9765,1,4,0)="      solution, then replaces a new solution to the selected IV line or"
^DIC(19,9765,1,5,0)="      converts the IV according to the user's choice."
^DIC(19,9765,1,6,0)="   3. Replace Same Solution - Replaces the same solution to a selected IV "
^DIC(19,9765,1,7,0)="      line."
^DIC(19,9765,1,8,0)="   4. DC IV/Lock/Port and Site - Removes the IV/lock/port from a selected "
^DIC(19,9765,1,9,0)="      IV site and documents tubing changes."
^DIC(19,9765,1,10,0)="   5. Care/Maintenance/Flush - Checks the site condition, and documents"
^DIC(19,9765,1,11,0)="      dressing, tubing changese and flushes."
^DIC(19,9765,1,12,0)="   6. Add Additional Solution(s) - Adds additional solution(s) to an IV "
^DIC(19,9765,1,13,0)="      line without discontinuing an existing one."
^DIC(19,9765,1,14,0)="   7. Restart DC'd IV - Restarts an IV which was discontinued due to "
^DIC(19,9765,1,15,0)="      infiltration or other reasons."
^DIC(19,9765,1,16,0)="   8. Adjust Infusion Rate - Adjusts infusion rate for a selected IV."
^DIC(19,9765,1,17,0)="   9. Flush - Flushes all IV line(s) for a selected infusion site."
^DIC(19,9765,25)="EN3^NURCYED0"
^DIC(19,9765,99)="55528,49963"
^DIC(19,9765,"U")="START/ADD/DC IV AND MAINTENANC"
