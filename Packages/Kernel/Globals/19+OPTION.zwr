^DIC(19,16065,0)="EHM-00886^Immunizations Documentation by BCMA Nightly Task^ Obsolete; Use CPRS Immunization Documentation^R^1^^^^^^^533^^^^"
^DIC(19,16065,1,0)="^^17^17^3240328^"
^DIC(19,16065,1,1,0)="This menu option has been marked OUT OF ORDER with patch PSB*3*142 and is "
^DIC(19,16065,1,2,0)="obsolete. Use CPRS Immunization Documentation."
^DIC(19,16065,1,3,0)=" "
^DIC(19,16065,1,4,0)="This option is intended to be scheduled as a nightly task, with a start "
^DIC(19,16065,1,5,0)="time after midnight but before 0800."
^DIC(19,16065,1,6,0)="When the task runs, it will create a record in the V IMMUNIZATIONS file "
^DIC(19,16065,1,7,0)="for each medication administration recorded the previous day for which "
^DIC(19,16065,1,8,0)="there is a mapped association between the PHARMACY ORDERABLE ITEM and an "
^DIC(19,16065,1,9,0)="IMMUNIZATION.  "
^DIC(19,16065,1,10,0)="  "
^DIC(19,16065,1,11,0)="When run interactively, the option will prompt the user for a start date, "
^DIC(19,16065,1,12,0)="allowing a manual backlog of immunization data to be recorded from BCMA "
^DIC(19,16065,1,13,0)="into PCE.  "
^DIC(19,16065,1,14,0)="  "
^DIC(19,16065,1,15,0)="Created by PSS*3*47 as part of Class III to Class I Conversion Project "
^DIC(19,16065,1,16,0)="""Immunizations Documentation by BCMA"""
^DIC(19,16065,1,17,0)="Cloned from ""PSB PX BCMA2PCE TASK"" option."
^DIC(19,16065,3)=""
^DIC(19,16065,25)="TASK^PSBPXLP"
^DIC(19,16065,200.9)="n"
^DIC(19,16065,"U")="IMMUNIZATIONS DOCUMENTATION BY"
^DIC(19,16066,0)="EHM-00887^Orders for MRRs With Removal Properties^^R^1^^^^^^^517^^^^"
^DIC(19,16066,1,0)="^^8^8^3240328^"
^DIC(19,16066,1,1,0)="This option enables you to determine which active orders contain "
^DIC(19,16066,1,2,0)="Orderable Items that have the new ""Prompt for Removal in BCMA"" flag value "
^DIC(19,16066,1,3,0)="set to 1, 2 or 3 that need to be discontinued and entered as New (not "
^DIC(19,16066,1,4,0)="copied, edited or renewed) AFTER the installation of Pharmacy Inpatient "
^DIC(19,16066,1,5,0)="Medications PSJ*5.0*315. Failure to re-create these orders could result"
^DIC(19,16066,1,6,0)="in confusing information to display on the BCMA VDL if displayed along"
^DIC(19,16066,1,7,0)="side newer MRR orders that do have the updated removal information."
^DIC(19,16066,1,8,0)="Cloned from ""PSS MRR ORDERS DIAGNOSTIC RPT"" option."
^DIC(19,16066,3)=""
^DIC(19,16066,25)="EN^PSSMRRDG"
^DIC(19,16066,"U")="ORDERS FOR MRRS WITH REMOVAL P"
^DIC(19,16067,0)="EHM-00888^Health Summary Enhanced Menu^^M^1^^^^^^^160^^^^"
^DIC(19,16067,1,0)="^^6^6^3240328^"
^DIC(19,16067,1,1,0)="This option allows the user to print Health Summaries based on pre-"
^DIC(19,16067,1,2,0)="defined Health Summary Types as well as Ad Hoc Summaries.  The user may"
^DIC(19,16067,1,3,0)="also list existing Health Summary Types and Health Summary Components and"
^DIC(19,16067,1,4,0)="may inquire about the structure of a Health Summary Type. This option also"
