^DIC(19,1052,1,1,0)="This option allows for the creation/editing of products in the"
^DIC(19,1052,1,2,0)="Tubefeeding file (118.2)."
^DIC(19,1052,25)="EN1^FHORT3"
^DIC(19,1052,"U")="ENTER/EDIT TUBEFEEDING PRODUCT"
^DIC(19,1053,0)="FHORTF2^List Tubefeeding Products^^R^10000000020^^^^^^^"
^DIC(19,1053,1,0)="^^3^3^2950302^^^"
^DIC(19,1053,1,1,0)="This option will list all tubefeeding products in the"
^DIC(19,1053,1,2,0)="Tubefeeding file (118.2) along with all associated data"
^DIC(19,1053,1,3,0)="elements."
^DIC(19,1053,25)="EN2^FHORT3"
^DIC(19,1053,"U")="LIST TUBEFEEDING PRODUCTS"
