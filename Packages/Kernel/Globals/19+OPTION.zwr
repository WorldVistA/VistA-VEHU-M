^DIC(19,7876,99)="58072,42129"
^DIC(19,7876,99.1)="56649,64814"
^DIC(19,7876,"U")="DUPLICATE RESOLUTION SYSTEM"
^DIC(19,7877,0)="XDR DISPLAY SEARCH STATUS^Display Search Status^^R^1039^XDR^^^^^^349"
^DIC(19,7877,1,0)="^^9^9^2970725^^"
^DIC(19,7877,1,1,0)="This option will display the status of a selected search for duplicates."
^DIC(19,7877,1,2,0)=" "
^DIC(19,7877,1,3,0)="The status may be RUNNING, HALTED, ERROE(STOP) or"
^DIC(19,7877,1,4,0)="COMPLETED.  If you are checking"
^DIC(19,7877,1,5,0)="the status to make sure the Duplicate Checking software is running"
^DIC(19,7877,1,6,0)="you must make sure that not only is the STATUS stated to be RUNNING"
^DIC(19,7877,1,7,0)="but also that the COUNT (which is the number of records that have been"
^DIC(19,7877,1,8,0)="checked for duplicates) is also steadily increasing.  If the COUNT is"
^DIC(19,7877,1,9,0)="not increasing notify your site manager."
^DIC(19,7877,25)="XDRDSTAT"
^DIC(19,7877,"U")="DISPLAY SEARCH STATUS"
^DIC(19,7878,0)="XDR FIND POTENTIAL DUPLICATES^Find Potential Duplicates for an Entry in a File^^R^1039^^^^^^^349"
^DIC(19,7878,1,0)="^^4^4^2971106^^^^"
^DIC(19,7878,1,1,0)="This option will find all potential duplicates for an entry in a file."
^DIC(19,7878,1,2,0)="Any potential duplicate pairs are then added to the Duplicate Record File."
^DIC(19,7878,1,3,0)="This user is prompted to enter the File and then to select an entry"
^DIC(19,7878,1,4,0)="within that file."
^DIC(19,7878,25)="XDRDFPD"
^DIC(19,7878,"U")="FIND POTENTIAL DUPLICATES FOR "
^DIC(19,7879,0)="XDR TALLY STATUS FIELDS^Tally STATUS and MERGE STATUS Fields^^R^1039^^^^^^^349"
^DIC(19,7879,1,0)="^^4^4^2971205^^^^"
^DIC(19,7879,1,1,0)=" "
^DIC(19,7879,1,2,0)="This is a summary report of how many records are verified duplicates or"
^DIC(19,7879,1,3,0)="verified not duplicates or potential duplicates unverified.  The total"
^DIC(19,7879,1,4,0)="number of records merged and ready to be merged will be displayed."
^DIC(19,7879,25)="XDRCNT"
^DIC(19,7879,"U")="TALLY STATUS AND MERGE STATUS "
^DIC(19,7880,0)="XTMENU^Application Utilities^^M^.5^^^^^^^"
^DIC(19,7880,1,0)="^^1^1^2930723^"
^DIC(19,7880,1,1,0)="This menu contains utilities that can be used by an application programmer."
^DIC(19,7880,10,0)="^19.01PI^2^2"
^DIC(19,7880,10,1,0)="7859^"
^DIC(19,7880,10,2,0)="7876^"
