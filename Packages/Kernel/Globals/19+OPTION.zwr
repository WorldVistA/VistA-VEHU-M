^DIC(19,7901,10,"B",7899,3)=""
^DIC(19,7901,10,"B",7900,5)=""
^DIC(19,7901,10,"B",7925,6)=""
^DIC(19,7901,10,"C",1,1)=""
^DIC(19,7901,10,"C",2,3)=""
^DIC(19,7901,10,"C",3,5)=""
^DIC(19,7901,10,"C",4,6)=""
^DIC(19,7901,99)="61957,33209"
^DIC(19,7901,"U")="PAYROLL TABLE MAINTENANCE"
^DIC(19,7902,0)="PRSA TL EDIT^Enter/Edit T&L Unit^^R^.5^^^^^^^"
^DIC(19,7902,1,0)="^^8^8^2930202^^"
^DIC(19,7902,1,1,0)="The user may create a new time and leave unit entry or edit an existing"
^DIC(19,7902,1,2,0)="entry. The user will be prompted to enter the three character code"
^DIC(19,7902,1,3,0)="for the time and leave unit, name, station number, Service/Section,"
^DIC(19,7902,1,4,0)="whether the time and leave unit is entitled to Saturday and Sunday"
^DIC(19,7902,1,5,0)="premium pay, the timekeeper(s), supervisor(s), and overtime/compensatory"
^DIC(19,7902,1,6,0)="time approver(s). If the time and leave unit has standby tours associated"
^DIC(19,7902,1,7,0)="with it, then a value should be entered for when the sleep time period"
^DIC(19,7902,1,8,0)="will begin."
^DIC(19,7902,25)="EDIT^PRSATL"
^DIC(19,7902,99)="55500,54392"
^DIC(19,7902,"U")="ENTER/EDIT T&L UNIT"
^DIC(19,7903,0)="PRSA TL DISP^Display T&L Unit^^R^.5^^^^^^^"
^DIC(19,7903,1,0)="^^8^8^2930202^^^"
^DIC(19,7903,1,1,0)="The user is prompted to select an existing time and leave unit. The"
^DIC(19,7903,1,2,0)="following data associated with the time and leave unit is displayed:"
^DIC(19,7903,1,3,0)="name, station number, Service/Section, whether the time and leave unit"
^DIC(19,7903,1,4,0)="has Saturday and Sunday premium pay, the timekeeper(s), supervisor(s),"
^DIC(19,7903,1,5,0)="and the overtime/compensatory time approver(s)."
^DIC(19,7903,1,6,0)=" "
^DIC(19,7903,1,7,0)="This option will display the data associated with the time and leave"
^DIC(19,7903,1,8,0)="unit. The user may not edit the data with this option."
^DIC(19,7903,25)="DISP^PRSATL"
^DIC(19,7903,99)="55500,54259"
^DIC(19,7903,"U")="DISPLAY T&L UNIT"
^DIC(19,7904,0)="PRSA PP OPEN^Open Next Pay Period^^R^.5^^^^^^^"
^DIC(19,7904,1,0)="^^3^3^2930202^^^^"
^DIC(19,7904,1,1,0)="This option allows Payroll to create a new pay period entry in the"
^DIC(19,7904,1,2,0)="TIME AND ATTENDANCE RECORDS file (#458) and creates a time card entry"
^DIC(19,7904,1,3,0)="for each employee within that pay period."
^DIC(19,7904,25)="PRSAPPO"
^DIC(19,7904,99)="55553,46621"
^DIC(19,7904,"U")="OPEN NEXT PAY PERIOD"
^DIC(19,7905,0)="PRSA TK TOUR-EDIT^Enter/Edit Employee Tour of Duty^^R^1^^^^^^^"
^DIC(19,7905,1,0)="^^8^8^3080821^"
^DIC(19,7905,1,1,0)="This option allows the user to enter or edit a Tour of Duty for an"
^DIC(19,7905,1,2,0)="employee for this pay period, the last one, or the next.  Various warnings"
^DIC(19,7905,1,3,0)="are provided if there are problems identified with the tour.  If tour"
^DIC(19,7905,1,4,0)="overlaps exist (e.g. Sat 11:30PM-8:00AM and Sun MID-8:30AM), then the tour"
^DIC(19,7905,1,5,0)="can not be saved.  When editing the ""Next"" pay period tour or creating a"
^DIC(19,7905,1,6,0)="""Permanent"" tour, no overlap can exist between day 1 and day 14.  The user"
^DIC(19,7905,1,7,0)="must wait until the next pay period is opened or select ""Temporary"" to"
^DIC(19,7905,1,8,0)="create this type of tour."
^DIC(19,7905,25)="PRSATE"
^DIC(19,7905,99)="55223,59683"
^DIC(19,7905,"U")="ENTER/EDIT EMPLOYEE TOUR OF DU"
^DIC(19,7906,0)="PRSA TK TOUR-DISP^Display Employee Tour of Duty^^R^.5^^^^^^^"
^DIC(19,7906,1,0)="^^3^3^2930430^^^^"
^DIC(19,7906,1,1,0)="This option allows the user to display the Tour(s) of Duty for"
^DIC(19,7906,1,2,0)="an employee for this pay period, the last one, or the next."
^DIC(19,7906,1,3,0)="The supervisor may choose to see a brief or detailed display."
^DIC(19,7906,25)="TK^PRSATE2"
^DIC(19,7906,99)="55377,38581"
^DIC(19,7906,"U")="DISPLAY EMPLOYEE TOUR OF DUTY"
^DIC(19,7907,0)="PRSA TK POST^Post Employee Time^^R^1^^^^^^^"
^DIC(19,7907,1,0)="^19.06^5^5^3050325^^^^"
^DIC(19,7907,1,1,0)="This option allows the Timekeeper to post timecard data on employees. The"
^DIC(19,7907,1,2,0)="Timekeeper is prompted for a date and whether or not to post the employees"
^DIC(19,7907,1,3,0)="timecards in alphabetical order.  A different option must be used if time"
^DIC(19,7907,1,4,0)="has to be posted for a part-time physician who has a Memorandum of Service"
^DIC(19,7907,1,5,0)="Level Expectations."
^DIC(19,7907,25)="PRSATP"
^DIC(19,7907,99)="55612,45269"
^DIC(19,7907,"U")="POST EMPLOYEE TIME"
^DIC(19,7908,0)="PRSA LV REQ^Leave Request^^R^.5^^^^^^^"
^DIC(19,7908,1,0)="^^4^4^2931208^^^^"
^DIC(19,7908,1,1,0)="This option allows an employee to make a request for leave (i.e.,"
^DIC(19,7908,1,2,0)="APPLICATION FOR LEAVE, SF 71). The employee must be entered in both"
^DIC(19,7908,1,3,0)="the PAID EMPLOYEE (#450) and NEW PERSON (#200) files and the social"
^DIC(19,7908,1,4,0)="security numbers must match."
^DIC(19,7908,25)="PRSALVR"
^DIC(19,7908,99)="55551,33522"
^DIC(19,7908,"U")="LEAVE REQUEST"
^DIC(19,7909,0)="PRSA EMP MENU^Employee Menu^^M^11596^^^^^^^^^1^1"
^DIC(19,7909,1,0)="^^2^2^2950725^^^^"
^DIC(19,7909,1,1,0)="This menu allows the employee to enter, cancel and list his/her leave"
^DIC(19,7909,1,2,0)="requests. Also, the employee may list his/her leave balances."
^DIC(19,7909,10,0)="^19.01PI^12^12"
^DIC(19,7909,10,1,0)="7908^1"
^DIC(19,7909,10,2,0)="7911^3"
