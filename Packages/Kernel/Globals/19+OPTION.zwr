^DIC(19,7772,0)="FBCH GENERIC PRICER^Generic Pricer Interface^^R^.5^^^^^^^"
^DIC(19,7772,1,0)="^^6^6^2930510^^"
^DIC(19,7772,1,1,0)="This option may be used to send a case to the NVHS Pricer system in"
^DIC(19,7772,1,2,0)="Austin.  The option does not require the patient to be in the"
^DIC(19,7772,1,3,0)="Patient file.  The same is true for the vendor.  The data that is sent"
^DIC(19,7772,1,4,0)="using this option will not be stored in the pricer database.  Cases can"
^DIC(19,7772,1,5,0)="be resubmitted.  The intent of this option is to help eliminate any"
^DIC(19,7772,1,6,0)="need for the use of FALCON."
^DIC(19,7772,25)="FBPRICE"
^DIC(19,7772,"U")="GENERIC PRICER INTERFACE"
