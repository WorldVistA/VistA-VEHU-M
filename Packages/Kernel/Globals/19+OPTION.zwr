^DIC(19,1641,0)="RA ABNORMAL^Abnormal Exam Report^^R^11712^^^^^^y^"
^DIC(19,1641,1,0)="^^5^5^2941115^"
^DIC(19,1641,1,1,0)="This option allows the Radiology/Nuclear Medicine Supervisor to print a"
^DIC(19,1641,1,2,0)="list of reported examinations which have a diagnostic code indicating"
^DIC(19,1641,1,3,0)="special action should be taken.  If the 'PRINT ON ABORNORMAL REPORT' field"
^DIC(19,1641,1,4,0)="of the diagnostic code in file 78.3 is set to 'Yes', any exams with that"
^DIC(19,1641,1,5,0)="diagnostic code will appear on this report."
^DIC(19,1641,25)="RAPRINT"
^DIC(19,1641,"U")="ABNORMAL EXAM REPORT"
^DIC(19,1642,0)="RA STATRPT^Status Time Report^^R^11712^^^^^^y^"
^DIC(19,1642,1,0)="^^5^5^2940606^^"
^DIC(19,1642,1,1,0)="This option allows the supervisor to generate a 'Status Tracking"
^DIC(19,1642,1,2,0)="Statistics' Report. For each status change within each division, the report"
^DIC(19,1642,1,3,0)="lists the original status, the updated status, minimum time to make the"
^DIC(19,1642,1,4,0)="status change, maximum time to make the status change, and the average time"
^DIC(19,1642,1,5,0)="to make the status change for an associated procedure."
^DIC(19,1642,25)="RASTAT"
^DIC(19,1642,"U")="STATUS TIME REPORT"
^DIC(19,1643,0)="RA MAJORAMISP^Major AMIS Code List^^R^11712^^^^^^^"
^DIC(19,1643,1,0)="^^2^2^2890221^^^^"
