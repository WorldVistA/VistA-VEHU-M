^DIC(19,14212,0)="FBAA REPROCESS BATCH^Reprocess Overdue Batch^^R^10000000216^FBAASUPERVISOR^^^^^^344"
^DIC(19,14212,1,0)="^^16^16^3111214^"
^DIC(19,14212,1,1,0)="This option is used to reprocess a transmitted payment batch that was not"
^DIC(19,14212,1,2,0)="received by Central Fee."
^DIC(19,14212,1,3,0)=" "
^DIC(19,14212,1,4,0)="If VistA Fee Basis does not receive a Payment Batch Result message by the "
^DIC(19,14212,1,5,0)="third weekday after transmission of the Payment Batch message, the "
^DIC(19,14212,1,6,0)="software will consider the result message as overdue.  A list of overdue "
^DIC(19,14212,1,7,0)="batches can be obtained by entering a ? at the select batch prompt of this"
^DIC(19,14212,1,8,0)="option."
^DIC(19,14212,1,9,0)=" "
^DIC(19,14212,1,10,0)="The site should contact the National Service Desk Austin to determine if"
^DIC(19,14212,1,11,0)="Central Fee contains the overdue batch. If so, the site should request"
^DIC(19,14212,1,12,0)="that the Payment Batch Results message be resent to VistA.  If Central Fee"
^DIC(19,14212,1,13,0)="does not have the batch, the site can use this option to either change the"
^DIC(19,14212,1,14,0)="batch status so the batch will be resent or to reject the entire batch so"
^DIC(19,14212,1,15,0)="the line items can be re-initiated into a new batch, edited, and then"
^DIC(19,14212,1,16,0)="resent with the new batch."
^DIC(19,14212,25)="FBAADD1"
^DIC(19,14212,"U")="REPROCESS OVERDUE BATCH"
^DIC(19,14213,0)="FBAA RESEND VOUCHER MSG^Resend Completed Batch^^R^10000000216^FBAASUPERVISOR^^^^^^344"
^DIC(19,14213,1,0)="^19.06^15^15^3120329^^^"
^DIC(19,14213,1,1,0)="This option can be used to resend a Voucher Batch message to Central Fee."
^DIC(19,14213,1,2,0)=" "
^DIC(19,14213,1,3,0)="If VistA Fee Basis does not receive a Voucher Batch Acknowledgement "
^DIC(19,14213,1,4,0)="message by the third weekday after finalization of the batch, the software"
^DIC(19,14213,1,5,0)="will consider the acknowledgement message as overdue. A list of batches"
^DIC(19,14213,1,6,0)="with an overdue acknowledgement can be obtained by entering a ? at the"
^DIC(19,14213,1,7,0)="select batch prompt of this option.  "
^DIC(19,14213,1,8,0)=" "
^DIC(19,14213,1,9,0)="The site should contact the National Service Desk Austin to determine if"
^DIC(19,14213,1,10,0)="Central Fee received the Voucher Batch message.  If Central Fee received"
^DIC(19,14213,1,11,0)="the Voucher Batch message, the site should request that the Voucher Batch"
^DIC(19,14213,1,12,0)="Acknowledgement message be resent to VistA.  If Central Fee did not "
^DIC(19,14213,1,13,0)="receive the Voucher Batch message, the site can use the Resend Completed "
^DIC(19,14213,1,14,0)="Batch option in VistA to generate a new Voucher Batch message and send "
^DIC(19,14213,1,15,0)="that to Central Fee."
^DIC(19,14213,25)="RESEND^FBAAVR6"
^DIC(19,14213,"U")="RESEND COMPLETED BATCH"
^DIC(19,14214,0)="FB PAYMENT AGING RPT^Payment Aging Report^^R^10000000216^^^^^^^344"
^DIC(19,14214,1,0)="^19.06^9^9^3120109^^"
^DIC(19,14214,1,1,0)="This option generates a report of payments that have been transmitted to"
^DIC(19,14214,1,2,0)="Central Fee and are still awaiting payment confirmation or cancellation in"
^DIC(19,14214,1,3,0)="VistA.  The purpose of the new report is to identify payments in VistA Fee"
^DIC(19,14214,1,4,0)="Basis that appear to have a problem because payment confirmation has not"
^DIC(19,14214,1,5,0)="been received within an expected period."
^DIC(19,14214,1,6,0)=" "
^DIC(19,14214,1,7,0)="Payment line items finalized within a user-specified period will be listed"
^DIC(19,14214,1,8,0)="on this report if payment confirmation has not been received from Austin"
^DIC(19,14214,1,9,0)="and the payment is not cancelled, flagged as rejected, or voided."
^DIC(19,14214,25)="FBAAPAR"
^DIC(19,14214,"U")="PAYMENT AGING REPORT"
^DIC(19,14215,0)="PSS VENDOR INTERFACE REPORT^Print Interface Data File^^R^10000000216^^^^^^^517"
