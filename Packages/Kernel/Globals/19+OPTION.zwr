^DIC(19,13078,0)="CAC Menu^Clinical Applications Menu^^M^11745"
^DIC(19,13078,1,0)="^19.06^2^2^3050428^^"
^DIC(19,13078,1,1,0)="Master menu of OE/RR options consisting of ORMGR, ORDERS MENU, "
^DIC(19,13078,1,2,0)="ORSRPT, and ORSSRPT"
^DIC(19,13078,10,0)="^19.01IP^2^2"
