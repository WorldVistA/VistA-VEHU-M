^DIC(19,13474,0)="SCRPW TRANS MT EQUAL U RPT^Encounters Transmitted with MT Status of U^^A^10000000020^^^^^^^16^^1"
^DIC(19,13474,1,0)="^^8^8^3030820^"
^DIC(19,13474,1,1,0)="This report prints a list of patients who have encounters which will "
^DIC(19,13474,1,2,0)="transmit with a means test indicator of 'U'. The patient will be included"
^DIC(19,13474,1,3,0)="on the report only if ALL the patient's encounters within the date range"
^DIC(19,13474,1,4,0)="selected will transmit with a MTI of 'U'.  This will focus the list on"
^DIC(19,13474,1,5,0)="patients who do not have a valid MT status in the National Patient Care"
^DIC(19,13474,1,6,0)="Database (NPCD) for the date range chosen. The current FY is the suggested"
^DIC(19,13474,1,7,0)="date range for this report.  Formatted for 132 col. output, this report "
^DIC(19,13474,1,8,0)="will not format correctly to an 80 column device."
^DIC(19,13474,20)="D EN^SCRPW81"
^DIC(19,13474,"U")="ENCOUNTERS TRANSMITTED WITH MT"
