^DIC(19,406,0)="DG G&L INIT^Gains and Losses Initialization^^R^.5^^^^^^^114"
^DIC(19,406,1,0)="^^9^9^2930511^^^^"
^DIC(19,406,1,1,0)="This option is used to initialize your Gains and Losses Sheet and Bed"
^DIC(19,406,1,2,0)="Census for your medical center.  Prior to using this options Wards must"
^DIC(19,406,1,3,0)="be defined using the WARD DEFINTION option and ADT parameters must be"
^DIC(19,406,1,4,0)="defined using the ADT PARAMETERS option.  The date to be initialized"
^DIC(19,406,1,5,0)="(usually the first day of a fiscal year) is defined when entering your"
^DIC(19,406,1,6,0)="ADT Parameters.  To initialize you G&L and Bed Census data for each"
^DIC(19,406,1,7,0)="ward location must be entered as of midnight the day previous to the"
^DIC(19,406,1,8,0)="initialization date, i.e., if the initialization date is ""October 1,1990"""
^DIC(19,406,1,9,0)="the data entered for each ward must be as of midnight ""September 30,1990""."
^DIC(19,406,25)="DGWIN"
^DIC(19,406,"U")="GAINS AND LOSSES INITIALIZATIO"
