^DIC(19,10878,0)="LA7V SETUP^LEDI Setup^^R^11740^^^^^^^480"
^DIC(19,10878,1,0)="^19.06^5^5^3000302^^^^"
^DIC(19,10878,1,1,0)="This option is used to setup the HL7 and Lab Auto Instrument environment"
^DIC(19,10878,1,2,0)="for a HOST or COLLECTION system.  This option will setup entries in the"
^DIC(19,10878,1,3,0)="HL7 APPLICATION PARAMETER file (#771), HL LOGICAL LINK file (#870),"
^DIC(19,10878,1,4,0)="PROTOCOL file (#101), AUTO INSTRUMENT file (#62.4), and LA7 MESSAGE PARAMETER"
^DIC(19,10878,1,5,0)="file (#62.48)."
^DIC(19,10878,25)="LA7VSET"
^DIC(19,10878,"U")="LEDI SETUP"
^DIC(19,10879,0)="LA7TASK NIGHTY^Lab Messaging Nightly Cleanup^^R^10000000020^^^^^^^53"
^DIC(19,10879,1,0)="^19.06^47^47^3040423^^^^"
^DIC(19,10879,1,1,0)="This is a tasked option to check integrity of LA7 MESSAGE QUEUE file"
^DIC(19,10879,1,2,0)="(#62.49) and purge messages that are eligible for purging. It also purges"
^DIC(19,10879,1,3,0)="the following files related to LEDI - SHIPPING MANIFEST (#62.8), LAB"
^DIC(19,10879,1,4,0)="SHIPPING EVENT (#62.85) and LAB PENDING ORDERS ENTRY (#69.6)"
^DIC(19,10879,1,5,0)=" "
^DIC(19,10879,1,6,0)="This option should be tasked daily, preferably during period when activity"
^DIC(19,10879,1,7,0)="in the Lab Messaging (i.e. Universal Interface, LEDI) package is at a"
^DIC(19,10879,1,8,0)="minimum."
^DIC(19,10879,1,9,0)=" "
^DIC(19,10879,1,10,0)="Prior to the purge of LA7 MESSAGE QUEUE file (#62.49), an integrity check is"
^DIC(19,10879,1,11,0)="performed. The integrity check can be run with a couple of switches."
^DIC(19,10879,1,12,0)=" "
^DIC(19,10879,1,13,0)="   LA7FIX = 0 - do not fix errors"
^DIC(19,10879,1,14,0)="            1 - do fix errors"
^DIC(19,10879,1,15,0)=" "
^DIC(19,10879,1,16,0)="   LA7LOG = 0 - do not log errors in XTMP global."
^DIC(19,10879,1,17,0)="            1 - do log errors in XTMP global"
^DIC(19,10879,1,18,0)=" "
^DIC(19,10879,1,19,0)="   LA7ION = name of device to print error report if set to"
^DIC(19,10879,1,20,0)="            log errors (LA7LOG=1)."
^DIC(19,10879,1,21,0)=" "
^DIC(19,10879,1,22,0)=" "
^DIC(19,10879,1,23,0)="These parameters can be setup by TaskMan if the site defines them when"
^DIC(19,10879,1,24,0)="scheduling the task. "
^DIC(19,10879,1,25,0)=""
^DIC(19,10879,1,26,0)="An example is given below:"
^DIC(19,10879,1,27,0)=""
^DIC(19,10879,1,28,0)="                        Edit Option Schedule"
^DIC(19,10879,1,29,0)="    Option Name: LA7TASK NIGHTY"
^DIC(19,10879,1,30,0)="    _____________________________________________________________________"
^DIC(19,10879,1,31,0)=" "
^DIC(19,10879,1,32,0)=" "
^DIC(19,10879,1,33,0)=" "
^DIC(19,10879,1,34,0)=" "
^DIC(19,10879,1,35,0)="    VARIABLE NAME: LA7FIX                   VALUE: 0"
^DIC(19,10879,1,36,0)="    VARIABLE NAME: LA7ION                   VALUE: ""IRM DEVELOP LASER1"""
^DIC(19,10879,1,37,0)="    VARIABLE NAME: LA7LOG                   VALUE: 1"
^DIC(19,10879,1,38,0)=" "
^DIC(19,10879,1,39,0)=" "
^DIC(19,10879,1,40,0)="If errors are found, an alert is sent to members of the mail group"
^DIC(19,10879,1,41,0)="""LAB MESSAGING"" notifying them that errors were detected. If logging of"
^DIC(19,10879,1,42,0)="errors occurred then alert recipients will be able to print/view error log"
^DIC(19,10879,1,43,0)="from the alert system. Alternatively the error report can be printed using"
^DIC(19,10879,1,44,0)="option Print Lab Messaging Integrity Check [LA7 PRINT INTEGRITY CHECK]."
^DIC(19,10879,1,45,0)=" "
^DIC(19,10879,1,46,0)="The integrity report can be run alone using option Lab Messaging File"
^DIC(19,10879,1,47,0)="Integrity Checker [LA7 CHECK FILES]."
^DIC(19,10879,2)="y"
^DIC(19,10879,25)="EN^LA7PURG"
^DIC(19,10879,200.9)="y"
^DIC(19,10879,"U")="LAB MESSAGING NIGHTLY CLEANUP"
