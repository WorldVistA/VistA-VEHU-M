^DIC(19,16089,1,2,0)="increments of 5 (i.e., 5, 10, 15, 20,...,5n where n is the total"
^DIC(19,16089,1,3,0)="number of components)."
^DIC(19,16089,1,4,0)="Cloned from ""GMTS IRM/ADPAC TYPE RESEQUENCE"" option."
^DIC(19,16089,3)=""
^DIC(19,16089,25)="GMTSRN"
^DIC(19,16089,"U")="RESEQUENCE A HEALTH SUMMARY TY"
