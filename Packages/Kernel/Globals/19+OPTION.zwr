^DIC(19,6963,"U")="CONSULT MANAGEMENT"
^DIC(19,6964,0)="GMRC SERVICE TRACKING^Consult Service Tracking^^R^11712^^^^^^^^^^1"
^DIC(19,6964,1,0)="^^5^5^2971217^^^^"
^DIC(19,6964,1,1,0)="This option provides actions which a service may use to track "
^DIC(19,6964,1,2,0)="consults and requests."
^DIC(19,6964,1,3,0)="  "
^DIC(19,6964,1,4,0)="The processing flow is similiar to the OE/RR review screen.  Most of"
^DIC(19,6964,1,5,0)="the actions have the same mnemonics as OE/RR for clinician familiarity."
^DIC(19,6964,15)="D ^GMRCREXT"
^DIC(19,6964,25)="EN^GMRCSLM"
^DIC(19,6964,99)="55068,85713"
^DIC(19,6964,99.1)="59164,31865"
^DIC(19,6964,"U")="CONSULT SERVICE TRACKING"
^DIC(19,6967,0)="GMRC PHARMACY TPN CONSULTS^Pharmacy TPN Consults^^R^11712^^^^^^^^^^"
