^DIC(19,14276,20)="D TSKMMARY^LRJSAU2(""AUF60"",""File 60 Audit"",""DISPLAY"")"
^DIC(19,14276,25)="LRJSAU2"
^DIC(19,14276,200.9)="y"
^DIC(19,14276,"U")="TASKMAN FILE 60 AUDIT IN DISPL"
