^DIC(19,13723,"U")="RETURN DRUG CREDIT MENU"
^DIC(19,13724,0)="PSA RET DRG BAT COMPLETE LIST^Batch Complete List^^R^1^^^^^^^287"
^DIC(19,13724,1,0)="^19.06^7^7^3080702^^"
^DIC(19,13724,1,1,0)="This option allows users to access and update batches with any status. "
^DIC(19,13724,1,2,0)="Users can select batches with the following status:"
^DIC(19,13724,1,3,0)="        AP -  AWAITING PICKUP"
^DIC(19,13724,1,4,0)="        PU -  PICKED UP"
^DIC(19,13724,1,5,0)="        CO -  COMPLETED"
^DIC(19,13724,1,6,0)="        CA -  CANCELLED"
