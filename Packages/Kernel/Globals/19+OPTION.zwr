^DIC(19,3135,1,0)="^^4^4^2890106^^"
^DIC(19,3135,1,1,0)="This option allows the supervisor to review and whenappropriate, correct"
^DIC(19,3135,1,2,0)="the stored balances within the system.  This option should not be used "
^DIC(19,3135,1,3,0)="until a complete audit of the account is accomplished and it is"
^DIC(19,3135,1,4,0)="certain that no tampering of the account has been found."
