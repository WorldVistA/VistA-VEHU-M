^DIC(19,13796,0)="SDRR CLEAN-UP^Clean Up Clinic Recall Entries^NO LONGER AVAILABLE!! - DECOM - SD*5.3*790^R^1^^^^^^^16"
^DIC(19,13796,1,0)="^19.06^8^8^3210712^^^"
^DIC(19,13796,1,1,0)="This option is a Recall Reminder option which should be queued to run"
^DIC(19,13796,1,2,0)="after 10:00pm every night.  It will check those patients in Recall"
^DIC(19,13796,1,3,0)="Reminder against scheduled appointments and will delete a patient from"
^DIC(19,13796,1,4,0)="Recall Reminder if the scheduled appointment date and clinic are within a "
^DIC(19,13796,1,5,0)="number of days from the Recall Date.  The Recall clinic must match"
^DIC(19,13796,1,6,0)="the clinic that the patient has been scheduled for.  If the Clinic name is"
^DIC(19,13796,1,7,0)="different, it will not delete the patient from the Recall Reminders file."
^DIC(19,13796,1,8,0)="The number of days is set within RECALL REMINDERS PARAMETERS."
^DIC(19,13796,3.91,0)="^19.391^^0"
^DIC(19,13796,25)="SDRRCLR"
^DIC(19,13796,200.9)="y"
^DIC(19,13796,"U")="CLEAN UP CLINIC RECALL ENTRIES"
^DIC(19,13797,0)="SDRR CARD ADD^Add/Edit Clinic Recall Patient^^R^10000000216^^^^^^^16^^^1"
^DIC(19,13797,1,0)="^19.06^2^2^3110815^^^^"
^DIC(19,13797,1,1,0)="This option allows users to enter or edit a patient into"
^DIC(19,13797,1,2,0)="the Recall Reminder file without using Appointment Management."
^DIC(19,13797,15)="I $G(SDDIK)>0 N DIK,DA S DIK=""^SD(403.5,"",DA=SDDIK D ^DIK K SDDIK,DA,DIK W !!?10,""No Recall Record created."" H 2"
^DIC(19,13797,25)="SDRRCLR2"
^DIC(19,13797,99.1)="62082,39923"
^DIC(19,13797,"U")="ADD/EDIT CLINIC RECALL PATIENT"
