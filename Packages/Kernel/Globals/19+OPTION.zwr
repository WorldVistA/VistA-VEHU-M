^DIC(19,14737,25)="EN^DGPFTR"
^DIC(19,14737,"U")="RECORD FLAG TRANSFER REQUESTS"
^DIC(19,14738,0)="DGPF DISRUPT BEHAVIOR REPORT^Behavioral PRF Disruptive Behavior Data Report^^R^11720^^^^^^^114^y"
^DIC(19,14738,1,0)="^^6^6^3180919^"
^DIC(19,14738,1,1,0)="For national Behavioral Flags, one may associate a Disruptive Behavioral "
^DIC(19,14738,1,2,0)="Reporting System (DBRS) number.  This report will prompt for a single "
^DIC(19,14738,1,3,0)="patient.  It will then display the changes over time made to the DBRS "
^DIC(19,14738,1,4,0)="data associated with the Behavioral Flag assignment.  There is no "
^DIC(19,14738,1,5,0)="electronic link between VistA and the DBRS.  The DBRS Number entered is "
^DIC(19,14738,1,6,0)="that link."
^DIC(19,14738,25)="EN^DGPFRDB"
^DIC(19,14738,"U")="BEHAVIORAL PRF DISRUPTIVE BEHA"
^DIC(19,14739,0)="DGPF RECORD REFRESH^Record Flag Data Refresh^^R^11720^DGPF TRANSMISSIONS^^^^^^114^n"
^DIC(19,14739,1,0)="^^14^14^3180919^"
^DIC(19,14739,1,1,0)="This option should have limited access.  It was intentionally exported as "
^DIC(19,14739,1,2,0)="stand alone option and not attached to a menu in order to prevent if from "
^DIC(19,14739,1,3,0)="being run accidently."
^DIC(19,14739,1,4,0)=" "
^DIC(19,14739,1,5,0)="This option will allow a Patient Record Flag Assignment for a patient to "
^DIC(19,14739,1,6,0)="be retransmitted to all facilities for which this patient has been "
^DIC(19,14739,1,7,0)="registered.  Its primary use is to resynchronize all the VistA accounts "
^DIC(19,14739,1,8,0)="to a single image of a particular record flag assignment.  This situation "
^DIC(19,14739,1,9,0)="occurs when some of the HL7 PRF messages fail to properly update the "
^DIC(19,14739,1,10,0)="facility receiving that HL7 message."
^DIC(19,14739,1,11,0)=" "
^DIC(19,14739,1,12,0)="It is the responsibility of the user running this option to ensure that "
^DIC(19,14739,1,13,0)="the data on file in this VistA system is accurate as this PRF Assignment "
^DIC(19,14739,1,14,0)="record will be used as an ""authoritative source"" for this information."
^DIC(19,14739,2)="y"
^DIC(19,14739,25)="RF^DGPFHLF"
^DIC(19,14739,200.9)="^y"
^DIC(19,14739,"U")="RECORD FLAG DATA REFRESH"
^DIC(19,14740,0)="RA ORDERREF^Refer Selected Requests to COMMUNITY CARE Provider^^R^1^^^^^^^31^^1^1"
^DIC(19,14740,1,0)="^^2^2^3221108^"
^DIC(19,14740,1,1,0)="This option allows the user to CREATE a REQUEST/CONSULT entry for a"
^DIC(19,14740,1,2,0)="selected 'requested' exam in the  'PENDING', 'HOLD' or 'SCHEDULED' status."
^DIC(19,14740,10.1)="Refer Exam"
^DIC(19,14740,15)="K RAOPT(""CCR"")"
^DIC(19,14740,20)="S RAOPT(""CCR"")="""""
^DIC(19,14740,25)="ENT^RAORDR"
^DIC(19,14740,"U")="REFER SELECTED REQUESTS TO COM"
^DIC(19,14741,0)="MAG WORK ITEMS DELETE^Delete work items^^R^11720^^^^^^^530"
^DIC(19,14741,1,0)="^19.06^2^2^3120510^^^^"
^DIC(19,14741,1,1,0)="Delete work items in date range by"
^DIC(19,14741,1,2,0)="work item type and subtype."
