^DIC(19,13188,0)="RA TIMELINESS REPORT^Summary/Detail report^^R^10000000020^^^^^^^31"
^DIC(19,13188,1,0)="^19.06^7^7^3090626^^"
^DIC(19,13188,1,1,0)="This option allows the supervisor to generate a report of timeliness of "
^DIC(19,13188,1,2,0)="performing outpatient Radiology orders for a user specified date range, "
^DIC(19,13188,1,3,0)="where the beginning and ending date is the Exam Date.  The timeliness is"
^DIC(19,13188,1,4,0)="measured in days, from the Desired Date of the order as entered by the"
^DIC(19,13188,1,5,0)="clinician, to the Exam Date as entered by the technician.  The summary"
^DIC(19,13188,1,6,0)="report will group the days within the date range into 30 day increments.  "
^DIC(19,13188,1,7,0)="The detail report will list each exam within the date range."
^DIC(19,13188,25)="RAPMW"
^DIC(19,13188,"U")="SUMMARY/DETAIL REPORT"
