^DIC(19,13390,0)="PRSP ESR EDIT^Electronic Subsidiary Record-Daily Enter/Edit^^R^1^^^^^^^230"
^DIC(19,13390,1,0)="^19.06^19^19^3050211^^^^"
^DIC(19,13390,1,1,0)="The primary purpose of this option is to allow part-time"
^DIC(19,13390,1,2,0)="physicians with a Memorandum of Service Level Expectations to"
^DIC(19,13390,1,3,0)="record time and leave on their daily electronic subsidiary record"
^DIC(19,13390,1,4,0)="(ESR).  This option presents a list of pay periods for the"
^DIC(19,13390,1,5,0)="part-time physician to select.  Any pay period that appears in the"
^DIC(19,13390,1,6,0)="selection list must have one or more days that are in a status"
^DIC(19,13390,1,7,0)="that requires some action from the part-time physician.  Once a pay"
^DIC(19,13390,1,8,0)="period is selected, the option presents a summary of the memorandum"
^DIC(19,13390,1,9,0)="that contains the pay period and a summary of each day within that"
^DIC(19,13390,1,10,0)="pay period.  The physician can select any day in the pay period"
^DIC(19,13390,1,11,0)="that is not yet approved.  Once a day is selected, the option"
^DIC(19,13390,1,12,0)="presents a form that allows the part-time physician to edit and"
^DIC(19,13390,1,13,0)="electronically sign their time and leave for that day. "
^DIC(19,13390,1,14,0)=""
^DIC(19,13390,1,15,0)="Secondarily, this option will also present the part-time physician"
^DIC(19,13390,1,16,0)="with any recently ended memoranda.  Any such memoranda will appear"
^DIC(19,13390,1,17,0)="first in the selection list.  If selected, the option allows the "
^DIC(19,13390,1,18,0)="part-time physician to review the memorandum and select a "
^DIC(19,13390,1,19,0)="reconciliation option. "
^DIC(19,13390,10.1)="ESR Edit/Update"
^DIC(19,13390,25)="MAIN^PRSPESR"
^DIC(19,13390,"U")="ELECTRONIC SUBSIDIARY RECORD-D"
^DIC(19,13391,0)="PRSP EA ENTER^Enter Extended Absence^^R^1^^^^^^^230"
^DIC(19,13391,1,0)="^19.06^7^7^3050211^^^^"
^DIC(19,13391,1,1,0)="This option allows a part-time physician to specify a future"
^DIC(19,13391,1,2,0)="period of time when they will not be performing work for the"
^DIC(19,13391,1,3,0)="VA (extended absence).  The physician will not need to"
^DIC(19,13391,1,4,0)="manually update their ESR during the absence.  The software"
^DIC(19,13391,1,5,0)="will automatically change the status of daily ESRs, with a"
^DIC(19,13391,1,6,0)="scheduled tour of duty, to SIGNED, if those days are covered"
^DIC(19,13391,1,7,0)="by the period of extended absence."
^DIC(19,13391,25)="PRSPEAN"
^DIC(19,13391,"U")="ENTER EXTENDED ABSENCE"
^DIC(19,13392,0)="PRSP EA EDIT^Edit Extended Absence^^R^1^^^^^^^230"
^DIC(19,13392,1,0)="^19.06^6^6^3050222^^^^"
^DIC(19,13392,1,1,0)="This option allows the part-time physician to edit a previously entered"
^DIC(19,13392,1,2,0)="extended absence.  The software will automatically update the current"
^DIC(19,13392,1,3,0)="and future days on the ESR as necessary.  However, any ESR days prior to"
^DIC(19,13392,1,4,0)="the current day will not be automatically modified when an extended"
^DIC(19,13392,1,5,0)="absence is edited.  An extended absence can not be edited when the To Date"
^DIC(19,13392,1,6,0)="is prior to the current day. "
^DIC(19,13392,25)="PRSPEAE"
^DIC(19,13392,"U")="EDIT EXTENDED ABSENCE"
^DIC(19,13393,0)="PRSP EA CANCEL^Cancel Extended Absence^^R^1^^^^^^^230"
^DIC(19,13393,1,0)="^19.06^6^6^3050222^^^^"
^DIC(19,13393,1,1,0)="This option allows the part-time physician to cancel a previously"
^DIC(19,13393,1,2,0)="entered extended absence.  The software will automatically update the"
^DIC(19,13393,1,3,0)="current and future days on the ESR as necessary.  However, any ESR days"
^DIC(19,13393,1,4,0)="prior to the current day will not be automatically modified when an"
^DIC(19,13393,1,5,0)="extended absence is cancelled.  An extended absence can not be cancelled"
^DIC(19,13393,1,6,0)="if its To Date is prior to the current day. "
^DIC(19,13393,25)="PRSPEAX"
^DIC(19,13393,"U")="CANCEL EXTENDED ABSENCE"
^DIC(19,13394,0)="PRSP EA MENU^Extended Absence^^M^1^^^^^^^230"
^DIC(19,13394,1,0)="^19.06^1^1^3050122^^^"
^DIC(19,13394,1,1,0)="The menu contains options related to maintaining extended absence records."
^DIC(19,13394,10,0)="^19.01IP^4^4"
^DIC(19,13394,10,1,0)="13391^1^1"
^DIC(19,13394,10,2,0)="13392^2^2"
