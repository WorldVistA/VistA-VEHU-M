^DIC(19,16094,0)="EHM-00915^CPRS Reports Tab 'Health Summary Types List' Menu^^M^1^^^^^^^^^^^"
^DIC(19,16094,1,0)="^^5^5^3240328^"
^DIC(19,16094,1,1,0)="Use the options in the CPRS Reports Tab Health Summary Types List"
^DIC(19,16094,1,2,0)="Menu to select the Health Summary Types to list on the Reports Tab,"
^DIC(19,16094,1,3,0)="arrange the order of these Health Summaries on the list, and to "
^DIC(19,16094,1,4,0)="view the user s preferences."
