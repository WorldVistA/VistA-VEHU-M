^DIC(19,11456,0)="XQALERT SURROGATE SET/REMOVE^Alerts - Set/Remove Surrogate for User^^R^11818^^^^^^^163"
^DIC(19,11456,1,0)="^^9^9^2990202^"
^DIC(19,11456,1,1,0)="This option is provided so that IRM or ADPAC personnel can set or remove a"
^DIC(19,11456,1,2,0)="surrogate for receiving alerts for a user.  The option asks for a user to"
^DIC(19,11456,1,3,0)="be selected, then is ready to specify a new surrogate for the selected"
^DIC(19,11456,1,4,0)="user, or to remove the current surrogate for that user."
^DIC(19,11456,1,5,0)=" "
^DIC(19,11456,1,6,0)="This option is NOT needed by the individual users who may select to name"
^DIC(19,11456,1,7,0)="or remove a surrogate as one of the options while processing alerts (or if"
^DIC(19,11456,1,8,0)="no alerts are present for the user, as his only option on selecting alert"
^DIC(19,11456,1,9,0)="processing)."
^DIC(19,11456,25)="OTHRSURO^XQALSURO"
^DIC(19,11456,"U")="ALERTS - SET/REMOVE SURROGATE "
