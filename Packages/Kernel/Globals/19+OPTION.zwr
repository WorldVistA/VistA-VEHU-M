^DIC(19,8399,0)="LRAPWR^Cytopathology screening workload^^R^.5^^^^^^^26"
^DIC(19,8399,1,0)="^^2^2^2911218^^^"
^DIC(19,8399,1,1,0)="Records date/time cytopathology slides are screened and captures"
^DIC(19,8399,1,2,0)=" screening workload."
^DIC(19,8399,25)="LRAPWR"
^DIC(19,8399,"U")="CYTOPATHOLOGY SCREENING WORKLO"
^DIC(19,8400,0)="LR BARCODE FORMAT LOAD^Download Format for Intermec Printer^^R^.5^LRLIASON^^^^^^26"
^DIC(19,8400,1,0)="^^5^5^2940509^^^^"
^DIC(19,8400,1,1,0)="  This option is used to down load the printer format for bar"
^DIC(19,8400,1,2,0)="code accession labels. The routine for Intermec printers for "
^DIC(19,8400,1,3,0)="the 1X3 format is LRLABAR."
^DIC(19,8400,1,4,0)="   If not used for Intermec 1X3 labels, refer to routine LRLABEL6 for"
^DIC(19,8400,1,5,0)="specifics."
^DIC(19,8400,25)="LRLABAR"
^DIC(19,8400,"U")="DOWNLOAD FORMAT FOR INTERMEC P"
^DIC(19,8401,0)="LRFASTS^Fast Bypass Data Entry/Verify^^R^.5^LRLAB^^^^^^26"
^DIC(19,8401,1,0)="^^7^7^2930228^^"
^DIC(19,8401,1,1,0)="  This option is simular to Bypass normal data entry, except it"
^DIC(19,8401,1,2,0)="offers a complete accession of several test on the same patient."
^DIC(19,8401,1,3,0)="After the test has been accessioned, the option will prompt the user"
^DIC(19,8401,1,4,0)="with each accession number previously accessioned."
^DIC(19,8401,1,5,0)="  NOTE:"
^DIC(19,8401,1,6,0)="    THIS OPTION IS INTENDED TO PHASE OUT THE USE OF BYPASS NORMAL DATA"
^DIC(19,8401,1,7,0)="ENTRY OPTION"
^DIC(19,8401,25)="LRFASTS"
^DIC(19,8401,"U")="FAST BYPASS DATA ENTRY/VERIFY"
^DIC(19,8402,0)="LRUFCL^Print future collection labels^^R^.5^LRLAB^^^^^^26"
^DIC(19,8402,1,0)="^^19^19^2940328^^^^"
^DIC(19,8402,1,1,0)="  This option is used to print labels/lists for Lab collect. This option"
^DIC(19,8402,1,2,0)="has several possible usage. The routine will print any order which has"
^DIC(19,8402,1,3,0)="the collection type of Lab Collect (LC) or Immediate Collection (IC)."
^DIC(19,8402,1,4,0)="The type IC is what the ward uses to request specimen collection at a"
^DIC(19,8402,1,5,0)="specific time outside of secheduled routine collection time (LC). Not"
^DIC(19,8402,1,6,0)="all site will provide the IC service."
^DIC(19,8402,1,7,0)="  The option will prompt for dates to search for uncollected LC and"
^DIC(19,8402,1,8,0)="IC collection types. The option will search those dates and print"
^DIC(19,8402,1,9,0)="COLLECTION LABELS. A collection label differs from an Accession Label"
^DIC(19,8402,1,10,0)="in two areas. 1) A collection label can printed only for uncollected"
^DIC(19,8402,1,11,0)="specimens. 2) The collection label has no accession number, instead"
^DIC(19,8402,1,12,0)="the requested collection time is printed. Except for these two areas"
^DIC(19,8402,1,13,0)="the two labels have identical information."
^DIC(19,8402,1,14,0)=" A possible use for this option would be to print a list of patient"
^DIC(19,8402,1,15,0)="collection labels in anticipation of computer down time or because"
^DIC(19,8402,1,16,0)="computer down time. This option prints all orders having the type of"
^DIC(19,8402,1,17,0)="LC or IC for the specified date(s). "
^DIC(19,8402,1,18,0)="  THE OPTION 'PRINT SINGLE FUTURE COLLECTION LABELS' should be used"
^DIC(19,8402,1,19,0)="to obtain a single collection label."
^DIC(19,8402,25)="LRLABLD0"
^DIC(19,8402,"U")="PRINT FUTURE COLLECTION LABELS"
^DIC(19,8403,0)="LRUFCLS^Print single future collection label^^R^.5^LRLAB^^^^^^26"
^DIC(19,8403,1,0)="^^4^4^2940328^^^^"
^DIC(19,8403,1,1,0)=" This option is a single label version of Print Future Collection option."
^DIC(19,8403,1,2,0)="There are two major differences from the other option. 1) This option"
^DIC(19,8403,1,3,0)="requires the user to supply the Order Number. 2) It only prints a single"
^DIC(19,8403,1,4,0)="label at a time."
^DIC(19,8403,25)="LRLABLDS"
^DIC(19,8403,"U")="PRINT SINGLE FUTURE COLLECTION"
^DIC(19,8404,0)="LRBLQSDD^Single donor demographic information^^R^.5^^^^^^^26"
^DIC(19,8404,1,0)="^^1^1^2911205^"
^DIC(19,8404,1,1,0)="Displays donor demographic information."
^DIC(19,8404,25)="U^LRBLDP"
^DIC(19,8404,"U")="SINGLE DONOR DEMOGRAPHIC INFOR"
^DIC(19,8406,0)="LRAPAUA^Alphabetical autopsy list^^R^.5^^^^^^^26"
^DIC(19,8406,1,0)="^^1^1^2911224^"
^DIC(19,8406,1,1,0)="Print an alphabetical list of autopsied patients from one date to another"
^DIC(19,8406,25)="LRAPAUA"
^DIC(19,8406,"U")="ALPHABETICAL AUTOPSY LIST"
^DIC(19,8407,0)="LROW IMMED COLLECT^Fast lab test order (IMMEDIATE COLLECT)^^R^.5^^^^^^^26"
^DIC(19,8407,1,0)="^^12^12^2950130^^^"
^DIC(19,8407,1,1,0)=" This option is used by the wards to request immediate collection"
^DIC(19,8407,1,2,0)="of a test specimen by the laboratory. This option is similar to the"
^DIC(19,8407,1,3,0)="'Fast lab test order (ROUTINE)' except that these orders are not for"
^DIC(19,8407,1,4,0)="scheduled laboratory collection times. These orders are placed for"
^DIC(19,8407,1,5,0)="irregular collection times."
^DIC(19,8407,1,6,0)="  The laboratory has set certain time frames and days of the week which"
^DIC(19,8407,1,7,0)="it will allow the user to select from. If the requested times are"
^DIC(19,8407,1,8,0)="not allowed, the user must make a PHONE CALL TO THE LAB TO ARRANGE"
^DIC(19,8407,1,9,0)="SPECIMEN COLLECTION."
^DIC(19,8407,1,10,0)=" "
^DIC(19,8407,1,11,0)="NOTE: IT IS RECOMMENDED THAT THE ORDERING PERSON ALWAYS CALL THE"
^DIC(19,8407,1,12,0)="LABORATORY TO CONFIRM THE RECEIPT OF THE PLACED ORDER."
^DIC(19,8407,25)="IMMCOL^LRORD"
^DIC(19,8407,99.1)="59164,31868"
^DIC(19,8407,"U")="FAST LAB TEST ORDER (IMMEDIATE"
^DIC(19,8408,0)="LRAPWRSP^Surg path gross assistance workload^^R^.5^^^^^^^26"
^DIC(19,8408,1,0)="^^2^2^2911230^"
^DIC(19,8408,1,1,0)="Use this option to record workload for gross description and cutting of "
^DIC(19,8408,1,2,0)="surgical tissue by a non-physician."
^DIC(19,8408,25)="EN^LRAPBS"
^DIC(19,8408,"U")="SURG PATH GROSS ASSISTANCE WOR"
^DIC(19,8409,0)="LRAPWE^EM scanning and photo workload^^R^.5^^^^^^^26"
^DIC(19,8409,1,0)="^^2^2^2920113^"
^DIC(19,8409,1,1,0)="Option allows recording workload for scanning and photography of"
^DIC(19,8409,1,2,0)=" EM grids and making of prints."
^DIC(19,8409,25)="LRAPWE"
^DIC(19,8409,"U")="EM SCANNING AND PHOTO WORKLOAD"
^DIC(19,8410,0)="LRBLA^Blood Bank Administrative Data^^R^.5^^^^^^^26"
^DIC(19,8410,1,0)="^^2^2^2920228^"
^DIC(19,8410,1,1,0)="Prints components prepared, received, transfused, shipped, "
^DIC(19,8410,1,2,0)="outdated, and discarded from one date to another inclusive."
^DIC(19,8410,25)="LRBLA"
^DIC(19,8410,"U")="BLOOD BANK ADMINISTRATIVE DATA"
^DIC(19,8411,0)="LRBLAA^Crossmatch/Transfusions by Specialty/Physician^^R^.5^^^^^^^26"
^DIC(19,8411,1,0)="^^3^3^2940331^^"
^DIC(19,8411,1,1,0)="Provides a list of crosmatches, transfusions, and crossmatch "
