^DIC(19,16522,0)="EHM-01343^Reminder Extract Menu^^M^1^^^^^^^534^^^^"
^DIC(19,16522,1,0)="^19.06^3^3^3240328^^^"
^DIC(19,16522,1,1,0)="This option allows management of extract definitions, extract runs, and "
^DIC(19,16522,1,2,0)="extract transmissions."
^DIC(19,16522,1,3,0)="Cloned from ""PXRM EXTRACT MENU"" option."
^DIC(19,16522,3)=""
^DIC(19,16522,10,0)="^19.01IP^5^5"
^DIC(19,16522,10,1,0)="16523^MA^10"
^DIC(19,16522,10,2,0)="16524^LR^40"
^DIC(19,16522,10,3,0)="16525^ED^30"
^DIC(19,16522,10,4,0)="16526^EC^35"
^DIC(19,16522,10,5,0)="16527^EG^36"
