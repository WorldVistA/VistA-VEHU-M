^DIC(19,9689,0)="PRCO VRQ REVIEW^Review VENDOR REQUEST^^R^11740^PRCFA VENDOR EDIT^^^^^^121^^1^^^1"
^DIC(19,9689,1,0)="^^6^6^2960507^^^^"
^DIC(19,9689,1,1,0)="This option will allow FISCAL to review VENDOR REQUESTS prior to being"
^DIC(19,9689,1,2,0)="sent to Austin.  This option was added to reduce the number of VRQs"
^DIC(19,9689,1,3,0)="going to Austin.  It is expected that the user reviewing the "
^DIC(19,9689,1,4,0)="VRQs will check with the VENDOR file in FMS, get any information"
^DIC(19,9689,1,5,0)="available, and edit the vendor locally rather than sending a VRQ to"
^DIC(19,9689,1,6,0)="Austin."
^DIC(19,9689,10.1)="FISCAL review of VRQs"
^DIC(19,9689,20)=" "
^DIC(19,9689,25)="PRCORV"
^DIC(19,9689,26)=" "
^DIC(19,9689,99)="56673,36624"
^DIC(19,9689,"U")="REVIEW VENDOR REQUEST"
