^DIC(19,14457,0)="LRLISTPS^Summary List (Patient)^^R^1^LRSUPER^^^^^^26"
^DIC(19,14457,1,0)="^^7^7^3150616^"
^DIC(19,14457,1,1,0)="All results for a given patient for a given area for a given date. This"
^DIC(19,14457,1,2,0)="report can serve as an 'audit trail' for a patient. Includes information"
^DIC(19,14457,1,3,0)="on person placing order, person performing test, verifying person, and"
^DIC(19,14457,1,4,0)="dates and times of specimen collection and test completion.  The report"
^DIC(19,14457,1,5,0)="can be printed in an ""extended"" form, which includes the above mentioned"
^DIC(19,14457,1,6,0)="information plus the test results and associated units/normals/LOINC"
^DIC(19,14457,1,7,0)="coding and performing lab."
^DIC(19,14457,25)="EN^LRLISTPS"
^DIC(19,14457,99)="55476,50281"
^DIC(19,14457,"U")="SUMMARY LIST (PATIENT)"
