^DIC(19,12721,26)="D EN1^EVETR4"
^DIC(19,12721,"U")="REGISTRATION REPORT FOR NEW AP"
^DIC(19,12722,0)="EVET DAILY DOWNLOAD ACTIVITY^Daily download activity for date^^A^10000000020^^^^^^^551^^1"
^DIC(19,12722,3)="^LAWTON,LARRY"
^DIC(19,12722,20)="D ^EVETR5"
^DIC(19,12722,"U")="DAILY DOWNLOAD ACTIVITY FOR DA"
^DIC(19,12723,0)="EVET START DOWNLOAD^Start download requests ^^R^10000000020^^^^^^^551^y"
^DIC(19,12723,1,0)="^^2^2^3020905^"
^DIC(19,12723,1,1,0)="This option starts the Evet download process. It sends a request to the"
