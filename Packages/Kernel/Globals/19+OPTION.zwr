^DIC(19,13620,25)="ENTIRRU"
^DIC(19,13620,"U")="ASSIGNMENTS PENDING ACCEPTANCE"
^DIC(19,13621,0)="ENIT PRINT HAND RCPT (IT)^Print Hand Receipt for an Individual^^R^1^^^^^^^33"
^DIC(19,13621,1,0)="^19.06^9^9^3080327^^^"
^DIC(19,13621,1,1,0)="This option enables IT personnel to print hard copy hand receipt for"
^DIC(19,13621,1,2,0)="an individual.  The printout of an individual's signed, active assignments"
^DIC(19,13621,1,3,0)="also serves as the loan form for Government Furnished IT Equipment."
^DIC(19,13621,1,4,0)="The Equipment Return Date on the loan form is determined by adding the"
^DIC(19,13621,1,5,0)="DAYS BETWEEN RETURNS value from the CMR file to the PHYSICAL INVENTORY"
^DIC(19,13621,1,6,0)="DATE (i.e. Last Inventoried) of the equipment item.  A default of 90"
^DIC(19,13621,1,7,0)="days is used if a value is not specified for the applicable CMR.  If"
^DIC(19,13621,1,8,0)="the equipment does not have an inventory date, the current date is"
^DIC(19,13621,1,9,0)="reported as the equipment return date."
^DIC(19,13621,25)="ASK^ENTIRRH"
^DIC(19,13621,"U")="PRINT HAND RECEIPT FOR AN INDI"
^DIC(19,13622,0)="ENIT PRINT HAND RCPT (COM)^Print My Hand Receipt^^R^1^^^^^^^33"
^DIC(19,13622,1,0)="^19.06^9^9^3080327^^^^"
^DIC(19,13622,1,1,0)="This option enables the user to print hand receipts for IT items assigned"
^DIC(19,13622,1,2,0)="to the user.  The printout of an individual's signed, active assignments"
^DIC(19,13622,1,3,0)="also serves as the loan form for Government Furnished IT Equipment."
^DIC(19,13622,1,4,0)="The Equipment Return Date on the loan form is determined by adding the"
^DIC(19,13622,1,5,0)="DAYS BETWEEN RETURNS value from the CMR file to the PHYSICAL INVENTORY"
^DIC(19,13622,1,6,0)="DATE (i.e. Last Inventoried) of the equipment item.  A default of 90"
^DIC(19,13622,1,7,0)="days is used if a value is not specified for the applicable CMR.  If"
^DIC(19,13622,1,8,0)="the equipment does not have an inventory date, the current date is"
^DIC(19,13622,1,9,0)="reported as the equipment return date."
^DIC(19,13622,25)="ASK^ENTIRRH"
^DIC(19,13622,"U")="PRINT MY HAND RECEIPT"
^DIC(19,13623,0)="ENIT USER ACCOUNT TERMINATED^IT Notification of Terminated User with Equipment^^A^1^^^^^^^33^^1"
^DIC(19,13623,1,0)="^^3^3^3071227^"
^DIC(19,13623,1,1,0)="This option should be attached to XU USER TERMINATE to notify"
^DIC(19,13623,1,2,0)="IT when a user with active IT equipment responsibilities is"
