^DIC(19,14282,1,0)="^19.06^2^2^3121018^^^^"
^DIC(19,14282,1,1,0)="This menu option provides access to the Lab File 60 Audit Tool which is"
^DIC(19,14282,1,2,0)="used to manage the auditing of LABORATORY TEST file (#60) fields."
