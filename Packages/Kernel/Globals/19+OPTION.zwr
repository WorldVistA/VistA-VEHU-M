^DIC(19,16090,1,1,0)="Selectively enable or disable Health Summary Components.  Out of"
^DIC(19,16090,1,2,0)="order messages may be entered and the disable action may now be"
^DIC(19,16090,1,3,0)="identified as being either temporary or permanent."
^DIC(19,16090,1,4,0)="Cloned from ""GMTS IRM/ADPAC ENABLE/DISABLE"" option."
