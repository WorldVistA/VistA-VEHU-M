^DIC(19,9857,0)="PXTT EDIT EDUCATION TOPICS^Education Topic Add/Edit^Do not use! Placed out of order by PX*1*211.^E^1^^^^^^n^^^1^1"
^DIC(19,9857,1,0)="^19.06^19^19^3180619^^^^"
^DIC(19,9857,1,1,0)="This option allows a user to create a new Education Topic or edit an"
^DIC(19,9857,1,2,0)="Education Topic that was originally created at your site. Education"
^DIC(19,9857,1,3,0)="topics that are distributed with the PCE package can be inactivated using"
^DIC(19,9857,1,4,0)="the PCE ""Activate/Inactivate Table Items"" menu."
^DIC(19,9857,1,5,0)=" "
^DIC(19,9857,1,6,0)="Once an education topic is defined in this table, it should not be deleted"
^DIC(19,9857,1,7,0)="if there is any encounter form definitions which may be referencing the"
^DIC(19,9857,1,8,0)="education topic, or if there is any patient encounter data which may be"
^DIC(19,9857,1,9,0)="referencing this education topic historically. Use the ""Inactive Flag"""
^DIC(19,9857,1,10,0)="field to make an education topic ""INACTIVE"" for selection in the encounter"
^DIC(19,9857,1,11,0)="form definition process and the PCE encounter data entry process."
^DIC(19,9857,1,12,0)=" "
^DIC(19,9857,1,13,0)="If education topics are to be included on the clinic's encounter form, the"
^DIC(19,9857,1,14,0)="exams must first be defined in the Education Topic file using this option."
^DIC(19,9857,1,15,0)=" "
^DIC(19,9857,1,16,0)="The scanning of encounter forms with the AICS package will provide PCE"
^DIC(19,9857,1,17,0)="with patient education information which is stored in the V PATIENT ED"
^DIC(19,9857,1,18,0)="file."
^DIC(19,9857,1,19,0)=""
^DIC(19,9857,15)="K PXTDUZ,PXNAT,PXB"
^DIC(19,9857,20)="D ZERO^PXTTU1(""^AUTTEDT("",$G(PXNAT))"
^DIC(19,9857,25)=""
^DIC(19,9857,30)="AUTTEDT("
^DIC(19,9857,31)="QAMEZL"
^DIC(19,9857,34)="S PXTDUZ=+$P($$SITE^VASITE,U,3) I $S($G(PXNAT):1,(+$G(Y)>100000):1,1:0)"
^DIC(19,9857,40)=""
^DIC(19,9857,41)=""
^DIC(19,9857,42)=""
^DIC(19,9857,50)="AUTTEDT("
^DIC(19,9857,51)="[PXTT EDIT PAT. EDUCATION]"
^DIC(19,9857,53)="BACKOUTOK"
^DIC(19,9857,"U")="EDUCATION TOPIC ADD/EDIT"
^DIC(19,9858,0)="PXTT EDIT HEALTH FACTORS^Health Factors Add/Edit^Do not use! Placed out of order by PX*1*211.^E^1^^^^^^n^^^1^1"
^DIC(19,9858,1,0)="^19.06^17^17^3010806^^^^"
^DIC(19,9858,1,1,0)="This option allows the user to create a new Health Factor or edit a Health"
^DIC(19,9858,1,2,0)="Factor that was originally created at your site.  Health factors that are"
^DIC(19,9858,1,3,0)="distributed with the PCE package can be inactivated using the PCE"
^DIC(19,9858,1,4,0)="""Activate/Inactivate Table Items"" menu."
^DIC(19,9858,1,5,0)=" "
^DIC(19,9858,1,6,0)="Once a health factor is defined in this table, it should not be deleted if"
^DIC(19,9858,1,7,0)="there is any encounter form definitions which may be using the term, or"
^DIC(19,9858,1,8,0)="if there is any patient encounter data which may be referencing this term"
^DIC(19,9858,1,9,0)="historically."
^DIC(19,9858,1,10,0)=" "
^DIC(19,9858,1,11,0)="Use the ""Inactive Flag"" field to make a health factor ""INACTIVE"" for"
^DIC(19,9858,1,12,0)="selection in the Encounter form definition process and the PCE encounter"
^DIC(19,9858,1,13,0)="data entry process."
^DIC(19,9858,1,14,0)=" "
^DIC(19,9858,1,15,0)="The scanning of encounter forms with the AICS package will provide PCE"
^DIC(19,9858,1,16,0)="with patient exam information which is stored in the V HEALTH FACTORS"
^DIC(19,9858,1,17,0)="FILE."
^DIC(19,9858,15)="K PXTDUZ,PXNAT,PXB"
^DIC(19,9858,20)="D ZERO^PXTTU1(""^AUTTHF("",$G(PXNAT))"
^DIC(19,9858,30)="AUTTHF("
^DIC(19,9858,31)="QAMEZL"
^DIC(19,9858,34)="S PXTDUZ=+$P($$SITE^VASITE,U,3) I $S($G(PXNAT):1,(+$G(Y)>100000):1,1:0)"
^DIC(19,9858,40)=""
^DIC(19,9858,41)=""
^DIC(19,9858,42)=""
^DIC(19,9858,50)="AUTTHF("
^DIC(19,9858,51)="[PXTT EDIT HEALTH FACTORS]"
^DIC(19,9858,53)="BACK"
^DIC(19,9858,"U")="HEALTH FACTORS ADD/EDIT"
^DIC(19,9861,0)="PXTT EDIT TREATMENT^Treatments Add/Edit^^E^10000000020^^^^^^n^^^1^1"
^DIC(19,9861,1,0)="^19.06^18^18^3010806^^^"
^DIC(19,9861,1,1,0)="This option allows a user to create a new Treatment or edit a Treatment"
^DIC(19,9861,1,2,0)="that was originally created at your site. Treatments that are"
^DIC(19,9861,1,3,0)="distributed with the PCE package can be inactivated using the PCE"
^DIC(19,9861,1,4,0)="""Activate/Inactivate TAble Items"" menu."
^DIC(19,9861,1,5,0)=" "
^DIC(19,9861,1,6,0)="Once a treatment is defined in this table, it should not be deleted if"
^DIC(19,9861,1,7,0)="there is any encounter form defintions which may be referencing the"
^DIC(19,9861,1,8,0)="treatment, or if there is any patient encounter data which may be"
^DIC(19,9861,1,9,0)="referencing the treatment historically.  Use the ""Inactive Flag"" field to"
^DIC(19,9861,1,10,0)="make a treatment ""INACTIVE"" for selection in the Encounter form definition"
^DIC(19,9861,1,11,0)="process and the PCE encounter data entry process."
^DIC(19,9861,1,12,0)=" "
^DIC(19,9861,1,13,0)="If treatments are to be included on the clinic's encounter form, the"
^DIC(19,9861,1,14,0)="treatments must first be defined in the Treatment file using this option."
^DIC(19,9861,1,15,0)=" "
^DIC(19,9861,1,16,0)="The scanning of encounter forms with the AICS package will provide PCE"
^DIC(19,9861,1,17,0)="with patient treatment information which is stored in the V TREATMENT"
^DIC(19,9861,1,18,0)="file."
^DIC(19,9861,15)="K PXTDUZ,PXNAT,PXB"
^DIC(19,9861,20)="D ZERO^PXTTU1(""^AUTTTRT("",$G(PXNAT))"
^DIC(19,9861,30)="AUTTTRT("
^DIC(19,9861,31)="QAMEZL"
^DIC(19,9861,34)="S PXTDUZ=+$P($$SITE^VASITE,U,3) I $S($G(PXNAT):1,(+$G(Y)>100000):1,1:0)"
