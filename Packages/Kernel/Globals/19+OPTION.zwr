^DIC(19,16587,"U")="PROVIDER NARRATIVE REPAIR MENU"
^DIC(19,16588,0)="EHM-01409^V POV PROVIDER NARRATIVE REPAIR^^R^1^^^^^^^507^^^^"
^DIC(19,16588,1,0)="^^8^8^3240328^"
^DIC(19,16588,1,1,0)="This option starts a TaskMan job that checks for missing or invalid "
^DIC(19,16588,1,2,0)="Provider Narrative pointers. When it is missing or invalid it will be "
^DIC(19,16588,1,3,0)="replaced with the default value, which is the ICD long description. Since "
^DIC(19,16588,1,4,0)="Provider Narrative Category is not a required field, invalid pointers "
^DIC(19,16588,1,5,0)="will be deleted. If a V POV entry is missing the pointer to the Visit "
^DIC(19,16588,1,6,0)="file or the pointed to Visit file entry does not exist, the V POV entry "
^DIC(19,16588,1,7,0)="will be skipped."
^DIC(19,16588,1,8,0)="Cloned from ""PXQ V POV PROVIDER NARR REPAIR"" option."
^DIC(19,16588,3)=""
^DIC(19,16588,25)="TASKVPOV^PXPNARR"
^DIC(19,16588,"U")="V POV PROVIDER NARRATIVE REPAI"
^DIC(19,16589,0)="EHM-01410^V CPT PROVIDER NARRATIVE REPAIR^^R^1^^^^^^^507^^^^"
^DIC(19,16589,1,0)="^^8^8^3240328^"
^DIC(19,16589,1,1,0)="This option starts a TaskMan job that checks for missing or invalid "
^DIC(19,16589,1,2,0)="Provider Narrative pointers. When it is missing or invalid it will be "
^DIC(19,16589,1,3,0)="replaced with the default value, which is the CPT short description. "
^DIC(19,16589,1,4,0)="Since Provider Narrative Category is not a required field, invalid "
^DIC(19,16589,1,5,0)="pointers will be deleted. If a V CPT entry is missing the pointer to the "
^DIC(19,16589,1,6,0)="Visit file or the pointed to Visit file entry does not exist, the V CPT "
^DIC(19,16589,1,7,0)="entry will be skipped."
^DIC(19,16589,1,8,0)="Cloned from ""PXQ V CPT PROVIDER NARR REPAIR"" option."
^DIC(19,16589,3)=""
^DIC(19,16589,25)="TASKVCPT^PXPNARR"
^DIC(19,16589,"U")="V CPT PROVIDER NARRATIVE REPAI"
