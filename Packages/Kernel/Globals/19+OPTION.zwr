^DIC(19,15775,0)="EHM-00596^Edit personal quick orders by user^^R^1^^^^^^^^^^^"
^DIC(19,15775,1,0)="^19.06^6^6^3240328^^^"
^DIC(19,15775,1,1,0)="This option lets you change all quick orders for a specific user."
^DIC(19,15775,1,2,0)="The dialog for creating a quick order is similar to a dialog for entering "
^DIC(19,15775,1,3,0)="an order. The responses you enter will become the pre-defined "
^DIC(19,15775,1,4,0)="responses for this quick order. End users will have the opportunity to"
^DIC(19,15775,1,5,0)="edit these pre-defined responses, if desired."
^DIC(19,15775,1,6,0)="Cloned from ""ORCM QUICK ORDERS BY USER"" option."
^DIC(19,15775,3)=""
