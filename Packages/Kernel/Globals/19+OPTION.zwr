^DIC(19,16318,0)="EHM-01139^PCE Encounter Data Entry^^A^1^^^^^^^^^1^^"
^DIC(19,16318,1,0)="^^11^11^3240328^"
^DIC(19,16318,1,1,0)="This option is for users who can document a clinical encounter in the"
^DIC(19,16318,1,2,0)="V-files (visit related files), but can only delete V-File encounter"
^DIC(19,16318,1,3,0)="entries that they have created. The data entered via this option includes"
^DIC(19,16318,1,4,0)="visit information (where and when), and the following clinical data"
^DIC(19,16318,1,5,0)="related to the visit: providers of care, problems treated, procedures and"
^DIC(19,16318,1,6,0)="treatments done, and immunizations, skin tests, and patient education"
^DIC(19,16318,1,7,0)="given."
^DIC(19,16318,1,8,0)=" "
^DIC(19,16318,1,9,0)=" "
^DIC(19,16318,1,10,0)="This option is intended for data entry staff."
^DIC(19,16318,1,11,0)="Cloned from ""PXCE ENCOUNTER DATA ENTRY"" option."
^DIC(19,16318,3)=""
^DIC(19,16318,10.1)="PCE"
^DIC(19,16318,20)="D EN^PXCE(""d"")"
^DIC(19,16318,99.1)="56179,36316"
^DIC(19,16318,"U")="PCE ENCOUNTER DATA ENTRY"
^DIC(19,16319,0)="EHM-01140^PCE Encounter Data Entry and Delete^^A^1^^^^^^^^^1^^"
^DIC(19,16319,1,0)="^^11^11^3240328^"
^DIC(19,16319,1,1,0)="This option is for users who can document a clinical encounter in the"
^DIC(19,16319,1,2,0)="V-files (visit related files), and can also delete any V-File encounter"
^DIC(19,16319,1,3,0)="entries, even though they are not the creator of the entries."
^DIC(19,16319,1,4,0)="The data entered via this option includes visit information"
^DIC(19,16319,1,5,0)="(where and when), and the following clinical data related to the visit:"
^DIC(19,16319,1,6,0)="providers of care, problems treated, procedures and treatments done,"
^DIC(19,16319,1,7,0)="and immunizations, skin tests, and patient education given."
^DIC(19,16319,1,8,0)=" "
^DIC(19,16319,1,9,0)="This option is intended for the Coordinator for PCE and/or supervisor of"
^DIC(19,16319,1,10,0)="the encounter data entry staff."
^DIC(19,16319,1,11,0)="Cloned from ""PXCE ENCOUNTER ENTRY & DELETE"" option."
^DIC(19,16319,3)=""
^DIC(19,16319,10.1)="PCE"
^DIC(19,16319,20)="D EN^PXCE(""D"")"
^DIC(19,16319,99.1)="56179,36316"
^DIC(19,16319,"U")="PCE ENCOUNTER DATA ENTRY AND D"
^DIC(19,16320,0)="EHM-01141^PCE Encounter Data Entry without Delete^^A^1^^^^^^^^^1^^"
^DIC(19,16320,1,0)="^^8^8^3240328^"
^DIC(19,16320,1,1,0)="This option is for users who can document a clinical encounter in the"
^DIC(19,16320,1,2,0)="V-files (visit-related files), but should not be able to delete any"
^DIC(19,16320,1,3,0)="entries, including ones that they have created. The data entered via this"
^DIC(19,16320,1,4,0)="option includes visit information (where and when), and the"
^DIC(19,16320,1,5,0)="following clinical data related to the visit: providers of care, problems"
^DIC(19,16320,1,6,0)="treated, procedures and treatments done, and immunizations, skin tests,"
^DIC(19,16320,1,7,0)="and patient education given."
^DIC(19,16320,1,8,0)="Cloned from ""PXCE ENCOUNTER ENTRY NO DELETE"" option."
^DIC(19,16320,3)=""
^DIC(19,16320,10.1)="PCE"
^DIC(19,16320,20)="D EN^PXCE("""")"
^DIC(19,16320,99.1)="56179,36316"
^DIC(19,16320,"U")="PCE ENCOUNTER DATA ENTRY WITHO"
^DIC(19,16321,0)="EHM-01142^Directions to Patient's Home Add/Edit^^E^1^^^^^^^^^^^"
^DIC(19,16321,1,0)="^^6^6^3240328^^"
^DIC(19,16321,1,1,0)="This option lets you enter directions to a patient's home - especially"
^DIC(19,16321,1,2,0)="useful for Hospital-Based Home Care staff."
^DIC(19,16321,1,3,0)=" "
^DIC(19,16321,1,4,0)="The Health Summary package contains a new PCE component that displays the"
^DIC(19,16321,1,5,0)="directions entered through this option."
^DIC(19,16321,1,6,0)="Cloned from ""PX EDIT LOCATION OF HOME"" option."
^DIC(19,16321,3)=""
^DIC(19,16321,10.1)="Dir. to Pt Home"
^DIC(19,16321,30)="AUPNPAT("
^DIC(19,16321,31)="AEMQ"
^DIC(19,16321,50)="AUPNPAT("
^DIC(19,16321,51)="[PX LOCATION OF HOME]"
^DIC(19,16321,"U")="DIRECTIONS TO PATIENT'S HOME A"
^DIC(19,16322,0)="EHM-01143^PCE Encounter Data Entry - Supervisor^^A^1^^^^^^^507^^1^1^"
^DIC(19,16322,1,0)="^19.06^15^15^3240328^^^^"
^DIC(19,16322,1,1,0)="This option allows for the add/edit/deleting of information on certain"
^DIC(19,16322,1,2,0)="encounters that most users should not be changing and the other PCE"
^DIC(19,16322,1,3,0)="options will not allow to be changed. This option also does not"
^DIC(19,16322,1,4,0)="conditionally not ask some fields, i.e. it always ask all of the fields."
^DIC(19,16322,1,5,0)="In addition this option allows users to document a clinical encounter in"
^DIC(19,16322,1,6,0)="the V-files (visit related files), and can also delete any V-File"
^DIC(19,16322,1,7,0)="encounter entries, even though they are not the creator of the entries."
^DIC(19,16322,1,8,0)="The data entered via this option includes visit information (where and"
^DIC(19,16322,1,9,0)="when), and the following clinical data related to the visit: providers of"
^DIC(19,16322,1,10,0)="care, problems treated, procedures and treatments done, and immunizations,"
^DIC(19,16322,1,11,0)="skin tests, and patient education given."
^DIC(19,16322,1,12,0)=" "
^DIC(19,16322,1,13,0)="This option is intended for the Coordinator for PCE and/or supervisor of"
^DIC(19,16322,1,14,0)="the encounter data entry staff."
^DIC(19,16322,1,15,0)="Cloned from ""PXCE ENCOUNTER ENTRY SUPER"" option."
^DIC(19,16322,3)=""
^DIC(19,16322,10.1)="SUP"
^DIC(19,16322,15)="K SDSCEDIT"
^DIC(19,16322,20)="S SDSCEDIT=1 D EN^PXCE(""S"")"
^DIC(19,16322,99.1)="56179,36316"
^DIC(19,16322,"U")="PCE ENCOUNTER DATA ENTRY - SUP"
^DIC(19,16323,0)="EHM-01144^PCE HS/RPT Parameter Menu^^M^1^^^^^^^^^^^"
^DIC(19,16323,1,0)="^^12^12^3240328^"
^DIC(19,16323,1,1,0)="This menu option contains print and edit options for PCE fields related to"
^DIC(19,16323,1,2,0)="the PCE Reports module.  "
^DIC(19,16323,1,3,0)=" "
^DIC(19,16323,1,4,0)="Use the print option to see what the current definition is for these"
^DIC(19,16323,1,5,0)="fields.  "
^DIC(19,16323,1,6,0)=" "
^DIC(19,16323,1,7,0)="The report edit option allows your site to specify which clinics in file"
^DIC(19,16323,1,8,0)="44 represent ""Emergency Room"" clinics, and what Lab tests from file 60"
^DIC(19,16323,1,9,0)="should be used for looking up patient data for Glucose, Cholesterol, LDL"
^DIC(19,16323,1,10,0)="Cholesterol and HBA1C lab results.  These fields are used by the following"
^DIC(19,16323,1,11,0)="reports:  Caseload Profile by Clinic, and Patient Activity by Clinic."
^DIC(19,16323,1,12,0)="Cloned from ""PX HS/RPT PARAMETER MENU"" option."
^DIC(19,16323,3)=""
^DIC(19,16323,10,0)="^19.01IP^2^2"
^DIC(19,16323,10,1,0)="16324^RPT^10"
^DIC(19,16323,10,2,0)="16325^PRNT^1"
