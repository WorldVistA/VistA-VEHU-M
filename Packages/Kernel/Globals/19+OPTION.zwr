^DIC(19,7169,0)="HL MAIN MENU^HL7 Main Menu^^M^11741^^^^^^y^304^y"
^DIC(19,7169,1,0)="^^1^1^2950711^^^^"
^DIC(19,7169,1,1,0)="This is the main menu for the HL7 module."
^DIC(19,7169,10,0)="^19.01IP^15^7"
^DIC(19,7169,10,9,0)="11589^^2"
^DIC(19,7169,10,10,0)="11590^^3"
