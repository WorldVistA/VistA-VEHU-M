^DIC(19,12776,0)="PSJU NSS SEARCH^Non-Standard Schedule Search^^R^10000000020^^^^^^^197"
^DIC(19,12776,1,0)="^^5^5^3040630^"
^DIC(19,12776,1,1,0)="This option allows the user to process Inpatient Medications order for the"
^DIC(19,12776,1,2,0)="specified time period and identify all schedules in use. In addition, the"
^DIC(19,12776,1,3,0)="option will identify all schedules that are not currently in the"
^DIC(19,12776,1,4,0)="ADMINISTRATION SCHEDULE file (#51.1). The option will send a mailman"
^DIC(19,12776,1,5,0)="message to the person who initiated the routine."
^DIC(19,12776,25)="PSJ0103"
^DIC(19,12776,"U")="NON-STANDARD SCHEDULE SEARCH"
^DIC(19,12777,0)="PSJU NSS REPORT^Non-Standard Schedule Report^^R^10000000020^^^^^^^197"
^DIC(19,12777,1,0)="^^4^4^3040630^"
^DIC(19,12777,1,1,0)="This option allows the user to print a listing of all the active orders "
^DIC(19,12777,1,2,0)="(during the timeframe selected) that contain problem schedules. These are"
^DIC(19,12777,1,3,0)="either invalid schedules or schedules with abbreviations that JCAHO"
^DIC(19,12777,1,4,0)="considers dangerous."
^DIC(19,12777,25)="PSJR0103"
^DIC(19,12777,"U")="NON-STANDARD SCHEDULE REPORT"
^DIC(19,12778,0)="IBCE PROVIDER ID WORKSHEET^Provider ID Worksheet^^R^10000000020^^^^^^^"
^DIC(19,12778,1,0)="^19.06^4^4^3040819^^^^"
^DIC(19,12778,1,1,0)="Allows the user to print off provider id worksheets on which to record"
^DIC(19,12778,1,2,0)="special requirements for provider ids for insurance companies.  Users"
^DIC(19,12778,1,3,0)="may choose blank sheets or sheets populated with all BLUE CROSS, BLUE"
^DIC(19,12778,1,4,0)="SHIELD and TRICARE insurance company names."
^DIC(19,12778,25)="EN^IBCEQ2"
^DIC(19,12778,"U")="PROVIDER ID WORKSHEET"
^DIC(19,12779,0)="IBCE PROVIDER ID QUERY^Provider ID Query^^R^1^^^^^^^"
^DIC(19,12779,1,0)="^^12^12^3061002^"
^DIC(19,12779,1,1,0)="This option allows the site to run or re-run the provider id query report"
^DIC(19,12779,1,2,0)="to report some of the invalid provider id set ups for insurance companies."
^DIC(19,12779,1,3,0)=" "
^DIC(19,12779,1,4,0)="CONDITIONS TO IDENTIFY:"
^DIC(19,12779,1,5,0)=" 1-BLUE CROSS LINKED TO CMS-1500 ONLY (1) THE ONLY HARD ERROR"
^DIC(19,12779,1,6,0)=" 2-BLUE SHIELD LINKED TO UB92 ONLY (2) WARNING"
^DIC(19,12779,1,7,0)=" 3-BLUE CROSS ID APPLIED TO BOTH FORMS (0) WARNING"
^DIC(19,12779,1,8,0)=" 4-BLUE CROSS OR BLUE SHIELD IDs EXIST FOR AN INS CO, BUT ONE OR"
^DIC(19,12779,1,9,0)="   MORE OF THE INSURANCE COMPANY'S PLANS DOES NOT HAVE AN"
^DIC(19,12779,1,10,0)="   ELECTRONIC PLAN TYPE OF 'BL'"
^DIC(19,12779,1,11,0)=" 5-NON BLUE CROSS/SHIELD ID FOR AN INS COMPANY WITH BLUE PLAN(S)"
^DIC(19,12779,1,12,0)=" 6-VAD000 as an ID but not flagged as a UPIN"
^DIC(19,12779,25)="EN^IBCEQ1"
^DIC(19,12779,"U")="PROVIDER ID QUERY"
