^DIC(19,6299,"U")="ORDER ENTRY PROCEDURE DISPLAY "
^DIC(19,6300,0)="RA CREATE OE/RR PROTOCOL^Create OE/RR Protocol from Common Procedure^^R^11712^^^^^^^"
^DIC(19,6300,1,0)="^^3^3^2940606^"
^DIC(19,6300,1,1,0)="This option is used to create orderable items (protocols) in the Order"
^DIC(19,6300,1,2,0)="Entry/Results Reporting package based upon entries in the Rad/Nuc Med"
^DIC(19,6300,1,3,0)="Common Procedures file."
^DIC(19,6300,25)="CP^RAORDU1"
^DIC(19,6300,"U")="CREATE OE/RR PROTOCOL FROM COM"
^DIC(19,6301,0)="RA PNLCLERK^Clerical List^^R^11712^^^^^^^"
^DIC(19,6301,1,0)="^^2^2^2940606^"
^DIC(19,6301,1,1,0)="This option allows the user to obtain a list of clerks"
^DIC(19,6301,1,2,0)="as specified by the 'Personnel Menu'."
^DIC(19,6301,25)="5^RAPNL"
^DIC(19,6301,"U")="CLERICAL LIST"
^DIC(19,6302,0)="RA CDR REPORT^Cost Distribution Report^^R^11712^^^^^^y^31"
^DIC(19,6302,1,0)="^^13^13^2940908^"
^DIC(19,6302,1,1,0)="This option produces a report of exam workload by cost distribution center"
^DIC(19,6302,1,2,0)="to assist the department in preparing their Cost Distribution Report"
^DIC(19,6302,1,3,0)="(CDR). If the supervisor has access to more than one division or imaging"
^DIC(19,6302,1,4,0)="type, s/he is prompted to select the divisions and imaging types to"
^DIC(19,6302,1,5,0)="include in the report."
^DIC(19,6302,1,6,0)=" "
^DIC(19,6302,1,7,0)="The reports are listed by division, imaging type within the division, and"
^DIC(19,6302,1,8,0)="then by cost distribution center within the imaging type. The report"
^DIC(19,6302,1,9,0)="contains the following information: procedure, number of examinations, and"
^DIC(19,6302,1,10,0)="percentages of examinations. The report groups all examinations together"
^DIC(19,6302,1,11,0)="by cost distribution center for each imaging type and division. The report"
^DIC(19,6302,1,12,0)="gives information for each individual procedure performed within the cost"
^DIC(19,6302,1,13,0)="distribution center."
^DIC(19,6302,25)="RACDR"
^DIC(19,6302,99)="55678,39188"
^DIC(19,6302,"U")="COST DISTRIBUTION REPORT"
