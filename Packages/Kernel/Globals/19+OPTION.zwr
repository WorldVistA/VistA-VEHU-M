^DIC(19,15375,0)="EHM-00196^Orderable Item Duplicate Order Range^^R^1^^^^^^^^^^^"
^DIC(19,15375,1,0)="^^2^2^3240328^^"
^DIC(19,15375,1,1,0)="The number of hours back in time to look for duplicate orders.  "
^DIC(19,15375,1,2,0)="Cloned from ""ORK DUP ORDER RANGE OI"" option."
^DIC(19,15375,3)=""
^DIC(19,15375,25)="DUPOR^ORKMGR"
^DIC(19,15375,"U")="ORDERABLE ITEM DUPLICATE ORDER"
^DIC(19,15376,0)="EHM-00197^Enable or Disable Order Checking System^^R^1^^^^^^^^^^^"
^DIC(19,15376,1,0)="^^5^5^3240328^^"
^DIC(19,15376,1,1,0)="Determines if any order checking will occur.  'E' or 'Enable' indicates"
^DIC(19,15376,1,2,0)="order checking is enabled and running.  'D' or 'Disabled' indicates order"
^DIC(19,15376,1,3,0)="checking is disabled and not running.  Can be set at the institution, System "
^DIC(19,15376,1,4,0)="or Package level."
^DIC(19,15376,1,5,0)="Cloned from ""ORK SYSTEM ENABLE/DISABLE"" option."
^DIC(19,15376,3)=""
^DIC(19,15376,25)="SYSEN^ORKMGR"
^DIC(19,15376,"U")="ENABLE OR DISABLE ORDER CHECKI"
^DIC(19,15377,0)="EHM-00198^Lab Duplicate Order Range^^R^1^^^^^^^^^^^"
^DIC(19,15377,1,0)="^^2^2^3240328^"
^DIC(19,15377,1,1,0)="The number of hours back in time to check for duplicate lab orders."
^DIC(19,15377,1,2,0)="Cloned from ""ORK DUP ORDER RANGE LAB"" option."
^DIC(19,15377,3)=""
^DIC(19,15377,25)="DUPLR^ORKMGR"
^DIC(19,15377,"U")="LAB DUPLICATE ORDER RANGE"
^DIC(19,15378,0)="EHM-00199^Radiology Duplicate Order Range^^R^1^^^^^^^^^^^"
^DIC(19,15378,1,0)="^^2^2^3240328^"
^DIC(19,15378,1,1,0)="The number of hours back in time to check for duplicate radiology orders."
^DIC(19,15378,1,2,0)="Cloned from ""ORK DUP ORDER RANGE RADIOLOGY"" option."
^DIC(19,15378,3)=""
^DIC(19,15378,25)="DUPRA^ORKMGR"
^DIC(19,15378,"U")="RADIOLOGY DUPLICATE ORDER RANG"
^DIC(19,15379,0)="EHM-00200^Enable or Disable Debug Message Logging^^R^1^^^^^^^^^^^"
^DIC(19,15379,1,0)="^^6^6^3240328^^^^"
^DIC(19,15379,1,1,0)="Determines if order check debug messages will be logged to ^XTMP(""ORKLOG""."
^DIC(19,15379,1,2,0)="'E' or 'Enabled' enables the logging of order checking debug information."
^DIC(19,15379,1,3,0)="'D' or 'Disabled' disables logging debug messages and cleans out"
^DIC(19,15379,1,4,0)="^XTMP(""ORKLOG"").  ^XTMP(""ORKLOG"" is also killed when more than 5,000 "
^DIC(19,15379,1,5,0)="entries exist.  Therefore, ^XTMP(""ORKLOG"") can only hold 5,000 entries."
^DIC(19,15379,1,6,0)="Cloned from ""ORK DEBUG ENABLE/DISABLE"" option."
^DIC(19,15379,3)=""
^DIC(19,15379,25)="DEBUG^ORKMGR"
^DIC(19,15379,"U")="ENABLE OR DISABLE DEBUG MESSAG"
^DIC(19,15380,0)="EHM-00201^Edit Site Local Terms^^A^1^^^^^^^^^1^^"
^DIC(19,15380,1,0)="^19.06^1^1^3240328^^^^"
^DIC(19,15380,1,1,0)="Cloned from ""OCX LOCAL TERM EDIT"" option."
^DIC(19,15380,3)=""
^DIC(19,15380,20)="D ^OCXOEDT6"
^DIC(19,15380,"U")="EDIT SITE LOCAL TERMS"
^DIC(19,15381,0)="EHM-00202^Display the Order Checks a User Can Receive^^R^1^^^^^^^170^^^^"
^DIC(19,15381,1,0)="^^4^4^3240328^"
^DIC(19,15381,1,1,0)="This option prompts for a user/recipient then processes each order check"
^DIC(19,15381,1,2,0)="to determine if and why the user will receive the order check message"
^DIC(19,15381,1,3,0)="during the ordering process."
^DIC(19,15381,1,4,0)="Cloned from ""ORK RECIP ORDER CHECKS"" option."
^DIC(19,15381,3)=""
^DIC(19,15381,25)="USRCHKS^ORKMGR"
^DIC(19,15381,"U")="DISPLAY THE ORDER CHECKS A USE"
^DIC(19,15382,0)="EHM-00203^Set Number of Medications for Polypharmacy^^R^1^^^^^^^^^^^"
^DIC(19,15382,1,0)="^^3^3^3240328^"
^DIC(19,15382,1,1,0)="Use this option to set the number medications for determining"
^DIC(19,15382,1,2,0)="polypharmacy.  "
^DIC(19,15382,1,3,0)="Cloned from ""ORK POLYPHARMACY"" option."
^DIC(19,15382,3)=""
^DIC(19,15382,25)="POLYRX^ORKMGR"
^DIC(19,15382,"U")="SET NUMBER OF MEDICATIONS FOR "
^DIC(19,15383,0)="EHM-00204^Set Creatinine Date Range for Glucophage-Lab Rslts^^R^1^^^^^^^170^^^^"
^DIC(19,15383,1,0)="^^4^4^3240328^^"
^DIC(19,15383,1,1,0)="Use this option to set the number of hours back in time to search for the"
^DIC(19,15383,1,2,0)="most recent creatinine lab results.  This value is used in the the order"
^DIC(19,15383,1,3,0)="check Glucophage-Lab Results."
^DIC(19,15383,1,4,0)="Cloned from ""ORK GLUCOPHAGE CREATININE"" option."
^DIC(19,15383,3)=""
^DIC(19,15383,25)="GLUCREAT^ORKMGR"
^DIC(19,15383,"U")="SET CREATININE DATE RANGE FOR "
^DIC(19,15384,0)="EHM-00205^Set Order Checks to be Uneditable By Users^^R^1^^^^^^^170^^^^"
^DIC(19,15384,1,0)="^^21^21^3240328^"
^DIC(19,15384,1,1,0)="   This option enters values for the parameter ORK EDITABLE BY USER.  "
^DIC(19,15384,1,2,0)="IRM and Clinical Coordinators can use this option to set one or more order"
^DIC(19,15384,1,3,0)="checks to be uneditable by end users.  An order check with an Editable By"
^DIC(19,15384,1,4,0)="User value of ""No"" prevents end users from changing or setting that order"
^DIC(19,15384,1,5,0)="check's enabled/disabled parameter value. If the order check's"
^DIC(19,15384,1,6,0)="enabled/disabled value is ""enabled"", in combination with an Editable By"
^DIC(19,15384,1,7,0)="User value of ""No"", that order check is effectively ""mandatory"". (In the"
^DIC(19,15384,1,8,0)="GUI option to enable/disable order checks, the order check will appear"
^DIC(19,15384,1,9,0)="with a ""Mandatory"" flag.)"
^DIC(19,15384,1,10,0)="   Editable By User values only apply to end users.  An order check with"
^DIC(19,15384,1,11,0)="a ""No"" value does not prevent IRM and Clinical Coordinators from setting"
^DIC(19,15384,1,12,0)="or changing the order check's enabled/disabled values.  The order check"
^DIC(19,15384,1,13,0)="can still be edited by users (presumably IRM and Clinical Coordinators)"
^DIC(19,15384,1,14,0)="with access to the Order Checking Mgmt menu option ""Enable/Disable an"
^DIC(19,15384,1,15,0)="Order Check"".  An order check with no entry for this option/parameter will"
^DIC(19,15384,1,16,0)="be treated as ""editable by user"" (as if it had a ""Yes"" value.) In other"
^DIC(19,15384,1,17,0)="words, the default for this option/parameter is ""Yes""."
^DIC(19,15384,1,18,0)="   This option is used by the List Manager option ""Enable/Disable My Order"
^DIC(19,15384,1,19,0)="Checks"" [ORK REC PROCESSING FLAG].  In the GUI, these settings can be"
^DIC(19,15384,1,20,0)="accessed from the Tools|Options menu then selecting the Order Checks tab."
^DIC(19,15384,1,21,0)="Cloned from ""ORK EDITABLE BY USER"" option."
^DIC(19,15384,3)=""
^DIC(19,15384,25)="EDITUSER^ORKMGR"
^DIC(19,15384,"U")="SET ORDER CHECKS TO BE UNEDITA"
^DIC(19,15385,0)="EHM-00206^Set Creatinine Date Range for Contrst Media Orders^^R^1^^^^^^^170^^^^"
^DIC(19,15385,1,0)="^^5^5^3240328^"
^DIC(19,15385,1,1,0)="Use this option to set the number of days back in time for the patient's"
^DIC(19,15385,1,2,0)="most recent  lab serum creatinine results when Imaging procedures using"
^DIC(19,15385,1,3,0)="contrast media are ordered.  This value is used in the Biochem Abnormality"
^DIC(19,15385,1,4,0)="for Contrast Media order check."
^DIC(19,15385,1,5,0)="Cloned from ""ORK CONTRAST MEDIA CREATININE"" option."
^DIC(19,15385,3)=""
^DIC(19,15385,25)="CMCREAT^ORKMGR"
^DIC(19,15385,"U")="SET CREATININE DATE RANGE FOR "
^DIC(19,15386,0)="EHM-00207^Order Check Override Reason Report^^R^1^^^^^^^170^^^^"
^DIC(19,15386,1,0)="^^5^5^3240328^"
^DIC(19,15386,1,1,0)="Provides a reporting utility that enables facilities to review critical "
^DIC(19,15386,1,2,0)="order check override reasons. Allow for reports to be extracted, "
^DIC(19,15386,1,3,0)="filtered, and sorted by DATE/TIME ORDERED, DIVISION, DISPLAY GROUP, ORDER "
^DIC(19,15386,1,4,0)="CHECK, and ORDER# or any combination of these."
^DIC(19,15386,1,5,0)="Cloned from ""ORK ORD CHK OVERRIDE REPORT"" option."
^DIC(19,15386,3)=""
^DIC(19,15386,25)="EN^OROVRRPT"
^DIC(19,15386,"U")="ORDER CHECK OVERRIDE REASON RE"
^DIC(19,15387,0)="EHM-00208^Cancelled Order Check Viewer/Report^^R^1^^^^^^^^^^^"
^DIC(19,15387,1,0)="^19.06^1^1^3240328^^^^"
^DIC(19,15387,1,1,0)="Cloned from ""ORK CANCELLED ORDER CHK VIEW"" option."
^DIC(19,15387,3)=""
^DIC(19,15387,25)="EN^ORNORC"
