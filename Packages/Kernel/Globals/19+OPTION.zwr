^DIC(19,11548,0)="RG ADMIN COORD MENU^MPI/PD Patient Admin Coordinator Menu^^M^1^^^^^^^525^^1^"
^DIC(19,11548,1,0)="^19.06^3^3^3061019^^^^"
^DIC(19,11548,1,1,0)="The MPI/PD Patient Admin Coordinator Menu [RG ADMIN COORD "
^DIC(19,11548,1,2,0)="MENU] options allow control and monitoring of CMOR and "
^DIC(19,11548,1,3,0)="patient data activities."
