^DIC(19,7609,0)="HBHCRP9^Provider Census Report  (132)^^R^10000000020^^^^^^^"
^DIC(19,7609,1,0)="^^8^8^3050921^"
^DIC(19,7609,1,1,0)="This option prints the HBPC Provider Census Report.  The report can"
^DIC(19,7609,1,2,0)="be run for All or Individual Providers.  The user is prompted to enter"
^DIC(19,7609,1,3,0)="the date range of visits for inclusion on the report.  Only patients"
^DIC(19,7609,1,4,0)="with a current admission will be included.  The report is sorted by"
^DIC(19,7609,1,5,0)="Provider and includes:  Provider Name, Provider Number, Patient Name,"
^DIC(19,7609,1,6,0)="Last Four, Admission Date, Street Address, City, ZIP Code, and Phone, with"
^DIC(19,7609,1,7,0)="Totals for each Provider and Final Totals if 'All' selected.  Report"
^DIC(19,7609,1,8,0)="prints in 132 column format."
^DIC(19,7609,25)="HBHCRP9"
^DIC(19,7609,598000)=3
^DIC(19,7609,"U")="PROVIDER CENSUS REPORT  (132)"
^DIC(19,7610,0)="HBHCRP10^Program Census Report  (80)^^R^10000000020^^^^^^^"
^DIC(19,7610,1,0)="^^4^4^3050921^"
^DIC(19,7610,1,1,0)="This option prints the HBPC Program Census Report.  The user is prompted"
^DIC(19,7610,1,2,0)="to enter the date range for inclusion on the report.  The report is"
^DIC(19,7610,1,3,0)="sorted by patient name and includes:  Patient Name, Last Four, and"
^DIC(19,7610,1,4,0)="Admission Date.  Report prints in 80 column format."
^DIC(19,7610,25)="HBHCRP10"
^DIC(19,7610,99)="55776,30342"
^DIC(19,7610,598000)=3
^DIC(19,7610,"U")="PROGRAM CENSUS REPORT  (80)"
^DIC(19,7611,0)="HBHCRP11^Team Census Report  (80)^^R^10000000020^^^^^^^"
^DIC(19,7611,1,0)="^^5^5^3050921^"
^DIC(19,7611,1,1,0)="This option prints the HBPC Team Census Report.  The user is prompted"
^DIC(19,7611,1,2,0)="to enter the date range for inclusion on the report.  The report is"
^DIC(19,7611,1,3,0)="sorted by Team and includes:  Team Name, Patient Name, Last Four, and"
^DIC(19,7611,1,4,0)="Admission Date, with Totals for each Team and Final Totals for all"
^DIC(19,7611,1,5,0)="Teams.  Report prints in 80 column format."
^DIC(19,7611,25)="HBHCRP11"
