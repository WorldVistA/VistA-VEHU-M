^DIC(19,7390,"U")="CONTRACTOR DATA EDIT (SCREEN 6"
^DIC(19,7391,0)="ENEQPOST^Direct Posting to Equipment Histories^^R^.5^^^^^^^"
^DIC(19,7391,1,0)="^^2^2^2930406^"
^DIC(19,7391,1,1,0)="A utility for posting activities to Equipment Histories without"
^DIC(19,7391,1,2,0)="going thru the Work Order Module."
^DIC(19,7391,25)="EN^ENEQP"
^DIC(19,7391,"U")="DIRECT POSTING TO EQUIPMENT HI"
^DIC(19,7393,0)="ENSP-PLAN^Planning Space Program Menu^^M^.5^^^^^^^"
^DIC(19,7393,1,0)="^^2^2^2930420^^^"
^DIC(19,7393,1,1,0)="Menu for options to be used for entering space planning data for"
^DIC(19,7393,1,2,0)="construction projects."
^DIC(19,7393,10,0)="^19.01PI^3^3"
^DIC(19,7393,10,1,0)="6419^1"
^DIC(19,7393,10,2,0)="7394^3"
^DIC(19,7393,10,3,0)="7395^2"
