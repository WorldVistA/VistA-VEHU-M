^DIC(19,11271,1,1,0)="This is an option for the Admin clerk to initiate a Lab Issue request."
^DIC(19,11271,1,2,0)="When the clerk initiates this option, a printout goes to the default"
^DIC(19,11271,1,3,0)="printer in the site parameter file for the Lab Techinician to complete the"
^DIC(19,11271,1,4,0)="request."
^DIC(19,11271,25)="RMPR29LI"
^DIC(19,11271,"U")="ENTER LAB ISSUE FROM STOCK"
