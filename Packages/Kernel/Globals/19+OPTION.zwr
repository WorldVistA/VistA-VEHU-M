^DIC(19,11413,0)="SC PCMM INCONSISTENCY REPORT^PCMM Inconsistency Report^^R^1^^^^^^^"
^DIC(19,11413,1,0)="^^2^2^2990720^^"
^DIC(19,11413,1,1,0)="Option to print the Inconsistencies that may exist according to the new"
^DIC(19,11413,1,2,0)="Business Rules that were established in Phase II of PCMM (Patch # 177)."
