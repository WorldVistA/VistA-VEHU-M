^DIC(19,14085,0)="SD MH NO SHOW AD HOC REPORT^High Risk MH No-Show Adhoc Report^^R^10000000216^^^^^^^16^^"
^DIC(19,14085,1,0)="^19.06^7^7^3111107^^^^"
^DIC(19,14085,1,1,0)="    This report will list the patients who have the patient record flag for "
^DIC(19,14085,1,2,0)="High Risk for suicide and No Show an appointment in a mental health or non"
^DIC(19,14085,1,3,0)="mental health clinic."
^DIC(19,14085,1,4,0)="    The report will list the patient, emergency contacts,next of kin,future "
^DIC(19,14085,1,5,0)="scheduled appointments. provider and results."
^DIC(19,14085,1,6,0)="    Mental Health clinics are face-to-face Mental Health appointments "
^DIC(19,14085,1,7,0)="defined in the ""VA-MH NO SHOW APPT CLINICS LL"" Reminder Location List."
^DIC(19,14085,20)=""
^DIC(19,14085,21,0)="^^1^1^3101104^"
^DIC(19,14085,21,1,0)=" "
^DIC(19,14085,25)="SDMHAD"
^DIC(19,14085,"U")="HIGH RISK MH NO-SHOW ADHOC REP"
^DIC(19,14086,0)="SD MH NO SHOW NIGHTLY BGJ^High Risk MH No-Show Nightly Report^^R^1^^^^^^^16"
^DIC(19,14086,1,0)="^19.06^21^21^3121115^^^^"
^DIC(19,14086,1,1,0)="This option should be used if you need to re-create the"
^DIC(19,14086,1,2,0)="same report that is created by the scheduled SDAM BACKGROUND job"
^DIC(19,14086,1,3,0)="after midnight each night.  The option lists the no-show and"
^DIC(19,14086,1,4,0)="no action taken appointments for Mental Health Clinics for the previous day"
^DIC(19,14086,1,5,0)=" "
^DIC(19,14086,1,6,0)="**This report should not be scheduled to run nightly"
^DIC(19,14086,1,7,0)="as it is kicked off by the Scheduling nightly background Job"
^DIC(19,14086,1,8,0)="(SDAM BACKGROUND JOB) that should already be"
^DIC(19,14086,1,9,0)="scheduled to run nightly on your system. "
^DIC(19,14086,1,10,0)=" "
^DIC(19,14086,1,11,0)="This report is sent in a mail message to the members"
^DIC(19,14086,1,12,0)="of the SD MH NO SHOW NOTIFICATION mail group. "
^DIC(19,14086,1,13,0)=" "
^DIC(19,14086,1,14,0)="Future appointments will list on this report.  The number"
^DIC(19,14086,1,15,0)="of days worth of future appointments that will list is defaulted"
^DIC(19,14086,1,16,0)="to 30 days in the future.  A new parameter"
^DIC(19,14086,1,17,0)="SD MH NO SHOW DAYS has been added to store"
^DIC(19,14086,1,18,0)="the number of days to list future appointments for."
^DIC(19,14086,1,19,0)="This parameter can be edited by the user by using the option "
^DIC(19,14086,1,20,0)="[ XPAR EDIT PARAMETER] Edit Parameter Values"
^DIC(19,14086,1,21,0)="changing the System value."
^DIC(19,14086,21,0)="^^1^1^3121115^"
^DIC(19,14086,21,1,0)=" "
^DIC(19,14086,25)="EN^SDMHNS"
^DIC(19,14086,"U")="HIGH RISK MH NO-SHOW NIGHTLY R"
