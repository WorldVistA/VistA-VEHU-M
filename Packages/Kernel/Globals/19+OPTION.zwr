^DIC(19,7846,"U")="PURGE PATIENT RECORDS WITH NO "
^DIC(19,7847,0)="ONCO #SITE-FIX EXP PAT F/U^Correct Next Follow-Up for Expired Patients^^R^11595^^^^^^^150^^1"
