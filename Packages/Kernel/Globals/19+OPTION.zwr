^DIC(19,3495,"U")="EDIT KERMIT HOLDING FILE"
^DIC(19,3498,0)="ZTMERDEL^Delete Error Log^^R^.5^^^^^^^"
^DIC(19,3498,1,0)="^^1^1^2880817^"
^DIC(19,3498,1,1,0)="This option deletes the Task Error Log."
^DIC(19,3498,25)="KILL^ZTMKE"
^DIC(19,3498,"U")="DELETE ERROR LOG"
^DIC(19,3502,0)="XQSMD SET PREFIX^Specify Allowable New Menu Prefix^^E^1039^^^^^^^^^"
^DIC(19,3502,1,0)="^^3^3^2881020^"
^DIC(19,3502,1,1,0)="Permits the user to give another user an Allowable New Menu Prefix for"
^DIC(19,3502,1,2,0)="purposes of Secure Menu Delegation, so that the Delegate may build new"
^DIC(19,3502,1,3,0)="menus from the options which have been delegated."
^DIC(19,3502,30)="VA(200,"
^DIC(19,3502,31)="AEMQ"
^DIC(19,3502,50)="VA(200,"
^DIC(19,3502,51)="[XQSMD SET PREFIX]"
^DIC(19,3502,99)="54716,40724"
^DIC(19,3502,"U")="SPECIFY ALLOWABLE NEW MENU PRE"
^DIC(19,3503,0)="XTFCR^Flow Chart Entire Routine^^R^.5^^^^^^^^^"
^DIC(19,3503,1,0)="^^2^2^2881027^"
^DIC(19,3503,1,1,0)="This option produces a flow chart of the processing performed within"
^DIC(19,3503,1,2,0)="a routine."
^DIC(19,3503,25)="XTFCR"
^DIC(19,3503,"U")="FLOW CHART ENTIRE ROUTINE"
^DIC(19,3504,0)="XTFCE^Flow Chart from Entry Point^^R^.5^^^^^^^^^"
^DIC(19,3504,1,0)="^^5^5^2881027^"
^DIC(19,3504,1,1,0)="This option produces a flow chart on the terminal screen of the processing"
^DIC(19,3504,1,2,0)="performed from the specified entry point to the the termination of"
^DIC(19,3504,1,3,0)="processing resulting from that entry point.  It also permits the user to"
^DIC(19,3504,1,4,0)="expand the code in other routines or entry points referenced by DO or"
^DIC(19,3504,1,5,0)="GOTO commands."
^DIC(19,3504,25)="XTFCE"
^DIC(19,3504,"U")="FLOW CHART FROM ENTRY POINT"
^DIC(19,3508,0)="ZTMERTYPE^Remove Type Of Error^^R^.5^^^^^^^"
^DIC(19,3508,1,0)="^^9^9^2890127^"
^DIC(19,3508,1,1,0)="This option provides a way to clean Task Manager's log of errors.  The"
^DIC(19,3508,1,2,0)="site manager can enter a string, and this option will then delete every"
^DIC(19,3508,1,3,0)="entry in the log that contains that string.  For example, if the site"
^DIC(19,3508,1,4,0)="manager enters ""<UNDEF>"" then every error that contains this string"
^DIC(19,3508,1,5,0)="will be deleted.  Two other examples are ""ZTSK+3^XQ1:4"" and ""E"".  The"
^DIC(19,3508,1,6,0)="first removes all errors that occurred on the line and command indicated"
^DIC(19,3508,1,7,0)="while the second removes ALL errors whose $ZE value contains an ""E""."
^DIC(19,3508,1,8,0)="Note that this does not edit the system's main error log, only Task"
^DIC(19,3508,1,9,0)="Manager's Error Log in the ^%ZTSCH global."
^DIC(19,3508,25)="TYPE^ZTMKE"
^DIC(19,3508,"U")="REMOVE TYPE OF ERROR"
^DIC(19,3509,0)="ZTMERRANGE^Purge Over Range Of Dates^^R^.5^^^^^^^"
^DIC(19,3509,1,0)="^^4^4^2890127^"
^DIC(19,3509,1,1,0)="This option allows the site manager to remove from Task Manager's error"
^DIC(19,3509,1,2,0)="log all entries that occur on or between two dates.  The site manager"
^DIC(19,3509,1,3,0)="enters the two dates, FIRST THE EARLIER DATE AND THEN THE LATER DATE,"
^DIC(19,3509,1,4,0)="and then the option removes the appropriate entries."
^DIC(19,3509,25)="RANGE^ZTMKE"
^DIC(19,3509,"U")="PURGE OVER RANGE OF DATES"
^DIC(19,3510,0)="ZTMDEFAULT^Edit Taskman Default Values^^E^.5^^^^^^^"
^DIC(19,3510,1,0)="^^2^2^2890202^^"
^DIC(19,3510,1,1,0)="This option is an edit template that collects together the fields in the"
^DIC(19,3510,1,2,0)="Kernel Site Parameters File that affect Task Manager."
^DIC(19,3510,30)="XMB(1,"
^DIC(19,3510,31)="AEMQ"
^DIC(19,3510,50)="XMB(1,"
^DIC(19,3510,51)="[XU-ZTMDEFAULT]"
^DIC(19,3510,"U")="EDIT TASKMAN DEFAULT VALUES"
^DIC(19,3511,0)="XTSUMBLD^Build an 'NTEG' routine for a package^^R^.5^^^^^^^^^"
^DIC(19,3511,1,0)="^^5^5^2890227^^"
^DIC(19,3511,1,1,0)="This option gets a package namespace from the package file and"
^DIC(19,3511,1,2,0)="then a list of routines from the user.  It then builds a "
^DIC(19,3511,1,3,0)="<namespace>NTEG routine that has a checksum for each of the"
^DIC(19,3511,1,4,0)="routines.  This routine can be run to see if there has been"
^DIC(19,3511,1,5,0)="any change to a routine since the NTEG routine was built."
^DIC(19,3511,25)="XTSUMBLD"
^DIC(19,3511,"U")="BUILD AN 'NTEG' ROUTINE FOR A "
^DIC(19,3512,0)="XUSESIG^Electronic Signature Code Edit^^R^11720^^^^^^^^^"
^DIC(19,3512,1,0)="^19.06^2^2^3170124^^^"
^DIC(19,3512,1,1,0)="This option allows the users to edit their INITALS, SIGNATURE BLOCK TITLE,"
^DIC(19,3512,1,2,0)="ELECTRONIC SIGNATURE CODE, and OFFICE PHONE."
^DIC(19,3512,25)="XUSESIG"
^DIC(19,3512,"U")="ELECTRONIC SIGNATURE CODE EDIT"
