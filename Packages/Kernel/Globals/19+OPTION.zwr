^DIC(19,13650,25)="QUERPT^RCDMCR2A"
^DIC(19,13650,200.9)="y"
^DIC(19,13650,"U")="DMC DEBT VALIDITY MANAGEMENT R"
^DIC(19,13651,0)="RCDMCR3 RD ELIG CHANGE REPORT^Rated Disability Eligibility Change Report^^R^1^^^^^^^261^y^"
^DIC(19,13651,1,0)="^^47^47^3080523^"
^DIC(19,13651,1,1,0)="This Accounts Receivable option is to assist users in focusing on"
^DIC(19,13651,1,2,0)="reviewing the legitimacy of first party bills where the veteran is neither"
^DIC(19,13651,1,3,0)="SC 50% to 100% nor in receipt of VA Pension benefits (Veterans not"
^DIC(19,13651,1,4,0)="included on the ""DMC Debt Validity Report""). The report would contain"
^DIC(19,13651,1,5,0)="information on veterans who have bills for episodes of care within the"
^DIC(19,13651,1,6,0)="previous 365 days (or older selected date) and who have a new Rated"
^DIC(19,13651,1,7,0)="Disability during a user selected time period. "
^DIC(19,13651,1,8,0)=" "
^DIC(19,13651,1,9,0)="Authorized billing staff can run the report to ensure that all bills"
^DIC(19,13651,1,10,0)="meeting the above criteria are reviewed and if necessary the appropriate"
^DIC(19,13651,1,11,0)="action is taken as follows:"
^DIC(19,13651,1,12,0)="   Bill is appropriate - There shall be no action taken."
^DIC(19,13651,1,13,0)="   Bill is inappropriate - AR staff shall cancel the bill using existing "
^DIC(19,13651,1,14,0)="                           functionality."
^DIC(19,13651,1,15,0)="   Inappropriate bill sent to DMC - AR staff shall cancel/refund "
^DIC(19,13651,1,16,0)="                                    using existing functionality."
^DIC(19,13651,1,17,0)=" "
^DIC(19,13651,1,18,0)="The report allows for the user to select the time period for Rated "
^DIC(19,13651,1,19,0)="Disabilities, to select the date from which to include bills for episodes"
^DIC(19,13651,1,20,0)="of care on the report, and to select if they want the report printed in a"
^DIC(19,13651,1,21,0)="Detailed Format or in an Excel Delimited Format. "
^DIC(19,13651,1,22,0)=" "
^DIC(19,13651,1,23,0)="It is recommended that the user Queues this report to a device that is 132"
^DIC(19,13651,1,24,0)="characters wide."
^DIC(19,13651,1,25,0)=" "
^DIC(19,13651,1,26,0)="The report will include the following data elements:"
^DIC(19,13651,1,27,0)="   Data Elements                      From File #"
^DIC(19,13651,1,28,0)="   -------------------------------    ---------------------------------"
^DIC(19,13651,1,29,0)="   Veteran's Name                     #2 (Patient File) "
^DIC(19,13651,1,30,0)="   SSN (Last 4 digits)                #2"
^DIC(19,13651,1,31,0)="   Claim Number(CXXXXXXXX)            #2"
^DIC(19,13651,1,32,0)="   Claim Location(Station Number)     #2"
^DIC(19,13651,1,33,0)="   Eligibility Change Date New        #390 (ENROLLMENT RATED DISABILITY "
^DIC(19,13651,1,34,0)="                                            UPLOAD AUDIT FILE)"
^DIC(19,13651,1,35,0)="   New Rated Disability Name          #390"
^DIC(19,13651,1,36,0)="   Extremity Affected                 #390"
^DIC(19,13651,1,37,0)="   Original Effective Date            #390"
^DIC(19,13651,1,38,0)="   Bill Number                        #430 (Accounts Receivable)"
^DIC(19,13651,1,39,0)="   RX Fill/Re-Fill Date.              File #52 pointed to by File #350"
^DIC(19,13651,1,40,0)="   Outpatient Visit Date              File #409.68 pointed to by file #350"
^DIC(19,13651,1,41,0)="   Discharge Date                     File #405 pointed to by file #350"
^DIC(19,13651,1,42,0)="   AR Status(Open/Active/Suspended)   #430"
^DIC(19,13651,1,43,0)="  "
^DIC(19,13651,1,44,0)="   Summary at bottom of report:"
^DIC(19,13651,1,45,0)="       Total Number of Bills"
^DIC(19,13651,1,46,0)="       Total Number of Rated Disabilities"
^DIC(19,13651,1,47,0)="       Total Number of unique veterans       "
^DIC(19,13651,20)=""
^DIC(19,13651,25)="MAIN^RCDMCR3A"
^DIC(19,13651,"U")="RATED DISABILITY ELIGIBILITY C"
^DIC(19,13652,0)="RCDMCR3 RD ELIG CHANGE TASK^Rated Disability Elig Change Rpt - Scheduled Task^^R^1^^^^^^^261^^"
^DIC(19,13652,1,0)="^19.06^57^57^3080523^^"
^DIC(19,13652,1,1,0)="This Accounts Receivable option is used to schedule the Rated Disability"
^DIC(19,13652,1,2,0)="Eligibility Change Report to run on a recurring basis with out user"
^DIC(19,13652,1,3,0)="intervention. It is used to assist users in focusing on reviewing the"
^DIC(19,13652,1,4,0)="legitimacy of first party bills where the veteran is neither SC 50% to"
^DIC(19,13652,1,5,0)="100% nor in receipt of VA Pension benefits (Veterans not included on the"
^DIC(19,13652,1,6,0)="""DMC Debt Validity Report""). The report will contain information on"
^DIC(19,13652,1,7,0)="veterans who have bills for episodes of care within the previous X1 days"
^DIC(19,13652,1,8,0)="and who have a new Rated Disability during the last X2 days. "
^DIC(19,13652,1,9,0)=" "
^DIC(19,13652,1,10,0)="X1 will be the value entered in the ""NUMBER OF DAYS FOR DMC REPORTS"""
^DIC(19,13652,1,11,0)="(#8.02) field of the AR SITE PARAMETER (#342) file. If this value isn't"
^DIC(19,13652,1,12,0)="entered the report will default to bills from episodes of care for the"
^DIC(19,13652,1,13,0)="past 365 days. This parameter can be edited using the Enter/Edit DMC"
^DIC(19,13652,1,14,0)="Report # Days for Episodes of Care [RCDMC EDIT DMC REPORT # OF DAY]"
^DIC(19,13652,1,15,0)="option. "
^DIC(19,13652,1,16,0)=" "
^DIC(19,13652,1,17,0)="X2 will be the value entered in the ""# OF DAYS FOR RD ELIG CHG RPT"""
^DIC(19,13652,1,18,0)="(#8.01) field of the AR SITE PARAMETER (#342) file. If this value isn't"
^DIC(19,13652,1,19,0)="entered or is zero, the report will default to RD data for the last 31"
^DIC(19,13652,1,20,0)="days. This parameter can be edited using the Enter/Edit RD Number of Days"
^DIC(19,13652,1,21,0)="Report Parameter [RCDMC EDIT RD # OF DAYS PARAME] option."
^DIC(19,13652,1,22,0)=" "
^DIC(19,13652,1,23,0)="Authorized billing staff can use the report to ensure that all bills"
^DIC(19,13652,1,24,0)="meeting the above criteria are reviewed and if necessary the appropriate"
^DIC(19,13652,1,25,0)="action is taken as follows:"
^DIC(19,13652,1,26,0)="    Bill is appropriate - There shall be no action taken."
^DIC(19,13652,1,27,0)="    Bill is inappropriate - AR staff shall cancel the bill using existing"
^DIC(19,13652,1,28,0)="                            functionality."
^DIC(19,13652,1,29,0)="    Inappropriate bill sent to DMC - AR staff shall cancel/refund"
^DIC(19,13652,1,30,0)="                                     using existing functionality."
^DIC(19,13652,1,31,0)=" "
^DIC(19,13652,1,32,0)="The scheduled report can only be printed in the detailed format and it "
^DIC(19,13652,1,33,0)="should be sent to a device that is 132 characters wide."
^DIC(19,13652,1,34,0)=" "
^DIC(19,13652,1,35,0)=" The report will include the following data elements:"
^DIC(19,13652,1,36,0)="    Data Elements                      From File #"
^DIC(19,13652,1,37,0)="    -------------------------------    ---------------------------------"
^DIC(19,13652,1,38,0)="    Veteran's Name                     #2 (Patient File)"
^DIC(19,13652,1,39,0)="    SSN (Last 4 digits)                #2"
^DIC(19,13652,1,40,0)="    Claim Number(CXXXXXXXX)            #2"
^DIC(19,13652,1,41,0)="    Claim Location(Station Number)     #2"
^DIC(19,13652,1,42,0)="    Eligibility Change Date            #390 (ENROLLMENT RATED DISABILITY"
^DIC(19,13652,1,43,0)="                                             UPLOAD AUDIT FILE)"
^DIC(19,13652,1,44,0)="    New Rated Disability Name          #390"
^DIC(19,13652,1,45,0)="    Extremity Affected                 #390"
^DIC(19,13652,1,46,0)="    Original Effective Date            #390"
^DIC(19,13652,1,47,0)="    Bill Number                        #430 (Accounts Receivable)"
^DIC(19,13652,1,48,0)="    RX Fill/Re-Fill Date.              File #52 pointed to by File #350"
^DIC(19,13652,1,49,0)="    Outpatient Visit Date              File #409.68 pointed to by file "
^DIC(19,13652,1,50,0)="                                       #350"
^DIC(19,13652,1,51,0)="    Discharge Date                     File #405 pointed to by file #350"
^DIC(19,13652,1,52,0)="    AR Status(Open/Active/Suspended)   #430"
^DIC(19,13652,1,53,0)=" "
^DIC(19,13652,1,54,0)="    Summary at bottom of report:"
^DIC(19,13652,1,55,0)="        Total Number of Bills"
^DIC(19,13652,1,56,0)="        Total Number of Rated Disabilities"
^DIC(19,13652,1,57,0)="        Total Number of unique veterans"
^DIC(19,13652,20)=""
^DIC(19,13652,25)="QUERPT^RCDMCR3A"
^DIC(19,13652,200.9)="y"
^DIC(19,13652,"U")="RATED DISABILITY ELIG CHANGE R"
^DIC(19,13653,0)="RCDMC EDIT DMC REPORT # OF DAY^Enter/Edit DMC Report # Days for Episodes of Care^^R^1^^^^^^^"
^DIC(19,13653,1,0)="^^12^12^3080520^"
^DIC(19,13653,1,1,0)="This option allows users to enter/edit the ""NUMBER OF DAYS FOR DMC "
^DIC(19,13653,1,2,0)="REPORTS"" site parameter in the AR Site Parameter (#342) file. This will"
^DIC(19,13653,1,3,0)="allow the user to select how many days in the past bills for episodes of"
^DIC(19,13653,1,4,0)="care will be included on the following reports when they are scheduled by"
^DIC(19,13653,1,5,0)="IRM to be run on a recurring basis:"
^DIC(19,13653,1,6,0)="     DMC Debt Validity Report"
^DIC(19,13653,1,7,0)="     DMC Debt Validity Management Report"
^DIC(19,13653,1,8,0)="     Rated Disability Eligibility Change Report"
^DIC(19,13653,1,9,0)=" "
^DIC(19,13653,1,10,0)="The minimum value for this site parameter is 365 days (1 year) and the"
^DIC(19,13653,1,11,0)="maximum value is 3650 days (10 years). If no value is added for this site "
^DIC(19,13653,1,12,0)="parameter the default value will be 365 days."
^DIC(19,13653,25)="EDITRDAY^RCMSITE"
^DIC(19,13653,"U")="ENTER/EDIT DMC REPORT # DAYS F"
^DIC(19,13654,0)="RA OUTSIDE RPTENTRY^Outside Report Entry/Edit^^R^1^^^^^^^31^^1^1"
^DIC(19,13654,1,0)="^^7^7^3211215^"
^DIC(19,13654,1,1,0)="For studies tied to CPT Codes this option allows the user to log an"
^DIC(19,13654,1,2,0)="outside interpreted report without having to verify it.  The report"
^DIC(19,13654,1,3,0)="entered from this option is automatically given the 'Electronically Filed'"
^DIC(19,13654,1,4,0)="report status."
^DIC(19,13654,1,5,0)=" "
^DIC(19,13654,1,6,0)=" Note: 'Outside Report Entry/Edit' will not log an outside interpreted"
^DIC(19,13654,1,7,0)="       report to a study with a 'Broad' procedure type."
^DIC(19,13654,15)="K RANOSCRN,^TMP($J,""RA D-TYPE""),^TMP($J,""RA I-TYPE"")"
^DIC(19,13654,20)="S RANOSCRN="""""
^DIC(19,13654,25)="RARTE5"
^DIC(19,13654,"U")="OUTSIDE REPORT ENTRY/EDIT"
^DIC(19,13655,0)="RA RESTORE REPORT^Restore a Deleted Report^^R^1^RA RPTMGR^^^^^^31"
^DIC(19,13655,1,0)="^19.06^5^5^3210406^^"
^DIC(19,13655,1,1,0)="This option will restore a deleted report to its case, only if another "
^DIC(19,13655,1,2,0)="report was not linked to the case in the interim (time between the report "
^DIC(19,13655,1,3,0)="deletion and restoration.)  The restored report is re-assigned the report "
^DIC(19,13655,1,4,0)="status it had prior to the 'Deleted' report status.  However, the status "
^DIC(19,13655,1,5,0)="of the exam is not updated."
^DIC(19,13655,25)="RSTR^RARTE6"
^DIC(19,13655,"U")="RESTORE A DELETED REPORT"
^DIC(19,13656,0)="PSD GS TRANS PCA/INF PATIENT^Transfer GS for PCA/Infusion Signed Out to Patient^^R^1^^^^^^^276"
^DIC(19,13656,1,0)="^^3^3^3070423^"
^DIC(19,13656,1,1,0)="Use this option to transfer Green Sheets for"
^DIC(19,13656,1,2,0)="PCA/Infusions already signed out to a patient"
^DIC(19,13656,1,3,0)="to another NAOU."
^DIC(19,13656,25)="PSDNTFPC"
^DIC(19,13656,"U")="TRANSFER GS FOR PCA/INFUSION S"
^DIC(19,13657,0)="PSD GS REC PCA/INF FOR PATIENT^Receive GS for PCA/Infusion Signed Out to Patient^^R^1^^^^^^^276"
^DIC(19,13657,1,0)="^^3^3^3070423^"
^DIC(19,13657,1,1,0)="Use this option to receive Green Sheets"
^DIC(19,13657,1,2,0)="already signed out to a patient from another"
^DIC(19,13657,1,3,0)="NAOU."
^DIC(19,13657,25)="PSDNTTPC"
^DIC(19,13657,"U")="RECEIVE GS FOR PCA/INFUSION SI"
^DIC(19,13658,0)="LA7 UI SETUP^Lab Universal Interface Setup^^R^1^^^^^^^53"
^DIC(19,13658,1,0)="^^3^3^3070726^"
^DIC(19,13658,1,1,0)="Allows configuring Lab Universal Interface entries (LA7UI*) in LA7 MESSAGE"
^DIC(19,13658,1,2,0)="PARAMETER file (#62.48) and corresponding entries in AUTO INSTRUMENT file"
^DIC(19,13658,1,3,0)="(#62.4) which use the Lab Universal Interface."
^DIC(19,13658,25)="EN^LA7UCFG"
^DIC(19,13658,"U")="LAB UNIVERSAL INTERFACE SETUP"
