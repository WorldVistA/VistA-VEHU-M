^DIC(19,7911,0)="PRSA LV DISP^Display Leave Requests^^R^.5^^^^^^^"
^DIC(19,7911,1,0)="^^2^2^2930202^^^^"
^DIC(19,7911,1,1,0)="The employee enters a date and a list of all his/her leave requests"
^DIC(19,7911,1,2,0)="from that date onward are displayed."
^DIC(19,7911,25)="PRSALVS"
^DIC(19,7911,99)="55550,58412"
^DIC(19,7911,"U")="DISPLAY LEAVE REQUESTS"
^DIC(19,7912,0)="PRSA LV CAN^Cancel Leave Request^^R^.5^^^^^^^"
^DIC(19,7912,1,0)="^^3^3^2930211^^^^"
^DIC(19,7912,1,1,0)="The employee enters a date and a list of all his/her leave requests"
^DIC(19,7912,1,2,0)="from that date onward are displayed. The employee is prompted to select"
^DIC(19,7912,1,3,0)="a choice from the list to cancel."
^DIC(19,7912,25)="PRSALVX"
^DIC(19,7912,99)="55559,53418"
^DIC(19,7912,"U")="CANCEL LEAVE REQUEST"
^DIC(19,7913,0)="PRSA SUP CERT^Supervisory Approvals^^R^.5^^^^^^^"
^DIC(19,7913,1,0)="^^3^3^2930211^^^"
^DIC(19,7913,1,1,0)="This option displays any actions that need a supervisor's approval"
^DIC(19,7913,1,2,0)="such as a change in an employee's Tour of Duty. The supervisor is"
^DIC(19,7913,1,3,0)="prompted to approve, disapprove or cancel the request."
^DIC(19,7913,25)="PRSASC"
^DIC(19,7913,"U")="SUPERVISORY APPROVALS"
^DIC(19,7914,0)="PRSA OT CAN^Cancel OT and CT/CH Requests^^R^11596^^^^^^^230"
^DIC(19,7914,1,0)="4^^7^7^2980514^^^^"
^DIC(19,7914,1,1,0)="This option allows the user to cancel overtime and"
^DIC(19,7914,1,2,0)="compensatory/credit hours requests. After selecting the employee,"
^DIC(19,7914,1,3,0)="the user specifies a date to begin searching for all such requests."
^DIC(19,7914,1,4,0)="That employee's requests are listed and the user selects the one to"
^DIC(19,7914,1,5,0)="cancel.  Note that compensatory time and credit hours are both coded"
^DIC(19,7914,1,6,0)="under CT. "
^DIC(19,7914,1,7,0)=""
^DIC(19,7914,25)="CAN^PRSAOTR"
^DIC(19,7914,99)="55525,57608"
^DIC(19,7914,"U")="CANCEL OT AND CT/CH REQUESTS"
^DIC(19,7915,0)="PRSA ED REQ^Envir. Diff. Request^^R^.5^^^^^^^"
^DIC(19,7915,1,0)="^^3^3^2930202^^^^"
^DIC(19,7915,1,1,0)="This option allows the user to enter an environmental differential"
^DIC(19,7915,1,2,0)="request for an employee. The date, from and to time, type of exposure,"
^DIC(19,7915,1,3,0)="and justification are entered."
^DIC(19,7915,25)="PRSAEDR"
^DIC(19,7915,99)="55525,56000"
^DIC(19,7915,"U")="ENVIR. DIFF. REQUEST"
^DIC(19,7916,0)="PRSA ED CAN^Cancel Envir. Diff. Request^^R^.5^^^^^^^"
^DIC(19,7916,1,0)="2^^2^2^2930202^^"
^DIC(19,7916,1,1,0)="This option allows the user to cancel an environmental differential"
^DIC(19,7916,1,2,0)="request."
^DIC(19,7916,25)="CAN^PRSAEDR"
^DIC(19,7916,99)="55525,55028"
^DIC(19,7916,"U")="CANCEL ENVIR. DIFF. REQUEST"
^DIC(19,7917,0)="PRSA VC POST^Post VCS Commission Sales^^R^.5^^^^^^^"
^DIC(19,7917,1,0)="^^2^2^2930202^^"
^DIC(19,7917,1,1,0)="This option allows the user to enter the dollar and cents amounts"
^DIC(19,7917,1,2,0)="of commission sales for Veteran Canteen Service pieceworkers."
^DIC(19,7917,25)="PRSATVC"
^DIC(19,7917,"U")="POST VCS COMMISSION SALES"
^DIC(19,7918,0)="PRSA PM POST^Post Miscellaneous Data^^R^11596^^^^^^^"
^DIC(19,7918,1,0)="^^2^2^2930202^^"
^DIC(19,7918,1,1,0)="This option allows Payroll to enter time and attendance related data"
^DIC(19,7918,1,2,0)="such as Annual Leave Lump Sum values and a T&L change."
^DIC(19,7918,25)="PRSAPEM"
^DIC(19,7918,99)="55550,52449"
^DIC(19,7918,"U")="POST MISCELLANEOUS DATA"
^DIC(19,7919,0)="PRSA OT LST^Display OT and CT/CH Requests^^R^11596^^^^^^^230"
^DIC(19,7919,1,0)="5^^8^8^2980514^^^^"
^DIC(19,7919,1,1,0)="This option allows a user to list overtime and compensatory/credit"
^DIC(19,7919,1,2,0)="hours requests for one or more employees. The user enters a 'begin'"
^DIC(19,7919,1,3,0)="date and an 'end' date. All such requests for the employee(s) chosen"
^DIC(19,7919,1,4,0)="will be displayed. The date, number of hours, type of request and"
^DIC(19,7919,1,5,0)="the justification for the request are listed.  Note that"
^DIC(19,7919,1,6,0)="compensatory time and credit hours are both coded under CT, so it"
^DIC(19,7919,1,7,0)="may be necessary for timekeepers to distinguish the type of request"
^DIC(19,7919,1,8,0)="(CT or CH) in the justification, when entering the request. "
^DIC(19,7919,25)="TK^PRSAOTL"
^DIC(19,7919,"U")="DISPLAY OT AND CT/CH REQUESTS"
^DIC(19,7920,0)="PRSA LV LST^List Leave Requests^^R^.5^^^^^^^"
^DIC(19,7920,1,0)="^^5^5^2940323^^^^"
^DIC(19,7920,1,1,0)="This option allows the user to list leave requests for one or all"
^DIC(19,7920,1,2,0)="employees. The user enters a 'begin' date and an 'end' date. All"
^DIC(19,7920,1,3,0)="leave requests for the employee(s) chosen will be displayed. The"
^DIC(19,7920,1,4,0)="list may be sorted by employee name or date of leave request. The"
^DIC(19,7920,1,5,0)="date, time, type of leave and any remarks are listed."
^DIC(19,7920,25)="TK^PRSALVL"
^DIC(19,7920,99)="55550,58275"
^DIC(19,7920,"U")="LIST LEAVE REQUESTS"
^DIC(19,7921,0)="PRSA TPD^Display Posted Data^^R^.5^^^^^^^"
^DIC(19,7921,1,0)="^^3^3^2930211^^^"
^DIC(19,7921,1,1,0)="This option allows the Timekeeper to select an employee and a posting"
^DIC(19,7921,1,2,0)="date. The employee's scheduled Tour of Duty and any exceptions to that"
^DIC(19,7921,1,3,0)="tour will be displayed."
^DIC(19,7921,25)="TK^PRSADP"
^DIC(19,7921,"U")="DISPLAY POSTED DATA"
^DIC(19,7922,0)="PRSA TPE ONE^List Daily Exceptions^^R^.5^^^^^^^"
^DIC(19,7922,1,0)="^^3^3^2940325^^^^"
^DIC(19,7922,1,1,0)="This option allows the user to list any time card problems for"
^DIC(19,7922,1,2,0)="a date selected. The name of the employee and a short message are"
^DIC(19,7922,1,3,0)="displayed."
^DIC(19,7922,25)="TK0^PRSATPX"
^DIC(19,7922,"U")="LIST DAILY EXCEPTIONS"
^DIC(19,7923,0)="PRSA TPE ALL^Display Pay Period Exceptions^^R^.5^^^^^^^"
^DIC(19,7923,1,0)="^^4^4^2930222^^^^"
^DIC(19,7923,1,1,0)="This option allows the user to list any time card problems for a"
^DIC(19,7923,1,2,0)="selected pay period. The name of the employee, date of the exception,"
^DIC(19,7923,1,3,0)="and a short message are displayed for the first day of the pay period"
^DIC(19,7923,1,4,0)="to the posting date chosen."
^DIC(19,7923,25)="TK1^PRSATPX"
^DIC(19,7923,"U")="DISPLAY PAY PERIOD EXCEPTIONS"
^DIC(19,7924,0)="PRSA EN EMP^Display Employee Entitlements^^R^11596^^^^^^^"
^DIC(19,7924,1,0)="^^2^2^2940112^^^^"
^DIC(19,7924,1,1,0)="This option allows the user to select an employee and display his/her"
^DIC(19,7924,1,2,0)="entitlement to each type of time worked or leave earned/used."
^DIC(19,7924,25)="PRSAENE"
^DIC(19,7924,99)="55342,55074"
^DIC(19,7924,"U")="DISPLAY EMPLOYEE ENTITLEMENTS"
^DIC(19,7925,0)="PRSA EN TAB^Display Entitlement Table^^R^.5^^^^^^^"
^DIC(19,7925,1,0)="^^3^3^2930202^^^^"
^DIC(19,7925,1,1,0)="This option deciphers the work/leave entitlement character string. It"
^DIC(19,7925,1,2,0)="displays the categories of work and leave and whether a value should be"
^DIC(19,7925,1,3,0)="entered in that category."
^DIC(19,7925,25)="PRSAENX"
^DIC(19,7925,99)="55333,39312"
^DIC(19,7925,"U")="DISPLAY ENTITLEMENT TABLE"
^DIC(19,7926,0)="PRSA OT APP^Approve OT and CT/CH^^R^11596^^^^^^^230^^^"
^DIC(19,7926,1,0)="^^3^3^2980518^^^^"
^DIC(19,7926,1,1,0)="This option allows the user to approve overtime and compensatory"
^DIC(19,7926,1,2,0)="time/credit hours requests.  Note that compensatory time and credit"
^DIC(19,7926,1,3,0)="hours are both coded under a single type of request. "
^DIC(19,7926,15)=""
^DIC(19,7926,20)=""
^DIC(19,7926,25)="PRSAOTX"
^DIC(19,7926,99)="55525,57558"
^DIC(19,7926,"U")="APPROVE OT AND CT/CH"
^DIC(19,7927,0)="PRSA SUP REV^Pay Period Certification^^R^.5^^^^^^^"
^DIC(19,7927,1,0)="^^4^4^2930202^^^"
^DIC(19,7927,1,1,0)="This option will display each date within the pay period, the"
^DIC(19,7927,1,2,0)="scheduled tour for that date and any tour exceptions for each"
^DIC(19,7927,1,3,0)="employee of each time and leave unit the supervisor is responsible"
^DIC(19,7927,1,4,0)="for certifying."
^DIC(19,7927,25)="PRSASR"
^DIC(19,7927,"U")="PAY PERIOD CERTIFICATION"
^DIC(19,7928,0)="PRSA ED LST^List Environment Diff. Requests^^R^.5^^^^^^^"
^DIC(19,7928,1,0)="3^^3^3^2930202^"
^DIC(19,7928,1,1,0)="This option allows the user to list environmental differential requests"
^DIC(19,7928,1,2,0)="within a user specified time span for one or all employees of a Time and"
^DIC(19,7928,1,3,0)="Leave Unit. The requests may be sorted by employee or date of request."
^DIC(19,7928,25)="TK^PRSAEDL"
^DIC(19,7928,99)="55525,55570"
^DIC(19,7928,"U")="LIST ENVIRONMENT DIFF. REQUEST"
^DIC(19,7929,0)="PRSA PAY EXC^Pay Period Exceptions^^R^11596^^^^^^^"
^DIC(19,7929,1,0)="^^3^3^2930202^^^"
^DIC(19,7929,1,1,0)="Displays a list of time card problems or questions for a pay period"
^DIC(19,7929,1,2,0)="that needs to be resolved. The name of the employee, day and date,"
^DIC(19,7929,1,3,0)="and a short description of the exception are displayed."
^DIC(19,7929,25)="PRSAPEX"
^DIC(19,7929,99)="55370,46221"
^DIC(19,7929,"U")="PAY PERIOD EXCEPTIONS"
