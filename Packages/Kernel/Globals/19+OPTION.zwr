^DIC(19,10683,"U")="IMPORT DATA"
^DIC(19,10684,0)="DMSQ PROJECT^Regenerate SQLI Projection^^R^1^XUPROGMODE^^^^^^309^^1^1"
^DIC(19,10684,1,0)="^^17^17^2971026^^^^"
^DIC(19,10684,1,1,0)="Regenerates the SQLI projection of VA FileMan data dictionaries. The"
^DIC(19,10684,1,2,0)="regeneration process:"
^DIC(19,10684,1,3,0)=" "
^DIC(19,10684,1,4,0)="  1. Purges existing information in SQLI data files."
^DIC(19,10684,1,5,0)="  2. Projects the data dictionaries for all VA FileMan files."
^DIC(19,10684,1,6,0)=" "
^DIC(19,10684,1,7,0)="Before running this option, the SQLI_KEY_WORD file should be populated"
^DIC(19,10684,1,8,0)="with all SQL, ODBC, and vendor-specific keywords that should not be used"
^DIC(19,10684,1,9,0)="in SQLI entity naming."
^DIC(19,10684,1,10,0)=" "
^DIC(19,10684,1,11,0)="This option requires programmer mode as well as the progmode key."
^DIC(19,10684,1,12,0)=" "
^DIC(19,10684,1,13,0)="This option may also be used as a skeleton for one that you may want"
^DIC(19,10684,1,14,0)="to create locally.  Your local option could include the vendor's"
^DIC(19,10684,1,15,0)="keyword call in the Entry Action and the vendor's mapping call in the"
^DIC(19,10684,1,16,0)="Exit Action.  A status variable could be used to confirm that the"
^DIC(19,10684,1,17,0)="SQLI projection completes before the vendor mapping is initiated."
^DIC(19,10684,15)=";vendor's mapper call could go here"
^DIC(19,10684,20)=";vendor's keyword call could go here"
^DIC(19,10684,25)="SETUP^DMSQ"
^DIC(19,10684,200.9)="y"
^DIC(19,10684,"U")="REGENERATE SQLI PROJECTION"
^DIC(19,10685,0)="DMSQ MENU^SQLI (VA FileMan)^^M^1^^^^^^^309"
^DIC(19,10685,1,0)="^^1^1^2970806^^^^"
