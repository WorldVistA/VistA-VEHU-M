^DIC(19,11684,"U")="CMOP UTILITIES"
^DIC(19,11685,0)="PSO SUCMOP RESUSPENDNOTPRI^Unprinted/Non-Transmitted Rxs Re-Suspend^^R^11740^^^^^^^141"
^DIC(19,11685,1,0)="^19.06^5^5^3000414^^^"
^DIC(19,11685,1,1,0)="This utility will allow sites to re-suspend everything that has not printed"
^DIC(19,11685,1,2,0)="and not already queued for CMOP.  This utility can be queued to run in the"
^DIC(19,11685,1,3,0)="background or while you wait. "
^DIC(19,11685,1,4,0)=" "
