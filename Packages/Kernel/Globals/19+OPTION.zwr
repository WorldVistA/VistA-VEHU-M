^DIC(19,14722,0)="PSO NON-VA PROVIDER IMPORT^Non-VA Provider Import^^R^11720^^^^^^y^141"
^DIC(19,14722,1,0)="^^18^18^3180515^"
^DIC(19,14722,1,1,0)="This option is used to import Non-VA provider information from Excel "
^DIC(19,14722,1,2,0)="spreadsheets and file the information into the NEW PERSON (#200) file."
^DIC(19,14722,1,3,0)=" "
^DIC(19,14722,1,4,0)="The following information must be known prior to invoking this option:"
^DIC(19,14722,1,5,0)="1. Directory name which contains the file(s)"
^DIC(19,14722,1,6,0)="2. Exact filename(s)"
^DIC(19,14722,1,7,0)=" "
^DIC(19,14722,1,8,0)="This option may be invoked multiple times if multiple files should be "
^DIC(19,14722,1,9,0)="imported for your site.  The files are separated out by VISN and state.  "
^DIC(19,14722,1,10,0)="Your site might need to import information from more than one site for "
^DIC(19,14722,1,11,0)="your VISN."
^DIC(19,14722,1,12,0)=" "
^DIC(19,14722,1,13,0)="NOTE: It is highly recommended to pre-define the titles of ""HN NON-VA "
^DIC(19,14722,1,14,0)="PROVIDER"" and ""TW NON-VA PROVIDER"" in the TITLE (#3.1) file.  Otherwise, "
^DIC(19,14722,1,15,0)="the providers loaded by this patch will have no titles viewable in CPRS."
^DIC(19,14722,1,16,0)=" "
^DIC(19,14722,1,17,0)="(The providers loaded by this patch may be selected as encounter "
^DIC(19,14722,1,18,0)="providers in CPRS, but not as ordering providers.)"
^DIC(19,14722,10.1)="Non-VA Provider Import"
^DIC(19,14722,25)="EN^PSONVAP2"
^DIC(19,14722,"U")="NON-VA PROVIDER IMPORT"
^DIC(19,14723,0)="PSO NON-VA PROVIDER INACTIVATE^Non-VA Provider Inactivate^^R^11720^XUPROG^^^^^^141"
^DIC(19,14723,1,0)="^^3^3^3180628^"
^DIC(19,14723,1,1,0)="This option is to be used only when Non-VA providers which were imported "
^DIC(19,14723,1,2,0)="by option ""PSO NON-VA PROVIDER IMPORT"" need to be inactivated due to"
^DIC(19,14723,1,3,0)="corrupt files or other issues."
^DIC(19,14723,25)="EN^PSONVAP4"
^DIC(19,14723,"U")="NON-VA PROVIDER INACTIVATE"
