^DIC(19,14653,1,9,0)=" RACE (#10)           ->  RACE MASTER (#10.99)"
^DIC(19,14653,1,10,0)=" MARITAL STATUS (#11) ->  MASTER MARITRAL STATUS (#11.99)"
^DIC(19,14653,1,11,0)=" RELIGION (#13)       ->  MASTER RELIGION (#13.99)"
^DIC(19,14653,25)="EN^DGMFASS"
^DIC(19,14653,"U")="MASTER FILE ASSOCIATION ENTER/"
