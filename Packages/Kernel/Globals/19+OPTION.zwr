^DIC(19,6313,0)="PRCAC TR RE-ESTABLISH BILL^Re-Establish Bill^^A^.5^^^^^^^261^^1"
^DIC(19,6313,1,0)="7^^7^7^2990811^^^^"
^DIC(19,6313,1,1,0)="This option is used to re-activate a bill that is in the WRITE-OFF, "
^DIC(19,6313,1,2,0)="SUSPENDED, CANCELLATION or COLLECTED/CLOSED status.  This will"
^DIC(19,6313,1,3,0)="create a Re-establish Transaction and change the status of the"
^DIC(19,6313,1,4,0)="bill to Active.  (not prepayment bill.)"
^DIC(19,6313,1,5,0)="     "
^DIC(19,6313,1,6,0)="If the bill has no balance, you must enter in the re-establish amount"
^DIC(19,6313,1,7,0)="of the bill which will be the principal balance of the bill."
^DIC(19,6313,20)="N PRC D ^PRCAWREA K DTOUT"
^DIC(19,6313,21,0)=0
^DIC(19,6313,99)="55704,37757"
^DIC(19,6313,"U")="RE-ESTABLISH BILL"
^DIC(19,6314,0)="PRCA PAYMENTS WITH WRITE-OFFS^Payments with Write-offs Report^^A^.5^^^^^^^261^^1"
^DIC(19,6314,1,0)="^^7^7^2920504^^"
^DIC(19,6314,1,1,0)="This report will show patients that have made payment and have"
^DIC(19,6314,1,2,0)="bills in the write-off status.  This report would be used to"
^DIC(19,6314,1,3,0)="re-evaluate if bills in the write-off status should be made active"
^DIC(19,6314,1,4,0)="for collection purposes."
^DIC(19,6314,1,5,0)=" "
^DIC(19,6314,1,6,0)="Written-off bills are still collectable and follow-up action should"
^DIC(19,6314,1,7,0)="be activated for these bills if the patient is making payments."
^DIC(19,6314,20)="D ^PRCAWOF K DTOUT"
^DIC(19,6314,"U")="PAYMENTS WITH WRITE-OFFS REPOR"
^DIC(19,6315,0)="PRCA REFUND REVIEW^Refund Review and Approve^^A^.5^^^^^^^^^1"
^DIC(19,6315,1,0)="^^10^10^2930609^^^^"
^DIC(19,6315,1,1,0)="This option will allow a user to select a Prepayment Bill in the"
^DIC(19,6315,1,2,0)="Open or Refund Review status, review the bill and approve the bill"
^DIC(19,6315,1,3,0)="by entering their Electronic Signature. The refund must be signed"
^DIC(19,6315,1,4,0)="by a Certifying Officer, holder of the PRCAY PAYMENT SUP security"
^DIC(19,6315,1,5,0)="key. "
^DIC(19,6315,1,6,0)="  "
^DIC(19,6315,1,7,0)="Two signatures are needed in order for it to be processed by the"
^DIC(19,6315,1,8,0)="Accounting Tech."
^DIC(19,6315,1,9,0)=" "
^DIC(19,6315,1,10,0)="NOTE: Prepayments under $1.00 cannot be refunded."
^DIC(19,6315,20)="D ^PRCARFD K DTOUT"
^DIC(19,6315,99)="55693,44899"
^DIC(19,6315,"U")="REFUND REVIEW AND APPROVE"
^DIC(19,6316,0)="PRCA PREPAY POST^Payments Posted from Prepayment^^A^.5^^^^^^^261^^1"
^DIC(19,6316,1,0)="^^9^9^2931015^^^^"
^DIC(19,6316,1,1,0)="This option will list by date selected, the AR Transactions that are"
^DIC(19,6316,1,2,0)="Decreases from Prepayment bills and their corresponding AR Transaction"
^DIC(19,6316,1,3,0)="that is a Payment in Full or Payment in Part to an Account Receivable"
^DIC(19,6316,1,4,0)="bill. An error will display if the decrease transaction and the payment"
^DIC(19,6316,1,5,0)="transaction don't balance."
^DIC(19,6316,1,6,0)=" "
^DIC(19,6316,1,7,0)="Payment transactions that are applied to bills that are not in the"
^DIC(19,6316,1,8,0)="36x5014 Appropriation will be flagged, in order to notify the AR Tech."
^DIC(19,6316,1,9,0)="to include that payment amount on a 928.23 transaction type code sheet."
^DIC(19,6316,20)="D ^PRCARFP K DTOUT"
^DIC(19,6316,"U")="PAYMENTS POSTED FROM PREPAYMEN"
