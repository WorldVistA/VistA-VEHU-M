^DIC(19,627,"U")="SUPERVISOR MENU"
^DIC(19,629,0)="SDDISCHARGE^Discharge from Clinic^^A^.5^^^^^^^16^^1^1"
^DIC(19,629,1,0)="^^4^4^2860723^^^"
^DIC(19,629,1,1,0)="This option is used to discharge a patient from a clinic in which he/she"
^DIC(19,629,1,2,0)="is enrolled.  Once discharged from the clinic the patient would have to"
^DIC(19,629,1,3,0)="either be re-enrolled or scheduled for a consultation if further visits"
^DIC(19,629,1,4,0)="are necessary."
^DIC(19,629,15)="D SDCD^SDKILL"
^DIC(19,629,20)="K SDFN,SDCLN D ^SDCD"
^DIC(19,629,25)=""
^DIC(19,629,"U")="DISCHARGE FROM CLINIC"
^DIC(19,630,0)="SDCLINLIST^Clinic List (Day of Week)^^R^.5^^^^^^^16^^^1"
^DIC(19,630,1,0)="^^3^3^2860620^^^"
^DIC(19,630,1,1,0)="This option generates a listing of clinics by the day of week they meet."
^DIC(19,630,1,2,0)="If a particular clinic meets Monday, Wednesday and Friday it will appear"
^DIC(19,630,1,3,0)="on each days listing."
^DIC(19,630,15)="D SDCLDOW^SDKILL"
^DIC(19,630,25)="SDCLDOW"
^DIC(19,630,"U")="CLINIC LIST (DAY OF WEEK)"
^DIC(19,631,0)="SDEDLET^Enter/Edit Letters^^R^.5^^^^^^^16"
^DIC(19,631,1,0)="^^8^8^2900419^^^"
^DIC(19,631,1,1,0)="This option is used to enter a new/edit an existing letter which is one of"
^DIC(19,631,1,2,0)="the following types:"
^DIC(19,631,1,3,0)="(P)re-appointment"
^DIC(19,631,1,4,0)="(N)o-show "
^DIC(19,631,1,5,0)="(C)linic Cancelled -       (Cancel Clinic Availaility option was used to "
^DIC(19,631,1,6,0)="                           cancel appointments)"
^DIC(19,631,1,7,0)="(A)ppointment Cancelled  - (appointment was cancelled individually through "
^DIC(19,631,1,8,0)="                           Cancel Appointment option)"
^DIC(19,631,25)="SDLTE"
^DIC(19,631,"U")="ENTER/EDIT LETTERS"
^DIC(19,633,0)="SDAPPEND^Append Ancillary Test to Appt.^^R^.5^^^^^^^16^^^1"
^DIC(19,633,1,0)="^^3^3^2850415^^"
^DIC(19,633,1,1,0)="This option allows the user to add ancillary tests to a previously"
^DIC(19,633,1,2,0)="scheduled appointment which may have been overlooked at the time the"
^DIC(19,633,1,3,0)="appointment was originally made."
^DIC(19,633,15)="K EKG,LAB,SDANAM,SDAPAM,SDWR,SODT,XRAY"
^DIC(19,633,25)="SDASO"
^DIC(19,633,"U")="APPEND ANCILLARY TEST TO APPT."
^DIC(19,634,0)="SDDELANCIL^Delete Ancillary Test for Appt.^^R^.5^^^^^^^16^^^1"
^DIC(19,634,1,0)="^^5^5^2930614^^^^"
^DIC(19,634,1,1,0)="This option is used to delete an ancillary test for a specific appointment"
^DIC(19,634,1,2,0)="which may have been inadvertantly scheduled or cancelled."
^DIC(19,634,1,3,0)=""
^DIC(19,634,1,4,0)="If the appointment has been checked out then use Add/Edit stop code"
^DIC(19,634,1,5,0)="functionality to delete the appropriate stop code."
^DIC(19,634,15)="K DIPGM,DUOUT,%Y,C,DD,DISYS,DIX,DIY,DZ"
^DIC(19,634,25)="SDDSO"
^DIC(19,634,"U")="DELETE ANCILLARY TEST FOR APPT"
^DIC(19,635,0)="SDDISPPEND^Display Appointments^^R^.5^^^^^^^16"
^DIC(19,635,1,0)="^^3^3^2880519^^^^"
^DIC(19,635,1,1,0)="This option is used to display the past or pending appointments for a given"
^DIC(19,635,1,2,0)="patient.  If past appointments are selected, you may choose a date in the"
^DIC(19,635,1,3,0)="past from which the display should begin."
^DIC(19,635,25)="SDDPA"
^DIC(19,635,"U")="DISPLAY APPOINTMENTS"
^DIC(19,644,0)="SDCLINIC^Clinic Profile^^A^.5^^^^^^^16^^1^1"
^DIC(19,644,1,0)="^^3^3^2900401^^^^"
^DIC(19,644,1,1,0)="This option is used to generate a profile of clinics.  Basic information"
^DIC(19,644,1,2,0)="about each clinic, i.e., Name, Abbreviation, Dates the clinic meets, etc.,"
^DIC(19,644,1,3,0)="are displayed in a formatted output."
^DIC(19,644,15)="K DGPGM,DGVAR,SC,SDSC,VAUTD,VAUTNI"
^DIC(19,644,20)="G 7^SDOUTPUT"
^DIC(19,644,"U")="CLINIC PROFILE"
^DIC(19,645,0)="SDRESTORE^Restore Clinic Availability^^R^.5^^^^^^^16^^^1"
^DIC(19,645,1,0)="^^4^4^2850424^^^^"
^DIC(19,645,1,1,0)="This option is used to restore the availability for a previously"
^DIC(19,645,1,2,0)="cancelled clinic.  Appointments which were rescheduled using the"
^DIC(19,645,1,3,0)="auto-rebook feature at the time of cancellation WILL NOT be"
^DIC(19,645,1,4,0)="moved back to their original time slots."
^DIC(19,645,15)="D SDUNC^SDKILL"
^DIC(19,645,25)="SDUNC"
^DIC(19,645,"U")="RESTORE CLINIC AVAILABILITY"
^DIC(19,648,0)="SDCONVERTTO3060^Change Patterns to 30-60^^R^.5^^^^^^^16^^^1"
^DIC(19,648,1,0)="^^2^2^2850415^^^"
^DIC(19,648,1,1,0)="Allows the changing of patterns which had been created with 15 "
^DIC(19,648,1,2,0)="minute increments to the 30 or 60 minute time slot pattern."
^DIC(19,648,15)="D SDSCE^SDKILL"
^DIC(19,648,25)="SDSCE"
^DIC(19,648,"U")="CHANGE PATTERNS TO 30-60"
^DIC(19,651,0)="SDMULTIBOOK^Multiple Appointment Booking^^R^.5^^^^^^^16^^1^1"
^DIC(19,651,1,0)="^^2^2^2970721^^^^"
^DIC(19,651,1,1,0)="This option allows the making of multiple appointments, on a daily or"
^DIC(19,651,1,2,0)="weekly basis, for a patient."
^DIC(19,651,15)="D HDLKILL^SDAMEVT"
^DIC(19,651,20)="D HDLKILL^SDAMEVT"
^DIC(19,651,25)="SDMM"
^DIC(19,651,99)="55739,43111"
^DIC(19,651,"U")="MULTIPLE APPOINTMENT BOOKING"
^DIC(19,652,0)="SDCLINIC ASSIGNMENT^Clinic Assignment Listing^^R^.5^^^^^^^16"
^DIC(19,652,1,0)="^^6^6^2850415^"
^DIC(19,652,1,1,0)="The Clinic Assignment Listing is used to monitor the size and composition"
^DIC(19,652,1,2,0)="of clinics.  It provides patient specific information including the name"
^DIC(19,652,1,3,0)="of the patient, SSN, Eligibility Status, Date of enrollment, last visit,"
^DIC(19,652,1,4,0)="future appointment, etc.  It is designed to be used as a management tool"
^DIC(19,652,1,5,0)="which, if monitored, over time one can see relative trends, e.g., growth,"
^DIC(19,652,1,6,0)="shrinkage, etc."
^DIC(19,652,25)="SDCLAS"
^DIC(19,652,"U")="CLINIC ASSIGNMENT LISTING"
^DIC(19,653,0)="SDCLINIC WORKLOAD^Workload Report^^R^.5^^^^^^^16"
^DIC(19,653,1,0)="^^4^4^2880608^^^^"
^DIC(19,653,1,1,0)="Displays the daily patient appointment transactions.  Allows one to determine"
^DIC(19,653,1,2,0)="the relative activity within a clinic during specified periods."
^DIC(19,653,1,3,0)="It also allows you to compare a period of time to the same period of time"
^DIC(19,653,1,4,0)="for the same selected clinics in the previous year."
^DIC(19,653,25)="SDCWL"
^DIC(19,653,99)="55656,56249"
^DIC(19,653,"U")="WORKLOAD REPORT"
^DIC(19,654,0)="SD INACTIVATE^Inactivate a clinic^^R^.5^^^^^^^16^^^1"
^DIC(19,654,1,0)="^^2^2^2920122^^"
^DIC(19,654,1,1,0)="This option is used to render a clinic inactive (no activity allowed) as of"
^DIC(19,654,1,2,0)="the selected date."
^DIC(19,654,15)="D SDINACT^SDKILL"
^DIC(19,654,25)="SDNACT"
^DIC(19,654,"U")="INACTIVATE A CLINIC"
^DIC(19,655,0)="SD REACT^Reactivate a Clinic^^R^.5^^^^^^^16^^^1"
^DIC(19,655,1,0)="^^2^2^2920122^^"
^DIC(19,655,1,1,0)="This option is used to set the date from which point the inactivation of a"
^DIC(19,655,1,2,0)="clinic is terminated."
^DIC(19,655,15)="D SDREACT^SDKILL"
^DIC(19,655,25)="SDREACT"
^DIC(19,655,"U")="REACTIVATE A CLINIC"
^DIC(19,656,0)="SDHOLIDAY^Add/Edit a Holiday^^R^.5^^^^^^^16^^^1"
^DIC(19,656,1,0)="^^1^1^2920122^^"
^DIC(19,656,1,1,0)="This option is used to add or edit a holiday in the Holiday global"
^DIC(19,656,15)="K %,%DT,%Y,C,D0,DA,DI,DIC,DIE,DIK,DR,X,Y,Z"
^DIC(19,656,25)="SDHOL"
^DIC(19,656,"U")="ADD/EDIT A HOLIDAY"
^DIC(19,660,0)="SDREVIEWDATE^Enrollment Review Date Entry^^R^.5^^^^^^^16^^^1"
^DIC(19,660,1,0)="^^4^4^2860910^^^^"
^DIC(19,660,1,1,0)="THIS OPTION ALLOWS YOU TO ENTER A DATE WHEN AN NSC/OPT CLINIC ENROLLMENT"
^DIC(19,660,1,2,0)="HAS BEEN REVIEWED.  THE EXISTENCE OF THIS DATE WILL PREVENT THE WARNING"
^DIC(19,660,1,3,0)="FROM PRINTING ON THE APPOINTMENT LIST FOR A PERIOD OF 1 YEAR FROM THE"
^DIC(19,660,1,4,0)="REVIEW DATE ENTERED."
^DIC(19,660,15)="K DIC,X,Y,Z,%DT,DGA1,DGT,DGX,D0,D1,DQ"
^DIC(19,660,25)="SDREV"
^DIC(19,660,"U")="ENROLLMENT REVIEW DATE ENTRY"
^DIC(19,663,0)="SDNEXT^Find Next Available Appointment^^R^11289^^^^^^^16^^^1"
^DIC(19,663,1,0)="^^6^6^2950425^^^^"
^DIC(19,663,1,1,0)="This option finds the day having the next available clinic slot for a"
^DIC(19,663,1,2,0)="selected clinic.  The search starts from a user-selected date and ends with"
^DIC(19,663,1,3,0)="the date calculated by the maximum # of days for future booking parameter."
^DIC(19,663,1,4,0)="Variable length clinics allow you to choose the length of the appointment to"
^DIC(19,663,1,5,0)="search for and there must be enough consecutive slots available to cover"
^DIC(19,663,1,6,0)="this appt length before a day is selected."
^DIC(19,663,15)="K FND,J,POP,SDAPP,SDNEXT"
^DIC(19,663,25)="NEW^SDNEXT"
^DIC(19,663,"U")="FIND NEXT AVAILABLE APPOINTMEN"
^DIC(19,664,0)="SDMULTICLINIC^Multiple Clinic Display/Book^^R^.5^^^^^^^16^^1^1"
^DIC(19,664,1,0)="^^3^3^2860630^"
^DIC(19,664,1,1,0)="Allows you to display or book appts into 2-4 clinics on the same day.  It"
^DIC(19,664,1,2,0)="automaticlly finds the day where all chosen clinics have the necessary"
^DIC(19,664,1,3,0)="availability."
^DIC(19,664,15)="D SDMULT^SDKILL,HDLKILL^SDAMEVT"
^DIC(19,664,20)="D HDLKILL^SDAMEVT"
^DIC(19,664,25)="SDMULT"
^DIC(19,664,99)="55739,43473"
^DIC(19,664,"U")="MULTIPLE CLINIC DISPLAY/BOOK"
^DIC(19,665,0)="SDAMISVER^Verify Integrity of OPC Tape^^R^.5^^^"
^DIC(19,665,1,0)="^^1^1^2880526^^^"
^DIC(19,665,1,1,0)="Reads and dumps the OPC tape"
^DIC(19,665,25)="SDTRAN2"
^DIC(19,665,"U")="VERIFY INTEGRITY OF OPC TAPE"
^DIC(19,666,0)="SDENRGREATERTHANX^Enrollments > X Days^^R^.5^^^^^^^16^^^1"
^DIC(19,666,1,0)="^^2^2^2860903^"
^DIC(19,666,1,1,0)="This option prints a report of patients enrolled in any clinics greater"
^DIC(19,666,1,2,0)="than a user specified number of days"
^DIC(19,666,15)="K %,%H,%T,ALL,D,DIV,POP,SDCL,SDEF,VAL,X,Y,Z"
^DIC(19,666,25)="SDST"
^DIC(19,666,"U")="ENROLLMENTS > X DAYS"
^DIC(19,675,0)="SDENROLL^Edit Clinic Enrollment Data^^R^.5^^^^^^^16^^^1"
^DIC(19,675,1,0)="^^1^1^2870505^^"
^DIC(19,675,1,1,0)="Allows the user to edit clinic enrollment data for a selected patient."
^DIC(19,675,15)="D SDENROLL^SDKILL"
^DIC(19,675,25)="19^SDAPP"
^DIC(19,675,"U")="EDIT CLINIC ENROLLMENT DATA"
^DIC(19,679,0)="SDAPP INPT^Inpatient Appointment List^^R^.5^^^^^^^16^^^1"
^DIC(19,679,1,0)="^^5^5^2910508^"
^DIC(19,679,1,1,0)="This option is used to produce a list of inpatients with"
^DIC(19,679,1,2,0)="appointments scheduled at one of the facility's clinics."
^DIC(19,679,1,3,0)="The report is produced for the date range of your choice."
^DIC(19,679,1,4,0)="It may be produced to list inpatients in one particular Ward,"
^DIC(19,679,1,5,0)="or for all of the Wards by entering 'ALL'."
^DIC(19,679,10,0)="^19.01IP^0^0"
^DIC(19,679,15)="D SDIAL^SDKILL"
^DIC(19,679,25)="SDCIAL"
^DIC(19,679,"U")="INPATIENT APPOINTMENT LIST"
^DIC(19,681,0)="SD SDCLK^Look up on Clerk Who Made Appointment^^R^.5^^^^^^^16"
^DIC(19,681,1,0)="^^2^2^2920122^^"
^DIC(19,681,1,1,0)="This option displays the name of the clerk who made an appointment,"
^DIC(19,681,1,2,0)="and gives cancellation information and appointment status."
^DIC(19,681,25)="SDCLK"
^DIC(19,681,"U")="LOOK UP ON CLERK WHO MADE APPO"
^DIC(19,687,0)="PSJU MGR^Unit Dose Medications^^M^1^^^^^^^117^^1^1"
^DIC(19,687,1,0)="^19.06^2^2^3120622^^^^"
^DIC(19,687,1,1,0)="  This is the main menu for the Unit Dose Medications software.  This menu"
^DIC(19,687,1,2,0)="must be given to all Unit Dose Medications users."
^DIC(19,687,10,0)="^19.01PI^42^42"
