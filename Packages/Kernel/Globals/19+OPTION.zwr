^DIC(19,8020,1,0)="^^2^2^2930823^"
^DIC(19,8020,1,1,0)="This option is used to enter the reason for not billing special inpatient"
^DIC(19,8020,1,2,0)="billing cases."
^DIC(19,8020,25)="DISP^IBAMTI1"
^DIC(19,8020,"U")="DISPOSITION SPECIAL INPATIENT "
