^DIC(19,11522,10,"C","ST",1)=""
^DIC(19,11522,10.1)="Display last run date/time."
^DIC(19,11522,99)="58160,56567"
^DIC(19,11522,"U")="ORMTIME MAIN MENU"
^DIC(19,11523,0)="ORMTIME STATUS^ORMTIME status of last run^^R^983^^^^^^^"
^DIC(19,11523,1,0)="^^1^1^2991201^^"
^DIC(19,11523,1,1,0)="Status display of last time ORMTIME scheduled option was run."
^DIC(19,11523,25)="STATUS^ORMTIME"
^DIC(19,11523,"U")="ORMTIME STATUS OF LAST RUN"
^DIC(19,11524,0)="ORMTIME RUN^ORMTIME Run^^R^983^^^^^^^"
^DIC(19,11524,1,0)="^^3^3^2991130^^^"
^DIC(19,11524,1,1,0)="Option calls EN^ORMTIME to run the ORMTIME processing.  This option does"
^DIC(19,11524,1,2,0)="not appear on any menu but is designed to be called through an entry in"
^DIC(19,11524,1,3,0)="the OPTION SCHEDULING file which effectively tasks it."
^DIC(19,11524,25)="EN^ORMTIME"
^DIC(19,11524,"U")="ORMTIME RUN"
^DIC(19,11525,0)="ORMTIME RUN CHECK^ORMTIME Run Check^^R^983^^^^^^^"
^DIC(19,11525,1,0)="^^4^4^3000201^^"
^DIC(19,11525,1,1,0)="This option calls BULL^ORMTIME in order to function as a backup in"
^DIC(19,11525,1,2,0)="verifying that the ORMTIME process has run within the past 24 hours.  "
^DIC(19,11525,1,3,0)="It does not appear on any menu, and is intended for use in the "
^DIC(19,11525,1,4,0)="OPTION SCHEDULING file, effectively tasking it.  "
^DIC(19,11525,25)="BULL^ORMTIME"
^DIC(19,11525,"U")="ORMTIME RUN CHECK"
^DIC(19,11526,0)="GMRC TERMINATE CLEANUP^User Terminate Cleanup^^A^983^^^^^^^294^^1"
^DIC(19,11526,1,0)="^^4^4^2991118^^^"
^DIC(19,11526,1,1,0)="Option calls EN^GMRCTU which responds to Kernel's XU USER TERMINATE"
^DIC(19,11526,1,2,0)="option to remove pointers to a terminated user from file(s) as specified"
^DIC(19,11526,1,3,0)="in the text section at the end of the routine's code.  XU USER TERMINATE's"
^DIC(19,11526,1,4,0)="variable XUIFN is used to determine the user's identity."
^DIC(19,11526,20)="D EN^GMRCTU"
^DIC(19,11526,"U")="USER TERMINATE CLEANUP"
^DIC(19,11527,0)="GMRC TEST DEFAULT REASON^Test Default Reason for Request^^R^11740^^^^^^^294"
^DIC(19,11527,1,0)="^^8^8^3001020^"
^DIC(19,11527,1,1,0)="This option will allow the Clinical Coordinator or IRM to test the default"
^DIC(19,11527,1,2,0)="reason for request for a given service or procedure without placing an"
^DIC(19,11527,1,3,0)="order."
^DIC(19,11527,1,4,0)=" "
^DIC(19,11527,1,5,0)="This option prompts for the selection of a procedure or a service from the"
^DIC(19,11527,1,6,0)="consult hierarchy and a patient name. The default reason will be presented"
^DIC(19,11527,1,7,0)="based on the selected patient in a list manager format. This format allows"
^DIC(19,11527,1,8,0)="searching, printing etc. "
^DIC(19,11527,25)="EN^GMRCDRFR"
^DIC(19,11527,"U")="TEST DEFAULT REASON FOR REQUES"
