^DIC(19,2325,0)="PSGW UPDATE AMIS STATS^Update AMIS Stats File^^R^.5^^^^^^^"
^DIC(19,2325,1,0)="^^4^4^2940914^^^^"
^DIC(19,2325,1,1,0)="This option is a background job scheduled to run each night.  The purpose"
^DIC(19,2325,1,2,0)="of the option is to loop through the ""temporary"" inventory global and move "
^DIC(19,2325,1,3,0)="the data into the AMIS sub-file. The rescheduling frequency for this "
^DIC(19,2325,1,4,0)="option is one day."
^DIC(19,2325,25)="PSGWUAS"
^DIC(19,2325,200.9)="y"
^DIC(19,2325,"U")="UPDATE AMIS STATS FILE"
^DIC(19,2326,0)="PSGW MGT REPORTS^Management Reports^^M^.5^^^^^^^"
^DIC(19,2326,1,0)="^^2^2^2930817^^^^"
^DIC(19,2326,1,1,0)="This menu gives access to various management reports, including the"
