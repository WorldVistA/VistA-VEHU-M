^DIC(19,15482,0)="EHM-00303^Immunization Default Responses Enter/Edit^^R^1^^^^^^^^^^^"
^DIC(19,15482,1,0)="^^3^3^3240328^"
^DIC(19,15482,1,1,0)="This option allows the user to enter or update information in the IMM"
^DIC(19,15482,1,2,0)="DEFAULT RESPONSES file (#920.05)."
