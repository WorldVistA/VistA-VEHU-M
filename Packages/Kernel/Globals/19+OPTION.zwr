^DIC(19,8989,0)="XUTM BACKGROUND PRINT^Print Options that are Scheduled to run^^P^1039^^^^^^^^^"
^DIC(19,8989,1,0)="^^6^6^2940422^^"
^DIC(19,8989,1,1,0)="This option prints a list of options from the option schedule file that"
^DIC(19,8989,1,2,0)="have data in one of the background task fields:"
^DIC(19,8989,1,3,0)=" 1. Queued to run at what time."
^DIC(19,8989,1,4,0)=" 2. Device for queued job output."
^DIC(19,8989,1,5,0)=" 3. Rescheduling frequency"
^DIC(19,8989,1,6,0)=" 4. Special queueing"
^DIC(19,8989,60)="DIC(19.2,"
^DIC(19,8989,62)=0
^DIC(19,8989,63)="[XQ-BACKGROUND SCHEDULE]"
