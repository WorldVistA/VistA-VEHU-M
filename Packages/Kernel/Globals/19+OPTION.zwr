^DIC(19,1569,"U")="PATIENT PROFILE MENU"
^DIC(19,1570,0)="RA AMIS^AMIS Report^^R^11712^^^^^^^"
^DIC(19,1570,1,0)="^^4^4^2940606^"
^DIC(19,1570,1,1,0)="This option allows the supervisor to generate an AMIS report"
^DIC(19,1570,1,2,0)="based on examinations performed within a specified date range. The report"
^DIC(19,1570,1,3,0)="contains the AMIS category number and name, weighted work unit statistics"
^DIC(19,1570,1,4,0)="and film usage."
^DIC(19,1570,25)="RAMIS"
^DIC(19,1570,"U")="AMIS REPORT"
^DIC(19,1571,0)="RA FLASH^Duplicate Flash Card^^R^11712^^^^^^^^^1^1"
^DIC(19,1571,1,0)="^^7^7^2940606^^^^"
^DIC(19,1571,1,1,0)="This function allows the user to print additional flash cards"
^DIC(19,1571,1,2,0)="or exam labels for a previous exam.  The user can duplicate "
^DIC(19,1571,1,3,0)="between 0 and 20 additional flash cards or exam labels."
^DIC(19,1571,1,4,0)="  "
^DIC(19,1571,1,5,0)="This function is often used because of a printer malfunction"
^DIC(19,1571,1,6,0)="occurring during the original printing of the flash card or exam"
^DIC(19,1571,1,7,0)="label."
^DIC(19,1571,15)="K RADUPSCN"
^DIC(19,1571,20)="S RADUPSCN="""""
^DIC(19,1571,25)="DUP^RAEDCN"
^DIC(19,1571,"U")="DUPLICATE FLASH CARD"
^DIC(19,1572,0)="RA LABELS^Jacket Labels^^R^11712^^^^^^^"
^DIC(19,1572,1,0)="^^3^3^2940606^^^^"
^DIC(19,1572,1,1,0)="This function allows the user to print jacket labels for a "
^DIC(19,1572,1,2,0)="patient's film jacket.  The user can retrieve between 0 and 20"
^DIC(19,1572,1,3,0)="additional jacket labels."
^DIC(19,1572,25)="DUP^RAJAC"
^DIC(19,1572,"U")="JACKET LABELS"
^DIC(19,1573,0)="RA LOG^Daily Log Report^^R^11712^^^^^^y^"
^DIC(19,1573,1,0)="^^2^2^2940606^^"
^DIC(19,1573,1,1,0)="This option generates an informational report for all examination activity"
^DIC(19,1573,1,2,0)="on a particular date."
^DIC(19,1573,25)="RADLY"
^DIC(19,1573,"U")="DAILY LOG REPORT"
^DIC(19,1574,0)="RA FILMUSE^Film Usage Report^^R^11712^^^^^^y^"
^DIC(19,1574,1,0)="^^16^16^2940901^"
^DIC(19,1574,1,1,0)="This option allows the supervisor to generate a report of film usage. The"
^DIC(19,1574,1,2,0)="supervisor is prompted to generate a 'detailed' or 'summary' report. If"
^DIC(19,1574,1,3,0)="the supervisor has access to more than one division or imaging type,"
^DIC(19,1574,1,4,0)="s/he is prompted to select the divisions and imaging types to include in"
^DIC(19,1574,1,5,0)="the report. The supervisor is prompted to select the film sizes to include"
^DIC(19,1574,1,6,0)="in the report. The supervisor may select one, many or all film sizes. The"
^DIC(19,1574,1,7,0)="supervisor is prompted to enter a date range for the exams to be included"
^DIC(19,1574,1,8,0)="in the report. The exam status values that will be included in the report"
^DIC(19,1574,1,9,0)="will be displayed by imaging type."
^DIC(19,1574,1,10,0)=" "
^DIC(19,1574,1,11,0)="The report is displayed by division, imaging type within the division, and"
^DIC(19,1574,1,12,0)="then by film size within the imaging type. The film size, number of films"
^DIC(19,1574,1,13,0)="used, the ratio of films per exam and a percentage of films used are"
^DIC(19,1574,1,14,0)="displayed. A 'summary' report groups all examinations together by film"
^DIC(19,1574,1,15,0)="size for each imaging type and division. A 'detailed' report gives"
^DIC(19,1574,1,16,0)="information for each individual procedure performed within the film size."
^DIC(19,1574,25)="RAFLM"
^DIC(19,1574,"U")="FILM USAGE REPORT"
^DIC(19,1575,0)="RA OUTSIDERPT^Delinquent Outside Film Report for Outpatients^^R^11712^^^^^^^"
^DIC(19,1575,1,0)="^^11^11^2940606^^"
^DIC(19,1575,1,1,0)="This function allows the user to obtain a report of all the patients"
^DIC(19,1575,1,2,0)="who have outside films registered that have a 'Needed Back' date"
^DIC(19,1575,1,3,0)="less than the date the user specifies."
^DIC(19,1575,1,4,0)=" "
^DIC(19,1575,1,5,0)="This function assists the file room with the return of outside"
^DIC(19,1575,1,6,0)="films to other hospitals and institutions."
^DIC(19,1575,1,7,0)=" "
^DIC(19,1575,1,8,0)="Outside films for inpatients are not shown on this report"
^DIC(19,1575,1,9,0)="because it is assumed that the department would not"
^DIC(19,1575,1,10,0)="want to send back films for patients still receiving care at the"
^DIC(19,1575,1,11,0)="facility."
^DIC(19,1575,25)="4^RAOUT"
^DIC(19,1575,"U")="DELINQUENT OUTSIDE FILM REPORT"
^DIC(19,1576,0)="RA COMPLICATION^Complication Report^^R^11712^^^^^^y^"
^DIC(19,1576,1,0)="^^3^3^2940606^^"
^DIC(19,1576,1,1,0)="This option allows the supervisor to generate a listing of patient"
^DIC(19,1576,1,2,0)="examinations in which complications occurred. The listing is generated for"
^DIC(19,1576,1,3,0)="a selected date range."
^DIC(19,1576,25)="RACMP"
^DIC(19,1576,"U")="COMPLICATION REPORT"
^DIC(19,1577,0)="RA SYSDIV^Division Parameter Set-up^^R^11712^^^^^^^"
^DIC(19,1577,1,0)="^^17^17^2940606^"
^DIC(19,1577,1,1,0)="The 'Division Parameter Set-Up' function allows the"
^DIC(19,1577,1,2,0)="coordinator to define division parameters."
^DIC(19,1577,1,3,0)=" "
^DIC(19,1577,1,4,0)="The module is designed to handle multiple divisions"
^DIC(19,1577,1,5,0)="within a medical center.  While most medical centers have only"
^DIC(19,1577,1,6,0)="one division, there are a number that are multi-divisional.  As"
^DIC(19,1577,1,7,0)="a result, it was necessary to structure the entire system around"
^DIC(19,1577,1,8,0)="the division concept."
^DIC(19,1577,1,9,0)=" "
^DIC(19,1577,1,10,0)="However, single division medical centers will not notice this"
^DIC(19,1577,1,11,0)="in the everyday execution of the module.  Only in the initial set-up"
^DIC(19,1577,1,12,0)="will there be any reference to 'division' for these single division"
^DIC(19,1577,1,13,0)="sites."
^DIC(19,1577,1,14,0)=" "
^DIC(19,1577,1,15,0)="Each division will have its own set of parameters defining such"
^DIC(19,1577,1,16,0)="division-wide criteria as, should the exam 'requested date' be asked"
^DIC(19,1577,1,17,0)="and are impressions required on reports."
^DIC(19,1577,25)="1^RASYS"
^DIC(19,1577,"U")="DIVISION PARAMETER SET-UP"
^DIC(19,1578,0)="RA PNLCLASS^Classification Enter/Edit^^R^11712^^^^^^^"
^DIC(19,1578,1,0)="^^10^10^2940606^^"
^DIC(19,1578,1,1,0)="This function allows the coordinator to enter/edit"
^DIC(19,1578,1,2,0)="personnel and their corresponding classifications."
^DIC(19,1578,1,3,0)=" "
^DIC(19,1578,1,4,0)="There are currently four classifications the personnel can be"
^DIC(19,1578,1,5,0)="placed under. They are as follows:"
^DIC(19,1578,1,6,0)=" "
^DIC(19,1578,1,7,0)="      1) Technologist"
^DIC(19,1578,1,8,0)="      2) Interpreting Resident"
^DIC(19,1578,1,9,0)="      3) Interpreting Staff"
^DIC(19,1578,1,10,0)="      4) Clerk"
^DIC(19,1578,25)="1^RAPNL"
^DIC(19,1578,"U")="CLASSIFICATION ENTER/EDIT"
^DIC(19,1579,0)="RA FILMEDIT^Film Type Entry/Edit^^R^11712^^^^^^^"
^DIC(19,1579,1,0)="^^6^6^2940606^"
^DIC(19,1579,1,1,0)="This function allows the coordinator to edit existing"
^DIC(19,1579,1,2,0)="film types and enter new film types."
^DIC(19,1579,1,3,0)=" "
^DIC(19,1579,1,4,0)="These film types will be the allowable choices the technologist can"
^DIC(19,1579,1,5,0)="choose from during the 'Status Tracking of Exams' and 'Case No. Exam Edit'"
^DIC(19,1579,1,6,0)="functions to indicate what films were used during a procedure."
^DIC(19,1579,25)="4^RAMAIN"
^DIC(19,1579,"U")="FILM TYPE ENTRY/EDIT"
^DIC(19,1580,0)="RA PROCEDURE^Procedure Enter/Edit^^R^1^^^^^^y^31^^^"
^DIC(19,1580,1,0)="^19.06^46^46^3240124^^^^"
^DIC(19,1580,1,1,0)="This function allows the package coordinator to enter new"
^DIC(19,1580,1,2,0)="procedures into the system and to edit existing procedures."
^DIC(19,1580,1,3,0)=" "
^DIC(19,1580,1,4,0)="Entries in this 'procedure' file are the allowable choices the"
^DIC(19,1580,1,5,0)="user will be able to choose from at the 'Procedure' prompt."
^DIC(19,1580,1,6,0)="This prompt appears as part of the 'Request an Exam', 'Register' exam,"
^DIC(19,1580,1,7,0)="'Case No. Edit', and the 'Exam Status Tracking' functions."
^DIC(19,1580,1,8,0)=" "
^DIC(19,1580,1,9,0)="If the procedure has an inactivation date of less than the current"
^DIC(19,1580,1,10,0)="date then the procedure is not a valid choice and will not appear"
^DIC(19,1580,1,11,0)="on the list of valid/active procedures when displayed to the user."
^DIC(19,1580,1,12,0)=" "
^DIC(19,1580,1,13,0)="There are four types of procedures.  They are the following:"
^DIC(19,1580,1,14,0)=" "
^DIC(19,1580,1,15,0)="      1) Detailed - Procedure is associated with one or more AMIS codes"
^DIC(19,1580,1,16,0)="                    and must have a CPT (Current Procedural Terminology)"
^DIC(19,1580,1,17,0)="                    code assigned to it."
^DIC(19,1580,1,18,0)=" "
^DIC(19,1580,1,19,0)="      2) Series   - Procedure is associated with more than one AMIS"
^DIC(19,1580,1,20,0)="                    code and must have a CPT code assigned to it."
^DIC(19,1580,1,21,0)=" "
^DIC(19,1580,1,22,0)="      3) Broad    - Procedure is mainly used by the receptionist when"
^DIC(19,1580,1,23,0)="                    scheduling a patient for an exam.  It is used"
^DIC(19,1580,1,24,0)="                    when he/she is not exactly sure which 'detailed' or"
^DIC(19,1580,1,25,0)="                    'series' procedure will be performed. However,"
^DIC(19,1580,1,26,0)="                    before the exam can be considered 'complete', the"
^DIC(19,1580,1,27,0)="                    procedure must be changed to 'detailed' or 'series'."
^DIC(19,1580,1,28,0)=" "
^DIC(19,1580,1,29,0)="                    If the 'division' parameter requiring a 'detailed'"
^DIC(19,1580,1,30,0)="                    or 'series' procedure upon initial exam registration"
^DIC(19,1580,1,31,0)="                    is set to 'yes', then the receptionist will not be"
^DIC(19,1580,1,32,0)="                    allowed to select a 'broad' procedure."
^DIC(19,1580,1,33,0)=" "
^DIC(19,1580,1,34,0)="       4) Parent  - Procedure is a ""placeholder"" used for ordering.  It"
^DIC(19,1580,1,35,0)="                    does not have a CPT and cannot be registered.  Parent"
^DIC(19,1580,1,36,0)="                    procedures must have one or more descendant procedures"
^DIC(19,1580,1,37,0)="                    associated with them.  The descendants should be"
^DIC(19,1580,1,38,0)="                    detailed procedures with valid CPT codes.  During"
^DIC(19,1580,1,39,0)="                    Registration, the system automatically cycles through"
^DIC(19,1580,1,40,0)="                    each descendant and asks if you want to register it."
^DIC(19,1580,1,41,0)="                    After each descendant is either registered or"
^DIC(19,1580,1,42,0)="                    bypassed, the opportunity to add additional procedures"
^DIC(19,1580,1,43,0)="                    is given.  All are registered under the same exam"
^DIC(19,1580,1,44,0)="                    date/time.  Parent procedures can be set up to require"
^DIC(19,1580,1,45,0)="                    a single report for all CPT's, or individual reports"
^DIC(19,1580,1,46,0)="                    for each CPT."
^DIC(19,1580,15)=""
^DIC(19,1580,20)=""
^DIC(19,1580,25)="2^RAMAIN2"
^DIC(19,1580,99.1)="57013,51400"
^DIC(19,1580,"U")="PROCEDURE ENTER/EDIT"
^DIC(19,1581,0)="RA PROFQUICK^Profile of Rad/Nuc Med Exams^^R^11740^^^^^^^^^1^1"
^DIC(19,1581,1,0)="^19.06^4^4^3000615^^^^"
^DIC(19,1581,1,1,0)="This function allows the user to see a list of the patient's"
^DIC(19,1581,1,2,0)="registered exams.  The exams are presented in reverse chronological"
^DIC(19,1581,1,3,0)="order.  A specific exam can be selected from the list.  When an "
^DIC(19,1581,1,4,0)="exam is selected, a very detailed display of the exam is presented."
^DIC(19,1581,15)="K RANOSCRN,RATECHCO"
^DIC(19,1581,20)="S (RANOSCRN,RATECHCO)="""""
^DIC(19,1581,25)="RAPROQ"
^DIC(19,1581,99.1)="58371,27483"
^DIC(19,1581,"U")="PROFILE OF RAD/NUC MED EXAMS"
^DIC(19,1582,0)="RA WORKSHEETS^Print Worksheets^^R^11712^^^^^^^"
^DIC(19,1582,1,0)="^^13^13^2940606^^"
^DIC(19,1582,1,1,0)="This function allows the user to print any number of"
^DIC(19,1582,1,2,0)="worksheets needed."
^DIC(19,1582,1,3,0)=" "
^DIC(19,1582,1,4,0)="These worksheets are designed to be used by an imaging department"
^DIC(19,1582,1,5,0)="that does not have enough CRT's to capture exam status in a"
^DIC(19,1582,1,6,0)="real-time mode."
^DIC(19,1582,1,7,0)=" "
^DIC(19,1582,1,8,0)="These worksheets should accompany the exam requisition as it proceeds"
^DIC(19,1582,1,9,0)="through the department.  As the exam status changes, the"
^DIC(19,1582,1,10,0)="appropriate entries on the worksheet should be made."
^DIC(19,1582,1,11,0)=" "
^DIC(19,1582,1,12,0)="The data captured on the sheets should then be entered in a batch"
^DIC(19,1582,1,13,0)="mode later in the day, when CRT's are available."
^DIC(19,1582,25)="RAWORK"
^DIC(19,1582,"U")="PRINT WORKSHEETS"
^DIC(19,1583,0)="RA MAINTENANCE^Utility Files Maintenance Menu^^M^11712^^^^^^^"
^DIC(19,1583,1,0)="^^10^10^2970702^^^"
^DIC(19,1583,1,1,0)="The 'Utility Files Maintenance Menu' provides the"
^DIC(19,1583,1,2,0)="coordinator with many functions to enter/edit package utility"
^DIC(19,1583,1,3,0)="files.  All of the files are 'day-one' files. That is, these files"
^DIC(19,1583,1,4,0)="need to be initialized before the module is placed in a"
^DIC(19,1583,1,5,0)="production mode."
^DIC(19,1583,1,6,0)=" "
^DIC(19,1583,1,7,0)="When the system is first loaded, many of these files"
^DIC(19,1583,1,8,0)="will have data.  However, the coordinator must review this data to"
^DIC(19,1583,1,9,0)="insure that the data meets his/her site's needs and to modify or add"
^DIC(19,1583,1,10,0)="file entries accordingly."
^DIC(19,1583,10,0)="^19.01PI^20^20"
^DIC(19,1583,10,3,0)="1584^"
^DIC(19,1583,10,4,0)="1579^"
^DIC(19,1583,10,5,0)="1585^"
^DIC(19,1583,10,6,0)="1586^"
^DIC(19,1583,10,7,0)="1587^"
^DIC(19,1583,10,9,0)="1598^"
^DIC(19,1583,10,10,0)="1615^"
^DIC(19,1583,10,11,0)="1662^"
^DIC(19,1583,10,13,0)="3309^"
^DIC(19,1583,10,15,0)="6299^"
^DIC(19,1583,10,16,0)=9226
^DIC(19,1583,10,18,0)=10763
^DIC(19,1583,10,19,0)=10772
^DIC(19,1583,10,20,0)=14818
^DIC(19,1583,10,"B",1579,4)=""
^DIC(19,1583,10,"B",1584,3)=""
^DIC(19,1583,10,"B",1585,5)=""
^DIC(19,1583,10,"B",1586,6)=""
^DIC(19,1583,10,"B",1587,7)=""
^DIC(19,1583,10,"B",1598,9)=""
^DIC(19,1583,10,"B",1615,10)=""
^DIC(19,1583,10,"B",1662,11)=""
^DIC(19,1583,10,"B",3309,13)=""
^DIC(19,1583,10,"B",6299,15)=""
^DIC(19,1583,10,"B",9226,16)=""
