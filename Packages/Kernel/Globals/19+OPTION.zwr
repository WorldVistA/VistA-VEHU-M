^DIC(19,9820,0)="GMRA PRINT ALLERGIES LIST^Allergies File List^^P^11595^^^^^^^"
^DIC(19,9820,1,0)="^^8^8^2960201^^"
^DIC(19,9820,1,1,0)="This option prints a captioned list of all entries in the GMR Allergies"
^DIC(19,9820,1,2,0)="file (#120.82). The list is sorted alphabetically by NAME. The user may"
^DIC(19,9820,1,3,0)="list all entries by accepting the default answer (FIRST) to the 'sort by'"
^DIC(19,9820,1,4,0)="prompt or may select a subset to print. The list contains the allergy"
^DIC(19,9820,1,5,0)="name; type; whether it is a nationally distributed entry; synonyms, if"
^DIC(19,9820,1,6,0)="any; VA Drug Class, if applicable; and drug ingredients, if applicable."
^DIC(19,9820,1,7,0)="This option is meant to be a helpful tool for the ADPAC to maintain the"
^DIC(19,9820,1,8,0)="GMR Allergies file."
