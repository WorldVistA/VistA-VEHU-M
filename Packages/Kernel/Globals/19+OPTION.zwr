^DIC(19,13640,10,"C","ED",1)=""
^DIC(19,13640,10,"C","TR",3)=""
^DIC(19,13640,99)="62195,28623"
^DIC(19,13640,"U")="NEW ENROLLEE APPOINTMENT REQUE"
^DIC(19,13641,0)="DGEN NEACL MGT RPT1^Call List^^R^1^^^^^^^114"
^DIC(19,13641,1,0)="^19.06^3^3^3130717^^^"
^DIC(19,13641,1,1,0)="Call List report - lists veterans from the Appointment Requested cross"
^DIC(19,13641,1,2,0)="reference with no scheduled appointment.  This list be used to assist in"
^DIC(19,13641,1,3,0)="the scheduling of an appointment for new enrollees."
^DIC(19,13641,25)="REPORT^DGENACL(1)"
^DIC(19,13641,"U")="CALL LIST"
^DIC(19,13642,0)="DGEN NEACL MGT RPT2^Tracking Report^^R^1^^^^^^^114"
^DIC(19,13642,1,0)="^19.06^2^2^3080326^^"
^DIC(19,13642,1,1,0)="This report shows times between enrollment date of veteran requesting an"
^DIC(19,13642,1,2,0)="appointment on the 1010EZ and the date appointment was actually made."
^DIC(19,13642,25)="REPORT^DGENACL(2)"
^DIC(19,13642,"U")="TRACKING REPORT"
^DIC(19,13643,0)="DGEN NEACL MGT RPT1BK^Call List (background job)^^A^1^^^^^^^114^^1"
^DIC(19,13643,1,0)="^19.06^5^5^3080326^^"
^DIC(19,13643,1,1,0)="Background Call List report - lists veterans from the Appointment"
^DIC(19,13643,1,2,0)="Requested cross reference with no scheduled appointment.  This list be"
^DIC(19,13643,1,3,0)="used to assist in the scheduling of an appointment for new enrollees."
^DIC(19,13643,1,4,0)=" "
^DIC(19,13643,1,5,0)="This option should be queued and scheduled to run daily to a printer."
^DIC(19,13643,20)="D BCKJOB^DGENACL(1)"
^DIC(19,13643,200.9)="y"
^DIC(19,13643,"U")="CALL LIST (BACKGROUND JOB)"
^DIC(19,13644,0)="DGEN RD UPLOAD AUDIT PURGE^Enrollment Rated Disability Upload Audit Purge^^R^1^^^^^^^"
^DIC(19,13644,1,0)="^19.06^2^2^3071025^^"
^DIC(19,13644,1,1,0)="This option will purge all entries in ENROLLMENT RATED DISABILITY UPLOAD "
^DIC(19,13644,1,2,0)="AUDIT file (#390) that are over 365 days old."
^DIC(19,13644,25)="PURGE^DGENRDUA"
^DIC(19,13644,200.9)="y"
^DIC(19,13644,"U")="ENROLLMENT RATED DISABILITY UP"
^DIC(19,13645,0)="RCDMC EDIT RD # OF DAYS PARAME^Enter/Edit RD Number of Days Report Parameter^^R^1^^^^^^^"
^DIC(19,13645,1,0)="^19.06^5^5^3071022^^"
^DIC(19,13645,1,1,0)="This option allows users to enter/edit the ""# OF DAYS FOR RD ELIG CHG RPT"""
^DIC(19,13645,1,2,0)="site parameter in the AR Site Parameter (#342) file. This will allow the"
^DIC(19,13645,1,3,0)="user to select how many days in the past Rated Disability Changes will be"
^DIC(19,13645,1,4,0)="checked for the Rated Disability Eligibility Change Report if it is"
^DIC(19,13645,1,5,0)="scheduled by IRM to be run on a recurring basis."
^DIC(19,13645,25)="EDITRDDT^RCMSITE"
^DIC(19,13645,"U")="ENTER/EDIT RD NUMBER OF DAYS R"
^DIC(19,13646,0)="RCDMCEDT ENTER/EDIT DMC DEBT ^Enter/Edit DMC Debt Validation^^R^1^^^^^^^261^y"
^DIC(19,13646,1,0)="^19.06^11^11^3080523^^"
^DIC(19,13646,1,1,0)="This Accounts Receivable option allows the user to enter/edit the DMC Debt"
^DIC(19,13646,1,2,0)="Valid field in the Accounts Receivable (#430) file. The user will be"
^DIC(19,13646,1,3,0)="prompted to select a specific bill, by bill number or Patient, and then be"
^DIC(19,13646,1,4,0)="issued a prompt for the DMC Debt Valid field for corresponding bill with a"
^DIC(19,13646,1,5,0)="Current Status of Active, Open, or Suspended. If the prompt is answered"
^DIC(19,13646,1,6,0)="'Yes', then the associated receivables will be included into the DMC"
^DIC(19,13646,1,7,0)="eligible debt determination process for the Accounts Receivable Nightly "
^DIC(19,13646,1,8,0)="Process Background Job and if it meets all DMC referral criteria be"
^DIC(19,13646,1,9,0)="referred to DMC. If the Debt is determined to be inappropriate (the DMC"
^DIC(19,13646,1,10,0)="Debt Valid field set to 'NO'), staff will cancel the bill using the"
^DIC(19,13646,1,11,0)="existing functionality"
^DIC(19,13646,25)="UPDTDMC^RCDMCEDT"
^DIC(19,13646,"U")="ENTER/EDIT DMC DEBT VALIDATION"
^DIC(19,13647,0)="RCDMCR1 DEBT VALIDITY REPORT^DMC Debt Validity Report^^R^1^^^^^^^261^y^1"
^DIC(19,13647,1,0)="^^59^59^3080523^"
^DIC(19,13647,1,1,0)="This Accounts Receivable option is to assist users in focusing on"
^DIC(19,13647,1,2,0)="reviewing the legitimacy of first party bills for veterans who are SC 50%"
^DIC(19,13647,1,3,0)="to 100% or in receipt of VA Pension benefits. The report contains"
^DIC(19,13647,1,4,0)="information on veterans who meet the above criteria and have bills for"
^DIC(19,13647,1,5,0)="episodes of care within the previous 365 days (or older selected date)"
^DIC(19,13647,1,6,0)="with a DMC Debt Valid field not flagged as 'YES' or 'NO' and for which the"
^DIC(19,13647,1,7,0)="Current Status is Active, Open or Suspended. "
^DIC(19,13647,1,8,0)=" "
^DIC(19,13647,1,9,0)="Authorized billing staff can run the report to ensure that all bills"
^DIC(19,13647,1,10,0)="meeting the above criteria are reviewed and if necessary the appropriate"
^DIC(19,13647,1,11,0)="action is taken as follows:"
^DIC(19,13647,1,12,0)="     Bill is appropriate - Update the Debt Validity Status field to 'YES'"
^DIC(19,13647,1,13,0)="                           in order that the bill is referred to DMC via"
^DIC(19,13647,1,14,0)="                           the automated process if all other DMC criteria"
^DIC(19,13647,1,15,0)="                           is met "
^DIC(19,13647,1,16,0)="     Bill is inappropriate - Update the Debt Validity Status Field to 'NO'"
^DIC(19,13647,1,17,0)="                             and staff will cancel the bill using existing"
^DIC(19,13647,1,18,0)="                             functionality "
^DIC(19,13647,1,19,0)="     Inappropriate bill sent to DMC - Staff to initiate action to cancel"
^DIC(19,13647,1,20,0)="                                      DMC collection or refund payments"
^DIC(19,13647,1,21,0)="                                      using existing functionality"
^DIC(19,13647,1,22,0)=" "
^DIC(19,13647,1,23,0)="The report allows for the user to select the date from which to include "
^DIC(19,13647,1,24,0)="bills for episodes of care on the report and to select if they want the"
^DIC(19,13647,1,25,0)="report printed in a Detailed Format or in an Excel Delimited Format."
^DIC(19,13647,1,26,0)=" "
^DIC(19,13647,1,27,0)="It is recommended that the user Queues this report to a device that is 132"
^DIC(19,13647,1,28,0)="characters wide."
^DIC(19,13647,1,29,0)=" "
^DIC(19,13647,1,30,0)="The report will include the following data elements:"
^DIC(19,13647,1,31,0)="   Data Elements                      From File #"
^DIC(19,13647,1,32,0)="   -------------------------------    ---------------------------------"
^DIC(19,13647,1,33,0)="   Veteran's Name                     #2 (Patient File) "
^DIC(19,13647,1,34,0)="   SSN (Last 4 digits)                #2"
^DIC(19,13647,1,35,0)="   Claim Number(CXXXXXXXX)            #2"
^DIC(19,13647,1,36,0)="   Claim Location(Station Number)     #2"
^DIC(19,13647,1,37,0)="   Eligibility/Effective Date         #2"
^DIC(19,13647,1,38,0)="   Bill Number                        #430 (Accounts Receivable)"
^DIC(19,13647,1,39,0)="   RX Fill/Re-Fill Date.              File #52 pointed to by File #350"
^DIC(19,13647,1,40,0)="   Outpatient Visit Date              File #409.68 pointed to by file #350"
^DIC(19,13647,1,41,0)="   Discharge Date                     File #405 pointed to by file #350"
^DIC(19,13647,1,42,0)="   AR Status(Open/Active/Suspended)   #430"
^DIC(19,13647,1,43,0)="   DMC Referral Date                  #430  "
^DIC(19,13647,1,44,0)="   DMC Debt Valid (Null/PENDING)      #430 "
^DIC(19,13647,1,45,0)="  "
^DIC(19,13647,1,46,0)="   Summary at bottom of report:"
^DIC(19,13647,1,47,0)="           "
^DIC(19,13647,1,48,0)="       Total Number of Bills Referred"
^DIC(19,13647,1,49,0)="       Total Number of unique veterans referred       "
^DIC(19,13647,1,50,0)="       Total AR Dollars referred   "
^DIC(19,13647,1,51,0)=" "
^DIC(19,13647,1,52,0)="       Total Number of Bills"
^DIC(19,13647,1,53,0)="       Total Number of unique veterans"
^DIC(19,13647,1,54,0)="       Total AR Dollars"
^DIC(19,13647,1,55,0)=" "
^DIC(19,13647,1,56,0)="Note: When the veteran is not Service Connected 50% to 100% and is not "
^DIC(19,13647,1,57,0)="Receiving a VA Pension the new software will also include the "
^DIC(19,13647,1,58,0)="functionality to consider a veteran as Receiving a VA Pension if he/she is"
^DIC(19,13647,1,59,0)="receiving A&A or Housebound Benefits."
^DIC(19,13647,20)="S TESTDATE=2920101"
^DIC(19,13647,25)="MAIN^RCDMCR1A"
^DIC(19,13647,"U")="DMC DEBT VALIDITY REPORT"
^DIC(19,13648,0)="RCDMCR1 DEBT VALIDITY TASK RPT^DMC Debt Validity Report - Scheduled Task^^R^1^^^^^^^261^^"
^DIC(19,13648,1,0)="^^63^63^3080523^"
^DIC(19,13648,1,1,0)="This Accounts Receivable option is used to schedule the DMC Debt Validity"
^DIC(19,13648,1,2,0)="Report to run on a recurring basis with out user intervention. The report"
^DIC(19,13648,1,3,0)="is used to assist users in focusing on reviewing the legitimacy of first"
^DIC(19,13648,1,4,0)="party bills for veterans who are SC 50% to 100% or in receipt of VA"
^DIC(19,13648,1,5,0)="Pension benefits. The report contains information on veterans who meet the"
^DIC(19,13648,1,6,0)="above criteria and have bills for episodes of care within the previous X"
^DIC(19,13648,1,7,0)="days with a DMC Debt Valid field not flagged as 'YES' or 'NO' and for"
^DIC(19,13648,1,8,0)="which the Current Status is Active, Open or Suspended. "
^DIC(19,13648,1,9,0)=" "
^DIC(19,13648,1,10,0)="X will be the value entered in the ""NUMBER OF DAYS FOR DMC REPORTS"""
^DIC(19,13648,1,11,0)="(#8.02) field of the AR SITE PARAMETER (#342) file. If this value isn't"
^DIC(19,13648,1,12,0)="entered the report will default to bills from episodes of care for the"
^DIC(19,13648,1,13,0)="past 365 days. This parameter can be edited using the Enter/Edit DMC"
^DIC(19,13648,1,14,0)="Report # Days for Episodes of Care [RCDMC EDIT DMC REPORT # OF DAY]"
^DIC(19,13648,1,15,0)="option."
^DIC(19,13648,1,16,0)=" "
^DIC(19,13648,1,17,0)="Authorized billing staff can use the report to ensure that all bills"
^DIC(19,13648,1,18,0)="meeting the above criteria are reviewed and if necessary the appropriate"
^DIC(19,13648,1,19,0)="action is taken as follows:"
^DIC(19,13648,1,20,0)="     Bill is appropriate - Update the Debt Validity Status field to 'YES'"
^DIC(19,13648,1,21,0)="                           in order that the bill is referred to DMC via"
^DIC(19,13648,1,22,0)="                           the automated process if all other DMC criteria"
^DIC(19,13648,1,23,0)="                           is met "
^DIC(19,13648,1,24,0)="     Bill is inappropriate - Update the Debt Validity Status Field to 'NO'"
^DIC(19,13648,1,25,0)="                             and staff will cancel the bill using existing"
^DIC(19,13648,1,26,0)="                             functionality "
^DIC(19,13648,1,27,0)="     Inappropriate bill sent to DMC - Staff to initiate action to cancel"
^DIC(19,13648,1,28,0)="                                      DMC collection or refund payments"
^DIC(19,13648,1,29,0)="                                      using existing functionality"
^DIC(19,13648,1,30,0)=" "
^DIC(19,13648,1,31,0)="The scheduled report can only be printed in the detailed format and it"
^DIC(19,13648,1,32,0)="should be sent to a device that is 132 characters wide."
^DIC(19,13648,1,33,0)=" "
^DIC(19,13648,1,34,0)="The report will include the following data elements:"
^DIC(19,13648,1,35,0)="   Data Elements                      From File #"
^DIC(19,13648,1,36,0)="   -------------------------------    ---------------------------------"
^DIC(19,13648,1,37,0)="   Veteran's Name                     #2 (Patient File) "
^DIC(19,13648,1,38,0)="   SSN (Last 4 digits)                #2"
^DIC(19,13648,1,39,0)="   Claim Number(CXXXXXXXX)            #2"
^DIC(19,13648,1,40,0)="   Claim Location(Station Number)     #2"
^DIC(19,13648,1,41,0)="   Eligibility/Effective Date         #2"
^DIC(19,13648,1,42,0)="   Bill Number                        #430 (Accounts Receivable)"
^DIC(19,13648,1,43,0)="   RX Fill/Re-Fill Date.              File #52 pointed to by File #350"
^DIC(19,13648,1,44,0)="   Outpatient Visit Date              File #409.68 pointed to by file #350"
^DIC(19,13648,1,45,0)="   Discharge Date                     File #405 pointed to by file #350"
^DIC(19,13648,1,46,0)="   AR Status(Open/Active/Suspended)   #430"
^DIC(19,13648,1,47,0)="   DMC Referral Date                  #430  "
^DIC(19,13648,1,48,0)="   DMC Debt Valid (Null/PENDING)      #430 "
^DIC(19,13648,1,49,0)="  "
^DIC(19,13648,1,50,0)="   Summary at bottom of report:"
^DIC(19,13648,1,51,0)="           "
^DIC(19,13648,1,52,0)="       Total Number of Bills Referred"
^DIC(19,13648,1,53,0)="       Total Number of unique veterans referred       "
^DIC(19,13648,1,54,0)="       Total AR Dollars referred   "
^DIC(19,13648,1,55,0)=" "
^DIC(19,13648,1,56,0)="       Total Number of Bills"
^DIC(19,13648,1,57,0)="       Total Number of unique veterans"
^DIC(19,13648,1,58,0)="       Total AR Dollars"
^DIC(19,13648,1,59,0)=" "
^DIC(19,13648,1,60,0)="Note: When the veteran is not Service Connected 50% to 100% and is not"
^DIC(19,13648,1,61,0)="Receiving a VA Pension the new software will also include the"
^DIC(19,13648,1,62,0)="functionality to consider a veteran as Receiving a VA Pension if he/she is"
^DIC(19,13648,1,63,0)="receiving A&A or Housebound Benefits."
^DIC(19,13648,20)=""
^DIC(19,13648,25)="QUERPT^RCDMCR1A"
^DIC(19,13648,200.9)="y"
^DIC(19,13648,"U")="DMC DEBT VALIDITY REPORT - SCH"
^DIC(19,13649,0)="RCDMCR2 DEBT VALIDITY MGMT RPT^DMC Debt Validity Management Report^^R^1^^^^^^^261^y"
^DIC(19,13649,1,0)="^^50^50^3080523^"
^DIC(19,13649,1,1,0)="This Accounts Receivable option is to assist management/supervisors to"
^DIC(19,13649,1,2,0)="review processing of the bills listed in the ""Debt Validity report"" for"
^DIC(19,13649,1,3,0)="veterans who are SC 50% to 100% or in receipt of VA Pension benefits and"
^DIC(19,13649,1,4,0)="have bills for episodes of care within the previous 365 days (or older "
^DIC(19,13649,1,5,0)="selected date) with the current bill Status of Open, Active, Suspended,"
^DIC(19,13649,1,6,0)="Cancellation, Refund Review or Refunded. "
^DIC(19,13649,1,7,0)=" "
^DIC(19,13649,1,8,0)="The report allows for the user to select the date from which to"
^DIC(19,13649,1,9,0)="include bills for episodes of care on the report; to select if they want"
^DIC(19,13649,1,10,0)="the report printed in a Detailed Format, a Summary Format, or in an Excel"
^DIC(19,13649,1,11,0)="Delimited Format; and to select based on the ""DMC Debt Valid"" status to"
^DIC(19,13649,1,12,0)="facilitate Supervisors to identify the bills that are either processed or"
^DIC(19,13649,1,13,0)="yet to be processed."
^DIC(19,13649,1,14,0)=" "
^DIC(19,13649,1,15,0)="It is recommended that the user Queues this report to a device that is 132"
^DIC(19,13649,1,16,0)="characters wide."
^DIC(19,13649,1,17,0)=" "
^DIC(19,13649,1,18,0)="The report will include the following data elements:"
^DIC(19,13649,1,19,0)="   Data Elements                      From File #"
^DIC(19,13649,1,20,0)="   -------------------------------    ---------------------------------"
^DIC(19,13649,1,21,0)="   Veteran's Name                     #2 (Patient File) "
^DIC(19,13649,1,22,0)="   SSN (Last 4 digits)                #2"
^DIC(19,13649,1,23,0)="   Claim Number(CXXXXXXXX)            #2"
^DIC(19,13649,1,24,0)="   Claim Location(Station Number)     #2"
^DIC(19,13649,1,25,0)="   Principal Balance                  #430 (Account Receivable)"
^DIC(19,13649,1,26,0)="   AR Status(Open/Active/Suspended/"
^DIC(19,13649,1,27,0)="      Cancellation/Refund Review/"
^DIC(19,13649,1,28,0)="      Refunded)                       #430"
^DIC(19,13649,1,29,0)="   DMC Debt Valid Edited By           #430"
^DIC(19,13649,1,30,0)="   DMC Debt Valid Edited Date         #430"
^DIC(19,13649,1,31,0)=" "
^DIC(19,13649,1,32,0)="   Summary at bottom of report        "
^DIC(19,13649,1,33,0)="     Total Number of Bills"
^DIC(19,13649,1,34,0)="     Total Number of unique Veterans"
^DIC(19,13649,1,35,0)="     Total AR Receivable Amount (Principle Balance)         "
^DIC(19,13649,1,36,0)="     Total Number of unique Active AR Status "
^DIC(19,13649,1,37,0)="     Total Number of unique Open AR Status   "
^DIC(19,13649,1,38,0)="     Total Number of unique Suspended AR Status      "
^DIC(19,13649,1,39,0)="     Total Number of unique Cancellation AR Status   "
^DIC(19,13649,1,40,0)="     Total Number of unique Refund Review AR Status  "
^DIC(19,13649,1,41,0)="     Total Number of unique Refunded AR Status"
^DIC(19,13649,1,42,0)=" "
^DIC(19,13649,1,43,0)="If the user chooses to print report for all DMC Debt Valid field values"
^DIC(19,13649,1,44,0)="then the will be a summary for each Value as well as a summary total for"
^DIC(19,13649,1,45,0)="all values combined."
^DIC(19,13649,1,46,0)=" "
^DIC(19,13649,1,47,0)="Note: When the veteran is not Service Connected 50% to 100% and is not"
^DIC(19,13649,1,48,0)="Receiving a VA Pension the new software will also include the"
^DIC(19,13649,1,49,0)="functionality to consider a veteran as Receiving a VA Pension if he/she is"
^DIC(19,13649,1,50,0)="receiving A&A or Housebound Benefits."
^DIC(19,13649,25)="MAIN^RCDMCR2A"
^DIC(19,13649,"U")="DMC DEBT VALIDITY MANAGEMENT R"
^DIC(19,13650,0)="RCDMCR2 DEBT VALID MGMT TASK^DMC Debt Validity Management Rpt - Scheduled Task^^R^1^^^^^^^261^^"
^DIC(19,13650,1,0)="^^54^54^3080523^"
^DIC(19,13650,1,1,0)="This Accounts Receivable option is used to schedule the DMC Debt Validity"
^DIC(19,13650,1,2,0)="Management Report to run on a recurring basis with out user intervention. "
^DIC(19,13650,1,3,0)="It is used to assist management/supervisors to review processing of the"
^DIC(19,13650,1,4,0)="bills listed in the ""Debt Validity report"" for veterans who are SC 50% to"
^DIC(19,13650,1,5,0)="100% or in receipt of VA Pension benefits and have bills for episodes of"
^DIC(19,13650,1,6,0)="care within the previous X days with the current bill Status of Open,"
^DIC(19,13650,1,7,0)="Active, Suspended, Cancellation, Refund Review or Refunded. "
^DIC(19,13650,1,8,0)=" "
^DIC(19,13650,1,9,0)="X will be the value entered in the ""NUMBER OF DAYS FOR DMC REPORTS"""
^DIC(19,13650,1,10,0)="(#8.02) field of the AR SITE PARAMETER (#342) file. If this value isn't"
^DIC(19,13650,1,11,0)="entered the report will default to bills from episodes of care for the"
^DIC(19,13650,1,12,0)="past 365 days. This parameter can be edited using the Enter/Edit DMC"
^DIC(19,13650,1,13,0)="Report # Days for Episodes of Care [RCDMC EDIT DMC REPORT # OF DAY]"
^DIC(19,13650,1,14,0)="option."
^DIC(19,13650,1,15,0)=" "
^DIC(19,13650,1,16,0)="The report will print all ""DMC Debt Valid"" statuses to facilitate"
^DIC(19,13650,1,17,0)="Supervisors to identify the bills that are either processed or yet to be"
^DIC(19,13650,1,18,0)="processed."
^DIC(19,13650,1,19,0)=" "
^DIC(19,13650,1,20,0)="The scheduled report can only be printed in the detailed format and it"
^DIC(19,13650,1,21,0)="should be sent to a device that is 132 characters wide."
^DIC(19,13650,1,22,0)=" "
^DIC(19,13650,1,23,0)="The report will include the following data elements:"
^DIC(19,13650,1,24,0)="    Data Elements                      From File #"
^DIC(19,13650,1,25,0)="    -------------------------------    ---------------------------------"
^DIC(19,13650,1,26,0)="    Veteran's Name                     #2 (Patient File)"
^DIC(19,13650,1,27,0)="    SSN (Last 4 digits)                #2"
^DIC(19,13650,1,28,0)="    Claim Number(CXXXXXXXX)            #2"
^DIC(19,13650,1,29,0)="    Claim Location(Station Number)     #2"
^DIC(19,13650,1,30,0)="    Principal Balance                  #430 (Account Receivable)"
^DIC(19,13650,1,31,0)="    AR Status(Open/Active/Suspended/"
^DIC(19,13650,1,32,0)="       Cancellation/Refund Review/"
^DIC(19,13650,1,33,0)="       Refunded)                       #430"
^DIC(19,13650,1,34,0)="    DMC Debt Valid Edited By           #430"
^DIC(19,13650,1,35,0)="    DMC Debt Valid Edited Date         #430"
^DIC(19,13650,1,36,0)=" "
^DIC(19,13650,1,37,0)="    Summary at bottom of report"
^DIC(19,13650,1,38,0)="      Total Number of Bills"
^DIC(19,13650,1,39,0)="      Total Number of unique Veterans"
^DIC(19,13650,1,40,0)="      Total AR Receivable Amount (Principle Balance)"
^DIC(19,13650,1,41,0)="      Total Number of unique Active AR Status"
^DIC(19,13650,1,42,0)="      Total Number of unique Open AR Status"
^DIC(19,13650,1,43,0)="      Total Number of unique Suspended AR Status"
^DIC(19,13650,1,44,0)="      Total Number of unique Cancellation AR Status"
^DIC(19,13650,1,45,0)="      Total Number of unique Refund Review AR Status"
^DIC(19,13650,1,46,0)="      Total Number of unique Refunded AR Status"
^DIC(19,13650,1,47,0)=" "
^DIC(19,13650,1,48,0)="There will be a summary for each DMC Debt Valid field Value as well as a"
^DIC(19,13650,1,49,0)="summary total for all values combined."
^DIC(19,13650,1,50,0)=" "
^DIC(19,13650,1,51,0)="Note: When the veteran is not Service Connected 50% to 100% and is not"
^DIC(19,13650,1,52,0)="Receiving a VA Pension the new software will also include the"
^DIC(19,13650,1,53,0)="functionality to consider a veteran as Receiving a VA Pension if he/she is"
^DIC(19,13650,1,54,0)="receiving A&A or Housebound Benefits."
