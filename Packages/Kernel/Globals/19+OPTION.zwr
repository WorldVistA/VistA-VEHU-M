^DIC(19,6738,"U")="PENDING CS ORDERS BY DISPENSIN"
^DIC(19,6739,0)="PSD PRINT 2638^Green Sheet - Print (VA FORM 10-2638)^^R^11595^^^^^^^276"
^DIC(19,6739,1,0)="^^3^3^2930224^^^"
^DIC(19,6739,1,1,0)="Pharmacy prints Green Sheets using this option.  All Green Sheets, not"
^DIC(19,6739,1,2,0)="previously printed for a specific NAOU, will be generated.  A single"
^DIC(19,6739,1,3,0)="Green Sheet print may also be selected."
^DIC(19,6739,25)="PSDPGS"
^DIC(19,6739,"U")="GREEN SHEET - PRINT (VA FORM 1"
^DIC(19,6740,0)="PSD REPRINT 2638^Green Sheet Reprint (VA FORM 10-2638)^^R^11595^^^^^^^276"
^DIC(19,6740,1,0)="^^1^1^2920912^^^"
^DIC(19,6740,1,1,0)="Pharmacy uses this option to reprint a single Green Sheet."
^DIC(19,6740,25)="PSDRPGS"
^DIC(19,6740,"U")="GREEN SHEET REPRINT (VA FORM 1"
^DIC(19,6741,0)="PSD DISPENSE W/O GS^Pharmacy Dispense without (VA FORM 10-2638)^^R^11595^^^^^^^276"
^DIC(19,6741,1,0)="^^5^5^2960221^^^^"
^DIC(19,6741,1,1,0)="This option provides pharmacy the ability to dispense Controlled Substances"
^DIC(19,6741,1,2,0)="drugs from a dispensing site without generating the VA FORM 10-2638."
^DIC(19,6741,1,3,0)="Drugs dispensed using this option will not be displayed on the Inspector's"
^DIC(19,6741,1,4,0)="Log for Controlled Substances for the NAOUs.  These drugs will be included"
^DIC(19,6741,1,5,0)="on the Pharmacy Dispensing Report and the Daily Activity Log."
^DIC(19,6741,25)="PSDDFP"
^DIC(19,6741,"U")="PHARMACY DISPENSE WITHOUT (VA "
^DIC(19,6742,0)="PSD PICKUP GS^Pick Up Green Sheet^^R^10000000216^^^^^^^276"
^DIC(19,6742,1,0)="^^2^2^2930727^^^"
^DIC(19,6742,1,1,0)="This option provides pharmacy the ability to receive a Green Sheet into"
^DIC(19,6742,1,2,0)="pharmacy that has been marked as Ready for Pickup by Nursing."
^DIC(19,6742,25)="PSDGSPU"
^DIC(19,6742,"U")="PICK UP GREEN SHEET"
^DIC(19,6743,0)="PSD NOT DELIVERED^Orders Filled Not Delivered^^R^11595^^^^^^^276"
^DIC(19,6743,1,0)="^^4^4^2930224^^^^"
^DIC(19,6743,1,1,0)="This option generates a list of all Controlled Substances orders"
^DIC(19,6743,1,2,0)="filled from the pharmacy dispensing site (vault) but not yet"
^DIC(19,6743,1,3,0)="delivered to the NAOUs.  A summary total sorted by drug is also"
^DIC(19,6743,1,4,0)="generated."
^DIC(19,6743,25)="PSDFND"
^DIC(19,6743,"U")="ORDERS FILLED NOT DELIVERED"
^DIC(19,6744,0)="PSD COMPLETE GS^Complete Green Sheet^^R^10000000216^^^^^^^276"
^DIC(19,6744,1,0)="^19.06^4^4^3000615^^^^"
^DIC(19,6744,1,1,0)="Pharmacy uses this option to complete a reviewed Green Sheet.  Green"
^DIC(19,6744,1,2,0)="Sheets with no discrepancies, math errors, drugs returned to stock, and"
^DIC(19,6744,1,3,0)="drugs holding for destruction, associated with this Green Sheet, are"
^DIC(19,6744,1,4,0)="processed utilizing this option."
^DIC(19,6744,25)="PSDGSRV"
^DIC(19,6744,"U")="COMPLETE GREEN SHEET"
^DIC(19,6745,0)="PSD NURSE SHIFT LOG^Nursing Shift Check Log^^R^11595^^^^^^^276"
^DIC(19,6745,1,0)="^^2^2^2990203^^^^"
^DIC(19,6745,1,1,0)="Use this report to list all ACTIVE Controlled Substances"
^DIC(19,6745,1,2,0)="orders currently on a specific NAOU."
^DIC(19,6745,25)="PSDNSCL"
^DIC(19,6745,99)="57740,57048"
^DIC(19,6745,"U")="NURSING SHIFT CHECK LOG"
^DIC(19,6746,0)="PSD PURGE^Purge CS WORKSHEET File^^R^11595^^^^^^^276"
^DIC(19,6746,1,0)="^^8^8^2940914^^^^"
^DIC(19,6746,1,1,0)="This option purges the CS WORKSHEET file (#58.85) nightly."
^DIC(19,6746,1,2,0)="The CS WORKSHEET file (#58.85) is the holding area for CS order requests"
^DIC(19,6746,1,3,0)="pending pharmacy processing. The data should remain in the file until"
^DIC(19,6746,1,4,0)="orders have been received on an NAOU or cancelled. Once the order is"
^DIC(19,6746,1,5,0)="received on an NAOU or cancelled, the data is purged from the file using"
^DIC(19,6746,1,6,0)="this background job. This routine should run nightly, therefore the"
^DIC(19,6746,1,7,0)="rescheduling frequency is 1D. The time to queue this option to run should"
^DIC(19,6746,1,8,0)="not conflict with system backup."
^DIC(19,6746,25)="PSDPRG"
^DIC(19,6746,200)="^^1D"
^DIC(19,6746,200.9)="y"
^DIC(19,6746,"U")="PURGE CS WORKSHEET FILE"
^DIC(19,6747,0)="PSD BALANCE INITIALIZE^Initialize Balance at Setup^^R^11595^^^^^^^276"
^DIC(19,6747,1,0)="^^6^6^2940908^^^^"
^DIC(19,6747,1,1,0)="This option will be used at package initialization only.  It provides"
^DIC(19,6747,1,2,0)="pharmacy a method of entering on-hand balances for Controlled Substances"
^DIC(19,6747,1,3,0)="drugs stocked within their dispensing vaults.  The drugs will be listed"
^DIC(19,6747,1,4,0)="alphabetically, displaying narcotic breakdown and package size for each."
^DIC(19,6747,1,5,0)="This option should be used only when the Controlled Substances package"
^DIC(19,6747,1,6,0)="is ready to be ""turned on"" for production use."
^DIC(19,6747,25)="PSDADJI"
^DIC(19,6747,"U")="INITIALIZE BALANCE AT SETUP"
^DIC(19,6748,0)="PSD OUTPATIENT^Outpatient Rx's^^R^10000000216^^^^^^^276"
^DIC(19,6748,1,0)="^^5^5^2940913^^^^"
^DIC(19,6748,1,1,0)="This option provides pharmacy the ability to log outpatient prescriptions"
^DIC(19,6748,1,2,0)="from their Controlled Substances dispensing vault.  The pharmacist will"
^DIC(19,6748,1,3,0)="select an outpatient prescription and the software will display the most"
^DIC(19,6748,1,4,0)="recently filled Rx.  It will display new, refill, and partial"
^DIC(19,6748,1,5,0)="prescriptions."
^DIC(19,6748,25)="PSDOPT"
^DIC(19,6748,99)="58129,47498"
^DIC(19,6748,"U")="OUTPATIENT RX'S"
^DIC(19,6749,0)="PSD EDIT/CANC VER ORD^Edit/Cancel Verified Orders^^R^11595^^^^^^^276"
^DIC(19,6749,1,0)=6
^DIC(19,6749,1,1,0)="This option allows the pharmacy supervisor access to edit or cancel a"
^DIC(19,6749,1,2,0)="verified order.  The order must be edited or cancelled prior to being"
^DIC(19,6749,1,3,0)="delivered to the NAOU.  A verified order may be edited only once.  It"
^DIC(19,6749,1,4,0)="must be cancelled and re-entered if a second edit is required.  Quantity,"
^DIC(19,6749,1,5,0)="manufacturer, lot number, and expiration date are the only fields in which"
^DIC(19,6749,1,6,0)="edits can be made."
^DIC(19,6749,25)="PSDEVO"
^DIC(19,6749,"U")="EDIT/CANCEL VERIFIED ORDERS"
^DIC(19,6750,0)="PSD EXISTING GS^Add Existing Green Sheets at Setup^^R^10000000216^^^^^^^276"
^DIC(19,6750,1,0)="^19.06^3^3^3010404^^^^"
^DIC(19,6750,1,1,0)="This option provides pharmacy the ability to enter existing Green Sheets"
^DIC(19,6750,1,2,0)="and active orders on an NAOU, at package setup.  These orders may be tracked"
^DIC(19,6750,1,3,0)="through the Controlled Substances software."
^DIC(19,6750,25)="PSDEXGS"
^DIC(19,6750,"U")="ADD EXISTING GREEN SHEETS AT S"
