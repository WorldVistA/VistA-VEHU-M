^DIC(19,15015,1,0)="^19.06^3^3^3210924^^^^"
^DIC(19,15015,1,1,0)="This option is used to remove a replacement program key from one or more "
^DIC(19,15015,1,2,0)="options.  The key is removed from the REVERSE/NEGATIVE LOCK, to grant "
^DIC(19,15015,1,3,0)="user access to VistA options that are needed post Cerner transition."
