^DIC(19,14315,0)="IBDF UTIL UPDATE ICD10 STATUS^Encounter Forms ICD-10 Update^^R^1^^^^^^^"
^DIC(19,14315,1,0)="^^6^6^3120125^"
^DIC(19,14315,1,1,0)="This is a report/Listman display that will enable the user to display a "
^DIC(19,14315,1,2,0)="list of Encounter Forms and Clinics after selecting from several input "
^DIC(19,14315,1,3,0)="options. When the list is displayed the user may then update the ICD-10 "
^DIC(19,14315,1,4,0)="Status field which may contain statuses Incomplete, Review or Complete. "
^DIC(19,14315,1,5,0)="The menu at the bottom will allow reselection and dispaly, update status, "
^DIC(19,14315,1,6,0)="print list or jump to another part of the list."
^DIC(19,14315,25)="IBDFUTL4"
^DIC(19,14315,"U")="ENCOUNTER FORMS ICD-10 UPDATE"
