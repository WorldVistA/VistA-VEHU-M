^DIC(19,11815,0)="ORK EDITABLE BY USER^Set Order Checks to be Uneditable By Users^^R^10000000020^^^^^^^170"
^DIC(19,11815,1,0)="^^20^20^3001024^"
^DIC(19,11815,1,1,0)="   This option enters values for the parameter ORK EDITABLE BY USER.  "
^DIC(19,11815,1,2,0)="IRM and Clinical Coordinators can use this option to set one or more order"
^DIC(19,11815,1,3,0)="checks to be uneditable by end users.  An order check with an Editable By"
^DIC(19,11815,1,4,0)="User value of ""No"" prevents end users from changing or setting that order"
^DIC(19,11815,1,5,0)="check's enabled/disabled parameter value. If the order check's"
^DIC(19,11815,1,6,0)="enabled/disabled value is ""enabled"", in combination with an Editable By"
^DIC(19,11815,1,7,0)="User value of ""No"", that order check is effectively ""mandatory"". (In the"
^DIC(19,11815,1,8,0)="GUI option to enable/disable order checks, the order check will appear"
^DIC(19,11815,1,9,0)="with a ""Mandatory"" flag.)"
^DIC(19,11815,1,10,0)="   Editable By User values only apply to end users.  An order check with"
^DIC(19,11815,1,11,0)="a ""No"" value does not prevent IRM and Clinical Coordinators from setting"
^DIC(19,11815,1,12,0)="or changing the order check's enabled/disabled values.  The order check"
^DIC(19,11815,1,13,0)="can still be edited by users (presumably IRM and Clinical Coordinators)"
^DIC(19,11815,1,14,0)="with access to the Order Checking Mgmt menu option ""Enable/Disable an"
^DIC(19,11815,1,15,0)="Order Check"".  An order check with no entry for this option/parameter will"
^DIC(19,11815,1,16,0)="be treated as ""editable by user"" (as if it had a ""Yes"" value.) In other"
^DIC(19,11815,1,17,0)="words, the default for this option/parameter is ""Yes""."
^DIC(19,11815,1,18,0)="   This option is used by the List Manager option ""Enable/Disable My Order"
^DIC(19,11815,1,19,0)="Checks"" [ORK REC PROCESSING FLAG].  In the GUI, these settings can be"
^DIC(19,11815,1,20,0)="accessed from the Tools|Options menu then selecting the Order Checks tab."
^DIC(19,11815,25)="EDITUSER^ORKMGR"
^DIC(19,11815,"U")="SET ORDER CHECKS TO BE UNEDITA"
^DIC(19,11816,0)="RCTOP MENU^TOP Menu^^M^10000000033^^^^^^^"
^DIC(19,11816,1,0)="^19.06^2^2^3000808^^"
