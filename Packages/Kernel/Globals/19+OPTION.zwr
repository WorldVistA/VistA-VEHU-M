^DIC(19,7330,0)="SR OR HOURS^Report of Normal Operating Room Hours^^R^.5^^^^^^^167^^1^1"
^DIC(19,7330,1,0)="^^5^5^2920914^^^"
^DIC(19,7330,1,1,0)="This report outputs the start time and the end time of the normal"
^DIC(19,7330,1,2,0)="working hours for all operating rooms or for the selected operating"
^DIC(19,7330,1,3,0)="room for each date within the specified date range.  The total time"
^DIC(19,7330,1,4,0)="of the normal working day is displayed for each operating room for"
^DIC(19,7330,1,5,0)="each date."
^DIC(19,7330,15)="D EXIT^SROVAR"
^DIC(19,7330,20)="D ^SROVAR"
^DIC(19,7330,22)="Q"
^DIC(19,7330,25)="SRORHRS"
^DIC(19,7330,"U")="REPORT OF NORMAL OPERATING ROO"
^DIC(19,7331,0)="SR SURGERY REQUEST^Surgery Request^^O^.5^SROREQ^^^^^^167^^1^1"
^DIC(19,7331,1,0)="^^2^2^2921102^^^"
^DIC(19,7331,1,1,0)="This protocol allows the entry and editing of operation requests through"
^DIC(19,7331,1,2,0)="OE/RR."
^DIC(19,7331,10,0)="^19.01PI^0^0"
