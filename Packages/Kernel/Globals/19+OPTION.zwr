^DIC(19,1673,1,1,0)="This option allows the supervisor to list all patients"
^DIC(19,1673,1,2,0)="who have had an examination that is associated with a specific Amis"
^DIC(19,1673,1,3,0)="code within a specified period of time."
^DIC(19,1673,1,4,0)=" "
