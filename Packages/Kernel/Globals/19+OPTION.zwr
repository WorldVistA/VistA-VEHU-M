^DIC(19,7863,15)="W:$D(IOF) @IOF W !,""Duplicate Resolution System Menu"",!"
^DIC(19,7863,20)="W:$D(IOF) @IOF W !,""Duplicate Resolution Operations Menu"",!"
^DIC(19,7863,99)="58072,42130"
^DIC(19,7863,99.1)="53418,43881"
^DIC(19,7863,"U")="OPERATIONS"
^DIC(19,7864,0)="XDR CHECK PAIR^Check Pair of Records to see if Duplicates^^R^1039^^2802^^^^^349"
^DIC(19,7864,1,0)="^^4^4^2971002^^^^"
^DIC(19,7864,1,1,0)="This option allows an operator to input two records and then"
^DIC(19,7864,1,2,0)="run them through the duplicate resolution software and see"
^DIC(19,7864,1,3,0)="what there Match Score would be.  It does not add records to the"
^DIC(19,7864,1,4,0)="Duplicate Record file."
^DIC(19,7864,20)=""
^DIC(19,7864,25)="XDRDCOMP"
^DIC(19,7864,"U")="CHECK PAIR OF RECORDS TO SEE I"
^DIC(19,7865,0)="XDR EDIT DUP RESOLUTION FILE^Edit Site Parameters^^C^1039^^2804^^^^^349"
^DIC(19,7865,1,0)="^^4^4^2970806^^^^"
^DIC(19,7865,1,1,0)="This option allows you to edit the values used by the duplicate resolution"
^DIC(19,7865,1,2,0)="software for determining whether to add an entry or not.  Once you"
^DIC(19,7865,1,3,0)="find the sequence of scores that best fit your facility, it is"
^DIC(19,7865,1,4,0)="recommended that you don't change these values."
^DIC(19,7865,30)="VA(15.1,"
^DIC(19,7865,31)="AELMQ"
^DIC(19,7865,40)="[XDR RESFILE FORM]"
^DIC(19,7865,41)=15.1
^DIC(19,7865,50)="VA(15.1,"
^DIC(19,7865,51)="[XDR EDIT DUP RESOLUTION FILE]"
^DIC(19,7865,52)=""
^DIC(19,7865,"U")="EDIT SITE PARAMETERS"
^DIC(19,7866,0)="XDR VIEW DUPLICATE RECORD^View Duplicate Record Entries^^I^1039^^^^^^^349"
^DIC(19,7866,1,0)="^^2^2^2971113^^^^"
^DIC(19,7866,1,1,0)="This option is used to view Duplicate Record entries in a"
^DIC(19,7866,1,2,0)="captioned format."
^DIC(19,7866,25)=""
^DIC(19,7866,30)="VA(15,"
^DIC(19,7866,31)="QEAM"
^DIC(19,7866,32)="Select a POTENTIAL DUPLICATE ENTRY:"
^DIC(19,7866,60)=""
^DIC(19,7866,61)=""
^DIC(19,7866,80)="VA(15,"
^DIC(19,7866,81)="0;1;11;21"
^DIC(19,7866,"U")="VIEW DUPLICATE RECORD ENTRIES"
^DIC(19,7867,0)="XDR EDIT DUP RECORD STATUS^Edit the Status Field of a Duplicate Record^^R^1039^^^^^^^349"
^DIC(19,7867,1,0)="^^4^4^2980204^^^"
^DIC(19,7867,1,1,0)="This option is used to edit the status field of the"
^DIC(19,7867,1,2,0)="Duplicate Record entry.  It would be used when a pair"
^DIC(19,7867,1,3,0)="was identified as Verified Duplicate or Verified Not A Duplicate and"
^DIC(19,7867,1,4,0)="you want to change the status back to Potential Duplicate,Unverified."
^DIC(19,7867,25)="XDRDEDT"
^DIC(19,7867,30)=""
^DIC(19,7867,31)=""
^DIC(19,7867,32)=""
^DIC(19,7867,50)=""
^DIC(19,7867,51)=""
^DIC(19,7867,"U")="EDIT THE STATUS FIELD OF A DUP"
^DIC(19,7868,0)="XDR PURGE^Purge Duplicate Record File^Inactivated with patch XT*7.3*113^R^1039^^2797^^^^^349"
^DIC(19,7868,1,0)="^^4^4^2971117^^^^"
^DIC(19,7868,1,1,0)="This option is used to purge entries in the"
^DIC(19,7868,1,2,0)="Duplicate Record File, you may"
^DIC(19,7868,1,3,0)="purge just the Potential Duplicates, or the Verified Non-Duplicates,"
^DIC(19,7868,1,4,0)="or both.  This should only be used by the Site Manager."
^DIC(19,7868,25)="XDRDPRGE"
^DIC(19,7868,"U")="PURGE DUPLICATE RECORD FILE"
^DIC(19,7869,0)="XDR MERGE READY DUPLICATES^Schedule Process to Merge Verified Duplicates^^R^1039^^2807^^^^^349"
^DIC(19,7869,1,0)="^^2^2^2971231^^^"
^DIC(19,7869,1,1,0)="This option merges all entries which currently are ready to merge verified"
^DIC(19,7869,1,2,0)="duplicate pairs that are not included in another merge process."
^DIC(19,7869,25)="QUE^XDRMERG0"
^DIC(19,7869,"U")="SCHEDULE PROCESS TO MERGE VERI"
^DIC(19,7870,0)="XDR MERGE SELECTED PAIR^Merge Selected Verified Duplicate Pair^^R^.5^^2808^^^^^"
^DIC(19,7870,1,0)="^^2^2^2910103^^"
^DIC(19,7870,1,1,0)="This option is used to select a certain ready to merge verified duplicate"
^DIC(19,7870,1,2,0)="pair for merging."
^DIC(19,7870,25)="EN2^XDRMAIN"
^DIC(19,7870,"U")="MERGE SELECTED VERIFIED DUPLIC"
^DIC(19,7871,0)="XDR AUTO MERGE^Automatically Merge all Ready Verified Duplicates^^A^.5^^2801^^^^^^^1"
^DIC(19,7871,1,0)="^^3^3^2910103^^^^"
^DIC(19,7871,1,1,0)="This option is used to non-interactively merge all verified duplicate"
^DIC(19,7871,1,2,0)="pairs that are ready to be merged.  This option may take some time"
^DIC(19,7871,1,3,0)="depending on how many verified duplicate pairs there are."
^DIC(19,7871,20)="S XDRM(""AUTO"")="""" D EN1^XDRMAIN K XDRM"
^DIC(19,7871,25)=""
^DIC(19,7871,"U")="AUTOMATICALLY MERGE ALL READY "
^DIC(19,7872,0)="XDR VERIFY SELECTED PAIR^Verify Selected Potential Duplicate Pair^^R^.5^^2809^^^^^"
^DIC(19,7872,1,0)="^^4^4^2910103^"
^DIC(19,7872,1,1,0)="This option is used to select a Potential Duplicate Pair and verify"
^DIC(19,7872,1,2,0)="as either Verified Non-Duplicate or Verified Duplicate.  It will"
^DIC(19,7872,1,3,0)="The merge process will be initiated if there are no package interactive"
^DIC(19,7872,1,4,0)="merges that need to occur."
^DIC(19,7872,25)="EN3^XDRMAIN"
^DIC(19,7872,"U")="VERIFY SELECTED POTENTIAL DUPL"
^DIC(19,7873,0)="XDR ADD VERIFIED DUPS^Add Verified Duplicate Pair^^R^1039^^2800^^^^^349"
^DIC(19,7873,1,0)="^^12^12^2970926^"
^DIC(19,7873,1,1,0)="This option allow the user to add a pair of records that are not already"
^DIC(19,7873,1,2,0)="identified as potential or verified duplicate to the Duplicate"
^DIC(19,7873,1,3,0)="Record File.  The pair will go through comparisons (Duplicate Tests).  The"
^DIC(19,7873,1,4,0)="comparison results in a computed value based on similarity of one"
^DIC(19,7873,1,5,0)="record to the other.  The resulting value is measured against the"
^DIC(19,7873,1,6,0)="Potential Duplicate Threshold Percentage.  When the record pair"
^DIC(19,7873,1,7,0)="scores evaluate above this percentage, they are considered to be"
^DIC(19,7873,1,8,0)="potential duplicates and are placed in the Duplicate Record File."
^DIC(19,7873,1,9,0)=" "
^DIC(19,7873,1,10,0)="If the user has the XUMGR key, the user has the option to bypass the"
^DIC(19,7873,1,11,0)="Potential Duplicate Threshold Percentage thereby adding the pair directly"
^DIC(19,7873,1,12,0)="to the Duplicate Record File."
^DIC(19,7873,25)="XDRMADD"
^DIC(19,7873,"U")="ADD VERIFIED DUPLICATE PAIR"
^DIC(19,7874,0)="XDR UTILITIES MENU^Utilities^^M^1039^^^^^^y^349^^1^1"
