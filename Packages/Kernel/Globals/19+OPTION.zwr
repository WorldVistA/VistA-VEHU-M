^DIC(19,13912,20)="N H2,L2 S H2=""*** Mental Health ***"",L2=""MHA3 Utilities"" W !,@IOF,#,?(IOM-$L(H2)/2),H2,!?(IOM-$L(L2)/2),L2"
^DIC(19,13912,99)="66272,51742"
^DIC(19,13912,"U")="MHA3 UTILITIES"
^DIC(19,13913,0)="YTQ FORM PRINT^Print Test Form^^R^10000000216^^^^^^^"
^DIC(19,13913,1,0)="^19.06^3^3^3080506^^"
^DIC(19,13913,1,1,0)="Displays a representation of the test as it might look on a paper form. "
^DIC(19,13913,1,2,0)="This is NOT the way the published test form looks but it will print "
^DIC(19,13913,1,3,0)="Introductions, Questions and Choices."
^DIC(19,13913,25)="FORM^YTQPRT"
^DIC(19,13913,"U")="PRINT TEST FORM"
^DIC(19,13914,0)="YTQ DETAILED DEFINITION^Detailed Definition^^R^10000000216^^^^^^^"
^DIC(19,13914,1,0)="^19.06^3^3^3080701^^^^"
^DIC(19,13914,1,1,0)="Displays all the information available for a specified MHA3 instrument. "
^DIC(19,13914,1,2,0)="This includes Intros, Questions, Choicetypes, Choices, Skips, Skip rules, "
^DIC(19,13914,1,3,0)="and Reports."
^DIC(19,13914,25)="PRTTEST^YTQPRT"
^DIC(19,13914,"U")="DETAILED DEFINITION"
^DIC(19,13918,0)="YTQTUSE^server test usage MHA3 stats^^S^10000000216^^^^^^^"
^DIC(19,13918,1,0)="^19.06^6^6^3100315^^^^"
^DIC(19,13918,1,1,0)="       *** MHA3 ***"
^DIC(19,13918,1,2,0)="Used by the National Mental Health Strategic Healthcare Group to determine"
^DIC(19,13918,1,3,0)="the annual psychological test usage by site.  This option reports the"
^DIC(19,13918,1,4,0)="number of each test by station within any given time period."
^DIC(19,13918,1,5,0)=" "
^DIC(19,13918,1,6,0)="The MAILMAN message must be in FILEMAN date format 3031001^3040930"
^DIC(19,13918,25)="YTQTUSE"
^DIC(19,13918,220)="^R^^N^^N"
^DIC(19,13918,"U")="SERVER TEST USAGE MHA3 STATS"
^DIC(19,13919,0)="YTQ EXEMPT TEST^Exempt Test^^R^10000000216^^^^^^^"
^DIC(19,13919,1,0)="^^5^5^3081008^"
^DIC(19,13919,1,1,0)="Set restrictions on Administering and Reporting of individual tests base "
^DIC(19,13919,1,2,0)="on the security keys held by the ORDERER of the test."
^DIC(19,13919,1,3,0)=" "
^DIC(19,13919,1,4,0)="The number of days that a test can be re-started if incomplete can also "
^DIC(19,13919,1,5,0)="be changed."
^DIC(19,13919,25)="EXEMPT^YTQAPI14"
^DIC(19,13919,"U")="EXEMPT TEST"
^DIC(19,13920,0)="YTQ XML OUTPUT^XML Output^^R^10000000216^^^^^^^"
^DIC(19,13920,1,0)="^19.06^15^15^3080701^^^^"
^DIC(19,13920,1,1,0)="Outputs an XML document of MHA3 Administration data filtered by:"
^DIC(19,13920,1,2,0)=" "
^DIC(19,13920,1,3,0)="          D         Date Only"
^DIC(19,13920,1,4,0)="          I         Instrument"
^DIC(19,13920,1,5,0)="          L         Location"
^DIC(19,13920,1,6,0)="          P         Patient"
^DIC(19,13920,1,7,0)="          O         Ordered By"
^DIC(19,13920,1,8,0)=" "
^DIC(19,13920,1,9,0)="All reports have a date range. You may include results and individual "
^DIC(19,13920,1,10,0)="question data."
^DIC(19,13920,1,11,0)=" "
^DIC(19,13920,1,12,0)="This report is in XML format to aid use by other reporting tools. Output "
^DIC(19,13920,1,13,0)="contains Patient Identified Data and its use is restricted to those who "
^DIC(19,13920,1,14,0)="meet all requirements for data security and research and clinical "
^DIC(19,13920,1,15,0)="authorization/"
^DIC(19,13920,25)="MAIN^YTQAPI15"
^DIC(19,13920,"U")="XML OUTPUT"
^DIC(19,13921,0)="YTQ USAGE^Test Usage^^R^10000000216^^^^^^^"
^DIC(19,13921,1,0)="^19.06^2^2^3100315^^^^"
^DIC(19,13921,1,1,0)="Returns number of completed administrations by test for a specified "
^DIC(19,13921,1,2,0)="period."
^DIC(19,13921,25)="EN1^YTQTUSE"
^DIC(19,13921,"U")="TEST USAGE"
^DIC(19,13925,0)="MMRS MRSA WARD MAPPING SETUP^MRSA Tools Ward Mapping Setup^^R^1^MMRS SETUP^^^^^^569"
^DIC(19,13925,1,0)="^19.06^2^2^3160804^^^^"
^DIC(19,13925,1,1,0)="This option allows the user to define geographical units for the "
^DIC(19,13925,1,2,0)="division(s). It will allow the user to map units together."
^DIC(19,13925,25)="WARDMAP^MMRSIPCP"
^DIC(19,13925,"U")="MRSA TOOLS WARD MAPPING SETUP"
^DIC(19,13927,0)="MMRS ISLT ORD EDIT^Isolation Orders Add/Edit^^R^1^MMRS SETUP^^^^^^"
^DIC(19,13927,1,0)="^19.06^3^3^3161206^^^^"
^DIC(19,13927,1,1,0)="This option will allow you to enter the orders at your site that are used "
^DIC(19,13927,1,2,0)="for isolation purposes. This will be used to populate the MRSA Tools "
^DIC(19,13927,1,3,0)="Isolation Report."
^DIC(19,13927,25)="ISLTORD^MMRSIPCP"
^DIC(19,13927,30)=""
^DIC(19,13927,31)=""
^DIC(19,13927,50)=""
^DIC(19,13927,51)=""
^DIC(19,13927,"U")="ISOLATION ORDERS ADD/EDIT"
^DIC(19,13928,0)="MMRS MRSA IPEC REPORT^Print MRSA IPEC Report^^R^1^^^^^^^"
^DIC(19,13928,1,0)="^^3^3^3161028^"
^DIC(19,13928,1,1,0)="This option allows the user to print the MRSA IPEC report. The report can "
^DIC(19,13928,1,2,0)="be run for the division or for a specific unit(s).  It allows you to "
^DIC(19,13928,1,3,0)="select either the Admission Report or the Discharge/Transmission report."
^DIC(19,13928,25)="MMRSIPC"
^DIC(19,13928,"U")="PRINT MRSA IPEC REPORT"
^DIC(19,13929,0)="MMRS ISOLATION REPORT^Print Isolation Report^^R^1^^^^^^^"
^DIC(19,13929,1,0)="^19.06^4^4^3160806^^"
^DIC(19,13929,1,1,0)="This option allows the user to print the Isolation Report for each unit.  "
^DIC(19,13929,1,2,0)="The report includes MDROs selected in the initial setup and the historical"
^DIC(19,13929,1,3,0)="timeframe to search for the last positive result.  Isolation Orders will"
^DIC(19,13929,1,4,0)="print on the report, if they are utilized by the site."
^DIC(19,13929,25)="MMRSISL"
^DIC(19,13929,99.1)="61663,44348"
^DIC(19,13929,"U")="PRINT ISOLATION REPORT"
^DIC(19,13930,0)="MMRS NARES SWAB LIST^Print Nares Screen Compliance List^^R^1^^^^^^^"
^DIC(19,13930,1,0)="^19.06^3^3^3161024^^"
^DIC(19,13930,1,1,0)="This option allows the user to print a report to capture the patient on a "
^DIC(19,13930,1,2,0)="unit at a given time and if a nares screen was ordered upon admission to "
^DIC(19,13930,1,3,0)="the unit.  This report prints real-time patient information for the unit."
^DIC(19,13930,25)="MMRSORD"
^DIC(19,13930,"U")="PRINT NARES SCREEN COMPLIANCE "
^DIC(19,13931,0)="MMRS REPORTS MENU^MDRO Tools Reports Menu^^M^1^^^^^^^"
^DIC(19,13931,10,0)="^19.01IP^4^4"
^DIC(19,13931,10,1,0)="13928^1^1"
^DIC(19,13931,10,2,0)="13929^2^2"
^DIC(19,13931,10,3,0)="13930^3^3"
^DIC(19,13931,10,4,0)="14544^4^4"
