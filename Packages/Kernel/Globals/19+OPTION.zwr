^DIC(19,11883,1,0)="^19.06^2^2^3020813^^^"
^DIC(19,11883,1,1,0)="This menu contains management reports for the MPI/PD Patient"
^DIC(19,11883,1,2,0)="Administration Coordinator."
^DIC(19,11883,10,0)="^19.01IP^4^3"
^DIC(19,11883,10,1,0)="11423^^10"
