^DIC(19,16964,0)="EHM-01785^Show Users with a Selected primary Menu^^R^1^^^^^^^^^^^"
^DIC(19,16964,1,0)="^19.06^6^6^3240328^^^^"
^DIC(19,16964,1,1,0)="This option generates a listing of those users who have a selected"
^DIC(19,16964,1,2,0)="option as their primary menus option or as a secondary menu option."
^DIC(19,16964,1,3,0)="It does NOT show all users who might have access to a particular"
^DIC(19,16964,1,4,0)="option.  It only looks at Primary (sign-on) menus and top-level"
^DIC(19,16964,1,5,0)="secondary menu options."
