^DIC(19,13430,1,0)="^^4^4^3060921^"
^DIC(19,13430,1,1,0)="This report lists all the items whose On-Demand Setting is 'NO' in the"
^DIC(19,13430,1,2,0)="Secondary and 'YES' in the Primary Inventory Point.  The Primary "
^DIC(19,13430,1,3,0)="Inventory Point used to make the comparison is the mandatory source for "
^DIC(19,13430,1,4,0)="the item in the Secondary Inventory Point."
^DIC(19,13430,25)="PRIM^PRCPRODM"
^DIC(19,13430,"U")="ON-DEMAND CONFLICTS REPORT"
^DIC(19,13434,0)="MAG REPORT 1^Image Type Count by User^^P^1^^^^^^^530"
^DIC(19,13434,1,0)="^^32^32^3060725^"
^DIC(19,13434,1,1,0)="This is a report of the Image file (#2005) of Image Types for a "
^DIC(19,13434,1,2,0)="'From' and 'To' Acquisition Site and 'From' and 'To' Date/Time Image Saved"
^DIC(19,13434,1,3,0)="date range.  The report will give totals for each Object Type, for each"
^DIC(19,13434,1,4,0)="user, within the date range.  A grand total of images within the date"
^DIC(19,13434,1,5,0)="range is given at the end of the report."
^DIC(19,13434,1,6,0)=" "
^DIC(19,13434,1,7,0)="Sorted by:"
^DIC(19,13434,1,8,0)=" "
^DIC(19,13434,1,9,0)=".   Acquisition Site"
^DIC(19,13434,1,10,0)=" "
^DIC(19,13434,1,11,0)="        You will be asked for a From and To Acquisition Site."
^DIC(19,13434,1,12,0)=" "
^DIC(19,13434,1,13,0)=".  Date/Time Image Saved"
^DIC(19,13434,1,14,0)=" "
^DIC(19,13434,1,15,0)="        You will be asked for a From and To date."
^DIC(19,13434,1,16,0)=" "
^DIC(19,13434,1,17,0)=".  Image Saved By"
^DIC(19,13434,1,18,0)=" "
^DIC(19,13434,1,19,0)="        Enter the exact name of the User at the 'From' and 'To'"
^DIC(19,13434,1,20,0)="        prompts to get a report for a single User."
^DIC(19,13434,1,21,0)=" "
^DIC(19,13434,1,22,0)="        Or, enter 'A' at the 'From' prompt and 'ZZZ' at the 'To'"
^DIC(19,13434,1,23,0)="        prompt for all Users."
^DIC(19,13434,1,24,0)=" "
^DIC(19,13434,1,25,0)=".  Object Type  (Image Type)"
^DIC(19,13434,1,26,0)=" "
^DIC(19,13434,1,27,0)="        Enter the exact name of the Image Type in the 'From' and"
^DIC(19,13434,1,28,0)="        'To' prompts, to get a report for a single Object Type, "
^DIC(19,13434,1,29,0)="        ex., DOCUMENT."
^DIC(19,13434,1,30,0)=" "
^DIC(19,13434,1,31,0)="        Or, enter 'A' at the 'From' prompt and 'ZZZ' at the 'To'"
^DIC(19,13434,1,32,0)="        prompt for all Object Types."
^DIC(19,13434,30)=""
^DIC(19,13434,60)="MAG(2005,"
^DIC(19,13434,63)="[MAG REPORT 1]"
^DIC(19,13434,64)="[MAG REPORT 1]"
^DIC(19,13434,67)=""
^DIC(19,13434,72)=""
^DIC(19,13434,79)="^^1"
^DIC(19,13434,"U")="IMAGE TYPE COUNT BY USER"
^DIC(19,13435,0)="MAG REPORT 2^Document Count^^P^1^^^^^^^530"
^DIC(19,13435,1,0)="^^16^16^3060725^"
^DIC(19,13435,1,1,0)="This is a report of the Image file (#2005) with images having an Image"
^DIC(19,13435,1,2,0)="Type of 'DOCUMENT'.  A 'From'and 'To' Acquisition Site and 'From' and 'To'"
^DIC(19,13435,1,3,0)="Date/time Image Saved will be asked.  Output includes: Date/Time Image"
^DIC(19,13435,1,4,0)="Saved, Object Type (DOCUMENT), Type Index, and Image Saved By.  There will"
