^DIC(19,13318,1,0)="^^5^5^3050607^"
^DIC(19,13318,1,1,0)="Use this option to print all matched Radiology procedure to other procedures"
^DIC(19,13318,1,2,0)="of interest based on grouping of CPT codes, or attributes associated with the CPT"
^DIC(19,13318,1,3,0)="code (Modality, Body Part).  This supports logic in the hanging protocols for"
^DIC(19,13318,1,4,0)="automatically retrieving and displaying prior exams of interest when"
