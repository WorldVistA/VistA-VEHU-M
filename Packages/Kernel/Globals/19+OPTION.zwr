^DIC(19,16505,0)="EHM-01326^Reminder GUI Resolution Active^^A^1^^^^^^^^^1^^"
^DIC(19,16505,1,0)="^^7^7^3240328^"
^DIC(19,16505,1,1,0)="This option allows a user to modify the ""Reminders Active"" CPRS"
^DIC(19,16505,1,2,0)="parameter. You can activate GUI reminder resolution processing at a user,"
^DIC(19,16505,1,3,0)="service, division, or system level. When activated for a level, a"
^DIC(19,16505,1,4,0)="reminders drawer is available on the notes tab for selecting reminders."
^DIC(19,16505,1,5,0)="When a reminder is selected, a dialog box opens with the reminders' dialog"
^DIC(19,16505,1,6,0)="for point and click resolution processing."
^DIC(19,16505,1,7,0)="Cloned from ""PXRM GUI REMINDERS ACTIVE"" option."
^DIC(19,16505,3)=""
^DIC(19,16505,20)="D EDITPAR^XPAREDIT(""PXRM GUI REMINDERS ACTIVE"")"
^DIC(19,16505,"U")="REMINDER GUI RESOLUTION ACTIVE"
