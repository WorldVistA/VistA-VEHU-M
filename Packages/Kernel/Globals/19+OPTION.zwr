^DIC(19,1339,0)="LRUPAC^Lab accession and test counts^^R^.5^^^^^^^26"
^DIC(19,1339,1,0)="^^4^4^2940610^^^^"
^DIC(19,1339,1,1,0)="Lists counts of each type of specimen and counts of each test from one date to another in the Accession Area file.  If Autopsy, Surgical pathology, Cytopathology, or EM is selected only accession counts are given."
^DIC(19,1339,1,2,0)="  NOTE: This option will count all accession for the time period selected."
^DIC(19,1339,1,3,0)="It will produce a total ordered test count. Use the option 'COUNT ACCESSION"
^DIC(19,1339,1,4,0)="TESTS' option to determine the total number verified."
^DIC(19,1339,25)="LRUPAC"
^DIC(19,1339,"U")="LAB ACCESSION AND TEST COUNTS"
