^DIC(19,12399,0)="DGPF RECORD FLAG MANAGEMENT^Record Flag Management^^R^1^DGPF MANAGER^^^^^^"
^DIC(19,12399,1,0)="^^5^5^3030522^"
^DIC(19,12399,1,1,0)="This option will provide users with the ability to:"
^DIC(19,12399,1,2,0)=" - Create Category II (Local) Patient Record Flags"
^DIC(19,12399,1,3,0)=" - Edit Category II (Local) Patient Record Flags"
^DIC(19,12399,1,4,0)=" - List Category I (National) and Category II (Local) Patient Record Flags"
^DIC(19,12399,1,5,0)=" - Display details of Category I and Category II Patient Record Flags"
^DIC(19,12399,25)="EN^DGPFLF"
^DIC(19,12399,"U")="RECORD FLAG MANAGEMENT"
^DIC(19,12401,0)="GMPL SELECTION LIST CSV CHECK^Check Problem Selection List Problem Codes^^R^11720^^^^^^^402"
^DIC(19,12401,1,0)="^^5^5^3160916^"
^DIC(19,12401,1,1,0)="This option will produce a report related to Problem Selection Lists. The"
^DIC(19,12401,1,2,0)="report will contain a list of any Problem Selection Lists that contain "
^DIC(19,12401,1,3,0)="problems with inactive SNOMED and/or ICD codes attached. It will also"
^DIC(19,12401,1,4,0)="determine if any attached ICD codes are due to be inactivated in the"
^DIC(19,12401,1,5,0)="future and a report of those findings is also included."
^DIC(19,12401,25)="CSVOPT^GMPLBLCK"
^DIC(19,12401,"U")="CHECK PROBLEM SELECTION LIST P"
^DIC(19,12402,0)="ORCM GMRC CSV CHECK^Review Quick Orders for Inactive ICD9 Codes^^R^10000000020^^^^^^^170"
^DIC(19,12402,1,0)="^^3^3^3030311^"
^DIC(19,12402,1,1,0)="This option may be run at any time to produce a report of Consult or "
^DIC(19,12402,1,2,0)="Procedure quick orders that have a provisional diagnosis code that "
^DIC(19,12402,1,3,0)="has been inactivated or will be inactivated in the future."
^DIC(19,12402,25)="CSVOPT^ORCMGMCK"
^DIC(19,12402,"U")="REVIEW QUICK ORDERS FOR INACTI"
^DIC(19,12403,0)="DG CV STATUS^Combat Vet Status Report^^R^10000000020^^^^^^^114"
^DIC(19,12403,1,0)="^^2^2^3030722^"
^DIC(19,12403,1,1,0)="The option will create a report listing veterans awarded Combat Vet "
^DIC(19,12403,1,2,0)="status for a specified date range."
^DIC(19,12403,25)="RPT2^DGCV1"
^DIC(19,12403,"U")="COMBAT VET STATUS REPORT"
^DIC(19,12404,0)="TIUHSOBJ MENU^Health Summary Object Menu^^R^10000000020^^^^^^^516"
^DIC(19,12404,1,0)="^19.06^1^1^3021126^^^^"
^DIC(19,12404,1,1,0)="This options selects the Health Summary Object Menu."
^DIC(19,12404,25)="EN^TIUHSL"
^DIC(19,12404,99.1)="59023,27548"
^DIC(19,12404,"U")="HEALTH SUMMARY OBJECT MENU"
^DIC(19,12405,0)="TIUHS LIST MANAGER^Create TIU/Health Summary Objects^^R^10000000020^^^^^^^516"
^DIC(19,12405,25)="TIUHSL"
^DIC(19,12405,99.1)="59023,27548"
^DIC(19,12405,"U")="CREATE TIU/HEALTH SUMMARY OBJE"
^DIC(19,12406,0)="TIU144 ENHANCED MISMATCH LIST^Enhanced Mismatched Consults List^^A^10000000020^^^^^^n^516^^1"
^DIC(19,12406,1,0)="^^11^11^3021106^"
^DIC(19,12406,1,1,0)="Option sent out with TIU*1*144.  Option lists TIU Consult documents whose"
^DIC(19,12406,1,2,0)="patient does not match the patient of the associated Consult Request."
^DIC(19,12406,1,3,0)="Such documents should either be relinked to the appropriate request or"
^DIC(19,12406,1,4,0)="reassigned to the correct patient."
^DIC(19,12406,1,5,0)=" "
^DIC(19,12406,1,6,0)="Option can be rerun if necessary, to check that all mismatches have been"
^DIC(19,12406,1,7,0)="corrected."
^DIC(19,12406,1,8,0)=" "
^DIC(19,12406,1,9,0)="Option is similar to option provided in patch 131, but display contains "
^DIC(19,12406,1,10,0)="more information, making it easier to reassign a document to the correct "
^DIC(19,12406,1,11,0)="patient, if necessary."
^DIC(19,12406,20)="D BEGIN^TIU144"
^DIC(19,12406,99)="58903,48422"
^DIC(19,12406,"U")="ENHANCED MISMATCHED CONSULTS L"
^DIC(19,12407,0)="TIU137 DDEFS & RULES, ANATPATH^Create DDEFS, Rules for Anat Path^^A^10000000020^^^^^^n^516^^1"
^DIC(19,12407,1,0)="^^13^13^3030605^"
^DIC(19,12407,1,1,0)="This option creates new Document Definitions, a User Class, and Business "
^DIC(19,12407,1,2,0)="Rules for Anatomic Pathology.  The option is exported with patch"
^DIC(19,12407,1,3,0)="TIU*1*137.  It is this option, not the patch itself, which actually "
^DIC(19,12407,1,4,0)="creates the new Document Definitions, User Class, and Business Rules."
^DIC(19,12407,1,5,0)=" "
^DIC(19,12407,1,6,0)="This option must be run after the patch is installed.  When the option "
^DIC(19,12407,1,7,0)="has run successfully to the end and messages have indicated that all "
^DIC(19,12407,1,8,0)="items have been created successfully with no problems encountered, this "
^DIC(19,12407,1,9,0)="option may be deleted."
^DIC(19,12407,1,10,0)=" "
^DIC(19,12407,1,11,0)="If the patch must be installed over itself, this option may be re-run if"
^DIC(19,12407,1,12,0)="desired.  However, the option will not attempt to recreate entries that "
^DIC(19,12407,1,13,0)="were already created successfully the first time the option was run."
^DIC(19,12407,20)="D BEGIN^TIUPS137"
^DIC(19,12407,"U")="CREATE DDEFS, RULES FOR ANAT P"
^DIC(19,12408,0)="TIU165 DDEFS & RULES, PRF^Create DDEFS, Rules for Patient Record Flags^^A^10000000020^^^^^^n^516^^1"
^DIC(19,12408,1,0)="^^13^13^3030616^"
^DIC(19,12408,1,1,0)="This option creates new Document Definitions, a User Class, and a Business"
^DIC(19,12408,1,2,0)="Rule for Patient Record Flags.  The option is exported with patch"
^DIC(19,12408,1,3,0)="TIU*1*165.  It is this option, not the patch itself, which actually "
^DIC(19,12408,1,4,0)="creates the new Document Definitions, User Class, and Business Rule."
^DIC(19,12408,1,5,0)=" "
^DIC(19,12408,1,6,0)="This option must be run after the patch is installed.  When the option "
^DIC(19,12408,1,7,0)="has run successfully to the end and messages have indicated that all "
^DIC(19,12408,1,8,0)="items have been created successfully with no problems encountered, this "
^DIC(19,12408,1,9,0)="option may be deleted."
^DIC(19,12408,1,10,0)=" "
^DIC(19,12408,1,11,0)="If the patch must be installed over itself, this option may be re-run if"
^DIC(19,12408,1,12,0)="desired.  However, the option will not attempt to recreate entries that "
^DIC(19,12408,1,13,0)="were already created successfully the first time the option was run."
^DIC(19,12408,20)="D BEGIN^TIUPS165"
^DIC(19,12408,"U")="CREATE DDEFS, RULES FOR PATIEN"
^DIC(19,12409,0)="SCRPW PERFORMANCE MONITOR MENU^Performance Monitor Menu^^M^10000000020^^^^^^^16"
^DIC(19,12409,1,0)="^^3^3^3030801^"
^DIC(19,12409,1,1,0)="Menu options used for reporting Performance Indicator information"
^DIC(19,12409,1,2,0)="involving outpatient encounters, their associated progress notes and the"
^DIC(19,12409,1,3,0)="time it takes the care providers to sign their progress notes."
^DIC(19,12409,10,0)="^19.01IP^3^3"
^DIC(19,12409,10,1,0)="12410^PMS^1"
^DIC(19,12409,10,2,0)="12411^PMD^2"
^DIC(19,12409,10,3,0)="12918^PMR"
^DIC(19,12409,10,"B",12410,1)=""
^DIC(19,12409,10,"B",12411,2)=""
^DIC(19,12409,10,"B",12918,3)=""
^DIC(19,12409,10,"C","PMD",2)=""
^DIC(19,12409,10,"C","PMR",3)=""
^DIC(19,12409,10,"C","PMS",1)=""
^DIC(19,12409,99)="65157,58373"
^DIC(19,12409,"U")="PERFORMANCE MONITOR MENU"
^DIC(19,12410,0)="SCRPW PM SUMMARY REPORT^Performance Monitor Summary Report^^R^10000000020^^^^^^^"
^DIC(19,12410,1,0)="^19.06^5^5^3030724^^"
^DIC(19,12410,1,1,0)="This option generates a summary of all Outpatient Encounters within a "
^DIC(19,12410,1,2,0)="user selected time frame. It uses nationally defined screening criteria "
^DIC(19,12410,1,3,0)="to identify encounters requiring progress notes, it then uses a TIU call "
^DIC(19,12410,1,4,0)="to retrieve progress note information. The information is then used to "
^DIC(19,12410,1,5,0)="report the number of encounters, the number of compliant notes etc. etc."
^DIC(19,12410,25)="EN^SCRPW304"
^DIC(19,12410,"U")="PERFORMANCE MONITOR SUMMARY RE"
^DIC(19,12411,0)="SCRPW PM DETAILED REPORT^Performance Monitor Detailed Report^^R^10000000020^^^^^^^"
^DIC(19,12411,1,0)="^^5^5^3030724^"
^DIC(19,12411,1,1,0)="This option generates a detailed report on information pertaining to "
^DIC(19,12411,1,2,0)="Outpatient Encounters and progress notes associated with them. It "
^DIC(19,12411,1,3,0)="identifies the encounter, the provider, was a note done on an encounter "
^DIC(19,12411,1,4,0)="and was the note signed within a given time frame. The option allows "
^DIC(19,12411,1,5,0)="users to screen and sort by different criteria."
^DIC(19,12411,25)="EN^SCRPW301"
^DIC(19,12411,"U")="PERFORMANCE MONITOR DETAILED R"
^DIC(19,12412,0)="RA PERFORMIN RPTS^Summary/Detail report^^R^10000000020^^^^^^^31"
^DIC(19,12412,1,0)="^19.06^19^19^3030408^^^"
^DIC(19,12412,1,1,0)="This option allows the supervisor to generate a report of performance "
^DIC(19,12412,1,2,0)="indicators for a user specified date range.  The indicators are hours from"
^DIC(19,12412,1,3,0)="EXAM DATE to DATE REPORT ENTERED and hours from EXAM DATE to VERIFIED"
^DIC(19,12412,1,4,0)="DATE.  The summary report will group the hours within the date range"
^DIC(19,12412,1,5,0)="into 24 hour increments. The detail report will list each exam within the"
^DIC(19,12412,1,6,0)="date range."
^DIC(19,12412,1,7,0)=" "
^DIC(19,12412,1,8,0)="Here are all the prompts  for this option:"
^DIC(19,12412,1,9,0)="   1.  Report Type: Summary, Detail, Both"
^DIC(19,12412,1,10,0)="   2.  Start Date (earliest Exam Date to include)"
^DIC(19,12412,1,11,0)="   3.  End Date (last Exam Date to include)"
^DIC(19,12412,1,12,0)="         for Summary report, this must be 90 days or less from Start Date"
^DIC(19,12412,1,13,0)="         for Detail report, this must be 30 days or lss from Start Date"
^DIC(19,12412,1,14,0)="   4.  Division:"
^DIC(19,12412,1,15,0)="   5.  Imaging Type:"
^DIC(19,12412,1,16,0)="   6.  Sort by:"
^DIC(19,12412,1,17,0)="         this is asked only if 'Detail' or 'Both' were selected"
^DIC(19,12412,1,18,0)="   7.  Sent to Mail Group? :"
^DIC(19,12412,1,19,0)="         this is asked only if 'Summary' was selected"
^DIC(19,12412,25)="RAPM"
^DIC(19,12412,"U")="SUMMARY/DETAIL REPORT"
^DIC(19,12414,0)="RA PERFORMIN MAIL GROUP ENTRY^Enter/Edit OUTLOOK mail group^^R^10000000020^^^^^^^31"
^DIC(19,12414,1,0)="^^4^4^3030408^"
^DIC(19,12414,1,1,0)="This option must be used to enter, delete, or add OUTLOOK mail groups"
^DIC(19,12414,1,2,0)="that will receive the Summary Report for Performance Indicator.  If no"
^DIC(19,12414,1,3,0)="mail group is entered, then the Summary Report will not be sent to anyone"
^DIC(19,12414,1,4,0)="in OUTLOOK."
^DIC(19,12414,25)="EN1^RAPM3"
^DIC(19,12414,"U")="ENTER/EDIT OUTLOOK MAIL GROUP"
^DIC(19,12415,0)="XUDEVEDITTRM^TRM or VTRM Device Edit^^R^10000000020^^^^^^^163^y"
^DIC(19,12415,1,0)="^19.06^1^1^3070607^^^"
^DIC(19,12415,1,1,0)="This option calls a screenman form to edit a TRM or VTRM device."
^DIC(19,12415,25)="TRM^ZISEDIT"
^DIC(19,12415,30)="%ZIS(1,"
^DIC(19,12415,31)="AEMLQ"
^DIC(19,12415,40)="[XUDEVICE TRM]"
^DIC(19,12415,41)="%ZIS(1,"
^DIC(19,12415,"U")="TRM OR VTRM DEVICE EDIT"
^DIC(19,12416,0)="XUDEVEDITLPD^LPD/VMS Device Edit^^C^10000000020^^^^^^^163"
^DIC(19,12416,1,0)="^^1^1^3030722^"
^DIC(19,12416,1,1,0)="This option calls a screenman form to edit a VMS LPD device."
^DIC(19,12416,30)="%ZIS(1,"
^DIC(19,12416,31)="AEMLQ"
^DIC(19,12416,40)="[XUDEVICE LPD]"
^DIC(19,12416,41)="%ZIS(1,"
^DIC(19,12416,"U")="LPD/VMS DEVICE EDIT"
^DIC(19,12417,0)="GMRC ADMP31 CORRECTIONS^Limited IFC Admin corrections^^R^10000000020^^^^^^^294"
^DIC(19,12417,1,0)="^^4^4^3030225^"
^DIC(19,12417,1,1,0)="This option allows the comment on a limited number of activities taken on"
^DIC(19,12417,1,2,0)="Inter-facility Consults to be corrected.  The activities that may be"
^DIC(19,12417,1,3,0)="edited are limited to those found on the post-install report from"
^DIC(19,12417,1,4,0)="GMRC*3*31."
^DIC(19,12417,25)="EN^GMRCAD31"
^DIC(19,12417,"U")="LIMITED IFC ADMIN CORRECTIONS"
^DIC(19,12418,0)="PSNODDI^Local Drugs Excluded from Drug-Drug Interactions^^R^10000000020^^^^^^^"
^DIC(19,12418,1,0)="^^3^3^3030528^"
^DIC(19,12418,1,1,0)="This report gives you a printed copy of local dispense drugs which are"
^DIC(19,12418,1,2,0)="matched to VA Products that are marked as EXCLUDE from drug-drug"
^DIC(19,12418,1,3,0)="interaction checking."
^DIC(19,12418,25)="PSNODDI"
^DIC(19,12418,"U")="LOCAL DRUGS EXCLUDED FROM DRUG"
^DIC(19,12419,0)="PSNEXMPT^VA Products Excluded from Drug-Drug Interactions^^R^10000000020^^^^^^^"
^DIC(19,12419,1,0)="^19.06^2^2^3030616^^"
^DIC(19,12419,1,1,0)="This report gives you a printed copy of active VA Products marked as"
^DIC(19,12419,1,2,0)="EXCLUDE from drug-drug interaction checking."
^DIC(19,12419,25)="PSNEXMPT"
^DIC(19,12419,"U")="VA PRODUCTS EXCLUDED FROM DRUG"
^DIC(19,12420,0)="PSO TPB PATIENT ENTER/EDIT^Transitional Pharmacy Benefit Patient Enter/Edit^PLACED OUT OF ORDER BY PSO*7*227^R^10000000020^^^^^^^141"
^DIC(19,12420,1,0)="^19.06^3^3^3030806^^"
^DIC(19,12420,1,1,0)="This option allows Clinical Pharmacist to enter/edit patient eligible for "
^DIC(19,12420,1,2,0)="the service set by the directive that allows Transitional Pharmacy Care"
^DIC(19,12420,1,3,0)="from Non-VA physicians and dentists."
^DIC(19,12420,25)="PSOTPCEE"
^DIC(19,12420,"U")="TRANSITIONAL PHARMACY BENEFIT "
^DIC(19,12421,0)="PSO TPB PATIENT REPORT^TPB Patient Report^PLACED OUT OF ORDER BY PSO*7*227^R^10000000020^^^^^^^141"
^DIC(19,12421,1,0)="^19.06^2^2^3030805^^^^"
^DIC(19,12421,1,1,0)="This option prints various reports of patients that are in the"
^DIC(19,12421,1,2,0)="TPB ELIGIBILITY file (#52.91)."
^DIC(19,12421,25)="PSOTPCRP"
^DIC(19,12421,"U")="TPB PATIENT REPORT"
^DIC(19,12422,0)="PSO TPB INSTITUTION LETTERS^TPB Institution Letter Enter/Edit^PLACED OUT OF ORDER BY PSO*7*227^R^10000000020^^^^^^^141"
^DIC(19,12422,1,0)="^19.06^2^2^3030808^^^"
^DIC(19,12422,1,1,0)="This allows the user to edit each TPB institution's information elements "
^DIC(19,12422,1,2,0)="that are to be printed in the letters to be sent to the patients."
^DIC(19,12422,25)="EDIT^PSOTPCL"
^DIC(19,12422,"U")="TPB INSTITUTION LETTER ENTER/E"
^DIC(19,12423,0)="PSO TPB PRINT LETTERS^Print TPB Patient Letter(s)^PLACED OUT OF ORDER BY PSO*7*227^R^10000000020^^^^^^^141"
^DIC(19,12423,1,0)="^^25^25^3030806^"
^DIC(19,12423,1,1,0)="This option provides the ability to print TPB letters to be sent to "
^DIC(19,12423,1,2,0)="patients. A minimum data check on the institution letters' information to"
^DIC(19,12423,1,3,0)="be printed will be performed prior to allowing the printing of the "
^DIC(19,12423,1,4,0)="patient leters."
^DIC(19,12423,1,5,0)=" "
^DIC(19,12423,1,6,0)="Patients that do not have sufficient address information for mailing will "
^DIC(19,12423,1,7,0)="not be printed and will be contained in a mailman message to the user "
^DIC(19,12423,1,8,0)="identifying patients who were skipped over."
^DIC(19,12423,1,9,0)=" "
^DIC(19,12423,1,10,0)="The user is presented several choices:"
^DIC(19,12423,1,11,0)=" "
^DIC(19,12423,1,12,0)="1) Print by Institution:"
^DIC(19,12423,1,13,0)=" "
^DIC(19,12423,1,14,0)="        a. All, or Select one or several institutions.       "
^DIC(19,12423,1,15,0)="        b. Select letters ""Printed"", ""Not Printed"", or ""Both""."
^DIC(19,12423,1,16,0)=" "
^DIC(19,12423,1,17,0)="        The letters wil print by institution and within institution"
^DIC(19,12423,1,18,0)="        alphabetically by patient."
^DIC(19,12423,1,19,0)=" "
^DIC(19,12423,1,20,0)="2) Select Patients"
^DIC(19,12423,1,21,0)="        a. All, or select one or several patients."
^DIC(19,12423,1,22,0)="        b. Select letters ""Printed"", ""Not Printed"", or ""Both""."
^DIC(19,12423,1,23,0)=" "
^DIC(19,12423,1,24,0)="        The letters wil print by institution and within institution"
^DIC(19,12423,1,25,0)="        alphabetically by patient."
^DIC(19,12423,25)="PRINT^PSOTPCLP"
^DIC(19,12423,"U")="PRINT TPB PATIENT LETTER(S)"
^DIC(19,12424,0)="PSO TPB LETTERS PRINTED REPORT^Report TPB Patients Letters Printed/NOT Printed^PLACED OUT OF ORDER BY PSO*7*227^R^10000000020^^^^^^^141"
^DIC(19,12424,1,0)="^19.06^2^2^3030811^^"
^DIC(19,12424,1,1,0)="This provides the user the ability to generate a report of patients "
^DIC(19,12424,1,2,0)="letters sent/NOT sent."
^DIC(19,12424,25)="EN^PSOTPCLR"
^DIC(19,12424,"U")="REPORT TPB PATIENTS LETTERS PR"
^DIC(19,12425,0)="PSO TPB RX ENTRY^TPB Rx (Prescription) Entry^PLACED OUT OF ORDER BY PSO*7*227^R^10000000020^^^^^^^^^1^1"
^DIC(19,12425,1,0)="^19.06^3^3^3030901^^^"
^DIC(19,12425,1,1,0)="The Transitional Pharmacy Benefit (TPB) Project provides this option to "
^DIC(19,12425,1,2,0)="the Clinical Pharmacists unless determined otherwise by the local site,"
^DIC(19,12425,1,3,0)="to process prescriptions written by NON-VA Physicians."
^DIC(19,12425,15)="K PSOTPBFG"
^DIC(19,12425,20)="D ^PSOLSET:'$D(PSOPAR) S PSOTPBFG=1"
^DIC(19,12425,25)="PSOTPRX1"
^DIC(19,12425,99)="59403,58307"
^DIC(19,12425,"U")="TPB RX (PRESCRIPTION) ENTRY"
^DIC(19,12426,0)="PSO TPB HL7 EXTRACT^TPB HL7 Data Extract/Transmission^PLACED OUT OF ORDER BY PSO*7*227^R^10000000020^^^^^^^141"
^DIC(19,12426,1,0)="^19.06^7^7^3030831^^"
^DIC(19,12426,1,1,0)="This option performs the weekly data extraction and HL7 message "
^DIC(19,12426,1,2,0)="generation and transmission from the TPB Eligibility File (#52.91)."
^DIC(19,12426,1,3,0)=" "
^DIC(19,12426,1,4,0)="***********************************************************"
^DIC(19,12426,1,5,0)="This option MUST be scheduled to run DAILY at 1800 (6:00 p.m.) local "
^DIC(19,12426,1,6,0)="time.  It will check for the day of the week and extract and transmit the "
^DIC(19,12426,1,7,0)="TPB Eligiblity data each Sunday."
^DIC(19,12426,25)="PSOTPHL1"
^DIC(19,12426,"U")="TPB HL7 DATA EXTRACT/TRANSMISS"
^DIC(19,12427,0)="PSO SCRIPTALK ENROLLEES^Report of ScripTalk Enrollees^^R^10000000020^^^^^^^141^"
^DIC(19,12427,1,0)="^19.06^4^4^3030613^^^^"
^DIC(19,12427,1,1,0)="This option will provide a report of patients who are defined to "
