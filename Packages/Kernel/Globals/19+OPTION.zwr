^DIC(19,6585,1,0)="^^6^6^2920519^^"
^DIC(19,6585,1,1,0)="This option allows the adding of additional Followup form letters,"
^DIC(19,6585,1,2,0)="and the editing of existing letters in the file. Using the Transfer"
^DIC(19,6585,1,3,0)="edit option for the MAIN FORM BODY word processing field, letters may"
^DIC(19,6585,1,4,0)="be replicated then edited to suit the users' needs. The internal number"
^DIC(19,6585,1,5,0)="of letters defined in the field must begin with the facility's number."
^DIC(19,6585,1,6,0)="This is done automatically to ensure proper identification of records."
^DIC(19,6585,25)="AED^ONCOFLF"
^DIC(19,6585,"U")="ADD/EDIT FOLLOW-UP LETTER"
^DIC(19,6587,0)="ONCO SUSPENSE-CASEFIND (LAB)^Automatic Casefinding-Lab Search^^R^.5^^^^^^^"
^DIC(19,6587,1,0)="^^9^9^2920519^^^"
^DIC(19,6587,1,1,0)="This option calls on a lab routine LRAPONC which allows the user to select"
^DIC(19,6587,1,2,0)="a lab section to search (Surgical Pathology, Cytology or Autopsy). A"
^DIC(19,6587,1,3,0)="temporary global is created storing the 'malignancy' entries found during"
^DIC(19,6587,1,4,0)="the time period selected. The option then creates an entry in the"
^DIC(19,6587,1,5,0)="Oncology patient file along with other 'suspense' information. If the"
^DIC(19,6587,1,6,0)="patient is already defined in the Oncology Patient file, a check is made"
^DIC(19,6587,1,7,0)="to see if a primary is defined with a diagnosis date which is the same"
^DIC(19,6587,1,8,0)="as the date of the lab test. If it isn't the same, the patient is then"
^DIC(19,6587,1,9,0)="put in 'suspense' using the date of the lab test found."
^DIC(19,6587,25)="ONCOCFL"
^DIC(19,6587,99)="55750,51209"
^DIC(19,6587,"U")="AUTOMATIC CASEFINDING-LAB SEAR"
^DIC(19,6588,0)="ONCO ANNUAL-ANAL/SITE/DX-AGE^Annual Status/Site/Dx-Age (132c)^^R^.5^^^^^^^"
^DIC(19,6588,1,0)="^^3^3^2920519^^^"
^DIC(19,6588,1,1,0)="Annual report which sorts first by accession year, then class category, "
^DIC(19,6588,1,2,0)="by status, site/pr and diagnosis age group. It gives subcounts for accessi"
^DIC(19,6588,1,3,0)="year, Site/gp and Dx Age Group for the field of Accession/Sequence number."
^DIC(19,6588,25)="SDX^ONCOPAR"
^DIC(19,6588,"U")="ANNUAL STATUS/SITE/DX-AGE (132"
^DIC(19,6589,0)="ONCO ANNUAL-HIST/SITE/ICDO^Annual Histology/Site/Topography (80c)^^R^.5^^^^^^^"
^DIC(19,6589,1,0)="^^2^2^2920803^^"
^DIC(19,6589,1,1,0)="Annual report which sorts first by accession year, then Histology, within"
^DIC(19,6589,1,2,0)="Histology, by Site, within Site by IDCO Topography."
^DIC(19,6589,25)="HIS^ONCOPAR"
^DIC(19,6589,99)="55740,41524"
^DIC(19,6589,"U")="ANNUAL HISTOLOGY/SITE/TOPOGRAP"
^DIC(19,6590,0)="ONCO ABSTRACT-MULTIPLE^Print QA/Multiple Abstracts^^R^1^^^^^^^"
^DIC(19,6590,1,0)="^^1^1^2910630^"
^DIC(19,6590,1,1,0)="Option to print more than one abstract."
^DIC(19,6590,25)="ONCOPMA"
^DIC(19,6590,99)="55770,35259"
^DIC(19,6590,"U")="PRINT QA/MULTIPLE ABSTRACTS"
^DIC(19,6591,0)="ONCO SUSPENSE-CASEFIND LAB-RPT^Print Casefinding-Lab Report^^R^.5^^^^^^^"
^DIC(19,6591,1,0)="^^1^1^2920519^^"
^DIC(19,6591,1,1,0)="This option will print the Lab report for the casefinding option."
^DIC(19,6591,25)="CFR^ONCOCFL"
^DIC(19,6591,99)="55013,52612"
^DIC(19,6591,"U")="PRINT CASEFINDING-LAB REPORT"
^DIC(19,6592,0)="ONCO SUSPENSE-CASEFIND (PTF)^Automatic Casefinding-PTF Search^^R^.5^^^^^^^"
^DIC(19,6592,1,0)="^^3^3^2920519^^"
^DIC(19,6592,1,1,0)="This option will search the PTF file for a specified time frame and pick"
^DIC(19,6592,1,2,0)="out ICD9 codes from 140.0 to 239.9. It will add entries to the Oncology"
^DIC(19,6592,1,3,0)="Patient file if they are not already there for that episode."
^DIC(19,6592,25)="ONCOCFP"
^DIC(19,6592,"U")="AUTOMATIC CASEFINDING-PTF SEAR"
^DIC(19,6593,0)="ONCO SUSPENSE-CASEFIND (RAD)^Automatic Casefinding-Radiology Search^^R^.5^^^^^^^"
^DIC(19,6593,1,0)="^^3^3^2920204^"
^DIC(19,6593,1,1,0)="This option will search the Radiology file for specified time-frame to"
^DIC(19,6593,1,2,0)="find cases that are coded for suspicious malignancies. An entry is made"
^DIC(19,6593,1,3,0)="in the Oncology Patient file if one is not already there."
^DIC(19,6593,25)="ONCOCFR"
^DIC(19,6593,"U")="AUTOMATIC CASEFINDING-RADIOLOG"
^DIC(19,6594,0)="ONCO ABSTRACT-EDIT^Abstract Edit Primary^^R^1^^^^^^^"
^DIC(19,6594,1,0)="^^1^1^2960130^^^^"
^DIC(19,6594,1,1,0)="Edit primary for Oncology"
^DIC(19,6594,20)=""
^DIC(19,6594,25)="ED^ONCOAIP"
