^DIC(19,4457,0)="PSGW WARD CONVERSION^Ward (For Item) Conversion^^R^.5^^^^^^^"
^DIC(19,4457,1,0)="^^6^6^2890809^^^^"
^DIC(19,4457,1,1,0)="This option will enable a user to change the WARD (FOR ITEM) designation"
^DIC(19,4457,1,2,0)="from the old ward to a new ward for all Items in all AOUs or a single AOU."
^DIC(19,4457,1,3,0)="This can be used, for example, when a ward is closed down for construction."
^DIC(19,4457,1,4,0)="A background job can be queued for a later time to do the conversion and"
^DIC(19,4457,1,5,0)="a MailMan message will be sent to the person who queued the job when it"
^DIC(19,4457,1,6,0)="has run to completion."
^DIC(19,4457,25)="PSGWCHG"
^DIC(19,4457,"U")="WARD (FOR ITEM) CONVERSION"
