^DIC(19,4360,1,1,0)="Use this option to recalculate all Fund Control Balances "
^DIC(19,4360,1,2,0)="for the Control Point Activity user.  This option is "
^DIC(19,4360,1,3,0)="included in your menu to update balances for all "
^DIC(19,4360,1,4,0)="automated Fund Control Points.  This recalculation is "
^DIC(19,4360,1,5,0)="necessary when the computer ""crashes"" (loses power).  "
^DIC(19,4360,1,6,0)="The transactions being processed when a ""crash"" occurs "
^DIC(19,4360,1,7,0)="do not update the Control Point records.  Therefore, "
^DIC(19,4360,1,8,0)="you may need to use this option to recalculate the Fund "
^DIC(19,4360,1,9,0)="Control Point balances in Fiscal."
^DIC(19,4360,25)="PRCBRCP"
^DIC(19,4360,200)="^^7D^SMA"
^DIC(19,4360,"U")="RECALCULATE ALL FUND CONTROL P"
^DIC(19,4361,0)="PRCB CPA RUNNING BALANCE^Display Control Point Official's Balance^^R^11740^^^^^^^121"
^DIC(19,4361,1,0)="^^1^1^2941207^^"
^DIC(19,4361,1,1,0)="This options displays a selected Control Point Officials balance."
^DIC(19,4361,25)="PRCBRBR"
^DIC(19,4361,99)="55655,49919"
^DIC(19,4361,"U")="DISPLAY CONTROL POINT OFFICIAL"
^DIC(19,4362,0)="PRCB ENTER CEILING TRANS^Place Released Ceiling Transaction in CP File^^R^11740^^2923^^^^^"
^DIC(19,4362,1,0)="^^18^18^2941108^^^^"
^DIC(19,4362,1,1,0)=" "
^DIC(19,4362,1,2,0)="Use this option when you automate Control Points at your "
^DIC(19,4362,1,3,0)="facility.  In most cases, you will be planning the "
^DIC(19,4362,1,4,0)="implementation of IFCAP at the Control Point level in"
^DIC(19,4362,1,5,0)="stages.  Use this option after you have Released all"
^DIC(19,4362,1,6,0)="Funding (Ceiling) Transactions for your facility and"
^DIC(19,4362,1,7,0)="a Control Point is just now being automated, in other"
^DIC(19,4362,1,8,0)="words, the funds have already been released "
^DIC(19,4362,1,9,0)="automatically.  You cannot re-release the ceiling, but"
^DIC(19,4362,1,10,0)="you can use this option to enter the ceiling amount "
^DIC(19,4362,1,11,0)="into the Control Point Official's balance.  This option "
^DIC(19,4362,1,12,0)="will not place an entry onto the budget balance for the "
^DIC(19,4362,1,13,0)="Control Point; because this entry was made when the "
^DIC(19,4362,1,14,0)="original transaction was posted.  Fiscal service uses "
^DIC(19,4362,1,15,0)="this option to enter a ceiling transaction into a Control"
^DIC(19,4362,1,16,0)="Point file.  Only use this option when a Control Point "
^DIC(19,4362,1,17,0)="is being automated after funds have already been "
^DIC(19,4362,1,18,0)="released through the funds distribution option."
^DIC(19,4362,25)="PRCBR2"
^DIC(19,4362,99)="55530,54848"
^DIC(19,4362,"U")="PLACE RELEASED CEILING TRANSAC"
