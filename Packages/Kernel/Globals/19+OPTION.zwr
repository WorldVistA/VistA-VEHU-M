^DIC(19,7960,1,2,0)="in File 450. Change will be reflected in stub record of next"
^DIC(19,7960,1,3,0)="pay transmission to Austin."
^DIC(19,7960,25)="EMP^PRSATL"
^DIC(19,7960,"U")="CHANGE EMPLOYEE T&L UNIT"
