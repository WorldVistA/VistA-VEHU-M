^DIC(19,16232,20)=""
^DIC(19,16232,25)="LEXDMG"
^DIC(19,16232,"U")="EDIT USER/USER GROUP DEFAULTS"
^DIC(19,16233,0)="EHM-01054^List User/User Group Defaults^^R^1^^^^^^^512^^^^"
^DIC(19,16233,1,0)="^^3^3^3240328^^^"
^DIC(19,16233,1,1,0)="This options allows a manager to list user defaults to a device for either"
^DIC(19,16233,1,2,0)="a single user or a user group (based on service or location)."
^DIC(19,16233,1,3,0)="Cloned from ""LEX MGR LIST DEFAULTS"" option."
^DIC(19,16233,3)=""
^DIC(19,16233,20)=""
^DIC(19,16233,25)="LEXDD1"
^DIC(19,16233,"U")="LIST USER/USER GROUP DEFAULTS"
^DIC(19,16234,0)="EHM-01055^Patient Record Flags Main Menu^^M^1^^^^^^^^^^^"
^DIC(19,16234,1,0)="^19.06^3^3^3240328^^^^"
^DIC(19,16234,1,1,0)="This menu option contains all menus and options needed to assign,"
^DIC(19,16234,1,2,0)="manage, and report patient record flag information."
^DIC(19,16234,1,3,0)="Cloned from ""DGPF RECORD FLAGS MAIN MENU"" option."
