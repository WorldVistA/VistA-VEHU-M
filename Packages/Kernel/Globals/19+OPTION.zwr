^DIC(19,16271,0)="EHM-01092^Edit Skin Test Reading CPT Code^^A^1^^^^^^^^^1^^"
^DIC(19,16271,1,0)="^^4^4^3240328^"
^DIC(19,16271,1,1,0)="This option is used to edit the CPT code that should be automatically"
^DIC(19,16271,1,2,0)="filed when a skin test reading is recorded. If blank, a CPT code will not "
^DIC(19,16271,1,3,0)="automatically be filed when a skin test reading entry is saved."
^DIC(19,16271,1,4,0)="Cloned from ""PXV SKIN TEST READING CPT"" option."
^DIC(19,16271,3)=""
^DIC(19,16271,20)="D EDITPAR^XPAREDIT(""PXV SKIN TEST READING CPT"")"
