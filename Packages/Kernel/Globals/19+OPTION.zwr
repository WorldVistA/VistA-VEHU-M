^DIC(19,14886,0)="RA OVERRIDE REPORT^Exams Overridden to 'Complete' per Directive^^R^1^RA MGR^^^^^y^31"
^DIC(19,14886,1,0)="^19.06^6^6^3200721^^^"
^DIC(19,14886,1,1,0)="'RA OVERRIDE REPORT' generates a report which displays all the radiology"
^DIC(19,14886,1,2,0)="studies overridden to 'Complete' by radiology patch RA*5.0*160. The user "
^DIC(19,14886,1,3,0)="is allowed to select the date range."
^DIC(19,14886,1,4,0)=" "
^DIC(19,14886,1,5,0)="Note that radiology patch RA*5.0*160 did not impact radiology exams "
^DIC(19,14886,1,6,0)="registered after December 31st 2008."
^DIC(19,14886,25)="RAMAORPT"
^DIC(19,14886,"U")="EXAMS OVERRIDDEN TO 'COMPLETE'"
^DIC(19,14887,0)="RCDPE AUTO-DECREASE 1ST PARTY^First Party COPAY Auto-Decrease Report^^R^1^^^^^^^261^^"
