^DIC(19,11436,99)="59254,80399"
^DIC(19,11436,"U")="PERSONAL PREFERENCES"
^DIC(19,11437,0)="XMEDITSURR^Surrogate Edit^^R^11748^^3151^^^^^54"
^DIC(19,11437,1,0)="^^3^3^2971126^"
^DIC(19,11437,1,1,0)="This option enables you to edit your surrogate list, that is,"
^DIC(19,11437,1,2,0)="to choose who may act as a surrogate for you in MailMan,"
^DIC(19,11437,1,3,0)="and which privileges (read and/or send) you wish to grant them."
^DIC(19,11437,25)="SURR^XMVVITA"
^DIC(19,11437,"U")="SURROGATE EDIT"
^DIC(19,11438,0)="XM DELIVERY BASKET EDIT^Delivery Basket Edit^^R^11748^^3158^^^^^54"
^DIC(19,11438,1,0)="^^5^5^2980518^^"
^DIC(19,11438,1,1,0)="The sender of a message may specify the basket to which the message should"
^DIC(19,11438,1,2,0)="be delivered for all recipients."
^DIC(19,11438,1,3,0)=""
^DIC(19,11438,1,4,0)="Using this option, you indicate whether or not you accept such target"
^DIC(19,11438,1,5,0)="basket delivery, and if you do, to what degree you accept it."
^DIC(19,11438,25)="BASKET^XMVVITA"
^DIC(19,11438,"U")="DELIVERY BASKET EDIT"
^DIC(19,11439,0)="IB MT ON HOLD FIX^Clean-up option for patch IB*2*95^^R^10000000033^IB SUPERVISOR^^^^^^192"
^DIC(19,11439,1,0)="^^17^17^2981117^"
^DIC(19,11439,1,1,0)="This option should be assigned to the person responsible for insuring IB"
^DIC(19,11439,1,2,0)="Actions are processed correctly.  This option should be deleted once the"
^DIC(19,11439,1,3,0)="clean-up process is complete."
^DIC(19,11439,1,4,0)=" "
^DIC(19,11439,1,5,0)="Select this option to perform one of three actions:"
^DIC(19,11439,1,6,0)=" "
^DIC(19,11439,1,7,0)="     1. List all INTEGRATED BILLING ACTIONS with a status of INCOMPLETE."
^DIC(19,11439,1,8,0)="     2. List all INTEGRATED BILLING ACTIONS with a status of COMPLETE/"
^DIC(19,11439,1,9,0)="        PENDING AR."
^DIC(19,11439,1,10,0)="     3. Repost INTEGRATED BILLING ACTIONS with a status of COMPLETE/"
^DIC(19,11439,1,11,0)="        PENDING AR and pass these charges to AR."
^DIC(19,11439,1,12,0)="  "
^DIC(19,11439,1,13,0)="Please note that when selecting item #3, the software will attempt to"
^DIC(19,11439,1,14,0)="process the IB actions with a status of COMPLETE.  Some of these IB"
^DIC(19,11439,1,15,0)="Actions will be placed ON HOLD with the ON HOLD DATE set to TODAY, while"
^DIC(19,11439,1,16,0)="other IB Actions will be passed to AR and patients will be billed"
^DIC(19,11439,1,17,0)="IMMEDIATELY."
^DIC(19,11439,25)="IBOHFIX"
^DIC(19,11439,99.1)="57763,7912"
^DIC(19,11439,"U")="CLEAN-UP OPTION FOR PATCH IB*2"
^DIC(19,11440,0)="GMRC UPDATE AUTHORITY^Determine users' update authority^^R^11597^^^^^^^294^^1"
^DIC(19,11440,1,0)="^^2^2^2990722^^"
^DIC(19,11440,1,1,0)="This option will determine a selected user's update authority for a"
^DIC(19,11440,1,2,0)="selected service in the consult hierarchy."
^DIC(19,11440,20)="D TSTINTRO^GMRCAU"
^DIC(19,11440,25)="TEST^GMRCAU"
^DIC(19,11440,"U")="DETERMINE USERS' UPDATE AUTHOR"
^DIC(19,11441,0)="GMRC USER NOTIFICATION^Determine if user is notification recipient^^R^11597^^^^^^^294^^1"
^DIC(19,11441,1,0)="^^2^2^2990722^^"
^DIC(19,11441,1,1,0)="This option will determine if a user would be a notification recipient"
