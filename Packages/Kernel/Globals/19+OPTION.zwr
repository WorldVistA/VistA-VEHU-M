^DIC(19,2340,"U")="MANAGEMENT REPORTS MENU"
^DIC(19,2341,0)="PSJU PRVR^PRovider (Cost per)^^R^11712^^^^^^^117"
^DIC(19,2341,1,0)="^^4^4^2910312^^^^"
^DIC(19,2341,1,1,0)="  Prints a COST BY PROVIDER report for a date range entered by user.  This"
^DIC(19,2341,1,2,0)="report shows each medication, the amount dispensed, and cost for each"
^DIC(19,2341,1,3,0)="provider.  This report also shows sub-totals for each provider and totals"
^DIC(19,2341,1,4,0)="for all providers at the end of the report."
^DIC(19,2341,25)="PSGPRVR"
^DIC(19,2341,"U")="PROVIDER (COST PER)"
^DIC(19,2342,0)="PSJU PO PURGE^PATient Order Purge^TEMPORARILY UNAVAILABLE^R^11712^^^^^^^117"
^DIC(19,2342,1,0)="^^6^6^2910312^^^^"
^DIC(19,2342,1,1,0)="  Allows the user to purge the orders of patients who have been discharged."
^DIC(19,2342,1,2,0)="When a patient is discharged, the patient's orders for that admission are"
^DIC(19,2342,1,3,0)="grouped together by the discharge date.  When the user selects a date, a"
^DIC(19,2342,1,4,0)="background job is started to delete all orders associated with all discharge"
^DIC(19,2342,1,5,0)="dates previous to the date selected.  When finished, a report is produced"
^DIC(19,2342,1,6,0)="showing the number of orders purged."
^DIC(19,2342,25)=""
^DIC(19,2342,"U")="PATIENT ORDER PURGE"
^DIC(19,2344,0)="PSJU PLDEL^Delete a Pick List^^R^11712^^^^^^^117"
^DIC(19,2344,1,0)="^^2^2^2910312^^^^"
^DIC(19,2344,1,1,0)="  Allows a user to delete the latest pick list for a ward group that"
^DIC(19,2344,1,2,0)="has been run but not yet filed away."
^DIC(19,2344,25)="PSGPLD"
^DIC(19,2344,"U")="DELETE A PICK LIST"
^DIC(19,2346,0)="PSJU OSE^Order Set Enter/Edit^^R^11712^^^^^^^117"
^DIC(19,2346,1,0)="^^4^4^2970910^^^^"
^DIC(19,2346,1,1,0)="  Allows the user to create and/or edit ORDER SETS for use in order"
^DIC(19,2346,1,2,0)="entry.  An ORDER SET is one or more orders grouped together to be"
^DIC(19,2346,1,3,0)="entering for a patient at one time, by entered a ""S."" and the name of the"
^DIC(19,2346,1,4,0)="order set at the DRUG prompt in order entry."
^DIC(19,2346,25)="ENOSE^PSGFILED"
^DIC(19,2346,"U")="ORDER SET ENTER/EDIT"
^DIC(19,2348,0)="PSJU HOLD ALL^Hold All of a Patient's Orders^^R^11712^PSJU RPH^^^^^^117"
^DIC(19,2348,1,0)="^^3^3^2940714^^^^"
^DIC(19,2348,1,1,0)="  Allows a Pharmacist or a Nurse to place all a patient's orders on hold,"
^DIC(19,2348,1,2,0)="or take all of the patient's orders off of hold.  (Orders placed on hold"
^DIC(19,2348,1,3,0)="may still automatically expire.)"
^DIC(19,2348,25)="EN^PSGOEHA"
^DIC(19,2348,"U")="HOLD ALL OF A PATIENT'S ORDERS"
^DIC(19,2350,0)="PSJU CPDD^Edit Patient's Default Stop Date^^R^11712^PSJU PL^^^^^^117"
^DIC(19,2350,1,0)="^^5^5^2910312^^^^"
^DIC(19,2350,1,1,0)="  Allows a pharmacist (or pharmacy technician) to edit the selected"
^DIC(19,2350,1,2,0)="patient's Default Stop Date.  If the corresponding site parameter is"
^DIC(19,2350,1,3,0)="turned on, this date is used as a default stop date value when orders"
^DIC(19,2350,1,4,0)="are entered or renewed for the patient.  The entry and renewal processes"
^DIC(19,2350,1,5,0)="may change this date."
^DIC(19,2350,25)="ENCPDD^PSGFILED"
^DIC(19,2350,"U")="EDIT PATIENT'S DEFAULT STOP DA"
^DIC(19,2351,0)="PSJU PLATCS^Send Pick List to ATC^^R^11740^PSJU PL^^^^^^117"
^DIC(19,2351,1,0)="^^4^4^3000718^"
^DIC(19,2351,1,1,0)="  Allows the user to have the appropriate meds from a selected Pick List"
^DIC(19,2351,1,2,0)="dispensed through the ATC machine.  PLEASE NOTE that only those meds on"
^DIC(19,2351,1,3,0)="the pick list that have the appropriate ATC data (canister number and"
^DIC(19,2351,1,4,0)="mnemonic) will dispense through the ATC."
^DIC(19,2351,25)="EN^PSGTAP"
^DIC(19,2351,"U")="SEND PICK LIST TO ATC"
