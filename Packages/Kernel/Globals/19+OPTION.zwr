^DIC(19,16251,"U")="PCE TABLE MAINTENANCE"
^DIC(19,16252,0)="EHM-01073^PCE Information Only^^M^1^^^^^^y^507^^^^"
^DIC(19,16252,1,0)="^19.06^16^16^3240328^^^^"
^DIC(19,16252,1,1,0)="This is a menu of options that list information about the files/tables"
^DIC(19,16252,1,2,0)="used by the Patient Care Encounter (PCE) package.  Some of the"
^DIC(19,16252,1,3,0)="files/tables determine what clinical data will be collected as the sites'"
^DIC(19,16252,1,4,0)="clinical terminology for specific categories of data such as"
^DIC(19,16252,1,5,0)="Immunizations, Skin Tests, Patient Education, and Treatments."
^DIC(19,16252,1,6,0)=" "
^DIC(19,16252,1,7,0)="The PCE Code Mapping file determines whether two entries should be made"
^DIC(19,16252,1,8,0)="from one clinical data item entered.  For example, if an immunization is"
^DIC(19,16252,1,9,0)="entered into the V Immunization file, a CPT code is generated in the V CPT"
^DIC(19,16252,1,10,0)="file for billing and workload.  The mapping definition of the CPT"
^DIC(19,16252,1,11,0)="relationship with the Immunization type is viewable from the PCE Code"
^DIC(19,16252,1,12,0)="Mapping list option."
^DIC(19,16252,1,13,0)="  "
^DIC(19,16252,1,14,0)="The reminder lists allow the user to see what the clinical reminders"
^DIC(19,16252,1,15,0)="definitions are for use with the Health Summary package."
^DIC(19,16252,1,16,0)="Cloned from ""PXTT PCE INFORMATION ONLY"" option."
^DIC(19,16252,3)=""
^DIC(19,16252,10,0)="^19.01IP^11^11"
^DIC(19,16252,10,1,0)="16253^EDA^1"
^DIC(19,16252,10,2,0)="16254^EDL^2"
