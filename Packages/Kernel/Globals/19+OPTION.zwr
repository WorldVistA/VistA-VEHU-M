^DIC(19,12173,1,0)="^19.06^1^1^3001207^^"
^DIC(19,12173,1,1,0)="This menu provides functions related to Radiology HL7 interfaces"
^DIC(19,12173,10,0)="^19.01IP^4^4"
^DIC(19,12173,10,1,0)="12172^RS"
^DIC(19,12173,10,2,0)="11443^ERR"
