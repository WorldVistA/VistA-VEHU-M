^DIC(19,6639,20)="W @IOF,!!!,?15,""Follow-up Procedures Menu"",!!!"
^DIC(19,6639,99)="67166,55999"
^DIC(19,6639,"U")="FOLLOW-UP PROCEDURES MENU"
^DIC(19,6640,0)="ONCO FOLL-ADD CONTACT^Add Patient Contact^^R^.5^^^^^^^"
^DIC(19,6640,1,0)="^^8^8^2920519^^"
^DIC(19,6640,1,1,0)="Upon selection of a patient, the program called pulls over the data"
^DIC(19,6640,1,2,0)="from MAS that is relevant to patient contacts: names and addresses of the"
^DIC(19,6640,1,3,0)="patient, next of kin (NOK), next of kin-2 (KIN), and the guardian. The"
^DIC(19,6640,1,4,0)="information is 'pulled over' and defined in the contact file, and"
^DIC(19,6640,1,5,0)="displayed, permitting the user to edit the data present in the contact file,"
^DIC(19,6640,1,6,0)="or to add new contacts not already defined.  The user has the choice of"
^DIC(19,6640,1,7,0)="continuing with this patient and making an attempt at follow-up, or to"
^DIC(19,6640,1,8,0)="continue adding contacts for another patient."
^DIC(19,6640,25)="DCL^ONCOFUL"
^DIC(19,6640,99)="55711,48758"
^DIC(19,6640,"U")="ADD PATIENT CONTACT"
^DIC(19,6641,0)="ONCO FOLL-ATTEMPT FOLLOWUP^Attempt a Follow-up^^R^.5^^^^^^^"
^DIC(19,6641,1,0)="^^6^6^2920519^^"
^DIC(19,6641,1,1,0)="Allows for the tracking of follow-up attempts, successful or non-successful."
^DIC(19,6641,1,2,0)="Select date, contact, type of contact - the letter status is set to"
^DIC(19,6641,1,3,0)="""pending"" automatically. Selection of letter to send is linked to the"
^DIC(19,6641,1,4,0)="type of follow-up selected. Successful contacts lead into posting of"
^DIC(19,6641,1,5,0)="follow-up. This process then allows for not only tracking the follow-up"
^DIC(19,6641,1,6,0)="history, but the attempt history as well."
^DIC(19,6641,25)="ATM^ONCOFUL"
^DIC(19,6641,"U")="ATTEMPT A FOLLOW-UP"
^DIC(19,6642,0)="ONCO FOLL-PRINT LETTER^Print Follow-up Letter^^R^.5^^^^^^^"
^DIC(19,6642,1,0)="^^2^2^2920519^^"
^DIC(19,6642,1,1,0)="Allows selection of patient, choosing a contact person to send a letter"
^DIC(19,6642,1,2,0)="to, and then the type of letter depending upon the type of contact."
^DIC(19,6642,25)="SCL^ONCOFUP"
^DIC(19,6642,99)="55700,41419"
^DIC(19,6642,"U")="PRINT FOLLOW-UP LETTER"
^DIC(19,6643,0)="ONCO FOLL-PATIENT INQUIRY^Patient Follow-up Inquiry^^R^.5^^^^^^^"
^DIC(19,6643,1,0)="^^4^4^2960125^^^"
^DIC(19,6643,1,1,0)="On-line basic information is made available to the Tumor Registrar"
^DIC(19,6643,1,2,0)="after selecting a patient. This option is most useful upon receipt"
^DIC(19,6643,1,3,0)="of phone-calls by other Hospitals/Tumor registrars attempting follow-up"
^DIC(19,6643,1,4,0)="of patients they may be treating or following."
^DIC(19,6643,25)="IN^ONCOFUL"
^DIC(19,6643,"U")="PATIENT FOLLOW-UP INQUIRY"
^DIC(19,6644,0)="ONCO FOLL-PAT FOLLOWUP REPORT^Individual Follow-up Report^Marked for deletion^R^10000000216^^^^^^^"
^DIC(19,6644,1,0)="^^1^1^2991202^^"
^DIC(19,6644,1,1,0)="Prints complete followup-report."
^DIC(19,6644,25)="PFR^ONCOPRT"
^DIC(19,6644,"U")="INDIVIDUAL FOLLOW-UP REPORT"
^DIC(19,6645,0)="ONCO STAT-DEFINE SEARCHES^Define Search Criteria^^R^.5^^^^^^^^^^1"
^DIC(19,6645,1,0)="^^2^2^2920519^^"
^DIC(19,6645,1,1,0)="Allows selection of a file for search, and then calls for search criteria -"
^DIC(19,6645,1,2,0)="then definition of search template, which can be run across data."
^DIC(19,6645,15)="Q"
^DIC(19,6645,20)=""
^DIC(19,6645,25)="SER^ONCOSO"
^DIC(19,6645,"U")="DEFINE SEARCH CRITERIA"
^DIC(19,6647,0)="ONCO STAT-SURVIVAL STAGE^Survival by Stage^^R^.5^^^^^^^^^1^1"
^DIC(19,6647,1,0)="^^4^4^2920519^^"
^DIC(19,6647,1,1,0)="Provided data is available and on line, life tables and survival curve"
^DIC(19,6647,1,2,0)="are produced, over the whole registry, divided into four stage groups."
^DIC(19,6647,1,3,0)="Curves produced show stages I and II with much better survival rates than"
^DIC(19,6647,1,4,0)="those diseases in stages III and IV."
^DIC(19,6647,15)="Q"
^DIC(19,6647,20)="W @IOF,!!!,?10,""SURVIVAL by Stage of Disease (All)"",!!"
^DIC(19,6647,25)="STG^ONCOSSAT"
^DIC(19,6647,99)="55789,54422"
^DIC(19,6647,"U")="SURVIVAL BY STAGE"
^DIC(19,6648,0)="ONCO ANNUAL-SITE/STG/TX^Annual Primary Site/Stage/Tx (132c)^^R^.5^^^^^^^"
^DIC(19,6648,1,0)="^^3^3^2910620^"
^DIC(19,6648,1,1,0)="This option prints a 132 column report of four kinds of treatment:"
^DIC(19,6648,1,2,0)="first sorted by Primary Site/GP, then by AJCC Summary Stage Group, then"
^DIC(19,6648,1,3,0)="by Treatment. It counts number in Stage Group and number in Treatment."
^DIC(19,6648,25)="SST^ONCOPAR"
^DIC(19,6648,"U")="ANNUAL PRIMARY SITE/STAGE/TX ("
