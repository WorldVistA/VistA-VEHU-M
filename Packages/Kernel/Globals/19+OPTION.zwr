^DIC(19,14673,0)="RCDPE AUTO-POST RECEIPT REPORT^Auto-Posted Receipt Report^^R^11720^^^^^^^261"
^DIC(19,14673,1,0)="^^2^2^3170329^"
^DIC(19,14673,1,1,0)="The Auto-Posted Receipt Report (APR) option displays receipt details"
^DIC(19,14673,1,2,0)="associated with auto-posted ERA/EFT, including totals."
^DIC(19,14673,25)="EN^RCDPELAR"
^DIC(19,14673,668000,0)="^19.0668^1^1"
