^DIC(19,12663,0)="MAGD FIX CLINSPEC DICOM FILE^Correct Clinical Specialties DICOM File Entries^^R^10000000020^^^^^^^530"
^DIC(19,12663,1,0)="^^7^7^3020816^"
^DIC(19,12663,1,1,0)="This menu option will allow corrections to be made on DICOM files which "
^DIC(19,12663,1,2,0)="failed during the downloading process on DICOM Image gateways.  The "
^DIC(19,12663,1,3,0)="routine used on the Dicom Image gateway will sometime fail to match "
^DIC(19,12663,1,4,0)="exactly on the patient's name, ssn or GMR number and thus a reference to "
^DIC(19,12663,1,5,0)="the failed file will be written to the MAGD(2006.575 global. This menu "
^DIC(19,12663,1,6,0)="option will read from this global and allow manual corrections so the "
^DIC(19,12663,1,7,0)="entries can be reprocessed on the DICOM Image gateways."
^DIC(19,12663,25)="START^MAGDCCSD"
^DIC(19,12663,"U")="CORRECT CLINICAL SPECIALTIES D"
