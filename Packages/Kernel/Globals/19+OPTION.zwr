^DIC(19,11316,0)="AJK1UB RATE TYPE FLAG^Bill/Claim Rate Type Flag^^R^11600^^^^^^^^^1"
^DIC(19,11316,1,0)="^^4^4^2990420^"
^DIC(19,11316,1,1,0)="This option is used to flag those BILLING RATE TYPES which are assigned to"
^DIC(19,11316,1,2,0)="collectable bills as being transmitable.  Only BILLS with flagged rate"
^DIC(19,11316,1,3,0)="types assigned in the BILL/CLAIM file will be considered for transmission"
^DIC(19,11316,1,4,0)="purposes."
^DIC(19,11316,20)="S X=$$RATE^AJK1UBDP(1)"
^DIC(19,11316,25)="RATE^AJK1UBM"
^DIC(19,11316,"U")="BILL/CLAIM RATE TYPE FLAG"
^DIC(19,11317,0)="ORCM DISABLE^Disable/Enable order dialogs^^R^11712^^^^^^^"
^DIC(19,11317,1,0)="^^2^2^2990212^"
^DIC(19,11317,1,1,0)="This option lets you disable order dialogs so that execution will be"
^DIC(19,11317,1,2,0)="prevented if selected; dialogs may also be re-enabled in this option."
^DIC(19,11317,25)="DISABLE^ORCMEDT5"
^DIC(19,11317,"U")="DISABLE/ENABLE ORDER DIALOGS"
^DIC(19,11318,0)="PXRM REMINDER EXCHANGE^Reminder Exchange^^R^10000000020^^^^^^^534"
^DIC(19,11318,1,0)="^19.06^2^2^3071129^^^^"
^DIC(19,11318,1,1,0)="This option allows sites to exchange reminder definitions via MailMan"
^DIC(19,11318,1,2,0)="messages and host files."
^DIC(19,11318,25)="START^PXRMEXLM"
^DIC(19,11318,"U")="REMINDER EXCHANGE"
^DIC(19,11319,0)="TIUZZ65 CLEANUP AFTER PTCH 65^Reset TIU XREF ACLPT05^^A^11597^^^^^^^^^1"
^DIC(19,11319,1,0)="^^12^12^2990331^"
^DIC(19,11319,1,1,0)="This option should be run AFTER patch TIU*1*65 has been installed.  [Since"
^DIC(19,11319,1,2,0)="patch 65 contains a NEW cross reference, running this option before"
^DIC(19,11319,1,3,0)="installing patch 65 will NOT update documents as desired.]"
^DIC(19,11319,1,4,0)=" "
^DIC(19,11319,1,5,0)="The option goes through the TIU DOCUMENT file (8925) and adds entries with"
^DIC(19,11319,1,6,0)="status COMPLETE to the ACLPT Cross- Reference. Documents SIGNED ON CHART"
^DIC(19,11319,1,7,0)="before patch TIU*1*65 may have been omitted from this Cross Reference,"
^DIC(19,11319,1,8,0)="causing them to not display under TIU option 2B Review Progress Notes [TIU"
^DIC(19,11319,1,9,0)="OE/RR REVIEW PROG NOTES]."
^DIC(19,11319,1,10,0)=" "
^DIC(19,11319,1,11,0)="This option executes the SET LOGIC for Cross Reference ACLPT05. The option"
^DIC(19,11319,1,12,0)="should be deleted when it has run successfully. It may be run over itself."
^DIC(19,11319,20)="D CLXREF^TIUZZ65"
^DIC(19,11319,"U")="RESET TIU XREF ACLPT05"
^DIC(19,11322,0)="WV SAVE LAB TEST^Save Lab Test as Procedure^^R^11712^^^^^^^522"
^DIC(19,11322,1,0)="^^11^11^2990303^^"
^DIC(19,11322,1,1,0)="This option is used to save lab tests as procedure entries in the Women's"
^DIC(19,11322,1,2,0)="Health package. Lab tests for cytology and surgical pathology are passed"
^DIC(19,11322,1,3,0)="to the Women's Health package from the Lab package and stored in the WV"
^DIC(19,11322,1,4,0)="LAB TESTS (#790.08) file. This option allows the user to dispose of the"
^DIC(19,11322,1,5,0)="lab tests either by 1) converting the lab test data into a Women's Health"
^DIC(19,11322,1,6,0)="package procedure, 2) deleting the lab test from the WV LAB TEST file"
^DIC(19,11322,1,7,0)="(i.e., don't convert it into a Women's Health procedure), or 3) ignore the"
^DIC(19,11322,1,8,0)="lab test for the time being."
^DIC(19,11322,1,9,0)=" "
^DIC(19,11322,1,10,0)="After converting the lab test into a Women's Health procedure, the user"
^DIC(19,11322,1,11,0)="may edit and close the procedure entry."
^DIC(19,11322,25)="WVLABADD"
^DIC(19,11322,"U")="SAVE LAB TEST AS PROCEDURE"
^DIC(19,11324,0)="IBJD DM VIEW/PRINT EXTRACTS^View/Print Extracted Reports^^R^10000000033^^^^^^^192"
^DIC(19,11324,1,0)="^^3^3^2990601^^"
^DIC(19,11324,1,1,0)="This option allows a user to see the results of previous Diagnostic"
^DIC(19,11324,1,2,0)="Measures extractions. It shows whether or not certain reports made it"
^DIC(19,11324,1,3,0)="through the extraction process."
^DIC(19,11324,25)="VPE^IBJDE1"
^DIC(19,11324,"U")="VIEW/PRINT EXTRACTED REPORTS"
^DIC(19,11325,0)="IBJD DM DISABLE/ENABLE^Disable-Enable DM Background Job/Reports^^R^10000000033^^^^^^^192"
^DIC(19,11325,1,0)="^^4^4^2990421^^^"
^DIC(19,11325,1,1,0)="This option allows a user to disable or re-enable the Diagnostic"
^DIC(19,11325,1,2,0)="Measures Extraction background job or certain DM reports that go"
^DIC(19,11325,1,3,0)="through the monthly DM Extraction background job. Once a report is"
^DIC(19,11325,1,4,0)="disabled, it won't be queued to run via the DM extract process."
^DIC(19,11325,25)="DER^IBJDE1"
^DIC(19,11325,"U")="DISABLE-ENABLE DM BACKGROUND J"
^DIC(19,11326,0)="IBJD DM EXTRACT MENU^Diagnostic Measures Extract Menu^^M^10000000033^^^^^^^^^1"
^DIC(19,11326,1,0)="^^2^2^2990405^"
^DIC(19,11326,1,1,0)="This menu contains options related to the Diagnostic Measures Extraction"
^DIC(19,11326,1,2,0)="Module."
^DIC(19,11326,10,0)="^19.01IP^4^3"
^DIC(19,11326,10,1,0)="11325^DE^1"
^DIC(19,11326,10,3,0)="11327^MN^3"
