^DIC(19,11458,1,0)="^^2^2^2991123^"
^DIC(19,11458,1,1,0)="This option is for the Queuable version of XUTM PROBLEM DEVICES.  "
^DIC(19,11458,1,2,0)="At the end of the report the problem device list is cleared."
