^DIC(19,14362,0)="RCDPE EEOB MOVE/COPY/REMOVE^EEOB Move/Copy/Remove^^R^1^^^^^^^261"
^DIC(19,14362,1,0)="^^6^6^3140228^"
^DIC(19,14362,1,1,0)="This option allows an EEOB incorrectly matched to a claim to be moved to"
^DIC(19,14362,1,2,0)="the correct claim or claims.  In addition, this option allows those with"
^DIC(19,14362,1,3,0)="the appropriate security key to remove an EEOB from a claim.  This is to"
^DIC(19,14362,1,4,0)="be used when the EEOB was matched to an incorrect claim and the EEOB does"
^DIC(19,14362,1,5,0)="not belong to this facility.  That is, the matching claim does not exist"
^DIC(19,14362,1,6,0)="in this system of records."
^DIC(19,14362,25)="EN^RCDPEM5"
^DIC(19,14362,"U")="EEOB MOVE/COPY/REMOVE"
^DIC(19,14363,0)="RCDPE EEOB MOVE/COPY/RMOVE RPT^EEOB Move/Copy/Remove Audit Report^^R^11720^^^^^^y^261"
^DIC(19,14363,1,0)="^19.06^3^3^3140529^^^^"
^DIC(19,14363,1,1,0)="This report lists EEOBs that have either been moved or copied to new claim"
^DIC(19,14363,1,2,0)="numbers or have been removed from a claim. The report can be filtered by"
^DIC(19,14363,1,3,0)="Station/Division and by date range.  "
^DIC(19,14363,25)="EOB^RCDPEM4"
^DIC(19,14363,"U")="EEOB MOVE/COPY/REMOVE AUDIT RE"
^DIC(19,14365,0)="RCDPE AUTO-POST REPORT^Auto-Post Report^^R^11720^^^^^^^261"
^DIC(19,14365,1,0)="^^3^3^3171129^"
^DIC(19,14365,1,1,0)="This report lists ERAs that have been auto-posted by the nightly process."
^DIC(19,14365,1,2,0)="The report can be filtered by Station/Division, payer type, payer name or "
^DIC(19,14365,1,3,0)="TIN and by date range."
^DIC(19,14365,25)="RPT^RCDPEAPP"
^DIC(19,14365,"U")="AUTO-POST REPORT"
^DIC(19,14366,0)="RCDPE AUTO-DECREASE REPORT^Auto-Decrease Adjustment report^^R^1^^^^^^^261"
^DIC(19,14366,1,0)="^19.06^3^3^3140703^^^"
^DIC(19,14366,1,1,0)="This report lists ERA claims with residual balances for which decrease "
^DIC(19,14366,1,2,0)="adjustments have been automatically applied by the nightly process. The"
^DIC(19,14366,1,3,0)="report can be filtered by Station/Division and by date range."
^DIC(19,14366,25)="RPT^RCDPEADP"
^DIC(19,14366,"U")="AUTO-DECREASE ADJUSTMENT REPOR"
^DIC(19,14367,0)="RCDPE SITE PARAMETER REPORT^EDI Lockbox Parameters Report^^R^1^^^^^^^261"
^DIC(19,14367,1,0)="^^9^9^3140708^"
^DIC(19,14367,1,1,0)="This report lists EDI Lockbox parameters.  The report includes ERA /EFT "
^DIC(19,14367,1,2,0)="number of days unmatched, auto-post /auto-decrease of medical claims "
^DIC(19,14367,1,3,0)="data, and the number of days for medical /pharmacy EFTs to prevent "
^DIC(19,14367,1,4,0)="posting."
^DIC(19,14367,1,5,0)=" "
^DIC(19,14367,1,6,0)="Information is displayed from these files:"
^DIC(19,14367,1,7,0)="   AR SITE PARAMETER file (#342)"
^DIC(19,14367,1,8,0)="   RCDPE PARAMETER file (#344.61)"
^DIC(19,14367,1,9,0)="   RCDPE AUTO-PAY EXCLUSION file (#344.6)"
^DIC(19,14367,25)="RPT^RCDPESP1"
^DIC(19,14367,"U")="EDI LOCKBOX PARAMETERS REPORT"
^DIC(19,14368,0)="RCDPE PARAMETER AUDIT REPORT^EDI Lockbox Parameters Audit Report^^R^1^^^^^^^261"
^DIC(19,14368,1,0)="^19.06^2^2^3140220^^"
^DIC(19,14368,1,1,0)="This option launches the EDI Lockbox Parameter Audit Report "
^DIC(19,14368,1,2,0)="(RPT^RCDPESP2)."
^DIC(19,14368,25)="RPT1^RCDPESP2"
^DIC(19,14368,"U")="EDI LOCKBOX PARAMETERS AUDIT R"
^DIC(19,14369,0)="RCDPE EXCLUSION AUDIT REPORT^EDI Lockbox Exclusion Audit Report^^R^1^^^^^^^261"
^DIC(19,14369,1,0)="^^3^3^3140725^"
^DIC(19,14369,1,1,0)="This report is a listing of the RCDPE PARAMETER AUDIT file (#344.7)"
^DIC(19,14369,1,2,0)="including data concerning changes to the RCDPE AUTO-PAY EXCLUSION file "
^DIC(19,14369,1,3,0)="(#344.6)."
^DIC(19,14369,25)="RPT2^RCDPESP2"
^DIC(19,14369,"U")="EDI LOCKBOX EXCLUSION AUDIT RE"
^DIC(19,14370,0)="RCDPE PAYER EXCLUSION NAME TIN^Payer Implementation Report^^R^11720^^^^^^^261"
^DIC(19,14370,1,0)="^19.06^2^2^3171205^^^"
^DIC(19,14370,1,1,0)="Launches a report to show the payers, with columns for payer name, payer "
^DIC(19,14370,1,2,0)="TIN, and the date on which the payer was added to the database."
^DIC(19,14370,25)="RPT^RCDPESP3"
^DIC(19,14370,"U")="PAYER IMPLEMENTATION REPORT"
^DIC(19,14371,0)="RCDPE UNPOSTED EFT OVERRIDE^Unposted EFT Override^^R^1^^^^^^^261"
^DIC(19,14371,1,0)="^^2^2^3140404^"
^DIC(19,14371,1,1,0)="Provides the capability for users assigned to the RCDPE AGED PMT security "
^DIC(19,14371,1,2,0)="key unrestricted ERA Worklist scratchpad creation for one day. "
^DIC(19,14371,25)="EN^RCDPEUPO"
^DIC(19,14371,"U")="UNPOSTED EFT OVERRIDE"
^DIC(19,14372,0)="RCDPE APAR^Auto-Post Awaiting Resolution^^R^1^^^^^^^261"
^DIC(19,14372,1,0)="^^7^7^3140610^"
^DIC(19,14372,1,1,0)="The Auto-Post Awaiting Resolution (APAR) option displays and allows "
^DIC(19,14372,1,2,0)="selection and editing of ERA-EEOB line items that did not pass the "
^DIC(19,14372,1,3,0)="auto-posting validation.  This means that these line items do not have a "
^DIC(19,14372,1,4,0)="receipt and will have to be manually worked by the Accounts Receivable "
^DIC(19,14372,1,5,0)="clerk. Once the clerk has made the necessary adjustments to each of the "
^DIC(19,14372,1,6,0)="EEOB line items, the line items must be 'Marked for Auto-Post' in order "
^DIC(19,14372,1,7,0)="for the EEOBs to be processed by the Nightly Auto-Posting job."
^DIC(19,14372,25)="EN^RCDPEAA1"
^DIC(19,14372,"U")="AUTO-POST AWAITING RESOLUTION"
