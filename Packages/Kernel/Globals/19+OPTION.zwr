^DIC(19,13577,0)="ECX PRO YTD REPORT^Prosthetics (PRO) YTD HCPCS Report^^R^10000000216^^^^^^^513"
^DIC(19,13577,1,0)="^^11^11^2990303^^"
^DIC(19,13577,1,1,0)="This report option will list PRO extract data by HCPCS code.  Data is"
^DIC(19,13577,1,2,0)="accumulated from all extract records for extracts dated within the"
^DIC(19,13577,1,3,0)="beginning and end of a fiscal year.  "
^DIC(19,13577,1,4,0)=" "
^DIC(19,13577,1,5,0)="If the site is non-divisional, data is reported under the facility"
^DIC(19,13577,1,6,0)="Station Number."
^DIC(19,13577,1,7,0)=" "
^DIC(19,13577,1,8,0)="If the site is multi-divisional (for Prosthetics), data can be"
^DIC(19,13577,1,9,0)="reported for any one division, or for all divisions belonging to"
^DIC(19,13577,1,10,0)="the same primary station/division.  If data is from all divisions, "
^DIC(19,13577,1,11,0)="then data is reported under the Station Number of the Primary Division."
^DIC(19,13577,10.1)="PRO YTD Report"
^DIC(19,13577,25)="EN^ECXCPRO"
^DIC(19,13577,"U")="PROSTHETICS (PRO) YTD HCPCS RE"
^DIC(19,13578,0)="ECX PRO LAB REPORT^Prosthetics (PRO) YTD Laboratory Report^^R^10000000216^^^^^^^"
^DIC(19,13578,1,0)="^^10^10^2990324^^^"
^DIC(19,13578,1,1,0)="This report option will list PRO extract data by HCPCS code for items "
^DIC(19,13578,1,2,0)="produced within the Prosthetics laboratories of the facilty.  Data is"
^DIC(19,13578,1,3,0)="accumulated from all extract records for extracts dated within the "
^DIC(19,13578,1,4,0)="beginning and end of a fiscal year.  "
^DIC(19,13578,1,5,0)="  "
^DIC(19,13578,1,6,0)="If the site is non-divisional, data is reported under the facility Station"
^DIC(19,13578,1,7,0)="Number."
^DIC(19,13578,1,8,0)="  "
^DIC(19,13578,1,9,0)="If the site is multi-divisional (for Prosthetics), data is reported for"
^DIC(19,13578,1,10,0)="for all divisions belonging to the same primary station/division."
^DIC(19,13578,25)="EN^ECXLPRO"
^DIC(19,13578,"U")="PROSTHETICS (PRO) YTD LABORATO"
^DIC(19,13579,0)="ECX LBB SOURCE AUDIT^Laboratory Blood Bank (LBB) Pre-Extract Audit^^R^10000000020^^^^^^^513^^"
^DIC(19,13579,1,0)="^19.06^5^5^3090504^^^^"
^DIC(19,13579,1,1,0)="This report is to provide DSS on-site support with a list of unmatched "
^DIC(19,13579,1,2,0)="blood products.  The report will contain those records that do not have a "
^DIC(19,13579,1,3,0)="value in either the DSS Product Dept or DSS IP # fields.  The result "
^DIC(19,13579,1,4,0)="report will enable the DSS on-site support team to correct the unmatched "
^DIC(19,13579,1,5,0)="blood products prior to running the LBB Extract."
^DIC(19,13579,20)=""
^DIC(19,13579,25)="ECXPLBB"
^DIC(19,13579,"U")="LABORATORY BLOOD BANK (LBB) PR"
