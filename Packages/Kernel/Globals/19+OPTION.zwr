^DIC(19,132,0)="XMINIT^Initialize domain^^R^-1^^^"
^DIC(19,132,1,0)="^^5^5^2850303^^"
^DIC(19,132,1,1,0)="This option is used to prepare the local domain for network traffic."
^DIC(19,132,1,2,0)="After a site is initialized, the parent domain must christen it with"
^DIC(19,132,1,3,0)="the ""Christen a subordinate domain"" option.  After both domains agree"
^DIC(19,132,1,4,0)="on the parent/child relationship, the local domain is ready to handle"
