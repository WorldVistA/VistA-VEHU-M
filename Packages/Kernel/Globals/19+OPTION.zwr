^DIC(19,9935,25)="%ZTPTCH"
^DIC(19,9935,"U")="ROUTINES BY PATCH NUMBER"
^DIC(19,9936,0)="XPD ROLLUP PATCHES^Rollup Patches into a Build^^R^983^^^^^^^453"
^DIC(19,9936,1,0)="^^4^4^2960920^^"
^DIC(19,9936,1,1,0)="This option will find all the patches for a Package and add their Build"
^DIC(19,9936,1,2,0)="file definition to the Package Build file definition.  This will enable"
^DIC(19,9936,1,3,0)="you to create a single Build file entry that contains the definition for"
^DIC(19,9936,1,4,0)="a patched Package."
^DIC(19,9936,25)="EN1^XPDER"
^DIC(19,9936,"U")="ROLLUP PATCHES INTO A BUILD"
^DIC(19,9937,0)="XPD PRINT PACKAGE PATCHES^Display Patches for a Package^^R^983^^^^^^^453"
^DIC(19,9937,1,0)="^^4^4^2960917^"
^DIC(19,9937,1,1,0)="This option will print all patches installed for a Package. It displays"
^DIC(19,9937,1,2,0)="the Date Installed and who installed the patches. It optionally will"
^DIC(19,9937,1,3,0)="print the description of the patch. All information comes from the"
^DIC(19,9937,1,4,0)="Package file."
^DIC(19,9937,25)="EN1^XPDDPCK"
^DIC(19,9937,"U")="DISPLAY PATCHES FOR A PACKAGE"
^DIC(19,9938,0)="XUPR RTN CHKSUM^Check Routines on Other CPUs^^R^983^^^^^^^163"
^DIC(19,9938,1,0)="^^3^3^2961003^^"
^DIC(19,9938,1,1,0)="This option will compare the Checksum for routines on one system to the"
^DIC(19,9938,1,2,0)="checksums for the same routines on another system.  It is only for sites"
^DIC(19,9938,1,3,0)="who have Compute and Print Servers with different routine directories."
^DIC(19,9938,25)="XTSUMCK"
^DIC(19,9938,"U")="CHECK ROUTINES ON OTHER CPUS"
