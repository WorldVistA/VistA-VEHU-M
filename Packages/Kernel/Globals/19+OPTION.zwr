^DIC(19,15772,1,0)="^19.06^4^4^3240328^^"
^DIC(19,15772,1,1,0)="This option allows a site to mark orderable items for use within pre-"
^DIC(19,15772,1,2,0)="defined quick orders only; these items will not be selectable when"
^DIC(19,15772,1,3,0)="ordering via standard package order dialogs."
