^DIC(19,3162,0)="PRPF FISCAL TRANS SUMMARY^Transaction Summary (Fiscal - By Transaction Date)^^R^11596^^^^^^^151"
^DIC(19,3162,1,0)="^^6^6^2880321.1119^"
^DIC(19,3162,1,1,0)="This report lists all of the transactions entered into the"
^DIC(19,3162,1,2,0)="system for a date or range of dates specified by the user.  It differs"
^DIC(19,3162,1,3,0)="from the transaction summary used by the Patient Fund Clerks in that"
^DIC(19,3162,1,4,0)="it sorts by the DATE OF THE TRANSACTION rather than the DATE THE"
^DIC(19,3162,1,5,0)="TRANSACTION WAS ENTERED.  This allows for predating entries for"
^DIC(19,3162,1,6,0)="the previous month on the first day of the following month."
^DIC(19,3162,25)="FISTRANS^PRPFPNT"
^DIC(19,3162,200.9)="n"
^DIC(19,3162,"U")="TRANSACTION SUMMARY (FISCAL - "
