^DIC(19,5323,0)="PSGW EXP REPORT^Expiration Date Report (80 column)^^R^.5^^^^^^^"
^DIC(19,5323,1,0)="^^3^3^2901108^^"
^DIC(19,5323,1,1,0)="This option will print an Expiration Date Report for a single, several,"
^DIC(19,5323,1,2,0)="or ALL AOUs.  For multiple AOUs it can be sorted by DATE/DRUG/AOU or"
^DIC(19,5323,1,3,0)="by DATE/AOU/DRUG."
^DIC(19,5323,25)="PSGWEXR"
^DIC(19,5323,"U")="EXPIRATION DATE REPORT (80 COL"
^DIC(19,5324,0)="PSGW ADD/DEL WARD^Add/Delete Ward (for Item)^^R^.5^^^^^^^^^^"
^DIC(19,5324,1,0)="^^2^2^2930219^^^^"
^DIC(19,5324,1,1,0)="This option will allow a user to add or delete a Ward (for Item) assignment"
^DIC(19,5324,1,2,0)="for all stock items in one or more active AOUs."
^DIC(19,5324,15)=""
^DIC(19,5324,20)=""
^DIC(19,5324,25)="PSGWWRD"
^DIC(19,5324,"U")="ADD/DELETE WARD (FOR ITEM)"
^DIC(19,5325,0)="PSGW RE-INDEX AMIS^Re-index AMIS Cross-Reference^^R^.5^^^^^^^"
^DIC(19,5325,1,0)="^^11^11^2930518^^^^"
^DIC(19,5325,1,1,0)="This option will queue a background job that will re-index the ""AMIS"""
^DIC(19,5325,1,2,0)="cross-reference for inventories, on-demands, and returns.  This cross-"
^DIC(19,5325,1,3,0)="reference is important because this is where the nightly job to update"
^DIC(19,5325,1,4,0)="the AR/WS Stats File (#58.5) gets the data for the update.  If this cross-"
^DIC(19,5325,1,5,0)="reference is somehow destroyed, it is very important to rebuild it."
^DIC(19,5325,1,6,0)="Though it is possible to accomplish this through VA FileMan, this option"
^DIC(19,5325,1,7,0)="is a much quicker and easier alternative.  This option is not tied to"
^DIC(19,5325,1,8,0)="any menu, but may be hooked into a menu at the site's discretion."
^DIC(19,5325,1,9,0)="*** NOTE *** This option is CPU intensive and should be queued only in"
^DIC(19,5325,1,10,0)="the ""off"" hours.  Also, it should ONLY be run if there is strong evidence"
^DIC(19,5325,1,11,0)="the ""AMIS"" cross-reference has been destroyed or corrupted."
^DIC(19,5325,25)="PSGWXREF"
^DIC(19,5325,"U")="RE-INDEX AMIS CROSS-REFERENCE"
^DIC(19,5326,0)="IB EDIT SITE PARAMETERS^Enter/Edit IB Site Parameters^^R^11720^IB PARAMETER EDIT^^^^^^192"
^DIC(19,5326,1,0)="^19.06^3^3^3170328^^^^"
^DIC(19,5326,1,1,0)="This option allows entering and editing of Integrated Billing Site"
^DIC(19,5326,1,2,0)="Parameter file.  Modifying the site parameters can affect the performance"
^DIC(19,5326,1,3,0)="of Integrated Billing's background filer."
^DIC(19,5326,15)=""
^DIC(19,5326,20)=""
^DIC(19,5326,25)="EDIT^IBEFUTL"
^DIC(19,5326,"U")="ENTER/EDIT IB SITE PARAMETERS"
