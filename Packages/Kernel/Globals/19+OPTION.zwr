^DIC(19,10746,0)="HBHC AUTO-QUEUED FILE UPDATE^Auto-queue HBHC File Update^^R^1253^^^^^^^328"
^DIC(19,10746,1,0)="^^10^10^2980323^^^^"
^DIC(19,10746,1,1,0)="This option runs a daily auto-queued batch job to create ^HBHC(632) (visit)"
^DIC(19,10746,1,2,0)="nodes from outpatient encounter information => patient, appointment date/time,"
^DIC(19,10746,1,3,0)="hospital location (clinic), provider, diagnosis code(s), & CPT code(s)."
^DIC(19,10746,1,4,0)=""
^DIC(19,10746,1,5,0)="This job also cancels ^HBHC(632 records if outpatient encounter referenced no"
^DIC(19,10746,1,6,0)="longer exists & deletes corresponding record from ^HBHC(634 (transmit) file if"
^DIC(19,10746,1,7,0)="transmit status is 'filed'. "
^DIC(19,10746,1,8,0)=""
^DIC(19,10746,1,9,0)="Members in mail group HBH receive a mail message if the batch job locates any"
^DIC(19,10746,1,10,0)="errors. "
^DIC(19,10746,25)="HBHCAPPT"
^DIC(19,10746,200.9)="y"
^DIC(19,10746,"U")="AUTO-QUEUE HBHC FILE UPDATE"
^DIC(19,10747,0)="PRCAC RC REVIEW/REFER^Review/Refer TP Bills to RC^^A^10000000033^^^^^^^261^^1"
^DIC(19,10747,1,0)="^^4^4^2980303^^^^"
^DIC(19,10747,1,1,0)="This option should be used to review pending Third Party bills and"
^DIC(19,10747,1,2,0)="if selected, electronically refer the bills to Regional Counsel."
^DIC(19,10747,1,3,0)="Third Party bills not of the Reimbursable Health Category will"
^DIC(19,10747,1,4,0)="need to be copied and mail or faxed to the Regional Cousnel Office."
^DIC(19,10747,20)="D OPT^RCRCVL"
^DIC(19,10747,"U")="REVIEW/REFER TP BILLS TO RC"
^DIC(19,10748,0)="PRCAC RC RRR TASK^Reconciliation Rollup Request Background Task1^^R^10000000033^^^^^^^261"
^DIC(19,10748,1,0)="^^8^8^2980309^^^^"
^DIC(19,10748,1,1,0)="This option should be scheduled to run in the background monthly by the"
^DIC(19,10748,1,2,0)="eleventh of each month.  A message will be created and sent to the Regional "
^DIC(19,10748,1,3,0)="Counsel Office requesting a Reimbursable Health reconciliation rollup. "
^DIC(19,10748,1,4,0)="The members of the RC RC REFERRALS Mail Group will receive four "
^DIC(19,10748,1,5,0)="Reconciliation mail messages."
^DIC(19,10748,1,6,0)="Entries in the AR RC Transmission File whose purge date has passed,"
^DIC(19,10748,1,7,0)="will be deleted when this option runs."
^DIC(19,10748,1,8,0)="This option will not need a device."
^DIC(19,10748,25)="BKTSK^RCRCRR(""RR1"")"
^DIC(19,10748,"U")="RECONCILIATION ROLLUP REQUEST "
^DIC(19,10749,0)="PRCAC RC ACTION MENU^TP Referred Follow-up^^A^10000000033^^^^^^^261^^1"
^DIC(19,10749,1,0)="^^5^5^2980227^^^"
^DIC(19,10749,1,1,0)="This option allows follow-up actions for referred TP bills to be "
^DIC(19,10749,1,2,0)="electronically sent to the RC office. This option should be used to "
^DIC(19,10749,1,3,0)="process pending EOB codes for partial payments, Increase referred TP"
^DIC(19,10749,1,4,0)="bills, request action be taken and to transmit selected AR Transactions"
^DIC(19,10749,1,5,0)="for referred TP bills."
^DIC(19,10749,20)="D OPT^RCRCAL"
^DIC(19,10749,"U")="TP REFERRED FOLLOW-UP"
^DIC(19,10750,0)="PRCA RC PARAMETERS^RC Parameters Edit^^R^1^^^^^^^261"
^DIC(19,10750,1,0)="^^2^2^2971210^^"
^DIC(19,10750,1,1,0)="This option allows users to edit the Regional Counsel"
^DIC(19,10750,1,2,0)="Interface Site Parameters."
^DIC(19,10750,25)="SITE^RCRCXMS"
^DIC(19,10750,"U")="RC PARAMETERS EDIT"
^DIC(19,10751,0)="PRCAC RC TRANSMISSION^Transmission Log for RC^^R^10000000033^^^^^^^261"
^DIC(19,10751,1,0)="^^7^7^2980408^^^^"
^DIC(19,10751,1,1,0)="This option displays the AR Transmissions sent via the Regional Counsel"
^DIC(19,10751,1,2,0)="Interface.  Users may View or Forward the mail messages in this"
^DIC(19,10751,1,3,0)="log.  They may also Delete or append Comments to existing AR RC"
^DIC(19,10751,1,4,0)="Transmission File entries.  Entries in this file will contian a"
^DIC(19,10751,1,5,0)="Purge Date set by the RC Parameters option.  Entries will be "
^DIC(19,10751,1,6,0)="purge when the background option, Reconciliation Rollup Request"
^DIC(19,10751,1,7,0)="Background Task1 runs.  This file may grow to be very large."
^DIC(19,10751,25)="EN^RCRCEL"
^DIC(19,10751,"U")="TRANSMISSION LOG FOR RC"
^DIC(19,10753,0)="PRCA DEPOSIT RECON REPORT^Deposit Reconciliation Report^^R^11720^^^^^^^261"
^DIC(19,10753,1,0)="^^5^5^2980311^"
^DIC(19,10753,1,1,0)="This option will print a report showing the cash receipt documents"
^DIC(19,10753,1,2,0)="sent to FMS.  The user can print a summary or detailed report.  The"
^DIC(19,10753,1,3,0)="summary report will show the total cash receipt dollars sent to FMS."
^DIC(19,10753,1,4,0)="The detail report will show the individual lines in the cash receipt"
^DIC(19,10753,1,5,0)="document sent to FMS."
^DIC(19,10753,25)="RCRJRDEP"
^DIC(19,10753,"U")="DEPOSIT RECONCILIATION REPORT"
^DIC(19,10754,0)="PRCA FMS RSC ENTER/EDIT^Enter/Edit Revenue Source Codes^^R^11720^PRCASVC^^^^^^261"
^DIC(19,10754,1,0)="^^6^6^2980312^^"
^DIC(19,10754,1,1,0)="This option will allow the user owning the PRCASVC supervisor security"
^DIC(19,10754,1,2,0)="key to enter and edit the revenue source codes sent to FMS.  It is"
^DIC(19,10754,1,3,0)="important that this option be used with caution since it could cause"
^DIC(19,10754,1,4,0)="many of the FMS code sheets to reject if invalid revenue source codes"
^DIC(19,10754,1,5,0)="are entered.  Revenue source codes should only be entered and used"
^DIC(19,10754,1,6,0)="after they have been entered in FMS."
^DIC(19,10754,25)="ADDEDIT^RCXFMSUR"
^DIC(19,10754,"U")="ENTER/EDIT REVENUE SOURCE CODE"
^DIC(19,10755,0)="PRCA FMS RSC CALCULATE^Calculate Revenue Source Code For A Bill^^R^11720^^^^^^^261"
^DIC(19,10755,1,0)="^^4^4^2980312^"
^DIC(19,10755,1,1,0)="This option will show (calculate) the revenue source code for a selected"
^DIC(19,10755,1,2,0)="bill.  For non-accrued bills in fund 0160A1, the revenue source code is"
^DIC(19,10755,1,3,0)="entered by the user and is not calculated.  For accrued bills in fund"
^DIC(19,10755,1,4,0)="5287, the revenue source code will be calculated and displayed."
^DIC(19,10755,25)="SHOW^RCXFMSUR"
^DIC(19,10755,"U")="CALCULATE REVENUE SOURCE CODE "
^DIC(19,10756,0)="RA BARPROCPRINT^Barcoded Procedure List^^R^11712^^^^^^^"
^DIC(19,10756,1,0)="^^2^2^2960112^"
^DIC(19,10756,1,1,0)="This option will print a list of selected procedures in a barcoded format."
^DIC(19,10756,1,2,0)="Your site must have a printer setup to print in a barcoded format."
^DIC(19,10756,25)="EN1^RABAR"
^DIC(19,10756,"U")="BARCODED PROCEDURE LIST"
^DIC(19,10757,0)="RA DISPLAY IMAGPROCINFO^Rad/Nuc Med Procedure Information Look-Up^^R^11712^^^^^^y^"
^DIC(19,10757,1,0)="^^4^4^2960227^^"
^DIC(19,10757,1,1,0)="This option will allow the user to select either inactive or active "
^DIC(19,10757,1,2,0)="procedures by imaging type.  The option will display the procedure, type "
^DIC(19,10757,1,3,0)="of procedure, imaging type abbreviation and the CPT code of the procedure."
^DIC(19,10757,1,4,0)="If any Educational Description exists, it will also be displayed."
^DIC(19,10757,25)="RAPINFO"
^DIC(19,10757,"U")="RAD/NUC MED PROCEDURE INFORMAT"
^DIC(19,10758,0)="RA UNCORRECTED REPORTS^Access Uncorrected Reports^^R^11712^^^^^^y^^^1^1"
^DIC(19,10758,1,0)="^^3^3^2970106^^^"
^DIC(19,10758,1,1,0)="This option will allow the user to select a patient whose reports "
^DIC(19,10758,1,2,0)="were amended sometime in the past.  The user may then display the  "
^DIC(19,10758,1,3,0)="reports as they appeared prior to amendment."
^DIC(19,10758,15)="K RAOPT(""UNCORRECTED REPORTS"")"
^DIC(19,10758,20)="S RAOPT(""UNCORRECTED REPORTS"")="""""
^DIC(19,10758,25)="EN1^RAERRPT"
^DIC(19,10758,99)="56708,26275"
