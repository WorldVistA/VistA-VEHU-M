^DIC(19,9880,0)="PXCE ENCOUNTER DATA ENTRY^PCE Encounter Data Entry^^A^10958^^^^^^^^^1"
^DIC(19,9880,1,0)="^^10^10^2950817^"
^DIC(19,9880,1,1,0)="This option is for users who can document a clinical encounter in the"
^DIC(19,9880,1,2,0)="V-files (visit related files), but can only delete V-File encounter"
^DIC(19,9880,1,3,0)="entries that they have created. The data entered via this option includes"
^DIC(19,9880,1,4,0)="visit information (where and when), and the following clinical data"
^DIC(19,9880,1,5,0)="related to the visit: providers of care, problems treated, procedures and"
^DIC(19,9880,1,6,0)="treatments done, and immunizations, skin tests, and patient education"
^DIC(19,9880,1,7,0)="given."
^DIC(19,9880,1,8,0)=" "
^DIC(19,9880,1,9,0)=" "
^DIC(19,9880,1,10,0)="This option is intended for data entry staff."
^DIC(19,9880,10.1)="PCE"
^DIC(19,9880,20)="D EN^PXCE(""d"")"
^DIC(19,9880,99.1)="56179,36316"
^DIC(19,9880,"U")="PCE ENCOUNTER DATA ENTRY"
^DIC(19,9881,0)="PX PCE CODE MAPPING LIST^PCE Code Mapping List^^P^1^^^^^^y^507"
^DIC(19,9881,1,0)="^^13^13^3160314^"
^DIC(19,9881,1,1,0)="This option allows the user to see the mapping between CPT codes"
^DIC(19,9881,1,2,0)="and a related entry in a PCE supporting file.  For example, the "
^DIC(19,9881,1,3,0)="CPT code 90732 is related to the Immunization file entry PNEUMOCCOCAL."
^DIC(19,9881,1,4,0)="  "
^DIC(19,9881,1,5,0)="PCE uses the code mapping relationships to populate multiple files from"
^DIC(19,9881,1,6,0)="one data entry step.  For example, an entry of PNEUMOCCOCAL in the V"
^DIC(19,9881,1,7,0)="Immunization file will also create a CPT entry, 90732 in the V CPT file"
^DIC(19,9881,1,8,0)="which will then be passed to PIMS for use by IB, Workload, and DSS."
^DIC(19,9881,1,9,0)=" "
^DIC(19,9881,1,10,0)="NOTE: As of patch PX*1.0*215, the PCE CODE MAPPING file (#811.1) has been "
^DIC(19,9881,1,11,0)="superseded. The mappings of immunizations and skin tests to CPT codes are"
^DIC(19,9881,1,12,0)="now contained in the CODING SYSTEM multiple of the IMMUNIZATION "
^DIC(19,9881,1,13,0)="(#9999999.14) and SKIN TEST (#9999999.28) files themselves."
^DIC(19,9881,60)="PXD(811.1,"
^DIC(19,9881,62)=0
^DIC(19,9881,63)="[PX CODE MAPPING PRINT]"
^DIC(19,9881,64)="[PX CODE MAPPING]"
^DIC(19,9881,"U")="PCE CODE MAPPING LIST"
^DIC(19,9882,0)="PXCE ENCOUNTER ENTRY & DELETE^PCE Encounter Data Entry and Delete^^A^10958^^^^^^^^^1"
^DIC(19,9882,1,0)="^^10^10^2950817^"
^DIC(19,9882,1,1,0)="This option is for users who can document a clinical encounter in the"
^DIC(19,9882,1,2,0)="V-files (visit related files), and can also delete any V-File encounter"
^DIC(19,9882,1,3,0)="entries, even though they are not the creator of the entries."
^DIC(19,9882,1,4,0)="The data entered via this option includes visit information"
^DIC(19,9882,1,5,0)="(where and when), and the following clinical data related to the visit:"
^DIC(19,9882,1,6,0)="providers of care, problems treated, procedures and treatments done,"
^DIC(19,9882,1,7,0)="and immunizations, skin tests, and patient education given."
^DIC(19,9882,1,8,0)=" "
^DIC(19,9882,1,9,0)="This option is intended for the Coordinator for PCE and/or supervisor of"
^DIC(19,9882,1,10,0)="the encounter data entry staff."
^DIC(19,9882,10.1)="PCE"
^DIC(19,9882,20)="D EN^PXCE(""D"")"
^DIC(19,9882,99.1)="56179,36316"
^DIC(19,9882,"U")="PCE ENCOUNTER DATA ENTRY AND D"
^DIC(19,9883,0)="PXCE ENCOUNTER ENTRY NO DELETE^PCE Encounter Data Entry without Delete^^A^10958^^^^^^^^^1"
^DIC(19,9883,1,0)="^^7^7^2950817^"
^DIC(19,9883,1,1,0)="This option is for users who can document a clinical encounter in the"
^DIC(19,9883,1,2,0)="V-files (visit-related files), but should not be able to delete any"
^DIC(19,9883,1,3,0)="entries, including ones that they have created. The data entered via this"
^DIC(19,9883,1,4,0)="option includes visit information (where and when), and the"
^DIC(19,9883,1,5,0)="following clinical data related to the visit: providers of care, problems"
^DIC(19,9883,1,6,0)="treated, procedures and treatments done, and immunizations, skin tests,"
^DIC(19,9883,1,7,0)="and patient education given."
^DIC(19,9883,10.1)="PCE"
^DIC(19,9883,20)="D EN^PXCE("""")"
^DIC(19,9883,99.1)="56179,36316"
^DIC(19,9883,"U")="PCE ENCOUNTER DATA ENTRY WITHO"
^DIC(19,9884,0)="PX PCE COORDINATOR MENU^PCE Coordinator Menu^^M^10958^^^^^^^507"
^DIC(19,9884,1,0)="^^10^10^2960723^^^^"
^DIC(19,9884,1,1,0)="This is the menu for the person that is the ADPAC for PCE.  It includes"
^DIC(19,9884,1,2,0)="all of the user interface options as well as the options for file"
^DIC(19,9884,1,3,0)="maintenance."
^DIC(19,9884,1,4,0)=" "
^DIC(19,9884,1,5,0)="The data entry options may be assigned to clerk and/or clinican menus as"
^DIC(19,9884,1,6,0)="needed."
^DIC(19,9884,1,7,0)=" "
^DIC(19,9884,1,8,0)="The HS and Report parameter edit and print options are for the coordinator"
^DIC(19,9884,1,9,0)="to manage fields for site specific preferences/definitions in the Health"
^DIC(19,9884,1,10,0)="Summary and PCE Reports."
^DIC(19,9884,10,0)="^19.01PI^14^14"
