^DIC(19,7361,0)="DGJ PHYS DEFICIENCY REPORT^Physician Deficiency Report^^R^10000000033^^^^^^^"
^DIC(19,7361,1,0)="^^5^5^2930409^^^"
^DIC(19,7361,1,1,0)="This option gives the list of deficiencies for a physician, patient or"
^DIC(19,7361,1,2,0)="service/specialty.  This report will only give a list of those records"
^DIC(19,7361,1,3,0)="which are not completed. The information listed on this report is"
^DIC(19,7361,1,4,0)="Division, Patient, Physician, PT ID, Admission Date, Deficiency,"
^DIC(19,7361,1,5,0)="Event Date, Status, Borrower, Phone/Rm, D/T Charged."
^DIC(19,7361,25)="DGJPDEF"
^DIC(19,7361,99)="55648,48244"
^DIC(19,7361,"U")="PHYSICIAN DEFICIENCY REPORT"
^DIC(19,7362,0)="DGPM PROVIDER CHANGE^Provider Change^^A^.5^^^^^^^114^^1"
^DIC(19,7362,1,0)="^^7^7^2940711^^"
^DIC(19,7362,1,1,0)="This option is used to enter changes in provider for a patient during"
^DIC(19,7362,1,2,0)="a inpatient stay. A patient movement record will be created for each provider"
^DIC(19,7362,1,3,0)="change. The movement type will be '6', a Treating Specialty Change. This"
^DIC(19,7362,1,4,0)="option should be used in the Treating Specilty is to remain the same for"
^DIC(19,7362,1,5,0)="the patient but a change in provider is indicated. By entering provider"
^DIC(19,7362,1,6,0)="changes through this option, it is possible to create an historical"
^DIC(19,7362,1,7,0)="record of all provider associated with a patient during a inpatient stay."
^DIC(19,7362,20)="S DGPMT=6,DGPMPC="""" D PAT^DGPMV"
^DIC(19,7362,"U")="PROVIDER CHANGE"
^DIC(19,7363,0)="DG CO-PAY TEST FUTURE LIST^Copay Exempt Test Needing Update At Next Appt.^^A^.5^^^^^^^114^^1"
^DIC(19,7363,1,0)="^^3^3^2930406^"
^DIC(19,7363,1,1,0)="This option allows users to select a date range for future appointments."
^DIC(19,7363,1,2,0)="It will list Co-Pay Exemption Test that need updating by that appointment"
^DIC(19,7363,1,3,0)="time."
^DIC(19,7363,20)="S DGMTYPT=2 D ^DGMTOFA"
^DIC(19,7363,"U")="COPAY EXEMPT TEST NEEDING UPDA"
^DIC(19,7364,0)="DGPM TS INPATIENT INFORMATION^Treating Specialty Inpatient Information^^R^.5^^^^^^^"
^DIC(19,7364,1,0)="^^9^9^2930421^^^^"
^DIC(19,7364,1,1,0)="This option is intended to printout lists with Treating Specialty "
^DIC(19,7364,1,2,0)="Inpatient Information for a specific date in the past.  Three separate "
^DIC(19,7364,1,3,0)="and different lists can be generated.  Patient Listing by Ward and  "
^DIC(19,7364,1,4,0)="Patient Listing by Treating Specialty print the individual patient "
^DIC(19,7364,1,5,0)="information, as well as, the subcounts and totals.  The Patient Count "
^DIC(19,7364,1,6,0)="by Treating Specialty does not print the individual patient information, "
^DIC(19,7364,1,7,0)="but does print the subcounts and totals for each Facility Treating "
^DIC(19,7364,1,8,0)="Specialty by Division.  All three provide information on the absences: "
^DIC(19,7364,1,9,0)="Pass, AA, UA and ASIH with subcounts and totals for each of them."
^DIC(19,7364,25)="DGPMTS"
^DIC(19,7364,"U")="TREATING SPECIALTY INPATIENT I"
