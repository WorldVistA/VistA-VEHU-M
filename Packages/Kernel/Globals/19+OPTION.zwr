^DIC(19,11286,0)="SRCODING NURSE REPORT^Nurse Intraoperative Report^^R^10000000020^^^^^^^167^y^1^1"
^DIC(19,11286,1,0)="^19.06^11^11^3020821^^^"
^DIC(19,11286,1,1,0)="This option is used by the coders to print the nurse intraoperative report"
^DIC(19,11286,1,2,0)="for an operation.  If the report is not electronically signed, the option"
^DIC(19,11286,1,3,0)="displays information directly from the SURGERY file (#130) with the choice"
^DIC(19,11286,1,4,0)="to edit the information on the report, to print/view the report from the"
^DIC(19,11286,1,5,0)="beginning, and to sign the report electronically if appropriate for the"
^DIC(19,11286,1,6,0)="user.  After the report is electronically signed, this option allows the"
^DIC(19,11286,1,7,0)="signed report to be edited by updating the information in the SURGERY file"
^DIC(19,11286,1,8,0)="(#130) and by creating addenda and this option allows the signed report to"
^DIC(19,11286,1,9,0)="be viewed or printed."
^DIC(19,11286,1,10,0)=" "
^DIC(19,11286,1,11,0)="This report is not available for non-OR procedures."
^DIC(19,11286,15)="D EXIT^SROVAR"
^DIC(19,11286,20)="D ^SROVAR I '$G(SRTN) D ^SROPS1 S:'$D(SRTN) XQUIT="""" Q:$D(XQUIT)"
^DIC(19,11286,22)="Q"
^DIC(19,11286,25)="NRPT^SROVER2"
^DIC(19,11286,"U")="NURSE INTRAOPERATIVE REPORT"
