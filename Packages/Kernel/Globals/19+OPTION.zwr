^DIC(19,10918,0)="XPAR EDIT BY TEMPLATE^Edit Parameter Values with Template^^A^11712^^^^^^^^^1"
^DIC(19,10918,1,0)="^^2^2^2970625^"
^DIC(19,10918,1,1,0)="This option prompts for a Parameter Template and then uses the selected"
^DIC(19,10918,1,2,0)="template to edit parameter values."
^DIC(19,10918,10.1)="Edit by Template"
^DIC(19,10918,20)="D SELTED^XPAREDT3"
^DIC(19,10918,"U")="EDIT PARAMETER VALUES WITH TEM"
^DIC(19,10919,0)="ORCM ORDERABLES^Enter/edit orderable items^^R^10000000020^^^^^^^^^"
^DIC(19,10919,1,0)="^^2^2^2981104^^^^"
^DIC(19,10919,1,1,0)="This option lets you create or change the things that are orderable via"
^DIC(19,10919,1,2,0)="generic text orders at your site."
^DIC(19,10919,20)=""
^DIC(19,10919,25)="OI^ORCMEDT1"
^DIC(19,10919,"U")="ENTER/EDIT ORDERABLE ITEMS"
^DIC(19,10920,0)="ORCM MENU^Enter/edit order menus^^R^11712^^^^^^^"
^DIC(19,10920,1,0)="^^1^1^2981104^^^"
^DIC(19,10920,1,1,0)="This option lets you create or change the Add Orders menus for your site."
^DIC(19,10920,25)="ORCMEDIT"
^DIC(19,10920,"U")="ENTER/EDIT ORDER MENUS"
^DIC(19,10921,0)="ORCM PROTOCOLS^Convert protocols^^R^11712^^^^^^^"
^DIC(19,10921,1,0)="^^3^3^2981104^"
^DIC(19,10921,1,1,0)="This option lets you convert any protocols that didn't get processed"
^DIC(19,10921,1,2,0)="automatically or successfully by the CPRS order menu conversion, for use"
^DIC(19,10921,1,3,0)="on Add Orders menus."
^DIC(19,10921,25)="PROTOCOL^ORCMEDT1"
^DIC(19,10921,"U")="CONVERT PROTOCOLS"
^DIC(19,10922,0)="ORCM QUICK ORDERS^Enter/edit quick orders^^R^11712^^^^^^^"
^DIC(19,10922,1,0)="^^5^5^2981104^^"
^DIC(19,10922,1,1,0)="This option lets you create or change quick orders. The dialog for"
^DIC(19,10922,1,2,0)="creating a quick order is similar to a dialog for entering an"
^DIC(19,10922,1,3,0)="order. The responses you enter will become the pre-defined responses"
^DIC(19,10922,1,4,0)="for this quick order. End users will have the opportunity to edit"
^DIC(19,10922,1,5,0)="these pre-defined responses, if desired."
^DIC(19,10922,25)="QUICK^ORCMEDT1"
^DIC(19,10922,"U")="ENTER/EDIT QUICK ORDERS"
^DIC(19,10923,0)="ORCM PROMPTS^Enter/edit prompts^^R^11712^^^^^^^"
^DIC(19,10923,1,0)="^^1^1^2981104^^"
^DIC(19,10923,1,1,0)="This option lets you create or change prompts for generic order dialogs."
^DIC(19,10923,25)="EN^ORCMEDT4"
^DIC(19,10923,"U")="ENTER/EDIT PROMPTS"
^DIC(19,10924,0)="ORCM ORDERS^Enter/edit generic orders^^R^11712^^^^^^^"
^DIC(19,10924,1,0)="^^3^3^2981104^"
^DIC(19,10924,1,1,0)="This option lets you create or change generic text orders that may be"
^DIC(19,10924,1,2,0)="placed on Add Orders menus; limited access to some clinical service"
^DIC(19,10924,1,3,0)="ordering dialogs is also available through this option."
^DIC(19,10924,25)="EN^ORCMEDT3"
^DIC(19,10924,"U")="ENTER/EDIT GENERIC ORDERS"
^DIC(19,10925,0)="ORCM ORDER SETS^Enter/edit order sets^^R^11712^^^^^^^"
^DIC(19,10925,1,0)="^^2^2^2981104^^"
^DIC(19,10925,1,1,0)="This option lets you create or modify order sets, by combining"
^DIC(19,10925,1,2,0)="a group of related quick orders into a single item."
^DIC(19,10925,25)="SET^ORCMEDT1"
^DIC(19,10925,"U")="ENTER/EDIT ORDER SETS"
^DIC(19,10926,0)="ORCM MGMT^Order Menu Management^^M^1^^^^^^^"
^DIC(19,10926,1,0)="^19.06^8^8^3160503^^^^"
^DIC(19,10926,1,1,0)="Options on this menu can be used for editing and modifying options"
^DIC(19,10926,1,2,0)="and menus for CPRS. If your site used OE/RR 2.5, most of your menus,"
^DIC(19,10926,1,3,0)="quick orders, and generic orders are converted to CPRS with the"
^DIC(19,10926,1,4,0)="installation of CPRS. Order Menu Management options can help you"
^DIC(19,10926,1,5,0)="convert protocols that weren't automatically converted, edit or"
^DIC(19,10926,1,6,0)="create quick orders and generic orders, create order sets, and"
^DIC(19,10926,1,7,0)="assign primary order menus. If your site hasn't used OE/RR 2.5,"
^DIC(19,10926,1,8,0)="you must create and assign primary order menus for all of your users."
^DIC(19,10926,10,0)="^19.01IP^23^23"
^DIC(19,10926,10,1,0)="12225^OI^1"
^DIC(19,10926,10,2,0)="10923^PM^2"
