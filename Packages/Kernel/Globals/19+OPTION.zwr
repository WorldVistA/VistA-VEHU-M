^DIC(19,14692,1,1,0)="Search the Outpatient Site (#59) for sites with less than 1000 numbers "
^DIC(19,14692,1,2,0)="left."
^DIC(19,14692,1,3,0)=" "
^DIC(19,14692,1,4,0)="NARCOTIC UPPER BOUND - LAST NARCOTIC NUMBER ISSUED"
^DIC(19,14692,1,5,0)="LAST PRESCRIPTION # NUMBER ISSUED - LAST PRESCRIPTION # NUMBER ISSUED"
