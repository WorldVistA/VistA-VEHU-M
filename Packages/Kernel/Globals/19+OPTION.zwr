^DIC(19,12924,0)="IBCEM VIEW MRA EOB^View MRA EOB^^R^10000000020^^^^^^^192"
^DIC(19,12924,1,0)="^19.06^4^4^3030502^^"
^DIC(19,12924,1,1,0)="This option will allow the user to choose a bill that has at "
^DIC(19,12924,1,2,0)="least one Medicare Remittance Advice (MRA) Explanation of"
^DIC(19,12924,1,3,0)="Benefits (EOB) on file.  The user can then view the MRA EOB"
^DIC(19,12924,1,4,0)="through the ListManager utility."
^DIC(19,12924,25)="EN^IBCEMVU"
^DIC(19,12924,"U")="VIEW MRA EOB"
^DIC(19,12925,0)="IBCEM PATIENTS W/O MEDICARE^Patients Without MEDICARE (WNR) Insurance^^R^10000000020^^^^^^^192"
^DIC(19,12925,1,0)="^^4^4^3031201^"
^DIC(19,12925,1,1,0)="This report will show living patients that have active insurance, but no "
^DIC(19,12925,1,2,0)="MEDICARE (WNR) insurance on file.  The other active insurance must be "
^DIC(19,12925,1,3,0)="Medigap, or Medicare Secondary type insurance.  In these cases, MEDICARE "
^DIC(19,12925,1,4,0)="(WNR) should be the primary insurance.  This is for the MRA project."
^DIC(19,12925,25)="EN^IBCEMMR"
^DIC(19,12925,"U")="PATIENTS WITHOUT MEDICARE (WNR"
^DIC(19,12926,0)="IBCEM MRA STATISTICS REPORT^MRA Statistics Report^^R^10000000020^^^^^^^192"
^DIC(19,12926,1,0)="^19.06^2^2^3040922^^"
^DIC(19,12926,1,1,0)="The MRA Statistics Report displays statistics on Primary and Secondary"
^DIC(19,12926,1,2,0)="MRA requests."
^DIC(19,12926,25)="EN^IBCEMSR"
^DIC(19,12926,"U")="MRA STATISTICS REPORT"
^DIC(19,12927,0)="ECXWRD^Active Wards for Fiscal Year Print^^R^1^^^^^^^513"
^DIC(19,12927,1,0)="^19.06^6^6^3220303^^^"
^DIC(19,12927,1,1,0)="This option prints a list of all wards that were active at any time "
^DIC(19,12927,1,2,0)="during the current fiscal year.  The list is sorted by Medical Center "
^DIC(19,12927,1,3,0)="Division and displays the pointer to the HOSPITAL LOCATION file (#44),"
^DIC(19,12927,1,4,0)="the service and specialty associated with the ward in the WARD LOCATION"
^DIC(19,12927,1,5,0)="file (#42), and the DSS Department code associated with the ward in the"
^DIC(19,12927,1,6,0)="DSS WARD file (#727.4)."
^DIC(19,12927,25)="EN^ECXWRD"
^DIC(19,12927,"U")="ACTIVE WARDS FOR FISCAL YEAR P"
^DIC(19,12928,0)="ECX DIVISION ID^Enter/Edit DSS Division Identifier^OUT OF ORDER, DO NOT USE THIS OPTION!!!^R^10000000020^ECXMGR^^^^^^513"
^DIC(19,12928,1,0)="^19.06^3^3^3020715^^^"
^DIC(19,12928,1,1,0)="This option should only be used by the DSS Site Manager to enter or"
^DIC(19,12928,1,2,0)="edit the DSS Division Identifier associated with any medical center"
^DIC(19,12928,1,3,0)="division."
^DIC(19,12928,25)="EN^ECXDVSNX"
^DIC(19,12928,"U")="ENTER/EDIT DSS DIVISION IDENTI"
^DIC(19,12929,0)="ECX WARD DSSDEPT^Enter/Edit DSS Ward^^R^10000000216^ECXMGR^^^^^^513"
^DIC(19,12929,1,0)="^19.06^3^3^3020731^^"
^DIC(19,12929,1,1,0)="This option should only be used by the DSS Site Manager to enter or"
^DIC(19,12929,1,2,0)="edit the DSS Department code associated with each medical center"
^DIC(19,12929,1,3,0)="ward."
^DIC(19,12929,25)="EN^ECXWRDX"
^DIC(19,12929,"U")="ENTER/EDIT DSS WARD"
^DIC(19,12930,0)="ECX DSSDEPT DECODE^Decode a DSS Department Code^^R^10000000020^^^^^^^"
^DIC(19,12930,1,0)="^^12^12^2980721^"
^DIC(19,12930,1,1,0)="This option will allow the user to enter a 4-character string, which"
^DIC(19,12930,1,2,0)="will then be 'decoded' as if it were a DSS Department code."
^DIC(19,12930,1,3,0)=" "
^DIC(19,12930,1,4,0)="DSS Department codes are of the format"
^DIC(19,12930,1,5,0)=" "
^DIC(19,12930,1,6,0)="   ABBCxxx"
^DIC(19,12930,1,7,0)="   where: A = DSS Clinical Service code"
^DIC(19,12930,1,8,0)="         BB = DSS Production Unit code"
^DIC(19,12930,1,9,0)="          C = DSS Division Identifier code"
^DIC(19,12930,1,10,0)="        xxx = suffix (optional)"
^DIC(19,12930,1,11,0)=" "
^DIC(19,12930,1,12,0)="Only the ABBC portion is decoded."
^DIC(19,12930,25)="DECODE^ECXDSSD"
^DIC(19,12930,"U")="DECODE A DSS DEPARTMENT CODE"
^DIC(19,12931,0)="ECX DSSDEPT MGMT^DSS Department Management^^M^10000000216^^^^^^^513"
^DIC(19,12931,1,0)="^19.06^2^2^3030714^^^^"
