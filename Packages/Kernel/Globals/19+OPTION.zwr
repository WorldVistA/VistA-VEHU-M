^DIC(19,15658,0)="EHM-00479^Results Reporting Menu^^A^1^^^^^^^170^^1^^"
^DIC(19,15658,1,0)="^^5^5^3240328^^^"
^DIC(19,15658,1,1,0)="This action type option sets up and calls MAIN^ORSDVR to allow selection"
^DIC(19,15658,1,2,0)="of multiple patients, followed by multiple reports.  It then asks any"
^DIC(19,15658,1,3,0)="parameters associated with the selected reports and gets a device to"
^DIC(19,15658,1,4,0)="which the reports will be printed by patient."
^DIC(19,15658,1,5,0)="Cloned from ""OR RESULTS REPORTING"" option."
