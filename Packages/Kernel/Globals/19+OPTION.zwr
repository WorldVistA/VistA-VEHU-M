^DIC(19,5308,0)="ECTP LINK^Link File 49 Entries to National File^^R^.5^^^^^^^189"
^DIC(19,5308,1,0)="^^4^4^2901202^^"
^DIC(19,5308,1,1,0)="This option allows the user to choose an entry from File 49 -"
^DIC(19,5308,1,2,0)="Service/Section and 'point' it to the equivalent entry in the"
^DIC(19,5308,1,3,0)="National Service File (#730).  This will facilitate the"
^DIC(19,5308,1,4,0)="standardization of services at all VAMCs for reporting purposes."
^DIC(19,5308,25)="ECTPLNK"
^DIC(19,5308,99)="54754,36565"
^DIC(19,5308,"U")="LINK FILE 49 ENTRIES TO NATION"
