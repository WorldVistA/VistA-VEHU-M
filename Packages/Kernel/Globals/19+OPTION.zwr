^DIC(19,15715,0)="EHM-00536^Erase Notifications^^R^1^^^^^^^^^^^"
^DIC(19,15715,1,0)="^^3^3^3240328^"
^DIC(19,15715,1,1,0)="Erase all notifications for a User, erase all notifications for a Patient,"
^DIC(19,15715,1,2,0)="or erase a specific Notification."
^DIC(19,15715,1,3,0)="Cloned from ""ORB3 ERASE NOTIFICATIONS"" option."
^DIC(19,15715,3)=""
^DIC(19,15715,25)="ERASE^ORB3MGR1"
^DIC(19,15715,99)="56686,35654"
^DIC(19,15715,"U")="ERASE NOTIFICATIONS"
^DIC(19,15716,0)="EHM-00537^Determine Recipients for a Notification^^R^1^^^^^^^170^^^^"
^DIC(19,15716,1,0)="^^5^5^3240328^^^"
^DIC(19,15716,1,1,0)="Based on Notification, Patient and optional Order Number and Default/"
^DIC(19,15716,1,2,0)="Regular Recipients, a list of recipients and potential recipients is "
^DIC(19,15716,1,3,0)="presented.  This is a tool for IRM or Clinical Coordinators only.  It will"
^DIC(19,15716,1,4,0)="enable the user to determine if and why a user receives a notification."
^DIC(19,15716,1,5,0)="Cloned from ""ORB3 DETERMINE RECIPIENTS"" option."
^DIC(19,15716,3)=""
^DIC(19,15716,10.1)="Determine Notif Recipients"
^DIC(19,15716,25)="RECIPS^ORB3U1"
^DIC(19,15716,"U")="DETERMINE RECIPIENTS FOR A NOT"
^DIC(19,15717,0)="EHM-00538^Display Patient Alerts and Alert Recipients^^R^1^^^^^^^170^^^^"
^DIC(19,15717,1,0)="^^7^7^3240328^^"
^DIC(19,15717,1,1,0)="This option prompts for a patient then displays all Kernel Alerts for that"
^DIC(19,15717,1,2,0)="patient.  You are then prompted to select one or more alerts.  Recipients"
^DIC(19,15717,1,3,0)="of those alerts are then displayed or printed along with relevant data"
^DIC(19,15717,1,4,0)="regarding how they processed the alert.  This option uses the Alert "
^DIC(19,15717,1,5,0)="Tracking file [^XTV(8992.1]."
^DIC(19,15717,1,6,0)="If an alert has an associated order number, it is displayed in brackets."
^DIC(19,15717,1,7,0)="Cloned from ""ORB3 ALERT RECIPIENTS"" option."
^DIC(19,15717,3)=""
^DIC(19,15717,10.1)="Display Alert Recipients"
^DIC(19,15717,25)="ALRTHX^ORB3U1"
^DIC(19,15717,"U")="DISPLAY PATIENT ALERTS AND ALE"
^DIC(19,15718,0)="EHM-00539^Report Menu for Alerts^^M^1^^^^^^^163^^^^"
^DIC(19,15718,1,0)="^19.06^3^3^3240328^^^^"
^DIC(19,15718,1,1,0)="This menu provides several options for generating reports on alerts for "
^DIC(19,15718,1,2,0)="users or patients."
^DIC(19,15718,1,3,0)="Cloned from ""XQAL REPORTS MENU"" option."
^DIC(19,15718,3)=""
^DIC(19,15718,10,0)="^19.01IP^5^5"
^DIC(19,15718,10,1,0)=15719
^DIC(19,15718,10,2,0)=15720
^DIC(19,15718,10,3,0)=15721
^DIC(19,15718,10,4,0)=15722
^DIC(19,15718,10,5,0)=15723
^DIC(19,15718,10,"B",15719,1)=""
^DIC(19,15718,10,"B",15720,2)=""
^DIC(19,15718,10,"B",15721,3)=""
^DIC(19,15718,10,"B",15722,4)=""
^DIC(19,15718,10,"B",15723,5)=""
^DIC(19,15718,99)="67411,49174"
^DIC(19,15718,"U")="REPORT MENU FOR ALERTS"
^DIC(19,15719,0)="EHM-00540^User Alerts Count Report^^R^1^^^^^^^163^^^^"
^DIC(19,15719,1,0)="^^11^11^3240328^"
^DIC(19,15719,1,1,0)="This option is used to generate a report on users who have more than a "
^DIC(19,15719,1,2,0)="specified number of alerts in the ALERTS file (#8992).  The report covers "
^DIC(19,15719,1,3,0)="a specified range of dates, and can be sorted by user name, number of "
^DIC(19,15719,1,4,0)="alerts, or by service/section.  In addition, the report in each of these "
^DIC(19,15719,1,5,0)="formats may be generated by Divisions if desired."
^DIC(19,15719,1,6,0)=" "
^DIC(19,15719,1,7,0)="For each user who has the specified number of alerts or more, the report"
^DIC(19,15719,1,8,0)="includes the user name, the section/service for the user, the number of"
^DIC(19,15719,1,9,0)="alerts in the ALERTS file, the last sign-on date, the number of Critical "
^DIC(19,15719,1,10,0)="alerts or Abnormal Imaging alerts, and the date of the oldest alert."
^DIC(19,15719,1,11,0)="Cloned from ""XQAL USER ALERTS COUNT"" option."
^DIC(19,15719,3)=""
^DIC(19,15719,25)="EN1^XQARPRT1"
^DIC(19,15719,"U")="USER ALERTS COUNT REPORT"
^DIC(19,15720,0)="EHM-00541^Critical Alerts Count Report^^R^1^^^^^^^163^^^^"
^DIC(19,15720,1,0)="^^12^12^3240328^"
^DIC(19,15720,1,1,0)="This option is used to generate a report of users who have more than a "
^DIC(19,15720,1,2,0)="specified number of alerts containing the word 'critical' or the words "
^DIC(19,15720,1,3,0)="'abnormal imaging' between the specified start and end dates. The report"
^DIC(19,15720,1,4,0)="is presented in descending order for the number of critical/abnormal"
^DIC(19,15720,1,5,0)="imaging alerts present."
^DIC(19,15720,1,6,0)=" "
^DIC(19,15720,1,7,0)="For each user who has the specified number of critical/abnormal "
^DIC(19,15720,1,8,0)="imaging alerts or more, the report includes the user name, the"
^DIC(19,15720,1,9,0)="section/service for the user, the number of alerts in the ALERTS file, the"
^DIC(19,15720,1,10,0)="last sign-on date, the number of Critical alerts or Abnormal Imaging"
^DIC(19,15720,1,11,0)="alerts, and the date of the oldest alert."
^DIC(19,15720,1,12,0)="Cloned from ""XQAL CRITICAL ALERT COUNT"" option."
^DIC(19,15720,3)=""
^DIC(19,15720,25)="CRITICAL^XQARPRT1"
^DIC(19,15720,"U")="CRITICAL ALERTS COUNT REPORT"
^DIC(19,15721,0)="EHM-00542^List Alerts for a user from a specified date^^R^1^^^^^^^163^^^^"
^DIC(19,15721,1,0)="^^9^9^3240328^"
^DIC(19,15721,1,1,0)="This option is used to obtain an interactive list of alerts from the "
^DIC(19,15721,1,2,0)="ALERT TRACKING file (#8992.1) for a specified user starting from a "
^DIC(19,15721,1,3,0)="specified date."
^DIC(19,15721,1,4,0)=" "
^DIC(19,15721,1,5,0)="The listing includes the internal entry number for the alert in the ALERT "
^DIC(19,15721,1,6,0)="TRACKING file, the date and time the alert was generated, the message "
^DIC(19,15721,1,7,0)="text of the alert, and information about any option or routine to be "
^DIC(19,15721,1,8,0)="executed for processing the alert."
^DIC(19,15721,1,9,0)="Cloned from ""XQAL ALERT LIST FROM DATE"" option."
^DIC(19,15721,3)=""
^DIC(19,15721,25)="EN^XQARPRT2"
^DIC(19,15721,"U")="LIST ALERTS FOR A USER FROM A "
^DIC(19,15722,0)="EHM-00543^Patient Alert List for specified date^^R^1^^^^^^^163^^^^"
^DIC(19,15722,1,0)="^^13^13^3240328^"
^DIC(19,15722,1,1,0)="This option is used to obtain a list of alerts for a specified patient "
^DIC(19,15722,1,2,0)="from the ALERT TRACKING file (#8992.1) for a selected date."
^DIC(19,15722,1,3,0)=" "
^DIC(19,15722,1,4,0)="A prompt is provided to obtain a quick scan listing of dates with at least"
^DIC(19,15722,1,5,0)="some alerts for the patient on it based on OR and DVB alerts (other"
^DIC(19,15722,1,6,0)="patient related alerts need to be identified by looking at each alert's"
^DIC(19,15722,1,7,0)="message text and are included in the full list, but not the quick scan)."
^DIC(19,15722,1,8,0)=" "
^DIC(19,15722,1,9,0)="The listing includes the internal entry number for the alert in the ALERT"
^DIC(19,15722,1,10,0)="TRACKING file, the date and time the alert was generated, the message"
^DIC(19,15722,1,11,0)="text of the alert, and information about any option or routine to be"
^DIC(19,15722,1,12,0)="executed for processing the alert."
^DIC(19,15722,1,13,0)="Cloned from ""XQAL PATIENT ALERT LIST"" option."
^DIC(19,15722,3)=""
^DIC(19,15722,25)="DTPT^XQARPRT2"
^DIC(19,15722,"U")="PATIENT ALERT LIST FOR SPECIFI"
^DIC(19,15723,0)="EHM-00544^View data for Alert Tracking file entry^^R^1^^^^^^^163^^^^"
^DIC(19,15723,1,0)="^^4^4^3240328^"
^DIC(19,15723,1,1,0)="This option can be used to view data for one or more entries in the Alert "
^DIC(19,15723,1,2,0)="Tracking file (#8992.1) in captioned format. The internal entry numbers"
^DIC(19,15723,1,3,0)="for the entries to be displayed must be entered individually."
^DIC(19,15723,1,4,0)="Cloned from ""XQAL VIEW ALERT TRACKING ENTRY"" option."
^DIC(19,15723,3)=""
