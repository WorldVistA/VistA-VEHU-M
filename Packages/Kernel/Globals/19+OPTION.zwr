^DIC(19,12205,0)="EASEC LTC EXEMPT TST VIEW EDIT^View LTC Copay Exemption Test Editing^^A^10000000020^^^^^^^538^y^1"
^DIC(19,12205,1,0)="^19.06^8^8^3020306^^^"
^DIC(19,12205,1,1,0)="This option allows the user to view all changes made to a particular Long "
^DIC(19,12205,1,2,0)="Term Care Copay Exemption Test for a patient.  Some of the displayed "
^DIC(19,12205,1,3,0)="information includes date of change, user who made the change, and the "
^DIC(19,12205,1,4,0)="type of change.  If a change involves a change to the test status, then "
^DIC(19,12205,1,5,0)="both the current and previous values are displayed."
^DIC(19,12205,1,6,0)=" "
^DIC(19,12205,1,7,0)="If a LTC Exemption test is deleted, any associated changes are also "
^DIC(19,12205,1,8,0)="deleted."
^DIC(19,12205,20)="S DGMTYPT=4 D DIS^DGMTAUD"
^DIC(19,12205,"U")="VIEW LTC COPAY EXEMPTION TEST "
^DIC(19,12206,0)="EASEC LTC EXEMPTION TST DELETE^Delete a LTC Copay Exemption Test^^A^10000000020^DG MTDELETE^^^^^^538^^1"
^DIC(19,12206,1,0)="^19.06^2^2^3020220^^"
^DIC(19,12206,1,1,0)="This option is used to delete a LTC copay exemption test which may have"
^DIC(19,12206,1,2,0)="been inadvertently entered."
^DIC(19,12206,20)="S DGMTYPT=4 D EN^DGMTDEL"
^DIC(19,12206,"U")="DELETE A LTC COPAY EXEMPTION T"
^DIC(19,12207,0)="EASEC LTC EXEMPTION TEST MENU^LTC Copay Exemption Test Menu^^M^10000000020^^^^^^^538"
^DIC(19,12207,1,0)="^19.06^2^2^3020122^^"
^DIC(19,12207,1,1,0)="This is the menu that contains the options pertaining to the "
^DIC(19,12207,1,2,0)="Long Term Care Copay Exemption Test."
^DIC(19,12207,10,0)="^19.01IP^4^4"
