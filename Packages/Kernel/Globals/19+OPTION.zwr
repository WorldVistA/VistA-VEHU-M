^DIC(19,5900,1,1,0)="This option is used to generate Record Retirement Pull lists."
^DIC(19,5900,1,2,0)="The program searches for records with no activity within the"
^DIC(19,5900,1,3,0)="'retire record cutoff' window and creates pull lists based on"
^DIC(19,5900,1,4,0)="the current or home location.  The size of the pull lists can be"
^DIC(19,5900,1,5,0)="limited by selecting a terminal digit range."
^DIC(19,5900,20)="D 1^RTM"
^DIC(19,5900,"U")="GENERATE RECORD RETIREMENT PUL"
