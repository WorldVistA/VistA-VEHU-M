^DIC(19,14073,0)="FB ARCH REMINDER DELAY^ARCH Clinical Reminder Due Delay^^R^1^FB ARCH DISABLE^^^^^^344^^"
^DIC(19,14073,1,0)="^19.06^6^6^3260312^^"
^DIC(19,14073,1,1,0)="This option will modify the PROJECT ARCH REMINDER DELAY field #38 in the"
^DIC(19,14073,1,2,0)="FEE BASIS SITE PARAMETERS file #161.4 for this site. The value represents "
^DIC(19,14073,1,3,0)="the number of days that the Project ARCH Clinical Reminder will become "
^DIC(19,14073,1,4,0)="due again after the patient has either declined or refused Project ARCH "
^DIC(19,14073,1,5,0)="services. The default value is 1 but a site can edit the number of days "
^DIC(19,14073,1,6,0)="up to 180."
^DIC(19,14073,20)=""
^DIC(19,14073,25)="SETDELAY^FBARCH0"
