^DIC(19,16624,"U")="REMINDER REPORTS"
^DIC(19,16625,0)="EHM-01446^Reminders Due Report^^R^1^^^^^^^534^^^^"
^DIC(19,16625,1,0)="^19.06^20^20^3240328^^^^"
^DIC(19,16625,1,1,0)="For a selected reminder the report lists any reminders which are currently "
^DIC(19,16625,1,2,0)="due. Available report options are: "
^DIC(19,16625,1,3,0)=" "
^DIC(19,16625,1,4,0)="- Individual Patient"
^DIC(19,16625,1,5,0)="- Reminder Patient List"
^DIC(19,16625,1,6,0)="- Hospital Location  (all patients with encounters)"
^DIC(19,16625,1,7,0)="- OE/RR Team (all patients in team)"
^DIC(19,16625,1,8,0)="- PCMM Provider (all practitioner patients)"
^DIC(19,16625,1,9,0)="- PCMM Team (all patients in team)"
^DIC(19,16625,1,10,0)=" "
^DIC(19,16625,1,11,0)="A SUMMARY report  displays totals of how many patients of those selected "
^DIC(19,16625,1,12,0)="have reminders due. "
^DIC(19,16625,1,13,0)=" "
^DIC(19,16625,1,14,0)="Alternatively, a DETAILED report displays patients with reminders due in "
^DIC(19,16625,1,15,0)="alphabetical order. The report displays for each patient the date the "
^DIC(19,16625,1,16,0)="reminder is due, the date the reminder was last done and next appointment "
^DIC(19,16625,1,17,0)="date. The detailed report also (optionally) lists all future appointments."
^DIC(19,16625,1,18,0)=" "
^DIC(19,16625,1,19,0)="DETAILED reports may be saved as a local patient list."
^DIC(19,16625,1,20,0)="Cloned from ""PXRM REMINDERS DUE"" option."
^DIC(19,16625,3)=""
^DIC(19,16625,20)=""
^DIC(19,16625,25)="PXRMXD"
^DIC(19,16625,99)="60096,35982"
^DIC(19,16625,"U")="REMINDERS DUE REPORT"
^DIC(19,16626,0)="EHM-01447^Extract EPI List by Finding and SSN^^P^1^^^^^^y^534^^^^"
^DIC(19,16626,1,0)="^^31^31^3240328^"
^DIC(19,16626,1,1,0)="This option allows printing extract results stored in the REMINDER"
^DIC(19,16626,1,2,0)="EXTRACT SUMMARY file (810.3).  This option lists extracted data by"
^DIC(19,16626,1,3,0)="finding item and social security number. The finding items are loaded into"
^DIC(19,16626,1,4,0)="the REMINDER EXTRACT SUMMARY file when one of the following options is"
^DIC(19,16626,1,5,0)="run:"
^DIC(19,16626,1,6,0)="   LREPI ENHANCE MANUAL RUN    Lab Search/Extract Manual Run (Enhanced)"
^DIC(19,16626,1,7,0)="   LREPI NIGHTLY TASK          Lab Search/Extract Nightly Task"
^DIC(19,16626,1,8,0)=" "
^DIC(19,16626,1,9,0)="The Lab EPI (Emerging Pathogens Initiative) extract name follows the"
^DIC(19,16626,1,10,0)="convention: LREPI YY/MM MMDDYY, where the YY/MM is the year and month from"
^DIC(19,16626,1,11,0)="the date range specified by the LREPI extract option that created the"
^DIC(19,16626,1,12,0)="extract. MMDDYY is the month, day and year that the extract was run. The"
^DIC(19,16626,1,13,0)="prefix of LREPI identifies the extract as the result of LREPI extract"
^DIC(19,16626,1,14,0)="options (manual or automatic run for the LREPI Lab Search/Extract"
^DIC(19,16626,1,15,0)="Protocol)."
^DIC(19,16626,1,16,0)=" "
^DIC(19,16626,1,17,0)="To print all extracts for the target reporting month,enter ""LREPI YY/MM"""
^DIC(19,16626,1,18,0)="at the FROM prompt, with the year and month's data to be reported.  At"
^DIC(19,16626,1,19,0)="the TO prompt, you can limit the print to extracts for the reporting month"
^DIC(19,16626,1,20,0)="by adding a suffix to the LREPI YY/MM, for example ""LREPI YY/MM z"" will"
^DIC(19,16626,1,21,0)="get all extracts that were created for the target reporting month,"
^DIC(19,16626,1,22,0)="regardless of when they were run."
^DIC(19,16626,1,23,0)=" "
^DIC(19,16626,1,24,0)="If there have been multiple runs for the target month, you can further"
^DIC(19,16626,1,25,0)="define the FROM and TO range by specifying LREPI YY/MM MMDDYY with the"
^DIC(19,16626,1,26,0)="MMDDYY being the date the report was run. There will normally only be one"
^DIC(19,16626,1,27,0)="extract per month.  More than one will exist if your site runs the LREPI"
^DIC(19,16626,1,28,0)="ENHANCE MANUAL RUN to correct errors found by the Austin Automation"
^DIC(19,16626,1,29,0)="Center on the monthly transmission of EPI data sent by the LREPI NIGHTLY"
^DIC(19,16626,1,30,0)="TASK."
^DIC(19,16626,1,31,0)="Cloned from ""PXRM EXTRACT EPI FINDING LIST"" option."
^DIC(19,16626,3)=""
^DIC(19,16626,60)="PXRMXT(810.3,"
^DIC(19,16626,63)="[PXRM EXTRACT EPI FINDING LIST]"
^DIC(19,16626,64)="[PXRM EXTRACT EPI BY FIND_PT]"
^DIC(19,16626,"U")="EXTRACT EPI LIST BY FINDING AN"
^DIC(19,16627,0)="EHM-01448^Extract EPI Totals^^P^1^^^^^^y^534^^^^"
^DIC(19,16627,1,0)="^19.06^4^4^3240328^^"
^DIC(19,16627,1,1,0)="This option is used to summarize total counts for each type of finding"
^DIC(19,16627,1,2,0)="item that was extracted for the target date range of the LREPI ENHANCE"
^DIC(19,16627,1,3,0)="MANUAL RUN or the LREPI NIGHTLY TASK option run."
^DIC(19,16627,1,4,0)="Cloned from ""PXRM EXTRACT EPI TOTALS"" option."
^DIC(19,16627,3)=""
^DIC(19,16627,34)=""
^DIC(19,16627,60)="PXRMXT(810.3,"
^DIC(19,16627,62)=""
^DIC(19,16627,63)="[PXRM EXTRACT EPI FINDING TOT]"
^DIC(19,16627,64)="NAME"
^DIC(19,16627,65)=""
^DIC(19,16627,66)=""
^DIC(19,16627,69)="I $G(^PXRMXT(810.3,D0,0))[""LREPI"""
^DIC(19,16627,"U")="EXTRACT EPI TOTALS"
^DIC(19,16628,0)="EHM-01449^User Report Templates^^A^1^^^^^^^534^^1^^"
^DIC(19,16628,1,0)="^19.06^4^4^3240328^^"
^DIC(19,16628,1,1,0)="This option allows a user to modify the PXRM REPORT TEMPLATE (USER)"
^DIC(19,16628,1,2,0)="parameter. This parameter defines which reminder report templates are"
^DIC(19,16628,1,3,0)="available to a restricted user."
^DIC(19,16628,1,4,0)="Cloned from ""PXRM REPORT TEMPLATE (USER)"" option."
^DIC(19,16628,3)=""
^DIC(19,16628,20)="D EDITPAR^XPAREDIT(""PXRM REPORT TEMPLATE (USER)"")"
^DIC(19,16628,"U")="USER REPORT TEMPLATES"
^DIC(19,16629,0)="EHM-01450^Reminders Due Report (User)^^R^1^^^^^^^534^^^^"
^DIC(19,16629,1,0)="^19.06^3^3^3240328^^^^"
^DIC(19,16629,1,1,0)="Reminders Due Reports may be run from any report template allocated to"
^DIC(19,16629,1,2,0)="this user."
