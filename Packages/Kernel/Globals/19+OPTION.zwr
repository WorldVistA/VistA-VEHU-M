^DIC(19,12734,1,0)="^^5^5^3031202^"
^DIC(19,12734,1,1,0)="This option allows you to set the flag to indicate if a CPRS OR "
^DIC(19,12734,1,2,0)="notification/alert can be deleted without processing via the GUI alert "
^DIC(19,12734,1,3,0)="Remove button.  A ""yes"" value indicates the notification/alert can be"
^DIC(19,12734,1,4,0)="removed.  If a notification/alert has a blank value or a ""no"" value, the"
^DIC(19,12734,1,5,0)="notification/alert cannot be deleted without processing."
^DIC(19,12734,10.1)="Remove Button Flag"
^DIC(19,12734,20)="D EDITPAR^XPAREDIT(""ORB REMOVE"")"
^DIC(19,12734,"U")="GUI REMOVE BUTTON ENABLED"
