^DIC(19,5766,0)="FBCH ENTER REQUEST^Enter a Request/Notification^^R^.5^^^^^^^"
^DIC(19,5766,1,0)="^^2^2^2890126^"
^DIC(19,5766,1,1,0)="This is the entry point for contract hospitalization. The"
^DIC(19,5766,1,2,0)="option allows the user to enter the request for services."
^DIC(19,5766,25)="FBCHREQ"
^DIC(19,5766,"U")="ENTER A REQUEST/NOTIFICATION"
^DIC(19,5767,0)="FBCH LEGAL ENTITLEMENT^Legal Entitlement^^R^1^FBAA LEVEL 1 AUTH^^^^^^"
^DIC(19,5767,1,0)="^19.06^3^3^3120709^^^"
^DIC(19,5767,1,1,0)="Legal entitlement must be determined by the user before"
^DIC(19,5767,1,2,0)="medical entitlement. If the veteran is determined not"
^DIC(19,5767,1,3,0)="to be legally entitled then the request is completed."
^DIC(19,5767,25)="LENT^FBCHREQ"
^DIC(19,5767,"U")="LEGAL ENTITLEMENT"
^DIC(19,5768,0)="FBCH MEDICAL ENTITLEMENT^Medical Entitlement^^R^1^FBAA LEVEL 1 AUTH^^^^^^"
^DIC(19,5768,1,0)="^^3^3^2900424^^"
^DIC(19,5768,1,1,0)="This option is used to enter the medical entitlement of a"
^DIC(19,5768,1,2,0)="veteran. Legal entitlement has to be determined , for the"
^DIC(19,5768,1,3,0)="veteran, prior to using this option."
^DIC(19,5768,25)="MENT^FBCHREQ"
^DIC(19,5768,"U")="MEDICAL ENTITLEMENT"
^DIC(19,5769,0)="FBCH COMPLETE 7078^Complete 7078/Authorization^^R^1^FBAA LEVEL 1 AUTH^^^^^^"
^DIC(19,5769,1,0)="^19.06^3^3^3070809^^"
^DIC(19,5769,1,1,0)="If the discharge date was not determined at the time of the"
^DIC(19,5769,1,2,0)="medical entitlement, this option is used to complete"
^DIC(19,5769,1,3,0)="the 7078."
^DIC(19,5769,25)="FBCHCD"
^DIC(19,5769,"U")="COMPLETE 7078/AUTHORIZATION"
^DIC(19,5770,0)="FBCH EDIT 7078^Edit Completed 7078^^R^1^FBAA LEVEL 1 AUTH^^^^^^"
^DIC(19,5770,1,0)="^^9^9^2900725^^^"
^DIC(19,5770,1,1,0)="This option allows the user to edit a completed 7078/authorization."
^DIC(19,5770,1,2,0)="The following fields may be editted using this option:"
^DIC(19,5770,1,3,0)="         - Admitting Authority"
^DIC(19,5770,1,4,0)="         - To Date"
^DIC(19,5770,1,5,0)="         - Discharge Type"
^DIC(19,5770,1,6,0)="         - Bedsection/Treating Specialty"
^DIC(19,5770,1,7,0)="         - Purpose of Visit"
^DIC(19,5770,1,8,0)="         - Authorization Remarks"
^DIC(19,5770,1,9,0)="         - Primary Service Area"
^DIC(19,5770,25)="EDIT^FBCHCD"
^DIC(19,5770,99)="55647,37357"
^DIC(19,5770,"U")="EDIT COMPLETED 7078"
