^DIC(19,14101,0)="PRSN POC APPLICATION PARAMETER^Edit POC Division Access Parameter^^R^10000000216^^^^^^^"
^DIC(19,14101,1,0)="^^5^5^3091208^"
^DIC(19,14101,1,1,0)="The option provides the VANOD site coordinator the ability to set the "
^DIC(19,14101,1,2,0)="access parameter for POC data to either T&L unit or Nursing "
^DIC(19,14101,1,3,0)="Location for each division.  This parameter will determine how data "
^DIC(19,14101,1,4,0)="entry personnel and data approval personnel access nurses for the "
^DIC(19,14101,1,5,0)="division."
^DIC(19,14101,25)="EN^PRSNCAPE"
^DIC(19,14101,"U")="EDIT POC DIVISION ACCESS PARAM"
^DIC(19,14102,0)="PRSN DATA ENTRY MENU^Nurse POC Data Entry Menu^^M^10000000216^^^^^^y^230"
^DIC(19,14102,1,0)="^19.06^2^2^3091022^^^^"
^DIC(19,14102,1,1,0)="This is the main menu for all the options that a Nurse Point of Care "
^DIC(19,14102,1,2,0)="(POC) Data Entry Personnel will need."
^DIC(19,14102,10,0)="^19.01IP^4^4"
^DIC(19,14102,10,1,0)="14103^2^2"
^DIC(19,14102,10,2,0)="14107^1^1"
