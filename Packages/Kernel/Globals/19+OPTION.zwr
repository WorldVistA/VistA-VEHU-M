^DIC(19,7429,0)="QAM RPT MONITOR HISTORY^Monitor History Report^^R^.5^^^^^^^"
^DIC(19,7429,1,0)="^^2^2^2910417^^"
^DIC(19,7429,1,1,0)="Monitor History Report:  Shows the user the statistics for the monitor "
^DIC(19,7429,1,2,0)="broken up by time frames."
^DIC(19,7429,25)="QAMPHIS1"
