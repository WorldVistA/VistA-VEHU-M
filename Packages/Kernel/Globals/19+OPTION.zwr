^DIC(19,15773,1,0)="^19.06^4^4^3240328^^"
^DIC(19,15773,1,1,0)="This option lets you search for specific orderable items saved as"
^DIC(19,15773,1,2,0)="responses within quick orders; a new orderable item may be selected"
^DIC(19,15773,1,3,0)="to automatically replace it, as well."
^DIC(19,15773,1,4,0)="Cloned from ""ORCM SEARCH/REPLACE ORDERABLES"" option."
^DIC(19,15773,3)=""
^DIC(19,15773,25)="SEARCH^ORCMEDT6"
^DIC(19,15773,"U")="SEARCH/REPLACE ORDERABLES"
^DIC(19,15774,0)="EHM-00595^Edit VBECS item display names^^R^1^^^^^^^^^^^"
^DIC(19,15774,1,0)="^19.06^3^3^3240328^^^^"
^DIC(19,15774,1,1,0)="This option allows you to modify the display name of VBECS blood"
^DIC(19,15774,1,2,0)="components and tests."
^DIC(19,15774,1,3,0)="Cloned from ""ORCM VBECS OI EDIT"" option."
^DIC(19,15774,3)=""
