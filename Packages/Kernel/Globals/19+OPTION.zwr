^DIC(19,12908,0)="TIU169 DDEFS, C&P WORKSHEETS^Create DDEFS for C&P Worksheets^^A^10000000020^^^^^^n^516^^1"
^DIC(19,12908,1,0)="^^12^12^3040211^"
^DIC(19,12908,1,1,0)="This option creates new Document Definitions (DDEFS) for the C&P Worksheet"
^DIC(19,12908,1,2,0)="Module. The option is exported with patch TIU*1*169.  It is this option,"
^DIC(19,12908,1,3,0)="not the patch itself, which actually creates the new Document Definitions."
^DIC(19,12908,1,4,0)=" "
^DIC(19,12908,1,5,0)="This option must be run after the patch is installed.  When the option has"
^DIC(19,12908,1,6,0)="run successfully to the end and messages have indicated that all DDEFS"
^DIC(19,12908,1,7,0)="have been created successfully with no problems encountered, the option"
^DIC(19,12908,1,8,0)="may be deleted."
^DIC(19,12908,1,9,0)=" "
^DIC(19,12908,1,10,0)="This option may be rerun if desired.  However, it will not attempt to"
^DIC(19,12908,1,11,0)="recreate entries that were already created successfully the first time the"
^DIC(19,12908,1,12,0)="option was run."
^DIC(19,12908,20)="D BEGIN^TIUPS169"
^DIC(19,12908,"U")="CREATE DDEFS FOR C&P WORKSHEET"
^DIC(19,12909,0)="DGJ LOCAL VENDOR ADD^Add a local vendor (COREFLS)^CoreFLS Disabled (DGJ*1*3)^R^10000000020^DGJ LOCAL VENDOR^^^^^^554"
^DIC(19,12909,1,0)="^^4^4^3021207^"
^DIC(19,12909,1,1,0)="Use this option to add or update coreFLS vendors from the national"
^DIC(19,12909,1,2,0)="database unto your LOCAL VENDOR (#392.31) file.  The LOCAL VENDOR "
^DIC(19,12909,1,3,0)="(#392.31) file will be used to return vendor information. The need"
^DIC(19,12909,1,4,0)=" to go over the network for a coreFLS vendor will be drastically reduced."
^DIC(19,12909,25)="ADD^DGJCSL"
^DIC(19,12909,"U")="ADD A LOCAL VENDOR (COREFLS)"
