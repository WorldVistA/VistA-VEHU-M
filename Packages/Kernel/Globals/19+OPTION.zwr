^DIC(19,15340,1,0)="^^4^4^3240328^"
^DIC(19,15340,1,1,0)="This option lets you create or change generic text orders that may be"
^DIC(19,15340,1,2,0)="placed on Add Orders menus; limited access to some clinical service"
^DIC(19,15340,1,3,0)="ordering dialogs is also available through this option."
^DIC(19,15340,1,4,0)="Cloned from ""ORCM ORDERS"" option."
^DIC(19,15340,3)=""
^DIC(19,15340,25)="EN^ORCMEDT3"
^DIC(19,15340,"U")="ENTER/EDIT GENERIC ORDERS"
^DIC(19,15341,0)="EHM-00162^Enter/edit order sets^^R^1^^^^^^^^^^^"
^DIC(19,15341,1,0)="^^3^3^3240328^^"
^DIC(19,15341,1,1,0)="This option lets you create or modify order sets, by combining"
^DIC(19,15341,1,2,0)="a group of related quick orders into a single item."
^DIC(19,15341,1,3,0)="Cloned from ""ORCM ORDER SETS"" option."
^DIC(19,15341,3)=""
^DIC(19,15341,25)="SET^ORCMEDT1"
^DIC(19,15341,"U")="ENTER/EDIT ORDER SETS"
^DIC(19,15342,0)="EHM-00163^Enter/edit actions^^R^1^^^^^^^^^^^"
^DIC(19,15342,1,0)="^^3^3^3240328^"
^DIC(19,15342,1,1,0)="This option lets you create or change actions that may be placed on Add"
^DIC(19,15342,1,2,0)="Orders menus."
^DIC(19,15342,1,3,0)="Cloned from ""ORCM ACTIONS"" option."
^DIC(19,15342,3)=""
^DIC(19,15342,25)="ACTION^ORCMEDT3"
^DIC(19,15342,"U")="ENTER/EDIT ACTIONS"
^DIC(19,15343,0)="EHM-00164^Search/replace components^^R^1^^^^^^^^^^^"
^DIC(19,15343,1,0)="^^5^5^3240328^^"
^DIC(19,15343,1,1,0)="This option lets you search for specific components on menus"
^DIC(19,15343,1,2,0)="and replace or delete one or more instances of these components."
^DIC(19,15343,1,3,0)="Components include: quick orders, order sets, prompts, protocols,"
^DIC(19,15343,1,4,0)="actions, etc."
^DIC(19,15343,1,5,0)="Cloned from ""ORCM SEARCH/REPLACE"" option."
^DIC(19,15343,3)=""
^DIC(19,15343,25)="SEARCH^ORCMEDT5"
^DIC(19,15343,"U")="SEARCH/REPLACE COMPONENTS"
^DIC(19,15344,0)="EHM-00165^Assign Primary Order Menu^^A^1^^^^^^^^^1^^"
^DIC(19,15344,1,0)="^^9^9^3240328^^^^"
^DIC(19,15344,1,1,0)="This option is used to assign a primary order menu to users."
^DIC(19,15344,1,2,0)="A primary order menu must be assigned to each user in order to add"
^DIC(19,15344,1,3,0)="orders using OE/RR."
^DIC(19,15344,1,4,0)=" "
^DIC(19,15344,1,5,0)=" Examples of menus assigned to users are:"
^DIC(19,15344,1,6,0)="    ORZ ADD MENU CLINICIAN"
^DIC(19,15344,1,7,0)="    ORZ ADD MENU NURSE"
^DIC(19,15344,1,8,0)="    ORZ ADD MENU WARD CLERK"
^DIC(19,15344,1,9,0)="Cloned from ""OR PARAM ADD MENU"" option."
^DIC(19,15344,3)=""
^DIC(19,15344,20)="D EDITPAR^XPAREDIT(""OR ADD ORDERS MENU"")"
^DIC(19,15344,"U")="ASSIGN PRIMARY ORDER MENU"
^DIC(19,15345,0)="EHM-00166^List Primary Order Menus^^R^1^^^^^^^170^^^^"
^DIC(19,15345,1,0)="^^4^4^3240328^^"
^DIC(19,15345,1,1,0)="This option will print a list of users, locations, divisions etc. that"
^DIC(19,15345,1,2,0)="have a specified order menu assigned for use in the List Manager"
^DIC(19,15345,1,3,0)="interface."
^DIC(19,15345,1,4,0)="Cloned from ""ORCM LIST ORDER MENUS"" option."
^DIC(19,15345,3)=""
^DIC(19,15345,25)="AOPAR^ORCMEDT5"
^DIC(19,15345,"U")="LIST PRIMARY ORDER MENUS"
^DIC(19,15346,0)="EHM-00167^Disable/Enable order dialogs^^R^1^^^^^^^^^^^"
^DIC(19,15346,1,0)="^^3^3^3240328^"
^DIC(19,15346,1,1,0)="This option lets you disable order dialogs so that execution will be"
^DIC(19,15346,1,2,0)="prevented if selected; dialogs may also be re-enabled in this option."
^DIC(19,15346,1,3,0)="Cloned from ""ORCM DISABLE"" option."
^DIC(19,15346,3)=""
^DIC(19,15346,25)="DISABLE^ORCMEDT5"
^DIC(19,15346,"U")="DISABLE/ENABLE ORDER DIALOGS"
^DIC(19,15347,0)="EHM-00168^Manage orderable items^^M^1^^^^^^^170^^^^"
^DIC(19,15347,1,0)="^19.06^3^3^3240328^^"
^DIC(19,15347,1,1,0)="This menu contains the options that facilitate entry and edit of"
^DIC(19,15347,1,2,0)="orderable items for use in order dialogs and quick orders."
^DIC(19,15347,1,3,0)="Cloned from ""ORCM ORDERABLES MENU"" option."
^DIC(19,15347,3)=""
^DIC(19,15347,10,0)="^19.01IP^4^4"
^DIC(19,15347,10,1,0)="15348^OI^1"
^DIC(19,15347,10,2,0)="15349^QO^2"
^DIC(19,15347,10,3,0)="15350^SR^3"
^DIC(19,15347,10,4,0)="15351^VB"
^DIC(19,15347,10,"B",15348,1)=""
^DIC(19,15347,10,"B",15349,2)=""
^DIC(19,15347,10,"B",15350,3)=""
^DIC(19,15347,10,"B",15351,4)=""
^DIC(19,15347,10,"C","OI",1)=""
^DIC(19,15347,10,"C","QO",2)=""
^DIC(19,15347,10,"C","SR",3)=""
^DIC(19,15347,10,"C","VB",4)=""
^DIC(19,15347,99)="67411,49173"
^DIC(19,15347,"U")="MANAGE ORDERABLE ITEMS"
^DIC(19,15348,0)="EHM-00169^Enter/edit orderable items^^R^1^^^^^^^^^^^"
^DIC(19,15348,1,0)="^^3^3^3240328^^^^"
^DIC(19,15348,1,1,0)="This option lets you create or change the things that are orderable via"
^DIC(19,15348,1,2,0)="generic text orders at your site."
^DIC(19,15348,1,3,0)="Cloned from ""ORCM ORDERABLES"" option."
^DIC(19,15348,3)=""
^DIC(19,15348,20)=""
^DIC(19,15348,25)="OI^ORCMEDT1"
^DIC(19,15348,"U")="ENTER/EDIT ORDERABLE ITEMS"
^DIC(19,15349,0)="EHM-00170^Enter/edit QO restriction^^R^1^^^^^^^170^^^^"
^DIC(19,15349,1,0)="^19.06^4^4^3240328^^"
^DIC(19,15349,1,1,0)="This option allows a site to mark orderable items for use within pre-"
^DIC(19,15349,1,2,0)="defined quick orders only; these items will not be selectable when"
^DIC(19,15349,1,3,0)="ordering via standard package order dialogs."
^DIC(19,15349,1,4,0)="Cloned from ""ORCM QO ITEMS"" option."
^DIC(19,15349,3)=""
^DIC(19,15349,20)=""
^DIC(19,15349,25)="QO^ORCMEDT6"
^DIC(19,15349,"U")="ENTER/EDIT QO RESTRICTION"
^DIC(19,15350,0)="EHM-00171^Search/replace orderables^^R^1^^^^^^^170^^^^"
^DIC(19,15350,1,0)="^19.06^4^4^3240328^^"
^DIC(19,15350,1,1,0)="This option lets you search for specific orderable items saved as"
^DIC(19,15350,1,2,0)="responses within quick orders; a new orderable item may be selected"
^DIC(19,15350,1,3,0)="to automatically replace it, as well."
^DIC(19,15350,1,4,0)="Cloned from ""ORCM SEARCH/REPLACE ORDERABLES"" option."
^DIC(19,15350,3)=""
^DIC(19,15350,25)="SEARCH^ORCMEDT6"
^DIC(19,15350,"U")="SEARCH/REPLACE ORDERABLES"
^DIC(19,15351,0)="EHM-00172^Edit VBECS item display names^^R^1^^^^^^^^^^^"
^DIC(19,15351,1,0)="^19.06^3^3^3240328^^^^"
^DIC(19,15351,1,1,0)="This option allows you to modify the display name of VBECS blood"
^DIC(19,15351,1,2,0)="components and tests."
^DIC(19,15351,1,3,0)="Cloned from ""ORCM VBECS OI EDIT"" option."
^DIC(19,15351,3)=""
^DIC(19,15351,25)="OI^ORCDVBC1"
^DIC(19,15351,"U")="EDIT VBECS ITEM DISPLAY NAMES"
^DIC(19,15352,0)="EHM-00173^Edit personal quick orders by user^^R^1^^^^^^^^^^^"
^DIC(19,15352,1,0)="^19.06^6^6^3240328^^^"
^DIC(19,15352,1,1,0)="This option lets you change all quick orders for a specific user."
^DIC(19,15352,1,2,0)="The dialog for creating a quick order is similar to a dialog for entering "
^DIC(19,15352,1,3,0)="an order. The responses you enter will become the pre-defined "
^DIC(19,15352,1,4,0)="responses for this quick order. End users will have the opportunity to"
^DIC(19,15352,1,5,0)="edit these pre-defined responses, if desired."
^DIC(19,15352,1,6,0)="Cloned from ""ORCM QUICK ORDERS BY USER"" option."
^DIC(19,15352,3)=""
^DIC(19,15352,25)="QCKBYUSR^ORCMEDT7"
^DIC(19,15352,"U")="EDIT PERSONAL QUICK ORDERS BY "
^DIC(19,15353,0)="EHM-00174^Update AP Order Dialogs^^R^1^^^^^^^^^^^"
^DIC(19,15353,1,0)="^^3^3^3240328^"
^DIC(19,15353,1,1,0)="This option lets you copy, edit or create new anatomic pathology order "
^DIC(19,15353,1,2,0)="dialogs for use in CPRS."
^DIC(19,15353,1,3,0)="Cloned from ""ORCM UPDATE AP DIALOGS"" option."
^DIC(19,15353,3)=""
^DIC(19,15353,25)="APDLGS^ORWLRAP1"
^DIC(19,15353,"U")="UPDATE AP ORDER DIALOGS"
^DIC(19,15354,0)="EHM-00175^Quick Order report/conversion utilities^^M^1^^^^^^^170^^^^"
