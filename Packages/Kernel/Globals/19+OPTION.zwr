^DIC(19,8697,0)="MCPFTCONV^Convert Old Records to Released Not Verified^^R^755^^^^^^^^^1^1"
^DIC(19,8697,1,0)="^^7^7^2931215^^"
^DIC(19,8697,1,1,0)="This option will convert old records or records that do not have a"
^DIC(19,8697,1,2,0)="released status to Release Not Verified.  It can only be used if"
^DIC(19,8697,1,3,0)="Release Control/Electronic Signature is turned on.  This option allows"
^DIC(19,8697,1,4,0)="the non-key holders to view the old records but not edit them.  Before"
^DIC(19,8697,1,5,0)="executing this option, turn on Release Control/Electronic Signature then"
^DIC(19,8697,1,6,0)="go into Enter/Edit option and select the records that you want to remain as"
^DIC(19,8697,1,7,0)="Draft status."
^DIC(19,8697,15)="D ^MCDIEDIE"
^DIC(19,8697,20)="S MCPRO=""PFT"""
^DIC(19,8697,25)="CONV^MCESCONV"
^DIC(19,8697,"U")="CONVERT OLD RECORDS TO RELEASE"
