^DIC(19,3245,"U")="MAINTENANCE MENU"
^DIC(19,3246,0)="DG GECS REPORTS MENU^Reports Menu^^M^.5^^^"
^DIC(19,3246,1,0)="^^2^2^2890411^"
^DIC(19,3246,1,1,0)="This menu contains the reports necessary to manage the generic code"
^DIC(19,3246,1,2,0)="sheet system."
^DIC(19,3246,10,0)="^19.01IP^4^4"
^DIC(19,3246,10,1,0)=3234
^DIC(19,3246,10,2,0)=3299
^DIC(19,3246,10,3,0)=3235
^DIC(19,3246,10,4,0)="3251^"
