^DIC(19,16228,0)="EHM-01049^Edit Term Definition^^R^1^^^^^^^512^^^^"
^DIC(19,16228,1,0)="^^3^3^3240328^^^^"
^DIC(19,16228,1,1,0)="This option lets managers edit the definition of an expression.  This"
^DIC(19,16228,1,2,0)="definition is accessable during searches using the Lexicon help routine."
^DIC(19,16228,1,3,0)="Cloned from ""LEX MGR EDIT DEFN"" option."
