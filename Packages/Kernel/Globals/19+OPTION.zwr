^DIC(19,12315,"U")="INSTITUTION DEA# EDIT"
^DIC(19,12316,0)="EAS MERGE DUP MT/COPAY DEP^Merge Duplicate MT/Copay Dependents^^R^11748^DG MEANSTEST^^^^^^538^y"
^DIC(19,12316,1,0)="^^4^4^3020513^"
^DIC(19,12316,1,1,0)="This menu option will allow holders of the DG MEANSTEST security key the"
^DIC(19,12316,1,2,0)="ability to merge dependents considered to be duplicates in the PATIENT "
^DIC(19,12316,1,3,0)="RELATION File.  Data deleted during the process is stored in an ^XTMP"
^DIC(19,12316,1,4,0)="global for 10 days."
^DIC(19,12316,25)="OPTION^EASXDR"
^DIC(19,12316,"U")="MERGE DUPLICATE MT/COPAY DEPEN"
^DIC(19,12317,0)="EAS DELETE MT/COPAY DEPENDENT^Delete Means Test/Copay Dependents^^R^11748^DG MEANSTEST^^^^^^538^y"
^DIC(19,12317,1,0)="^^5^5^3020513^"
^DIC(19,12317,1,1,0)="This menu option requires the user to be a holder of the DG MEANSTEST"
^DIC(19,12317,1,2,0)="security key.  The option will allow authorized users to delete a Means "
^DIC(19,12317,1,3,0)="Test and/or Copay Test Dependent without having to manually process all"
^DIC(19,12317,1,4,0)="Means Tests on file for the patient.  Data deleted during the process is"
^DIC(19,12317,1,5,0)="stored in an ^XTMP global for 10 days."
^DIC(19,12317,25)="DELETE^EASXDR"
^DIC(19,12317,"U")="DELETE MEANS TEST/COPAY DEPEND"
^DIC(19,12318,0)="EAS DUPLICATE DEPENDENTS RPT^Duplicate Dependents Report^^R^11748^DG MEANSTEST^^^^^^538^y^1"
