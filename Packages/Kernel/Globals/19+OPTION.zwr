^DIC(19,16187,0)="EHM-01008^Precedence of 'Health Summary Types List'^^R^1^^^^^^^^^^^"
^DIC(19,16187,1,0)="^^18^18^3240328^"
^DIC(19,16187,1,1,0)="Use this option to select the defined Health Summary Types to include"
^DIC(19,16187,1,2,0)="on the list and arrange them in the order (precedence) that they "
^DIC(19,16187,1,3,0)="should appear on the list.  The three most common groups of Health "
^DIC(19,16187,1,4,0)="Summary Types are:"
^DIC(19,16187,1,5,0)=""
^DIC(19,16187,1,6,0)=" SYS  Health Summary Types may be defined for all users on the system."
^DIC(19,16187,1,7,0)=""
^DIC(19,16187,1,8,0)=" USR  Health Summary Types may be defined for a single user on the"
^DIC(19,16187,1,9,0)="      system."
^DIC(19,16187,1,10,0)=""
^DIC(19,16187,1,11,0)=" NAT  Nationally exported Health Summary Types (NAT) defined for "
^DIC(19,16187,1,12,0)="      system users or a single user are treated independently to"
^DIC(19,16187,1,13,0)="      keep them together in the list box."
^DIC(19,16187,1,14,0)=""
^DIC(19,16187,1,15,0)="In this option, you must first select those Health Summary Type groups"
^DIC(19,16187,1,16,0)="(SYS, USR, NAT, etc.) to include on the Reports Tab, then specify the"
^DIC(19,16187,1,17,0)="order in which they will appear on the Reports Tab."
^DIC(19,16187,1,18,0)="Cloned from ""GMTS GUI HS LIST PRECEDENCE"" option."
^DIC(19,16187,3)=""
^DIC(19,16187,25)="PREC^GMTSXA"
^DIC(19,16187,"U")="PRECEDENCE OF 'HEALTH SUMMARY "
^DIC(19,16188,0)="EHM-01009^Method of compiling 'Health Summary Types List'^^R^1^^^^^^^^^^^"
^DIC(19,16188,1,0)="^19.06^14^14^3240328^^^"
^DIC(19,16188,1,1,0)="Use this option to edit the method used to build the list of Health"
^DIC(19,16188,1,2,0)="Summary Types displayed on the Reports Tab in CPRS.  There are 2 "
^DIC(19,16188,1,3,0)="methods:"
^DIC(19,16188,1,4,0)=""
^DIC(19,16188,1,5,0)="   Overwrite   System-defined Health Summary Types are added "
^DIC(19,16188,1,6,0)="               to the list.  If there are User-defined Health"
^DIC(19,16188,1,7,0)="               Summary Types, then they will replace the System"
^DIC(19,16188,1,8,0)="               defined Health Summary Types already on the list."
^DIC(19,16188,1,9,0)=""
^DIC(19,16188,1,10,0)="   Append      System-defined Health Summary Types are added to"
^DIC(19,16188,1,11,0)="               the list.  If there are User-defined Health Summary"
^DIC(19,16188,1,12,0)="               Types, then they will added to the list along with "
^DIC(19,16188,1,13,0)="               the System-defined types."
^DIC(19,16188,1,14,0)="Cloned from ""GMTS GUI HS LIST METHOD"" option."
^DIC(19,16188,3)=""
^DIC(19,16188,25)="METH^GMTSXA"
^DIC(19,16188,"U")="METHOD OF COMPILING 'HEALTH SU"
