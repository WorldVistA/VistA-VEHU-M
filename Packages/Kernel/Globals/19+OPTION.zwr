^DIC(19,5633,0)="PRCFD BULLETIN DUE^Send CI's Due Bulletin^^R^11740^^^^^^^"
^DIC(19,5633,1,0)="^19.06^6^6^3000607^^^^"
^DIC(19,5633,1,1,0)="This option will generate a bulletin to CP Officials and clerks "
^DIC(19,5633,1,2,0)="to notify them that a CI is due in Fiscal service on"
^DIC(19,5633,1,3,0)="a specific date.  The date selected will be for those Invoices due in 7 days"
^DIC(19,5633,1,4,0)="from the date this option is run."
^DIC(19,5633,1,5,0)=" "
^DIC(19,5633,1,6,0)="This option will notify the service ONE time only."
