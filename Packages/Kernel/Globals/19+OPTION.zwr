^DIC(19,13444,0)="XUS NPI LOCAL REPORTS^Print Local NPI Reports^^R^10000000020^^^^^^^163"
^DIC(19,13444,1,0)="^^2^2^3060505^"
^DIC(19,13444,1,1,0)="This option is used to generate reports for the local facility on those "
