^DIC(19,13661,0)="LRAP ALERT^Send an AP Alert^^R^10000000216^LRVERIFY^^^^^^26"
^DIC(19,13661,1,0)="^^2^2^3080423^"
^DIC(19,13661,1,1,0)="This option allows a pathologist to send an action alert to a provider"
^DIC(19,13661,1,2,0)="or other person(s) or mail group(s) after the case has been released."
^DIC(19,13661,25)="LRAPALRT"
^DIC(19,13661,"U")="SEND AN AP ALERT"
^DIC(19,13662,0)="OR MEDICATION QO CHECKER^Medication Quick Order Report^^A^10000000020^^^^^^^170^^1"
^DIC(19,13662,1,0)="^19.06^6^6^3081001^^"
^DIC(19,13662,1,1,0)="This option generates two reports (printed to an e-mail message sent to "
^DIC(19,13662,1,2,0)="the originator of the report) of Quick Orders that should be evaluated "
^DIC(19,13662,1,3,0)="due to the addition of three new fields in CPRS 27:  Route, IV Type and "
^DIC(19,13662,1,4,0)="Schedule.  One report includes QOs that are contained in an order menu, "
^DIC(19,13662,1,5,0)="order set or a reminder dialog.  The other report includes QOs that are "
^DIC(19,13662,1,6,0)="stand alone and not included in another entry. "
^DIC(19,13662,20)="D ATWILL^ORWOD"
^DIC(19,13662,"U")="MEDICATION QUICK ORDER REPORT"
^DIC(19,13663,0)="ORK ORD CHK OVERRIDE REPORT^Order Check Override Reason Report^^R^10000000020^^^^^^^170"
^DIC(19,13663,1,0)="^^4^4^3061114^"
^DIC(19,13663,1,1,0)="Provides a reporting utility that enables facilities to review critical "
^DIC(19,13663,1,2,0)="order check override reasons. Allow for reports to be extracted, "
^DIC(19,13663,1,3,0)="filtered, and sorted by DATE/TIME ORDERED, DIVISION, DISPLAY GROUP, ORDER "
^DIC(19,13663,1,4,0)="CHECK, and ORDER# or any combination of these."
^DIC(19,13663,25)="EN^OROVRRPT"
^DIC(19,13663,"U")="ORDER CHECK OVERRIDE REASON RE"
^DIC(19,13664,0)="ORLP TEAM LIST VISIBILITY^Set                List Visibility^^R^10000000020^^^^^^^170^y"
^DIC(19,13664,1,0)="^19.06^7^7^3071116^^"
^DIC(19,13664,1,1,0)="Allow team lists to be designated to be used by GUI applications for:"
^DIC(19,13664,1,2,0)=" "
^DIC(19,13664,1,3,0)="  0 = OWNER - only viewable by the owner "
^DIC(19,13664,1,4,0)="  1 = ALLUSERS - viewable by anyone"
^DIC(19,13664,1,5,0)=" "
^DIC(19,13664,1,6,0)="This allows for exclusion of teams from these GUI applications and "
^DIC(19,13664,1,7,0)="would prevent users from viewing some information that is not appropriate."
^DIC(19,13664,25)="ORLSTVIZ"
^DIC(19,13664,"U")="SET                LIST VISIBI"
^DIC(19,13665,0)="OR LAPSED ORDERS^Lapsed Orders search^^R^10000000020^^^^^^^170"
^DIC(19,13665,1,0)="^^10^10^3070119^"
^DIC(19,13665,1,1,0)="This option will allow the user to search for LAPSED orders and sort them "
^DIC(19,13665,1,2,0)="by Service/Section, Provider, Patient, or Location."
^DIC(19,13665,1,3,0)=" "
^DIC(19,13665,1,4,0)="A start date entry will allow the site to ignore lapsed orders that "
^DIC(19,13665,1,5,0)="fall within their allowed grace period. For example: the site allows the "
^DIC(19,13665,1,6,0)="clinician 48 hours to sign unsigned orders, you would enter T-2 for a "
^DIC(19,13665,1,7,0)="start date.  A stop date entry will allow the site to ignore orders older "
^DIC(19,13665,1,8,0)="than the date entered. An example of this would be, if you wanted to "
^DIC(19,13665,1,9,0)="ignore lapsed orders that were placed prior to CPRS and you installed "
^DIC(19,13665,1,10,0)="CPRS on Jan 1, 1999, you would enter 010199."
^DIC(19,13665,25)="EN^ORLPSR"
^DIC(19,13665,"U")="LAPSED ORDERS SEARCH"
^DIC(19,13666,0)="OR INPT CLOZAPINE MESSAGE^GUI Edit Inpatient Clozapine Message^^A^10000000020^^^^^^^170^^1"
^DIC(19,13666,20)="D EDITPAR^XPAREDIT(""OR CLOZ INPT MSG"")"
^DIC(19,13666,"U")="GUI EDIT INPATIENT CLOZAPINE M"
