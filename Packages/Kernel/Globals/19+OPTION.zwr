^DIC(19,10524,25)="EN1^PRCH2A"
^DIC(19,10524,"U")="CARD HOLDER DAILY CHARGE STATE"
^DIC(19,10525,0)="DG141 LIST^DG141 SC 0% MT REPORT^^R^1253^^^^^^^114"
^DIC(19,10525,1,0)="^^5^5^2970929^^"
^DIC(19,10525,1,1,0)="This report option will list those veterans whose Means Test or"
^DIC(19,10525,1,2,0)="Copay Test statuses were changed as a result of the fixes in "
^DIC(19,10525,1,3,0)="patch DG*5.3*141."
^DIC(19,10525,1,4,0)=" "
^DIC(19,10525,1,5,0)="This option will only be available for use through 4/1/98."
^DIC(19,10525,25)="EN^DGMT141A"
^DIC(19,10525,"U")="DG141 SC 0% MT REPORT"
^DIC(19,10526,0)="XUDEV RES-CLEAR^Clear all resources^^R^983^^^^^^^163"
^DIC(19,10526,1,0)="^^5^5^2961115^"
^DIC(19,10526,1,1,0)="This option should only be used as a TaskMan Startup option or by"
^DIC(19,10526,1,2,0)="a knowledgeable site person."
^DIC(19,10526,1,3,0)=" "
^DIC(19,10526,1,4,0)="This option will loop through all entries in the Resource file (3.54)"
^DIC(19,10526,1,5,0)="and remove any slot in use entries."
^DIC(19,10526,25)="RELALL^XUDHRES"
^DIC(19,10526,200.9)="y"
^DIC(19,10526,"U")="CLEAR ALL RESOURCES"
^DIC(19,10527,0)="XUDEV RES-ONE^Clear one Resource^^R^983^^^^^^^163"
^DIC(19,10527,1,0)="^^2^2^2961125^"
^DIC(19,10527,1,1,0)="This option will allow the clearing/reseting of one entry of one"
^DIC(19,10527,1,2,0)="resource.  This is to be used by IRM personal to clear problems."
^DIC(19,10527,25)="RELONE^XUDHRES"
^DIC(19,10527,"U")="CLEAR ONE RESOURCE"
^DIC(19,10528,0)="XUERTRP TYPE^Remove a TYPE of error^^R^983^^^^^^^163^y"
^DIC(19,10528,25)="TYPE^XTERPUR"
^DIC(19,10528,"U")="REMOVE A TYPE OF ERROR"
^DIC(19,10529,0)="XU-PERSON CLASS REMOVE^Remove a person class entry^^R^983^^^^^^^163"
^DIC(19,10529,1,0)="^^4^4^2970321^"
^DIC(19,10529,1,1,0)="This option should be given only to those persons that the site trusts"
^DIC(19,10529,1,2,0)="to remove entries from the Person Class multiple of the New Person file."
^DIC(19,10529,1,3,0)="The Person Class multiple holds a history and under normal use entries"
^DIC(19,10529,1,4,0)="should not be removed.  This option is to fix real messes."
^DIC(19,10529,25)="REMOVE^XUA4A72"
^DIC(19,10529,200.9)="^y"
^DIC(19,10529,"U")="REMOVE A PERSON CLASS ENTRY"
^DIC(19,10530,0)="EC PCE FEED^EC Data Feed to PCE^MENU OPTION NO LONGER USED^R^10000000020^^^^^^^499"
^DIC(19,10530,1,0)="^19.06^6^6^3070926^^"
^DIC(19,10530,1,1,0)="This option controls the routine that sends Event Capture data "
^DIC(19,10530,1,2,0)="to Patient Care Encounter (PCE) software.  The EC system data "
^DIC(19,10530,1,3,0)="is stored in the EVENT CAPTURE PATIENT file (#721).  EC data"
^DIC(19,10530,1,4,0)="that has been flagged to send to PCE will be picked and sent when"
^DIC(19,10530,1,5,0)="this routine is run. It is recommended that this routine be schedule "
^DIC(19,10530,1,6,0)="to run every 60-180 (1-3 minutes)."
^DIC(19,10530,25)="NITE^ECPCEU"
^DIC(19,10530,"U")="EC DATA FEED TO PCE"
^DIC(19,10531,0)="EC PCE REPORT^PCE Data Summary^OPTION NO LONGER SUPPORTED. USE THE ECS GUI INTERFACE.^R^11596^^2993^^^^^499^^1^1"
^DIC(19,10531,1,0)="^^6^6^2970122^^"
^DIC(19,10531,1,1,0)="This Event Capture data summary lists, by patient, key information"
^DIC(19,10531,1,2,0)="that has been sent to the Patient Care Encounter (PCE) software."
^DIC(19,10531,1,3,0)="The date and time of the procedure, procedure name listed in PCE,"
^DIC(19,10531,1,4,0)="volume of procedures sent, CPT and ICD-9 codes, associated clinic"
^DIC(19,10531,1,5,0)="and DSS ID (formerly stop code), and the provider of care are listed"
^DIC(19,10531,1,6,0)="on this report."
^DIC(19,10531,15)="W @IOF"
^DIC(19,10531,20)="W @IOF"
^DIC(19,10531,25)="ECPCER"
^DIC(19,10531,"U")="PCE DATA SUMMARY"
^DIC(19,10532,0)="ECRDSSU^DSS Unit Workload Summary ^OPTION NO LONGER SUPPORTED. USE THE ECS GUI INTERFACE.^R^11596^^2959^^^^^499^^^1"
^DIC(19,10532,1,0)="^^1^1^2970819^^"
^DIC(19,10532,1,1,0)="This option will generate the DSS Unit Workload Summary Report."
^DIC(19,10532,15)="W @IOF"
^DIC(19,10532,25)="ECRDSSU"
^DIC(19,10532,"U")="DSS UNIT WORKLOAD SUMMARY "
^DIC(19,10533,0)="ECRPERS^Inactive Person Class Report^OPTION NO LONGER SUPPORTED. USE THE ECS GUI INTERFACE.^R^11596^^2994^^^^^499^^^1"
^DIC(19,10533,1,0)="^^12^12^2970814^^"
^DIC(19,10533,1,1,0)="This option generates a provider report on EVENT CAPTURE PATIENT file"
^DIC(19,10533,1,2,0)="(#721) entries."
^DIC(19,10533,1,3,0)=" "
^DIC(19,10533,1,4,0)="The report lists all those Event Capture records where any one of the"
^DIC(19,10533,1,5,0)="providers (i.e., PROVIDER, PROVIDER #2, or PROVIDER #3) satisfies one"
^DIC(19,10533,1,6,0)="of the following criteria:"
^DIC(19,10533,1,7,0)=" "
^DIC(19,10533,1,8,0)="   (1) The provider does not have a Person Class specified"
^DIC(19,10533,1,9,0)="       in the NEW PERSON file (#200)."
^DIC(19,10533,1,10,0)=" "
^DIC(19,10533,1,11,0)="   (2) The provider does not have an active Person Class entry"
^DIC(19,10533,1,12,0)="       for the Event Capture patient's procedure date."
^DIC(19,10533,15)="W @IOF"
^DIC(19,10533,25)="EN^ECRPCLS"
^DIC(19,10533,"U")="INACTIVE PERSON CLASS REPORT"
^DIC(19,10534,0)="ECRPRSN^Procedure Reason Report^OPTION NO LONGER SUPPORTED. USE THE ECS GUI INTERFACE.^R^11596^^2995^^^^^499^^^1"
^DIC(19,10534,1,0)="^^8^8^2970819^"
^DIC(19,10534,1,1,0)="This report provides a listing of Procedure Reasons associated with"
^DIC(19,10534,1,2,0)="Event Capture data in the Event Capture Patient file (#721).  The user"
^DIC(19,10534,1,3,0)="may select a date range for the file #721 records to be included in"
^DIC(19,10534,1,4,0)="the report.  The user may also select the Location(s) and DSS Unit(s)"
^DIC(19,10534,1,5,0)="on which to report."
^DIC(19,10534,1,6,0)=" "
^DIC(19,10534,1,7,0)="The file #721 records are sorted and listed by Procedure Reason and"
^DIC(19,10534,1,8,0)="Procedure within each Location/DSS Unit."
^DIC(19,10534,15)="W @IOF"
^DIC(19,10534,25)="EN^ECRPRSN"
^DIC(19,10534,"U")="PROCEDURE REASON REPORT"
^DIC(19,10535,0)="ECMULT PROC^Multiple Dates/Multiple Procedures Data Entry^OPTION NO LONGER SUPPORTED. USE THE ECS GUI INTERFACE.^R^11596^^2996^^^^^499^^^1"
^DIC(19,10535,1,0)="^^3^3^2970902^"
^DIC(19,10535,1,1,0)="This data entry option allows the user to select multiple procedure dates"
^DIC(19,10535,1,2,0)="and procedures within a specified location and DSS Unit.  Multiple"
^DIC(19,10535,1,3,0)="patients may then be selected and filed with these procedures."
^DIC(19,10535,15)="W @IOF"
^DIC(19,10535,20)=""
^DIC(19,10535,25)="ECMLMD"
^DIC(19,10535,99)="57222,31988"
^DIC(19,10535,"U")="MULTIPLE DATES/MULTIPLE PROCED"
^DIC(19,10536,0)="PRC SO TO AR^Enter/Edit Date When SOs become ARs^^R^11740^PRCFA SUPERVISOR^^^^^^121"
^DIC(19,10536,1,0)="^19.06^13^13^3000606^^"
^DIC(19,10536,1,1,0)="To synchronize IFCAP with Austin, the IFCAP PARAMETERS Cross-reference for"
^DIC(19,10536,1,2,0)="the ADMIN. ACTIVITY SITE PARAMETER file (#411) is created to contain"
^DIC(19,10536,1,3,0)="non-site specific data.  The cross-reference is NOT record oriented and"
^DIC(19,10536,1,4,0)="will initially have only one entry: "
^DIC(19,10536,1,5,0)=" "
^DIC(19,10536,1,6,0)="       ^PRC(411,""A IFCAP-Wide Parameters"",""SO 2 AR Date"") = date"
^DIC(19,10536,1,7,0)=" "
^DIC(19,10536,1,8,0)="being that date on which Austin will convert ""this year's unpaid POs"" to"
^DIC(19,10536,1,9,0)="""Last Year's"", i.e. that date on which IFCAP must convert to ""SO""s and"
^DIC(19,10536,1,10,0)="""AR""s -- SO TO AR DATE (#2)."
^DIC(19,10536,1,11,0)=" "
^DIC(19,10536,1,12,0)="The option Enter the ""SO"" to ""AR"" Shift Date for Austin/IFCAP"
^DIC(19,10536,1,13,0)="Synchronization [PRCB SO TO AR] is provided to enter that date."
^DIC(19,10536,25)="SOAR^PRCFD8L"
^DIC(19,10536,"U")="ENTER/EDIT DATE WHEN SOS BECOM"
^DIC(19,10537,0)="FB VEN FPDS BLANK^List Vendors Without FPDS Data^^R^1999^^^^^^^344"
