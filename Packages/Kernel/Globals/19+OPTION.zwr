^DIC(19,16204,0)="EHM-01025^Display Site Health Summary List Defaults^^R^1^^^^^^^^^^^"
^DIC(19,16204,1,0)="^^6^6^3240328^"
^DIC(19,16204,1,1,0)="Use this option to display the site defaults for building the list"
^DIC(19,16204,1,2,0)="of Health Summary Types on the Reports Tab in CPRS. The display "
^DIC(19,16204,1,3,0)="includes the method for building the list and the precedence of "
^DIC(19,16204,1,4,0)="parameters. These default values will be used in the event that the"
^DIC(19,16204,1,5,0)="user has not established user preferences."
^DIC(19,16204,1,6,0)="Cloned from ""GMTS GUI SITE DISPLAY DEFAULTS"" option."
^DIC(19,16204,3)=""
^DIC(19,16204,25)="DS^GMTSXA"
^DIC(19,16204,"U")="DISPLAY SITE HEALTH SUMMARY LI"
^DIC(19,16205,0)="EHM-01026^Edit Default HS Type List Compile Method^^R^1^^^^^^^160^^^^"
^DIC(19,16205,1,0)="^^14^14^3240328^"
^DIC(19,16205,1,1,0)="Use this option to modifiy how the list of Health Summary Types "
^DIC(19,16205,1,2,0)="is to be built for the site.  This method will be used for all "
^DIC(19,16205,1,3,0)="users who do not have user preferences set. "
^DIC(19,16205,1,4,0)="  "
^DIC(19,16205,1,5,0)="  Overwrite  System-defined Health Summary Types are added to "
^DIC(19,16205,1,6,0)="             the list. If there are User-defined Health Summary"
^DIC(19,16205,1,7,0)="             Types, then they will replace the System defined "
^DIC(19,16205,1,8,0)="             Health Summary Types already on the list."
^DIC(19,16205,1,9,0)="  "
^DIC(19,16205,1,10,0)="  Append     System-defined Health Summary Types are added to "
^DIC(19,16205,1,11,0)="             the list. If there are User-defined Health Summary"
^DIC(19,16205,1,12,0)="             Types, then they will added to the list along"
^DIC(19,16205,1,13,0)="             with the System defined types."
^DIC(19,16205,1,14,0)="Cloned from ""GMTS GUI SITE COMPILE METHOD"" option."
^DIC(19,16205,3)=""
^DIC(19,16205,25)="MS^GMTSXA"
^DIC(19,16205,"U")="EDIT DEFAULT HS TYPE LIST COMP"
^DIC(19,16206,0)="EHM-01027^Add/Edit Allowable Entities for HS List^^R^1^^^^^^^^^^^"
^DIC(19,16206,1,0)="^19.06^5^5^3240328^^^"
^DIC(19,16206,1,1,0)="Use this option to add or delete an entity (System, Division, User,"
^DIC(19,16206,1,2,0)="etc) from the list of allowable entites for the parameter 'ORWRP "
^DIC(19,16206,1,3,0)="HEALTH SUMMARY TYPE LIST' used on the CPRS Reports Tab to display"
^DIC(19,16206,1,4,0)="the Health Summary Types List."
^DIC(19,16206,1,5,0)="Cloned from ""GMTS GUI SITE PRECEDENCE"" option."
^DIC(19,16206,3)=""
^DIC(19,16206,25)="PS^GMTSXA"
^DIC(19,16206,"U")="ADD/EDIT ALLOWABLE ENTITIES FO"
^DIC(19,16207,0)="EHM-01028^Resequence Allowable Entities for HS List^^R^1^^^^^^^^^^^"
^DIC(19,16207,1,0)="^^6^6^3240328^"
^DIC(19,16207,1,1,0)="Use this option to resequence the order in which the allowable "
^DIC(19,16207,1,2,0)="entites for parameter 'ORWRP HEALTH SUMMARY TYPE LIST' are used "
^DIC(19,16207,1,3,0)="in building the list of Health Summary Types for the CPRS Reports"
^DIC(19,16207,1,4,0)="Tab.  This order is used for any user who does not have user "
^DIC(19,16207,1,5,0)="preferences set."
^DIC(19,16207,1,6,0)="Cloned from ""GMTS GUI SITE RESEQUENCE"" option."
^DIC(19,16207,3)=""
^DIC(19,16207,25)="RS^GMTSXA"
^DIC(19,16207,"U")="RESEQUENCE ALLOWABLE ENTITIES "
