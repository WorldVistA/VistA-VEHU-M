^DIC(19,3283,0)="A3FSTSHO^Show Applicants Submitted (by Batch)^^R^.5^^^^^^^"
^DIC(19,3283,1,0)="^^2^2^2890406^"
^DIC(19,3283,1,1,0)="After selecting a batch number for the date range, the station will"
^DIC(19,3283,1,2,0)="be shown all FSMB applicant names currently submitted."
^DIC(19,3283,25)="A3FSTSHO"
^DIC(19,3283,"U")="SHOW APPLICANTS SUBMITTED (BY BATCH)"
^DIC(19,3284,0)="A3FSTAT^Print Status of FSMB Requests^^R^.5^^^^^^^"
^DIC(19,3284,1,0)="^^2^2^2890407^"
^DIC(19,3284,1,1,0)="This option prints a report which shows the status of all FSMB"
^DIC(19,3284,1,2,0)="applicants entered by a station for a selected batch."
^DIC(19,3284,25)="A3FSTAT"
^DIC(19,3284,"U")="PRINT STATUS OF FSMB REQUESTS"
^DIC(19,3285,0)="A3FBCR^Create Batch Numbers^^E^.5^^^^^^^"
^DIC(19,3285,1,0)="^^4^4^2890412^^"
^DIC(19,3285,1,1,0)="This option allows the creation and editing of FSMB batches."
^DIC(19,3285,1,2,0)="It defines the beginning date/time and ending date/time"
^DIC(19,3285,1,3,0)="for a batch.  Additionally, a batch may be either ""regular"""
^DIC(19,3285,1,4,0)="or ""emergent""."
^DIC(19,3285,30)="DIZ(131001,"
^DIC(19,3285,31)="AEMQL"
^DIC(19,3285,50)="DIZ(131001,"
^DIC(19,3285,51)="[A3FBCR]"
^DIC(19,3285,"U")="CREATE BATCH NUMBERS"
