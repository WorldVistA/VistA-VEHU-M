^DIC(19,4379,25)="DEA^PRCB1A2"
^DIC(19,4379,99)="55628,54373"
^DIC(19,4379,"U")="DEACTIVATE A FUND CONTROL POIN"
^DIC(19,4380,0)="PRCB CLEAR LOCK^Clear Program Lock^^R^11740^^2925^^^^^"
^DIC(19,4380,1,0)="2^^9^9^2941108^"
^DIC(19,4380,1,1,0)="This option allows the user to clear a program lock and "
^DIC(19,4380,1,2,0)="continue processing.  This option clears a lock that "
^DIC(19,4380,1,3,0)="has been placed on batch transmission or on releasing "
^DIC(19,4380,1,4,0)="the budget figures for a station.  This can occur when "
^DIC(19,4380,1,5,0)="someone else is using the option and the system will "
^DIC(19,4380,1,6,0)="not allow a second person to perform the same function, "
^DIC(19,4380,1,7,0)="or when a system error or power problem interrupts a "
^DIC(19,4380,1,8,0)="function.  Never proceed with further processing after "
^DIC(19,4380,1,9,0)="a lock until you have used this option to clear the lock."
^DIC(19,4380,25)="CLEAR^PRCFALCK"
^DIC(19,4380,99)="54951,56793"
^DIC(19,4380,"U")="CLEAR PROGRAM LOCK"
^DIC(19,4381,0)="PRCB GENERATE CODE SHEETS^Generate FMS Budget Documents^^R^11740^^^^^^^"
^DIC(19,4381,1,0)="^^2^2^2940728^^^^"
^DIC(19,4381,1,1,0)="This option generates FMS documents for released transactions for a given"
^DIC(19,4381,1,2,0)="Fiscal Year and Quarter."
^DIC(19,4381,25)="V^PRCBCS"
^DIC(19,4381,99)="55523,51678"
^DIC(19,4381,"U")="GENERATE FMS BUDGET DOCUMENTS"
^DIC(19,4382,0)="PRCB MULTIPLE CREATE/POST^Create/Post Multiple Transaction^^R^11740^^^^^^^"
^DIC(19,4382,1,0)="^^4^4^2930512^^"
^DIC(19,4382,1,1,0)="This option will allow you to enter/edit/review multiple transactions and"
^DIC(19,4382,1,2,0)=" post them in the Fund Distribution file for release.  For transaction"
^DIC(19,4382,1,3,0)=" with a TDA # the single transaction option should be used."
^DIC(19,4382,1,4,0)="Transaction can be entered now and posted at a later date."
^DIC(19,4382,25)="PRCBMT"
^DIC(19,4382,99)="55649,41742"
^DIC(19,4382,"U")="CREATE/POST MULTIPLE TRANSACTI"
