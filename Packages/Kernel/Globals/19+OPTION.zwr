^DIC(19,15692,99)="67411,49174"
^DIC(19,15692,"U")="NOTIFICATION MGMT MENU"
^DIC(19,15693,0)="EHM-00514^Set Urgency for Notifications (GUI)^^R^1^^^^^^^^^^^"
^DIC(19,15693,1,0)="^19.06^7^7^3240328^^^^"
^DIC(19,15693,1,1,0)="Set of codes indicating the urgency for a notification for a site.  The"
^DIC(19,15693,1,2,0)="urgency is mainly used for sorting in displays.  The codes include:  "
^DIC(19,15693,1,3,0)="  "
^DIC(19,15693,1,4,0)="     1 (High):  notification is Highly urgent"
^DIC(19,15693,1,5,0)="     2 (Moderate):  notification is Moderately urgent"
^DIC(19,15693,1,6,0)="     3 (Low):  notification is of Low urgency"
^DIC(19,15693,1,7,0)="Cloned from ""ORB3 URGENCY"" option."
^DIC(19,15693,3)=""
^DIC(19,15693,25)="URG^ORB3MGR1"
^DIC(19,15693,"U")="SET URGENCY FOR NOTIFICATIONS "
^DIC(19,15694,0)="EHM-00515^Set Deletion Parameters for Notifications^^R^1^^^^^^^^^^^"
^DIC(19,15694,1,0)="^19.06^13^13^3240328^^^^"
^DIC(19,15694,1,1,0)="Enter 'I' if deleted on individual review/action; 'A' for all recipients."
^DIC(19,15694,1,2,0)="Set of codes used to determine how a notification will be deleted at a site."
^DIC(19,15694,1,3,0)="Codes include:"
^DIC(19,15694,1,4,0)="     I (Individual Recipient):  delete the notification for an individual"
^DIC(19,15694,1,5,0)="       recipient when"
^DIC(19,15694,1,6,0)="          a) that individual completes the follow-up action on "
^DIC(19,15694,1,7,0)="               notifications with associated actions."
^DIC(19,15694,1,8,0)="     A (All Recipients):  delete the notification for all recipients when"
^DIC(19,15694,1,9,0)="          a) any recipient completes the follow-up action on notifications"
^DIC(19,15694,1,10,0)="             with follow-up actions."
^DIC(19,15694,1,11,0)="          b) any recipient reviews notifications without follow-up "
^DIC(19,15694,1,12,0)="             actions."
^DIC(19,15694,1,13,0)="Cloned from ""ORB3 DELETE MECHANISM"" option."
^DIC(19,15694,3)=""
^DIC(19,15694,25)="DEL^ORB3MGR1"
^DIC(19,15694,"U")="SET DELETION PARAMETERS FOR NO"
^DIC(19,15695,0)="EHM-00516^Set Default Recipient(s) for Notifications^^R^1^^^^^^^^^^^"
^DIC(19,15695,1,0)="^^5^5^3240328^^"
^DIC(19,15695,1,1,0)="Enter 'Yes' if the recipient should always receive this notification."
^DIC(19,15695,1,2,0)="Recipients (users,teams) will receive the notification on a regular"
^DIC(19,15695,1,3,0)="basis - despite settings in the option Enable/Disable Notifications."
^DIC(19,15695,1,4,0)="These recipients will always receive the notification, regardless of patient."
^DIC(19,15695,1,5,0)="Cloned from ""ORB3 DEFAULT RECIPIENTS"" option."
^DIC(19,15695,3)=""
^DIC(19,15695,25)="REGR^ORB3MGR1"
^DIC(19,15695,31)=6
^DIC(19,15695,"U")="SET DEFAULT RECIPIENT(S) FOR N"
^DIC(19,15696,0)="EHM-00517^Set Provider Recipients for Notifications^^R^1^^^^^^^^^^^"
^DIC(19,15696,1,0)="^^15^15^3240328^^"
^DIC(19,15696,1,1,0)="Any one or combination of 'P', 'A', 'T', and/or 'O'.  "
^DIC(19,15696,1,2,0)="Set of codes indicating default (provider) recipients of a notification by"
^DIC(19,15696,1,3,0)="their title or relationship to the patient.  Notifications can be set up "
^DIC(19,15696,1,4,0)="with any or all of the following codes:"
^DIC(19,15696,1,5,0)="   P (Primary Provider):     Deliver notification to the patient's Primary"
^DIC(19,15696,1,6,0)="                             Provider."
^DIC(19,15696,1,7,0)="   A (Attending Physician):  Deliver notification to the patient's "
^DIC(19,15696,1,8,0)="                             Attending Physician."
^DIC(19,15696,1,9,0)="   T (Patient Care Team):    Deliver notification to the patient's primary"
^DIC(19,15696,1,10,0)="                             care Team."
^DIC(19,15696,1,11,0)="   O (Ordering Provider):    Deliver notification to the provider who placed"
^DIC(19,15696,1,12,0)="                             the order which triggered the notification."
^DIC(19,15696,1,13,0)="The providers, physicians and teams must be set up properly and accurately"
^DIC(19,15696,1,14,0)="for the correct individuals to receive the notification."
^DIC(19,15696,1,15,0)="Cloned from ""ORB3 PROVIDER RECIPIENTS"" option."
^DIC(19,15696,3)=""
^DIC(19,15696,25)="TITLR^ORB3MGR1"
^DIC(19,15696,"U")="SET PROVIDER RECIPIENTS FOR NO"
^DIC(19,15697,0)="EHM-00518^Enable/Disable Notifications ^^R^1^^^^^^^^^^^"
^DIC(19,15697,1,0)="^^16^16^3240328^^^^"
^DIC(19,15697,1,1,0)="Set of codes indicating processing flag for the entity and notification."
^DIC(19,15697,1,2,0)="   E (Enabled):    Notification enabled for entity unless entity of "
^DIC(19,15697,1,3,0)="                   higher precedence has notification disabled, e.g. Enabled"
^DIC(19,15697,1,4,0)="                   at System level and Disabled at User level - User will "
^DIC(19,15697,1,5,0)="                   not receive notification."
^DIC(19,15697,1,6,0)="   D (Disabled):   Notification disabled for entity unless entity of "
^DIC(19,15697,1,7,0)="                   higher precedence has notification enabled, e.g. Dis-"
^DIC(19,15697,1,8,0)="                   abled at System level and Enabled at User level - User"
^DIC(19,15697,1,9,0)="                   will receive notification.  [Note:  If the option Set"
^DIC(19,15697,1,10,0)="                   Default Recipients for Notifications (parameter ORB3"
^DIC(19,15697,1,11,0)="                   REGULAR RECIPIENTS) is set to 'True' for a Team or "
^DIC(19,15697,1,12,0)="                   User, that Team or User will always receive the notifi-"
^DIC(19,15697,1,13,0)="                   cation, regardless of the Enabled/Disabled settings.]"
^DIC(19,15697,1,14,0)="                   [Second Note:  During alpha, Class and Service will not"
^DIC(19,15697,1,15,0)="                   affect processing.]"
^DIC(19,15697,1,16,0)="Cloned from ""ORB3 PROCESSING FLAG"" option."
^DIC(19,15697,3)=""
^DIC(19,15697,25)="PFLAG^ORB3MGR1"
^DIC(19,15697,99)="56670,46270"
^DIC(19,15697,"U")="ENABLE/DISABLE NOTIFICATIONS "
^DIC(19,15698,0)="EHM-00519^Erase Notifications^^R^1^^^^^^^^^^^"
^DIC(19,15698,1,0)="^^3^3^3240328^"
^DIC(19,15698,1,1,0)="Erase all notifications for a User, erase all notifications for a Patient,"
^DIC(19,15698,1,2,0)="or erase a specific Notification."
^DIC(19,15698,1,3,0)="Cloned from ""ORB3 ERASE NOTIFICATIONS"" option."
^DIC(19,15698,3)=""
^DIC(19,15698,25)="ERASE^ORB3MGR1"
^DIC(19,15698,99)="56686,35654"
^DIC(19,15698,"U")="ERASE NOTIFICATIONS"
^DIC(19,15699,0)="EHM-00520^Flag Orderable Item(s) to Send Notifications^^R^1^^^^^^^^^^^"
^DIC(19,15699,1,0)="^^4^4^3240328^"
^DIC(19,15699,1,1,0)="Two sub-options to flag specific orderable items to send notifications when"
^DIC(19,15699,1,2,0)="they are ordered or resulted.  [Note:  This option may not be available "
^DIC(19,15699,1,3,0)="until late alpha testing.]"
^DIC(19,15699,1,4,0)="Cloned from ""ORB3 FLAG ORDERABLE ITEMS"" option."
^DIC(19,15699,3)=""
^DIC(19,15699,25)="FLGOI^ORB3MGR1"
^DIC(19,15699,"U")="FLAG ORDERABLE ITEM(S) TO SEND"
^DIC(19,15700,0)="EHM-00521^Archive(delete) after <x> Days^^R^1^^^^^^^^^^^"
^DIC(19,15700,1,0)="^^11^11^3240328^"
^DIC(19,15700,1,1,0)="Enter the number of days to archive this notification before deletion."
^DIC(19,15700,1,2,0)="The number of days to archive a notification for a site.  If not indicated,"
^DIC(19,15700,1,3,0)="the default period of 30 days is used.  The maximum number of 100,000 is"
^DIC(19,15700,1,4,0)="about 220 years.  This value is passed to the Kernal Alert Utility where"
^DIC(19,15700,1,5,0)="the actual archiving and deletion of alerts/notifications occurs."
^DIC(19,15700,1,6,0)="The effect of this option is that entries in the Alert Tracking file will "
^DIC(19,15700,1,7,0)="be removed which is a log of Alert activity, not the alets themselves.  "
^DIC(19,15700,1,8,0)="However, if the Kernel option XQALERT DELETE OLD is set to a time that is "
^DIC(19,15700,1,9,0)="greater than 30 days (or whatever the value is for the ORB3 ARCHIVE "
^DIC(19,15700,1,10,0)="PERIOD) then this option will also delete old alerts."
^DIC(19,15700,1,11,0)="Cloned from ""ORB3 ARCHIVE PERIOD"" option."
^DIC(19,15700,3)=""
^DIC(19,15700,25)="ARC^ORB3MGR1"
^DIC(19,15700,"U")="ARCHIVE(DELETE) AFTER <X> DAYS"
^DIC(19,15701,0)="EHM-00522^Send Flagged Orders Bulletin^^R^1^^^^^^^^^^^"
^DIC(19,15701,1,0)="^^7^7^3240328^^^^"
^DIC(19,15701,1,1,0)="Enter 'yes' to send a bulletin when an order is flagged for clarification."
^DIC(19,15701,1,2,0)="'Yes' indicates a MailMan bulletin will be sent to the order's Current"
^DIC(19,15701,1,3,0)="Provider (usually the Ordering Provider) when the order is flagged for"
^DIC(19,15701,1,4,0)="clarification.  This parameter has no effect on the Flagged Orders"
^DIC(19,15701,1,5,0)="notification which is also triggered when an order is flagged for"
^DIC(19,15701,1,6,0)="clarification."
^DIC(19,15701,1,7,0)="Cloned from ""ORB3 FLAGGED ORDERS BULLETIN"" option."
^DIC(19,15701,3)=""
^DIC(19,15701,25)="FLGOB^ORB3MGR1"
^DIC(19,15701,"U")="SEND FLAGGED ORDERS BULLETIN"
^DIC(19,15702,0)="EHM-00523^Determine Recipients for a Notification^^R^1^^^^^^^170^^^^"
^DIC(19,15702,1,0)="^^5^5^3240328^^^"
^DIC(19,15702,1,1,0)="Based on Notification, Patient and optional Order Number and Default/"
^DIC(19,15702,1,2,0)="Regular Recipients, a list of recipients and potential recipients is "
^DIC(19,15702,1,3,0)="presented.  This is a tool for IRM or Clinical Coordinators only.  It will"
^DIC(19,15702,1,4,0)="enable the user to determine if and why a user receives a notification."
^DIC(19,15702,1,5,0)="Cloned from ""ORB3 DETERMINE RECIPIENTS"" option."
^DIC(19,15702,3)=""
^DIC(19,15702,10.1)="Determine Notif Recipients"
^DIC(19,15702,25)="RECIPS^ORB3U1"
^DIC(19,15702,"U")="DETERMINE RECIPIENTS FOR A NOT"
^DIC(19,15703,0)="EHM-00524^Set Default Recipient Device(s) for Notifications^^R^1^^^^^^^^^^^"
^DIC(19,15703,1,0)="^^5^5^3240328^^"
^DIC(19,15703,1,1,0)="Enter 'Yes' if the device should always receive this notification. Devices"
^DIC(19,15703,1,2,0)="will receive the notification on a regular basis - despite setting in the"
^DIC(19,15703,1,3,0)="option Enable/Disable Notifications.  These devices will always receive"
^DIC(19,15703,1,4,0)="the notification, regardless of patient."
^DIC(19,15703,1,5,0)="Cloned from ""ORB3 DEFAULT RECIPIENT DEVICES"" option."
^DIC(19,15703,3)=""
^DIC(19,15703,25)="REGDEV^ORB3MGR1"
^DIC(19,15703,"U")="SET DEFAULT RECIPIENT DEVICE(S"
^DIC(19,15704,0)="EHM-00525^Display Patient Alerts and Alert Recipients^^R^1^^^^^^^170^^^^"
^DIC(19,15704,1,0)="^^7^7^3240328^^"
^DIC(19,15704,1,1,0)="This option prompts for a patient then displays all Kernel Alerts for that"
^DIC(19,15704,1,2,0)="patient.  You are then prompted to select one or more alerts.  Recipients"
^DIC(19,15704,1,3,0)="of those alerts are then displayed or printed along with relevant data"
^DIC(19,15704,1,4,0)="regarding how they processed the alert.  This option uses the Alert "
^DIC(19,15704,1,5,0)="Tracking file [^XTV(8992.1]."
^DIC(19,15704,1,6,0)="If an alert has an associated order number, it is displayed in brackets."
^DIC(19,15704,1,7,0)="Cloned from ""ORB3 ALERT RECIPIENTS"" option."
^DIC(19,15704,3)=""
^DIC(19,15704,10.1)="Display Alert Recipients"
^DIC(19,15704,25)="ALRTHX^ORB3U1"
^DIC(19,15704,"U")="DISPLAY PATIENT ALERTS AND ALE"
^DIC(19,15705,0)="EHM-00526^Enable or Disable Notification System^^R^1^^^^^^^^^^^"
^DIC(19,15705,1,0)="^^6^6^3240328^^"
^DIC(19,15705,1,1,0)="Determines if any notification processing will occur in entire"
^DIC(19,15705,1,2,0)="Notifications system. 'E' or 'Enable' indicates the Notification system is"
^DIC(19,15705,1,3,0)="enabled and running.  'D' or 'Disabled' indicates the Notification system"
^DIC(19,15705,1,4,0)="is disabled and not running.  Can be set at the Institution or System"
^DIC(19,15705,1,5,0)="level."
^DIC(19,15705,1,6,0)="Cloned from ""ORB3 SYSTEM ENABLE/DISABLE"" option."
^DIC(19,15705,3)=""
^DIC(19,15705,25)="SYSEN^ORB3MGR1"
^DIC(19,15705,"U")="ENABLE OR DISABLE NOTIFICATION"
^DIC(19,15706,0)="EHM-00527^Display the Notifications a User Can Receive^^R^1^^^^^^^170^^^1^"
^DIC(19,15706,1,0)="^19.06^4^4^3240328^^"
^DIC(19,15706,1,1,0)="This option prompts for a user/recipient then processes each notification "
^DIC(19,15706,1,2,0)="to determine if and why the user will receive the notification.  This "
^DIC(19,15706,1,3,0)="information is then displayed."
^DIC(19,15706,1,4,0)="Cloned from ""ORB3 RECIP NOTIFICATIONS"" option."
^DIC(19,15706,3)=""
^DIC(19,15706,15)="W @IOF"
^DIC(19,15706,25)="DETV^ORPARMG1"
^DIC(19,15706,"U")="DISPLAY THE NOTIFICATIONS A US"
^DIC(19,15707,0)="EHM-00528^Forward Notifications^^M^1^^^^^^^^^^^"
^DIC(19,15707,1,0)="^19.06^3^3^3240328^^"
^DIC(19,15707,1,1,0)="This menu option is used to access options which set up parameters for"
^DIC(19,15707,1,2,0)="forwarding notifications/alerts."
^DIC(19,15707,1,3,0)="Cloned from ""ORB3 FORWARD NOTIFS MENU"" option."
^DIC(19,15707,3)=""
^DIC(19,15707,10,0)="^19.01IP^3^3"
^DIC(19,15707,10,1,0)="15708^1"
^DIC(19,15707,10,2,0)="15709^2"
^DIC(19,15707,10,3,0)="15710^3"
^DIC(19,15707,10,"B",15708,1)=""
^DIC(19,15707,10,"B",15709,2)=""
^DIC(19,15707,10,"B",15710,3)=""
^DIC(19,15707,10,"C",1,1)=""
^DIC(19,15707,10,"C",2,2)=""
^DIC(19,15707,10,"C",3,3)=""
^DIC(19,15707,10.1)="Forward Notifications"
^DIC(19,15707,99)="67411,49174"
^DIC(19,15707,"U")="FORWARD NOTIFICATIONS"
^DIC(19,15708,0)="EHM-00529^Forward Unprocessed Notification to Supervisor^^R^1^^^^^^^^^^^"
^DIC(19,15708,1,0)="^^12^12^3240328^^^^"
^DIC(19,15708,1,1,0)="The number of days to hold a notification before it is forwarded to a"
^DIC(19,15708,1,2,0)="recipient's supervisor.  The maximum is 30 days.  If not indicated or zero, "
^DIC(19,15708,1,3,0)="the notification will not be forwarded.  For example, if a notification "
^DIC(19,15708,1,4,0)="has a value of 14 for this parameter, it will be forwarded to the supervisor"
^DIC(19,15708,1,5,0)="of each recipient who hasn't processed the notification after 14 days.  "
^DIC(19,15708,1,6,0)="Determination of recipients who have not processed the notification and"
^DIC(19,15708,1,7,0)="who their supervisors are is made by the Kernel Alert Utility.  It will"
^DIC(19,15708,1,8,0)="not be forwarded to supervisors of recipients who have processed the "
^DIC(19,15708,1,9,0)="alert within 14 days.  If the value of this parameter is zero or"
^DIC(19,15708,1,10,0)="non-existent, the alert/notification will never be forwarded."
^DIC(19,15708,1,11,0)="[Note:  This option may not be available until late alpha testing.]"
^DIC(19,15708,1,12,0)="Cloned from ""ORB3 FORWARD SUPERVISOR"" option."
^DIC(19,15708,3)=""
^DIC(19,15708,25)="FSUPER^ORB3MGR1"
^DIC(19,15708,"U")="FORWARD UNPROCESSED NOTIFICATI"
^DIC(19,15709,0)="EHM-00530^Forward Unprocessed Notification to Surrogates^^R^1^^^^^^^^^^^"
^DIC(19,15709,1,0)="^^12^12^3240328^^"
^DIC(19,15709,1,1,0)="Number of days to hold notification before forwarding to recipient's"
^DIC(19,15709,1,2,0)="surrogates.  The maximum is 30 days.  If not indicated or zero, the "
^DIC(19,15709,1,3,0)="notification will not be forwarded.  For example, if a notification has a "
^DIC(19,15709,1,4,0)="value of 14 for this parameter, it will be forwarded to the supervisor of "
^DIC(19,15709,1,5,0)="each recipient who hasn't processed the notification after 14 days."
^DIC(19,15709,1,6,0)="Determination of recipients who have not processed the notification and"
^DIC(19,15709,1,7,0)="who their supervisors are is made by the Kernel Alert Utility. It will "
^DIC(19,15709,1,8,0)="not be forwarded to supervisors of recipients who have processed the "
^DIC(19,15709,1,9,0)="alert within 14 days.  If the value of this parameter is zero or "
^DIC(19,15709,1,10,0)="non-existent, the alert/notification will never be forwarded."
^DIC(19,15709,1,11,0)="[Note:  This option may not be available until late alpha testing.]"
^DIC(19,15709,1,12,0)="Cloned from ""ORB3 FORWARD SURROGATES"" option."
^DIC(19,15709,3)=""
^DIC(19,15709,25)="FSURR^ORB3MGR1"
^DIC(19,15709,"U")="FORWARD UNPROCESSED NOTIFICATI"
^DIC(19,15710,0)="EHM-00531^Forward Unprocessed Notification to Bkup Reviewer^^R^1^^^^^^^170^^^^"
^DIC(19,15710,1,0)="^^12^12^3240328^"
^DIC(19,15710,1,1,0)="The number of days to hold a notification before it is forwarded to a"
^DIC(19,15710,1,2,0)="recipient's backup reviewer. The maximum is 30 days.  If not indicated or"
^DIC(19,15710,1,3,0)="zero, the notification will not be forwarded.  For example, if a"
^DIC(19,15710,1,4,0)="notification has a value of 14 for this parameter, it will be forwarded to"
^DIC(19,15710,1,5,0)="the backup reviewer of each recipient who hasn't processed the"
^DIC(19,15710,1,6,0)="notification after 14 days.  Determination of recipients who have not"
^DIC(19,15710,1,7,0)="processed the notification and who their supervisors are is made by the"
^DIC(19,15710,1,8,0)="Kernel Alert Utility.  It will not be forwarded to the backup reviewer of"
^DIC(19,15710,1,9,0)="recipients who have processed the alert within 14 days.  If the value of"
^DIC(19,15710,1,10,0)="this parameter is zero or non-existent, the alert/notification will never"
^DIC(19,15710,1,11,0)="be forwarded to the backup reviewer."
^DIC(19,15710,1,12,0)="Cloned from ""ORB3 FORWARD BACKUP REVIEWER"" option."
^DIC(19,15710,3)=""
^DIC(19,15710,25)="FREVIEW^ORB3MGR1"
^DIC(19,15710,"U")="FORWARD UNPROCESSED NOTIFICATI"
