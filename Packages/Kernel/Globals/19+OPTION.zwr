^DIC(19,6339,0)="XQSMD LIMITED FM OPTIONS^Limited File Manager Options (Build)^^R^1039^XQSMDFM^^^^^^^^"
^DIC(19,6339,1,0)="^^11^11^2900201^"
^DIC(19,6339,1,1,0)="This option permits a user to build limited PRINT, EDIT, or INQUIRE"
^DIC(19,6339,1,2,0)="options.  The user must have one or more ALLOWABLE MENU PREFIX, and"
^DIC(19,6339,1,3,0)="the XQSMDFM key.  To build an edit option the user must have an"
^DIC(19,6339,1,4,0)="edit template to use.  To build a print option, the user must"
^DIC(19,6339,1,5,0)="have both a sort template and a print template.  For an inquire"
^DIC(19,6339,1,6,0)="option the user may have a print template, or can specify the file to use."
^DIC(19,6339,1,7,0)="The option is entered among the user's delegated options, so that they"
^DIC(19,6339,1,8,0)="may be included on a menu built under the Secure Menu Delegation and/or"
^DIC(19,6339,1,9,0)="given to other users as secondary options.  The name of the option is"
^DIC(19,6339,1,10,0)="restricted to the namespace designated in the ALLOWABLE MENU PREFIX"
^DIC(19,6339,1,11,0)="followed by a 'Z', and then identifying text."
^DIC(19,6339,25)="XQSMDFM"
^DIC(19,6339,"U")="LIMITED FILE MANAGER OPTIONS ("
^DIC(19,6340,0)="XQSMD COPY USER^Copy One Users Menus and Keys to others^^R^1039^^^^^^^^^"
^DIC(19,6340,1,0)="^^9^9^2900202^"
^DIC(19,6340,1,1,0)="This option is used to copy the primary menu and secondary menu options"
^DIC(19,6340,1,2,0)="from one user to one or more others.  The only options transferred will"
^DIC(19,6340,1,3,0)="be those which have been delegated to the current user.  Likewise, keys"
^DIC(19,6340,1,4,0)="which are held by the selected user may be copied to the receipient"
^DIC(19,6340,1,5,0)="users if the current user has been delegated this capacity as well."
^DIC(19,6340,1,6,0)=" "
^DIC(19,6340,1,7,0)="This option provides an application coordinator the ability to produce"
^DIC(19,6340,1,8,0)="users which have the capabilities of a current user, e.g., a ward"
^DIC(19,6340,1,9,0)="clerk, scheduling clerk, etc."
^DIC(19,6340,25)="XQSMDCPY"
^DIC(19,6340,"U")="COPY ONE USERS MENUS AND KEYS "
^DIC(19,6341,0)="XMKSP^MailMan Site Parameters^^E^10000000020^^3187^^^^^54^^^"
^DIC(19,6341,1,0)="0^19.06^71^71^3040217^^^^"
^DIC(19,6341,1,1,0)="This option allows a site manager to edit the fields in the MailMan Site"
^DIC(19,6341,1,2,0)="Parameter file that do not have to do with christening."
^DIC(19,6341,1,3,0)=""
^DIC(19,6341,1,4,0)="(To christen a domain use the XMCHRIS option.  XMCHRIS also will allow you"
^DIC(19,6341,1,5,0)="to change fields set during the original christening if you set them wrong.)"
^DIC(19,6341,1,6,0)=" "
^DIC(19,6341,1,7,0)="Following are the fields which are edited, in the order in which they"
^DIC(19,6341,1,8,0)="are edited: "
^DIC(19,6341,1,9,0)=" "
^DIC(19,6341,1,10,0)=" 1         TIME ZONE (RP4.4'), [0;2]"
^DIC(19,6341,1,11,0)=" 3         PARENT (P4.2'), [0;3]"
^DIC(19,6341,1,12,0)=" 7         REQUIRE INTRODUCTIONS? (S), [0;6]"
^DIC(19,6341,1,13,0)=" 5         SHOW INSTITUTION IN MAILMAN? (S), [0;5]"
^DIC(19,6341,1,14,0)=" 7.3       SHOW DUZ WHEN ADDRESS MESSAGE (S), [0;8]"
^DIC(19,6341,1,15,0)=" 7.4       SHOW ADDRESS ON USER LOOKUP (S), [0;10]"
^DIC(19,6341,1,16,0)=" 5.1       MESSAGE ACTION DEFAULT (S), [0;15]"
^DIC(19,6341,1,17,0)=" 21        FORWARD PRIORITY MAIL TO GROUP (S), [2;1]"
^DIC(19,6341,1,18,0)=" 22        DROP OUT OF RESTRICTED GROUP (S), [2,2]"
^DIC(19,6341,1,19,0)=" 23        TITLE SOURCE (S), [0;11]"
^DIC(19,6341,1,20,0)=" 5.11      COPY LIMIT - RECIPIENTS (NJ5,0), [.11;1]"
^DIC(19,6341,1,21,0)=" 5.12      COPY LIMIT - RESPONSES (NJ4,0), [.11;2]"
^DIC(19,6341,1,22,0)=" 5.13      COPY LIMIT - LINES (NJ7,0), [.11;3]"
^DIC(19,6341,1,23,0)=" 16.1      P-MESSAGE LINE LIMIT (NJ7,0), [.16;1]"
^DIC(19,6341,1,24,0)=" 7.2       BIG GROUP SIZE (NJ5,0), [0;7]"
^DIC(19,6341,1,25,0)=" 7.01      FWD TEST MESSAGE TO POSTMASTER (S), [FORWARD;1]"
^DIC(19,6341,1,26,0)=" 143       FAX ENABLED (S), [0;19]"
^DIC(19,6341,1,27,0)=" 8.14      LARGE MESSAGE REPORT LINES (NJ6,0), [XMUT2-LINES;1]"
^DIC(19,6341,1,28,0)=" 50        LIMITED BROADCAST (Multiple-4.32), [5;0]"
^DIC(19,6341,1,29,0)="           .01  LIMITED BROADCAST (MF), [0;1]"
^DIC(19,6341,1,30,0)="           1    POINTED TO FILE (RP1'), [0;2]"
^DIC(19,6341,1,31,0)="           2    NEW PERSON FILE XREF (RF), [0;3]"
^DIC(19,6341,1,32,0)=" 51        LIMITED BROADCAST DEFAULT (NJ3,0XO), [0;20]"
^DIC(19,6341,1,33,0)=" 17.1      MAX DIGITS FOR MESSAGE NUMBER (NJ2,0), [.17;1]"
^DIC(19,6341,1,34,0)=" 241       BACKGROUND MESSAGE DELIVERERS (FX), [6;1]"
