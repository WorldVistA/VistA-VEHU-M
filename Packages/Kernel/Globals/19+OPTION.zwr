^DIC(19,11158,0)="WV SEXUAL TRAUMA SUMMARY^Sexual Trauma Summary Report^^R^11720^^^^^^^522"
^DIC(19,11158,1,0)="^^6^6^3010228^"
^DIC(19,11158,1,1,0)="This option provides the user with a short report of the number of WH"
^DIC(19,11158,1,2,0)="patients who have experienced sexual trauma. The report may include"
^DIC(19,11158,1,3,0)="patients for a single case manager or all case managers."
^DIC(19,11158,1,4,0)=" "
^DIC(19,11158,1,5,0)="Patients who are deceased or have a date entered into the DATE INACTIVE"
