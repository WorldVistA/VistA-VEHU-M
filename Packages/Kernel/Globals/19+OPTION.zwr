^DIC(19,13954,10.1)="TROUBLESHOOTING MENU"
^DIC(19,13954,99)="62054,33564"
^DIC(19,13954,"U")="TROUBLESHOOTING MENU"
^DIC(19,13955,0)="HLO CLIENT TRACE^CLIENT TRACE^^R^10000000216^^^^^^y^304"
^DIC(19,13955,1,0)="^19.06^6^6^3100111^^"
^DIC(19,13955,1,1,0)="The client trace tool is used to run the HLO"
^DIC(19,13955,1,2,0)="client in the foreground and to trace its"
^DIC(19,13955,1,3,0)="execution.  The purpose of the tool is to"
^DIC(19,13955,1,4,0)="determine failure points within the client"
^DIC(19,13955,1,5,0)="process."
^DIC(19,13955,1,6,0)=""
^DIC(19,13955,10.1)="Client trace tool"
^DIC(19,13955,25)="HLOTRACE"
^DIC(19,13955,"U")="CLIENT TRACE"
^DIC(19,13956,0)="HLO SERVER TRACE^SERVER TRACE^^R^10000000216^^^^^^y^304"
^DIC(19,13956,1,0)="^19.06^5^5^3091124^^"
^DIC(19,13956,1,1,0)="The server trace tool is used to trace the "
^DIC(19,13956,1,2,0)="execution of the HLO server.  The purpose"
^DIC(19,13956,1,3,0)="of the tools is to troubleshoot the server"
^DIC(19,13956,1,4,0)="functionality and find failure points."
^DIC(19,13956,1,5,0)=""
^DIC(19,13956,10.1)="SERVER TRACE TOOL"
^DIC(19,13956,25)="HLOSTRAC"
^DIC(19,13956,"U")="SERVER TRACE"
^DIC(19,13957,0)="HLO SET QUEUE PRIORITY^SET OUTGOING QUEUE PRIORITY^^R^10000000216^^^^^^y^304"
^DIC(19,13957,1,0)="^19.06^7^7^3100120^^^^"
^DIC(19,13957,1,1,0)="This option allows users to add/edit entries in the HLO PRIORITY QUEUES"
^DIC(19,13957,1,2,0)="file (#779.9). Creating a Priority Queue allows the operations staff"
^DIC(19,13957,1,3,0)="to increase or decrease the throughput of particular queues. The default"
^DIC(19,13957,1,4,0)="priority of a queue is 50.  For queues that tend to backup, their priority"
^DIC(19,13957,1,5,0)="should be set to higher than 50."
^DIC(19,13957,1,6,0)=""
^DIC(19,13957,1,7,0)=""
^DIC(19,13957,10.1)="SET OUTGOING QUEUE PRIORITY"
^DIC(19,13957,25)="SETPRTY^HLOQUE"
^DIC(19,13957,"U")="SET OUTGOING QUEUE PRIORITY"
^DIC(19,13958,0)="HLO PING^PING REMOTE SYSTEM^^A^10000000216^^^^^^y^304^^1"
^DIC(19,13958,1,0)="^^6^6^3091124^"
^DIC(19,13958,1,1,0)="This option asks the user to select an TCP HL Logical Link.  It then asks"
^DIC(19,13958,1,2,0)="the user to choose between the HLO port and the HL7 1.6 port.  It then"
^DIC(19,13958,1,3,0)="sends an HL7 message to that other system.  If a commit ack is returned then"
^DIC(19,13958,1,4,0)="that demonstrates that there is remote connectivity AND the remote HL7 server"
^DIC(19,13958,1,5,0)="is in operation. "
^DIC(19,13958,1,6,0)=""
^DIC(19,13958,10.1)="PING OTHER SYSTEM"
^DIC(19,13958,20)="D PING^HLOPING"
^DIC(19,13958,"U")="PING REMOTE SYSTEM"
^DIC(19,13959,0)="HLO LOG READ/WRITE ERRORS^LOG READ/WRITE ERRORS^^A^10000000216^^^^^^y^304^^1^"
^DIC(19,13959,1,0)="^19.06^10^10^3100325^^^"
^DIC(19,13959,1,1,0)="This is a troubleshooting option. Logging all errors should be turned on for"
^DIC(19,13959,1,2,0)="only short periods while troubleshooting a communication problem, and will"
^DIC(19,13959,1,3,0)="cause TCP/IP errors to be entered to the Kernel Error Trap."
^DIC(19,13959,1,4,0)=""
^DIC(19,13959,1,5,0)="Normally, the HLO software (HL7 optimized) will NOT log common errors that"
^DIC(19,13959,1,6,0)="occur durring TCP/IP communication, such as READ and WRITE errors, though other"
^DIC(19,13959,1,7,0)="types of errors ARE always entered to the Kerel Error Trap. Turning"
^DIC(19,13959,1,8,0)="logging on will cause READ and WRITE errors to be logged to the Kernel Error"
^DIC(19,13959,1,9,0)="Trap."
^DIC(19,13959,1,10,0)=""
^DIC(19,13959,15)=""
^DIC(19,13959,20)="D LOGALL^HLOUSR"
^DIC(19,13959,"U")="LOG READ/WRITE ERRORS"
