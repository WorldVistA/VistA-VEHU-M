^DIC(19,11816,99)="67255,66730"
^DIC(19,11816,"U")="TOP MENU"
^DIC(19,11817,0)="RCTOP REPORT^Print TOP Report^^R^10000000033^^^^^^^"
^DIC(19,11817,1,0)="^^3^3^2990927^"
^DIC(19,11817,1,1,0)="This option is used to print a TOP report.  It will give the current"
^DIC(19,11817,1,2,0)="balance of all debtor's referred to TOP.  The user will have the option of"
^DIC(19,11817,1,3,0)="including those debtor's referred whose balance currently is '0'."
^DIC(19,11817,25)="REPORT^RCTOPU"
^DIC(19,11817,"U")="PRINT TOP REPORT"
^DIC(19,11818,0)="RCTOP STOP^Stop/Re-activate TOP Referral For A Debtor^^R^10000000033^^^^^^^"
^DIC(19,11818,1,0)="^^3^3^2990927^"
^DIC(19,11818,1,1,0)="This option is used to allow the user to stop TOP referral for a debtor."
^DIC(19,11818,1,2,0)="It also is used to re-activate TOP referral for a debtor that had been"
^DIC(19,11818,1,3,0)="previously stopped."
^DIC(19,11818,25)="STOP^RCTOPU"
^DIC(19,11818,"U")="STOP/RE-ACTIVATE TOP REFERRAL "
^DIC(19,11819,0)="RCTOP REFUND REVERSAL^TOP Refund Reversal^^R^10000000033^^^^^^^"
^DIC(19,11819,1,0)="^19.06^5^5^3001002^^"
^DIC(19,11819,1,1,0)="This option is used to 'queue' up a refund reversal document to be sent"
^DIC(19,11819,1,2,0)="with the next TOP transmission.  The pre-payment bill must be in refunded"
^DIC(19,11819,1,3,0)="status, a TOP trace number for that bill must be present, and the TOP"
^DIC(19,11819,1,4,0)="Refund Status field must be set to 'Refund Transmitted' to complete this"
^DIC(19,11819,1,5,0)="option."
^DIC(19,11819,25)="REVERSE^RCTOPU"
^DIC(19,11819,"U")="TOP REFUND REVERSAL"
^DIC(19,11820,0)="RCTOP UPDATE REF/REV CODE^Update Refund/Refund Reversal Codes^^R^10000000033^^^^^^^"
^DIC(19,11820,1,0)="^^3^3^2990927^"
^DIC(19,11820,1,1,0)="This option is used to enter the 1 character refund and 1 character"
^DIC(19,11820,1,2,0)="reversal code to be placed on Refund and Refund Reversal documents.  This"
^DIC(19,11820,1,3,0)="code will be updated each calendar year and will be provided by TOP."
^DIC(19,11820,25)="UPDCODE^RCTOPU"
^DIC(19,11820,"U")="UPDATE REFUND/REFUND REVERSAL "
^DIC(19,11821,0)="RCTOP BILL REPORT^TOP Bill Report^^R^10000000033^^^^^^^"
^DIC(19,11821,1,0)="^^4^4^3000808^"
^DIC(19,11821,1,1,0)="This report lists the bills for the individual debtor that have been"
^DIC(19,11821,1,2,0)="forwarded to TOP.  It shows a status code, the total amount of the bill,"
^DIC(19,11821,1,3,0)="the principle,  interest, admin, marshall fee and court cost for each"
^DIC(19,11821,1,4,0)="bill."
^DIC(19,11821,25)="BILLREP^RCTOPU"
^DIC(19,11821,"U")="TOP BILL REPORT"
^DIC(19,11822,0)="RCTOP SERVER^TOP Return Messages^^S^10000000033^^^^^^^"
^DIC(19,11822,1,0)="^^1^1^3000927^"
^DIC(19,11822,1,1,0)="This server processes rejection messages for the TOP referral program."
^DIC(19,11822,25)="RCTOPS"
^DIC(19,11822,220)="^R^^Y^Y^E^1"
^DIC(19,11822,"U")="TOP RETURN MESSAGES"
^DIC(19,11823,0)="LRCAP64S^NLT Mapped Code Search^^R^11740^^^^^^^26"
^DIC(19,11823,1,0)="^19.06^11^11^3001231^^"
^DIC(19,11823,1,1,0)="This option is useful when determining what codes are linked to what"
^DIC(19,11823,1,2,0)="entry in the WKLD CODE (#64) file.e."
^DIC(19,11823,1,3,0)=" Several national coding schemes (i.e. CPT, LOINC, MORPHOLOGY) can be"
^DIC(19,11823,1,4,0)="linked to the WKLD CODE file. This option will search the entire WKLD CODE"
^DIC(19,11823,1,5,0)="file to determine if specific national codes are linked."
^DIC(19,11823,1,6,0)=" "
^DIC(19,11823,1,7,0)="The search can be done for as many codes of the same set as required. The"
^DIC(19,11823,1,8,0)="report will list the national code(s) and any WKLD CODE(s) linked."
^DIC(19,11823,1,9,0)=" "
^DIC(19,11823,1,10,0)="Can be used to assist when a particular national code should be changed or"
^DIC(19,11823,1,11,0)="deleted."
^DIC(19,11823,25)="LRCAP64S"
^DIC(19,11823,"U")="NLT MAPPED CODE SEARCH"
