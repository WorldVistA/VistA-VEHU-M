^DIC(19,10440,0)="TIU SEARCH LIST MRT^Search for Selected Documents^^A^10000000020^^^^^^n^516^^1^1"
^DIC(19,10440,1,0)="^^4^4^2960607^"
^DIC(19,10440,1,1,0)="Allows MRT's to generate lists of selected documents by extended search"
^DIC(19,10440,1,2,0)="criteria (i.e., STATUS, SEARCH CATEGORY, and REFERNCE DATE RANGE).  These"
^DIC(19,10440,1,3,0)="can then be individually or multiply reviewed, verified, sent back to"
^DIC(19,10440,1,4,0)="transcription, reassigned, or printed."
^DIC(19,10440,15)="K TIUEDT,TIULDT"
