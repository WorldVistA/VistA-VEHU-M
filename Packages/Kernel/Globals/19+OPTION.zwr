^DIC(19,227,0)="PSO PNDRX^Pull Early from Suspense^^R^11712^^^^^^^141"
^DIC(19,227,1,0)="^^4^4^2960805^^^^"
^DIC(19,227,1,1,0)="This option is used to print labels early from suspense. Specific Rx's or"
^DIC(19,227,1,2,0)="all Rx's for a patient may be pulled. Any labels printed by this option"
^DIC(19,227,1,3,0)="will then be deleted from suspense. They will not be included as part of a"
^DIC(19,227,1,4,0)="printed batch from suspense."
^DIC(19,227,20)=""
^DIC(19,227,25)="PSOSUPRX"
^DIC(19,227,"U")="PULL EARLY FROM SUSPENSE"
^DIC(19,229,0)="PSO PNDRPT^Reprint Batches from Suspense^^R^11712^^^^^^^141"
^DIC(19,229,1,0)="^^6^6^2960110^^^^"
^DIC(19,229,1,1,0)="This option allows you to reprint labels that were printed from suspense."
^DIC(19,229,1,2,0)="Each time the Print From Suspense File option is run, those labels are"
^DIC(19,229,1,3,0)="grouped in a batch. This option shows you all batches printed for the"
^DIC(19,229,1,4,0)="date range entered, and any number of batches may be selected to reprint."
^DIC(19,229,1,5,0)="Only those labels that printed with the original batch will reprint, and"
^DIC(19,229,1,6,0)="they will reprint in the same order they were originally printed."
^DIC(19,229,20)=""
^DIC(19,229,25)="PSOSURST"
^DIC(19,229,"U")="REPRINT BATCHES FROM SUSPENSE"
^DIC(19,230,0)="PSO PNDCHG^Change Suspense Date^^R^11712^^^^^^^141"
^DIC(19,230,1,0)="^^2^2^2920827^^"
^DIC(19,230,1,1,0)="This option is used to change the suspense date, fill/refill date,"
^DIC(19,230,1,2,0)="and/or delete RXs from the suspense file."
^DIC(19,230,20)=""
^DIC(19,230,25)="PSOSUCHG"
^DIC(19,230,"U")="CHANGE SUSPENSE DATE"
^DIC(19,231,0)="PSO PNDLBL^Print from Suspense File^^R^11712^^^^^^^141^^1^"
^DIC(19,231,1,0)="^^3^3^2960805^^^^"
^DIC(19,231,1,1,0)="This option is used to print labels from the suspense file for the date"
^DIC(19,231,1,2,0)="range entered for all patients. Each time this option is run, all labels"
^DIC(19,231,1,3,0)="printed then become a printed batch from suspense."
^DIC(19,231,15)=""
^DIC(19,231,20)="D:'$D(PSOPAR) ^PSOLSET"
^DIC(19,231,25)="PSOSULBL"
^DIC(19,231,200)="^"
^DIC(19,231,"U")="PRINT FROM SUSPENSE FILE"
^DIC(19,232,0)="PSO PNDEL^Auto-delete from Suspense^^R^11712^^^^^^^141"
^DIC(19,232,1,0)="^^3^3^2960904^^^^"
^DIC(19,232,1,1,0)="This option deletes printed Rx's from the suspense file if they were"
^DIC(19,232,1,2,0)="printed over the site specified number of days to remain in the suspense"
^DIC(19,232,1,3,0)="file. Once this job is queued, it is then set to run every 7 days."
^DIC(19,232,20)=""
