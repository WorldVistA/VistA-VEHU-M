^DIC(19,13596,0)="MD SCHEDULED STUDIES^Scheduled Studies^^R^1^^^^^^^557"
^DIC(19,13596,1,0)="^19.06^3^3^3071203^^^^"
^DIC(19,13596,1,1,0)="This option is tasked to run daily.  It will process the"
^DIC(19,13596,1,2,0)="HL7 messages that need to be sent to the device on a daily"
^DIC(19,13596,1,3,0)="basis for CP studies."
^DIC(19,13596,25)="EN1^MDWORSR"
^DIC(19,13596,200.9)="y"
^DIC(19,13596,"U")="SCHEDULED STUDIES"
^DIC(19,13597,0)="MD STUDY CHECK-IN^Study Check-in^^R^1^^^^^^^557"
^DIC(19,13597,1,0)="^19.06^3^3^3071203^^"
^DIC(19,13597,1,1,0)="This option is tasked to run daily.  It checks-in CP studies"
^DIC(19,13597,1,2,0)="for procedures that require multiple encounters such as"
^DIC(19,13597,1,3,0)="Hemodialysis, Respiratory Therapy, and Sleep Studies."
^DIC(19,13597,25)="CLINICPT^MDWORSR"
^DIC(19,13597,200.9)="y"
^DIC(19,13597,"U")="STUDY CHECK-IN"
^DIC(19,13598,0)="MD AUTO CHECK-IN SETUP^Auto Study Check-In Setup^^R^1^^^^^^^557"
^DIC(19,13598,1,0)="^19.06^8^8^3071203^^^"
^DIC(19,13598,1,1,0)="This option is used to populate the XPAR parameters MD USE"
^DIC(19,13598,1,2,0)="APPT WITH PROCEDURE, MD CHECK-IN PROCEDURE LIST, MD CLINIC"
^DIC(19,13598,1,3,0)="QUICK LIST, and MD CLINICS WITH MULT PROC.  The four XPAR"
^DIC(19,13598,1,4,0)="parameters are used for the auto study check-in.  Users"
^DIC(19,13598,1,5,0)="can use the option to indicate whether their site use"
^DIC(19,13598,1,6,0)="and schedule appointments.  They can populate a list of"
^DIC(19,13598,1,7,0)="procedures and associated clinics that need a CP study"
^DIC(19,13598,1,8,0)="checked-in."
^DIC(19,13598,25)="EN1^MDWSETUP"
^DIC(19,13598,"U")="AUTO STUDY CHECK-IN SETUP"
