^DIC(19,1002,1,0)="^^2^2^2970113^^^^"
^DIC(19,1002,1,1,0)="This option sets the ward patient care status and the status of all"
^DIC(19,1002,1,2,0)="patients assigned to the ward to ACTIVE."
^DIC(19,1002,25)="EN1^NURSCPLU"
^DIC(19,1002,"U")="WARD ACTIVATION PATIENT UPDATE"
^DIC(19,1005,0)="NURAPP-UNCLOC^Current Unclassified Patient Print, by Location^^R^10958^^^^^^^28"
^DIC(19,1005,1,0)="^^2^2^2891215^^^^"
^DIC(19,1005,1,1,0)="Prints a report of all unclassified patients on a specific ward for the"
^DIC(19,1005,1,2,0)="current day."
^DIC(19,1005,25)="EN1^NURACEW0"
^DIC(19,1005,"U")="CURRENT UNCLASSIFIED PATIENT P"
^DIC(19,1006,0)="NURSPE-LOC/BED^Location/Bed Section, Edit Nursing^^R^10958^^^^^^^28"
^DIC(19,1006,1,0)="^^6^6^2911211^^^^"
^DIC(19,1006,1,1,0)="This option permits the user to correct the patient's NURSING ward location"
^DIC(19,1006,1,2,0)="and NURSING AMIS bed section. Although all patient transfers are to be "
^DIC(19,1006,1,3,0)="initiated through the ADT option, a R.N. might need this nursing option"
^DIC(19,1006,1,4,0)="if: (1) ADT is down or (2) the nursing location must be changed. The AMIS "
^DIC(19,1006,1,5,0)="bed section must be updated to reflect accurate AMIS patient classification"
^DIC(19,1006,1,6,0)="statistics."
^DIC(19,1006,25)="EN1^NURSCPLE"
^DIC(19,1006,"U")="LOCATION/BED SECTION, EDIT NUR"
^DIC(19,1009,0)="FHDMP^Patient Data Log^^R^10000000020^^^^^^^119"
^DIC(19,1009,1,0)="^19.06^4^4^3040623^^^^"
^DIC(19,1009,1,1,0)="This option will dump all of the dietetic data for a particular"
^DIC(19,1009,1,2,0)="admission for a given patient. It includes all of the"
^DIC(19,1009,1,3,0)="'captured' data such as who entered the order and the exact"
^DIC(19,1009,1,4,0)="date and time of entry."
^DIC(19,1009,25)="FHDMP"
^DIC(19,1009,"U")="PATIENT DATA LOG"
