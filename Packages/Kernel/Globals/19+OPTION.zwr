^DIC(19,3556,0)="PRCAC TR TERMINATION^Terminate an Accounts Receivable^^M^10000000033^^^^^^^"
^DIC(19,3556,1,0)="^^4^4^2980120^^^^"
^DIC(19,3556,1,1,0)="This option is used to terminate an accounts receivable at the user's request."
^DIC(19,3556,1,2,0)="There are two types of Termination transaction, Terminated by Fiscal"
^DIC(19,3556,1,3,0)="Officer and Terminated by compromise with RC/DOJ. This termination changes the"
^DIC(19,3556,1,4,0)="current status of the account to inactive."
^DIC(19,3556,10,0)="^19.01PI^2^2"
