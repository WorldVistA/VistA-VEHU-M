^DIC(19,10816,0)="SRHL INTERFACE^Surgery Interface Management Menu^^M^11595^^^^^^^167^^^^^1"
^DIC(19,10816,1,0)="^^5^5^2980302^"
^DIC(19,10816,1,1,0)="This menu contains options that allow the user to set up certain interface"
^DIC(19,10816,1,2,0)="parameters that control the processing of HL7 messages.  The interface"
^DIC(19,10816,1,3,0)="adheres to the Health Level 7 (HL7) protocol and forms the basis for the"
^DIC(19,10816,1,4,0)="exchange of health care information between the VistA Surgery package and"
^DIC(19,10816,1,5,0)="any ancillary system."
^DIC(19,10816,10,0)="^19.01PI^4^4"
^DIC(19,10816,10,1,0)="10817^I^1"
^DIC(19,10816,10,2,0)="10818^F^2"
^DIC(19,10816,10,3,0)="10819^T^3"
^DIC(19,10816,10,4,0)="10820^P^4"
^DIC(19,10816,10,"B",10817,1)=""
^DIC(19,10816,10,"B",10818,2)=""
^DIC(19,10816,10,"B",10819,3)=""
^DIC(19,10816,10,"B",10820,4)=""
^DIC(19,10816,10,"C","F",2)=""
^DIC(19,10816,10,"C","I",1)=""
^DIC(19,10816,10,"C","P",4)=""
^DIC(19,10816,10,"C","T",3)=""
^DIC(19,10816,26)="D HDR^SROUTL"
^DIC(19,10816,99)="58051,63279"
^DIC(19,10816,"U")="SURGERY INTERFACE MANAGEMENT M"
^DIC(19,10817,0)="SRHL INTERFACE FLDS^Flag Interface Fields^^R^11595^^^^^^^167"
^DIC(19,10817,1,0)="^^16^16^2980520^"
^DIC(19,10817,1,1,0)="This option allows the package coordinator to set the INTERFACE field in"
^DIC(19,10817,1,2,0)="the SURGERY INTERFACE file (#133.2).  The categories listed on the first"
^DIC(19,10817,1,3,0)="screen correspond to entries in File 133.2.  These categories are listed"
^DIC(19,10817,1,4,0)="in the Surgery Health Level 7 Interface Specifications document as being"
^DIC(19,10817,1,5,0)="the OBR (Oservation Request) text identifiers. Each identifier corresponds"
^DIC(19,10817,1,6,0)="to several fields in the VistA Surgery package.  This allows the user to"
^DIC(19,10817,1,7,0)="control the flow of data between the VistA Surgery package and the"
^DIC(19,10817,1,8,0)="ancillary system on a field by field basis."
^DIC(19,10817,1,9,0)=" "
^DIC(19,10817,1,10,0)="The option lists each identifier and its current setting.  To receive the"
^DIC(19,10817,1,11,0)="data coming from the ancillary system for a category, set the flag to R"
^DIC(19,10817,1,12,0)="for receive.  To ignore the data, set the flag to N for not receive.  To"
^DIC(19,10817,1,13,0)="see a second underlying layer of OBX text identifiers (fields in File 130)"
^DIC(19,10817,1,14,0)="and their settings, set the OBR text identifier to R for receive. The"
^DIC(19,10817,1,15,0)="option will allow the user to toggle the settings for a range or for"
^DIC(19,10817,1,16,0)="individual items."
^DIC(19,10817,25)="SRHLSCRN"
^DIC(19,10817,"U")="FLAG INTERFACE FIELDS"
^DIC(19,10818,0)="SRHL DOWNLOAD INTERFACE FILES^File Download^^R^11595^^^^^^^167"
^DIC(19,10818,1,0)="^^4^4^2980302^^"
^DIC(19,10818,1,1,0)="This option is used to download Surgery interface files to the Automated"
^DIC(19,10818,1,2,0)="Anesthesia Information System (AAIS). The process is currently being done"
^DIC(19,10818,1,3,0)="by a screen capture to a file.  In the future, this will be changed to a"
^DIC(19,10818,1,4,0)="background task that can be queued to send HL7 master file updates."
^DIC(19,10818,25)="SRHLDW1"
^DIC(19,10818,"U")="FILE DOWNLOAD"
^DIC(19,10819,0)="SRHL DOWNLOAD SET OF CODES^Table Download^^R^11595^^^^^^^167"
^DIC(19,10819,1,0)="^^5^5^2980302^^"
^DIC(19,10819,1,1,0)="This option downloads the SURGERY file (#130) set of codes to the"
^DIC(19,10819,1,2,0)="Automated Anesthesia Information System (AAIS).  This process is currently"
^DIC(19,10819,1,3,0)="being done by a screen capture to a file.  In the future, this will be"
^DIC(19,10819,1,4,0)="changed to a background task that can be queued to send HL7 master file"
^DIC(19,10819,1,5,0)="updates."
^DIC(19,10819,25)="SRHLDW"
^DIC(19,10819,"U")="TABLE DOWNLOAD"
^DIC(19,10820,0)="SRHL PARAMETER^Update Interface Parameter Field^^R^11595^^^^^^^167"
^DIC(19,10820,1,0)="^^7^7^2980306^"
^DIC(19,10820,1,1,0)="This option may be used to edit the site parameter that determines which"
^DIC(19,10820,1,2,0)="Surgery HL7 interface will be used, the interface compatible with VistA"
^DIC(19,10820,1,3,0)="HL7 v1.6 or the older one compatible with VistA HL7 v1.5."
^DIC(19,10820,1,4,0)=" "
^DIC(19,10820,1,5,0)="If applications communicating with the Surgery HL7 interface must use the"
^DIC(19,10820,1,6,0)="interface designed for use with HL7 v1.5, enter YES.  Otherwise, enter NO"
^DIC(19,10820,1,7,0)="or leave this field blank."
^DIC(19,10820,25)="CHNG^SRHLU"
^DIC(19,10820,"U")="UPDATE INTERFACE PARAMETER FIE"
^DIC(19,10821,0)="RMPR NPPD PRT^Print NPPD Worksheets^^R^11731^^^^^^^249"
^DIC(19,10821,25)="RMPRN6"
^DIC(19,10821,"U")="PRINT NPPD WORKSHEETS"
