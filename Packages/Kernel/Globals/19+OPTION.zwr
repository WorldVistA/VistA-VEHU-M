^DIC(19,15438,1,3,0)="Windows executable files. Use this format: ""Display Text=Executable""."
^DIC(19,15438,1,4,0)="For example, ""Vista Terminal Emulator=KEA.EXE VISTA""."
^DIC(19,15438,1,5,0)="Cloned from ""ORW TOOL MENU ITEMS"" option."
