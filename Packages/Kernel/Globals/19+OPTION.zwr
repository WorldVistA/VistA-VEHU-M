^DIC(19,10422,0)="TIU PRINT PN ADMISSION^Admission- Prints all PNs for Current Admission^^R^11712^^^^^^^516"
^DIC(19,10422,1,0)="^^6^6^2960227^"
^DIC(19,10422,1,1,0)="This option will print all progress notes for a selected patient for the"
^DIC(19,10422,1,2,0)="current admission if patient is an inpatient or LAST admission if the"
^DIC(19,10422,1,3,0)="patient has been discharged."
^DIC(19,10422,1,4,0)=" "
^DIC(19,10422,1,5,0)="This option is intended to be used to consolidate the PNs for the chart"
^DIC(19,10422,1,6,0)="for an admission."
^DIC(19,10422,25)="ADM^TIUPRPN6"
^DIC(19,10422,"U")="ADMISSION- PRINTS ALL PNS FOR "
^DIC(19,10423,0)="TIU RELEASED/UNVERIFIED REPORT^Released/Unverified Report^^P^10000000020^^^^^^y^516"
^DIC(19,10423,1,0)="^^6^6^2960423^^^^"
^DIC(19,10423,1,1,0)="This is a report that will give information on Documents for a specified"
^DIC(19,10423,1,2,0)="time period that have been released from transcription but still aren't"
^DIC(19,10423,1,3,0)="verified. "
^DIC(19,10423,1,4,0)=" "
^DIC(19,10423,1,5,0)="This menu action can be eliminated if Transcription Release or MAS "
^DIC(19,10423,1,6,0)="Verification parameters are not enabled."
^DIC(19,10423,2)="y"
