^DIC(19,704,20)="D BRJCHK^PSGSET"
^DIC(19,704,99)="62088,37770"
^DIC(19,704,"U")="SUPERVISOR'S MENU"
^DIC(19,707,0)="PSJU EWG^Ward Groups^^R^11712^^^^^^^117"
^DIC(19,707,1,0)="^^14^14^2920630^^^^"
^DIC(19,707,1,1,0)="  Oft times a Pharmacy 'ward' will actually encompass several MAS wards."
^DIC(19,707,1,2,0)="Therefore, this package uses WARD GROUPS.  This option allows the user to"
^DIC(19,707,1,3,0)="name their ward groups and select which MAS wards fall under each one.  If"
^DIC(19,707,1,4,0)="there is a ward that stands alone, a ward group must be defined (probably"
^DIC(19,707,1,5,0)="with the same name), with that ward under it."
^DIC(19,707,1,6,0)="  When a new WARD GROUP is entered, it's TYPE is asked (PHARMACY and MAS"
^DIC(19,707,1,7,0)="are the choices).  This field is NOT editable.  No two ward groups marked"
^DIC(19,707,1,8,0)="as PHARMACY may contain the same ward, while MAS ward groups may be"
^DIC(19,707,1,9,0)="arranged and rearranged, as desired.  Only PHARMACY ward groups are select-"
^DIC(19,707,1,10,0)="able at the PICK LIST options, while any ward group is selectable at the"
^DIC(19,707,1,11,0)="other print options."
^DIC(19,707,1,12,0)="  The parameters that determine how pick lists for a ward group should print"
^DIC(19,707,1,13,0)="are now editable through this option, allowing the site to make such"
^DIC(19,707,1,14,0)="determinations by ward group."
^DIC(19,707,25)="ENWG^PSGFILED"
^DIC(19,707,"U")="WARD GROUPS"
^DIC(19,708,0)="PSJU MAR^Medication Administration Record^^R^11712^^^^^^^117"
^DIC(19,708,1,0)="^^3^3^2910312^^^^"
^DIC(19,708,1,1,0)="  Allows the user to print an MAR by patient, ward, or ward group."
^DIC(19,708,1,2,0)="The MAR shows the patients' orders and their associated administration"
^DIC(19,708,1,3,0)="times for a selected 24 hour period."
^DIC(19,708,25)="PSGMAR"
^DIC(19,708,"U")="MEDICATION ADMINISTRATION RECO"
^DIC(19,709,0)="PSJU BRJ^Unit Dose Clean-Up^^R^11712^^^^^^^117"
^DIC(19,709,1,0)="^^3^3^3000114^^^^"
^DIC(19,709,1,1,0)="  An option that is to run once every night, performing various tasks."
^DIC(19,709,1,2,0)="The main purpose of this background job is to keep the site's computer"
^DIC(19,709,1,3,0)="as free from extraneous Unit Dose data as possible."
^DIC(19,709,25)="PSGBRJ"
^DIC(19,709,99)="54410,31477"
^DIC(19,709,200.9)="y"
^DIC(19,709,1916)=""
^DIC(19,709,"U")="UNIT DOSE CLEAN-UP"
^DIC(19,710,0)="PSJU LABEL^Label Print/Reprint^^R^11712^^^^^^^117"
^DIC(19,710,1,0)="^^2^2^2910312^^^^"
^DIC(19,710,1,1,0)="  Allows the user to print new unprinted labels and/or reprint the"
^DIC(19,710,1,2,0)="latest label for any order containing a label record."
^DIC(19,710,25)="PSGL"
^DIC(19,710,99)="55927,55755"
^DIC(19,710,"U")="LABEL PRINT/REPRINT"
^DIC(19,711,0)="PSJU VBW^Non-Verified/Pending Orders^^R^1^^^^^^^^^^1"
^DIC(19,711,1,0)="^^7^7^2910312^^^^"
^DIC(19,711,1,1,0)="  Allows the user to verify (or take other actions) on non-verified orders"
^DIC(19,711,1,2,0)="for patients.  If the user is a pharmacist, this option will show all"
^DIC(19,711,1,3,0)="orders not verified by a pharmacist for a ward group, ward, or single"
^DIC(19,711,1,4,0)="patient, as the user chooses.  If the user is a nurse, this option will"
^DIC(19,711,1,5,0)="show all orders not verified by a nurse.  If the user is ward staff,"
^DIC(19,711,1,6,0)="this option will show patients with orders not verified by a nurse,"
^DIC(19,711,1,7,0)="but not allow any action to be taken."
^DIC(19,711,15)="D KILL^XUSCLEAN"
^DIC(19,711,20)=""
^DIC(19,711,25)="PSGVBW"
^DIC(19,711,99)="56742,62611"
^DIC(19,711,"U")="NON-VERIFIED/PENDING ORDERS"
^DIC(19,712,0)="PSJU CA^Discontinue All of a Patient's Orders^^R^11712^^^^^^^117"
^DIC(19,712,1,0)="^^2^2^2910312^^^^"
^DIC(19,712,1,1,0)="  Allows a pharmacist or nurse to cancel all of a patient's orders.  Allows"
^DIC(19,712,1,2,0)="a ward clerk to mark all of a patient's order for cancellation."
^DIC(19,712,25)="PSGOECA"
^DIC(19,712,"U")="DISCONTINUE ALL OF A PATIENT'S"
^DIC(19,713,0)="PSJU PLRP^Reprint Pick List^^R^11712^PSJU PL^^^^^^117"
^DIC(19,713,1,0)="^^1^1^2910312^^^^"
^DIC(19,713,1,1,0)="  Allows the user to PRINT or REPRINT any PICK LIST previously run."
^DIC(19,713,25)="PSGPLRP"
^DIC(19,713,"U")="REPRINT PICK LIST"
^DIC(19,715,0)="PSJU TRAIN DRUG LOOK-UP^Drug Look-up^^R^.5^^^"
^DIC(19,715,1,0)="^^3^3^2860723^^^"
^DIC(19,715,1,1,0)="Allows anyone to `see' what drugs are in the drug file.  Affects NO"
^DIC(19,715,1,2,0)="data!  Shows only the formulary to ward staff and nurses, and all items"
^DIC(19,715,1,3,0)="to pharmacists.  Inactive items are shown to no one."
^DIC(19,715,25)="ENDL^PSGSICHK"
^DIC(19,715,"U")="DRUG LOOK-UP"
^DIC(19,716,0)="PSJU EUD^EXtra Units Dispensed^^R^11712^PSJU PL^^^^^^117"
^DIC(19,716,1,0)="^^2^2^2910312^^^^"
^DIC(19,716,1,1,0)="  Allows a pharmacist to enter the number of any extra units dispensed for a"
^DIC(19,716,1,2,0)="Unit Dose order.  Any data entered here is used by the cost reports."
^DIC(19,716,25)="PSGEUD"
^DIC(19,716,99.1)="54305,47013"
^DIC(19,716,"U")="EXTRA UNITS DISPENSED"
^DIC(19,717,0)="PSGW EDIT AOU STOCK^Stock Items - Enter/Edit^^R^.5^^^^^^^"
^DIC(19,717,1,0)="^^2^2^2930301^^^^"
^DIC(19,717,1,1,0)="Provides access to enter or edit items stocked in an Area of Use.  This is"
^DIC(19,717,1,2,0)="how the list of items an AOU stocks is created or changed."
^DIC(19,717,25)="PSGWSTKI"
