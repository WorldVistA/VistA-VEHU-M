^DIC(19,15268,0)="EHM-00089^Print Formats^^A^1^^^^^^^^^1^^"
^DIC(19,15268,1,0)="^^3^3^3240328^^^^"
^DIC(19,15268,1,1,0)="This option allows the user to define formats for printing labels and"
^DIC(19,15268,1,2,0)="requisitions for orders."
^DIC(19,15268,1,3,0)="Cloned from ""ORCL PRINT FORMAT"" option."
