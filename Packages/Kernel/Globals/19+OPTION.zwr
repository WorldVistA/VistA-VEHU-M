^DIC(19,13825,1,2,0)="fields in the HBHC MFH file (#633.2).  Once entered, the .01 field is not"
^DIC(19,13825,1,3,0)="editable via this option.  Inspection & Training data are entered via "
^DIC(19,13825,1,4,0)="separate options."
^DIC(19,13825,25)="HBHCDEM"
^DIC(19,13825,"U")="DEMOGRAPHIC DATA ENTRY FOR MFH"
^DIC(19,13826,0)="HBHCRP26^MFH File Data Report  (132)^^R^10000000020^^^^^^^328"
^DIC(19,13826,1,0)="^^5^5^3070612^"
^DIC(19,13826,1,1,0)="This option prints the HBHC Medical Foster Home (MFH) file (#633.2) "
^DIC(19,13826,1,2,0)="report.  The report is sorted alphabetically by Medical Foster Home Name "
^DIC(19,13826,1,3,0)="& includes:  Medical Foster Home Name, Opened Date, Primary Caregiver "
^DIC(19,13826,1,4,0)="Name, Maximum Patients, Bedbound Patient Maximum, Closure Date, & "
^DIC(19,13826,1,5,0)="Voluntary Closure.  Report prints in 132 column format."
^DIC(19,13826,25)="HBHCRP26"
^DIC(19,13826,"U")="MFH FILE DATA REPORT  (132)"
^DIC(19,13827,0)="HBHC MFH MENU^Medical Foster Home (MFH) Menu^^M^10000000020^HBHC MEDICAL FOSTER HOME^^^^^^328"
^DIC(19,13827,1,0)="^^9^9^3080331^"
^DIC(19,13827,1,1,0)="This option represents the HBHC Medical Foster Home (MFH) Menu.  The Menu "
^DIC(19,13827,1,2,0)="contains the following options:"
^DIC(19,13827,1,3,0)=" "
