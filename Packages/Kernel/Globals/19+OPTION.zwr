^DIC(19,7624,0)="GMRA PRINT-FDA EXCEPT BY PT^Print Patient FDA Exception Data^^R^11595^^^^^^^247"
^DIC(19,7624,1,0)="^^27^27^2960917^^^"
^DIC(19,7624,1,1,0)="This option allows the user to select a patient and date/time range, then"
^DIC(19,7624,1,2,0)="displays the patient's reactions that:"
^DIC(19,7624,1,3,0)=" 1) are not entered-in-error,"
^DIC(19,7624,1,4,0)=" 2) are observed drug reactions,"
^DIC(19,7624,1,5,0)=" 3) are marked as 'signed-off' by the originator of the entry,"
^DIC(19,7624,1,6,0)=" 4) have an origination date/time within the date/time range selected by"
^DIC(19,7624,1,7,0)="    the user, and"
^DIC(19,7624,1,8,0)=" 5) do not have the minimum amount of FDA data needed."
^DIC(19,7624,1,9,0)="     "
^DIC(19,7624,1,10,0)="The FDA data needed is:"
^DIC(19,7624,1,11,0)=" a) date/time of the reaction,"
^DIC(19,7624,1,12,0)=" b) patient,"
^DIC(19,7624,1,13,0)=" c) date/time the reaction was reported,"
^DIC(19,7624,1,14,0)=" d) person who reported the reaction,"
^DIC(19,7624,1,15,0)=" e) the reaction itself,"
^DIC(19,7624,1,16,0)=" f) the suspected agent, and"
^DIC(19,7624,1,17,0)=" g) at least one of the following questions must be answered"
^DIC(19,7624,1,18,0)="    1) Patient died?"
^DIC(19,7624,1,19,0)="    2) Reaction treated with RX drug?"
^DIC(19,7624,1,20,0)="    3) Life Threatening illness?"
^DIC(19,7624,1,21,0)="    4) Required hospitalization?"
^DIC(19,7624,1,22,0)="    5) Prolonged Hospitalization?"
^DIC(19,7624,1,23,0)="    6) Resulted in permanent disability?"
^DIC(19,7624,1,24,0)="    7) Patient recovered?"
^DIC(19,7624,1,25,0)="    8) Is this event a Congenital Anomaly?"
^DIC(19,7624,1,26,0)="    9) Did this event require intervention to prevent impairment?"
^DIC(19,7624,1,27,0)="    10) Required ER/MD visit?"
^DIC(19,7624,25)="EN1^GMRAEF1"
^DIC(19,7624,99)="55602,55964"
^DIC(19,7624,"U")="PRINT PATIENT FDA EXCEPTION DA"
^DIC(19,7625,0)="GMRA PRINT-EXCEPT BY DATE^Print All FDA Exceptions within a D/T Range^^R^11595^^^^^^^247"
^DIC(19,7625,1,0)="^^27^27^2960917^^"
^DIC(19,7625,1,1,0)="This option allows the user to select a date/time range and then displays"
^DIC(19,7625,1,2,0)="all reactions that:"
^DIC(19,7625,1,3,0)=" 1) are not entered-in-error,"
^DIC(19,7625,1,4,0)=" 2) are observed drug reactions,"
^DIC(19,7625,1,5,0)=" 3) are marked as 'signed-off' by the originator of the entry,"
^DIC(19,7625,1,6,0)=" 4) have an origination date/time within the date/time range selected by"
^DIC(19,7625,1,7,0)="    the user, and"
^DIC(19,7625,1,8,0)=" 5) do not have the minimum amount of FDA data needed."
^DIC(19,7625,1,9,0)="     "
^DIC(19,7625,1,10,0)="The FDA data needed is:"
^DIC(19,7625,1,11,0)=" a) date/time of the reaction,"
^DIC(19,7625,1,12,0)=" b) patient,"
^DIC(19,7625,1,13,0)=" c) date/time the reaction was reported,"
^DIC(19,7625,1,14,0)=" d) person who reported the reaction,"
^DIC(19,7625,1,15,0)=" e) the reaction itself,"
^DIC(19,7625,1,16,0)=" f) the suspected agent, and"
^DIC(19,7625,1,17,0)=" g) at least one of the following questions must be answered"
^DIC(19,7625,1,18,0)="    1) Patient died?"
^DIC(19,7625,1,19,0)="    2) Reaction treated with RX drug?"
^DIC(19,7625,1,20,0)="    3) Life Threatening illness?"
^DIC(19,7625,1,21,0)="    4) Required hospitalization?"
^DIC(19,7625,1,22,0)="    5) Prolonged Hospitalization?"
^DIC(19,7625,1,23,0)="    6) Resulted in permanent disability?"
^DIC(19,7625,1,24,0)="    7) Patient recovered?"
^DIC(19,7625,1,25,0)="    8) Is this event a Congenital Anomaly?"
^DIC(19,7625,1,26,0)="    9) Did this event require intervention to prevent impairment?"
^DIC(19,7625,1,27,0)="    10) Required ER/MD visit?"
