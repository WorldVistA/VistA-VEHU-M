^DIC(19,6287,0)="NURAED-BATSEP-QUEUE^TaskManager Activation/Separation Report^^A^10958^^^^^^^28^^1"
^DIC(19,6287,1,0)="^^3^3^2931021^^^^"
^DIC(19,6287,1,1,0)="This option is used to queue the activation/separation report to print daily"
^DIC(19,6287,1,2,0)="at a time designated by the user.  This option should be queued at least 2"
^DIC(19,6287,1,3,0)="hours after queuing of the NURAAM-ACU option."
^DIC(19,6287,20)="I $D(ZTSK) S (NUROUT,NQSW,NURMDSW)=0,X=""T-1"" D ^%DT S NURSDATE=$S(+Y:Y,1:"""") D EN9^NURSAGSP S:NURMDSW NURFAC=1 D:+NURSDATE START^NURAFSD"
