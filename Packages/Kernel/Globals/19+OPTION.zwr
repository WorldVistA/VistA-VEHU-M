^DIC(19,9052,0)="XUERTRP AUTO CLEAN^Error trap Auto clean^^R^10000000216^^^^^^^"
^DIC(19,9052,1,0)="^^4^4^3120702"
^DIC(19,9052,1,1,0)="This is a queueable option to clean up the error trap. This option will "
^DIC(19,9052,1,2,0)="clean-up any errors that were recorded more than a number of days ago. The"
^DIC(19,9052,1,3,0)="number of days is defined on the KEEP ERROR TRAP field (#520.3) in the KERNEL"
^DIC(19,9052,1,4,0)="SYSTEM PARAMETERS file (#8989.3). The default is 7 if the field is blank."
^DIC(19,9052,25)="AUTO^XTERPUR"
^DIC(19,9052,200.9)="y"
^DIC(19,9052,"U")="ERROR TRAP AUTO CLEAN"
^DIC(19,9053,0)="XPD CONVERT PACKAGE^Convert Loaded Package for Redistribution^^R^1039^^^^^^^"
^DIC(19,9053,1,0)="^^6^6^2950329^"
^DIC(19,9053,1,1,0)="This option will change a Package that was loaded on your system, to"
^DIC(19,9053,1,2,0)="a Package that can be transported in a Distribution.  The loaded Package"
^DIC(19,9053,1,3,0)="will be unloaded from your system and deleted from the Install file. A"
^DIC(19,9053,1,4,0)="Build file entry will be created for this Package. You can use the"
^DIC(19,9053,1,5,0)="'Transport a Distribution' option to create a new Distribution with this"
^DIC(19,9053,1,6,0)="Package."
^DIC(19,9053,25)="EN2^XPDIU"
