^DIC(19,11782,0)="DGRU RAI BATCH UPDATE^Background job for updating RAI/MDS COTS^^R^11740^^^^^^^114"
^DIC(19,11782,1,0)="^^8^8^2991101^^^"
^DIC(19,11782,1,1,0)="This option is not intended to be run from programmer mode.  No"
^DIC(19,11782,1,2,0)="output to the screen is intended.  When this job is scheduled through TaskMan"
^DIC(19,11782,1,3,0)="it will collect and transmitt all the entries in the PIVOT file that are a"
^DIC(19,11782,1,4,0)="COTS UPDATE to patient information . The job will build DGRU PATIENT A08"
^DIC(19,11782,1,5,0)="HL7 v2.3 messages and broadcast them to the COTS subscriber the TCP"
^DIC(19,11782,1,6,0)="linkage. The job should be re-scheduled to run about every 10 minutes. The"
^DIC(19,11782,1,7,0)="task interval will determine approximately the maximum time it takes for"
^DIC(19,11782,1,8,0)="an update to patient information to be broadcast in a HL7 message."
^DIC(19,11782,25)="EN^DGRUGBJ"
^DIC(19,11782,200.9)="y"
^DIC(19,11782,"U")="BACKGROUND JOB FOR UPDATING RA"
^DIC(19,11783,0)="DGRUG MFU BACKGROUND JOB^MFU Background Job^^R^11740^^^^^^^"
^DIC(19,11783,1,0)="^^2^2^2991005^"
^DIC(19,11783,1,1,0)="Background job which checks to see if any Master File Update records"
^DIC(19,11783,1,2,0)="need to be sent to the RAI/MDS COTS system via HL7."
^DIC(19,11783,25)="DGRUGSEE"
^DIC(19,11783,"U")="MFU BACKGROUND JOB"
