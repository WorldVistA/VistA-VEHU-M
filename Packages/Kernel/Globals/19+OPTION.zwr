^DIC(19,7591,0)="HBHCADM^Evaluation/Admission Data Entry^^R^10000000020^^^^^^^"
^DIC(19,7591,1,0)="^^2^2^2970207^^^^"
^DIC(19,7591,1,1,0)="This option allows entering/editing of the evaluation/admission"
^DIC(19,7591,1,2,0)="data in the HBHC Patient File (HBHC(631))."
^DIC(19,7591,25)="HBHCADM"
^DIC(19,7591,99)="55797,38239"
^DIC(19,7591,"U")="EVALUATION/ADMISSION DATA ENTR"
^DIC(19,7593,0)="HBHCDIS^Discharge Data Entry^^R^10000000020^^^^^^^"
^DIC(19,7593,1,0)="^^2^2^2970207^^^^"
^DIC(19,7593,1,1,0)="This option allows entering/editing of the discharge data in the"
^DIC(19,7593,1,2,0)="HBHC Patient File (HBHC(631))."
^DIC(19,7593,25)="HBHCDIS"
^DIC(19,7593,"U")="DISCHARGE DATA ENTRY"
^DIC(19,7594,0)="HBHCRP2^Evaluation/Admission Data Report by Patient  (80)^^R^10000000020^^^^^^^"
^DIC(19,7594,1,0)="^^3^3^2970207^^^^"
^DIC(19,7594,1,1,0)="This option prints the HBPC Patient Evaluation/Admission Data Report."
^DIC(19,7594,1,2,0)="The report includes all evaluation/admission (Form 3) fields, plus"
^DIC(19,7594,1,3,0)="Case Manager and prints in 80 column format."
^DIC(19,7594,25)="HBHCRP2"
^DIC(19,7594,598000)=3
^DIC(19,7594,"U")="EVALUATION/ADMISSION DATA REPO"
^DIC(19,7595,0)="HBHCRP3^Patient Visit Data Report  (80)^^R^10000000020^^^^^^^"
^DIC(19,7595,1,0)="^19.06^3^3^3000421^^^^"
^DIC(19,7595,1,1,0)="This option prints the HBPC Patient Visit Data Report.  The user is "
^DIC(19,7595,1,2,0)="prompted to enter the date range for inclusion on the report.  The"
^DIC(19,7595,1,3,0)="report includes all visit (Form 4) fields and prints in 80 column format."
^DIC(19,7595,25)="HBHCRP3"
^DIC(19,7595,99)="55775,38173"
^DIC(19,7595,598000)=3
^DIC(19,7595,"U")="PATIENT VISIT DATA REPORT  (80"
^DIC(19,7596,0)="HBHCRP5^Discharge Data Report by Patient  (80)^^R^10000000020^^^^^^^"
^DIC(19,7596,1,0)="^^3^3^2970207^^^^"
^DIC(19,7596,1,1,0)="This option prints the HBPC Patient Discharge Data Report.  The "
^DIC(19,7596,1,2,0)="report includes all discharge (Form 5) fields and prints in 80 "
^DIC(19,7596,1,3,0)="column format."
^DIC(19,7596,25)="HBHCRP5"
^DIC(19,7596,598000)=3
^DIC(19,7596,"U")="DISCHARGE DATA REPORT BY PATIE"
^DIC(19,7597,0)="HBHCRP7^Admissions/Discharges by Date Range Report  (132)^^R^1^^^^^^^"
^DIC(19,7597,1,0)="^^5^5^3120302^"
^DIC(19,7597,1,1,0)="This option prints the HBPC Admissions or Discharges by Date Range Report."
^DIC(19,7597,1,2,0)="The  report is sorted Alphabetically by Patient or by Admission/Discharge"
^DIC(19,7597,1,3,0)="Date and  includes:  Admission/Discharge Date, Patient Name, Last Four,"
^DIC(19,7597,1,4,0)="and ICD Code and  Diagnosis Text  (Primary Diagnosis @"
^DIC(19,7597,1,5,0)="Admission/Discharge), with Totals.  Report prints in 132 column format."
^DIC(19,7597,25)="HBHCRP7"
^DIC(19,7597,598000)=3
^DIC(19,7597,"U")="ADMISSIONS/DISCHARGES BY DATE "
^DIC(19,7598,0)="HBHCRP4^Visit Data by Date Range Report  (80)^^R^10000000020^^^^^^^"
^DIC(19,7598,1,0)="^19.06^5^5^3000421^^^^"
^DIC(19,7598,1,1,0)="This option prints the HBPC Visit Data by Date Range Report.  The"
^DIC(19,7598,1,2,0)="report is sorted by provider, then by visit date and includes:"
^DIC(19,7598,1,3,0)="Provider Name, Visit Date, Patient Last Name, SSN, DX, & CPT Codes with"
^DIC(19,7598,1,4,0)="Modifiers, with totals by provider & all providers total if All providers"
^DIC(19,7598,1,5,0)="included on report.  Report prints in 80 column format. "
^DIC(19,7598,25)="HBHCRP4"
^DIC(19,7598,99)="55775,28786"
^DIC(19,7598,598000)=3
^DIC(19,7598,"U")="VISIT DATA BY DATE RANGE REPOR"
^DIC(19,7599,0)="HBHCRP6^Case Manager Census Report  (132)^^R^10000000020^^^^^^^"
^DIC(19,7599,1,0)="^^7^7^3050921^"
^DIC(19,7599,1,1,0)="This option prints the HBPC Case Manager Census Report.  The report"
^DIC(19,7599,1,2,0)="can be run for All or Individual Case Managers.  The user is prompted"
^DIC(19,7599,1,3,0)="to enter the date range for inclusion on the report.  The report is "
^DIC(19,7599,1,4,0)="sorted by Case Manager and includes:  Case Manager, Patient Name, Last "
^DIC(19,7599,1,5,0)="Four, Admission Date, Street Address, City, ZIP Code, and Phone, with"
^DIC(19,7599,1,6,0)="Totals for each Case Manager and Final Totals if 'All' selected.  Report"
^DIC(19,7599,1,7,0)="prints in 132 column format."
^DIC(19,7599,25)="HBHCRP6"
^DIC(19,7599,598000)=3
^DIC(19,7599,"U")="CASE MANAGER CENSUS REPORT  (1"
^DIC(19,7600,0)="HBHCFILE^Build/Verify Transmission File^^R^10000000020^^^^^^^"
^DIC(19,7600,1,0)="11^^12^12^2970207^^^^"
^DIC(19,7600,1,1,0)="This option builds the HBPC Transmission Data file (HBHC(634)) used"
^DIC(19,7600,1,2,0)="to transmit to Austin.  The records included in this file are verified"
^DIC(19,7600,1,3,0)="for completeness and also for validity  (e.g.  no admission data should"
^DIC(19,7600,1,4,0)="be included if the patient was rejected from the HBPC program)."
^DIC(19,7600,1,5,0)=" "
^DIC(19,7600,1,6,0)="If errors/omissions are found, the records in error are written to"
^DIC(19,7600,1,7,0)="another file and must be corrected before transmission is allowed."
^DIC(19,7600,1,8,0)="Once the errors are corrected, this option must be run again to "
^DIC(19,7600,1,9,0)="add the corrected records to the transmission file.  This process"
^DIC(19,7600,1,10,0)="(build file, correct errors, add corrected records via build file) "
^DIC(19,7600,1,11,0)="may be repeated as necessary until all records are valid and included"
^DIC(19,7600,1,12,0)="in the Transmission Data file."
^DIC(19,7600,25)="HBHCFILE"
^DIC(19,7600,"U")="BUILD/VERIFY TRANSMISSION FILE"
^DIC(19,7601,0)="HBHCRP1^Form Errors Report  (80)^^R^1^^^^^^^"
^DIC(19,7601,1,0)="^^6^6^3120302^"
^DIC(19,7601,1,1,0)="This option prints the HBPC Form Errors Report.  The errors were found when"
^DIC(19,7601,1,2,0)="the Build/Verify Transmission File [HBHCFILE] option was run.  The report"
^DIC(19,7601,1,3,0)="is sorted by Form, then by Patient Name and includes: Patient File IEN"
^DIC(19,7601,1,4,0)="(internal entry number), Patient Name, Last Four, and corresponding Date. "
^DIC(19,7601,1,5,0)="Visits also contain:  Clinic Name, Error, Provider, ICD Diagnosis, and CPT"
^DIC(19,7601,1,6,0)="Code fields.  Report prints in 80 column format. "
^DIC(19,7601,25)="HBHCRP1A"
^DIC(19,7601,99)="55493,57972"
^DIC(19,7601,598000)=3
^DIC(19,7601,"U")="FORM ERRORS REPORT  (80)"
^DIC(19,7602,0)="HBHCUPD^Edit Form Errors Data^^R^10000000020^^^^^^^"
^DIC(19,7602,1,0)="^^7^7^2970710^^^^"
^DIC(19,7602,1,1,0)="This option allows editing of the HBPC Form Errors Data.  The user"
^DIC(19,7602,1,2,0)="is prompted for a patient, then the routine prompts for the fields"
^DIC(19,7602,1,3,0)="that are missing or invalid in each record.  These errors are found"
^DIC(19,7602,1,4,0)="when the Build/Verify Transmission File [HBHCFILE] option is run and"
^DIC(19,7602,1,5,0)="must be corrected before transmission to Austin is allowed.  Visit error "
^DIC(19,7602,1,6,0)="corrections must be made using PCE options.  Then the Edit Form Errors"
^DIC(19,7602,1,7,0)="option must be accessed to clean up the Visit Error file. "
^DIC(19,7602,25)="HBHCUPD"
^DIC(19,7602,"U")="EDIT FORM ERRORS DATA"
^DIC(19,7603,0)="HBHCXMT^Transmit File to Austin^^R^10000000020^HBHC TRANSMIT^^^^^^"
^DIC(19,7603,1,0)="^^6^6^2971010^^^"
^DIC(19,7603,1,1,0)="This option creates and transmits the HBPC MailMan message using the"
^DIC(19,7603,1,2,0)="Transmission Data in HBHC(634) to Austin.  All Form Errors found via"
^DIC(19,7603,1,3,0)="the Build/Verify Transmission File option must be corrected before"
^DIC(19,7603,1,4,0)="transmission to Austin is allowed.  A confirmation message will be"
^DIC(19,7603,1,5,0)="returned from Austin upon receipt of the HBPC Transmission.  This option is"
^DIC(19,7603,1,6,0)="locked with the HBHC TRANSMIT security key. "
^DIC(19,7603,25)="HBHCXMT"
^DIC(19,7603,"U")="TRANSMIT FILE TO AUSTIN"
^DIC(19,7604,0)="HBHCRP8^HBPC Provider File Report  (132)^(per patch HBH*1.0*32)^R^10000000020^^^^^^^"
^DIC(19,7604,1,0)="^^4^4^2970710^^^^"
^DIC(19,7604,1,1,0)="This option prints the HBPC Provider File Report.  The report is"
^DIC(19,7604,1,2,0)="sorted by Provider Name and includes:  Provider Name, Provider"
^DIC(19,7604,1,3,0)="Number, Degree, Grade/Step, HBPC FTEE, HBPC Team, and Inactive Provider "
^DIC(19,7604,1,4,0)="Number.  Report prints in 132 column format. "
^DIC(19,7604,25)="HBHCRP8"
^DIC(19,7604,99)="55775,51850"
^DIC(19,7604,598000)=3
^DIC(19,7604,"U")="HBPC PROVIDER FILE REPORT  (13"
^DIC(19,7605,0)="HBHCRXMT^Re-Transmit File to Austin^^R^10000000020^^^^^^^"
^DIC(19,7605,1,0)="^^7^7^2970207^^"
^DIC(19,7605,1,1,0)="This option allows re-transmission of the same HBPC data included in the"
^DIC(19,7605,1,2,0)="last file transmitted to Austin, provided that Build/Verify Transmission"
^DIC(19,7605,1,3,0)="File has NOT been run again since the last transmission.  This option"
^DIC(19,7605,1,4,0)="should be used only under special circumstances, such as a transmission"
^DIC(19,7605,1,5,0)="failure, and should be coordinated with Austin via your IRM technical"
^DIC(19,7605,1,6,0)="support person.  This option requires cautious use due to the possibility"
^DIC(19,7605,1,7,0)="of duplicate records in Austin."
^DIC(19,7605,25)="HBHCRXMT"
^DIC(19,7605,"U")="RE-TRANSMIT FILE TO AUSTIN"
