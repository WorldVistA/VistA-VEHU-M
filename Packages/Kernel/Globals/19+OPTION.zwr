^DIC(19,15558,0)="EHM-00379^Send me a MailMan bulletin for Flagged Orders^^R^1^^^^^^^^^^^"
^DIC(19,15558,1,0)="^19.06^7^7^3240328^^"
^DIC(19,15558,1,1,0)="Enter 'Yes' to send a bulletin when an order is flagged for clarification. "
^DIC(19,15558,1,2,0)="'Yes' indicates a MailMan bulletin will be sent to the order's Current"
^DIC(19,15558,1,3,0)="Provider (usually the Ordering Provider) when the order is flagged for"
^DIC(19,15558,1,4,0)="clarification.  This parameter has no effect on the Flagged Orders"
^DIC(19,15558,1,5,0)="notification which is also triggered when an order is flagged for"
^DIC(19,15558,1,6,0)="clarification."
^DIC(19,15558,1,7,0)="Cloned from ""ORB3 REC FLG ORDERS BULLETIN"" option."
