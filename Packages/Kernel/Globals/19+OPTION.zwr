^DIC(19,11670,0)="IBAT TP MANAGEMENT^Transfer Pricing Management^^A^10000000033^^^^^^^192^^1^"
^DIC(19,11670,1,0)="^^2^2^2990401^^^"
^DIC(19,11670,1,1,0)="This is the main entry option for viewing and editing patients and"
^DIC(19,11670,1,2,0)="transactions."
^DIC(19,11670,3)="^ZEIGLER,EDWARD L"
^DIC(19,11670,15)=""
