^DIC(19,16177,1,0)="^^4^4^3240328^"
^DIC(19,16177,1,1,0)="This menu contains options which provide information only about Health"
^DIC(19,16177,1,2,0)="Summary Types, Components, Measurement Panels, and Reminder/Maintenance"
^DIC(19,16177,1,3,0)="Items."
^DIC(19,16177,1,4,0)="Cloned from ""GMTS INFO ONLY MENU"" option."
