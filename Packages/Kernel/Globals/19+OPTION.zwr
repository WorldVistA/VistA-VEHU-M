^DIC(19,12728,0)="EVET EMAIL DOWNLOAD REPORT^Email weekly download report^^R^10000000020^^^^^^^551^"
^DIC(19,12728,1,0)="^^2^2^3040219^"
^DIC(19,12728,1,1,0)="This option is used to schedule the weekly download report.  It runs the "
^DIC(19,12728,1,2,0)="download report which is emailed tothe EVET HEALTH EVET ALERTS mail group."
^DIC(19,12728,25)="AUTO^EVETR6"
^DIC(19,12728,"U")="EMAIL WEEKLY DOWNLOAD REPORT"
^DIC(19,12729,0)="DG MS INCONSISTENCIES RPT^Military Service Data Inconsistencies Report^^R^10000000020^^^^^^^114"
^DIC(19,12729,1,0)="^^13^13^3040210^"
^DIC(19,12729,1,1,0)="This option will produce reports of inconsistencies found in veterans' "
^DIC(19,12729,1,2,0)="military service data.  There are two parts to this option:"
^DIC(19,12729,1,3,0)=" "
^DIC(19,12729,1,4,0)="Extract and Count Inconsistencies - this process will scan the veterans' "
^DIC(19,12729,1,5,0)="records in the Patient file and extract those that contain "
^DIC(19,12729,1,6,0)="inconsistencies.  At the completion of this process a mail message will "
^DIC(19,12729,1,7,0)="be sent with a summary report of the volume of inconsistencies found in"
^DIC(19,12729,1,8,0)="various categories.  This process must be run before the detail report can"
^DIC(19,12729,1,9,0)="be printed."
^DIC(19,12729,1,10,0)=" "
^DIC(19,12729,1,11,0)="Print Inconsistencies Detail Report - this process will produce a detail"
^DIC(19,12729,1,12,0)="report of inconsistencies found for individual veterans.  The report can"
^DIC(19,12729,1,13,0)="be sorted by veteran name or SSN (terminal digits)."
^DIC(19,12729,25)="EN^DGMSRPT"
