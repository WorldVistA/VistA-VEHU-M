^DIC(19,13171,0)="IBBA BATCH DFT^PFSS Charge Batch Processing^^R^10000000020^^^^^^^192"
^DIC(19,13171,1,0)="^^18^18^3050607^"
^DIC(19,13171,1,1,0)="The menu option is used to schedule via TaskManager the PFSS Charge"
^DIC(19,13171,1,2,0)="Batch Processor.  Normally, this option should be scheduled to run"
^DIC(19,13171,1,3,0)="once daily at a time of low system activity."
^DIC(19,13171,1,4,0)="  "
^DIC(19,13171,1,5,0)="When the batch processor starts, it will set data into two fields"
^DIC(19,13171,1,6,0)="in the PFSS SITE PARAMETERS file (#372):"
^DIC(19,13171,1,7,0)="(1) The CHARGE PROCESSOR RUNNING field (#.1) will be set to ""YES""."
^DIC(19,13171,1,8,0)="(2) The CHARGE PROCESS START TIME field (#.11) will be set to the"
^DIC(19,13171,1,9,0)="current system date/time."
^DIC(19,13171,1,10,0)="  "
^DIC(19,13171,1,11,0)="When charge batch processing is complete, then:"
^DIC(19,13171,1,12,0)="(1) The CHARGE PROCESSOR RUNNING field (#.1) will be set to ""NO""."
^DIC(19,13171,1,13,0)="(2) The CHARGE PROCESS START TIME field (#.11) will be deleted."
^DIC(19,13171,1,14,0)="  "
^DIC(19,13171,1,15,0)="When a charge batch processor job is started, it always checks the"
^DIC(19,13171,1,16,0)="status of the CHARGE PROCESSOR RUNNING field.  If this field is set to"
^DIC(19,13171,1,17,0)="""YES"", then the job quits immediately.  This insures that only one"
^DIC(19,13171,1,18,0)="batch processor is running at any given time."
^DIC(19,13171,25)="EN^IBBADFTO"
^DIC(19,13171,200.9)="y"
^DIC(19,13171,"U")="PFSS CHARGE BATCH PROCESSING"
^DIC(19,13172,0)="PRCPLO CLO GIP OPTION^CLO GIP Reports (CLRS)^^R^1^^^^^^^121"
^DIC(19,13172,1,0)="^^11^11^3061227^"
^DIC(19,13172,1,1,0)="This is the option used by the Prosthetics and Clinical Logistics Office"
^DIC(19,13172,1,2,0)="to gather GIP information.  It runs the Stock Status Report and Days of"
^DIC(19,13172,1,3,0)="Stock on Hand Report for every combination of station and active inventory"
^DIC(19,13172,1,4,0)="point present within a system and creates extracts in the CLRS REPORT"
^DIC(19,13172,1,5,0)="STORAGE file (#446.7).  "
^DIC(19,13172,1,6,0)=" "
^DIC(19,13172,1,7,0)="These extracts are ""*"" delimited files and encompass data extracted from"
^DIC(19,13172,1,8,0)="the first day of the previous month to the last day of the previous"
^DIC(19,13172,1,9,0)="month.  The extracts are stored in the CLRS REPORT STORAGE file (#446.7)"
^DIC(19,13172,1,10,0)="until the FTP transmission to the CLRS occur as instructed by the"
^DIC(19,13172,1,11,0)="Prosthetics and Clinical Logistics Office."
^DIC(19,13172,25)="ENT^PRCPLO3"
^DIC(19,13172,"U")="CLO GIP REPORTS (CLRS)"
^DIC(19,13173,0)="PRCPLO CLO SYSTEM PARAM^CLO System Parameters (CLRS)^^R^1^XUPROG^^^^^^121"
^DIC(19,13173,1,0)="^^6^6^3060425^"
^DIC(19,13173,1,1,0)="This option presents the user with the current value for the system "
^DIC(19,13173,1,2,0)="parameters associated with the Clinical Logistics Report Server and"
^DIC(19,13173,1,3,0)="prompts the user to enter new values if needed.  Entries are screened for"
^DIC(19,13173,1,4,0)="validity and any setting errors are returned to the user. This option is"
^DIC(19,13173,1,5,0)="only intended to be used by IRM staff and access to it is restricted to"
^DIC(19,13173,1,6,0)="those who have the XUPROG security key."
^DIC(19,13173,25)="ENT^PRCPLO4"
^DIC(19,13173,"U")="CLO SYSTEM PARAMETERS (CLRS)"
^DIC(19,13174,0)="PRCHLO CLO PROCUREMENT^CLO Procurement Reports (CLRS)^FTP SERVER SHUT DOWN, PRC*5.1*194^R^11720^^^^^^^121"
^DIC(19,13174,1,0)="^19.06^4^4^3080108^^^"
^DIC(19,13174,1,1,0)="This option runs the procurement extracts associated with the CLRS and"
^DIC(19,13174,1,2,0)="will be scheduled to run as directed by the Prosthetics & Clinical"
^DIC(19,13174,1,3,0)="Logistics Office.  As part of this process, the flat files for both the PO"
^DIC(19,13174,1,4,0)="Activity and GIP extracts are created for FTP transmission."
^DIC(19,13174,25)="ENT^PRCHLO5"
^DIC(19,13174,"U")="CLO PROCUREMENT REPORTS (CLRS)"
