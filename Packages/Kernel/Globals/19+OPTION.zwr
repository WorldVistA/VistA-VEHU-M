^DIC(19,9423,20)="K:$G(PRCP(""DPTYPE""))'=""S"" PRCP S PRCP(""DPTYPE"")=""S"" D DISPLAY^PRCPUSEL I '$G(PRCP(""I"")) S XQUIT=1 D NOMENU^PRCPUSEL"
^DIC(19,9423,99)="62195,30816"
^DIC(19,9423,"U")="STOCK REPLENISHMENT MENU"
^DIC(19,9424,0)="PRCP DUE-IN ITEM REPORT^Due-In Item Report^^R^11740^^^^^^^"
^DIC(19,9424,1,0)="^^13^13^2940124^^^"
^DIC(19,9424,1,1,0)="This option will print a report showing the inventory point items"
^DIC(19,9424,1,2,0)="which have outstanding transactions stored (in the inventory point)"
^DIC(19,9424,1,3,0)="as due-ins.  The report will display the outstanding transaction,"
^DIC(19,9424,1,4,0)="associated purchase order, vendor, estimated delivery date or"
^DIC(19,9424,1,5,0)="partial numbers not received in, and the due-in quantity."
^DIC(19,9424,1,6,0)=" "
^DIC(19,9424,1,7,0)="The results of this report may not agree with the report generated"
^DIC(19,9424,1,8,0)="by the option 'Update Calculated Due-Ins/Outstanding Transactions.'"
^DIC(19,9424,1,9,0)="The 'Update' option will print a report showing the calculated"
^DIC(19,9424,1,10,0)="due-ins not the stored due-ins.  If the 'Update' option is run"
^DIC(19,9424,1,11,0)="and the update is performed, the 'Due-In Item Report' option"
^DIC(19,9424,1,12,0)="can be run and will agree with the 'Update' report since the"
^DIC(19,9424,1,13,0)="'Update' option will store the calculated due-ins."
^DIC(19,9424,25)="PRCPRDIN"
^DIC(19,9424,"U")="DUE-IN ITEM REPORT"
^DIC(19,9425,0)="PRCPW RECEIVING/DISTR MENU^Receiving and Distribution Menu^^M^11740^^^^^^^^^1"
^DIC(19,9425,1,0)="^19.06^1^1^3000608^^^"
^DIC(19,9425,1,1,0)="This menu contains all the options to handle Warehouse receiving and distribution."
^DIC(19,9425,10,0)="^19.01PI^13^11"
^DIC(19,9425,10,2,0)="9420^"
