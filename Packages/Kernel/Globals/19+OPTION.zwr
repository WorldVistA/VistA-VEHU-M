^DIC(19,15014,1,0)="^19.06^4^4^3210924^^^^"
^DIC(19,15014,1,1,0)="This option is used to assign a replacement program key to one or more "
^DIC(19,15014,1,2,0)="options.  The key is assigned as a REVERSE/NEGATIVE LOCK, to limit user "
^DIC(19,15014,1,3,0)="access to VistA applications that have been replaced in the Cerner "
^DIC(19,15014,1,4,0)="transition."
^DIC(19,15014,3)=""
^DIC(19,15014,25)="5^XUSEHRM"
^DIC(19,15014,"U")="ADD PROGRAM REPLACEMENT KEY TO"
