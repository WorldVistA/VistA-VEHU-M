^DIC(19,12132,"U")="OR BCMA ORDER COM VERSION 1.0"
^DIC(19,12133,0)="OR DELAYED ORDERS^Event Delayed Orders Menu^^M^10000000020^^^^^^^"
^DIC(19,12133,1,0)="^^2^2^3020911^"
^DIC(19,12133,1,1,0)="This menu contains all the options for setting up and maintaining the "
^DIC(19,12133,1,2,0)="event delayed orders functionality."
^DIC(19,12133,10,0)="^19.01IP^3^3"
^DIC(19,12133,10,1,0)="12221^DO"
^DIC(19,12133,10,2,0)="12220^IN"
^DIC(19,12133,10,3,0)="12222^EP"
^DIC(19,12133,10,"B",12220,2)=""
^DIC(19,12133,10,"B",12221,1)=""
^DIC(19,12133,10,"B",12222,3)=""
^DIC(19,12133,10,"C","DO",1)=""
^DIC(19,12133,10,"C","EP",3)=""
^DIC(19,12133,10,"C","IN",2)=""
^DIC(19,12133,25)=""
^DIC(19,12133,99)="59241,26894"
^DIC(19,12133,"U")="EVENT DELAYED ORDERS MENU"
^DIC(19,12134,0)="ORCL CPRS ACCESS^GUI Access - Tabs, RPL^^E^10000000020^^^^^^^170"
^DIC(19,12134,1,0)="^^53^53^3020613^"
^DIC(19,12134,1,1,0)="This option provides input template access for editing CPRS GUI access "
^DIC(19,12134,1,2,0)="restrictions in the NEW PERSON file [^VA(200,] for cover sheet tabs and "
^DIC(19,12134,1,3,0)="user-specific restricted patient selection lists."
^DIC(19,12134,1,4,0)=" "
^DIC(19,12134,1,5,0)="Note that there is a logic path followed by the GUI application with "
^DIC(19,12134,1,6,0)="regard to the entries in all of these fields under discussion.  The "
^DIC(19,12134,1,7,0)="possible scenarios are:"
^DIC(19,12134,1,8,0)=" "
^DIC(19,12134,1,9,0)="Scenario A - The user is restricted to, and sees only, the REPORTS tab of "
^DIC(19,12134,1,10,0)="the CPRS GUI application.  In addition, the Tools/Options menu restricts "
^DIC(19,12134,1,11,0)="access to patient selection settings.  "
^DIC(19,12134,1,12,0)=" "
^DIC(19,12134,1,13,0)="Scenario B - The user sees all tabs and can select from all patients.  "
^DIC(19,12134,1,14,0)=" "
^DIC(19,12134,1,15,0)="Scenario C - The user has no access to the CPRS GUI.  "
^DIC(19,12134,1,16,0)=" "
^DIC(19,12134,1,17,0)="Scenario D - The user has access to the Reports Tab only, and all "
^DIC(19,12134,1,18,0)="patients."
^DIC(19,12134,1,19,0)=" "
^DIC(19,12134,1,20,0)="The following matrix should indicate what to expect:"
^DIC(19,12134,1,21,0)=" "
^DIC(19,12134,1,22,0)="    Restr. Pt. List     OE/RR Team           Tab(s)      Scenario"
^DIC(19,12134,1,23,0)="    = = = = = = = =     = = = = = =          = = = =     = = = = ="
^DIC(19,12134,1,24,0)="    (blank)             (none)               (none)      C"
^DIC(19,12134,1,25,0)="    (blank)             XYZ Team             (none)      C"
^DIC(19,12134,1,26,0)="    (blank)             XYZ Team             RPT         C"
^DIC(19,12134,1,27,0)="    Y                   (none/invalid)       RPT         C"
^DIC(19,12134,1,28,0)="    N                   XYZ Team             RPT         D"
^DIC(19,12134,1,29,0)="    Y                   XYZ Team             RPT         A"
^DIC(19,12134,1,30,0)="    N                   N/A                  COR         B"
^DIC(19,12134,1,31,0)="    N                   N/A                  COR, RPT    B"
^DIC(19,12134,1,32,0)="    Y                   N/A                  COR         B"
^DIC(19,12134,1,33,0)="    Y                   N/A                  COR, RPT    B"
^DIC(19,12134,1,34,0)="    (blank)             N/A                  COR         C"
^DIC(19,12134,1,35,0)="    (blank)             N/A                  COR, RPT    C"
^DIC(19,12134,1,36,0)=" "
^DIC(19,12134,1,37,0)="It will be seen that the ""COR"" tab overrules other tab settings, allows "
^DIC(19,12134,1,38,0)="access to all tabs, and also allows access to all patients - except when "
^DIC(19,12134,1,39,0)="the ""RESTRICTED PATIENT SELECTION"" entry is left blank.  "
^DIC(19,12134,1,40,0)=" "
^DIC(19,12134,1,41,0)="Note that more than one entry can be made for the same tab.  For example, "
^DIC(19,12134,1,42,0)="a ""RPT"" tab entry could be made for a user with valid dates equating to "
^DIC(19,12134,1,43,0)="the second week of the current month, then another ""RPT"" entry made with "
^DIC(19,12134,1,44,0)="dates allowing access for the first week of the next month.  To create a "
^DIC(19,12134,1,45,0)="duplicate entry of the same tab, the user must select ""No"" when prompted "
^DIC(19,12134,1,46,0)="for the new entry on a blank line.  Some users may not be familiar with "
^DIC(19,12134,1,47,0)="this standard Fileman behavior.  "
^DIC(19,12134,1,48,0)=" "
^DIC(19,12134,1,49,0)="The ruling logic for multiple entries of the same tab is:"
^DIC(19,12134,1,50,0)=" "
^DIC(19,12134,1,51,0)="    If any entry for a given tab allows access to the tab "
^DIC(19,12134,1,52,0)="    as of the date of login, then the tab is allowed, regardless  "
^DIC(19,12134,1,53,0)="    of any other entries which may exist for that tab.  "
^DIC(19,12134,30)="VA(200,"
^DIC(19,12134,31)="AEMQ"
^DIC(19,12134,50)="VA(200,"
^DIC(19,12134,51)="[OR USER ACCESS OPTIONS]"
^DIC(19,12134,53)="BACK"
^DIC(19,12134,"U")="GUI ACCESS - TABS, RPL"
^DIC(19,12136,0)="GMTS GUI SITE DISPLAY DEFAULTS^Display Site Health Summary List Defaults^^R^10000000020^^^^^^^"
^DIC(19,12136,1,0)="^^5^5^3020718^"
^DIC(19,12136,1,1,0)="Use this option to display the site defaults for building the list"
^DIC(19,12136,1,2,0)="of Health Summary Types on the Reports Tab in CPRS. The display "
^DIC(19,12136,1,3,0)="includes the method for building the list and the precedence of "
^DIC(19,12136,1,4,0)="parameters. These default values will be used in the event that the"
^DIC(19,12136,1,5,0)="user has not established user preferences."
^DIC(19,12136,25)="DS^GMTSXA"
^DIC(19,12136,"U")="DISPLAY SITE HEALTH SUMMARY LI"
^DIC(19,12137,0)="GMTS GUI SITE DEFAULTS^CPRS Health Summary Display/Edit Site Defaults^^M^10000000020^^^^^^^"
^DIC(19,12137,1,0)="^^8^8^3020718^"
^DIC(19,12137,1,1,0)="Use the options in the CPRS Health Summary Display/Edit Site "
^DIC(19,12137,1,2,0)="Defaults Menu to display the site defaults, select the Health "
^DIC(19,12137,1,3,0)="Summary Types to list on the Reports Tab, edit the method of "
^DIC(19,12137,1,4,0)="building the list (append/overwrite), edit allowable entities"
^DIC(19,12137,1,5,0)="for the list (i.e., User, System, Division, etc.), or resequence"
^DIC(19,12137,1,6,0)="the allowable entities in the order they should be appear on "
^DIC(19,12137,1,7,0)="the list."
^DIC(19,12137,1,8,0)=""
^DIC(19,12137,10,0)="^19.01IP^5^5"
^DIC(19,12137,10,1,0)="12136^1^1"
^DIC(19,12137,10,2,0)="12138^3^3"
^DIC(19,12137,10,3,0)="12139^4^4"
^DIC(19,12137,10,4,0)="12140^5^5"
^DIC(19,12137,10,5,0)="12141^2^2"
^DIC(19,12137,10,"B",12136,1)=""
^DIC(19,12137,10,"B",12138,2)=""
^DIC(19,12137,10,"B",12139,3)=""
^DIC(19,12137,10,"B",12140,4)=""
^DIC(19,12137,10,"B",12141,5)=""
^DIC(19,12137,10,"C",1,1)=""
^DIC(19,12137,10,"C",2,5)=""
^DIC(19,12137,10,"C",3,2)=""
^DIC(19,12137,10,"C",4,3)=""
^DIC(19,12137,10,"C",5,4)=""
^DIC(19,12137,99)="67131,68795"
^DIC(19,12137,"U")="CPRS HEALTH SUMMARY DISPLAY/ED"
^DIC(19,12138,0)="GMTS GUI SITE COMPILE METHOD^Edit Default HS Type List Compile Method^^R^10000000020^^^^^^^160"
^DIC(19,12138,1,0)="^^13^13^3020718^"
^DIC(19,12138,1,1,0)="Use this option to modifiy how the list of Health Summary Types "
^DIC(19,12138,1,2,0)="is to be built for the site.  This method will be used for all "
^DIC(19,12138,1,3,0)="users who do not have user preferences set. "
^DIC(19,12138,1,4,0)="  "
^DIC(19,12138,1,5,0)="  Overwrite  System-defined Health Summary Types are added to "
^DIC(19,12138,1,6,0)="             the list. If there are User-defined Health Summary"
^DIC(19,12138,1,7,0)="             Types, then they will replace the System defined "
^DIC(19,12138,1,8,0)="             Health Summary Types already on the list."
^DIC(19,12138,1,9,0)="  "
^DIC(19,12138,1,10,0)="  Append     System-defined Health Summary Types are added to "
^DIC(19,12138,1,11,0)="             the list. If there are User-defined Health Summary"
^DIC(19,12138,1,12,0)="             Types, then they will added to the list along"
^DIC(19,12138,1,13,0)="             with the System defined types."
^DIC(19,12138,25)="MS^GMTSXA"
^DIC(19,12138,"U")="EDIT DEFAULT HS TYPE LIST COMP"
^DIC(19,12139,0)="GMTS GUI SITE PRECEDENCE^Add/Edit Allowable Entities for HS List^^R^10000000020^^^^^^^"
^DIC(19,12139,1,0)="^19.06^4^4^3020718^^^"
^DIC(19,12139,1,1,0)="Use this option to add or delete an entity (System, Division, User,"
^DIC(19,12139,1,2,0)="etc) from the list of allowable entites for the parameter 'ORWRP "
^DIC(19,12139,1,3,0)="HEALTH SUMMARY TYPE LIST' used on the CPRS Reports Tab to display"
^DIC(19,12139,1,4,0)="the Health Summary Types List."
^DIC(19,12139,25)="PS^GMTSXA"
^DIC(19,12139,"U")="ADD/EDIT ALLOWABLE ENTITIES FO"
^DIC(19,12140,0)="GMTS GUI SITE RESEQUENCE^Resequence Allowable Entities for HS List^^R^10000000020^^^^^^^"
^DIC(19,12140,1,0)="^^5^5^3020718^"
^DIC(19,12140,1,1,0)="Use this option to resequence the order in which the allowable "
^DIC(19,12140,1,2,0)="entites for parameter 'ORWRP HEALTH SUMMARY TYPE LIST' are used "
^DIC(19,12140,1,3,0)="in building the list of Health Summary Types for the CPRS Reports"
^DIC(19,12140,1,4,0)="Tab.  This order is used for any user who does not have user "
^DIC(19,12140,1,5,0)="preferences set."
^DIC(19,12140,25)="RS^GMTSXA"
^DIC(19,12140,"U")="RESEQUENCE ALLOWABLE ENTITIES "
^DIC(19,12141,0)="GMTS GUI SITE ADD/EDIT LIST^Edit 'Health Summary Types List' Parameters^^R^10000000020^^^^^^^"
^DIC(19,12141,1,0)="^^3^3^3020718^"
^DIC(19,12141,1,1,0)="Use this option to add, edit or delete a Health Summary Type from"
^DIC(19,12141,1,2,0)="the list of Health Summary Types defined for a given entity (System,"
^DIC(19,12141,1,3,0)="Division, User, etc.)."
^DIC(19,12141,25)="EM^GMTSXA"
^DIC(19,12141,"U")="EDIT 'HEALTH SUMMARY TYPES LIS"
^DIC(19,12142,0)="LR LOINC HISTORICAL MAP MENU^LOINC Historical Mapping Menu^^M^10000000020^XUPROGMODE^^^^^^26"
^DIC(19,12142,1,0)="^19.06^5^5^3020215^^^^"
^DIC(19,12142,1,1,0)="This menu contains the software required to perform historical LOINC "
^DIC(19,12142,1,2,0)="mapping of CH subscripted verified results. The software will use "
^DIC(19,12142,1,3,0)="existing LOINC mapping configuration defined in WKLD CODE (#64) file to "
^DIC(19,12142,1,4,0)="determine LOINC code assigned a given dataname. The look back mapping "
^DIC(19,12142,1,5,0)="process extends to the past 5-6 years of verified 'CH' subscripted data."
^DIC(19,12142,10,0)="^19.01IP^4^4"
^DIC(19,12142,10,1,0)="12143^1^1"
^DIC(19,12142,10,2,0)="12145^2^2"
^DIC(19,12142,10,3,0)="12144^3^3"
^DIC(19,12142,10,4,0)="12146^4^4"
^DIC(19,12142,10,"B",12143,1)=""
^DIC(19,12142,10,"B",12144,3)=""
^DIC(19,12142,10,"B",12145,2)=""
^DIC(19,12142,10,"B",12146,4)=""
^DIC(19,12142,10,"C",1,1)=""
^DIC(19,12142,10,"C",2,2)=""
^DIC(19,12142,10,"C",3,3)=""
^DIC(19,12142,10,"C",4,4)=""
^DIC(19,12142,99)="59037,38090"
^DIC(19,12142,"U")="LOINC HISTORICAL MAPPING MENU"
^DIC(19,12143,0)="LR LOINC HISTORICAL MAPPER 63^LAB DATA LOINC Mapping^^R^10000000020^XUPROGMODE^^^^^^26"
^DIC(19,12143,1,0)="^^5^5^3020130^"
^DIC(19,12143,1,1,0)="This option will initiate the required number of background tasks to "
^DIC(19,12143,1,2,0)="inspect the entire LAB DATA file and map verified CH subscripted test "
^DIC(19,12143,1,3,0)="with LOINC codes."
^DIC(19,12143,1,4,0)="Note: This option is used also to restart the mapping process. The "
^DIC(19,12143,1,5,0)="mapping process will continue until all LRDFNs have been inspected."
^DIC(19,12143,25)="QUE^LRLNC63"
^DIC(19,12143,"U")="LAB DATA LOINC MAPPING"
^DIC(19,12144,0)="LR LOINC HISTORICAL STOP 63^STOP LOINC Mapping^^R^10000000020^^^^^^^26"
^DIC(19,12144,1,0)="^^1^1^3020130^"
^DIC(19,12144,1,1,0)="This option will stop all background LOINC historical mapping tasks."
^DIC(19,12144,25)="STOP^LRLNC63"
^DIC(19,12144,"U")="STOP LOINC MAPPING"
^DIC(19,12145,0)="LR LOINC HISTORICAL RESTART 63^Restart LOINC Historical Mapping^^R^10000000020^XUPROGMODE^^^^^^26"
^DIC(19,12145,1,0)="^19.06^7^7^3020206^^^"
^DIC(19,12145,1,1,0)="This option will restart the mapping process from the beginning. This "
^DIC(19,12145,1,2,0)="option will reset all counters and reinitiate the ^XTMP(""LRLNC63"") "
^DIC(19,12145,1,3,0)="global. Rerunning this option is not harmful but the same considerations "
^DIC(19,12145,1,4,0)="used for the option."
^DIC(19,12145,1,5,0)="LAB DATA LOINC mapping [LR LOINC HISTORICAL MAPPER 63]. This option "
^DIC(19,12145,1,6,0)="should only be run during a 24 hour period when the systems is of low "
^DIC(19,12145,1,7,0)="activity."
^DIC(19,12145,25)="RERUN^LRLNC63A"
^DIC(19,12145,"U")="RESTART LOINC HISTORICAL MAPPI"
^DIC(19,12146,0)="LR LOINC HISTORICAL MODIFY^Modify LOINC Historical Mapping^^R^10000000020^XUPROGMODE^^^^^^26"
^DIC(19,12146,1,0)="^^85^85^3020225^"
^DIC(19,12146,1,1,0)=" "
^DIC(19,12146,1,2,0)=" "
^DIC(19,12146,1,3,0)="This is a very powerful utility option to be used to reconcile"
^DIC(19,12146,1,4,0)="previous LOINC historical mapping. A knowledgeable LOINC mapper is "
^DIC(19,12146,1,5,0)="required to properly implement this functionality."
^DIC(19,12146,1,6,0)="  "
^DIC(19,12146,1,7,0)="After initial historical mapping has been completed, adjustments maybe "
^DIC(19,12146,1,8,0)="required to modify the LOINC code lookup parameters to properly map past "
^DIC(19,12146,1,9,0)="results. Careful review of current LOINC mapping should be done to "
^DIC(19,12146,1,10,0)="establish IF there is a systematic error in LOINC code assignments. File"
^DIC(19,12146,1,11,0)="definition corrections should be done to prevent future LOINC mapping"
^DIC(19,12146,1,12,0)="errors. Re-running LAB DATA LOINC Mapping [LR LOINC HISTORICAL MAPPER 63]"
^DIC(19,12146,1,13,0)="option will correct the problem."
^DIC(19,12146,1,14,0)="  "
^DIC(19,12146,1,15,0)="In those situations when editing LOINC mapping parameters is not "
^DIC(19,12146,1,16,0)="desirable, this option provides a method for the user to intervene in the"
^DIC(19,12146,1,17,0)="mapping logic for specific tests."
^DIC(19,12146,1,18,0)="  "
^DIC(19,12146,1,19,0)="The user is able to select test(s) [Atomic or Panel], then assign a "
^DIC(19,12146,1,20,0)="specific suffix code to be used during LOINC mapping logic. In addition"
^DIC(19,12146,1,21,0)="the user is able to force the Result NLT CODE (#64.1) of LABORATORY TEST"
^DIC(19,12146,1,22,0)="(#60) for the test and the designated suffix code pair to override"
^DIC(19,12146,1,23,0)="previous LOINC mapping."
^DIC(19,12146,1,24,0)="  "
^DIC(19,12146,1,25,0)="This is a very powerful feature, great care and study should be used "
^DIC(19,12146,1,26,0)="before attempting correct past LOINC mapping systematic errors."
^DIC(19,12146,1,27,0)="After the user has completed the modify LOINC mapping procedures, the "
^DIC(19,12146,1,28,0)="LAB DATA LOINC Mapping option is called. All considerations of this option"
^DIC(19,12146,1,29,0)="still applies. Most notably, only performing this mapping exercise during"
^DIC(19,12146,1,30,0)="week ends or in a 24 period of lowest system activity. Even with the"
^DIC(19,12146,1,31,0)="increased logic iterations, the process should complete within the 24 hr"
^DIC(19,12146,1,32,0)="window of time."
^DIC(19,12146,1,33,0)="  "
^DIC(19,12146,1,34,0)=" Option example: "
^DIC(19,12146,1,35,0)="  "
^DIC(19,12146,1,36,0)="      This option will allow you to manage how specific DataNames"
^DIC(19,12146,1,37,0)="          will be mapped to LOINC Codes for historical data."
^DIC(19,12146,1,38,0)="  "
^DIC(19,12146,1,39,0)=" You are able to override file definitions to correct past LOINC "
^DIC(19,12146,1,40,0)="mappings. Select the CH subscripted tests, indicate the suffix to be"
^DIC(19,12146,1,41,0)="used. The user can indicate if this suffix should override"
^DIC(19,12146,1,42,0)="previous LOINC Mapping."
^DIC(19,12146,1,43,0)="  "
^DIC(19,12146,1,44,0)="This option will REMAP your entire database."
^DIC(19,12146,1,45,0)="  "
^DIC(19,12146,1,46,0)="  "
^DIC(19,12146,1,47,0)=" This option should only be run on weekends after hours."
^DIC(19,12146,1,48,0)="  "
^DIC(19,12146,1,49,0)="  Do you wish to continue ? YES "
^DIC(19,12146,1,50,0)="  "
^DIC(19,12146,1,51,0)="           Selection can be a 'CH' Atomic or Panel test."
^DIC(19,12146,1,52,0)="  "
^DIC(19,12146,1,53,0)=" Select test you want to modify mapping: CBC Select Suffix Code: .4322    "
^DIC(19,12146,1,54,0)=" COULTER ELECTRONICS Override previous LOINC mapping? YES "
^DIC(19,12146,1,55,0)="  "
^DIC(19,12146,1,56,0)="  "
^DIC(19,12146,1,57,0)="           Selection can be a 'CH' Atomic or Panel test."
^DIC(19,12146,1,58,0)="  "
^DIC(19,12146,1,59,0)=" Select test you want to modify mapping: CALCIUM  "
^DIC(19,12146,1,60,0)="  Select Suffix Code: AA DIRECT     .3901     NOT SPECIFIED"
^DIC(19,12146,1,61,0)=" Override previous LOINC mapping?"
^DIC(19,12146,1,62,0)="  "
^DIC(19,12146,1,63,0)="           Selection can be a 'CH' Atomic or Panel test.<ret>"
^DIC(19,12146,1,64,0)="  "
^DIC(19,12146,1,65,0)=" Select test you want to modify mapping: <ret>"
^DIC(19,12146,1,66,0)="  "
^DIC(19,12146,1,67,0)="              Here is a list of what you have selected."
^DIC(19,12146,1,68,0)="               [O] indicates override current mapping"
^DIC(19,12146,1,69,0)=".  DEVICE: HOME//     Right Margin:80//"
^DIC(19,12146,1,70,0)=" "
