^DIC(19,15758,"U")="ORDER MENU MANAGEMENT"
^DIC(19,15759,0)="EHM-00580^Enter/edit order menus^^R^1^^^^^^^^^^^"
^DIC(19,15759,1,0)="^^2^2^3240328^^^"
^DIC(19,15759,1,1,0)="This option lets you create or change the Add Orders menus for your site."
^DIC(19,15759,1,2,0)="Cloned from ""ORCM MENU"" option."
^DIC(19,15759,3)=""
^DIC(19,15759,25)="ORCMEDIT"
^DIC(19,15759,"U")="ENTER/EDIT ORDER MENUS"
^DIC(19,15760,0)="EHM-00581^Convert protocols^^R^1^^^^^^^^^^^"
^DIC(19,15760,1,0)="^^4^4^3240328^"
^DIC(19,15760,1,1,0)="This option lets you convert any protocols that didn't get processed"
^DIC(19,15760,1,2,0)="automatically or successfully by the CPRS order menu conversion, for use"
^DIC(19,15760,1,3,0)="on Add Orders menus."
^DIC(19,15760,1,4,0)="Cloned from ""ORCM PROTOCOLS"" option."
^DIC(19,15760,3)=""
^DIC(19,15760,25)="PROTOCOL^ORCMEDT1"
^DIC(19,15760,"U")="CONVERT PROTOCOLS"
^DIC(19,15761,0)="EHM-00582^Enter/edit quick orders^^R^1^^^^^^^^^^^"
^DIC(19,15761,1,0)="^^6^6^3240328^^"
^DIC(19,15761,1,1,0)="This option lets you create or change quick orders. The dialog for"
^DIC(19,15761,1,2,0)="creating a quick order is similar to a dialog for entering an"
^DIC(19,15761,1,3,0)="order. The responses you enter will become the pre-defined responses"
^DIC(19,15761,1,4,0)="for this quick order. End users will have the opportunity to edit"
^DIC(19,15761,1,5,0)="these pre-defined responses, if desired."
^DIC(19,15761,1,6,0)="Cloned from ""ORCM QUICK ORDERS"" option."
^DIC(19,15761,3)=""
^DIC(19,15761,25)="QUICK^ORCMEDT1"
^DIC(19,15761,"U")="ENTER/EDIT QUICK ORDERS"
^DIC(19,15762,0)="EHM-00583^Enter/edit prompts^^R^1^^^^^^^^^^^"
^DIC(19,15762,1,0)="^^2^2^3240328^^"
^DIC(19,15762,1,1,0)="This option lets you create or change prompts for generic order dialogs."
^DIC(19,15762,1,2,0)="Cloned from ""ORCM PROMPTS"" option."
^DIC(19,15762,3)=""
^DIC(19,15762,25)="EN^ORCMEDT4"
^DIC(19,15762,"U")="ENTER/EDIT PROMPTS"
^DIC(19,15763,0)="EHM-00584^Enter/edit generic orders^^R^1^^^^^^^^^^^"
^DIC(19,15763,1,0)="^^4^4^3240328^"
^DIC(19,15763,1,1,0)="This option lets you create or change generic text orders that may be"
^DIC(19,15763,1,2,0)="placed on Add Orders menus; limited access to some clinical service"
^DIC(19,15763,1,3,0)="ordering dialogs is also available through this option."
^DIC(19,15763,1,4,0)="Cloned from ""ORCM ORDERS"" option."
^DIC(19,15763,3)=""
^DIC(19,15763,25)="EN^ORCMEDT3"
^DIC(19,15763,"U")="ENTER/EDIT GENERIC ORDERS"
^DIC(19,15764,0)="EHM-00585^Enter/edit order sets^^R^1^^^^^^^^^^^"
^DIC(19,15764,1,0)="^^3^3^3240328^^"
^DIC(19,15764,1,1,0)="This option lets you create or modify order sets, by combining"
^DIC(19,15764,1,2,0)="a group of related quick orders into a single item."
^DIC(19,15764,1,3,0)="Cloned from ""ORCM ORDER SETS"" option."
^DIC(19,15764,3)=""
^DIC(19,15764,25)="SET^ORCMEDT1"
^DIC(19,15764,"U")="ENTER/EDIT ORDER SETS"
^DIC(19,15765,0)="EHM-00586^Enter/edit actions^^R^1^^^^^^^^^^^"
^DIC(19,15765,1,0)="^^3^3^3240328^"
^DIC(19,15765,1,1,0)="This option lets you create or change actions that may be placed on Add"
^DIC(19,15765,1,2,0)="Orders menus."
^DIC(19,15765,1,3,0)="Cloned from ""ORCM ACTIONS"" option."
^DIC(19,15765,3)=""
^DIC(19,15765,25)="ACTION^ORCMEDT3"
^DIC(19,15765,"U")="ENTER/EDIT ACTIONS"
^DIC(19,15766,0)="EHM-00587^Search/replace components^^R^1^^^^^^^^^^^"
^DIC(19,15766,1,0)="^^5^5^3240328^^"
^DIC(19,15766,1,1,0)="This option lets you search for specific components on menus"
^DIC(19,15766,1,2,0)="and replace or delete one or more instances of these components."
^DIC(19,15766,1,3,0)="Components include: quick orders, order sets, prompts, protocols,"
^DIC(19,15766,1,4,0)="actions, etc."
^DIC(19,15766,1,5,0)="Cloned from ""ORCM SEARCH/REPLACE"" option."
^DIC(19,15766,3)=""
^DIC(19,15766,25)="SEARCH^ORCMEDT5"
^DIC(19,15766,"U")="SEARCH/REPLACE COMPONENTS"
^DIC(19,15767,0)="EHM-00588^Assign Primary Order Menu^^A^1^^^^^^^^^1^^"
^DIC(19,15767,1,0)="^^9^9^3240328^^^^"
^DIC(19,15767,1,1,0)="This option is used to assign a primary order menu to users."
^DIC(19,15767,1,2,0)="A primary order menu must be assigned to each user in order to add"
^DIC(19,15767,1,3,0)="orders using OE/RR."
^DIC(19,15767,1,4,0)=" "
^DIC(19,15767,1,5,0)=" Examples of menus assigned to users are:"
^DIC(19,15767,1,6,0)="    ORZ ADD MENU CLINICIAN"
^DIC(19,15767,1,7,0)="    ORZ ADD MENU NURSE"
^DIC(19,15767,1,8,0)="    ORZ ADD MENU WARD CLERK"
^DIC(19,15767,1,9,0)="Cloned from ""OR PARAM ADD MENU"" option."
^DIC(19,15767,3)=""
^DIC(19,15767,20)="D EDITPAR^XPAREDIT(""OR ADD ORDERS MENU"")"
^DIC(19,15767,"U")="ASSIGN PRIMARY ORDER MENU"
^DIC(19,15768,0)="EHM-00589^List Primary Order Menus^^R^1^^^^^^^170^^^^"
^DIC(19,15768,1,0)="^^4^4^3240328^^"
^DIC(19,15768,1,1,0)="This option will print a list of users, locations, divisions etc. that"
^DIC(19,15768,1,2,0)="have a specified order menu assigned for use in the List Manager"
^DIC(19,15768,1,3,0)="interface."
^DIC(19,15768,1,4,0)="Cloned from ""ORCM LIST ORDER MENUS"" option."
^DIC(19,15768,3)=""
^DIC(19,15768,25)="AOPAR^ORCMEDT5"
^DIC(19,15768,"U")="LIST PRIMARY ORDER MENUS"
^DIC(19,15769,0)="EHM-00590^Disable/Enable order dialogs^^R^1^^^^^^^^^^^"
^DIC(19,15769,1,0)="^^3^3^3240328^"
^DIC(19,15769,1,1,0)="This option lets you disable order dialogs so that execution will be"
^DIC(19,15769,1,2,0)="prevented if selected; dialogs may also be re-enabled in this option."
^DIC(19,15769,1,3,0)="Cloned from ""ORCM DISABLE"" option."
^DIC(19,15769,3)=""
^DIC(19,15769,25)="DISABLE^ORCMEDT5"
^DIC(19,15769,"U")="DISABLE/ENABLE ORDER DIALOGS"
