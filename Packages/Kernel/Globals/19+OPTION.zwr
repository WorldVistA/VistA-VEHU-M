^DIC(19,7140,0)="PSO MGMT REPORTS ALL DAILY^All Reports^^R^11712^^^^^^^141^^1"
^DIC(19,7140,1,0)="^^4^4^2930308^^^^"
^DIC(19,7140,1,1,0)="This option prints all of the Daily Management Reports which include the"
^DIC(19,7140,1,2,0)="Intravenous Admixture, Prescription Costs, Prescription Counts, and"
^DIC(19,7140,1,3,0)="Type of Prescriptions Filled reports.  They may be printed for a"
^DIC(19,7140,1,4,0)="specific division or for all divisions if the site is multi-divisional."
^DIC(19,7140,20)="S RUN=""A"""
^DIC(19,7140,25)="PSOMGREP"
^DIC(19,7140,"U")="ALL REPORTS"
^DIC(19,7141,0)="PSO MGMT REPORT RX COUNTS^Count of Prescriptions^^R^11712^^^^^^^141^^1"
^DIC(19,7141,1,0)="^^5^5^2930209^^^"
^DIC(19,7141,1,1,0)="This option prints the daily Prescription Counts management report."
^DIC(19,7141,1,2,0)="The report contains the total number of prescriptions filled during the"
^DIC(19,7141,1,3,0)="specified month(s). It contains the patient category, number of equivalent"
^DIC(19,7141,1,4,0)="fills, total prescriptions, total methadone prescriptions (if methadone"
^DIC(19,7141,1,5,0)="program), and patient requests."
^DIC(19,7141,20)="S RUN=1"
^DIC(19,7141,25)="PSOMGREP"
^DIC(19,7141,"U")="COUNT OF PRESCRIPTIONS"
^DIC(19,7142,0)="PSO MGMT REPORT TYPE OF RX^Type of Prescriptions Filled^^R^11712^^^^^^^141^^1"
^DIC(19,7142,1,0)="^^5^5^2930208^^"
^DIC(19,7142,1,1,0)="This option prints the daily Type of Prescriptions Filled Management report."
^DIC(19,7142,1,2,0)="It contains the total number of prescriptions filled by fee and staff"
^DIC(19,7142,1,3,0)="physicians, new and refill prescriptions, prescriptions sent by mail or"
^DIC(19,7142,1,4,0)="dispensed at the window, prescriptions filled by participating pharmacies,"
^DIC(19,7142,1,5,0)="and investigational drug prescriptions."
^DIC(19,7142,20)="S RUN=2"
^DIC(19,7142,25)="PSOMGREP"
^DIC(19,7142,"U")="TYPE OF PRESCRIPTIONS FILLED"
^DIC(19,7143,0)="PSO MGMT REPORT RX COSTS^Cost of Prescriptions^^R^11712^^^^^^^141^^1"
^DIC(19,7143,1,0)="^^7^7^2990413^^^^"
^DIC(19,7143,1,1,0)="This option prints the daily Prescription Costs management report."
^DIC(19,7143,1,2,0)="The report contains the average cost for staff prescriptions, fee"
^DIC(19,7143,1,3,0)="prescriptions, all prescriptions, equivalent fills, methadone"
^DIC(19,7143,1,4,0)="prescriptions (if methadone program), and participating pharmacies"
^DIC(19,7143,1,5,0)="prescriptions.  It also contains the total cost for all prescriptions,"
^DIC(19,7143,1,6,0)="methadone prescriptions (if methadone program), and participating"
^DIC(19,7143,1,7,0)="pharmacies prescriptions."
^DIC(19,7143,20)="S RUN=3"
^DIC(19,7143,25)="PSOMGREP"
^DIC(19,7143,"U")="COST OF PRESCRIPTIONS"
^DIC(19,7144,0)="PSO MGMT REPORT IV^Intravenous Admixture^^R^11712^^^^^^^141^^1"
^DIC(19,7144,1,0)="^^3^3^2930406^^^^"
^DIC(19,7144,1,1,0)="This option prints the Daily Intravenous Admixture management report."
^DIC(19,7144,1,2,0)="This report contains the total and average cost for piggybacks and syringes,"
^DIC(19,7144,1,3,0)="L.V.P., T.P.N., and Chemotherapy for each month plus a grand total."
^DIC(19,7144,20)="S RUN=4"
^DIC(19,7144,25)="PSOMGREP"
^DIC(19,7144,"U")="INTRAVENOUS ADMIXTURE"
