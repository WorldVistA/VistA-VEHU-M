^DIC(19,11686,0)="PSO SUCMOP PRINT REPORT^List of Rxs with CMOP Drugs Printed From Suspense^^A^11740^^^^^^^141^^1"
^DIC(19,11686,1,0)="^^7^7^3000414^"
^DIC(19,11686,1,1,0)="This utility will print a report of everything that has printed "
^DIC(19,11686,1,2,0)="locally that has a CMOP drug.  This report is by start and end dates.  The"
^DIC(19,11686,1,3,0)="report will list the Rx#, patient name, date printed from suspense, and the"
^DIC(19,11686,1,4,0)="drug.  This report is printed by the division you have signed in under. "
^DIC(19,11686,1,5,0)=" "
^DIC(19,11686,1,6,0)=" "
^DIC(19,11686,1,7,0)="PSO*7*39."
^DIC(19,11686,20)="D SURPT^PSOSUCLE"
^DIC(19,11686,"U")="LIST OF RXS WITH CMOP DRUGS PR"
^DIC(19,11687,0)="PSO SUCMOP RE-SUSLOCALCMOPPRI^Re-Suspend Printed Rxs with CMOP Drugs^^A^11740^^^^^^^141^^1"
^DIC(19,11687,1,0)="^19.06^7^7^3000417^^^"
^DIC(19,11687,1,1,0)="This utility will allow sites to re-suspend those Rxs that list on the "
^DIC(19,11687,1,2,0)="List of Rxs with CMOP Drugs Printed From Suspense report [PSO SUCMOP PRINT"
^DIC(19,11687,1,3,0)="REPORT].  This utility will re-suspend to the date that it was originally"
^DIC(19,11687,1,4,0)="suspended to.  It should not be necessary to edit the suspended date because"
^DIC(19,11687,1,5,0)="all Rxs queued for CMOP transmission will be transmitted."
^DIC(19,11687,1,6,0)=" "
^DIC(19,11687,1,7,0)="PSO*7*39"
^DIC(19,11687,20)="D RESUS^PSOSUCLE"
^DIC(19,11687,"U")="RE-SUSPEND PRINTED RXS WITH CM"
^DIC(19,11688,0)="PSO MANUAL AUTO EXPIRE^Manual Auto Expire Rxs^^R^11740^^^^^^^"
^DIC(19,11688,1,0)="^^5^5^3000516^"
^DIC(19,11688,1,1,0)="If you are facing with expired prescriptions showing up as active orders"
^DIC(19,11688,1,2,0)="on the CPRS Orders tab then you need to run this option. This will go"
^DIC(19,11688,1,3,0)="through all past prescriptions starting from the day Outpatient Pharmacy"
^DIC(19,11688,1,4,0)="Ver. 7 was installed up to the previous day and mark those prescriptions"
