^DIC(19,17048,0)="RA PROCEDURE ACTIVATE^Activate/Inactivate Standard Procedures^^R^1^RA MGR^^^^^^31"
^DIC(19,17048,1,0)="^^6^6^3250515^"
^DIC(19,17048,1,1,0)="This option is used to batch activate or inactivate the new Oracle/Cerner"
^DIC(19,17048,1,2,0)="standard procedures. The user can choose to activate/inactivate a set of"
^DIC(19,17048,1,3,0)="individual procedures, procedures by modality, or ALL of the new standard"
^DIC(19,17048,1,4,0)="procedures. The RAD/NUC MED PROCEDURE field STANDARD PROCEDURE? is used to"
^DIC(19,17048,1,5,0)="identify these.  Radiology patch RA*5.0*226 deployed the new procedures"
^DIC(19,17048,1,6,0)="with an inactive date so the sites may control how they are deployed."
^DIC(19,17048,25)="EN1^RACTCERN"
^DIC(19,17048,"U")="ACTIVATE/INACTIVATE STANDARD P"
^DIC(19,17049,0)="MAGD AUTO RETRIEVE MONITOR^Real-Time Monitor of Retrieval of Missing Images^^R^1^^^^^^^"
^DIC(19,17049,1,0)="^^1^1^3220315^"
^DIC(19,17049,1,1,0)="This is a real-time monitor of the retrieval of RAD and CPRS images from PACS."
^DIC(19,17049,25)="ENTRY^MAGDSTAG"
^DIC(19,17049,"U")="REAL-TIME MONITOR OF RETRIEVAL"
^DIC(19,17050,0)="MAG DISPLAY ROUTINE CHECKSUMS^Display Routine Checksums^^R^1^^^^^^^"
^DIC(19,17050,1,0)="^^3^3^3220606^"
^DIC(19,17050,1,1,0)="This option diplays the checksums for a set of routines selected"
^DIC(19,17050,1,2,0)="either by name or by Imaging (MAG*3.0*nnn) patch number."
^DIC(19,17050,1,3,0)="The last edit date/time and patch list are displayed as well."
^DIC(19,17050,25)="CHECKSUM^MAGDFCNV"
^DIC(19,17050,"U")="DISPLAY ROUTINE CHECKSUMS"
^DIC(19,17051,0)="EHM_CONVERTED APPOINTMENT LIST^Converted Appointment List^^R^1^^^^^^^594^^1^1"
^DIC(19,17051,1,0)="^19.06^13^13^3240425^^^^"
^DIC(19,17051,1,1,0)="This option will produce a detailed list of appointments that have an "
^DIC(19,17051,1,2,0)="appointment date on or after the date of conversion that were created "
^DIC(19,17051,1,3,0)="before the date of conversion but no more than two years prior to the "
^DIC(19,17051,1,4,0)="conversion date. "
^DIC(19,17051,1,5,0)=" "
^DIC(19,17051,1,6,0)="This report can be run pre-conversion and post-conversion to Oracle "
^DIC(19,17051,1,7,0)="Health."
^DIC(19,17051,1,8,0)=" "
^DIC(19,17051,1,9,0)="The report can be run for a single clinic (entry in the HOSPITAL LOCATION "
^DIC(19,17051,1,10,0)="file (#44)) or for all clinics. "
^DIC(19,17051,1,11,0)=" "
^DIC(19,17051,1,12,0)="The report can be sorted by the following:  All, With Encounters, Without "
^DIC(19,17051,1,13,0)="Encounters, Without Action Required Encounters."
^DIC(19,17051,15)=" "
^DIC(19,17051,20)=" "
^DIC(19,17051,25)="CNVTDLST^EHMAPPT"
^DIC(19,17051,"U")="CONVERTED APPOINTMENT LIST"
^DIC(19,17052,0)="EHM_POST CONVERSION APPT LIST^Post Conversion Appointment List^^R^1^^^^^^^594"
^DIC(19,17052,1,0)="^19.06^11^11^3240501^^"
^DIC(19,17052,1,1,0)="This option will provide a detailed report of appointments that have an "
^DIC(19,17052,1,2,0)="appointment date after the Oracle Health conversion date and entered in "
^DIC(19,17052,1,3,0)="VistA after the Oracle Health conversion date."
^DIC(19,17052,1,4,0)=" "
^DIC(19,17052,1,5,0)="The report excludes clinics added in the active clinic add/edit option."
^DIC(19,17052,1,6,0)=" "
^DIC(19,17052,1,7,0)="This report can be run pre-conversion and post-conversion to Oracle "
^DIC(19,17052,1,8,0)="Health."
^DIC(19,17052,1,9,0)=" "
^DIC(19,17052,1,10,0)="The report can be run for a single clinic (entry in the HOSPITAL LOCATION "
^DIC(19,17052,1,11,0)="file (#44)) or for all clinics. "
^DIC(19,17052,25)="POSTLIST^EHMAPPT0"
^DIC(19,17052,"U")="POST CONVERSION APPOINTMENT LI"
^DIC(19,17053,0)="EHM_CONVERTED APPT SUMMARY^Converted Appointment Summary^^R^1^^^^^^^594"
^DIC(19,17053,1,0)="^^10^10^3240423^"
^DIC(19,17053,1,1,0)="This option will produce a summary list of appointments that have an "
^DIC(19,17053,1,2,0)="appointment date on or after the date of conversion that were created "
^DIC(19,17053,1,3,0)="before the date of conversion but no more than two years prior to the "
^DIC(19,17053,1,4,0)="conversion date. "
^DIC(19,17053,1,5,0)=" "
^DIC(19,17053,1,6,0)="This report can be run pre-conversion and post-conversion to Oracle "
