^DIC(19,12281,0)="XWB M2M CACHE LISTENER^Start M2M RPC Broker Cache Listener^^R^10000000020^^^^^^y^501^^1^1"
^DIC(19,12281,1,0)="^19.06^4^4^3040826^^^"
^DIC(19,12281,1,1,0)="This option is for Cache/NT only.  It will start the listener for RPC "
^DIC(19,12281,1,2,0)="Broker M2M.  This option called STRT^XWBVLL() and it is jobbed off.  "
^DIC(19,12281,1,3,0)="Option will prompt you for PORT# to start the listener on.  The default "
^DIC(19,12281,1,4,0)="is 4800 which it the port use for M2M."
^DIC(19,12281,10.1)=" "
^DIC(19,12281,15)="D STRT^XWBVLL(XWBPORT)"
^DIC(19,12281,20)="W !! S DIR(0)=""N"",DIR(""B"")=""4800"",DIR(""A"")=""PORT"" D ^DIR Q:$D(DIRUT)  S XWBPORT=Y"
^DIC(19,12281,25)=" "
^DIC(19,12281,99)="59625,62769"
^DIC(19,12281,"U")="START M2M RPC BROKER CACHE LIS"
^DIC(19,12290,0)="PSS OTHER LANGUAGE SETUP^Other Language Translation Setup^^A^10000000020^^^^^^^517^^1"
^DIC(19,12290,1,0)="^19.06^2^2^3020916^^^^"
^DIC(19,12290,1,1,0)="This option can be used to enter other language translations that will"
^DIC(19,12290,1,2,0)="print on the outpatient pharmacy Rx labels."
^DIC(19,12290,20)="D OTHLAN^PSSJEEU"
^DIC(19,12290,"U")="OTHER LANGUAGE TRANSLATION SET"
^DIC(19,12294,0)="RORHDT MAIN^Historical Data Extraction^^M^1^^^^^^^540^^^"
^DIC(19,12294,1,0)="^19.06^16^16^3060131^^"
^DIC(19,12294,1,1,0)=" "
^DIC(19,12294,1,2,0)="This is a top level management option for the historical data extraction"
^DIC(19,12294,1,3,0)="that gathers historical data for each registry patient that exists on the"
^DIC(19,12294,1,4,0)="ROR REGISTRY RECORD file (#798) and creates flat text files that can be"
^DIC(19,12294,1,5,0)="FTP'd to a pre-defined area at the AAC. This is done independently of"
^DIC(19,12294,1,6,0)="daily updates and extracts and requires some intervention of an IRM."
^DIC(19,12294,1,7,0)=" "
^DIC(19,12294,1,8,0)="Each data extraction task will get the historical data patient by patient"
^DIC(19,12294,1,9,0)="and write it to a flat text file in HL7 format. If any data errors are"
^DIC(19,12294,1,10,0)="found they will be reported on log file, the task will then continue onto"
^DIC(19,12294,1,11,0)="the next patient on the registry."
^DIC(19,12294,1,12,0)=" "
^DIC(19,12294,1,13,0)="IRM's can check the status of the task using this user interface and view"
^DIC(19,12294,1,14,0)="the log file if any errors have been found. The log will provide enough"
^DIC(19,12294,1,15,0)="information for the IRM to fix the errors. After errors are fixed the task"
^DIC(19,12294,1,16,0)="can be re-started via this interface."
^DIC(19,12294,2)="y"
^DIC(19,12294,10,0)="^19.01IP^6^5"
^DIC(19,12294,10,1,0)="12295^DS^10"
^DIC(19,12294,10,3,0)="12297^ST^20"
^DIC(19,12294,10,4,0)="12298^TT^25"
^DIC(19,12294,10,5,0)="12299^ED^15"
^DIC(19,12294,10,6,0)="12301^DL^30"
^DIC(19,12294,10,"B",12295,1)=""
^DIC(19,12294,10,"B",12297,3)=""
^DIC(19,12294,10,"B",12298,4)=""
^DIC(19,12294,10,"B",12299,5)=""
^DIC(19,12294,10,"B",12301,6)=""
^DIC(19,12294,10,"C","DL",6)=""
^DIC(19,12294,10,"C","DS",1)=""
^DIC(19,12294,10,"C","ED",5)=""
^DIC(19,12294,10,"C","ST",3)=""
^DIC(19,12294,10,"C","TT",4)=""
^DIC(19,12294,15)=""
^DIC(19,12294,20)=""
^DIC(19,12294,99)="60708,41955"
^DIC(19,12294,200.9)="^"
^DIC(19,12294,"U")="HISTORICAL DATA EXTRACTION"
^DIC(19,12295,0)="RORHDT STATUS^Display Extraction Status^^R^1^^^^^^^540"
^DIC(19,12295,1,0)="^^15^15^3060131^"
^DIC(19,12295,1,1,0)=" "
^DIC(19,12295,1,2,0)="This option displays the status of a selected data extraction. The "
^DIC(19,12295,1,3,0)="historical data extraction start and end dates, the output directory name,"
^DIC(19,12295,1,4,0)="processed registries, and task table are displayed. For each task in the"
^DIC(19,12295,1,5,0)="table the following information is displayed:"
^DIC(19,12295,1,6,0)=" "
^DIC(19,12295,1,7,0)="ID: Identificator of the task (sequential number). "
^DIC(19,12295,1,8,0)=" "
^DIC(19,12295,1,9,0)="File name: Unique name based on site number and sequential number of the"
^DIC(19,12295,1,10,0)="task.  This file will contain the extracted data when the task has run; it"
^DIC(19,12295,1,11,0)="will reside in the designated output directory."
^DIC(19,12295,1,12,0)=" "
^DIC(19,12295,1,13,0)="Task: Task number assigned by the Taskman for the data extraction task."
^DIC(19,12295,1,14,0)=" "
^DIC(19,12295,1,15,0)="Status: Indicates the current status of the task."
^DIC(19,12295,2)="y"
^DIC(19,12295,25)="STATUS^RORHDT"
^DIC(19,12295,99)="58659,36996"
^DIC(19,12295,"U")="DISPLAY EXTRACTION STATUS"
^DIC(19,12296,0)="RORHDT CREATE^Create Extraction Tasks^^R^1^^^^^^^540"
^DIC(19,12296,1,0)="^^4^4^3060131^"
^DIC(19,12296,1,1,0)=" "
^DIC(19,12296,1,2,0)="This option allows users to spread historical data processing over several"
^DIC(19,12296,1,3,0)="tasks and thus avoid creating one large task that could use up too many "
^DIC(19,12296,1,4,0)="system resources by taking a long time to complete."
^DIC(19,12296,2)="y"
^DIC(19,12296,25)="CREATE^RORHDT"
^DIC(19,12296,99)="58659,37007"
^DIC(19,12296,"U")="CREATE EXTRACTION TASKS"
^DIC(19,12297,0)="RORHDT START^Start a Task^^R^1^^^^^^^540"
^DIC(19,12297,1,0)="^^5^5^3011214^"
^DIC(19,12297,1,1,0)=" "
^DIC(19,12297,1,2,0)="This option displays data extraction tasks that were created with the"
^DIC(19,12297,1,3,0)="'Create Extraction Tasks' option. Users can select a task and enter a date"
^DIC(19,12297,1,4,0)="and time that they want the task to run. This option can be re-entered to"
^DIC(19,12297,1,5,0)="re-schedule a previously scheduled task."
^DIC(19,12297,2)="y"
^DIC(19,12297,25)="START^RORHDT"
^DIC(19,12297,"U")="START A TASK"
^DIC(19,12298,0)="RORHDT STOP^Stop a Task^^R^1^^^^^^^540"
^DIC(19,12298,1,0)="^19.06^3^3^3011214^^"
^DIC(19,12298,1,1,0)=" "
^DIC(19,12298,1,2,0)="This option allows users to stop a running task or de-queue a task that "
^DIC(19,12298,1,3,0)="is scheduled to run in the future."
^DIC(19,12298,2)="y"
^DIC(19,12298,25)="STOP^RORHDT"
^DIC(19,12298,"U")="STOP A TASK"
^DIC(19,12299,0)="RORHDT EDIT^Edit^^M^1^^^^^^^540"
^DIC(19,12299,1,0)="^19.06^4^4^3051221^^^^"
^DIC(19,12299,1,1,0)=" "
^DIC(19,12299,1,2,0)="This option displays a submenu when selected. The submenu contains options"
^DIC(19,12299,1,3,0)="that are used to create and edit the parameters of the historical data"
^DIC(19,12299,1,4,0)="extraction."
^DIC(19,12299,2)="y"
^DIC(19,12299,10,0)="^19.01IP^4^2"
^DIC(19,12299,10,1,0)="12296^CT^10"
^DIC(19,12299,10,4,0)="13426^EE"
^DIC(19,12299,10,"B",12296,1)=""
^DIC(19,12299,10,"B",13426,4)=""
^DIC(19,12299,10,"C","CT",1)=""
^DIC(19,12299,10,"C","EE",4)=""
^DIC(19,12299,99)="60708,41955"
^DIC(19,12299,"U")="EDIT"
^DIC(19,12301,0)="RORHDT LOG^Display Task Log^^R^1^^^^^^^540"
^DIC(19,12301,1,0)="^19.06^4^4^3030610^^^"
^DIC(19,12301,1,1,0)=" "
^DIC(19,12301,1,2,0)="The 'Display Task Log' option lets users see a log of any running/finished"
^DIC(19,12301,1,3,0)="data extraction task. If any errors have been found, they would be logged"
^DIC(19,12301,1,4,0)="here. Any errors should be fixed and then the task re-started."
^DIC(19,12301,2)="y"
^DIC(19,12301,25)="LOG^RORHDT"
^DIC(19,12301,"U")="DISPLAY TASK LOG"
^DIC(19,12302,0)="ROR TASK^Registry Update & Data Extraction^^R^10000000216^^^^^^^540"
^DIC(19,12302,1,0)="^^34^34^3120518^"
^DIC(19,12302,1,1,0)=" "
^DIC(19,12302,1,2,0)="This option starts the registry update and data extraction task that"
^DIC(19,12302,1,3,0)="processes ALL active initialized registries."
^DIC(19,12302,1,4,0)=" "
^DIC(19,12302,1,5,0)="The following task parameters are optional. They can be defined on the"
^DIC(19,12302,1,6,0)="second page of the option scheduling form (as the pairs of the variable "
^DIC(19,12302,1,7,0)="names and values)."
^DIC(19,12302,1,8,0)=" "
^DIC(19,12302,1,9,0)="RORFLCLR, RORFLSET (Default: """")"
^DIC(19,12302,1,10,0)=" "
^DIC(19,12302,1,11,0)="These two parameters override the values of the flags that control the "
^DIC(19,12302,1,12,0)="processing. Add the flags to the RORFLCLR variable to clear them and to"
^DIC(19,12302,1,13,0)="the RORFLSET variable to set them. Below are the possible values of the "
^DIC(19,12302,1,14,0)="parameters (can be combined):"
^DIC(19,12302,1,15,0)=" "
^DIC(19,12302,1,16,0)="  ""E"" - Use the event references (file #798.3)"
^DIC(19,12302,1,17,0)=" "
^DIC(19,12302,1,18,0)="RORMNTSK (Default: ""2-3-AUTO"")"
^DIC(19,12302,1,19,0)=" "
^DIC(19,12302,1,20,0)="Maximum number of the registry update subtasks. If this parameter is less"
^DIC(19,12302,1,21,0)="than 2, all patients will be processed by the single main task. Otherwise,"
^DIC(19,12302,1,22,0)="all patients can be distributed among several subtasks."
^DIC(19,12302,1,23,0)=" "
^DIC(19,12302,1,24,0)="If ""N-M-AUTO"" is passed as the value of this parameter and difference"
^DIC(19,12302,1,25,0)="between the end and start dates of the registry update is more than M days"
^DIC(19,12302,1,26,0)="then N subtasks will be started. Otherwise, the single task will run."
^DIC(19,12302,1,27,0)=" "
^DIC(19,12302,1,28,0)="RORSUSP (Default: """")"
^DIC(19,12302,1,29,0)=" "
^DIC(19,12302,1,30,0)="Suspension parameters of the registry update subtasks. The subtasks are"
^DIC(19,12302,1,31,0)="not suspended by default. Parameter should contain start and end times of"
^DIC(19,12302,1,32,0)="the suspension (in external format) separated by the ""-"". For example, the"
^DIC(19,12302,1,33,0)="""7:00-18:00"" value will suspend the subtasks from 7am until 6pm each day"
^DIC(19,12302,1,34,0)="except weekends and holidays."
^DIC(19,12302,2)="n"
^DIC(19,12302,25)="TASK^ROR"
^DIC(19,12302,99.1)="60985,30687"
^DIC(19,12302,200.9)="y^y"
^DIC(19,12302,"U")="REGISTRY UPDATE & DATA EXTRACT"
^DIC(19,12303,0)="RORMNT MAIN^Clinical Case Registries Maintenance^^M^1^^^^^^^540"
^DIC(19,12303,1,0)="^19.06^3^3^3060131^^"
^DIC(19,12303,1,1,0)=" "
^DIC(19,12303,1,2,0)="This menu contains miscellaneous maintenance options for the Clinical Case"
^DIC(19,12303,1,3,0)="Registries package. Usually, they should be used only for troubleshooting."
^DIC(19,12303,2)="y"
