^DIC(19,6183,0)="QAQ MANAGER^QM Manager Menu^^M^.5^^^^^^^"
^DIC(19,6183,1,0)="^^2^2^2930325^^^"
^DIC(19,6183,1,1,0)="This option contains the manager menus for all the QM packages"
^DIC(19,6183,1,2,0)="installed at your site."
^DIC(19,6183,10,0)="^19.01PI^8^5"
