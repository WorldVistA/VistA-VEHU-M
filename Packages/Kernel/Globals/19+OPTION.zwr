^DIC(19,9931,0)="PRC REVIEW OF VOUCHERS^Quarterly Review of Vouchers^^R^11740^^^^^^^"
^DIC(19,9931,1,0)="^^22^22^2960827^"
^DIC(19,9931,1,1,0)="  This option QUARTERLY REVIEW OF VOUCHERS [PRC REVIEW OF VOUCHERS] under"
^DIC(19,9931,1,2,0)="  the IFCAP Application Coordinator Menu  [PRCHUSER COORDINATOR] is to be"
^DIC(19,9931,1,3,0)="  used in accordance with VA Directive 7127.1."
^DIC(19,9931,1,4,0)="  "
^DIC(19,9931,1,5,0)="  VA DIRECTIVE 7127.1"
^DIC(19,9931,1,6,0)="  March 27, 1996"
^DIC(19,9931,1,7,0)="  "
^DIC(19,9931,1,8,0)="  ACCOUNTING REQUIREMENTS"
^DIC(19,9931,1,9,0)="  "
^DIC(19,9931,1,10,0)="  1. PURPOSE.  This directive provides acquisition and materiel"
^DIC(19,9931,1,11,0)="     management policies required to audit VA vouchers."
^DIC(19,9931,1,12,0)="  "
^DIC(19,9931,1,13,0)="  2. POLICY.  All facilities using IFCAP will conduct a quarterly audit of"
^DIC(19,9931,1,14,0)="     all vouchers to determine that application of duplicate signatures on"
^DIC(19,9931,1,15,0)="     voucher documents are analyzed for validity of item or service"
^DIC(19,9931,1,16,0)="     requirement. The reviews will be conducted as outlined in Appendix A."
^DIC(19,9931,1,17,0)="  "
^DIC(19,9931,1,18,0)="  3. RESPONSIBILITY.  The Deputy Assistant Secretary for Acquisition and "
^DIC(19,9931,1,19,0)="     Materiel Management (90) will ensure a program is established to"
^DIC(19,9931,1,20,0)="     review and issue Department wide guidance and support."
^DIC(19,9931,1,21,0)="  "
^DIC(19,9931,1,22,0)="  4. REFERENCES.  OIG Report NO. 1AD-G07-116, Audit of IFCAP"
^DIC(19,9931,25)="PRCRIA"
^DIC(19,9931,"U")="QUARTERLY REVIEW OF VOUCHERS"
^DIC(19,9932,0)="PRCH CARD REGISTRATION^Purchase Card Registration^^R^11740^^^^^^^"
