^DIC(19,5265,0)="ECTP T&L ID^Identify T&L for Services^^R^.5^^^^^^^189"
^DIC(19,5265,1,0)="^^5^5^2901025^"
^DIC(19,5265,1,1,0)="This option allows the user to display all T&L units, display local"
^DIC(19,5265,1,2,0)="services, and thereby match the T&L units to the correct service."
^DIC(19,5265,1,3,0)="The option allows the input and editing of T&L data for local services."
^DIC(19,5265,1,4,0)="Finally, the user may display the list of T&L units input for services"
^DIC(19,5265,1,5,0)="in order to verify accuracy."
^DIC(19,5265,25)="ECTPTL"
^DIC(19,5265,"U")="IDENTIFY T&L FOR SERVICES"
^DIC(19,5266,0)="ECTP T&L SERVICES^PAID Data for All Services^^R^.5^^^^^^^189"
^DIC(19,5266,1,0)="^^5^5^2901101^"
^DIC(19,5266,1,1,0)="The user may choose the pay period/date range for this report which"
^DIC(19,5266,1,2,0)="prints for all services.  For the selected time-frame, the following"
^DIC(19,5266,1,3,0)="PAID totals will be displayed: annual leave, sick leave, leave without"
^DIC(19,5266,1,4,0)="pay, authorized absence, earned comp time, used comp time, unscheduled"
^DIC(19,5266,1,5,0)="regular time, and over time."
^DIC(19,5266,25)="ECTPAS"
^DIC(19,5266,99)="56382,35465"
^DIC(19,5266,"U")="PAID DATA FOR ALL SERVICES"
^DIC(19,5267,0)="ECTP T&L 1 SERVICE^PAID Data for One Service^^R^.5^^^^^^^189"
^DIC(19,5267,1,0)="^^5^5^2901112^^^"
^DIC(19,5267,1,1,0)="This option produces a report for a selected service.  The user may"
^DIC(19,5267,1,2,0)="choose the pay period/date range.  For the selected time-frame,"
^DIC(19,5267,1,3,0)="the following PAID totals will be displayed: annual leave, sick leave,"
^DIC(19,5267,1,4,0)="leave without pay, authorized absence, earned comp time, used comp"
^DIC(19,5267,1,5,0)="time, unscheduled regular time, and over time."
^DIC(19,5267,25)="ECTP1S"
^DIC(19,5267,99)="56487,40987"
^DIC(19,5267,"U")="PAID DATA FOR ONE SERVICE"
^DIC(19,5268,0)="ECTP T&L INDIVIDUAL^Individual PAID Inquiry^^R^.5^^^^^^^189"
^DIC(19,5268,1,0)="^^5^5^2901030^^"
^DIC(19,5268,1,1,0)="This option produces a report for a selected employee.  The user may"
^DIC(19,5268,1,2,0)="choose the pay period/date range.  For the selected time-frame,"
^DIC(19,5268,1,3,0)="the following PAID data will be displayed: annual leave, sick leave,"
^DIC(19,5268,1,4,0)="leave without pay, authorized absence, earned comp time, used comp"
^DIC(19,5268,1,5,0)="time, and over time."
^DIC(19,5268,25)="ECTPIND"
^DIC(19,5268,99)="56176,57066"
^DIC(19,5268,"U")="INDIVIDUAL PAID INQUIRY"
^DIC(19,5269,0)="ECTP FISCAL YEAR^Service Staffing Report by Fiscal Year^^R^.5^^^^^^^189"
^DIC(19,5269,1,0)="^^3^3^2901108^^"
^DIC(19,5269,1,1,0)="This report prints the assigned FTEE for all local services for a"
^DIC(19,5269,1,2,0)="selected range of fiscal years.  Up to a five year range may be"
^DIC(19,5269,1,3,0)="displayed on the report."
^DIC(19,5269,25)="ECTPFYR"
^DIC(19,5269,"U")="SERVICE STAFFING REPORT BY FIS"
^DIC(19,5270,0)="ECTF CP BAL^Display Control Point Official's Balance^^R^.5^^^^^^^189"
^DIC(19,5270,1,0)="^^2^2^2900928^"
^DIC(19,5270,1,1,0)="This option comes from the IFCAP package.  It displays a selected"
^DIC(19,5270,1,2,0)="control point official's balance."
^DIC(19,5270,25)="ECTFCPB"
^DIC(19,5270,"U")="DISPLAY CONTROL POINT OFFICIAL"
^DIC(19,5271,0)="ECTF CPO^Fund Control Point Officials^^R^.5^^^^^^^189"
^DIC(19,5271,1,0)="^^4^4^2900928^^^"
^DIC(19,5271,1,1,0)="This option displays data from the 'Fund Control Point' File."
^DIC(19,5271,1,2,0)="Data is sorted by station name and control point.  Fields"
^DIC(19,5271,1,3,0)="displayed include: control point, controlling service, and"
^DIC(19,5271,1,4,0)="control point manager."
^DIC(19,5271,25)="ECTFCPO"
^DIC(19,5271,"U")="FUND CONTROL POINT OFFICIALS"
^DIC(19,5272,0)="ECTF CONTRACT^Contract Summary by Fiscal Year^^R^.5^^^^^^^189"
^DIC(19,5272,1,0)="^^6^6^2901105^^"
^DIC(19,5272,1,1,0)="The contract summary report prints for a user selected fiscal year."
^DIC(19,5272,1,2,0)="The data is sorted by responsible service and within responsible"
^DIC(19,5272,1,3,0)="service, by contract number.  Fields displayed include: contract"
^DIC(19,5272,1,4,0)="number, description, contract type (i.e. maintenance, service,"
^DIC(19,5272,1,5,0)="or sharing), and contract amount.  A sub-total by service is"
^DIC(19,5272,1,6,0)="computed, as well as a grand total."
^DIC(19,5272,20)=""
^DIC(19,5272,25)="ECTFCS"
^DIC(19,5272,99)="54675,32781"
^DIC(19,5272,"U")="CONTRACT SUMMARY BY FISCAL YEA"
^DIC(19,5273,0)="ECTF FCP BAL^Fund Control Point Balance Sheet^^R^.5^^^^^^^189"
^DIC(19,5273,1,0)="^^3^3^2901110^"
^DIC(19,5273,1,1,0)="For a selected fiscal year, sorted by control point, this report displays "
^DIC(19,5273,1,2,0)="the current quarterly uncommitted balance, unobligated balance, and "
^DIC(19,5273,1,3,0)="SCP uncommitted balance."
^DIC(19,5273,25)="ECTFBAL"
^DIC(19,5273,"U")="FUND CONTROL POINT BALANCE SHE"
