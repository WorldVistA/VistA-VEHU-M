^DIC(19,15026,0)="PSO EPCS LOGICAL ACCESS REPORT^Changes to DEA Prescribing Privileges Report^^R^1^^^^^^^^^1^1"
^DIC(19,15026,1,0)="^^4^4^3211229^"
^DIC(19,15026,1,1,0)="This is an on-demand report option that will print the setting or change "
^DIC(19,15026,1,2,0)="to DEA prescribing privileges related to issuance of controlled substance "
^DIC(19,15026,1,3,0)="prescription. It'll prompt for a date range and will print data that has "
^DIC(19,15026,1,4,0)="been modified. The data is retrieved from the XUEPCS DATA file (#8991.6)."
^DIC(19,15026,15)="K PSORPT"
^DIC(19,15026,20)="S PSORPT=1"
^DIC(19,15026,25)="ODRPT^PSODEART"
^DIC(19,15026,"U")="CHANGES TO DEA PRESCRIBING PRI"
^DIC(19,15027,0)="PSO EPCS PHARMACIST ACC REPORT^Allocation Audit of PSDRPH Key Report^^R^1^^^^^^^141^^1^1"
^DIC(19,15027,1,0)="^^4^4^3211230^"
^DIC(19,15027,1,1,0)="This is an on-demand report option that will print the allocation of the "
^DIC(19,15027,1,2,0)="PSDRPH key. It'll prompt for a date range and will print the allocation "
^DIC(19,15027,1,3,0)="of the PSDRPH key data that has been modified. The data is retrieved from "
^DIC(19,15027,1,4,0)="the XUEPCS PSDRPH AUDIT file (#8991.7)."
^DIC(19,15027,15)="K PSORPT"
^DIC(19,15027,20)="S PSORPT=2"
^DIC(19,15027,25)="ODRPT^PSODEART"
^DIC(19,15027,"U")="ALLOCATION AUDIT OF PSDRPH KEY"
^DIC(19,15028,0)="PSO EPCS PSDRPH AUDIT^Task Allocation Audit of PSDRPH Key Report^^R^1^^^^^^^141"
^DIC(19,15028,1,0)="^^5^5^3211230^"
^DIC(19,15028,1,1,0)="This option is for the DEA ePCS project and will print the allocation of "
^DIC(19,15028,1,2,0)="the PSDRPH key.  The report will only print data from the previous day "
^DIC(19,15028,1,3,0)="and with data that has been modified.  The report prints data for the "
^DIC(19,15028,1,4,0)="archive file #8991.7.  This option should be scheduled to run on a daily "
^DIC(19,15028,1,5,0)="basis."
^DIC(19,15028,25)="RPT2^PSODEART"
^DIC(19,15028,200.9)="y"
^DIC(19,15028,"U")="TASK ALLOCATION AUDIT OF PSDRP"
^DIC(19,15029,0)="PSO EPCS LOGICAL ACCESS^Task Changes to DEA Prescribing Privileges Report^^R^1^^^^^^^141"
^DIC(19,15029,1,0)="^^6^6^3211230^"
^DIC(19,15029,1,1,0)="This option is for the DEA ePCS project and will print the setting or "
^DIC(19,15029,1,2,0)="change to DEA prescribing privileges related to issuance of controlled "
^DIC(19,15029,1,3,0)="substance prescription.  The report will only print data from the "
^DIC(19,15029,1,4,0)="previous day and with data that has been modified.  The data is retrieved "
^DIC(19,15029,1,5,0)="from file #8991.6.  This option should be scheduled to run on a daily "
^DIC(19,15029,1,6,0)="basis."
^DIC(19,15029,25)="RPT1^PSODEART"
^DIC(19,15029,200.9)="y"
^DIC(19,15029,"U")="TASK CHANGES TO DEA PRESCRIBIN"
