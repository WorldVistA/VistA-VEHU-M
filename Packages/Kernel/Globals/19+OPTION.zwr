^DIC(19,14432,"U")="CLINICAL SCHEDULING PROCEDURE "
^DIC(19,14433,0)="SDEC IDX REFRESH^Refresh SDEC Index global^^R^1^^^^^^^"
^DIC(19,14433,1,0)="^^2^2^3150420^"
^DIC(19,14433,1,1,0)="This option prepares the ^XTMP(""SDEC"",""IDX"" global and should be "
^DIC(19,14433,1,2,0)="scheduled to run daily at 2am."
^DIC(19,14433,10.1)="Refresh SDEC Index global"
^DIC(19,14433,25)="ENTRY^SDECIDX"
^DIC(19,14433,200.9)="y"
^DIC(19,14433,"U")="REFRESH SDEC INDEX GLOBAL"
^DIC(19,14434,0)="SDEC ACCESS BLOCK MAINTENANCE^SDEC ACCESS BLOCK MAINTENANCE^^R^1^^^^^^^"
^DIC(19,14434,1,0)="^^3^3^3150610^"
^DIC(19,14434,1,1,0)="This option maintains the SDEC ACCESS BLOCK file by removing old entries "
^DIC(19,14434,1,2,0)="that are no longer needed and possibly adding future entries."
^DIC(19,14434,1,3,0)="This option should be scheduled to run nightly."
^DIC(19,14434,10.1)="Maintain SDEC ACCESS BLOCKS"
^DIC(19,14434,25)="ABM^SDEC04"
^DIC(19,14434,"U")="SDEC ACCESS BLOCK MAINTENANCE"
^DIC(19,14435,0)="SDEC REPORT DATA^VistA Scheduling GUI Resource Mgmt Report Data^^R^1^^^^^^^16^^1^1"
^DIC(19,14435,1,0)="^^2^2^3150706^"
^DIC(19,14435,1,1,0)="This option allows Scheduling Administrators to initiate the VistA"
^DIC(19,14435,1,2,0)="Scheduling GUI Resource Management Report data compilation."
^DIC(19,14435,15)="D EXITOPT^SDCED"
^DIC(19,14435,20)="S SDECMAIL=1"
^DIC(19,14435,25)="QUEUE^SDCED"
^DIC(19,14435,99)="63516,28327"
^DIC(19,14435,200.9)="y"
^DIC(19,14435,"U")="VISTA SCHEDULING GUI RESOURCE "
^DIC(19,14436,0)="SDRR CLINIC LETTER REPORT^Clinic Letter Report^^R^1^^^^^^^16"
^DIC(19,14436,1,0)="^^3^3^3160114^"
^DIC(19,14436,1,1,0)="This option lists clinics and patients from RECALL REMINDER entries that "
^DIC(19,14436,1,2,0)="are associated with a clinic in which there is not a RECALL REMINDER "
^DIC(19,14436,1,3,0)="LETTER defined."
^DIC(19,14436,10.1)="Clinic Letter Report"
^DIC(19,14436,25)="SDRRREP"
^DIC(19,14436,200.9)="n"
^DIC(19,14436,"U")="CLINIC LETTER REPORT"
^DIC(19,14437,0)="RISA CLONE PATIENT^Clone a Patient^^R^1"
^DIC(19,14437,1,0)="^19.06^1^1^3160919^^"
^DIC(19,14437,1,1,0)="Allows the user to clone a patient, including orders, meds, lab results, etc."
^DIC(19,14437,25)="CLONE^ZZCPDAT0"
^DIC(19,14437,"U")="CLONE A PATIENT"
^DIC(19,14438,0)="GMRA ASSESSMENT UTILITY^Assessment clean up utility^^R^1^^^^^^^247"
^DIC(19,14438,1,0)="^^5^5^3130409^"
^DIC(19,14438,1,1,0)="Identifies patients whose ADVERSE REACTION ASSESSMENT file (#120.86) "
^DIC(19,14438,1,2,0)="entry is not synced with the PATIENT ALLERGIES file (#120.8).  After "
^DIC(19,14438,1,3,0)="reviewing the patient's assessment and allergy entries, the user can "
^DIC(19,14438,1,4,0)="either modify the assessment or can mark all allergies as entered in "
^DIC(19,14438,1,5,0)="error."
^DIC(19,14438,25)="EN^GMRAFA"
^DIC(19,14438,"U")="ASSESSMENT CLEAN UP UTILITY"
^DIC(19,14439,0)="RISA UTILITIES^Risa Utilities^^M^1"
^DIC(19,14439,1,0)="^19.06^1^1^3160919^^^"
^DIC(19,14439,1,1,0)="This menu contains utilities used by Team Risa for test data maintenance."
^DIC(19,14439,10,0)="^19.01IP^2^2"
^DIC(19,14439,10,1,0)=14437
^DIC(19,14439,10,2,0)=14478
^DIC(19,14439,10,"B",14437,1)=""
^DIC(19,14439,10,"B",14478,2)=""
^DIC(19,14439,99)="64180,56787"
^DIC(19,14439,99.1)="67804,41143"
^DIC(19,14439,"U")="RISA UTILITIES"
^DIC(19,14440,0)="PRCHJ TRANS REPORT3^Transaction Report - eCMS/IFCAP^^R^1^PRCHJFIS^^^^^^121^^^"
^DIC(19,14440,1,0)="^19.06^5^5^3130716^^^^"
^DIC(19,14440,1,1,0)="This report displays information about HL7 transactions that take place"
^DIC(19,14440,1,2,0)="between eCMS and IFCAP.  This option is available to Fiscal users who have"
^DIC(19,14440,1,3,0)="the appropriate security key."
^DIC(19,14440,1,4,0)="The report is generated from data stored in the IFCAP/ECMS TRANSACTION"
^DIC(19,14440,1,5,0)="file [414.06]."
^DIC(19,14440,15)=""
^DIC(19,14440,20)=""
^DIC(19,14440,25)="EN^PRCHJRP5"
^DIC(19,14440,99.1)="62937,55696"
^DIC(19,14440,"U")="TRANSACTION REPORT - ECMS/IFCA"
^DIC(19,14441,0)="RCDPE CARC CODE PAYER REPORT^835 CARC Data Report^^R^1^^^^^^^261"
^DIC(19,14441,1,0)="^19.06^2^2^3150728^^^"
^DIC(19,14441,1,1,0)="This report is used to summarize the CARC codes and amounts reimbursed by "
^DIC(19,14441,1,2,0)="the third party payers from the returned 835 forms."
^DIC(19,14441,25)="EN^RCDPARC"
^DIC(19,14441,"U")="835 CARC DATA REPORT"
^DIC(19,14442,0)="RCDPE CARC/RARC TABLE REPORT^CARC/RARC Table Data Report^^R^1^^^^^^^261"
^DIC(19,14442,1,0)="^19.06^5^5^3141231^^^^"
^DIC(19,14442,1,1,0)="This report will allow a user to see the full information on CARC or RARC "
^DIC(19,14442,1,2,0)="data stored in the AR EDI CARC DATA and AR EDI RARC DATA files. These "
^DIC(19,14442,1,3,0)="files are transmitted from the FSC and the FSC has a subscription with "
^DIC(19,14442,1,4,0)="the Washington Publishing Company which keeps the official versions of "
^DIC(19,14442,1,5,0)="these code lists."
^DIC(19,14442,25)="EN^RCDPCRR"
^DIC(19,14442,"U")="CARC/RARC TABLE DATA REPORT"
^DIC(19,14443,0)="RCDPE PROVIDER LVL ADJ REPORT^Provider Level Adjustments (PLB) Report^^R^1^^^^^^^261"
^DIC(19,14443,1,0)="^19.06^3^3^3150728^^"
^DIC(19,14443,1,1,0)="This report will display ERA data with PLB (Provider Level Benifits) data "
^DIC(19,14443,1,2,0)="details. This is an ad-hoc report to allow the user to extract reportdata "
^DIC(19,14443,1,3,0)="as well as view and manage refund requests for all PLB adjustment codes."
^DIC(19,14443,25)="EN^RCDPPLB"
^DIC(19,14443,"U")="PROVIDER LEVEL ADJUSTMENTS (PL"
^DIC(19,14444,0)="RCDPE EFT TRANSACTION AUD REP^EFT Transaction Audit Report^^R^1^^^^^^^261"
^DIC(19,14444,1,0)="^^3^3^3150102^"
^DIC(19,14444,1,1,0)="This report will list all actions that have been performed on a single "
^DIC(19,14444,1,2,0)="EFT. The intent of the report is to follow the the EFT from cradle to "
^DIC(19,14444,1,3,0)="grave."
^DIC(19,14444,25)="EN^RCDPTAR"
^DIC(19,14444,"U")="EFT TRANSACTION AUDIT REPORT"
^DIC(19,14445,0)="RCDPE CARC/RARC QUICK SEARCH^CARC/RARC Quick Search^^R^1^^^^^^^261^^1"
^DIC(19,14445,1,0)="^^3^3^3150108^"
^DIC(19,14445,1,1,0)="This is option is a quick lookup of a CARC or RARC data. This is to be "
^DIC(19,14445,1,2,0)="used by the user to get a full description of a single or limited set of "
^DIC(19,14445,1,3,0)="codes."
^DIC(19,14445,20)="S QS=1"
^DIC(19,14445,25)="EN^RCDPCRR"
^DIC(19,14445,"U")="CARC/RARC QUICK SEARCH"
^DIC(19,14446,0)="RCDPE EDI CARC-RARC SERVER^EDI Lockbox CARC-RARC Processing Server^^S^1^^^^^^^261"
^DIC(19,14446,1,0)="^19.06^3^3^3150121^^^^"
^DIC(19,14446,1,1,0)="This option is the server interface for processing the CARC/RARC data "
^DIC(19,14446,1,2,0)="files sent from the FSC in Austin. This option executes the processor to "
^DIC(19,14446,1,3,0)="file the records sent to the G.CARC_RARC_DATA MailMan Group."
^DIC(19,14446,25)="SERV^RCDPEMSG"
^DIC(19,14446,220)="^R^435^Y^Y^^1^^7"
^DIC(19,14446,"U")="EDI LOCKBOX CARC-RARC PROCESSI"
^DIC(19,14447,0)="RCDPE EDI VOLUME STATISTICS^EDI VOLUME STATISTICS Report^^R^1^^^^^^y^261^^"
^DIC(19,14447,1,0)="^19.06^4^4^3150602^^^^"
^DIC(19,14447,1,1,0)="This report compiles and prints out statistical metrics for Medical "
^DIC(19,14447,1,2,0)="(837) and Pharmacy (NCPDP) electronic claims, and the payments (835s) "
^DIC(19,14447,1,3,0)="received for those claims.  This information can either be reviewed "
^DIC(19,14447,1,4,0)="locally or sent to the National reporting group."
^DIC(19,14447,20)=""
^DIC(19,14447,25)="835837^RCDPENR1"
^DIC(19,14447,"U")="EDI VOLUME STATISTICS REPORT"
^DIC(19,14448,0)="RCDPE EFT-ERA TRENDING REPORT^EFT/ERA TRENDING Report^^R^1^^^^^^^261"
^DIC(19,14448,1,0)="^^3^3^3150727^"
^DIC(19,14448,1,1,0)="This report contains the metrics for the # of ERAs, # of EEOBs, and # of"
^DIC(19,14448,1,2,0)="EFTs processed during a given time period. It will also calculate the # "
^DIC(19,14448,1,3,0)="of days between each step in the electronic payments process."
^DIC(19,14448,25)="EFTERA^RCDPENR2"
^DIC(19,14448,"U")="EFT/ERA TRENDING REPORT"
^DIC(19,14449,0)="RCDPE NR DISABLE/ENABLE^Disable-Enable DM Background Job/Reports^^R^11720^PRCFA SUPERVISOR^^^^^^261"
^DIC(19,14449,1,0)="^^3^3^3150603^"
^DIC(19,14449,1,1,0)="This option allows a user to disable or re-enable the AR National Reports "
^DIC(19,14449,1,2,0)="background job.  Once a report is disabled, it won't re-queue to run via "
^DIC(19,14449,1,3,0)="the AR National Reports process."
^DIC(19,14449,25)="DER^RCDPENRU"
^DIC(19,14449,"U")="DISABLE-ENABLE DM BACKGROUND J"
^DIC(19,14450,0)="RCDPE NR VIEW/PRINT EXTRACTS^View/Print Extracted Reports^^R^1^^^^^^^261"
^DIC(19,14450,1,0)="^^3^3^3150603^"
^DIC(19,14450,1,1,0)="This option allows a user to see the results of previous AR National "
^DIC(19,14450,1,2,0)="Report extractions.  It shows whether or not certain reports made it "
^DIC(19,14450,1,3,0)="through the extraction process."
^DIC(19,14450,25)="VPE^RCDPENRU"
^DIC(19,14450,"U")="VIEW/PRINT EXTRACTED REPORTS"
^DIC(19,14451,0)="RCDPE NR MANUAL START^Manually Start DM Extract^^R^11720^PRCFA SUPERVISOR^^^^^^261"
^DIC(19,14451,1,0)="^19.06^2^2^3150603^^"
^DIC(19,14451,1,1,0)="This option allows a user to restart the AR National Reports Extraction "
^DIC(19,14451,1,2,0)="background job if the report is not running."
^DIC(19,14451,25)="MAN1^RCDPENRU"
^DIC(19,14451,33)=""
^DIC(19,14451,"U")="MANUALLY START DM EXTRACT"
^DIC(19,14452,0)="RCDPE NR MANUAL TRANSMIT^Manually Transmit DM Extract^^R^11720^PRCFA SUPERVISOR^^^^^^261"
^DIC(19,14452,1,0)="^19.06^3^3^3150603^^"
^DIC(19,14452,1,1,0)="This option allows a user to retransmit a AR National Report file to "
^DIC(19,14452,1,2,0)="FORUM for a particular month if that month's report data did not "
^DIC(19,14452,1,3,0)="successfully transmit the first time."
^DIC(19,14452,25)="MAN2^RCDPENRU"
^DIC(19,14452,"U")="MANUALLY TRANSMIT DM EXTRACT"
^DIC(19,14453,0)="RCDPE NR EXTRACT MENU^EDI Diagnostic Measures Extracts Menu^^M^1^^^^^^^261^^"
^DIC(19,14453,1,0)="^19.06^1^1^3160112^^^^"
^DIC(19,14453,1,1,0)="This menu contains options related to the AR National Reports extraction."
