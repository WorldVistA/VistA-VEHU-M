^DIC(19,7788,"U")="CNH CENSUS REPORT"
^DIC(19,7789,0)="FBCNH AMIE^Report of Admissions/Discharges for CNH^^R^1^^^^^^^344^^1^1"
^DIC(19,7789,1,0)="^^2^2^2930507^^^"
^DIC(19,7789,1,1,0)="Output report listing Admissions to and Discharges from a Contract Nursing"
