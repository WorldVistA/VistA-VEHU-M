^DIC(19,7898,0)="PRSA PT D1^Display Special Tour Indicator^^R^.5^^^^^^^"
^DIC(19,7898,1,0)="^^2^2^2930202^^^^"
^DIC(19,7898,1,1,0)="This option displays a list of the special tour indicators, the type"
^DIC(19,7898,1,2,0)="of time associated with each indicator and the indicator's code."
^DIC(19,7898,25)="STID^PRSAPT1"
^DIC(19,7898,"U")="DISPLAY SPECIAL TOUR INDICATOR"
^DIC(19,7899,0)="PRSA PT D2^Display Type of Time Table^^R^.5^^^^^^^"
^DIC(19,7899,1,0)="^^3^3^2930202^^^^"
^DIC(19,7899,1,1,0)="This option displays a list of the various types of time that may be"
^DIC(19,7899,1,2,0)="coded on a time card. The code, a short description and a long"
^DIC(19,7899,1,3,0)="description are displayed for each entry."
^DIC(19,7899,25)="TTD^PRSAPT1"
^DIC(19,7899,"U")="DISPLAY TYPE OF TIME TABLE"
^DIC(19,7900,0)="PRSA PT D3^Display Time Remarks^^R^.5^^^^^^^"
^DIC(19,7900,1,0)="^^3^3^2930202^^^^"
^DIC(19,7900,1,1,0)="This option displays a list of the various time remarks. For each"
^DIC(19,7900,1,2,0)="time remark, the code, its description and the applicable types of"
^DIC(19,7900,1,3,0)="time associated with it are displayed."
^DIC(19,7900,25)="TRMD^PRSAPT1"
^DIC(19,7900,"U")="DISPLAY TIME REMARKS"
^DIC(19,7901,0)="PRSA PT MENU^Payroll Table Maintenance^^M^.5^^^^^^^"
^DIC(19,7901,1,0)="^^3^3^2930211^^^"
^DIC(19,7901,1,1,0)="This option is a submenu on the Payroll Supervisor Menu. The options"
^DIC(19,7901,1,2,0)="on this submenu allow the user to display Special Tour Indicators,"
^DIC(19,7901,1,3,0)="Types of Time, Time Remarks and Entitlement Table entries."
^DIC(19,7901,10,0)="^19.01PI^6^4"
^DIC(19,7901,10,1,0)="7898^1"
^DIC(19,7901,10,3,0)="7899^2"
^DIC(19,7901,10,5,0)="7900^3"
^DIC(19,7901,10,6,0)="7925^4"
