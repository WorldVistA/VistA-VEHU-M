^DIC(19,8033,0)="IBT OUTPUT CLAIM INQUIRY^Inquire to Claims Tracking^^R^.5^^^^^^^192"
^DIC(19,8033,1,0)="^^3^3^2940207^^^"
^DIC(19,8033,1,1,0)="This option allows viewing or printing a detailed inquiry to any claims"
^DIC(19,8033,1,2,0)="tracking entry.  This includes showing all associated reviews and"
^DIC(19,8033,1,3,0)="communications."
^DIC(19,8033,25)="IBTOTR"
^DIC(19,8033,"U")="INQUIRE TO CLAIMS TRACKING"
^DIC(19,8034,0)="IBT EDIT TRACKING PARAMETERS^Claims Tracking Parameter Edit^^R^11720^IB PARAMETER EDIT^^^^^^192"
^DIC(19,8034,1,0)="^19.06^2^2^3161215^^^^"
^DIC(19,8034,1,1,0)="This option allows editing MCCR site parameters that affect the"
^DIC(19,8034,1,2,0)="Claims Tracking Module."
^DIC(19,8034,25)="IBTRP"
^DIC(19,8034,"U")="CLAIMS TRACKING PARAMETER EDIT"
^DIC(19,8035,0)="IBT EDIT REVIEWS TO DO^Pending Reviews^^A^.5^^^^^^^192^^1"
^DIC(19,8035,1,0)="^^7^7^2940307^^^^"
^DIC(19,8035,1,1,0)="This option will list all reviews that have a next review date in the"
^DIC(19,8035,1,2,0)="past seven days.  All screens and actions necessary to complete the "
^DIC(19,8035,1,3,0)="pending reviews are available from within this option.  You may also"
^DIC(19,8035,1,4,0)="select a different date range of pending reviews if desired."
^DIC(19,8035,1,5,0)="Both Hospital and Insurance reviews can be accessed with this option."
^DIC(19,8035,1,6,0)="Many pending reviews may have automatically been created by the computer "
^DIC(19,8035,1,7,0)="when a patient is admitted."
^DIC(19,8035,20)="S IBTRPRF=12 D ^IBTRPR K IBTRPRF"
^DIC(19,8035,99)="55774,51555"
^DIC(19,8035,"U")="PENDING REVIEWS"
^DIC(19,8036,0)="IBT OUTPUT DENIED DAYS REPORT^Days Denied Report^^R^.5^^^^^^^192"
^DIC(19,8036,1,0)="^^2^2^2931104^"
^DIC(19,8036,1,1,0)="This option prints a summary of days denied by insurance company for a"
^DIC(19,8036,1,2,0)="user specified date range.  A summary report by service is also generated."
^DIC(19,8036,25)="IBTODD"
^DIC(19,8036,"U")="DAYS DENIED REPORT"
^DIC(19,8037,0)="IBT OUTPUT UR ACTIVITY REPORT^UR Activity Report^^R^.5^^^^^^^192"
^DIC(19,8037,1,0)="^^2^2^2931110^^"
^DIC(19,8037,1,1,0)="This option prints by clinical service, information about the mccr/ur"
^DIC(19,8037,1,2,0)="activity."
^DIC(19,8037,25)="IBTOUR"
^DIC(19,8037,"U")="UR ACTIVITY REPORT"
^DIC(19,8038,0)="IBT OUTPUT SCHED ADM W/INS^Scheduled Admissions w/Insurance^^R^.5^^^^^^^192"
^DIC(19,8038,1,0)="^^4^4^2940307^^^"
^DIC(19,8038,1,1,0)="This option will print a list of Admission that are scheduled but"
^DIC(19,8038,1,2,0)="not admitted and/or scheduled admissions that have been admitted."
^DIC(19,8038,1,3,0)="All admissions must be for patients who were insured on their admission"
^DIC(19,8038,1,4,0)="date."
^DIC(19,8038,25)="IBTOSA"
^DIC(19,8038,"U")="SCHEDULED ADMISSIONS W/INSURAN"
