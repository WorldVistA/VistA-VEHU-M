^DIC(19,16892,0)="EHM-01713^List Membership by User^^A^1^^^^^^^^^1^^"
^DIC(19,16892,1,0)="^19.06^3^3^3240328^^^^"
^DIC(19,16892,1,1,0)="This option allows review, addition, editing, and removal of individual"
^DIC(19,16892,1,2,0)="members to and from User Classes."
^DIC(19,16892,1,3,0)="Cloned from ""USR LIST MEMBERSHIP BY USER"" option."
