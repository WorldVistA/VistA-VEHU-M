^DIC(19,16061,0)="EHM-00882^BCMA Drug IEN Synonym Check^^R^1^^^^^^^533^^^^"
^DIC(19,16061,1,0)="^^4^4^3240328^"
^DIC(19,16061,1,1,0)="This option checks a specific drug in the DRUG (#50) file by using its "
