^DIC(19,9140,1,2,0)="Production Facilities, Service Points, Communication Offices, and"
^DIC(19,9140,1,3,0)="Supplemental Feeding Sites. The reports show all parameters"
^DIC(19,9140,1,4,0)="associated with each facility."
^DIC(19,9140,25)="FHPRW1"
^DIC(19,9140,"U")="LIST PRODUCTION/SERVICE/COMMUN"
