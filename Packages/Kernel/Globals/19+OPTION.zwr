^DIC(19,1697,1,1,0)="This function allows the coordinator to override"
^DIC(19,1697,1,2,0)="the status of any exam to 'complete'.  The only exceptions to"
^DIC(19,1697,1,3,0)="this function are exams which are already 'complete' or those"
^DIC(19,1697,1,4,0)="which have been 'cancelled'."
^DIC(19,1697,25)="SINGLE^RAESO"
^DIC(19,1697,"U")="OVERRIDE A SINGLE EXAM'S STATU"
^DIC(19,1698,0)="RA PAST^Enter Last Past Visit Before VISTA^^R^11712^^^^^^^"
^DIC(19,1698,1,0)="^^6^6^2970818^^"
^DIC(19,1698,1,1,0)="This option allows the user to enter the last visit to the department for"
^DIC(19,1698,1,2,0)="a patient."
^DIC(19,1698,1,3,0)=" "
^DIC(19,1698,1,4,0)="Many file rooms are divided by date. By entering the last exam date, it"
^DIC(19,1698,1,5,0)="will allow the file room clerk to lookup the patient's last visit by using"
^DIC(19,1698,1,6,0)="the patient demographic display option."
^DIC(19,1698,25)="RAPAST"
^DIC(19,1698,"U")="ENTER LAST PAST VISIT BEFORE V"
