^DIC(19,13291,0)="BPS NIGHTLY BACKGROUND JOB^BPS NIGHTLY BACKGROUND JOB^^R^1^^^^^^^"
^DIC(19,13291,1,0)="^^6^6^3060602^"
^DIC(19,13291,1,1,0)="This option is not to be placed on any menu nor run by any user.  It has"
^DIC(19,13291,1,2,0)="specifically been designed to be scheduled in TaskMan to be executed"
^DIC(19,13291,1,3,0)="once a day during off-peak hours. It is recommended that this option be"
^DIC(19,13291,1,4,0)="scheduled to run at night after midnight. Running this option more than"
^DIC(19,13291,1,5,0)="once a day may cause unexpected results.  This option is the BPS nightly"
^DIC(19,13291,1,6,0)="task that performs ECME-related nightly procedures."
^DIC(19,13291,25)="EN^BPSBCKJ"
^DIC(19,13291,200.9)="y"
^DIC(19,13291,"U")="BPS NIGHTLY BACKGROUND JOB"
^DIC(19,13293,0)="BPS UNSTRAND SCREEN^View/Unstrand Submissions Not Completed^^R^10000000216^BPS MANAGER^^^^^^^^^"
^DIC(19,13293,1,0)="^^7^7^3101006^"
^DIC(19,13293,1,1,0)="List Manager screen which permits users to see submissions that have not"
^DIC(19,13293,1,2,0)="completed and have been in progress for one half hour or more. Users"
^DIC(19,13293,1,3,0)="can then unstrand these submissions.  In the case of billing "
^DIC(19,13293,1,4,0)="requests and reversals, the submissions can be processed via the"
^DIC(19,13293,1,5,0)="ECME user screen (i.e., reversed, resubmitted).  For eligibility "
^DIC(19,13293,1,6,0)="verification submissions, the submissions will unstrand to permit"
^DIC(19,13293,1,7,0)="processing of subquent requests."
^DIC(19,13293,15)=""
^DIC(19,13293,25)="EN^BPSUSCR"
^DIC(19,13293,99.1)="58154,30494"
^DIC(19,13293,"U")="VIEW/UNSTRAND SUBMISSIONS NOT "
^DIC(19,13294,0)="BPS RPT PAYER SHEET DETAIL^Payer Sheet Detail Report^^R^1^BPS REPORTS^^^^^^"
^DIC(19,13294,1,0)="^^3^3^3060602^"
^DIC(19,13294,1,1,0)="This report shows detail information for payer sheets in the BPS NCPDP"
^DIC(19,13294,1,2,0)="FORMATS (#9002313.92) table, including NCPDP segment and field"
^DIC(19,13294,1,3,0)="information."
^DIC(19,13294,25)="EN^BPSRPAY"
^DIC(19,13294,"U")="PAYER SHEET DETAIL REPORT"
^DIC(19,13295,0)="BPS STATISTICS SCREEN^Statistics Screen^^R^1^BPS MANAGER^^^^^^^^^"
^DIC(19,13295,1,0)="^^4^4^3060602^"
^DIC(19,13295,1,1,0)="List Manager screen that shows claims that are in progress and"
^DIC(19,13295,1,2,0)="completed.  The in progress claims are broken out by the progress states"
^DIC(19,13295,1,3,0)="(i.e., Waiting for Packet Build, Transmitted).  The completed claims are"
^DIC(19,13295,1,4,0)="broken out by payer results (i.e., Paid, Rejected, Duplicate)."
^DIC(19,13295,15)=""
^DIC(19,13295,20)=""
^DIC(19,13295,25)="EN^BPSOS2"
^DIC(19,13295,"U")="STATISTICS SCREEN"
^DIC(19,13296,0)="BPS RPT SETUP PHARMACIES^ECME Setup - Pharmacies Report^^P^1^BPS REPORTS^^^^^^^^^1"
^DIC(19,13296,1,0)="^^3^3^3060602^"
^DIC(19,13296,1,1,0)="This report shows BPS Pharmacy information entered via the Register with"
^DIC(19,13296,1,2,0)="Austin Automation Center and Edit ECME Pharmacy Data options.  All BPS"
^DIC(19,13296,1,3,0)="Pharmacies are displayed."
