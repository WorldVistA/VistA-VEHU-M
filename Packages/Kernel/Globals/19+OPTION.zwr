^DIC(19,5757,0)="FBAA PRINT REPORT OF CONTACT^Print Report of Contact^^R^.5^^^^^^^"
^DIC(19,5757,1,0)="^^2^2^2881014^"
^DIC(19,5757,1,1,0)="This option generates a hard copy of a Fee Basis Patient"
^DIC(19,5757,1,2,0)="Report of Contact in the format of VA FORM 119."
^DIC(19,5757,25)="FBAAPRC"
^DIC(19,5757,"U")="PRINT REPORT OF CONTACT"
^DIC(19,5758,0)="FBAA VENDOR LOOKUP^Payment Look-up for Medical Vendor^^R^.5^^^^^^^"
^DIC(19,5758,1,0)="^^2^2^2881014^"
^DIC(19,5758,1,1,0)="This option may be used to look-up payment history for a"
^DIC(19,5758,1,2,0)="selected time frame for a Medical vendor."
^DIC(19,5758,25)="FBAAVLU"
^DIC(19,5758,"U")="PAYMENT LOOK-UP FOR MEDICAL VE"
^DIC(19,5759,0)="FBAA PHARMACY LOOKUP^Pharmacy Vendor Payment Look-Up^^R^.5^^^^^^^"
^DIC(19,5759,1,0)="^^2^2^2881014^"
^DIC(19,5759,1,1,0)="This option may be used to look-up payment history, for a selected time"
^DIC(19,5759,1,2,0)="frame, for a Pharmacy vendor."
^DIC(19,5759,25)="FBAAPLU"
^DIC(19,5759,99)="55626,57128"
^DIC(19,5759,"U")="PHARMACY VENDOR PAYMENT LOOK-U"
^DIC(19,5760,0)="FBAA MEDICAL VOID PAYMENT^Medical Void Payment^^R^1^FBAA LEVEL 2^^^^^^"
^DIC(19,5760,1,0)="^19.06^6^6^3140515^^^^"
^DIC(19,5760,1,1,0)="This option allows a holder of the FBAA LEVEL 2 key to void"
^DIC(19,5760,1,2,0)="a payment that has already been finalized. This option is useful"
^DIC(19,5760,1,3,0)="in the circumstance that a check is returned by a vendor. You can"
^DIC(19,5760,1,4,0)="retain the payment history but flag the payment as void(#)."
^DIC(19,5760,1,5,0)="The dollars for the payment must be added back into"
^DIC(19,5760,1,6,0)="the appropriate obligation using the appropriate IFCAP option."
^DIC(19,5760,25)="FBAAVP"
^DIC(19,5760,"U")="MEDICAL VOID PAYMENT"
^DIC(19,5761,0)="FBAA PHARMACY VOID PAYMENT^Pharmacy Void Payment^^R^1^FBAA LEVEL 2^^^^^^"
^DIC(19,5761,1,0)="^19.06^5^5^3140515^^^^"
^DIC(19,5761,1,1,0)="This option allows a holder of the FBAA Level 2 key to void a"
^DIC(19,5761,1,2,0)="payment to a Pharmacy vendor that has already been Finalized. By"
^DIC(19,5761,1,3,0)="using this option you have the ability to retain the payment history"
^DIC(19,5761,1,4,0)="yet, for some reason, void the payment. The dollar amount must be added"
^DIC(19,5761,1,5,0)="back to the obligation using the appropriate IFCAP option."
^DIC(19,5761,25)="FBAAPHV"
^DIC(19,5761,"U")="PHARMACY VOID PAYMENT"
^DIC(19,5762,0)="FBAA CANCEL MEDICAL VOID^Medical Delete Void Payment^^R^1^FBAA LEVEL 2^^^^^^^^1^1"
^DIC(19,5762,1,0)="^19.06^3^3^3140515^^^^"
^DIC(19,5762,1,1,0)="This option will delete the void flag. The dollar amount for the payment"
^DIC(19,5762,1,2,0)="must be subtracted from the obligation using the appropriate"
^DIC(19,5762,1,3,0)="IFCAP option."
^DIC(19,5762,15)="K FBVOID"
^DIC(19,5762,20)="S FBVOID=1"
^DIC(19,5762,25)="FBAAVP"
^DIC(19,5762,"U")="MEDICAL DELETE VOID PAYMENT"
^DIC(19,5763,0)="FBAA CANCEL PHARMACY VOID^Pharmacy Delete Void Payment^^R^1^FBAA LEVEL 2^^^^^^^^1^1"
^DIC(19,5763,1,0)="^19.06^3^3^3140515^^^"
^DIC(19,5763,1,1,0)="This option will delete the void flag. The dollar amount for the payment"
^DIC(19,5763,1,2,0)="must be subtracted from the obligation using the appropriate"
^DIC(19,5763,1,3,0)="IFCAP obligation."
^DIC(19,5763,15)="K FBVOID"
^DIC(19,5763,20)="S FBVOID=1"
^DIC(19,5763,25)="FBAAPHV"
^DIC(19,5763,"U")="PHARMACY DELETE VOID PAYMENT"
^DIC(19,5764,0)="FBAA CLERK LOOK-UP^Clerk Look-Up For An Authorization^^R^1^FBAASUPERVISOR^^^^^^344^^1^1"
^DIC(19,5764,1,0)="^^4^4^3141125^"
^DIC(19,5764,1,1,0)="This option will list users that entered or edited a specified "
^DIC(19,5764,1,2,0)="authorization in the FEE BASIS PATIENT file.  When applicable the output "
^DIC(19,5764,1,3,0)="will also show users that entered or edited the civil hospital "
^DIC(19,5764,1,4,0)="notification or unauthorized claims associated with the authorization."
^DIC(19,5764,15)="K FBFILE"
^DIC(19,5764,20)="S FBFILE=161.01"
^DIC(19,5764,25)="FBAACLU"
^DIC(19,5764,"U")="CLERK LOOK-UP FOR AN AUTHORIZA"
