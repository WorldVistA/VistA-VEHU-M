^DIC(19,5716,1,0)="^^1^1^2940401^^^^"
^DIC(19,5716,1,1,0)="Checks 2507 REQUEST file (396.3) for missing crucial information."
^DIC(19,5716,25)="DVBCCHKR"
^DIC(19,5716,"U")="CHECK C&P FILE INTEGRITY"
^DIC(19,5717,0)="DVBA C CHECK 2507 INTEGRITY TM^Check C&P File Integrity (TaskMan)^^R^.5^^^^^^^173"
^DIC(19,5717,1,0)="^^1^1^2940401^^"
^DIC(19,5717,1,1,0)="TaskMan version of the 2507 REQUEST integrity checker."
^DIC(19,5717,25)="GO^DVBCCHKR"
^DIC(19,5717,200.9)="y"
^DIC(19,5717,"U")="CHECK C&P FILE INTEGRITY (TASK"
^DIC(19,5718,0)="DVBA C RO AMIS 290^AMIS 290 for the Regional Office^^R^.5^^^^^^^173"
^DIC(19,5718,1,0)="^^1^1^2920828^^^^"
^DIC(19,5718,1,1,0)="This option will give AMIS 290 totals for individual regional offices."
^DIC(19,5718,25)="DVBCAMRO"
^DIC(19,5718,"U")="AMIS 290 FOR THE REGIONAL OFFI"
^DIC(19,5719,0)="DVBA C PRINT WORKSHEETS^Print/Reprint C&P Work Sheets^^R^.5^^^^^^^173"
^DIC(19,5719,1,0)="^^2^2^2930624^^^^"
^DIC(19,5719,1,1,0)="Allows medical center to reprint C&P work sheets on an 'one, many, all'"
^DIC(19,5719,1,2,0)="basis."
^DIC(19,5719,25)="RPRT^DVBCADE1"
^DIC(19,5719,99)="55692,62678"
^DIC(19,5719,"U")="PRINT/REPRINT C&P WORK SHEETS"
^DIC(19,5720,0)="DVBA C TRANSFER C&P REQUEST^Transfer a C&P Request to Another Site^^R^.5^^^^^^^173"
^DIC(19,5720,1,0)="^^2^2^2940712^^^^"
^DIC(19,5720,1,1,0)="Transfers a C&P request to another site.  This option should be used"
^DIC(19,5720,1,2,0)="only when necessary and by persons who are familiar with what it does."
^DIC(19,5720,25)="DVBCXFRA"
^DIC(19,5720,99)="55783,54953"
^DIC(19,5720,"U")="TRANSFER A C&P REQUEST TO ANOT"
^DIC(19,5721,0)="DVBA C MANUAL C&P XFER RETURN^Manual Return of Transferred C&P Requests^^R^.5^^^^^^^173"
^DIC(19,5721,1,0)="^^8^8^2930521^^^^"
^DIC(19,5721,1,1,0)="This option is used to manually return transferred C&P requests.  It should"
^DIC(19,5721,1,2,0)="only be used when the normal return (via the release option) fails."
^DIC(19,5721,1,3,0)=" "
^DIC(19,5721,1,4,0)="When a request is released, the system checks to see if it is a transfer.  "
^DIC(19,5721,1,5,0)="If it is, it will automatically attempt to return it at release time.  "
^DIC(19,5721,1,6,0)="However, due to problems that may arise (user deletion of information, etc)"
^DIC(19,5721,1,7,0)="the return may fail.  In this event the MAS supervisor should repair any"
^DIC(19,5721,1,8,0)="problems and attempt to send it back with this option."
^DIC(19,5721,25)="MANUAL^DVBCXFRE"
^DIC(19,5721,"U")="MANUAL RETURN OF TRANSFERRED C"
^DIC(19,5754,0)="DVBZ MASTER^AMIE V2 MASTER MENU^^M^10652^^^^^^y^175^y"
