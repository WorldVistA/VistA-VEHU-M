^DIC(19,16346,0)="EHM-01167^Reminder Dialog Management^^M^1^^^^^^y^534^n^^^"
^DIC(19,16346,1,0)="^19.06^3^3^3240328^^^^"
^DIC(19,16346,1,1,0)="This menu allows maintenance of the parameters used by CPRS for reminder"
^DIC(19,16346,1,2,0)="dialog processing."
^DIC(19,16346,1,3,0)="Cloned from ""PXRM DIALOG MANAGEMENT"" option."
^DIC(19,16346,3)=""
^DIC(19,16346,10,0)="^19.01IP^3^3"
^DIC(19,16346,10,1,0)="16347^DI^9"
