^DIC(19,13855,0)="PSB PX BCMA2PCE TASK^Immunizations Documentation by BCMA Nightly Task^ Obsolete; Use CPRS Immunization Documentation^R^1^^^^^^^533"
^DIC(19,13855,1,0)="^^16^16^3230525^"
^DIC(19,13855,1,1,0)="This menu option has been marked OUT OF ORDER with patch PSB*3*142 and is "
^DIC(19,13855,1,2,0)="obsolete. Use CPRS Immunization Documentation."
^DIC(19,13855,1,3,0)=" "
^DIC(19,13855,1,4,0)="This option is intended to be scheduled as a nightly task, with a start "
^DIC(19,13855,1,5,0)="time after midnight but before 0800."
^DIC(19,13855,1,6,0)="When the task runs, it will create a record in the V IMMUNIZATIONS file "
^DIC(19,13855,1,7,0)="for each medication administration recorded the previous day for which "
^DIC(19,13855,1,8,0)="there is a mapped association between the PHARMACY ORDERABLE ITEM and an "
^DIC(19,13855,1,9,0)="IMMUNIZATION.  "
^DIC(19,13855,1,10,0)="  "
^DIC(19,13855,1,11,0)="When run interactively, the option will prompt the user for a start date, "
^DIC(19,13855,1,12,0)="allowing a manual backlog of immunization data to be recorded from BCMA "
^DIC(19,13855,1,13,0)="into PCE.  "
^DIC(19,13855,1,14,0)="  "
^DIC(19,13855,1,15,0)="Created by PSS*3*47 as part of Class III to Class I Conversion Project "
^DIC(19,13855,1,16,0)="""Immunizations Documentation by BCMA"""
^DIC(19,13855,25)="TASK^PSBPXLP"
^DIC(19,13855,200.9)="n"
^DIC(19,13855,"U")="IMMUNIZATIONS DOCUMENTATION BY"
^DIC(19,13856,0)="ZVH ADD VITALS^Vitals Entry^^R^10000000020"
^DIC(19,13856,1,0)="^19.06^2^2^3150129^^^"
^DIC(19,13856,1,1,0)="This option will populate vitals for patients.  The Vitals are not "
^DIC(19,13856,1,2,0)="evaluated for proper format.  "
^DIC(19,13856,25)="ZVHGMPOP"
^DIC(19,13856,"U")="VITALS ENTRY"
