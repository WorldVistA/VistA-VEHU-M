^DIC(19,10405,"U")="TIU PARAMETERS MENU"
^DIC(19,10406,0)="TIU REVIEW FILING EVENTS^Review Upload Filing Events^^A^10000000020^^^^^^n^516^^1^1"
^DIC(19,10406,1,0)="^^6^6^3030418^"
^DIC(19,10406,1,1,0)="This option allows the user to generate a list of all upload filing events"
^DIC(19,10406,1,2,0)="(i.e., SUCCESSES, FILING ERRORS, or MISSING FIELD ERRORS) by division,"
^DIC(19,10406,1,3,0)="status (e.g., RESOLVED, UNRESOLVED, or ALL), and by date range. The user"
^DIC(19,10406,1,4,0)="can then act on selected errors to either print the corresponding error"
^DIC(19,10406,1,5,0)="records, or resolve the error (e.g., correct the Patient SSN or Admission"
^DIC(19,10406,1,6,0)="date), and retry the filer.  "
^DIC(19,10406,15)="K TIUEDT,TIULDT"
^DIC(19,10406,20)="K VALMY D EN^VALM(""TIU REVIEW FILING EVENTS"")"
^DIC(19,10406,99)="55431,50702"
^DIC(19,10406,"U")="REVIEW UPLOAD FILING EVENTS"
^DIC(19,10407,0)="TIU PREFERRED DOCUMENT LIST^Document List Management^^A^11712^^^^^^y^516^^1"
^DIC(19,10407,1,0)="^^6^6^2970214^^"
^DIC(19,10407,1,1,0)="Allows individual users to specify which titles they wish to choose"
^DIC(19,10407,1,2,0)="from when asked to select from a given Class of TIU Documents (e.g., when"
^DIC(19,10407,1,3,0)="selecting from the class Progress Notes, I'd like to see the Titles Lipid"
^DIC(19,10407,1,4,0)="Clinic Note, History & Physical, Interservice Transfer Note, and Discharge"
^DIC(19,10407,1,5,0)="Planning, in that order). Also allows the user to specify a default title"
^DIC(19,10407,1,6,0)="for the selected Class."
^DIC(19,10407,20)="D MAIN^TIUPLST"
^DIC(19,10407,"U")="DOCUMENT LIST MANAGEMENT"
^DIC(19,10408,0)="TIU PERSONAL PREFERENCE MENU^Personal Preferences^^M^11712^^^^^^^516"
^DIC(19,10408,1,0)="^^6^6^2961101^^^^"
^DIC(19,10408,1,1,0)="This menu allows users to enter either their preferences with respect to"
^DIC(19,10408,1,2,0)="the behavior of the TIU Package (e.g., DEFAULT LOCATION, REVIEW SCREEN"
^DIC(19,10408,1,3,0)="SORT FIELD and SORT ORDER, DISPLAY MENUS, PATIENT SELECTION PREFERENCE,"
^DIC(19,10408,1,4,0)="etc.), or to specify their ""pick lists"" for document selection when"
^DIC(19,10408,1,5,0)="composing or editing documents (e.g., when choosing from the document"
^DIC(19,10408,1,6,0)="class Progress Notes, let me see these three specific titles, etc.)."
^DIC(19,10408,10,0)="^19.01IP^2^2"
^DIC(19,10408,10,1,0)="10407^2^2"
^DIC(19,10408,10,2,0)="10409^1^1"
