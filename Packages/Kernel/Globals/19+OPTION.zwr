^DIC(19,11296,1,1,0)="This option reviews call information using reports.  Reports"
^DIC(19,11296,1,2,0)="consist of a list (a collection of calls), a sort (optional), and a"
^DIC(19,11296,1,3,0)="format (a collection of fields to be presented or a special report"
^DIC(19,11296,1,4,0)="program)."
