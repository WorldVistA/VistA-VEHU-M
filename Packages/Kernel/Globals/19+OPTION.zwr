^DIC(19,9018,"U")="KERNEL INSTALLATION & DISTRIBU"
^DIC(19,9019,0)="XPD BUILD NAMESPACE^Create a Build Using Namespace^^R^1039^^^^^^^^^"
^DIC(19,9019,1,0)="^^2^2^2940601^^^^"
^DIC(19,9019,1,1,0)="This option creates a new entry in the Build file, and populates the entry"
^DIC(19,9019,1,2,0)="using a namespace. "
^DIC(19,9019,20)=""
^DIC(19,9019,25)="BUILD^XPDE"
^DIC(19,9019,"U")="CREATE A BUILD USING NAMESPACE"
^DIC(19,9020,0)="XPD COPY BUILD^Copy Build to Build^^R^1039^^^^^^^^^"
^DIC(19,9020,1,0)="^^1^1^2940601^^^"
^DIC(19,9020,1,1,0)="This option copies one entry in the Build file to another."
^DIC(19,9020,20)=""
^DIC(19,9020,25)="COPY^XPDE"
^DIC(19,9020,"U")="COPY BUILD TO BUILD"
^DIC(19,9021,0)="XPD VERIFY BUILD^Verify a Build^^R^1039^^^^^^^"
^DIC(19,9021,1,0)="^^3^3^2940601^^^^"
^DIC(19,9021,1,1,0)="This option verifies the contents of a build.  It checks that every"
^DIC(19,9021,1,2,0)="component that is listed in the build still exists on your system.  You"
^DIC(19,9021,1,3,0)="should use it before you export a package. "
^DIC(19,9021,25)="VER^XPDE"
^DIC(19,9021,"U")="VERIFY A BUILD"
^DIC(19,9022,0)="XPD PRINT BUILD^Build File Print^^R^1039^^^^^^^"
^DIC(19,9022,1,0)="^^1^1^2940601^^^^"
^DIC(19,9022,1,1,0)="This option prints the contents of an entry in the Build File."
^DIC(19,9022,25)="EN1^XPDDP"
^DIC(19,9022,"U")="BUILD FILE PRINT"
^DIC(19,9023,0)="XPD TRANSPORT PACKAGE^Transport a Distribution^^R^1039^^^^^^^"
^DIC(19,9023,1,0)="^^5^5^2950130^^^^"
^DIC(19,9023,1,1,0)="This option uses entries in the Build file to create a Transport Global to "
^DIC(19,9023,1,2,0)="export packages.  If you choose an HFS file as an output device, the"
^DIC(19,9023,1,3,0)="Transport Global is written to the HFS file, creating a distribution.  If"
^DIC(19,9023,1,4,0)="you don't choose a device, the Transport Global is written to the ^XTMP"
^DIC(19,9023,1,5,0)="global on your system. "
^DIC(19,9023,25)="XPDT"
^DIC(19,9023,"U")="TRANSPORT A DISTRIBUTION"
^DIC(19,9024,0)="XPD LOAD DISTRIBUTION^Load a Distribution^^R^10652^^^^^^^453"
^DIC(19,9024,1,0)="^^2^2^2950130^^^^"
^DIC(19,9024,1,1,0)="This option loads a KIDS Distribution. A Distribution is an HFS file that"
^DIC(19,9024,1,2,0)="contains one or more Transport Globals. "
^DIC(19,9024,25)="EN1^XPDIL"
^DIC(19,9024,"U")="LOAD A DISTRIBUTION"
^DIC(19,9025,0)="XPD RESTART INSTALL^Restart Install of Package(s)^^R^10652^^^^^^^453"
^DIC(19,9025,1,0)="^^2^2^2950202^^^^"
^DIC(19,9025,1,1,0)="This option restarts the install process for Packages in a Transport"
^DIC(19,9025,1,2,0)="Global."
^DIC(19,9025,25)="EN^XPDIR"
^DIC(19,9025,"U")="RESTART INSTALL OF PACKAGE(S)"
^DIC(19,9026,0)="XPD ROUTINE UPDATE^Update Routine File^^R^10000000020^^^^^^^"
^DIC(19,9026,1,0)="^^6^6^3060509^"
^DIC(19,9026,1,1,0)="This option lets you update the Routine File by adding existing routine"
^DIC(19,9026,1,2,0)="names from the current system.  You enter the namespaces of routines to"
^DIC(19,9026,1,3,0)="update the routine file with, and namespaces to exclude from the updating. "
^DIC(19,9026,1,4,0)="In addition, if you ask it to, this option goes through the Routine File"
^DIC(19,9026,1,5,0)="and deletes any local routine names that no longer exist on the system."
^DIC(19,9026,1,6,0)="Any routine listed as national will not be removed from the file."
^DIC(19,9026,25)="UPDT^XPDR"
^DIC(19,9026,"U")="UPDATE ROUTINE FILE"
^DIC(19,9027,0)="XU USER TERMINATE^User terminate event^^X^10000000020^^^^^^^163^y^1^^^"
^DIC(19,9027,1,0)="^^10^10^3030320^"
^DIC(19,9027,1,1,0)="This is a protocol to link other packages that want to know about"
^DIC(19,9027,1,2,0)="a USER TERMINATE event. Other pachages can attach to this protocol option"
^DIC(19,9027,1,3,0)="and they will be called when a USER is Terminated. The call will be just "
^DIC(19,9027,1,4,0)="after the users Access and Verify codes have been removed."
^DIC(19,9027,1,5,0)="DUZ will be the person that is running the terminate option.  "
^DIC(19,9027,1,6,0)="XUIFN will point to the NEW PERSON file entry that is being terminated."
^DIC(19,9027,1,7,0)="Returns selected file 200 data to XUSR(field name) array for New Person"
^DIC(19,9027,1,8,0)="components."
^DIC(19,9027,1,9,0)=" "
^DIC(19,9027,1,10,0)="It is called in XUSTERM from XUSERP."
^DIC(19,9027,10,0)="^19.01IP^9^8"
^DIC(19,9027,10,1,0)=10713
^DIC(19,9027,10,2,0)=11526
