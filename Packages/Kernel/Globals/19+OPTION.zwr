^DIC(19,16289,0)="EHM-01110^Immunization List^^P^1^^^^^^y^^^1^^"
^DIC(19,16289,1,0)="^^6^6^3240328^^"
^DIC(19,16289,1,1,0)="This option lists all immunizations, with their Active Status, which have"
^DIC(19,16289,1,2,0)="been defined in the Immunization file for use with PCE."
^DIC(19,16289,1,3,0)=" "
