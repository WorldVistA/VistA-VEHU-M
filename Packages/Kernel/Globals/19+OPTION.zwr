^DIC(19,5611,0)="PRCT STATUS OF DATA^Status Of Data^^A^11740^^^^^^^^^1"
^DIC(19,5611,1,0)="^^28^28^2910321^^^^"
^DIC(19,5611,1,1,0)="This option will print the status of data that is being uploaded"
^DIC(19,5611,1,2,0)="or has been uploaded from barcode readers.  The following are status"
^DIC(19,5611,1,3,0)="codes that are used as progress reports."
^DIC(19,5611,1,4,0)=" "
^DIC(19,5611,1,5,0)="o ATTEMPTING DATA UPLOAD          - User is currently uploading data"
^DIC(19,5611,1,6,0)="o DATA UPLOAD FAILURE             - Data upload has failed"
^DIC(19,5611,1,7,0)="o DATA UPLOAD SUCCESSFUL          - Data has successfully uploaded"
^DIC(19,5611,1,8,0)="o TASKED FOR JUL 07,1989@14:50    - Data will be processed at specified time"
^DIC(19,5611,1,9,0)="o DEVICE NOT SELECTED             - User has not selected a device for processing"
^DIC(19,5611,1,10,0)="o RUN FAIL, RTN FLD IS MISSING    - Routine is not defined (446.4,.04)"
^DIC(19,5611,1,11,0)="o RUN FAIL, RTN IS MISSING        - Routine (446.4,.04) is not on system"
^DIC(19,5611,1,12,0)="o STARTED AT JUL 07,1989@14:52    - Data has started processing at specified time"
^DIC(19,5611,1,13,0)="o FINISHED ON JUL 07,1989@15:31   - Data finished processing at specified time"
^DIC(19,5611,1,14,0)=" "
^DIC(19,5611,1,15,0)="The above status give the ability to view the progress of data from the"
^DIC(19,5611,1,16,0)="point of when it was uploaded from the barcode reader to the time it has"
^DIC(19,5611,1,17,0)="been processed.  Certain status are errors, such as RUN FAIL, DEVICE NOT"
^DIC(19,5611,1,18,0)="SELECTED and these mean the data will never be processed because of an"
^DIC(19,5611,1,19,0)="unexpected error in the process."
^DIC(19,5611,1,20,0)=" "
^DIC(19,5611,1,21,0)="The normal progression of status that data will take is:"
^DIC(19,5611,1,22,0)=" "
^DIC(19,5611,1,23,0)="  1) ATTEMPTING DATA UPLOAD"
^DIC(19,5611,1,24,0)="  2) DATA UPLOAD SUCCESSFUL"
^DIC(19,5611,1,25,0)="  3) TASKED FOR [date/time]"
^DIC(19,5611,1,26,0)="  4) STARTED AT [date/time]"
^DIC(19,5611,1,27,0)="  5) FINISHED ON [date/time]"
^DIC(19,5611,1,28,0)=" "
^DIC(19,5611,20)="S DIC=""^PRCT(446.4,"",BY=""[PRCT DATA UPLOAD STATUS]"",FLDS=BY,L=0 D EN1^DIP K %DT,DP"
^DIC(19,5611,"U")="STATUS OF DATA"
^DIC(19,5612,0)="PRCT SCHEDULE DATA TO PROCESS^Schedule Data To Process^^R^11740^^^^^^^"
