^DIC(19,13847,0)="ECX ECS VOL^Event Capture Pre-Extract Unusual Volume Report^^R^11720^^^^^^^"
^DIC(19,13847,1,0)="^^8^8^3170531^"
^DIC(19,13847,1,1,0)="This report prints a listing of unusual volumes that would be generated "
^DIC(19,13847,1,2,0)="by the Event Capture (ECS) extract as determined by a user-defined "
^DIC(19,13847,1,3,0)="threshold value. It should be run prior to the generation of an actual "
^DIC(19,13847,1,4,0)="extract to identify and fix, as necessary, any volumes determined to be "
^DIC(19,13847,1,5,0)="erroneous."
^DIC(19,13847,1,6,0)=" "
^DIC(19,13847,1,7,0)="Unusual volumes are those in excess of the thresold value defined by the "
^DIC(19,13847,1,8,0)="user. The threshold value is 20 by default."
^DIC(19,13847,25)="EN^ECXUEC"
^DIC(19,13847,"U")="EVENT CAPTURE PRE-EXTRACT UNUS"
