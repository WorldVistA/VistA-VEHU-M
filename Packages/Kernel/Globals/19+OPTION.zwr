^DIC(19,3133,1,1,0)="This option allows the supervisor to print a report outlining the"
^DIC(19,3133,1,2,0)="number of transactions posted, by clerk, for a period specified."
^DIC(19,3133,25)="CLERK^PRPFPNT"
^DIC(19,3133,200.9)="n"
^DIC(19,3133,"U")="PRODUCTIVITY REPORT"
