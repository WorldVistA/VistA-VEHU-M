^DIC(19,3281,0)="A3FSTIN^Enter/Edit FSMB Requests^^R^.5^^^^^^^"
^DIC(19,3281,1,0)="^^6^6^2890403^"
^DIC(19,3281,1,1,0)="This option allows the VAMC user to enter applicants into the"
^DIC(19,3281,1,2,0)="FSMB file for processing.  The user is asked for applicant name,"
^DIC(19,3281,1,3,0)="date of birth, social security number, medical school attended,"
^DIC(19,3281,1,4,0)="and year of graduation.  Based on the date that the user enters"
^DIC(19,3281,1,5,0)="this data, the request will be assigned a ""batch"" number.  Batches"
^DIC(19,3281,1,6,0)="will be submitted to FSMB, and results reported back to the station."
^DIC(19,3281,25)="A3FSTIN1"
^DIC(19,3281,"U")="ENTER/EDIT FSMB REQUESTS"
