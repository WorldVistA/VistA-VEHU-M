^DIC(19,14403,"U")="PATIENT APPOINTMENTS"
^DIC(19,14404,0)="HMP APPLICATION PROXY^HMP Application Proxy^^B^1^^^^^^^"
^DIC(19,14404,1,0)="^19.06^1^1^3110602^^^^"
^DIC(19,14404,1,1,0)="This option allows the HMP connector proxy access to the VistA system."
^DIC(19,14404,99.1)="62971,33865"
^DIC(19,14404,"RPC",0)="^19.05P^4^4"
^DIC(19,14404,"RPC",2,0)=3521
^DIC(19,14404,"RPC",3,0)=3515
^DIC(19,14404,"RPC",4,0)=3533
