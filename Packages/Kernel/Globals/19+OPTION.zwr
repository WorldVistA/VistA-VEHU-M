^DIC(19,14944,0)="LEX CSV VSE QUERY^VA EXT SNOMED CT Code Query^^R^1^^^^^^^^^1^1"
^DIC(19,14944,1,0)="^19.06^4^4^3210329^^"
^DIC(19,14944,1,1,0)="This option displays a single VA Extension SNOMED CT code from the "
^DIC(19,14944,1,2,0)="Lexicon with the status, effective dates, concept, preferred term, fully "
^DIC(19,14944,1,3,0)="specified term and synonyms based on a date provided by the user.  The "
^DIC(19,14944,1,4,0)="date may be a future date."
^DIC(19,14944,15)="K ^TMP(""LEXQVSEO"",$J)"
^DIC(19,14944,20)="K ^TMP(""LEXQVSEO"",$J)"
^DIC(19,14944,25)="EN^LEXQVSE"
^DIC(19,14944,"U")="VA EXT SNOMED CT CODE QUERY"
^DIC(19,14945,0)="OR UNFLAGGING KEY SETUP^Order Unflagging Key Setup^^A^1^^^^^^^170^^1"
^DIC(19,14945,1,0)="^^3^3^3210303^"
^DIC(19,14945,1,1,0)="This option provides the ability to perform the unflagging action by "
^DIC(19,14945,1,2,0)="'Display Groups'. Each display group can specify what key (example ORELSE,"
^DIC(19,14945,1,3,0)="OREMAS, etc.) can do the unflagging in CPRS."
^DIC(19,14945,20)="S DIC=""^ORD(100.98,"",DIC(0)=""AEMQ"" D ^DIC K DIC Q:Y=-1  S DA=+Y,DR=""1:5"",DIE=""^ORD(100.98,"" D ^DIE"
^DIC(19,14945,"U")="ORDER UNFLAGGING KEY SETUP"
^DIC(19,14946,0)="OR UNFLAGGING RESTRICTIONS^Order Unflagging Restrictions^^A^1^^^^^^^^^1"
^DIC(19,14946,1,0)="^19.06^5^5^3210219^^"
^DIC(19,14946,1,1,0)="This option can be used to setup the OR UNFLAGGING RESTRICTIONS parameter."
^DIC(19,14946,1,2,0)="This parameter is for the CPRS GUI application to enable/disable "
^DIC(19,14946,1,3,0)="unflagging restrictions on flagged orders. It's marked enabled"
^DIC(19,14946,1,4,0)="at the Package level. The sites can disable it at System level or at"
^DIC(19,14946,1,5,0)="Division level."
^DIC(19,14946,10.1)="OR Unflagging Restrictions"
^DIC(19,14946,20)="D EDITPAR^XPAREDIT(""OR UNFLAGGING RESTRICTIONS"")"
^DIC(19,14946,25)=""
^DIC(19,14946,"U")="ORDER UNFLAGGING RESTRICTIONS"
^DIC(19,14947,0)="OR UNFLAGGING MESSAGE^Order Unflagging Message^^A^1^^^^^^^^^1"
^DIC(19,14947,1,0)="^19.06^6^6^3210219^^"
^DIC(19,14947,1,1,0)="This option can be used to setup the OR UNFLAGGING MESSAGE parameter.  "
^DIC(19,14947,1,2,0)="This parameter is for the CPRS GUI application to setup a customized"
^DIC(19,14947,1,3,0)="message to display to users who do not have the proper security key to"
^DIC(19,14947,1,4,0)="unflag an order. At the Package level, it's set to ""You are not allowed to"
^DIC(19,14947,1,5,0)="un-flag this order based on your security keys and the order type."""
^DIC(19,14947,1,6,0)="Sites can customize this message at System level or at Division level."
^DIC(19,14947,20)="D EDITPAR^XPAREDIT(""OR UNFLAGGING MESSAGE"")"
^DIC(19,14947,"U")="ORDER UNFLAGGING MESSAGE"
^DIC(19,14948,0)="OR FLAG/UNFLAG SETUP^GUI Order Flagging/Unflagging Setup^^M^1^^^^^^^"
^DIC(19,14948,1,0)="^19.06^2^2^3210303^^"
^DIC(19,14948,1,1,0)="This menu contains the options needed to manage the Flagging/Unflagging"
^DIC(19,14948,1,2,0)="functionalities in CPRS."
^DIC(19,14948,10,0)="^19.01IP^4^4"
