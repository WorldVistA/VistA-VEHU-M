^DIC(19,14879,0)="PSO MEDICATION STATUS CHECK^Medication Status Check^^R^1^^^^^^y^141^^^1"
^DIC(19,14879,1,0)="^^17^17^3200117^"
^DIC(19,14879,1,1,0)="This option searches for: (1) discontinued and expired medication orders"
^DIC(19,14879,1,2,0)="which are still active in the ORDERS (#100) file; and (2) discontinued or"
^DIC(19,14879,1,3,0)="expired orders in the ORDERS (#100) file which are not discontinued or"
^DIC(19,14879,1,4,0)="expired in the corresponding medication file."
^DIC(19,14879,1,5,0)=" "
^DIC(19,14879,1,6,0)="This option is tasked after the user specifies the search criteria "
^DIC(19,14879,1,7,0)="consisting of a date range, type(s) of medication orders to evaluate, and "
^DIC(19,14879,1,8,0)="whether erroneously active statuses in the ORDERS (#100) file should be "
^DIC(19,14879,1,9,0)="corrected to match the status in the associated medication file."
^DIC(19,14879,1,10,0)=" "
^DIC(19,14879,1,11,0)="The date range pertains to the original order date of the order as well "
^DIC(19,14879,1,12,0)="as some (not all) activity dates on the order. (Any activity which sets a "
^DIC(19,14879,1,13,0)="date/time subscript into the ""AF"" cross reference of the ORDERS (#100) "
^DIC(19,14879,1,14,0)="file will be included in the date range search.)"
^DIC(19,14879,1,15,0)=" "
^DIC(19,14879,1,16,0)="After completion, an alert and MailMan message are sent to the user who "
^DIC(19,14879,1,17,0)="invoked the option."
^DIC(19,14879,10.1)=""
^DIC(19,14879,15)="K ^TMP(""PSOQUIT"",$J)"
^DIC(19,14879,25)="EN^PSOUTOR"
^DIC(19,14879,"U")="MEDICATION STATUS CHECK"
^DIC(19,14880,0)="SDEC HELP PANE EDIT (LOCAL)^VS GUI Help Pane Edit^^E^1^SDEC HELP^^^^^^16^^^^"
