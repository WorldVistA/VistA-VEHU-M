^DIC(19,16140,99)="67411,49176"
^DIC(19,16140,"U")="PRINT HEALTH SUMMARY MENU"
^DIC(19,16141,0)="EHM-00962^Patient Health Summary^^R^1^^^^^^^160^^1^^"
^DIC(19,16141,1,0)="^^3^3^3240328^^^^"
^DIC(19,16141,1,1,0)="Generates a Health Summary of a specified pre-defined Health Summary Type"
^DIC(19,16141,1,2,0)="for a specified patient."
^DIC(19,16141,1,3,0)="Cloned from ""GMTS HS BY PATIENT"" option."
^DIC(19,16141,2)="y"
^DIC(19,16141,3)=""
^DIC(19,16141,20)="K ORVP"
^DIC(19,16141,25)="GMTS"
^DIC(19,16141,72)="W @IOF"
^DIC(19,16141,99)="54858,49206"
^DIC(19,16141,"U")="PATIENT HEALTH SUMMARY"
^DIC(19,16142,0)="EHM-00963^Hospital Location Health Summary^^R^1^^^^^n^^160^^^^"
^DIC(19,16142,1,0)="^^5^5^3240328^"
^DIC(19,16142,1,1,0)="Allows user to print health summaries interactively for all patients on a"
^DIC(19,16142,1,2,0)="specified ward(s), for all patients with appointments at a specified"
^DIC(19,16142,1,3,0)="outpatient clinic(s), or for all patients scheduled for a specified"
^DIC(19,16142,1,4,0)="operating room(s) on a selected day or range of days."
^DIC(19,16142,1,5,0)="Cloned from ""GMTS HS BY LOC"" option."
^DIC(19,16142,2)="y"
^DIC(19,16142,3)=""
^DIC(19,16142,25)="MAIN^GMTSPD"
^DIC(19,16142,99)="55425,54053"
^DIC(19,16142,"U")="HOSPITAL LOCATION HEALTH SUMMA"
^DIC(19,16143,0)="EHM-00964^Ad Hoc Health Summary^^R^1^^^^^^^160^^1^^"
^DIC(19,16143,1,0)="^^6^6^3240328^"
^DIC(19,16143,1,1,0)="Generates an 'Ad Hoc' Health Summary for specified patients. Instead of"
^DIC(19,16143,1,2,0)="selecting a pre-defined Health Summary Type, the user defines his own ad"
^DIC(19,16143,1,3,0)="hoc Health Summary structure for temporary use while using this option."
^DIC(19,16143,1,4,0)="The user selects Health Summary components, time and occurrence limits"
^DIC(19,16143,1,5,0)="when applicable, and selection items when applicable."
^DIC(19,16143,1,6,0)="Cloned from ""GMTS HS ADHOC"" option."
^DIC(19,16143,3)=""
^DIC(19,16143,20)="K ORVP"
^DIC(19,16143,25)="GMTSADH"
^DIC(19,16143,99)="55626,36491"
^DIC(19,16143,"U")="AD HOC HEALTH SUMMARY"
^DIC(19,16144,0)="EHM-00965^Visit Patient Health Summary^^R^1^^^^^^^160^^1^1^"
^DIC(19,16144,1,0)="^^9^9^3240328^^"
^DIC(19,16144,1,1,0)="Generates Health Summaries of a specified pre-defined Health Summary Type"
^DIC(19,16144,1,2,0)="for multiple patients. After a patient is selected, the user can pick an"
^DIC(19,16144,1,3,0)="outpatient visit (based on the VISIT File) or an inpatient hospital"
^DIC(19,16144,1,4,0)="admission (based on the Patient Movement file). If the Patient Care"
^DIC(19,16144,1,5,0)="Encounter (PCE) package isn't installed then the user can only choose an"
^DIC(19,16144,1,6,0)="inpatient visit. Data for summaries is based on a date range from the"
^DIC(19,16144,1,7,0)="outpatient visit or inpatient admission. This Date Range overrides Time"
^DIC(19,16144,1,8,0)="Limits for components which allows this option."
^DIC(19,16144,1,9,0)="Cloned from ""GMTS HS BY PATIENT & VISIT"" option."
^DIC(19,16144,3)=""
^DIC(19,16144,15)="K GMTSPXGO"
^DIC(19,16144,20)="K ORVP S GMTSPXGO=1"
^DIC(19,16144,25)="GMTS"
^DIC(19,16144,"U")="VISIT PATIENT HEALTH SUMMARY"
^DIC(19,16145,0)="EHM-00966^Batch Print of All Clinics by Visit Date^^R^1^^^^^^^160^^^^"
^DIC(19,16145,1,0)="^^9^9^3240328^"
^DIC(19,16145,1,1,0)="Allows user to interactively designate the batch print of all health"
^DIC(19,16145,1,2,0)="summaries for patients with appointments at all outpatient clinics on a"
^DIC(19,16145,1,3,0)="selected day. Summaries will be printed at the print device designated for"
^DIC(19,16145,1,4,0)="that clinic in the Location Parameters. This option is an alternate method"
^DIC(19,16145,1,5,0)="to designate when summaries should be printed for all clinics. The nightly"
^DIC(19,16145,1,6,0)="batch job that prints summaries for wards, clinics and operating rooms"
^DIC(19,16145,1,7,0)="probably should be disable if the user wants to uses this option on a"
^DIC(19,16145,1,8,0)="daily basis."
^DIC(19,16145,1,9,0)="Cloned from ""GMTS HS FOR ALL CLINICS"" option."
^DIC(19,16145,3)=""
^DIC(19,16145,25)="MAIN^GMTSPCD"
^DIC(19,16145,"U")="BATCH PRINT OF ALL CLINICS BY "
^DIC(19,16146,0)="EHM-00967^Range of Dates Patient Health Summary^^R^1^^^^^^^160^^1^1^"
^DIC(19,16146,1,0)="^^6^6^3240328^^^^"
^DIC(19,16146,1,1,0)="Generates Health Summaries of a specified pre-defined Health"
^DIC(19,16146,1,2,0)="Summary Type for multiple patients. After patients are selected."
^DIC(19,16146,1,3,0)="the user can pick a date range. Data for summaries is based on"
^DIC(19,16146,1,4,0)="the date range. This date range overrides Time Limits for"
^DIC(19,16146,1,5,0)="components which allow this option."
^DIC(19,16146,1,6,0)="Cloned from ""GMTS HS BY PATIENT & DATE RANG"" option."
^DIC(19,16146,3)=""
^DIC(19,16146,15)="K GMRANGE"
^DIC(19,16146,20)="K ORVP S GMRANGE=1"
^DIC(19,16146,25)="GMTS"
^DIC(19,16146,"U")="RANGE OF DATES PATIENT HEALTH "
^DIC(19,16147,0)="EHM-00968^Set-up Batch Print Locations^^R^1^^^^^^^160^^^^"
^DIC(19,16147,1,0)="^^16^16^3240328^"
^DIC(19,16147,1,1,0)="Allows the user to set-up Health Summary Types to be batch printed nightly"
^DIC(19,16147,1,2,0)="for all patients at a specified hospital location."
^DIC(19,16147,1,3,0)=" "
^DIC(19,16147,1,4,0)="Location may be a ward or a clinic. If location is a clinic, the user is"
^DIC(19,16147,1,5,0)="asked to specify 'Print Days Ahead.' Health Summaries will then be printed"
^DIC(19,16147,1,6,0)="for all patients with appointments that many days in the future."
^DIC(19,16147,1,7,0)=" "
^DIC(19,16147,1,8,0)="To generate summaries, this option requires that option GMTS TASK STARTUP"
^DIC(19,16147,1,9,0)="be queued to run nightly.  Summaries should then be printed during the"
^DIC(19,16147,1,10,0)="night and be ready for distribution by early morning. Thus, 0 Print Days"
^DIC(19,16147,1,11,0)="Ahead means summaries should be ready to distribute by early morning of"
^DIC(19,16147,1,12,0)="day of clinic appointment."
^DIC(19,16147,1,13,0)=" "
^DIC(19,16147,1,14,0)="For ease in separating printouts queued to the same device, a location"
^DIC(19,16147,1,15,0)="banner appears in front of each locations Health Summaries."
^DIC(19,16147,1,16,0)="Cloned from ""GMTS HS BY LOC PARAMETERS"" option."
^DIC(19,16147,3)=""
^DIC(19,16147,25)="GMTSPP"
^DIC(19,16147,99)="55689,37491"
^DIC(19,16147,"U")="SET-UP BATCH PRINT LOCATIONS"
^DIC(19,16148,0)="EHM-00969^List Batch Health Summary Locations^^P^1^^^^^^y^^^^^"
^DIC(19,16148,1,0)="^^4^4^3240328^"
^DIC(19,16148,1,1,0)="This option displays a list of all locations which will be checked to see"
^DIC(19,16148,1,2,0)="if health summaries should be printed in the nightly run of GMTS TASK"
^DIC(19,16148,1,3,0)="STARTUP."
^DIC(19,16148,1,4,0)="Cloned from ""GMTS TASK LOCATIONS LIST"" option."
^DIC(19,16148,3)=""
^DIC(19,16148,60)="GMT(142,"
^DIC(19,16148,62)=0
^DIC(19,16148,63)="[GMTS TASK LOCATIONS LIST]"
^DIC(19,16148,64)="[GMTS TASK LOCATIONS SORT]"
^DIC(19,16148,65)="A"
^DIC(19,16148,66)="zzz"
^DIC(19,16148,73)=""
^DIC(19,16148,"U")="LIST BATCH HEALTH SUMMARY LOCA"
^DIC(19,16149,0)="EHM-00970^CPRS Reports Tab 'Health Summary Types List' Menu^^M^1^^^^^^^^^^^"
^DIC(19,16149,1,0)="^^5^5^3240328^"
^DIC(19,16149,1,1,0)="Use the options in the CPRS Reports Tab Health Summary Types List"
^DIC(19,16149,1,2,0)="Menu to select the Health Summary Types to list on the Reports Tab,"
^DIC(19,16149,1,3,0)="arrange the order of these Health Summaries on the list, and to "
^DIC(19,16149,1,4,0)="view the user s preferences."
^DIC(19,16149,1,5,0)="Cloned from ""GMTS GUI REPORTS LIST MENU"" option."
^DIC(19,16149,3)=""
^DIC(19,16149,10,0)="^19.01IP^4^4"
^DIC(19,16149,10,1,0)="16150^1^1"
^DIC(19,16149,10,2,0)="16151^2^2"
^DIC(19,16149,10,3,0)="16152^3^3"
^DIC(19,16149,10,4,0)="16153^4^4"
^DIC(19,16149,10,"B",16150,1)=""
^DIC(19,16149,10,"B",16151,2)=""
^DIC(19,16149,10,"B",16152,3)=""
^DIC(19,16149,10,"B",16153,4)=""
^DIC(19,16149,10,"C",1,1)=""
^DIC(19,16149,10,"C",2,2)=""
^DIC(19,16149,10,"C",3,3)=""
^DIC(19,16149,10,"C",4,4)=""
^DIC(19,16149,99)="67411,49176"
^DIC(19,16149,99.1)="59171,34704"
^DIC(19,16149,"U")="CPRS REPORTS TAB 'HEALTH SUMMA"
^DIC(19,16150,0)="EHM-00971^Display 'Health Summary Types List' Defaults^^R^1^^^^^^^^^^^"
^DIC(19,16150,1,0)="^19.06^6^6^3240328^^^^"
^DIC(19,16150,1,1,0)="Use this option to display the list of Health Summary Types that "
^DIC(19,16150,1,2,0)="will be contained in the 'Health Summary Types' section on the "
^DIC(19,16150,1,3,0)="Reports Tab in CPRS.  The display includes the precedence of "
^DIC(19,16150,1,4,0)="parameters, the method for building the list, and finally the list"
^DIC(19,16150,1,5,0)="that will actually appear on the Reports Tab in CPRS."
^DIC(19,16150,1,6,0)="Cloned from ""GMTS GUI HS LIST DEFAULTS"" option."
^DIC(19,16150,3)=""
^DIC(19,16150,25)="DISP^GMTSXA"
^DIC(19,16150,"U")="DISPLAY 'HEALTH SUMMARY TYPES "
^DIC(19,16151,0)="EHM-00972^Precedence of 'Health Summary Types List'^^R^1^^^^^^^^^^^"
^DIC(19,16151,1,0)="^^18^18^3240328^"
^DIC(19,16151,1,1,0)="Use this option to select the defined Health Summary Types to include"
^DIC(19,16151,1,2,0)="on the list and arrange them in the order (precedence) that they "
^DIC(19,16151,1,3,0)="should appear on the list.  The three most common groups of Health "
^DIC(19,16151,1,4,0)="Summary Types are:"
^DIC(19,16151,1,5,0)=""
^DIC(19,16151,1,6,0)=" SYS  Health Summary Types may be defined for all users on the system."
^DIC(19,16151,1,7,0)=""
^DIC(19,16151,1,8,0)=" USR  Health Summary Types may be defined for a single user on the"
^DIC(19,16151,1,9,0)="      system."
^DIC(19,16151,1,10,0)=""
^DIC(19,16151,1,11,0)=" NAT  Nationally exported Health Summary Types (NAT) defined for "
^DIC(19,16151,1,12,0)="      system users or a single user are treated independently to"
^DIC(19,16151,1,13,0)="      keep them together in the list box."
^DIC(19,16151,1,14,0)=""
^DIC(19,16151,1,15,0)="In this option, you must first select those Health Summary Type groups"
^DIC(19,16151,1,16,0)="(SYS, USR, NAT, etc.) to include on the Reports Tab, then specify the"
^DIC(19,16151,1,17,0)="order in which they will appear on the Reports Tab."
^DIC(19,16151,1,18,0)="Cloned from ""GMTS GUI HS LIST PRECEDENCE"" option."
^DIC(19,16151,3)=""
^DIC(19,16151,25)="PREC^GMTSXA"
^DIC(19,16151,"U")="PRECEDENCE OF 'HEALTH SUMMARY "
^DIC(19,16152,0)="EHM-00973^Method of compiling 'Health Summary Types List'^^R^1^^^^^^^^^^^"
^DIC(19,16152,1,0)="^19.06^14^14^3240328^^^"
^DIC(19,16152,1,1,0)="Use this option to edit the method used to build the list of Health"
^DIC(19,16152,1,2,0)="Summary Types displayed on the Reports Tab in CPRS.  There are 2 "
^DIC(19,16152,1,3,0)="methods:"
^DIC(19,16152,1,4,0)=""
^DIC(19,16152,1,5,0)="   Overwrite   System-defined Health Summary Types are added "
^DIC(19,16152,1,6,0)="               to the list.  If there are User-defined Health"
^DIC(19,16152,1,7,0)="               Summary Types, then they will replace the System"
^DIC(19,16152,1,8,0)="               defined Health Summary Types already on the list."
^DIC(19,16152,1,9,0)=""
^DIC(19,16152,1,10,0)="   Append      System-defined Health Summary Types are added to"
^DIC(19,16152,1,11,0)="               the list.  If there are User-defined Health Summary"
^DIC(19,16152,1,12,0)="               Types, then they will added to the list along with "
^DIC(19,16152,1,13,0)="               the System-defined types."
^DIC(19,16152,1,14,0)="Cloned from ""GMTS GUI HS LIST METHOD"" option."
^DIC(19,16152,3)=""
^DIC(19,16152,25)="METH^GMTSXA"
^DIC(19,16152,"U")="METHOD OF COMPILING 'HEALTH SU"
^DIC(19,16153,0)="EHM-00974^Edit 'Health Summary Types List' Parameters^^R^1^^^^^^^^^^^"
^DIC(19,16153,1,0)="^^5^5^3240328^"
^DIC(19,16153,1,1,0)="Use this option to add, edit or delete a Health Summary Type from"
^DIC(19,16153,1,2,0)="the list of Health Summary Types defined by the user.  If you are "
^DIC(19,16153,1,3,0)="a holder of the GMTSMGR Key, you can also use this option to edit"
^DIC(19,16153,1,4,0)="the Health Summary Types defined for the System."
^DIC(19,16153,1,5,0)="Cloned from ""GMTS GUI HS LIST PARAMETERS"" option."
^DIC(19,16153,3)=""
^DIC(19,16153,25)="EDIT^GMTSXA"
^DIC(19,16153,"U")="EDIT 'HEALTH SUMMARY TYPES LIS"
^DIC(19,16154,0)="EHM-00975^Health Summary Menu^^M^1^^^^^^^^^^^"
^DIC(19,16154,1,0)="^^9^9^3240328^"
^DIC(19,16154,1,1,0)="This menu allows the user to print Health Summaries by Patient or Hospital"
^DIC(19,16154,1,2,0)="Location with a pre-defined Health Summary Type, or print Health Summaries"
^DIC(19,16154,1,3,0)="for patients, based on ad hoc Health Summary definitions.  The user may"
^DIC(19,16154,1,4,0)="also use the Information Menu to list and inquire about Health Summary"
^DIC(19,16154,1,5,0)="Types and Health Summary Components."
^DIC(19,16154,1,6,0)="   "
^DIC(19,16154,1,7,0)="This menu does not contain the options which allow the user to create or"
^DIC(19,16154,1,8,0)="delete his/her own Health Summary Types."
^DIC(19,16154,1,9,0)="Cloned from ""GMTS USER"" option."
^DIC(19,16154,3)=""
^DIC(19,16154,10,0)="^19.01IP^7^7"
