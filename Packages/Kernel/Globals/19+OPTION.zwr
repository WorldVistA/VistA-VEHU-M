^DIC(19,14530,"U")="CROSS-SERVICING MENU"
^DIC(19,14531,0)="RCTCSP BILL REPORT^Cross-Servicing Bill Report^^R^11720^^^^^^^"
^DIC(19,14531,1,0)="^19.06^5^5^3150113^^^^"
^DIC(19,14531,1,1,0)="This report lists the bills for the individual debtor that have been"
^DIC(19,14531,1,2,0)="forwarded to Cross-Servicing.  For each bill, the report displays"
^DIC(19,14531,1,3,0)="the status code, the original amount of the bill, the current amount of"
^DIC(19,14531,1,4,0)="the bill, the principle, interest, administrative cost, court cost, and"
^DIC(19,14531,1,5,0)="the Cross-Servicing referral date."
^DIC(19,14531,25)="BILLREP^RCTCSP1"
^DIC(19,14531,"U")="CROSS-SERVICING BILL REPORT"
^DIC(19,14532,0)="RCTCSP REPORT^Print Cross-Servicing Report^^R^11720^^^^^^^"
^DIC(19,14532,1,0)="^19.06^5^5^3150113^^^"
^DIC(19,14532,1,1,0)="This option is used to print a Cross-Servicing report.  For each bill "
^DIC(19,14532,1,2,0)="which has been referred to Cross-Servicing, the report will display the"
^DIC(19,14532,1,3,0)="Debtor's name, the Debtor SSN, the original amount referred, and the "
^DIC(19,14532,1,4,0)="Cross-Servicing referred date.  The user will have the option of sorting"
^DIC(19,14532,1,5,0)="by Bill Number, Debtor Name, or Cross-Servicing Referred Date."
^DIC(19,14532,25)="CSRPRT^RCTCSP1"
^DIC(19,14532,"U")="PRINT CROSS-SERVICING REPORT"
^DIC(19,14533,0)="RCTCSP RECALL REPORT^Cross-Servicing Recall Report^^R^11720^^^^^^^"
^DIC(19,14533,1,0)="^19.06^3^3^3150113^^^^"
^DIC(19,14533,1,1,0)="The Cross-Servicing Recall Report lists the bills that have been recalled"
^DIC(19,14533,1,2,0)="from Cross-Servicing.  The report has two sort options, a sort by Bill "
^DIC(19,14533,1,3,0)="Number, and a sort by Debtor Name."
^DIC(19,14533,25)="CSRCLRT^RCTCSP5"
^DIC(19,14533,"U")="CROSS-SERVICING RECALL REPORT"
^DIC(19,14534,0)="RCTCSPR SERVER^TCSP Reconciliation Messages^^S^1^^^^^^^"
^DIC(19,14534,1,0)="^^2^2^3140718^"
^DIC(19,14534,1,1,0)="This server processes reconciliation messages from Treasury for the Cross"
^DIC(19,14534,1,2,0)="Servicing referral process."
^DIC(19,14534,25)="RCTCSPRS"
^DIC(19,14534,220)="^R^^Y^Y^R^1"
^DIC(19,14534,"U")="TCSP RECONCILIATION MESSAGES"
^DIC(19,14535,0)="RCTCSP RECONCIL REPORT^Reconciliation Report - Cross-Servicing^^R^11720^^^^^^^"
^DIC(19,14535,1,0)="^19.06^8^8^3170308^^^^"
^DIC(19,14535,1,1,0)="This option is used to print a Reconciliation Report.  For"
^DIC(19,14535,1,2,0)="each bill which has been returned from Treasury by reconciliation,"
^DIC(19,14535,1,3,0)="the report will display the Debtor's name, Bill Number, Returned"
^DIC(19,14535,1,4,0)="Date, and Closed Date.  A second text line will display "
^DIC(19,14535,1,5,0)="the Returned Code Description.  If there is a Date of Death,"
^DIC(19,14535,1,6,0)="a Date of Bankruptcy, or a Date of Dissolution, then this"
^DIC(19,14535,1,7,0)="date will appear on a new line with a text description and"
^DIC(19,14535,1,8,0)="the date."
^DIC(19,14535,25)="RCRPRT^RCTCSP2"
^DIC(19,14535,"U")="RECONCILIATION REPORT - CROSS-"
^DIC(19,14536,0)="RCTCSP REJECT REPORT^Debt Referral Reject Report^^R^11720^^^^^^^"
^DIC(19,14536,1,0)="4^19.06^10^10^3141208^^^^"
^DIC(19,14536,1,1,0)="This option allows the user to report identified Debt Referral Rejects."
^DIC(19,14536,1,2,0)=" "
^DIC(19,14536,1,3,0)="The report prints out based on the following user defined parameters: "
^DIC(19,14536,1,4,0)=" (i.e. -Range of Dates,   -in either Brief or Detail mode,"
^DIC(19,14536,1,5,0)="       -sorted by Bill Number, Debtor Name or CS Referred Date,"
^DIC(19,14536,1,6,0)="       -for a given Reject Origination Source (or All),"
^DIC(19,14536,1,7,0)="       -and in either Ascending or Descending print order.)"
^DIC(19,14536,1,8,0)=" "
^DIC(19,14536,1,9,0)="In addition, output can be made to a device or file in either print "
^DIC(19,14536,1,10,0)="or in Excel spreadsheet format."
^DIC(19,14536,25)="RJRPT^RCTCSJR"
^DIC(19,14536,"U")="DEBT REFERRAL REJECT REPORT"
^DIC(19,14537,0)="RCTCSP IAI ERROR CODES LIST^List IAI Error Codes^^R^11720^^^^^^^"
^DIC(19,14537,1,0)="^19.06^3^3^3141112^^"
^DIC(19,14537,1,1,0)="This option is a listing of the IAI Error Codes, in error code order.  Its"
^DIC(19,14537,1,2,0)="display contains a) Error Code, b) Field Name, c) associated Record Types "
^DIC(19,14537,1,3,0)="and d) Description."
^DIC(19,14537,25)="ECLIST^RCTCSJR"
^DIC(19,14537,"U")="LIST IAI ERROR CODES"
^DIC(19,14538,0)="RCTCSP REJ SERVER^TCSP Reject Return Messages^^S^1^^^^^^^"
^DIC(19,14538,1,0)="^19.06^2^2^3150113^^^"
^DIC(19,14538,1,1,0)="This server processes rejection messages for the Cross-Servicing referral"
^DIC(19,14538,1,2,0)="process."
^DIC(19,14538,25)="SERVER^RCTCSJS"
^DIC(19,14538,220)="^R^^Y^Y^R^1"
^DIC(19,14538,"U")="TCSP REJECT RETURN MESSAGES"
^DIC(19,14539,0)="RCTCSPD SERVER^Due Process Notification Server^^S^1^^^^^^^"
^DIC(19,14539,1,0)="^19.06^2^2^3150325^^"
^DIC(19,14539,1,1,0)="This server processes reject messages from AITC"
^DIC(19,14539,1,2,0)="for Due Process Notification letters."
^DIC(19,14539,25)="RCTCSP3S"
^DIC(19,14539,220)="^R^^Y^Y^E^1"
^DIC(19,14539,"U")="DUE PROCESS NOTIFICATION SERVE"
