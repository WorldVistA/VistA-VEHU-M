^DIC(19,16769,"U")="PCE HS/RPT PARAMETER MENU"
^DIC(19,16770,0)="EHM-01591^PCE Report Parameter Edit^^E^1^^^^^^^507^^^^"
^DIC(19,16770,1,0)="^^10^10^3240328^"
^DIC(19,16770,1,1,0)="This option is used to define parameters that will be used by the PCE"
^DIC(19,16770,1,2,0)="Report Module.  The user will need to identify which clinics are viewed by"
^DIC(19,16770,1,3,0)="clinicians as being Emergency Room clinics.  The user will also need to"
^DIC(19,16770,1,4,0)="identify the lab test names that are used by your site to identify the"
^DIC(19,16770,1,5,0)="following types of Lab tests: Glucose, Cholesterol, LDL Cholesterol, and"
^DIC(19,16770,1,6,0)="HBA1C."
^DIC(19,16770,1,7,0)=" "
^DIC(19,16770,1,8,0)="To get a print out of current definitions in the PCE Parameters fields for"
^DIC(19,16770,1,9,0)="these fields, use the PCE HS/RPT Parameters Print."
^DIC(19,16770,1,10,0)="Cloned from ""PX REPORT PARAMETER EDIT"" option."
^DIC(19,16770,3)=""
^DIC(19,16770,30)="PX(815,"
^DIC(19,16770,31)="QAMEZL"
^DIC(19,16770,50)="PX(815,"
^DIC(19,16770,51)="801:805"
^DIC(19,16770,53)="BACKOUTOK"
^DIC(19,16770,"U")="PCE REPORT PARAMETER EDIT"
^DIC(19,16771,0)="EHM-01592^PCE HS/RPT Parameters Print^^P^1^^^^^^y^507^^^^"
^DIC(19,16771,1,0)="^^5^5^3240328^"
^DIC(19,16771,1,1,0)="This option prints the current PCE Parameter definitions that are used by"
^DIC(19,16771,1,2,0)="some of the PCE Reports. A brief explanation is included about editing and"
^DIC(19,16771,1,3,0)="viewing health summary disclaimers that are now managed from the Clinical"
^DIC(19,16771,1,4,0)="Reminders package."
^DIC(19,16771,1,5,0)="Cloned from ""PX HS/RPT PARAMETERS PRINT"" option."
^DIC(19,16771,3)=""
^DIC(19,16771,60)="PX(815,"
^DIC(19,16771,61)=""
^DIC(19,16771,62)=0
^DIC(19,16771,63)="[PX HS/RPT PARAMETERS PRINT]"
^DIC(19,16771,64)="[PX PARAMETERS PRINT]"
^DIC(19,16771,"U")="PCE HS/RPT PARAMETERS PRINT"
^DIC(19,16772,0)="EHM-01593^PCE Device Interface Error Report^^R^1^^^^^^^507^^^^"
^DIC(19,16772,1,0)="^^2^2^3240328^^"
^DIC(19,16772,1,1,0)="This produces an error report for PCE device interface errors."
^DIC(19,16772,1,2,0)="Cloned from ""PXEDI"" option."
^DIC(19,16772,3)=""
^DIC(19,16772,10.1)="Device Interface Error Report"
^DIC(19,16772,25)="PXEDIM"
^DIC(19,16772,"U")="PCE DEVICE INTERFACE ERROR REP"
^DIC(19,16773,0)="EHM-01594^PCE Encounter Viewer^^A^1^^^^^^^507^^1^^"
^DIC(19,16773,1,0)="^^7^7^3240328^"
^DIC(19,16773,1,1,0)="This option is for users who can view a clinical encounter in the V-files"
^DIC(19,16773,1,2,0)="(visit-related files) with out being able to add, edit or delete any"
^DIC(19,16773,1,3,0)="information. The data viewable via this option includes visit information"
^DIC(19,16773,1,4,0)="(where and when), and the following clinical data related to the visit:"
^DIC(19,16773,1,5,0)="providers of care, problems treated, procedures and treatments done, and"
^DIC(19,16773,1,6,0)="immunizations, skin tests, and patient education given."
^DIC(19,16773,1,7,0)="Cloned from ""PXCE ENCOUNTER VIEWER"" option."
^DIC(19,16773,3)=""
^DIC(19,16773,10.1)="VIEW"
^DIC(19,16773,20)="D EN^PXCE(""V"")"
^DIC(19,16773,99.1)="56179,36316"
^DIC(19,16773,"U")="PCE ENCOUNTER VIEWER"
^DIC(19,16774,0)="EHM-01595^CIDC Missing Data Report^^R^1^^^^^^^507^^^^"
^DIC(19,16774,1,0)="^^3^3^3240328^"
^DIC(19,16774,1,1,0)="This produces a report of missing Clinical Indicator Data"
^DIC(19,16774,1,2,0)="Collection (CIDC) data"
^DIC(19,16774,1,3,0)="Cloned from ""PXRRMDR"" option."
^DIC(19,16774,3)=""
^DIC(19,16774,10.1)="CIDC Missing Data Report"
^DIC(19,16774,25)="EN^PXRRMDR"
^DIC(19,16774,"U")="CIDC MISSING DATA REPORT"
^DIC(19,16775,0)="EHM-01596^Accounting Of Immunization Disclosures Report^^R^1^^^^^^^^^^^"
^DIC(19,16775,1,0)="^^9^9^3240328^"
^DIC(19,16775,1,1,0)="This option is used for generating a list of immunization administration"
^DIC(19,16775,1,2,0)="records transmitted to external agencies. This option allows for a date"
^DIC(19,16775,1,3,0)="range selection as well as one, multiple or all agencies and one, multiple"
^DIC(19,16775,1,4,0)="or all patients. The list is sorted by disclosure date/time, agency, and"
^DIC(19,16775,1,5,0)="then by patient."
^DIC(19,16775,1,6,0)=" "
^DIC(19,16775,1,7,0)="Note: This report must be printed to a 132 column device in order to view "
^DIC(19,16775,1,8,0)="the entire data set."
^DIC(19,16775,1,9,0)="Cloned from ""PXV IMM DISCLOSURE REPORT"" option."
^DIC(19,16775,3)=""
^DIC(19,16775,25)="MAIN^PXVDIS"
^DIC(19,16775,"U")="ACCOUNTING OF IMMUNIZATION DIS"
^DIC(19,16776,0)="EHM-01597^Enter/edit quick orders^^R^1^^^^^^^^^^^"
^DIC(19,16776,1,0)="^^6^6^3240328^^"
^DIC(19,16776,1,1,0)="This option lets you create or change quick orders. The dialog for"
^DIC(19,16776,1,2,0)="creating a quick order is similar to a dialog for entering an"
^DIC(19,16776,1,3,0)="order. The responses you enter will become the pre-defined responses"
^DIC(19,16776,1,4,0)="for this quick order. End users will have the opportunity to edit"
^DIC(19,16776,1,5,0)="these pre-defined responses, if desired."
^DIC(19,16776,1,6,0)="Cloned from ""ORCM QUICK ORDERS"" option."
^DIC(19,16776,3)=""
^DIC(19,16776,25)="QUICK^ORCMEDT1"
^DIC(19,16776,"U")="ENTER/EDIT QUICK ORDERS"
