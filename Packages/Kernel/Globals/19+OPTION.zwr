^DIC(19,6289,0)="NURAPR-RES-WKLSUM^AMIS Workload Statistics Summary Report^^R^10958^^^^^^^28^^1^1"
^DIC(19,6289,1,0)="^^2^2^2920203^"
^DIC(19,6289,1,1,0)="This option provides an AMIS Workload Statistic Summary report by ward, and"
^DIC(19,6289,1,2,0)="date."
^DIC(19,6289,15)="K SUMSW"
^DIC(19,6289,20)="S SUMSW=1"
