^DIC(19,687,"U")="UNIT DOSE MEDICATIONS"
^DIC(19,688,0)="PSJU NE^Order Entry^^R^11712^^^^^^^117"
^DIC(19,688,1,0)="^^3^3^2910312^^^^"
^DIC(19,688,1,1,0)="  Allows the user to input new UNIT DOSE orders for a patient currently"
^DIC(19,688,1,2,0)="admitted in the medical center, and the editing (and other actions) of"
^DIC(19,688,1,3,0)="orders previously entered."
^DIC(19,688,25)="PSGOE"
^DIC(19,688,99)="54143,61496"
^DIC(19,688,"U")="ORDER ENTRY"
^DIC(19,689,0)="PSJU PR^PAtient Profile (Unit Dose)^^R^1^^^^^^^117^^1^1"
^DIC(19,689,1,0)="^19.06^7^7^3070921^^^^"
^DIC(19,689,1,1,0)="  Allows a user to print to any device a profile (list) of a patient's"
^DIC(19,689,1,2,0)="orders for the patient's current or last (if patient has been discharged)"
^DIC(19,689,1,3,0)="admission.  If the user's terminal is selected as the printing device,"
^DIC(19,689,1,4,0)="this option will allow the user to select any of the printed orders to be"
^DIC(19,689,1,5,0)="shown in complete detail, including the activity logs, if any.  The user"
^DIC(19,689,1,6,0)="may print patients' profiles for a single patient, or for an entire WARD"
^DIC(19,689,1,7,0)="GROUP or an entire WARD."
^DIC(19,689,15)="K PSJNODIS"
^DIC(19,689,20)="S PSJNODIS=1"
^DIC(19,689,25)="PSGPR"
^DIC(19,689,99.1)="59015,44130"
^DIC(19,689,"U")="PATIENT PROFILE (UNIT DOSE)"
^DIC(19,690,0)="PSJU TRAIN^Train - simple^^M^.5^^^^^^^^^^1"
^DIC(19,690,1,0)="^^4^4^2860723^^^^"
^DIC(19,690,1,1,0)="'Train' allows the human practice in functions or sub-functions"
^DIC(19,690,1,2,0)="that are in the inpatient pharmacy package."
^DIC(19,690,1,3,0)="There isn't any patient involvement and there isn't any danger"
^DIC(19,690,1,4,0)="of corrupting real patient's orders while you are in 'Train' ."
^DIC(19,690,10,0)="^19.01PI^2^2"
^DIC(19,690,10,1,0)="694^"
^DIC(19,690,10,2,0)="715^"
^DIC(19,690,10,"B",694,1)=""
^DIC(19,690,10,"B",715,2)=""
^DIC(19,690,15)="K PSGS0XT,PSGS0Y"
^DIC(19,690,20)=""
^DIC(19,690,99)="62088,37770"
^DIC(19,690,"U")="TRAIN - SIMPLE"
^DIC(19,694,0)="PSJU TRAIN SCHEDULE^Schedule Practice^^A^10000000020^^^^^^^^^1"
^DIC(19,694,1,0)="^^4^4^3040716^"
^DIC(19,694,1,1,0)="You can practice inputing your schedules under this option.  Try"
^DIC(19,694,1,2,0)="anything - serious or not!  If the schedule chosen has ADMINISTRATION "
^DIC(19,694,1,3,0)="TIMES, they will be shown. Entries containing ""PRN"" or those considered "
^DIC(19,694,1,4,0)="""ODD"" schedules, will show nothing."
^DIC(19,694,20)="D ENA^PSGS0"
^DIC(19,694,25)=""
^DIC(19,694,"U")="SCHEDULE PRACTICE"
^DIC(19,695,0)="PSJU RET^Report Returns^^R^11712^PSJU PL^^^^^^117"
^DIC(19,695,1,0)="^^3^3^2910312^^^^"
^DIC(19,695,1,1,0)="  This option allows a user to enter the units of returned medication (as"
^DIC(19,695,1,2,0)="when a patient is discharged) into the medication order record.  Data"
^DIC(19,695,1,3,0)="entered is used in the cost reports."
^DIC(19,695,25)="PSGRET"
^DIC(19,695,"U")="REPORT RETURNS"
^DIC(19,696,0)="PSJU PL^Pick List^^R^11712^PSJU PL^^^^^^117"
^DIC(19,696,1,0)="^^6^6^2911214^^^^"
^DIC(19,696,1,1,0)="  The Pick List is used by pharmacy when filling medication carts.  The"
^DIC(19,696,1,2,0)="list is sorted by administering team, ward, room-bed, and then patient."
^DIC(19,696,1,3,0)="The site may define ward groups and generate the pick list by these groups"
^DIC(19,696,1,4,0)="to match site-specific filling practices.  The pick list will calculate the"
^DIC(19,696,1,5,0)="units needed to be dispensed for selected patients' orders over a selected"
^DIC(19,696,1,6,0)="date range."
^DIC(19,696,25)="PSGPL"
^DIC(19,696,99)="55593,33832"
^DIC(19,696,"U")="PICK LIST"
^DIC(19,697,0)="PSJU PLMGR^PIck List Menu^^M^11712^PSJU PL^^^^^^117"
^DIC(19,697,1,0)="^^2^2^2910312^^^^"
^DIC(19,697,1,1,0)="  Various options allowing the tracking of the dispensing of medication"
^DIC(19,697,1,2,0)="from the pharmacy.  This option is available only to pharmacy personnel."
^DIC(19,697,10,0)="^19.01PI^8^7"
^DIC(19,697,10,1,0)="696^^3"
^DIC(19,697,10,3,0)="701^^1"
^DIC(19,697,10,4,0)="695^RRS^4"
^DIC(19,697,10,5,0)="713^RPL^5"
^DIC(19,697,10,6,0)="703^"
^DIC(19,697,10,7,0)="716^^2"
^DIC(19,697,10,8,0)="2351^"
^DIC(19,697,10,"B",695,4)=""
^DIC(19,697,10,"B",696,1)=""
^DIC(19,697,10,"B",701,3)=""
^DIC(19,697,10,"B",703,6)=""
^DIC(19,697,10,"B",713,5)=""
^DIC(19,697,10,"B",716,7)=""
^DIC(19,697,10,"B",2351,8)=""
^DIC(19,697,10,"C","RPL",5)=""
^DIC(19,697,10,"C","RRS",4)=""
^DIC(19,697,99)="62088,37770"
^DIC(19,697,"U")="PICK LIST MENU"
^DIC(19,698,0)="PSJU AOE^Active order edit^^R^.5^PSGRPH^^"
^DIC(19,698,1,0)="^^2^2^2850823^^^^"
^DIC(19,698,1,1,0)="Action may be taken on an active order via this option.  The order may be"
^DIC(19,698,1,2,0)="edited, renewed, or discontinued."
^DIC(19,698,25)="ENA^PSGEDALL"
^DIC(19,698,200)="^^"
^DIC(19,698,"U")="ACTIVE ORDER EDIT"
^DIC(19,699,0)="PSJU NOE^Non-verified Orders^^R^.5^^^"
^DIC(19,699,1,0)="^^2^2^2850823^^^^"
^DIC(19,699,1,1,0)="Allows action to be taken on non-verified orders.  Orders may be edited,"
^DIC(19,699,1,2,0)="held, verified, or cancelled via this option."
^DIC(19,699,25)="ENV^PSGEDALL"
^DIC(19,699,"U")="NON-VERIFIED ORDERS"
^DIC(19,700,0)="PSJU AT^Administering Teams^^R^11712^^^^^^^117"
^DIC(19,700,1,0)="^^4^4^2940321^^^^"
^DIC(19,700,1,1,0)="  Allows the user to create and edit administering teams (carts) for each"
^DIC(19,700,1,2,0)="ward.  The user designates which room-beds are associated with each team"
^DIC(19,700,1,3,0)="created.  The teams are used in sorting the data in reports, especially"
^DIC(19,700,1,4,0)="the Pick List."
^DIC(19,700,25)="ENAT^PSGFILED"
^DIC(19,700,"U")="ADMINISTERING TEAMS"
^DIC(19,701,0)="PSJU PLDP^ENter Units Dispensed^^R^11712^PSJU PL^^^^^^117"
^DIC(19,701,1,0)="^^5^5^2940408^^^^"
^DIC(19,701,1,1,0)="  Allows the user to enter the units actually dispensed into the cart for"
^DIC(19,701,1,2,0)="which the respective pick list was run.  This option allows the user"
^DIC(19,701,1,3,0)="to select only those pick lists which have not already been filed away."
^DIC(19,701,1,4,0)="From here, the user may then file the pick list away, a process that makes"
^DIC(19,701,1,5,0)="the data usable for cost reports."
^DIC(19,701,25)="PSGPLDP"
^DIC(19,701,"U")="ENTER UNITS DISPENSED"
^DIC(19,703,0)="PSJU PLUP^Update Pick List^^R^11712^PSJU PL^^^^^^117"
^DIC(19,703,1,0)="^^5^5^2910312^^^^"
^DIC(19,703,1,1,0)="  Allows the pharmacy personnel to update a pick list that has already been"
^DIC(19,703,1,2,0)="run but not yet started, picking up the new orders, renewed orders, and"
^DIC(19,703,1,3,0)="orders that were being edited when the pick list was first run.  This option"
^DIC(19,703,1,4,0)="allows the pharmacist to print either only the updated orders, or to print "
^DIC(19,703,1,5,0)="the entire pick list, including the updated orders."
^DIC(19,703,25)="PSGPLUP"
^DIC(19,703,"U")="UPDATE PICK LIST"
^DIC(19,704,0)="PSJU FILE^Supervisor's Menu^^M^10000000020^PSJU MGR^^^^^^117^^1"
^DIC(19,704,1,0)="^19.06^3^3^3040727^^^^"
^DIC(19,704,1,1,0)="  Allows the user (coordinator) to edit the various files, and perform"
^DIC(19,704,1,2,0)="certain functions, needed for the basic running of the Unit Dose Medications"
^DIC(19,704,1,3,0)="package."
^DIC(19,704,10,0)="^19.01PI^32^10"
^DIC(19,704,10,1,0)="700^^1"
^DIC(19,704,10,8,0)="707^"
^DIC(19,704,10,13,0)="2340^"
