^DIC(19,10029,0)="LRAR ARCHIVE 64.1^Archive Wkld Data file 64.1^^R^10958^^^^^^^510^^1"
^DIC(19,10029,1,0)="^^5^5^2960909^^^^"
^DIC(19,10029,1,1,0)="This option allows you to archive data from WKLD DATA file(#64.1)."
^DIC(19,10029,1,2,0)="Data in the specified date range moves to the ARCHIVED WKLD DATA"
^DIC(19,10029,1,3,0)="file (#64.19999).  You should NOT archive or purge this file until"
^DIC(19,10029,1,4,0)="the DSS extraction has been completed.  Please consult with the DSS"
^DIC(19,10029,1,5,0)="coordinator."
