^DIC(19,6798,1,1,0)="The Report Potential NDC Matches option scans the DRUG file (#50) for"
^DIC(19,6798,1,2,0)="entries not yet linked to the ITEM MASTER file (#441) that have a National"
^DIC(19,6798,1,3,0)="Drug Code (NDC) entered. It then checks the ITEM MASTER file for an NDC"
^DIC(19,6798,1,4,0)="match."
^DIC(19,6798,25)="PSALND"
^DIC(19,6798,"U")="REPORT POTENTIAL NDC MATCHES"
^DIC(19,6799,0)="PSA NDC CONTROL LOOP^Controlled Connection by NDC Match^^R^11595^^^^^^^287"
^DIC(19,6799,1,0)="^^4^4^2970923^^"
^DIC(19,6799,1,1,0)="The Controlled Connection by NDC Match option loops through the DRUG file"
^DIC(19,6799,1,2,0)="(#50) for entries not yet linked to the ITEM MASTER file (#441). It checks"
^DIC(19,6799,1,3,0)="for a National Drug Code (NDC) match with the ITEM MASTER file and ,if one"
^DIC(19,6799,1,4,0)="is located, the user is asked to approve the link."
^DIC(19,6799,25)="PSALNM"
^DIC(19,6799,"U")="CONTROLLED CONNECTION BY NDC M"
