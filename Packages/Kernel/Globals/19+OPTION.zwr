^DIC(19,7070,0)="DG CO-PAY TEST INCOMPLETE^List Incomplete Copay Exemption Test^^A^.5^DG MEANSTEST^^^^^^^^1"
^DIC(19,7070,1,0)="^^2^2^2921216^^"
^DIC(19,7070,1,1,0)="This option is used to generate a listing of patients who"
^DIC(19,7070,1,2,0)="either have an INCOMPLETE co-pay test or are PENDING AJUDICATION.  "
