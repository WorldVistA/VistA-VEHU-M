^DIC(19,15639,0)="EHM-00460^Build Patient List Menu^^M^1^^^^^^^^^^^"
^DIC(19,15639,1,0)="^19.06^4^4^3240328^^^^"
^DIC(19,15639,1,1,0)="Options on this menu allow you to create patient lists by patient,"
^DIC(19,15639,1,2,0)="ward, or clinic.  These lists can then be used to display results or"
^DIC(19,15639,1,3,0)="to print reports, or can be merged with other lists."
^DIC(19,15639,1,4,0)="Cloned from ""ORLP ADD MENU"" option."
