^DIC(19,9680,1,0)="^^4^4^2960402^^^"
^DIC(19,9680,1,1,0)="This option allows the user to print a report on categories from"
^DIC(19,9680,1,2,0)="the EVENT CAPTURE CATEGORY file (#726). You can select all"
^DIC(19,9680,1,3,0)="categories, active categories only, or only those categories"
^DIC(19,9680,1,4,0)="that have been inactivated."
^DIC(19,9680,15)="W @IOF"
^DIC(19,9680,25)="ECDSS3"
^DIC(19,9680,"U")="CATEGORY REPORTS"
