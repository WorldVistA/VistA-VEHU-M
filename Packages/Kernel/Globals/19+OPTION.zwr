^DIC(19,15860,"U")="GUI HEALTH SUMMARY TYPES"
^DIC(19,15861,0)="EHM-00682^GUI Tool Menu Items^^A^1^^^^^^^^^1^^"
^DIC(19,15861,1,0)="^^5^5^3240328^^"
^DIC(19,15861,1,1,0)="This option allows you to add items that will appear on the Tools menu "
^DIC(19,15861,1,2,0)="in the CPRS GUI.  Items that appear on the tools menu should be"
^DIC(19,15861,1,3,0)="Windows executable files. Use this format: ""Display Text=Executable""."
^DIC(19,15861,1,4,0)="For example, ""Vista Terminal Emulator=KEA.EXE VISTA""."
^DIC(19,15861,1,5,0)="Cloned from ""ORW TOOL MENU ITEMS"" option."
^DIC(19,15861,3)=""
^DIC(19,15861,10.1)="GUI Tool Menu Items"
^DIC(19,15861,20)="D EDITPAR^XPAREDIT(""ORWT TOOLS MENU"")"
^DIC(19,15861,"U")="GUI TOOL MENU ITEMS"
^DIC(19,15862,0)="EHM-00683^GUI Parameters - Miscellaneous^^A^1^^^^^^^^^1^^"
^DIC(19,15862,1,0)="^^2^2^3240328^"
^DIC(19,15862,1,1,0)="This option allows various parameters that affect the CPRS GUI to be set."
^DIC(19,15862,1,2,0)="Cloned from ""ORW PARAM GENERAL ALL"" option."
^DIC(19,15862,3)=""
^DIC(19,15862,20)="N SETFOR D GETENT^XPAREDIT(.SETFOR,$$FIND1^DIC(8989.51,"""",""X"",""ORCH INITIAL TAB"")_U_""Miscellaneous Parameters"") I SETFOR D TED^XPAREDIT(""ORW GENERAL PARAMETERS (ALL)"",""B"",SETFOR)"
^DIC(19,15862,"U")="GUI PARAMETERS - MISCELLANEOUS"
^DIC(19,15863,0)="EHM-00684^GUI Clear Size & Position Settings for User^^R^1^^^^^^^^^^^"
^DIC(19,15863,1,0)="^^4^4^3240328^^^"
^DIC(19,15863,1,1,0)="This option will reset all GUI size and position settings for the"
^DIC(19,15863,1,2,0)="selected user.  This includes window positions, splitter bar positions,"
^DIC(19,15863,1,3,0)="etc."
^DIC(19,15863,1,4,0)="Cloned from ""ORW CLEAR SIZES USER"" option."
