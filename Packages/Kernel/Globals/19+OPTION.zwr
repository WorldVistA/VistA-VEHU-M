^DIC(19,7065,0)="PRCAX CO-PAY EXEMPTION REPORT^Medication Co-pay Exemption Report^^R^.5^^^^^^^"
^DIC(19,7065,1,0)="^^4^4^2921223^^"
^DIC(19,7065,1,1,0)="This option produces a report showing the medication co-pay exemption"
^DIC(19,7065,1,2,0)="adjustments applied to the system for a given time period selected by the"
^DIC(19,7065,1,3,0)="user.  The report will display the patient name, patient id, bill number,"
^DIC(19,7065,1,4,0)="transaction number, and transaction amount for the adjustment."
^DIC(19,7065,25)="PRCAXP"
^DIC(19,7065,99)="55713,41427"
^DIC(19,7065,"U")="MEDICATION CO-PAY EXEMPTION RE"
^DIC(19,7066,0)="DG CO-PAY TEST ADD^Add a Copay Exemption Test^^A^10000000020^DG MEANSTEST^^^^^^114^^1^1"
^DIC(19,7066,1,0)="^^1^1^2921216^"
^DIC(19,7066,1,1,0)="Add new Co-Pay Test."
^DIC(19,7066,15)="K DGFINOP"
^DIC(19,7066,20)="D ON^DGMTCOU I Y S DGMTYPT=2 S DGFINOP="""" D EN^DGMTA"
^DIC(19,7066,25)=""
^DIC(19,7066,99)="55613,57733"
^DIC(19,7066,"U")="ADD A COPAY EXEMPTION TEST"
^DIC(19,7067,0)="DG CO-PAY TEST EDIT^Edit an Existing Copay Exemption Test^^A^10000000020^DG MEANSTEST^^^^^^^^1^1"
^DIC(19,7067,1,0)="^^1^1^2930413^^"
^DIC(19,7067,1,1,0)="Edit existing Co-Pay Test Information."
^DIC(19,7067,15)="K DGFINOP"
^DIC(19,7067,20)="D ON^DGMTCOU I Y S DGMTYPT=2 S DGFINOP="""" D EN^DGMTE"
^DIC(19,7067,25)=""
^DIC(19,7067,"U")="EDIT AN EXISTING COPAY EXEMPTI"
^DIC(19,7068,0)="DG CO-PAY TEST DELETE^Delete a Copay Exemption Test^^A^.5^DG MTDELETE^^^^^^^^1"
^DIC(19,7068,1,0)="^^6^6^2921216^"
^DIC(19,7068,1,1,0)="This option is used to delete co-pay test data which may have been "
^DIC(19,7068,1,2,0)="inadvertantly entered.  Under normal circumstances only individual dates of"
^DIC(19,7068,1,3,0)="test may be deleted using this option.  The exception is non-veterans.  All"
^DIC(19,7068,1,4,0)="co-pay tests found for a non-veteran may be deleted.  "
^DIC(19,7068,1,5,0)="  "
^DIC(19,7068,1,6,0)="This option invokes the means test event driver.  "
^DIC(19,7068,20)="D ON^DGMTCOU I Y S DGMTYPT=2 D EN^DGMTDEL"
^DIC(19,7068,25)=""
^DIC(19,7068,"U")="DELETE A COPAY EXEMPTION TEST"
