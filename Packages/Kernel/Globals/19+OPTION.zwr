^DIC(19,16259,1,1,0)="This option lists all treatments, with their active status, that have been"
^DIC(19,16259,1,2,0)="defined in the Treatment file for use with PCE."
^DIC(19,16259,1,3,0)="Cloned from ""PXTT LIST TREATMENTS"" option."
