^DIC(19,7704,0)="SDAM RPT WAITING TIME^Appointment Waiting Time Report^^R^.5^^^^^^^16"
^DIC(19,7704,1,0)="^^12^12^2931201^"
^DIC(19,7704,1,1,0)="This report will list the waiting time for patients with scheduled"
^DIC(19,7704,1,2,0)="appointments.  The patient has to be checked-in and check-out."
^DIC(19,7704,1,3,0)=" "
^DIC(19,7704,1,4,0)="It will give the user the opportunity to print a full report with patient's"
^DIC(19,7704,1,5,0)="names or a report of totals only."
^DIC(19,7704,1,6,0)=" "
^DIC(19,7704,1,7,0)="Both types of reports will furnish averages for clinics/stop codes, division"
^DIC(19,7704,1,8,0)="and total for the hospital.  It will print in the format of:"
^DIC(19,7704,1,9,0)=" "
^DIC(19,7704,1,10,0)="Patient - ID - (Clinic) - CI Date/Time - Elapsed Minutes - Appt. Date/Time"
^DIC(19,7704,1,11,0)=" - CO Date/Time - Elapsed Minutes - Total Minutes"
^DIC(19,7704,1,12,0)=" "
^DIC(19,7704,25)="SDAMOW"
^DIC(19,7704,"U")="APPOINTMENT WAITING TIME REPOR"
