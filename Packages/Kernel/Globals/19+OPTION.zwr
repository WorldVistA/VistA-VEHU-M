^DIC(19,14733,0)="GMRC CHANGE STATUS X TO DC^GMRC CHANGE STATUS X TO DC^^R^11720^^^^^^n^294^^"
^DIC(19,14733,1,0)="^19.06^3^3^3180815^^"
^DIC(19,14733,1,1,0)="This option is exclusively used by Taskman to schedule an overnight job "
^DIC(19,14733,1,2,0)="that looks for all consults that were cancelled over 30 days ago, and "
^DIC(19,14733,1,3,0)="discontinues them."
