^DIC(19,13520,20)="D EN^SDWLKIL"
^DIC(19,13520,25)="EN^SDWLEC"
^DIC(19,13520,"U")="OPEN CLOSED EWL ENTRY"
^DIC(19,13521,0)="SDWL BATCH CLINIC CHANGE^Wait List Batch Clinic Change^DO NOT USE!! - EWL DECOM - SD*5.3*769^A^1^SDWL MENU^^^^^^^^1"
^DIC(19,13521,1,0)="^^4^4^3061026^"
^DIC(19,13521,1,1,0)="This option allows the user to 'move' Open EWL entries from a specific"
^DIC(19,13521,1,2,0)="clinic to a different clinic even if it involves a different Institution."
^DIC(19,13521,1,3,0)="New entries for the different clinic are created, and the original entries"
^DIC(19,13521,1,4,0)="shall be closed with the new disposition code of 'CL' for Changed Clinic."
^DIC(19,13521,20)="D ^SDWLBACC"
^DIC(19,13521,"U")="WAIT LIST BATCH CLINIC CHANGE"
^DIC(19,13522,0)="SDWL ENTER/EDIT WITH ACA FLAG^Wait List Enter/Edit as a Scheduling Reminder^DO NOT USE!! - EWL DECOM - SD*5.3*769^A^1^^^^^^^^^1"
^DIC(19,13522,1,0)="^^2^2^3061026^"
^DIC(19,13522,1,1,0)="This option allows the user to create an EWL entry that can be used as"
^DIC(19,13522,1,2,0)="a Scheduling Reminder. "
^DIC(19,13522,20)="S SDWLACA=1 D ^SDWLE K SDWLACA"
^DIC(19,13522,"U")="WAIT LIST ENTER/EDIT AS A SCHE"
^DIC(19,13523,0)="PSB TOOL MENU ITEMS^BCMA GUI Tool Menu Items^^A^1^^^^^^^533^^1"
^DIC(19,13523,1,0)="^19.06^4^4^3070711^^"
^DIC(19,13523,1,1,0)="This option allows you to add items that will appear on the Tools menu in "
^DIC(19,13523,1,2,0)="the BCMA GUI.  Items that appear on the tools menu should be Windows "
^DIC(19,13523,1,3,0)="executable files. Use this format: ""Display Text=Executable"". For "
^DIC(19,13523,1,4,0)="example, ""Vista Terminal Emulator=KEA.EXE VISTA""."
^DIC(19,13523,20)="D EDITPAR^XPAREDIT(""PSB TOOLS MENU"")"
^DIC(19,13523,"U")="BCMA GUI TOOL MENU ITEMS"
^DIC(19,13524,0)="EAS MT UES OVERRIDE^User Enrollee Site Print Override^Disabled by the VFA project. Do not use.^A^1^EAS MT UES OVERRIDE^^^^^^538^^1"
^DIC(19,13524,1,0)="^19.06^3^3^3070730^^^^"
^DIC(19,13524,1,1,0)="This option overrides the User Enrollee filters and allows a site to print"
^DIC(19,13524,1,2,0)="the letters for veterans which have a User Enrollee status of 'Diff."
^DIC(19,13524,1,3,0)="Site'."
^DIC(19,13524,20)="D QUE^EASMT65"
^DIC(19,13524,43)="^"
^DIC(19,13524,"U")="USER ENROLLEE SITE PRINT OVERR"
^DIC(19,13525,0)="SDSC SITE PARAMETER^ASCD Compile Parameter^^R^1^SDSC SUPER^^^^^^16^^1"
^DIC(19,13525,1,0)="^19.06^2^2^3070320^^^"
^DIC(19,13525,1,1,0)="This option allows the supervisor to adjust the number of days the"
^DIC(19,13525,1,2,0)="compile uses to check for completed outpatient encounters."
^DIC(19,13525,20)="W @IOF"
^DIC(19,13525,25)="EN^SDSCPRM"
^DIC(19,13525,"U")="ASCD COMPILE PARAMETER"
^DIC(19,13526,0)="SDSC CHECK COMPILE^Compile Results Report^^R^1^^^^^^^16"
^DIC(19,13526,1,0)="^19.06^1^1^3070302^^^^"
^DIC(19,13526,1,1,0)="This report prints out why encounters were not compiled into ASCD."
^DIC(19,13526,25)="EN^SDSCCHK"
^DIC(19,13526,"U")="COMPILE RESULTS REPORT"
^DIC(19,13527,0)="SDSC COMPILE^Compile ASCD Encounters by Date Range^^R^1^^^^^^^16"
^DIC(19,13527,1,0)="^19.06^8^8^3070521^^^"
^DIC(19,13527,1,1,0)="This option compares POVs of visits/encounters with the rated disabilities"
^DIC(19,13527,1,2,0)="of a patient to verify if the visit is service connected. If the visit"
^DIC(19,13527,1,3,0)="cannot be verified as service connected, the encounter will be stored"
^DIC(19,13527,1,4,0)="for review and reporting."
^DIC(19,13527,1,5,0)=" "
^DIC(19,13527,1,6,0)="This option is interactive.  It will ask the users for a date range.  It"
^DIC(19,13527,1,7,0)="is suggested that this be run at least once a month to update any records"
^DIC(19,13527,1,8,0)="not completed at the time of the nightly compile."
^DIC(19,13527,25)="COMPILE^SDSCOMP"
^DIC(19,13527,"U")="COMPILE ASCD ENCOUNTERS BY DAT"
^DIC(19,13528,0)="SDSC EDIT BY DATE^Edit ASCD Encounters by Date Range^^R^1^^^^^^^16"
^DIC(19,13528,1,0)="^^2^2^3061019^"
^DIC(19,13528,1,1,0)="This option allows the user to edit the service connected information for"
^DIC(19,13528,1,2,0)="a set of previously compiled encounters for a specific date range."
^DIC(19,13528,25)="START^SDSCEDT"
^DIC(19,13528,"U")="EDIT ASCD ENCOUNTERS BY DATE R"
^DIC(19,13529,0)="SDSC EDIT LISTMAN^Edit ASCD Encounters by ListMan^^R^1^^^^^^^16"
^DIC(19,13529,1,0)="^19.06^2^2^3070515^^^^"
^DIC(19,13529,1,1,0)="This option allows the user to review and edit Automated Service"
^DIC(19,13529,1,2,0)="Connected Designation encounters via a ListMan screen."
^DIC(19,13529,25)="EN^SDSCLST"
^DIC(19,13529,"U")="EDIT ASCD ENCOUNTERS BY LISTMA"
^DIC(19,13530,0)="SDSC FIRST PARTY REPORT^First Party Billable Service Connected Report^^R^1^^^^^^^16"
^DIC(19,13530,1,0)="^19.06^2^2^3070302^^^"
^DIC(19,13530,1,1,0)="This report displays information on any encounters found by the ASCD"
^DIC(19,13530,1,2,0)="compile that are potentially billable to first party (means test)."
^DIC(19,13530,25)="NSCCOP^SDSCRPT1"
^DIC(19,13530,"U")="FIRST PARTY BILLABLE SERVICE C"
^DIC(19,13531,0)="SDSC ENC REPORT^Service Connected Encounters Report^^R^1^^^^^^^16"
^DIC(19,13531,1,0)="^^2^2^3070327^"
^DIC(19,13531,1,1,0)="This report displays details of the current status of each encounter"
^DIC(19,13531,1,2,0)="found by the Automated Service Connected Designation compile."
^DIC(19,13531,25)="RDPOV^SDSCRPT1"
^DIC(19,13531,"U")="SERVICE CONNECTED ENCOUNTERS R"
^DIC(19,13532,0)="SDSC NIGHTLY COMPILE^Compile ASCD Encounters on a Nightly Basis^^R^1^^^^^^^16"
^DIC(19,13532,1,0)="^^6^6^3070418^"
^DIC(19,13532,1,1,0)="This option compares the outpatient encounter visit with the rated"
^DIC(19,13532,1,2,0)="disabilities of a patient to verify if the visit is service connected. If"
^DIC(19,13532,1,3,0)="the visit cannot be verified as service connected, the encounter will be"
^DIC(19,13532,1,4,0)="stored for review and reporting.  This option is not interactive.  It"
^DIC(19,13532,1,5,0)="compiles data for the previous day.  It is suggested that this option be"
^DIC(19,13532,1,6,0)="scheduled in TaskMan to run daily."
^DIC(19,13532,25)="AUTODT^SDSCOMP"
^DIC(19,13532,"U")="COMPILE ASCD ENCOUNTERS ON A N"
^DIC(19,13533,0)="SDSC PROVIDER REPORT^Provider Service Connected Encounters Report^^R^1^^^^^^^16^^1"
^DIC(19,13533,1,0)="^19.06^3^3^3070302^^^^"
^DIC(19,13533,1,1,0)="This report can either display details or a summary of the encounters"
^DIC(19,13533,1,2,0)="found by the ASCD compile sorted by the primary provider from the"
^DIC(19,13533,1,3,0)="encounter/visit."
^DIC(19,13533,20)="W @IOF"
^DIC(19,13533,25)="SCPRV^SDSCRPT1"
