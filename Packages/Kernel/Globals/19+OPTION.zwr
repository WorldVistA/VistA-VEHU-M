^DIC(19,12311,"U")="PENDING PATIENTS"
^DIC(19,12312,0)="XPAR EDIT KEYWORD^Edit Parameter Definition Keyword^^E^11748^^^^^^^349^y"
^DIC(19,12312,1,0)="^^2^2^3021002^"
^DIC(19,12312,1,1,0)="This option allows a user to edit the keyword field in the Parameter "
^DIC(19,12312,1,2,0)="Definition file."
^DIC(19,12312,30)="XTV(8989.51,"
^DIC(19,12312,31)="AEMQ"
^DIC(19,12312,50)="XTV(8989.51,"
^DIC(19,12312,51)=4
^DIC(19,12312,"U")="EDIT PARAMETER DEFINITION KEYW"
^DIC(19,12313,0)="XT-RTN CS UPDATE^Old Checksum Update from Build^^R^11748^^^^^^^349^y"
^DIC(19,12313,1,0)="^^4^4^3021010^"
^DIC(19,12313,1,1,0)="This option will update the old checksum of the routine in a Build with "
^DIC(19,12313,1,2,0)="the routines current checksum value.  This option should be run after a "
^DIC(19,12313,1,3,0)="patch has been released and before any new editing of the routines takes "
^DIC(19,12313,1,4,0)="place."
^DIC(19,12313,25)="UPDATE^XTRUTL"
^DIC(19,12313,"U")="OLD CHECKSUM UPDATE FROM BUILD"
^DIC(19,12314,0)="SCRPW SC VETS AWAITING APPTS^SC Veterans Awaiting Appointments^^R^11748^^^^^^^16"
^DIC(19,12314,1,0)="^^14^14^3020826^"
^DIC(19,12314,1,1,0)="This option produces a report in two different formats regarding Service"
^DIC(19,12314,1,2,0)="Connected veterans awaiting appointments.  One format returns SC veterans "
^DIC(19,12314,1,3,0)="entered in the past year that have not been given an appointment.  The "
^DIC(19,12314,1,4,0)="other format returns SC veterans with appointments in the future where "
^DIC(19,12314,1,5,0)="the scheduled appointment date is more than 30 days beyond the 'desired "
^DIC(19,12314,1,6,0)="date' defined for that appointment.  "
^DIC(19,12314,1,7,0)=" "
^DIC(19,12314,1,8,0)="Both report formats include patient identifiers, eligibility, address and "
^DIC(19,12314,1,9,0)="phone number.  For patients that are 0-50% service connected, a list of "
^DIC(19,12314,1,10,0)="rated service connected disabilities is included.  With the format "
^DIC(19,12314,1,11,0)="related to future appointments, those appointments that are greater than "
^DIC(19,12314,1,12,0)="30 days beyond the 'desired date' are also displayed."
^DIC(19,12314,1,13,0)=" "
^DIC(19,12314,1,14,0)="The reports are available in detailed or statistics only formats."
^DIC(19,12314,25)="SCRPW62"
^DIC(19,12314,"U")="SC VETERANS AWAITING APPOINTME"
^DIC(19,12315,0)="XU-INSTITUTION-DEA^Institution DEA# edit^^E^10000000020^XUMGR^^^^^^163^n"
^DIC(19,12315,1,0)="^^2^2^3030220^"
^DIC(19,12315,1,1,0)="This option allows the editing of the Facility DEA number in the "
^DIC(19,12315,1,2,0)="Institution file."
^DIC(19,12315,30)="DIC(4,"
^DIC(19,12315,31)="AEMQ"
^DIC(19,12315,50)="DIC(4,"
