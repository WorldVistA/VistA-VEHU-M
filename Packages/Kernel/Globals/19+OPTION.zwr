^DIC(19,10511,"U")="PATIENT ENROLLMENT"
^DIC(19,10512,0)="SRO PCE NOTRANS^Outpatient Encounters Not Transmitted to NPCD^^R^11701^^^^^^^167^^1^1"
^DIC(19,10512,1,0)="^^23^23^2970903^"
^DIC(19,10512,1,1,0)="Outpatient surgical and non-OR procedures that are filed as encounters in"
^DIC(19,10512,1,2,0)="the Patient Care Encounters (PCE) package without an active, count clinic"
^DIC(19,10512,1,3,0)="identified for each encounter are not transmitted to the National Patient"
^DIC(19,10512,1,4,0)="Care Database (NPCD) as workload.  This option may be used as a tool for"
^DIC(19,10512,1,5,0)="identifying these encounters that represent uncounted workload so that"
^DIC(19,10512,1,6,0)="corrective actions may be taken in the Surgery package to insure these"
^DIC(19,10512,1,7,0)="procedures are associated with an active, count clinic.  After corrections"
^DIC(19,10512,1,8,0)="are made, these encounters may be re-filed with PCE to be transmitted to"
^DIC(19,10512,1,9,0)="NPCD."
^DIC(19,10512,1,10,0)=" "
^DIC(19,10512,1,11,0)="This option provides functionality:"
^DIC(19,10512,1,12,0)=" - To count and/or list surgical cases and non-OR procedures that have"
^DIC(19,10512,1,13,0)="   entries in PCE but have no matching entries in the OUTPATIENT ENCOUNTER"
^DIC(19,10512,1,14,0)="   file (#409.68) or have matching entries that are non-count encounters"
^DIC(19,10512,1,15,0)="   or encounters requiring action."
^DIC(19,10512,1,16,0)=" - To re-file with PCE the cases identified as having no matching entries"
^DIC(19,10512,1,17,0)="   in the OUTPATIENT ENCOUNTER file (#409.68) or having matching entries"
^DIC(19,10512,1,18,0)="   that are non-count encounters or encounters requiring action."
^DIC(19,10512,1,19,0)=" "
^DIC(19,10512,1,20,0)="Both the report and the re-filing process may be run for OR surgical"
^DIC(19,10512,1,21,0)="cases, non-OR procedures or both.  The report and the re-filing process"
^DIC(19,10512,1,22,0)="may be run for a specific specialty or for all specialties and may be run"
^DIC(19,10512,1,23,0)="for a selected date range."
^DIC(19,10512,15)="D EXIT^SROVAR"
^DIC(19,10512,20)="D ^SROVAR"
^DIC(19,10512,22)="Q"
^DIC(19,10512,25)="SROPCEU"
^DIC(19,10512,"U")="OUTPATIENT ENCOUNTERS NOT TRAN"
^DIC(19,10513,0)="PRSE-SERV-TRAIN-RPT^Training Report by Service^^R^11596^^^^^^^"
^DIC(19,10513,1,0)="^^4^4^2970702^"
^DIC(19,10513,1,1,0)="This report shows training taken by all employees within the "
^DIC(19,10513,1,2,0)="selected service(s).  The report groups each Cost Center/Organization"
^DIC(19,10513,1,3,0)="together within the service.  You may select a date range, calender"
^DIC(19,10513,1,4,0)="year or fiscal year.  You may select different types of training."
^DIC(19,10513,25)="EN1^PRSEEMP3"
^DIC(19,10513,"U")="TRAINING REPORT BY SERVICE"
