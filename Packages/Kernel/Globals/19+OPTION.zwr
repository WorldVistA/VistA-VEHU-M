^DIC(19,15001,1,0)="^19.06^3^3^3210910^^^^"
^DIC(19,15001,1,1,0)="This option displays either all sent or received interfacility insurance "
^DIC(19,15001,1,2,0)="update records.  The report can be generated as a summary or detailed to "
^DIC(19,15001,1,3,0)="provide insurance details."
^DIC(19,15001,25)="EN^IBCNIUR1"
^DIC(19,15001,"U")="INTERFACILITY INS. UPDATE REPO"
^DIC(19,15002,0)="IBCNE PAYER LINK REPORT^Payer Link Report^^R^1^^^^^^^"
^DIC(19,15002,1,0)="^19.06^2^2^3211018^^^^"
^DIC(19,15002,1,1,0)="This report shows the relationship between the insurance companies in "
^DIC(19,15002,1,2,0)="file #36 and the payers in file #365.12."
^DIC(19,15002,25)="EN^IBCNERPB"
