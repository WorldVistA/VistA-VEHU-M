^DIC(19,10885,0)="LA7S EDIT 62.9^Edit Shipping Configuration^^R^11712^^^^^^^480"
^DIC(19,10885,1,0)="^^3^3^2970717^^^"
^DIC(19,10885,1,1,0)="This option sets up the LAB SHIPPING CONFIGURATION file (#62.9)."
^DIC(19,10885,1,2,0)="Sites use this option to define and configure a lab shipping"
^DIC(19,10885,1,3,0)="configuration."
