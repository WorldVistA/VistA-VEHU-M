^DIC(19,9683,0)="ECCP1^*Summary of Procedures and Categories (Old File)^OPTION NO LONGER SUPPORTED. USE THE ECS GUI INTERFACE.^R^11596^^2964^^^^^499^^^1"
^DIC(19,9683,1,0)="^^8^8^2970911^"
^DIC(19,9683,1,1,0)="This option prints a category and procedure summary from the"
^DIC(19,9683,1,2,0)="EVENT CAPTURE SCREENING file (#720.2) that contained the"
^DIC(19,9683,1,3,0)="event code screens utilized in the Event Capture pilot software."
^DIC(19,9683,1,4,0)="This report is retained in this version to assist users in the"
^DIC(19,9683,1,5,0)="creation of their new event code screens."
^DIC(19,9683,1,6,0)=" "
^DIC(19,9683,1,7,0)="This option, as well as file #720.2, is obsolete and has been starred for"
^DIC(19,9683,1,8,0)="deletion with patch EC*2*5."
^DIC(19,9683,15)="W @IOF"
^DIC(19,9683,25)="ECSUN"
^DIC(19,9683,"U")="*SUMMARY OF PROCEDURES AND CAT"
^DIC(19,9684,0)="ECBATCH PROC^Data Entry (Batch) by Procedure^OPTION NO LONGER SUPPORTED. USE THE ECS GUI INTERFACE.^R^.5^^2965^^^^^^^^1"
^DIC(19,9684,1,0)="^^3^3^2960402^^^^"
^DIC(19,9684,1,1,0)="This option allows users to batch enter patient workload by a"
^DIC(19,9684,1,2,0)="procedural order. For a given DSS unit and procedure, users"
^DIC(19,9684,1,3,0)="can batch enter patient data, ordering section, and volume."
^DIC(19,9684,15)="W @IOF"
^DIC(19,9684,25)="ECBEP"
^DIC(19,9684,"U")="DATA ENTRY (BATCH) BY PROCEDUR"
^DIC(19,9685,0)="ONCO #STATE DATA DISK^Create State Data Download^^R^1^^^^^^^^^^"
^DIC(19,9685,1,0)="^^6^6^2970725^^^^"
^DIC(19,9685,1,1,0)="This option will allow for the creation of a disk to be "
^DIC(19,9685,1,2,0)="for transmission of cancer registry information"
^DIC(19,9685,1,3,0)="including confidential patient identity data to the State"
^DIC(19,9685,1,4,0)="collecting agencies.  The length of the strings gathered"
^DIC(19,9685,1,5,0)="here are 1150 characters as opposed to the 850 character"
^DIC(19,9685,1,6,0)="ACOS data strings."
^DIC(19,9685,15)=""
^DIC(19,9685,25)="EN1^ONCACD0(0,1)"
^DIC(19,9685,"U")="CREATE STATE DATA DOWNLOAD"
^DIC(19,9686,0)="GMRG-PURGE PT DATA^Purge GMR Text File Data^^R^755^^^^^^^504"
^DIC(19,9686,1,0)="^^5^5^2960415^^"
^DIC(19,9686,1,1,0)="The purge GMR Text File Data [GMRG-PURGE PT DATA] option allows the site"
^DIC(19,9686,1,2,0)="to purge data from the GMR Text (124.3) and NURS Care Plan (216.8) files."
^DIC(19,9686,1,3,0)="This option should only be assigned to IRM personnel, and prior to its"
^DIC(19,9686,1,4,0)="running, IRM should notify Nursing and figure out how many months of data"
^DIC(19,9686,1,5,0)="is to be retained."
^DIC(19,9686,25)="EN1^GMRGARC0"
^DIC(19,9686,"U")="PURGE GMR TEXT FILE DATA"
