^DIC(19,8428,0)="LR WKLD MANUAL INPUT^Workload manual input^^E^.5^^^^^^^26"
^DIC(19,8428,1,0)="^^3^3^2940328^^"
^DIC(19,8428,1,1,0)=" This option will allow the LIM to update the workload data."
^DIC(19,8428,1,2,0)="This may be necessary after a computer down time or special workload data"
