^DIC(19,5275,1,0)="^^2^2^2900929^"
^DIC(19,5275,1,1,0)="This option displays selected fields from the Equipment Inv. file"
^DIC(19,5275,1,2,0)="(#6914)."
^DIC(19,5275,20)="S ECT1=""EQT"""
