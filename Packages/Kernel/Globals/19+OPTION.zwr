^DIC(19,11870,0)="TIU TEMPLATE DELETE TERM ALL^Delete templates for ALL terminated users.^^A^10000000020^^^^^^^516^^1"
^DIC(19,11870,1,0)="^^3^3^3010314^"
^DIC(19,11870,1,1,0)="This option allows a CAC or other manager to remove all non-shared TIU"
^DIC(19,11870,1,2,0)="templates for all users who have been terminated.  It orders through the"
^DIC(19,11870,1,3,0)="files recursively and then deletes those that have not been shared."
^DIC(19,11870,20)="D CTRL^TIUSRVT4"
^DIC(19,11870,"U")="DELETE TEMPLATES FOR ALL TERMI"
^DIC(19,11871,0)="OR PERFORMANCE MONITOR^Performance Monitor Report^^R^10000000020^^^^^^^170"
^DIC(19,11871,1,0)="^^8^8^3010306^"
^DIC(19,11871,1,1,0)="This option produces a report showing the number of orders entered by"
^DIC(19,11871,1,2,0)="provider.  The report includes a detailed listing as well as a summary."
^DIC(19,11871,1,3,0)="The detail listing includes pertinent information about each order"
^DIC(19,11871,1,4,0)="associated with the listed provider.  The summary report shows the number"
^DIC(19,11871,1,5,0)="of orders entered for a provider, the number of orders entered by an ORES"
^DIC(19,11871,1,6,0)="key holder, the percentage of orders entered by an ORES key holder for the"
^DIC(19,11871,1,7,0)="given provider and a break down of the orders by nature of order for those"
^DIC(19,11871,1,8,0)="that were entered by a non-ORES key holder."
^DIC(19,11871,25)="ORPRPM"
^DIC(19,11871,"U")="PERFORMANCE MONITOR REPORT"
^DIC(19,11872,0)="LR LOINC MAP DEFAULT^Map Lab Tests to Default LOINC Code^^R^10000000020^^^^^^^26"
^DIC(19,11872,1,0)="^19.06^4^4^3000922^^"
^DIC(19,11872,1,1,0)="This option allows you to map a lab test to a default LOINC code."
^DIC(19,11872,1,2,0)="A default LOINC code is a LOINC code for a lab test without a"
^DIC(19,11872,1,3,0)="specimen defined.  If you perform this test and the specimen is "
^DIC(19,11872,1,4,0)="not in the TOPOGRAPHY file, then the default code is used."
^DIC(19,11872,25)="LRLNCMD"
^DIC(19,11872,"U")="MAP LAB TESTS TO DEFAULT LOINC"
^DIC(19,11873,0)="LR LOINC UNMAP/DELETE LOINC^Unmap/Delete Lab Tests to LOINC Codes^^R^10000000020^^^^^^^26"
^DIC(19,11873,1,0)="^19.06^1^1^3000424^^"
^DIC(19,11873,1,1,0)="This option allows you to unmap or delete LOINC code mappings."
^DIC(19,11873,25)="LRLNCDEL"
^DIC(19,11873,"U")="UNMAP/DELETE LAB TESTS TO LOIN"
^DIC(19,11874,0)="LR LOINC UNMAP/DELETE DEFAULT^Unmap/Delete Lab Tests to Default LOINC Code^^R^10000000020^^^^^^^26"
^DIC(19,11874,1,0)="^19.06^1^1^3000424^^"
^DIC(19,11874,1,1,0)="This option allows you to unmap or delete default LOINC code mappings."
^DIC(19,11874,25)="DELETE^LRLNCMD"
^DIC(19,11874,"U")="UNMAP/DELETE LAB TESTS TO DEFA"
^DIC(19,11875,0)="LR LOINC PRINT LOINC CODE^Print a Single LOINC CODE^^R^10000000020^^^^^^y^26"
^DIC(19,11875,1,0)="^^1^1^3000922^"
^DIC(19,11875,1,1,0)="This option allows you to print a single LOINC code."
^DIC(19,11875,25)="LRLNCLK"
^DIC(19,11875,"U")="PRINT A SINGLE LOINC CODE"
^DIC(19,11876,0)="LR LOINC PRINT DEFAULT/LOINC^Print Default LOINC/LOINC Code by Lab Tests^Obsolete Menu Item^R^10000000020^^^^^^^26"
^DIC(19,11876,1,0)="^^2^2^3010919^"
^DIC(19,11876,1,1,0)="This option is obsolete. You can use one of the other menu items on the"
^DIC(19,11876,1,2,0)="LOINC Mapping Utility Menu [LR LOINC UTILITY]."
^DIC(19,11876,25)="LRLNCSUF"
^DIC(19,11876,"U")="PRINT DEFAULT LOINC/LOINC CODE"
^DIC(19,11878,0)="LR LOINC EXTRACT LAB NAMES^Extract VistA Lab Test Names^^R^10000000020^^^^^^^26"
^DIC(19,11878,1,0)="^^5^5^3010823^"
^DIC(19,11878,1,1,0)="This option allows you to capture the VistA lab tests."
^DIC(19,11878,1,2,0)="Copy and save the capture data into a text file. Using WordPad, edit the"
^DIC(19,11878,1,3,0)="text file removing extraneous data to ensure the capture only contains the"
^DIC(19,11878,1,4,0)="lab tests. Use RELMA to find the proper LOINC codes for all your lab"
^DIC(19,11878,1,5,0)="tests, and then use the VistA LOINC mapping options to map in VistA."
^DIC(19,11878,25)="LRLNCX"
^DIC(19,11878,"U")="EXTRACT VISTA LAB TEST NAMES"
