^DIC(19,16062,0)="EHM-00883^Report for Respiratory Therapy Medications^^R^1^^^^^^^533^^^^"
^DIC(19,16062,1,0)="^^4^4^3240328^"
^DIC(19,16062,1,1,0)="This report is used by Respiratory Therapists to track "
