^DIC(19,15258,662000)="^^^^^^1"
^DIC(19,15258,"U")="CONSULT CLOSURE TOOL EDIT CONF"
^DIC(19,15259,0)="EHM-00080^Consult Closure Tool Inquire Configuration^^I^1^^^^^^^294^^^^"
^DIC(19,15259,1,0)="^19.06^3^3^3240328^^^^"
^DIC(19,15259,1,1,0)="This option is used by the Consult Closure Tool to examine configuration"
^DIC(19,15259,1,2,0)="file entries that associate consults, clinics, and note titles."
^DIC(19,15259,1,3,0)="Cloned from ""GMRC CONSULT CLOSE TOOL INQ"" option."
^DIC(19,15259,3)=""
^DIC(19,15259,30)="GMR(123.033,"
^DIC(19,15259,31)="AEMNQZ"
^DIC(19,15259,32)="Select CONSULT CONFIGURATION: "
^DIC(19,15259,63)="[GMRC CONSULT MAPPING INQIRE]"
^DIC(19,15259,67)="Consult Closure Tool Configuration"
