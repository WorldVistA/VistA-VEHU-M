^DIC(19,717,51)=""
^DIC(19,717,"U")="STOCK ITEMS - ENTER/EDIT"
^DIC(19,718,0)="PSGW INACTIVATE AOU STOCK ITEM^Inactivate AOU Stock Item^^R^.5^^^^^^^"
^DIC(19,718,1,0)="^^2^2^2930518^^^^"
^DIC(19,718,1,1,0)="Use this option to inactivate an item that is currently on an AOU's"
^DIC(19,718,1,2,0)="stock list.  Items should not be deleted, but simply made inactive."
^DIC(19,718,25)="PSGWBGIN"
