^DIC(19,12231,0)="IBCE 837 EDI REPORTS^EDI Return Message Management^^M^10000000020^^^^^^^192"
^DIC(19,12231,1,0)="^19.06^7^7^3010705^^^^"
^DIC(19,12231,1,1,0)="This menu contains the options needed to define the types of electronic"
^DIC(19,12231,1,2,0)="reports from the clearinghouse that the site needs to see and defines"
^DIC(19,12231,1,3,0)="the text that should/should not allow automatic review and file for"
^DIC(19,12231,1,4,0)="informational status messages.  It also contains an option to purge old"
^DIC(19,12231,1,5,0)="status messages, reports for maintaining the integrity of the return"
^DIC(19,12231,1,6,0)="message subsystem and the option for reviewing electronically returned"
^DIC(19,12231,1,7,0)="messages."
^DIC(19,12231,10,0)="^19.01IP^16^16"
