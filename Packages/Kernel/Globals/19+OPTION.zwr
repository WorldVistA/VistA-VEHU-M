^DIC(19,16155,"U")="PATIENT HEALTH SUMMARY"
^DIC(19,16156,0)="EHM-00977^Hospital Location Health Summary^^R^1^^^^^n^^160^^^^"
^DIC(19,16156,1,0)="^^5^5^3240328^"
^DIC(19,16156,1,1,0)="Allows user to print health summaries interactively for all patients on a"
^DIC(19,16156,1,2,0)="specified ward(s), for all patients with appointments at a specified"
^DIC(19,16156,1,3,0)="outpatient clinic(s), or for all patients scheduled for a specified"
^DIC(19,16156,1,4,0)="operating room(s) on a selected day or range of days."
^DIC(19,16156,1,5,0)="Cloned from ""GMTS HS BY LOC"" option."
^DIC(19,16156,2)="y"
^DIC(19,16156,3)=""
