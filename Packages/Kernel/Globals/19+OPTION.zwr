^DIC(19,13197,1,0)="^^6^6^3061016^"
^DIC(19,13197,1,1,0)="This report lists patients who were on a Wait List for a particular"
^DIC(19,13197,1,2,0)="Clinic or Specialty and were not removed from the Wait List when an"
^DIC(19,13197,1,3,0)="appointment was made for that Clinic or Specialty.  The report displays"
^DIC(19,13197,1,4,0)="the patient's name and the last 4 of the patient's Social Security"
^DIC(19,13197,1,5,0)="Number along with the Originating Date, Non-Removal Date and Non-Removal"
^DIC(19,13197,1,6,0)="Reason.  The user's name and EWL record Status is also included."
^DIC(19,13197,60)="SDWL(409.3,"
^DIC(19,13197,63)="[SDWLDNR]"
^DIC(19,13197,64)="[SDWLDNR]"
