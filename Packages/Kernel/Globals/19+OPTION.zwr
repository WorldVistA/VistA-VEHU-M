^DIC(19,13548,"U")="EPHARMACY MEDICATION PROFILE D"
^DIC(19,13549,0)="PSO IGNORED REJECTS REPORT^Ignored Rejects Report^^R^10000000020^^^^^^^141"
^DIC(19,13549,25)="PSOBPSRP"
^DIC(19,13549,"U")="IGNORED REJECTS REPORT"
^DIC(19,13550,0)="PSO AUTO REFILL INITIALIZE^Automate Internet Refill^^R^1^^^^^^^141"
^DIC(19,13550,1,0)="^^3^3^3070730^"
^DIC(19,13550,1,1,0)="This option initializes a job that will automatically process the "
^DIC(19,13550,1,2,0)="refill requests placed via the Internet. You require PSOAUTRF key to use "
^DIC(19,13550,1,3,0)="this option."
^DIC(19,13550,25)="SETUP^PSOATRF"
^DIC(19,13550,"U")="AUTOMATE INTERNET REFILL"
^DIC(19,13551,0)="PSO AUTO REFILL^Automate Internet Refill^^R^1^^^^^^^141"
^DIC(19,13551,1,0)="^19.06^3^3^3070803^^"
^DIC(19,13551,1,1,0)="Refill request entries in the PRESCRIPTION REFILL REQUEST file (#52.43)"
^DIC(19,13551,1,2,0)="(Internet Refill requests) will be processed and placed on suspense for"
^DIC(19,13551,1,3,0)="the appropriate calculated fill date and a routing of Mail."
^DIC(19,13551,25)="PSOATRF"
^DIC(19,13551,"U")="AUTOMATE INTERNET REFILL"
