^DIC(19,4327,0)="PRCHPM CS ADD TO BATCH^Add Code Sheet to Printed Batch (LOG/GSA/DLA)^^R^11740^PRCHPM CS TRANSMIT^^^^^^"
^DIC(19,4327,1,0)="^19.06^8^8^3000608^^^^"
^DIC(19,4327,1,1,0)="This option allows the user to add a code sheet to a batch, after the batch"
^DIC(19,4327,1,2,0)="has already been ""Batched and Printed"", but before it has been transmitted"
^DIC(19,4327,1,3,0)="to Austin."
