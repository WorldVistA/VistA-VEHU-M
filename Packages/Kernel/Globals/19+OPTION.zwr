^DIC(19,16323,"U")="PCE HS/RPT PARAMETER MENU"
^DIC(19,16324,0)="EHM-01145^PCE Report Parameter Edit^^E^1^^^^^^^507^^^^"
^DIC(19,16324,1,0)="^^10^10^3240328^"
^DIC(19,16324,1,1,0)="This option is used to define parameters that will be used by the PCE"
^DIC(19,16324,1,2,0)="Report Module.  The user will need to identify which clinics are viewed by"
^DIC(19,16324,1,3,0)="clinicians as being Emergency Room clinics.  The user will also need to"
^DIC(19,16324,1,4,0)="identify the lab test names that are used by your site to identify the"
^DIC(19,16324,1,5,0)="following types of Lab tests: Glucose, Cholesterol, LDL Cholesterol, and"
^DIC(19,16324,1,6,0)="HBA1C."
^DIC(19,16324,1,7,0)=" "
^DIC(19,16324,1,8,0)="To get a print out of current definitions in the PCE Parameters fields for"
^DIC(19,16324,1,9,0)="these fields, use the PCE HS/RPT Parameters Print."
^DIC(19,16324,1,10,0)="Cloned from ""PX REPORT PARAMETER EDIT"" option."
^DIC(19,16324,3)=""
^DIC(19,16324,30)="PX(815,"
^DIC(19,16324,31)="QAMEZL"
^DIC(19,16324,50)="PX(815,"
^DIC(19,16324,51)="801:805"
^DIC(19,16324,53)="BACKOUTOK"
^DIC(19,16324,"U")="PCE REPORT PARAMETER EDIT"
^DIC(19,16325,0)="EHM-01146^PCE HS/RPT Parameters Print^^P^1^^^^^^y^507^^^^"
^DIC(19,16325,1,0)="^^5^5^3240328^"
^DIC(19,16325,1,1,0)="This option prints the current PCE Parameter definitions that are used by"
^DIC(19,16325,1,2,0)="some of the PCE Reports. A brief explanation is included about editing and"
^DIC(19,16325,1,3,0)="viewing health summary disclaimers that are now managed from the Clinical"
^DIC(19,16325,1,4,0)="Reminders package."
^DIC(19,16325,1,5,0)="Cloned from ""PX HS/RPT PARAMETERS PRINT"" option."
^DIC(19,16325,3)=""
^DIC(19,16325,60)="PX(815,"
^DIC(19,16325,61)=""
^DIC(19,16325,62)=0
^DIC(19,16325,63)="[PX HS/RPT PARAMETERS PRINT]"
^DIC(19,16325,64)="[PX PARAMETERS PRINT]"
^DIC(19,16325,"U")="PCE HS/RPT PARAMETERS PRINT"
^DIC(19,16326,0)="EHM-01147^PCE Device Interface Error Report^^R^1^^^^^^^507^^^^"
^DIC(19,16326,1,0)="^^2^2^3240328^^"
^DIC(19,16326,1,1,0)="This produces an error report for PCE device interface errors."
^DIC(19,16326,1,2,0)="Cloned from ""PXEDI"" option."
^DIC(19,16326,3)=""
^DIC(19,16326,10.1)="Device Interface Error Report"
^DIC(19,16326,25)="PXEDIM"
^DIC(19,16326,"U")="PCE DEVICE INTERFACE ERROR REP"
^DIC(19,16327,0)="EHM-01148^PCE Encounter Viewer^^A^1^^^^^^^507^^1^^"
^DIC(19,16327,1,0)="^^7^7^3240328^"
^DIC(19,16327,1,1,0)="This option is for users who can view a clinical encounter in the V-files"
^DIC(19,16327,1,2,0)="(visit-related files) with out being able to add, edit or delete any"
^DIC(19,16327,1,3,0)="information. The data viewable via this option includes visit information"
^DIC(19,16327,1,4,0)="(where and when), and the following clinical data related to the visit:"
^DIC(19,16327,1,5,0)="providers of care, problems treated, procedures and treatments done, and"
^DIC(19,16327,1,6,0)="immunizations, skin tests, and patient education given."
^DIC(19,16327,1,7,0)="Cloned from ""PXCE ENCOUNTER VIEWER"" option."
^DIC(19,16327,3)=""
^DIC(19,16327,10.1)="VIEW"
^DIC(19,16327,20)="D EN^PXCE(""V"")"
^DIC(19,16327,99.1)="56179,36316"
^DIC(19,16327,"U")="PCE ENCOUNTER VIEWER"
^DIC(19,16328,0)="EHM-01149^CIDC Missing Data Report^^R^1^^^^^^^507^^^^"
^DIC(19,16328,1,0)="^^3^3^3240328^"
^DIC(19,16328,1,1,0)="This produces a report of missing Clinical Indicator Data"
^DIC(19,16328,1,2,0)="Collection (CIDC) data"
^DIC(19,16328,1,3,0)="Cloned from ""PXRRMDR"" option."
^DIC(19,16328,3)=""
^DIC(19,16328,10.1)="CIDC Missing Data Report"
^DIC(19,16328,25)="EN^PXRRMDR"
^DIC(19,16328,"U")="CIDC MISSING DATA REPORT"
^DIC(19,16329,0)="EHM-01150^Accounting Of Immunization Disclosures Report^^R^1^^^^^^^^^^^"
^DIC(19,16329,1,0)="^^9^9^3240328^"
^DIC(19,16329,1,1,0)="This option is used for generating a list of immunization administration"
^DIC(19,16329,1,2,0)="records transmitted to external agencies. This option allows for a date"
^DIC(19,16329,1,3,0)="range selection as well as one, multiple or all agencies and one, multiple"
^DIC(19,16329,1,4,0)="or all patients. The list is sorted by disclosure date/time, agency, and"
^DIC(19,16329,1,5,0)="then by patient."
^DIC(19,16329,1,6,0)=" "
^DIC(19,16329,1,7,0)="Note: This report must be printed to a 132 column device in order to view "
^DIC(19,16329,1,8,0)="the entire data set."
^DIC(19,16329,1,9,0)="Cloned from ""PXV IMM DISCLOSURE REPORT"" option."
^DIC(19,16329,3)=""
^DIC(19,16329,25)="MAIN^PXVDIS"
^DIC(19,16329,"U")="ACCOUNTING OF IMMUNIZATION DIS"
^DIC(19,16330,0)="EHM-01151^Directions to Patient's Home Add/Edit^^E^1^^^^^^^^^^^"
^DIC(19,16330,1,0)="^^6^6^3240328^^"
^DIC(19,16330,1,1,0)="This option lets you enter directions to a patient's home - especially"
^DIC(19,16330,1,2,0)="useful for Hospital-Based Home Care staff."
^DIC(19,16330,1,3,0)=" "
^DIC(19,16330,1,4,0)="The Health Summary package contains a new PCE component that displays the"
^DIC(19,16330,1,5,0)="directions entered through this option."
^DIC(19,16330,1,6,0)="Cloned from ""PX EDIT LOCATION OF HOME"" option."
