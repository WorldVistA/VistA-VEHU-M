^DIC(19,17124,0)="EHM_DISCHARGE SUMMARY^Summary of Patients to be Discharged^^R^1^^^^^^^594"
^DIC(19,17124,1,0)="^19.06^2^2^3240718^^"
^DIC(19,17124,1,1,0)="This option produces a summary sorted by institution and ward of patients"
^DIC(19,17124,1,2,0)="to be discharged on the night of conversion to Cerner."
^DIC(19,17124,25)="SUMMARY^EHMDISCH"
^DIC(19,17124,"U")="SUMMARY OF PATIENTS TO BE DISC"
^DIC(19,17125,0)="EHM_DISCHARGE MENU^Patient Discharge Menu^^M^1^EHM_AUTO-DISCHARGE^^^^^^594"
^DIC(19,17125,1,0)="^19.06^2^2^3250908^^^^"
^DIC(19,17125,1,1,0)="Main menu for the Automated Patient Discharge Tool that is used on night"
^DIC(19,17125,1,2,0)="of cutover to Cerner."
