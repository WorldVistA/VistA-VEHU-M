^DIC(19,11788,0)="DGRU DATA SEED^Seed Accu-Max Database^^R^11740^^^^^^y^"
^DIC(19,11788,1,0)="^^6^6^3000726^"
^DIC(19,11788,1,1,0)="This option will create an Admit (A01) HL7 message for every patient in"
^DIC(19,11788,1,2,0)="an RAI/MDS Ward assigned to the selected division.  The purpose of this"
^DIC(19,11788,1,3,0)="option is to do the initial seeding of the Accu-Max database with"
^DIC(19,11788,1,4,0)="patients currently in RAI/MDS Wards.  This should only be done once"
^DIC(19,11788,1,5,0)="for each division, and the Accu-Max database should have an empty"
^DIC(19,11788,1,6,0)="patient database for the selected division when run."
^DIC(19,11788,25)="DGRUGDS"
^DIC(19,11788,"U")="SEED ACCU-MAX DATABASE"
^DIC(19,11789,0)="ORX PARAM TAB PREF^Tab Default Chart Preferences^^R^11740^^^^^^^"
^DIC(19,11789,1,0)="^19.06^2^2^3000511^^^^"
^DIC(19,11789,1,1,0)="This option allows users to set their parameter preferences for the tabs"
^DIC(19,11789,1,2,0)="in OE/RR."
^DIC(19,11789,25)="EN^ORXTABS"
^DIC(19,11789,"U")="TAB DEFAULT CHART PREFERENCES"
^DIC(19,11790,0)="OR UNSIGNED ORDERS^Unsigned orders search^^R^11740^^^^^^^170"
^DIC(19,11790,1,0)="^^13^13^2990402^"
^DIC(19,11790,1,1,0)="This option will allow the user to search for either RELEASED but UNSIGNED"
^DIC(19,11790,1,2,0)="orders or just UNSIGNED orders and sort them by Service/section, Provider,"
^DIC(19,11790,1,3,0)="Patient, or Location."
^DIC(19,11790,1,4,0)=" "
^DIC(19,11790,1,5,0)="A start date entry will allow the site to ignore unsigned orders that fall"
^DIC(19,11790,1,6,0)="within their allowed grace period. For example: the site allows the"
^DIC(19,11790,1,7,0)="clinician 48 hours to sign unsigned orders, you would enter T-2 for a"
^DIC(19,11790,1,8,0)="start date."
^DIC(19,11790,1,9,0)=" "
^DIC(19,11790,1,10,0)="A stop date entry will allow the site to ignore orders older than the date"
^DIC(19,11790,1,11,0)="entered. An example of this would be, if you wanted to ignore unsigned"
^DIC(19,11790,1,12,0)="orders that were placed prior to CPRS and you installed CPRS on Jan 1,"
^DIC(19,11790,1,13,0)="1999, you would enter 010199."
^DIC(19,11790,25)="EN^ORS100"
^DIC(19,11790,"U")="UNSIGNED ORDERS SEARCH"
^DIC(19,11791,0)="OR NATURE/STATUS ORDER SEARCH^Search orders by Nature or Status^^R^11740^^^^^^^"
^DIC(19,11791,1,0)="^^8^8^2990606^"
^DIC(19,11791,1,1,0)="This option will allow the user to search orders for a specific NATURE OF"
^DIC(19,11791,1,2,0)="ORDER or order STATUS. There are two formats available. one is a detailed"
^DIC(19,11791,1,3,0)="display that is printed in real time as the order number that meets the"
^DIC(19,11791,1,4,0)="search criteria is encountered. There is no further sort capability for"
^DIC(19,11791,1,5,0)="this format. The second format is the columnar format which will allow the"
^DIC(19,11791,1,6,0)="sort by ENTERING person or by SERVICE/SECTION. This format works best if"
^DIC(19,11791,1,7,0)="sending the output to a 132 column compressed printer or to the BROWSER"
^DIC(19,11791,1,8,0)="device."
^DIC(19,11791,25)="EN^ORSNAST"
^DIC(19,11791,99)="57865,60196"
^DIC(19,11791,"U")="SEARCH ORDERS BY NATURE OR STA"
^DIC(19,11803,0)="ECXSCX^Clinic Visit Extract^^R^10000000020^^^^^^^513"
^DIC(19,11803,1,0)="^19.06^5^5^3000629^^^^"
^DIC(19,11803,1,1,0)="Extract Clinic visit data."
^DIC(19,11803,1,2,0)="This option provides the extract manager the ability to extract the"
^DIC(19,11803,1,3,0)="clinic visit data for a selected date range. This data is stored in the"
^DIC(19,11803,1,4,0)="CLINIC EXTRACT file (#727.827) "
^DIC(19,11803,1,5,0)="until data is transmitted to the commercial vendor."
^DIC(19,11803,25)="BEG^ECXSCXN"
^DIC(19,11803,"U")="CLINIC VISIT EXTRACT"
