^DIC(19,11268,"U")="INVENTORY TASK BALANCE CHECK"
^DIC(19,11269,0)="RMPR EDT/COMP ISSUE^Edit/Complete Issue From Stock^^R^11596^^^^^^^"
^DIC(19,11269,1,0)="^^5^5^2990115^"
^DIC(19,11269,1,1,0)="This is an option to Edit or Complete a Lab issue from stock"
^DIC(19,11269,1,2,0)="for items issued in the LAB.  Only the Lab Technician should run this"
^DIC(19,11269,1,3,0)="option.  Under this option, a technician has the ability to EDIT and"
^DIC(19,11269,1,4,0)="CLOSE a lab issue.  When a technician elects to close the lab issue"
^DIC(19,11269,1,5,0)="the Pre-determined time for an item will be posted to the patient's 2319."
^DIC(19,11269,25)="RMPR29LC"
^DIC(19,11269,"U")="EDIT/COMPLETE ISSUE FROM STOCK"
^DIC(19,11270,0)="RMPR EDIT LAB STOCK ISSUE^Edit Lab Issue from Stock^USE STANDARD ISSUE FROM STOCK^R^11740^^^^^^^"
^DIC(19,11270,1,0)="^^3^3^2990107^"
^DIC(19,11270,1,1,0)="This is an option for the Admin Clerk to EDIT a Lab Issue from Stock"
^DIC(19,11270,1,2,0)="request. User should be able to ADD or EDIT lab items to be completed by"
^DIC(19,11270,1,3,0)="the Lab Technician."
^DIC(19,11270,25)="EDT^RMPR29LI"
^DIC(19,11270,"U")="EDIT LAB ISSUE FROM STOCK"
