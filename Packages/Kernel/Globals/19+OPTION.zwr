^DIC(19,13851,1,0)="^19.06^5^5^3090508^^^"
^DIC(19,13851,1,1,0)="This option runs a routine that checks a selected reminder dialog for invalid"
^DIC(19,13851,1,2,0)="sub dialog items, invalid finding items, invalid TIU Objects, and/or invalid"
