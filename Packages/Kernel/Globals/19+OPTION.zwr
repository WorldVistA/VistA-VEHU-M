^DIC(19,3483,0)="XT-OPTION TEST^Test an option not in your menu^^A^10000000020^XUMGR^^^^^^^^1^1^"
^DIC(19,3483,1,0)="^19.06^3^3^3010417^^^^"
^DIC(19,3483,1,1,0)="This is for in-house testing of options only.  It allows the selection of"
^DIC(19,3483,1,2,0)="an option from the OPTION file and then executes it."
^DIC(19,3483,1,3,0)="No security checks are performed, therefore, this option should only be given to programmers."
^DIC(19,3483,15)=" "
^DIC(19,3483,20)="S DIC=19,DIC(0)=""AEMQZ"",DIC(""A"")=""Option entry to test: "",DIC(""S"")=""I $P(^(0),U)'[""""XUPROG"""""" D ^DIC K DIC I Y>0 S XQY=+Y,XQUR=$P(Y,U,2),XQDIC=""U"",XQY0=^DIC(19,XQY,0),^(""T"")=^XUTL(""XQ"",$J,""T"")-1 G M0^XQ"
^DIC(19,3483,99)="53824,50375"
^DIC(19,3483,99.1)="54318,55009"
^DIC(19,3483,"U")="TEST AN OPTION NOT IN YOUR MEN"
