^DIC(19,13182,0)="XUSFACHK^Check Failed Access Log^^R^10000000020^^^^^^^^y"
^DIC(19,13182,1,0)="^^9^9^3031006^"
^DIC(19,13182,1,1,0)="This option runs the Failed Access Check routine ""XUSFACHK""."
^DIC(19,13182,1,2,0)="It looks to see if there have been a large number of failed access "
^DIC(19,13182,1,3,0)="attempts since the routine was last run."
^DIC(19,13182,1,4,0)="If it finds that the number of failed access attempts is greater that the "
^DIC(19,13182,1,5,0)="limit in the Kernel system parameter field ""FAILED ATTEMPTS LIMIT - IRM"""
^DIC(19,13182,1,6,0)="during normal business hours (8am to 4:30pm) it sends a message to the"
^DIC(19,13182,1,7,0)="mail group stored in the field ""IRM MAIL GROUP"" or the limit set in Kernel"
^DIC(19,13182,1,8,0)="system parameter ""FAILED ATTEMPTS LIMIT - AOD"" after hours, it sends a"
^DIC(19,13182,1,9,0)="message to the mail group in the ""AFTER HOURS MAIL GROUP""."
^DIC(19,13182,25)="FAILED^XUSFACHK"
^DIC(19,13182,200.9)="y"
^DIC(19,13182,"U")="CHECK FAILED ACCESS LOG"
