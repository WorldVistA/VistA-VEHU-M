^DIC(19,7860,0)="XDR SEARCH ALL^Start/Halt Duplicate Search^^R^1039^^2792^^^^^349"
^DIC(19,7860,1,0)="^^8^8^2971122^"
^DIC(19,7860,1,1,0)="This utility searches a selected file for potential duplicates."
^DIC(19,7860,1,2,0)="A search on a selected file seeking potential duplicates is performed"
^DIC(19,7860,1,3,0)="using one of two methods: 1) A Basic search, which checks all records from"
^DIC(19,7860,1,4,0)="the beginning of the file, and 2) a New search, which checks only those"
^DIC(19,7860,1,5,0)="records that have been added or edited since the last search was run based"
^DIC(19,7860,1,6,0)="on a user specified cross-reference."
^DIC(19,7860,1,7,0)="This is a tasked job that can be started and halted until"
^DIC(19,7860,1,8,0)="the entire file has been checked."
^DIC(19,7860,25)="XDRDQUE"
^DIC(19,7860,99)="55439,32579"
^DIC(19,7860,"U")="START/HALT DUPLICATE SEARCH"
^DIC(19,7861,0)="XDR PRINT LIST^Print List of File Duplicates^^R^1039^^2794^^^^^349"
^DIC(19,7861,1,0)="^^4^4^2971112^^^"
^DIC(19,7861,1,1,0)="This utility prints a list of file duplicates.  You may choose"
^DIC(19,7861,1,2,0)="to print potential duplicates, verified ready to merge duplicates, not"
^DIC(19,7861,1,3,0)="ready to merge verified duplicates and merged verified duplicates.  You"
^DIC(19,7861,1,4,0)="may choose to print a brief listing or a captioned listing."
^DIC(19,7861,25)="XDRDLIST"
^DIC(19,7861,"U")="PRINT LIST OF FILE DUPLICATES"
^DIC(19,7862,0)="XDR VERIFY ALL^Verify Potential Duplicates^^R^1039^^2798^^^^^349"
^DIC(19,7862,1,0)="^^7^7^2970724^^^"
^DIC(19,7862,1,1,0)="This option is used to mark a potential duplicate as an actual duplicate"
^DIC(19,7862,1,2,0)="(OR mark a potential duplicate pair as VERIFIED - NOT DUPLICATES)."
^DIC(19,7862,1,3,0)="The 'from' and 'to' records are identified and all top level"
^DIC(19,7862,1,4,0)="patient file fields resolved and a bulletin generated informing"
^DIC(19,7862,1,5,0)="the Verified Duplicate mailgroup of the actual duplicate."
^DIC(19,7862,1,6,0)="If there is no interactive package merge that needs to"
^DIC(19,7862,1,7,0)="take place the merge process will also occur."
^DIC(19,7862,25)="XDRDPICK"
^DIC(19,7862,"U")="VERIFY POTENTIAL DUPLICATES"
^DIC(19,7863,0)="XDR OPERATIONS MENU^Operations^^M^1039^^^^^^^349^^1^1"
^DIC(19,7863,1,0)="^^2^2^2971231^^"
^DIC(19,7863,1,1,0)="This menu contains options for operations.  These options are used by the"
^DIC(19,7863,1,2,0)="primary reviewer along with the utilities menu."
^DIC(19,7863,10,0)="^19.01PI^7^3"
^DIC(19,7863,10,2,0)="7862^VPD^4"
^DIC(19,7863,10,6,0)="11448^ADR^6"
^DIC(19,7863,10,7,0)="11449^APP^2"
