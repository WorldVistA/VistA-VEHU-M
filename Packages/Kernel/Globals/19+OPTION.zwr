^DIC(19,8921,1,0)="^^5^5^2950311^"
^DIC(19,8921,1,1,0)="This option will fix a survey response which may have exited abnormally as"
^DIC(19,8921,1,2,0)="in when a job was killed or a system crash."
^DIC(19,8921,1,3,0)=" "
^DIC(19,8921,1,4,0)="Such abnormal exits will leave the survey without proper information to"
^DIC(19,8921,1,5,0)="allow the participant to restart and complete it."
^DIC(19,8921,25)="QAPFIX"
^DIC(19,8921,"U")="FIX A SURVEY RESPONSE"
