^DIC(19,6693,0)="PSD DRUG LOC PRINT^List CS Drug Location Codes^^R^11595^^^^^^^276"
^DIC(19,6693,1,0)="^^2^2^2930224^^"
^DIC(19,6693,1,1,0)="This report will list the codes used to define the location of drugs stocked"
^DIC(19,6693,1,2,0)="in Narcotic Areas of Use or in the pharmacy."
^DIC(19,6693,25)="CODE^PSDPRT"
^DIC(19,6693,"U")="LIST CS DRUG LOCATION CODES"
^DIC(19,6694,0)="PSD SITE^Site Parameters^^R^11595^PSD PARAM^^^^^^276"
^DIC(19,6694,1,0)="^^3^3^2920912^^^^"
^DIC(19,6694,1,1,0)="Site parameters for the Controlled Substances module.  This includes"
^DIC(19,6694,1,2,0)="selecting an inpatient site for Controlled Substances use and answering"
^DIC(19,6694,1,3,0)="package specific questions concerning this site.  "
^DIC(19,6694,25)="PSDSITE"
^DIC(19,6694,"U")="SITE PARAMETERS"
^DIC(19,6695,0)="PSD MFG/LOT/EXP DATE EDIT^Manufacturer, Lot #, and Exp. Date - Enter/Edit^^R^10000000216^^^^^^^276"
^DIC(19,6695,1,0)="^^2^2^2930727^^^^"
^DIC(19,6695,1,1,0)="This option allows the user to enter or edit manufacturer, lot #, and"
^DIC(19,6695,1,2,0)="expiration dates for stocked drugs in an NAOU."
^DIC(19,6695,25)="PSDMFG"
^DIC(19,6695,"U")="MANUFACTURER, LOT #, AND EXP. "
^DIC(19,6696,0)="PSD INVEN TYPE EDIT^Inventory Types - Enter/Edit^^R^11595^^^^^^^276"
^DIC(19,6696,1,0)="^^2^2^2940908^^^^"
^DIC(19,6696,1,1,0)="This option will edit the entries in the AOU INVENTORY TYPE file (#58.16)"
^DIC(19,6696,1,2,0)="used to classify Narcotic Area of Use drugs."
^DIC(19,6696,25)="PSDNVT"
^DIC(19,6696,"U")="INVENTORY TYPES - ENTER/EDIT"
^DIC(19,6697,0)="PSD INVEN TYPE PRINT^Print Inventory Types^^R^11595^^^^^^^276"
^DIC(19,6697,1,0)="^^2^2^2940908^^^"
^DIC(19,6697,1,1,0)="Use this option to print the entries in the AOU INVENTORY TYPE file (#58.16)"
^DIC(19,6697,1,2,0)="used to classify Narcotic Area of Use stocked drugs."
^DIC(19,6697,25)="INVEN^PSDPRT"
^DIC(19,6697,"U")="PRINT INVENTORY TYPES"
^DIC(19,6698,0)="PSD INACTIVATE NAOU^Inactivate NAOU^^R^11595^^^^^^^276"
^DIC(19,6698,1,0)="^^2^2^2940908^^^^"
^DIC(19,6698,1,1,0)="This option will allow a user to inactivate an NAOU.  An inactivation date "
^DIC(19,6698,1,2,0)="may be entered for a future time."
^DIC(19,6698,25)="PSDNACT"
^DIC(19,6698,"U")="INACTIVATE NAOU"
^DIC(19,6699,0)="PSD MENU^Controlled Substances Menu^^M^11595^^^^^^^276^^1^1"
^DIC(19,6699,1,0)="^^2^2^2940223^^^^"
^DIC(19,6699,1,1,0)="This menu contains access to all options associated with the Controlled"
^DIC(19,6699,1,2,0)="Substances module of the Pharmacy software."
^DIC(19,6699,10,0)="^19.01PI^8^5"
^DIC(19,6699,10,1,0)="6687^^1"
