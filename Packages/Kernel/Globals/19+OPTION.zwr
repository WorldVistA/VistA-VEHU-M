^DIC(19,10632,0)="SCENI IEMM ERROR REPORT^Incomplete Encounter Error Report^^R^11281^^^^^^^16^^"
^DIC(19,10632,1,0)="^^4^4^2980107^^^^"
^DIC(19,10632,1,1,0)="Prints report of incomplete encounters (errors) based on o/m/a division"
^DIC(19,10632,1,2,0)="and clinic selection, and date range.  Sorts by encounter date and then"
^DIC(19,10632,1,3,0)="patient name.  Displays encounter date, patient, error code, and error"
^DIC(19,10632,1,4,0)="description."
^DIC(19,10632,20)=""
^DIC(19,10632,25)="SCRPI01"
^DIC(19,10632,"U")="INCOMPLETE ENCOUNTER ERROR REP"
^DIC(19,10633,0)="SCENI IEMM SUMMARY REPORT^Summary Report - IEMM^^R^11281^^^^^^^16"
^DIC(19,10633,1,0)="^^4^4^2970911^^^^"
^DIC(19,10633,1,1,0)="This report prints a summary showing number of outpatient encounters,"
^DIC(19,10633,1,2,0)="and the number of those encounters that are incomplete, and the"
^DIC(19,10633,1,3,0)="percentage.  If there is one error that is occurring more than any "
^DIC(19,10633,1,4,0)="other, it is displayed as well.  Formatted for 80 col. output."
^DIC(19,10633,25)="SCRPI02"
^DIC(19,10633,"U")="SUMMARY REPORT - IEMM"
^DIC(19,10634,0)="SCENI IEMM SUMMARY BULLETIN^IEMM Summary Bulletin^^R^11281^^^^^^^16"
^DIC(19,10634,1,0)="^^2^2^2970911^^^^"
^DIC(19,10634,1,1,0)="Sends IEMM Summary Report as a bulletin.  Uses SCDX INCOMPLETE ENCOUNTER"
^DIC(19,10634,1,2,0)="MGMT bulliten with locally specified mail group as recipient."
^DIC(19,10634,25)="ENBLT^SCRPI02"
^DIC(19,10634,"U")="IEMM SUMMARY BULLETIN"
^DIC(19,10635,0)="SCENI OP ENCOUNTER EDIT^Edit Outpatient Encounter^^R^1253^SCENI ENCOUNTER EDIT^^^^^^16^^"
^DIC(19,10635,1,0)="^^18^18^2980220^^^"
^DIC(19,10635,1,1,0)="Allows access to change the following  uneditable fields in the"
^DIC(19,10635,1,2,0)="OUTPATIENT ENCOUNTER FILE, #409.68: CLINIC STOP CODE, Field #.03;"
^DIC(19,10635,1,3,0)="APPOINTMENT TYPE, Field #.1; MEDICAL CENTER DIVISION, Field #.11; and the"
^DIC(19,10635,1,4,0)="ELIGIBILITY OF ENCOUNTER, Field #.13."
^DIC(19,10635,1,5,0)=" "
^DIC(19,10635,1,6,0)="In order to keep the multiple data fields being stored in various files in"
^DIC(19,10635,1,7,0)="synch, the following fields and files are updated when this option is"
^DIC(19,10635,1,8,0)="used: "
^DIC(19,10635,1,9,0)="   1.  Any child encounters for the parent encounter being changed are"
^DIC(19,10635,1,10,0)="updated as well in the OUTPATIENT ENCOUNTER FILE, #409.68. "
^DIC(19,10635,1,11,0)=" "
^DIC(19,10635,1,12,0)="   2. The ELIGIBILITY OF VISIT Field #30 in the APPOINTMENT Sub-File"
^DIC(19,10635,1,13,0)="#44.001 of the HOSPITAL LOCATION File, #44 is updated to match the"
^DIC(19,10635,1,14,0)="encounter."
^DIC(19,10635,1,15,0)=" "
^DIC(19,10635,1,16,0)="   3. The APPOINTMENT TYPE Field #9.5 in the APPOINTMENT Sub-File #2.98"
^DIC(19,10635,1,17,0)="of the PATIENT File, #2 is updated to match the encounter."
^DIC(19,10635,1,18,0)=""
^DIC(19,10635,20)=""
^DIC(19,10635,25)="UPDENC^SCENIA2"
^DIC(19,10635,"U")="EDIT OUTPATIENT ENCOUNTER"
