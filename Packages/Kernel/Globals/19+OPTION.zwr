^DIC(19,8997,"U")="DELETE ERROR LOG"
^DIC(19,8998,0)="XUTM WAIT^Place Taskman in a WAIT State^^R^1039^^^^^^^^^"
^DIC(19,8998,1,0)="^^2^2^2880817^"
^DIC(19,8998,1,1,0)="Places Taskman in a WAIT state, in which Taskman is active but does"
^DIC(19,8998,1,2,0)="not process any tasks, within fifteen seconds."
^DIC(19,8998,25)="WAIT^ZTMKU"
^DIC(19,8998,"U")="PLACE TASKMAN IN A WAIT STATE"
^DIC(19,8999,0)="XUTM RUN^Remove Taskman from WAIT State^^R^1039^^^^^^^^^"
^DIC(19,8999,1,0)="^^2^2^2880817^"
^DIC(19,8999,1,1,0)="Places Taskman in a RUN state, in which Taskman processes tasks normally,"
^DIC(19,8999,1,2,0)="within fifteen seconds."
^DIC(19,8999,25)="RUN^ZTMKU"
^DIC(19,8999,"U")="REMOVE TASKMAN FROM WAIT STATE"
^DIC(19,9000,0)="XUTM STOP^Stop Task Manager^^R^1039^^^^^^^^^"
^DIC(19,9000,1,0)="^^1^1^2880817^"
^DIC(19,9000,1,1,0)="This option will shut down Task Manager."
^DIC(19,9000,25)="STOP^ZTMKU"
