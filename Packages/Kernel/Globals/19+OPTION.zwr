^DIC(19,13259,0)="SROA CODE ISSUE^Alert Coder Regarding Coding Issues^^R^10000000049^^^^^^^^^1^1"
^DIC(19,13259,1,0)="^19.06^4^4^3060404^^"
^DIC(19,13259,1,1,0)="This option is used to provide the Risk Assessment Nurse Reviewers an"
^DIC(19,13259,1,2,0)="electronic method to notify coders of potential coding issues or concerns."
^DIC(19,13259,1,3,0)="The message sent will include the basic Surgery case information and"
^DIC(19,13259,1,4,0)="comments specifically added by the Nurse Reviewer."
^DIC(19,13259,15)="D EXIT^SROVAR"
^DIC(19,13259,20)="D ^SROVAR"
