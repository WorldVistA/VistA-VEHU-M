^DIC(19,15257,"U")="MENU FOR CLOSURE TOOLS"
^DIC(19,15258,0)="EHM-00079^Consult Closure Tool Edit Configuration^^C^1^^^^^^^294^^1^1^"
^DIC(19,15258,1,0)="^19.06^4^4^3240328^^^^"
^DIC(19,15258,1,1,0)="This option is used by the Consult Closure Tool to create and manage"
^DIC(19,15258,1,2,0)="configuration file entries that associate consults, clinics, and note"
^DIC(19,15258,1,3,0)="titles."
^DIC(19,15258,1,4,0)="Cloned from ""GMRC CONSULT CLOSE TOOL EDT"" option."
^DIC(19,15258,3)=""
^DIC(19,15258,15)="K DLAYGO,DIDEL"
^DIC(19,15258,20)="S (DLAYGO,DIDEL)=123.033"
^DIC(19,15258,30)="GMR(123.033,"
^DIC(19,15258,31)="AELMNQZ"
^DIC(19,15258,32)="Select CONSULT CONFIGURATION: "
^DIC(19,15258,33)=""
