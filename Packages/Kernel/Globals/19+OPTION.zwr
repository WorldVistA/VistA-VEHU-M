^DIC(19,3246,99)="62195,28623"
^DIC(19,3246,"U")="REPORTS MENU"
^DIC(19,3247,0)="DG GECS USER MENU^MAS Code Sheet User Menu^^M^.5^^^^^^^114"
^DIC(19,3247,1,0)="^^9^9^2911023^^^^"
^DIC(19,3247,1,1,0)="This menu will allow users to generate, create and keypunch"
^DIC(19,3247,1,2,0)="MAS Code Sheets. The menu also contains options to edit and review"
^DIC(19,3247,1,3,0)="the code sheets as well as delete and print code sheets."
^DIC(19,3247,1,4,0)=" "
^DIC(19,3247,1,5,0)="The option to 'Generate a Code Sheet' can be used to generate the"
^DIC(19,3247,1,6,0)="AMIS 223, 334-341, 345-346 and 401-420 segments. The 'Create a Code"
^DIC(19,3247,1,7,0)="Sheet' option can be used to create the AMIS 167 and 290 segments."
^DIC(19,3247,1,8,0)="The 'Key Punch a Code Sheet' option is typically used for prior data"
^DIC(19,3247,1,9,0)="corrections."
^DIC(19,3247,10,0)="^19.01PI^9^7"
^DIC(19,3247,10,2,0)="3237^^2"
^DIC(19,3247,10,4,0)="3239^^3"
