^DIC(19,15757,0)="EHM-00578^Check for Multiple Keys^^A^1^^^^^^^170^^1^^"
^DIC(19,15757,1,0)="^^5^5^3240328^^"
^DIC(19,15757,1,1,0)="This option will identify users that have more than one OR key."
^DIC(19,15757,1,2,0)="Users must only have one OR key to correctly use the software."
^DIC(19,15757,1,3,0)="Any users identified need to have their keys edited so that only"
^DIC(19,15757,1,4,0)="one of the OR keys remain (ORES, OREMAS, ORELSE)."
^DIC(19,15757,1,5,0)="Cloned from ""ORE KEY CHECK"" option."
