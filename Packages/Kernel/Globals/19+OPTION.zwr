^DIC(19,17117,0)="EHM CMOP TEMPORARY ADDRESS^CMOP Temporary Address^^P^1^^^^^^^594^^^^^"
^DIC(19,17117,1,0)="^19.06^5^5^3260223^^^^"
^DIC(19,17117,1,1,0)="This option tracks the temporary addresses of CMOP patients.  This will "
^DIC(19,17117,1,2,0)="be run pre go-live for Cerner sites to be converted."
^DIC(19,17117,1,3,0)=" "
^DIC(19,17117,1,4,0)="Used at T-90 or T-120 pre go-live and repeatedly until go-live to see the "
^DIC(19,17117,1,5,0)="numbers track downward towards zero."
^DIC(19,17117,26)=""
^DIC(19,17117,60)="DPT("
^DIC(19,17117,62)=0
^DIC(19,17117,63)=.01
^DIC(19,17117,64)=.01
^DIC(19,17117,67)="CMOP Patient Temporary Addresses"
^DIC(19,17117,69)="S ACTIVE=$P($G(^DPT(D0,.121)),U,9)=""Y"",ENDDATE=$P($G(^DPT(D0,.121)),U,8),DEATH=$P($G(^DPT(D0,.35)),U,1) I ACTIVE,DEATH="""",ENDDATE=""""!(ENDDATE>DT)"
