^DIC(19,14887,"U")="FIRST PARTY COPAY AUTO-DECREAS"
^DIC(19,14888,0)="RCDPE 1ST PARTY AUTO VS MAN^First Party COPAY Manual vs Auto-Decrease Report^^R^1^^^^^^^261"
^DIC(19,14888,1,0)="^^3^3^3190530^"
^DIC(19,14888,1,1,0)="This report shows all decrease adjustments for 1st party copay claims and "
^DIC(19,14888,1,2,0)="gives a statistical break down of which were performed manually and which "
^DIC(19,14888,1,3,0)="were performed via auto-decrease in the nightly process."
