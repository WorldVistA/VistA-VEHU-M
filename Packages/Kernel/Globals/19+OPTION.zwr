^DIC(19,13312,0)="DGPT FEE BASIS CENSUS STAT RPT^Fee Basis Census Status Report^^R^10000000020^^^^^^^"
^DIC(19,13312,1,0)="^19.06^14^14^3050323^^^"
^DIC(19,13312,1,1,0)="The report will indicate the status of the census record with a type of"
^DIC(19,13312,1,2,0)="FEE BASIS for each admission.  This report uses the data stored in the"
^DIC(19,13312,1,3,0)="CENSUS WORKFILE.  This workfile is an extract of data from the admission"
^DIC(19,13312,1,4,0)="data for the patients who were inpatients (including FEE BASIS patients)"
^DIC(19,13312,1,5,0)="as of 11:59 on the census date.  This workfile makes the printing of this"
^DIC(19,13312,1,6,0)="report much faster than otherwise would be possible.  Without this"
^DIC(19,13312,1,7,0)="workfile, it would be neccessary to scan all admissions prior to the"
^DIC(19,13312,1,8,0)="census date to determine if the admission was still active on the census"
^DIC(19,13312,1,9,0)="date. "
^DIC(19,13312,1,10,0)=" "
^DIC(19,13312,1,11,0)="The report is sorted by: "
^DIC(19,13312,1,12,0)="   "
^DIC(19,13312,1,13,0)="    1) Census Date"
^DIC(19,13312,1,14,0)="    2) Census Status"
^DIC(19,13312,25)="EN^DGPTCO3"
^DIC(19,13312,"U")="FEE BASIS CENSUS STATUS REPORT"
^DIC(19,13313,0)="DGPT CENSUS DATE DISPLAY^Display Census Date Parameters^^R^10000000020^DG PTFSUP^^^^^^114"
^DIC(19,13313,1,0)="^19.06^7^7^3060317^^"
^DIC(19,13313,1,1,0)=" "
^DIC(19,13313,1,2,0)="This option displays a 'Quick Parameter Profile'. "
^DIC(19,13313,1,3,0)="This profile can be used to view the parameters."
^DIC(19,13313,1,4,0)="One parameter, WORKFILE LAST UPDATED,"
^DIC(19,13313,1,5,0)="is updated at the end of the 'Regenerate"
^DIC(19,13313,1,6,0)="Census Workfile'.  This profile can be used to "
^DIC(19,13313,1,7,0)="monitor the completion of the regeneration."
^DIC(19,13313,25)="7^DGPTC"
^DIC(19,13313,"U")="DISPLAY CENSUS DATE PARAMETERS"
^DIC(19,13314,0)="MAG DICOM CORRECT VALIDATE^Validate DICOM Correct Information^^R^10000000049^^^^^^^"
^DIC(19,13314,1,0)="^^3^3^3041203^"
^DIC(19,13314,1,1,0)="This menu option invokes the program that validates"
^DIC(19,13314,1,2,0)="(and, if necessary, corrects) the table that describes"
^DIC(19,13314,1,3,0)="all images that are waiting for corrections to be applied."
^DIC(19,13314,25)="MENU^MAGDLBV"
^DIC(19,13314,"U")="VALIDATE DICOM CORRECT INFORMA"
