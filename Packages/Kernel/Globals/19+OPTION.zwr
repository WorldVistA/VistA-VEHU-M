^DIC(19,14888,"U")="FIRST PARTY COPAY MANUAL VS AU"
^DIC(19,14889,0)="ECX SUR OBS^Surgery Pre-Extract Observation Report^^R^1^^^^^^^513"
^DIC(19,14889,1,0)="^^10^10^3200423^"
^DIC(19,14889,1,1,0)="This report prints a listing of patients who had surgery while in "
^DIC(19,14889,1,2,0)="observation"
^DIC(19,14889,1,3,0)="status.  As a pre-extract report, it should be run prior to the "
^DIC(19,14889,1,4,0)="generation of"
^DIC(19,14889,1,5,0)="the surgey extract to identify and fix as necessary any record determined "
^DIC(19,14889,1,6,0)="to be erroneous.  This report has no effect on the actual extracts and "
^DIC(19,14889,1,7,0)="can be run as"
^DIC(19,14889,1,8,0)="needed."
^DIC(19,14889,1,9,0)=" "
^DIC(19,14889,1,10,0)="The report is sorted by Observation Admission Date."
^DIC(19,14889,10.1)=""
^DIC(19,14889,25)="EN^ECXOBSUR"
^DIC(19,14889,"U")="SURGERY PRE-EXTRACT OBSERVATIO"
^DIC(19,14890,0)="OR ENABLE CTB CONS ACT DLGS^Enable Toolbox on Consult Actions^^A^1^^^^^^^170^^1"
^DIC(19,14890,1,0)="^^8^8^3200713^"
^DIC(19,14890,1,1,0)="This option allows you to enable or disable the Launch DST/Open Consult "
^DIC(19,14890,1,2,0)="Toolbox button on the individual consult action dialogs of CPRS GUI. The"
^DIC(19,14890,1,3,0)="option invokes a parameter template which is used to guide you through"
^DIC(19,14890,1,4,0)="setting the on/off parameter for each consult action."
^DIC(19,14890,1,5,0)=" "
^DIC(19,14890,1,6,0)="The parameter values set by this option may be overridden by the ORQQCN "
^DIC(19,14890,1,7,0)="DST/CTB FEATURE SWITCH parameter. If the feature switch parameter is set "
^DIC(19,14890,1,8,0)="to OFF, then no button will be displayed on the consult action dialogs."
^DIC(19,14890,20)="D TED^XPAREDIT(""ORQQCN CTB ACTION ENABLE"",""B"")"
^DIC(19,14890,"U")="ENABLE TOOLBOX ON CONSULT ACTI"
^DIC(19,14891,0)="OR DST/CTB URL EDIT^Edit URLs for DST/CTB^^A^1^XUPROG^^^^^^170^^1^^^"
^DIC(19,14891,1,0)="^19.06^5^5^3201118^^^"
^DIC(19,14891,1,1,0)="This option allows access to edit the various URL parameters associated"
^DIC(19,14891,1,2,0)="with the DST/CTB tools used within CPRS GUI. These parameters are set "
^DIC(19,14891,1,3,0)="only at the Package level and will typically be updated via VistA patch."
^DIC(19,14891,1,4,0)=" "
^DIC(19,14891,1,5,0)="Access to this option is locked with the XUPROG key."
^DIC(19,14891,20)="D TED^XPAREDIT(""ORQQCN DST/CTB URL/SERVICES"",""B"")"
^DIC(19,14891,26)=""
^DIC(19,14891,"U")="EDIT URLS FOR DST/CTB"
^DIC(19,14892,0)="OR DST/CTB CPRS CONFIGURATION^GUI Consults DST/CTB Configuration^^M^1^^^^^^^170"
^DIC(19,14892,1,0)="^19.06^5^5^3201118^^^"
^DIC(19,14892,1,1,0)="This main menu contains the options for configuring the Decision Support "
^DIC(19,14892,1,2,0)="Tool (DST) and Consult Toolbox (CTB) environment for CPRS GUI. The "
^DIC(19,14892,1,3,0)="options include things like setting which consult actions will display the"
^DIC(19,14892,1,4,0)="Open Consult Toolbox button and completely disabling the DST/CTB features "
^DIC(19,14892,1,5,0)="within CPRS GUI."
^DIC(19,14892,10,0)="^19.01IP^3^3"
^DIC(19,14892,10,2,0)="14890^ACT^15"
^DIC(19,14892,10,3,0)="14893^FSW^5"
^DIC(19,14892,10,"B",14890,2)=""
^DIC(19,14892,10,"B",14893,3)=""
^DIC(19,14892,10,"C","ACT",2)=""
^DIC(19,14892,10,"C","FSW",3)=""
^DIC(19,14892,99)="66284,72151"
^DIC(19,14892,"U")="GUI CONSULTS DST/CTB CONFIGURA"
^DIC(19,14893,0)="OR DST/CTB FEATURE SWITCH^DST/CTB Feature Switch^^A^1^^^^^^^170^^1"
^DIC(19,14893,1,0)="^^10^10^3200715^"
^DIC(19,14893,1,1,0)="This option allows you to control the state of the built-in Decision"
^DIC(19,14893,1,2,0)="Support Tool or Consult Toolbox features of CPRS GUI."
^DIC(19,14893,1,3,0)=" "
^DIC(19,14893,1,4,0)="There are three possible values: OFF, DST, and CTB."
^DIC(19,14893,1,5,0)=" "
^DIC(19,14893,1,6,0)="OFF: All integrated DST/CTB features are disabled."
^DIC(19,14893,1,7,0)=" "
^DIC(19,14893,1,8,0)="DST: Only Decision Support Tool features are available."
^DIC(19,14893,1,9,0)=" "
^DIC(19,14893,1,10,0)="CTB: Only Consult Toolbox features are available."
^DIC(19,14893,20)="D EDITPAR^XPAREDIT(""ORQQCN DST/CTB FEATURE SWITCH"")"
^DIC(19,14893,"U")="DST/CTB FEATURE SWITCH"
