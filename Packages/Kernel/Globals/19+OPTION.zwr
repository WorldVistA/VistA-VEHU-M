^DIC(19,17125,"U")="PATIENT DISCHARGE MENU"
^DIC(19,17126,0)="EHM_DISCHARGE PATIENTS^Discharge Patients^^R^1^^^^^^^594"
^DIC(19,17126,1,0)="^19.06^3^3^3240718^^"
^DIC(19,17126,1,1,0)="Use this option to discharge eligible patients on night of cutover.  The "
^DIC(19,17126,1,2,0)="option can be run for a single institution or for all institutions at a "
^DIC(19,17126,1,3,0)="site."
^DIC(19,17126,25)="DISCHARGE^EHMDISCH"
^DIC(19,17126,"U")="DISCHARGE PATIENTS"
^DIC(19,17127,0)="EHM_DISCHARGE POST-LIST^Discharged Patients List^^R^1^^^^^^^594"
^DIC(19,17127,1,0)="^^2^2^3240718^"
^DIC(19,17127,1,1,0)="This option lists the patients discharged by the Automated Patient "
^DIC(19,17127,1,2,0)="Discharge Tool."
^DIC(19,17127,25)="POSTLIST^EHMDISCH"
^DIC(19,17127,"U")="DISCHARGED PATIENTS LIST"
^DIC(19,17128,0)="EHM_DISCHARGE INPT APPT^Inpatient Appointments^^R^1^^^^^^^594"
^DIC(19,17128,1,0)="^^2^2^3250224^"
^DIC(19,17128,1,1,0)="Use this option to list inpatient appointments for patients eligible to "
^DIC(19,17128,1,2,0)="be discharged."
^DIC(19,17128,25)="INAPPT^EHMDISH1"
^DIC(19,17128,"U")="INPATIENT APPOINTMENTS"
^DIC(19,17129,0)="DGY991PO^Inactivate PRF Flags and Options at Conversion^^R^1^DGPRF^^^^^^114"
^DIC(19,17129,25)="ENTRY^DGY991PO"
^DIC(19,17129,"U")="INACTIVATE PRF FLAGS AND OPTIO"
^DIC(19,17130,0)="ONCOLOGY DATA MIGRATION^Migrate VistA Oncology and Related Data^^R^1^^^^^^^150"
^DIC(19,17130,1,0)="^19.06^1^1^3260106^^"
^DIC(19,17130,1,1,0)="This option will migrate VistA Oncology data in JSON formatted .gz file"
^DIC(19,17130,25)="ONCORIS"
^DIC(19,17130,200.9)="y"
^DIC(19,17130,"U")="MIGRATE VISTA ONCOLOGY AND REL"
^DIC(19,17131,0)="BPS EPHARM BILLING PARAMS^ePharmacy Billing Parameters^^R^1^BPS SUPERVISOR^^^^^^553"
^DIC(19,17131,1,0)="^^4^4^3250814^"
^DIC(19,17131,1,1,0)="This option will enable or disable third-party billing for specific "
^DIC(19,17131,1,2,0)="patient categories.  Selecting 'Yes' will allow ePharmacy claims to "
^DIC(19,17131,1,3,0)="transmit to the patients' third-party payer, while selecting 'No' will "
^DIC(19,17131,1,4,0)="disable the ePharmacy claims for the selected category."
^DIC(19,17131,10.1)="ePharmacy Billing Parameters"
^DIC(19,17131,25)="EBP^BPSEBP"
^DIC(19,17131,"U")="EPHARMACY BILLING PARAMETERS"
