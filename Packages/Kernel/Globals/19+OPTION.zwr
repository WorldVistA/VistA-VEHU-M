^DIC(19,11103,0)="PSJI 200^Correct Changed User Names in IV Orders^^R^11712^^^^^^^"
^DIC(19,11103,1,0)="^^11^11^2961009^"
^DIC(19,11103,1,1,0)="In Inpatient Medications version 5.0, the Pharmacy Patient file (#55)"
^DIC(19,11103,1,2,0)="subfile 55.01 field ENTRY CODE (#.23) was changed from free text to a"
^DIC(19,11103,1,3,0)="pointer to the NEW PERSON file (#200).  A new field ENTRY BY (#135) was"
^DIC(19,11103,1,4,0)="created. The post init of the version 5.0 install converts these"
^DIC(19,11103,1,5,0)="names to there pointer and stores it in the new field.  The"
^DIC(19,11103,1,6,0)="conversion also looks for the Free Text names in field ENTRY CODE that"
^DIC(19,11103,1,7,0)="don't have exact matches in the NEW PERSON file. These names are"
^DIC(19,11103,1,8,0)="temporarily stored in ^XTMP(""PSJ NEW PERSON"",NAME,DFN, ORDER NUMBER). This"
^DIC(19,11103,1,9,0)="option lets a pharmacist go through the bad names and choose the correct"
^DIC(19,11103,1,10,0)="user name.  After the correct name is chosen, the IV orders are updated"
^DIC(19,11103,1,11,0)="with the new pointer to that user."
^DIC(19,11103,25)="PSJ200"
^DIC(19,11103,"U")="CORRECT CHANGED USER NAMES IN "
^DIC(19,11104,0)="GMRC QC PENDING CONSULTS^QC Pending Consults Report^^R^11712^^^^^^^"
^DIC(19,11104,25)="EN^GMRCQC"
^DIC(19,11104,"U")="QC PENDING CONSULTS REPORT"
