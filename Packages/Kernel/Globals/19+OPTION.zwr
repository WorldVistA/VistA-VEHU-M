^DIC(19,17111,0)="XU MULTI UCI USER STATUS^Kernel Multi-UCI User Status Report^^R^1^^^^^^^"
^DIC(19,17111,1,0)="^^5^5^3251106^"
^DIC(19,17111,1,1,0)="This option launches the Kernel Multi-UCI User Status Report.  The "
^DIC(19,17111,1,2,0)="application is a VA ListManager (ListMan) application that is modeled "
^DIC(19,17111,1,3,0)="after the current USER STATUS REPORT [XUUSERSTATUS] with the added "
^DIC(19,17111,1,4,0)="functionality of listing the users on all UCIs on the currently connected "
^DIC(19,17111,1,5,0)="system."
^DIC(19,17111,25)="XUMUCI"
^DIC(19,17111,"U")="KERNEL MULTI-UCI USER STATUS R"
^DIC(19,17112,0)="EHM CANCEL RX (MANUAL)^Discontinue RX for EHRM Data Migration (Manual)^^A^1^EHM DISCONTINUE^^^^^^594^^1"
^DIC(19,17112,1,0)="^19.06^4^4^3260128^^^^"
^DIC(19,17112,1,1,0)="PBM/RMS - This option allows a user to paste in a series of "
^DIC(19,17112,1,2,0)=" prescription IENs (Internal Entry Numbers) to call an API developed for "
^DIC(19,17112,1,3,0)="the purpose of discontinuing the Rx's on the legacy VistA system after"
^DIC(19,17112,1,4,0)="successful migration to EHRM/Cerner."
^DIC(19,17112,20)="F  R !,""Rx IEN: "",EHMIEN:DTIME Q:EHMIEN=""""  D CAN^EHMPSRXDC(EHMIEN)"
^DIC(19,17112,"U")="DISCONTINUE RX FOR EHRM DATA M"
