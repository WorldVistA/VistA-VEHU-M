^DIC(19,1354,0)="LRWRKINC^Incomplete test status report^^R^.5^^^^^^^26"
^DIC(19,1354,1,0)="^^4^4^2870203^^"
^DIC(19,1354,1,1,0)="Use this option to display or print a report of all incomplete tests"
^DIC(19,1354,1,2,0)="in a specific accession area.  You may list by accession number or"
^DIC(19,1354,1,3,0)="by date.  You may also limit the report to a specific test of combination"
^DIC(19,1354,1,4,0)="of tests."
^DIC(19,1354,25)="LRWRKINC"
^DIC(19,1354,99)="53971,23511"
^DIC(19,1354,"U")="INCOMPLETE TEST STATUS REPORT"
^DIC(19,1355,0)="LRAC DIAG^Diagnostic routine for Lab Reports file (64.5)^^R^.5^LRLIASON^^^^^^26"
^DIC(19,1355,1,0)="^^5^5^2870203^^"
^DIC(19,1355,1,1,0)="This options checks the Lab Reports file for erroneous entries and"
^DIC(19,1355,1,2,0)="gives fatal and warning messages when problems are found.  Problems"
^DIC(19,1355,1,3,0)="reported by this option can be fixed by editing the appropriate fields"
^DIC(19,1355,1,4,0)="in the Lab Reports file or if necessary by the LRAC XREF option (LRAC"
^DIC(19,1355,1,5,0)="XREF re-cross-references selected indexes)."
^DIC(19,1355,25)="LRACDIAG"
^DIC(19,1355,"U")="DIAGNOSTIC ROUTINE FOR LAB REP"
^DIC(19,1356,0)="LRAC XREF^Re-cross-reference indexes in LAB REPORTS file^^M^.5^LRLIASON^^^^^^26"
^DIC(19,1356,1,0)="^^18^18^2870203^^^^"
^DIC(19,1356,1,1,0)="This option will allow the user to re-cross-reference selected"
^DIC(19,1356,1,2,0)="indexes from the Lab Reports file."
^DIC(19,1356,1,3,0)="  1.  The ""A"" index contains the reference ranges, critical ranges,"
^DIC(19,1356,1,4,0)="      and units from file 60.  This index needs to be re-cross-"
^DIC(19,1356,1,5,0)="      referenced any time changes are made to these fields in file"
^DIC(19,1356,1,6,0)="      60, if those changes need to be reflected on the cumulative report."
^DIC(19,1356,1,7,0)="  2.  The ""AC"" index contains the pointers to the Lab Data file (63)."
^DIC(19,1356,1,8,0)="      This index may need to be re-cross-referenced if it is found"
^DIC(19,1356,1,9,0)="      that the cross-reference contains entries for tests in the"
^DIC(19,1356,1,10,0)="      cumulative that don't have data names in file 63."
^DIC(19,1356,1,11,0)="  3.  The ""AR"" index contains for each site/specimen the test on"
^DIC(19,1356,1,12,0)="      each minor header of the cumulative.  This index may have"
^DIC(19,1356,1,13,0)="      to be re-cross-referenced if it is found that a given"
^DIC(19,1356,1,14,0)="      test and site/specimen is located in more than one place"
^DIC(19,1356,1,15,0)="      on the report."
^DIC(19,1356,1,16,0)=" "
^DIC(19,1356,1,17,0)="The option LRAC DIAG should be used to diagnose when these indexes"
^DIC(19,1356,1,18,0)="need to be re-cross-referenced."
^DIC(19,1356,10,0)="^19.01PI^4^4"
^DIC(19,1356,10,1,0)="2128^1"
^DIC(19,1356,10,2,0)="2129^2"
^DIC(19,1356,10,3,0)="2130^3"
^DIC(19,1356,10,4,0)="2131^4"
^DIC(19,1356,10,"B",2128,1)=""
^DIC(19,1356,10,"B",2129,2)=""
^DIC(19,1356,10,"B",2130,3)=""
^DIC(19,1356,10,"B",2131,4)=""
^DIC(19,1356,10,"C",1,1)=""
^DIC(19,1356,10,"C",2,2)=""
^DIC(19,1356,10,"C",3,3)=""
^DIC(19,1356,10,"C",4,4)=""
^DIC(19,1356,20)=""
^DIC(19,1356,25)=""
^DIC(19,1356,99)="56214,30170"
^DIC(19,1356,"U")="RE-CROSS-REFERENCE INDEXES IN "
^DIC(19,1357,0)="LRAC ""A""^Mumps A index of the LAB REPORTS file^^A^.5^^^^^^^^^1"
^DIC(19,1357,1,0)="^^4^4^2851104^^"
^DIC(19,1357,1,1,0)="This option does a re-cross-reference on the mumps ""A"" index on the"
^DIC(19,1357,1,2,0)="LAB TEST subfield of the LAB REPORTS file."
^DIC(19,1357,1,3,0)="The ""A"" cross-reference contains reference ranges, critical ranges, and"
^DIC(19,1357,1,4,0)="units from the LABORATORY TEST file."
^DIC(19,1357,20)="K LR S LR(1)=1 D EN^LRACDIAG"
^DIC(19,1357,"U")="MUMPS A INDEX OF THE LAB REPORTS FILE"
^DIC(19,1358,0)="LRAC ""AC""^Mumps AC index of the LAB REPORTS file^^A^.5^^^^^^^^^1"
^DIC(19,1358,1,0)="^^4^4^2851104^^"
^DIC(19,1358,1,1,0)="This option does a re-cross-reference on the mumps ""AC"" index "
^DIC(19,1358,1,2,0)="on the TEST LOCATION subfield of the LAB REPORTS file."
^DIC(19,1358,1,3,0)="The ""AC"" cross-reference is to identify the tests in the file that"
^DIC(19,1358,1,4,0)="have data names in the LAB DATA file (atomic tests)."
^DIC(19,1358,20)="K LR S LR(2)=1 D EN^LRACDIAG"
^DIC(19,1358,"U")="MUMPS AC INDEX OF THE LAB REPORTS FILE"
^DIC(19,1359,0)="LRAC ""AR""^Mumps AR index of the LAB REPORTS file^^A^.5^^^^^^^^^1"
^DIC(19,1359,1,0)="^^4^4^2851104^^"
^DIC(19,1359,1,1,0)="This option does a re-cross-reference on the mumps ""AR"" index"
^DIC(19,1359,1,2,0)="on the LAB TEST subfield of the LAB REPORTS file."
^DIC(19,1359,1,3,0)="The ""AR"" cross-reference holds the site/specimen for each test in the"
^DIC(19,1359,1,4,0)="file."
^DIC(19,1359,20)="K LR S LR(3)=1 D EN^LRACDIAG"
^DIC(19,1359,"U")="MUMPS AR INDEX OF THE LAB REPORTS FILE"
^DIC(19,1360,0)="LRAC ""A"" ""AC"" ""AR""^Mumps A, AC, & AR indexes of the LAB REPORTS file^^A^.5^^^^^^^^^1"
^DIC(19,1360,1,0)="^^3^3^2851104^"
^DIC(19,1360,1,1,0)="This option does a re-cross-reference on the ""A"" and ""AR"" indexes of "
^DIC(19,1360,1,2,0)="the LAB TEST subfield and the ""AC"" index of the TEST LOCATION subfield"
^DIC(19,1360,1,3,0)="within the LAB REPORTS FILE.  All three indexes are re-cross-referenced."
^DIC(19,1360,20)="K LR S LR(1)=1,LR(2)=1,LR(3)=1 D EN^LRACDIAG"
^DIC(19,1360,"U")="MUMPS A, AC, & AR INDEXES OF THE LAB REPORTS FILE"
^DIC(19,1361,0)="LRRD^Interim report by provider^^R^10000000020^^^^^^^26"
^DIC(19,1361,1,0)="^19.06^16^16^3021031^^^^"
^DIC(19,1361,1,1,0)="This option is used to obtain all data on one day for selected providers."
^DIC(19,1361,1,2,0)="All providers may be selected or a range of providers (this may be"
^DIC(19,1361,1,3,0)="helpful if obtaining reports for all providers but you wish to split"
^DIC(19,1361,1,4,0)="the load between multiple printers).  Multiple selections are allowed"
^DIC(19,1361,1,5,0)="for selecting specific providers.  All reports are sorted by provider"
^DIC(19,1361,1,6,0)="name. If no results are available for a provider, the option will print "
^DIC(19,1361,1,7,0)="the provider's name followed by the next provider's name.  This option"
^DIC(19,1361,1,8,0)="is an alternative to having the Interim report tasked to the taskmanager."
^DIC(19,1361,1,9,0)="Only verified results will be printed.  This option is not part of the"
^DIC(19,1361,1,10,0)="cumulative report and should not be charted.  The date chosen for this"
^DIC(19,1361,1,11,0)="report is the collection date.  If a test is ordered on one day and "
^DIC(19,1361,1,12,0)="verified on the next, you have to select the order date to see the report. "
^DIC(19,1361,1,13,0)="The report prints site codes for tests.  You will be asked if you would"
^DIC(19,1361,1,14,0)="like to print an address page.  The address page prints on a separate page(s)"
^DIC(19,1361,1,15,0)="at the end of the report and lists the performing lab name, address and site"
^DIC(19,1361,1,16,0)="code."
^DIC(19,1361,25)="LRRD"
^DIC(19,1361,"U")="INTERIM REPORT BY PROVIDER"
^DIC(19,1362,0)="LRUW^Accession area worklist^^R^.5^^^^^^^26"
^DIC(19,1362,1,0)="^^4^4^2860105^^"
^DIC(19,1362,1,1,0)="Prints a worklist for all tests associated with an accession area."
^DIC(19,1362,1,2,0)=" If the test is completed the date completed and tech initials may"
^DIC(19,1362,1,3,0)=" be shown and in some cases (ex. Blood bank) the test results will"
^DIC(19,1362,1,4,0)=" also be seen."
^DIC(19,1362,25)="LRUW"
^DIC(19,1362,"U")="ACCESSION AREA WORKLIST"
^DIC(19,1369,0)="LRUMD^Print/display preselected lab tests^^R^.5^^^^^^^26"
^DIC(19,1369,1,0)="^^7^7^2870204^^^^"
^DIC(19,1369,1,1,0)=" This option prints/displays preselected lab tests selected by the lab or"
^DIC(19,1369,1,2,0)=" or the user.  If no user selection the default is lab selection."
^DIC(19,1369,1,3,0)=" Users can keep their own lists of patients to print which can be"
^DIC(19,1369,1,4,0)=" edited upon entering the option."
^DIC(19,1369,1,5,0)=" This option is intended to be used by a physician who wants a quick"
^DIC(19,1369,1,6,0)=" list of preselected lab tests for his patients from one date to another"
^DIC(19,1369,1,7,0)=" and is not intended for chart copy."
^DIC(19,1369,25)="LRUMD"
^DIC(19,1369,99)="55647,48528"
^DIC(19,1369,"U")="PRINT/DISPLAY PRESELECTED LAB "
^DIC(19,1370,0)="LRUMDE^Enter/edit user defined lab test lists^^R^.5^^^^^^^26"
^DIC(19,1370,1,0)="3^^3^3^2870204^"
^DIC(19,1370,1,1,0)="Allows a user to define lab test panels to print/display."
^DIC(19,1370,1,2,0)=" Each panel can have up to 7 tests each.  The tests must be chem,"
^DIC(19,1370,1,3,0)=" hem, ser, tox, coag, RIA, or ones for a urinalysis."
^DIC(19,1370,25)="LRUMDU"
^DIC(19,1370,"U")="ENTER/EDIT USER DEFINED LAB TE"
^DIC(19,1371,0)="LRUMDL^Enter/edit predefined lab test lists^^R^.5^^^^^^^26"
^DIC(19,1371,1,0)="^^3^3^2930901^^^^"
^DIC(19,1371,1,1,0)="This is a default list of lab tests in the ""CH"" subscript for users,"
^DIC(19,1371,1,2,0)=" especially physicians for their personal patient lists, and is not"
^DIC(19,1371,1,3,0)=" intended to be for chartable reports."
^DIC(19,1371,25)="LRUMDF"
^DIC(19,1371,99)="55538,39127"
^DIC(19,1371,"U")="ENTER/EDIT PREDEFINED LAB TEST"
^DIC(19,1372,0)="LRUMDA^Edit/print/display preselected lab tests^^M^.5^^^^^^^26"
^DIC(19,1372,1,0)="^^3^3^2880801^^^^"
^DIC(19,1372,1,1,0)="User defined lab tests and patient lists for display/print from one"
^DIC(19,1372,1,2,0)=" date to another.  If tests not defined by the user the lab defined"
^DIC(19,1372,1,3,0)=" list will be displayed."
