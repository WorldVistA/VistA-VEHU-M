^DIC(19,12596,"U")="CP TOOLS REPORTS"
^DIC(19,12597,0)="KMPD TMG AVG TTL^Average Daily Coversheet Load^^R^10000000216^^^^^^^547"
^DIC(19,12597,1,0)="^^3^3^3030903^"
^DIC(19,12597,1,1,0)="This report displays the daily average time-to-load value for the"
^DIC(19,12597,1,2,0)="coversheet at this site.  Average time-to-load values are given for either"
^DIC(19,12597,1,3,0)="daily prime time or non-prime time periods."
^DIC(19,12597,25)="EN^KMPDTP1"
^DIC(19,12597,"U")="AVERAGE DAILY COVERSHEET LOAD"
^DIC(19,12598,0)="KMPD TMG DLY TTL DETAIL^Detailed Daily Coversheet Load^^R^10000000216^^^^^^^547"
^DIC(19,12598,1,0)="^^3^3^3030903^"
^DIC(19,12598,1,1,0)="This detailed report displays daily time-to-load values for the coversheet"
^DIC(19,12598,1,2,0)="at this site.  The report breaks the time-to-load metrics into ten second"
^DIC(19,12598,1,3,0)="groupings."
^DIC(19,12598,25)="EN^KMPDTP2"
^DIC(19,12598,"U")="DETAILED DAILY COVERSHEET LOAD"
^DIC(19,12599,0)="KMPD TMG HRLY TTL^Average Hourly Coversheet Load^^R^10000000033^^^^^^^547"
^DIC(19,12599,1,0)="^^2^2^3030903^"
^DIC(19,12599,1,1,0)="This report displays the hourly average time-to-load value the coversheet"
^DIC(19,12599,1,2,0)="at this site over 24 hours."
^DIC(19,12599,25)="EN^KMPDTP3"
^DIC(19,12599,"U")="AVERAGE HOURLY COVERSHEET LOAD"
^DIC(19,12600,0)="KMPD TMG HRLY TTL DETAIL^Detailed Hourly Coversheet Load^^R^10000000216^^^^^^^547"
^DIC(19,12600,1,0)="^^3^3^3030903^"
^DIC(19,12600,1,1,0)="This detail report displays the hourly time-to-load values for the"
^DIC(19,12600,1,2,0)="coversheet at this site.  The report breaks the time-to-load metrics into"
^DIC(19,12600,1,3,0)="ten second groupings."
^DIC(19,12600,25)="EN^KMPDTP4"
^DIC(19,12600,"U")="DETAILED HOURLY COVERSHEET LOA"
^DIC(19,12601,0)="KMPD TMG TTL ALERT^Threshold Alert^^R^10000000216^^^^^^^547"
^DIC(19,12601,1,0)="^^3^3^3031105^"
^DIC(19,12601,1,1,0)="This alerting report shows the particular coversheet loads that had"
^DIC(19,12601,1,2,0)="excessive time-to-load values. This report will search for a particular"
^DIC(19,12601,1,3,0)="person, a particular client name or IP address."
^DIC(19,12601,25)="EN^KMPDTP5"
^DIC(19,12601,"U")="THRESHOLD ALERT"
^DIC(19,12602,0)="KMPD TMG START/STOP^Start/Stop Timing Collection^^R^10000000216^^^^^^^547"
^DIC(19,12602,25)="SST^KMPDSS"
^DIC(19,12602,"U")="START/STOP TIMING COLLECTION"
