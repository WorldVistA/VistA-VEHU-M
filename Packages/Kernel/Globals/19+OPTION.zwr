^DIC(19,16671,0)="EHM-01492^Print Health Summary Menu^^M^1^^^^^^^160^^^^"
^DIC(19,16671,1,0)="^^6^6^3240328^"
^DIC(19,16671,1,1,0)="This menu includes all of the various print options available for Health"
^DIC(19,16671,1,2,0)="Summaries, allowing the user to generate Health Summaries by Patient, by"
^DIC(19,16671,1,3,0)="Patient and a date range, by patient and a outpatient visit or an"
^DIC(19,16671,1,4,0)="admission, by Location, for patients at all clinics, and on an Ad Hoc"
^DIC(19,16671,1,5,0)="basis."
^DIC(19,16671,1,6,0)="Cloned from ""GMTS HS MENU"" option."
