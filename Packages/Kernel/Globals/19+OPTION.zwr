^DIC(19,14240,0)="XLFIPV CONVERT^Convert any IP address per system settings^^R^1^^^^^^^163"
^DIC(19,14240,1,0)="^^15^15^3120810^"
^DIC(19,14240,1,1,0)="XU*8*605 IPv4 and IPv6 Utilities "
^DIC(19,14240,1,2,0)="  "
^DIC(19,14240,1,3,0)="Convert an IP address (either IPv4 or IPv6) into an IPv6 address in a "
^DIC(19,14240,1,4,0)="standardized format, either IPv4 or IPv6 depending upon the Cache system "
^DIC(19,14240,1,5,0)="settings.  "
^DIC(19,14240,1,6,0)="Usage: S Y=$$CONVERT^XLFIPV(IP) "
^DIC(19,14240,1,7,0)="   VARIABLES:  Input     IP "
^DIC(19,14240,1,8,0)="                           (string) IPv4 or IPv6 Address to be converted."
^DIC(19,14240,1,9,0)="   VARIABLES:  Output    returns: "
^DIC(19,14240,1,10,0)="                           - An IPv4 address if IPv6 is disabled on the "
^DIC(19,14240,1,11,0)="                             system.  "
^DIC(19,14240,1,12,0)="                           - An IPv6 address if IPv6 is enabled on the "
^DIC(19,14240,1,13,0)="                             system.  "
^DIC(19,14240,1,14,0)="                           - An IPv4 or IPv6 null address if the input "
^DIC(19,14240,1,15,0)="                             cannot be converted."
^DIC(19,14240,25)="CON^XLFIPV"
^DIC(19,14240,"U")="CONVERT ANY IP ADDRESS PER SYS"
^DIC(19,14241,0)="XLFIPV FORCEIP4^Convert any IP address to IPv4^^R^1^^^^^^^163"
^DIC(19,14241,1,0)="^^14^14^3120810^"
^DIC(19,14241,1,1,0)="XU*8*605 IPv4 and IPv6 Utilities "
^DIC(19,14241,1,2,0)="  "
^DIC(19,14241,1,3,0)="Convert an IP address (either IPv4 or IPv6) into an IPv4 address in a "
^DIC(19,14241,1,4,0)="standardized format: ""127.0.0.1"".  "
^DIC(19,14241,1,5,0)="Usage: S Y=$$FORCEIP4^XLFIPV(IP) "
^DIC(19,14241,1,6,0)="   VARIABLES:  Input     IP "
^DIC(19,14241,1,7,0)="                          (string) IPv4 or IPv6 Address to be converted."
^DIC(19,14241,1,8,0)="   VARIABLES:  Output    returns:  An IPv4 address in ""nnn.nnn.nnn.nnn"" "
^DIC(19,14241,1,9,0)="                           notation if the input address is valid and has"
^DIC(19,14241,1,10,0)="                           an IPv4 equivalent, or the null address "
^DIC(19,14241,1,11,0)="                           ""0.0.0.0"" if the input address is invalid, or "
^DIC(19,14241,1,12,0)="                           the null address ""0.0.0.0"" if an IPv6 address "
^DIC(19,14241,1,13,0)="                           is input which does not have an IPv4 "
^DIC(19,14241,1,14,0)="                           equivalent."
^DIC(19,14241,25)="IP4^XLFIPV"
^DIC(19,14241,"U")="CONVERT ANY IP ADDRESS TO IPV4"
^DIC(19,14242,0)="XLFIPV FORCEIP6^Convert any IP address to IPv6^^R^1^^^^^^^163"
^DIC(19,14242,1,0)="^^12^12^3120810^"
^DIC(19,14242,1,1,0)="XU*8*605 IPv4 and IPv6 Utilities"
^DIC(19,14242,1,2,0)=" "
^DIC(19,14242,1,3,0)="Convert an IP address (either IPv4 or IPv6) into an IPv6 address in a "
^DIC(19,14242,1,4,0)="standardized format: ""0000:0000:0000:FFFF:0127:0000:0000:0001"".  "
^DIC(19,14242,1,5,0)="Usage: S Y=$$FORCEIP6^XLFIPV(IP)"
^DIC(19,14242,1,6,0)="   VARIABLES:  Input     IP "
^DIC(19,14242,1,7,0)="                           (string) IPv4 or IPv6 Address to be converted."
^DIC(19,14242,1,8,0)="   VARIABLES:  Output    returns:  An IPv6 address in "
^DIC(19,14242,1,9,0)="                           ""hhhh:hhhh:hhhh:hhhh:hhhh:hhhh:hhhh:hhhh"" "
^DIC(19,14242,1,10,0)="                           notation if the input address is valid, or the"
^DIC(19,14242,1,11,0)="                           null address ""::0"" if the input address is "
^DIC(19,14242,1,12,0)="                           invalid."
^DIC(19,14242,25)="IP6^XLFIPV"
^DIC(19,14242,"U")="CONVERT ANY IP ADDRESS TO IPV6"
^DIC(19,14243,0)="XLFIPV VALIDATE^Validate IPv4 and IPv6 address^^R^1^^^^^^^163"
^DIC(19,14243,1,0)="^^9^9^3120810^"
^DIC(19,14243,1,1,0)="XU*8*605 IPv4 and IPv6 Utilities "
^DIC(19,14243,1,2,0)="  "
^DIC(19,14243,1,3,0)="Validate the format of an IP address (either IPv4 or IPv6).  "
^DIC(19,14243,1,4,0)="Usage: S Y=$$VALIDATE^XLFIPV(IP)"
^DIC(19,14243,1,5,0)="   VARIABLES:  Input     IP"
^DIC(19,14243,1,6,0)="                           (string) IPv4 or IPv6 Address to be validated."
^DIC(19,14243,1,7,0)="   VARIABLES:  Output    returns:"
^DIC(19,14243,1,8,0)="                           1 - if the IP address is in a valid format.  "
^DIC(19,14243,1,9,0)="                           0 - if the format is invalid or null input."
^DIC(19,14243,25)="VAL^XLFIPV"
^DIC(19,14243,"U")="VALIDATE IPV4 AND IPV6 ADDRESS"
^DIC(19,14244,0)="XLFIPV VERSION^Show system settings for IPv6^^R^1^^^^^^^163"
^DIC(19,14244,1,0)="^^8^8^3120810^"
^DIC(19,14244,1,1,0)="XU*8*605 IPv4 and IPv6 Utilities"
^DIC(19,14244,1,2,0)=" "
^DIC(19,14244,1,3,0)="Determine the Cache system settings for IPv6."
^DIC(19,14244,1,4,0)="Usage: S Y=$$VERSION^XLFIPV()"
^DIC(19,14244,1,5,0)="   VARIABLES:  Input     None "
^DIC(19,14244,1,6,0)="   VARIABLES:  Output    returns: "
^DIC(19,14244,1,7,0)="                           1 - if IPv6 is enabled.  "
^DIC(19,14244,1,8,0)="                           0 - if IPv6 is disabled."
^DIC(19,14244,25)="VER^XLFIPV"
^DIC(19,14244,"U")="SHOW SYSTEM SETTINGS FOR IPV6"
^DIC(19,14245,0)="XLFIPV IPV4 IPV6 MENU^IPv4 and IPv6 Address Tools^^M^1^^^^^^^163"
^DIC(19,14245,1,0)="^^3^3^3120810^"
^DIC(19,14245,1,1,0)="Patch XU*8*605 includes new utilities to support the VA's transition from "
^DIC(19,14245,1,2,0)="IPv4 to IPv6.  These menu options demonstrate the APIs included in the "
^DIC(19,14245,1,3,0)="patch."
