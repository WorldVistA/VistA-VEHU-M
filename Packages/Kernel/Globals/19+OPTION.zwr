^DIC(19,4591,0)="IB EDIT RETURNED BILL^Edit Returned Bill^^R^.5^IB EDIT^^^^^^192"
^DIC(19,4591,1,0)="^^2^2^2900606^^"
^DIC(19,4591,1,1,0)="This option will allow users to edit a bill that has been returned from"
^DIC(19,4591,1,2,0)="AR to MCCR and return it back to A/R"
^DIC(19,4591,25)="EN1^IBCRTN"
