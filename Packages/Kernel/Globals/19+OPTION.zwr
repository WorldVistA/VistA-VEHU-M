^DIC(19,15168,0)="OR PACT ACT^PACT Act Patient Updater^^R^1^^^^^^^^^1"
^DIC(19,15168,10.1)="Patient Updater"
^DIC(19,15168,20)="W @IOF"
^DIC(19,15168,25)="PATIENT^OR628P"
^DIC(19,15168,"U")="PACT ACT PATIENT UPDATER"
^DIC(19,15169,0)="PRCAC MULT REF RPT^Multiple Referral Programs Report^^R^1^^^^^^^261"
^DIC(19,15169,1,0)="^^3^3^3240719^"
^DIC(19,15169,1,1,0)="This report identifies any bills that may be referred for debt collection "
^DIC(19,15169,1,2,0)="to multiple debt referral programs. The report includes debtors who may"
^DIC(19,15169,1,3,0)="also have a VBA benefit, Aid and Attendance, Housebound, or Pension."
^DIC(19,15169,25)="EN^RCRFRPT"
^DIC(19,15169,"U")="MULTIPLE REFERRAL PROGRAMS REP"
^DIC(19,15170,0)="IBMH MULTI FAC COPAY PULL REQ^Mental Health Copay Pull Request by Patient^^R^1^IB SUPERVISOR^^^^^^"
^DIC(19,15170,1,0)="^^2^2^3240103^"
^DIC(19,15170,1,1,0)="This option asks for a patient and requests MH copay"
^DIC(19,15170,1,2,0)="information at any facility that patient has been treated at.  "
^DIC(19,15170,25)="PULL^IBMHPMPY3"
^DIC(19,15170,"U")="MENTAL HEALTH COPAY PULL REQUE"
^DIC(19,15171,0)="IBMH MULTI FAC COPAY SYNCH^Mental Health synch copay file across facilities^^R^1^^^^^^^"
^DIC(19,15171,1,0)="^19.06^4^4^3240103^^"
^DIC(19,15171,1,1,0)="This option should not be placed on any menu or run by any user. It is"
^DIC(19,15171,1,2,0)="designed to be scheduled in TaskMan to be executed once a day during"
^DIC(19,15171,1,3,0)="off-peak hours. This option is a nightly task that updates Mental Health"
^DIC(19,15171,1,4,0)="COPAY data across a patient's treating facilities."
^DIC(19,15171,25)="UPDATED^IBMHPMPY1"
^DIC(19,15171,"U")="MENTAL HEALTH SYNCH COPAY FILE"
^DIC(19,15172,0)="IBUC EXCEPTION REPORT^Urgent Care Exception Report^^R^1^^^^^^^192"
^DIC(19,15172,1,0)="^^2^2^3230331^"
^DIC(19,15172,1,1,0)="This report allows users to review Urgent Care Visits that did not "
^DIC(19,15172,1,2,0)="successfully update other VAMCs that a Veteran is enrolled in."
^DIC(19,15172,25)="REPORT^IBUCERP"
^DIC(19,15172,"U")="URGENT CARE EXCEPTION REPORT"
^DIC(19,15173,0)="PSJU OTP^OTP Medication Dispense Report^^R^1^^^^^^^197"
^DIC(19,15173,1,0)="^19.06^6^6^3240624^^"
^DIC(19,15173,1,1,0)="Allows the user to print an OTP (Opioid Treatment Program) Medication "
^DIC(19,15173,1,2,0)="Dispense Report by patient for a date range. The report shows whether a "
^DIC(19,15173,1,3,0)="patient received medication in clinic or as a take-home dose within the "
^DIC(19,15173,1,4,0)="date range selected. The report will also display the medication "
^DIC(19,15173,1,5,0)="dispensed, the dose amount, the individual that dispensed the dose, and "
^DIC(19,15173,1,6,0)="the time of the dispensed dose."
^DIC(19,15173,25)="ASK^ORDOTP"
^DIC(19,15173,"U")="OTP MEDICATION DISPENSE REPORT"
^DIC(19,15174,0)="RA REPROC^Reprocess locked study accession error^^R^1^^^^^^^31^^1^1"
^DIC(19,15174,1,0)="^^5^5^3241112^"
^DIC(19,15174,1,1,0)="This option should be scheduled to run every fifteen minutes. Its "
^DIC(19,15174,1,2,0)="primary function is to monitor the 'HL7 MESSAGE EXCEPTION' file for any "
^DIC(19,15174,1,3,0)="'REPROCESS' flags that are triggered by study or report lock errors. Upon "
^DIC(19,15174,1,4,0)="detection, it will automatically reinitiate processing of the affected "
^DIC(19,15174,1,5,0)="result message that was previously rejected due to this issue."
^DIC(19,15174,15)=" K RAOPT(""REPROC"")"
^DIC(19,15174,20)="S RAOPT(""REPROC"")="""""
^DIC(19,15174,25)="REPROC^RAHLRPRO"
^DIC(19,15174,200.9)="y"
^DIC(19,15174,"U")="REPROCESS LOCKED STUDY ACCESSI"
^DIC(19,15175,0)="RASAN ENABLE REPROCESSING^Enable HL7 reprocessing for locked studies^^R^1^^^^^^^31"
^DIC(19,15175,1,0)="^^4^4^3250106^"
^DIC(19,15175,1,1,0)="This option enables a sending application to reprocess HL7 result messages"
^DIC(19,15175,1,2,0)="that were rejected due to a locked study error. Additionally, it includes"
^DIC(19,15175,1,3,0)="a flag that, when set, overrides the radiology NOSEND flag and sends the"
^DIC(19,15175,1,4,0)="reprocessed result message back to the sending application."
^DIC(19,15175,25)="SANABLE^RAHLRPRO"
^DIC(19,15175,"U")="ENABLE HL7 REPROCESSING FOR LO"
^DIC(19,15176,0)="RCDPE ERA MATCH POST AUDIT RPT^ERA Status Change Audit Report^^R^1^^^^^^^261"
^DIC(19,15176,1,0)="^19.06^1^1^3240806^^^"
^DIC(19,15176,1,1,0)="This report is used to display the current status of an ERA plus audit information for auto-post status and match status."
^DIC(19,15176,25)="ERASTR^RCDPEWLE"
^DIC(19,15176,"U")="ERA STATUS CHANGE AUDIT REPORT"
^DIC(19,15177,0)="BPS AUTO CLOSE REJECT^ePharmacy Claim Parameters^^R^1^BPS SUPERVISOR^^^^^^553"
^DIC(19,15177,1,0)="^^3^3^3241104^"
^DIC(19,15177,1,1,0)="This routine allows the user the ability to define reject codes as auto "
^DIC(19,15177,1,2,0)="close reject codes.  The auto close reject codes will provide the ability "
^DIC(19,15177,1,3,0)="to close certain claims if the pharmacist ignores the reject."
^DIC(19,15177,10.1)="ePharmacy Claim Parameters"
^DIC(19,15177,25)="EN^BPSACR"
^DIC(19,15177,"U")="EPHARMACY CLAIM PARAMETERS"
^DIC(19,15178,0)="IB TP VETERAN CHRG RPT^Veteran Third Party Charge Report^^R^1^^^^^^^192"
^DIC(19,15178,1,0)="^^2^2^3230602^"
^DIC(19,15178,1,1,0)="This report allows users to identify outstanding 3rd Party (insurance) "
^DIC(19,15178,1,2,0)="bills for further review."
^DIC(19,15178,25)="EN^IBTPRPT"
^DIC(19,15178,"U")="VETERAN THIRD PARTY CHARGE REP"
