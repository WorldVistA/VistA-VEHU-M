^DIC(19,15877,1,1,0)="Allows users to enable or disable CPRS' ePCS functionality at the site "
^DIC(19,15877,1,2,0)="level."
^DIC(19,15877,1,3,0)="Cloned from ""OR EPCS SITE PARAMETER"" option."
