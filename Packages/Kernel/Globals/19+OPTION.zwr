^DIC(19,11129,0)="WV EDIT PATIENT CASE DATA^Edit/Print Patient Case Data^^R^11597^^^^^^^522"
^DIC(19,11129,1,0)="^^3^3^2980903^"
^DIC(19,11129,1,1,0)="This option allows you to add a new patient and her case data to the WH"
^DIC(19,11129,1,2,0)="register.  It also allows you to edit case data of patients already in the"
^DIC(19,11129,1,3,0)="register."
^DIC(19,11129,25)="WVPATE"
^DIC(19,11129,"U")="EDIT/PRINT PATIENT CASE DATA"
^DIC(19,11130,0)="WV ADD/EDIT CASE MANAGERS^Add/Edit Case Managers^^R^1^^^^^^^522^^1^1"
^DIC(19,11130,1,0)="^^3^3^2980923^"
^DIC(19,11130,1,1,0)="This option allows for Case Managers to be selected from the New Person"
^DIC(19,11130,1,2,0)="(#200) file. If a case manager is inactivated through this option they"
^DIC(19,11130,1,3,0)="will no longer be able to be assigned to WH patients."
^DIC(19,11130,15)="K WVTYPE"
^DIC(19,11130,20)="S WVTYPE=""CM"""
^DIC(19,11130,25)="WVCMGR"
^DIC(19,11130,"U")="ADD/EDIT CASE MANAGERS"
^DIC(19,11131,0)="WV EDIT SITE PARAMETERS^Edit Site Parameters^^R^11597^^^^^^^522"
^DIC(19,11131,1,0)="^^1^1^2980610^"
^DIC(19,11131,1,1,0)="This option allows the program manager to edit several parameters specific to the clinic of hospital where the software is being used."
^DIC(19,11131,25)="WVSITE"
^DIC(19,11131,"U")="EDIT SITE PARAMETERS"
^DIC(19,11132,0)="WV PRINT RES/DIAG FILE^Print Results/Diagnosis File^^R^11597^^^^^^^522"
^DIC(19,11132,1,0)="^^3^3^2980903^"
^DIC(19,11132,1,1,0)="For each procedure type in WH only certain Results/Diagnoses may be"
^DIC(19,11132,1,2,0)="selected.  This option list all procedure types and their corresponding"
^DIC(19,11132,1,3,0)="Results/Diagnoses."
^DIC(19,11132,25)="WVDIAG"
^DIC(19,11132,"U")="PRINT RESULTS/DIAGNOSIS FILE"
^DIC(19,11133,0)="WV PRINT INDIVIDUAL LETTERS^Print Individual Letters^^R^11597^^^^^^^522"
^DIC(19,11133,1,0)="^^2^2^2980610^"
^DIC(19,11133,1,1,0)="This option allows you to print individual notification letters for selected"
^DIC(19,11133,1,2,0)="patients."
^DIC(19,11133,25)="WVLETPR"
^DIC(19,11133,"U")="PRINT INDIVIDUAL LETTERS"
^DIC(19,11134,0)="WV PATIENT PROFILE W/ERRORS^Patient Profile Including Errors^^R^11597^^^^^^^522"
^DIC(19,11134,1,0)="^^4^4^2980610^"
^DIC(19,11134,1,1,0)="Displays the Patient Profile exactly as described under the Patient Profile"
^DIC(19,11134,1,2,0)="option, however it also includes those procedures given a Results/Diagnosis"
^DIC(19,11134,1,3,0)="of Error/Disregard.  This is the only option that displays procedures "
^DIC(19,11134,1,4,0)="entered in error."
^DIC(19,11134,25)="ERRORS^WVPROF"
^DIC(19,11134,"U")="PATIENT PROFILE INCLUDING ERRO"
^DIC(19,11135,0)="WV MENU-MGR PATIENT MGT^Manager's Patient Management^^M^11597^^^^^^^522^^1"
^DIC(19,11135,1,0)="^^2^2^2980914^^^^"
^DIC(19,11135,1,1,0)="This menu allows the Program Manager to view and edit certain types of "
^DIC(19,11135,1,2,0)="patient and procedure data in greater detail."
^DIC(19,11135,10,0)="^19.01PI^10^6"
^DIC(19,11135,10,1,0)="11134^PPE^1"
^DIC(19,11135,10,3,0)="11137^PRL^8"
