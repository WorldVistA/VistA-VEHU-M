^DIC(19,13401,0)="PRSP HR RM^Reconcile Memoranda^^R^1^^^^^^^230"
^DIC(19,13401,1,0)="^19.06^2^2^3050122^^^^"
^DIC(19,13401,1,1,0)="This option allows Human Resources to review part-time physicians memoranda"
^DIC(19,13401,1,2,0)="and to complete its reconciliation."
^DIC(19,13401,25)="MAIN^PRSPRM"
^DIC(19,13401,"U")="RECONCILE MEMORANDA"
^DIC(19,13402,0)="PRSP HR MR^Memoranda Report^^R^1^^^^^^^230"
^DIC(19,13402,1,0)="^19.06^1^1^3050122^^^^"
^DIC(19,13402,1,1,0)="This option allows Human Resources to review a part-time physician's memoranda."
^DIC(19,13402,25)="PAY^PRSPDM"
^DIC(19,13402,"U")="MEMORANDA REPORT"
^DIC(19,13403,0)="PRSP HR DE^Display Pay Period ESR^^R^1^^^^^^^230"
^DIC(19,13403,1,0)="^19.06^2^2^3050122^^^^"
^DIC(19,13403,1,1,0)="This option lets Human Resources review a part-time physician's ESR"
