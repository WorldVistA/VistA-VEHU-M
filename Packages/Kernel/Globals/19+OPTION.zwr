^DIC(19,5709,0)="DVBA C EDIT C&P REQUEST INFO^Edit C&P Request Information^^R^.5^^^^^^^173"
^DIC(19,5709,1,0)="^^2^2^2920813^^^^"
^DIC(19,5709,1,1,0)="Allows editing of only the static 2507 information and the remarks."
^DIC(19,5709,1,2,0)="Does not allow any editing of exam information."
^DIC(19,5709,25)="DVBCREDT"
^DIC(19,5709,99)="55593,44699"
^DIC(19,5709,"U")="EDIT C&P REQUEST INFORMATION"
^DIC(19,5710,0)="DVBA C AMIS REPORT^AMIS 290 Report for C&P^^R^.5^^^^^^^173"
^DIC(19,5710,1,0)="^^3^3^2940610^^^^"
^DIC(19,5710,1,1,0)="Generates AMIS figures for the C&P exams.  Also will optionally send a"
^DIC(19,5710,1,2,0)="bulletin when completed.  The bulletins may be sent via NetMail if"
^DIC(19,5710,1,3,0)="desired."
^DIC(19,5710,25)="DVBCAMIS"
^DIC(19,5710,"U")="AMIS 290 REPORT FOR C&P"
^DIC(19,5711,0)="DVBA C PENDING REPORT^Pending C&P Exams Report^^R^.5^^^^^^^173"
^DIC(19,5711,1,0)="^^7^7^2940401^^^^"
^DIC(19,5711,1,1,0)="Reports any C&P request which are not R, X, RX, C, or CT status."
^DIC(19,5711,1,2,0)=" "
^DIC(19,5711,1,3,0)="""R"" status indicates ""released to RO, not printed""."
^DIC(19,5711,1,4,0)="""C"" status indicates ""Completed, printed by the RO""."
^DIC(19,5711,1,5,0)="""X"" status indicates ""Cancelled by MAS""."
^DIC(19,5711,1,6,0)="""RX"" status indicates ""Cancelled by the RO""."
^DIC(19,5711,1,7,0)="""CT"" status indicates ""Completed, transferred out""."
^DIC(19,5711,25)="DVBCPNDR"
^DIC(19,5711,"U")="PENDING C&P EXAMS REPORT"
^DIC(19,5712,0)="DVBA C NOT SCHEDULED IN 3 DAYS^Report for Exams Not Scheduled in Three Days^^R^.5^^^^^^^173"
^DIC(19,5712,1,0)="^^2^2^2930119^^^^"
^DIC(19,5712,1,1,0)="Reports exams which have not been scheduled within three days of the"
^DIC(19,5712,1,2,0)="request date."
^DIC(19,5712,25)="DVBCNTSC"
^DIC(19,5712,99)="55628,55202"
^DIC(19,5712,"U")="REPORT FOR EXAMS NOT SCHEDULED"
^DIC(19,5713,0)="DVBA C EXAM CHECKLIST^Print Exam Check List for RO^^R^.5^^^^^^^173"
^DIC(19,5713,1,0)="^^5^5^2940401^^^^"
^DIC(19,5713,1,1,0)="Prints a checklist for the RO which is to be used by the Rating Board"
^DIC(19,5713,1,2,0)="in the selection of C & P Exams for Veterans.  It may be run as often"
^DIC(19,5713,1,3,0)="as needed by the RO and should be run whenever exam changes occur."
^DIC(19,5713,1,4,0)=" "
^DIC(19,5713,1,5,0)="This checklist will only be used internally by the RO."
^DIC(19,5713,25)="DVBCEXML"
^DIC(19,5713,60)=""
^DIC(19,5713,62)=""
^DIC(19,5713,63)=""
^DIC(19,5713,64)=""
^DIC(19,5713,"U")="PRINT EXAM CHECK LIST FOR RO"
^DIC(19,5714,0)="DVBA C PRINT FEE COVER SHEET^Print a Fee Exam Cover Sheet^^R^.5^^^^^^^173"
^DIC(19,5714,1,0)="^^2^2^2920813^^^"
^DIC(19,5714,1,1,0)="Prints a cover sheet for cases where the Veteran's physician might not"
^DIC(19,5714,1,2,0)="be familiar with Comp and Pen exams."
^DIC(19,5714,25)="DVBCFEE"
^DIC(19,5714,"U")="PRINT A FEE EXAM COVER SHEET"
^DIC(19,5715,0)="DVBA C REQUESTS BY DATE RANGE^C&P Request List by Date Range^^R^.5^^^^^^^173"
^DIC(19,5715,1,0)="^^4^4^2930329^^^^"
^DIC(19,5715,1,1,0)="This option is used to produce a listing of any 2507 requests on a"
^DIC(19,5715,1,2,0)="date range basis.  A typical use for this option would be to help"
^DIC(19,5715,1,3,0)="reconcile missing requests if some were lost due to printer problems"
^DIC(19,5715,1,4,0)="during the morning printing."
^DIC(19,5715,25)="DVBCRLST"
^DIC(19,5715,99)="55629,27358"
^DIC(19,5715,"U")="C&P REQUEST LIST BY DATE RANGE"
