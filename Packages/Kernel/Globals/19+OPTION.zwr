^DIC(19,12389,0)="DG ALL ADDRESS CHANGE REPORT^Report - All Address Changes^^R^10000000020^^^^^^^114^^"
^DIC(19,12389,1,0)="^19.06^1^1^3030626^^^"
^DIC(19,12389,1,1,0)="This report lists changes to any of the patient primary address fields for the previous 24 hours."
^DIC(19,12389,20)=""
