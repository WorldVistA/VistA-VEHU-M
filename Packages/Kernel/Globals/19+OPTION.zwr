^DIC(19,4177,0)="PRCS REC.DATE SINGLE^Single Transaction^^R^11740^^^^^^^"
^DIC(19,4177,1,0)="^^5^5^2890716^^"
^DIC(19,4177,1,1,0)="Control Point user selects a transaction.  If a P.O. has been entered,"
^DIC(19,4177,1,2,0)="and the date received has not yet been entered, the program checks the"
^DIC(19,4177,1,3,0)="partials.  If the final partial has been received, or the P.O. is"
^DIC(19,4177,1,4,0)="either a Certified Invoice, Direct Delivery or Payment in Advance,"
^DIC(19,4177,1,5,0)="the user is allowed to enter the Date Received by the Service."
