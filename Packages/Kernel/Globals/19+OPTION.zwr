^DIC(19,8991,0)="XUTM CLEAN^Clean Task File^^R^1039^^^^^^^^^"
^DIC(19,8991,1,0)="^^8^8^2890308^^^^"
^DIC(19,8991,1,1,0)="This option will clean out the Task Log for the site manager, removing"
^DIC(19,8991,1,2,0)="all entries for tasks that have completed, have been rejected, or have"
^DIC(19,8991,1,3,0)="bombed with an error.  The site manager is asked to specify how old"
^DIC(19,8991,1,4,0)="such entries can be before they should be deleted; the option then"
^DIC(19,8991,1,5,0)="deletes from ^%ZTSK all inactive tasks that are older than that."
^DIC(19,8991,1,6,0)="Note that this option is not queueable, though it does create a tasked"
^DIC(19,8991,1,7,0)="job to do the actual deletion.  ZTMQCLEAN is the queueable version"
^DIC(19,8991,1,8,0)="of this option."
^DIC(19,8991,25)="OPTION^XUTMK"
^DIC(19,8991,200.9)=""
^DIC(19,8991,"U")="CLEAN TASK FILE"
^DIC(19,8992,0)="XUTM DEL^Delete Tasks^^R^1039^^^^^^^^^"
^DIC(19,8992,1,0)="^^3^3^2910722^^^^"
^DIC(19,8992,1,1,0)="Allows user to dequeue own tasks and delete them from the Task Log."
^DIC(19,8992,1,2,0)="User may delete either a single task or a range of tasks.  Holders of"
^DIC(19,8992,1,3,0)="the ZTMQ key selecting this option may delete any tasks."
^DIC(19,8992,3.91,0)="^19.391^^0"
^DIC(19,8992,25)="XUTMD"
^DIC(19,8992,"U")="DELETE TASKS"
^DIC(19,8993,0)="XUTM REQ^Requeue Tasks^^R^1039^^^^^^^^^"
^DIC(19,8993,1,0)="^^4^4^2881031.1607^^^^"
^DIC(19,8993,1,1,0)="Allows user to requeue own tasks; user may modify the device that the"
^DIC(19,8993,1,2,0)="task is to be run on and also the time that the task is to be run."
^DIC(19,8993,1,3,0)="Holders of the ZTMQ key selecting this option may requeue any tasks,"
^DIC(19,8993,1,4,0)="and may also modify the task's priority and partition size."
^DIC(19,8993,25)="XUTMR"
^DIC(19,8993,"U")="REQUEUE TASKS"
^DIC(19,8994,0)="XUTM DQ^Dequeue Tasks^^R^1039^^^^^^^^^"
^DIC(19,8994,1,0)="^^2^2^2881031.1607^^^"
^DIC(19,8994,1,1,0)="Allows user to dequeue own tasks; holders of the ZTMQ key selecting"
^DIC(19,8994,1,2,0)="this option may dequeue any tasks."
^DIC(19,8994,25)="XUTMDQ"
^DIC(19,8994,"U")="DEQUEUE TASKS"
