^DIC(19,4378,0)="PRCB FCP REACTIVATE^Reactivate a Fund Control Point^^R^11740^^^^^^^"
^DIC(19,4378,1,0)="^^2^2^2940616^^^^"
^DIC(19,4378,1,1,0)="This option allows the user to reactivate a control point that had been"
^DIC(19,4378,1,2,0)="deactivated and is therefore unusable."
^DIC(19,4378,25)="REA^PRCB1A2"
^DIC(19,4378,"U")="REACTIVATE A FUND CONTROL POIN"
