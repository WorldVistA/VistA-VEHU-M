^DIC(19,11147,1,0)="^^2^2^2980923^"
^DIC(19,11147,1,1,0)="This option lists all of the Women's Health Mammogram Diagnoses followed"
^DIC(19,11147,1,2,0)="by the corresponding Radiology Diagnostic Codes."
