^DIC(19,609,0)="SDM^Make Appointment^^R^.5^^^^^^^16^^1^1"
^DIC(19,609,1,0)="^^3^3^2970721^^^^"
^DIC(19,609,1,1,0)="Allow user to make an appointment for a specific time for a patient"
^DIC(19,609,1,2,0)="in a Clinic.  Also allows deletion of appointment."
^DIC(19,609,1,3,0)="Displays ""Month-At-A-Glance"" for Clinic."
^DIC(19,609,15)="D SDM^SDKILL K ORACTION,ORVP,XQORQUIT D HDLKILL^SDAMEVT"
^DIC(19,609,20)="K ORACTION,ORVP,XQORQUIT D HDLKILL^SDAMEVT"
