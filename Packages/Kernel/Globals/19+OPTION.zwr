^DIC(19,13144,0)="PRCH NIF UPDATE REPORT^Item Descriptions After NIF Update^^R^10000000020^^^^^^^121"
^DIC(19,13144,1,0)="^19.06^5^5^3040908^^"
^DIC(19,13144,1,1,0)="This option displays the pre-NIF and current values of the Short"
^DIC(19,13144,1,2,0)="Description (#.05) and the Description (#.1) fields, along with"
^DIC(19,13144,1,3,0)="the most recent Short Description edit date and the Inactive Flag."
^DIC(19,13144,1,4,0)="The user has a choice of up to 5 sort keys to specify the sort orders"
^DIC(19,13144,1,5,0)="at run time."
^DIC(19,13144,25)="PRT^PRCHITM2"
^DIC(19,13144,"U")="ITEM DESCRIPTIONS AFTER NIF UP"
^DIC(19,13145,0)="IBT UNREVIEWED CODING REPORT^Un-reviewed Claims for Coders Report^^R^10000000020^^^^^^^192"
^DIC(19,13145,1,0)="^19.06^5^5^3050718^^"
^DIC(19,13145,1,1,0)="This report is designed to be run by staff to determine which Claims "
^DIC(19,13145,1,2,0)="Tracking events still require review. "
^DIC(19,13145,1,3,0)=" "
^DIC(19,13145,1,4,0)="The user is prompted for the OUTPATIENT ENCOUNTER START DATE and "
^DIC(19,13145,1,5,0)="OUTPATIENT ENCOUNTER END DATE."
^DIC(19,13145,25)="UNREV^IBTOECT"
^DIC(19,13145,"U")="UN-REVIEWED CLAIMS FOR CODERS "
^DIC(19,13146,0)="IBT ENTERED NOT REVIEWED^CT Entered/Not Reviewed Report^^R^10000000020^^^^^^^192"
^DIC(19,13146,1,0)="^^11^11^3050718^"
^DIC(19,13146,1,1,0)="This new report will allow the MCCF staff to identify encounters that have"
^DIC(19,13146,1,2,0)="been:"
^DIC(19,13146,1,3,0)="    1.  Reviewed by the coders and are ready to bill (indicated by a "
^DIC(19,13146,1,4,0)="        non-blank findings type) and"
^DIC(19,13146,1,5,0)="    2.  not reviewed by code (indicated by a blank findings type)"
^DIC(19,13146,1,6,0)=" "
^DIC(19,13146,1,7,0)="The report prints all outpatient reimbursable insurance claims in file "
^DIC(19,13146,1,8,0)="#399 with a status of Entered/Not Reviewed.  The user input criteria for "
^DIC(19,13146,1,9,0)="the report is the Event Date range."
^DIC(19,13146,1,10,0)=" "
^DIC(19,13146,1,11,0)="The user is prompted for the EVENT START DATE and EVENT END DATE."
^DIC(19,13146,25)="ENR^IBTOECT"
^DIC(19,13146,"U")="CT ENTERED/NOT REVIEWED REPORT"
^DIC(19,13147,0)="IBT QUICK REV CODING STAT^Quick Review Coding Status Report^^P^10000000020^^^^^^^192^^1^1"
^DIC(19,13147,1,0)="^19.06^12^12^3050717^^^^"
^DIC(19,13147,1,1,0)="This report allows the MCCF staff to select a specific patient to see "
^DIC(19,13147,1,2,0)="the status of the claim so they know at a glance whether or not it is "
^DIC(19,13147,1,3,0)="ready for billing."
^DIC(19,13147,1,4,0)=" "
^DIC(19,13147,1,5,0)="The report input variable is: Patient Name"
^DIC(19,13147,1,6,0)="Report is sorted by ENCOUNTER DATE/TIME"
^DIC(19,13147,1,7,0)="The following fields are to printed on this report:"
^DIC(19,13147,1,8,0)="1.      Patient Social Security Number"
^DIC(19,13147,1,9,0)="2.      Outpatient  Encounter Location"
^DIC(19,13147,1,10,0)="3.      Encounter Date and Time "
^DIC(19,13147,1,11,0)="4.      Reason Not Billable"
^DIC(19,13147,1,12,0)="5.      Billable Findings Type"
^DIC(19,13147,15)="K DFN"
^DIC(19,13147,20)="N DIC S DIC=""^DPT("",DIC(0)=""AEMNQ"" D ^DIC S:Y<1 XQUIT=1 S:Y>0 DFN=+Y"
^DIC(19,13147,60)="IBT(356,"
^DIC(19,13147,62)=0
^DIC(19,13147,63)="[IBT QUICK REV CODING STAT]"
