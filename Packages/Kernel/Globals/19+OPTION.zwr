^DIC(19,16216,0)="EHM-01037^Import/Install a Health Summary Object^^R^1^^^^^^^^^^^"
^DIC(19,16216,1,0)="^19.06^11^11^3240328^^^"
^DIC(19,16216,1,1,0)="This option is used to install a Health Summary Object "
^DIC(19,16216,1,2,0)="exported using the GMTS OBJ EXPORT option.  The incoming "
^DIC(19,16216,1,3,0)="Object must first be unpacked from the incoming Mailman "
^DIC(19,16216,1,4,0)="message using Packman utilities.  Then this option is used "
^DIC(19,16216,1,5,0)="to install the object into the Health Summary files.  "
^DIC(19,16216,1,6,0)="If there is a Health Summary Type with the same name as "
^DIC(19,16216,1,7,0)="the Health Summary being imported, then you will be prompted"
^DIC(19,16216,1,8,0)="to either use the existing Health Summary Type, or to "
^DIC(19,16216,1,9,0)="rename the incoming Health Summary Type.  At no time will "
^DIC(19,16216,1,10,0)="an existing Health Summary Type be over written."
^DIC(19,16216,1,11,0)="Cloned from ""GMTS OBJ IMPORT/INSTALL"" option."
^DIC(19,16216,3)=""
^DIC(19,16216,25)="INS^GMTSOBJ"
^DIC(19,16216,"U")="IMPORT/INSTALL A HEALTH SUMMAR"
^DIC(19,16217,0)="EHM-01038^Check Medication Reconciliation Configuration^^R^1^^^^^^^160^^^^"
^DIC(19,16217,1,0)="^^4^4^3240328^"
^DIC(19,16217,1,1,0)="This option allows a site to confirm that the setup of Health Summary "
^DIC(19,16217,1,2,0)="Types is consistent with the intent of the Medication Reconciliation "
^DIC(19,16217,1,3,0)="approach for use as the 'Essential Med List for Review'."
