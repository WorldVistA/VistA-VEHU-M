^DIC(19,23,"U")="MAIL GROUP EDIT"
^DIC(19,24,0)="XMSTAT^Message statistics^^R^11748^^^^^^^54^^^^"
^DIC(19,24,1,0)="^19.06^12^12^3010419^^^^"
^DIC(19,24,1,1,0)="This interactive option displays information about past purges and"
^DIC(19,24,1,2,0)="about current mailbox usage.  This option should not be scheduled."
^DIC(19,24,1,3,0)=""
^DIC(19,24,1,4,0)="First, it displays the types and results of the last 20 purges of the"
^DIC(19,24,1,5,0)="MESSAGE file 3.9.  It tells you whether the purge was an unreferenced"
^DIC(19,24,1,6,0)="message purge (option XMPURGE or XMAUTOPURGE), or a date purge (option"
^DIC(19,24,1,7,0)="XMPURGE-BY-DATE).  It tells you when it started and ended, how long it"
^DIC(19,24,1,8,0)="took, how many messages were purged, and how many were left."
^DIC(19,24,1,9,0)=" "
^DIC(19,24,1,10,0)="Next, it displays information about each user in the MESSAGE file 3.7."
^DIC(19,24,1,11,0)="It tells you how many messages they have in their mailboxes, when they"
^DIC(19,24,1,12,0)="last logged on, and when they last used MailMan."
^DIC(19,24,20)=""
^DIC(19,24,25)="STAT^XMA3"
^DIC(19,24,"U")="MESSAGE STATISTICS"
^DIC(19,25,0)="XMPURGE^Purge Unreferenced Messages^^R^11748^^^^^^^^^^^"
^DIC(19,25,1,0)="^19.06^7^7^3010419^^^^"
^DIC(19,25,1,1,0)="This  option, if scheduled, does exactly what option XMAUTOPURGE does,"
^DIC(19,25,1,2,0)="and then stops."
^DIC(19,25,1,3,0)=""
^DIC(19,25,1,4,0)="This  option, if run interactively, does exactly what option XMAUTOPURGE"
^DIC(19,25,1,5,0)="does, and then it does exactly what option XMSTAT does, and then it stops."
^DIC(19,25,1,6,0)=""
^DIC(19,25,1,7,0)="You should NOT schedule this option."
^DIC(19,25,20)=""
^DIC(19,25,25)="SCAN^XMA3"
^DIC(19,25,200)="^^"
^DIC(19,25,"U")="PURGE UNREFERENCED MESSAGES"
