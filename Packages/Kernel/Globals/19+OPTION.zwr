^DIC(19,7174,1,2,0)="file that have a status of 'Error in Transmission'.  The user is prompted"
^DIC(19,7174,1,3,0)="for the date range for the report."
^DIC(19,7174,25)="PLFT^HLUOPT"
^DIC(19,7174,"U")="FAILED TRANSMISSION REPORT (NO"
^DIC(19,7175,0)="HL SERVER^HL7 Mail Message Server^^S^.5^^^^^^^304"
