^DIC(19,16030,0)="EHM-00851^Build Primary Menu Trees^^R^1^^100^^^^^^^^^"
^DIC(19,16030,1,0)="^^6^6^3240328^^"
^DIC(19,16030,1,1,0)="This option can be used to force the rebuilding of the tree structures"
^DIC(19,16030,1,2,0)="used for the ^JUMP.  Whenever an item in a menu is modified, the tree"
^DIC(19,16030,1,3,0)="must get rebuilt.  This will happen automatically the first time it is"
^DIC(19,16030,1,4,0)="referenced, but forcing the rebuild can often save time."
^DIC(19,16030,1,5,0)="The rebuilding of all trees can be queued."
^DIC(19,16030,1,6,0)="Cloned from ""XQBUILDTREE"" option."
^DIC(19,16030,3)=""
^DIC(19,16030,25)="BUILD^XQ81"
^DIC(19,16030,99.1)="66618,61249"
^DIC(19,16030,"U")="BUILD PRIMARY MENU TREES"
^DIC(19,16031,0)="EHM-00852^Most Recent Menu Rebuilds^^R^1^^^^^^y^163^y^^^"
^DIC(19,16031,1,0)="^^5^5^3240328^"
^DIC(19,16031,1,1,0)="        This option runs the program ^XQ84 which formats the data stored"
^DIC(19,16031,1,2,0)="in the global ^XUTL(""XQ"",""BUILDS"") the 20 most recent menu rebuilds,"
^DIC(19,16031,1,3,0)="including complete live rebuilds, micro surgery episodes, and tasked"
^DIC(19,16031,1,4,0)="rebuilds."
^DIC(19,16031,1,5,0)="Cloned from ""XQSHOWBUILDS"" option."
^DIC(19,16031,3)=""
^DIC(19,16031,25)="SHOW^XQ84"
^DIC(19,16031,"U")="MOST RECENT MENU REBUILDS"
^DIC(19,16032,0)="EHM-00853^Kick Off Micro Surgery^^R^1^^^^^^^^y^1^^"
^DIC(19,16032,1,0)="^^10^10^3240328^"
^DIC(19,16032,1,1,0)="     When certain changes are made to the Option File those changes are"
^DIC(19,16032,1,2,0)="recorded in the cross-reference ^DIC(19,""AT"").  Micro surgery is the"
^DIC(19,16032,1,3,0)="software in ^XQ83* that uses this data to rebuild the compiled menu trees"
^DIC(19,16032,1,4,0)="in ^DIC(19,""AXQ"").  Micro surgery is normally triggered when a user logs"
^DIC(19,16032,1,5,0)="into a system, but this option allows the programmer to start it manually"
^DIC(19,16032,1,6,0)="if minor changes are made to the Option File which do not merit a complete"
^DIC(19,16032,1,7,0)="rebuild.  If there is nothing in the ""AT"" cross reference to work on the"
^DIC(19,16032,1,8,0)="option responds: ""Nothing to rebuild."", if there is work to do then the"
^DIC(19,16032,1,9,0)="option responds with ""Done."" meaning that Micro surgery has been started."
^DIC(19,16032,1,10,0)="Cloned from ""XQKICKMICRO"" option."
^DIC(19,16032,3)=""
^DIC(19,16032,20)="W !!,?5,$S($D(^DIC(19,""AT"")):""Done."",1:""Nothing to rebuild."")"
^DIC(19,16032,25)="CHEK^XQ83"
^DIC(19,16032,"U")="KICK OFF MICRO SURGERY"
^DIC(19,16033,0)="EHM-00854^Is there a menu rebuild running right now?^^R^1^^^^^^y^^y^^^"
^DIC(19,16033,1,0)="^^3^3^3240328^"
^DIC(19,16033,1,1,0)="     This option checks the various flags set in ^DIC(19,""AXQ"",""P0"") to"
^DIC(19,16033,1,2,0)="determine if there is menu rebuild activity on your system right now."
^DIC(19,16033,1,3,0)="Cloned from ""XQRIGHTNOW"" option."
^DIC(19,16033,3)=""
^DIC(19,16033,25)="NOW^XQ84"
^DIC(19,16033,"U")="IS THERE A MENU REBUILD RUNNIN"
^DIC(19,16034,0)="EHM-00855^Single User Menu Tree Rebuild^^R^1^^^^^^^163^y^^^"
^DIC(19,16034,1,0)="^^5^5^3240328^"
^DIC(19,16034,1,1,0)="This option collects the menus that a user has in the primary and"
^DIC(19,16034,1,2,0)="secondary fields of the OPTION file (#19) and then rebuilds the menu tree."
^DIC(19,16034,1,3,0)="Note that other users might have the same menu tree, but this will only "
^DIC(19,16034,1,4,0)="rebuild the menu tree for the selected user."
^DIC(19,16034,1,5,0)="Cloned from ""XQBUILDUSER"" option."
^DIC(19,16034,3)=""
^DIC(19,16034,25)="USER^XQ84"
^DIC(19,16034,200.9)="^y"
^DIC(19,16034,"U")="SINGLE USER MENU TREE REBUILD"
