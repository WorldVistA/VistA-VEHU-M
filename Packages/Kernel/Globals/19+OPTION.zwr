^DIC(19,13615,1,1,0)="Add an entry to the NEW PERSON file.  A person should only be added with "
^DIC(19,13615,1,2,0)="this option if that person will NOT be provided a user account to sign on"
^DIC(19,13615,1,3,0)="the computer, but will be assigned responsibility for IT equipment."
^DIC(19,13615,25)="ADDNP^ENTIUTL"
^DIC(19,13615,"U")="ADD ENTRY TO NEW PERSON FILE"
^DIC(19,13616,0)="ENIT RESP NOTIFY^Notify User of IT Assignments Requiring Signature^^A^1^^^^^^^33^^1"
