^DIC(19,1067,1,2,0)="items currently ordered for any selected ward."
^DIC(19,1067,25)="EN2^FHNO4"
^DIC(19,1067,"U")="REVIEW BULK NUTRITION LOCATION"
^DIC(19,1068,0)="FHNO10^Print Bulk Feedings/Cost Report^^R^10000000020^^^^^^^"
^DIC(19,1068,1,0)="^19.06^4^4^3030617^^^^"
^DIC(19,1068,1,1,0)="This option will produce a delivery listing or labels"
^DIC(19,1068,1,2,0)="for all bulk supplemental feedings for all wards served by a"
^DIC(19,1068,1,3,0)="Supplemental Feeding Site. A cost report and consolidated pick"
