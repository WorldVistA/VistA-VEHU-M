^DIC(19,7396,67)="REPORT OF ALL BUILDING DATA"
^DIC(19,7396,"U")="PRINT ALL BUILDING DATA"
^DIC(19,7397,0)="ENPLM18^Activations E/E^^R^.5^^^^^^^33"
^DIC(19,7397,1,0)="^^1^1^2930427^^^"
^DIC(19,7397,1,1,0)="This option enables enter/edit of project activations information."
^DIC(19,7397,25)="ACT^ENPL2"
^DIC(19,7397,"U")="ACTIVATIONS E/E"
^DIC(19,7398,0)="QAM COPY MONITOR EDIT^Copy/Edit a Monitor^^R^.5^^^^^^^"
^DIC(19,7398,1,0)="^^7^7^2910417^^"
^DIC(19,7398,1,1,0)="Copy/Edit a Monitor:  Takes existing monitor and copies it to a new "
^DIC(19,7398,1,2,0)="monitor.  It automatically changes the code to ""Copy of ..."" and the "
^DIC(19,7398,1,3,0)="Title to ""Copy of ..."".  this field allows up to 30 characters, so the code "
^DIC(19,7398,1,4,0)="and name may be truncated if it is too long.  If the Code on the "
^DIC(19,7398,1,5,0)="original monitor is ""XX-1"" then the code for the copy would read "
^DIC(19,7398,1,6,0)="""Copy of XX-1"".  It is recommended that the user change the code and "
^DIC(19,7398,1,7,0)="title of the new monitor once the copy is made."
^DIC(19,7398,25)="QAMDUP0"
^DIC(19,7398,"U")="COPY/EDIT A MONITOR"
^DIC(19,7399,0)="QAM BUILD MONITOR EDIT^Enter/Edit a Monitor^^R^.5^^^^^^^"
^DIC(19,7399,1,0)="^^3^3^2960118^^^^"
^DIC(19,7399,1,1,0)="Enter/Edit a Monitor:  Allows user to build a monitor.  Once it is "
^DIC(19,7399,1,2,0)="marked as ""Finished"", certain fields may no longer be edited except "
^DIC(19,7399,1,3,0)="through the Programmer Menu."
^DIC(19,7399,25)="QAMEDT0"
^DIC(19,7399,"U")="ENTER/EDIT A MONITOR"
^DIC(19,7400,0)="QAM PGMR MONITOR EDIT^Monitor File Edit^^R^.5^^^^^^^"
^DIC(19,7400,1,0)="^^6^6^2920527^^^"
^DIC(19,7400,1,1,0)="Monitor File Edit:  This is the only place where the status of a "
^DIC(19,7400,1,2,0)="monitor can be changed from ""Finished"" to ""Under Construction"" so "
^DIC(19,7400,1,3,0)="the user can do further editing to the monitor.  It also allows editing "
^DIC(19,7400,1,4,0)="of certain programmer specific fields in the monitor file.  It is also "
^DIC(19,7400,1,5,0)="used when adding routines like new worksheets to a specific "
^DIC(19,7400,1,6,0)="monitor."
^DIC(19,7400,25)="QAMEDT2"
^DIC(19,7400,"U")="MONITOR FILE EDIT"
^DIC(19,7401,0)="QAM GROUP FILE EDIT^Group Edit^^R^.5^^^^^^^"
^DIC(19,7401,1,0)="^^4^4^2910417^^"
^DIC(19,7401,1,1,0)="Group Edit:  Allows user to create groups off of any DHCP file that is "
^DIC(19,7401,1,2,0)="in a QAM application group.  Example:  The Ward Location file "
^DIC(19,7401,1,3,0)="contains all the wards at the site.  The user can select specific wards "
^DIC(19,7401,1,4,0)="from this file to create a group."
^DIC(19,7401,25)="QAMEDT6"
^DIC(19,7401,"U")="GROUP EDIT"
^DIC(19,7402,0)="QAM QUICK MONITOR EDIT^Quick Monitor Edit^^R^.5^^^^^^^"
^DIC(19,7402,1,0)="^^2^2^2910417^^"
^DIC(19,7402,1,1,0)="Quick Monitor Edit:  Allows quick editing of on/off switch, start and "
^DIC(19,7402,1,2,0)="end dates, bulletin switches, and bulletin mail groups."
^DIC(19,7402,25)="QAMEDT1"
^DIC(19,7402,"U")="QUICK MONITOR EDIT"
