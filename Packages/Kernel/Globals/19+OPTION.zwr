^DIC(19,9935,0)="XUPR RTN PATCH^Routines by Patch Number^^R^983^^^^^^^163"
^DIC(19,9935,1,0)="^^2^2^2960920^^"
^DIC(19,9935,1,1,0)="This options will print routines associated with a patch.  You must"
