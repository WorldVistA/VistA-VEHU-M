^DIC(19,13181,1,0)="^19.06^2^2^3030305^^^"
^DIC(19,13181,1,1,0)="This option allows the editing of the Kernel System Parameters for IP "
^DIC(19,13181,1,2,0)="lockout and/or User lockout and Terminal server list entry."
^DIC(19,13181,20)="N DA,DR,DIE S DA=1,DR=""[XUSITEIP]"",DIE=8989.3 D XUDIE^XUS5"
