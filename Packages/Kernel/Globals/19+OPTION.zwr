^DIC(19,10908,"U")="LAB EPI PROTOCOL EDIT"
^DIC(19,10912,0)="XPAR LIST BY PARAM^List Values for a Selected Parameter^^A^11712^^^^^^^^^1"
^DIC(19,10912,1,0)="^^2^2^2970625^"
^DIC(19,10912,1,1,0)="This option prompts for a parameter (defined in the PARAMETER DEFINITION"
^DIC(19,10912,1,2,0)="file) and lists all value instances for that parameter."
^DIC(19,10912,10.1)="List Values by Parameter"
^DIC(19,10912,20)="D ALLPARS^XPARLIST"
^DIC(19,10912,"U")="LIST VALUES FOR A SELECTED PAR"
^DIC(19,10913,0)="XPAR LIST BY ENTITY^List Values for a Selected Entity^^A^11712^^^^^^^^^1"
^DIC(19,10913,1,0)="^^2^2^2970625^"
^DIC(19,10913,1,1,0)="This option prompts for the entry of an entity (location, user, etc.) and"
^DIC(19,10913,1,2,0)="lists all value instances for that entity."
^DIC(19,10913,10.1)="List Values by Entity"
^DIC(19,10913,20)="D ALLENTS^XPARLIST"
^DIC(19,10913,"U")="LIST VALUES FOR A SELECTED ENT"
^DIC(19,10914,0)="XPAR LIST BY PACKAGE^List Values for a Selected Package^^A^11712^^^^^^^^^1"
^DIC(19,10914,1,0)="^^2^2^2970625^"
^DIC(19,10914,1,1,0)="This option prompts for a package and lists all parameter values for the"
^DIC(19,10914,1,2,0)="selected package."
^DIC(19,10914,10.1)="List Values by Package"
^DIC(19,10914,20)="D ALLPKG^XPARLIST"
^DIC(19,10914,"U")="LIST VALUES FOR A SELECTED PAC"
^DIC(19,10915,0)="XPAR LIST BY TEMPLATE^List Values for a Selected Template^^A^11712^^^^^^^^^1"
^DIC(19,10915,1,0)="^^3^3^2970625^"
^DIC(19,10915,1,1,0)="This option prompts for a parameter template.  Depending on the definition"
^DIC(19,10915,1,2,0)="of the template, additional information may be prompted for and then the"
^DIC(19,10915,1,3,0)="parameter values defined by the template are displayed."
^DIC(19,10915,10.1)="List Values by Template"
^DIC(19,10915,20)="D TMPLT^XPARLIST()"
^DIC(19,10915,"U")="LIST VALUES FOR A SELECTED TEM"
^DIC(19,10916,0)="XPAR EDIT PARAMETER^Edit Parameter Values^^A^11712^^^^^^^^^1"
^DIC(19,10916,1,0)="^^3^3^2990824^^^"
^DIC(19,10916,1,1,0)="The option calls the low level parameter editor which allows you to edit"
^DIC(19,10916,1,2,0)="the values for every parameter.  Normally packages supply other means of"
^DIC(19,10916,1,3,0)="editing parameters."
^DIC(19,10916,10.1)="Edit Parameter Values"
^DIC(19,10916,20)="D ^XPAREDIT"
^DIC(19,10916,"U")="EDIT PARAMETER VALUES"
^DIC(19,10917,0)="XPAR MENU TOOLS^General Parameter Tools^^M^11712^^^^^^^"
^DIC(19,10917,1,0)="^^1^1^2990824^^"
^DIC(19,10917,1,1,0)="This menu contains general purpose tools for managing parameters."
^DIC(19,10917,10,0)="^19.01IP^7^7"
^DIC(19,10917,10,1,0)="10912^LV^1"
