^DIC(19,3249,0)="DG GECS MAIN MENU^MAS Code Sheet Manager Menu^^M^.5^^^^^^^114"
^DIC(19,3249,1,0)="^^11^11^2950301^^^^"
^DIC(19,3249,1,1,0)="This menu will allow the MAS ADPAC or MAS Code Sheet Manager to"
^DIC(19,3249,1,2,0)="have access to all MAS Code Sheet options. This menu"
^DIC(19,3249,1,3,0)="contains the 'MAS Code Sheet User' Menu which has the enter/edit,"
^DIC(19,3249,1,4,0)="print and delete code sheet options. The menu also contains the"
^DIC(19,3249,1,5,0)="'MAS Code Sheet Batch' Menu which has the MAS batch type menu"
^DIC(19,3249,1,6,0)="options used to coordinate and group all the MAS code sheets so"
^DIC(19,3249,1,7,0)="that they can be transmitted. The menu also contains the 'MAS"
^DIC(19,3249,1,8,0)="Code Sheet Transmission' Menu which has the MAS transmission"
^DIC(19,3249,1,9,0)="options used to transmit the MAS Code Sheets. The menu also"
^DIC(19,3249,1,10,0)="contains the option to purge code sheets and associated"
^DIC(19,3249,1,11,0)="transmitted batches."
^DIC(19,3249,10,0)="^19.01PI^4^4"
^DIC(19,3249,10,1,0)="3247^USR^1"
^DIC(19,3249,10,2,0)="3335^BAT^2"
^DIC(19,3249,10,3,0)="3336^TRAN^3"
^DIC(19,3249,10,4,0)="3240^PUR^4"
