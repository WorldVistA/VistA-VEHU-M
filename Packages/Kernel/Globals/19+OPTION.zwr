^DIC(19,9393,0)="PRCP WHERE ITEM STOCKED REPORT^Display Where An Item Is Stocked^^R^11740^^^^^^^"
^DIC(19,9393,1,0)="^^3^3^2920211^^^^"
^DIC(19,9393,1,1,0)="This option will print a report showing which inventory points"
^DIC(19,9393,1,2,0)="stock a specified item.  The report will show the distribution"
^DIC(19,9393,1,3,0)="point, quantity on hand, and unit per issue."
^DIC(19,9393,20)=""
^DIC(19,9393,25)="PRCPRSTK"
^DIC(19,9393,"U")="DISPLAY WHERE AN ITEM IS STOCK"
^DIC(19,9394,0)="PRCP2 PURGE MENU^Purge History Menu^^M^11740^^^^^^^^^1"
^DIC(19,9394,1,0)="^^2^2^2920211^^^^"
^DIC(19,9394,1,1,0)="This menu contains options allowing the user to purge various history"
^DIC(19,9394,1,2,0)="files, in order to free up disk space."
^DIC(19,9394,10,0)="^19.01PI^3^3"
^DIC(19,9394,10,1,0)="9387^^"
