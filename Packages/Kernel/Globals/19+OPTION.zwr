^DIC(19,16549,1,0)="^^4^4^3240328^^^^"
^DIC(19,16549,1,1,0)="This is a menu of PCE clinical reports that clinicians can use for"
^DIC(19,16549,1,2,0)="summary level information about their patients, workload activity, and"
^DIC(19,16549,1,3,0)="encounter counts."
^DIC(19,16549,1,4,0)="Cloned from ""PXRR CLINICAL REPORTS"" option."
^DIC(19,16549,3)=""
^DIC(19,16549,10,0)="^19.01IP^6^6"
^DIC(19,16549,10,1,0)="16550^CP^10"
^DIC(19,16549,10,2,0)="16551^LE^30"
