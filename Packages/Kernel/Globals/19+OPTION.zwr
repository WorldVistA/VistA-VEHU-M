^DIC(19,13907,"U")="DSS DOCMANAGER IMAGING SYSTEM"
^DIC(19,13908,0)="DSIV NIGHTLY REPORT^DSIV Nightly Report^^R^10000000216^^^^^^^568"
^DIC(19,13908,1,0)="^^6^6^3071109^"
^DIC(19,13908,1,1,0)="Tasked process to run the DSS Inc ICB Exception Report each night.  Other "
^DIC(19,13908,1,2,0)="report(s) may be added to this process at a later date.  The job should "
^DIC(19,13908,1,3,0)="be queued in the evening after the scheduling job has changed the "
^DIC(19,13908,1,4,0)="appointment status of appointments that were not checked-in/out.  The "
^DIC(19,13908,1,5,0)="Exception report requires appts to be checked out before they can be "
^DIC(19,13908,1,6,0)="evaluated."
^DIC(19,13908,25)="N1^DSIVICR2"
^DIC(19,13908,200.9)="y"
^DIC(19,13908,"U")="DSIV NIGHTLY REPORT"
^DIC(19,13909,0)="DSIV EXCEPTION REPORT^ICB Exception Report^^R^10000000216^^^^^^^"
^DIC(19,13909,1,0)="^^3^3^3071109^"
^DIC(19,13909,1,1,0)="Runs the ICB Exception Report in real-time.  This option should only ever "
^DIC(19,13909,1,2,0)="be used for comparison to the nightly queued job and only for a single "
^DIC(19,13909,1,3,0)="date since it looks up ALL appointments in ALL active clinics!"
^DIC(19,13909,25)="RPT^DSIVICR1"
^DIC(19,13909,"U")="ICB EXCEPTION REPORT"
^DIC(19,13910,0)="TIU VBC LINE COUNT REPORT^Transcription Billing Verification Report^^A^10000000216^^^^^^^516^^1"
^DIC(19,13910,1,0)="^19.06^3^3^3090727^^^"
^DIC(19,13910,1,1,0)="This option produces a report for the verification of transcription "
^DIC(19,13910,1,2,0)="bills, using the Visible Black Character counting method described in VHA "
^DIC(19,13910,1,3,0)="Directive 2008-042."
^DIC(19,13910,20)="D MAIN^TIURVBC"
^DIC(19,13910,"U")="TRANSCRIPTION BILLING VERIFICA"
^DIC(19,13911,0)="YTQ PNOTE FLAG^Stop/Re-Start Progress Notes for an Instrument^^R^10000000216^^^^^^^"
^DIC(19,13911,1,0)="^19.06^2^2^3081015^^"
^DIC(19,13911,1,1,0)="Allows site to turn off MHA3 generated TIU notes for a specified "
^DIC(19,13911,1,2,0)="instrument."
^DIC(19,13911,25)="NOPNOTE^YTQAPI14"
^DIC(19,13911,"U")="STOP/RE-START PROGRESS NOTES F"
^DIC(19,13912,0)="YTQ MHA3 MENU^MHA3 Utilities^^M^10000000216^^^^^^^^^1"
^DIC(19,13912,1,0)="^19.06^1^1^3100224^^^^"
