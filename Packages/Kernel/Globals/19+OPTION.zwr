^DIC(19,16593,0)="EHM-01414^Edit PL Site Parameters^^R^1^^^^^^^402^^^^"
^DIC(19,16593,1,0)="^^4^4^3240328^^^^"
^DIC(19,16593,1,1,0)="This option allows quick access to toggle the site parameters"
^DIC(19,16593,1,2,0)="controlling the behavior of the PL application; these are stored"
^DIC(19,16593,1,3,0)="in the PL Site Parameters file #125.99."
^DIC(19,16593,1,4,0)="Cloned from ""GMPL PARAMETER EDIT"" option."
