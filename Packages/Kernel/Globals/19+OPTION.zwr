^DIC(19,13068,0)="PSU MAP PHARMACY LOCATIONS^Map Pharmacy Locations^^R^10000000020^^^^^^^367"
^DIC(19,13068,1,0)="^19.06^7^7^3040902^^^^"
^DIC(19,13068,1,1,0)="This option allows the mapping of dispensing/procurement locations from "
^DIC(19,13068,1,2,0)="the AR/WS, Controlled Substances, and Drug Accountability applications to "
^DIC(19,13068,1,3,0)="either a Medical Center Division or an Outpatient Site.  Any "
^DIC(19,13068,1,4,0)="dispensing/procurement data associated with an AR/WS AOU, CS NAOU or DA "
^DIC(19,13068,1,5,0)="Pharmacy Location that has not been mapped will be attributed to the "
^DIC(19,13068,1,6,0)="facility at which the database resides.  Any unmapped locations will be "
^DIC(19,13068,1,7,0)="displayed upon entering the option."
^DIC(19,13068,25)="PSUMAP0"
^DIC(19,13068,99)="59569,48784"
