^DIC(19,3883,1,0)=2
^DIC(19,3883,1,1,0)="This option allows for editing only the item cost field"
^DIC(19,3883,1,2,0)="in the Ingredient file (113)."
^DIC(19,3883,25)="EN3^FHADM5"
^DIC(19,3883,"U")="EDIT INGREDIENT COST"
^DIC(19,3884,0)="FHBIR^Birthday List^^R^10000000020^^^^^^^"
^DIC(19,3884,1,0)="^19.06^5^5^3040524^^^^"
^DIC(19,3884,1,1,0)="This option will print a list of all patients with a birthday in"
^DIC(19,3884,1,2,0)="a particular month or those with a birthday on a specific month"
^DIC(19,3884,1,3,0)="and day."
^DIC(19,3884,1,4,0)=""
^DIC(19,3884,1,5,0)="As of Version 5.5, the birthday list may be printed for outpatients as well."
^DIC(19,3884,25)="FHBIR"
^DIC(19,3884,99)="55593,31173"
^DIC(19,3884,"U")="BIRTHDAY LIST"
