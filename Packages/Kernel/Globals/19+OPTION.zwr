^DIC(19,14938,0)="XTVS PKG EXTRACT SERVER^Process XTVS Request Message^^S^1^^^^^^^349"
^DIC(19,14938,1,0)="^19.06^21^21^3201009^^^^"
^DIC(19,14938,1,1,0)="This server option will process a Kernel Toolkit VistA Package Size request"
^DIC(19,14938,1,2,0)="message.  The VistA Package Size report tool can request the following"
^DIC(19,14938,1,3,0)="information from a remote VistA via a request message to this option:"
^DIC(19,14938,1,4,0)="  - Size report for a single VistA package on another production VistA"
^DIC(19,14938,1,5,0)="  - Package file extract from any production VistA.  Optionally, a size"
^DIC(19,14938,1,6,0)="      a report for all packages can be requested from Forum in addition"
^DIC(19,14938,1,7,0)="      to a Package file extract."
^DIC(19,14938,1,8,0)=" "
^DIC(19,14938,1,9,0)="This option processes a request and returns the global in a VA MailMan"
^DIC(19,14938,1,10,0)="message."
^DIC(19,14938,1,11,0)=" "
^DIC(19,14938,1,12,0)="Request message form:"
^DIC(19,14938,1,13,0)="  REQUESTED BY: {E-Mail address} - Recipient of size report"
^DIC(19,14938,1,14,0)="  Extract Indicator: {0 or 1} - 0 means no extract"
^DIC(19,14938,1,15,0)="                                1 means extract Package file"
^DIC(19,14938,1,16,0)="  Report Indicator: {1 or 2} - 1 means All Packages Size rpt"
^DIC(19,14938,1,17,0)="                               2 means Single Package Size rpt"
^DIC(19,14938,1,18,0)="  Package Parameters: Line 1 is the packaged parameters for the selected"
^DIC(19,14938,1,19,0)="                        package to report followed by parameters for all"
^DIC(19,14938,1,20,0)="                        packages in the parameter file [single package"
^DIC(19,14938,1,21,0)="                        report only]"
^DIC(19,14938,25)="SRVREXT^XTVSSVR"
^DIC(19,14938,220)="^R^^Y^N^E"
^DIC(19,14938,"U")="PROCESS XTVS REQUEST MESSAGE"
