^DIC(19,13827,"U")="MEDICAL FOSTER HOME (MFH) MENU"
^DIC(19,13828,0)="HBHCWORK^Worksheet for MFH  (80)^^R^10000000020^^^^^^^328"
^DIC(19,13828,1,0)="^19.06^5^5^3070629^^"
^DIC(19,13828,1,1,0)="This option prints the Medical Foster Home (MFH) Data Entry Worksheet."
^DIC(19,13828,1,2,0)="MFH must exist in HBHC Medical Foster Home file (633.2).  Any data already"
^DIC(19,13828,1,3,0)="on file will be printed on the report.  A line of underscores will be"
^DIC(19,13828,1,4,0)="printed when no data exists for a specific field.  Worksheet prints in 80"
^DIC(19,13828,1,5,0)="column format."
^DIC(19,13828,25)="EN^HBHCWORK"
^DIC(19,13828,"U")="WORKSHEET FOR MFH  (80)"
^DIC(19,13829,0)="HBHC MFH INSPECTION INPUT^Inspection Data Entry for MFH^^E^10000000020^^^^^^^328"
^DIC(19,13829,1,0)="^19.06^2^2^3070629^^^^"
^DIC(19,13829,1,1,0)="This option allows data entry of the Medical Foster Home (MFH) Inspection "
^DIC(19,13829,1,2,0)="multiples in the HBHC Medical Foster Home file (#633.2)."
^DIC(19,13829,30)="HBHC(633.2,"
^DIC(19,13829,31)="AEMQ"
^DIC(19,13829,50)="HBHC(633.2,"
^DIC(19,13829,51)="[HBHC MFH INSPECTION INPUT]"
^DIC(19,13829,"U")="INSPECTION DATA ENTRY FOR MFH"
^DIC(19,13830,0)="HBHC MFH TRAINING INPUT^Training Data Entry for MFH^^E^10000000020^^^^^^^328"
^DIC(19,13830,1,0)="^19.06^2^2^3070629^^^"
^DIC(19,13830,1,1,0)="This option allows data entry of the Medical Foster Home (MFH) Training"
^DIC(19,13830,1,2,0)="multiples in the HBHC Medical Foster Home file (#633.2)."
^DIC(19,13830,30)="HBHC(633.2,"
^DIC(19,13830,31)="AEMQ"
^DIC(19,13830,50)="HBHC(633.2,"
^DIC(19,13830,51)="[HBHC MFH TRAINING INPUT]"
^DIC(19,13830,"U")="TRAINING DATA ENTRY FOR MFH"
^DIC(19,13831,0)="HBHCBLNK^Blank MFH Worksheet Report  (80)^^R^10000000020^^^^^^^328"
^DIC(19,13831,1,0)="^^2^2^3070725^"
^DIC(19,13831,1,1,0)="This option prints the HBPC Medical Foster Home (MFH) Blank Worksheet "
^DIC(19,13831,1,2,0)="Report.  Report prints in 80 column format."
^DIC(19,13831,25)="BLANK^HBHCWORK"
^DIC(19,13831,"U")="BLANK MFH WORKSHEET REPORT  (8"
^DIC(19,13832,0)="HBHC MFH AUTO-QUEUED REMINDERS^Auto-queued Inspection/Training Reminder e-mail^^R^10000000020^^^^^^^328"
^DIC(19,13832,1,0)="^19.06^11^11^3080108^^"
^DIC(19,13832,1,1,0)="This option runs a monthly auto-queued batch job to create separate e-mail"
^DIC(19,13832,1,2,0)="reminder messages for HBPC Medical Foster Home (MFH) Inspections &/or"
^DIC(19,13832,1,3,0)="Training due within the next 3 months, based on month only.  This job"
^DIC(19,13832,1,4,0)="should be scheduled for the 1st day of each month, regardless of day of"
^DIC(19,13832,1,5,0)="the week for 1st."
^DIC(19,13832,1,6,0)=" "
^DIC(19,13832,1,7,0)="The MFH Inspection & Training data used by this option are multiples with"
^DIC(19,13832,1,8,0)="the HBHC MEDICAL FOSTER HOME file (#633.2)."
^DIC(19,13832,1,9,0)=" "
^DIC(19,13832,1,10,0)="Members in mail group HBHC MEDICAL FOSTER HOME receive the reminder mail"
^DIC(19,13832,1,11,0)="messages."
^DIC(19,13832,25)="DQ^HBHCRP27"
^DIC(19,13832,"U")="AUTO-QUEUED INSPECTION/TRAININ"
^DIC(19,13833,0)="HBHCRP27^Inspection/Training Due Report for MFH  (80)^^R^10000000020^^^^^^^328"
^DIC(19,13833,1,0)="^19.06^6^6^3070831^^"
^DIC(19,13833,1,1,0)="This option prints the HBPC Medical Foster Home (MFH) Inspection or "
^DIC(19,13833,1,2,0)="Training report.  Inspection & Training data are multiples with the HBHC"
^DIC(19,13833,1,3,0)="MEDICAL FOSTER HOME file (#633.2). The data includes inspections/training"
^DIC(19,13833,1,4,0)="due within the next 6 months, based on month only.  Report includes:  "
^DIC(19,13833,1,5,0)="inspections/training due & most recent inspection/training date.  Report"
^DIC(19,13833,1,6,0)="prints in 80 column format."
^DIC(19,13833,25)="HBHCRP27"
^DIC(19,13833,"U")="INSPECTION/TRAINING DUE REPORT"
^DIC(19,13834,0)="HBHCRP28^Rate Paid Report for MFH  (80)^^R^10000000020^^^^^^^328"
^DIC(19,13834,1,0)="^^9^9^3071212^"
^DIC(19,13834,1,1,0)="This option prints the HBPC Medical Foster Home (MFH) Rate Paid report.  "
^DIC(19,13834,1,2,0)="Rate Paid data is a multiple in the HBHC PATIENT file (#631).  The user "
^DIC(19,13834,1,3,0)="selects to sort the data by Patient or MFH, then to include Active ONLY, "
^DIC(19,13834,1,4,0)="Individual, or All Patients or MFHs, then whether to include Current ONLY"
^DIC(19,13834,1,5,0)="Rate or All Rates Paid.  MFH sort also prompts for whether to include"
^DIC(19,13834,1,6,0)="Discharged Patients.  Report includes:  Patient Name, Last Four, Rate"
^DIC(19,13834,1,7,0)="Paid, Start Date, & Medical Foster Home Name.  Report selection criteria"
^DIC(19,13834,1,8,0)="is listed in the report header.  Lowest, Highest, & Average Rate Paid are "
^DIC(19,13834,1,9,0)="included at the end of the report.  Report prints in 80 column format."
^DIC(19,13834,25)="HBHCRP28"
^DIC(19,13834,"U")="RATE PAID REPORT FOR MFH  (80)"
^DIC(19,13835,0)="HBHCTXT^Rate Paid Delimited Text File Output^^R^10000000020^^^^^^^328"
^DIC(19,13835,1,0)="^19.06^9^9^3080828^^^"
^DIC(19,13835,1,1,0)="This option creates the HBPC Medical Foster Home (MFH) Rate Paid delimited"
^DIC(19,13835,1,2,0)="text file, suitable for spreadsheet import.  Rate Paid data is a multiple"
^DIC(19,13835,1,3,0)="in the HBHC PATIENT file (#631).  The user selects to sort the data by"
^DIC(19,13835,1,4,0)="Patient or MFH, then to include Active ONLY, Individual, or All Patients"
^DIC(19,13835,1,5,0)="or MFHs, then whether to include Current ONLY Rate or All Rates Paid.  "
^DIC(19,13835,1,6,0)="File includes:  Patient Name, Last Four, Rate Paid, Start Date, for"
^DIC(19,13835,1,7,0)="Patient sort, plus Medical Foster Home Name is included on MFH sort.  MFH "
^DIC(19,13835,1,8,0)="sort also prompts for whether to include Discharged Patients.  File is"
^DIC(19,13835,1,9,0)="delimited by ""^""."
^DIC(19,13835,25)="HBHCTXT"
^DIC(19,13835,"U")="RATE PAID DELIMITED TEXT FILE "
^DIC(19,13836,0)="HBHCTXT2^Inspection/Training Delimited Text File Output^^R^10000000020^^^^^^^328"
^DIC(19,13836,1,0)="^19.06^15^15^3080828^^^"
^DIC(19,13836,1,1,0)="This option creates the HBPC Medical Foster Home (MFH) Inspection or "
^DIC(19,13836,1,2,0)="Training data delimited text file, suitable for spreadsheet import.  "
^DIC(19,13836,1,3,0)="Inspection & Training data are multiples in the HBHC MEDICAL FOSTER HOME"
^DIC(19,13836,1,4,0)="file (#633.2).  Inspection multiples include:  Nurse, Social Work, "
^DIC(19,13836,1,5,0)="Dietitian, & Fire/Safety Inspections.  Training multiples include:  Home"
^DIC(19,13836,1,6,0)="Operation, Fire/Safety, Medication Management, Personal Care, Infection"
^DIC(19,13836,1,7,0)="Control, End of Life, & Other as training categories. Other training"
^DIC(19,13836,1,8,0)="category also contains Topic field."
^DIC(19,13836,1,9,0)=" "
^DIC(19,13836,1,10,0)="The user selects Inspection or Training data.  All data on file is"
^DIC(19,13836,1,11,0)="included in exported text file. Inspection File includes: Medical Foster"
^DIC(19,13836,1,12,0)="Home Name, MFH Closure Date, Inspection Discipline, Inspection Date, &"
^DIC(19,13836,1,13,0)="Inspector Name. Training File includes:  Medical Foster Home Name, MFH"
^DIC(19,13836,1,14,0)="Closure Date, Training Category, Training Date, & Other Training Topic.  "
^DIC(19,13836,1,15,0)="File is delimited by ""^""."
^DIC(19,13836,25)="HBHCTXT2"
^DIC(19,13836,"U")="INSPECTION/TRAINING DELIMITED "
^DIC(19,13837,0)="HBHCRP29^License Due for MFH Report  (80)^^R^10000000020^^^^^^^328"
^DIC(19,13837,1,0)="^^5^5^3080318^"
^DIC(19,13837,1,1,0)="This option prints the HBPC Medical Foster Home (MFH) License Due report."
^DIC(19,13837,1,2,0)="The report is sorted alphabetically by MFH Name & contains MFH Name & "
^DIC(19,13837,1,3,0)="License Expiration Date.  The report includes License Expiration Dates due"
^DIC(19,13837,1,4,0)="to expire within 6 months, based on month only.  The report prints in 80"
^DIC(19,13837,1,5,0)="column format."
^DIC(19,13837,25)="HBHCRP29"
^DIC(19,13837,"U")="LICENSE DUE FOR MFH REPORT  (8"
^DIC(19,13838,0)="HBHC MFH AUTO-Q LICENSE DUE^Auto-queued License Due Reminder e-mail^^R^10000000020^^^^^^^328"
^DIC(19,13838,1,0)="^^13^13^3080318^"
^DIC(19,13838,1,1,0)="This option runs a monthly auto-queued batch job to create an e-mail"
^DIC(19,13838,1,2,0)="message for HBPC Medical Foster Home(s) (MFH) with License due within the"
^DIC(19,13838,1,3,0)="next 3 months, based on month only.  This job should be scheduled for the"
^DIC(19,13838,1,4,0)="1st day of each month, regardless of day of the week for 1st."
^DIC(19,13838,1,5,0)=" "
^DIC(19,13838,1,6,0)="Note:  This option does NOT need to be scheduled to run for HBPC MFH sites"
^DIC(19,13838,1,7,0)="which are in states that do not require licensure."
^DIC(19,13838,1,8,0)=" "
^DIC(19,13838,1,9,0)="The MFH License data used by this option resides in the HBHC MEDICAL"
^DIC(19,13838,1,10,0)="FOSTER HOME file (#633.2)."
^DIC(19,13838,1,11,0)=" "
^DIC(19,13838,1,12,0)="Members in mail group HBHC MEDICAL FOSTER HOME receive the reminder mail"
^DIC(19,13838,1,13,0)="message."
^DIC(19,13838,25)="DQ^HBHCRP29"
^DIC(19,13838,"U")="AUTO-QUEUED LICENSE DUE REMIND"
^DIC(19,13839,0)="HBHC MFH REPORTS MENU^MFH Reports^^M^10000000020^^^^^^^328"
^DIC(19,13839,1,0)="^^12^12^3080305^"
^DIC(19,13839,1,1,0)="This option is the HBPC Medical Foster Home (MFH) Reports Menu.  The "
^DIC(19,13839,1,2,0)="option includes:"
^DIC(19,13839,1,3,0)=" "
^DIC(19,13839,1,4,0)="   MFH File Data Report  (132) [HBHCRP26]"
^DIC(19,13839,1,5,0)="   Worksheet for MFH  (80) [HBHCWORK]"
^DIC(19,13839,1,6,0)="   Inspection/Training Due Report for MFH  (80) [HBHCRP27]"
^DIC(19,13839,1,7,0)="   Rate Paid Report for MFH  (80) [HBHCRP28]"
^DIC(19,13839,1,8,0)="   License Due for MFH Report  (80) [HBHCRP29]"
^DIC(19,13839,1,9,0)="   Caregiver Age Report  (132) [HBHCRP30]"
^DIC(19,13839,1,10,0)="   Form Errors Report for MFH  (80) [HBHCRP31]"
^DIC(19,13839,1,11,0)="   Delimited Text File Output Menu for MFH ... "
^DIC(19,13839,1,12,0)="      [HBHC MFH TEXT FILE OUTPUT MENU]"
