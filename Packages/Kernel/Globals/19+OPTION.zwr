^DIC(19,7181,0)="DGYP PROVIDER CONVERSION^Provider Conversion Report^^A^.5^^^^^^^307^^1"
^DIC(19,7181,1,0)="^^52^52^2930714^^^^"
^DIC(19,7181,1,1,0)="The Provider Conversion Report will examine all provider"
^DIC(19,7181,1,2,0)="references in the following PIMS files for entries that cannot be"
^DIC(19,7181,1,3,0)="converted."
^DIC(19,7181,1,4,0)=" "
^DIC(19,7181,1,5,0)="          PATIENT File (#2)"
^DIC(19,7181,1,6,0)="          SCHEDULED ADMISSION File (#41.1)"
^DIC(19,7181,1,7,0)="          HOSPITAL LOCATION File (#44)"
^DIC(19,7181,1,8,0)="          PTF File (#45)"
^DIC(19,7181,1,9,0)="          FACILITY TREATING SPECIALTY File (#45.7)"
^DIC(19,7181,1,10,0)="          BENEFICIARY TRAVEL CLAIM File (#392)"
^DIC(19,7181,1,11,0)="          PATIENT MOVEMENT File (#405)"
^DIC(19,7181,1,12,0)=" "
^DIC(19,7181,1,13,0)="During the post init of PIMS v5.3, the Provider Conversion will delete"
^DIC(19,7181,1,14,0)="any references that cannot be converted. This report will list entries"
^DIC(19,7181,1,15,0)="in the file so that they can be reviewed and corrected prior to"
^DIC(19,7181,1,16,0)="installing PIMS v5.3. The MAS ADPAC should run this option to review "
^DIC(19,7181,1,17,0)="the listing and make any necessary corrections. No data will be "
^DIC(19,7181,1,18,0)="changed as a result of running this report. It is the responsibility "
^DIC(19,7181,1,19,0)="of the MAS ADPAC to review the report and determine if any changes "
^DIC(19,7181,1,20,0)="need to be made."
^DIC(19,7181,1,21,0)=" "
^DIC(19,7181,1,22,0)="Most discrepancies can be attributed to entries in the PERSON File #16"
^DIC(19,7181,1,23,0)="that are not contained in the NEW PERSON File (#200) or duplicate "
^DIC(19,7181,1,24,0)="entries in file #16 or #200."
^DIC(19,7181,1,25,0)=" "
^DIC(19,7181,1,26,0)="Using the following FileMan print, you can identify all entries in the"
^DIC(19,7181,1,27,0)="PERSON File that do not have an entry in the USER File (#3)."
^DIC(19,7181,1,28,0)=" "
^DIC(19,7181,1,29,0)="VA FileMan 19.0"
^DIC(19,7181,1,30,0)=" "
^DIC(19,7181,1,31,0)=" "
^DIC(19,7181,1,32,0)="Select OPTION: 2  PRINT FILE ENTRIES"
^DIC(19,7181,1,33,0)=" "
^DIC(19,7181,1,34,0)="OUTPUT FROM WHAT FILE: PERSON// "
^DIC(19,7181,1,35,0)="SORT BY: NAME// "
^DIC(19,7181,1,36,0)="START WITH NAME: FIRST// "
^DIC(19,7181,1,37,0)="FIRST PRINT FIELD: 30.003  USER FILE POINTER  "
^DIC(19,7181,1,38,0)="THEN PRINT FIELD: .01  NAME  "
^DIC(19,7181,1,39,0)="THEN PRINT FIELD: "
^DIC(19,7181,1,40,0)="HEADING: PERSON LIST// "
^DIC(19,7181,1,41,0)="DEVICE:   LAT    RIGHT MARGIN: 80// "
^DIC(19,7181,1,42,0)=" "
^DIC(19,7181,1,43,0)=" "
^DIC(19,7181,1,44,0)="Once all entries have been resolved between the two files, careful "
^DIC(19,7181,1,45,0)="review of all remaining inconsistencies should be performed. If the "
^DIC(19,7181,1,46,0)="records are old and the data is not considered critical, then the site"
^DIC(19,7181,1,47,0)="does not have to make any further changes. Once the conversion has "
^DIC(19,7181,1,48,0)="run, the entries that cannot be converted will be stuffed with a NULL."
^DIC(19,7181,1,49,0)=" "
^DIC(19,7181,1,50,0)="Otherwise, using the appropriate option open/edit the records in "
^DIC(19,7181,1,51,0)="question to resolve the inconsistent pointers. Please refer to the MAS"
^DIC(19,7181,1,52,0)="Users manual for instructions on entering the correct data."
^DIC(19,7181,20)="D ^DGYPV1"
^DIC(19,7181,99)="55619,61391"
^DIC(19,7181,"U")="PROVIDER CONVERSION REPORT"
