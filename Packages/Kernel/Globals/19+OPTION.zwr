^DIC(19,12232,0)="IBCE QUERY PENDING BATCH^Pending Batch Transmission Status Report^^R^10000000020^^^^^^^"
^DIC(19,12232,1,0)="^^3^3^2990601^^^^"
^DIC(19,12232,1,1,0)="This report shows the current transmission status of a batch's mail message."
^DIC(19,12232,1,2,0)="It also includes the mail message number it was sent in along with the first"
^DIC(19,12232,1,3,0)="and last date/times it was sent."
^DIC(19,12232,25)="QSTAT^IBCEQBS"
^DIC(19,12232,"U")="PENDING BATCH TRANSMISSION STA"
^DIC(19,12234,0)="IBCE BATCHES PENDING TOO LONG^EDI Batches Pending Receipt^^R^1^^^^^^^"
^DIC(19,12234,1,0)="^^4^4^2961001^^"
^DIC(19,12234,1,1,0)="This report lists all batches by batch type that have been in a PENDING"
^DIC(19,12234,1,2,0)="status and have not yet received confirmation of receipt from Austin for"
^DIC(19,12234,1,3,0)="more than 1 day.  Report includes pending since date and mail message # the"
^DIC(19,12234,1,4,0)="batch is contained in."
^DIC(19,12234,25)="PENDING^IBCERP3"
^DIC(19,12234,"U")="EDI BATCHES PENDING RECEIPT"
^DIC(19,12235,0)="IBCE EDI BATCHES INCOMPLETE^Bills Needing Resubmission Action^^R^10000000020^^^^^^^"
^DIC(19,12235,1,0)="^^3^3^2991112^^^^"
^DIC(19,12235,1,1,0)="This report lists all batches that have been resubmitted, but not all bills"
^DIC(19,12235,1,2,0)="were included.  These are batches that have at least one bill still not"
^DIC(19,12235,1,3,0)="resubmitted or canceled."
^DIC(19,12235,25)="INC^IBCERP1"
^DIC(19,12235,"U")="BILLS NEEDING RESUBMISSION ACT"
^DIC(19,12236,0)="IBCE MSGS PENDING TOO LONG^EDI Messages Not Yet Filed^^R^10000000020^^^^^^^"
^DIC(19,12236,1,0)="^^2^2^3020313^"
^DIC(19,12236,1,1,0)="This report lists EDI messages still waiting to be filed after a user "
^DIC(19,12236,1,2,0)="specified number of days."
^DIC(19,12236,25)="PENDING^IBCERP4"
^DIC(19,12236,"U")="EDI MESSAGES NOT YET FILED"
^DIC(19,12237,0)="IBCE RULE MAINTENANCE^Transmission Rule Maintenance^^R^10000000020^^^^^^^192"
^DIC(19,12237,1,0)="^^2^2^2990429^^^^"
^DIC(19,12237,1,1,0)="This option will allow for the adding of new electronic transmission rules"
^DIC(19,12237,1,2,0)="and to modify existing ones."
^DIC(19,12237,25)="EN^IBCEF6"
^DIC(19,12237,"U")="TRANSMISSION RULE MAINTENANCE"
^DIC(19,12238,0)="IBCE RETURN MSG PROCESSING^Return Message Filing Exceptions^^R^10000000020^^^^^^^192"
^DIC(19,12238,1,0)="^19.06^6^6^3010613^^^"
^DIC(19,12238,1,1,0)="This option allows for the display of a list of return messages that"
^DIC(19,12238,1,2,0)="have been received at the site, but have been left in the temporary"
^DIC(19,12238,1,3,0)="STATUS MESSAGE file.  This may have been because of a system error or"
^DIC(19,12238,1,4,0)="the message may not have been received in a readable format.  This"
^DIC(19,12238,1,5,0)="option provides the means to delete the message or to attempt to"
^DIC(19,12238,1,6,0)="reapply it against the VistA data base."
^DIC(19,12238,25)="EN^IBCEM1"
^DIC(19,12238,"U")="RETURN MESSAGE FILING EXCEPTIO"
^DIC(19,12239,0)="IBCE ELECTRONIC ERROR REPORT^Electronic Error Report^^R^10000000020^^^^^^^"
^DIC(19,12239,1,0)="^^2^2^2990601^^^"
^DIC(19,12239,1,1,0)="This report provides a tool for billing personnel to identify the who,"
^DIC(19,12239,1,2,0)="what, and where of errors in electronic billing process."
^DIC(19,12239,25)="BEG^IBCERP2"
^DIC(19,12239,"U")="ELECTRONIC ERROR REPORT"
^DIC(19,12240,0)="IBCE 837 MANUAL TRANSMIT^Transmit EDI Bills - Manual^^R^10000000020^IB SUPERVISOR^^^^^^192"
^DIC(19,12240,1,0)="^^3^3^2990629^^^^"
^DIC(19,12240,1,1,0)="This job batches and transmits bills that are in authorized or Request MRA"
^DIC(19,12240,1,2,0)="status for insurance companies flagged to transmit electronically via EDI."
^DIC(19,12240,1,3,0)="This job can be executed at any time to transmit bills awaiting extract."
^DIC(19,12240,25)="EN1^IBCE"
^DIC(19,12240,"U")="TRANSMIT EDI BILLS - MANUAL"
^DIC(19,12241,0)="IBCE CLAIMS STATUS AWAITING^Claims Status Awaiting Resolution^^R^10000000020^IB SUPERVISOR^^^^^^192"
^DIC(19,12241,1,0)="^19.06^5^5^3010724^^^^"
^DIC(19,12241,1,1,0)="Used by bill staff to review the most current status messages received for"
^DIC(19,12241,1,2,0)="a bill(s) and do follow-up on the bills. Users will be able to select a"
^DIC(19,12241,1,3,0)="bill from the list to view the details and the entire message text as well"
^DIC(19,12241,1,4,0)="as to mark the message as reviewed or under review and document user"
^DIC(19,12241,1,5,0)="comments."
^DIC(19,12241,25)="EN^IBCECSA"
^DIC(19,12241,"U")="CLAIMS STATUS AWAITING RESOLUT"
^DIC(19,12242,0)="IBCE READY FOR EXTRACT REP^Ready for Extract Status Report^^R^10000000020^^^^^^^"
^DIC(19,12242,1,0)="^^3^3^2991227^^^^"
^DIC(19,12242,1,1,0)="This report provides a list of claims held in a Ready for"
^DIC(19,12242,1,2,0)="Extract status due to the EDI/MRA IB site parameter"
^DIC(19,12242,1,3,0)="field being turned off."
^DIC(19,12242,25)="EN^IBCERP6"
^DIC(19,12242,"U")="READY FOR EXTRACT STATUS REPOR"
^DIC(19,12243,0)="IBCE EXTRACT STATUS^Extract Status Management^^R^10000000020^^^^^^^"
^DIC(19,12243,1,0)="^19.06^4^4^3010724^^^^"
^DIC(19,12243,1,1,0)="This is a list manager screen that will display bills that are trapped in a"
^DIC(19,12243,1,2,0)="ready for extract status due to the EDI/MRA parameter being turned off. "
^DIC(19,12243,1,3,0)="From here, the valid actions are cancel a bill, cancel/clone/authorize"
^DIC(19,12243,1,4,0)="a bill without user interaction, or print the report."
^DIC(19,12243,25)="EN^IBCEXTR"
^DIC(19,12243,"U")="EXTRACT STATUS MANAGEMENT"
^DIC(19,12244,0)="IBCE TRANSMIT SELECTED BILLS^Transmit Selected Bills^^R^10000000020^^^^^^^192"
^DIC(19,12244,1,0)="^19.06^2^2^3000627^^^^"
^DIC(19,12244,1,1,0)="This option allows a user to transmit one or more transmittable claims that"
^DIC(19,12244,1,2,0)="are waiting to be transmitted and are in a WAITING FOR EXTRACT status."
^DIC(19,12244,25)="SUB1^IBCEM03"
^DIC(19,12244,"U")="TRANSMIT SELECTED BILLS"
^DIC(19,12245,0)="IBCE PROVIDER MAINT^Provider ID Maintenance^^R^10000000020^IB PROVIDER EDIT^^^^^^192"
