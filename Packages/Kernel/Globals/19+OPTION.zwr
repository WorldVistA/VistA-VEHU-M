^DIC(19,13429,0)="PRCP ON-DEMAND AUDIT REPORT^On-Demand Audit Activity Report^^R^1^^^^^^^"
^DIC(19,13429,1,0)="^^4^4^3060613^"
^DIC(19,13429,1,1,0)="This report will list information for any item in the selected inventory"
^DIC(19,13429,1,2,0)="point whose On-Demand setting has ever been changed.  The report will"
^DIC(19,13429,1,3,0)="include the date/time of the change, who made the change, the reason for"
^DIC(19,13429,1,4,0)="the change and what the setting was set to."
^DIC(19,13429,25)="PRIMARY^PRCPRODA"
