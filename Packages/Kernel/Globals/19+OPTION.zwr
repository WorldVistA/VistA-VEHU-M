^DIC(19,5280,0)="ECTA SPACE^Space Survey^^R^.5^^^^^^^189"
^DIC(19,5280,1,0)="^^4^4^2901003^^^"
^DIC(19,5280,1,1,0)="This option displays the following fields from the Engineering"
^DIC(19,5280,1,2,0)="Space file (#6928): room number, service, function, square"
^DIC(19,5280,1,3,0)="foot, and building number.  The user may choose to sort by building"
^DIC(19,5280,1,4,0)=" number or by service."
