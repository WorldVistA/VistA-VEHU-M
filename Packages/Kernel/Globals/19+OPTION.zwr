^DIC(19,14741,200.9)="^y"
^DIC(19,14741,"U")="DELETE WORK ITEMS"
^DIC(19,14742,0)="DDE AUTO GEN ENTITY FOR A DD #^Generate an Entity for a File^^R^1^^^^^^^309^^^^"
^DIC(19,14742,1,0)="^19.06^2^2^3190522^^^^"
^DIC(19,14742,1,1,0)="This option will generate an Entity for a user selected Data Dictionary # "
^DIC(19,14742,1,2,0)="(DD #)."
^DIC(19,14742,3)=""
^DIC(19,14742,25)="MAIN^DDEMAP"
^DIC(19,14742,"U")="GENERATE AN ENTITY FOR A FILE"
^DIC(19,14743,0)="DDE ENTITY INQUIRE^Print an Entity^^R^1^^^^^^^^^^^"
^DIC(19,14743,1,0)="^^1^1^3190522^"
^DIC(19,14743,1,1,0)="This option will prompt for an ENTITY File (#1.5) entry and then display the information."
^DIC(19,14743,3)=""
^DIC(19,14743,25)="EN^DDEPRT"
^DIC(19,14743,"U")="PRINT AN ENTITY"
^DIC(19,14744,0)="RCDPE MARKED AUTO-POST REPORT^EEOBs Marked for Auto-Post Audit Report^^R^1^^^^^^^261"
^DIC(19,14744,1,0)="^^3^3^3180705^"
^DIC(19,14744,1,1,0)="The marked for autopost audit report will list the user who marked an EEOB"
^DIC(19,14744,1,2,0)="for autopost. Lines included in the report are based on filter criteria "
^DIC(19,14744,1,3,0)="selected at run time by the end user."
^DIC(19,14744,25)="EN^RCDPEMAP"
^DIC(19,14744,"U")="EEOBS MARKED FOR AUTO-POST AUD"
^DIC(19,14745,0)="RCDPE EFT OVERRIDE REPORT^Pending EFT Override Report^^R^1^^^^^^^"
^DIC(19,14745,1,0)="^^3^3^3180710^"
^DIC(19,14745,1,1,0)="This report allows listing by date range of unposted medical"
^DIC(19,14745,1,2,0)="EFTs that are older than the limit set in the NUMBER OF DAYS (AGE) OF UNPOSTED"
^DIC(19,14745,1,3,0)="MEDICAL EFTS TO PREVENT POSTING parameter."
^DIC(19,14745,25)="EN^RCDPEFTL"
^DIC(19,14745,"U")="PENDING EFT OVERRIDE REPORT"
^DIC(19,14746,0)="RCDPE DUPLICATE ERA WORKLIST^Duplicate ERA Worklist^^A^1^^^^^^^^^1"
^DIC(19,14746,1,0)="^^2^2^3180730^"
^DIC(19,14746,1,1,0)="Used for the Duplicate ERA Worklist"
^DIC(19,14746,1,2,0)="See ListMan template: RCDPEX DUPLICATE ERA LIST"
^DIC(19,14746,20)="D EN1^RCDPEX1"
^DIC(19,14746,"U")="DUPLICATE ERA WORKLIST"
^DIC(19,14747,0)="RCDPE AUTO PARAM HIST REPORT^Auto Parameter History Report^^R^1^^^^^^^261"
^DIC(19,14747,25)="EN^RCDPESP8"
^DIC(19,14747,"U")="AUTO PARAMETER HISTORY REPORT"
