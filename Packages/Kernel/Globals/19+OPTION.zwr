^DIC(19,7880,10,"B",7876,2)=""
^DIC(19,7880,99)="58072,42129"
^DIC(19,7880,"U")="APPLICATION UTILITIES"
^DIC(19,7881,0)="XQAB ERROR LOG XMIT^Errors Logged in Alpha/Beta Test (QUEUED)^^R^1039^^^^^^^"
^DIC(19,7881,1,0)="^^14^14^2930726^"
^DIC(19,7881,1,1,0)=" "
^DIC(19,7881,1,2,0)="This option is used to identify any errors associated with an application"
^DIC(19,7881,1,3,0)="package which is in either alpha or beta test.  The identified errors are"
^DIC(19,7881,1,4,0)="combined in a mail message which includes the type of error, the routine"
^DIC(19,7881,1,5,0)="involved, the date (usually the previous day), and the option which was"
^DIC(19,7881,1,6,0)="being used at the time of the error, and the number of times the error was"
^DIC(19,7881,1,7,0)="logged.  The volume and uci are included so that stations with error logs"
^DIC(19,7881,1,8,0)="being maintained on different cpus can run the task on each different"
^DIC(19,7881,1,9,0)="system.  This option was designed to be tasked.  It does not require a"
^DIC(19,7881,1,10,0)="device and generates a mail message to the developing ISC.  An alpha or"
^DIC(19,7881,1,11,0)="beta package is indicated by the presence of the package (and its"
^DIC(19,7881,1,12,0)="namespaces in the Alpha/Beta Package multiple of the Kernel Site Parameter"
^DIC(19,7881,1,13,0)="file.  The option should usually be scheduled to run after midnight, and"
^DIC(19,7881,1,14,0)="scheduled for re-queuing at a daily interval."
^DIC(19,7881,25)="XQABERR"
^DIC(19,7881,200.9)="y"
^DIC(19,7881,"U")="ERRORS LOGGED IN ALPHA/BETA TE"
^DIC(19,7882,0)="XQAB ERROR LOG SERVER^Handle Alpha/Beta Errors Logged at Sites^^S^1039^^^^^^^"
^DIC(19,7882,1,0)="^^12^12^2930726^"
^DIC(19,7882,1,1,0)=" "
^DIC(19,7882,1,2,0)="This SERVER option is used to store data sent by the 'XQAB ERROR LOG XMIT'"
^DIC(19,7882,1,3,0)="option back to the developing site (usually an ISC).  As a server to which"
^DIC(19,7882,1,4,0)="the mail messages containing data on the types and frequencies of errors"
^DIC(19,7882,1,5,0)="associated with an application package in alpha or beta test, this option"
^DIC(19,7882,1,6,0)="starts a routine which processes the message contents and stores the data"
^DIC(19,7882,1,7,0)="in file 8991.5 (^XTV(8991.5,...).  The contents of the file may be"
^DIC(19,7882,1,8,0)="processed using several options or by the use of File Manager directly."
^DIC(19,7882,1,9,0)="The file contains data on the type of error, the routine involved, the"
^DIC(19,7882,1,10,0)="option which was in use at the time of the error, the date, and the number"
^DIC(19,7882,1,11,0)="of errors for that date, by site (and if multiple error traps are used at"
^DIC(19,7882,1,12,0)="a site, by the vol,uci)."
^DIC(19,7882,25)="XQABELOG"
^DIC(19,7882,220)="^R^^^Y^N"
^DIC(19,7882,"U")="HANDLE ALPHA/BETA ERRORS LOGGE"
^DIC(19,7883,0)="XQAB ERR DATE/SITE/NUM/ROU/ERR^Print Alpha/Beta Errors (Date/Site/Num/Rou/Err)^^P^1039^^^^^^^"
^DIC(19,7883,1,0)="^^11^11^2930727^"
^DIC(19,7883,1,1,0)=" "
^DIC(19,7883,1,2,0)="This option is used to print a listing of alpha/beta test errors reported"
^DIC(19,7883,1,3,0)="from the test sites.  The print is for a range of dates and lists the"
^DIC(19,7883,1,4,0)="sites, the number of the errors reported by a site, the routine involved,"
^DIC(19,7883,1,5,0)="and the error text.  The range of dates, sites, and routine names are user"
^DIC(19,7883,1,6,0)="selectable.  The output format is similar to:"
^DIC(19,7883,1,7,0)=" "
^DIC(19,7883,1,8,0)="              Date of Errors"
^DIC(19,7883,1,9,0)="site.name       number.of.errors    routine     error.text"
^DIC(19,7883,1,10,0)=" "
^DIC(19,7883,1,11,0)="and the subtotals and totals are given for number of errors."
^DIC(19,7883,60)="XTV(8991.5,"
^DIC(19,7883,62)=0
^DIC(19,7883,63)="[XQAB SITE/NUMBER/ROU/OPT/ERR]"
^DIC(19,7883,64)="[XQAB +DAT/ROU/SITE]"
^DIC(19,7883,65)="?,?,?"
^DIC(19,7883,66)="?,?,?"
^DIC(19,7883,"U")="PRINT ALPHA/BETA ERRORS (DATE/"
^DIC(19,7884,0)="XTQUEUABLE OPTIONS^Toolkit Queuable Options^^M^.5^^^^^^^"
^DIC(19,7884,1,0)="^^3^3^2930816^"
^DIC(19,7884,1,1,0)="This menu, which has no parent, collects together all of the parentless"
^DIC(19,7884,1,2,0)="Toolkit options that are intended to be scheduled through the Taskman"
^DIC(19,7884,1,3,0)="option ZTMSCHEDULE."
^DIC(19,7884,10,0)="^19.01PI^0^0"
^DIC(19,7884,99)="56288,60355"
^DIC(19,7884,"U")="TOOLKIT QUEUABLE OPTIONS"
^DIC(19,7886,0)="XTCM MAIN^Capacity Planning^^M^10000000216^^^^^^^349"
^DIC(19,7886,1,0)="^19.06^2^2^3100331^^^^"
^DIC(19,7886,1,1,0)="This menu holds all the currently available capacity management"
^DIC(19,7886,1,2,0)="functions."
^DIC(19,7886,10,0)="^19.01IP^14^14"
^DIC(19,7886,10,12,0)="12595^TLS"
^DIC(19,7886,10,13,0)="11606^CPG"
