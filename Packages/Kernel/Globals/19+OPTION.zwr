^DIC(19,16440,0)="EHM-01261^PCE Coordinator Menu^^M^1^^^^^^^507^^^^"
^DIC(19,16440,1,0)="^^11^11^3240328^^^^"
^DIC(19,16440,1,1,0)="This is the menu for the person that is the ADPAC for PCE.  It includes"
^DIC(19,16440,1,2,0)="all of the user interface options as well as the options for file"
^DIC(19,16440,1,3,0)="maintenance."
^DIC(19,16440,1,4,0)=" "
^DIC(19,16440,1,5,0)="The data entry options may be assigned to clerk and/or clinican menus as"
^DIC(19,16440,1,6,0)="needed."
^DIC(19,16440,1,7,0)=" "
^DIC(19,16440,1,8,0)="The HS and Report parameter edit and print options are for the coordinator"
^DIC(19,16440,1,9,0)="to manage fields for site specific preferences/definitions in the Health"
^DIC(19,16440,1,10,0)="Summary and PCE Reports."
^DIC(19,16440,1,11,0)="Cloned from ""PX PCE COORDINATOR MENU"" option."
