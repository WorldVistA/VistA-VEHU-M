^DIC(19,11547,0)="RG IRM MENU^MPI/PD IRM Menu^^M^10000000033^^^^^^^525"
^DIC(19,11547,1,0)="^19.06^3^3^3020813^^^^"
^DIC(19,11547,1,1,0)="This option provides the Information Resource Management (IRM) "
