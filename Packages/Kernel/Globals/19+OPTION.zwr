^DIC(19,5455,"U")="INPATIENT PROFILE"
^DIC(19,5456,0)="PSJ OE^Inpatient Order Entry^^R^1^^^^^^^197^^^1"
^DIC(19,5456,1,0)="^^2^2^2890903^^"
^DIC(19,5456,1,1,0)="  Allows the entry of IV and Unit Dose orders.  Will also give the user the"
^DIC(19,5456,1,2,0)="opportunity to view and possibly edit previously entered orders."
