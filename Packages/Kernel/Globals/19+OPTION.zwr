^DIC(19,10887,0)="LA7S EDIT 62.93^Edit Shipping Condition^^R^11712^^^^^^^480"
^DIC(19,10887,1,0)="^^4^4^2970717^^^"
^DIC(19,10887,1,1,0)="This option sets up the LAB SHIPPING CONDITIONS file (#62.93)."
