^DIC(19,8039,1,0)="^^2^2^2940207^^"
^DIC(19,8039,1,1,0)="This option will print a list of patients who were insured on their"
^DIC(19,8039,1,2,0)="admission date but were not scheduled admissions."
^DIC(19,8039,25)="IBTOUA"
^DIC(19,8039,"U")="UNSCHEDULED ADMISSIONS W/INSUR"
^DIC(19,8040,0)="IBT OUTPUT MCCR/UR SUMMARY^MCCR/UR Summary Report^^R^.5^^^^^^^192"
^DIC(19,8040,1,0)="^^6^6^2940214^^^"
^DIC(19,8040,1,1,0)="This report can be run for either admissions or discharges for a"
^DIC(19,8040,1,2,0)="date range.  It will summarize totals by admission or discharge, cases"
^DIC(19,8040,1,3,0)="with insurance, billable inpatient cases, cases requiring reviews,"
^DIC(19,8040,1,4,0)="days approved, amount collectible approved for billing, number of days"
^DIC(19,8040,1,5,0)="denied, amount denied, and penalty dollars."
^DIC(19,8040,1,6,0)=" "
^DIC(19,8040,10,0)="^19.01PI^0^0"
^DIC(19,8040,25)="IBTOSUM"
^DIC(19,8040,"U")="MCCR/UR SUMMARY REPORT"
