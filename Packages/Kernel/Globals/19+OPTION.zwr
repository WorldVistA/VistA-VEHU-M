^DIC(19,10515,25)="DEFED^YSASFM"
^DIC(19,10515,"U")="DEFAULT EDITOR"
^DIC(19,10524,0)="PRCH CARD HOLDER DAILY CHARGES^Card Holder Daily Charge Statement^^R^11740^^^^^^^121"
