^DIC(19,9638,0)="ENFA SEND SINGLE^Send a Single FA Document^^A^.5^ENFACS^^^^^^33^^1"
^DIC(19,9638,1,0)="^^5^5^2960318^"
^DIC(19,9638,1,1,0)="This option will send a FA Document (code sheet) to the Fixed Assets"
^DIC(19,9638,1,2,0)="package (FAP) in Austin for a selected equipment entry. Appropriate data"
^DIC(19,9638,1,3,0)="is extracted from the Equipment file and used to populate the code sheet."
^DIC(19,9638,1,4,0)="FA Documents will not be created for equipment entries already established"
^DIC(19,9638,1,5,0)="in FAP."
