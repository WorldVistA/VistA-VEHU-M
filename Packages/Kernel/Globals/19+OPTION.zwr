^DIC(19,5925,"U")="NATIONAL DRUG FILE REPORTS MEN"
^DIC(19,5926,0)="PSNOCLS^Local Drugs With No VA Drug Class Report^^R^10000000020^^^^^^^"
^DIC(19,5926,1,0)="^^4^4^2980922^^^^"
^DIC(19,5926,1,1,0)="This option produces a report showing all drugs from your local drug"
^DIC(19,5926,1,2,0)="file which have no VA Drug Classification. This report should only be"
^DIC(19,5926,1,3,0)="run after using the ""Merge National Drug File Data Into Local File"" and"
^DIC(19,5926,1,4,0)="""Allow Unmatched Drugs To Be Classed"" options."
^DIC(19,5926,25)="PSNOCLS"
^DIC(19,5926,"U")="LOCAL DRUGS WITH NO VA DRUG CL"
^DIC(19,5927,0)="PSNVIEW^Inquire To Local Drug File^^R^11740^^^^^^^"
^DIC(19,5927,1,0)="5^^5^5^2980922^^"
^DIC(19,5927,1,1,0)="This option allows you to look-up into your local drug file by Generic"
^DIC(19,5927,1,2,0)="Name or VA Drug Class Code. If you choose VA Drug Class Code, it will"
^DIC(19,5927,1,3,0)="sort by the least expensive Price Per Dispense Unit. It will display"
^DIC(19,5927,1,4,0)="the Generic Name, VA Drug Class Code, Price Per Dispense Unit, the"
^DIC(19,5927,1,5,0)="Message field, and Synonyms not marked as quick codes."
^DIC(19,5927,25)="PSNVIEW"
^DIC(19,5927,"U")="INQUIRE TO LOCAL DRUG FILE"
^DIC(19,5928,0)="PSNSUPLY^Supply (XA000) VA Class Report^^R^10000000020^^^^^^^"
^DIC(19,5928,1,0)="^^7^7^2980922^^^"
^DIC(19,5928,1,1,0)="This report should be run if you have already classed your"
^DIC(19,5928,1,2,0)="local items using Version 1.0 of NDF. After the installation"
^DIC(19,5928,1,3,0)="of Version 2.0 of NDF and the VA DRUG CLASS file is re-installed,"
^DIC(19,5928,1,4,0)="you may wish to re-class your local items with a ""XA"" classification"
^DIC(19,5928,1,5,0)="using the newly expanded ""XA000"" classification. It gives you a hard"
^DIC(19,5928,1,6,0)="copy of the items from your local drug file which are ""active"" and"
^DIC(19,5928,1,7,0)="have an ""XA"" VA Drug Classification."
^DIC(19,5928,25)="PSNSUPLY"
^DIC(19,5928,"U")="SUPPLY (XA000) VA CLASS REPORT"
^DIC(19,5929,0)="PSNFRMLY^Local Formulary Report^^R^10000000020^PSNMGR^^^^^^"
^DIC(19,5929,1,0)="^^4^4^2980922^^^^"
^DIC(19,5929,1,1,0)="This option produces a report of drugs marked as formulary in your local"
^DIC(19,5929,1,2,0)="drug file. It will ask you if you want to include supply items."
^DIC(19,5929,1,3,0)="You are asked to either sort by Generic/Tradename or to pick a"
^DIC(19,5929,1,4,0)="range of VA Drug Class codes. Only active drugs will print."
^DIC(19,5929,25)="PSNFRMLY"
^DIC(19,5929,99)="55070,56065"
^DIC(19,5929,"U")="LOCAL FORMULARY REPORT"
^DIC(19,5931,0)="PSNMCLS^Manually Classed Drugs Report^^R^10000000020^^^^^^^"
^DIC(19,5931,1,0)="^^5^5^2980922^^^"
^DIC(19,5931,1,1,0)="This report will give you an alphabetic listing, by local generic name,"
^DIC(19,5931,1,2,0)="of the drugs from your local drug file which are ""active"" and have been"
^DIC(19,5931,1,3,0)="assigned a VA Drug Classification through the option ""Allow Unmatched"
^DIC(19,5931,1,4,0)="Drugs To Be Classed"". This report will exclude your supply items that"
^DIC(19,5931,1,5,0)="have been assigned an ""XA"" class."
^DIC(19,5931,25)="PSNMCLS"
^DIC(19,5931,"U")="MANUALLY CLASSED DRUGS REPORT"
^DIC(19,5933,0)="PSNAUTO^Automatic Match of Unmatched Drugs^^R^11595^^^^^^^"
^DIC(19,5933,1,0)="^^4^4^2980922^^^^"
^DIC(19,5933,1,1,0)="New data has been released with this version. This option allows you to"
^DIC(19,5933,1,2,0)="match, by NDC, items in your local file to these newly released items."
^DIC(19,5933,1,3,0)="It will attempt to match by NDC, anything that is not previously matched to"
^DIC(19,5933,1,4,0)="the National Drug File."
^DIC(19,5933,25)="PSNAUTO"
^DIC(19,5933,99)="55595,54825"
^DIC(19,5933,"U")="AUTOMATIC MATCH OF UNMATCHED D"
^DIC(19,5934,0)="PSNVAGN^Report of VA Generic Names From National Drug^^R^10000000020^^^^^^^"
^DIC(19,5934,1,0)="^^6^6^2980922^^^^"
^DIC(19,5934,1,1,0)="This option provides a report of VA Generic Names from the National Drug"
^DIC(19,5934,1,2,0)="File. You may print all or you may specify a range. This report may be"
^DIC(19,5934,1,3,0)="useful when using the option ""Rematch / Match Single Drugs"". If"
^DIC(19,5934,1,4,0)="you cannot find a match, you are asked to type in a VA Generic Name to "
^DIC(19,5934,1,5,0)="attempt to match to. You may type in one of the entries contained in this"
^DIC(19,5934,1,6,0)="report to assist you in matching. This report requires 80 columns."
^DIC(19,5934,25)="PSNVAGN"
^DIC(19,5934,"U")="REPORT OF VA GENERIC NAMES FRO"
^DIC(19,5935,0)="PSNVER^Verify Single Match^^R^11595^^^^^^^"
^DIC(19,5935,1,0)="^^4^4^2980922^^^^"
^DIC(19,5935,1,1,0)="Use this option to verify single matches. User is prompted for the drug"
^DIC(19,5935,1,2,0)="name from the local drug file to verify match to the National Drug file."
^DIC(19,5935,1,3,0)="The matches are stored in the National Drug Translation file. It is a"
^DIC(19,5935,1,4,0)="requirement that all matches be verified before being merged."
^DIC(19,5935,25)="PSNVER"
^DIC(19,5935,"U")="VERIFY SINGLE MATCH"
^DIC(19,5936,0)="QIE REPORT^Generate EPRP list of patients to review^^R^.5^^^^^^^"
^DIC(19,5936,1,0)="^^2^2^2920318^"
^DIC(19,5936,1,1,0)="This option generates lists of patients for EPRP review for a month"
^DIC(19,5936,1,2,0)="and year selected by the user."
^DIC(19,5936,25)="EN^DGYEPRP"
^DIC(19,5936,99)="55465,57110"
^DIC(19,5936,"U")="GENERATE EPRP LIST OF PATIENTS"
^DIC(19,5937,0)="QIE AUTO REPORT^Background job to generate EPRP list of patients^^R^.5^^^^^^^"
^DIC(19,5937,1,0)="^^3^3^2920401^^"
^DIC(19,5937,1,1,0)="This option is designed to be queued as a monthly job to generate"
^DIC(19,5937,1,2,0)="the EPRP list of patients for the month three months before the current"
^DIC(19,5937,1,3,0)="month"
^DIC(19,5937,25)="AUTO^DGYEPRP"
^DIC(19,5937,99)="55465,56975"
^DIC(19,5937,200.9)="y"
^DIC(19,5937,"U")="BACKGROUND JOB TO GENERATE EPR"
^DIC(19,5970,0)="SRO QUARTERLY REPORT^Quarterly Report - Surgical Service^Not used after patch SR*3*175^R^10000000216^^^^^^^167^^1^1"
^DIC(19,5970,1,0)="^^4^4^2970128^^"
^DIC(19,5970,1,1,0)="This option will generate the quarterly report to be submitted to the"
^DIC(19,5970,1,2,0)="Surgical Service, Central Office.  The option also provides the "
^DIC(19,5970,1,3,0)="flexibility to print the summary report for selected date ranges."
^DIC(19,5970,1,4,0)=" "
^DIC(19,5970,15)="D EXIT^SROVAR"
^DIC(19,5970,20)="D ^SROVAR"
^DIC(19,5970,22)="Q"
^DIC(19,5970,25)="SROQ"
^DIC(19,5970,99)="55585,31134"
^DIC(19,5970,"U")="QUARTERLY REPORT - SURGICAL SE"
^DIC(19,5971,0)="SROSTAFF^Update Staff Surgeon Information^^R^.5^^^^^^^167^^1^1"
^DIC(19,5971,1,0)="^^6^6^2921104^^^^"
^DIC(19,5971,1,1,0)="This option allows the designation of a user as a staff surgeon by"
^DIC(19,5971,1,2,0)="assigning the security key 'SR STAFF SURGEON'.  The Annual Report"
^DIC(19,5971,1,3,0)="of Surgical Procedures counts cases performed by holders of this"
^DIC(19,5971,1,4,0)="security key as performed by 'STAFF'.  All other cases are counted"
^DIC(19,5971,1,5,0)="as performed by 'RESIDENT'."
^DIC(19,5971,1,6,0)="   "
^DIC(19,5971,15)="D EXIT^SROVAR"
^DIC(19,5971,20)="D ^SROVAR"
^DIC(19,5971,22)="Q"
^DIC(19,5971,25)="SROSTAFF"
^DIC(19,5971,"U")="UPDATE STAFF SURGEON INFORMATI"
^DIC(19,5975,0)="PRCH DRUG TYPE CODE EDIT^Drug type code edit^^R^11740^^^^^^^"
^DIC(19,5975,1,0)="^^2^2^2920531^^^"
^DIC(19,5975,1,1,0)="This option allows the users to enter/edit the 'DRUG TYPE CODE' field for"
^DIC(19,5975,1,2,0)="items in the Item Master file."
^DIC(19,5975,25)="PRCHDRG"
