^DIC(19,15860,0)="EHM-00681^GUI Health Summary Types^^A^1^^^^^^^^^1^^"
^DIC(19,15860,1,0)="^^5^5^3240328^^^"
^DIC(19,15860,1,1,0)="This option allows you to set up a list of health summary types to be"
^DIC(19,15860,1,2,0)="displayed on the GUI Reports tab. Don't add health summaries that require"
^DIC(19,15860,1,3,0)="additional prompting (e.g., for date ranges & occurrence limits) "
^DIC(19,15860,1,4,0)="since the GUI cannot support this type of prompting."
^DIC(19,15860,1,5,0)="Cloned from ""ORW HEALTH SUMMARY TYPES"" option."
