^DIC(19,109,1,0)="^^1^1^2910520^^"
^DIC(19,109,1,1,0)="Uses the utility %ZTP1 to print the first line of routines."
^DIC(19,109,25)="%ZTP1"
^DIC(19,109,99)="55424,59906"
^DIC(19,109,"U")="FIRST LINE ROUTINE PRINT"
^DIC(19,110,0)="XUROUTINE OUT^Output routines^^A^10000000020^^^^^^^^n^1^^"
^DIC(19,110,1,0)="^^3^3^3020808^^^^"
^DIC(19,110,1,1,0)="This routine will output routines to an external device such as a host file."
^DIC(19,110,1,2,0)=""
^DIC(19,110,1,3,0)=""
^DIC(19,110,20)="N % S %=$G(^%ZOSF(""OS"")) D @$S(%[""GT.M"":""^ZRO"",%[""OpenM"":""^%RO"",%[""DTM"":""^%rsave"",1:""^%RS"")"
^DIC(19,110,25)=""
^DIC(19,110,"U")="OUTPUT ROUTINES"
