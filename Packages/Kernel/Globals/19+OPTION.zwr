^DIC(19,8492,0)="GMPL PATIENT LISTING^List Patients with Problem List data^^R^.5^^^^^^^402"
^DIC(19,8492,1,0)="^^2^2^2930824^^"
^DIC(19,8492,1,1,0)="This option will generate a listing of all patients having data"
^DIC(19,8492,1,2,0)="in the Problem file #9000011."
^DIC(19,8492,25)="PAT^GMPLRPTS"
^DIC(19,8492,"U")="LIST PATIENTS WITH PROBLEM LIS"
^DIC(19,8493,0)="GMPL PROBLEM LISTING^Search for Patients having selected Problem^^R^.5^^^^^^^402"
^DIC(19,8493,1,0)="^^4^4^2930824^"
^DIC(19,8493,1,1,0)="This option will generate a listing of all patients identified as"
^DIC(19,8493,1,2,0)="having a particular problem in the Problem file #9000011; the user"
^DIC(19,8493,1,3,0)="is first prompted for the problem, then the file is searched for"
^DIC(19,8493,1,4,0)="patients having this problem."
^DIC(19,8493,25)="PROB^GMPLRPTS"
^DIC(19,8493,"U")="SEARCH FOR PATIENTS HAVING SEL"
^DIC(19,8494,0)="GMPL BUILD SELECTION LIST^Build Problem Selection List(s)^^R^.5^^^^^^^402"
^DIC(19,8494,1,0)="^^5^5^2940202^^^^"
^DIC(19,8494,1,1,0)="This option allows access to utilities to facilitate the creation"
^DIC(19,8494,1,2,0)="and maintenance of problem menus, i.e. lists of commonly selected"
^DIC(19,8494,1,3,0)="problems.  Categories of problems may be defined, and lists created"
^DIC(19,8494,1,4,0)="from linking categories together; categories may be reused in multiple"
^DIC(19,8494,1,5,0)="lists."
^DIC(19,8494,25)="EN^GMPLBLD"
^DIC(19,8494,"U")="BUILD PROBLEM SELECTION LIST(S"
^DIC(19,8495,0)="GMPL USER LIST^Preferred Problem Selection List^^A^.5^^^^^^^402^^1"
^DIC(19,8495,1,0)="^^6^6^2931001^"
^DIC(19,8495,1,1,0)="This option allows an individual user to define his/her own default"
^DIC(19,8495,1,2,0)="list of commonly selected problems; this list will be displayed when"
^DIC(19,8495,1,3,0)="the action 'Add New Problem(s)' is invoked, and the user may either"
^DIC(19,8495,1,4,0)="choose to add a problem from the menu (selected by display number)"
^DIC(19,8495,1,5,0)="or search the Clinical Lexicon for a problem not listed.  The same"
^DIC(19,8495,1,6,0)="prompts will asked per problem to complete the entry."
^DIC(19,8495,20)="S DIE=""^VA(200,"",DR=125.1,DA=DUZ D ^DIE"
^DIC(19,8495,"U")="PREFERRED PROBLEM SELECTION LI"
^DIC(19,8496,0)="GMPL BUILD LIST MENU^Create Problem Selection Lists^^M^.5^^^^^^^402"
^DIC(19,8496,1,0)="^^5^5^2931007^^"
^DIC(19,8496,1,1,0)="This menu contains options that facilitate building and maintaining"
^DIC(19,8496,1,2,0)="lists of commonly selected problems.  Problem groups are defined, and"
^DIC(19,8496,1,3,0)="these groups are then linked together to form a list; a group may be"
^DIC(19,8496,1,4,0)="reused, as a member of multiple lists, and it may be assigned a sequence"
^DIC(19,8496,1,5,0)="number and header for ordering and clarity within the list."
^DIC(19,8496,10,0)="^19.01PI^8^7"
^DIC(19,8496,10,1,0)="8494^1^1"
^DIC(19,8496,10,3,0)="8497^3^3"
^DIC(19,8496,10,4,0)="8498^2^2"
^DIC(19,8496,10,5,0)="8500^4^4"
^DIC(19,8496,10,7,0)="12401^5^5"
^DIC(19,8496,10,8,0)="14618^6^6"
