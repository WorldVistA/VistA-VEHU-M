^DIC(19,14196,0)="PRCHJ RETRANS 2237^Retransmit a 2237 to eCMS^^R^1^^^^^^^121^^1"
^DIC(19,14196,1,0)="^^9^9^3130627^"
^DIC(19,14196,1,1,0)="This option allows an IFCAP user having the Manager or Accountable Officer"
^DIC(19,14196,1,2,0)="role to retransmit a 2237 transaction to the Electronic Contract"
^DIC(19,14196,1,3,0)="Management System (eCMS) via the IFCAP/eCMS HL7 interface."
^DIC(19,14196,1,4,0)=" "
^DIC(19,14196,1,5,0)="A 2237 transaction will be selectable for retransmission to eCMS when:"
^DIC(19,14196,1,6,0)=" "
^DIC(19,14196,1,7,0)="[The Current Status (#1.5) field of the record in the REQUEST WORKSHEET "
^DIC(19,14196,1,8,0)="(#443) is 'Sent to eCMS (P&C)'] AND [The ECMS ACTIONUID (#103) field of"
^DIC(19,14196,1,9,0)="the record in the CONTROL POINT ACTIVITY (#410) file is not populated.]"
^DIC(19,14196,20)="S:'$$ENTACT^PRCHJS07(DUZ) XQUIT=1"
^DIC(19,14196,25)="RETRANS^PRCHJS07"
^DIC(19,14196,99)="62609,52495"
^DIC(19,14196,99.1)="62619,34881"
^DIC(19,14196,"U")="RETRANSMIT A 2237 TO ECMS"
^DIC(19,14197,0)="PRCHJ TRANS REPORT^Transaction Report - eCMS/IFCAP^^R^1^^^^^^^121"
^DIC(19,14197,1,0)="3^19.06^6^6^3130716^^"
^DIC(19,14197,1,1,0)="This report displays information about HL7 transactions that take place "
^DIC(19,14197,1,2,0)="between eCMS and IFCAP. Only users defined as PPM ACCOUNTABLE OFFICERS"
^DIC(19,14197,1,3,0)="or MANAGER can use this option."
^DIC(19,14197,1,4,0)="This option is accessed from the Accountable Officer Menu."
^DIC(19,14197,1,5,0)="The report is generated from data stored in the IFCAP/ECMS TRANSACTION"
^DIC(19,14197,1,6,0)="file [414.06]."
^DIC(19,14197,25)="EN^PRCHJRP5"
^DIC(19,14197,"U")="TRANSACTION REPORT - ECMS/IFCA"
^DIC(19,14198,0)="PRCHJ TRANS REPORT2^Transaction Report - eCMS/IFCAP^^R^1^^^^^^^^^"
^DIC(19,14198,1,0)="^19.06^5^5^3130716^^^^"
^DIC(19,14198,1,1,0)="This option prints a report of the HL7 messages between eCMS and IFCAP. "
^DIC(19,14198,1,2,0)="This option is accessible from the Control Point Official and Control "
^DIC(19,14198,1,3,0)="Point Clerk Menus, by means of Process a Request."
^DIC(19,14198,1,4,0)="The report is generated from data stored in the IFCAP/ECMS TRANSACTION"
^DIC(19,14198,1,5,0)="file [414.06]."
^DIC(19,14198,20)=""
^DIC(19,14198,25)="EN^PRCHJRP5"
^DIC(19,14198,"U")="TRANSACTION REPORT - ECMS/IFCA"
