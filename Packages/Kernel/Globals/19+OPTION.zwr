^DIC(19,16735,0)="EHM-01556^Immunization List^^P^1^^^^^^y^^^1^^"
^DIC(19,16735,1,0)="^^6^6^3240328^^"
^DIC(19,16735,1,1,0)="This option lists all immunizations, with their Active Status, which have"
^DIC(19,16735,1,2,0)="been defined in the Immunization file for use with PCE."
^DIC(19,16735,1,3,0)=" "
^DIC(19,16735,1,4,0)="Note:  To see what CPT codes may be related to the immunization entries,"
^DIC(19,16735,1,5,0)="print the PCE Code Mapping List."
^DIC(19,16735,1,6,0)="Cloned from ""PXTT LIST IMMUNIZATIONS"" option."
