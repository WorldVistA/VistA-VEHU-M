^DIC(19,3132,1,0)="^^3^3^2870901.2134^"
^DIC(19,3132,1,1,0)="This option allows a supervisor to change the deferral date on a"
^DIC(19,3132,1,2,0)="transaction when it is entered in error, or is administratively"
^DIC(19,3132,1,3,0)="determined appropriate to change."
^DIC(19,3132,25)="DEF^PRPFED"
^DIC(19,3132,99.1)="59176,52320"
