^DIC(19,1045,1,0)="^^3^3^2880716^^"
^DIC(19,1045,1,1,0)="This option will print the various consult types contained in"
^DIC(19,1045,1,2,0)="the Dietetic Consults file (119.5) along with associated"
^DIC(19,1045,1,3,0)="data elements."
^DIC(19,1045,25)="EN12^FHORC5"
^DIC(19,1045,"U")="LIST CONSULT TYPES"
^DIC(19,1046,0)="FHORC9^Re-Assign Active Consults^^R^10000000020^^^^^^^"
^DIC(19,1046,1,0)="^^4^4^2880717^"
^DIC(19,1046,1,1,0)="This option will allow re-assignments of all active consults"
^DIC(19,1046,1,2,0)="from one clinician to another. It is primarily used when a"
^DIC(19,1046,1,3,0)="clinician is reassigned to other duties, leaves, or will be"
^DIC(19,1046,1,4,0)="on leave for an extended period."
^DIC(19,1046,25)="FHORC4"
^DIC(19,1046,"U")="RE-ASSIGN ACTIVE CONSULTS"
^DIC(19,1047,0)="FHORC10^Consult Statistics^^R^10000000020^^^^^^^"
^DIC(19,1047,1,0)="^^3^3^2880716^^"
^DIC(19,1047,1,1,0)="This option will, for any specified period of time, produce"
^DIC(19,1047,1,2,0)="an optional listing of all completed consults as well as"
^DIC(19,1047,1,3,0)="'time units' by consult type and totals."
^DIC(19,1047,25)="FHORC3"
^DIC(19,1047,"U")="CONSULT STATISTICS"
^DIC(19,1048,0)="FHORC2^Review Active Consults^^R^10000000020^^^^^^^"
^DIC(19,1048,1,0)="^^3^3^2880716^^"
^DIC(19,1048,1,1,0)="This option allows a clinician or supervisor to review all"
^DIC(19,1048,1,2,0)="active (e.g., not completed or cancelled) consults for"
^DIC(19,1048,1,3,0)="themselves or for all clinicians."
^DIC(19,1048,25)="FHORC1"
^DIC(19,1048,"U")="REVIEW ACTIVE CONSULTS"
