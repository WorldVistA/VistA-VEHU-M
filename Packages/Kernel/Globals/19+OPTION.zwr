^DIC(19,5924,1,8,0)="and meet the selected parameters, to a Compensation & Pension appointment"
^DIC(19,5924,1,9,0)="type."
^DIC(19,5924,1,10,0)="  "
^DIC(19,5924,1,11,0)="This option is only needed if other packages (such as Radiology v 4.0)"
^DIC(19,5924,1,12,0)="capture stop code workload.  Refer to the User manual, Volume II,"
^DIC(19,5924,1,13,0)="Appendix, for further documentation."
^DIC(19,5924,25)="SDACSCGB"
^DIC(19,5924,"U")="BATCH UPDATE COMP GEN APPT TYP"
