^DIC(19,7286,1,0)="^^4^4^2900529^"
^DIC(19,7286,1,1,0)="This report displays the total number of each CPT code entered for the"
^DIC(19,7286,1,2,0)="date range selected.  It also breaks down the totals into two categories,"
^DIC(19,7286,1,3,0)="principal procedures and other operative procedures."
