^DIC(19,5153,0)="DIFG CREATE^Create/Edit Filegram Template^^A^1^XUFILEGRAM^^^^^^^^1^^"
^DIC(19,5153,1,0)="^^4^4^2900124^"
^DIC(19,5153,1,1,0)="Use this option to create a filegram template or edit an existing"
^DIC(19,5153,1,2,0)="filegram template.  This option is the first step in developing a"
^DIC(19,5153,1,3,0)="filegram and is very important since there won't be filegrams without"
^DIC(19,5153,1,4,0)="this template."
^DIC(19,5153,20)="S DI=1 D EN^DIFGO"
^DIC(19,5153,"U")="CREATE/EDIT FILEGRAM TEMPLATE"
^DIC(19,5154,0)="DIFG DISPLAY^Display Filegram Template^^A^1^XUFILEGRAM^^^^^^^^1^^"
^DIC(19,5154,1,0)="^^2^2^2900124^"
^DIC(19,5154,1,1,0)="Use this option to display the filegram template in a two-column"
^DIC(19,5154,1,2,0)="format (similar to FileMan's Inquire to File Entries option)."
^DIC(19,5154,20)="S DI=2 D EN^DIFGO"
^DIC(19,5154,"U")="DISPLAY FILEGRAM TEMPLATE"
^DIC(19,5155,0)="DIFG GENERATE^Generate Filegram^^A^1^XUFILEGRAM^^^^^^^^1^^"
^DIC(19,5155,1,0)="^^3^3^2900124^"
^DIC(19,5155,1,1,0)="Use this option to generate a filegram into a MailMan message after"
^DIC(19,5155,1,2,0)="selecting the file, filegram template and an entry.  It's a good idea"
^DIC(19,5155,1,3,0)="to know that information before using this option."
^DIC(19,5155,20)="S DI=3 D EN^DIFGO"
^DIC(19,5155,"U")="GENERATE FILEGRAM"
^DIC(19,5156,0)="DIFG VIEW^View Filegram^^A^1^^^^^^^^^1^^"
^DIC(19,5156,1,0)="^^1^1^2900124^"
^DIC(19,5156,1,1,0)="Use this option to view the filegram in filegram format."
^DIC(19,5156,20)="S DI=4 D EN^DIFGO"
^DIC(19,5156,"U")="VIEW FILEGRAM"
^DIC(19,5157,0)="DIFG SPECIFIERS^Specifiers^^A^1^XUFILEGRAM^^^^^^^^1^^"
^DIC(19,5157,1,0)="^^6^6^2900124^"
^DIC(19,5157,1,1,0)="Use this option to identify a particular field in the file as a"
^DIC(19,5157,1,2,0)="reference point for FileMan to use when installing the filegram."
^DIC(19,5157,1,3,0)=" "
^DIC(19,5157,1,4,0)="Specifiers can be compared to FileMan's identifier, unlike identifiers"
^DIC(19,5157,1,5,0)="which are used for interaction purposes...specifiers are used for"
^DIC(19,5157,1,6,0)="transaction purposes."
