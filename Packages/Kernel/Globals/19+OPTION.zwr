^DIC(19,11534,0)="PXRM MENTAL HEALTH ACTIVE^Mental Health Dialogs Active^^A^10000000020^^^^^^^^^1"
^DIC(19,11534,1,0)="^19.06^4^4^3040416^^^"
^DIC(19,11534,1,1,0)="This option allows a user to modify the ""Mental Health Active"" CPRS"
^DIC(19,11534,1,2,0)="parameter.  You can activate mental health dialogs for reminder resolution"
^DIC(19,11534,1,3,0)="processing at a user, service, division, or system level. When activated"
^DIC(19,11534,1,4,0)="for a level, mental health tests in a reminder dialog can be performed."
^DIC(19,11534,20)="D EDITPAR^XPAREDIT(""PXRM MENTAL HEALTH ACTIVE"")"
^DIC(19,11534,"U")="MENTAL HEALTH DIALOGS ACTIVE"
^DIC(19,11535,0)="PXRM GUI REMINDERS ACTIVE^Reminder GUI Resolution Active^^A^10000000020^^^^^^^^^1"
^DIC(19,11535,1,0)="^^6^6^3010116^"
^DIC(19,11535,1,1,0)="This option allows a user to modify the ""Reminders Active"" CPRS"
^DIC(19,11535,1,2,0)="parameter. You can activate GUI reminder resolution processing at a user,"
^DIC(19,11535,1,3,0)="service, division, or system level. When activated for a level, a"
^DIC(19,11535,1,4,0)="reminders drawer is available on the notes tab for selecting reminders."
^DIC(19,11535,1,5,0)="When a reminder is selected, a dialog box opens with the reminders' dialog"
^DIC(19,11535,1,6,0)="for point and click resolution processing."
^DIC(19,11535,20)="D EDITPAR^XPAREDIT(""PXRM GUI REMINDERS ACTIVE"")"
^DIC(19,11535,"U")="REMINDER GUI RESOLUTION ACTIVE"
