^DIC(19,1132,99)="60081,36527"
^DIC(19,1132,99.1)="54430,18313"
^DIC(19,1132,"U")="MICROBIOLOGY PRINT MENU"
^DIC(19,1133,0)="LRMIPSZ^Patient report^^R^.5^^^^^^^26"
^DIC(19,1133,1,0)="^^5^5^2870206^^^^"
^DIC(19,1133,1,1,0)="Provides a comprehensive report of microbiology data by selecting"
^DIC(19,1133,1,2,0)="either patient or accession.  If results are looked up by patient, the"
^DIC(19,1133,1,3,0)="report will show all microbiology tests ordered on the specified patient,"
^DIC(19,1133,1,4,0)="verified result of those tests, and the status of each test."
^DIC(19,1133,1,5,0)="The results may also be looked up by the accession number."
^DIC(19,1133,25)="LRMIPSZ"
^DIC(19,1133,"U")="PATIENT REPORT"
^DIC(19,1134,0)="LRMIPC^Cumulative patient report^^R^.5^^^^^^^26"
^DIC(19,1134,1,0)="^^3^3^2870209^^^^"
^DIC(19,1134,1,1,0)="Provides a comprehensive report of all microbiology tests, results,"
^DIC(19,1134,1,2,0)="and status of tests for a specified patient for a specified date range."
^DIC(19,1134,1,3,0)="This option is only for a single patient."
^DIC(19,1134,25)="LRMIPC"
^DIC(19,1134,"U")="CUMULATIVE PATIENT REPORT"
^DIC(19,1135,0)="LRMISEZ^Infection control survey report^^R^.5^^^^^^^26"
^DIC(19,1135,1,0)="^^17^17^2870209^^^^"
^DIC(19,1135,1,1,0)="The Infection Control report is used by the Laboratory and "
^DIC(19,1135,1,2,0)="Infection Control unit to look for increases in the number of"
^DIC(19,1135,1,3,0)="a particular organism or the emergence and spread of a resistant"
^DIC(19,1135,1,4,0)="organism.  The report contains patient information, specimen or collection"
^DIC(19,1135,1,5,0)="sample, and all isolates regardless of whether or not they have a"
^DIC(19,1135,1,6,0)="sensitivity.  For a particular accession area and within a specified time"
^DIC(19,1135,1,7,0)="range, 4 separate reports can be obtained.  Information can be grouped by:"
^DIC(19,1135,1,8,0)="1) location, 2) organism, 3) physician, and 4) patient.  A hospital can"
^DIC(19,1135,1,9,0)="pre-select the reports, or reports may be selected individually.  Each"
^DIC(19,1135,1,10,0)="report can include all information or be restricted to a single location,"
^DIC(19,1135,1,11,0)="patient, etc.  All reports can be restricted to a single organism.  A"
^DIC(19,1135,1,12,0)="survey by organism is sorted by the collection sample or site/specimen."
^DIC(19,1135,1,13,0)="All reports can be restricted to include only those patients with a"
^DIC(19,1135,1,14,0)="length of stay in the hospital exceeding a specified # of days.  This "
^DIC(19,1135,1,15,0)="can be helpful in tracking hospital-acquired infections.  The reports"
^DIC(19,1135,1,16,0)="can also be restricted to include only those that have specific anti-"
^DIC(19,1135,1,17,0)="biotic patterns."
^DIC(19,1135,25)="LRMISEZ"
^DIC(19,1135,99.1)="54225,41744"
^DIC(19,1135,"U")="INFECTION CONTROL SURVEY REPOR"
^DIC(19,1136,0)="LRMIPLOG^All results for selected accessions^^R^.5^^^^^^^26"
^DIC(19,1136,1,0)="^^1^1^2870206^^^^"
^DIC(19,1136,1,1,0)="Prints all available results for selected accession numbers in microbiology."
^DIC(19,1136,25)="LRMIPLOG"
^DIC(19,1136,"U")="ALL RESULTS FOR SELECTED ACCES"
^DIC(19,1138,0)="LRMIEDZ^Results entry^^R^.5^^^^^^^26"
^DIC(19,1138,1,0)="^^5^5^2880301^^^^"
^DIC(19,1138,1,1,0)="Allows input of microbiology test results by accession number.  A test"
^DIC(19,1138,1,2,0)="or procedure may be selected in order to limit data entry to only that"
^DIC(19,1138,1,3,0)="procedure.  Input prompts are dependent on the procedure and organisms"
^DIC(19,1138,1,4,0)="being reported.  A date must be entered to complete the 'FINAL' designation"
^DIC(19,1138,1,5,0)="of the result."
^DIC(19,1138,25)="LRMIEDZ"
^DIC(19,1138,"U")="RESULTS ENTRY"
^DIC(19,1139,0)="LRMIREF^References^^M^.5^^^^^^^26"
^DIC(19,1139,1,0)="^^1^1^2871231^^"
^DIC(19,1139,1,1,0)="Microbiology reference options"
^DIC(19,1139,10,0)="^19.01PI^3^3"
^DIC(19,1139,10,1,0)="1281^M"
^DIC(19,1139,10,2,0)="1282^I"
^DIC(19,1139,10,3,0)="1280^J"
^DIC(19,1139,10,"B",1280,3)=""
^DIC(19,1139,10,"B",1281,1)=""
^DIC(19,1139,10,"B",1282,2)=""
^DIC(19,1139,10,"C","I",2)=""
^DIC(19,1139,10,"C","J",3)=""
^DIC(19,1139,10,"C","M",1)=""
^DIC(19,1139,25)=""
^DIC(19,1139,99)="56214,30299"
^DIC(19,1139,99.1)="54225,33"
^DIC(19,1139,"U")="REFERENCES"
^DIC(19,1140,0)="LRMINEWD^Verification of data by tech^^R^.5^^^^^^^26"
^DIC(19,1140,1,0)="^^8^8^2870715^^^^"
^DIC(19,1140,1,1,0)="Allows lab techs to check and approve their own result entries or"
^DIC(19,1140,1,2,0)="supervisors to approve lab techs' result entries (LRSUPER key is"
^DIC(19,1140,1,3,0)="required to verify data entry by others).  The lab tech or supervisor"
^DIC(19,1140,1,4,0)="must choose a field to edit, then those accessions that have been edited"
^DIC(19,1140,1,5,0)="will be displayed.  The lab tech or supervisor can exclude specific"
^DIC(19,1140,1,6,0)="accessions from review, they can review the data as the wards or lab will "
^DIC(19,1140,1,7,0)="see it, and they can exclude accessions from verification.  The approved "
^DIC(19,1140,1,8,0)="results can also be sent to a device near the requesting location."
^DIC(19,1140,25)="LRMINEW"
^DIC(19,1140,99.1)="54226,27810"
^DIC(19,1140,"U")="VERIFICATION OF DATA BY TECH"
^DIC(19,1141,0)="LRMIVER^Verification of data by supervisor^^R^.5^LRSUPER^^^^^^26"
^DIC(19,1141,1,0)="^^5^5^2870209^^^^"
^DIC(19,1141,1,1,0)="This option allows supervisors to create a list of accessions to be"
^DIC(19,1141,1,2,0)="verified.  The supervisor may choose a previously used list or choose"
^DIC(19,1141,1,3,0)="a new list within a chosen date range.  The list can be printed and  "
^DIC(19,1141,1,4,0)="reviewed prior to verification.  The supervisor can exclude accessions"
^DIC(19,1141,1,5,0)="from the list and then verify the remainder."
^DIC(19,1141,25)="LRMIVER"
^DIC(19,1141,"U")="VERIFICATION OF DATA BY SUPERV"
^DIC(19,1142,0)="LRMISTUF^Results entry (batch)^^R^.5^^^^^^^26"
^DIC(19,1142,1,0)="^^10^10^2870209^^^^"
^DIC(19,1142,1,1,0)="Results entry (batch) allows you to enter either preliminary or final data"
^DIC(19,1142,1,2,0)="for one field and test for multiple accession numbers in one session.  "
^DIC(19,1142,1,3,0)="The field choices are Bacteriology, Mycology, TB, Virology, Mycobacter-"
^DIC(19,1142,1,4,0)="iology, Parasite Report Remark, Gram Stain, Urine Screen, Sputum Screen,"
^DIC(19,1142,1,5,0)="Parasitology Smear/Prep, Mycology Smear/Prep, and Acid Fast Stain.  These"
^DIC(19,1142,1,6,0)="choices are dependent on the microbiology test selected and specified on"
^DIC(19,1142,1,7,0)="the test's edit code.  There are three levels of automation to choose from:"
^DIC(19,1142,1,8,0)="1) result is entered and you are not allowed to change it, 2) result"
^DIC(19,1142,1,9,0)="is entered and you are allowed to change it, 3) no result is entered"
^DIC(19,1142,1,10,0)="for you.  You must have the LRVERIFY security key to use this option."
^DIC(19,1142,25)="LRMISTF"
^DIC(19,1142,"U")="RESULTS ENTRY (BATCH)"
^DIC(19,1143,0)="LRPHEXCPT^Receipt of routine lab collection from wards^^R^.5^^^^^^^26"
^DIC(19,1143,1,0)="4^^4^4^2870203^^^"
^DIC(19,1143,1,1,0)="After routine phlebotomy collection has been made, accessions are"
^DIC(19,1143,1,2,0)="designated as being in the lab by running this function.  For a given"
^DIC(19,1143,1,3,0)="location, orders not collected may be indicated with the remainder for"
^DIC(19,1143,1,4,0)="the location being logged in."
^DIC(19,1143,25)="LRPHEXPT"
^DIC(19,1143,"U")="RECEIPT OF ROUTINE LAB COLLECT"
^DIC(19,1144,0)="LRNONCOM^Special test accessioning^^R^.5^^^^^^^26"
^DIC(19,1144,1,0)="^^7^7^2870204^^^^"
^DIC(19,1144,1,1,0)="Several additional questions are asked in this option.  The key"
^DIC(19,1144,1,2,0)="question is which accession area the test(s) will be put under."
^DIC(19,1144,1,3,0)=" "
^DIC(19,1144,1,4,0)="If the order number is known and entered, the accessioning is the"
^DIC(19,1144,1,5,0)="same as the [LROE] option with the above noted exception."
^DIC(19,1144,1,6,0)="This option may be used for accessioning employee health patient"
^DIC(19,1144,1,7,0)="and other non-standard patients; e.g., research animals."
^DIC(19,1144,25)="LROEN^LROE"
^DIC(19,1144,"U")="SPECIAL TEST ACCESSIONING"
^DIC(19,1145,0)="LRACC1^Long form accession list^^R^.5^^^^^^^26"
^DIC(19,1145,1,0)="^^11^11^2870203^^^^"
^DIC(19,1145,1,1,0)="Detailed list of accessions by accession area.  The list produces"
^DIC(19,1145,1,2,0)="a complete listing of accessions over a specified time period."
^DIC(19,1145,1,3,0)="The user can opt to print only specified tests and/or only"
^DIC(19,1145,1,4,0)="uncompleted entries.  The status of each test for an accession"
^DIC(19,1145,1,5,0)="is also given.  Microbiology has its own ""Long Form Accession"""
^DIC(19,1145,1,6,0)="list (LRMIACC1).  The Long Form Accession list can effectively"
^DIC(19,1145,1,7,0)="replace log books, provide a list of uncompleted test(s) for "
^DIC(19,1145,1,8,0)="an accession area, and be used at the end of the shift and work "
^DIC(19,1145,1,9,0)="day to monitor what is left on the list.  Use the option ""Remove"
^DIC(19,1145,1,10,0)="an Accession"" (LRDELOG) to remove an unwanted accession so that "
^DIC(19,1145,1,11,0)="the ""rollover"" option, if activated, will work as desired."
^DIC(19,1145,25)="LRWRKLST"
^DIC(19,1145,"U")="LONG FORM ACCESSION LIST"
^DIC(19,1146,0)="LRACC2^Short accession list^^R^.5^^^^^^^26"
^DIC(19,1146,1,0)="^^3^3^2870204^^^^"
^DIC(19,1146,1,1,0)="An abbreviated list of accessions.  You may combine more than one"
^DIC(19,1146,1,2,0)="accession area on the list which may serve as a very abbreviated"
^DIC(19,1146,1,3,0)="worklist."
^DIC(19,1146,25)="LRLSTWRK"
^DIC(19,1146,"U")="SHORT ACCESSION LIST"
^DIC(19,1148,0)="LRLL^Build a load/work list^^R^.5^^^^^^^26"
^DIC(19,1148,1,0)="^^1^1^2870203^^^"
^DIC(19,1148,1,1,0)="This creates a load or work list for an instrument or manual test(s)."
^DIC(19,1148,25)="LRLL"
^DIC(19,1148,"U")="BUILD A LOAD/WORK LIST"
^DIC(19,1149,0)="LRLLP^Print a load/work list^^R^.5^^^^^^^26"
^DIC(19,1149,1,0)="^^2^2^2870203^^"
^DIC(19,1149,1,1,0)="Prints a load or work list.  You can start printing from any entry and"
^DIC(19,1149,1,2,0)="it will reflect revised and new current status of specimens."
^DIC(19,1149,25)="LRLLP"
^DIC(19,1149,"U")="PRINT A LOAD/WORK LIST"
^DIC(19,1150,0)="LRTESTDIQ^Inquiry to LAB TEST file^^I^.5^LRSUPER^^^^^^26^^^1"
^DIC(19,1150,1,0)="^^6^6^2870203^^^^"
^DIC(19,1150,1,1,0)="This function displays information from the Laboratory test file."
^DIC(19,1150,1,2,0)="All defined fields that are associated with the requested test in"
^DIC(19,1150,1,3,0)="file 60 are displayed.  If information is missing on a particular"
^DIC(19,1150,1,4,0)="test, the desired information must be first added to File 60."
^DIC(19,1150,1,5,0)="This option is just a ""lookup"" option to allow the user to inquire"
^DIC(19,1150,1,6,0)="about how a test is defined in the ""Laboratory Test File 60."""
^DIC(19,1150,15)="K %,A,DIC,DL,DX,K,S,X,Y,Z"
^DIC(19,1150,30)="LAB(60,"
^DIC(19,1150,31)="AEMQ"
^DIC(19,1150,80)="LAB(60,"
^DIC(19,1150,"U")="INQUIRY TO LAB TEST FILE"
^DIC(19,1151,0)="LRTASK ROLLOVER^ROLLOVER ACCESSION ^^R^.5^^^^^^^26"
^DIC(19,1151,1,0)="^^2^2^2941130^^^^"
^DIC(19,1151,1,1,0)="This routine is run each night by task-man to"
^DIC(19,1151,1,2,0)="roll forward the unverified accessions."
^DIC(19,1151,25)="LROLOVER"
^DIC(19,1151,99.1)="54223,10968"
^DIC(19,1151,200.9)="y"
^DIC(19,1151,"U")="ROLLOVER ACCESSION "
^DIC(19,1152,0)="LRTASK NIGHTY^NIGHTLY CLEANUP^^R^.5^^^^^^^26"
^DIC(19,1152,1,0)="^^6^6^2920625^^^^"
^DIC(19,1152,1,1,0)="This routine is run nighty by task-man to do some lab clean up."
^DIC(19,1152,1,2,0)="It cleans up a x-ref used by the LRTASK INTERIM option and updates"
^DIC(19,1152,1,3,0)="workload counts for WKLD code reporting.  This option should be tasked"
^DIC(19,1152,1,4,0)="right after midnight each day, and run only once a day."
^DIC(19,1152,1,5,0)=" This option also triggers the collection of Clinic Stop Codes and"
^DIC(19,1152,1,6,0)="passes this data to a MAS module utility."
^DIC(19,1152,25)="LRNIGHT"
^DIC(19,1152,200.9)="y"
^DIC(19,1152,"U")="NIGHTLY CLEANUP"
^DIC(19,1154,0)="LRGV^Group verify (EA, EL, EW)^^R^.5^LRLIASON^^^^^^26"
^DIC(19,1154,1,0)="^^3^3^2870203^^^^"
^DIC(19,1154,1,1,0)="This option provides for batch verification of automated instrument data."
^DIC(19,1154,1,2,0)="If a delta check or critical range check is found, the data need not be"
^DIC(19,1154,1,3,0)="approved.  Must have the LRVERIFY key to use this option."
^DIC(19,1154,25)="LRGV"
^DIC(19,1154,99.1)="54224,35565"
^DIC(19,1154,"U")="GROUP VERIFY (EA, EL, EW)"
^DIC(19,1155,0)="LRLIASON^Lab liaison menu^^M^10958^LRLIASON^^^^^^"
^DIC(19,1155,1,0)="^^1^1^2970826^^^^"
^DIC(19,1155,1,1,0)="This menu should only be assigned to the LAB liason person."
^DIC(19,1155,10,0)="^19.01PI^0^0"
^DIC(19,1155,99)="57189,33477"
^DIC(19,1155,99.1)="67804,41143"
^DIC(19,1155,"U")="LAB LIAISON MENU"
^DIC(19,1156,0)="LRGP^Group unverified review (EA, EL, EW)^^R^.5^^^^^^^26"
^DIC(19,1156,1,0)="^^2^2^2870203^^"
^DIC(19,1156,1,1,0)="Batch review of automated instrument data, similar printout to LRGVP;"
^DIC(19,1156,1,2,0)="no editing or verification is done."
^DIC(19,1156,25)="LRGP"
^DIC(19,1156,"U")="GROUP UNVERIFIED REVIEW (EA, E"
^DIC(19,1157,0)="LRVR^Enter/verify data (auto instrument)^^R^.5^^^^^^^26"
^DIC(19,1157,1,0)="^^8^8^2870203^^^^"
^DIC(19,1157,1,1,0)="Data from an automated instrument can be reviewed/edited individually"
^DIC(19,1157,1,2,0)="by accession, by worklist sequence, by tray-cup.  If the LRVERIFY"
^DIC(19,1157,1,3,0)="key is owned, the data may also be verified.  Once verified, the data are"
^DIC(19,1157,1,4,0)="not available for viewing with this option.  Likewise, if test results"
^DIC(19,1157,1,5,0)="have been previously verified for a given accession, even new data"
^DIC(19,1157,1,6,0)="from the automated instrument can neither be viewed or verified."
^DIC(19,1157,1,7,0)="Entering the ""*"" character for any entry will substitute the word"
^DIC(19,1157,1,8,0)="""canceled"" as the result."
^DIC(19,1157,25)="LRVR"
^DIC(19,1157,"U")="ENTER/VERIFY DATA (AUTO INSTRU"
^DIC(19,1159,0)="LRCENLKUP^Review by order number^^R^.5^^^^^^^26"
^DIC(19,1159,1,0)="^^2^2^2870204^^^^"
^DIC(19,1159,1,1,0)="If the order number is known, essential information related to the order"
^DIC(19,1159,1,2,0)="can be displayed with this function."
^DIC(19,1159,25)="LRCE"
^DIC(19,1159,"U")="REVIEW BY ORDER NUMBER"
^DIC(19,1160,0)="LRSMACMENU^Smac Support menu^^M^.5^^^^^^^26"
^DIC(19,1160,1,0)="^^2^2^2901022^^"
^DIC(19,1160,1,1,0)="Since the SMAC has a number of specialized support functions, it has its"
^DIC(19,1160,1,2,0)="own menu."
^DIC(19,1160,10,0)="^19.01PI^10^6"
^DIC(19,1160,10,3,0)="1161^"
^DIC(19,1160,10,5,0)="1162^"
^DIC(19,1160,10,6,0)="1163^"
^DIC(19,1160,10,7,0)="1154^"
^DIC(19,1160,10,9,0)="1179^"
^DIC(19,1160,10,10,0)="1111^"
