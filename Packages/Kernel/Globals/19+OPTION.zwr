^DIC(19,11445,1,1,0)="Scan through a file selected for Duplicate Resolution to check for"
^DIC(19,11445,1,2,0)="entries within the file which are missing identifiers (which are presumed"
^DIC(19,11445,1,3,0)="to be significant data elements) or have other problems."
^DIC(19,11445,25)="XDRDPREL"
^DIC(19,11445,"U")="PRELIMINARY SCAN OF FILE FOR E"
^DIC(19,11446,0)="XDR SCAN POSSIBLE DUPLICATES^Scan Possible Duplicates^^R^1039^^^^^^^349"
^DIC(19,11446,1,0)="^^5^5^2971122^^^"
^DIC(19,11446,1,1,0)="This option provides a rapid scan of possible duplicates by listing"
^DIC(19,11446,1,2,0)="the zero node of the patient file for each individual."
^DIC(19,11446,1,3,0)=" "
^DIC(19,11446,1,4,0)="If the output is not queued to a printer, then the data will be sent"
^DIC(19,11446,1,5,0)="to the FM Browser for examination."
^DIC(19,11446,25)="XDRDDATA"
^DIC(19,11446,"U")="SCAN POSSIBLE DUPLICATES"
