^DIC(19,14969,0)="PSO PROCESS TELEPHONE REFILLS^Process Telephone Refills^^R^1^^^^^^y^141"
^DIC(19,14969,1,0)="^19.06^11^11^3210920^^"
^DIC(19,14969,1,1,0)="Retrieves the information for prescription refills and renewals from the"
^DIC(19,14969,1,2,0)="third-party AudioCARE vendor array,^VEXHRX(19080), and stores into the new"
^DIC(19,14969,1,3,0)="PHARMACY TELEPHONE REFILLS file (#52.444).  Only refill/renewal "
^DIC(19,14969,1,4,0)="prescription requests that do not yet have a processed date are"
^DIC(19,14969,1,5,0)="transmitted from the vendor array. The telephone refills system processes"
^DIC(19,14969,1,6,0)="prescriptions by refilling, renewing, or marking the order as not"
^DIC(19,14969,1,7,0)="processed. These actions produce various processing results that are"
^DIC(19,14969,1,8,0)="recorded into the PHARMACY TELEPHONE REFILLS file (#52.444). These results"
^DIC(19,14969,1,9,0)="include the processed date and renewal processing codes. This information"
^DIC(19,14969,1,10,0)="is then sent back to the AudioCARE vendor array to enable further"
^DIC(19,14969,1,11,0)="processing functions by the AudioCARE system."
^DIC(19,14969,10.1)="Telephone Refills"
^DIC(19,14969,25)="PSOVEXRX"
^DIC(19,14969,99)="64756,29771"
^DIC(19,14969,"U")="PROCESS TELEPHONE REFILLS"
^DIC(19,14970,0)="PSO PURGE PROCESSED 52.444^Purge Processed Telephone Refill Requests^^R^1^^^^^^n^141"
^DIC(19,14970,1,0)="^19.06^2^2^3210921^^"
^DIC(19,14970,1,1,0)="This option is recommended for scheduling and is designed to clear out"
^DIC(19,14970,1,2,0)="processed refills from the PHARMACY TELEPHONE REFILLS file 52.444."
^DIC(19,14970,10.1)="Clear processed RX requests."
^DIC(19,14970,25)="CLEAN^PSOVEXR1"
^DIC(19,14970,200.9)="y"
^DIC(19,14970,"U")="PURGE PROCESSED TELEPHONE REFI"
