^DIC(19,15079,1,2,0)="export of patient inquiry and patient update audit records to the central"
^DIC(19,15079,1,3,0)="VAS repository. "
^DIC(19,15079,25)="DISPLAY^DGAUDIT3"
^DIC(19,15079,"U")="DISPLAY VAS PARAMETERS"
