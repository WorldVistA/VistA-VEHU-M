^DIC(19,8473,0)="LRTASK CUM FILEROOM^TASK CUMULATIVE FILEROOM REPORT^^R^.5^LRSUPER^^^^^^26^^"
^DIC(19,8473,1,0)="^^12^12^2940623^^^^"
^DIC(19,8473,1,1,0)=" This option is used to print file room cumulative patients. This option"
^DIC(19,8473,1,2,0)="determines the last time the file room patients were printed. It then"
^DIC(19,8473,1,3,0)="identifies all file room patients that require printing since the last"
^DIC(19,8473,1,4,0)="run and move those entries to the current list of cumulative file room"
^DIC(19,8473,1,5,0)="patients. Finally it queues a task to print these patients to specified"
^DIC(19,8473,1,6,0)="printers."
^DIC(19,8473,1,7,0)=" WHEN THE LAB REPORTS FILE HAS BEEN PROPERLY SET, THIS OPTION WILL ALLOW"
^DIC(19,8473,1,8,0)="THE PRINTING OF THE FILE ROOM CUM ON A DIFFERENT SCHEDULE THAN IN PATIENT"
^DIC(19,8473,1,9,0)="CUMS."
^DIC(19,8473,1,10,0)=" "
^DIC(19,8473,1,11,0)="  The manual version of this option is LRFAC MANUAL FILE ROOM CUM. This "
^DIC(19,8473,1,12,0)="option is designed to be tasked. The manual version SHOULD NOT be tasked."
^DIC(19,8473,20)=""
^DIC(19,8473,25)="CLOCK^LRACFR"
^DIC(19,8473,"U")="TASK CUMULATIVE FILEROOM REPOR"
^DIC(19,8474,0)="LRAC MANUAL FILEROON CUM^Manual Queuing of Fileroom Cum^^R^.5^LRSUPER^^^^^^26"
^DIC(19,8474,1,0)="^^7^7^2951011^^^^"
^DIC(19,8474,1,1,0)="This option runs the manual version of the LRTASK CUM FILEROOM option."
^DIC(19,8474,1,2,0)="You may use this option if you don't wish to schedule automatic printing"
^DIC(19,8474,1,3,0)="of the fileroom cumulative using the LRTASK CUM FILEROON option.  This"
^DIC(19,8474,1,4,0)="option should never be tasked because there are prompts for the user.  When"
^DIC(19,8474,1,5,0)="the proper file setup has been done, this option will allow the printing of"
^DIC(19,8474,1,6,0)="the file room cumulative on a different schedule than the inpatient "
^DIC(19,8474,1,7,0)="cumulatives."
^DIC(19,8474,25)="LRACFR"
^DIC(19,8474,"U")="MANUAL QUEUING OF FILEROOM CUM"
^DIC(19,8475,0)="LRMIXALL^Re-index Antimicrobial Suscept File (62.06)^^R^.5^^^^^^^26"
^DIC(19,8475,1,0)="^^8^8^2940623^^"
^DIC(19,8475,1,1,0)=" This option is used to re-index a single antibiotic in the 'ANTIBICROBIAL"
^DIC(19,8475,1,2,0)="SUSCEPTIBILITY file (#62.06).  This option differs from the FileMan re-"
^DIC(19,8475,1,3,0)="index in two ways. 1) This option removes all X-ref entries. 2) It allows"
^DIC(19,8475,1,4,0)="the user to select a single antibiotic."
^DIC(19,8475,1,5,0)=" When a selection is made, X-Ref of 'AI',""AJ"" and ""AS"" cleared and re"
^DIC(19,8475,1,6,0)="defined."
^DIC(19,8475,1,7,0)="  Note: This option may be used when trouble shooting Microbiology results"
^DIC(19,8475,1,8,0)="print out of antibiotics."
^DIC(19,8475,25)="MAN^LRMIXALL"
^DIC(19,8475,"U")="RE-INDEX ANTIMICROBIAL SUSCEPT"
