^DIC(19,10505,1,2,0)="used by OE/RR."
^DIC(19,10505,20)="I $L($T(TED^XPAREDIT)) D TED^XPAREDIT(""LR DOMAIN"",""B"")"
^DIC(19,10505,"U")="DOMAIN LEVEL PARAMETER EDIT"
