^DIC(19,16103,1,0)="^^6^6^3240328^"
^DIC(19,16103,1,1,0)="Use this option to resequence the order in which the allowable "
^DIC(19,16103,1,2,0)="entites for parameter 'ORWRP HEALTH SUMMARY TYPE LIST' are used "
^DIC(19,16103,1,3,0)="in building the list of Health Summary Types for the CPRS Reports"
^DIC(19,16103,1,4,0)="Tab.  This order is used for any user who does not have user "
