^DIC(19,507,0)="DG THIRD PARTY PATIENT REVIEW^Patient Review Document^^R^.5^^^^^^^114"
^DIC(19,507,1,0)="^^3^3^2930402^^"
^DIC(19,507,1,1,0)="This option prompts for patient and, if there are admissions on"
^DIC(19,507,1,2,0)="file, prompts for admission. If there are no admissions or no "
^DIC(19,507,1,3,0)="admission is chosen, it then checks for scheduled admissions."
