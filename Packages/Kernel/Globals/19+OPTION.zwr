^DIC(19,111,1,0)="^^3^3^3020808^^^^"
^DIC(19,111,1,1,0)="Loads routines from an external device, like a host file."
^DIC(19,111,1,2,0)="**DO NOT USE THIS OPTION IF YOU AREN'T SURE HOW TO RUN IT!!**"
^DIC(19,111,1,3,0)=""
^DIC(19,111,20)="N % S %=$G(^%ZOSF(""OS"")) D @$S(%[""OpenM"":""^%RI"",%[""DTM"":""^%rload"",%[""GT.M"":""^%RI"",1:""^%RR"")"
^DIC(19,111,25)=""
^DIC(19,111,"U")="INPUT ROUTINES"
