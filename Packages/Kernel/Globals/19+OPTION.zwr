^DIC(19,9751,0)="NURS-COMP^Position Control/Staff File Integrity Report^^R^10958^^^^^^^28"
^DIC(19,9751,1,0)="^^4^4^2960813^"
^DIC(19,9751,1,1,0)="This option searches the Position Control File (#211.8) for staff who are"
^DIC(19,9751,1,2,0)="not in the NURS Staff File (#210). If any is found, a listing is displayed"
^DIC(19,9751,1,3,0)="to the terminal or can be queued to a printer. The user may selectively"
^DIC(19,9751,1,4,0)="re-enter any of the staff with all required data."
^DIC(19,9751,10.1)="COMPARE F-211.8 AGAINST F-210"
^DIC(19,9751,25)="NURSCEP"
^DIC(19,9751,"U")="POSITION CONTROL/STAFF FILE IN"
^DIC(19,9752,0)="NURS-EXP^NURS Staff Experience Integrity Check/Fix^^R^10958^^^^^^^28"
^DIC(19,9752,1,0)="^^17^17^2970220^^"
^DIC(19,9752,1,1,0)=" This option checks the integrity of the NURS STAFF Experience sub-file."
^DIC(19,9752,1,2,0)="The option will detect and correct the following discrepancies:"
^DIC(19,9752,1,3,0)=" "
^DIC(19,9752,1,4,0)="1. Change pointer values in name field to appropriate free-text values."
^DIC(19,9752,1,5,0)=" "
^DIC(19,9752,1,6,0)="2. Delete corrupted entries containing no data or cross references."
^DIC(19,9752,1,7,0)=" "
^DIC(19,9752,1,8,0)="3. Restore the missing name field for entries with a ""B"" index entry."
^DIC(19,9752,1,9,0)=" "
^DIC(19,9752,1,10,0)="4. Convert lower case name data to uppercase."
^DIC(19,9752,1,11,0)=" "
^DIC(19,9752,1,12,0)="5. Delete entries not found in the NURS CLINICAL BACKGROUND File."
^DIC(19,9752,1,13,0)=" "
^DIC(19,9752,1,14,0)="6. Remove duplicate cross reference entries from the subfile."
^DIC(19,9752,1,15,0)=" "
^DIC(19,9752,1,16,0)="This option checks, cleans and re-crossreferences the Nurstaff Experience"
^DIC(19,9752,1,17,0)="Sub-File."
^DIC(19,9752,25)="NURSEXP"
^DIC(19,9752,"U")="NURS STAFF EXPERIENCE INTEGRIT"
^DIC(19,9753,0)="NURCPE-VIT TPR EXT B/P^Temp, Detailed PR and B/P^NUR*4*40 - shutdown Vitals CHUI^R^1^^^^^^^28^^1^1"
^DIC(19,9753,1,0)="^^6^6^2940228^^^^"
^DIC(19,9753,1,1,0)="This option allows data to be entered for temperature, pulse, respiration "
^DIC(19,9753,1,2,0)="and detaied blood pressure.  Detailed blood pressure captures the numeric"
^DIC(19,9753,1,3,0)="value of both the systolic and diastolic pressures and also associates "
^DIC(19,9753,1,4,0)="(a) the site where the pressure was taken (e.g., left arm vs right arm), and"
^DIC(19,9753,1,5,0)="(b) the position of the patient when the reading was taken (e.g., sitting vs"
^DIC(19,9753,1,6,0)="standing)."
^DIC(19,9753,15)="D EXITACT^NURCVED2"
^DIC(19,9753,20)="D ENTACT^NURCVED2"
^DIC(19,9753,25)="EN8^NURCVED2"
^DIC(19,9753,"U")="TEMP, DETAILED PR AND B/P"
^DIC(19,9754,0)="NURCPE-VIT EXT B/P^Detailed B/P and Associated Pulse^NUR*4*40 - shutdown Vitals CHUI^R^1^^^^^^^28^^1^1"
^DIC(19,9754,1,0)="^^5^5^2961219^"
^DIC(19,9754,1,1,0)="This option allows users to enter detailed blood pressure and"
^DIC(19,9754,1,2,0)="associated information.  In addition to the numeric values of the blood"
^DIC(19,9754,1,3,0)="pressure and pulse readings, the site/location where the eblood pressure"
^DIC(19,9754,1,4,0)="and pulse were taken (e.g., left arm vs right arm), the position of the"
^DIC(19,9754,1,5,0)="patient (e.g., sitting, standing) and other qualifiers are documented."
^DIC(19,9754,15)="D EXITACT^NURCVED2"
^DIC(19,9754,20)="D ENTACT^NURCVED2"
^DIC(19,9754,25)="EN9^NURCVED2"
^DIC(19,9754,"U")="DETAILED B/P AND ASSOCIATED PU"
^DIC(19,9755,0)="NURCPE-VIT HTWT^**deleted**^NUR*4*40 - shutdown Vitals CHUI^R^1^^^^^^^28^^1^1"
^DIC(19,9755,1,0)="^^1^1^2970124^^^^"
^DIC(19,9755,1,1,0)="This option allows entry for height and weight measurements."
^DIC(19,9755,15)="D EXITACT^NURCVED2"
^DIC(19,9755,20)="D ENTACT^NURCVED2"
^DIC(19,9755,25)="EN10^NURCVED2"
^DIC(19,9755,"U")="**DELETED**"
^DIC(19,9756,0)="NURCPE-VIT FILECONF^Selected V/M Site File Functions^NUR*4*40 - shutdown Vitals CHUI^M^1^^^^^^^28"
^DIC(19,9756,1,0)="^^8^8^2970204^^^^"
^DIC(19,9756,1,1,0)="This menu contains the following options:"
^DIC(19,9756,1,2,0)="1. Enter/Edit Vitals Qualifierrs option is used to configure qualifiers in"
^DIC(19,9756,1,3,0)="   the GMRV Vital Qualifier file (#120.52) for vital types, blood"
^DIC(19,9756,1,4,0)="   pressuree, for example."
^DIC(19,9756,1,5,0)="2. Change Default Qualifiers for Temp./Pulse is used to change the default"
^DIC(19,9756,1,6,0)="   qualifier for temperature and pulse."
^DIC(19,9756,1,7,0)="3. Display Vitals Category/Qualifier Table is used to print the categories"
^DIC(19,9756,1,8,0)="   /qualifiers table for each vital type."
^DIC(19,9756,10,0)="^19.01PI^3^3"
^DIC(19,9756,10,1,0)="9757^1^1"
^DIC(19,9756,10,2,0)="9758^2^2"
^DIC(19,9756,10,3,0)="10498^3^3"
