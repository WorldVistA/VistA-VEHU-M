^DIC(19,16203,0)="EHM-01024^CPRS Health Summary Display/Edit Site Defaults^^M^1^^^^^^^^^^^"
^DIC(19,16203,1,0)="^^9^9^3240328^"
^DIC(19,16203,1,1,0)="Use the options in the CPRS Health Summary Display/Edit Site "
^DIC(19,16203,1,2,0)="Defaults Menu to display the site defaults, select the Health "
^DIC(19,16203,1,3,0)="Summary Types to list on the Reports Tab, edit the method of "
^DIC(19,16203,1,4,0)="building the list (append/overwrite), edit allowable entities"
^DIC(19,16203,1,5,0)="for the list (i.e., User, System, Division, etc.), or resequence"
^DIC(19,16203,1,6,0)="the allowable entities in the order they should be appear on "
