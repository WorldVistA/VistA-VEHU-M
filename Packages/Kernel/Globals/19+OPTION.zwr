^DIC(19,13541,"U")="MANAGER SUMMARY REPORT"
^DIC(19,13542,0)="SDSC PROVIDER TOTAL REPORT^Provider Total Summary Report^^R^1^^^^^^^16"
^DIC(19,13542,1,0)="^^3^3^3070326^"
^DIC(19,13542,1,1,0)="This option displays provider totals by division for the VBA okay codes,"
^DIC(19,13542,1,2,0)="changed service connected encounters and encounters where the service"
^DIC(19,13542,1,3,0)="connected was not changed."
