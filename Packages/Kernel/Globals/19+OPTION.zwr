^DIC(19,16692,1,4,0)="for import."
^DIC(19,16692,1,5,0)="Cloned from ""GMTS OBJ EXPORT"" option."
^DIC(19,16692,3)=""
^DIC(19,16692,25)="EXP^GMTSOBJ"
^DIC(19,16692,"U")="EXPORT A HEALTH SUMMARY OBJECT"
^DIC(19,16693,0)="EHM-01514^Import/Install a Health Summary Object^^R^1^^^^^^^^^^^"
^DIC(19,16693,1,0)="^19.06^11^11^3240328^^^"
^DIC(19,16693,1,1,0)="This option is used to install a Health Summary Object "
^DIC(19,16693,1,2,0)="exported using the GMTS OBJ EXPORT option.  The incoming "
^DIC(19,16693,1,3,0)="Object must first be unpacked from the incoming Mailman "
^DIC(19,16693,1,4,0)="message using Packman utilities.  Then this option is used "
^DIC(19,16693,1,5,0)="to install the object into the Health Summary files.  "
^DIC(19,16693,1,6,0)="If there is a Health Summary Type with the same name as "
^DIC(19,16693,1,7,0)="the Health Summary being imported, then you will be prompted"
^DIC(19,16693,1,8,0)="to either use the existing Health Summary Type, or to "
^DIC(19,16693,1,9,0)="rename the incoming Health Summary Type.  At no time will "
^DIC(19,16693,1,10,0)="an existing Health Summary Type be over written."
^DIC(19,16693,1,11,0)="Cloned from ""GMTS OBJ IMPORT/INSTALL"" option."
^DIC(19,16693,3)=""
^DIC(19,16693,25)="INS^GMTSOBJ"
^DIC(19,16693,"U")="IMPORT/INSTALL A HEALTH SUMMAR"
^DIC(19,16694,0)="EHM-01515^Print Health Summary Menu^^M^1^^^^^^^160^^^^"
^DIC(19,16694,1,0)="^^6^6^3240328^"
^DIC(19,16694,1,1,0)="This menu includes all of the various print options available for Health"
^DIC(19,16694,1,2,0)="Summaries, allowing the user to generate Health Summaries by Patient, by"
^DIC(19,16694,1,3,0)="Patient and a date range, by patient and a outpatient visit or an"
^DIC(19,16694,1,4,0)="admission, by Location, for patients at all clinics, and on an Ad Hoc"
^DIC(19,16694,1,5,0)="basis."
^DIC(19,16694,1,6,0)="Cloned from ""GMTS HS MENU"" option."
^DIC(19,16694,3)=""
^DIC(19,16694,10,0)="^19.01IP^6^6"
^DIC(19,16694,10,1,0)="16695^1^1"
^DIC(19,16694,10,2,0)="16696^5^5"
^DIC(19,16694,10,3,0)="16697^2^2"
^DIC(19,16694,10,4,0)="16698^4^4"
^DIC(19,16694,10,5,0)="16699^6^6"
^DIC(19,16694,10,6,0)="16700^3^3"
^DIC(19,16694,10,"B",16695,1)=""
^DIC(19,16694,10,"B",16696,2)=""
^DIC(19,16694,10,"B",16697,3)=""
^DIC(19,16694,10,"B",16698,4)=""
^DIC(19,16694,10,"B",16699,5)=""
^DIC(19,16694,10,"B",16700,6)=""
^DIC(19,16694,10,"C",1,1)=""
^DIC(19,16694,10,"C",2,3)=""
^DIC(19,16694,10,"C",3,6)=""
^DIC(19,16694,10,"C",4,4)=""
^DIC(19,16694,10,"C",5,2)=""
^DIC(19,16694,10,"C",6,5)=""
^DIC(19,16694,25)=""
^DIC(19,16694,99)="67411,49178"
^DIC(19,16694,"U")="PRINT HEALTH SUMMARY MENU"
^DIC(19,16695,0)="EHM-01516^Patient Health Summary^^R^1^^^^^^^160^^1^^"
^DIC(19,16695,1,0)="^^3^3^3240328^^^^"
^DIC(19,16695,1,1,0)="Generates a Health Summary of a specified pre-defined Health Summary Type"
^DIC(19,16695,1,2,0)="for a specified patient."
^DIC(19,16695,1,3,0)="Cloned from ""GMTS HS BY PATIENT"" option."
^DIC(19,16695,2)="y"
^DIC(19,16695,3)=""
^DIC(19,16695,20)="K ORVP"
^DIC(19,16695,25)="GMTS"
^DIC(19,16695,72)="W @IOF"
^DIC(19,16695,99)="54858,49206"
^DIC(19,16695,"U")="PATIENT HEALTH SUMMARY"
^DIC(19,16696,0)="EHM-01517^Hospital Location Health Summary^^R^1^^^^^n^^160^^^^"
^DIC(19,16696,1,0)="^^5^5^3240328^"
^DIC(19,16696,1,1,0)="Allows user to print health summaries interactively for all patients on a"
^DIC(19,16696,1,2,0)="specified ward(s), for all patients with appointments at a specified"
^DIC(19,16696,1,3,0)="outpatient clinic(s), or for all patients scheduled for a specified"
^DIC(19,16696,1,4,0)="operating room(s) on a selected day or range of days."
^DIC(19,16696,1,5,0)="Cloned from ""GMTS HS BY LOC"" option."
^DIC(19,16696,2)="y"
^DIC(19,16696,3)=""
^DIC(19,16696,25)="MAIN^GMTSPD"
^DIC(19,16696,99)="55425,54053"
^DIC(19,16696,"U")="HOSPITAL LOCATION HEALTH SUMMA"
^DIC(19,16697,0)="EHM-01518^Ad Hoc Health Summary^^R^1^^^^^^^160^^1^^"
^DIC(19,16697,1,0)="^^6^6^3240328^"
^DIC(19,16697,1,1,0)="Generates an 'Ad Hoc' Health Summary for specified patients. Instead of"
^DIC(19,16697,1,2,0)="selecting a pre-defined Health Summary Type, the user defines his own ad"
^DIC(19,16697,1,3,0)="hoc Health Summary structure for temporary use while using this option."
^DIC(19,16697,1,4,0)="The user selects Health Summary components, time and occurrence limits"
^DIC(19,16697,1,5,0)="when applicable, and selection items when applicable."
^DIC(19,16697,1,6,0)="Cloned from ""GMTS HS ADHOC"" option."
^DIC(19,16697,3)=""
^DIC(19,16697,20)="K ORVP"
^DIC(19,16697,25)="GMTSADH"
^DIC(19,16697,99)="55626,36491"
^DIC(19,16697,"U")="AD HOC HEALTH SUMMARY"
^DIC(19,16698,0)="EHM-01519^Visit Patient Health Summary^^R^1^^^^^^^160^^1^1^"
^DIC(19,16698,1,0)="^^9^9^3240328^^"
^DIC(19,16698,1,1,0)="Generates Health Summaries of a specified pre-defined Health Summary Type"
^DIC(19,16698,1,2,0)="for multiple patients. After a patient is selected, the user can pick an"
^DIC(19,16698,1,3,0)="outpatient visit (based on the VISIT File) or an inpatient hospital"
^DIC(19,16698,1,4,0)="admission (based on the Patient Movement file). If the Patient Care"
^DIC(19,16698,1,5,0)="Encounter (PCE) package isn't installed then the user can only choose an"
^DIC(19,16698,1,6,0)="inpatient visit. Data for summaries is based on a date range from the"
^DIC(19,16698,1,7,0)="outpatient visit or inpatient admission. This Date Range overrides Time"
^DIC(19,16698,1,8,0)="Limits for components which allows this option."
^DIC(19,16698,1,9,0)="Cloned from ""GMTS HS BY PATIENT & VISIT"" option."
^DIC(19,16698,3)=""
^DIC(19,16698,15)="K GMTSPXGO"
^DIC(19,16698,20)="K ORVP S GMTSPXGO=1"
^DIC(19,16698,25)="GMTS"
^DIC(19,16698,"U")="VISIT PATIENT HEALTH SUMMARY"
^DIC(19,16699,0)="EHM-01520^Batch Print of All Clinics by Visit Date^^R^1^^^^^^^160^^^^"
^DIC(19,16699,1,0)="^^9^9^3240328^"
^DIC(19,16699,1,1,0)="Allows user to interactively designate the batch print of all health"
^DIC(19,16699,1,2,0)="summaries for patients with appointments at all outpatient clinics on a"
^DIC(19,16699,1,3,0)="selected day. Summaries will be printed at the print device designated for"
^DIC(19,16699,1,4,0)="that clinic in the Location Parameters. This option is an alternate method"
^DIC(19,16699,1,5,0)="to designate when summaries should be printed for all clinics. The nightly"
^DIC(19,16699,1,6,0)="batch job that prints summaries for wards, clinics and operating rooms"
^DIC(19,16699,1,7,0)="probably should be disable if the user wants to uses this option on a"
^DIC(19,16699,1,8,0)="daily basis."
^DIC(19,16699,1,9,0)="Cloned from ""GMTS HS FOR ALL CLINICS"" option."
^DIC(19,16699,3)=""
^DIC(19,16699,25)="MAIN^GMTSPCD"
^DIC(19,16699,"U")="BATCH PRINT OF ALL CLINICS BY "
^DIC(19,16700,0)="EHM-01521^Range of Dates Patient Health Summary^^R^1^^^^^^^160^^1^1^"
^DIC(19,16700,1,0)="^^6^6^3240328^^^^"
^DIC(19,16700,1,1,0)="Generates Health Summaries of a specified pre-defined Health"
^DIC(19,16700,1,2,0)="Summary Type for multiple patients. After patients are selected."
^DIC(19,16700,1,3,0)="the user can pick a date range. Data for summaries is based on"
^DIC(19,16700,1,4,0)="the date range. This date range overrides Time Limits for"
^DIC(19,16700,1,5,0)="components which allow this option."
^DIC(19,16700,1,6,0)="Cloned from ""GMTS HS BY PATIENT & DATE RANG"" option."
^DIC(19,16700,3)=""
^DIC(19,16700,15)="K GMRANGE"
^DIC(19,16700,20)="K ORVP S GMRANGE=1"
^DIC(19,16700,25)="GMTS"
^DIC(19,16700,"U")="RANGE OF DATES PATIENT HEALTH "
^DIC(19,16701,0)="EHM-01522^Set-up Batch Print Locations^^R^1^^^^^^^160^^^^"
^DIC(19,16701,1,0)="^^16^16^3240328^"
^DIC(19,16701,1,1,0)="Allows the user to set-up Health Summary Types to be batch printed nightly"
^DIC(19,16701,1,2,0)="for all patients at a specified hospital location."
^DIC(19,16701,1,3,0)=" "
^DIC(19,16701,1,4,0)="Location may be a ward or a clinic. If location is a clinic, the user is"
^DIC(19,16701,1,5,0)="asked to specify 'Print Days Ahead.' Health Summaries will then be printed"
^DIC(19,16701,1,6,0)="for all patients with appointments that many days in the future."
^DIC(19,16701,1,7,0)=" "
^DIC(19,16701,1,8,0)="To generate summaries, this option requires that option GMTS TASK STARTUP"
^DIC(19,16701,1,9,0)="be queued to run nightly.  Summaries should then be printed during the"
^DIC(19,16701,1,10,0)="night and be ready for distribution by early morning. Thus, 0 Print Days"
^DIC(19,16701,1,11,0)="Ahead means summaries should be ready to distribute by early morning of"
^DIC(19,16701,1,12,0)="day of clinic appointment."
^DIC(19,16701,1,13,0)=" "
^DIC(19,16701,1,14,0)="For ease in separating printouts queued to the same device, a location"
^DIC(19,16701,1,15,0)="banner appears in front of each locations Health Summaries."
^DIC(19,16701,1,16,0)="Cloned from ""GMTS HS BY LOC PARAMETERS"" option."
^DIC(19,16701,3)=""
^DIC(19,16701,25)="GMTSPP"
^DIC(19,16701,99)="55689,37491"
^DIC(19,16701,"U")="SET-UP BATCH PRINT LOCATIONS"
^DIC(19,16702,0)="EHM-01523^List Batch Health Summary Locations^^P^1^^^^^^y^^^^^"
^DIC(19,16702,1,0)="^^4^4^3240328^"
^DIC(19,16702,1,1,0)="This option displays a list of all locations which will be checked to see"
^DIC(19,16702,1,2,0)="if health summaries should be printed in the nightly run of GMTS TASK"
^DIC(19,16702,1,3,0)="STARTUP."
^DIC(19,16702,1,4,0)="Cloned from ""GMTS TASK LOCATIONS LIST"" option."
^DIC(19,16702,3)=""
^DIC(19,16702,60)="GMT(142,"
^DIC(19,16702,62)=0
^DIC(19,16702,63)="[GMTS TASK LOCATIONS LIST]"
^DIC(19,16702,64)="[GMTS TASK LOCATIONS SORT]"
^DIC(19,16702,65)="A"
^DIC(19,16702,66)="zzz"
^DIC(19,16702,73)=""
^DIC(19,16702,"U")="LIST BATCH HEALTH SUMMARY LOCA"
^DIC(19,16703,0)="EHM-01524^CPRS Reports Tab 'Health Summary Types List' Menu^^M^1^^^^^^^^^^^"
^DIC(19,16703,1,0)="^^5^5^3240328^"
^DIC(19,16703,1,1,0)="Use the options in the CPRS Reports Tab Health Summary Types List"
^DIC(19,16703,1,2,0)="Menu to select the Health Summary Types to list on the Reports Tab,"
^DIC(19,16703,1,3,0)="arrange the order of these Health Summaries on the list, and to "
^DIC(19,16703,1,4,0)="view the user s preferences."
^DIC(19,16703,1,5,0)="Cloned from ""GMTS GUI REPORTS LIST MENU"" option."
^DIC(19,16703,3)=""
^DIC(19,16703,10,0)="^19.01IP^4^4"
^DIC(19,16703,10,1,0)="16704^1^1"
^DIC(19,16703,10,2,0)="16705^2^2"
^DIC(19,16703,10,3,0)="16706^3^3"
^DIC(19,16703,10,4,0)="16707^4^4"
^DIC(19,16703,10,"B",16704,1)=""
^DIC(19,16703,10,"B",16705,2)=""
^DIC(19,16703,10,"B",16706,3)=""
^DIC(19,16703,10,"B",16707,4)=""
^DIC(19,16703,10,"C",1,1)=""
^DIC(19,16703,10,"C",2,2)=""
^DIC(19,16703,10,"C",3,3)=""
^DIC(19,16703,10,"C",4,4)=""
^DIC(19,16703,99)="67411,49178"
^DIC(19,16703,99.1)="59171,34704"
^DIC(19,16703,"U")="CPRS REPORTS TAB 'HEALTH SUMMA"
^DIC(19,16704,0)="EHM-01525^Display 'Health Summary Types List' Defaults^^R^1^^^^^^^^^^^"
^DIC(19,16704,1,0)="^19.06^6^6^3240328^^^^"
^DIC(19,16704,1,1,0)="Use this option to display the list of Health Summary Types that "
^DIC(19,16704,1,2,0)="will be contained in the 'Health Summary Types' section on the "
^DIC(19,16704,1,3,0)="Reports Tab in CPRS.  The display includes the precedence of "
^DIC(19,16704,1,4,0)="parameters, the method for building the list, and finally the list"
^DIC(19,16704,1,5,0)="that will actually appear on the Reports Tab in CPRS."
^DIC(19,16704,1,6,0)="Cloned from ""GMTS GUI HS LIST DEFAULTS"" option."
^DIC(19,16704,3)=""
^DIC(19,16704,25)="DISP^GMTSXA"
^DIC(19,16704,"U")="DISPLAY 'HEALTH SUMMARY TYPES "
^DIC(19,16705,0)="EHM-01526^Precedence of 'Health Summary Types List'^^R^1^^^^^^^^^^^"
^DIC(19,16705,1,0)="^^18^18^3240328^"
^DIC(19,16705,1,1,0)="Use this option to select the defined Health Summary Types to include"
^DIC(19,16705,1,2,0)="on the list and arrange them in the order (precedence) that they "
^DIC(19,16705,1,3,0)="should appear on the list.  The three most common groups of Health "
^DIC(19,16705,1,4,0)="Summary Types are:"
^DIC(19,16705,1,5,0)=""
^DIC(19,16705,1,6,0)=" SYS  Health Summary Types may be defined for all users on the system."
^DIC(19,16705,1,7,0)=""
^DIC(19,16705,1,8,0)=" USR  Health Summary Types may be defined for a single user on the"
^DIC(19,16705,1,9,0)="      system."
^DIC(19,16705,1,10,0)=""
^DIC(19,16705,1,11,0)=" NAT  Nationally exported Health Summary Types (NAT) defined for "
^DIC(19,16705,1,12,0)="      system users or a single user are treated independently to"
^DIC(19,16705,1,13,0)="      keep them together in the list box."
^DIC(19,16705,1,14,0)=""
^DIC(19,16705,1,15,0)="In this option, you must first select those Health Summary Type groups"
^DIC(19,16705,1,16,0)="(SYS, USR, NAT, etc.) to include on the Reports Tab, then specify the"
^DIC(19,16705,1,17,0)="order in which they will appear on the Reports Tab."
^DIC(19,16705,1,18,0)="Cloned from ""GMTS GUI HS LIST PRECEDENCE"" option."
^DIC(19,16705,3)=""
^DIC(19,16705,25)="PREC^GMTSXA"
^DIC(19,16705,"U")="PRECEDENCE OF 'HEALTH SUMMARY "
^DIC(19,16706,0)="EHM-01527^Method of compiling 'Health Summary Types List'^^R^1^^^^^^^^^^^"
^DIC(19,16706,1,0)="^19.06^14^14^3240328^^^"
^DIC(19,16706,1,1,0)="Use this option to edit the method used to build the list of Health"
^DIC(19,16706,1,2,0)="Summary Types displayed on the Reports Tab in CPRS.  There are 2 "
^DIC(19,16706,1,3,0)="methods:"
^DIC(19,16706,1,4,0)=""
^DIC(19,16706,1,5,0)="   Overwrite   System-defined Health Summary Types are added "
^DIC(19,16706,1,6,0)="               to the list.  If there are User-defined Health"
^DIC(19,16706,1,7,0)="               Summary Types, then they will replace the System"
^DIC(19,16706,1,8,0)="               defined Health Summary Types already on the list."
^DIC(19,16706,1,9,0)=""
^DIC(19,16706,1,10,0)="   Append      System-defined Health Summary Types are added to"
^DIC(19,16706,1,11,0)="               the list.  If there are User-defined Health Summary"
^DIC(19,16706,1,12,0)="               Types, then they will added to the list along with "
^DIC(19,16706,1,13,0)="               the System-defined types."
^DIC(19,16706,1,14,0)="Cloned from ""GMTS GUI HS LIST METHOD"" option."
^DIC(19,16706,3)=""
^DIC(19,16706,25)="METH^GMTSXA"
^DIC(19,16706,"U")="METHOD OF COMPILING 'HEALTH SU"
^DIC(19,16707,0)="EHM-01528^Edit 'Health Summary Types List' Parameters^^R^1^^^^^^^^^^^"
^DIC(19,16707,1,0)="^^5^5^3240328^"
^DIC(19,16707,1,1,0)="Use this option to add, edit or delete a Health Summary Type from"
^DIC(19,16707,1,2,0)="the list of Health Summary Types defined by the user.  If you are "
^DIC(19,16707,1,3,0)="a holder of the GMTSMGR Key, you can also use this option to edit"
^DIC(19,16707,1,4,0)="the Health Summary Types defined for the System."
^DIC(19,16707,1,5,0)="Cloned from ""GMTS GUI HS LIST PARAMETERS"" option."
^DIC(19,16707,3)=""
^DIC(19,16707,25)="EDIT^GMTSXA"
^DIC(19,16707,"U")="EDIT 'HEALTH SUMMARY TYPES LIS"
^DIC(19,16708,0)="EHM-01529^Print Blank Encounter Form^^A^1^^^^^^y^485^^1^^"
^DIC(19,16708,1,0)="^^3^3^3240328^^^^"
^DIC(19,16708,1,1,0)="This option allows the user to select a clinic, and if an encounter form"
^DIC(19,16708,1,2,0)="is defined for use with an embossed patient card the form will be printed."
^DIC(19,16708,1,3,0)="Cloned from ""IBDF PRINT BLNK ENCOUNTER FORM"" option."
^DIC(19,16708,3)=""
^DIC(19,16708,20)="D MAIN^IBDF1A(0)"
^DIC(19,16708,"U")="PRINT BLANK ENCOUNTER FORM"
^DIC(19,16709,0)="EHM-01530^PCE Table Maintenance^^M^1^^^^^^^507^^^^"
^DIC(19,16709,1,0)="^19.06^10^10^3240328^^^^"
^DIC(19,16709,1,1,0)="The options on this menu are used to manage the clinical terminology"
^DIC(19,16709,1,2,0)="defined in PCE. There are management systems for Education Topics,"
^DIC(19,16709,1,3,0)="Exams, and Health Factors. Immunizations and Skin Tests are standardized"
^DIC(19,16709,1,4,0)="nationally and cannot be edited by sites. National Education Topics,"
^DIC(19,16709,1,5,0)="Exams, and Health Factors cannot be edited by sites."
^DIC(19,16709,1,6,0)="  "
^DIC(19,16709,1,7,0)="The PCE Information Only menu options can be used to list the defined"
^DIC(19,16709,1,8,0)="data types."
^DIC(19,16709,1,9,0)=""
^DIC(19,16709,1,10,0)="Cloned from ""PXTT TABLE MAINTENANCE"" option."
^DIC(19,16709,3)=""
^DIC(19,16709,10,0)="^19.01IP^9^9"
^DIC(19,16709,10,1,0)="16710^INFO^35"
