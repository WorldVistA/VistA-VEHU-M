^DIC(19,13619,0)="ENIT RESP NOT ASSIGNED RPT^Unassigned IT Asset Report^^R^1^^^^^^^33"
^DIC(19,13619,1,0)="^19.06^3^3^3080204^^"
^DIC(19,13619,1,1,0)="Report of tracked IT Assets that are not currently assigned to a "
^DIC(19,13619,1,2,0)="responsible individual.  Assets are considered to be tracked IT assets if"
^DIC(19,13619,1,3,0)="their CMR value has IT TRACKING set to YES."
^DIC(19,13619,25)="ENTIRRNA"
^DIC(19,13619,"U")="UNASSIGNED IT ASSET REPORT"
