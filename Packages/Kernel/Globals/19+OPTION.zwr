^DIC(19,7071,0)="DG CO-PAY TEST VIEW EDITING^View Copay Exemption Test Editing Activity^^A^.5^^^^^^^^^1"
^DIC(19,7071,1,0)="^^6^6^2930201^^^"
^DIC(19,7071,1,1,0)="This option allows the user to view all changes made to a particular co-pay "
^DIC(19,7071,1,2,0)="test for a patient.  Some of the displayed information includes date of "
^DIC(19,7071,1,3,0)="change, user who made change and the type of change.  If a change involves "
^DIC(19,7071,1,4,0)="a change in the co-pay test status, the previous and current values are "
^DIC(19,7071,1,5,0)="displayed.  If a co-pay test is deleted, any associated changes are also "
^DIC(19,7071,1,6,0)="deleted.  "
^DIC(19,7071,20)="D ON^DGMTCOU I Y S DGMTYPT=2 D DIS^DGMTAUD"
^DIC(19,7071,"U")="VIEW COPAY EXEMPTION TEST EDIT"
