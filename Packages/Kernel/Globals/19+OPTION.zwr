^DIC(19,14033,0)="ECX SET MAX LINES^Set Maximum Line Count for Transmission^^R^10000000216^ECXMGR^^^^^^"
^DIC(19,14033,1,0)="^^8^8^2990416^^^"
^DIC(19,14033,1,1,0)="This option allows the DSS Site Manager to set the maximum number"
^DIC(19,14033,1,2,0)="of lines per transmission message for any extract type."
^DIC(19,14033,1,3,0)=" "
^DIC(19,14033,1,4,0)="The default value is 200 lines per message.  Certain extracts,"
^DIC(19,14033,1,5,0)="such as CLI and ADM, are known to require fewer lines per message"
^DIC(19,14033,1,6,0)="(i.e., 100 to 150).  It may be possible to set some extracts to"
^DIC(19,14033,1,7,0)="line counts greater than 200, but caution must be exercised."
^DIC(19,14033,1,8,0)="Messages which are larger than 32 Kbytes will be rejected by AAC."
^DIC(19,14033,25)="SETMAX^ECXUTL2"
^DIC(19,14033,99.1)="57821,64934"
^DIC(19,14033,"U")="SET MAXIMUM LINE COUNT FOR TRA"
