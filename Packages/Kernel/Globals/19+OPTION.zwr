^DIC(19,9015,"U")="VOLUME SET EDIT"
^DIC(19,9016,0)="XU-PING-SERVER^TCP/IP type PING server^^S^1039^^^^^^^"
^DIC(19,9016,1,0)="^^2^2^2920811^"
^DIC(19,9016,1,1,0)="This is a PING server that works like PING under TCP/IP.  If"
^DIC(19,9016,1,2,0)=" you send a message to this server it will send it back to you."
^DIC(19,9016,25)="XTSPING"
^DIC(19,9016,220)="^R^^N^Y^E^0"
^DIC(19,9016,"U")="TCP/IP TYPE PING SERVER"
