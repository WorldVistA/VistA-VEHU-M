^DIC(19,12472,0)="PSB BCBU INIT SINGLE PT^Single Patient Init^^R^10000000020^^^^^^^533"
^DIC(19,12472,1,0)="^19.06^2^2^3030808^^"
^DIC(19,12472,1,1,0)="This option will send inpatient orders to the BCMA Contingency "
^DIC(19,12472,1,2,0)="workstation for a single patient."
^DIC(19,12472,25)="SNDPT^ALPBIND"
^DIC(19,12472,"U")="SINGLE PATIENT INIT"
^DIC(19,12473,0)="PSB BCBU PMU MESSAGE BUILDER^Build a PMU B01/B02 Message^^A^10000000020^^^^^^^533^^1"
^DIC(19,12473,1,0)="^19.06^8^8^3030808^^"
^DIC(19,12473,1,1,0)="This is a subscriber to the Kernel options, XU USER ADD, XU USER "
^DIC(19,12473,1,2,0)="TERMINATE, AND XU USER CHANGE for generating an HL7 PMU message for the "
^DIC(19,12473,1,3,0)="BCMA contingency workstations."
^DIC(19,12473,1,4,0)=" "
^DIC(19,12473,1,5,0)="If the event was to Add or Create a New Person File entry, a B01 message"
^DIC(19,12473,1,6,0)="is generated. If the action was an edit of an existing entry, such as"
^DIC(19,12473,1,7,0)="changing access/verify codes, termination or disuser/nodisuser, a B02 "
^DIC(19,12473,1,8,0)="message is generated."
^DIC(19,12473,20)="I $D(XUIEN),$D(XUSR) D HL7^ALPBGEN(XUIEN,XUFLG,.XUSR) K HL,XUSR,XUNAME"
^DIC(19,12473,"U")="BUILD A PMU B01/B02 MESSAGE"
^DIC(19,12474,0)="PSB BCBU PRINT BLK MAR^Print Blank Mar for Selected Patient^^R^10000000020^^^^^^^533"
^DIC(19,12474,1,0)="^19.06^2^2^3030808^^"
^DIC(19,12474,1,1,0)="This option allows the user to select a patient from the BCMA contingecy"
^DIC(19,12474,1,2,0)="and print a blank 3 or 7 day MAR. The MAR will only contain patient info."
^DIC(19,12474,25)="ALPBBK"
^DIC(19,12474,"U")="PRINT BLANK MAR FOR SELECTED P"
^DIC(19,12476,0)="GMRA FREE TEXT UTILITY^Allergy clean up utility^^R^10000000020^^^^^^^"
^DIC(19,12476,1,0)="^^4^4^3060321^"
^DIC(19,12476,1,1,0)="This utility will identify either free text reactants, ingredient based "
^DIC(19,12476,1,2,0)="reactants or drug class based reactants.  The user will then be allowed "
^DIC(19,12476,1,3,0)="to either update the reactant to a more appropriate choice or they can "
^DIC(19,12476,1,4,0)="mark it as entered in error."
^DIC(19,12476,25)="GMRAFX"
^DIC(19,12476,"U")="ALLERGY CLEAN UP UTILITY"
^DIC(19,12490,0)="PSO TPB PATIENT RX REPORT^Report of Patients with TPB and Non-TPB Rx's^PLACED OUT OF ORDER BY PSO*7*227^A^10000000020^^^^^^^^^1"
^DIC(19,12490,20)="D EN^PSOTPRP1"
^DIC(19,12490,"U")="REPORT OF PATIENTS WITH TPB AN"
^DIC(19,12491,0)="DG CLEANUP INCOME TEST DUPES^Purge Duplicate Income Tests^^R^10000000020^^^^^^^"
^DIC(19,12491,1,0)="^19.06^4^4^3031103^^"
^DIC(19,12491,1,1,0)="This option will allow the authorized user to run the cleanup utility."
^DIC(19,12491,1,2,0)="This utility purges duplicate tests that appear on the same day.  It will"
^DIC(19,12491,1,3,0)="leave one valid test per day.  This utility will also delete ""BAD"""
^DIC(19,12491,1,4,0)="tests.  Theses ""BAD"" tests are defined as ones that have a null status."
^DIC(19,12491,25)="EN^DG53558"
^DIC(19,12491,"U")="PURGE DUPLICATE INCOME TESTS"
^DIC(19,12492,0)="DG CLEANUP INCOME TEST MONITOR^Purge Income Test Monitor^^R^10000000020^^^^^^^"
^DIC(19,12492,1,0)="^^4^4^3031103^"
^DIC(19,12492,1,1,0)="This option will monitor the cleanup process previously selected.  If "
^DIC(19,12492,1,2,0)="the process has been stopped, then it may be resumed where it left off.  "
^DIC(19,12492,1,3,0)="If the process has run to Completion, then re-running the Purge option, "
^DIC(19,12492,1,4,0)="will kill the XTMP work file, and start over."
^DIC(19,12492,25)="MONITOR^DG53558M"
^DIC(19,12492,"U")="PURGE INCOME TEST MONITOR"
^DIC(19,12495,0)="PSNDELTE^Delete Patient Medication Information Sheet Data^^R^10000000020^^^^^^^136^^"
^DIC(19,12495,1,0)="^19.06^2^2^3031008^^"
^DIC(19,12495,1,1,0)="This option is a standalone option ONLY TO BE USED when installing Patient"
^DIC(19,12495,1,2,0)="Medication Information Sheets (PMI) data."
^DIC(19,12495,20)=""
^DIC(19,12495,25)="BEGIN^PSNDELTE"
^DIC(19,12495,"U")="DELETE PATIENT MEDICATION INFO"
^DIC(19,12496,0)="AWCM PURGE CPRS MONITOR DATA^Purge CPRS Monitor Data^^R^10000000020^^^^^^^"
^DIC(19,12496,1,0)="^^2^2^3031226^"
^DIC(19,12496,1,1,0)="This option purges the CPRS monitor data.  It leaves thirty days on file "
^DIC(19,12496,1,2,0)="automatically if no parameter is set up for it."
^DIC(19,12496,25)="AWCMCPUR"
^DIC(19,12496,200.9)="y"
^DIC(19,12496,"U")="PURGE CPRS MONITOR DATA"
^DIC(19,12497,0)="AWCM CPRS MONITOR^Generate CPRS Monitor Web Data^^R^10000000020^^^^^^^"
^DIC(19,12497,1,0)="^19.06^3^3^3030712^^"
^DIC(19,12497,1,1,0)="Generates web data for the CPRS Monitor.  It is suggested that this "
^DIC(19,12497,1,2,0)="option run every 10 minutes because the time increments on the graph are "
^DIC(19,12497,1,3,0)="10 minutes."
^DIC(19,12497,25)="PPAGE^AWCMCPR1"
^DIC(19,12497,"U")="GENERATE CPRS MONITOR WEB DATA"
