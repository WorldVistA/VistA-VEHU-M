^DIC(19,13890,0)="RMPR EDIT 2319 VENDOR/QTY/COST^Edit 2319 (Vendor,QTY,Cost)^^A^10000000020^RMPRSUPERVISOR^^^^^^249^^1"
^DIC(19,13890,1,0)="^^1^1^3081014^"
^DIC(19,13890,1,1,0)="This option will allow limited editing (Vendor,Quantity,Cost) of purchasing and stock issue transactions recorded on a patient's VAF 10-2319."
