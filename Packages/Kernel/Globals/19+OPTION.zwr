^DIC(19,5417,0)="DGPM CHECK-IN^Check-in Lodger^^A^.5^^^^^^^114^^1"
^DIC(19,5417,1,0)="^^4^4^2900905^^"
^DIC(19,5417,1,1,0)="Use this option to check-in a lodger to your facility or to another"
^DIC(19,5417,1,2,0)="facility.  You will be asked the type of check-in (either CHECK-IN or"
^DIC(19,5417,1,3,0)="CHECK-IN (OTHER FACILITY)) as well as the reason for lodging and any"
^DIC(19,5417,1,4,0)="optional comments you may wish to add."
^DIC(19,5417,20)="S DGPMT=4 D PAT^DGPMV"
^DIC(19,5417,"U")="CHECK-IN LODGER"
^DIC(19,5418,0)="DGPM CHECK-OUT^Lodger Check-out^^A^.5^^^^^^^114^^1"
^DIC(19,5418,1,0)="^^3^3^2900905^^^"
^DIC(19,5418,1,1,0)="This option should be used when checking-out a lodger from your facility"
^DIC(19,5418,1,2,0)="or another facility.  You will be asked to enter a disposition for this"
^DIC(19,5418,1,3,0)="patient which can be either 'admit' or 'dismissed'."
^DIC(19,5418,20)="S DGPMT=5 D PAT^DGPMV"
^DIC(19,5418,"U")="LODGER CHECK-OUT"
^DIC(19,5419,0)="DGPM PATIENT MOVEMENT LIST^Patient Movement List^^R^.5^^^^^^^114"
^DIC(19,5419,1,0)="^^5^5^2920715^^^^"
^DIC(19,5419,1,1,0)="This option lists the admissions discharges and transfers that"
^DIC(19,5419,1,2,0)="have taken place up to T-5 to today. The list displays the patients"
^DIC(19,5419,1,3,0)="name, PT ID (SHORT FORM), DATE/TIME OF THE MOVEMENT, the FROM and TO"
^DIC(19,5419,1,4,0)="of the movement. This was an old Dietetics routine renamed in the MAS"
^DIC(19,5419,1,5,0)="namespace."
^DIC(19,5419,25)="DGOPATM"
^DIC(19,5419,"U")="PATIENT MOVEMENT LIST"
^DIC(19,5420,0)="DGPM LODGING REASONS ENTRY^Reasons for Lodging Entry/Edit^^R^.5^^^^^^^114"
^DIC(19,5420,1,0)="^^3^3^2900824^^"
^DIC(19,5420,1,1,0)="This option should be used to add new reasons for lodging.  Examples"
^DIC(19,5420,1,2,0)="include distance too far to travel and lack of transportation.  When"
^DIC(19,5420,1,3,0)="checking in a lodger patient, a reason for lodging will be required."
^DIC(19,5420,25)="REAS^DGPMV35"
^DIC(19,5420,"U")="REASONS FOR LODGING ENTRY/EDIT"
^DIC(19,5421,0)="DGPM EDIT OOS BEDS^Bed Out-of-Service Date Enter/Edit^^R^.5^^^^^^^114"
^DIC(19,5421,1,0)="^^2^2^2900718^^"
^DIC(19,5421,1,1,0)="Use this option to place a bed out-of-service or return a bed to service."
^DIC(19,5421,1,2,0)="An out-of-service bed will be reflected on the G&L."
^DIC(19,5421,25)="BED^DGPMDDOS"
^DIC(19,5421,"U")="BED OUT-OF-SERVICE DATE ENTER/"
^DIC(19,5422,0)="DGPM WARD OOS EDIT^Edit Ward Out-of-Service Dates^^R^.5^^^^^^^114"
^DIC(19,5422,1,0)="^^5^5^2901029^^^"
^DIC(19,5422,1,1,0)="Use this option to place a ward out-of-service or return a ward to service."
^DIC(19,5422,1,2,0)="If you are placing a ward out-of-service indefinately, do not answer the"
^DIC(19,5422,1,3,0)="'RETURN TO SERVICE' prompt.  You will be asked how long you wish to show"
^DIC(19,5422,1,4,0)="statistics for this ward on the G&L.  If you do not answer these questions,"
^DIC(19,5422,1,5,0)="the data will always show on the G&L."
^DIC(19,5422,25)="WARD^DGPMDDOS"
^DIC(19,5422,99)="55614,33513"
^DIC(19,5422,99.1)="59164,31864"
^DIC(19,5422,"U")="EDIT WARD OUT-OF-SERVICE DATES"
^DIC(19,5423,0)="DGPM BED ENTRY/EDIT^Add/Edit Beds^^E^.5^^^^^^^114"
^DIC(19,5423,1,0)="^^5^5^2940624^^^^"
^DIC(19,5423,1,1,0)="Use this option to add a new bed or edit an existing bed.  You will be"
^DIC(19,5423,1,2,0)="asked which ward or wards will be able to assign the bed.  You will NOT"
^DIC(19,5423,1,3,0)="be able to delete a bed, but you will be able to remove all wards from"
^DIC(19,5423,1,4,0)="being able to assign.  To inactivate a bed for a period of time, use the"
^DIC(19,5423,1,5,0)="'Bed Out-of-Service Date Enter/Edit' option."
^DIC(19,5423,30)="DG(405.4,"
^DIC(19,5423,31)="AEMQL"
^DIC(19,5423,50)="DG(405.4,"
^DIC(19,5423,51)="[DGPM BED EDIT]"
^DIC(19,5423,"U")="ADD/EDIT BEDS"
^DIC(19,5424,0)="DGPM CURRENT LODGERS OUTPUT^Current Lodger List^^R^.5^^^^^^^114"
^DIC(19,5424,1,0)="^^2^2^2900824^"
^DIC(19,5424,1,1,0)="This option will list current lodgers for one, many, or all divisions on"
^DIC(19,5424,1,2,0)="one, many, or all wards."
^DIC(19,5424,25)="EN^DGPMOLD"
^DIC(19,5424,99)="55448,39683"
^DIC(19,5424,"U")="CURRENT LODGER LIST"
^DIC(19,5425,0)="DGPM LODGERS FOR DATE RANGE^Lodgers for a Date Range^^R^.5^^^^^^^114"
^DIC(19,5425,1,0)="^^3^3^2900824^"
^DIC(19,5425,1,1,0)="This output will list all lodgers housed between the dates specified."
^DIC(19,5425,1,2,0)="You will be able to choose one, many, or all divisions and one, many, or"
^DIC(19,5425,1,3,0)="all wards."
^DIC(19,5425,25)="EN1^DGPMOLD"
^DIC(19,5425,"U")="LODGERS FOR A DATE RANGE"
^DIC(19,5426,0)="DG ELIG ID FORMAT EDIT^ID Format Enter/Edit^^R^.5^^^^^^^114"
^DIC(19,5426,1,0)="^^23^23^2910510^^^^"
^DIC(19,5426,1,1,0)="This option allows IRM personnel to enter/edit patient"
^DIC(19,5426,1,2,0)="identification formats.  These formats are used to set the"
^DIC(19,5426,1,3,0)="various patient id fields in the PATIENT file, such as"
^DIC(19,5426,1,4,0)="PRIMARY LONG ID and PRIMARY SHORT ID."
^DIC(19,5426,1,5,0)=" "
^DIC(19,5426,1,6,0)="The standard format is the 'VA STANDARD'. This format is the"
^DIC(19,5426,1,7,0)="Social Security Number format.  All eligibility codes in the"
^DIC(19,5426,1,8,0)="ELIGIBILITY CODE file will be associated with this format as"
^DIC(19,5426,1,9,0)="a result of the MAS v5 post-init."
^DIC(19,5426,1,10,0)=" "
^DIC(19,5426,1,11,0)="Whenever the patient's SSN or PRIMARY ELIGIBILITY CODE fields"
^DIC(19,5426,1,12,0)="are updated the 'VA STANDARD' format will be used to set the"
^DIC(19,5426,1,13,0)="ID fields."
^DIC(19,5426,1,14,0)=" "
^DIC(19,5426,1,15,0)="The site should not have to add any other formats nor should"
^DIC(19,5426,1,16,0)="they have to modify the 'VA STANDARD' format."
^DIC(19,5426,1,17,0)=" "
^DIC(19,5426,1,18,0)="The only exception are those sites running the VA/DOD sharing"
^DIC(19,5426,1,19,0)="agreement software being developed by the Dallas ISC."
^DIC(19,5426,1,20,0)=" "
^DIC(19,5426,1,21,0)="If the site feels it needs to add formats or modify the "
^DIC(19,5426,1,22,0)="'VA STANDARD' format, IRM staff should first call their local"
^DIC(19,5426,1,23,0)="support ISC."
^DIC(19,5426,25)="1^VADPT61"
^DIC(19,5426,"U")="ID FORMAT ENTER/EDIT"
^DIC(19,5427,0)="DG ELIG CODE ENTER/EDIT^Eligibility Code Enter/Edit^^R^.5^^^^^^^114"
^DIC(19,5427,1,0)="^^2^2^2950925^^^^"
^DIC(19,5427,1,1,0)="This option allows IRM personnel to enter/edit eligibility codes that"
^DIC(19,5427,1,2,0)="are used at the user's site."
^DIC(19,5427,25)="2^VADPT61"
^DIC(19,5427,"U")="ELIGIBILITY CODE ENTER/EDIT"
^DIC(19,5428,0)="DG ELIG ID FORMAT RESET^Specific ID Format Reset^^R^.5^^^^^^^114"
^DIC(19,5428,1,0)="^^9^9^2910510^^^^"
^DIC(19,5428,1,1,0)="IRM personnel are prompted for an ID format.  Next, all patients that have"
^DIC(19,5428,1,2,0)="eligibility codes that point to this ID format will have their ID's reset."
^DIC(19,5428,1,3,0)=" "
^DIC(19,5428,1,4,0)="The site would use this utility if the 'DEFAULT LONG ID VALUE CODE' field"
^DIC(19,5428,1,5,0)="in the IDENTIFICATION FORMAT file was modified.  This utility allows them"
^DIC(19,5428,1,6,0)="to update their database with the new value."
^DIC(19,5428,1,7,0)=" "
^DIC(19,5428,1,8,0)="This option should be executed during non-peak hours.  When the job has"
^DIC(19,5428,1,9,0)="completed, a Mailman message will be sent to the user."
^DIC(19,5428,25)="3^VADPT60"
^DIC(19,5428,"U")="SPECIFIC ID FORMAT RESET"
^DIC(19,5429,0)="DG ELIG PRI ELIG RESET^Primary Eligibility ID Reset (All Patients)^^R^.5^^^^^^^114"
^DIC(19,5429,1,0)="^^14^14^2910510^^^^"
^DIC(19,5429,1,1,0)="This option will set/reset the id's associated with each"
^DIC(19,5429,1,2,0)="patient's PRIMARY ELIGIBILITY CODE.  This utility is"
^DIC(19,5429,1,3,0)="called by the version 5 conversion clean-up routine."
^DIC(19,5429,1,4,0)=" "
^DIC(19,5429,1,5,0)="It will create the necessary entry in the PATIENT"
^DIC(19,5429,1,6,0)="ELIGIBILITIES multiple corresponding to each patient's PRIMARY "
^DIC(19,5429,1,7,0)="ELIGIBILITY CODE.  It will then update all the ID fields."
^DIC(19,5429,1,8,0)=" "
^DIC(19,5429,1,9,0)="This option can be executed multiple times with no harmful"
^DIC(19,5429,1,10,0)="effects."
^DIC(19,5429,1,11,0)=" "
^DIC(19,5429,1,12,0)="This option should be executed during non-peak hours.  When"
^DIC(19,5429,1,13,0)="the job has completed, a Mailman message will be sent to"
^DIC(19,5429,1,14,0)="the user."
^DIC(19,5429,25)="4^VADPT60"
^DIC(19,5429,"U")="PRIMARY ELIGIBILITY ID RESET ("
^DIC(19,5430,0)="DG ELIG ID RESET^Specific Eligibility ID Reset (All patients)^^R^.5^^^^^^^114"
^DIC(19,5430,1,0)="^^9^9^2910510^^^^"
^DIC(19,5430,1,1,0)="IRM personnel are prompted for an eligibility code.  Next, all patients that"
^DIC(19,5430,1,2,0)="have that eligibility code will have that ID reset."
^DIC(19,5430,1,3,0)=" "
^DIC(19,5430,1,4,0)="The site would use this utility if the 'ID FORMAT' field in the "
^DIC(19,5430,1,5,0)="ELIGIBILITY CODE file was changed.  This utility would allow the site to"
^DIC(19,5430,1,6,0)="update their database with the new values."
^DIC(19,5430,1,7,0)=" "
^DIC(19,5430,1,8,0)="This option should be executed during non-peak hours.  When the job has"
^DIC(19,5430,1,9,0)="completed, a Mailman message will be sent to the user."
^DIC(19,5430,25)="5^VADPT60"
^DIC(19,5430,"U")="SPECIFIC ELIGIBILITY ID RESET "
^DIC(19,5431,0)="DG ELIG RESET PATIENT^Reset All ID's for a Patient^^R^.5^^^^^^^114"
^DIC(19,5431,1,0)="^^5^5^2910510^^^^"
^DIC(19,5431,1,1,0)="The user is prompted for a patient.  Next, the corresponding ID'S for"
^DIC(19,5431,1,2,0)="all the patient's eligibilities are reset."
^DIC(19,5431,1,3,0)=" "
^DIC(19,5431,1,4,0)="This utility can be used, if for some reason, a patient's ID's got"
^DIC(19,5431,1,5,0)="corrupted."
^DIC(19,5431,25)="6^VADPT60"
^DIC(19,5431,"U")="RESET ALL ID'S FOR A PATIENT"
^DIC(19,5432,0)="DG ELIG RESET ALL^Reset ALL ID's for ALL Patients^^R^.5^^^^^^^114"
^DIC(19,5432,1,0)="^^5^5^2910510^^^^"
^DIC(19,5432,1,1,0)="This utility resets all ID's corresponding to each patient's"
^DIC(19,5432,1,2,0)="eligibilities.  This is done for ALL patients."
^DIC(19,5432,1,3,0)=" "
^DIC(19,5432,1,4,0)="This option should be executed during non-peak hours.  When the job has"
^DIC(19,5432,1,5,0)="completed, a Mailman message will be sent to the user."
^DIC(19,5432,25)="7^VADPT60"
^DIC(19,5432,"U")="RESET ALL ID'S FOR ALL PATIENT"
^DIC(19,5433,0)="DG ELIG MAINTENANCE^Eligibility/ID Maintenance Menu^^M^.5^^^^^^^114"
^DIC(19,5433,1,0)="^^16^16^2910510^^"
^DIC(19,5433,1,1,0)="This menu contians utility options that allow the site to"
^DIC(19,5433,1,2,0)="maintain their ELIGIBILITY CODE file and patient ID formats."
^DIC(19,5433,1,3,0)=" "
^DIC(19,5433,1,4,0)="The primary reason for having different ID formats and then"
^DIC(19,5433,1,5,0)="associating them with a eligibilities is to help meet DOD/Sharing"
^DIC(19,5433,1,6,0)="agreement requirements."
^DIC(19,5433,1,7,0)=" "
^DIC(19,5433,1,8,0)="For most sites each eligibility needs to simply be assoicated with the"
^DIC(19,5433,1,9,0)="VA STANDARD format.  This association is first accomplished during"
^DIC(19,5433,1,10,0)="the post-init of MAS v5.  As a result of this post-init,"
^DIC(19,5433,1,11,0)="most site will not require any further action."
^DIC(19,5433,1,12,0)=" "
^DIC(19,5433,1,13,0)="This is an IRM menu and should be used with care."
^DIC(19,5433,1,14,0)="Some options are very cpu intensive and should not be"
^DIC(19,5433,1,15,0)="executed during peak hours."
^DIC(19,5433,1,16,0)=" "
^DIC(19,5433,10,0)="^19.01PI^7^7"
^DIC(19,5433,10,1,0)="5427^"
^DIC(19,5433,10,2,0)="5426^"
^DIC(19,5433,10,3,0)="5428^"
^DIC(19,5433,10,4,0)="5430^"
^DIC(19,5433,10,5,0)="5429^"
^DIC(19,5433,10,6,0)="5432^"
^DIC(19,5433,10,7,0)="5431^"
^DIC(19,5433,10,"B",5426,2)=""
^DIC(19,5433,10,"B",5427,1)=""
^DIC(19,5433,10,"B",5428,3)=""
^DIC(19,5433,10,"B",5429,5)=""
^DIC(19,5433,10,"B",5430,4)=""
^DIC(19,5433,10,"B",5431,7)=""
^DIC(19,5433,10,"B",5432,6)=""
^DIC(19,5433,99)="62195,28623"
^DIC(19,5433,"U")="ELIGIBILITY/ID MAINTENANCE MEN"
^DIC(19,5434,0)="DGPM G&L PARAMETER EDIT^G&L Parameter Edit^^R^.5^DG SUPERVISOR^^^^^^"
^DIC(19,5434,1,0)="^^2^2^2910422^^^^"
^DIC(19,5434,1,1,0)="This option allows the MAS supervisor to edit the parameters"
^DIC(19,5434,1,2,0)="used by the G&L and recalculation routines and options."
^DIC(19,5434,25)="DGPMGL5"
^DIC(19,5434,"U")="G&L PARAMETER EDIT"
^DIC(19,5435,0)="DGBT BENE TRAVEL ACCOUNT^Bene Travel Account file Enter/Edit^Option is no longer available. Please use appropriate claim processing system.^R^10000000020^DGBT SUPERVISOR^^^^^^546"
^DIC(19,5435,1,0)="^^3^3^2931105^^"
^DIC(19,5435,1,1,0)="Allows supervisor to make entries or edits to the account file."
^DIC(19,5435,1,2,0)="Entries/edits should only be made to the file when directed"
^DIC(19,5435,1,3,0)="through a patch."
^DIC(19,5435,25)="NWACT^DGBTEF1"
^DIC(19,5435,"U")="BENE TRAVEL ACCOUNT FILE ENTER"
^DIC(19,5437,0)="SDACS CGATLIST^Computer Generated Appointment Type Listing^^R^.5^^^^^^^^^1"
^DIC(19,5437,1,0)="^^6^6^2910510^^"
^DIC(19,5437,1,1,0)="Listing of visits with 'Computer Generated' Appointment Type."
^DIC(19,5437,1,2,0)="MAS must update to a valid type.  Use 'Edit Computer Generated"
^DIC(19,5437,1,3,0)="Appointment Type' option to update."
^DIC(19,5437,1,4,0)="   "
^DIC(19,5437,1,5,0)="This option is only needed if other packages (such as Radiology 4.0)"
^DIC(19,5437,1,6,0)="capture stop code workload."
^DIC(19,5437,20)="S SDX=""ACG"""
^DIC(19,5437,25)="EN^SDACSCGP"
^DIC(19,5437,"U")="COMPUTER GENERATED APPOINTMENT"
^DIC(19,5438,0)="SDACS CGSCLIST^Stop Code Listing (Computer Generated)^^R^1253^^^^^^^^^1"
^DIC(19,5438,1,0)="^^3^3^2980420^^^^"
^DIC(19,5438,1,1,0)="This option will allow a listing of one/many/all stop codes which"
^DIC(19,5438,1,2,0)="have been added to the Outpatient Encounter file automatically"
^DIC(19,5438,1,3,0)="by other packages via PCE."
^DIC(19,5438,20)="S SDX=""AG"""
^DIC(19,5438,25)="EN^SDACSCGP"
^DIC(19,5438,"U")="STOP CODE LISTING (COMPUTER GE"
^DIC(19,5439,0)="SDACS CGEDIT^Edit Computer Generated Appointment Type^^R^.5^^^^^^^"
^DIC(19,5439,1,0)="^^7^7^2910510^^"
^DIC(19,5439,1,1,0)="Option should be used to edit appointment types which have a value"
^DIC(19,5439,1,2,0)="of 'Computer Generated' to a valid appointment type so that"
^DIC(19,5439,1,3,0)="the clinic will receive credit."
^DIC(19,5439,1,4,0)="   "
^DIC(19,5439,1,5,0)="This option is only needed if other packages (such as Radiology v 4.0)"
^DIC(19,5439,1,6,0)="capture stop code workload.  Refer to the User manual, Volume II,"
^DIC(19,5439,1,7,0)="Appendix, for further documentation."
^DIC(19,5439,25)="EDIT^SDACSCG"
^DIC(19,5439,99)="55670,47103"
^DIC(19,5439,"U")="EDIT COMPUTER GENERATED APPOIN"
^DIC(19,5440,0)="SDACS CGMENU^Computer Generated Menu^^M^1253^^^^^^^"
^DIC(19,5440,1,0)="^^13^13^2980420^^^^"
^DIC(19,5440,1,1,0)="This menu contains options that allow the user to do the following:"
^DIC(19,5440,1,2,0)="       1) identify those 'stop code addition' encounters added by other"
^DIC(19,5440,1,3,0)="          packages to the Outpatient Encounter file"
^DIC(19,5440,1,4,0)=" "
^DIC(19,5440,1,5,0)="       2) identify those encounters added by other packages which still"
^DIC(19,5440,1,6,0)="          have an invalid appointment type of 'Computer Generated' and"
^DIC(19,5440,1,7,0)=" "
^DIC(19,5440,1,8,0)="       3) to resolve the appointment type for encounters with a"
^DIC(19,5440,1,9,0)="          'Computer Generated' appointment type."
^DIC(19,5440,1,10,0)="  "
^DIC(19,5440,1,11,0)="This menu option should be used when a package is installed (such as radiology"
^DIC(19,5440,1,12,0)="and lab) that will automatically capture workload by passing encounter"
^DIC(19,5440,1,13,0)="information to PCE."
^DIC(19,5440,10,0)="^19.01PI^4^4"
^DIC(19,5440,10,1,0)="5437^^1"
^DIC(19,5440,10,2,0)="5439^^2"
^DIC(19,5440,10,3,0)="5438^^4"
^DIC(19,5440,10,4,0)="5924^^3"
^DIC(19,5440,10,"B",5437,1)=""
^DIC(19,5440,10,"B",5438,3)=""
^DIC(19,5440,10,"B",5439,2)=""
^DIC(19,5440,10,"B",5924,4)=""
^DIC(19,5440,99)="57712,54930"
^DIC(19,5440,"U")="COMPUTER GENERATED MENU"
^DIC(19,5442,0)="PRMQ APPROPRIATENESS EDIT MENU^Appropriateness Edit^^M^.5^^^^^^^149"
^DIC(19,5442,1,0)="^^1^1^2900525^^^"
^DIC(19,5442,1,1,0)="Sub-menu to set the edit seperate"
^DIC(19,5442,10,0)="^19.01PI^0^0"
^DIC(19,5442,99)="57692,55974"
^DIC(19,5442,"U")="APPROPRIATENESS EDIT"
^DIC(19,5443,0)="PRMQ DGPM UR EVENT^Utilization Review Patient Movement Event^^X^.5^^^^^^^149^^1"
^DIC(19,5443,1,0)="^^1^1^2900604^^"
^DIC(19,5443,1,1,0)="Option tied to the MAS v5 patient event driver."
^DIC(19,5443,10,0)="^19.01PI^0^0"
^DIC(19,5443,20)="D EN1^PRMQDGPM"
^DIC(19,5443,"U")="UTILIZATION REVIEW PATIENT MOV"
^DIC(19,5444,0)="PSJI AOR^ACtive Order Report by Ward/Drug (IV)^^A^11712^^^^^^^115^^1^1"
^DIC(19,5444,1,0)="^^3^3^2910312^^"
^DIC(19,5444,1,1,0)="  This option allows the user to generate a listing of all active"
^DIC(19,5444,1,2,0)="prescriptions for a specific ward (or all), and for a specific drug (or"
^DIC(19,5444,1,3,0)="all)."
^DIC(19,5444,15)="K D,I10,TN,W42,Y"
^DIC(19,5444,20)="D ^PSIVXU Q:$D(XQUIT)  S XREF=""AIV"" D ^PSIVAOR"
^DIC(19,5444,99)="54199,50332"
^DIC(19,5444,"U")="ACTIVE ORDER REPORT BY WARD/DR"
^DIC(19,5445,0)="PSJI CHANGE^Change to Another IV Room (IV)^^R^11712^^^^^^^115"
^DIC(19,5445,1,0)="^^4^4^2910312^^"
^DIC(19,5445,1,1,0)="  This option allows the user to change from one IV room to another, without"
^DIC(19,5445,1,2,0)="leaving the IV package.  Once a new IV room has been selected, the user is"
^DIC(19,5445,1,3,0)="shown the current IV label and report devices if they are defined in the"
^DIC(19,5445,1,4,0)="site parameters file, or asked to select them if they are not."
^DIC(19,5445,15)=""
^DIC(19,5445,20)=""
^DIC(19,5445,25)="CHA^PSIVXU"
^DIC(19,5445,99)="54200,43142"
^DIC(19,5445,"U")="CHANGE TO ANOTHER IV ROOM (IV)"
^DIC(19,5446,0)="PSJU AP-1^Action Profile #1^^R^1^^^^^^^117^^1^1"
^DIC(19,5446,1,0)="^^3^3^2910312^^^^"
^DIC(19,5446,1,1,0)="  Allows the user to print a profile of patients' active orders for review"
^DIC(19,5446,1,2,0)="by the physician.  Includes places for the physician to mark each order"
^DIC(19,5446,1,3,0)="and sign the profile.  When possible, space is included for new orders."
^DIC(19,5446,15)="K PSJNODIS"
^DIC(19,5446,20)="S PSJNODIS=1"
^DIC(19,5446,25)="PSGAP"
^DIC(19,5446,99.1)="57660,75042"
^DIC(19,5446,"U")="ACTION PROFILE #1"
^DIC(19,5449,0)="PSJU SFEM^Miscellaneous Site Parameters^^R^.5^^^^^^^117"
^DIC(19,5449,1,0)="^^1^1^2910312^^"
^DIC(19,5449,1,1,0)="  Allows the user to edit miscellaneous Inpatient Site parameters."
^DIC(19,5449,25)="ENSFEM^PSGFILD0"
^DIC(19,5449,"U")="MISCELLANEOUS SITE PARAMETERS"
^DIC(19,5452,0)="PSJU DS^AUthorized Absence/Discharge Summary^^R^11712^^^^^^^117"
^DIC(19,5452,1,0)="^^4^4^2910312^^^"
^DIC(19,5452,1,1,0)="  Gives the physician and/or Outpatient Pharmacy a report of the active"
^DIC(19,5452,1,2,0)="medications for a patient about to be discharged or transferred to"
^DIC(19,5452,1,3,0)="Authorized Absence, and allows the physician to mark the appropriate"
^DIC(19,5452,1,4,0)="action deemed necessary for each medication."
^DIC(19,5452,25)="PSGDS"
^DIC(19,5452,"U")="AUTHORIZED ABSENCE/DISCHARGE S"
^DIC(19,5453,0)="PSJU AP-2^Action Profile #2^^R^1^^^^^^^117^^1^1"
^DIC(19,5453,1,0)="^^3^3^2910312^^^^"
^DIC(19,5453,1,1,0)="  Allows the user to print a profile of patients' active orders for review"
^DIC(19,5453,1,2,0)="by the physician.  Includes places for the physician to mark each order"
^DIC(19,5453,1,3,0)="and sign the profile.  When possible, space is included for new orders."
^DIC(19,5453,15)="K PSJNODIS"
^DIC(19,5453,20)="S PSJNODIS=1"
^DIC(19,5453,25)="PSGCAP"
^DIC(19,5453,99)="55626,33425"
^DIC(19,5453,"U")="ACTION PROFILE #2"
^DIC(19,5455,0)="PSJ PR^Inpatient Profile^^R^1^^^^^^^197^^1^1"
^DIC(19,5455,1,0)="^19.06^2^2^3070921^^^^"
^DIC(19,5455,1,1,0)="  This allows the user to print Inpatient Medications orders for selected"
^DIC(19,5455,1,2,0)="patients."
^DIC(19,5455,15)="K DRGN,I1,NF,OD,ON55,PDRG,PSIVAC,PSIVUP,PSJORIFN,UL80,PSJNODIS"
^DIC(19,5455,20)="S PSJNODIS=1"
^DIC(19,5455,25)="PSJPR"
^DIC(19,5455,99)="54808,38719"
