^DIC(19,5331,0)="IB FILER CLEAR PARAMETERS^Clear Integrated Billing Filer Parameters^^R^.5^^^^^^^192"
^DIC(19,5331,1,0)="^^8^8^2940207^^^"
^DIC(19,5331,1,1,0)="This option will clear the IB site parameters to allow the IB filer to"
^DIC(19,5331,1,2,0)="start on its own whenever it needs to.  It will not edit the"
^DIC(19,5331,1,3,0)="field, FILE IN BACKGROUND.  It will only let the filer start when called"
^DIC(19,5331,1,4,0)="if this field is set to yes. "
^DIC(19,5331,1,5,0)=" "
^DIC(19,5331,1,6,0)="This option will be called as a start up job when the CPU is rebooted."
^DIC(19,5331,1,7,0)="It will clear the two IB parameters that prevent the IB filer from"
^DIC(19,5331,1,8,0)="restarting if the CPU crashed while the filer was running."
^DIC(19,5331,15)=""
^DIC(19,5331,20)=""
^DIC(19,5331,25)="CLEAR^IBEFUTL"
^DIC(19,5331,200.9)="s"
^DIC(19,5331,"U")="CLEAR INTEGRATED BILLING FILER"
^DIC(19,5332,0)="IB OUTPUT STATISTICAL REPORT^Statistical Report (IB)^^R^.5^^^^^^^192"
^DIC(19,5332,1,0)="^^6^6^2910311^"
^DIC(19,5332,1,1,0)="This report lists the total number of Integrated Billing actions by"
^DIC(19,5332,1,2,0)="Action type along with the total charge by type for a date range.  The"
^DIC(19,5332,1,3,0)="net totals are also printed.  The net totals are derived by looking at"
^DIC(19,5332,1,4,0)="the last update for a parent even though the update may not be within"
^DIC(19,5332,1,5,0)="the date range.  The net total within a date range can be derived by"
^DIC(19,5332,1,6,0)="the formula ""new+update-cancel"" for any associated action types."
^DIC(19,5332,15)=""
^DIC(19,5332,20)=""
^DIC(19,5332,25)="IBOST"
^DIC(19,5332,"U")="STATISTICAL REPORT (IB)"
