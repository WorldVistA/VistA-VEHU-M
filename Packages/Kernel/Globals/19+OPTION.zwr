^DIC(19,6343,0)="XT-PURGE ERRORS^Clean Error Trap^^R^.5^XUPROGMODE^^^^^^349^^"
^DIC(19,6343,1,0)="^^1^1^2950414^^"
^DIC(19,6343,1,0,"LE")=1
^DIC(19,6343,1,1,0)="This option is available to delete old errors from the error trap."
^DIC(19,6343,25)="XTERPUR"
