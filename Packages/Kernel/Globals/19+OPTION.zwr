^DIC(19,12921,0)="IBCE MRA MANAGEMENT^MRA Management WorkList^^R^10000000020^^^^^^^192"
^DIC(19,12921,1,0)="^19.06^3^3^3030502^^^^"
^DIC(19,12921,1,1,0)="This will be a list manager screen with the option available to print an"
^DIC(19,12921,1,2,0)="associated report. Using the screen, billing staff will be able to follow"
^DIC(19,12921,1,3,0)="up on bills for secondary and tertiary billing for MRA bills."
^DIC(19,12921,25)="EN^IBCECOB"
^DIC(19,12921,"U")="MRA MANAGEMENT WORKLIST"
^DIC(19,12922,0)="IBCEM MRA REPORT PRINT^Print MRA^^R^10000000020^^^^^^^192"
^DIC(19,12922,1,0)="^19.06^4^4^3031017^^^^"
^DIC(19,12922,1,1,0)="This menu option prints the MRA Reports given a Bill Number. Based on the "
^DIC(19,12922,1,2,0)="Bill Type, this report will print either an Institutional Format (Part A) "
^DIC(19,12922,1,3,0)="or a Professional Format (Part B). In addition, if more than one MRA are "
^DIC(19,12922,1,4,0)="associated with the Bill, all MRA's will print."
^DIC(19,12922,25)="ENT^IBCEMRAA"
^DIC(19,12922,"U")="PRINT MRA"
^DIC(19,12923,0)="IBCEM MRA MANAGEMENT MENU^MRA Management Menu^^M^10000000020^^^^^^^192"
^DIC(19,12923,1,0)="^19.06^2^2^3040812^^^^"
^DIC(19,12923,1,1,0)="This menu option holds all EDI Medicare Remittance Advice (MRA) related "
^DIC(19,12923,1,2,0)="options."
