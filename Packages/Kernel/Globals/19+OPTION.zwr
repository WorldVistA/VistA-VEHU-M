^DIC(19,13316,0)="MAGJ E/E CPT MATCHING SET^E/E VistaRad CPT Matching Set^^R^10000000049^^^^^^^530"
^DIC(19,13316,1,0)="^19.06^5^5^3050607^^"
^DIC(19,13316,1,1,0)="Use this option to define a matched Radiology procedure to other procedures of"
^DIC(19,13316,1,2,0)="interest based on grouping of CPT codes, or attributes associated with the CPT"
^DIC(19,13316,1,3,0)="code (Modality, Body Part).  This supports logic in the hanging protocols for"
^DIC(19,13316,1,4,0)="automatically retrieving and displaying prior exams of interest when"
^DIC(19,13316,1,5,0)="interpreting a new exam for a patient."
^DIC(19,13316,10.1)="ECPT"
^DIC(19,13316,25)="EECPT^MAGJMN3"
^DIC(19,13316,"U")="E/E VISTARAD CPT MATCHING SET"
