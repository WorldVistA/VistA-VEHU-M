^DIC(19,12166,10,"B",12165,2)=""
^DIC(19,12166,10,"B",12167,5)=""
^DIC(19,12166,10,"B",12168,4)=""
^DIC(19,12166,10,"B",12171,6)=""
^DIC(19,12166,10,"C",1,1)=""
^DIC(19,12166,10,"C",2,5)=""
^DIC(19,12166,10,"C",3,2)=""
^DIC(19,12166,10,"C",4,4)=""
^DIC(19,12166,10,"C",5,6)=""
^DIC(19,12166,99)="67131,68795"
^DIC(19,12166,"U")="HEALTH SUMMARY OBJECTS MENU"
^DIC(19,12167,0)="GMTS OBJ INQ^Inquire about a Health Summary Object^^R^10000000020^^^^^^^"
^DIC(19,12167,1,0)="^19.06^2^2^3020910^^^^"
^DIC(19,12167,1,1,0)="Display a Health Summary Object from file 142.5, to include "
^DIC(19,12167,1,2,0)="an example of the object."
^DIC(19,12167,25)="INQ^GMTSOBJ"
^DIC(19,12167,"U")="INQUIRE ABOUT A HEALTH SUMMARY"
^DIC(19,12168,0)="GMTS OBJ DELETE^Delete Health Summary Object^^R^10000000020^^^^^^^"
^DIC(19,12168,1,0)="^19.06^3^3^3020910^^"
^DIC(19,12168,1,1,0)="This option is used to delete a Health Summary Object that"
^DIC(19,12168,1,2,0)="you created.  You may not delete Health Summary Objects "
^DIC(19,12168,1,3,0)="created by other people."
^DIC(19,12168,25)="DEL^GMTSOBJ"
^DIC(19,12168,"U")="DELETE HEALTH SUMMARY OBJECT"
^DIC(19,12169,0)="GMTS OBJ EXPORT^Export a Health Summary Object^^R^10000000020^^^^^^^"
^DIC(19,12169,1,0)="^19.06^4^4^3020910^^^"
^DIC(19,12169,1,1,0)="This option will allow a user to export a Health Summary "
^DIC(19,12169,1,2,0)="Object, and its corresponding Health Summary Type to a "
^DIC(19,12169,1,3,0)="Mailman message which can be sent to other accounts/sites"
^DIC(19,12169,1,4,0)="for import."
^DIC(19,12169,25)="EXP^GMTSOBJ"
^DIC(19,12169,"U")="EXPORT A HEALTH SUMMARY OBJECT"
^DIC(19,12170,0)="GMTS OBJ IMPORT/INSTALL^Import/Install a Health Summary Object^^R^10000000020^^^^^^^"
^DIC(19,12170,1,0)="^19.06^10^10^3020910^^^"
^DIC(19,12170,1,1,0)="This option is used to install a Health Summary Object "
^DIC(19,12170,1,2,0)="exported using the GMTS OBJ EXPORT option.  The incoming "
^DIC(19,12170,1,3,0)="Object must first be unpacked from the incoming Mailman "
^DIC(19,12170,1,4,0)="message using Packman utilities.  Then this option is used "
^DIC(19,12170,1,5,0)="to install the object into the Health Summary files.  "
^DIC(19,12170,1,6,0)="If there is a Health Summary Type with the same name as "
^DIC(19,12170,1,7,0)="the Health Summary being imported, then you will be prompted"
^DIC(19,12170,1,8,0)="to either use the existing Health Summary Type, or to "
^DIC(19,12170,1,9,0)="rename the incoming Health Summary Type.  At no time will "
^DIC(19,12170,1,10,0)="an existing Health Summary Type be over written."
^DIC(19,12170,25)="INS^GMTSOBJ"
^DIC(19,12170,"U")="IMPORT/INSTALL A HEALTH SUMMAR"
^DIC(19,12171,0)="GMTS OBJ EXPORT/IMPORT^Export/Import a Health Summary Object^^M^10000000020^^^^^^^"
^DIC(19,12171,1,0)="^19.06^4^4^3020910^^"
^DIC(19,12171,1,1,0)="This menu contains options used to either export a Health"
^DIC(19,12171,1,2,0)="Summary Object to a Mailman message, or import an Health "
^DIC(19,12171,1,3,0)="Summary Object by reading the data unpacked from a Mainman"
^DIC(19,12171,1,4,0)="message using the Packman Utilities."
^DIC(19,12171,10,0)="^19.01IP^2^2"
^DIC(19,12171,10,1,0)="12169^1^1"
^DIC(19,12171,10,2,0)="12170^2^2"
