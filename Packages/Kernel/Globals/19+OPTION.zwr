^DIC(19,8519,0)="PSD STOCK UNIT LIST^Breakdown/Dispensing Unit Report^^R^11595^^^^^^^276"
^DIC(19,8519,1,0)="^^5^5^2930309^"
^DIC(19,8519,1,1,0)="This report provides an alphabetic listing of all active drugs you have"
^DIC(19,8519,1,2,0)="defined in the DRUG ACCOUNTABILITY STATS file (#58.8).  This listing"
^DIC(19,8519,1,3,0)="includes breakdown unit and package size from the DRUG ACCOUNTABILITY"
^DIC(19,8519,1,4,0)="STATS file (#58.8) and dispense unit and price per dispense unit from"
^DIC(19,8519,1,5,0)="the DRUG file (#50)."
^DIC(19,8519,25)="PSDPDU"
^DIC(19,8519,"U")="BREAKDOWN/DISPENSING UNIT REPO"
^DIC(19,8520,0)="PSD TRANSFER VAULT DRUGS^Transfer Drugs between Dispensing Sites^^R^10000000216^^^^^^^276"
^DIC(19,8520,1,0)="^^8^8^2940908^^^^"
^DIC(19,8520,1,1,0)="This option is utilized by RPh's to transfer controlled substances"
^DIC(19,8520,1,2,0)="between dispensing sites.  The inventory balances are updated within"
^DIC(19,8520,1,3,0)="each dispensing site."
^DIC(19,8520,1,4,0)="  "
^DIC(19,8520,1,5,0)="When drugs are being transferred from one dispensing site into"
^DIC(19,8520,1,6,0)="another, a MailMan message will be generated to the pharmacy"
^DIC(19,8520,1,7,0)="supervisor holding the PSDMGR security key, if the receiving dispensing"
^DIC(19,8520,1,8,0)="site does not normally stock that particular drug."
^DIC(19,8520,25)="PSDTRV"
^DIC(19,8520,99)="62088,38882"
^DIC(19,8520,"U")="TRANSFER DRUGS BETWEEN DISPENS"
^DIC(19,8521,0)="PSD PRINT VAULT TRANSFERS^Transfer Drugs between Dispensing Sites Report^^R^11595^^^^^^^276"
^DIC(19,8521,1,0)="^^4^4^2950524^^^^"
^DIC(19,8521,1,1,0)="This report displays all transactions which transferred Controlled"
^DIC(19,8521,1,2,0)="Substances between dispensing sites, for a given period of time. The"
^DIC(19,8521,1,3,0)="transactions list within dispensing site, by drug, the date/time transferred,"
^DIC(19,8521,1,4,0)="quantity transferred, and pharmacist transferring the drug."
^DIC(19,8521,25)="PSDTRVR"
^DIC(19,8521,"U")="TRANSFER DRUGS BETWEEN DISPENS"
^DIC(19,8522,0)="PSD CORRECT STATUS^Correct Order Status - GS Ready for Pickup^^R^11595^^^^^^^276"
^DIC(19,8522,1,0)="^^8^8^2930524^^"
^DIC(19,8522,1,1,0)="This option allows the pharmacy supervisor access to correct the"
^DIC(19,8522,1,2,0)="order status of certain CS orders.  Sometimes nursing may erroneously"
^DIC(19,8522,1,3,0)="flag a Green Sheet ready for pharmacy pickup.  Using this option, the"
^DIC(19,8522,1,4,0)="pharmacy supervisor may change the Green Sheet order status from"
^DIC(19,8522,1,5,0)="COMPLETED - GREEN SHEET READY FOR PICKUP to DELIVERED - ACTIVELY ON"
^DIC(19,8522,1,6,0)="NAOU to correct this problem.  An entry in the CS CORRECTION LOG"
^DIC(19,8522,1,7,0)="file (#58.87) will be created to log a history of all corrective"
^DIC(19,8522,1,8,0)="actions."
^DIC(19,8522,25)="EN1^PSDCOR"
^DIC(19,8522,"U")="CORRECT ORDER STATUS - GS READ"
^DIC(19,8523,0)="PSD CORRECT EXISTING GS^Existing Green Sheets Correction^^R^11595^^^^^^^276"
^DIC(19,8523,1,0)="^^9^9^2930727^^^"
^DIC(19,8523,1,1,0)="This option allows the pharmacy supervisor access to make corrective"
^DIC(19,8523,1,2,0)="actions on Controlled Substances orders.  The CS software allows"
^DIC(19,8523,1,3,0)="pharmacy to add existing Green Sheets active orders on an NAOU at"
^DIC(19,8523,1,4,0)="package setup.  These orders may be tracked using the CS software."
^DIC(19,8523,1,5,0)="Sometimes one of these existing Green Sheets may be incorrectly"
^DIC(19,8523,1,6,0)="entered in the software.  Using this option, the pharmacy supervisor"
^DIC(19,8523,1,7,0)="may delete this erroneous existing Green Sheet.  An entry in the"
^DIC(19,8523,1,8,0)="CS CORRECTION LOG file (#58.87) will be created to log a history"
^DIC(19,8523,1,9,0)="of all corrective actions."
^DIC(19,8523,25)="EN2^PSDCOR"
^DIC(19,8523,"U")="EXISTING GREEN SHEETS CORRECTI"
^DIC(19,8524,0)="PSD DESTROY DEA41^DEA Form 41 Destroyed Drugs Report^^R^10000000216^^^^^^^276"
^DIC(19,8524,1,0)="^^2^2^2930727^^"
^DIC(19,8524,1,1,0)="This report lists information on destroyed Controlled Substances that"
^DIC(19,8524,1,2,0)="is required in completing the DEA Form 41."
^DIC(19,8524,25)="PSDEA41"
^DIC(19,8524,"U")="DEA FORM 41 DESTROYED DRUGS RE"
^DIC(19,8525,0)="PSD DEST DRUGS REPORT^Destroyed Drugs Report^^R^10000000216^^^^^^^276"
^DIC(19,8525,1,0)="^19.06^6^6^3101122^^^"
^DIC(19,8525,1,1,0)="This report lists, alphabetically by drug, all destroyed controlled"
^DIC(19,8525,1,2,0)="substances, within a narcotic dispensing site, for a given period of time."
^DIC(19,8525,1,3,0)="Pharmacy supervisor certifying the destruction, quantity destroyed, and"
^DIC(19,8525,1,4,0)="date destroyed are also included on this report. The report may be"
^DIC(19,8525,1,5,0)="generated for a single drug, several drugs, or ALL drugs stocked within"
^DIC(19,8525,1,6,0)="a specific dispensing site."
^DIC(19,8525,25)="PSDESTP"
^DIC(19,8525,99)="56917,58509"
^DIC(19,8525,"U")="DESTROYED DRUGS REPORT"
^DIC(19,8526,0)="PSD CORRECT GS STATUS^Error on Completed Green Sheets^^R^11595^^^^^^^276"
^DIC(19,8526,1,0)="^^4^4^2930522^"
^DIC(19,8526,1,1,0)="This option allows the Pharmacy Supervisor to correct the completed"
^DIC(19,8526,1,2,0)="status of a Green Sheet from COMPLETED - REVIEWED to COMPLETED -"
^DIC(19,8526,1,3,0)="PENDING PROBLEM RESOLUTION.  An entry in the CS CORRECTION LOG"
^DIC(19,8526,1,4,0)="file (#58.87) will be created to track this error."
^DIC(19,8526,25)="EN3^PSDCOR"
^DIC(19,8526,"U")="ERROR ON COMPLETED GREEN SHEET"
^DIC(19,8527,0)="PSD INFUSION O/E^Infusion Order Entry^^R^11595^^^^^^^276"
^DIC(19,8527,1,0)="^^4^4^2940913^^^"
