^DIC(19,3557,0)="PRCAC TR WAIVED^Waive an Accounts Receivable^^M^.5^^^^^^^"
^DIC(19,3557,1,0)="^^6^6^2880817^^^^"
^DIC(19,3557,1,1,0)="This option is used to waive an accounts receivable. There are two types of"
^DIC(19,3557,1,2,0)="waiver transactions - Waived in full and Waived in part."
^DIC(19,3557,1,3,0)="In case of waived in full, the current status of the accounts will be"
^DIC(19,3557,1,4,0)="changed to inactive."
^DIC(19,3557,1,5,0)="In the case of a partial waiver, the amount will be"
^DIC(19,3557,1,6,0)="applied to the principal balance."
^DIC(19,3557,10,0)="^19.01PI^2^2"
^DIC(19,3557,10,1,0)="3618^^1"
^DIC(19,3557,10,2,0)="3619^^2"
