^DIC(19,16381,10,"B",16385,4)=""
^DIC(19,16381,10,"B",16386,5)=""
^DIC(19,16381,10,"B",16387,6)=""
^DIC(19,16381,10,"C",1,1)=""
^DIC(19,16381,10,"C",2,3)=""
^DIC(19,16381,10,"C",3,6)=""
^DIC(19,16381,10,"C",4,4)=""
^DIC(19,16381,10,"C",5,2)=""
^DIC(19,16381,10,"C",6,5)=""
^DIC(19,16381,25)=""
^DIC(19,16381,99)="67411,49177"
^DIC(19,16381,"U")="PRINT HEALTH SUMMARY MENU"
^DIC(19,16382,0)="EHM-01203^Patient Health Summary^^R^1^^^^^^^160^^1^^"
^DIC(19,16382,1,0)="^^3^3^3240328^^^^"
^DIC(19,16382,1,1,0)="Generates a Health Summary of a specified pre-defined Health Summary Type"
^DIC(19,16382,1,2,0)="for a specified patient."
^DIC(19,16382,1,3,0)="Cloned from ""GMTS HS BY PATIENT"" option."
^DIC(19,16382,2)="y"
^DIC(19,16382,3)=""
^DIC(19,16382,20)="K ORVP"
^DIC(19,16382,25)="GMTS"
^DIC(19,16382,72)="W @IOF"
^DIC(19,16382,99)="54858,49206"
^DIC(19,16382,"U")="PATIENT HEALTH SUMMARY"
^DIC(19,16383,0)="EHM-01204^Hospital Location Health Summary^^R^1^^^^^n^^160^^^^"
^DIC(19,16383,1,0)="^^5^5^3240328^"
^DIC(19,16383,1,1,0)="Allows user to print health summaries interactively for all patients on a"
^DIC(19,16383,1,2,0)="specified ward(s), for all patients with appointments at a specified"
^DIC(19,16383,1,3,0)="outpatient clinic(s), or for all patients scheduled for a specified"
^DIC(19,16383,1,4,0)="operating room(s) on a selected day or range of days."
^DIC(19,16383,1,5,0)="Cloned from ""GMTS HS BY LOC"" option."
^DIC(19,16383,2)="y"
^DIC(19,16383,3)=""
^DIC(19,16383,25)="MAIN^GMTSPD"
^DIC(19,16383,99)="55425,54053"
^DIC(19,16383,"U")="HOSPITAL LOCATION HEALTH SUMMA"
^DIC(19,16384,0)="EHM-01205^Ad Hoc Health Summary^^R^1^^^^^^^160^^1^^"
^DIC(19,16384,1,0)="^^6^6^3240328^"
^DIC(19,16384,1,1,0)="Generates an 'Ad Hoc' Health Summary for specified patients. Instead of"
^DIC(19,16384,1,2,0)="selecting a pre-defined Health Summary Type, the user defines his own ad"
^DIC(19,16384,1,3,0)="hoc Health Summary structure for temporary use while using this option."
^DIC(19,16384,1,4,0)="The user selects Health Summary components, time and occurrence limits"
^DIC(19,16384,1,5,0)="when applicable, and selection items when applicable."
^DIC(19,16384,1,6,0)="Cloned from ""GMTS HS ADHOC"" option."
^DIC(19,16384,3)=""
^DIC(19,16384,20)="K ORVP"
^DIC(19,16384,25)="GMTSADH"
^DIC(19,16384,99)="55626,36491"
^DIC(19,16384,"U")="AD HOC HEALTH SUMMARY"
^DIC(19,16385,0)="EHM-01206^Visit Patient Health Summary^^R^1^^^^^^^160^^1^1^"
^DIC(19,16385,1,0)="^^9^9^3240328^^"
^DIC(19,16385,1,1,0)="Generates Health Summaries of a specified pre-defined Health Summary Type"
^DIC(19,16385,1,2,0)="for multiple patients. After a patient is selected, the user can pick an"
^DIC(19,16385,1,3,0)="outpatient visit (based on the VISIT File) or an inpatient hospital"
^DIC(19,16385,1,4,0)="admission (based on the Patient Movement file). If the Patient Care"
^DIC(19,16385,1,5,0)="Encounter (PCE) package isn't installed then the user can only choose an"
^DIC(19,16385,1,6,0)="inpatient visit. Data for summaries is based on a date range from the"
^DIC(19,16385,1,7,0)="outpatient visit or inpatient admission. This Date Range overrides Time"
^DIC(19,16385,1,8,0)="Limits for components which allows this option."
^DIC(19,16385,1,9,0)="Cloned from ""GMTS HS BY PATIENT & VISIT"" option."
^DIC(19,16385,3)=""
^DIC(19,16385,15)="K GMTSPXGO"
^DIC(19,16385,20)="K ORVP S GMTSPXGO=1"
^DIC(19,16385,25)="GMTS"
^DIC(19,16385,"U")="VISIT PATIENT HEALTH SUMMARY"
^DIC(19,16386,0)="EHM-01207^Batch Print of All Clinics by Visit Date^^R^1^^^^^^^160^^^^"
^DIC(19,16386,1,0)="^^9^9^3240328^"
^DIC(19,16386,1,1,0)="Allows user to interactively designate the batch print of all health"
^DIC(19,16386,1,2,0)="summaries for patients with appointments at all outpatient clinics on a"
^DIC(19,16386,1,3,0)="selected day. Summaries will be printed at the print device designated for"
^DIC(19,16386,1,4,0)="that clinic in the Location Parameters. This option is an alternate method"
^DIC(19,16386,1,5,0)="to designate when summaries should be printed for all clinics. The nightly"
^DIC(19,16386,1,6,0)="batch job that prints summaries for wards, clinics and operating rooms"
^DIC(19,16386,1,7,0)="probably should be disable if the user wants to uses this option on a"
^DIC(19,16386,1,8,0)="daily basis."
^DIC(19,16386,1,9,0)="Cloned from ""GMTS HS FOR ALL CLINICS"" option."
^DIC(19,16386,3)=""
^DIC(19,16386,25)="MAIN^GMTSPCD"
^DIC(19,16386,"U")="BATCH PRINT OF ALL CLINICS BY "
^DIC(19,16387,0)="EHM-01208^Range of Dates Patient Health Summary^^R^1^^^^^^^160^^1^1^"
^DIC(19,16387,1,0)="^^6^6^3240328^^^^"
^DIC(19,16387,1,1,0)="Generates Health Summaries of a specified pre-defined Health"
^DIC(19,16387,1,2,0)="Summary Type for multiple patients. After patients are selected."
^DIC(19,16387,1,3,0)="the user can pick a date range. Data for summaries is based on"
^DIC(19,16387,1,4,0)="the date range. This date range overrides Time Limits for"
^DIC(19,16387,1,5,0)="components which allow this option."
^DIC(19,16387,1,6,0)="Cloned from ""GMTS HS BY PATIENT & DATE RANG"" option."
^DIC(19,16387,3)=""
^DIC(19,16387,15)="K GMRANGE"
^DIC(19,16387,20)="K ORVP S GMRANGE=1"
^DIC(19,16387,25)="GMTS"
^DIC(19,16387,"U")="RANGE OF DATES PATIENT HEALTH "
^DIC(19,16388,0)="EHM-01209^Delete Health Summary Type^^E^1^^^^^^^160^^1^1^"
^DIC(19,16388,1,0)="^19.06^9^9^3240328^^^^"
^DIC(19,16388,1,1,0)="This option allows the owner of a Health Summary Type to delete"
^DIC(19,16388,1,2,0)="it. In addition anyone who holds the GMTSMGR key may use this "
^DIC(19,16388,1,3,0)="option. Also, if a Health Summary Type has a lock, anyone who "
^DIC(19,16388,1,4,0)="holds a key with that lock value may delete that Health Summary"
^DIC(19,16388,1,5,0)="Type.  This Option will not allow the deletion of a Health Summary"
^DIC(19,16388,1,6,0)="Type in use by a Health Summary Object.  It will not allow the "
^DIC(19,16388,1,7,0)="deletion of special case Health Summary Types such as GMTS HS "
^DIC(19,16388,1,8,0)="ADHOC OPTION, or REMOTE Health Summary Types."
^DIC(19,16388,1,9,0)="Cloned from ""GMTS TYPE DELETE"" option."
^DIC(19,16388,3)=""
^DIC(19,16388,15)="K %,GMTSMGR"
^DIC(19,16388,20)="K DA,DIC,DIE,DIK,DR"
^DIC(19,16388,30)="GMT(142,"
^DIC(19,16388,31)="AEMQ"
^DIC(19,16388,32)="Select Health Summary Type:"
^DIC(19,16388,34)="I +($$DHST^GMTSULT(+($G(Y))))"
^DIC(19,16388,50)="GMT(142,"
^DIC(19,16388,51)="[GMTS DELETE HLTH SUM TYPE]"
^DIC(19,16388,"U")="DELETE HEALTH SUMMARY TYPE"
^DIC(19,16389,0)="EHM-01210^Create/Modify Health Summary Type^^R^1^^^^^^^^^1^^"
^DIC(19,16389,1,0)="^^10^10^3240328^"
^DIC(19,16389,1,1,0)="This option allows the user to create or modify a Health Summary Type. New"
^DIC(19,16389,1,2,0)="types created under this option will automatically define the creator as"
^DIC(19,16389,1,3,0)="the owner unless creator holds the GMTSMGR security key in which case"
^DIC(19,16389,1,4,0)="GMTSMGR-holder may designate owner of his choice. Normally Health Summary"
^DIC(19,16389,1,5,0)="Types may be modified only by their owner. Exceptions are: someone who"
^DIC(19,16389,1,6,0)="holds the GMTSMGR key may modify any Health Summary Type. If a Health"
^DIC(19,16389,1,7,0)="Summary Type has a lock, someone who holds a security key with that lock"
^DIC(19,16389,1,8,0)="value may modify that Health Summary Type. Use the 'Delete Health Summary"
^DIC(19,16389,1,9,0)="Type' option to delete the Health Summary Type."
^DIC(19,16389,1,10,0)="Cloned from ""GMTS TYPE ENTER/EDIT"" option."
^DIC(19,16389,3)=""
^DIC(19,16389,15)=""
^DIC(19,16389,20)="K DA,DIC,DIE,DR"
^DIC(19,16389,25)="GMTSRM"
^DIC(19,16389,30)=""
^DIC(19,16389,31)=""
^DIC(19,16389,50)=""
^DIC(19,16389,51)=""
^DIC(19,16389,"U")="CREATE/MODIFY HEALTH SUMMARY T"
