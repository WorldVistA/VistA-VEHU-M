^DIC(19,16248,0)="EHM-01069^Record Flag Manual Query^^R^1^^^^^^^114^^^^"
^DIC(19,16248,1,0)="^^9^9^3240328^"
^DIC(19,16248,1,1,0)="This option allows a user to query a selected treating facility for"
^DIC(19,16248,1,2,0)="existing Category I Patient Record Flag (PRF) assignments for a selected"
^DIC(19,16248,1,3,0)="patient.  Any Category I PRF assignment returned by the query that does"
^DIC(19,16248,1,4,0)="not exist at the local facility will automatically be added at the local"
^DIC(19,16248,1,5,0)="facility.  A List Manager user interface will display a list of all"
^DIC(19,16248,1,6,0)="Category I PRF assignments found at the queried treating facility.  The"
^DIC(19,16248,1,7,0)="following action is provided within the List Manager interface:"
^DIC(19,16248,1,8,0)="  - Display the query details for a selected assignment."
^DIC(19,16248,1,9,0)="Cloned from ""DGPF MANUAL QUERY"" option."
^DIC(19,16248,3)=""
^DIC(19,16248,20)=""
^DIC(19,16248,25)="EN^DGPFHLUQ"
^DIC(19,16248,99.1)="60275,49582"
^DIC(19,16248,"U")="RECORD FLAG MANUAL QUERY"
^DIC(19,16249,0)="EHM-01070^Record Flag Transfer Requests^^R^1^^^^^^^114^^^^"
^DIC(19,16249,1,0)="^^4^4^3240328^"
^DIC(19,16249,1,1,0)="This option provides a List Manager screen for viewing patient record "
^DIC(19,16249,1,2,0)="flag ownership transfer requests. In addition to that, it provides the "
^DIC(19,16249,1,3,0)="ability to review and approve / reject any pending transfer requests."
^DIC(19,16249,1,4,0)="Cloned from ""DGPF PRF TRANSFER REQUESTS"" option."
^DIC(19,16249,3)=""
^DIC(19,16249,25)="EN^DGPFTR"
^DIC(19,16249,"U")="RECORD FLAG TRANSFER REQUESTS"
^DIC(19,16250,0)="EHM-01071^PCE IRM Main Menu^^M^1^^^^^^^507^^^^"
^DIC(19,16250,1,0)="^^3^3^3240328^^"
^DIC(19,16250,1,1,0)="This menu is the main menu for IRM staff. This menu contains all of the "
^DIC(19,16250,1,2,0)="menu's and unique options distributed with PCE."
^DIC(19,16250,1,3,0)="Cloned from ""PX IRM MAIN MENU"" option."
