^DIC(19,6735,1,0)="^^2^2^2950426^^^^"
^DIC(19,6735,1,1,0)="Use this option to complete a Controlled Substance Administration"
^DIC(19,6735,1,2,0)="Record (VA FORM 10-2638).  "
^DIC(19,6735,25)="PSDNCGS"
^DIC(19,6735,"U")="COMPLETE A GREEN SHEET - READY"
^DIC(19,6736,0)="PSD PRINT GS PICKUP^Green Sheet Ready for Pickup Log^^R^10000000216^^^^^^^276"
^DIC(19,6736,1,0)="^^5^5^2920525^"
^DIC(19,6736,1,1,0)="This report lists all Green Sheets ready on the wards to be picked up"
^DIC(19,6736,1,2,0)="by pharmacy.  This report requires a signature of the pharmacy employee"
^DIC(19,6736,1,3,0)="picking up the Green Sheet and a signature of the nurse releasing"
^DIC(19,6736,1,4,0)="the Green Sheet.  This document will be retained on the ward for nursing's"
^DIC(19,6736,1,5,0)="records."
^DIC(19,6736,25)="PSDPUGS"
^DIC(19,6736,"U")="GREEN SHEET READY FOR PICKUP L"
^DIC(19,6737,0)="PSD PEND NAOU ORDERS^Pending CS Orders Report for an NAOU^^R^11595^^^^^^^276"
^DIC(19,6737,1,0)="^^2^2^2950426^^^^"
^DIC(19,6737,1,1,0)="Use this option to list all pending CS orders.  This report may"
^DIC(19,6737,1,2,0)="be generated for a single drug or ALL drugs within the NAOU."
^DIC(19,6737,25)="PSDORSN"
^DIC(19,6737,"U")="PENDING CS ORDERS REPORT FOR A"
^DIC(19,6738,0)="PSD PEND VAULT ORDERS^Pending CS Orders by Dispensing Site^^R^11595^^^^^^^276"
^DIC(19,6738,1,0)="^^2^2^2940913^^^^"
^DIC(19,6738,1,1,0)="Pharmacy uses this option to list all pending Controlled Substances orders"
^DIC(19,6738,1,2,0)="for a specific dispensing site."
