^DIC(19,12249,1,0)="^19.06^4^4^3010515^^^^"
^DIC(19,12249,1,1,0)="This option allows for the display of a list of words or phrases"
^DIC(19,12249,1,2,0)="that if found in the text of an informational status message, will "
^DIC(19,12249,1,3,0)="either always require the message to be reviewed or will auto-file"
^DIC(19,12249,1,4,0)="the message and flag it as not needing a review."
^DIC(19,12249,25)="EN^IBCEM4"
^DIC(19,12249,"U")="EDI MESSAGE TEXT TO SCREEN MAI"
^DIC(19,12250,0)="IBCEM MESSAGES WITHOUT REVIEW^EDI Messages Not Reviewed Report^^R^10000000020^^^^^^^192"
^DIC(19,12250,1,0)="^19.06^6^6^3010613^^^^"
^DIC(19,12250,1,1,0)="This option allows for the display of all EDI return messages that were"
^DIC(19,12250,1,2,0)="filed without needing a review based on the text entries in the message"
^DIC(19,12250,1,3,0)="screen text file (#361.3).  The report can be run for a user-selected"
^DIC(19,12250,1,4,0)="date range on date the message was received at the site and may be"
^DIC(19,12250,1,5,0)="sorted by message text that caused the message to not need a review or"
^DIC(19,12250,1,6,0)="by bill #."
