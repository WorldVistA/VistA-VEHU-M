^DIC(19,9639,0)="ENFAR5^Voucher Summary for Station^^R^.5^^^^^^^33"
^DIC(19,9639,1,0)="^^6^6^2951114^"
^DIC(19,9639,1,1,0)="This option generates a voucher summary report for a specified station and"
^DIC(19,9639,1,2,0)="accounting period. The data is obtained from FAP documents which have an"
^DIC(19,9639,1,3,0)="impact on dollars for a Fund and Standard General Ledger. The ouput can be"
^DIC(19,9639,1,4,0)="used to reconcile FAP transactions with FMS transactions. The Inventory"
^DIC(19,9639,1,5,0)="Report (Report ID: RGLLIAV) from FMS is the anticipated source of"
^DIC(19,9639,1,6,0)="information on FMS transactions."
^DIC(19,9639,25)="ENFAR5"
^DIC(19,9639,"U")="VOUCHER SUMMARY FOR STATION"
