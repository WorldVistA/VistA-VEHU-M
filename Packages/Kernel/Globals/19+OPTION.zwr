^DIC(19,11513,1,0)="^^2^2^3000313^"
^DIC(19,11513,1,1,0)="This menu allows maintenance of the parameters used by CPRS for reminder"
^DIC(19,11513,1,2,0)="term processing."
^DIC(19,11513,10,0)="^19.01IP^7^7"
