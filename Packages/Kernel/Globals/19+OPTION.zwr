^DIC(19,11836,"U")="NON-SS ORDER BUILDER"
^DIC(19,11837,0)="PRCP UPDATE SUPPLY STA ITEMS^Supply Station Item Update^^R^11740^^^^^^^"
^DIC(19,11837,1,0)="^^5^5^3010125^"
^DIC(19,11837,1,1,0)="This option will build transactions for supply station secondaries, that"
^DIC(19,11837,1,2,0)="will be sent to its associated supply station.  Transactions will be"
^DIC(19,11837,1,3,0)="created for all items in the selected inventory point whose normal stock"
^DIC(19,11837,1,4,0)="level is greater than zero.  All transactions will be flagged as either"
^DIC(19,11837,1,5,0)="item adds or item edits, as specified by the user of this option."
^DIC(19,11837,25)="INIT^PRCPHLFM"
