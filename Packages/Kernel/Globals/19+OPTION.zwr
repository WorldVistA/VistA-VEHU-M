^DIC(19,112,10,0)="^19.01IP^0^0"
^DIC(19,112,25)="%RD"
^DIC(19,112,"U")="ROUTINE DIRECTORY"
^DIC(19,113,0)="XMSCRIPTRES^Resume processing a script^^R^11748^^^^^^^54"
^DIC(19,113,1,0)="^19.06^2^2^3020312^^^"
^DIC(19,113,1,1,0)="This option allows the user to resume the interpretation of a script,"
^DIC(19,113,1,2,0)="with manual intervention."
^DIC(19,113,25)="RESUME^XMC1"
^DIC(19,113,"U")="RESUME PROCESSING A SCRIPT"
^DIC(19,114,0)="XMSCRIPTEDIT^Edit a script^^R^11748^^^^^^^54^^"
^DIC(19,114,1,0)="^19.06^1^1^3020312^^^"
^DIC(19,114,1,1,0)="This option allows the editing of a script in file 4.2 for a given domain."
^DIC(19,114,25)="EDIT42^XMCE"
^DIC(19,114,99)="54850,27281"
^DIC(19,114,"U")="EDIT A SCRIPT"
^DIC(19,115,0)="XMLIST^List a transcript^^R^11748^^^^^^^54^^"
^DIC(19,115,1,0)="^19.06^1^1^3020312^^"
^DIC(19,115,1,1,0)="This option lists the transcript for a previously played script."
^DIC(19,115,25)="LIST^XMCXT"
^DIC(19,115,"U")="LIST A TRANSCRIPT"
^DIC(19,116,0)="XMSCRIPTPLAY^Play a script^^R^11748^^^^^^^54^^"
^DIC(19,116,1,0)="^19.06^9^9^3020312^^^^"
^DIC(19,116,1,1,0)="If messages are queued in the Postmaster box for a given domain, you can"
^DIC(19,116,1,2,0)="start those messages transmitting immediately (in the foreground) by"
^DIC(19,116,1,3,0)="invoking this option.  (It will not create a task.  If you want to create"
^DIC(19,116,1,4,0)="a task, then use option XMSTARTQUE.)"
^DIC(19,116,1,5,0)=""
^DIC(19,116,1,6,0)="If you want to pull messages from another domain, this is the option to"
^DIC(19,116,1,7,0)="use, whether or not there are messages queued to transmit to that domain."
^DIC(19,116,1,8,0)="(If you regularly pull messages from another domain, you may wish to"
^DIC(19,116,1,9,0)="consider polling that domain.  See option XMPOLL for more information.)"
^DIC(19,116,25)="PLAY^XMCX"
^DIC(19,116,99)="54766,39687"
^DIC(19,116,"U")="PLAY A SCRIPT"
^DIC(19,118,0)="XMVADATS^VADATS SERVER^^R^-1^^^"
^DIC(19,118,25)="XMNETV"
^DIC(19,118,"U")="VADATS SERVER"
^DIC(19,120,0)="XUSERAOLD^Purge Log of Old Access and Verify Codes^^R^10000000020^^115^^^^^^n^^"
^DIC(19,120,1,0)="^^3^3^3050425^"
^DIC(19,120,1,1,0)="This option will purge all inactive access and verify codes which are "
^DIC(19,120,1,2,0)="more than 270 to 400 days old. This will allow for the recycling of "
^DIC(19,120,1,3,0)="codes after a minimun of 3 changes."
^DIC(19,120,25)="AOLD^XUSPURGE"
^DIC(19,120,"U")="PURGE LOG OF OLD ACCESS AND VE"
^DIC(19,121,0)="XMQDISP^Display Active & Inactive Message Queues^^R^11748^^^^^^y^54^^^^^"
^DIC(19,121,1,0)="^19.06^16^16^3020312^^^^"
^DIC(19,121,1,1,0)="Reports on every active queue and every queue with messages."
^DIC(19,121,1,2,0)=" "
^DIC(19,121,1,3,0)="For active queues, it shows much the same information as option"
^DIC(19,121,1,4,0)="XMQACTIVE (Actively transmitting queues), except that instead of"
^DIC(19,121,1,5,0)="the task number, it shows the date/time that the information was"
^DIC(19,121,1,6,0)="last updated."
^DIC(19,121,1,7,0)=" "
^DIC(19,121,1,8,0)="For inactive queues which have messages, it shows whether or not"
^DIC(19,121,1,9,0)="there's a task scheduled.  If there is, it tells you what time"
^DIC(19,121,1,10,0)="it's scheduled for.  If there isn't, it shows you the FLAGS field"
^DIC(19,121,1,11,0)="for that domain in the DOMAIN file.  By looking at the FLAGS field,"
^DIC(19,121,1,12,0)="you should be able to tell whether a task needs to be created to"
^DIC(19,121,1,13,0)="transmit the queue.  Generally, if the FLAGS field contains ""S"""
^DIC(19,121,1,14,0)="(for SEND), and there's no task scheduled, you probably ought to"
^DIC(19,121,1,15,0)="schedule one, using either option XMSTARTQUE-ALL (for all queues),"
^DIC(19,121,1,16,0)="or XMSTARTQUE (for a queue of your choice)."
^DIC(19,121,15)=""
^DIC(19,121,20)=""
^DIC(19,121,25)="STATUS^XMCQ"
^DIC(19,121,"U")="DISPLAY ACTIVE & INACTIVE MESS"
