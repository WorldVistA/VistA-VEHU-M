^DIC(19,3853,99)="59969,39662"
^DIC(19,3853,"U")="MENU CYCLE MANAGEMENT"
^DIC(19,3854,0)="FHREC2^Print Adjusted Recipe^^R^10000000020^^^^^^^"
^DIC(19,3854,1,0)="^^5^5^2880718^^^"
^DIC(19,3854,1,1,0)="This option will adjust and print an adjusted recipe. For"
^DIC(19,3854,1,2,0)="any specified number of portions, the ingredient requirements"
^DIC(19,3854,1,3,0)="will be linearly adjusted upward or downward based upon the"
^DIC(19,3854,1,4,0)="number of portions specified as compared to the number of"
^DIC(19,3854,1,5,0)="portions contained in the recipe."
^DIC(19,3854,25)="EN2^FHREC2"
^DIC(19,3854,"U")="PRINT ADJUSTED RECIPE"
^DIC(19,3855,0)="FHPRC1^Enter/Edit Menu Cycle^^R^10000000020^^^^^^^"
^DIC(19,3855,1,0)="^^2^2^2880716^^"
^DIC(19,3855,1,1,0)="This option will allow the creation and/or editing of an"
^DIC(19,3855,1,2,0)="entry in the Menu Cycle file (116)."
^DIC(19,3855,25)="EN2^FHPRC"
^DIC(19,3855,"U")="ENTER/EDIT MENU CYCLE"
^DIC(19,3856,0)="FHPRC2^Menu Cycle Effective Dates^^R^10000000020^^^^^^^"
^DIC(19,3856,1,0)="^^2^2^2880716^^"
^DIC(19,3856,1,1,0)="This option allows for the entry or editing of the Effective"
^DIC(19,3856,1,2,0)="Date field in the Menu Cycle file (116)."
^DIC(19,3856,25)="EN2^FHPRC4"
^DIC(19,3856,"U")="MENU CYCLE EFFECTIVE DATES"
^DIC(19,3857,0)="FHPRC3^Menu Cycle Query^^R^10000000020^^^^^^^"
^DIC(19,3857,1,0)="^^4^4^2880718^^^"
^DIC(19,3857,1,1,0)="This option will display, for any date, the menu cycle that"
^DIC(19,3857,1,2,0)="is in effect as well as the three meals. In the case where holiday"
^DIC(19,3857,1,3,0)="meals have been entered into the Holiday Meal file, those"
^DIC(19,3857,1,4,0)="meals will over-ride the normal cycle meals."
^DIC(19,3857,25)="EN1^FHPRC4"
^DIC(19,3857,"U")="MENU CYCLE QUERY"
^DIC(19,3858,0)="FHPRC4^Enter/Edit Meals^^R^10000000020^^^^^^^"
^DIC(19,3858,1,0)="^19.06^2^2^3031106^^^"
^DIC(19,3858,1,1,0)="This option allows for the creation/editing of a meal including"
^DIC(19,3858,1,2,0)="the associated recipes and production diets."
^DIC(19,3858,25)="EN3^FHPRC"
^DIC(19,3858,"U")="ENTER/EDIT MEALS"
^DIC(19,3859,0)="FHPRC5^Enter/Edit Holiday Meals^^R^10000000020^^^^^^^"
^DIC(19,3859,1,0)="^^6^6^2890607^^^^"
^DIC(19,3859,1,1,0)="This option allows for the entry/editing of the Holiday Meals"
^DIC(19,3859,1,2,0)="file (116.3) in which meals may be specified for a holiday"
^DIC(19,3859,1,3,0)="which will override the normal cycle meals. Only those"
^DIC(19,3859,1,4,0)="meals selected will override; the absence of a specific"
^DIC(19,3859,1,5,0)="meal entry will result in the retention of the normal cycle"
^DIC(19,3859,1,6,0)="meal."
^DIC(19,3859,25)="EN4^FHPRC"
^DIC(19,3859,"U")="ENTER/EDIT HOLIDAY MEALS"
^DIC(19,3860,0)="FHPRC6^List Meal^^R^10000000020^^^^^^^"
^DIC(19,3860,1,0)="^^2^2^2880716^^"
^DIC(19,3860,1,1,0)="This option will list a meal contained in the Meal file (116.1)"
^DIC(19,3860,1,2,0)="as well as the associated recipes and production diets."
^DIC(19,3860,25)="FHPRC3"
^DIC(19,3860,"U")="LIST MEAL"
^DIC(19,3861,0)="FHPRC7^Print Weekly Menu^^R^10000000020^^^^^^^"
^DIC(19,3861,1,0)="^^5^5^2920226^^^^"
^DIC(19,3861,1,1,0)="This option will print a seven day menu containing the "
^DIC(19,3861,1,2,0)="individual recipes to be served at breakfast, noon, and"
^DIC(19,3861,1,3,0)="evening for each of the seven days. The meals, from which"
^DIC(19,3861,1,4,0)="the recipes are taken, are those that are or will be effective"
^DIC(19,3861,1,5,0)="during the week chosen."
^DIC(19,3861,25)="FHPRC2"
^DIC(19,3861,"U")="PRINT WEEKLY MENU"
^DIC(19,3862,0)="FHREC3^List Recipes^^R^10000000020^^^^^^^"
^DIC(19,3862,1,0)="^^2^2^2880717^^"
^DIC(19,3862,1,1,0)="This option will list all recipes contained in the Recipe"
^DIC(19,3862,1,2,0)="file (114) and their associated data elements."
^DIC(19,3862,25)="FHREC4"
^DIC(19,3862,"U")="LIST RECIPES"
^DIC(19,3863,0)="FHING5^List Ingredients - Recipe Data^^R^10000000020^^^^^^^"
^DIC(19,3863,1,0)="^19.06^4^4^3021121^^^^"
^DIC(19,3863,1,1,0)="This option will list all ingredients along with data elements"
^DIC(19,3863,1,2,0)="associated with recipe preparation such as unit of issue, recipe"
^DIC(19,3863,1,3,0)="unit, number of recipe units in an issue unit, storage location,"
^DIC(19,3863,1,4,0)="thaw days, etc."
^DIC(19,3863,25)="LIS1^FHPRI2"
^DIC(19,3863,"U")="LIST INGREDIENTS - RECIPE DATA"
^DIC(19,3864,0)="FHING6^List Units^^R^10000000020^^^^^^^"
^DIC(19,3864,1,0)="^^2^2^2880717^"
^DIC(19,3864,1,1,0)="This option produces a listing of all of the entries in the"
^DIC(19,3864,1,2,0)="Units file (119.1)."
^DIC(19,3864,25)="EN6^FHPRI"
^DIC(19,3864,"U")="LIST UNITS"
^DIC(19,3865,0)="FHING7^List Vendors^^R^10000000020^^^^^^^"
^DIC(19,3865,1,0)="^^2^2^2950614^^"
^DIC(19,3865,1,1,0)="This option produces a list of all of the vendors in the"
^DIC(19,3865,1,2,0)="Vendor file (113.2) as well as all associated data elements."
^DIC(19,3865,25)="FHPRI3"
^DIC(19,3865,"U")="LIST VENDORS"
^DIC(19,3866,0)="FHING8^List Storage Locations^^R^10000000020^^^^^^^"
^DIC(19,3866,1,0)="^^3^3^2880717^"
^DIC(19,3866,1,1,0)="This option produces a list of all storage locations contained"
^DIC(19,3866,1,2,0)="in the Storage Location file (113.1) as well as all associated"
^DIC(19,3866,1,3,0)="data elements."
^DIC(19,3866,25)="EN8^FHPRI"
^DIC(19,3866,"U")="LIST STORAGE LOCATIONS"
^DIC(19,3867,0)="FHPRF5^Enter/Edit Other Meals^^R^10000000020^^^^^^^"
^DIC(19,3867,1,0)="^^6^6^2911212^^^^"
^DIC(19,3867,1,1,0)="This option allows for the building of a table of other"
^DIC(19,3867,1,2,0)="meals. The table is by Service Point, day of the week, and"
^DIC(19,3867,1,3,0)="meal (breakfast, noon, evening). The values represent"
^DIC(19,3867,1,4,0)="other meals (for outpatients, residents, guests, volunteers,"
^DIC(19,3867,1,5,0)="etc.) that would not be included in the inpatient forecast or"
^DIC(19,3867,1,6,0)="census."
^DIC(19,3867,25)="EN2^FHPRF"
^DIC(19,3867,"U")="ENTER/EDIT OTHER MEALS"
^DIC(19,3868,0)="FHPRF6^List Other Meals^^R^10000000020^^^^^^^"
^DIC(19,3868,1,0)="^19.06^3^3^3020719^^^^"
^DIC(19,3868,1,1,0)="This option will list the Other Meals table showing for"
^DIC(19,3868,1,2,0)="each Service Point how many other meals are required"
^DIC(19,3868,1,3,0)="each day of the week for breakfast, noon, and evening."
^DIC(19,3868,25)="FHPRF4"
^DIC(19,3868,"U")="LIST OTHER MEALS"
^DIC(19,3869,0)="FHING9^Enter/Edit Preparation Areas^^R^10000000020^^^^^^^"
^DIC(19,3869,1,0)="^^2^2^2920505^^"
^DIC(19,3869,1,1,0)="This option allows the user to add and/or edit entries in"
^DIC(19,3869,1,2,0)="the Preparation Area file (114.2)."
^DIC(19,3869,25)="EN9^FHREC"
^DIC(19,3869,"U")="ENTER/EDIT PREPARATION AREAS"
^DIC(19,3870,0)="FHING10^List Preparation Areas^^R^10000000020^^^^^^^"
^DIC(19,3870,1,0)="^^2^2^2880717^^"
^DIC(19,3870,1,1,0)="This option produces a listing of the entries in the"
^DIC(19,3870,1,2,0)="Preparation Area file (114.2)."
^DIC(19,3870,25)="EN10^FHREC"
^DIC(19,3870,"U")="LIST PREPARATION AREAS"
^DIC(19,3871,0)="FHING11^List Recipes Containing an Ingredient^^R^10000000020^^^^^^^"
^DIC(19,3871,1,0)="^^4^4^2880717^^"
^DIC(19,3871,1,1,0)="This option will produce a list of all recipes in the Recipe"
^DIC(19,3871,1,2,0)="file which contain a selected ingredient. In addition, the"
^DIC(19,3871,1,3,0)="listing shows which meals and menu cycle days reference"
^DIC(19,3871,1,4,0)="that recipe."
^DIC(19,3871,25)="FHPRI1"
^DIC(19,3871,"U")="LIST RECIPES CONTAINING AN ING"
