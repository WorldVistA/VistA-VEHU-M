^DIC(19,13517,1,1,0)="This option will allow the user to create Allergy-type Food Preferences"
^DIC(19,13517,1,2,0)="and map them to corresponding standardized GMR Allergies."
^DIC(19,13517,25)="CREATE^FHSELA1"
^DIC(19,13517,"U")="CREATE/MAP FOOD PREFERENCES TO"
