^DIC(19,12387,1,1,0)="This option prints a generic test letter from the EAS MT LETTERS File, "
^DIC(19,12387,1,2,0)="#713.3.  User will be asked to select the type of letter to print in a"
^DIC(19,12387,1,3,0)="test format.  The printed letter includes a ""DO NOT MAIL"" warning as"
^DIC(19,12387,1,4,0)="part of the patient name."
^DIC(19,12387,20)="D TESTLTR^EASMTUTL"
^DIC(19,12387,"U")="PRINT A TEST LETTER (EAS MT)"
