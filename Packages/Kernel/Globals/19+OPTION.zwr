^DIC(19,9905,0)="PX PCE CLINICIAN MENU^PCE Clinician Menu^^M^10958^^^^^^^507"
^DIC(19,9905,1,0)="^^2^2^2960520^"
^DIC(19,9905,1,1,0)="This menu option allows the clinician to have access to PCE options which"
^DIC(19,9905,1,2,0)="may be useful to the clinician."
^DIC(19,9905,10,0)="^19.01IP^4^4"
