^DIC(19,11174,0)="PRCO AR VENDOR EDIT^Setup AR selected vendors^^R^11740^PRCFA VENDOR EDIT^^^^^^121^^1"
^DIC(19,11174,1,0)="^19.06^9^9^3000608^^"
^DIC(19,11174,1,1,0)="This option will handle the editing and creating of a VRQ for vendor"
^DIC(19,11174,1,2,0)="records chosen by Accounts Receivable users."
^DIC(19,11174,1,3,0)="   "
^DIC(19,11174,1,4,0)="Once the VRQ is 'created' it will be reviewed by FISCAL or sent directly"
^DIC(19,11174,1,5,0)="to Austin."
^DIC(19,11174,1,6,0)="   "
^DIC(19,11174,1,7,0)="The 'CAN FISCAL ADD VENDORS?' flag in file 411 will govern if FISCAL or"
^DIC(19,11174,1,8,0)="SUPPLY edits these vendor records.  If the flag is set to 'YES' FISCAL"
^DIC(19,11174,1,9,0)="will edit these records.  Otherwise, A&MM will have the honor."
^DIC(19,11174,20)="D FIND^PRCHUTL S:STN411'=1 XQUIT="""" K STN411 S LOCAT=""F"""
^DIC(19,11174,25)="PRCOVL"
^DIC(19,11174,"U")="SETUP AR SELECTED VENDORS"
^DIC(19,11175,0)="PRCO AR SUPPLY VENDOR EDIT^Setup AR selected vendors^^R^11740^^^^^^^121^^1"
^DIC(19,11175,1,0)="^19.06^9^9^3000608^^^^"
^DIC(19,11175,1,1,0)="This option will handle the editing and creating of a VRQ for vendor"
^DIC(19,11175,1,2,0)="records chosen by Accounts Receivable users."
^DIC(19,11175,1,3,0)="   "
^DIC(19,11175,1,4,0)="Once the VRQ is 'created' it will be reviewed by FISCAL or sent directly"
^DIC(19,11175,1,5,0)="to Austin."
^DIC(19,11175,1,6,0)="   "
^DIC(19,11175,1,7,0)="The 'CAN FISCAL ADD VENDORS?' flag in file 411 will govern if FISCAL or"
^DIC(19,11175,1,8,0)="SUPPLY edits these vendor records.  If the flag is set to 'YES' FISCAL"
^DIC(19,11175,1,9,0)="will edit these records.  Otherwise, A&MM will have the honor."
^DIC(19,11175,20)="S LOCAT=""S"""
^DIC(19,11175,25)="PRCOVL"
^DIC(19,11175,"U")="SETUP AR SELECTED VENDORS"
