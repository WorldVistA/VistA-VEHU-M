^DIC(19,16634,0)="EHM-01455^HT Previous Enrollment Health Factor Search^^R^1^^^^^^^534^^^^"
^DIC(19,16634,1,0)="^19.06^5^5^3240328^^^"
^DIC(19,16634,1,1,0)="This option will search the Clinical Reminders Index for any "
^DIC(19,16634,1,2,0)="occurrences of the CCHT ENROLLMENT-START DATE (PREV ENROLL) and HT "
^DIC(19,16634,1,3,0)="ENROLLMENT-START DATE (PREV ENROLL) health factors.  For any occurrence "
^DIC(19,16634,1,4,0)="found, the report will output the patient name, SSN, and visit date."
^DIC(19,16634,1,5,0)="Cloned from ""PXRM HT HEALTH FACTOR"" option."
^DIC(19,16634,3)=""
^DIC(19,16634,25)="EN^PXRMCCHT"
^DIC(19,16634,"U")="HT PREVIOUS ENROLLMENT HEALTH "
^DIC(19,16635,0)="EHM-01456^Cover Sheet Reminder Report^^R^1^^^^^^^534^^^^"
^DIC(19,16635,1,0)="^^4^4^3240328^"
^DIC(19,16635,1,1,0)=""
