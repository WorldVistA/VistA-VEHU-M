^DIC(19,9826,1,2,0)="for Third Party billing or to be ignored by the Third Party auto biller."
^DIC(19,9826,1,3,0)="These parameters are all flagged by date and may be inactivated"
^DIC(19,9826,1,4,0)="and re-activated."
^DIC(19,9826,25)="EN^IBEPTC"
^DIC(19,9826,"U")="FLAG STOP CODES/CLINICS FOR TH"
^DIC(19,9827,0)="IB TP LIST FLAGGED PARAMS^List Flagged Stop Codes/Clinics for Third Party^^R^10000000033^^^^^^^192"
^DIC(19,9827,1,0)="^^4^4^2960209^"
^DIC(19,9827,1,1,0)="This output is used to generate a list of all stop codes and clinics that"
^DIC(19,9827,1,2,0)="are flagged as non-billable for Third Party billing or that should"
^DIC(19,9827,1,3,0)="not be auto billed by the Third Party auto biller on a user-specified"
^DIC(19,9827,1,4,0)="date."
^DIC(19,9827,25)="EN^IBEPTC2"
^DIC(19,9827,"U")="LIST FLAGGED STOP CODES/CLINIC"
