^DIC(19,12069,0)="VAFC HFS SETUP^HFS Device Setup^^R^10000000020^^^^^^^"
^DIC(19,12069,1,0)="^19.06^14^14^3011116^^^"
^DIC(19,12069,1,1,0)="This option is used to set up the PARAMETER DEFINITION (#8989.51) "
^DIC(19,12069,1,2,0)="and PARAMETERS (#8989.5) files to read, write, and delete reports to "
^DIC(19,12069,1,3,0)="a Host File Server (HFS) file.  In the setup, the directory NAME (#.01)"
^DIC(19,12069,1,4,0)="field should contain a directory location that is wide open (read,"
^DIC(19,12069,1,5,0)="write, edit, and delete) to all.  If these files are not set up, the"
^DIC(19,12069,1,6,0)="inbound requests will default to the working Broker Server directory"
^DIC(19,12069,1,7,0)="which may or may not have enough privileges to allow a remote system"
^DIC(19,12069,1,8,0)="to pull the necessary information.  Please check to see that your"
^DIC(19,12069,1,9,0)="directory has the appropriate privileges."
^DIC(19,12069,1,10,0)=" "
^DIC(19,12069,1,11,0)=" VMS example code to check privileges:"
^DIC(19,12069,1,12,0)=" A2$dir aij$:[000000]tcp$spool.dir /own/prot"
^DIC(19,12069,1,13,0)="    Directory AIJ$:[000000]"
^DIC(19,12069,1,14,0)="    TCP$SPOOL.DIR;1      [SYSTEM] (RWED,RWED,RWED,RWED)"
^DIC(19,12069,25)="CREATE^VAFCHFS"
^DIC(19,12069,"U")="HFS DEVICE SETUP"
^DIC(19,12070,0)="RG REMOTE PDAT SEND^Send Remote Patient Data Query^^R^10000000033^^^^^^^525"
^DIC(19,12070,1,0)="^19.06^5^5^3011115^^"
^DIC(19,12070,1,1,0)="This option allows you to send remote patient data queries from "
^DIC(19,12070,1,2,0)="your facility to any facility at which a selected patient has "
^DIC(19,12070,1,3,0)="been seen.  The remote data fields retrieved are the same as "
^DIC(19,12070,1,4,0)="those that are available for local data using the Patient MPI/PD "
^DIC(19,12070,1,5,0)="Data Inquiry [RG EXCEPTION TF INQUIRY] option."
^DIC(19,12070,25)="SEND2^RGRPDAT"
^DIC(19,12070,"U")="SEND REMOTE PATIENT DATA QUERY"
^DIC(19,12071,0)="RG REMOTE PDAT CHECK^Check Remote Patient Data Query^^R^10000000033^^^^^^^525"
^DIC(19,12071,1,0)="^19.06^3^3^3011115^^^"
^DIC(19,12071,1,1,0)="This option allows you to check the status of a remote patient "
^DIC(19,12071,1,2,0)="data query previously sent using the Send Remote Patient "
^DIC(19,12071,1,3,0)="Data Query [RG REMOTE PDAT SEND] option."
^DIC(19,12071,25)="CHKSTAT2^RGRPDAT"
^DIC(19,12071,"U")="CHECK REMOTE PATIENT DATA QUER"
^DIC(19,12072,0)="RG REMOTE PDAT DISPLAY^Display Remote Patient Data Query^^R^10000000033^^^^^^^525"
^DIC(19,12072,1,0)="^19.06^3^3^3011115^^"
^DIC(19,12072,1,1,0)="This option allows you to display a patient data query previously"
^DIC(19,12072,1,2,0)="sent using the Send Remote Patient Data Query [RG REMOTE PDAT SEND]"
^DIC(19,12072,1,3,0)="option."
^DIC(19,12072,25)="DISP2^RGRPDAT"
^DIC(19,12072,"U")="DISPLAY REMOTE PATIENT DATA QU"
^DIC(19,12073,0)="RG REMOTE PDAT MENU^Remote Patient Data Query Menu^^M^10000000033^^^^^^^525"
^DIC(19,12073,1,0)="^19.06^7^7^3011220^^^^"
^DIC(19,12073,1,1,0)="This menu provides options to query any facility at which a selected"
^DIC(19,12073,1,2,0)="patient has been seen, check the query, and display the remote patient"
^DIC(19,12073,1,3,0)="data that is returned from that site.  The remote data fields retrieved"
^DIC(19,12073,1,4,0)="include the Integration Control Number (ICN), the Coordinating Master"
^DIC(19,12073,1,5,0)="of Record (CMOR) site, MPI/PD Activity Score, Subscription Control"
^DIC(19,12073,1,6,0)="Number, Treating Facility list, CMOR History and CMOR Change Request "
^DIC(19,12073,1,7,0)="History."
^DIC(19,12073,10,0)="^19.01IP^3^3"
^DIC(19,12073,10,1,0)="12070^^10"
^DIC(19,12073,10,2,0)="12071^^20"
^DIC(19,12073,10,3,0)="12072^^30"
^DIC(19,12073,10,"B",12070,1)=""
^DIC(19,12073,10,"B",12071,2)=""
^DIC(19,12073,10,"B",12072,3)=""
^DIC(19,12073,99)="61957,33175"
^DIC(19,12073,"U")="REMOTE PATIENT DATA QUERY MENU"
^DIC(19,12074,0)="GMRC PRINT BY SEARCH^Print Consults by Provider, Location, or Procedure^^R^11740^^^^^^^"
^DIC(19,12074,1,0)="^^9^9^3020305^"
^DIC(19,12074,1,1,0)="This option will compile a list of consult requests based on Provider,"
^DIC(19,12074,1,2,0)="Location, or Procedure search criteria. Date range, status, and output"
^DIC(19,12074,1,3,0)="formats are selectable parameters."
^DIC(19,12074,1,4,0)=" "
^DIC(19,12074,1,5,0)="There are additional prompts for selection of local, remote, or both local"
^DIC(19,12074,1,6,0)="and remote Provider(s) and Location(s). For the purposes of this "
^DIC(19,12074,1,7,0)="option, ""local"" refers to non-Inter-facility requests and Inter-facility"
^DIC(19,12074,1,8,0)="requests originating locally; ""remote"" only refers to Inter-facility"
^DIC(19,12074,1,9,0)="requests originating at another site."
^DIC(19,12074,25)="EN^GMRCPSL1"
^DIC(19,12074,99)="58686,53687"
^DIC(19,12074,"U")="PRINT CONSULTS BY PROVIDER, LO"
