^DIC(19,12707,0)="SD-PAIT ACK SUMMARY^Acknowledgement Summary^^P^10000000020^^^^^^y^"
^DIC(19,12707,1,0)="^^3^3^3040304^"
^DIC(19,12707,1,1,0)="This report lists all batches in batch control ID order. The report also "
