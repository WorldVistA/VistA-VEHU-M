^DIC(19,14117,0)="PRSNR ACTIVITY BY GROUP-COORD^Activity Report by Group^^R^10000000216^^^^^^^"
^DIC(19,14117,1,0)="^19.06^3^3^3091119^^^"
^DIC(19,14117,1,1,0)="This report provides nursing point of care activity over a date range, by "
^DIC(19,14117,1,2,0)="location or T&L unit within a division.  The user can specify a detailed "
^DIC(19,14117,1,3,0)="or summary report."
^DIC(19,14117,25)="COORD^PRSNRAS0"
^DIC(19,14117,"U")="ACTIVITY REPORT BY GROUP"
^DIC(19,14118,0)="PRSNR INDIV ACTIVITY-COORD^Individual Activity Report^^R^10000000216^^^^^^^"
^DIC(19,14118,1,0)="^19.06^2^2^3091014^^"
^DIC(19,14118,1,1,0)="This report provides individual nursing point of care activity over a "
^DIC(19,14118,1,2,0)="date range, by location or T&L unit within a division."
^DIC(19,14118,25)="COORD^PRSNRIA"
^DIC(19,14118,"U")="INDIVIDUAL ACTIVITY REPORT"
^DIC(19,14119,0)="PRSNR INDIV ACTIVITY-NURSE^Individual Activity Report^^R^10000000216^^^^^^^"
^DIC(19,14119,1,0)="^^2^2^3091014^"
^DIC(19,14119,1,1,0)="This report provides individual nursing point of care activity over a"
^DIC(19,14119,1,2,0)="date range, by location or T&L unit within a division."
^DIC(19,14119,25)="NURSE^PRSNRIA"
^DIC(19,14119,"U")="INDIVIDUAL ACTIVITY REPORT"
