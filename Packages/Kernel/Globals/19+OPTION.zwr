^DIC(19,10933,"U")="COLLECTION SUPERVISOR MENU"
^DIC(19,10934,0)="AJK1UB NEW STRING EDIT^New Transmission String Enter/Edit^^R^11600^^^^^^^"
^DIC(19,10934,1,0)="^^2^2^2971114^"
^DIC(19,10934,1,1,0)="This option is used by the manager to modify the data string being"
^DIC(19,10934,1,2,0)="transmitted to the collection agency."
^DIC(19,10934,25)="NEW^AJK1UBM"
^DIC(19,10934,"U")="NEW TRANSMISSION STRING ENTER/"
^DIC(19,10935,0)="AJK1UB STATUS STRING EDIT^Status Change Transmission Edit^^R^11600^^^^^^^"
^DIC(19,10935,1,0)="^^2^2^2971114^"
^DIC(19,10935,1,1,0)="This option is used to edit the transmission string sent to the collection"
^DIC(19,10935,1,2,0)="agency whenever a status change is made."
^DIC(19,10935,25)="CHG^AJK1UBM"
^DIC(19,10935,"U")="STATUS CHANGE TRANSMISSION EDI"
^DIC(19,10936,0)="AJK1UB RETRANSMIT BY MESSAGE^Retransmit by Message Number^^R^11600^^^^^^^"
^DIC(19,10936,1,0)="^^5^5^2971117^"
^DIC(19,10936,1,1,0)="This option is used to retransmit all records associated with a specific"
^DIC(19,10936,1,2,0)="message number.  Enter the number of the message you wish to retransmit"
^DIC(19,10936,1,3,0)="records for and confirm your choice.  The records are set up in the"
^DIC(19,10936,1,4,0)="RETRANSMISSION file and are sent with the next regularly scheduled"
^DIC(19,10936,1,5,0)="transmission."
^DIC(19,10936,25)="MSG^AJK1UBTR"
^DIC(19,10936,"U")="RETRANSMIT BY MESSAGE NUMBER"
^DIC(19,10937,0)="AJK1UB STATUS CODE ENTER/EDIT^Enter/Edit Status Code^^R^11600^^^^^^^"
^DIC(19,10937,1,0)="^^2^2^2971117^"
^DIC(19,10937,1,1,0)="This option is used to define the status codes which are transmitted to"
^DIC(19,10937,1,2,0)="the collection agency whenever a status change is observed."
^DIC(19,10937,25)="CODE^AJK1UBM"
^DIC(19,10937,"U")="ENTER/EDIT STATUS CODE"
^DIC(19,10938,0)="AJK1UB PURGE^Purge Old Collection Data^^R^11600^^^^^^^"
^DIC(19,10938,1,0)="^^6^6^2971118^"
^DIC(19,10938,1,1,0)="This option is used to, interactively, select the parameters you want AND"
^DIC(19,10938,1,2,0)="the time to start the collection purge utility.  This utility will look"
^DIC(19,10938,1,3,0)="for all records in the AJK1UB TRANSMITAL file, which are no longer ACTIVE,"
^DIC(19,10938,1,4,0)="and are older than the number of days you select and remove them from the"
^DIC(19,10938,1,5,0)="file.  All corresponding entries in the AJK1UB STATUS CHANGE file are also"
^DIC(19,10938,1,6,0)="removed."
^DIC(19,10938,25)="EN^AJK1UBP1"
^DIC(19,10938,"U")="PURGE OLD COLLECTION DATA"
^DIC(19,10939,0)="AJK1UB PURGE AUTO^Collection Data Purge (Auto)^^R^11600^^^^^^^"
^DIC(19,10939,1,0)="^^5^5^2971118^"
^DIC(19,10939,1,1,0)="This option is used to automatically start the purge utility.  This"
^DIC(19,10939,1,2,0)="utility will look for all records in the AJK1UB TRANSMITAL file, which are"
^DIC(19,10939,1,3,0)="no longer ACTIVE, and are older than the number of days defined in the"
^DIC(19,10939,1,4,0)="AJK1UB SITE PARAMETER file and remove them from the file.  All"
^DIC(19,10939,1,5,0)="corresponding entries in the AJK1UB STATUS CHANGE file are also removed."
^DIC(19,10939,25)="AUTO^AJK1UBP1"
^DIC(19,10939,"U")="COLLECTION DATA PURGE (AUTO)"
^DIC(19,10940,0)="LR BAR CF^Lab Bar Code Label Formatter^^R^10958^LRLIASON^^^^^^26"
^DIC(19,10940,1,0)="^^2^2^2980707^^^^"
^DIC(19,10940,1,1,0)="This option is used to program bar code label printers with"
^DIC(19,10940,1,2,0)="pre-established label formats used by the Laboratory software."
^DIC(19,10940,25)="LRBARCF"
^DIC(19,10940,"U")="LAB BAR CODE LABEL FORMATTER"
^DIC(19,10941,0)="USR EDIT BUSINESS RULES^Edit Business Rules^^A^11712^^^^^^y^515^^1"
^DIC(19,10941,1,0)="^^4^4^2960610^^"
^DIC(19,10941,1,1,0)="This option allows the user to enter Business Rules authorizing specific"
^DIC(19,10941,1,2,0)="users or groups of users to perform specified actions on documents in"
^DIC(19,10941,1,3,0)="particular statuses (e.g, an UNSIGNED PROGRESS NOTE may be EDITED by a"
^DIC(19,10941,1,4,0)="PROVIDER who is also the EXPECTED SIGNER of the note, etc.)."
^DIC(19,10941,20)="D MAIN^USRAEDT"
^DIC(19,10941,"U")="EDIT BUSINESS RULES"
^DIC(19,10942,0)="TIU RE-INDEX DOCUMENT FILE^Re-index Document file for CPRS^^A^11712^^^^^^^516^y^1^1^^"
^DIC(19,10942,1,0)="^^3^3^2980528^"
^DIC(19,10942,1,1,0)="This option provides will RE-INDEX the TIU DOCUMENT FILE (#8925), for the"
^DIC(19,10942,1,2,0)="""ACLPT"", ""ACLAU"", and ""ACLEC"" Cross-references only, to assure that"
^DIC(19,10942,1,3,0)="Discharge Summaries may be appropriately accessed from the CPRS Chart."
^DIC(19,10942,15)="D EN^TIURENDX"
^DIC(19,10942,20)="W !!,$$CENTER^TIULS(""--- Re-index TIU Document File ---""),!!"
^DIC(19,10942,26)=""
^DIC(19,10942,"U")="RE-INDEX DOCUMENT FILE FOR CPR"
^DIC(19,10961,0)="ORS HEALTH SUMMARY^Health Summary^^R^11712^^^^^^^170"
^DIC(19,10961,1,0)="^^2^2^2920226^^"
^DIC(19,10961,1,1,0)="This option allows the user to run Health Summaries for multiple patients"
^DIC(19,10961,1,2,0)="using the selection dialogue for OE/RR"
^DIC(19,10961,25)="MAIN^GMTSDVR"
^DIC(19,10961,"U")="HEALTH SUMMARY"
^DIC(19,10962,0)="ORB3 URGENCY^Set Urgency for Notifications (GUI)^^R^10000000020^^^^^^^"
^DIC(19,10962,1,0)="^19.06^6^6^3010904^^^^"
^DIC(19,10962,1,1,0)="Set of codes indicating the urgency for a notification for a site.  The"
^DIC(19,10962,1,2,0)="urgency is mainly used for sorting in displays.  The codes include:  "
^DIC(19,10962,1,3,0)="  "
^DIC(19,10962,1,4,0)="     1 (High):  notification is Highly urgent"
^DIC(19,10962,1,5,0)="     2 (Moderate):  notification is Moderately urgent"
^DIC(19,10962,1,6,0)="     3 (Low):  notification is of Low urgency"
^DIC(19,10962,25)="URG^ORB3MGR1"
^DIC(19,10962,"U")="SET URGENCY FOR NOTIFICATIONS "
^DIC(19,10963,0)="ORB3 DELETE MECHANISM^Set Deletion Parameters for Notifications^^R^10000000020^^^^^^^"
^DIC(19,10963,1,0)="^19.06^12^12^3010904^^^^"
^DIC(19,10963,1,1,0)="Enter 'I' if deleted on individual review/action; 'A' for all recipients."
^DIC(19,10963,1,2,0)="Set of codes used to determine how a notification will be deleted at a site."
^DIC(19,10963,1,3,0)="Codes include:"
^DIC(19,10963,1,4,0)="     I (Individual Recipient):  delete the notification for an individual"
^DIC(19,10963,1,5,0)="       recipient when"
^DIC(19,10963,1,6,0)="          a) that individual completes the follow-up action on "
^DIC(19,10963,1,7,0)="               notifications with associated actions."
^DIC(19,10963,1,8,0)="     A (All Recipients):  delete the notification for all recipients when"
^DIC(19,10963,1,9,0)="          a) any recipient completes the follow-up action on notifications"
^DIC(19,10963,1,10,0)="             with follow-up actions."
^DIC(19,10963,1,11,0)="          b) any recipient reviews notifications without follow-up "
^DIC(19,10963,1,12,0)="             actions."
^DIC(19,10963,25)="DEL^ORB3MGR1"
^DIC(19,10963,"U")="SET DELETION PARAMETERS FOR NO"
^DIC(19,10964,0)="ORB3 DEFAULT RECIPIENTS^Set Default Recipient(s) for Notifications^^R^10958^^^^^^^"
^DIC(19,10964,1,0)="^^4^4^2960820^^"
^DIC(19,10964,1,1,0)="Enter 'Yes' if the recipient should always receive this notification."
^DIC(19,10964,1,2,0)="Recipients (users,teams) will receive the notification on a regular"
^DIC(19,10964,1,3,0)="basis - despite settings in the option Enable/Disable Notifications."
^DIC(19,10964,1,4,0)="These recipients will always receive the notification, regardless of patient."
^DIC(19,10964,25)="REGR^ORB3MGR1"
^DIC(19,10964,31)=6
^DIC(19,10964,"U")="SET DEFAULT RECIPIENT(S) FOR N"
^DIC(19,10965,0)="ORB3 PROVIDER RECIPIENTS^Set Provider Recipients for Notifications^^R^11720^^^^^^^"
^DIC(19,10965,1,0)="^^14^14^2991229^^"
^DIC(19,10965,1,1,0)="Any one or combination of 'P', 'A', 'T', and/or 'O'.  "
^DIC(19,10965,1,2,0)="Set of codes indicating default (provider) recipients of a notification by"
^DIC(19,10965,1,3,0)="their title or relationship to the patient.  Notifications can be set up "
^DIC(19,10965,1,4,0)="with any or all of the following codes:"
^DIC(19,10965,1,5,0)="   P (Primary Provider):     Deliver notification to the patient's Primary"
^DIC(19,10965,1,6,0)="                             Provider."
^DIC(19,10965,1,7,0)="   A (Attending Physician):  Deliver notification to the patient's "
^DIC(19,10965,1,8,0)="                             Attending Physician."
^DIC(19,10965,1,9,0)="   T (Patient Care Team):    Deliver notification to the patient's primary"
^DIC(19,10965,1,10,0)="                             care Team."
^DIC(19,10965,1,11,0)="   O (Ordering Provider):    Deliver notification to the provider who placed"
^DIC(19,10965,1,12,0)="                             the order which triggered the notification."
^DIC(19,10965,1,13,0)="The providers, physicians and teams must be set up properly and accurately"
^DIC(19,10965,1,14,0)="for the correct individuals to receive the notification."
^DIC(19,10965,25)="TITLR^ORB3MGR1"
^DIC(19,10965,"U")="SET PROVIDER RECIPIENTS FOR NO"
^DIC(19,10966,0)="ORB3 PROCESSING FLAG^Enable/Disable Notifications ^^R^10958^^^^^^^"
^DIC(19,10966,1,0)="^^15^15^2990427^^^^"
^DIC(19,10966,1,1,0)="Set of codes indicating processing flag for the entity and notification."
^DIC(19,10966,1,2,0)="   E (Enabled):    Notification enabled for entity unless entity of "
^DIC(19,10966,1,3,0)="                   higher precedence has notification disabled, e.g. Enabled"
^DIC(19,10966,1,4,0)="                   at System level and Disabled at User level - User will "
^DIC(19,10966,1,5,0)="                   not receive notification."
^DIC(19,10966,1,6,0)="   D (Disabled):   Notification disabled for entity unless entity of "
^DIC(19,10966,1,7,0)="                   higher precedence has notification enabled, e.g. Dis-"
^DIC(19,10966,1,8,0)="                   abled at System level and Enabled at User level - User"
^DIC(19,10966,1,9,0)="                   will receive notification.  [Note:  If the option Set"
^DIC(19,10966,1,10,0)="                   Default Recipients for Notifications (parameter ORB3"
^DIC(19,10966,1,11,0)="                   REGULAR RECIPIENTS) is set to 'True' for a Team or "
^DIC(19,10966,1,12,0)="                   User, that Team or User will always receive the notifi-"
^DIC(19,10966,1,13,0)="                   cation, regardless of the Enabled/Disabled settings.]"
^DIC(19,10966,1,14,0)="                   [Second Note:  During alpha, Class and Service will not"
^DIC(19,10966,1,15,0)="                   affect processing.]"
^DIC(19,10966,25)="PFLAG^ORB3MGR1"
^DIC(19,10966,99)="56670,46270"
^DIC(19,10966,"U")="ENABLE/DISABLE NOTIFICATIONS "
^DIC(19,10967,0)="ORB3 ERASE NOTIFICATIONS^Erase Notifications^^R^1^^^^^^^"
^DIC(19,10967,1,0)="^^2^2^2960821^"
^DIC(19,10967,1,1,0)="Erase all notifications for a User, erase all notifications for a Patient,"
^DIC(19,10967,1,2,0)="or erase a specific Notification."
^DIC(19,10967,25)="ERASE^ORB3MGR1"
^DIC(19,10967,99)="56686,35654"
^DIC(19,10967,"U")="ERASE NOTIFICATIONS"
^DIC(19,10968,0)="ORB3 FLAG ORDERABLE ITEMS^Flag Orderable Item(s) to Send Notifications^^R^10958^^^^^^^"
^DIC(19,10968,1,0)="^^3^3^2960820^"
^DIC(19,10968,1,1,0)="Two sub-options to flag specific orderable items to send notifications when"
^DIC(19,10968,1,2,0)="they are ordered or resulted.  [Note:  This option may not be available "
^DIC(19,10968,1,3,0)="until late alpha testing.]"
^DIC(19,10968,25)="FLGOI^ORB3MGR1"
^DIC(19,10968,"U")="FLAG ORDERABLE ITEM(S) TO SEND"
^DIC(19,10969,0)="ORB3 ARCHIVE PERIOD^Archive(delete) after <x> Days^^R^10000000020^^^^^^^"
^DIC(19,10969,1,0)="^^10^10^3080410^"
^DIC(19,10969,1,1,0)="Enter the number of days to archive this notification before deletion."
^DIC(19,10969,1,2,0)="The number of days to archive a notification for a site.  If not indicated,"
^DIC(19,10969,1,3,0)="the default period of 30 days is used.  The maximum number of 100,000 is"
^DIC(19,10969,1,4,0)="about 220 years.  This value is passed to the Kernal Alert Utility where"
^DIC(19,10969,1,5,0)="the actual archiving and deletion of alerts/notifications occurs."
^DIC(19,10969,1,6,0)="The effect of this option is that entries in the Alert Tracking file will "
^DIC(19,10969,1,7,0)="be removed which is a log of Alert activity, not the alets themselves.  "
^DIC(19,10969,1,8,0)="However, if the Kernel option XQALERT DELETE OLD is set to a time that is "
^DIC(19,10969,1,9,0)="greater than 30 days (or whatever the value is for the ORB3 ARCHIVE "
^DIC(19,10969,1,10,0)="PERIOD) then this option will also delete old alerts."
^DIC(19,10969,25)="ARC^ORB3MGR1"
^DIC(19,10969,"U")="ARCHIVE(DELETE) AFTER <X> DAYS"
^DIC(19,10970,0)="ORB3 FORWARD SUPERVISOR^Forward Unprocessed Notification to Supervisor^^R^10958^^^^^^^"
^DIC(19,10970,1,0)="^^11^11^2990329^^^^"
^DIC(19,10970,1,1,0)="The number of days to hold a notification before it is forwarded to a"
^DIC(19,10970,1,2,0)="recipient's supervisor.  The maximum is 30 days.  If not indicated or zero, "
^DIC(19,10970,1,3,0)="the notification will not be forwarded.  For example, if a notification "
^DIC(19,10970,1,4,0)="has a value of 14 for this parameter, it will be forwarded to the supervisor"
^DIC(19,10970,1,5,0)="of each recipient who hasn't processed the notification after 14 days.  "
^DIC(19,10970,1,6,0)="Determination of recipients who have not processed the notification and"
^DIC(19,10970,1,7,0)="who their supervisors are is made by the Kernel Alert Utility.  It will"
^DIC(19,10970,1,8,0)="not be forwarded to supervisors of recipients who have processed the "
^DIC(19,10970,1,9,0)="alert within 14 days.  If the value of this parameter is zero or"
^DIC(19,10970,1,10,0)="non-existent, the alert/notification will never be forwarded."
^DIC(19,10970,1,11,0)="[Note:  This option may not be available until late alpha testing.]"
^DIC(19,10970,25)="FSUPER^ORB3MGR1"
^DIC(19,10970,"U")="FORWARD UNPROCESSED NOTIFICATI"
^DIC(19,10971,0)="ORB3 FORWARD SURROGATES^Forward Unprocessed Notification to Surrogates^^R^10958^^^^^^^"
^DIC(19,10971,1,0)="^^11^11^2960821^^"
^DIC(19,10971,1,1,0)="Number of days to hold notification before forwarding to recipient's"
^DIC(19,10971,1,2,0)="surrogates.  The maximum is 30 days.  If not indicated or zero, the "
^DIC(19,10971,1,3,0)="notification will not be forwarded.  For example, if a notification has a "
^DIC(19,10971,1,4,0)="value of 14 for this parameter, it will be forwarded to the supervisor of "
^DIC(19,10971,1,5,0)="each recipient who hasn't processed the notification after 14 days."
^DIC(19,10971,1,6,0)="Determination of recipients who have not processed the notification and"
^DIC(19,10971,1,7,0)="who their supervisors are is made by the Kernel Alert Utility. It will "
^DIC(19,10971,1,8,0)="not be forwarded to supervisors of recipients who have processed the "
^DIC(19,10971,1,9,0)="alert within 14 days.  If the value of this parameter is zero or "
^DIC(19,10971,1,10,0)="non-existent, the alert/notification will never be forwarded."
^DIC(19,10971,1,11,0)="[Note:  This option may not be available until late alpha testing.]"
^DIC(19,10971,25)="FSURR^ORB3MGR1"
^DIC(19,10971,"U")="FORWARD UNPROCESSED NOTIFICATI"
^DIC(19,10973,0)="ORB3 REC ERASE NOTIFICATIONS^Erase All of My Notifications^^R^11720^^^^^^^"
^DIC(19,10973,1,0)="^19.06^1^1^3000516^^^"
^DIC(19,10973,1,1,0)="Erase all notifications for the current User."
^DIC(19,10973,25)="ERASE^ORB3REC"
^DIC(19,10973,"U")="ERASE ALL OF MY NOTIFICATIONS"
^DIC(19,10974,0)="ORB3 FLAGGED ORDERS BULLETIN^Send Flagged Orders Bulletin^^R^10958^^^^^^^"
^DIC(19,10974,1,0)="^^6^6^2960821^^^^"
^DIC(19,10974,1,1,0)="Enter 'yes' to send a bulletin when an order is flagged for clarification."
^DIC(19,10974,1,2,0)="'Yes' indicates a MailMan bulletin will be sent to the order's Current"
^DIC(19,10974,1,3,0)="Provider (usually the Ordering Provider) when the order is flagged for"
^DIC(19,10974,1,4,0)="clarification.  This parameter has no effect on the Flagged Orders"
^DIC(19,10974,1,5,0)="notification which is also triggered when an order is flagged for"
^DIC(19,10974,1,6,0)="clarification."
^DIC(19,10974,25)="FLGOB^ORB3MGR1"
^DIC(19,10974,"U")="SEND FLAGGED ORDERS BULLETIN"
^DIC(19,10975,0)="ORB3 REC PROCESSING FLAG^Enable/Disable My Notifications^^R^11720^^^^^^^"
^DIC(19,10975,1,0)="^19.06^4^4^3000516^^"
^DIC(19,10975,1,1,0)="Code indicating processing flag for the current User and selected"
^DIC(19,10975,1,2,0)="notification.  Users indicate a notification should not be processed for"
^DIC(19,10975,1,3,0)="them - except where indicated for that notification in ORB3 REGULAR"
^DIC(19,10975,1,4,0)="RECIPIENTS parameter."
^DIC(19,10975,25)="PFLAG^ORB3REC"
^DIC(19,10975,99)="56699,27097"
^DIC(19,10975,"U")="ENABLE/DISABLE MY NOTIFICATION"
^DIC(19,10977,0)="ORB3 REC FLG ORDERS BULLETIN^Send me a MailMan bulletin for Flagged Orders^^R^11720^^^^^^^"
^DIC(19,10977,1,0)="^19.06^6^6^3000516^^"
^DIC(19,10977,1,1,0)="Enter 'Yes' to send a bulletin when an order is flagged for clarification. "
^DIC(19,10977,1,2,0)="'Yes' indicates a MailMan bulletin will be sent to the order's Current"
^DIC(19,10977,1,3,0)="Provider (usually the Ordering Provider) when the order is flagged for"
^DIC(19,10977,1,4,0)="clarification.  This parameter has no effect on the Flagged Orders"
^DIC(19,10977,1,5,0)="notification which is also triggered when an order is flagged for"
^DIC(19,10977,1,6,0)="clarification."
^DIC(19,10977,25)="FLGOB^ORB3REC"
^DIC(19,10977,"U")="SEND ME A MAILMAN BULLETIN FOR"
^DIC(19,10978,0)="ORK PROCESSING FLAG^Enable/Disable an Order Check^^R^11712^^^^^^^"
^DIC(19,10978,1,0)="^^2^2^2960815^"
^DIC(19,10978,1,1,0)="Enter the code indicating the processing flag for the entity and order "
^DIC(19,10978,1,2,0)="check."
