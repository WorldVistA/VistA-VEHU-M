^DIC(19,13626,0)="PRSA FIND 8B-TOUR MISMATCH-SUP^Find Mismatched Normal and Tour Hours^^R^1^^^^^^y^"
^DIC(19,13626,1,0)="^19.06^12^12^3080312^^^"
^DIC(19,13626,1,1,0)="This option searches a pay period for employees with scheduled tour hours"
^DIC(19,13626,1,2,0)="that don't match the employee's 8B Normal Hours.  In some cases hours that"
^DIC(19,13626,1,3,0)="carry over from a two day tour on the last Saturday of the pay period "
^DIC(19,13626,1,4,0)="prior to the one being searched can be the source of the mismatch.  "
^DIC(19,13626,1,5,0)="Timecards for employees on this report cannot be certified until all"
^DIC(19,13626,1,6,0)="scheduled hours from midnight Saturday through midnight Saturday match the"
^DIC(19,13626,1,7,0)="8B Normal Hours.  Either the tour or 8B Normal Hours should be updated"
^DIC(19,13626,1,8,0)="through established processes for any employee appearing on this report "
^DIC(19,13626,1,9,0)="for an uncertified pay period.  Optionally, Tours of Duty and Tour Hours "
^DIC(19,13626,1,10,0)="can be displayed.  The Tour Hours column contains a total of any tour "
^DIC(19,13626,1,11,0)="hours that fall on that day.  So, two day tours will contribute hours to "
^DIC(19,13626,1,12,0)="both days on which they fall."
^DIC(19,13626,10.1)="Find Norm/Tour Mismatch"
^DIC(19,13626,25)="SUPERV^PRSA8BNH"
^DIC(19,13626,"U")="FIND MISMATCHED NORMAL AND TOU"
^DIC(19,13627,0)="PRSA FIND 8B-TOUR MISMATCH-FIS^Find Mismatched Normal and Tour Hours^^R^1^^^^^^^"
^DIC(19,13627,1,0)="^^12^12^3080305^"
^DIC(19,13627,1,1,0)="This option searches a pay period for employees with scheduled tour hours"
^DIC(19,13627,1,2,0)="that don't match the employee's 8B Normal Hours.  In some cases hours that"
^DIC(19,13627,1,3,0)="carry over from a two day tour on the last Saturday of the pay period "
^DIC(19,13627,1,4,0)="prior to the one being searched can be the source of the mismatch.  "
^DIC(19,13627,1,5,0)="Timecards for employees on this report cannot be certified until all"
^DIC(19,13627,1,6,0)="scheduled hours from midnight Saturday through midnight Saturday match the"
^DIC(19,13627,1,7,0)="8B Normal Hours.  Either the tour or 8B Normal Hours should be updated"
^DIC(19,13627,1,8,0)="through established processes for any employee appearing on this report "
^DIC(19,13627,1,9,0)="for an uncertified pay period.  Optionally, Tours of Duty and Tour Hours"
^DIC(19,13627,1,10,0)="can be displayed.  The Tour Hours column contains a total of any tour "
^DIC(19,13627,1,11,0)="hours that fall on that day.  So, two day tours will contribute hours to "
^DIC(19,13627,1,12,0)="both days on which they fall."
^DIC(19,13627,25)="PAYROLL^PRSA8BNH"
^DIC(19,13627,"U")="FIND MISMATCHED NORMAL AND TOU"
