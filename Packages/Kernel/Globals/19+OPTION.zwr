^DIC(19,12365,0)="XU USER ADD^New User Event^^X^10000000020^^^^^^^163^y^1"
^DIC(19,12365,1,0)="^^10^10^3030320^"
^DIC(19,12365,1,1,0)="This is a protocol to link other packages that want to know about a USER"
^DIC(19,12365,1,2,0)="ADD event. Other pachages can attach to this protocol option and they will"
^DIC(19,12365,1,3,0)="be called when a new USER is Added.  At the end of editing the user data"
^DIC(19,12365,1,4,0)="the protocol XU USER CHANGE will be called."
^DIC(19,12365,1,5,0)="DUZ will be the person that is running the adding the user option.  "
^DIC(19,12365,1,6,0)="XUIFN will point to the NEW PERSON file entry that has been added. "
^DIC(19,12365,1,7,0)="Returns selected file 200 data to XUSR(field name) array for New Person"
^DIC(19,12365,1,8,0)="components"
^DIC(19,12365,1,9,0)=" "
^DIC(19,12365,1,10,0)="Called from XUSERNEW by XUSERP."
