^DIC(19,6380,"U")="ELECTRONIC SIGNATURE BLOCK EDI"
^DIC(19,6381,0)="XU-486 MENU COPY^Copy the compiled menus from the print server^^A^1039^^^^^^^^^1"
^DIC(19,6381,1,0)="^^8^8^2920630^^"
^DIC(19,6381,1,1,0)="This option is just for the MSM 486 site that run Taskman only on the"
^DIC(19,6381,1,2,0)="print server and need to get up-dated compiled menus to the compute"
^DIC(19,6381,1,3,0)="servers."
^DIC(19,6381,1,4,0)=" "
^DIC(19,6381,1,5,0)="It should be scheduled to run after the menu tree rebuild has finished on"
^DIC(19,6381,1,6,0)="the print server. As distributed it only copies the compiled menus to a"
^DIC(19,6381,1,7,0)="UCI named VAH on compute servers named CSA,CSB,..."
^DIC(19,6381,1,8,0)="It uses %RCR to copy the data."
^DIC(19,6381,20)="S SYS=""CS"" F  S SYS=$O(^%ZIS(14.5,""B"",SYS)) Q:SYS'[""CS""  S UCI=""VAH"",%X=""^XUTL(""""XQO"""","",%Y=""^[UCI,SYS]XUTL(""""XQO"""","",%=$E(%Y,1,$L(%Y)-1)_"")"" X ""K @% D %XY^%RCR"""
^DIC(19,6381,99)="55591,36509"
^DIC(19,6381,"U")="COPY THE COMPILED MENUS FROM T"
^DIC(19,6382,0)="ENBCUPLD^Upload Data From Portable Bar Code Reader^^R^.5^^^^^^^"
^DIC(19,6382,1,0)="^^2^2^2900614^^^"
^DIC(19,6382,1,1,0)="Calls a routine that causes a portable bar code reader to upload its"
^DIC(19,6382,1,2,0)="data to DHCP."
^DIC(19,6382,25)="ENCTREAD"
^DIC(19,6382,"U")="UPLOAD DATA FROM PORTABLE BAR "
^DIC(19,6383,0)="ENBCSP WING^WING Bar Code Labels^^R^.5^^^^^^^"
^DIC(19,6383,1,0)="^^2^2^2900416^"
^DIC(19,6383,1,1,0)="Prints bar code LOCATION LABELS for all rooms in a specified WING,"
