^DIC(19,16827,1,1,0)="This menu contains options to manage list rules and patient lists."
^DIC(19,16827,1,2,0)="Cloned from ""PXRM PATIENT LIST MENU"" option."
^DIC(19,16827,3)=""
^DIC(19,16827,10,0)="^19.01IP^2^2"
