^DIC(19,14222,0)="DGPF LOCAL TO NATIONAL CONVERT^Convert Local HRMH PRF to National^^A^1^^^^^^^114^^1"
^DIC(19,14222,1,0)="^19.06^4^4^3120109^^"
^DIC(19,14222,1,1,0)="This option will initiate the conversion of the local category 2 "
^DIC(19,14222,1,2,0)="suicide Prevention Patient Record Flag to a National  category 1"
^DIC(19,14222,1,3,0)="flag.  This option will allow the selection of a report only mode"
^DIC(19,14222,1,4,0)="or allow the running of the actual conversion of local to national."
^DIC(19,14222,20)="D EN^DGPFCNV"
^DIC(19,14222,"U")="CONVERT LOCAL HRMH PRF TO NATI"
^DIC(19,14223,0)="SD MH PROACTIVE BGJ REPORT^High Risk MH Proactive Nightly Report^^R^1^^^^^^^16"
^DIC(19,14223,1,0)="^19.06^23^23^3121115^^^^"
^DIC(19,14223,1,1,0)="This option should be used if you need to re-create"
^DIC(19,14223,1,2,0)="the same report that is created by the scheduled"
^DIC(19,14223,1,3,0)="SDAM BACKGROUND job after midnight each night. "
^DIC(19,14223,1,4,0)="The option lists the scheduled appointments for"
^DIC(19,14223,1,5,0)="Mental Health Clinics for today."
^DIC(19,14223,1,6,0)=" "
^DIC(19,14223,1,7,0)="**This report should not be scheduled to run"
^DIC(19,14223,1,8,0)="nightly as it is kicked off by the"
^DIC(19,14223,1,9,0)="Scheduling nightly background Job (SDAM BACKGROUND JOB)"
^DIC(19,14223,1,10,0)="that should already be scheduled to run nightly on your system. "
^DIC(19,14223,1,11,0)=" "
^DIC(19,14223,1,12,0)="This report is sent in a mail message to the members"
^DIC(19,14223,1,13,0)="of the SD MH NO SHOW NOTIFICATION mail group."
^DIC(19,14223,1,14,0)=" "
^DIC(19,14223,1,15,0)="Future appointments will list on this report."
^DIC(19,14223,1,16,0)="The number of days worth of future appointments"
^DIC(19,14223,1,17,0)="that will list is defaulted to 30 days in the future."
^DIC(19,14223,1,18,0)="Parameter SD MH PROACTIVE  DAYS has been added"
^DIC(19,14223,1,19,0)="to store the number of days to list future"
^DIC(19,14223,1,20,0)="appointments for.  This parameter can be edited"
^DIC(19,14223,1,21,0)="by the user by using the option "
^DIC(19,14223,1,22,0)="[ XPAR EDIT PARAMETER] Edit Parameter Values,"
^DIC(19,14223,1,23,0)="changing the System value."
^DIC(19,14223,25)="EN^SDMHPRO"
^DIC(19,14223,"U")="HIGH RISK MH PROACTIVE NIGHTLY"
^DIC(19,14224,0)="SD MH PROACTIVE AD HOC REPORT^High Risk MH Proactive Adhoc Report^^R^1^^^^^^^16^^"
^DIC(19,14224,1,0)="^^2^2^3110927^"
^DIC(19,14224,1,1,0)="This report will list the appoinments for a date range for patients with a"
^DIC(19,14224,1,2,0)="high risk for mental health patient record flag."
^DIC(19,14224,20)=""
^DIC(19,14224,25)="EN^SDMHAP"
^DIC(19,14224,"U")="HIGH RISK MH PROACTIVE ADHOC R"
^DIC(19,14225,0)="OR QO CASE REPORT^Quick Order Mixed-Case Report^^R^1^^^^^^^"
^DIC(19,14225,1,0)="^19.06^8^8^3120719^^"
^DIC(19,14225,1,1,0)="This report identifies quick orders that potentially had the DRUG name"
^DIC(19,14225,1,2,0)="edited such that when the quick order is loaded in CPRS the dosage that is"
^DIC(19,14225,1,3,0)="saved with the quick order does not match any of the dosages available for"
^DIC(19,14225,1,4,0)="selection in the list. This causes the dosage checks not to be able to be"
^DIC(19,14225,1,5,0)="performed correctly.  The edit to the drug that this specifically looks "
^DIC(19,14225,1,6,0)="for is a case change to the DRUG name.  If the name is changed so that it"
^DIC(19,14225,1,7,0)="contains different characters that are not just case changes, this report"
^DIC(19,14225,1,8,0)="will not identify them."
^DIC(19,14225,25)="CASE^ORQOREP"
^DIC(19,14225,"U")="QUICK ORDER MIXED-CASE REPORT"
^DIC(19,14226,0)="OR QO FREETEXT REPORT^Quick Order Free-Text Report^^R^1^^^^^^^"
^DIC(19,14226,1,0)="^^2^2^3120731^"
^DIC(19,14226,1,1,0)="This report identifies Medication Quick orders that have a free text "
^DIC(19,14226,1,2,0)="dosage that does not match exactly one of the Local Dosages from Pharmacy."
^DIC(19,14226,25)="DIFF^ORQOREP"
^DIC(19,14226,"U")="QUICK ORDER FREE-TEXT REPORT"
