^DIC(19,14693,0)="PSO CLINICAL ALERT ENTER/EDIT^Clinical Alert Enter/Edit^^R^11720^^^^^^^141"
^DIC(19,14693,1,0)="^^11^11^3180622^"
^DIC(19,14693,1,1,0)="This option provides Enter/Edit of Clinical Alerts multiple (#109) in"
^DIC(19,14693,1,2,0)="Pharmacy Patient file (#55)."
^DIC(19,14693,1,3,0)=" "
^DIC(19,14693,1,4,0)="This option was developed for alerting pharmacy personnel of important"
^DIC(19,14693,1,5,0)="information (i.e., Drug to Drug interactions on research programs that the"
^DIC(19,14693,1,6,0)="normal software would not know about, etc.)."
^DIC(19,14693,1,7,0)=" "
^DIC(19,14693,1,8,0)="This option is only assigned to Pharmacy Supervisors.  The supervisor"
^DIC(19,14693,1,9,0)="enters the clinical alert and then this information is displayed in the"
^DIC(19,14693,1,10,0)="appropriate places.  Someone filling an order (or RX) would view this"
^DIC(19,14693,1,11,0)="information beforehand and act accordingly."
^DIC(19,14693,25)="ENTER^PSODEMSB"
^DIC(19,14693,99.1)="64729,30553"
^DIC(19,14693,"U")="CLINICAL ALERT ENTER/EDIT"
^DIC(19,14694,0)="PSB RPT RESP THERAPY MEDS^Report for Respiratory Therapy Medications^^R^11720^^^^^^^533^^"
^DIC(19,14694,1,0)="^^3^3^3180222^"
^DIC(19,14694,1,1,0)="This report is used by Respiratory Therapists to track "
^DIC(19,14694,1,2,0)="admininstration dates and times of medications for patients who need"
^DIC(19,14694,1,3,0)="respiratory therapy treatments."
^DIC(19,14694,20)=""
^DIC(19,14694,25)="EN1^PSBMMRB"
^DIC(19,14694,99)="64701,57138"
^DIC(19,14694,"U")="REPORT FOR RESPIRATORY THERAPY"
^DIC(19,14695,0)="HDISDOSERVER^HDI SDO ORDER SERVER^^S^11720^^^^^^^559"
^DIC(19,14695,1,0)="^19.06^2^2^3171227^^^^"
^DIC(19,14695,1,1,0)="This HDI server is for users to collect SDO's associated to items"
^DIC(19,14695,1,2,0)="in the orderable items file (#101.43) by way of a mailman message."
^DIC(19,14695,25)="HDISDSR"
^DIC(19,14695,99.1)="64671,40423"
^DIC(19,14695,220)="^R^^^Y"
^DIC(19,14695,"U")="HDI SDO ORDER SERVER"
^DIC(19,14696,0)="HDISDO REQUEST SDO^HDI REQUEST SDO^^R^11720^^^^^^^559"
^DIC(19,14696,1,0)="^19.06^4^4^3180626^^^"
^DIC(19,14696,1,1,0)="This option allows users to request Standard Development Organization (SDO)"
^DIC(19,14696,1,2,0)="values from the ORDERABLE ITEMS File (#101.43) for Laboratory."
^DIC(19,14696,1,3,0)="The option will call the HDISDO API with the request and display the"
^DIC(19,14696,1,4,0)="results."
^DIC(19,14696,25)="EN^HDISDOL"
^DIC(19,14696,99.1)="64671,40414"
^DIC(19,14696,"U")="HDI REQUEST SDO"
^DIC(19,14697,0)="HDISDO API^HDI SDO API^^R^11720^^^^^^^559"
^DIC(19,14697,1,0)="^19.06^15^15^3180626^^^"
^DIC(19,14697,1,1,0)="This option collects the SDO values associated to items in the ODERABLE"
^DIC(19,14697,1,2,0)="ITEMS File (#101.43) for the Laboratory and returns the results in an "
^DIC(19,14697,1,3,0)="XML style format."
^DIC(19,14697,1,4,0)="Calling Parameters:"
^DIC(19,14697,1,5,0)="Area: L for Laboratory"
^DIC(19,14697,1,6,0)="Lookup value: this can be ALL for all items for the area, a partial match"
^DIC(19,14697,1,7,0)="name for a value for the area, or the IEN of a specific item for that"
^DIC(19,14697,1,8,0)="area."
^DIC(19,14697,1,9,0)="Return variable: this is the variable that the results will be returned in."
^DIC(19,14697,1,10,0)="it is suggested that the return variable be associated to a global."
^DIC(19,14697,1,11,0)="example - RET=""^TMP(""""SDORET"""",$J)"" use RET when calling the option."
^DIC(19,14697,1,12,0)="Error: (optional) if an error variable is passed in and if an error is"
^DIC(19,14697,1,13,0)="encountered then the error variable will be populated."
^DIC(19,14697,1,14,0)="Count: (optional) if a variable is passed in counts for select items will"
^DIC(19,14697,1,15,0)="be returned. The items counted will vary depending on the Area."
^DIC(19,14697,25)="HDISDOC"
^DIC(19,14697,99.1)="64671,40130"
^DIC(19,14697,"U")="HDI SDO API"
^DIC(19,14698,0)="GMRC RPT ADMIN RELEASE CONSULT^Administratively Released Consults by Title^^R^11720^^^^^^n^294^^^^^1"
