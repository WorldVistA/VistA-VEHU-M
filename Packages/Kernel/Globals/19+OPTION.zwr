^DIC(19,6934,1,1,0)="Use this option to remove patients from a team list."
^DIC(19,6934,20)="D DELPT^ORLPL"
^DIC(19,6934,"U")="REMOVE             PATIENTS FR"
^DIC(19,6935,0)="OR RESULTS REPORTING^Results Reporting Menu^^A^11712^^^^^^^170^^1"
^DIC(19,6935,1,0)="^^4^4^2920226^^^"
^DIC(19,6935,1,1,0)="This action type option sets up and calls MAIN^ORSDVR to allow selection"
^DIC(19,6935,1,2,0)="of multiple patients, followed by multiple reports.  It then asks any"
^DIC(19,6935,1,3,0)="parameters associated with the selected reports and gets a device to"
^DIC(19,6935,1,4,0)="which the reports will be printed by patient."
^DIC(19,6935,20)="D EN^ORPRS07"
^DIC(19,6935,"U")="RESULTS REPORTING MENU"
^DIC(19,6937,0)="ORB NOT COORD MENU^Notification Mgmt Menu^^M^10000000020^^^^^^^^^^"
