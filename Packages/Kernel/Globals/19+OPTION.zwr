^DIC(19,6762,0)="PSD NURSE TRANSFER GS^Transfer Green Sheet and Drug to another NAOU^^R^11595^^^^^^^276"
^DIC(19,6762,1,0)="^^7^7^2920916^^^^"
^DIC(19,6762,1,1,0)="This option provides nurses the ability to transfer Controlled"
^DIC(19,6762,1,2,0)="Substances drugs and their associated Green Sheet to another"
^DIC(19,6762,1,3,0)="NAOU.  The transferring of Controlled Substances drugs between"
^DIC(19,6762,1,4,0)="NAOUs requires two processing steps."
^DIC(19,6762,1,5,0)="  "
^DIC(19,6762,1,6,0)=" Step 1 - Transfer Green Sheet and Drug to another NAOU"
^DIC(19,6762,1,7,0)=" Step 2 - From an NAOU - Receive Green Sheet Transfer & Drug"
^DIC(19,6762,25)="PSDNTF"
^DIC(19,6762,"U")="TRANSFER GREEN SHEET AND DRUG "
^DIC(19,6763,0)="PSD NURSE REC TRANSFER GS^Receive Green Sheet & Drug from another NAOU^^R^11595^^^^^^^276"
