^DIC(19,6962,0)="GMRC SETUP REQUEST SERVICES^Set up Consult Services^^R^11712^^^^^^^^^^"
^DIC(19,6962,1,0)="^^9^9^2970924^^^^"
^DIC(19,6962,1,1,0)="This option is used to setup the Hospital hierarchy of services and"
^DIC(19,6962,1,2,0)="specialties.  Each service/specialty defined in this file may be"
^DIC(19,6962,1,3,0)="setup to have a consult print at its own service printer when the"
^DIC(19,6962,1,4,0)="consult is entered and signed using the ""Add orders"" menus in OE/RR."
^DIC(19,6962,1,5,0)="  "
^DIC(19,6962,1,6,0)="Teams of clinicians may also be associated with each Service/Specialty."
^DIC(19,6962,1,7,0)="The team members will be notified when a new consult is ordered"
^DIC(19,6962,1,8,0)="from their service/specialty."
^DIC(19,6962,1,9,0)="  "
