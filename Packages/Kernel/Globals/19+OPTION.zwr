^DIC(19,14282,"U")="FILE 60 AUDIT MANAGER"
^DIC(19,14283,0)="LRJ QUICK ORDER CHECK^LRJ QUICK ORDER SEARCH^^R^1^^^^^^^"
^DIC(19,14283,1,0)="^19.06^4^4^3130502^^"
^DIC(19,14283,1,1,0)="This option should be scheduled. It will search the Lab 60 audit for "
^DIC(19,14283,1,2,0)="tests where certain fields have been edited. If a test is found where "
^DIC(19,14283,1,3,0)="those fields have been changed, the routine will call a CPRS API to "
^DIC(19,14283,1,4,0)="determine if they are included in a quick order."
^DIC(19,14283,25)="EN^LRJSAUO"
^DIC(19,14283,"U")="LRJ QUICK ORDER SEARCH"
^DIC(19,14284,0)="LA7TASK SCT MAPPINGS CHECK^Check SNOMED CT Mappings Against the Lexicon^^R^1^^^^^^^480"
^DIC(19,14284,1,0)="^^12^12^3121231^"
^DIC(19,14284,1,1,0)="This option checks the SNOMED CT mappings against the Lexicon for "
^DIC(19,14284,1,2,0)="exceptions (e.g., a code is inactive). It checks the following files:"
^DIC(19,14284,1,3,0)=" - TOPOGRAPHY FIELD (#61)"
^DIC(19,14284,1,4,0)=" - ETIOLOGY FIELD (#61.2)"
^DIC(19,14284,1,5,0)=" - COLLECTION SAMPLE (#62)"
^DIC(19,14284,1,6,0)=" "
^DIC(19,14284,1,7,0)="If any exceptions are found:"
^DIC(19,14284,1,8,0)=" - The SCT CODE STATUS field (#21) for the entry will be updated to "
^DIC(19,14284,1,9,0)="   'Error'."
^DIC(19,14284,1,10,0)=" - A HDI exception alert will be sent to Standards & Terminology Services."
^DIC(19,14284,1,11,0)=" - A MailMan message will be sent to the G.LMI and G.LAB MESSAGING Mail"
^DIC(19,14284,1,12,0)="   Groups with a list of the exceptions found."
^DIC(19,14284,25)="EN^LA7CHKF1"
^DIC(19,14284,200.9)="y"
^DIC(19,14284,"U")="CHECK SNOMED CT MAPPINGS AGAIN"
