^DIC(19,15365,1,2,0)="were built for orderable items that are considered supply items, to use"
^DIC(19,15365,1,3,0)="the PSO SUPPLY dialog."
^DIC(19,15365,1,4,0)="Cloned from ""OR SUPPLY QO CONVERSION"" option."
^DIC(19,15365,3)=""
^DIC(19,15365,25)="SUPPLYQO^ORSPUTIL"
^DIC(19,15365,"U")="CONVERT SUPPLY QUICK ORDERS"
