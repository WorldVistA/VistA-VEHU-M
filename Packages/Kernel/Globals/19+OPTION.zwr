^DIC(19,8397,0)="LRCAP CODE ADD^Add a new WKLD code to file^^R^.5^LRLIASON^^^^^^26"
^DIC(19,8397,1,0)="^^15^15^2940331^^^^"
^DIC(19,8397,1,1,0)="  This option allow one create a new WKLD code. The WKLD CODE file (#64)"
^DIC(19,8397,1,2,0)="can not be edited directly. New codes (those requiring suffixes) which"
^DIC(19,8397,1,3,0)="are not in the distributed file, can be added with this option."
^DIC(19,8397,1,4,0)="  Code are automatically generated for those procedures which are verified."
^DIC(19,8397,1,5,0)="However if a code needs to be created before verification, use this"
^DIC(19,8397,1,6,0)="option."
^DIC(19,8397,1,7,0)="  You will be asked for the Procedure first. These choices come from"
^DIC(19,8397,1,8,0)="WKLD CODE file (#64). Then you will be asked for the Suffix code, these"
^DIC(19,8397,1,9,0)="come from WKLD CODE SUFFIX file (#64.2). If this code already exists, the"
^DIC(19,8397,1,10,0)="information will be displayed."
^DIC(19,8397,1,11,0)="  If it does not exist the option will create a new entry for you and"
^DIC(19,8397,1,12,0)="display the new code data."
^DIC(19,8397,1,13,0)=" "
^DIC(19,8397,1,14,0)="   ONCE A WKLD CODE HAS BEEN CREATED, DO NOT DELETE IT."
^DIC(19,8397,1,15,0)="       REPEAT -- DO NOT DELETE."
^DIC(19,8397,25)="LRCAPV11"
^DIC(19,8397,"U")="ADD A NEW WKLD CODE TO FILE"
^DIC(19,8398,0)="LRAPW^Workload, anat path^^M^.5^^^^^^^26"
^DIC(19,8398,1,0)="^^1^1^2911230^^^"
^DIC(19,8398,1,1,0)="List of options for anatomic pathology workload"
^DIC(19,8398,10,0)="^19.01PI^4^4"
