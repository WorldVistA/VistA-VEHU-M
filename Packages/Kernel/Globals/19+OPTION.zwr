^DIC(19,9127,0)="DGPW PATIENT WRISTBAND PRINT^Print Patient Wristband^^R^.5^^^^^^^114^^"
^DIC(19,9127,1,0)="^^4^4^2950202^"
^DIC(19,9127,1,1,0)="This option allows the user to print a Patient Wristband.  The user"
^DIC(19,9127,1,2,0)="selects the patient's name.  It then looks at the ward the patient is"
^DIC(19,9127,1,3,0)="on, and determines from the division designated for the ward whether"
^DIC(19,9127,1,4,0)="the wristband will be printed."
^DIC(19,9127,20)=""
^DIC(19,9127,25)="EN^DGPWB"
^DIC(19,9127,"U")="PRINT PATIENT WRISTBAND"
^DIC(19,9128,0)="IB RX REPRINT REMINDER^Reprint Single Income Test Reminder Letter^^R^.5^^^^^^^192"
^DIC(19,9128,1,0)="^^6^6^2950621^"
^DIC(19,9128,1,1,0)="This option is used to generate an Income Test reminder letter"
^DIC(19,9128,1,2,0)="for a veteran who effective copay exemption is based upon income."
^DIC(19,9128,1,3,0)="When the letter is generated, the field REMINDER LETTER DATE"
^DIC(19,9128,1,4,0)="(#.16) in the BILLING EXEMPTIONS (#354.1) file will be updated,"
^DIC(19,9128,1,5,0)="for the exemption record which is the basis for sending the"
^DIC(19,9128,1,6,0)="reminder letter, with the current date."
^DIC(19,9128,25)="IBARXEL1"
^DIC(19,9128,"U")="REPRINT SINGLE INCOME TEST REM"
^DIC(19,9129,0)="GMTS MANAGER^Health Summary Overall Menu^^M^.5^^^^^^^"
^DIC(19,9129,1,0)="^^2^2^2950202^^^^"
^DIC(19,9129,1,1,0)="This manager menu includes the four primary menus, (Coordinators menu, "
