^DIC(19,13546,1,2,0)="the response that was returned.  This report displays or prints"
^DIC(19,13546,1,3,0)="information from the following files - BPS Transaction (#9002313.59) or"
^DIC(19,13546,1,4,0)="Log of Transaction (#9002313.57), BPS Claims (#9002313.02), and BPS"
^DIC(19,13546,1,5,0)="Responses (#9002313.03)."
^DIC(19,13546,20)=""
^DIC(19,13546,25)="EN^BPSRCRI"
^DIC(19,13546,"U")="ECME CLAIMS-RESPONSE INQUIRY"
