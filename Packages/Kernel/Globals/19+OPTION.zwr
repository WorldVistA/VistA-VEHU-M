^DIC(19,15878,1,0)="^19.06^3^3^3240328^^^"
^DIC(19,15878,1,1,0)="Allows users to enable or disable CPRS' ePCS functionality at the user "
^DIC(19,15878,1,2,0)="level."
^DIC(19,15878,1,3,0)="Cloned from ""OR EPCS USERS PARAMETER"" option."
