^DIC(19,14674,0)="RCTCSP STOP REACTIVATE REPORT^Cross-Servicing Stop Reactivate Report^^R^1^^^^^^^"
^DIC(19,14674,1,0)="^^7^7^3190503^"
^DIC(19,14674,1,1,0)="The Cross-Servicing Stop Reactivate Report lets the User run the report"
^DIC(19,14674,1,2,0)="either for Bills or for Debtors.  If Bill Level is selected, the report"
^DIC(19,14674,1,3,0)="lists the bills that have been stopped from Cross-Servicing, or "
^DIC(19,14674,1,4,0)="Reactivated, or Both.  If Debtor Level is selected, the report lists the "
^DIC(19,14674,1,5,0)="debtors that have been stopped from Cross-Servicing, or Reactivated, or "
^DIC(19,14674,1,6,0)="Both. The user may select a range of Debtors or all Debtors, and a range "
^DIC(19,14674,1,7,0)="of dates or all dates. Excel CSV output is also supported."
^DIC(19,14674,25)="EN^RCTCSP4"
^DIC(19,14674,"U")="CROSS-SERVICING STOP REACTIVAT"
^DIC(19,14675,0)="PRCAC ENTER EDIT REPAYMENT^Enter/Edit Repayment Plan^^A^11720^^^^^^^261^^1"
^DIC(19,14675,1,0)="^^1^1^3170213^"
^DIC(19,14675,1,1,0)="This option sets up a repayment plan for an AR Debtor. The plan can incorporate multiple bills."
^DIC(19,14675,20)="D ^PRCARPM"
^DIC(19,14675,"U")="ENTER/EDIT REPAYMENT PLAN"
^DIC(19,14676,0)="RCTCSP RECONCILIATION WORKLIST^Reconciliation List Manager^^R^11720^^^^^^^"
^DIC(19,14676,1,0)="^19.06^1^1^3170329^^^"
^DIC(19,14676,1,1,0)="List Manager for VistA AR Cross-servicing"
^DIC(19,14676,25)="EN^RCTCSWL"
^DIC(19,14676,"U")="RECONCILIATION LIST MANAGER"
^DIC(19,14677,0)="RCTCSP IAI REPORT^Treasury Cross-Servicing IAI Report^^R^11720^^^^^^^"
^DIC(19,14677,1,0)="^^4^4^3171016^"
^DIC(19,14677,1,1,0)="This report displays a record of current VHA bills at Treasury. It is a "
^DIC(19,14677,1,2,0)="tool that can be used to identify bills erroneously"
^DIC(19,14677,1,3,0)="listed in a referral status in VistA when reconciled with the Print "
^DIC(19,14677,1,4,0)="Cross-Servicing Report."
^DIC(19,14677,25)="IAIRPT^RCTCSP5"
^DIC(19,14677,"U")="TREASURY CROSS-SERVICING IAI R"
^DIC(19,14678,0)="RCDPE PAYER IDENTIFY^Identify Payers^^R^11720^^^^^^^261"
^DIC(19,14678,1,0)="^19.06^7^7^3170822^^"
^DIC(19,14678,1,1,0)="The option displays a list of payers from the PAYER EXCLUSION file "
^DIC(19,14678,1,2,0)="(#344.6) and allows an end user with the appropriate security access to "
^DIC(19,14678,1,3,0)="flag entries as Pharmacy and/or Tricare. Entries can be either, neither "
^DIC(19,14678,1,4,0)="or both.  The option allows the user to filter the list by date added.  "
^DIC(19,14678,1,5,0)="This is important as entries are added to the file automatically by the "
^DIC(19,14678,1,6,0)="nightly process.  A user needs to be able to see what entries were "
^DIC(19,14678,1,7,0)="added recently and if they need to be flagged."
^DIC(19,14678,25)="EN^RCDPEP"
^DIC(19,14678,"U")="IDENTIFY PAYERS"
^DIC(19,14679,0)="PSO EPHARMACY PATIENT COMMENTS^ePharmacy Patient Comment^^R^11720^PSO EPHARMACY SITE MANAGER^^^^^^141"
^DIC(19,14679,1,0)="^^2^2^3171207^"
^DIC(19,14679,1,1,0)="This option allows entry of Patient Billing comments and will require the "
^DIC(19,14679,1,2,0)="PSO EPHARMACY SITE MANAGER key."
^DIC(19,14679,25)="PSOPTC0"
^DIC(19,14679,99)="64635,57744"
^DIC(19,14679,"U")="EPHARMACY PATIENT COMMENT"
^DIC(19,14680,0)="GMTS PS MED RECON CONFIG CHECK^Check Medication Reconciliation Configuration^^R^11720^^^^^^^160"
^DIC(19,14680,1,0)="^^3^3^3160408^"
^DIC(19,14680,1,1,0)="This option allows a site to confirm that the setup of Health Summary "
^DIC(19,14680,1,2,0)="Types is consistent with the intent of the Medication Reconciliation "
^DIC(19,14680,1,3,0)="approach for use as the 'Essential Med List for Review'."
^DIC(19,14680,25)="EN1^GMTSPSCK"
^DIC(19,14680,"U")="CHECK MEDICATION RECONCILIATIO"
^DIC(19,14681,0)="ECX RAD SOURCE AUDIT CPT^Radiology (RAD) Extract CPT Code Audit^^R^11720^^^^^^^"
^DIC(19,14681,1,0)="^^14^14^3180405^"
^DIC(19,14681,1,1,0)="This option will produce a report that identifies records in the "
^DIC(19,14681,1,2,0)="RADIOLOGY EXTRACT file (#727.814) that have a CPT code that is either"
^DIC(19,14681,1,3,0)="missing or was inactive on the date of the procedure."
^DIC(19,14681,1,4,0)=" "
^DIC(19,14681,1,5,0)="The user will select a specific extract log number and the report will "
^DIC(19,14681,1,6,0)="review all records contained in the extract for CPT code issues."
^DIC(19,14681,1,7,0)=" "
^DIC(19,14681,1,8,0)="Records listed on this report indicate a problem with the procedure's CPT "
^DIC(19,14681,1,9,0)="code in the radiology package and should be resolved prior to transmitting"
^DIC(19,14681,1,10,0)="the extract."
^DIC(19,14681,1,11,0)=" "
^DIC(19,14681,1,12,0)="Once changes are made in the radiology package, the extract for this time "
^DIC(19,14681,1,13,0)="frame will need to be run again to ensure that any changes made are "
^DIC(19,14681,1,14,0)="captured in the extract."
^DIC(19,14681,25)="ECXRACPT"
^DIC(19,14681,"U")="RADIOLOGY (RAD) EXTRACT CPT CO"
^DIC(19,14682,0)="ECXBSC^Extract Stop Code Validity Report^^R^11720^^^^^^^"
^DIC(19,14682,1,0)="^19.06^6^6^3180614^^"
^DIC(19,14682,1,1,0)="This report will allow the user to select an extract from either the "
^DIC(19,14682,1,2,0)="CLI, ECS, or RAD systems and will then review the stop code associated"
^DIC(19,14682,1,3,0)="with each record in the extract."
^DIC(19,14682,1,4,0)=" "
^DIC(19,14682,1,5,0)="If the stop code was inactive/invalid at the time of service for the "
^DIC(19,14682,1,6,0)="selected extract and record then it will be included on the report."
^DIC(19,14682,25)="ECXBSC"
^DIC(19,14682,"U")="EXTRACT STOP CODE VALIDITY REP"
