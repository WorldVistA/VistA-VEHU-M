^DIC(19,3087,0)="ENAR-ASSEMBLE^Find & Assemble Records^^R^.5^^^^^^^"
^DIC(19,3087,1,0)="^^10^10^2960222^"
^DIC(19,3087,1,1,0)="Searches the database and finds the individual records to be archived,"
^DIC(19,3087,1,2,0)="after which it moves them to an archive global and simultaneously purges"
^DIC(19,3087,1,3,0)="them from disk. The user is asked for record type, station number, and"
^DIC(19,3087,1,4,0)="sort parameters. Records may be archived for an entire fiscal year, or"
^DIC(19,3087,1,5,0)="a specific quarter. Completed work orders may be archived by shop (all"
^DIC(19,3087,1,6,0)="shops, one shop, or all shops but one)."
^DIC(19,3087,1,7,0)="Since this function actually purges data from disk, you should backup"
^DIC(19,3087,1,8,0)="your system before executing ""Find and Assemble Records"". Users should"
^DIC(19,3087,1,9,0)="be kept off the system until ""Find and Assemble"" and ""Archive and Verify"""
^DIC(19,3087,1,10,0)="have run to completion."
^DIC(19,3087,25)="G^ENAR"
^DIC(19,3087,"U")="FIND & ASSEMBLE RECORDS"
^DIC(19,3088,0)="ENAR-ARCHIVE^Archive & Verify Records^^R^.5^^^^^^^"
^DIC(19,3088,1,0)="^^3^3^2960222^"
^DIC(19,3088,1,1,0)="Moves a collection of records (archive set) from the archive global"
^DIC(19,3088,1,2,0)="to tape. This function should be executed immediately after ""Find and"
^DIC(19,3088,1,3,0)="Assemble Records""."
^DIC(19,3088,25)="A^ENAR"
^DIC(19,3088,"U")="ARCHIVE & VERIFY RECORDS"
^DIC(19,3089,0)="ENAR-DELETE^Delete Archive Global^^R^.5^^^^^^^"
^DIC(19,3089,1,0)="^^6^6^2960222^"
^DIC(19,3089,1,1,0)="Kills the archive global, which may be thought of as a temporary storage"
^DIC(19,3089,1,2,0)="area. The archive global holds records in the process of being archived,"
^DIC(19,3089,1,3,0)="as well as records which have been recalled from an archive tape for"
^DIC(19,3089,1,4,0)="inspection via File Manager. ""Delete Archive Global"" should be executed"
^DIC(19,3089,1,5,0)="after ""Archive and Verify"" and after ""Recall Archive Global"" (once the"
^DIC(19,3089,1,6,0)="recalled records have been inspected and/or printed)."
^DIC(19,3089,25)="D^ENAR"
^DIC(19,3089,"U")="DELETE ARCHIVE GLOBAL"
^DIC(19,3090,0)="ENAR-RECALL^Recall Archive Global^^R^.5^^^^^^^"
^DIC(19,3090,1,0)="^^3^3^2960222^"
^DIC(19,3090,1,1,0)="Restores records from an archive tape into the archive global, where"
^DIC(19,3090,1,2,0)="they may be examined via File Manager. User may recall an entire tape"
^DIC(19,3090,1,3,0)="or search a tape for a specific record."
^DIC(19,3090,20)=""
^DIC(19,3090,25)="R^ENAR"
^DIC(19,3090,"U")="RECALL ARCHIVE GLOBAL"
^DIC(19,3091,0)="ENAR-LOG^Review Activity Log^^R^.5^^^^^^^"
^DIC(19,3091,1,0)="^^2^2^2960222^"
^DIC(19,3091,1,1,0)="Displays a chronological listing of everything that has been done with"
^DIC(19,3091,1,2,0)="a given archive set."
^DIC(19,3091,25)="L^ENAR"
^DIC(19,3091,"U")="REVIEW ACTIVITY LOG"
