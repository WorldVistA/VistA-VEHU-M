^DIC(19,2667,"U")="BILL STATUS REPORT"
^DIC(19,2668,0)="IB CANCEL BILL^Cancel Bill^^R^.5^IB AUTHORIZE^^^^^^192"
^DIC(19,2668,1,0)="^^5^5^2930905^^^^"
^DIC(19,2668,1,1,0)="This option allows the user to cancel a bill. A mandatory"
^DIC(19,2668,1,2,0)="comment field exists to document the reason for cancellation,"
^DIC(19,2668,1,3,0)="and a log is maintained to audit responsible user and date/time"
^DIC(19,2668,1,4,0)="bill is cancelled. A bulletin is sent to the billing supervisor"
^DIC(19,2668,1,5,0)="each time a bill is cancelled."
^DIC(19,2668,20)=""
^DIC(19,2668,25)="4^IBCMENU"
^DIC(19,2668,"U")="CANCEL BILL"
