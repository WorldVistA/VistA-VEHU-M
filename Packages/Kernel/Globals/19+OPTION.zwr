^DIC(19,6232,1,0)="^^1^1^2930712^^^^"
^DIC(19,6232,1,1,0)="List of Veteran discharges by division that are billable."
^DIC(19,6232,25)="INPDIS^IBCONSC"
^DIC(19,6232,"U")="VETERANS W/INSURANCE AND DISCH"
^DIC(19,6233,0)="IB BACKGRND VET DISCHS W/INS^Background Vet. Patients with Discharges and Ins^^R^.5^^^^^^^192"
^DIC(19,6233,1,0)="^^2^2^2940207^"
^DIC(19,6233,1,1,0)="This option may be set to be queued once per week to run and generate "
^DIC(19,6233,1,2,0)="a list of Veterans with Insurance and Discharges."
^DIC(19,6233,25)="EN^IBCONS1"
^DIC(19,6233,"U")="BACKGROUND VET. PATIENTS WITH "
^DIC(19,6234,0)="IB OUTPUT CONTINUOUS PATIENTS^Patient Currently Cont. Hospitalized since 1986^^R^.5^^^^^^^192"
^DIC(19,6234,1,0)="^^2^2^2920304^^^"
^DIC(19,6234,1,1,0)="This option is a list of current inpatients continuously hospitalized"
^DIC(19,6234,1,2,0)="at the same level of care since 1986."
^DIC(19,6234,25)="IBOBCR6"
^DIC(19,6234,"U")="PATIENT CURRENTLY CONT. HOSPIT"
^DIC(19,6235,0)="IB OUTPUT MOST COMMON OPT CPT^Most Commonly used Outpatient CPT Codes^^R^11594^^^^^^^192"
^DIC(19,6235,1,0)="^^3^3^2960523^^^^"
^DIC(19,6235,1,1,0)="This option will list the most common Ambulatory Procedures and "
^DIC(19,6235,1,2,0)="Ambulatory Surgeries performed in a date range for a given set of clinics."
^DIC(19,6235,1,3,0)="This can be used to help build the CPT Check-off Sheets."
^DIC(19,6235,25)="IBOCNC"
^DIC(19,6235,"U")="MOST COMMONLY USED OUTPATIENT "
^DIC(19,6236,0)="IB OUTPUT INPTS WITHOUT INS^Inpatients w/Unknown or Expired Insurance^^R^.5^^^^^^^192"
^DIC(19,6236,1,0)="^^3^3^2920604^^^"
^DIC(19,6236,1,1,0)="This option will produce a list of either current inpatients or admissions"
^DIC(19,6236,1,2,0)="for a date range where the patient has either unknown insurance or the "
^DIC(19,6236,1,3,0)="insurance is expired."
^DIC(19,6236,25)="IBOUNP4"
^DIC(19,6236,"U")="INPATIENTS W/UNKNOWN OR EXPIRE"
^DIC(19,6237,0)="IB OUTPUT OPTS WITHOUT INS^Outpatients w/Unknown or Expired Insurance^^R^.5^^^^^^^192"
^DIC(19,6237,1,0)="^^2^2^2920604^^^"
