^DIC(19,14020,20)=""
^DIC(19,14020,25)="INTACT^PSSHRIT"
^DIC(19,14020,99.1)="61370,27253"
^DIC(19,14020,"U")="CHECK VENDOR DATABASE LINK"
^DIC(19,14021,0)="PSS CHECK PEPS SERVICES SETUP^Check PEPS Services Setup^^R^10000000216^^^^^^^517"
^DIC(19,14021,1,0)="^19.06^4^4^3110616^^"
^DIC(19,14021,1,1,0)="This option provides the ability  to check and validate that the link to the vendor "
^DIC(19,14021,1,2,0)="interface used for enhanced order checking is enabled and operational. "
^DIC(19,14021,1,3,0)="It also provides the ability to execute various order checks against the vendor "
^DIC(19,14021,1,4,0)="database to ensure that the database is installed and reachable."
^DIC(19,14021,25)="RUNTEST^PSSHRIT"
^DIC(19,14021,"U")="CHECK PEPS SERVICES SETUP"
^DIC(19,14022,0)="PSS PEPS SERVICES^PEPS Services^^M^10000000216^^^^^^^517"
^DIC(19,14022,10,0)="^19.01IP^4^4"
^DIC(19,14022,10,1,0)="14020^^1"
^DIC(19,14022,10,2,0)="14021^^2"
^DIC(19,14022,10,3,0)="14075^^3"
