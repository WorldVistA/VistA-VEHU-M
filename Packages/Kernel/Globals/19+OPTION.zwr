^DIC(19,14348,0)="IBCNH HPID NIF BATCH QUERY^Send HPID/OEID Batch Queries^^S^1^^^^^^n^192"
^DIC(19,14348,1,0)="^19.06^11^11^3141003^^^^"
^DIC(19,14348,1,1,0)="This option does not appear on any VistA user menu and is for one-time"
^DIC(19,14348,1,2,0)="use with IB*2.0*519.  Once the data extract from this patch has been"
^DIC(19,14348,1,3,0)="received and processed at the NIF, a VistA user will run this option to"
^DIC(19,14348,1,4,0)="retrieve the NIF ID's and HPID/OEID data from the NIF into their VISTA"
^DIC(19,14348,1,5,0)="system.  This option will kick off one HL7 message per insurance company."
^DIC(19,14348,1,6,0)="DO NOT run this option unless instructed to do so by FSC and DO NOT run"
^DIC(19,14348,1,7,0)="this option more than once."
^DIC(19,14348,1,8,0)="Running this option will set the HPID/OEID Active? flag in the IB SITE"
^DIC(19,14348,1,9,0)="PARAMETERS file to 1 for Active which will indicate to Vista that the"
^DIC(19,14348,1,10,0)="NIF is ready to send and receive Insurance Company HL7 updates to and"
^DIC(19,14348,1,11,0)="from your site."
^DIC(19,14348,25)="SERVER^IBCNHSRV"
^DIC(19,14348,220)="^R^^N^Y^N"
^DIC(19,14348,"U")="SEND HPID/OEID BATCH QUERIES"
