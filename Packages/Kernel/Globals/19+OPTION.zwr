^DIC(19,12748,0)="LREPIDATASERVER^LREPI TRANSMIT DATA SERVER^^S^10000000020^^^^^^^26"
^DIC(19,12748,1,0)="^19.06^6^6^3030403^^"
^DIC(19,12748,1,1,0)="This server allows the EPI program office to trigger retransmission "
^DIC(19,12748,1,2,0)="of monthly data or trigger extraction for a single day from sites."
^DIC(19,12748,1,3,0)="A mail group containing all sites allows a single message to trigger"
^DIC(19,12748,1,4,0)="the server at all sites in the mail group.  A message will be sent to the"
^DIC(19,12748,1,5,0)="mail group each time the server is triggered containing the name of the"
^DIC(19,12748,1,6,0)="person who triggered the server, their location, and the action initiated."
^DIC(19,12748,25)="LREPISV1"
^DIC(19,12748,220)="^R^^^^E"
^DIC(19,12748,"U")="LREPI TRANSMIT DATA SERVER"
^DIC(19,12749,0)="LREPI GENERATE REPORT/SP^Lab EPI Generate Local Report/Spreadsheet^^R^10000000020^^^^^^^26"
^DIC(19,12749,1,0)="^19.06^7^7^3040128^^^^"
^DIC(19,12749,1,1,0)="The job is automatically tasked after selecting the national EPI or local"
^DIC(19,12749,1,2,0)="pathogens, time period, segments/fields, report or spreadsheet type, and will"
^DIC(19,12749,1,3,0)="take approximately 2-3 hours to generate.  When the report or spreadsheet has"
^DIC(19,12749,1,4,0)="finished generating an alert is automatically sent to the user generating the"
^DIC(19,12749,1,5,0)="report or spreadsheet.   The report or spreadsheet can then be viewed on the"
^DIC(19,12749,1,6,0)="screen or printed using the new Lab EPI Print Local Report/Spreadsheet option."
^DIC(19,12749,1,7,0)="Note: NO data is transmitted to Austin when using this option "
^DIC(19,12749,10.1)=""
^DIC(19,12749,25)="LREPIRS"
^DIC(19,12749,"U")="LAB EPI GENERATE LOCAL REPORT/"
