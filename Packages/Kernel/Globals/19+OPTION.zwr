^DIC(19,17055,0)="EHM_ALL APPOINTMENT LIST^All Appointment List^^R^1^^^^^^^594"
^DIC(19,17055,1,0)="^^5^5^3240502^"
^DIC(19,17055,1,1,0)="This option provides a detailed list of all appointments that are not "
^DIC(19,17055,1,2,0)="cancelled, no-shows, checked in or checked out. The all appointment list "
^DIC(19,17055,1,3,0)="can be run for a single clinic (entry in the HOSPITAL LOCATION file "
^DIC(19,17055,1,4,0)="(#44)) or for all clinics.  Output is available as a formatted report or "
^DIC(19,17055,1,5,0)="as comma-delimited records."
^DIC(19,17055,25)="APPTLIST^EHMAPPT0"
^DIC(19,17055,"U")="ALL APPOINTMENT LIST"
^DIC(19,17056,0)="EHM_ALL APPOINTMENT SUMMARY^All Appointment Summary^^R^1^^^^^^^594"
^DIC(19,17056,1,0)="^^5^5^3240502^"
^DIC(19,17056,1,1,0)="This option provides a summary of all appointments that are not cancelled,"
^DIC(19,17056,1,2,0)="no-showed, checked in or checked out.  The all appointment summary can be "
^DIC(19,17056,1,3,0)="run for a single clinic (entry in the HOSPITAL LOCATION file (#44)) or "
^DIC(19,17056,1,4,0)="for all clinics. Output are counts of appointments by month and year and "
^DIC(19,17056,1,5,0)="by clinic."
^DIC(19,17056,25)="APPTSMRY^EHMAPPT0"
^DIC(19,17056,"U")="ALL APPOINTMENT SUMMARY"
^DIC(19,17057,0)="EHM_APPT REQUEST LIST^Appointment Request List^^R^1^^^^^^^594"
^DIC(19,17057,1,0)="^^3^3^3240502^"
^DIC(19,17057,1,1,0)="This option provides a detailed list of open appointment requests from the"
^DIC(19,17057,1,2,0)="SDEC APPOINTMENT REQUEST (#409.85), the SD WAIT LIST (#409.3) and the "
^DIC(19,17057,1,3,0)="RECALL REMINDERS (#403.5) files."
^DIC(19,17057,25)="RQSTLIST^EHMAPTRQ"
^DIC(19,17057,"U")="APPOINTMENT REQUEST LIST"
^DIC(19,17058,0)="EHM_APPT REQUEST SUMMARY^Appointment Request Summary^^R^1^^^^^^^594"
^DIC(19,17058,1,0)="^^3^3^3240423^"
^DIC(19,17058,1,1,0)="This option provides a summary of open appointment requests from the SDEC "
^DIC(19,17058,1,2,0)="APPOINTMENT REQUEST (#409.85), the SD WAIT LIST (#409.3) and the RECALL "
^DIC(19,17058,1,3,0)="REMINDERS (#403.5) files."
^DIC(19,17058,25)="SUMMARY^EHMAPTRQ"
^DIC(19,17058,"U")="APPOINTMENT REQUEST SUMMARY"
^DIC(19,17059,0)="EHM_ACTIVE CLINIC ADD/EDIT^Active Clinic Add/Edit^^R^1^^^^^^^594"
^DIC(19,17059,1,0)="^19.06^8^8^3240624^^"
^DIC(19,17059,1,1,0)="Use this option to exclude clinics from the ""Cleanup"" options.  This "
^DIC(19,17059,1,2,0)="option is used to populate the new EHRM ACTIVE CLINIC file (#1610). The "
^DIC(19,17059,1,3,0)="clinics entered in this file are clinics that are still used in VistA "
^DIC(19,17059,1,4,0)="post-conversion to Oracle Health. "
^DIC(19,17059,1,5,0)=" "
^DIC(19,17059,1,6,0)="These clinics will be excluded from the Converted Appointment Cleanup, "
^DIC(19,17059,1,7,0)="'Post-Conversion Appointment Cleanup' or 'Inactivate Converted Clinics' "
^DIC(19,17059,1,8,0)="options. "
^DIC(19,17059,25)="EDIT1610^EHMAPPT3"
^DIC(19,17059,"U")="ACTIVE CLINIC ADD/EDIT"
^DIC(19,17060,0)="EHM_ACTIVE CLINIC LIST^Active Clinic List^^P^1^^^^^^^594"
^DIC(19,17060,1,0)="^^6^6^3240423^"
^DIC(19,17060,1,1,0)="Use this option to list the clinics entered EHRM ACTIVE CLINIC file "
^DIC(19,17060,1,2,0)="(#1610) from the Active Clinic Add/Edit option. "
^DIC(19,17060,1,3,0)=" "
^DIC(19,17060,1,4,0)="These clinics will be excluded from the Converted Appointment Cleanup, "
^DIC(19,17060,1,5,0)="'Post-Conversion Appointment Cleanup' or 'Inactivate Converted Clinics' "
^DIC(19,17060,1,6,0)="options. "
^DIC(19,17060,60)="EHRM(1610,"
^DIC(19,17060,62)=0
^DIC(19,17060,63)=.01
^DIC(19,17060,64)=.01
^DIC(19,17060,67)="ACTIVE CLINIC LIST"
^DIC(19,17060,"U")="ACTIVE CLINIC LIST"
^DIC(19,17061,0)="EHM_INACTIVATE_CLINICS^Inactivate Converted Clinics^^R^1^^^^^^^594"
^DIC(19,17061,1,0)="^19.06^7^7^3240423^^^"
^DIC(19,17061,1,1,0)="This option inactivates clinics in converted environments.  The user "
^DIC(19,17061,1,2,0)="enters the date of conversion.  The HOSPITAL LOCATION (#44) file is "
^DIC(19,17061,1,3,0)="scanned for active clinics.  If they have no future appointments - or "
^DIC(19,17061,1,4,0)="only appointments marked ""converted"" - then they are inactivated."
^DIC(19,17061,1,5,0)=" "
^DIC(19,17061,1,6,0)="A summary of the number of clincs inactivated as well as those that could "
^DIC(19,17061,1,7,0)="not be inactivated is produced."
^DIC(19,17061,25)="INACTVAT^EHMAPPT1"
^DIC(19,17061,"U")="INACTIVATE CONVERTED CLINICS"
^DIC(19,17062,0)="EHM_ACTIVE APPOINTMENT LIST^Active Appointment List^^R^1^^^^^^^594"
^DIC(19,17062,1,0)="^^14^14^3240423^"
^DIC(19,17062,1,1,0)="This option will produce a detailed list of active appointments (not "
^DIC(19,17062,1,2,0)="cancelled) with an appointment date after the expected conversion date."
^DIC(19,17062,1,3,0)=" "
^DIC(19,17062,1,4,0)="The user is prompted for the prospective conversion date.  The report can"
^DIC(19,17062,1,5,0)="be run for all clinics,  a single clinic, or single stop code."
^DIC(19,17062,1,6,0)=" "
^DIC(19,17062,1,7,0)="Three (3) sort orders are available, and the report can run in a formatted"
^DIC(19,17062,1,8,0)="style or as a comma-delimited file for uploading. "
^DIC(19,17062,1,9,0)=" "
^DIC(19,17062,1,10,0)="In addition, the dental classification can be included or excluded on the "
^DIC(19,17062,1,11,0)="report."
^DIC(19,17062,1,12,0)=" "
^DIC(19,17062,1,13,0)="This report can be run pre-conversion and post-conversion to Oracle "
^DIC(19,17062,1,14,0)="Health."
^DIC(19,17062,25)="ACTVLIST^EHMAPPTR"
^DIC(19,17062,"U")="ACTIVE APPOINTMENT LIST"
^DIC(19,17063,0)="EHM_ACTIVE APPOINTMENT SUMMARY^Active Appointment Summary^^R^1^^^^^^^594"
^DIC(19,17063,1,0)="^^12^12^3240423^"
^DIC(19,17063,1,1,0)="This option produces a summary of the active appointments (not "
^DIC(19,17063,1,2,0)="cancelled) with an appointment date after the expected conversion date."
^DIC(19,17063,1,3,0)="The user is prompted for the prospective conversion date.  The list can be"
^DIC(19,17063,1,4,0)="run for all clinics, a single clinic or a single stop code.  Three (3)"
^DIC(19,17063,1,5,0)="sort orders are available, and the report can be output in formatted style"
^DIC(19,17063,1,6,0)="or as a comma-delimited file for uploading."
^DIC(19,17063,1,7,0)="      "
^DIC(19,17063,1,8,0)="In addition, the dental classification can be included or excluded on the "
^DIC(19,17063,1,9,0)="report."
^DIC(19,17063,1,10,0)=" "
^DIC(19,17063,1,11,0)="This report can be run pre-conversion and post-conversion to Oracle "
^DIC(19,17063,1,12,0)="Health."
^DIC(19,17063,25)="SUMMARY^EHMAPPTR"
^DIC(19,17063,"U")="ACTIVE APPOINTMENT SUMMARY"
^DIC(19,17064,0)="EHM_CONVERTED APPT CLEANUP^Converted Appointment Cleanup^^R^1^^^^^^^594"
^DIC(19,17064,1,0)="^19.06^3^3^3240520^^"
^DIC(19,17064,1,1,0)="Use this option to select all appointments created before the    "
^DIC(19,17064,1,2,0)="conversion date with appointment dates on or after the conversion date "
^DIC(19,17064,1,3,0)="and to mark them ""converted.""  (Bulk appointment cleanup)"
^DIC(19,17064,25)="CNVTDCLN^EHMAPPT1"
^DIC(19,17064,"U")="CONVERTED APPOINTMENT CLEANUP"
^DIC(19,17065,0)="EHM_MARK APPOINTMENT CONVERTED^Mark Appointment Converted^^R^1^^^^^^^594"
^DIC(19,17065,1,0)="^^3^3^3240423^"
^DIC(19,17065,1,1,0)="Use this option to select a single appointment created before the    "
^DIC(19,17065,1,2,0)="conversion date with appointment dates on or after the conversion date "
^DIC(19,17065,1,3,0)="and to mark it ""converted."""
^DIC(19,17065,25)="MARKCNVTD^EHMAPPT1"
^DIC(19,17065,"U")="MARK APPOINTMENT CONVERTED"
^DIC(19,17066,0)="EHM_POST CONVERSION CLEANUP^Post-Conversion Appointment Cleanup^^R^1^^^^^^^594"
^DIC(19,17066,1,0)="^^8^8^3240423^"
^DIC(19,17066,1,1,0)="Use this option to select all appointments that have an appointment date "
