^DIC(19,13199,1,0)="^19.06^8^8^3061019^^"
^DIC(19,13199,1,1,0)="This report provides a list of patients whose Desired Date for an"
^DIC(19,13199,1,2,0)="appointment is within 30 days or less.  The report is sorted by"
^DIC(19,13199,1,3,0)="Institution, and then by the Desired Date for the appointment."
^DIC(19,13199,1,4,0)="It displays the patient's name, the last 4 of the patient's Social"
^DIC(19,13199,1,5,0)="Security Number, the Desired Date, the Originating Date and the"
^DIC(19,13199,1,6,0)="Clinic or Specialty Wait List.  This report is useful for identifying"
^DIC(19,13199,1,7,0)="those patients who need immediate follow up regarding their being"
^DIC(19,13199,1,8,0)="served within 30 day of their desired appointment date."
^DIC(19,13199,60)="SDWL(409.3,"
^DIC(19,13199,63)="[SDWL30DAY]"
