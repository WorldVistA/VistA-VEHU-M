^DIC(19,9138,1,1,0)="This option is used to enter and edit values for Service Points."
^DIC(19,9138,1,2,0)="Service Points are various tray assembly lines and cafeterias where"
^DIC(19,9138,1,3,0)="bulk food from the Production Facility is served."
^DIC(19,9138,25)="EN6^FHPRO"
^DIC(19,9138,"U")="ENTER/EDIT SERVICE POINTS"
