^DIC(19,9401,99)="62195,30817"
^DIC(19,9401,"U")="MANAGER FOR SECONDARY POINT ME"
^DIC(19,9402,0)="PRCP PURGE RECEIPTS HISTORY^Receipts History By Item Purge^^R^11740^^^^^^^"
^DIC(19,9402,1,0)="^^4^4^2920211^^^"
^DIC(19,9402,1,1,0)="This option will purge the receipts history for items stored in the"
^DIC(19,9402,1,2,0)="inventory point.  This option should be run once a month and will"
^DIC(19,9402,1,3,0)="purge stored data which is older than 13 months.  The data is used"
^DIC(19,9402,1,4,0)="in the report 'Percent Of Normal Stock On Hand Before Receiving.'"
^DIC(19,9402,20)=""
^DIC(19,9402,25)="PRCPXREC"
^DIC(19,9402,"U")="RECEIPTS HISTORY BY ITEM PURGE"
^DIC(19,9403,0)="PRCP PPM MENU^Posted Stock Management^^M^11740^^^^^^^^^^1"
^DIC(19,9403,1,0)="1^19.06^6^6^3000608^^^^"
^DIC(19,9403,1,1,0)="This menu allows PPM to designate posted stock (Issue Book) items on the"
^DIC(19,9403,1,2,0)="Item Master file.  It also allows PPM to notify those services that are"
^DIC(19,9403,1,3,0)="using the Generic Inventory System to place their issue book orders, that"
^DIC(19,9403,1,4,0)="those orders are due in A&MM. PPM will also be able to edit 'Normal Stock "
^DIC(19,9403,1,5,0)="Level' field for items that have a mandatory source as Supply Warehouse"
^DIC(19,9403,1,6,0)="vendor in the primary inventory points."
^DIC(19,9403,10,0)="^19.01PI^7^3"
^DIC(19,9403,10,4,0)="4200^^"
^DIC(19,9403,10,6,0)="1757^^"
^DIC(19,9403,10,7,0)="9481^"
^DIC(19,9403,10,"B",1757,6)=""
^DIC(19,9403,10,"B",4200,4)=""
^DIC(19,9403,10,"B",9481,7)=""
^DIC(19,9403,15)="K PRCP"
^DIC(19,9403,20)=""
^DIC(19,9403,99)="62195,30816"
^DIC(19,9403,"U")="POSTED STOCK MANAGEMENT"
^DIC(19,9404,0)="PRCP INACTIVE ITEMS REPORT^Inactive Items Report^^R^11740^^^^^^^"
^DIC(19,9404,1,0)="^^6^6^2940124^^^"
^DIC(19,9404,1,1,0)="This option will print a report showing items which have not been"
^DIC(19,9404,1,2,0)="used (distributed) and not received into the inventory point within"
^DIC(19,9404,1,3,0)="a specified time period.  The report will show the last usage date,"
^DIC(19,9404,1,4,0)="last receipt date, and due-out quantity.  If the item is marked"
^DIC(19,9404,1,5,0)="'delete item when inventory 0,' the quantity on-hand will also"
^DIC(19,9404,1,6,0)="be displayed."
^DIC(19,9404,20)=""
^DIC(19,9404,25)="PRCPRIIR"
^DIC(19,9404,"U")="INACTIVE ITEMS REPORT"
^DIC(19,9405,0)="PRCP USAGE DEMAND ITEM REPORT^Usage Demand Item Report^^R^11740^^^^^^^326"
^DIC(19,9405,1,0)="^19.06^10^10^3001102^^"
^DIC(19,9405,1,1,0)="This option reports the usage/distribution within a specified date range"
^DIC(19,9405,1,2,0)="of a single item, a set of selected items or of all items stored in the"
^DIC(19,9405,1,3,0)="inventory point within a specified date range."
^DIC(19,9405,1,4,0)=" "
^DIC(19,9405,1,5,0)="The report can be sorted by NSN (warehouse) or group category (primary or"
^DIC(19,9405,1,6,0)="secondary inventory points) with the items in each category sorted either"
^DIC(19,9405,1,7,0)="numerically or alphabetically. The report shows item information, unit"
^DIC(19,9405,1,8,0)="per issue, last cost, average cost, used month-year, quantity used, total"
^DIC(19,9405,1,9,0)="cost, and cumulative quantity and cost totals for each item in the date"
^DIC(19,9405,1,10,0)="range."
^DIC(19,9405,20)=""
^DIC(19,9405,25)="PRCPRUSE"
^DIC(19,9405,"U")="USAGE DEMAND ITEM REPORT"
^DIC(19,9406,0)="PRCP USAGE DEMAND ANALYSIS^Usage Demand Analysis Report^^R^11740^^^^^^^"
^DIC(19,9406,1,0)="^^9^9^2920211^^^^"
^DIC(19,9406,1,1,0)="This option will print a report showing the decrease or increase"
^DIC(19,9406,1,2,0)="in usage for items stored in the inventory point.  The report will"
^DIC(19,9406,1,3,0)="compare a selected month-year to a range of dates (from month-year"
^DIC(19,9406,1,4,0)="to month-year) and print the increase or decrease (specified)"
^DIC(19,9406,1,5,0)="percentage change (also specified) for the period.  The report"
^DIC(19,9406,1,6,0)="will show the quantity used in the comparison month, the average"
^DIC(19,9406,1,7,0)="quantity used per month for the date range, and the percent"
^DIC(19,9406,1,8,0)="increase or decrease in usage.  The report will sort from low"
^DIC(19,9406,1,9,0)="percent usage to high percent usage."
^DIC(19,9406,20)=""
^DIC(19,9406,25)="PRCPRUS1"
^DIC(19,9406,99)="55727,39458"
^DIC(19,9406,"U")="USAGE DEMAND ANALYSIS REPORT"
^DIC(19,9407,0)="PRCP RECEIVE ISSUE BOOK ORDER^Receive Issue Book Order^^R^11740^^^^^^^"
^DIC(19,9407,1,0)="^^8^8^2940614^^^^"
^DIC(19,9407,1,1,0)="This option is used by the primary inventory point to receive in"
^DIC(19,9407,1,2,0)="issue book requests distributed by the warehouse.  When receiving"
^DIC(19,9407,1,3,0)="in the issue book request, the primary on-hand quantity and due-in"
^DIC(19,9407,1,4,0)="quantity is adjusted.  The warehouse quantities are not changed until"
^DIC(19,9407,1,5,0)="the warehouse posts the issue book request.  If the warehouse has"
^DIC(19,9407,1,6,0)="posted the issue book request, the primary will not be able to"
^DIC(19,9407,1,7,0)="receive the order in since the primary receiving process was done during"
^DIC(19,9407,1,8,0)="warehouse posting."
^DIC(19,9407,25)="PRCPWPPL"
^DIC(19,9407,"U")="RECEIVE ISSUE BOOK ORDER"
^DIC(19,9408,0)="PRCP DATE RECEIVED DELETE^Date Received Delete (for Issue Book Requests)^^E^11740^^^^^^^"
^DIC(19,9408,1,0)="^^6^6^2940124^^^^"
^DIC(19,9408,1,1,0)="  This option allows the user to delete or change the 'DATE RECEIVED'"
^DIC(19,9408,1,2,0)="field on a request.  This field should be set only when the final"
^DIC(19,9408,1,3,0)="partial on a request has been received, and is a flag to the system"
^DIC(19,9408,1,4,0)="that no more receiving is due.  If the user accidentally has specified"
^DIC(19,9408,1,5,0)="that an order was received complete when it was not, they can delete this"
^DIC(19,9408,1,6,0)="field, and they will then be allowed to receive more on the request."
^DIC(19,9408,20)=""
^DIC(19,9408,30)="PRCS(410,"
^DIC(19,9408,31)="AEMQ"
^DIC(19,9408,34)="I +$G(PRCP(""I""))=+$P(^(0),U,6)!($G(PRCP(""DPTYPE""))=""W"")"
^DIC(19,9408,50)="PRCS(410,"
^DIC(19,9408,51)=48
^DIC(19,9408,99)="55711,31590"
^DIC(19,9408,"U")="DATE RECEIVED DELETE (FOR ISSU"
^DIC(19,9409,0)="PRCP EDIT DISTR PT ITEMS^Enter/Edit Items On Distribution Point^^R^11740^^^^^^^"
^DIC(19,9409,1,0)="^^4^4^2920211^^^^"
^DIC(19,9409,1,1,0)="This option allows a warehouse or primary inventory point to update"
^DIC(19,9409,1,2,0)="information on selected items for a distribution point.  In order"
^DIC(19,9409,1,3,0)="to select a distribution point, the distribution point must not be"
^DIC(19,9409,1,4,0)="maintaining their inventory items."
^DIC(19,9409,25)="PRCPEITD"
^DIC(19,9409,99)="55580,49804"
^DIC(19,9409,"U")="ENTER/EDIT ITEMS ON DISTRIBUTI"
^DIC(19,9410,0)="PRCP POST ISSUE BOOK ORDER^Post Issue Book Order^^R^11740^^^^^^^"
^DIC(19,9410,1,0)="^^6^6^2940614^^^^"
^DIC(19,9410,1,1,0)="This option should be used by the warehouse to post an issue book"
^DIC(19,9410,1,2,0)="distribution order.  When posting the order, the quantity on-hand"
^DIC(19,9410,1,3,0)="and quantity due-out in the warehouse is adjusted, and the"
^DIC(19,9410,1,4,0)="quantity on-hand and due-in in the primary is adjusted.  At completion"
^DIC(19,9410,1,5,0)="of posting, the FMS and ISMS code sheets are automatically created and"
^DIC(19,9410,1,6,0)="transmitted to Austin."
^DIC(19,9410,25)="PRCPWPLM"
^DIC(19,9410,99)="54160,50551"
^DIC(19,9410,"U")="POST ISSUE BOOK ORDER"
^DIC(19,9411,0)="PRCPW INVENTORY MENU^Inventory File Maintenance Menu^^M^11740^^^^^^^^^1"
^DIC(19,9411,1,0)="^^2^2^2920211^^^^"
^DIC(19,9411,1,1,0)="This menu includes the options for a warehouse to maintain the items"
^DIC(19,9411,1,2,0)="stored in the inventory point."
^DIC(19,9411,10,0)="^19.01PI^18^4"
^DIC(19,9411,10,1,0)="9435^"
^DIC(19,9411,10,16,0)="9379^^"
^DIC(19,9411,10,17,0)="9474^"
