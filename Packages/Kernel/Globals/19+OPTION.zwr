^DIC(19,8369,10,"C","PUR",3)=""
^DIC(19,8369,10,"C","TRN",2)=""
^DIC(19,8369,99)="56188,51697"
^DIC(19,8369,"U")="IVM SYSTEM MANAGER'S MENU"
^DIC(19,8370,0)="IB MT REV PEND CHARGES^Release Charges 'Pending Review'^^R^10000000020^^^^^^^192"
^DIC(19,8370,1,0)="^19.06^12^12^3010910^^^^"
^DIC(19,8370,1,1,0)="This new option is introduced with IVM v2.0 to support the IVM process."
^DIC(19,8370,1,2,0)=" "
^DIC(19,8370,1,3,0)="When an IVM-verified Means Test is transmitted from the IVM Center to"
^DIC(19,8370,1,4,0)="the field facility, Means Tests charges will be created, if necessary,"
^DIC(19,8370,1,5,0)="for patients whose MT status has changed from NO to YES.  These charges"
^DIC(19,8370,1,6,0)="are not passed to Accounts Receivable, but held in Billing in a new"
^DIC(19,8370,1,7,0)="'hold' (HOLD - REVIEW) status to await a manual review.  This option"
^DIC(19,8370,1,8,0)="is used to review all charges which are pending a review before being"
^DIC(19,8370,1,9,0)="billed to the patient.  Once reviewed, the charge may either be"
^DIC(19,8370,1,10,0)="cancelled or passed to AR.  If the charge is passed, billing"
^DIC(19,8370,1,11,0)="information is passed to the IVM package to initiate the transmission"
^DIC(19,8370,1,12,0)="of billing information back to the IVM Center."
^DIC(19,8370,25)="IBAMTV3"
^DIC(19,8370,"U")="RELEASE CHARGES 'PENDING REVIE"
^DIC(19,8371,0)="PSJ EXP^INpatient Stop Order Notices^^R^11712^^^^^^^117"
^DIC(19,8371,1,0)="^^3^3^2940310^^^^"
^DIC(19,8371,1,1,0)="  Allows the user to print a report of selected patients' UNIT DOSE orders,"
^DIC(19,8371,1,2,0)="IV orders, or both UNIT DOSE and IV orders that have expiration dates"
^DIC(19,8371,1,3,0)="between two user selected dates."
^DIC(19,8371,25)="PSJEXP"
^DIC(19,8371,"U")="INPATIENT STOP ORDER NOTICES"
^DIC(19,8372,0)="PSJU 24H MAR^24 Hour MAR^^R^11712^^^^^^^117"
^DIC(19,8372,1,0)="^^3^3^2940202^^^^"
^DIC(19,8372,1,1,0)="  Allows the user to print an MAR by patient, ward, or ward group."
^DIC(19,8372,1,2,0)="The MAR shows the patients' orders and their associated administration"
^DIC(19,8372,1,3,0)="times for a selected 24 hour period."
^DIC(19,8372,25)="PSGMAR"
^DIC(19,8372,"U")="24 HOUR MAR"
^DIC(19,8374,0)="PSJU EPPD^Pharmacy Patient Data Edit^^R^1^^^^^^^117^^1^1"
^DIC(19,8374,1,0)="^^3^3^2910312^^^^"
^DIC(19,8374,1,1,0)="  Allows the user to edit data pertaining to a particular pharmacy"
^DIC(19,8374,1,2,0)="patient.  This option is not tied to any menu, but if a site desires,"
^DIC(19,8374,1,3,0)="may be used to edit the NARRATIVE, WEIGHT, and REACTIONS fields."
^DIC(19,8374,15)="K PSJNODIS"
^DIC(19,8374,20)="S PSJNODIS=1"
^DIC(19,8374,25)="ENPPD^PSGFILED"
^DIC(19,8374,"U")="PHARMACY PATIENT DATA EDIT"
^DIC(19,8376,0)="PSJ OAOPT^Order Action on Patient Transfer^^R^11712^^^^^^^197^^^1"
^DIC(19,8376,1,0)="^^3^3^2900425^^"
^DIC(19,8376,1,1,0)="  This allows the user to determine what action, if any, should be taken"
^DIC(19,8376,1,2,0)="on a patient's Inpatient Medication orders whenever the patient is"
^DIC(19,8376,1,3,0)="transferred."
^DIC(19,8376,15)="K %DT,%X,%Y,D,D0,D1,DI,DISYS,DQ"
^DIC(19,8376,25)="ENOAOPT^PSGFILD0"
^DIC(19,8376,"U")="ORDER ACTION ON PATIENT TRANSF"
^DIC(19,8377,0)="PSJ UD ALIGN LABEL^Align Unit Dose Labels^^R^11712^^^^^^^197"
^DIC(19,8377,1,0)="^^2^2^2920315^"
^DIC(19,8377,1,1,0)="  Allows users to align the label stock of a printer to be sure that Unit"
^DIC(19,8377,1,2,0)="Dose labels print properly."
^DIC(19,8377,25)="ENAL^PSGLBA"
^DIC(19,8377,"U")="ALIGN UNIT DOSE LABELS"
^DIC(19,8378,0)="PSJ EXTP^Patient Profile (Extended)^^R^1^^^^^^^117^^1^1"
^DIC(19,8378,1,0)="^19.06^3^3^3071009^^^"
^DIC(19,8378,1,1,0)="This report allows viewing all of the orders on file for a patient (not "
^DIC(19,8378,1,2,0)="just since last discharge).  All orders that have not been purged can"
^DIC(19,8378,1,3,0)="be viewed, or a date entered to start searching forward from."
^DIC(19,8378,15)="K PSJEXTP,PSJNODIS"
^DIC(19,8378,20)="S (PSJEXTP,PSJNODIS)=1"
^DIC(19,8378,25)="PSJPR"
^DIC(19,8378,"U")="PATIENT PROFILE (EXTENDED)"
^DIC(19,8379,0)="PSJ MDWS^Medications Due Worksheet^^R^11712^^^^^^^117"
^DIC(19,8379,1,0)="^^3^3^2940202^^"
^DIC(19,8379,1,1,0)="Allows the user to print the Medications Due Worksheet by patient, ward,"
^DIC(19,8379,1,2,0)="or ward group.  The worksheet shows the patients's orders that are to be"
^DIC(19,8379,1,3,0)="administered within a 24 hour period."
^DIC(19,8379,25)="PSJMDWS"
^DIC(19,8379,"U")="MEDICATIONS DUE WORKSHEET"
^DIC(19,8380,0)="PSJU EUDD^Extra Units Dispensed Report^^R^11712^^^^^^^117"
^DIC(19,8380,1,0)="^^3^3^2940202^^"
^DIC(19,8380,1,1,0)="Allows the user to print the Extra Units Dispensed Report by patient, ward,"
^DIC(19,8380,1,2,0)="or a ward group.  The report shows the amounts, date dispensed and the "
^DIC(19,8380,1,3,0)="initial of the person entered the dispensed drug.  "
^DIC(19,8380,25)="PSGEUDD"
^DIC(19,8380,99)="55915,48114"
^DIC(19,8380,"U")="EXTRA UNITS DISPENSED REPORT"
^DIC(19,8381,0)="PSJ PDV^Patients on Specific Drug(s)^^R^11712^^^^^^^117"
^DIC(19,8381,1,0)="^^5^5^2991117^^^^"
^DIC(19,8381,1,1,0)="This 80 column report lists patients on specific primary drug(s), dispense"
^DIC(19,8381,1,2,0)="drug(s), or VA class(es) of drugs. If more than one primary drug, dispense"
^DIC(19,8381,1,3,0)="drug, or VA class of drug is chosen, only patients with orders containing"
^DIC(19,8381,1,4,0)="all the drugs or classes will be shown. The user may choose to list all"
^DIC(19,8381,1,5,0)="orders, only IV orders, or only Unit Dose orders."
^DIC(19,8381,2)="n"
^DIC(19,8381,10.1)=""
^DIC(19,8381,25)="PSJPDV"
^DIC(19,8381,"U")="PATIENTS ON SPECIFIC DRUG(S)"
