^DIC(19,12918,1,0)="^19.06^4^4^3031216^^"
^DIC(19,12918,1,1,0)="This menu option is used for transmitting Performance Monitor (TIU) data"
^DIC(19,12918,1,2,0)="to Austin Automation Center in the event that a problem is encountered. In"
^DIC(19,12918,1,3,0)="addittion, this option allows to retroactively transmit previous months"
^DIC(19,12918,1,4,0)="extracts."
^DIC(19,12918,25)="QUE^SDPMHLS"
^DIC(19,12918,"U")="PERFORMANCE MONITOR RETRANSMIT"
