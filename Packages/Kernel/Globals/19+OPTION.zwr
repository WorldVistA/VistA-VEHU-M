^DIC(19,10551,99)="67475,56697"
^DIC(19,10551,99.1)="67804,41143"
^DIC(19,10551,"U")="PHARMACY DATA MANAGEMENT"
^DIC(19,10552,0)="PSS SCHEDULE EDIT^Standard Schedule Edit^^R^10000000020^^^^^^^517"
^DIC(19,10552,1,0)="^^4^4^2960624^^"
^DIC(19,10552,1,1,0)="Allows user to edit the set of times associated with the standard"
^DIC(19,10552,1,2,0)="dosage administration schedules (Q3H,Q8H,TID, etc.)."
^DIC(19,10552,1,3,0)="This may be used to define the outpatient expansion to be used when the"
^DIC(19,10552,1,4,0)="schedule is entered for an outpatient medication order."
^DIC(19,10552,25)="ENPSJSE^PSSJEEU"
^DIC(19,10552,"U")="STANDARD SCHEDULE EDIT"
^DIC(19,10553,0)="PSSJU MI^Medication Instruction File Add/Edit^^R^10000000020^^^^^^^"
^DIC(19,10553,1,0)="^^6^6^2960807^^^"
^DIC(19,10553,1,1,0)="The UNIT DOSE package contains a field called SPECIAL INSTRUCTIONS. This"
^DIC(19,10553,1,2,0)="field utilizes the abbreviations and expansions of the MEDICATION INSTRUCTION"
^DIC(19,10553,1,3,0)="File when printing on various reports. This option allow the user to enter"
^DIC(19,10553,1,4,0)="and edit abbreviations and expansions in the MEDICATION INSTRUCTION file and"
^DIC(19,10553,1,5,0)="to ""flag"" those entries for use by the INPATIENT packages only, OUTPATIENT"
^DIC(19,10553,1,6,0)="package only, or by both."
^DIC(19,10553,25)="ENMI^PSSFILED"
^DIC(19,10553,"U")="MEDICATION INSTRUCTION FILE AD"
^DIC(19,10554,0)="PSS DRUG ENTER/EDIT^Drug Enter/Edit^^R^10000000020^^^^^^^^^^1"
^DIC(19,10554,1,0)="^19.06^3^3^3020313^^^"
^DIC(19,10554,1,1,0)="This option allows the user to edit fields for ALL pharmacy packages if"
^DIC(19,10554,1,2,0)="they possess the proper package key. It also will allow the user to match"
^DIC(19,10554,1,3,0)="to NDF and Orderable Item."
^DIC(19,10554,15)="K DIR"
^DIC(19,10554,25)="PSSDEE"
^DIC(19,10554,99)="58756,55831"
^DIC(19,10554,99.1)="59164,31868"
^DIC(19,10554,"U")="DRUG ENTER/EDIT"
^DIC(19,10556,0)="PSS LOOK^Lookup into Dispense Drug File^^R^10000000020^^^^^^^"
^DIC(19,10556,1,0)="^^2^2^2961029^"
^DIC(19,10556,1,1,0)="This option provides a lookup into dispense drug file. It displays fields"
^DIC(19,10556,1,2,0)="commonly edited."
^DIC(19,10556,25)="PSSLOOK"
^DIC(19,10556,"U")="LOOKUP INTO DISPENSE DRUG FILE"
^DIC(19,10557,0)="PSSJU DRG^Dispense Drug Fields^^R^11595^^^^^^^117"
^DIC(19,10557,1,0)="^^4^4^2910312^^^^"
^DIC(19,10557,1,1,0)="  This option allows the user to enter data into fields that are used as"
^DIC(19,10557,1,2,0)="default values, and in calculating default values, when the drug is"
^DIC(19,10557,1,3,0)="chosen in Unit Dose ORDER ENTRY.  This option allows the selection of"
^DIC(19,10557,1,4,0)="any drug, including INACTIVE or NON-FORMULARY items."
^DIC(19,10557,25)="ENDRG^PSGFILED"
^DIC(19,10557,"U")="DISPENSE DRUG FIELDS"
^DIC(19,10558,0)="PSSJI DRUG^ADditives File^^A^10000000020^^^^^^^115^^1^1"
^DIC(19,10558,1,0)="^19.06^3^3^3010509^^^^"
^DIC(19,10558,1,1,0)="This option allows the applications coordinator to add, change, or"
^DIC(19,10558,1,2,0)="inactivate drugs which are to be used as additives in the IV room."
^DIC(19,10558,1,3,0)="All drug information is contained within the IV additives file."
^DIC(19,10558,15)="K %DT,C,D0,I,I1,J,PSIV,PSIUDA,PSIUX,PSSJI,Y,Z"
^DIC(19,10558,20)="D ^PSIVXU Q:$D(XQUIT)  S PSSJI=1 D ENA^PSSVIDRG"
^DIC(19,10558,25)=""
^DIC(19,10558,30)=""
^DIC(19,10558,31)=""
^DIC(19,10558,50)=""
^DIC(19,10558,51)=""
^DIC(19,10558,"U")="ADDITIVES FILE"
^DIC(19,10559,0)="PSSJI SOLN^PRimary Solution File (IV)^^A^10000000020^^^^^^^115^^1^1"
^DIC(19,10559,1,0)="^19.06^6^6^3010509^^^^"
^DIC(19,10559,1,1,0)="  This option is for the applications coordinator to add, change, or"
^DIC(19,10559,1,2,0)="inactivate primary solutions used in the IV section.  The solution must"
^DIC(19,10559,1,3,0)="already exist in the Drug File to be selected here.  If use of a primary "
^DIC(19,10559,1,4,0)="solution is to be discontinued, the solution should be inactivated by "
^DIC(19,10559,1,5,0)="entering an inactivation date, rather than by deleting the solution from "
^DIC(19,10559,1,6,0)="the file."
^DIC(19,10559,15)="K D0,DI,DQ,J,PSSJI,Y"
^DIC(19,10559,20)="D ^PSIVXU Q:$D(XQUIT)  S PSSJI=1 D ENS^PSSVIDRG"
^DIC(19,10559,25)=""
^DIC(19,10559,30)=""
^DIC(19,10559,31)=""
^DIC(19,10559,50)=""
^DIC(19,10559,51)=""
^DIC(19,10559,"U")="PRIMARY SOLUTION FILE (IV)"
^DIC(19,10560,0)="PSSJU MARK UD ITEMS^MARk/Unmark Dispense Drugs For Unit Dose^^R^1^^^^^^^"
^DIC(19,10560,1,0)="^^7^7^2920630^^^^"
^DIC(19,10560,1,1,0)="  This allows users to easily mark or unmark items from the Drug file (#50)"
^DIC(19,10560,1,2,0)="for use by the Unit Dose Medications package.  Only those items marked for"
^DIC(19,10560,1,3,0)="Unit Dose are selectable for Unit Dose orders."
^DIC(19,10560,1,4,0)="  When the Inpatient Medications package is first installed, it marks all"
^DIC(19,10560,1,5,0)="items in the Drug file for use by Unit Dose so that users may immediately"
^DIC(19,10560,1,6,0)="continue to use the package.  This can be used to unmark those dispense"
^DIC(19,10560,1,7,0)="items that Unit Dose users should not be able to select."
^DIC(19,10560,25)="ENIU^PSSGIU"
^DIC(19,10560,"U")="MARK/UNMARK DISPENSE DRUGS FOR"
^DIC(19,10562,0)="PSSXX MARK^CMOP Mark/Unmark (Single drug)^^R^10000000020^PSXCMOPMGR^^^^^^"
^DIC(19,10562,1,0)="^^2^2^2970519^^"
^DIC(19,10562,1,1,0)="This option allows the user to mark/unmark a single drug for transmission"
^DIC(19,10562,1,2,0)="to the CMOP."
^DIC(19,10562,25)="PSSMARK"
^DIC(19,10562,62)=""
^DIC(19,10562,99.1)="60761,47544"
^DIC(19,10562,"U")="CMOP MARK/UNMARK (SINGLE DRUG)"
^DIC(19,10563,0)="PSS SYS EDIT^Pharmacy System Parameters Edit^^R^10000000020^^^^^^^"
^DIC(19,10563,1,0)="^^2^2^2970807^"
^DIC(19,10563,1,1,0)="This option allows the user to edit the Pharmacy System parameters used"
^DIC(19,10563,1,2,0)="in Pharmacy Data Management."
^DIC(19,10563,25)="PSSYSP"
^DIC(19,10563,"U")="PHARMACY SYSTEM PARAMETERS EDI"
^DIC(19,10568,0)="PSS ORDERABLE ITEM MANAGEMENT^Orderable Item Management^^M^10000000020^^^^^^^"
