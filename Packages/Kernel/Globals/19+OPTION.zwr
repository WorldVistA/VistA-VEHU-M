^DIC(19,9386,20)="D DISPLAY^PRCPUSEL I '$G(PRCP(""I"")) S XQUIT=1 D NOMENU^PRCPUSEL"
^DIC(19,9386,99)="62195,30816"
^DIC(19,9386,"U")="PURGE HISTORY FILES MENU"
^DIC(19,9387,0)="PRCP PURGE TRANS REGISTER^Transaction Register Purge^^R^11740^^^^^^^"
^DIC(19,9387,1,0)="^^5^5^2920211^^^^"
^DIC(19,9387,1,1,0)="This option will purge the transaction register for all transactions"
^DIC(19,9387,1,2,0)="which affect the inventory point that are older than 13 months.  This"
^DIC(19,9387,1,3,0)="option should be run once a month in order to free up disk space."
^DIC(19,9387,1,4,0)="The data is used for printing the inventory transaction register"
^DIC(19,9387,1,5,0)="report."
^DIC(19,9387,20)=""
^DIC(19,9387,25)="PRCPXTRA"
^DIC(19,9387,"U")="TRANSACTION REGISTER PURGE"
^DIC(19,9388,0)="PRCP EMERGENCY STOCK REPORT^Emergency Stock Report^^R^11740^^^^^^^"
^DIC(19,9388,1,0)="^^10^10^2920211^^^^"
^DIC(19,9388,1,1,0)="This option will print a report of inventory point items which the"
^DIC(19,9388,1,2,0)="quantity on-hand is at or below the emergency stock level.  The report"
^DIC(19,9388,1,3,0)="will show the unit per issue, normal stock level, emergency stock level,"
^DIC(19,9388,1,4,0)="quantity on-hand, quantity due-in, quantity due-out, and interval"
^DIC(19,9388,1,5,0)="order point.  The report will also show the due-in transactions and"
^DIC(19,9388,1,6,0)="associated purchase order number, vendor, estimated receiving date,"
^DIC(19,9388,1,7,0)="and the due-in quantity."
^DIC(19,9388,1,8,0)=" "
^DIC(19,9388,1,9,0)="After the report has printed, the message 'you have items at or below"
^DIC(19,9388,1,10,0)="the emergency stock level' will be cleared."
^DIC(19,9388,20)=""
^DIC(19,9388,25)="PRCPREME"
^DIC(19,9388,99)="54717,56130"
^DIC(19,9388,"U")="EMERGENCY STOCK REPORT"
^DIC(19,9389,0)="PRCP PURGE USAGE/DISTRIBUTION^Usage/Distribution Monthly Totals Purge^^R^11740^^^^^^^"
^DIC(19,9389,1,0)="^^4^4^2920211^^^^"
^DIC(19,9389,1,1,0)="This option will purge the usage/distribution totals for items stored"
^DIC(19,9389,1,2,0)="in the inventory point and are older than 13 months.  This option"
^DIC(19,9389,1,3,0)="should be run once a month in order to free up disk space.  The data"
^DIC(19,9389,1,4,0)="is used in the 'Usage Reports.'"
^DIC(19,9389,20)=""
^DIC(19,9389,25)="PRCPXUSE"
^DIC(19,9389,99)="54717,56789"
^DIC(19,9389,"U")="USAGE/DISTRIBUTION MONTHLY TOT"
^DIC(19,9390,0)="PRCP PURGE DISTRIBUTION HIST^History By Cost Center Purge^^R^11740^^^^^^^"
^DIC(19,9390,1,0)="^^3^3^2870812^^^"
^DIC(19,9390,1,1,0)="This option purges the Distribution/Usage History totals by cost center,"
^DIC(19,9390,1,2,0)="for the month specified by the user.  This file is used to create the"
^DIC(19,9390,1,3,0)="month-end distribution report used by accounting."
^DIC(19,9390,20)=""
^DIC(19,9390,25)="PRCPXDIS"
^DIC(19,9390,"U")="HISTORY BY COST CENTER PURGE"
^DIC(19,9391,0)="PRCP INVPT PARAM ENTER/EDIT^Enter/Edit Inventory And Distribution Points^^R^11740^^^^^^^"
^DIC(19,9391,1,0)="^^4^4^2920211^^^^"
^DIC(19,9391,1,1,0)="This option will allow the inventory point manager to edit the control"
^DIC(19,9391,1,2,0)="parameters for the inventory point and distribution points.  The"
^DIC(19,9391,1,3,0)="control parameters include the cost center, fund control points,"
^DIC(19,9391,1,4,0)="inventory point users, distribution points, etc."
^DIC(19,9391,20)=""
^DIC(19,9391,25)="PRCPENLM"
^DIC(19,9391,99)="55028,49584"
