^DIC(19,13325,0)="ECXLARP^Print DSS Lab Test Datasheet^MENU OPTION NO LONGER USED^R^10000000020^^^^^^^513"
^DIC(19,13325,1,0)="^19.06^5^5^3050513^^^^"
^DIC(19,13325,1,1,0)="This option prints a list of the DSS Lab Tests used for the Lab Results"
^DIC(19,13325,1,2,0)="Extract (LAR).  It will display the local lab data names for each test."
^DIC(19,13325,1,3,0)="It will also show the blood, urine and feces specimens used by your "
^DIC(19,13325,1,4,0)="facility.  This information is critical for generating the DSS Lab "
^DIC(19,13325,1,5,0)="Results Extract."
^DIC(19,13325,25)="EN^ECXLARP"
^DIC(19,13325,"U")="PRINT DSS LAB TEST DATASHEET"
^DIC(19,13326,0)="IBCR RC EXTRACT^Extract Charge Master RC Rates^^R^1^IB SUPERVISOR^^^^^^192"
^DIC(19,13326,1,0)="^^7^7^3060111^"
^DIC(19,13326,1,1,0)="This option is used to extract Reasonable Charges rates from Charge "
^DIC(19,13326,1,2,0)="Master in a format that can be imported to Excel.  The extract will allow "
^DIC(19,13326,1,3,0)="you to create a text file that is delimitated by the circumflex/caret (^) "
^DIC(19,13326,1,4,0)="character.  When importing to Excel specify that delimiter.  This can be "
^DIC(19,13326,1,5,0)="used for any version of RC from 2.0 or above.  The output device selected "
^DIC(19,13326,1,6,0)="should be a Host File Server (HFS) or the Current Terminal (for screen "
^DIC(19,13326,1,7,0)="capture)."
^DIC(19,13326,25)="EN^IBCROE"
^DIC(19,13326,"U")="EXTRACT CHARGE MASTER RC RATES"
^DIC(19,13327,0)="IBCEMC MULT CSA MSG MANAGEMENT^Multiple CSA Message Management^^R^1^IB MESSAGE MANAGEMENT^^^^^^192"
^DIC(19,13327,1,0)="^^3^3^3051003^"
^DIC(19,13327,1,1,0)="This option allows users to see rejected claims status messages which are "
^DIC(19,13327,1,2,0)="not reviewed.  The users are able to take the same action on multiple "
^DIC(19,13327,1,3,0)="messages at the same time."
^DIC(19,13327,25)="EN^IBCEMCL"
^DIC(19,13327,"U")="MULTIPLE CSA MESSAGE MANAGEMEN"
^DIC(19,13328,0)="IBCN RESYNCH INS COMP^Re-synch Associated Insurance Companies^^R^1^^^^^^^"
^DIC(19,13328,1,0)="^^8^8^3060426^"
^DIC(19,13328,1,1,0)="On the rare occasion that the associated insurance company provider "
^DIC(19,13328,1,2,0)="IDs get out of synch, this option is to be used by EVS or the IRM to get"
^DIC(19,13328,1,3,0)="the parent and child insurance companies to be the same.  This option"
^DIC(19,13328,1,4,0)="should not be linked to any menu."
^DIC(19,13328,1,5,0)=" "
^DIC(19,13328,1,6,0)="This runs for all insurance companies and locks the insurance company "
^DIC(19,13328,1,7,0)="file before starting so no one can be editing an insurance company while"
^DIC(19,13328,1,8,0)="it is running."
^DIC(19,13328,25)="RESYNCH^IBCEPCID()"
^DIC(19,13328,"U")="RE-SYNCH ASSOCIATED INSURANCE "
