^DIC(19,6030,"U")="LIST ORDERS BY PATIENT OR STAT"
^DIC(19,6031,0)="RMPFET^Enter/Edit Patient Order^^R^.5^^^^^^^"
^DIC(19,6031,1,0)="^^3^3^2940628^"
^DIC(19,6031,1,1,0)="This option is the Enter/Edit module for all patient orders."
^DIC(19,6031,1,2,0)="A patient is selected and a new order may be entered or an"
