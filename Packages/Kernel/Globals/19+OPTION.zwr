^DIC(19,13290,1,0)="^^2^2^3060608^"
^DIC(19,13290,1,1,0)="This ECME maintenance menu contains the BPS Unstrand Screen and the "
^DIC(19,13290,1,2,0)="Re-Open Closed Claim options."
^DIC(19,13290,10,0)="^19.01IP^2^2"
^DIC(19,13290,10,1,0)="13293^UNS^1"
^DIC(19,13290,10,2,0)="13323^ROC^2"
