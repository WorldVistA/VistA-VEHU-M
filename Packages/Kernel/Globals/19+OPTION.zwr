^DIC(19,7980,0)="PSA IV SINGLE^IV Dispensing (Single Drug)^^R^11595^^^^^^^287"
^DIC(19,7980,1,0)="^^4^4^2970923^"
^DIC(19,7980,1,1,0)="The IV Dispensing (Single Drug) option collects introvenous (IV)"
^DIC(19,7980,1,2,0)="dispensing for a single drug from the IV STATS file (#50.8). If present,"
^DIC(19,7980,1,3,0)="the last IV collection date is used as a starting point. Otherwise a date"
^DIC(19,7980,1,4,0)="from which to begin collection is requested."
^DIC(19,7980,25)="PSAPSI"
^DIC(19,7980,"U")="IV DISPENSING (SINGLE DRUG)"
^DIC(19,7981,0)="PSA IV ALL DRUGS^IV Dispensing (All Drugs)^^R^11595^^^^^^^287"
^DIC(19,7981,1,0)="^^4^4^2970923^"
^DIC(19,7981,1,1,0)="The IV Dispensing (All Drugs) option collects intravenous (IV) dispensing"
^DIC(19,7981,1,2,0)="for all drugs in this location from the IV STATS file (#50.8). If present,"
^DIC(19,7981,1,3,0)="the last IV collection date is used as a starting point. Otherwise the"
^DIC(19,7981,1,4,0)="user selected date is used."
^DIC(19,7981,25)="PSAPSI2"
^DIC(19,7981,99)="55675,53247"
^DIC(19,7981,"U")="IV DISPENSING (ALL DRUGS)"
^DIC(19,7982,0)="PSA IV ALL LOCATIONS^All Location Dispense/Purge^^R^11595^^^^^^^287"
^DIC(19,7982,1,0)="^^10^10^2970923^^"
^DIC(19,7982,1,1,0)="The All Location Dispense/Purge option should be scheduled, using TaskMan,"
^DIC(19,7982,1,2,0)="to run nightly to update all Drug Accountability locations with dispensing"
^DIC(19,7982,1,3,0)="from the IV STATS (#50.8), PRESCRIPTION (#52), and the UNIT DOSE PICK LIST"
^DIC(19,7982,1,4,0)="STATS (#57.6) files. It also searches all active pharmacy locations and"
^DIC(19,7982,1,5,0)="master vaults for drug balances  equal to or less than the reorder level"
^DIC(19,7982,1,6,0)="if drug balances are maintained in the location or vault. A mail message"
^DIC(19,7982,1,7,0)="containing these drugs is sent to all holders of the PSA ORDERS key. To"
^DIC(19,7982,1,8,0)="avoid competing locks of ^PSD globals, it should not be scheduled within"
^DIC(19,7982,1,9,0)="one hour of the Update AMIS Stats File [PSGW UPDATE AMIS STATS] option and"
^DIC(19,7982,1,10,0)="after the Compile IV Costs in Background [PSJI BACKGROUND JOB] option."
^DIC(19,7982,25)="PSAPSI3"
^DIC(19,7982,99)="55720,28423"
^DIC(19,7982,200.9)="y"
^DIC(19,7982,"U")="ALL LOCATION DISPENSE/PURGE"
