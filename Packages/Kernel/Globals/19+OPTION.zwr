^DIC(19,11449,1,2,0)="resolution to give final approval for selected duplicate pairs to be"
^DIC(19,11449,1,3,0)="included in the next merge process."
^DIC(19,11449,25)="APPROVE^XDRMERGA"
^DIC(19,11449,"U")="APPROVE VERIFIED DUPLICATES FO"
