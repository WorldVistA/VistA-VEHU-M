^DIC(19,13001,0)="IBCNE IIV AMBIGUOUS POLICY RPT^eIV Ambiguous Policy Report^^R^1^^^^^^^192"
^DIC(19,13001,1,0)="^^4^4^3211020^"
^DIC(19,13001,1,1,0)="This report will allow a user to display Ambiguous Payer Responses"
^DIC(19,13001,1,2,0)="that the eIV software returned while processing transactions."
^DIC(19,13001,1,3,0)="Ambiguous payer responses are those responses that do not have"
