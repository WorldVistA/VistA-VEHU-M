^DIC(19,9137,0)="FHPRO7^Enter/Edit Production Facilities^^R^10000000020^^^^^^^"
^DIC(19,9137,1,0)="^^3^3^2911204^"
^DIC(19,9137,1,1,0)="This option is used to enter and edit values for the various"
^DIC(19,9137,1,2,0)="Production Facilities. A Production Facility is generally a main"
^DIC(19,9137,1,3,0)="kitchen where bulk food is prepared."
