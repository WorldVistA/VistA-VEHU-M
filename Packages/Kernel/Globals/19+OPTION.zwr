^DIC(19,16156,99)="55425,54053"
^DIC(19,16156,"U")="HOSPITAL LOCATION HEALTH SUMMA"
^DIC(19,16157,0)="EHM-00978^Ad Hoc Health Summary^^R^1^^^^^^^160^^1^^"
^DIC(19,16157,1,0)="^^6^6^3240328^"
^DIC(19,16157,1,1,0)="Generates an 'Ad Hoc' Health Summary for specified patients. Instead of"
^DIC(19,16157,1,2,0)="selecting a pre-defined Health Summary Type, the user defines his own ad"
^DIC(19,16157,1,3,0)="hoc Health Summary structure for temporary use while using this option."
^DIC(19,16157,1,4,0)="The user selects Health Summary components, time and occurrence limits"
^DIC(19,16157,1,5,0)="when applicable, and selection items when applicable."
^DIC(19,16157,1,6,0)="Cloned from ""GMTS HS ADHOC"" option."
