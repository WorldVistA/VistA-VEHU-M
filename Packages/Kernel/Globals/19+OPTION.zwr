^DIC(19,1696,0)="RA IMGLOG^Imaging Type Activity Log^^R^11712^^^^^^^"
^DIC(19,1696,1,0)="^^9^9^2940607^^^^"
^DIC(19,1696,1,1,0)="This printout lists the activity log for all imaging types in the"
^DIC(19,1696,1,2,0)="'TYPE OF IMAGING' file (#79.2)."
^DIC(19,1696,1,3,0)=" "
^DIC(19,1696,1,4,0)="The types of activities listed are the following:"
^DIC(19,1696,1,5,0)=" "
^DIC(19,1696,1,6,0)="       1) When imaging type parameters were changed"
^DIC(19,1696,1,7,0)="       2) When data was scheduled to be purged"
^DIC(19,1696,1,8,0)="       3) When data was actually purged"
^DIC(19,1696,1,9,0)="       4) When the on-line data criteria was modified"
^DIC(19,1696,25)="5^RASITE"
^DIC(19,1696,"U")="IMAGING TYPE ACTIVITY LOG"
^DIC(19,1697,0)="RA OVERRIDE^Override a Single Exam's Status to 'complete'^^R^11712^RA MGR^^^^^^"
