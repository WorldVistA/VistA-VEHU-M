^DIC(19,14277,200.9)="y"
^DIC(19,14277,"U")="TASKMAN FILE FORMAT FILE 60 AU"
^DIC(19,14278,0)="LRJ OBSOLETE PENDING ORDERS^Obsolete Pending Lab Orders^^R^1^^^^^^^26"
^DIC(19,14278,1,0)="^19.06^12^12^3130425^^"
^DIC(19,14278,1,1,0)="This option is responsible for automatically lapsing (obsoleting) pending"
^DIC(19,14278,1,2,0)="lab orders. The order will be canceled in lab and an order status update"
^DIC(19,14278,1,3,0)="message will be sent to CPRS with a new status of lapsed."
^DIC(19,14278,1,4,0)="  "
^DIC(19,14278,1,5,0)="This lapsing is based on a parameter: LRJ OBSOLETE PENDING ORDERS. The "
^DIC(19,14278,1,6,0)="value of this parameter will be compared to the GRACE PERIOD FOR"
^DIC(19,14278,1,7,0)="ORDERS field (#15) in the LABORATORY SITE file (#69.9). The smaller of "
^DIC(19,14278,1,8,0)="the two will be used as the number of days before a pending order is "
^DIC(19,14278,1,9,0)="considered to be obsolete. If neither of these values is defined, a"
^DIC(19,14278,1,10,0)="MailMan message will be sent to the LMI mail group."
^DIC(19,14278,1,11,0)="  "
^DIC(19,14278,1,12,0)="This option should be queued to run in TASKMAN nightly."
^DIC(19,14278,25)="EN^LRJPON"
^DIC(19,14278,"U")="OBSOLETE PENDING LAB ORDERS"
^DIC(19,14279,0)="LRJ MAINT INACTIVE DT FILE 61^Edit Inactive Date - TOPOGRAPHY FIELD^^E^1^LRLIASON^^^^^^"
