^DIC(19,13543,1,0)="^19.06^3^3^3070327^^^^"
^DIC(19,13543,1,1,0)="This report displays the Service Connected changes by clinical service"
^DIC(19,13543,1,2,0)="M:MEDICINE;S:SURGERY;P:PSYCHIATRY;R:REHAB MEDICINE;N:NEUROLOGY;0:NONE and"
^DIC(19,13543,1,3,0)="by the clinic with that service."
