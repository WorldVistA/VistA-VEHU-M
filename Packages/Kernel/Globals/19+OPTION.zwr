^DIC(19,6278,"U")="UNCLASSIFIED MIDNIGHT PATIENTS"
^DIC(19,6279,0)="NURAAM-MD-UNCBAT^Batch Run of Unclassified Midnight Patients^^R^10958^^^^^^^28^^1"
^DIC(19,6279,1,0)="^^2^2^2930120^^^^"
^DIC(19,6279,1,1,0)="This is an optional report, that the site may or may not wish to queue to run.  This option should be queued at least 2 hours after the queuing of the NURAAM-ACU option."
^DIC(19,6279,1,2,0)="This option will print out the unclassified patients not counted by the NURAAM-ACU."
^DIC(19,6279,20)="S NURTYPE=1"
^DIC(19,6279,25)="EN3^NURAAU2"
^DIC(19,6279,"U")="BATCH RUN OF UNCLASSIFIED MIDN"
