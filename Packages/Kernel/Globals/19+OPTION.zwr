^DIC(19,10427,0)="TIUFC CREATE DDEFS MGR^Create Document Definitions^^A^10000000020^^^^^^n^516^^1"
^DIC(19,10427,1,0)="^^11^11^2970220^"
^DIC(19,10427,1,1,0)="The Create Document Definitions Option lets you create new entries of any"
^DIC(19,10427,1,2,0)="type except Object, placing them where they belong in the hierarchy."
^DIC(19,10427,1,3,0)=" "
^DIC(19,10427,1,4,0)="Although entries can be created using the Edit and Sort Options, the"
^DIC(19,10427,1,5,0)="Create Option streamlines the process. This option presents entries in"
^DIC(19,10427,1,6,0)="hierarchy order, traversing ONE line of descent, starting from Clinical"
^DIC(19,10427,1,7,0)="Documents at the top."
^DIC(19,10427,1,8,0)=" "
^DIC(19,10427,1,9,0)="The Create Option permits you to view, edit, and create entries, but only"
^DIC(19,10427,1,10,0)="from within the current line of descent.  The Create Option does not let"
^DIC(19,10427,1,11,0)="you copy an entry."
^DIC(19,10427,20)="N TIUFWHO S TIUFWHO=""M"" D EN^TIUFC"
^DIC(19,10427,99)="56434,85597"
^DIC(19,10427,99.1)="59164,31868"
^DIC(19,10427,"U")="CREATE DOCUMENT DEFINITIONS"
