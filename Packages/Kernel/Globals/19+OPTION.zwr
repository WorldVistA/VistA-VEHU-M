^DIC(19,11267,1,0)="^^3^3^2990107^"
^DIC(19,11267,1,1,0)="This is an option for the Lab Technician to initiate the lab stock"
^DIC(19,11267,1,2,0)="issue request and close it. This option will automatically create a"
^DIC(19,11267,1,3,0)="patient 2319 record with a Form requested on as Lab Issuance-3."
