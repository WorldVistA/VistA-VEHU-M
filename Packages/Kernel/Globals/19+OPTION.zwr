^DIC(19,13931,10,"C",2,2)=""
^DIC(19,13931,10,"C",3,3)=""
^DIC(19,13931,10,"C",4,4)=""
^DIC(19,13931,99)="64407,58492"
^DIC(19,13931,99.1)="61662,79248"
^DIC(19,13931,"U")="MDRO TOOLS REPORTS MENU"
^DIC(19,13932,0)="MMRS ISOLATION REPORT (TASKED)^Print Isolation Report (Tasked)^^R^10000000216^^^^^^^569"
^DIC(19,13932,1,0)="^^15^15^3090304^"
^DIC(19,13932,1,1,0)="This option should not be run interactively - it should only be tasked to "
^DIC(19,13932,1,2,0)="run via Taskman. This option will print the isolation report. In order for"
^DIC(19,13932,1,3,0)="it to run correctly, when the option is scheduled to run in Taskman via"
^DIC(19,13932,1,4,0)="the option 'Schedule/Unschedule Options' [XUTM SCHEDULE], some variables"
^DIC(19,13932,1,5,0)="need to be setup on Page 2."
^DIC(19,13932,1,6,0)=" "
^DIC(19,13932,1,7,0)="The Variable Name 'MMRSDIV' should be added and its Value should be set to"
^DIC(19,13932,1,8,0)="the IEN in file 104 for the Division this option is running for."
^DIC(19,13932,1,9,0)=" "
^DIC(19,13932,1,10,0)="If the option will print the report for all locations, then 'MMRSLOC'"
^DIC(19,13932,1,11,0)="should be added as a Variable Name and its Value should be set to '""ALL""'."
^DIC(19,13932,1,12,0)="If the option will only print for a few locations, then for each location"
^DIC(19,13932,1,13,0)="that will be printed, a Variable Name should be added as follows:"
^DIC(19,13932,1,14,0)="MMRSLOC(LOCIEN) (where LOCIEN is the geographical unit IEN from file "
^DIC(19,13932,1,15,0)="104.3) and its Value should be set to '""""'."
^DIC(19,13932,25)="MAIN2^MMRSISL"
^DIC(19,13932,200.9)="y"
^DIC(19,13932,"U")="PRINT ISOLATION REPORT (TASKED"
^DIC(19,13933,0)="MMRS NARES SWAB LIST (TASKED)^Print Nares Screen Compliance List (Tasked)^^R^10000000216^^^^^^^569"
^DIC(19,13933,1,0)="^^15^15^3090304^"
^DIC(19,13933,1,1,0)="This option should not be run interactively - it should only be tasked to"
^DIC(19,13933,1,2,0)="run via Taskman. This option will print the Nares Screen Compliance List."
^DIC(19,13933,1,3,0)="In order for it to run correctly, when the option is scheduled to run in"
^DIC(19,13933,1,4,0)="Taskman via the option 'Schedule/Unschedule Options' [XUTM SCHEDULE], some"
^DIC(19,13933,1,5,0)="variables need to be setup on Page 2."
^DIC(19,13933,1,6,0)="  "
^DIC(19,13933,1,7,0)="The Variable Name 'MMRSDIV' should be added and its Value should be set to"
^DIC(19,13933,1,8,0)="the IEN in file 104 for the Division this option is running for."
^DIC(19,13933,1,9,0)="  "
^DIC(19,13933,1,10,0)="If the option will print the report for all locations, then 'MMRSLOC' "
^DIC(19,13933,1,11,0)="should be added as a Variable Name and its Value should be set to"
^DIC(19,13933,1,12,0)="'""ALL""'.  If the option will only print for a few locations, then for each"
^DIC(19,13933,1,13,0)="location that will be printed, a Variable Name should be added as follows:"
^DIC(19,13933,1,14,0)="MMRSLOC(LOCIEN) (where LOCIEN is the geographical unit IEN from file"
^DIC(19,13933,1,15,0)="104.3) and its Value should be set to '""""'."
^DIC(19,13933,25)="MAIN2^MMRSORD"
^DIC(19,13933,200.9)="y"
^DIC(19,13933,"U")="PRINT NARES SCREEN COMPLIANCE "
^DIC(19,13934,0)="MMRS MRSA IPEC AUTO-EXTRACT^MRSA IPEC Auto-Extract (Tasked)^^R^10000000216^^^^^^^569"
^DIC(19,13934,1,0)="^^5^5^3090901^"
^DIC(19,13934,1,1,0)="This option will auto-extract MRSA data for entry into the Inpatient "
^DIC(19,13934,1,2,0)="Evaluation Center (IPEC) for the previous month's MRSA prevalence and "
^DIC(19,13934,1,3,0)="transmission measures, via a MailMan message.  This option should be "
^DIC(19,13934,1,4,0)="scheduled to run once a month. This option should not be run"
^DIC(19,13934,1,5,0)="interactively; it should only be tasked to run via TaskMan."
^DIC(19,13934,25)="TASK^MMRSIPC5"
^DIC(19,13934,200.9)="y"
^DIC(19,13934,"U")="MRSA IPEC AUTO-EXTRACT (TASKED"
