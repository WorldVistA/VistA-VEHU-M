^DIC(19,12468,0)="PSB BCBU USER INIT^Initialize a Backup Workstation with BCMA Users^^R^10000000020^^^^^^^533"
^DIC(19,12468,1,0)="^19.06^4^4^3030808^^"
^DIC(19,12468,1,1,0)="This option searches the VISTA New Person file for authorized BCMA users "
^DIC(19,12468,1,2,0)="and generates a version 2.4 HL7 message. Messages are addressed "
^DIC(19,12468,1,3,0)="dynamically based on the parameter definitions for BCMA Backup using "
^DIC(19,12468,1,4,0)="divisions or the default group."
^DIC(19,12468,25)="INIT^ALPBGEN2"
^DIC(19,12468,"U")="INITIALIZE A BACKUP WORKSTATIO"
