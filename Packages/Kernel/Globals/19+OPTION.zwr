^DIC(19,11390,0)="DGMST ENTER NEW MST^MST Status Add/Edit^Add/edit MST status only in MST Clinical Reminder^A^1^^^^^^^114^^1^1"
^DIC(19,11390,1,0)="^^6^6^2990305^^"
^DIC(19,11390,1,1,0)="This option will allow the user to enter, edit, delete, and display new"
^DIC(19,11390,1,2,0)="MST status codes to the MST HISTORY File (#29.11) for patients through a"
^DIC(19,11390,1,3,0)="List Manager Interface. Edit, delete will only be allowed for entries"
^DIC(19,11390,1,4,0)="in the current session.  Previous file entries cannot be modified. On"
^DIC(19,11390,1,5,0)="exiting the option, HL7 messages will be posted to send the MST status"
^DIC(19,11390,1,6,0)="information to the NPCD."
^DIC(19,11390,15)="K DGMSTLM"
^DIC(19,11390,20)="S DGMSTLM=1 D EN^DGMSTL"
^DIC(19,11390,99.1)="64074,59637"
^DIC(19,11390,"U")="MST STATUS ADD/EDIT"
^DIC(19,11391,0)="DGMST OUTPUTS^MST Outputs^^M^11281^^^^^^^114"
^DIC(19,11391,1,0)="^^1^1^2990119^^^^"
^DIC(19,11391,1,1,0)="This is the menu for the MST reports"
^DIC(19,11391,10,0)="^19.01IP^4^4"
^DIC(19,11391,10,1,0)="11393^STAT^1"
^DIC(19,11391,10,2,0)="11392^SUM^11"
