^DIC(19,3558,0)="PRCAC TR ADM^Add an Administrative Cost^^A^.5^^^^^^^^^1"
^DIC(19,3558,1,0)="^^4^4^2880817^^^^"
^DIC(19,3558,1,1,0)="This option adds an administrative cost to the  accounts receivable."
^DIC(19,3558,1,2,0)="The cost could be marshal fee, court cost, IRS Loc. cost, Credit Rep. cost"
^DIC(19,3558,1,3,0)=", Dept. of Motor Vehicles Loc. cost, Consumer Rep. Agency cost, etc."
^DIC(19,3558,1,4,0)="These costs are accrued to the administrative cost balance automatically."
^DIC(19,3558,20)="N PRC D EN1^PRCAWO1 K DTOUT"
^DIC(19,3558,25)=""
^DIC(19,3558,99)="55707,32078"
