^DIC(19,15354,1,1,0)="This menu stores a list of Quick Orders reports and conversion utilities."
^DIC(19,15354,1,2,0)="Cloned from ""ORCM REPORT/CONV UTILITIES"" option."
^DIC(19,15354,3)=""
