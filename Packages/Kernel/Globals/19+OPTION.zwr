^DIC(19,3494,"U")="DATA DICTIONARY CROSS-REFERENC"
^DIC(19,3495,0)="XT-KERMIT EDIT^Edit KERMIT holding file^^E^.5^^^^^^^^^1^1"
^DIC(19,3495,1,0)="^^3^3^2890608^^^"
^DIC(19,3495,1,1,0)="This option allows the user to edit their own holding file."
^DIC(19,3495,1,2,0)="They can change the name, Transfer mode, authorized viewers,"
^DIC(19,3495,1,3,0)="and the data."
^DIC(19,3495,15)="K DIA"
^DIC(19,3495,20)="S DIE=""DIZ(8980,"",DIA=DIE,DIA(""P"")=8980"
^DIC(19,3495,30)="DIZ(8980,"
^DIC(19,3495,31)="AEMQL"
