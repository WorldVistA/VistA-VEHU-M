^DIC(19,9851,0)="LR7O 60-64 AUTO^Semi-automatic Linking of file 60 to 64^^R^10000000020^^^^^^^26"
^DIC(19,9851,1,0)="^^10^10^2970717^^^^"
^DIC(19,9851,1,1,0)="This option should be run first to automatically link the"
^DIC(19,9851,1,2,0)="LABORATORY TESTS file (#60) to WKLD CODES file (#64). It will"
^DIC(19,9851,1,3,0)="reduce the LIM workload in preparation for PCE and OE/RR V. 3.0"
^DIC(19,9851,1,4,0)="installs."
^DIC(19,9851,1,5,0)=" "
^DIC(19,9851,1,6,0)="This option looks for potential matches in File #60 with"
^DIC(19,9851,1,7,0)="File #64 and allow the user to link the entries. After this option"
^DIC(19,9851,1,8,0)="is run, the Manual Linking of File 60 to 64 [LR7O 60-64 MANUAL]"
^DIC(19,9851,1,9,0)="option should be run to manually link the entries that this"
^DIC(19,9851,1,10,0)="option could not match."
^DIC(19,9851,25)="64^LR7OU4"
^DIC(19,9851,99)="57807,52584"
^DIC(19,9851,"U")="SEMI-AUTOMATIC LINKING OF FILE"
^DIC(19,9852,0)="LR7O 60-64 MANUAL^Manual Linking of file 60 to 64^^R^10000000020^^^^^^^26"
^DIC(19,9852,1,0)="^^9^9^2990301^"
^DIC(19,9852,1,1,0)="This option loops through the entries in LABORATORY TEST"
^DIC(19,9852,1,2,0)="file (#60) in alphabetical order and allows the user to"
^DIC(19,9852,1,3,0)="link its entries with appropriate entries in WKLD CODE file"
^DIC(19,9852,1,4,0)="(#64). This process needs to be done prior to the installation"
^DIC(19,9852,1,5,0)="of OE/RR V. 3.0."
^DIC(19,9852,1,6,0)=" "
^DIC(19,9852,1,7,0)="The Semi-Automatic Linking of File 60 to 64 [LR7O 60-64 AUTO]"
^DIC(19,9852,1,8,0)="option should be used first to link exact matching entries in File #60"
^DIC(19,9852,1,9,0)="to entries in File #64."
^DIC(19,9852,25)="EN^LR7OU5"
^DIC(19,9852,99)="57807,41428"
^DIC(19,9852,"U")="MANUAL LINKING OF FILE 60 TO 6"
^DIC(19,9853,0)="LR7O 60-64^National Laboratory File^^M^10000000020^^^^^^^26"
^DIC(19,9853,1,0)="^^4^4^2990119^^^^"
^DIC(19,9853,1,1,0)="This menu contains options to be used to link Laboratory tests"
