^DIC(19,17043,0)="SD ADV CLINIC SEARCH^Advanced Clinic Search Report^^R^1^^^^^^^16"
^DIC(19,17043,1,0)="^^9^9^3250624^"
^DIC(19,17043,1,1,0)="This report allows a user to search all clinics by the"
^DIC(19,17043,1,2,0)=" following criteria: "
^DIC(19,17043,1,3,0)="  CLINIC NAME "
