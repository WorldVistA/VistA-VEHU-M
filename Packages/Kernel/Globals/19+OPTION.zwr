^DIC(19,5568,0)="GMTS TYPE DELETE^Delete Health Summary Type^^E^10000000020^^^^^^^160^^1^1"
^DIC(19,5568,1,0)="^19.06^8^8^3020911^^^^"
^DIC(19,5568,1,1,0)="This option allows the owner of a Health Summary Type to delete"
^DIC(19,5568,1,2,0)="it. In addition anyone who holds the GMTSMGR key may use this "
^DIC(19,5568,1,3,0)="option. Also, if a Health Summary Type has a lock, anyone who "
^DIC(19,5568,1,4,0)="holds a key with that lock value may delete that Health Summary"
^DIC(19,5568,1,5,0)="Type.  This Option will not allow the deletion of a Health Summary"
^DIC(19,5568,1,6,0)="Type in use by a Health Summary Object.  It will not allow the "
^DIC(19,5568,1,7,0)="deletion of special case Health Summary Types such as GMTS HS "
^DIC(19,5568,1,8,0)="ADHOC OPTION, or REMOTE Health Summary Types."
^DIC(19,5568,15)="K %,GMTSMGR"
^DIC(19,5568,20)="K DA,DIC,DIE,DIK,DR"
^DIC(19,5568,30)="GMT(142,"
^DIC(19,5568,31)="AEMQ"
^DIC(19,5568,32)="Select Health Summary Type:"
^DIC(19,5568,34)="I +($$DHST^GMTSULT(+($G(Y))))"
^DIC(19,5568,50)="GMT(142,"
^DIC(19,5568,51)="[GMTS DELETE HLTH SUM TYPE]"
^DIC(19,5568,"U")="DELETE HEALTH SUMMARY TYPE"
^DIC(19,5569,0)="GMTS TYPE ENTER/EDIT^Create/Modify Health Summary Type^^R^.5^^^^^^^^^1"
^DIC(19,5569,1,0)="^^9^9^2950816^"
^DIC(19,5569,1,1,0)="This option allows the user to create or modify a Health Summary Type. New"
^DIC(19,5569,1,2,0)="types created under this option will automatically define the creator as"
^DIC(19,5569,1,3,0)="the owner unless creator holds the GMTSMGR security key in which case"
^DIC(19,5569,1,4,0)="GMTSMGR-holder may designate owner of his choice. Normally Health Summary"
^DIC(19,5569,1,5,0)="Types may be modified only by their owner. Exceptions are: someone who"
^DIC(19,5569,1,6,0)="holds the GMTSMGR key may modify any Health Summary Type. If a Health"
^DIC(19,5569,1,7,0)="Summary Type has a lock, someone who holds a security key with that lock"
^DIC(19,5569,1,8,0)="value may modify that Health Summary Type. Use the 'Delete Health Summary"
^DIC(19,5569,1,9,0)="Type' option to delete the Health Summary Type."
