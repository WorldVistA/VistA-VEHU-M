^DIC(19,16087,0)="EHM-00908^Create/Modify Health Summary Type^^R^1^^^^^^^^^1^^"
^DIC(19,16087,1,0)="^^10^10^3240328^"
^DIC(19,16087,1,1,0)="This option allows the user to create or modify a Health Summary Type. New"
^DIC(19,16087,1,2,0)="types created under this option will automatically define the creator as"
^DIC(19,16087,1,3,0)="the owner unless creator holds the GMTSMGR security key in which case"
^DIC(19,16087,1,4,0)="GMTSMGR-holder may designate owner of his choice. Normally Health Summary"
^DIC(19,16087,1,5,0)="Types may be modified only by their owner. Exceptions are: someone who"
^DIC(19,16087,1,6,0)="holds the GMTSMGR key may modify any Health Summary Type. If a Health"
^DIC(19,16087,1,7,0)="Summary Type has a lock, someone who holds a security key with that lock"
^DIC(19,16087,1,8,0)="value may modify that Health Summary Type. Use the 'Delete Health Summary"
^DIC(19,16087,1,9,0)="Type' option to delete the Health Summary Type."
^DIC(19,16087,1,10,0)="Cloned from ""GMTS TYPE ENTER/EDIT"" option."
^DIC(19,16087,3)=""
^DIC(19,16087,15)=""
^DIC(19,16087,20)="K DA,DIC,DIE,DR"
^DIC(19,16087,25)="GMTSRM"
^DIC(19,16087,30)=""
