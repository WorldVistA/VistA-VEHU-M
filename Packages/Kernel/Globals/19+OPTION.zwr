^DIC(19,11653,0)="XM SUPER SEARCH^Super Search Message File^^R^11748^XM SUPER SEARCH^^^^^^54"
^DIC(19,11653,1,0)="^19.06^20^20^3000907^^^^"
^DIC(19,11653,1,1,0)="This option lets the authorized user (anyone holding the XM SUPER SEARCH"
^DIC(19,11653,1,2,0)="key) search the Message file for messages meeting any number of criteria,"
^DIC(19,11653,1,3,0)="no matter who sent the messages."
^DIC(19,11653,1,4,0)=" "
^DIC(19,11653,1,5,0)="This option should not be used lightly.  One example in which usage is"
^DIC(19,11653,1,6,0)="justified would be the search for evidence in an EEO harassment case."
^DIC(19,11653,1,7,0)=" "
^DIC(19,11653,1,8,0)="This option should be audited to track who uses it."
^DIC(19,11653,1,9,0)=" "
^DIC(19,11653,1,10,0)="Every search will trigger the sending of the XM SUPER SEARCH bulletin to"
^DIC(19,11653,1,11,0)="the XM SUPER SEARCH mail group.  The bulletin will record who (DUZ)"
^DIC(19,11653,1,12,0)="conducted the search and what criteria were used.  It will not record"
^DIC(19,11653,1,13,0)="the results of the search."
^DIC(19,11653,1,14,0)=" "
^DIC(19,11653,1,15,0)="The XM SUPER SEARCH mail group must have at least two active local users"
^DIC(19,11653,1,16,0)="in it who have logged on recently.  If it doesn't, the search will not be"
^DIC(19,11653,1,17,0)="performed.  Members of this mail group should be anyone whose"
^DIC(19,11653,1,18,0)="responsibility it is to ensure that security is maintained and privileges"
^DIC(19,11653,1,19,0)="are not abused.  The mail group coordinator should be the site's"
^DIC(19,11653,1,20,0)="Information Security Officer or another responsible individual."
^DIC(19,11653,25)="SUPER^XMJMF"
^DIC(19,11653,"U")="SUPER SEARCH MESSAGE FILE"
