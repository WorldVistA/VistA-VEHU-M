^DIC(19,15712,25)="UVMED^ORB3MGR1"
^DIC(19,15712,"U")="SET DELAY FOR UNVERIFIED MEDIC"
^DIC(19,15713,0)="EHM-00534^Set Delay for All Unverified Orders^^R^1^^^^^^^^^^^"
^DIC(19,15713,1,0)="^^4^4^3240328^"
^DIC(19,15713,1,1,0)="Enter the number of hours delay to wait after an order is placed before"
^DIC(19,15713,1,2,0)="triggering an Unverified Order notification/alert.  The maximum number of"
^DIC(19,15713,1,3,0)="hours is 10,000."
^DIC(19,15713,1,4,0)="Cloned from ""ORB3 UNVERIFIED ORDER"" option."
^DIC(19,15713,3)=""
^DIC(19,15713,25)="UNVER^ORB3MGR1"
^DIC(19,15713,"U")="SET DELAY FOR ALL UNVERIFIED O"
