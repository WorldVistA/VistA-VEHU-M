^DIC(19,6134,0)="ENEQ-WARRANTY^Warranty List^^R^.5^^^^^^^"
^DIC(19,6134,1,0)="^^2^2^2880516^"
^DIC(19,6134,1,1,0)="Prints all devices whose warranties are scheduled to expire within a"
^DIC(19,6134,1,2,0)="user specified time interval."
^DIC(19,6134,25)="W^ENEQRP1"
^DIC(19,6134,"U")="WARRANTY LIST"
^DIC(19,6135,0)="ENEQ-REPLACE^Replacement Listing^^R^.5^^^^^^^"
^DIC(19,6135,1,0)="^^2^2^2880516^"
^DIC(19,6135,1,1,0)="Prints all entries in the EQUIPMENT INV. File scheduled for replacement"
^DIC(19,6135,1,2,0)="within a user specified time interval."
^DIC(19,6135,25)="R^ENEQRP1"
^DIC(19,6135,99)="55720,42433"
^DIC(19,6135,"U")="REPLACEMENT LISTING"
^DIC(19,6136,0)="ENEQ-FAILURE^Failure Rate Report^^R^.5^^^^^^^"
^DIC(19,6136,1,0)="^^1^1^2880516^"
^DIC(19,6136,1,1,0)="Prints a synopsis of the repair history of user specified device types."
^DIC(19,6136,25)="F1^ENEQRP3"
^DIC(19,6136,"U")="FAILURE RATE REPORT"
^DIC(19,6137,0)="ENEQ-PLANNER^PM Workload Analysis^^R^.5^^^^^^^"
^DIC(19,6137,1,0)="^^2^2^2880516^"
^DIC(19,6137,1,1,0)="Prints a breakdown of scheduled PMI hours by month for a given shop."
^DIC(19,6137,1,2,0)="Intended as a tool in balancing PM workload."
^DIC(19,6137,25)="EN^ENEQRP5"
^DIC(19,6137,"U")="PM WORKLOAD ANALYSIS"
^DIC(19,6138,0)="ENWODISAP^Disapprove Work Order^^R^.5^^^^^^^"
^DIC(19,6138,1,0)="^^4^4^2880707^"
^DIC(19,6138,1,1,0)="Use this option to record disapproval action on a work request. It is"
^DIC(19,6138,1,2,0)="anticipated that this option will be most useful at facilities which allow"
^DIC(19,6138,1,3,0)="entry of work requests into AEMS/MERS by personnel outside of Engineering"
^DIC(19,6138,1,4,0)="Service."
^DIC(19,6138,20)=""
^DIC(19,6138,25)="DISAP^ENWO2"
^DIC(19,6138,"U")="DISAPPROVE WORK ORDER"
^DIC(19,6139,0)="ENINV EDIT^Inventory Edit^^R^11596^^^^^^^"
^DIC(19,6139,1,0)="^^4^4^2920427^^^^"
^DIC(19,6139,1,1,0)="Edit the record of an existing piece of equipment. The .01 field (ENTRY"
^DIC(19,6139,1,2,0)="NUMBER) is assigned by the system when an item is first added to the"
^DIC(19,6139,1,3,0)="EQUIPMENT INV. File and may not be edited."
^DIC(19,6139,1,4,0)="This option gives access to both Supply and Engineering fields."
^DIC(19,6139,25)="EQED^ENEQ2"
^DIC(19,6139,"U")="INVENTORY EDIT"
^DIC(19,6140,0)="ENWONEW-WARD^Request Electronic Work Order^^A^.5^^^^^^^^^1^1"
^DIC(19,6140,1,0)="^^5^5^2900828^^^^"
^DIC(19,6140,1,1,0)="Entry of Engineering work requests by non-Engineering personnel. Intent"
^DIC(19,6140,1,2,0)="is to reduce volume of written work orders and to reduce telephone calls"
^DIC(19,6140,1,3,0)="to Engineering Work Control desk. Assumes that AEMS/MERS has been"
^DIC(19,6140,1,4,0)="integrated with CORE systems so that all DHCP users have access to the"
^DIC(19,6140,1,5,0)="Engineering Package."
^DIC(19,6140,15)="K ENSHKEY"
^DIC(19,6140,20)="S ENDR=$S($D(^DIE(""B"",""ENZWOWARD"")):""[ENZWOWARD]"",1:""[ENWOWARD]"") D INIT^EN,WARD^ENWONEW"
^DIC(19,6140,25)=""
^DIC(19,6140,"U")="REQUEST ELECTRONIC WORK ORDER"
^DIC(19,6142,0)="ENWOEDIT-WARD^Edit Electronic Work Order ^^R^.5^^^^^^^"
^DIC(19,6142,1,0)="^^4^4^2900611^^"
^DIC(19,6142,1,1,0)="Permits non-Engineering users to edit work requests which were input via"
^DIC(19,6142,1,2,0)="the 'Electronic Work Order Request' option. Once work orders have been"
^DIC(19,6142,1,3,0)="transferred by Engineering Service to a working shop they may no longer"
^DIC(19,6142,1,4,0)="be edited via this option, but users may check their status."
^DIC(19,6142,25)="WRDEDT^ENWARD"
^DIC(19,6142,"U")="EDIT ELECTRONIC WORK ORDER "
^DIC(19,6143,0)="ENWOWARD^Electronic Work Requests^^M^11596^^^^^^^"
^DIC(19,6143,1,0)="^^2^2^2900611^^^^"
^DIC(19,6143,1,1,0)="Main option for entry and status checking of Engineering work requests"
^DIC(19,6143,1,2,0)="by DHCP users outside of Engineering Service."
^DIC(19,6143,10,0)="^19.01PI^4^4"
^DIC(19,6143,10,1,0)="6142^2"
^DIC(19,6143,10,2,0)="6140^1"
^DIC(19,6143,10,3,0)="6144^3"
^DIC(19,6143,10,4,0)="6406^4"
