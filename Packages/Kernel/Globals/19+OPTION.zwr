^DIC(19,11854,0)="RG EXCEPTION TF INQUIRY^Patient MPI/PD Data Inquiry^^R^1^^^^^^^525"
^DIC(19,11854,1,0)="^^3^3^3070327^"
^DIC(19,11854,1,1,0)="This report provides MPI/PD Data for a selected patient.  The information "
^DIC(19,11854,1,2,0)="displayed includes the Integration Control Number (ICN), patient identity "
^DIC(19,11854,1,3,0)="information, and Treating Facility list."
^DIC(19,11854,25)="PDAT^RGEX01"
^DIC(19,11854,"U")="PATIENT MPI/PD DATA INQUIRY"
^DIC(19,11855,0)="RG STATUS DISPLAY^Unresolved Exception Summary^^R^1^^^^^^^525"
^DIC(19,11855,1,0)="^^10^10^3080527^"
^DIC(19,11855,1,1,0)=" The Unresolved Exception Summary calculates and presents the"
^DIC(19,11855,1,2,0)=" following data."
^DIC(19,11855,1,3,0)=" - the number of unresolved exceptions in the CIRN HL7 EXCEPTION LOG "
^DIC(19,11855,1,4,0)="   (#991.1) file for the MPI/PD related entries in the CIRN HL7"
^DIC(19,11855,1,5,0)="   EXCEPTION TYPE (#991.11) file, and"
^DIC(19,11855,1,6,0)=" - the number of unique patients with exceptions."
^DIC(19,11855,1,7,0)=" "
^DIC(19,11855,1,8,0)=" The Exception Handler numbers indicate how up-to-date a site is in"
^DIC(19,11855,1,9,0)=" exception resolution.  This data can be useful in reducing the"
^DIC(19,11855,1,10,0)=" number of exceptions."
^DIC(19,11855,25)="RGSYSTAT"
^DIC(19,11855,"U")="UNRESOLVED EXCEPTION SUMMARY"
