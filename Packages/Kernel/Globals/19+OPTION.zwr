^DIC(19,9700,"U")="IV SOLUTION"
^DIC(19,9701,0)="GMRY INPUT FILE1^Intake Type^^E^10958^^^^^^^502^^1^1"
^DIC(19,9701,1,0)="^^3^3^2960119^^^^"
^DIC(19,9701,1,1,0)="This option is used by the ADP coordinator to configure the NON-IV"
^DIC(19,9701,1,2,0)="intake type entries for the GMRY INPUT TYPE file (#126.56).  For example, "
^DIC(19,9701,1,3,0)="PO, TUBE FEEDING, and OTHER are input types."
^DIC(19,9701,15)="K DLAYGO"
^DIC(19,9701,20)="S DLAYGO=126.56"
^DIC(19,9701,30)="GMRD(126.56,"
^DIC(19,9701,31)="AEMQL"
^DIC(19,9701,50)="GMRD(126.56,"
^DIC(19,9701,51)=".01;1"
^DIC(19,9701,"U")="INTAKE TYPE"
^DIC(19,9702,0)="GMRY OUTPUT FILE1^Output Type^^E^10958^^^^^^^502^^1^1"
^DIC(19,9702,1,0)="^^3^3^2970212^^^^"
^DIC(19,9702,1,1,0)="This option is provided for the ADP coordinator to configure the entries"
^DIC(19,9702,1,2,0)="for the GMRY OUTPUT TYPE file (#126.58).  URINE, STOOL and DRAINS, for"
^DIC(19,9702,1,3,0)="example, are major output types."
^DIC(19,9702,15)="K DLAYGO"
^DIC(19,9702,20)="S DLAYGO=126.58"
^DIC(19,9702,30)="GMRD(126.58,"
^DIC(19,9702,31)="AMEQL"
^DIC(19,9702,50)="GMRD(126.58,"
^DIC(19,9702,51)=".01;1"
^DIC(19,9702,"U")="OUTPUT TYPE"
^DIC(19,9703,0)="GMRY I/O CURRENT^Print I/O Summary (Midnight to Present)^^R^10958^^^^^^^502"
^DIC(19,9703,1,0)="^^1^1^2940114^^^^"
^DIC(19,9703,1,1,0)="This option summarizes current patient intake/output."
^DIC(19,9703,25)="EN4^GMRYRP0"
^DIC(19,9703,"U")="PRINT I/O SUMMARY (MIDNIGHT TO"
^DIC(19,9704,0)="GMRY I/O 48HRS^Print I/O Summary (48 Hrs)^^R^10958^^^^^^^502"
^DIC(19,9704,1,0)="^^2^2^2950301^^^^"
^DIC(19,9704,1,1,0)="This option summarizes patient intake/output for the previous day and "
^DIC(19,9704,1,2,0)="today."
^DIC(19,9704,25)="EN5^GMRYRP0"
^DIC(19,9704,99)="55441,54683"
^DIC(19,9704,"U")="PRINT I/O SUMMARY (48 HRS)"
^DIC(19,9705,0)="GMRY NURSHIFT^Shift Starting Hour and Other Parameters^^E^10958^^^^^^^502^^"
^DIC(19,9705,1,0)="^^4^4^2970225^"
^DIC(19,9705,1,1,0)="The shift starting hours stored in the GMRY NUR SHIFT/OTHER file (#126.95)"
^DIC(19,9705,1,2,0)="are used to calculate the patient's total intake/output for night, day and "
^DIC(19,9705,1,3,0)="evening shifts, respectively.  The data type for hours can be entered "
^DIC(19,9705,1,4,0)="""0800"", ""1600"" and ""2400""."
^DIC(19,9705,20)=""
^DIC(19,9705,30)="GMRD(126.95,"
^DIC(19,9705,31)="AMEQL"
^DIC(19,9705,50)="GMRD(126.95,"
^DIC(19,9705,51)="1;2;3"
^DIC(19,9705,99)="55516,49891"
^DIC(19,9705,"U")="SHIFT STARTING HOUR AND OTHER "
^DIC(19,9706,0)="GMRY EDIT INTAKE^Enter/Edit Patient Intake^^R^10958^^^^^^^502^^1^1"
^DIC(19,9706,1,0)="^^2^2^2960620^^^^"
^DIC(19,9706,1,1,0)="This option allows the user to enter or edit patient IV and NON-IV intake"
^DIC(19,9706,1,2,0)="records."
^DIC(19,9706,15)="K GMROUT"
^DIC(19,9706,20)="I $G(^GMRD(126.95,1,""OFF"")) S XQUIT=1"
^DIC(19,9706,25)="EN3^GMRYED0"
^DIC(19,9706,99)="55106,45597"
^DIC(19,9706,"U")="ENTER/EDIT PATIENT INTAKE"
^DIC(19,9707,0)="GMRY IV CARE^Start/Add/DC IV and Maintenance^^R^10958^^^^^^^502^^1"
^DIC(19,9707,1,0)="^^17^17^2961219^"
^DIC(19,9707,1,1,0)="This option contains seven protocols associated with intravenous therapy:"
^DIC(19,9707,1,2,0)="   1. Start IV - Starts a new IV line or a heparin/saline lock/port."
^DIC(19,9707,1,3,0)="   2. Solution: Replace/DC/Convert/Finish Solution - DC's the current"
^DIC(19,9707,1,4,0)="      solution, then replaces a new solution to the selected IV line or"
^DIC(19,9707,1,5,0)="      converts the IV according to the user's choice."
^DIC(19,9707,1,6,0)="   3. Replace Same Solution - Replaces the same solution to a selected IV"
^DIC(19,9707,1,7,0)="      line."
^DIC(19,9707,1,8,0)="   4. DC IV/Lock/Port and Site - Removes the IV/lock/port from a selected "
^DIC(19,9707,1,9,0)="      IV site and documents tubing changes."
^DIC(19,9707,1,10,0)="   5. Care/Maintenance/Flush - Checks the site condition, and documents"
^DIC(19,9707,1,11,0)="      dressing, tubing changes and flushes."
^DIC(19,9707,1,12,0)="   6. Add Additional Solution(s) - Adds additional solution(s) to an IV "
^DIC(19,9707,1,13,0)="      line without discontinuing an existing one."
^DIC(19,9707,1,14,0)="   7. Restart DC'd IV - Restarts an IV which was discontinued due to"
^DIC(19,9707,1,15,0)="      infiltration or other reasons."
^DIC(19,9707,1,16,0)="   8. Adjust Infusion Rate - Adjusts infusion rate for a selected IV."
^DIC(19,9707,1,17,0)="   9. Flush - Flushes all IV line(s) for a selected infusion site."
^DIC(19,9707,20)="I $G(^GMRD(126.95,1,""OFF"")) S XQUIT=1"
^DIC(19,9707,25)="EN1^GMRYED0"
^DIC(19,9707,99)="55441,47646"
^DIC(19,9707,"U")="START/ADD/DC IV AND MAINTENANC"
^DIC(19,9708,0)="GMRY SITE DESCRP^IV Site Description^^E^10958^^^^^^^502^^1^1"
^DIC(19,9708,1,0)="^^3^3^2960123^^^^"
^DIC(19,9708,1,1,0)="This option allows the ADP coordinator to enter IV site descriptions into "
^DIC(19,9708,1,2,0)="the GMRY IV SITE DESCRIPTION file (#126.72).  This information is used for "
^DIC(19,9708,1,3,0)="documenting site maintenance."
^DIC(19,9708,15)="K DLAYGO,DIDEL"
^DIC(19,9708,20)="S (DIDEL,DLAYGO)=126.72"
^DIC(19,9708,30)="GMRD(126.72,"
^DIC(19,9708,31)="AEMQL"
^DIC(19,9708,50)="GMRD(126.72,"
^DIC(19,9708,51)=".01;"
^DIC(19,9708,"U")="IV SITE DESCRIPTION"
^DIC(19,9709,0)="GMRY IV CATH^IV Catheter^^E^10958^^^^^^^502^^1^1"
^DIC(19,9709,1,0)="^^2^2^2960514^^^^"
^DIC(19,9709,1,1,0)="This option allows the ADP coordinator to enter types of IV catheters "
^DIC(19,9709,1,2,0)="into the GMRY IV CATHETER file (#126.74)."
^DIC(19,9709,15)="K DIDEL,DLAYGO"
^DIC(19,9709,20)="S (DIDEL,DLAYGO)=126.74"
^DIC(19,9709,30)="GMRD(126.74,"
^DIC(19,9709,31)="AEMQL"
^DIC(19,9709,50)="GMRD(126.74,"
^DIC(19,9709,51)=".01;1"
^DIC(19,9709,"U")="IV CATHETER"
^DIC(19,9710,0)="GMRY DC REASON^IV DC'ed Reason^^E^10958^^^^^^^502^^1^1"
^DIC(19,9710,1,0)="^^2^2^2960507^^^^"
^DIC(19,9710,1,1,0)="This option allows the ADP coordinator to edit reasons for"
^DIC(19,9710,1,2,0)="discontinuing an IV into the GMRY IV DC'ED REASON file (#126.76)."
^DIC(19,9710,15)="K DIDEL,DLAYGO"
^DIC(19,9710,20)="S (DIDEL,DLAYGO)=126.76"
^DIC(19,9710,30)="GMRD(126.76,"
^DIC(19,9710,31)="AEMQL"
^DIC(19,9710,50)="GMRD(126.76,"
^DIC(19,9710,51)=".01;"
