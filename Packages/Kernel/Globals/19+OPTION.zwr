^DIC(19,6250,0)="IB PURGE DELETE TEMPLATE ENTRY^Delete Entry from Search Template^^R^.5^^^^^^^192"
^DIC(19,6250,1,0)="^^10^10^2940207^^^"
^DIC(19,6250,1,1,0)="This option may be used to prevent a record from being purged from the"
^DIC(19,6250,1,2,0)="database.  The user will be prompted for an established Search Template"
^DIC(19,6250,1,3,0)="based on one of the following three files:"
^DIC(19,6250,1,4,0)=" "
^DIC(19,6250,1,5,0)="  350  INTEGRATED BILLING ACTION"
^DIC(19,6250,1,6,0)="  351  CATEGORY C BILLING CLOCK"
^DIC(19,6250,1,7,0)="  399  BILL/CLAIMS"
^DIC(19,6250,1,8,0)=" "
^DIC(19,6250,1,9,0)="The records stored in this template will be listed, and the user may"
^DIC(19,6250,1,10,0)="select a record to be deleted from the template."
^DIC(19,6250,25)="IBPUDEL"
^DIC(19,6250,"U")="DELETE ENTRY FROM SEARCH TEMPL"
