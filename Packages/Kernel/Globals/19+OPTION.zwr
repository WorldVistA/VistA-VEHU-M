^DIC(19,14759,99)="65279,68898"
^DIC(19,14759,"U")="CLOZAPINE INPATIENT MEDICATION"
^DIC(19,14760,0)="utMUNIT^M-Unit Tester^^B^1^^^^^^^"
^DIC(19,14760,1,0)="^^1^1^3140805^"
^DIC(19,14760,1,1,0)="This is the context option for M-Unit Test functionality."
^DIC(19,14760,"RPC",0)="^19.05P^3^3"
^DIC(19,14760,"RPC",1,0)=3984
^DIC(19,14760,"RPC",2,0)=3985
^DIC(19,14760,"RPC",3,0)=3986
^DIC(19,14760,"RPC","B",3984,1)=""
^DIC(19,14760,"RPC","B",3985,2)=""
^DIC(19,14760,"RPC","B",3986,3)=""
^DIC(19,14760,"U")="M-UNIT TESTER"
^DIC(19,14761,0)="utMUNIT GROUP EDIT^M-Unit Test Group Edit^^E^1^^^^^^^349"
^DIC(19,14761,1,0)="^19.06^6^6^3031030^^^"
^DIC(19,14761,1,1,0)="This option can be used to maintain a listing of unit tests related to a "
^DIC(19,14761,1,2,0)="specific topic.  The Group identifies the topic, and the unit tests "
^DIC(19,14761,1,3,0)="related to that topic are added in the multiple.  Unit Tests can be run "
^DIC(19,14761,1,4,0)="by selecting a group, and all unit tests included in the multiple will be "
^DIC(19,14761,1,5,0)="used for the test.  In addition, any other references under the XTROU tag "
^DIC(19,14761,1,6,0)="in any of the included test routines will be included in the run."
^DIC(19,14761,30)="%ut(17.9001,"
^DIC(19,14761,31)="AEMQL"
^DIC(19,14761,50)=17.9001
^DIC(19,14761,51)=".01;1"
^DIC(19,14761,"U")="M-UNIT TEST GROUP EDIT"
^DIC(19,14762,0)="utMUNIT GROUP RUN^Run M-Unit Tests From Test Groups^^R^1^^^^^^^349"
^DIC(19,14762,1,0)="^^2^2^3031030^"
^DIC(19,14762,1,1,0)="Provides a means of initiating a unit test run from the menu system based "
^DIC(19,14762,1,2,0)="on entries in the M-UNIT TEST GROUP file (#17.9001)."
^DIC(19,14762,25)="PICKSET^%ut"
^DIC(19,14762,"U")="RUN M-UNIT TESTS FROM TEST GRO"
^DIC(19,14763,0)="ECXINDIV^Print Stations and Divisions^^R^1^^^^^^^"
^DIC(19,14763,1,0)="^^10^10^3190529^"
^DIC(19,14763,1,1,0)="This report will display either all institutions/stations related to the "
^DIC(19,14763,1,2,0)="user selected institution or it will display all entries from the MEDICAL "
^DIC(19,14763,1,3,0)="CENTER DIVISION file."
^DIC(19,14763,1,4,0)=" "
^DIC(19,14763,1,5,0)="If the user chooses to list institutions, they'll be prompted to select "
^DIC(19,14763,1,6,0)="an institution.  The station number associated with the selected "
^DIC(19,14763,1,7,0)="institution will then be used to identify other related institutions.  "
^DIC(19,14763,1,8,0)="For example, if the user selects Salt Lake City (station number 660) then"
^DIC(19,14763,1,9,0)="all institution entries that have a station number that contains 660 will"
^DIC(19,14763,1,10,0)="be displayed."
^DIC(19,14763,25)="ECXINDIV"
^DIC(19,14763,"U")="PRINT STATIONS AND DIVISIONS"
^DIC(19,14764,0)="ECX PHA COST AUDIT^Pharmacy Extract Cost by Feeder Key^^R^1^^^^^^^513"
^DIC(19,14764,1,0)="^19.06^10^10^3190617^^"
^DIC(19,14764,1,1,0)="This report will show costs by feeder key for a selected pharamacy"
^DIC(19,14764,1,2,0)="related extract.  The user may select PHA, IVP, UDP or BCM."
^DIC(19,14764,1,3,0)=" "
^DIC(19,14764,1,4,0)="Once the specific pharmacy related extract is selected, the report will"
^DIC(19,14764,1,5,0)="group records by station and within station by feeder key.  The feeder key"
^DIC(19,14764,1,6,0)="for the BCMA extract will need to be built as the BCMA extract does not"
^DIC(19,14764,1,7,0)="use the feeder key as part of the extract."
^DIC(19,14764,1,8,0)=" "
^DIC(19,14764,1,9,0)="This report is extract only so the results will display to the screen for "
^DIC(19,14764,1,10,0)="capture and subsequent importing into excel."
^DIC(19,14764,25)="ECXCBFK"
^DIC(19,14764,"U")="PHARMACY EXTRACT COST BY FEEDE"
