^DIC(19,6371,1,0)="^^3^3^2910507^"
^DIC(19,6371,1,1,0)="This option will read a standard DSM %RS tape or disk file, or M/11"
^DIC(19,6371,1,2,0)="tape and compare the routines on the tape with a routine with the"
^DIC(19,6371,1,3,0)="same name in the current account."
^DIC(19,6371,25)="TAPE^XTRCMP"
^DIC(19,6371,"U")="COMPARE ROUTINES ON TAPE TO DI"
