^DIC(19,15363,0)="EHM-00184^CONVERT SUPPLY NON-FORMULARY OIS^^R^1^^^^^^^^^^^"
^DIC(19,15363,1,0)="^^4^4^3240328^"
^DIC(19,15363,1,1,0)="Use this option to set all orderable items marked as Supply and "
^DIC(19,15363,1,2,0)="Non-Formulary in the Orderable Items File (101.43) to be QO-ONLY set to "
^DIC(19,15363,1,3,0)="yes."
^DIC(19,15363,1,4,0)="Cloned from ""OR SUPPLY NF CONVERSION"" option."
^DIC(19,15363,3)=""
^DIC(19,15363,20)=""
^DIC(19,15363,25)="SUPPLYNF^ORSPUTIL"
^DIC(19,15363,"U")="CONVERT SUPPLY NON-FORMULARY O"
^DIC(19,15364,0)="EHM-00185^CONVERT SUPPLY OUTPATIENT OIS^^R^1^^^^^^^^^^^"
^DIC(19,15364,1,0)="^^4^4^3240328^"
^DIC(19,15364,1,1,0)="Use this option to set all orderable items that are marked as Supply and "
^DIC(19,15364,1,2,0)="that are set as QO-ONLY=YES for Outpatient Meds, to be QO-ONLY=YES for "
^DIC(19,15364,1,3,0)="Supplies also."
^DIC(19,15364,1,4,0)="Cloned from ""OR SUPPLY OP CONVERSION"" option."
^DIC(19,15364,3)=""
^DIC(19,15364,25)="COPYO2S^ORSPUTIL"
^DIC(19,15364,"U")="CONVERT SUPPLY OUTPATIENT OIS"
