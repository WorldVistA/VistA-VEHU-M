^DIC(19,16105,0)="EHM-00926^Health Summary Objects Menu^^M^1^^^^^^^^^^^"
^DIC(19,16105,1,0)="^19.06^5^5^3240328^^^^"
^DIC(19,16105,1,1,0)="Use this option to access utilities to add/edit a Health Summary "
^DIC(19,16105,1,2,0)="Object, display the characteristics of a Health Summary Object, "
^DIC(19,16105,1,3,0)="to test a Health Summary Object or to export/import a Health"
^DIC(19,16105,1,4,0)="Summary Object."
^DIC(19,16105,1,5,0)="Cloned from ""GMTS OBJ MENU"" option."
