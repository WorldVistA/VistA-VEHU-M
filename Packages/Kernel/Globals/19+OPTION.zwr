^DIC(19,1273,1,0)="^^2^2^2870203^^"
^DIC(19,1273,1,1,0)="This function allows the user to find information about a single"
^DIC(19,1273,1,2,0)="accession."
^DIC(19,1273,25)="SINGLE^LRWRKLST"
^DIC(19,1273,"U")="LOOKUP ACCESSION"
