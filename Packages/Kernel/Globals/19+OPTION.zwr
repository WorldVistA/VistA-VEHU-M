^DIC(19,7931,0)="PRSA TP ENVIR. DIFF.^Environmental Differential^^R^.5^^^^^^^"
^DIC(19,7931,1,0)="^^3^3^2930202^^^"
^DIC(19,7931,1,1,0)="This option allows the user to make changes to posted environmental"
^DIC(19,7931,1,2,0)="differential time card data on an employee's time card for a prior"
^DIC(19,7931,1,3,0)="pay period (a corrected time card)."
^DIC(19,7931,25)="PRSAEDR"
^DIC(19,7931,"U")="ENVIRONMENTAL DIFFERENTIAL"
^DIC(19,7932,0)="PRSA TP VCS^VCS Commission Sales^^R^.5^^^^^^^"
^DIC(19,7932,1,0)="^^3^3^2930202^^"
^DIC(19,7932,1,1,0)="This option allows changes to be made to an employee's posted Veteran"
^DIC(19,7932,1,2,0)="Canteen Service commission sales data from a prior pay period (a"
^DIC(19,7932,1,3,0)="corrected time card)."
^DIC(19,7932,25)="PRP^PRSATVC"
^DIC(19,7932,"U")="VCS COMMISSION SALES"
^DIC(19,7933,0)="PRSA TP POST^Posting/Tour Change^^R^.5^^^^^^^"
^DIC(19,7933,1,0)="^^3^3^2930202^^"
^DIC(19,7933,1,1,0)="This option allows changes to be made to an employee's posted time"
^DIC(19,7933,1,2,0)="card data or Tour of Duty for a prior pay period (a corrected time"
^DIC(19,7933,1,3,0)="card)."
^DIC(19,7933,25)="PRSATPP"
^DIC(19,7933,"U")="POSTING/TOUR CHANGE"
^DIC(19,7934,0)="PRSA TD LIST^List Tours by T&L^^R^.5^^^^^^^"
^DIC(19,7934,1,0)="^^10^10^2930202^^^^"
^DIC(19,7934,1,1,0)="The user is prompted to select a particular Time and Leave Unit (T&L)"
^DIC(19,7934,1,2,0)="or ALL Time and Leave Units. If a particular T&L is selected, then all"
^DIC(19,7934,1,3,0)="the tours associated with it are displayed. If ALL T&Ls are selected,"
^DIC(19,7934,1,4,0)="then all Tours of Duty will be displayed along with the T&Ls associated"
^DIC(19,7934,1,5,0)="with the tour."
^DIC(19,7934,1,6,0)=" "
^DIC(19,7934,1,7,0)="The tour number, start/stop times, number of hours in the tour,"
^DIC(19,7934,1,8,0)="start/stop times of the various segments of the tour, any special"
^DIC(19,7934,1,9,0)="indicators for each time segment and the T&L(s) associated with"
^DIC(19,7934,1,10,0)="the tour are displayed."
^DIC(19,7934,25)="PRSATD2"
^DIC(19,7934,99)="55500,51070"
^DIC(19,7934,"U")="LIST TOURS BY T&L"
^DIC(19,7935,0)="PRSA ED/VCS^Envir. Diff./VCS Sales^^M^.5^^^^^^^"
^DIC(19,7935,1,0)="^^3^3^2940321^^^^"
^DIC(19,7935,1,1,0)="This submenu allows the user to enter, cancel and list environmental"
^DIC(19,7935,1,2,0)="differential requests. Also, the user may post Veteran Canteen Service"
^DIC(19,7935,1,3,0)="commission sales."
