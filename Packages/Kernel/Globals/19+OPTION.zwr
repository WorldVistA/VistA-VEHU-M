^DIC(19,13264,0)="ECSCPT^Event Code Screens with CPT Codes^OPTION NO LONGER SUPPORTED. USE THE ECS GUI INTERFACE.^R^10000000020^^3504^^^^^499^^^1"
^DIC(19,13264,1,0)="^19.06^3^3^3051202^^"
^DIC(19,13264,1,1,0)="This option produces a list of event codes screens with CPT Codes. Users"
