^DIC(19,6207,"U")="PATIENT BILLING REPORTS MENU"
^DIC(19,6208,0)="IB OUTPUT CLK PROD^Clerk Productivity^^R^.5^^^^^^^192"
^DIC(19,6208,1,0)="^^2^2^2920616^^^^"
^DIC(19,6208,1,1,0)="Lists number and type of bills entered by selected clerks, over a"
^DIC(19,6208,1,2,0)="date range."
^DIC(19,6208,25)="IBOCPD"
^DIC(19,6208,"U")="CLERK PRODUCTIVITY"
^DIC(19,6213,0)="IB PURGE/BASC TRANSFER CLEANUP^Purge Update File^Obsolete and will be deleted by future version.^R^1253^XUMGR^^^^^^192"
^DIC(19,6213,1,0)="^^2^2^2960919^^^^"
^DIC(19,6213,1,1,0)="Delete all CPT entries in the temporary file that have been transferred"
^DIC(19,6213,1,2,0)="to the permanent billing file."
^DIC(19,6213,25)="PURGE^IBECPTZ"
^DIC(19,6213,"U")="PURGE UPDATE FILE"
^DIC(19,6217,0)="IB MT PROFILE^Single Patient Means Test Billing Profile^^R^10000000020^^^^^^^192"
^DIC(19,6217,1,0)="^19.06^3^3^3010910^^^^"
^DIC(19,6217,1,1,0)="The Means Test Billing Profile may be used to list, for a single patient,"
^DIC(19,6217,1,2,0)="all Means Test charges which fall within a user-specified"
^DIC(19,6217,1,3,0)="date range."
^DIC(19,6217,25)="IBOMTP"
^DIC(19,6217,"U")="SINGLE PATIENT MEANS TEST BILL"
^DIC(19,6218,0)="IB MT ESTIMATOR^Estimate Means Test Charges for an Admission^^R^10000000020^^^^^^^192"
^DIC(19,6218,1,0)="^19.06^4^4^3010910^^^^"
^DIC(19,6218,1,1,0)="This report is used to estimate the Means Test charges for"
^DIC(19,6218,1,2,0)="an episode of Hospital or Nursing Home Care, given a proposed length"
^DIC(19,6218,1,3,0)="of stay.  The report may also be used to determine the remaining"
^DIC(19,6218,1,4,0)="charges that will be billed to a current inpatient."
^DIC(19,6218,25)="IBOMTE"
^DIC(19,6218,"U")="ESTIMATE MEANS TEST CHARGES FO"
^DIC(19,6219,0)="IB MT NIGHT COMP^Queue Means Test Compilation of Charges^^R^1^^^^^^^192"
^DIC(19,6219,1,0)="^^18^18^3210706^"
^DIC(19,6219,1,1,0)="This job creates Means Test bills for all current inpatients"
^DIC(19,6219,1,2,0)="through the previous day.  The job should be queued to run each evening"
^DIC(19,6219,1,3,0)="after the G&L Recalculation has been completed."
^DIC(19,6219,1,4,0)=" "
^DIC(19,6219,1,5,0)="In order to ensure that Pandemic period copays are properly cancelled and "
^DIC(19,6219,1,6,0)="don't appear on patient statements, as required by the American Rescue"
^DIC(19,6219,1,7,0)="Plan Act (ARPA) of 2021, the IB MT NIGHT COMP VistA TaskMan job will need"
^DIC(19,6219,1,8,0)="to follow the scheduling criteria listed below:"
^DIC(19,6219,1,9,0)=" "
^DIC(19,6219,1,10,0)="Starts shortly after midnight local time."
^DIC(19,6219,1,11,0)=" "
^DIC(19,6219,1,12,0)="Starts after the DG G&L RECALCULATION AUTO nightly process."
^DIC(19,6219,1,13,0)=" "
^DIC(19,6219,1,14,0)="Starts at least 30 minutes prior to the start of the PRCA NIGHTLY PROCESS."
^DIC(19,6219,1,15,0)=" "
^DIC(19,6219,1,16,0)="You may need to reschedule the PRCA NIGHTLY PROCESS TaskMan job as well "
^DIC(19,6219,1,17,0)="to ensure that it starts at least 30 minutes after the start of the IB MT "
^DIC(19,6219,1,18,0)="NIGHT COMP TaskMan job."
^DIC(19,6219,25)="IBAMTC"
^DIC(19,6219,200.9)="y"
^DIC(19,6219,"U")="QUEUE MEANS TEST COMPILATION O"
^DIC(19,6221,0)="IB OUTPUT TREND REPORT^Insurance Payment Trend Report^^R^.5^^^^^^^192"
^DIC(19,6221,1,0)="^^7^7^2940207^^"
^DIC(19,6221,1,1,0)="This option allows the user to analyze payment trends among"
^DIC(19,6221,1,2,0)="insurance companies.  In addition, it may be used to track"
^DIC(19,6221,1,3,0)="receivables which are due the Medical Center.  Many different"
^DIC(19,6221,1,4,0)="criteria may be specified to limit the selection of bills,"
^DIC(19,6221,1,5,0)="such as Rate Type, Inpt/Outpt, Treatment Dates, Bill Printed"
^DIC(19,6221,1,6,0)="Dates, and Insurance Company.  Any additional field may also"
^DIC(19,6221,1,7,0)="be selected and analyzed depending upon its content."
^DIC(19,6221,25)="IBOTR"
^DIC(19,6221,"U")="INSURANCE PAYMENT TREND REPORT"
^DIC(19,6222,0)="IB OUTPT VISIT DATE INQUIRY^Outpatient Visit Date Inquiry^^R^.5^^^^^^^192"
^DIC(19,6222,1,0)="^^5^5^2920106^"
^DIC(19,6222,1,1,0)="This option displays a billing record which covers a specified"
^DIC(19,6222,1,2,0)="outpatient visit.  The user may select any patient with billed"
^DIC(19,6222,1,3,0)="outpatient visits, and then the visit date in question.  The"
^DIC(19,6222,1,4,0)="option displays the same information as found in the Patient"
^DIC(19,6222,1,5,0)="Billing Inquiry."
^DIC(19,6222,25)="IBCNQ1"
^DIC(19,6222,"U")="OUTPATIENT VISIT DATE INQUIRY"
