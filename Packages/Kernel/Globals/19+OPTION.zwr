^DIC(19,12276,1,2,0)="mode the cleanup process of the 3 Patient Relation & Income type files,"
^DIC(19,12276,1,3,0)="408.12, 408.21, & 408.22.  Bad pointers and partially stubbed in records "
^DIC(19,12276,1,4,0)="will be deleted."
^DIC(19,12276,25)="EN^DG488"
^DIC(19,12276,"U")="CLEANUP PATIENT RELATION/INCOM"
