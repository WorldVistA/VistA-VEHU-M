^DIC(19,16633,1,0)="^19.06^6^6^3240328^^^^"
^DIC(19,16633,1,1,0)="This provides a report of where selected Clinical Reminder findings"
^DIC(19,16633,1,2,0)="are used in reminder definitions, reminder terms, and reminder"
^DIC(19,16633,1,3,0)="dialogs."
