^DIC(19,6769,0)="PSD CORRECTION LOG^Correction Menu^^M^11595^^^^^^^276"
^DIC(19,6769,1,0)="^^17^17^2931110^^^^"
^DIC(19,6769,1,1,0)="This menu option allows the pharmacy supervisor access to make corrective"
^DIC(19,6769,1,2,0)="actions on Controlled Substances orders."
^DIC(19,6769,1,3,0)=" "
^DIC(19,6769,1,4,0)="Sometimes nursing may erroneously flag a Green Sheet ready for pharmacy"
^DIC(19,6769,1,5,0)="pickup.  Using this option, the pharmacy supervisor may change the"
^DIC(19,6769,1,6,0)="Green Sheet order status from COMPLETED - GREEN SHEET READY FOR PICKUP"
^DIC(19,6769,1,7,0)="to DELIVERED - ACTIVELY ON NAOU to correct this problem."
^DIC(19,6769,1,8,0)="  "
^DIC(19,6769,1,9,0)="The CS software allows pharmacy to add existing Green Sheets, active"
^DIC(19,6769,1,10,0)="orders on an NAOU, at package setup.  These orders may be tracked"
^DIC(19,6769,1,11,0)="using the CS software.  Sometimes one of these existing Green Sheets"
^DIC(19,6769,1,12,0)="may be incorrectly entered in the software.  Using this option,"
^DIC(19,6769,1,13,0)="the pharmacy supervisor may delete this erroneous existing Green"
^DIC(19,6769,1,14,0)="Sheet."
^DIC(19,6769,1,15,0)="   "
^DIC(19,6769,1,16,0)="An entry in the CS CORRECTION LOG file (#58.87) will be created"
^DIC(19,6769,1,17,0)="to log a history of all corrective actions."
^DIC(19,6769,10,0)="^19.01PI^7^7"
^DIC(19,6769,10,1,0)="8522^^2"
^DIC(19,6769,10,2,0)="8523^^3"
^DIC(19,6769,10,3,0)="6749^^1"
^DIC(19,6769,10,4,0)="8526^^4"
^DIC(19,6769,10,5,0)="8541^^20"
^DIC(19,6769,10,6,0)="8542^^40"
^DIC(19,6769,10,7,0)="8549^^30"
