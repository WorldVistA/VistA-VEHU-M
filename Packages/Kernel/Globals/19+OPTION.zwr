^DIC(19,14324,"U")="STATE PRESCRIPTION MONITORING "
^DIC(19,14325,0)="PSO SPMP STATE PARAMETERS^View/Edit SPMP State Parameters^^A^1^^^^^^^^^1"
^DIC(19,14325,1,0)="^^1^1^3130110^"
^DIC(19,14325,1,1,0)="This option is used for viewing or editing the State Prescription Monitoring Program (SPMP) parameters for a specific state."
^DIC(19,14325,20)="D ^PSOSPMSP"
^DIC(19,14325,"U")="VIEW/EDIT SPMP STATE PARAMETER"
^DIC(19,14326,0)="PSO SPMP BATCH VIEW/EXPORT^View/Export Batch^^A^1^^^^^^^^^1"
^DIC(19,14326,1,0)="^19.06^1^1^3130110^^"
^DIC(19,14326,1,1,0)="This option allows the user to visualize the State Prescription Monitoring Program (SPMP) data contained in one batch as well as the list of prescriptions in the batch. This option also allows the user to manually export the batch to the state."
^DIC(19,14326,20)="D ^PSOSPML2"
^DIC(19,14326,"U")="VIEW/EXPORT BATCH"
^DIC(19,14327,0)="PSO SPMP BATCH PROCESSING^Export Batch Processing^^A^1^^^^^^^^^1"
^DIC(19,14327,1,0)="^19.06^2^2^3130110^^"
^DIC(19,14327,1,1,0)="This option is used to monitor all the batches used to transmit State Prescription Monitoring Program (SPMP) data to the states. The user selects a data range and a list of batches is presented where the user can select perform different actions"
^DIC(19,14327,1,2,0)="on a specific batch."
^DIC(19,14327,20)="D ^PSOSPML1"
^DIC(19,14327,"U")="EXPORT BATCH PROCESSING"
^DIC(19,14328,0)="PSO SPMP SCHEDULED EXPORT^Scheduled SPMP Data Export^^A^1^^^^^^^^^1"
^DIC(19,14328,1,0)="^19.06^5^5^3130129^^^"
^DIC(19,14328,1,1,0)="This option is used for running the automatic transmissions to the states. It"
^DIC(19,14328,1,2,0)="should be scheduled to run nightly and it will decide when to transmit the data"
^DIC(19,14328,1,3,0)="to the state based on the REPORTING FREQUENCY IN DAYS field  value for the state,"
^DIC(19,14328,1,4,0)="which can be updated via the View/Edit SPMP State Parameters option [PSO SPMP"
^DIC(19,14328,1,5,0)="STATE PARAMETERS].  "
^DIC(19,14328,20)="D EXPORT^PSOSPML0"
^DIC(19,14328,200.9)="y"
^DIC(19,14328,"U")="SCHEDULED SPMP DATA EXPORT"
^DIC(19,14329,0)="PSO SPMP DISCLOSURE REPORT^Accounting Of Disclosures Report^^A^1^^^^^^^^^1"
^DIC(19,14329,1,0)="^^2^2^3130417^"
^DIC(19,14329,1,1,0)="This option is used for generating a list of all prescriptions transmitted to states. This option allows for a date range selection as well as one, multiple or all states and one, multiple or all patients. The list is sorted by state and then by"
^DIC(19,14329,1,2,0)="patient."
^DIC(19,14329,20)="D ^PSOSPML5"
^DIC(19,14329,"U")="ACCOUNTING OF DISCLOSURES REPO"
^DIC(19,14330,0)="PSO SPMP UNMARK ADMIN CLINIC^Unmark Rx Fill as Administered In Clinic^^A^1^^^^^^^^^1"
^DIC(19,14330,1,0)="^^4^4^3131010^"
^DIC(19,14330,1,1,0)="This option is used for resetting the flag that indicates a prescription"
^DIC(19,14330,1,2,0)="fill was 'Administered In Clinic'. The flag can only be set to 'No'. In"
^DIC(19,14330,1,3,0)="other words, you cannot use this option to flag a window or mail"
^DIC(19,14330,1,4,0)="prescription fill as 'Administered In Clinic'."
^DIC(19,14330,20)="D ^PSOSPML6"
^DIC(19,14330,"U")="UNMARK RX FILL AS ADMINISTERED"
^DIC(19,14331,0)="RMPR PURGE AGED^Purge Aged Purchasing Transactions^^R^1^RMPRMANAGER^^^^^^249"
^DIC(19,14331,1,0)="^^3^3^3241107^"
^DIC(19,14331,1,1,0)="This option is used to purge prosthetics orders in the PROSTHETICS 1358"
^DIC(19,14331,1,2,0)="(#664) file of aged transactions based on the same orders having been"
^DIC(19,14331,1,3,0)="purged from the PROCUREMENT & ACCOUNTING TRANSACTIONS (#442) file."
^DIC(19,14331,25)="EN20^RMPRCDP"
^DIC(19,14331,"U")="PURGE AGED PURCHASING TRANSACT"
^DIC(19,14332,0)="FBAA AUTH DATA AUDIT RPT^Historical Authorization Data Report^^R^1^^^^^^^344"
^DIC(19,14332,1,0)="^^1^1^3140220^"
^DIC(19,14332,1,1,0)="This option displays historical data for an authorization."
^DIC(19,14332,25)="FBAAAUDR"
^DIC(19,14332,"U")="HISTORICAL AUTHORIZATION DATA "
^DIC(19,14333,0)="XUPROGAUD^Direct-mode Programmer Access Audit^^A^1^^^^^^^163^n^1"
^DIC(19,14333,1,0)="^19.06^7^7^3140825^^^^"
^DIC(19,14333,1,1,0)="This option calls into the underlying M implementation's audit facility"
^DIC(19,14333,1,2,0)="in response to an OIG request to more closely monitor programmer access"
^DIC(19,14333,1,3,0)="into VistA systems.  It is part of the XUSPY menu, which is for"
^DIC(19,14333,1,4,0)="Information Security Officers, and is placed on the sub-menu Access"
^DIC(19,14333,1,5,0)="Monitor Menu [XUMNACCESS].  It was origianlly designed by Bryan Lucas"
^DIC(19,14333,1,6,0)="in HSP.  It uses ENTRY ACTION logic to call into the %ZSPECIAL routine"
^DIC(19,14333,1,7,0)="which is distributed by HSP to all sites."
^DIC(19,14333,20)="X ""NEW CRLF,Option,Pad,SQLCODE,Status,String,UTCBeginDateTime,UTCEndDateTime D ISOAUD^%ZSPECIAL()"""
^DIC(19,14333,"U")="DIRECT-MODE PROGRAMMER ACCESS "
