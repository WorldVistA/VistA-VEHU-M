^DIC(19,11884,0)="RGMT AUDIT SINGLE^Single Patient Audit File Print^^R^10000000033^^^^^^^525"
^DIC(19,11884,1,0)="^19.06^7^7^3010706^^"
^DIC(19,11884,1,1,0)="This option prints information from the AUDIT (#1.1) file for a "
^DIC(19,11884,1,2,0)="selected patient and date range."
^DIC(19,11884,1,3,0)="   "
^DIC(19,11884,1,4,0)="The report prints the patient name and DFN, date/time the field was"
^DIC(19,11884,1,5,0)="edited, the user who made the change, the field edited, the old value,"
^DIC(19,11884,1,6,0)="the new value and the option or protocol used to do the edit.  The "
^DIC(19,11884,1,7,0)="right margin for this report is 80."
^DIC(19,11884,25)="RGMTAUD"
^DIC(19,11884,"U")="SINGLE PATIENT AUDIT FILE PRIN"
^DIC(19,11894,0)="RG PROCESS CONTROL^Stop/Send/Suspend MPI/PD Messages^^R^10000000020^^^^^^^525"
^DIC(19,11894,1,0)="^^13^13^3010720^"
^DIC(19,11894,1,1,0)=" This option is used to edit the STOP MPI/PD MESSAGING field (#16) "
^DIC(19,11894,1,2,0)=" in the CIRN SITE PARAMETER file (#991.8), to stop/suspend/send messages."
^DIC(19,11894,1,3,0)="  "
^DIC(19,11894,1,4,0)=" STOP - should be used only to totally shutdown HL7 V2.3 and MPI/PD"
^DIC(19,11894,1,5,0)="        messages. It should only be used under the direction of "
^DIC(19,11894,1,6,0)="        System Design and Development."
^DIC(19,11894,1,7,0)="  "
^DIC(19,11894,1,8,0)=" SUSPEND - should be used in an emergency situation to suspend HL7 V2.3 "
^DIC(19,11894,1,9,0)="           and MPI/PD messages if the volume of messages is affecting "
^DIC(19,11894,1,10,0)="           system performance. System Design and Development should also"
^DIC(19,11894,1,11,0)="           be called in this situation."
^DIC(19,11894,1,12,0)="  "
^DIC(19,11894,1,13,0)=" SEND - normal operating mode.  "
^DIC(19,11894,25)="EN^RGRSPARM"
^DIC(19,11894,"U")="STOP/SEND/SUSPEND MPI/PD MESSA"
^DIC(19,11895,0)="GMTS GUI REPORTS LIST MENU^CPRS Reports Tab 'Health Summary Types List' Menu^^M^10000000020^^^^^^^"
^DIC(19,11895,1,0)="^^4^4^3020718^"
^DIC(19,11895,1,1,0)="Use the options in the CPRS Reports Tab Health Summary Types List"
^DIC(19,11895,1,2,0)="Menu to select the Health Summary Types to list on the Reports Tab,"
^DIC(19,11895,1,3,0)="arrange the order of these Health Summaries on the list, and to "
^DIC(19,11895,1,4,0)="view the user s preferences."
^DIC(19,11895,10,0)="^19.01IP^4^4"
^DIC(19,11895,10,1,0)="11896^1^1"
^DIC(19,11895,10,2,0)="11897^2^2"
^DIC(19,11895,10,3,0)="11898^3^3"
^DIC(19,11895,10,4,0)="11899^4^4"
^DIC(19,11895,10,"B",11896,1)=""
^DIC(19,11895,10,"B",11897,2)=""
^DIC(19,11895,10,"B",11898,3)=""
^DIC(19,11895,10,"B",11899,4)=""
^DIC(19,11895,10,"C",1,1)=""
^DIC(19,11895,10,"C",2,2)=""
^DIC(19,11895,10,"C",3,3)=""
^DIC(19,11895,10,"C",4,4)=""
^DIC(19,11895,99)="67131,68795"
^DIC(19,11895,99.1)="59171,34704"
^DIC(19,11895,"U")="CPRS REPORTS TAB 'HEALTH SUMMA"
^DIC(19,11896,0)="GMTS GUI HS LIST DEFAULTS^Display 'Health Summary Types List' Defaults^^R^10000000020^^^^^^^"
^DIC(19,11896,1,0)="^19.06^5^5^3020725^^^^"
^DIC(19,11896,1,1,0)="Use this option to display the list of Health Summary Types that "
^DIC(19,11896,1,2,0)="will be contained in the 'Health Summary Types' section on the "
^DIC(19,11896,1,3,0)="Reports Tab in CPRS.  The display includes the precedence of "
^DIC(19,11896,1,4,0)="parameters, the method for building the list, and finally the list"
^DIC(19,11896,1,5,0)="that will actually appear on the Reports Tab in CPRS."
^DIC(19,11896,25)="DISP^GMTSXA"
^DIC(19,11896,"U")="DISPLAY 'HEALTH SUMMARY TYPES "
^DIC(19,11897,0)="GMTS GUI HS LIST PRECEDENCE^Precedence of 'Health Summary Types List'^^R^10000000020^^^^^^^"
^DIC(19,11897,1,0)="^^17^17^3020718^"
^DIC(19,11897,1,1,0)="Use this option to select the defined Health Summary Types to include"
^DIC(19,11897,1,2,0)="on the list and arrange them in the order (precedence) that they "
^DIC(19,11897,1,3,0)="should appear on the list.  The three most common groups of Health "
^DIC(19,11897,1,4,0)="Summary Types are:"
^DIC(19,11897,1,5,0)=""
^DIC(19,11897,1,6,0)=" SYS  Health Summary Types may be defined for all users on the system."
^DIC(19,11897,1,7,0)=""
^DIC(19,11897,1,8,0)=" USR  Health Summary Types may be defined for a single user on the"
^DIC(19,11897,1,9,0)="      system."
^DIC(19,11897,1,10,0)=""
^DIC(19,11897,1,11,0)=" NAT  Nationally exported Health Summary Types (NAT) defined for "
^DIC(19,11897,1,12,0)="      system users or a single user are treated independently to"
^DIC(19,11897,1,13,0)="      keep them together in the list box."
^DIC(19,11897,1,14,0)=""
^DIC(19,11897,1,15,0)="In this option, you must first select those Health Summary Type groups"
^DIC(19,11897,1,16,0)="(SYS, USR, NAT, etc.) to include on the Reports Tab, then specify the"
^DIC(19,11897,1,17,0)="order in which they will appear on the Reports Tab."
^DIC(19,11897,25)="PREC^GMTSXA"
^DIC(19,11897,"U")="PRECEDENCE OF 'HEALTH SUMMARY "
^DIC(19,11898,0)="GMTS GUI HS LIST METHOD^Method of compiling 'Health Summary Types List'^^R^10000000020^^^^^^^"
^DIC(19,11898,1,0)="^19.06^13^13^3020718^^^"
^DIC(19,11898,1,1,0)="Use this option to edit the method used to build the list of Health"
^DIC(19,11898,1,2,0)="Summary Types displayed on the Reports Tab in CPRS.  There are 2 "
^DIC(19,11898,1,3,0)="methods:"
^DIC(19,11898,1,4,0)=""
^DIC(19,11898,1,5,0)="   Overwrite   System-defined Health Summary Types are added "
^DIC(19,11898,1,6,0)="               to the list.  If there are User-defined Health"
^DIC(19,11898,1,7,0)="               Summary Types, then they will replace the System"
^DIC(19,11898,1,8,0)="               defined Health Summary Types already on the list."
^DIC(19,11898,1,9,0)=""
^DIC(19,11898,1,10,0)="   Append      System-defined Health Summary Types are added to"
^DIC(19,11898,1,11,0)="               the list.  If there are User-defined Health Summary"
^DIC(19,11898,1,12,0)="               Types, then they will added to the list along with "
^DIC(19,11898,1,13,0)="               the System-defined types."
^DIC(19,11898,25)="METH^GMTSXA"
^DIC(19,11898,"U")="METHOD OF COMPILING 'HEALTH SU"
^DIC(19,11899,0)="GMTS GUI HS LIST PARAMETERS^Edit 'Health Summary Types List' Parameters^^R^10000000020^^^^^^^"
^DIC(19,11899,1,0)="^^4^4^3020718^"
^DIC(19,11899,1,1,0)="Use this option to add, edit or delete a Health Summary Type from"
^DIC(19,11899,1,2,0)="the list of Health Summary Types defined by the user.  If you are "
^DIC(19,11899,1,3,0)="a holder of the GMTSMGR Key, you can also use this option to edit"
^DIC(19,11899,1,4,0)="the Health Summary Types defined for the System."
^DIC(19,11899,25)="EDIT^GMTSXA"
^DIC(19,11899,"U")="EDIT 'HEALTH SUMMARY TYPES LIS"
^DIC(19,11900,0)="XUMF INSTITUTION^Institution File Query / Update^Use XUMF LOAD INSTITUTION^R^10000000020^XUMF INSTITUTION^^^^^^163"
^DIC(19,11900,1,0)="^^20^20^3000705^"
^DIC(19,11900,1,1,0)="This option provides clean up utilities to check for duplicate station"
^DIC(19,11900,1,2,0)="numbers and to get a copy of Institution Master File from FORUM for comparison"
^DIC(19,11900,1,3,0)="and update purposes."
^DIC(19,11900,1,4,0)=""
^DIC(19,11900,1,5,0)="The clean up utilities will provide several lists to compare the local"
^DIC(19,11900,1,6,0)="INSTITUTION (#4) file with the Institution Master File (IMF) -- the ""gold"""
^DIC(19,11900,1,7,0)="file of Institutions complete with all approved station numbers including"
^DIC(19,11900,1,8,0)="inactive as well as active station numbers.  Utilities will be included to"
^DIC(19,11900,1,9,0)="resolve duplicate station numbers and to automatically populate the local"
^DIC(19,11900,1,10,0)="INSTITUTION (#4) file with national IMF data."
^DIC(19,11900,1,11,0)=""
^DIC(19,11900,1,12,0)="The INSTITUTION (#4) file clean up utilities utilize the query functionality"
^DIC(19,11900,1,13,0)="provided by the Master File Server mechanism.  An HL7 Master File Query (MFQ)"
^DIC(19,11900,1,14,0)="message is sent to FORUM to get the IFM.  The MFQ message is handled by the"
^DIC(19,11900,1,15,0)="VistA HL7 package which invokes the Master File Sever (MFS) message handler."
^DIC(19,11900,1,16,0)="The MFS handler interprets the query and builds/sends the appropriate response"
^DIC(19,11900,1,17,0)="to the local site in an HL7 Master File Response (MFR) message.  The VistA HL7"
^DIC(19,11900,1,18,0)="package invokes the MFS handler on the local site which stores the IMF data"
^DIC(19,11900,1,19,0)="in a temporary global.  The clean up utilities use this information for the"
^DIC(19,11900,1,20,0)="displays and to automatically update the local INSTITUTION (#4) file."
^DIC(19,11900,25)="EN^XUMF4"
^DIC(19,11900,"U")="INSTITUTION FILE QUERY / UPDAT"
^DIC(19,11901,0)="IBJD DM MANUAL TRANSMIT^Manually Transmit DM Extract^^R^10000000020^^^^^^^192"
^DIC(19,11901,1,0)="^^3^3^3000424^"
^DIC(19,11901,1,1,0)="This option allows a user to retransmit a Diagnostic Measures"
^DIC(19,11901,1,2,0)="Extract file to FORUM for a particular month if that month's"
^DIC(19,11901,1,3,0)="DM report data did not successfully transmit the first time."
^DIC(19,11901,25)="MAN2^IBJDE1"
^DIC(19,11901,"U")="MANUALLY TRANSMIT DM EXTRACT"
^DIC(19,11902,0)="IBJD FOLLOW-UP FIRST PARTY^First Party Follow-Up Report^^R^10000000020^^^^^^^192"
^DIC(19,11902,1,0)="^19.06^2^2^3000925^^^^"
^DIC(19,11902,1,1,0)="This option provides information for sites to use to conduct follow-up"
^DIC(19,11902,1,2,0)="activities for First Party receivables."
^DIC(19,11902,25)="IBJDF4"
^DIC(19,11902,"U")="FIRST PARTY FOLLOW-UP REPORT"
^DIC(19,11903,0)="IBJD FOLLOW-UP CHAMPVA/TRICARE^CHAMPVA/TRICARE Follow-Up Report^^R^10000000020^^^^^^^192"
^DIC(19,11903,1,0)="^19.06^2^2^3000525^^"
^DIC(19,11903,1,1,0)="This option provides information for sites to use to conduct follow-up"
^DIC(19,11903,1,2,0)="activities for CHAMPVA and TRICARE receivables."
^DIC(19,11903,25)="IBJDF5"
^DIC(19,11903,"U")="CHAMPVA/TRICARE FOLLOW-UP REPO"
^DIC(19,11904,0)="IBJD FOLLOW-UP MISC BILLS^Miscellaneous Bills Follow-Up Report^^R^10000000020^^^^^^^192"
^DIC(19,11904,1,0)="^19.06^2^2^3000613^^^"
^DIC(19,11904,1,1,0)="This option provides information for sites to use to conduct follow-up"
^DIC(19,11904,1,2,0)="activities for miscellaneous receivables."
^DIC(19,11904,25)="IBJDF6"
^DIC(19,11904,"U")="MISCELLANEOUS BILLS FOLLOW-UP "
^DIC(19,11905,0)="IBJD REASONS NOT BILLABLE^Reasons Not Billable Report^^R^10000000020^^^^^^^192"
^DIC(19,11905,1,0)="^^2^2^3010403^"
^DIC(19,11905,1,1,0)="This option prints a list of Claims Tracking entries that cannot be billed"
^DIC(19,11905,1,2,0)="to an insurance company for various reasons."
^DIC(19,11905,25)="IBJDB2"
^DIC(19,11905,"U")="REASONS NOT BILLABLE REPORT"
^DIC(19,11906,0)="IBJD FOLLOW-UP REPAYMENT PLAN^Repayment Plan Follow-up Report^This option is obsolete.^R^1^^^^^^^192"
^DIC(19,11906,1,0)="^^5^5^3210216^"
^DIC(19,11906,1,1,0)="*** This option is obsolete. Please use ""Repayment Plan Status Report"""
^DIC(19,11906,1,2,0)="(PRCAC PLAN STATUS REPORT) option instead. ***"
^DIC(19,11906,1,3,0)=" "
^DIC(19,11906,1,4,0)=" "
^DIC(19,11906,1,5,0)="This option provides information for sites to use to conduct follow-up on the Repayment Plans."
^DIC(19,11906,25)="IBJDF7"
^DIC(19,11906,"U")="REPAYMENT PLAN FOLLOW-UP REPOR"
^DIC(19,11907,0)="IBJD FOLLOW-UP WORKLOAD^Workload Assignment Enter/Edit^^R^10000000020^IBJD WORKLOAD ASSIGNMENT^^^^^^192"
^DIC(19,11907,1,0)="^19.06^1^1^3010404^^"
^DIC(19,11907,1,1,0)="This option allows the entering/editing of Workload Assignments by clerk to be stored in file #351.73."
^DIC(19,11907,25)="IBJDF8I"
^DIC(19,11907,"U")="WORKLOAD ASSIGNMENT ENTER/EDIT"
^DIC(19,11908,0)="IBJD FOLLOW-UP AR PROD REPORT^AR Productivity Report^^R^10000000020^IBJD WORKLOAD ASSIGNMENT^^^^^^192"
^DIC(19,11908,1,0)="^19.06^1^1^3010223^^^^"
^DIC(19,11908,1,1,0)="This report shows clerk activity based on transaction types and timeframes."
^DIC(19,11908,25)="IBJDF8"
^DIC(19,11908,"U")="AR PRODUCTIVITY REPORT"
^DIC(19,11909,0)="IBJD FOLLOW-UP ASSIGN PRINT^Workload Assignment Print^^R^10000000020^^^^^^^192"
^DIC(19,11909,1,0)="^19.06^1^1^3010404^^^^"
^DIC(19,11909,1,1,0)="This option allows the printing of selected or all Workload Assignments stored in file #351.73."
^DIC(19,11909,25)="IBJDF8R"
^DIC(19,11909,"U")="WORKLOAD ASSIGNMENT PRINT"
^DIC(19,11910,0)="PRCHOUT DEL^Delinquent Delivery Listing^^R^10000000020^^^^^^^^^^"
^DIC(19,11910,1,0)="^19.06^1^1^3010221^^^^"
^DIC(19,11910,1,1,0)="This option prints a listing of outstanding purchase orders."
^DIC(19,11910,15)=""
^DIC(19,11910,20)=""
^DIC(19,11910,25)="PRCHDPO"
^DIC(19,11910,"U")="DELINQUENT DELIVERY LISTING"
^DIC(19,11911,0)="RMPR NPPDL PRL L^Print 2529-3 Single Line^^R^10000000020^^^^^^^249"
^DIC(19,11911,1,0)="^19.06^2^2^3010201^^"
^DIC(19,11911,1,1,0)="This option will print a single line, either New or Repair in Detail"
^DIC(19,11911,1,2,0)="format for the form type 2529-3 only.  This is the Lab."
^DIC(19,11911,25)="ENL^RMPRN7"
^DIC(19,11911,"U")="PRINT 2529-3 SINGLE LINE"
^DIC(19,11912,0)="RMPR NPPDL PRT^Print 2529-3 Worksheets^^R^10000000020^^^^^^^249"
^DIC(19,11912,1,0)="^19.06^15^15^3010328^^^^"
^DIC(19,11912,1,1,0)="The Print 2529-3 Worksheets [RMPR NPPDL PRT] option provides both Summary and"
^DIC(19,11912,1,2,0)="Detail worksheets.  They are divided into the following two basic parts with a "
^DIC(19,11912,1,3,0)="station summary of each:"
^DIC(19,11912,1,4,0)=""
^DIC(19,11912,1,5,0)="     * New Activities"
^DIC(19,11912,1,6,0)="     * Repair Activities"
^DIC(19,11912,1,7,0)=""
^DIC(19,11912,1,8,0)="The above are further broken down by each mapped NPPD Group with a summary "
^DIC(19,11912,1,9,0)="of each. Within each NPPD Group, there is an NPPD Line with a summary. The"
^DIC(19,11912,1,10,0)="Detail dispaly adds an itemized listing for each NPPD Line within the "
^DIC(19,11912,1,11,0)="NPPD Group, so every transaction for the date range selected is displayed.  "
^DIC(19,11912,1,12,0)="It is recommended to send this report to a device that will print a "
^DIC(19,11912,1,13,0)="132 right margin. This will not only ensure that you get the entire report,"
^DIC(19,11912,1,14,0)="it will also expand the length of some of the data (e.g., Item and HCPCS "
^DIC(19,11912,1,15,0)="DESCRIPTION on the Detail Worksheet) to make it more legible."
^DIC(19,11912,25)="RMPRN7"
^DIC(19,11912,"U")="PRINT 2529-3 WORKSHEETS"
^DIC(19,11913,0)="EAS EZ REMOVE SIGNATURE^Remove Signature Verification^^R^10000000020^^^^^^^538"
^DIC(19,11913,1,0)="^19.06^3^3^3010406^^"
^DIC(19,11913,1,1,0)="Allows the user to remove Signature Verification from the 1010EZ"
^DIC(19,11913,1,2,0)="Application.  The status of the Application reverts from 'Signed'"
^DIC(19,11913,1,3,0)="to either 'Printed, Pending Signature' or 'In Review'.  "
^DIC(19,11913,25)="REMSIG^EASEZU5"
^DIC(19,11913,"U")="REMOVE SIGNATURE VERIFICATION"
^DIC(19,11914,0)="IBARXM COPAY QUERY^Query Medication Copay Billing Events^^R^10000000020^^^^^^^192"
^DIC(19,11914,1,0)="^^5^5^3010121^"
^DIC(19,11914,1,1,0)="This option will produce a report that will show what medication"
^DIC(19,11914,1,2,0)="copayments a patient has been billed for and not billed for.  This option"
^DIC(19,11914,1,3,0)="will allow you to query remote facilities to get all the information and"
^DIC(19,11914,1,4,0)="verify its accuracy.  If there is a discrepancy, the amounts will be"
^DIC(19,11914,1,5,0)="updated as well."
^DIC(19,11914,25)="EN^IBARXMQ"
^DIC(19,11914,"U")="QUERY MEDICATION COPAY BILLING"
^DIC(19,11915,0)="IBARXM CAP TRANS PUSH^Push Rx Copay Cap Transactions^^R^10000000020^^^^^^^192"
^DIC(19,11915,1,0)="^^8^8^3010427^"
^DIC(19,11915,1,1,0)="This option will allow the user to try to ""push"" outpatient medication"
^DIC(19,11915,1,2,0)="copayment cap transactions to the other treating facilities for the"
^DIC(19,11915,1,3,0)="patient.  This is used to try to resolve problems with transmissions.  The"
^DIC(19,11915,1,4,0)="problems are usually identified by mail messages sent to the IB RX COPAY"
^DIC(19,11915,1,5,0)="CAP ERROR mail group.  To resolve these error messages first IRM should"
^DIC(19,11915,1,6,0)="verify that the HL7 logical links are working correctly. Then with this"
^DIC(19,11915,1,7,0)="option the user can select individual transactions to attempt to send or"
^DIC(19,11915,1,8,0)="All un-transmitted transactions."
^DIC(19,11915,25)="PUSH^IBARXMP"
^DIC(19,11915,"U")="PUSH RX COPAY CAP TRANSACTIONS"
