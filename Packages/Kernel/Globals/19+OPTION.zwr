^DIC(19,12102,0)="RMPR PCE BACKGROUND TASK^PROSTHETICS PCE BACKGROUND TASK^** NO LONGER USED**^R^1^^^^^^^249"
^DIC(19,12102,1,0)="^19.06^5^5^3080311^^"
^DIC(19,12102,1,1,0)="This is a nightly job that process the patient encounter to PCE module."
^DIC(19,12102,1,2,0)="This option should be tasked to run at night when prosthetics' users are"
^DIC(19,12102,1,3,0)="off or prosthetics' activities are minimal.  A mail message will be"
^DIC(19,12102,1,4,0)="forwarded to the RMPR INVENTORY mail group when the task job processed"
^DIC(19,12102,1,5,0)="to completion."
^DIC(19,12102,25)="OPTION^RMPRPCEB"
^DIC(19,12102,"U")="PROSTHETICS PCE BACKGROUND TAS"
^DIC(19,12103,0)="RMPR RECORDS WITH SUSPENSE^Print Patient Records Linked To Suspense^^R^10000000020^^^^^^^"
^DIC(19,12103,1,0)="^19.06^2^2^3010907^^"
^DIC(19,12103,1,1,0)="This is an option that prints all patient records that are linked to"
^DIC(19,12103,1,2,0)="suspense in a given date range."
^DIC(19,12103,25)="RMPRSP6"
^DIC(19,12103,"U")="PRINT PATIENT RECORDS LINKED T"
^DIC(19,12104,0)="RMPR RECORDS WITHOUT SUSPENSE^Print Patient Records Not Linked To Suspense^^R^10000000020^^^^^^^"
^DIC(19,12104,1,0)="^^2^2^3010905^"
^DIC(19,12104,1,1,0)="This option prints all patient records that has no linked to suspense in"
^DIC(19,12104,1,2,0)="a given date range."
^DIC(19,12104,25)="RMPRSP7"
^DIC(19,12104,"U")="PRINT PATIENT RECORDS NOT LINK"
^DIC(19,12105,0)="RMPR PRINT PCE DATA^Print Patient PCE Data ^^R^10000000020^^^^^^^"
^DIC(19,12105,1,0)="^^1^1^3010905^"
^DIC(19,12105,1,1,0)="This option prints all patients with PCE linked in a given date range."
^DIC(19,12105,25)="RMPRPCER"
^DIC(19,12105,"U")="PRINT PATIENT PCE DATA "
^DIC(19,12106,0)="RMPR LINK 2319 TO SUSPENSE^Link Patient Record to Suspense^^R^10000000020^^^^^^^"
^DIC(19,12106,1,0)="^^4^4^3011002^"
^DIC(19,12106,1,1,0)="This option is used for linking patient's record to SUSPENSE.  In"
^DIC(19,12106,1,2,0)="order to link a patient's record to suspense, user must access and select"
^DIC(19,12106,1,3,0)="a record using either options; Post Initial Action, Post Complete or Post"
^DIC(19,12106,1,4,0)="Other."
^DIC(19,12106,25)="LINK^RMPRPCE1"
^DIC(19,12106,"U")="LINK PATIENT RECORD TO SUSPENS"
^DIC(19,12107,0)="GMRC IFC RPT CONSULTS^IFC Requests^^R^11740^^^^^^^294"
^DIC(19,12107,1,0)="^^29^29^3020313^"
^DIC(19,12107,1,1,0)="This option provides detailed information regarding inter-facility "
^DIC(19,12107,1,2,0)="consults."
^DIC(19,12107,1,3,0)=" "
^DIC(19,12107,1,4,0)="If not specified, all status' are utilized."
^DIC(19,12107,1,5,0)=" "
^DIC(19,12107,1,6,0)="""Routing Facility"" data: If selecting requesting site information, this "
^DIC(19,12107,1,7,0)="refers to the facility the consult is sent to; if selecting consulting "
^DIC(19,12107,1,8,0)="site information, this refers to the facility the consult is sent from."
^DIC(19,12107,1,9,0)=" "
^DIC(19,12107,1,10,0)="""Days Diff"" data: This refers to the (whole number) of days difference "
^DIC(19,12107,1,11,0)="between the COMPLETE activity date/time and one of the following activity "
^DIC(19,12107,1,12,0)="date/time (if one doesn't exist, retrieve the next): RECEIVED, ENTERED IN "
^DIC(19,12107,1,13,0)="CPRS, SERVICE ENTERED, FILE ENTRY DATE. All date/time data must be in the"
^DIC(19,12107,1,14,0)="range selected. Field REMOTE ACTIVITY TIME ZONE is NOT figured into the"
^DIC(19,12107,1,15,0)="calculations."
^DIC(19,12107,1,16,0)=" "
^DIC(19,12107,1,17,0)="""Rec Date"" data: For IFC consulting site report requests only, the option"
^DIC(19,12107,1,18,0)="checks for DATE/TIME OF ACTION ENTRY for activity of REMOTE REQUEST"
^DIC(19,12107,1,19,0)="RECEIVED, and if that doesn't exist it checks for DATE/TIME OF ACTION"
^DIC(19,12107,1,20,0)="ENTRY for the activity of RECEIVED. Only date is listed in the report."
^DIC(19,12107,1,21,0)=" "
^DIC(19,12107,1,22,0)="""Mean Days Completed To Service <service> @ <facility>"" data: For only "
^DIC(19,12107,1,23,0)="those entries in which Days Diff exists, this calculation for each service"
^DIC(19,12107,1,24,0)="at each routing facility is: Days Diff total divided by Number of Days"
^DIC(19,12107,1,25,0)="Diff values."
^DIC(19,12107,1,26,0)=" "
^DIC(19,12107,1,27,0)="""Mean Days Completed To Service <service>"" data: For only those entries in"
^DIC(19,12107,1,28,0)="which Days Diff exists, this calculation for each service is: Days Diff"
^DIC(19,12107,1,29,0)="total divided by Number of Days Diff values."
^DIC(19,12107,25)="EN^GMRCIR"
^DIC(19,12107,"U")="IFC REQUESTS"
^DIC(19,12108,0)="GMRC IFC INC TRANS^List incomplete IFC transactions^^R^11740^^^^^^^294"
^DIC(19,12108,1,0)="^19.06^2^2^3011213^^"
^DIC(19,12108,1,1,0)="This option is used to list and/or retransmit any and all Inter-facility"
^DIC(19,12108,1,2,0)="Consult activities that did not complete successfully. "
^DIC(19,12108,25)="EN^GMRCINC"
^DIC(19,12108,"U")="LIST INCOMPLETE IFC TRANSACTIO"
^DIC(19,12109,0)="GMRC IFC TEST SETUP^Test IFC implementation^^R^11740^^^^^^^294"
^DIC(19,12109,1,0)="^^4^4^3011130^"
^DIC(19,12109,1,1,0)="This option can be used to test the IFC setup for a given procedure or "
^DIC(19,12109,1,2,0)="consult service.  After selection of the service or procedure, the remote "
^DIC(19,12109,1,3,0)="site will be contacted and the procedure or service name will be "
^DIC(19,12109,1,4,0)="confirmed as correct.  Any errors encountered will be listed."
^DIC(19,12109,25)="EN^GMRCITST"
^DIC(19,12109,"U")="TEST IFC IMPLEMENTATION"
^DIC(19,12110,0)="GMRC IFC TRANS^IFC Transaction Report^^R^11740^^^^^^^294"
^DIC(19,12110,1,0)="^^5^5^3020227^"
^DIC(19,12110,1,1,0)="This option is used to list any or all Inter-facility Consult entries"
^DIC(19,12110,1,2,0)="from the IFC MESSAGE LOG file (#123.6)."
^DIC(19,12110,1,3,0)="NOTE: The parameter GMRC RETAIN IFC ACTIVITY DAYS controls the number of "
^DIC(19,12110,1,4,0)="days that completed Inter-facility Consult transactions are maintained in"
^DIC(19,12110,1,5,0)="the IFC MESSAGE LOG (#123.6) file."
^DIC(19,12110,25)="EN^GMRCITR"
^DIC(19,12110,"U")="IFC TRANSACTION REPORT"
^DIC(19,12111,0)="GMRC IFC REMOTE NUMBER^Locate IFC by Remote Cslt #^^R^11740^^^^^^^294"
^DIC(19,12111,1,0)="^^3^3^3020108^"
^DIC(19,12111,1,1,0)="This option allows the look-up of a local consult/request when only the "
^DIC(19,12111,1,2,0)="remote site and remote consult number are known.  Upon look-up, the option"
^DIC(19,12111,1,3,0)="includes both a brief and detailed display of the request."
^DIC(19,12111,25)="EN^GMRCILKP"
^DIC(19,12111,"U")="LOCATE IFC BY REMOTE CSLT #"
^DIC(19,12112,0)="GMRC IFC MGMT^IFC Management Menu^^M^11740^^^^^^^294"
^DIC(19,12112,1,0)="^19.06^2^2^3020402^^^^"
^DIC(19,12112,1,1,0)="This menu contains a collection of options used to implement and manage "
^DIC(19,12112,1,2,0)="the Inter-facility Consults interface."
^DIC(19,12112,10,0)="^19.01IP^13^13"
