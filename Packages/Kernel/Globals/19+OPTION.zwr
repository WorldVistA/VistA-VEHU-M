^DIC(19,14956,0)="RA ORDER DISCONTINUED^Log of Discontinued Requests^^R^1^^^^^^^31"
^DIC(19,14956,1,0)="^19.06^12^12^3210407^^^"
^DIC(19,14956,1,1,0)="This option allows the user to generate a list of discontinued requests by"
^DIC(19,14956,1,2,0)="date desired.  The list includes the following information: patient name,"
^DIC(19,14956,1,3,0)="SSN (last four), procedure, date desired, canceled date, who canceled,"
^DIC(19,14956,1,4,0)="cancel reason."
^DIC(19,14956,1,5,0)=" "
^DIC(19,14956,1,6,0)="Before printing a report, the option will prompt for imaging locations and"
^DIC(19,14956,1,7,0)="allows selection of only the location(s) to which the user has access"
^DIC(19,14956,1,8,0)="through Personnel Classification or via the RA ALLOC security key. The"
^DIC(19,14956,1,9,0)="location(s) selected must also be within the current sign-on imaging"
^DIC(19,14956,1,10,0)="type.  Requests for which an imaging location has not been entered will"
^DIC(19,14956,1,11,0)="print on every report under location ""UNKNOWN"" regardless of which"
^DIC(19,14956,1,12,0)="locations are selected."
^DIC(19,14956,25)="EN^RAORDCP"
^DIC(19,14956,"U")="LOG OF DISCONTINUED REQUESTS"
