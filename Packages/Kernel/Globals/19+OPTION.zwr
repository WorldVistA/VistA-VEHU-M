^DIC(19,14308,0)="PSS TRAILING SPACES REPORT^Drug Names with Trailing Spaces Report^^R^1^^^^^^^517"
^DIC(19,14308,1,0)="^^10^10^3121005^"
^DIC(19,14308,1,1,0)="This option lists all active, multi-ingredient DRUG File (#50) entries"
^DIC(19,14308,1,2,0)="with Local Possible Dosages defined, and whose drug name has trailing"
^DIC(19,14308,1,3,0)="spaces. Drugs not matched to the National Drug File with trailing spaces"
^DIC(19,14308,1,4,0)="in the name will also be listed. If the Drug Name is appended to the Local"
^DIC(19,14308,1,5,0)="Possible Dosage and optional conjunction in  the Computerized Patient"
^DIC(19,14308,1,6,0)="Record System (CPRS) order dialogues, a selection of such a dosage could"
^DIC(19,14308,1,7,0)="cause the conjunction+drug name to become part of the actual Dosage,"
^DIC(19,14308,1,8,0)="instead of just a display enhancement. This can case the Dosage check to"
^DIC(19,14308,1,9,0)="fail, and that extra text could come to pharmacy as part of the Dosage in"
^DIC(19,14308,1,10,0)="the order. These trailing spaces should be cleaned up if possible."
^DIC(19,14308,25)="TRAIL^PSSSCHRP"
^DIC(19,14308,"U")="DRUG NAMES WITH TRAILING SPACE"
^DIC(19,14309,0)="XUPCSRVR^UPDATE PERSON CLASS SERVER^^S^1^^^^^^^163"
