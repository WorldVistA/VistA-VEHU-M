^DIC(19,5673,0)="DGJ IRT PARAMETERS^Set up IRT Parameters^^R^10000000033^DGJ SUPER^^^^^^"
^DIC(19,5673,1,0)="^^3^3^2930409^^^^"
^DIC(19,5673,1,1,0)="This option allows you to set up parameters for the IRT package."
^DIC(19,5673,1,2,0)="It also allows you to turn the package on and off. These parameters are"
^DIC(19,5673,1,3,0)="site specific."
^DIC(19,5673,25)="DGJPAR"
^DIC(19,5673,"U")="SET UP IRT PARAMETERS"
^DIC(19,5676,0)="XMS-SEQ-TRANSMIT^Sequential Media Queue Transmission^^R^11748^^^^^^^54^^1^1"
^DIC(19,5676,1,0)="^19.06^20^20^3020312^^^^"
^DIC(19,5676,1,1,0)="This option allows the recording of a queue of messages onto sequential"
^DIC(19,5676,1,2,0)="media.  The messages so recorded may be 'read' into another MailMan system."
^DIC(19,5676,1,3,0)="The option 'Sequential Media Message Reception' is the converse process."
^DIC(19,5676,1,4,0)=" "
^DIC(19,5676,1,5,0)="This option has been developed specifically for emergency transmission of"
^DIC(19,5676,1,6,0)="messages when the wide area network is not available.  It can also be used"
^DIC(19,5676,1,7,0)="for archiving."
^DIC(19,5676,1,8,0)=" "
^DIC(19,5676,1,9,0)="Say a bulldozer knocked out your T1 line to the WAN in front of your"
^DIC(19,5676,1,10,0)="computer room.  It will be three weeks until the system is reconnected to"
^DIC(19,5676,1,11,0)="the network.  You know that a sister installation 10 miles down the road is"
^DIC(19,5676,1,12,0)="still on line.  You must get your payroll information to Austin.  The"
^DIC(19,5676,1,13,0)="messages are ready to be sent (in the queue to FOC-AUSTIN.VA.GOV).  Quick!"
^DIC(19,5676,1,14,0)="Mount a tape.  Use this procedure to 'transmit' the queue onto the tape."
^DIC(19,5676,1,15,0)="Have the tape delivered to your sister site (keeping it away from all"
^DIC(19,5676,1,16,0)="magnetic fields -- those messages are no longer in the queue).  At your"
^DIC(19,5676,1,17,0)="sister site the tape is delivered.  They mount it and read in the messages."
^DIC(19,5676,1,18,0)="The messages are queued up for FOC-AUSTIN.VA.GOV and delivered as though"
^DIC(19,5676,1,19,0)="they were 'relayed' through this site.  You could also have sent the tape"
^DIC(19,5676,1,20,0)="directly to FOC-AUSTIN.VA.GOV where they could have been received."
^DIC(19,5676,15)="D CHECKOUT^XM"
^DIC(19,5676,20)="D EN^XM"
^DIC(19,5676,25)="TAPEOUT^XMCB"
^DIC(19,5676,"U")="SEQUENTIAL MEDIA QUEUE TRANSMI"
^DIC(19,5677,0)="XMR-SEQ-RECEIVE^Sequential Media Message Reception^^R^11748^^^^^^^54^^1^1"
^DIC(19,5677,1,0)="^19.06^2^2^3020312^^^^"
^DIC(19,5677,1,1,0)="This is the converse procedure to XMS-SEQ-TRANSMIT.  Please refer to the"
^DIC(19,5677,1,2,0)="description of XMS-SEQ-TRANSMIT for more information."
^DIC(19,5677,15)="D CHECKOUT^XM"
^DIC(19,5677,20)="D EN^XM"
^DIC(19,5677,25)="TAPEIN^XMCB"
^DIC(19,5677,"U")="SEQUENTIAL MEDIA MESSAGE RECEP"
