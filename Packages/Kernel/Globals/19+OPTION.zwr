^DIC(19,9819,0)="GMRA PRINT SIGN/SYMPTOMS LIST^Sign/Symptoms List^^P^11595^^^^^^^"
^DIC(19,9819,1,0)="^^7^7^2960201^"
^DIC(19,9819,1,1,0)="This option will print a list of entries in the Sign/Symptoms file"
^DIC(19,9819,1,2,0)="(#120.83). The user may print all entries by accepting the default value"
^DIC(19,9819,1,3,0)="(FIRST) at the'sort by' prompt or may select a subset of entries. The"
^DIC(19,9819,1,4,0)="listing includes the name of the sign/symptom, whether it is a nationally"
^DIC(19,9819,1,5,0)="distributed entry or a locally created entry, and any of its synonyms."
^DIC(19,9819,1,6,0)="This option is meant to be a useful tool for the ADPAC to maintain the"
^DIC(19,9819,1,7,0)="Sign/Symptoms file."
