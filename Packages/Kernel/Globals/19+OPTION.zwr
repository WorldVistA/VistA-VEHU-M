^DIC(19,16650,"U")="REMINDER DEFINITION MANAGEMENT"
^DIC(19,16651,0)="EHM-01472^Activate/Inactivate Reminders^^E^1^^^^^^n^534^^^^"
^DIC(19,16651,1,0)="^^2^2^3240328^^"
^DIC(19,16651,1,1,0)="This option is used to make reminders active or inactive."
^DIC(19,16651,1,2,0)="Cloned from ""PXRM (IN)/ACTIVATE REMINDERS"" option."
^DIC(19,16651,3)=""
^DIC(19,16651,10.1)="Activate/Inactivate Reminders"
^DIC(19,16651,30)="PXD(811.9,"
^DIC(19,16651,31)="QAMEZ"
^DIC(19,16651,50)="PXD(811.9,"
