^DIC(19,11293,1,0)="^^3^3^2970904^^^"
^DIC(19,11293,1,1,0)="This option displays and edits a NOIS call using the Edit"
^DIC(19,11293,1,2,0)="Screen.  Editing data on calls is restricted to NOIS Specialists but"
^DIC(19,11293,1,3,0)="anyone can review and make notes on calls."
