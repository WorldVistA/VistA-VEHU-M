^DIC(19,12536,"U")="EDI LOCKBOX (EPAYMENTS)"
^DIC(19,12537,0)="RCDPE EDI LOCKBOX ACT REPORT^EFT Daily Activity Report^^R^1^^^^^^^261"
^DIC(19,12537,1,0)="^^6^6^3140428^"
^DIC(19,12537,1,1,0)="This option produces the EDI Lockbox EFT Daily Activity Report.  This"
^DIC(19,12537,1,2,0)="report can be run in detail or summary format.  Detail format provides a"
^DIC(19,12537,1,3,0)="detailed list of all EFT deposits received within the selected date range"
^DIC(19,12537,1,4,0)="and the corresponding EFT payments from the payers comprising the deposit."
^DIC(19,12537,1,5,0)="Totals are provided by date and date range selected.  Summary format "
^DIC(19,12537,1,6,0)="prints only the totals data."
^DIC(19,12537,25)="RPT^RCDPEDAR"
^DIC(19,12537,"U")="EFT DAILY ACTIVITY REPORT"
^DIC(19,12539,0)="RCDPE EDI LOCKBOX REPORTS MENU^EDI Lockbox (ePayments) Reports Menu^^M^1^^^^^^^261"
^DIC(19,12539,1,0)="2^19.06^2^2^3181105^^^^"
^DIC(19,12539,1,1,0)="This menu allows access to all the reports that can be produced for EDI"
^DIC(19,12539,1,2,0)="Lockbox."
^DIC(19,12539,10,0)="^19.01IP^31^31"
^DIC(19,12539,10,6,0)="12546^VP^25"
^DIC(19,12539,10,28,0)="14748^AUDR^20"
^DIC(19,12539,10,29,0)="14751^WORK^5"
^DIC(19,12539,10,30,0)="14749^RESR^15"
^DIC(19,12539,10,31,0)="14750^ADJR^10"
^DIC(19,12539,10,"B",12546,6)=""
^DIC(19,12539,10,"B",14748,28)=""
^DIC(19,12539,10,"B",14749,30)=""
^DIC(19,12539,10,"B",14750,31)=""
^DIC(19,12539,10,"B",14751,29)=""
^DIC(19,12539,10,"C","ADJR",31)=""
^DIC(19,12539,10,"C","AUDR",28)=""
^DIC(19,12539,10,"C","RESR",30)=""
^DIC(19,12539,10,"C","VP",6)=""
^DIC(19,12539,10,"C","WORK",29)=""
^DIC(19,12539,99)="67475,57219"
^DIC(19,12539,99.1)="59232,49629"
^DIC(19,12539,"U")="EDI LOCKBOX (EPAYMENTS) REPORT"
^DIC(19,12540,0)="RCDPE MANUAL MATCH EFT-ERA^EFT Manual Match^^R^1^^^^^^^261"
^DIC(19,12540,1,0)="^19.06^5^5^3030512^^^^"
^DIC(19,12540,1,1,0)="This option will allow the user to choose an EFT detail record and an ERA"
^DIC(19,12540,1,2,0)="record and will mark the 2 records as matched.  This should be used only"
^DIC(19,12540,1,3,0)="if the automatic matching function is not able to make the match. The"
^DIC(19,12540,1,4,0)="EFT and ERA selected must both be unmatched and the ERA must not be"
^DIC(19,12540,1,5,0)="associated with a receipt."
^DIC(19,12540,25)="MATCH1^RCDPEM2"
^DIC(19,12540,"U")="EFT MANUAL MATCH"
^DIC(19,12541,0)="RCDPE MARK 0-BAL EFT MATCHED^Mark 0-Balance EFT Matched^^R^1^^^^^^^261"
^DIC(19,12541,1,0)="^19.06^3^3^3030603^^^^"
^DIC(19,12541,1,1,0)="This option allows the user to select an EFT detail record that has a"
^DIC(19,12541,1,2,0)="0-balance payment and mark it as matched to a paper EOB.  This will"
^DIC(19,12541,1,3,0)="remove it from the EFT UNMATCHED AGING REPORT."
^DIC(19,12541,25)="MATCH2^RCDPEM2"
^DIC(19,12541,"U")="MARK 0-BALANCE EFT MATCHED"
^DIC(19,12542,0)="RCDPE MOVE ERA TO SUSPENSE^Move ERA Total To Suspense^THIS OPTION IS NO LONGER IN USE^R^11720^^^^^^^261"
^DIC(19,12542,1,0)="^19.06^10^10^3030520^^^^"
^DIC(19,12542,1,1,0)="This option will allow the user to choose an ERA record that is matched"
^DIC(19,12542,1,2,0)="to an EFT deposit and will create a receipt to post the total amount"
^DIC(19,12542,1,3,0)="reported as being paid on the EFT to SUSPENSE.  The ERA record must"
^DIC(19,12542,1,4,0)="not already have a receipt attached to it.  This option is used to force a"
^DIC(19,12542,1,5,0)="'TR' document to be generated from the EDI Lockbox deposit account to the"
^DIC(19,12542,1,6,0)="suspense account when creating/posting a receipt can not be done due to"
^DIC(19,12542,1,7,0)="take backs or other situations where the EFT and ERA amounts do not match."
^DIC(19,12542,1,8,0)="NO posting to individual claims in AR is accomplished by this option."
^DIC(19,12542,1,9,0)="These must be done manually.  FMS is updated if there is any payment"
^DIC(19,12542,1,10,0)="indicated on the EFT."
^DIC(19,12542,25)="SUSPERA^RCDPEWL5"
^DIC(19,12542,"U")="MOVE ERA TOTAL TO SUSPENSE"
^DIC(19,12543,0)="RCDPE RATE TYPE AUTO AUDIT^Update Rate Types For Auto-audit^^R^10000000033^^^^^^^261"
^DIC(19,12543,1,0)="^19.06^4^4^3030605^^^^"
^DIC(19,12543,1,1,0)="This option allows the user to select a rate type from the RATE TYPE"
^DIC(19,12543,1,2,0)="file (#399.3) and to turn auto-audit ON or OFF for the rate type.  If"
^DIC(19,12543,1,3,0)="auto-audit is turned ON, a valid BILL RESULTING FROM entry must be"
^DIC(19,12543,1,4,0)="entered."
^DIC(19,12543,25)="RESFROM^PRCAUDT1"
^DIC(19,12543,"U")="UPDATE RATE TYPES FOR AUTO-AUD"
^DIC(19,12544,0)="RCDP SUMMARY 215 REPORT^Summary SF215 Report^^R^10000000033^^^^^^^261"
^DIC(19,12544,1,0)="^^3^3^3030619^"
^DIC(19,12544,1,1,0)="This option will print the summary 215 report for a selected deposit."
^DIC(19,12544,1,2,0)="It consists of an SF215 for each receipt in the deposit and a grand"
^DIC(19,12544,1,3,0)="totals page summarizing all the receipt totals."
^DIC(19,12544,25)="SUMM215^RCDPE215"
^DIC(19,12544,"U")="SUMMARY SF215 REPORT"
^DIC(19,12545,0)="RCDPE ERA POSTED BY PAPER EOB^Update ERA Posted Using Paper EOB^^R^11720^^^^^^^261"
^DIC(19,12545,1,0)="^19.06^4^4^3030828^^^^"
^DIC(19,12545,1,1,0)="This option is used to mark an ERA as posted when the paper EOB containing"
^DIC(19,12545,1,2,0)="this ERA data was posted to your A/R and FMS and no reference to the ERA"
^DIC(19,12545,1,3,0)="was included.  This will mark the ERA as posted.  It will require you to"
^DIC(19,12545,1,4,0)="enter the receipt # that was used to post the ERA information."
^DIC(19,12545,25)="POSTED^RCDPEM21"
^DIC(19,12545,"U")="UPDATE ERA POSTED USING PAPER "
^DIC(19,12546,0)="RCDPE VIEW/PRINT ERA^View/Print ERA^^R^1^^^^^^^261"
^DIC(19,12546,1,0)="^19.06^1^1^3030911^^^^"
^DIC(19,12546,1,1,0)="This option allows you to select an ERA and print or view its contents."
^DIC(19,12546,25)="PRTERA^RCDPEWL0"
^DIC(19,12546,"U")="VIEW/PRINT ERA"
^DIC(19,12547,0)="RCDPE UNMATCH ERA^Unmatch An ERA^^R^1^^^^^^^261"
^DIC(19,12547,1,0)="^19.06^6^6^3030912^^^^"
^DIC(19,12547,1,1,0)="This option allows you to remove the match status from an ERA if it was"
^DIC(19,12547,1,2,0)="added in error.  You may only select an ERA that was previously marked as"
^DIC(19,12547,1,3,0)="matched and that has had no receipt created for it yet.  If the worklist"
^DIC(19,12547,1,4,0)="entry has been created, it will be deleted before it allows the unmatch"
^DIC(19,12547,1,5,0)="to occur.  If the ERA was matched to an EFT, the EFT will be remarked as"
^DIC(19,12547,1,6,0)="unmatched too."
^DIC(19,12547,25)="UNMATCH^RCDPEM2"
^DIC(19,12547,"U")="UNMATCH AN ERA"
^DIC(19,12548,0)="RG LINKS & PROCESS DISPLAY^Link and Process Status Display ^^R^10000000033^^^^^^^525"
^DIC(19,12548,1,0)="^19.06^9^9^3020813^^^^"
^DIC(19,12548,1,1,0)="This option is used to monitor the status of MPI/PD related functions "
^DIC(19,12548,1,2,0)="and messaging.  The monitor displays the following information.  "
^DIC(19,12548,1,3,0)=" - HL links that currently have messages to be processed on either "
^DIC(19,12548,1,4,0)="   the inbound or outbound queues and the current STATE of the link.  "
^DIC(19,12548,1,5,0)=" - Status of MPI/PD background jobs.  "
^DIC(19,12548,1,6,0)=" - Current audit status on the NAME (#.01) field in the PATIENT"
^DIC(19,12548,1,7,0)="   (#2) file.  "
^DIC(19,12548,1,8,0)=" - Current status of the SEND parameters for HL7 messaging.  "
^DIC(19,12548,1,9,0)=" - Local link management information.  "
^DIC(19,12548,25)="RGMTMONT"
^DIC(19,12548,"U")="LINK AND PROCESS STATUS DISPLA"
^DIC(19,12550,0)="EEO CLOSE CASE^Close Case^^A^10000000033^^^^^^^^^1^1"
^DIC(19,12550,1,0)="^^1^1^2960821^"
^DIC(19,12550,1,1,0)="This option is used to close an EEO case."
^DIC(19,12550,15)="D KILL^EEOEOSE"
^DIC(19,12550,20)="D KILL^EEOEOSE,CLOSE^EEOEOE1"
^DIC(19,12550,"U")="CLOSE CASE"
^DIC(19,12551,0)="EEO REOPEN CASE^Reopen EEO case^^A^10000000033^^^^^^^^^1^1"
^DIC(19,12551,1,0)="^^1^1^2960821^"
^DIC(19,12551,1,1,0)="This option is used to reopen a closed EEO case."
^DIC(19,12551,15)="D KILL^EEOEOSE"
^DIC(19,12551,20)="D KILL^EEOEOSE,REOP^EEOEOE1"
^DIC(19,12551,"U")="REOPEN EEO CASE"
^DIC(19,12552,0)="EEO DELETE^Delete an EEO Case^^A^10000000033^^^^^^^^^1^1"
^DIC(19,12552,1,0)="^^2^2^2960821^"
^DIC(19,12552,1,1,0)="This option is used to delete an EEO case. The case is not actually"
^DIC(19,12552,1,2,0)="deleted, but rather screened from selection."
^DIC(19,12552,15)="D KILL^EEOEOSE"
^DIC(19,12552,20)="D KILL^EEOEOSE,DELETE^EEOEOE1"
^DIC(19,12552,"U")="DELETE AN EEO CASE"
^DIC(19,12553,0)="EEO UNDELETE^Reactivate a Deleted Case^^A^10000000033^^^^^^^^^1^1"
^DIC(19,12553,1,0)="^^1^1^2960822^"
^DIC(19,12553,1,1,0)="This option will 'undelete' an EEO case that had been previously deleted"
^DIC(19,12553,15)="D KILL^EEOEOSE"
^DIC(19,12553,20)="D KILL^EEOEOSE,UNDELETE^EEOEOE1"
^DIC(19,12553,"U")="REACTIVATE A DELETED CASE"
^DIC(19,12554,0)="EEO CLOSE/DELETE^Close/Delete Menu^^M^10000000033^^^^^^^"
^DIC(19,12554,1,0)="^^2^2^2960821^"
^DIC(19,12554,1,1,0)="This menu will allow the EEO Manager to close/delete,open, and"
^DIC(19,12554,1,2,0)="reactivate EEO cases."
^DIC(19,12554,10,0)="^19.01IP^4^4"
^DIC(19,12554,10,1,0)="12550^1^1"
^DIC(19,12554,10,2,0)="12551^2^2"
^DIC(19,12554,10,3,0)="12552^3^3"
