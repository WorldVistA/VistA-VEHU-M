^DIC(19,11550,0)="RG TRAN/AUD AUD REP^Patient Audit Log Reports^^M^10000000033^^^^^^^525"
^DIC(19,11550,1,0)="^19.06^4^4^3010706^^^^"
^DIC(19,11550,1,1,0)="This menu contains two options for reviewing information stored in"
^DIC(19,11550,1,2,0)="the AUDIT (#1.1) file for fields being audited in the PATIENT (#2) file."
^DIC(19,11550,1,3,0)="Options allow the user to (1) view all audited fields or selected fields"
^DIC(19,11550,1,4,0)="for a date range or (2) all audited data on a single patient."
^DIC(19,11550,10,0)="^19.01IP^3^2"
^DIC(19,11550,10,2,0)="11551^^10"
^DIC(19,11550,10,3,0)="11884^^20"
^DIC(19,11550,10,"B",11551,2)=""
^DIC(19,11550,10,"B",11884,3)=""
^DIC(19,11550,99)="61957,33175"
^DIC(19,11550,"U")="PATIENT AUDIT LOG REPORTS"
^DIC(19,11551,0)="RGMT AUDIT PRINT^Patient Audit File Print^^R^10000000033^^^^^^^525"
^DIC(19,11551,1,0)="^^11^11^2971118^^^^"
^DIC(19,11551,1,1,0)="This option prints information stored in the AUDIT file (#1.1) for "
^DIC(19,11551,1,2,0)="fields being audited in the PATIENT file (#2).  For a specified date "
^DIC(19,11551,1,3,0)="range, you can view all audited fields or selected fields."
^DIC(19,11551,1,4,0)="  "
^DIC(19,11551,1,5,0)="If selected fields are viewed, you can choose to see data for all or "
^DIC(19,11551,1,6,0)="selected patients.  If all audited fields are viewed, you must "
^DIC(19,11551,1,7,0)="choose the patients to examine."
^DIC(19,11551,1,8,0)="  "
^DIC(19,11551,1,9,0)="The report prints the patient name and DFN, date/time the field was "
^DIC(19,11551,1,10,0)="edited, the user who made the change, the field edited, the old "
^DIC(19,11551,1,11,0)="value, and the new value.  The right margin for this report is 80."
^DIC(19,11551,25)="RGMTAUDP"
^DIC(19,11551,"U")="PATIENT AUDIT FILE PRINT"
^DIC(19,11572,0)="MPIFINIT DPT TO MPI^Patient File Initialization to MPI^^R^11741^^^^^^^537"
^DIC(19,11572,1,0)="^^1^1^2981222^"
^DIC(19,11572,1,1,0)="This option builds messages to the MPI for initialization."
^DIC(19,11572,10.1)="Initialize MPI"
^DIC(19,11572,25)="GOBKG^MPIFBT1"
^DIC(19,11572,"U")="PATIENT FILE INITIALIZATION TO"
^DIC(19,11574,0)="MPIF DISPLAY ONLY QUERY TO MPI^Display Only Query^^R^10000000020^^^^^^^537"
^DIC(19,11574,1,0)="^^5^5^2980123^^"
^DIC(19,11574,1,1,0)="This option allows the user to query the MPI in Austin for all known data"
^DIC(19,11574,1,2,0)="about a patient.  The patient may or may not be currently in the Patient"
^DIC(19,11574,1,3,0)="file.  The MPI will return:  Patient Not Known at the MPI, a list of"
^DIC(19,11574,1,4,0)="potential matches along with all known data, or an exact match along with"
^DIC(19,11574,1,5,0)="all known data.  This will be for display purposes only."
^DIC(19,11574,10.1)="Query MPI"
^DIC(19,11574,25)="INTACTV^MPIFSAQ"
^DIC(19,11574,"U")="DISPLAY ONLY QUERY"
^DIC(19,11580,0)="MPIF LOC/MIS ICN RES^Local/Missing ICN Resolution Background Job^^R^10000000020^^^^^^^537"
^DIC(19,11580,1,0)="^^5^5^3040921^"
^DIC(19,11580,1,1,0)="This option will start the background job of resolving local and missing"
^DIC(19,11580,1,2,0)="ICNs against the MPI."
^DIC(19,11580,1,3,0)=" "
^DIC(19,11580,1,4,0)="It is recommended that this option be scheduled to run via TaskMan once"
^DIC(19,11580,1,5,0)="every 600 seconds per patch MPIF*1.0*33."
^DIC(19,11580,3.91,0)="^19.391^^0"
