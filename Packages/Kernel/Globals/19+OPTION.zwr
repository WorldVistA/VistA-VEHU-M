^DIC(19,10678,0)="HBHCR19A^ICD Code/Dx Text by Date Range Report  (80)^^R^1^^^^^^^328"
^DIC(19,10678,1,0)="^^10^10^3120302^"
^DIC(19,10678,1,1,0)="This option prints the HBPC ICD Code/Diagnosis Text by Date Range Report."
^DIC(19,10678,1,2,0)="The user is prompted to enter the date range, and the ICD Code(s), or "
^DIC(19,10678,1,3,0)="category of codes, for inclusion on the report.  If the user responds 'yes'"
^DIC(19,10678,1,4,0)="to the 'include All codes within category xxx' prompt, simply selecting ANY"
^DIC(19,10678,1,5,0)="code from the category will be category inclusive.  (e.g.  selecting 250.00"
^DIC(19,10678,1,6,0)="or 250.60 will produce the same report results) "
^DIC(19,10678,1,7,0)=" "
^DIC(19,10678,1,8,0)="The report is sorted by ICD Code category, then alphabetically by patient"
^DIC(19,10678,1,9,0)="within category, with totals for each ICD Code category plus a grand"
^DIC(19,10678,1,10,0)="total.  Report prints in 80 column format. "
^DIC(19,10678,25)="HBHCR19A"
^DIC(19,10678,598000)=2
^DIC(19,10678,"U")="ICD CODE/DX TEXT BY DATE RANGE"
^DIC(19,10679,0)="HBHCRP20^Unique Patients by Date Range Summary Report  (80)^^R^10000000020^^^^^^^328"
^DIC(19,10679,1,0)="^^4^4^2971118^"
^DIC(19,10679,1,1,0)="This option prints the HBPC Unique patients by Date Range Report.  The user is"
^DIC(19,10679,1,2,0)="prompted to enter the date range for inclusion on the report.  The report"
^DIC(19,10679,1,3,0)="prints separate totals for patients with single visit only or multiple visits,"
^DIC(19,10679,1,4,0)="plus grand total of unique patients.  Reports prints in 80 column format. "
^DIC(19,10679,25)="HBHCRP20"
^DIC(19,10679,"U")="UNIQUE PATIENTS BY DATE RANGE "
