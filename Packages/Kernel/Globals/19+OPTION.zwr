^DIC(19,1101,"U")="MICROBIOLOGY MENU"
^DIC(19,1102,0)="LRDRAW^Ward collection summary for lab orders^^R^.5^^^^^^^26"
^DIC(19,1102,1,0)="^^3^3^2931122^^^^"
^DIC(19,1102,1,1,0)="A summary of ward orders not yet accessioned."
^DIC(19,1102,1,2,0)="This function may be appropriate for the wards to use to determine"
^DIC(19,1102,1,3,0)="their quality assurance of chart transcription to lab orders."
^DIC(19,1102,25)="LRDRAW"
^DIC(19,1102,"U")="WARD COLLECTION SUMMARY FOR LA"
^DIC(19,1103,0)="LREV^Test description information^^R^.5^^^^^^^26"
^DIC(19,1103,1,0)="^^2^2^2870204^^^^"
^DIC(19,1103,1,1,0)="This function displays limited information from the Laboratory test file,"
^DIC(19,1103,1,2,0)="such as special ordering information, normal ranges, etc."
^DIC(19,1103,25)="LRUTW"
^DIC(19,1103,"U")="TEST DESCRIPTION INFORMATION"
^DIC(19,1104,0)="LRFAST^Bypass normal data entry^^R^.5^^^^^^^26^^1"
^DIC(19,1104,1,0)="^^6^6^2910123^^^^"
^DIC(19,1104,1,1,0)="This option bypasses normal ordering, accessioning, and data entry."
^DIC(19,1104,1,2,0)="Where the results are in hand and no information regarding the order"
^DIC(19,1104,1,3,0)="is in the computer, this option may be used to enter the patient's"
^DIC(19,1104,1,4,0)="name, the test, and the results.  Note that information such as the"
^DIC(19,1104,1,5,0)="person ordering the test, or alternative routing information is not"
^DIC(19,1104,1,6,0)="asked (the report routing is taken from MAS information in the computer)."
^DIC(19,1104,20)="D ^LRPARAM"
^DIC(19,1104,25)="EN^LRFAST"
^DIC(19,1104,99)="55640,54848"
^DIC(19,1104,99.1)="59164,31861"
^DIC(19,1104,"U")="BYPASS NORMAL DATA ENTRY"
^DIC(19,1105,0)="LRNODRAW^List of lab orders not collected^^R^.5^^^^^^^26"
^DIC(19,1105,1,0)="^^2^2^2870203^^^^"
^DIC(19,1105,1,1,0)="This option lists orders which have been indicated as not being collected"
^DIC(19,1105,1,2,0)="by the phlebotomists after routine collection by lab on the ward."
^DIC(19,1105,25)="LRNODRAW"
^DIC(19,1105,"U")="LIST OF LAB ORDERS NOT COLLECT"
^DIC(19,1106,0)="LROC^Purge old orders & accessions^^R^.5^LRSUPER^^^^^^26"
^DIC(19,1106,1,0)="^^4^4^2870203^^^"
^DIC(19,1106,1,1,0)="This function allows a manually driven purging of old order and"
^DIC(19,1106,1,2,0)="accession data.  One must have records in some form accessible to the"
^DIC(19,1106,1,3,0)="laboratory to satisfy JCAH and CAP requirements, though these do not have"
^DIC(19,1106,1,4,0)="to be on the computer."
^DIC(19,1106,25)="LROC"
^DIC(19,1106,"U")="PURGE OLD ORDERS & ACCESSIONS"
^DIC(19,1107,0)="LROE^Accessioning tests ordered by ward order entry^^R^.5^^^^^^^26^^1^1"
^DIC(19,1107,1,0)="^^10^10^2870203^^^^"
^DIC(19,1107,1,1,0)="The first question asked is the ""Order number.""  If the order has not"
^DIC(19,1107,1,2,0)="been placed in the computer, this number does not exist and the question"
^DIC(19,1107,1,3,0)="should be skipped.  The patient and test information will be asked and"
^DIC(19,1107,1,4,0)="an order number assigned.  The option will then proceed to accession the"
^DIC(19,1107,1,5,0)="order as if the ""Order number"" had been entered in the first place."
^DIC(19,1107,1,6,0)=" "
^DIC(19,1107,1,7,0)="The Order number is normally assigned at the time the ward places the"
^DIC(19,1107,1,8,0)="order.  This option is then used to accession tests ordered and brought"
^DIC(19,1107,1,9,0)="to the lab by the ward, or to accession tests ordered by the ward and"
^DIC(19,1107,1,10,0)="brought to the lab by the patient."
^DIC(19,1107,15)="K LRLABLIO S LREND=0"
^DIC(19,1107,20)="D ^LRPARAM"
^DIC(19,1107,25)="LROE"
^DIC(19,1107,"U")="ACCESSIONING TESTS ORDERED BY "
^DIC(19,1108,0)="LROW^Lab test order^^R^.5^^^^^^^26"
^DIC(19,1108,1,0)="^^6^6^2870203^^^^"
^DIC(19,1108,1,1,0)="This is to be used by the wards for order entry, NOT by the lab!"
^DIC(19,1108,1,2,0)="The purpose of this function is to allow selection among sending"
^DIC(19,1108,1,3,0)="the patient or specimen accompanied with the order number to the lab"
^DIC(19,1108,1,4,0)="where it can be accessioned, or holding the test request in the computer"
^DIC(19,1108,1,5,0)="until a collection list can be made and routine phlebotomy collection"
^DIC(19,1108,1,6,0)="by the laboratory on the wards occurs."
^DIC(19,1108,25)="LROW"
^DIC(19,1108,99)="54031,49515"
^DIC(19,1108,99.1)="59164,31861"
^DIC(19,1108,"U")="LAB TEST ORDER"
^DIC(19,1109,0)="LRPHLIST^Print collection list/labels^^R^.5^^^^^^^26"
^DIC(19,1109,1,0)="^^2^2^2870203^^^^"
^DIC(19,1109,1,1,0)="Prints information which may be used for routine phlebotomy"
^DIC(19,1109,1,2,0)="collection."
^DIC(19,1109,25)="LRPHLIST"
^DIC(19,1109,200)="^^"
^DIC(19,1109,"U")="PRINT COLLECTION LIST/LABELS"
^DIC(19,1110,0)="LRTASK PHSET^CREATE NEW COLLECTION LIST^^R^.5^^^^^^^26"
^DIC(19,1110,1,0)="^^1^1^2860627^^^^"
^DIC(19,1110,1,1,0)="This routine is run each night by task-man to create the collection list."
^DIC(19,1110,25)="LRPHSET"
^DIC(19,1110,200)="^^^"
^DIC(19,1110,200.9)="y"
^DIC(19,1110,"U")="CREATE NEW COLLECTION LIST"
^DIC(19,1111,0)="LRQC^Quality control display (Levey-Jennings)^^R^.5^^^^^^^26"
^DIC(19,1111,1,0)="^^13^13^2870203^^^^"
^DIC(19,1111,1,1,0)="Quality control data are displayed against the normal mean and standard"
^DIC(19,1111,1,2,0)="deviation entered for the requested test (in the Test field of the"
^DIC(19,1111,1,3,0)="Lab Control Name file).  The option uses a modified Levey-Jennings"
^DIC(19,1111,1,4,0)="format to allow a printout on the VA printers.  This format is "
^DIC(19,1111,1,5,0)="vertical and the time scale is sequential and not proportional."
^DIC(19,1111,1,6,0)="The report will list all dates, control values, total # of"
^DIC(19,1111,1,7,0)="controls (N), target range, actual range obtained, and will flag"
^DIC(19,1111,1,8,0)="any values outside of 3SD.  The control values outside of 3SD are "
^DIC(19,1111,1,9,0)="not used in the calculation of the actual range obtained.  The"
^DIC(19,1111,1,10,0)="report also has a line where the responsible laboratory official "
^DIC(19,1111,1,11,0)="may review the output of the report (CAP Requirement).  The"
^DIC(19,1111,1,12,0)="""mean"" is denoted by the ***** line, 1SD & 3SD are denoted by the "
^DIC(19,1111,1,13,0)="..... lines, and 2SD is denoted by the ::::: lines."
^DIC(19,1111,25)="LRQC"
^DIC(19,1111,"U")="QUALITY CONTROL DISPLAY (LEVEY"
^DIC(19,1112,0)="LRQCC^Bull algorithm quality control^^R^.5^^^^^^^26"
^DIC(19,1112,1,0)="^^9^9^2870203^^^^"
^DIC(19,1112,1,1,0)="Displays cumulative data from the Bull algorithm.  This is a"
^DIC(19,1112,1,2,0)="Hematology Quality Control option which allows the Hematology"
^DIC(19,1112,1,3,0)="Supervisor to monitor the MCH, MCV, and MCHC hematology indices."
^DIC(19,1112,1,4,0)="These indices are grouped in ""sets"" of 20 values, from which the "
^DIC(19,1112,1,5,0)="mean and delta values are calculated.  It has been reported that"
^DIC(19,1112,1,6,0)="these three indices do not vary except in extreme disease states."
^DIC(19,1112,1,7,0)="Hence, the indices are an indication of the stability and precision"
^DIC(19,1112,1,8,0)="of the automated hematology instrument.  Before using this option"
^DIC(19,1112,1,9,0)="the original article by Dr. Brian Bull should be studied."
^DIC(19,1112,25)="LRQCC"
^DIC(19,1112,"U")="BULL ALGORITHM QUALITY CONTROL"
^DIC(19,1113,0)="LRQCLOG^Manually accession QC, Environmental, etc.^^R^.5^^^^^^^26"
^DIC(19,1113,1,0)="^^8^8^2870720^^^^"
^DIC(19,1113,1,1,0)="This option allows you to accession quality control specimens, (lab control"
^DIC(19,1113,1,2,0)="names) and specimens from blood donor, referral, research, sterilizers, and"
^DIC(19,1113,1,3,0)="enviromental areas."
^DIC(19,1113,1,4,0)="Quality control specimens may be given accessions with this function."
^DIC(19,1113,1,5,0)="QC specimens may also be accessioned using ""extended syntax""; i.e."
^DIC(19,1113,1,6,0)="LAB CONTROL NAME:QC NAME when using other test request functions."
^DIC(19,1113,1,7,0)="Usually, controls are automatically accessioned at the time of the"
^DIC(19,1113,1,8,0)="creation of a load or work list."
^DIC(19,1113,25)="LRQCLOG"
^DIC(19,1113,"U")="MANUALLY ACCESSION QC, ENVIRON"
^DIC(19,1114,0)="LRTSTJAM^Delete test from an accession^Out of Service per patch LR*5.2*527^R^.5^^^"
^DIC(19,1114,1,0)="^^1^1^2881206^^^^"
^DIC(19,1114,1,1,0)="This option may be used to remove individual tests from an accession."
^DIC(19,1114,25)="LRTSTJAM"
^DIC(19,1114,"U")="DELETE TEST FROM AN ACCESSION"
^DIC(19,1115,0)="LRDELOG^Remove an accession^Out of Service per patch LR*5.2*527^R^.5^^^^^^^26"
^DIC(19,1115,1,0)="^^2^2^2870203^^"
^DIC(19,1115,1,1,0)="Completely removes an accession from the system.  The original order"
^DIC(19,1115,1,2,0)="still remains for the record."
^DIC(19,1115,25)="DELOG^LRTSTJAN"
^DIC(19,1115,"U")="REMOVE AN ACCESSION"
^DIC(19,1116,0)="LRNEWSTART^Set a new starting accession number^^R^.5^LRSUPER^^^^^^26"
^DIC(19,1116,1,0)="^^1^1^2870204^^^^"
^DIC(19,1116,1,1,0)="Allows resetting the default prompt for any accession area."
^DIC(19,1116,25)="NEWSTART^LRTSTJAN"
^DIC(19,1116,"U")="SET A NEW STARTING ACCESSION N"
^DIC(19,1117,0)="LRQCADDNAME^Add/edit QC name &/or edit test means^^R^.5^LRSUPER^^^^^^26"
^DIC(19,1117,1,0)="^^4^4^2870203^^^^"
^DIC(19,1117,1,1,0)="Quality control names may be added or edited.  Tests for listing on"
^DIC(19,1117,1,2,0)="worklists may be edited.  Tests may be individually listed for entering"
^DIC(19,1117,1,3,0)="the expected mean and standard deviations.  New control lots should have"
^DIC(19,1117,1,4,0)="new name entries in this file."
^DIC(19,1117,25)="ADDNAME^LRQCLOG"
^DIC(19,1117,"U")="ADD/EDIT QC NAME &/OR EDIT TES"
^DIC(19,1118,0)="LRRSP^Interim report for selected tests as ordered^^R^10000000020^^^^^^^26"
^DIC(19,1118,1,0)="^19.06^14^14^3021031^^^^"
^DIC(19,1118,1,1,0)="Detailed report format for an individual patient.  Report is done"
^DIC(19,1118,1,2,0)="for selected tests as they are ordered.  If the orders have been"
^DIC(19,1118,1,3,0)="purged, the results will not be found because the result look-up"
^DIC(19,1118,1,4,0)="is dependent on the orders.  This option allows the user"
^DIC(19,1118,1,5,0)="to select a specific test or panel, or select the ""ANY"" test"
^DIC(19,1118,1,6,0)="default which will output all the verified tests for that patient "
^DIC(19,1118,1,7,0)="during the time period specified.  If no results are available, the"
^DIC(19,1118,1,8,0)="option will ask for another patient.  This option will only print"
^DIC(19,1118,1,9,0)="verified results and should be used for information only."
^DIC(19,1118,1,10,0)="The option should not be charted."
^DIC(19,1118,1,11,0)="The report prints site codes for tests.  You will be asked if you would"
^DIC(19,1118,1,12,0)="like to print an address page.  The address page prints on a separate page(s)"
^DIC(19,1118,1,13,0)="at the end of the report and lists the performing lab name, address and site"
^DIC(19,1118,1,14,0)="code."
^DIC(19,1118,25)="LRRSP"
^DIC(19,1118,99.1)="55638,54386"
^DIC(19,1118,"U")="INTERIM REPORT FOR SELECTED TE"
^DIC(19,1132,0)="LRMIP^Microbiology print menu^^M^.5^^^^^^^26"
^DIC(19,1132,1,0)="^^1^1^2930328^^^^"
^DIC(19,1132,1,1,0)="Microbiology print menu options"
^DIC(19,1132,10,0)="^19.01PI^19^10"
^DIC(19,1132,10,4,0)="1133^"
^DIC(19,1132,10,7,0)="1134^"
^DIC(19,1132,10,8,0)="1135^"
^DIC(19,1132,10,9,0)="1136^"
^DIC(19,1132,10,14,0)="1146^"
^DIC(19,1132,10,15,0)="1145^"
^DIC(19,1132,10,16,0)="1342^"
^DIC(19,1132,10,17,0)="8448^"
^DIC(19,1132,10,18,0)=9350
^DIC(19,1132,10,19,0)=9351
