^DIC(19,5327,"U")="DISPLAY INTEGRATED BILLING STA"
^DIC(19,5328,0)="IB FILER STOP^Stop the Integrated Billing Background Filer^^R^.5^^^^^^^192"
^DIC(19,5328,1,0)="^^3^3^2910304^"
^DIC(19,5328,1,1,0)="This option will cause the IB background filer to cease when it has"
^DIC(19,5328,1,2,0)="finished processing all its known transactions.  Processing with"
^DIC(19,5328,1,3,0)="Accounts Receivable will then be accomplished in the foreground."
^DIC(19,5328,15)=""
^DIC(19,5328,20)=""
^DIC(19,5328,25)="STOP^IBEFUTL"
^DIC(19,5328,"U")="STOP THE INTEGRATED BILLING BA"
^DIC(19,5329,0)="IB FILER START^Start the Integrated Billing Background Filer^^R^.5^^^^^^^192"
^DIC(19,5329,1,0)="^^4^4^2910417^^^"
^DIC(19,5329,1,1,0)="This option will task the IB background filer to run whether or not a"
^DIC(19,5329,1,2,0)="filer is currently running.  This option can be used when a filer"
^DIC(19,5329,1,3,0)="job has terminated unexpectedly and won't restart itself.  This will"
^DIC(19,5329,1,4,0)="force a filer to start running."
^DIC(19,5329,15)=""
^DIC(19,5329,20)=""
^DIC(19,5329,25)="START^IBEFUTL"
^DIC(19,5329,"U")="START THE INTEGRATED BILLING B"
