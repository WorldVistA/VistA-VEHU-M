^DIC(19,7281,"U")="SURGERY UTILIZATION MENU"
^DIC(19,7282,0)="SR OR UTL1^Operating Room Utilization Report^^R^10000000216^^^^^^^^^1^1"
^DIC(19,7282,1,0)="^^12^12^2911112^^^^"
^DIC(19,7282,1,1,0)="This report prints utilization information for a selected date range for"
^DIC(19,7282,1,2,0)="all operating rooms or for a single operating room.  The report displays"
^DIC(19,7282,1,3,0)="the percent utilization, the number of cases, the total operation time"
^DIC(19,7282,1,4,0)="and the time worked outside normal hours for each operating room"
^DIC(19,7282,1,5,0)="individually and all operating rooms collectively."
^DIC(19,7282,1,6,0)="  "
^DIC(19,7282,1,7,0)="The percent utilization is derived by dividing the total operation time"
^DIC(19,7282,1,8,0)="for all operations (including total time patients were in OR, plus the"
^DIC(19,7282,1,9,0)="cleanup time allowed for each case, plus one hour allowance for startup"
^DIC(19,7282,1,10,0)="and shutdown daily for each OR that had at least one case) by the total"
^DIC(19,7282,1,11,0)="OR functioning time as defined in the Surgery Utilization file.  The"
^DIC(19,7282,1,12,0)="quotient is then multiplied by 100."
^DIC(19,7282,15)="D EXIT^SROVAR"
^DIC(19,7282,20)="D ^SROVAR"
^DIC(19,7282,22)="Q"
^DIC(19,7282,25)="SRORUT"
^DIC(19,7282,"U")="OPERATING ROOM UTILIZATION REP"
^DIC(19,7283,0)="SRTASK-NIGHT^Surgery Nightly Cleanup and Updates^^R^.5^^^^^^^"
^DIC(19,7283,1,0)="^^7^7^2990720^^^^"
^DIC(19,7283,1,1,0)="This option is queued to run daily.  It will initiate a number of"
^DIC(19,7283,1,2,0)="background tasks to cleanup the surgery database and update all"
^DIC(19,7283,1,3,0)="appropriate information.  Among the tasks done are calculation of"
^DIC(19,7283,1,4,0)="average procedure times, cleanup of outstanding requests, update"
^DIC(19,7283,1,5,0)="expected start and end times for operating rooms and surgical"
^DIC(19,7283,1,6,0)="specialties, and locking cases."
^DIC(19,7283,1,7,0)=" "
^DIC(19,7283,25)="SRONITE"
^DIC(19,7283,200.9)="y"
^DIC(19,7283,"U")="SURGERY NIGHTLY CLEANUP AND UP"
