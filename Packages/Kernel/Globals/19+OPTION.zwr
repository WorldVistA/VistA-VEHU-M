^DIC(19,14102,"U")="NURSE POC DATA ENTRY MENU"
^DIC(19,14103,0)="PRSN DEL POC RECORD^Delete Nurse POC Daily Time Record^^R^10000000216^^^^^^^"
^DIC(19,14103,1,0)="^19.06^10^10^3091109^^"
^DIC(19,14103,1,1,0)="This option allows data entry personnel to delete the following types of "
^DIC(19,14103,1,2,0)="records:"
^DIC(19,14103,1,3,0)=" "
^DIC(19,14103,1,4,0)="1. An entered Nurse POC Daily Time record that has never been approved or "
^DIC(19,14103,1,5,0)="released."
^DIC(19,14103,1,6,0)="2. A Nurse POC Daily Time record that is an unapproved correction to a "
^DIC(19,14103,1,7,0)="previously released record."
^DIC(19,14103,1,8,0)=" "
^DIC(19,14103,1,9,0)="The system provides a message to the user as to the status of the"
^DIC(19,14103,1,10,0)="deletion request."
^DIC(19,14103,25)="DELPOC^PRSNDPC1"
^DIC(19,14103,"U")="DELETE NURSE POC DAILY TIME RE"
^DIC(19,14104,0)="PRSN TOGGLE TK POC POST^Turn On/Off POC Data Entry from Timecard Posting^^R^10000000216^PRSN DEP^^^^^^"
^DIC(19,14104,1,0)="^^7^7^3090724^"
^DIC(19,14104,1,1,0)="This option is controlled by a security key-PRSN DEP.  When a "
^DIC(19,14104,1,2,0)="timekeeper is added to the POC DATA ENTRY PERSONNEL multiple in the T&L "
^DIC(19,14104,1,3,0)="unit file, then they will receive the SECURITY KEY that unlocks this menu "
^DIC(19,14104,1,4,0)="item from the TIMEKEEPER MAIN MENU.  The option will give them the "
^DIC(19,14104,1,5,0)="ability to TURN ON or TURN OFF the new functionality in the POST EMPLOYEE "
^DIC(19,14104,1,6,0)="time option, which takes a timekeeper directly to the POC Data Entry from "
^DIC(19,14104,1,7,0)="the POST EMPLOYEE TIME option."
^DIC(19,14104,25)="TOGGLE^PRSNEETP"
^DIC(19,14104,"U")="TURN ON/OFF POC DATA ENTRY FRO"
^DIC(19,14105,0)="PRSN VANOD EXTRACT^VANOD Kernel RPC^^B^10000000216^^^^^^^"
^DIC(19,14105,1,0)="^^2^2^3090826^"
^DIC(19,14105,1,1,0)="This option is required by the Kernel Broker to give access to the RPCs "
^DIC(19,14105,1,2,0)="used by the VA Nursing Outcomes Database (VANOD)"
^DIC(19,14105,"RPC",0)="^19.05P^2^2"
^DIC(19,14105,"RPC",1,0)=3074
^DIC(19,14105,"RPC",2,0)=3075
^DIC(19,14105,"RPC","B",3074,1)=""
^DIC(19,14105,"RPC","B",3075,2)=""
^DIC(19,14105,"U")="VANOD KERNEL RPC"
^DIC(19,14106,0)="PRSN SHOW POC SYSTEM SETUP^Show Nurse Count by Location and T&L Unit^^R^10000000216^^^^^^^"
^DIC(19,14106,1,0)="^19.06^2^2^3100305^^^"
^DIC(19,14106,1,1,0)="This option lists divisions and the locations in those divisions.  It "
^DIC(19,14106,1,2,0)="shows how many nurses from various T&Ls are assigned to those locations."
^DIC(19,14106,25)="SHOWSU^PRSNUT05"
^DIC(19,14106,"U")="SHOW NURSE COUNT BY LOCATION A"
^DIC(19,14107,0)="PRSN ENTER NURSE POC DATA^Enter Nurse POC Data^^R^10000000216^^^^^^^230"
