^DIC(19,7332,1,1,0)="This option allows the backfilling of the ORDER file with existing Surgical"
^DIC(19,7332,1,2,0)="cases.  The user must select the number of days back for which Surgical"
^DIC(19,7332,1,3,0)="cases should be added to the ORDER file to update OE/RR."
^DIC(19,7332,15)="D EXIT^SROVAR"
^DIC(19,7332,20)="D ^SROVAR"
^DIC(19,7332,22)="Q"
^DIC(19,7332,25)="SROERRPO"
^DIC(19,7332,"U")="BACKFILL ORDER FILE WITH SURGI"
^DIC(19,7333,0)="SR PURGE UTILIZATION^Purge Utilization Information^^R^.5^^^^^^^167^^1^1"
^DIC(19,7333,1,0)="^^5^5^2920721^"
^DIC(19,7333,1,1,0)="This option is used to purge utilization information for a selected"
^DIC(19,7333,1,2,0)="date range.  After selecteing a starting date, you may purge all"
^DIC(19,7333,1,3,0)="utilization information for dates prior to, and including, that"
^DIC(19,7333,1,4,0)="starting date."
^DIC(19,7333,1,5,0)=" "
^DIC(19,7333,15)="D EXIT^SROVAR"
^DIC(19,7333,20)="D ^SROVAR"
^DIC(19,7333,22)="Q"
^DIC(19,7333,25)="SRSUPRG"
^DIC(19,7333,"U")="PURGE UTILIZATION INFORMATION"
^DIC(19,7334,0)="SR UPDATE FILES^Update Site Configurable Files^^R^.5^^^^^^^167^^1^1"
^DIC(19,7334,1,0)="^^6^6^2921104^^^"
^DIC(19,7334,1,1,0)="This option is used to add, edit, or delete information in the"
^DIC(19,7334,1,2,0)="site configurable files contained within the Surgery package."
^DIC(19,7334,1,3,0)=" "
^DIC(19,7334,1,4,0)="File entries that are not to be used should be made inactive and should"
^DIC(19,7334,1,5,0)="not be deleted from the file."
^DIC(19,7334,1,6,0)="   "
^DIC(19,7334,15)="D EXIT^SROVAR"
^DIC(19,7334,20)="D ^SROVAR"
^DIC(19,7334,22)="Q"
^DIC(19,7334,25)="SROFILE"
^DIC(19,7334,"U")="UPDATE SITE CONFIGURABLE FILES"
^DIC(19,7335,0)="SR NON-OR REPORT^Procedure Report (Non-O.R.)^^R^10000000020^^^^^^^167^^1^1"
^DIC(19,7335,1,0)="^^3^3^3030908^"
^DIC(19,7335,1,1,0)="This option generates the Procedure Report (Non-O.R.). This report "
^DIC(19,7335,1,2,0)="consists of the electronically signed procedure summary (provider's "
^DIC(19,7335,1,3,0)="dictation) stored in the Text Integration Utilities (TIU) software."
^DIC(19,7335,15)="D EXIT^SROVAR"
^DIC(19,7335,20)="D ^SROVAR Q:$D(XQUIT)"
^DIC(19,7335,22)="Q"
^DIC(19,7335,25)="SRONON"
