^DIC(19,7281,0)="SR OR UTIL^Surgery Utilization Menu^^M^11595^SRCOORD^^^^^^^^1^1^^1"
^DIC(19,7281,1,0)="^^2^2^2920623^^^^"
^DIC(19,7281,1,1,0)="This menu contains various Operating Room Utilization reports. "
^DIC(19,7281,1,2,0)=" "
