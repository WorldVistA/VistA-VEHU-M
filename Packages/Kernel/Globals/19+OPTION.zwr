^DIC(19,6595,1,0)="^19.06^1^1^3130708^^^^"
^DIC(19,6595,1,1,0)="Display or print of patient's summary record."
^DIC(19,6595,20)="S ONTEMP=""[ONCO XABSTRACT INCOMPLETE]"" ;D SU^ONCOGEN"
^DIC(19,6595,25)="SU^ONCOGEN"
^DIC(19,6595,"U")="PATIENT SUMMARY"
