^DIC(19,1756,0)="PRCHPC PO ADD^New Purchase Order^^R^11740^^^^^^^"
^DIC(19,1756,1,0)="^19.06^9^9^3000608^^^^"
^DIC(19,1756,1,1,0)="This function allows A&MM Service to prepare Purchase Orders."
^DIC(19,1756,1,2,0)="The agent may work from a printed form (e.g., paper 2237), or if the"
^DIC(19,1756,1,3,0)="service is using the system to enter its requests, the agent may"
^DIC(19,1756,1,4,0)="automatically transfer the data directly from the service order to"
^DIC(19,1756,1,5,0)="the Purchase Order.  After the basic Purchase Order data is entered,"
^DIC(19,1756,1,6,0)="the agent provides additional data for discounts and terms."
^DIC(19,1756,1,7,0)=" "
^DIC(19,1756,1,8,0)="An Electronic Signature is required for the agent to release the order"
^DIC(19,1756,1,9,0)="to Fiscal for obligation."
