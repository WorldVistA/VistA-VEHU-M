^DIC(19,10603,1,1,0)="The Transfer Drugs Between Pharmacies option allows a pharmacist to move"
^DIC(19,10603,1,2,0)="drugs between pharmacy locations. The number of dispense units to be moved"
^DIC(19,10603,1,3,0)="is subtracted from the dispensing pharmacy location and added to the"
^DIC(19,10603,1,4,0)="receiving pharmacy location. A Transfer Signature Sheet may be printed"
^DIC(19,10603,1,5,0)="after all transfers are completed."
^DIC(19,10603,25)="PSATRAN"
^DIC(19,10603,"U")="TRANSFER DRUGS BETWEEN PHARMAC"
