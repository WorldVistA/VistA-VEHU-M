^DIC(19,3521,66)=1
^DIC(19,3521,"U")="DISPLAY THE KERNEL AUDIT PARAM"
^DIC(19,3524,0)="XUXREF-2^Show Users with a Selected primary Menu^^R^11748^^^^^^^"
^DIC(19,3524,1,0)="^19.06^5^5^3021001^^^^"
^DIC(19,3524,1,1,0)="This option generates a listing of those users who have a selected"
^DIC(19,3524,1,2,0)="option as their primary menus option or as a secondary menu option."
^DIC(19,3524,1,3,0)="It does NOT show all users who might have access to a particular"
^DIC(19,3524,1,4,0)="option.  It only looks at Primary (sign-on) menus and top-level"
^DIC(19,3524,1,5,0)="secondary menu options."
^DIC(19,3524,25)="XQ32"
^DIC(19,3524,"U")="SHOW USERS WITH A SELECTED PRI"
^DIC(19,3525,0)="XQ UNREF'D OPTIONS^Delete Unreferenced Options^^R^1039^^^^^^^"
^DIC(19,3525,1,0)="^^4^4^2890307^"
^DIC(19,3525,1,1,0)="This option can be used to examine those options which are not on any"
^DIC(19,3525,1,2,0)="menu, are not used as primary or secondary options, and are not tasked"
^DIC(19,3525,1,3,0)="to run.  The user may then decide in each case whether to delete the"
^DIC(19,3525,1,4,0)="unreferenced option."
^DIC(19,3525,25)="XQ33"
^DIC(19,3525,"U")="DELETE UNREFERENCED OPTIONS"
