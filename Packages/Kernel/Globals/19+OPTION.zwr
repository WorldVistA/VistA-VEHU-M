^DIC(19,13952,0)="ECXDEFINE^Define Extract Schedule^Temporarily out-of-service.^R^10000000216^ECXMGR^^^^^^513"
^DIC(19,13952,1,0)="^^8^8^2950417^^^^"
^DIC(19,13952,1,1,0)="This option allows the extract manager to create schedules for"
^DIC(19,13952,1,2,0)="running the extracts. Each extract may be scheduled to run daily,"
^DIC(19,13952,1,3,0)="weekly, or monthly. For daily and weekly extracts, the offset"
^DIC(19,13952,1,4,0)="between the run time and the date range to be extracted may be"
^DIC(19,13952,1,5,0)="selected. Monthly extracts extract data for the month previous to"
^DIC(19,13952,1,6,0)="the run time. Once the extracts are scheduled through this option,"
^DIC(19,13952,1,7,0)="careful attention must be used in trying to change this schedule."
^DIC(19,13952,1,8,0)="Changing this schedule can lead to missing data."
^DIC(19,13952,25)="EN^ECXDEFIN"
^DIC(19,13952,"U")="DEFINE EXTRACT SCHEDULE"
