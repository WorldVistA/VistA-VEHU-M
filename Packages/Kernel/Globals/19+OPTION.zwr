^DIC(19,13211,0)="DGPF TRANSMISSION ERRORS^Record Flag Transmission Errors^^R^1^DGPF TRANSMISSIONS^^^^^^114^^1^1"
^DIC(19,13211,1,0)="^19.06^9^9^3060814^^^^"
^DIC(19,13211,1,1,0)="This option provides a List Manager user interface that can be used to"
^DIC(19,13211,1,2,0)="review and manage Rejected Status (""RJ"") HL7 transmission messages that"
^DIC(19,13211,1,3,0)="are received from Treating Facilities of the patient when trying to share"
^DIC(19,13211,1,4,0)="Category I PRF Assignment information."
^DIC(19,13211,1,5,0)="The following actions are provided within this option."
^DIC(19,13211,1,6,0)=" - Sort List display by patient name alphabetically or date/time received"
^DIC(19,13211,1,7,0)=" - View Message details of the patient's rejected HL7 message record"
^DIC(19,13211,1,8,0)=" - Retransmit all of the patient's PRF Assignment and History records to"
^DIC(19,13211,1,9,0)="   the site that the rejection message occurred at."
^DIC(19,13211,15)="L -^TMP(""DGPFLMT"")"
^DIC(19,13211,20)="L +^TMP(""DGPFLMT""):2 E  W !!,"">>> Sorry, it appears that someone is already using this option."",! S XQUIT=1"
^DIC(19,13211,22)="S DIR(0)=""EA"",DIR(""A"")=""Hit the 'Enter' or 'Return' Key to Continue"" D ^DIR K DIR"
^DIC(19,13211,25)="EN^DGPFLMT"
^DIC(19,13211,"U")="RECORD FLAG TRANSMISSION ERROR"
^DIC(19,13212,0)="DGPF ENABLE DIVISIONS^Record Flag Enable Divisions^^R^1^DGPF MANAGER^^^^^^114^^1"
^DIC(19,13212,1,0)="^^7^7^3050919^"
^DIC(19,13212,1,1,0)="This option allows multi-divisional facilities to enable individual "
^DIC(19,13212,1,2,0)="medical center divisions stored in the MEDICAL CENTER DIVISION (#40.8) "
^DIC(19,13212,1,3,0)="file as patient record flag assignment owners.  Once a medical center "
^DIC(19,13212,1,4,0)="division has been enabled as a patient record flag assignment owner, it"
^DIC(19,13212,1,5,0)="may also be disabled through this option.  Disabling a medical center "
^DIC(19,13212,1,6,0)="division will only be allowed if there are no active patient record flag"
^DIC(19,13212,1,7,0)="assignments associated with the division."
^DIC(19,13212,20)="I '$P($G(^DG(43,1,""GL"")),U,2) W !,""Your facility is not multi-divisional."",*7 S XQUIT=1"
^DIC(19,13212,25)="EN^DGPFDIV"
^DIC(19,13212,"U")="RECORD FLAG ENABLE DIVISIONS"
^DIC(19,13213,0)="DGPF MANUAL QUERY^Record Flag Manual Query^^R^1^DGPF TRANSMISSIONS^^^^^^114^^"
^DIC(19,13213,1,0)="^^8^8^3060824^"
^DIC(19,13213,1,1,0)="This option allows a user to query a selected treating facility for"
^DIC(19,13213,1,2,0)="existing Category I Patient Record Flag (PRF) assignments for a selected"
^DIC(19,13213,1,3,0)="patient.  Any Category I PRF assignment returned by the query that does"
^DIC(19,13213,1,4,0)="not exist at the local facility will automatically be added at the local"
^DIC(19,13213,1,5,0)="facility.  A List Manager user interface will display a list of all"
^DIC(19,13213,1,6,0)="Category I PRF assignments found at the queried treating facility.  The"
^DIC(19,13213,1,7,0)="following action is provided within the List Manager interface:"
^DIC(19,13213,1,8,0)="  - Display the query details for a selected assignment."
^DIC(19,13213,20)=""
^DIC(19,13213,25)="EN^DGPFHLUQ"
^DIC(19,13213,99.1)="60275,49582"
^DIC(19,13213,"U")="RECORD FLAG MANUAL QUERY"
^DIC(19,13214,0)="DGPF TRANSMISSION MGMT^Record Flag Transmission Mgmt^^M^1^DGPF TRANSMISSIONS^^^^^^114"
^DIC(19,13214,1,0)="^^2^2^3060124^"
^DIC(19,13214,1,1,0)="This option acts as a submenu containing options available to manage "
^DIC(19,13214,1,2,0)="patient record flags transmissions."
