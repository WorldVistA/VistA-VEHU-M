^DIC(19,16137,1,0)="^19.06^5^5^3240328^^"
^DIC(19,16137,1,1,0)="This menu contains options used to either export a Health"
^DIC(19,16137,1,2,0)="Summary Object to a Mailman message, or import an Health "
^DIC(19,16137,1,3,0)="Summary Object by reading the data unpacked from a Mainman"
^DIC(19,16137,1,4,0)="message using the Packman Utilities."
^DIC(19,16137,1,5,0)="Cloned from ""GMTS OBJ EXPORT/IMPORT"" option."
