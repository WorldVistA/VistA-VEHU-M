^DIC(19,3287,0)="A3FBPR^Print Batch Numbers/Dates^^R^.5^^^^^^^"
^DIC(19,3287,1,0)="^^2^2^2890412^"
^DIC(19,3287,1,1,0)="This option will print the 12 most current batch numbers with"
^DIC(19,3287,1,2,0)="their corresponding beginning and ending dates."
^DIC(19,3287,25)="A3FBPR"
^DIC(19,3287,"U")="PRINT BATCH NUMBERS/DATES"
^DIC(19,3288,0)="A3FBNO^Show VAMC/No Applicants for Batch^^R^.5^^^^^^^"
^DIC(19,3288,1,0)="^^2^2^2890413^"
^DIC(19,3288,1,1,0)="This option prints a list of stations that have not entered any"
^DIC(19,3288,1,2,0)="FSMB applicant names for a selected batch number."
^DIC(19,3288,25)="A3FBNO"
^DIC(19,3288,"U")="SHOW VAMC/NO APPLICANTS FOR BATCH"
^DIC(19,3289,0)="A3FBATCH^Batch Management^^M^.5^^^^^^^"
^DIC(19,3289,1,0)="^^1^1^2890413^"
^DIC(19,3289,1,1,0)="Menu containing options pertaining to batch management."
^DIC(19,3289,10,0)="^19.01PI^3^3"
^DIC(19,3289,10,1,0)="3285^^1"
^DIC(19,3289,10,2,0)="3287^^3"
