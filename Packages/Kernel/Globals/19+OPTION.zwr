^DIC(19,11984,0)="EASEC LTC COPAY TEST ADD^Add a New LTC Copayment Test^^A^10000000020^^^^^^^538^^1^1"
^DIC(19,11984,1,0)="^^4^4^3020306^"
^DIC(19,11984,1,1,0)="This option will add a new Long Term Care Copayment Test for a patient."
^DIC(19,11984,1,2,0)="The information entered will be from the Application for Extended"
^DIC(19,11984,1,3,0)="Care Services (VA Form 10-10EC). If all the required information is"
^DIC(19,11984,1,4,0)="entered, the test can be completed and the 10-10EC form can be printed."
^DIC(19,11984,15)="K DGMTYPT"
^DIC(19,11984,20)="S DGMTYPT=3 D EN^EASECA"
^DIC(19,11984,"U")="ADD A NEW LTC COPAYMENT TEST"
^DIC(19,11985,0)="EASEC LTC COPAY TEST EDIT^Edit an Existing LTC Copayment Test^^A^10000000020^^^^^^^538^y^1^1"
^DIC(19,11985,1,0)="^19.06^3^3^3020306^^"
^DIC(19,11985,1,1,0)="This option will enable the user to make changes to data in an existing"
^DIC(19,11985,1,2,0)="Long Term Care Copayment Test.  If all the required information is"
^DIC(19,11985,1,3,0)="entered, the test can be completed and the 10-10EC form can be printed."
^DIC(19,11985,15)="K DGMTYPT"
^DIC(19,11985,20)="S DGMTYPT=3 D EN^EASECE"
^DIC(19,11985,"U")="EDIT AN EXISTING LTC COPAYMENT"
^DIC(19,11986,0)="EASEC LTC COPAY TEST VIEW^View a LTC Copayment Test^^A^10000000020^^^^^^^^y^1^1"
^DIC(19,11986,1,0)="^19.06^3^3^3020306^^^"
^DIC(19,11986,1,1,0)="This option will display all of the screens containing the information for"
^DIC(19,11986,1,2,0)="a selected Long Term Care Copayment Test.  This option does not allow"
^DIC(19,11986,1,3,0)="editing."
^DIC(19,11986,15)="K DGMTYPT"
^DIC(19,11986,20)="S DGMTYPT=3 D EN^EASECV"
^DIC(19,11986,"U")="VIEW A LTC COPAYMENT TEST"
^DIC(19,11987,0)="EASEC LTC COPAY PRINT^Calculated LTC Copayments Print^^A^10000000020^^^^^^^^y^1^1"
^DIC(19,11987,1,0)="^19.06^2^2^3020306^^^"
^DIC(19,11987,1,1,0)="This option will enable the user to display or print the calculated Long"
^DIC(19,11987,1,2,0)="Term Care copayments for a selected veteran."
^DIC(19,11987,15)="K DGMTYPT"
^DIC(19,11987,20)="S DGMTYPT=3 D EN^EASECPC"
^DIC(19,11987,"U")="CALCULATED LTC COPAYMENTS PRIN"
