^DIC(19,9886,0)="PX PCE SITE PARAMETERS EDIT^PCE Site Parameters Edit^^E^10958^^^^^^n^507"
^DIC(19,9886,1,0)="^^5^5^2960728^^^"
^DIC(19,9886,1,1,0)="This option is used to edit fields in the PCE PARAMETERS file that impact"
^DIC(19,9886,1,2,0)="the PCE data capture and the PCE user interface processing."
^DIC(19,9886,1,3,0)=" "
^DIC(19,9886,1,4,0)="The parameters that are defined here alter the default view of encounters"
^DIC(19,9886,1,5,0)="that the user will see when the PCE Data Entry options are selected."
^DIC(19,9886,30)="PX(815,"
