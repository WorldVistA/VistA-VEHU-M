^DIC(19,7342,"U")="DATA EXPORT TO FOREIGN FORMAT"
^DIC(19,7343,0)="DIAX EXTRACT MENU^Extract Data To Fileman File^^M^1^DIEXTRACT^^^^^^^^^1^^"
^DIC(19,7343,1,0)="^^2^2^2921222^^^^"
^DIC(19,7343,1,1,0)=" "
^DIC(19,7343,1,2,0)="This is a menu of the tool for extracting data to Fileman file."
^DIC(19,7343,10,0)="^19.01PI^9^9"
^DIC(19,7343,10,1,0)="7344^^1"
^DIC(19,7343,10,2,0)="7345^^2"
^DIC(19,7343,10,3,0)="7346^^3"
^DIC(19,7343,10,4,0)="7347^^4"
^DIC(19,7343,10,5,0)="7348^^5"
^DIC(19,7343,10,6,0)="7349^^6"
^DIC(19,7343,10,7,0)="7350^^7"
^DIC(19,7343,10,8,0)="7351^^7"
^DIC(19,7343,10,9,0)="7352^^8"
^DIC(19,7343,10,"B",7344,1)=""
^DIC(19,7343,10,"B",7345,2)=""
^DIC(19,7343,10,"B",7346,3)=""
^DIC(19,7343,10,"B",7347,4)=""
^DIC(19,7343,10,"B",7348,5)=""
^DIC(19,7343,10,"B",7349,6)=""
^DIC(19,7343,10,"B",7350,7)=""
^DIC(19,7343,10,"B",7351,8)=""
^DIC(19,7343,10,"B",7352,9)=""
^DIC(19,7343,15)="K DIAX"
^DIC(19,7343,99)="64176,46884"
^DIC(19,7343,"U")="EXTRACT DATA TO FILEMAN FILE"
^DIC(19,7344,0)="DIAX SELECT^Select Entries to Extract^^A^1^DIEXTRACT^^^^^^^^1^^^"
^DIC(19,7344,1,0)="^^5^5^2921222^"
^DIC(19,7344,1,1,0)=" "
^DIC(19,7344,1,2,0)="Use this option to specify the criteria that would select Fileman entries"
^DIC(19,7344,1,3,0)="to extract.  This is the first step in developing an extract activity and"
^DIC(19,7344,1,4,0)="is important since there cannot be any extract process without the search"
^DIC(19,7344,1,5,0)="template created in this option."
^DIC(19,7344,20)="S DI=1 D EN^DIAX"
^DIC(19,7344,"U")="SELECT ENTRIES TO EXTRACT"
^DIC(19,7345,0)="DIAX ADD/DELETE^Add/Delete Selected Entries^^A^1^DIEXTRACT^^^^^^^^1^^^"
^DIC(19,7345,1,0)="^^3^3^2921222^"
^DIC(19,7345,1,1,0)=" "
^DIC(19,7345,1,2,0)="Use this option to edit the list of selected entries to extract by adding"
^DIC(19,7345,1,3,0)="needed entries or by deleting undesired ones."
^DIC(19,7345,20)="S DI=2 D EN^DIAX"
^DIC(19,7345,"U")="ADD/DELETE SELECTED ENTRIES"
^DIC(19,7346,0)="DIAX PRINT^Print Selected Entries^^A^1^DIEXTRACT^^^^^^^^1^^^"
^DIC(19,7346,1,0)="^^3^3^2921222^"
^DIC(19,7346,1,1,0)=" "
^DIC(19,7346,1,2,0)="Use this option to display the list of entries selected for extract.  This"
^DIC(19,7346,1,3,0)="option uses the standard VA Fileman interface for printing."
^DIC(19,7346,20)="S DI=3 D EN^DIAX"
^DIC(19,7346,"U")="PRINT SELECTED ENTRIES"
^DIC(19,7347,0)="DIAX MODIFY^Modify Destination File^^A^1^DIEXTRACT^^^^^^^^1^^^"
^DIC(19,7347,1,0)="^^3^3^2921222^"
^DIC(19,7347,1,1,0)=" "
^DIC(19,7347,1,2,0)="Use this option to create a destination file that will hold the data"
^DIC(19,7347,1,3,0)="extracted from the source entries."
^DIC(19,7347,20)="S DI=4 D EN^DIAX"
^DIC(19,7347,"U")="MODIFY DESTINATION FILE"
^DIC(19,7348,0)="DIAX CREATE^Create Extract Template^^A^1^DIEXTRACT^^^^^^^^1^^^"
^DIC(19,7348,1,0)="^^4^4^2930104^"
^DIC(19,7348,1,1,0)=" "
^DIC(19,7348,1,2,0)="Use this option to identify the fields to be extracted from the source"
^DIC(19,7348,1,3,0)="file and the fields in the destination file where the extracted data will"
^DIC(19,7348,1,4,0)="be stored."
^DIC(19,7348,20)="S DI=5 D EN^DIAX"
^DIC(19,7348,"U")="CREATE EXTRACT TEMPLATE"
^DIC(19,7349,0)="DIAX UPDATE^Update Destination File^^A^1^DIEXTRACT^^^^^^^^1^^^"
^DIC(19,7349,1,0)="^^3^3^2921222^"
^DIC(19,7349,1,1,0)=" "
^DIC(19,7349,1,2,0)="Use this option to extract data from the source file and move it to the"
^DIC(19,7349,1,3,0)="destination file."
^DIC(19,7349,20)="S DI=6 D EN^DIAX"
^DIC(19,7349,"U")="UPDATE DESTINATION FILE"
^DIC(19,7350,0)="DIAX PURGE^Purge Extracted Entries^^A^1^DIEXTRACT^^^^^^^^1^^^"
