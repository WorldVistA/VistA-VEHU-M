^DIC(19,5142,0)="XU OPTION START^One-time Option Start (Internal Use Only)^^A^10000000020^^^^^^^^y^1^^"
^DIC(19,5142,1,0)="^^5^5^2900413^^^^"
^DIC(19,5142,1,0,"LE")=1
^DIC(19,5142,1,1,0)="This option works with XU OPTION QUEUE (One-time Option Queue) to allow"
^DIC(19,5142,1,2,0)="site managers to schedule an option that usually runs on a cycle without"
^DIC(19,5142,1,3,0)="disrupting that cycle.  This option should NOT be used directly, either"
^DIC(19,5142,1,4,0)="from a menu or through ZTMSCHEDULE (Schedule/Unschedule Options); it is"
^DIC(19,5142,1,5,0)="used internally by XU OPTION QUEUE to make that option work correctly."
^DIC(19,5142,2)="n"
^DIC(19,5142,20)="N XQY,XQY0 S XQY0=$G(^DIC(19,XUXQM,0)),XQT=$P(XQY0,U,4) I $L(XQT),""APR""[XQT S XQY=XUXQM D ZTSK2^XQ1 Q"
^DIC(19,5142,"U")="ONE-TIME OPTION START (INTERNA"
