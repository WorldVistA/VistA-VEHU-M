^DIC(19,7074,"U")="MEDICATION COPAY INCOME EXEMPT"
^DIC(19,7075,0)="IB RX HARDSHIP^Manually Change Copay Exemption (Hardships)^^R^.5^^^^^^^"
^DIC(19,7075,1,0)="^^7^7^2930419^^"
^DIC(19,7075,1,1,0)="This option can be used to give a hardship waiver from the Medication"
^DIC(19,7075,1,2,0)="Copayment.  If a hardship is granted it will be good for one year from"
^DIC(19,7075,1,3,0)="the date of the hardship. "
^DIC(19,7075,1,4,0)=" "
^DIC(19,7075,1,5,0)="This option can also be used to update a single patient's exemption to"
^DIC(19,7075,1,6,0)="the correct status as computed from his patient record, if the current"
^DIC(19,7075,1,7,0)="exemption does not match what is computed."
^DIC(19,7075,25)="IBARXEX"
^DIC(19,7075,"U")="MANUALLY CHANGE COPAY EXEMPTIO"
^DIC(19,7076,0)="IB RX INQUIRE^Inquire to Medication Copay Income Exemptions^^R^.5^^^^^^^192"
^DIC(19,7076,1,0)="^^2^2^2930122^"
^DIC(19,7076,1,1,0)="This option will allow a brief inquiry to active exemptions or a full"
^DIC(19,7076,1,2,0)="inquiry to the history of all exemptions for a patient."
^DIC(19,7076,25)="IBARXEI"
^DIC(19,7076,"U")="INQUIRE TO MEDICATION COPAY IN"
^DIC(19,7077,0)="IB RX ADD THRESHOLDS^Add Income Thresholds^^R^.5^^^^^^^192"
^DIC(19,7077,1,0)="^^2^2^2930120^"
^DIC(19,7077,1,1,0)="This option is used to add the Income Thresholds used in the Medication"
^DIC(19,7077,1,2,0)="Copayment Income Exemption."
^DIC(19,7077,25)="ADD^IBARXET"
^DIC(19,7077,"U")="ADD INCOME THRESHOLDS"
^DIC(19,7078,0)="IB RX PRINT THRESHOLDS^List Income Thresholds^^R^.5^^^^^^^192"
^DIC(19,7078,1,0)="^^3^3^2930120^"
^DIC(19,7078,1,1,0)="This option will print a listing of the Income Thresholds used in"
^DIC(19,7078,1,2,0)="the Medication Copayment Income Exemption process.  The output"
^DIC(19,7078,1,3,0)="is sorted by type of Threshold and Effective Date.  "
^DIC(19,7078,25)="PRINT^IBARXET"
^DIC(19,7078,"U")="LIST INCOME THRESHOLDS"
^DIC(19,7079,0)="IB RX PRINT PAT. EXEMP.^Print Patient Exemptions or summary^^R^.5^^^^^^^192"
^DIC(19,7079,1,0)="^^5^5^2930323^^^^"
^DIC(19,7079,1,1,0)="This option can print a list of patients by exemption status"
^DIC(19,7079,1,2,0)="or exemption reason.  This will enable a facility to print a list "
^DIC(19,7079,1,3,0)="of patients who are either exempt or non-exempt.  Optionally the "
^DIC(19,7079,1,4,0)="report can print only sub totals without printing the detailed "
^DIC(19,7079,1,5,0)="patient listing."
^DIC(19,7079,25)="IBARXEP"
^DIC(19,7079,"U")="PRINT PATIENT EXEMPTIONS OR SU"
^DIC(19,7080,0)="IB RX PRINT RETRO CHARGES^Print Charges Canceled Due to Income Exemption^^R^.5^^^^^^^301"
^DIC(19,7080,1,0)="^^5^5^2930304^^"
^DIC(19,7080,1,1,0)="This report will print a list of patients and Medication Copayment"
^DIC(19,7080,1,2,0)="charges that have been canceled due to the income exclusion.  Initially"
^DIC(19,7080,1,3,0)="this report will print a list of charges canceled during the installation/"
^DIC(19,7080,1,4,0)="conversion process.  The software may cancel other charges after"
^DIC(19,7080,1,5,0)="installation and this report can be used to list those charges."
^DIC(19,7080,25)="IBARXEC1"
^DIC(19,7080,"U")="PRINT CHARGES CANCELED DUE TO "
^DIC(19,7081,0)="IB RX PRINT VERIFY EXEMP^Print/Verify Patient Exemption Status^^R^.5^^^^^^^192"
^DIC(19,7081,1,0)="^^10^10^2940207^^^^"
^DIC(19,7081,1,1,0)="This option can be used to search through the BILLING EXEMPTIONS file"
^DIC(19,7081,1,2,0)="and compare the currently stored active exemption for each patient"
^DIC(19,7081,1,3,0)="against what it calculates to be the correct exemption status for"
^DIC(19,7081,1,4,0)="the patient based on current data in the MAS files.  This report can"
^DIC(19,7081,1,5,0)="be run to just print a list of discrepancies or it can be run "
^DIC(19,7081,1,6,0)="to automatically update each incorrect exemption status."
^DIC(19,7081,1,7,0)=" "
^DIC(19,7081,1,8,0)="Initially the report should be run without updating the exemptions.  The"
^DIC(19,7081,1,9,0)="option Manually Change Copay Exemptions (Hardship) can be used to update"
^DIC(19,7081,1,10,0)="exemptions to the correct status one patient at a time if desired."
^DIC(19,7081,25)="IBARXEPV"
^DIC(19,7081,"U")="PRINT/VERIFY PATIENT EXEMPTION"
^DIC(19,7082,0)="IB RX EDIT LETTER^Edit Copay Exemption Letter^^R^.5^^^^^^^192"
^DIC(19,7082,1,0)="^^12^12^2930429^"
^DIC(19,7082,1,1,0)="This option will allow editing of the header, or station name and address,"
^DIC(19,7082,1,2,0)="and the main body of a letter.  The letter IB NOW EXEMPT is the letter"
^DIC(19,7082,1,3,0)="that was written to be sent to patients who become exempt during the"
^DIC(19,7082,1,4,0)="conversion to inform them that they no longer need to send in a "
^DIC(19,7082,1,5,0)="copayment with their Rx refill requests."
^DIC(19,7082,1,6,0)=" "
^DIC(19,7082,1,7,0)="The first six lines of the header field will be centered at the top"
^DIC(19,7082,1,8,0)="of each letter.  Do not center these lines.  The patient address will"
^DIC(19,7082,1,9,0)="print beginning on line 17.  The main body will print after the patient"
^DIC(19,7082,1,10,0)="address section.  Do not include functions in either word processing"
^DIC(19,7082,1,11,0)="field as VA FileMan utilities are not used at this time to output"
^DIC(19,7082,1,12,0)="the letters."
^DIC(19,7082,25)="IBARXEPE"
^DIC(19,7082,"U")="EDIT COPAY EXEMPTION LETTER"
^DIC(19,7083,0)="IB RX PRINT EX LETERS^Letters to Exempt Patients^^R^.5^^^^^^^192"
^DIC(19,7083,1,0)="^^9^9^2930429^"
^DIC(19,7083,1,1,0)="This option will print the form letter IB NOW EXEMPT for all currently"
^DIC(19,7083,1,2,0)="exempt patients.  The following patients will not be included:"
^DIC(19,7083,1,3,0)="   Deceased Patients"
^DIC(19,7083,1,4,0)="   Non-Veterans"
^DIC(19,7083,1,5,0)="   Patients who are rated SC greater than 50%"
^DIC(19,7083,1,6,0)="The user will be allowed to sort by Exemption Status Date, and by"
^DIC(19,7083,1,7,0)="Patient name.  Optionally, the user can store the results of the"
^DIC(19,7083,1,8,0)="search in a template named IB EXEMPTION LIST for local printing purposes."
^DIC(19,7083,1,9,0)=" "
^DIC(19,7083,25)="IBARXEPL"
^DIC(19,7083,99)="55696,55250"
^DIC(19,7083,"U")="LETTERS TO EXEMPT PATIENTS"
^DIC(19,7084,0)="A1BF START RTM^START RTM (THIS NODE)^^R^877^^^^^^^281"
^DIC(19,7084,1,0)="^^1^1^2930630^^"
^DIC(19,7084,1,1,0)="Starts up RTM on this node.  Runs A1BFJOBR."
^DIC(19,7084,25)="EN^A1BFJOBR"
^DIC(19,7084,"U")="START RTM (THIS NODE)"
^DIC(19,7085,0)="A1BF RT HISTORY REPORT^RT HISTORY REPORT^^R^877^^^^^^^281"
^DIC(19,7085,1,0)="^^2^2^2930624^"
^DIC(19,7085,1,1,0)="Produces 132 column output.  Uses A1BF RESPONSE TIME file to track"
^DIC(19,7085,1,2,0)="response times, number of users for selected time range."
^DIC(19,7085,25)="EN^A1BFTRR1"
^DIC(19,7085,"U")="RT HISTORY REPORT"
^DIC(19,7086,0)="A1BF RTM MENU^RESPONSE TIME MANAGEMENT^^M^877^^^^^^^281"
^DIC(19,7086,1,0)="^^1^1^2930628^"
^DIC(19,7086,1,1,0)="Menu for use/management of Class III Response Time package."
^DIC(19,7086,10,0)="^19.01IP^2^2"
^DIC(19,7086,10,1,0)="7085^^3"
^DIC(19,7086,10,2,0)="7084^^1"
