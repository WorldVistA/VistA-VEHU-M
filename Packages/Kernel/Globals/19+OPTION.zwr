^DIC(19,13891,0)="MAG REASON EDIT^Enter/edit Reason^^E^10000000049^^^^^^^530^^1^1"
^DIC(19,13891,1,0)="^19.06^2^2^3090204^^^^"
^DIC(19,13891,1,1,0)="This option allows adding/editing of reasons for actions performed on"
^DIC(19,13891,1,2,0)="images (copying, printing, etc.) stored in the MAG REASON file."
^DIC(19,13891,15)="K DIDEL,DLAYGO"
^DIC(19,13891,20)="S (DIDEL,DLAYGO)=2005.88"
^DIC(19,13891,30)="MAG(2005.88,"
^DIC(19,13891,31)="AELMNQ"
^DIC(19,13891,50)="MAG(2005.88,"
^DIC(19,13891,51)="[MAG REASON EDIT]"
^DIC(19,13891,"U")="ENTER/EDIT REASON"
^DIC(19,13892,0)="MAG CLIENT VERSION REPORT^Imaging Clients Version Report^^R^10000000216^^^^^^^530"
^DIC(19,13892,1,0)="^19.06^19^19^3100428^^^^"
^DIC(19,13892,1,1,0)=" This option prints a list of workstations that need updated to be able to"
^DIC(19,13892,1,2,0)=" run."
^DIC(19,13892,1,3,0)=" When the new version of VistA server code is released, those"
^DIC(19,13892,1,4,0)=" clients will not be supported and the Client Application will be aborted"
^DIC(19,13892,1,5,0)=" when logon is attempted."
^DIC(19,13892,1,6,0)=" Note: While the new version of VistA Server code is in Alpha/Beta mode, "
^DIC(19,13892,1,7,0)="           those clients will still be allowed to connect."
^DIC(19,13892,1,8,0)=" "
^DIC(19,13892,1,9,0)=" The User can choose "
^DIC(19,13892,1,10,0)="  - to search for workstations that have logged on within a selected"
^DIC(19,13892,1,11,0)="    number of days."
^DIC(19,13892,1,12,0)=" "
^DIC(19,13892,1,13,0)="  - to search only workstations where the workstation name contains selected "
^DIC(19,13892,1,14,0)="    text.  This can be left blank, and all workstations are included."
^DIC(19,13892,1,15,0)=" "
^DIC(19,13892,1,16,0)="  - to list all workstations or only the workstations that need updated."
^DIC(19,13892,1,17,0)="    If a workstation is listed and does not need updated, an '*' is displayed."
^DIC(19,13892,1,18,0)=" "
^DIC(19,13892,1,19,0)="  - to sort the listing by Client (Display,Capture,etc) or Workstation Name."
^DIC(19,13892,25)="WSCVCROP^MAGGTU4"
^DIC(19,13892,"U")="IMAGING CLIENTS VERSION REPORT"
^DIC(19,13893,0)="PSS IV ADDITIVE REPORT^IV Additive Report^^R^10000000020^^^^^^^517"
^DIC(19,13893,1,0)="^^4^4^3090715^"
^DIC(19,13893,1,1,0)="This report will display entries from the IV ADDITIVES (#52.6) File. The "
^DIC(19,13893,1,2,0)="display selection choices will be for all IV Additives, only IV Additives "
^DIC(19,13893,1,3,0)="whose ADDITIVE FREQUENCY (#18 ) Field is set to '1 BAG/DAY', or only those"
^DIC(19,13893,1,4,0)="IV Additives whose ADDITIVE FREQUENCY (#18) Field is null."
^DIC(19,13893,25)="REP^PSSADRPT"
^DIC(19,13893,"U")="IV ADDITIVE REPORT"
^DIC(19,13895,0)="PSN VISTALINK CONTEXT^NDF Remote Procedure Calls Context^^B^1^^^^^^^"
^DIC(19,13895,1,0)="^^3^3^3100125^"
^DIC(19,13895,1,1,0)="This option is used by NDF as a Vistalink Context, which enables Kernel tp"
^DIC(19,13895,1,2,0)="give access to the RPCs used by GUI application to access NDF (e.g. FDA"
^DIC(19,13895,1,3,0)="Medication Guide Java Client)."
