^DIC(19,13840,1,0)="^^6^6^3080109^"
^DIC(19,13840,1,1,0)="This option is the HBPC Delimited Text File Output Menu for MFH.  The "
^DIC(19,13840,1,2,0)="data produced is suitable for spreadsheet import.  The data is delimited "
^DIC(19,13840,1,3,0)="by the ""^"" character.  The option includes:"
^DIC(19,13840,1,4,0)=" "
^DIC(19,13840,1,5,0)="   Inspection/Training Delimited Text File Output [HBHCTXT2]"
^DIC(19,13840,1,6,0)="   Rate Paid Delimited Text File Output [HBHCTXT]"
