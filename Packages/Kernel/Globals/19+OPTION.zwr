^DIC(19,16940,1,0)="^19.06^3^3^3240328^^^^"
^DIC(19,16940,1,1,0)="This option lists, by user, each file the user has access to and what"
^DIC(19,16940,1,2,0)="that access is.  Users who have no access are not listed."
