^DIC(19,9862,0)="PXTT TABLE MAINTENANCE^PCE Table Maintenance^^M^1^^^^^^^507^^^1"
^DIC(19,9862,1,0)="^19.06^9^9^3180518^^^^"
^DIC(19,9862,1,1,0)="The options on this menu are used to manage the clinical terminology"
^DIC(19,9862,1,2,0)="defined in PCE. There are management systems for Education Topics,"
^DIC(19,9862,1,3,0)="Exams, and Health Factors. Immunizations and Skin Tests are standardized"
^DIC(19,9862,1,4,0)="nationally and cannot be edited by sites. National Education Topics,"
^DIC(19,9862,1,5,0)="Exams, and Health Factors cannot be edited by sites."
^DIC(19,9862,1,6,0)="  "
^DIC(19,9862,1,7,0)="The PCE Information Only menu options can be used to list the defined"
