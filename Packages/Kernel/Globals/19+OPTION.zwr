^DIC(19,9379,1,0)="^19.06^7^7^3000608^^^^"
^DIC(19,9379,1,1,0)="This option will allow items to be added, deleted, or changed within"
^DIC(19,9379,1,2,0)="the inventory point.  This is the main option for keeping the inventory"
^DIC(19,9379,1,3,0)="items up to date."
^DIC(19,9379,1,4,0)=" "
^DIC(19,9379,1,5,0)="When using this option, an item may be selected up-front followed"
^DIC(19,9379,1,6,0)="by the field types to edit, or, the field types to edit may be"
^DIC(19,9379,1,7,0)="selected first followed by the inventory items to edit."
