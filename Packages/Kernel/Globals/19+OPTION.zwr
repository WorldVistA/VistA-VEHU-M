^DIC(19,7935,"U")="ENVIR. DIFF./VCS SALES"
^DIC(19,7936,0)="PRSA TPD PP^Display Employee Pay Period^^R^.5^^^^^^^"
^DIC(19,7936,1,0)="^^4^4^2930202^^^"
^DIC(19,7936,1,1,0)="This option allows the user to select an employee and a posting"
^DIC(19,7936,1,2,0)="date. The employee's scheduled Tour of Duty and any Tour of Duty"
^DIC(19,7936,1,3,0)="exceptions for the pay period for which the posting date belongs"
^DIC(19,7936,1,4,0)="are displayed."
^DIC(19,7936,25)="TK^PRSADP2"
^DIC(19,7936,"U")="DISPLAY EMPLOYEE PAY PERIOD"
^DIC(19,7937,0)="PRSA PR^Return Record to Timekeeper^^R^11596^^^^^^^"
^DIC(19,7937,1,0)="^^2^2^2930202^^"
^DIC(19,7937,1,1,0)="This option allows Payroll to return a time card to the Timekeeper"
^DIC(19,7937,1,2,0)="for correction and re-certification."
^DIC(19,7937,25)="PRSAPRT"
^DIC(19,7937,"U")="RETURN RECORD TO TIMEKEEPER"
^DIC(19,7938,0)="PRSA TP DAY LIST^Daily T&L List^^R^.5^^^^^^^"
^DIC(19,7938,1,0)="^^4^4^2930202^^^"
^DIC(19,7938,1,1,0)="The user is prompted to select an existing Time and Leave Unit (T&L)"
^DIC(19,7938,1,2,0)="and a posting date. The names of the employees in the T&L, their"
^DIC(19,7938,1,3,0)="scheduled Tour of Duty and any exceptions to the scheduled Tour of"
^DIC(19,7938,1,4,0)="Duty are displayed."
^DIC(19,7938,25)="TK^PRSATPL"
^DIC(19,7938,"U")="DAILY T&L LIST"
^DIC(19,7939,0)="PRSA PP EMP^Create Employee Record for Pay Period^^R^11596^^^^^^^"
^DIC(19,7939,1,0)="^^3^3^2930810^^^^"
^DIC(19,7939,1,1,0)="This option will allow Payroll to create a time card entry for an"
^DIC(19,7939,1,2,0)="employee in the TIME AND ATTENDANCE RECORDS file (#458). The employee"
^DIC(19,7939,1,3,0)="must exist as an entry in the PAID EMPLOYEE file (#450)."
^DIC(19,7939,25)="PRSAPRE"
^DIC(19,7939,"U")="CREATE EMPLOYEE RECORD FOR PAY"
^DIC(19,7940,0)="PRSA PE DISP^Display Employee Pay Period^^R^11596^^^^^^^"
^DIC(19,7940,1,0)="^^3^3^2930826^^^"
^DIC(19,7940,1,1,0)="Displays the employee's name, all fourteen dates in the pay period,"
^DIC(19,7940,1,2,0)="the employee's scheduled tour(s) and any exceptions to the scheduled"
^DIC(19,7940,1,3,0)="tour(s)."
^DIC(19,7940,25)="PAY^PRSADP2"
^DIC(19,7940,"U")="DISPLAY EMPLOYEE PAY PERIOD"
^DIC(19,7941,0)="PRSA LV BAL-EMP^Leave Balances^^R^.5^^^^^^^"
^DIC(19,7941,1,0)="^^1^1^2951206^^^^"
^DIC(19,7941,1,1,0)="Displays a list of the leave balances an employee has."
^DIC(19,7941,25)="EMP^PRSALVB"
^DIC(19,7941,"U")="LEAVE BALANCES"
^DIC(19,7942,0)="PRSA LV BAL-SUP^Employee Leave Balances^^R^.5^^^^^^^"
^DIC(19,7942,1,0)="^^3^3^2930202^^^^"
^DIC(19,7942,1,1,0)="This option allows a user to view all leave balances for an employee"
^DIC(19,7942,1,2,0)="he/she supervises. Leave fields that have no value (i.e., null) are"
^DIC(19,7942,1,3,0)="not listed."
^DIC(19,7942,25)="SUP^PRSALVB"
^DIC(19,7942,"U")="EMPLOYEE LEAVE BALANCES"
