^DIC(19,12609,1,2,0)="Project collection routines to begin an orderly shut-down process.  Each"
^DIC(19,12609,1,3,0)="collection routine will then stop after reaching an appropriate"
^DIC(19,12609,1,4,0)="'break-point'."
^DIC(19,12609,25)="STOP^KMPSUTL"
^DIC(19,12609,"U")="STOP SAGG COLLECTION"
