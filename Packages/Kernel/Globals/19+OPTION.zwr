^DIC(19,12989,0)="XWB DEBUG EDIT^Debug Parameter Edit^^R^10000000020^^^^^^^^y"
^DIC(19,12989,1,0)="^^1^1^3031008^"
^DIC(19,12989,1,1,0)="This option allows the editing of the BROKER debug parameter."
^DIC(19,12989,25)="DEBUG^XWBTCP"
^DIC(19,12989,"U")="DEBUG PARAMETER EDIT"
^DIC(19,12990,0)="XWB LOG VIEW^View XWB Log^^R^10000000020^^^^^^^501^y"
^DIC(19,12990,1,0)="^^2^2^3040413^"
^DIC(19,12990,1,1,0)="This option allow the user to view the debug log files that the Broker "
^DIC(19,12990,1,2,0)="can set.  The parameter XWBDEBUG must be set for log files to be recorded."
^DIC(19,12990,25)="VIEW^XWBDLOG"
^DIC(19,12990,"U")="VIEW XWB LOG"
^DIC(19,12991,0)="XWB LOG CLEAR^Clear XWB Log Files^^R^10000000020^^^^^^^501^y"
^DIC(19,12991,1,0)="^^1^1^3040413^"
^DIC(19,12991,1,1,0)="This option allows the user to clear (KILL) the XWB log files."
^DIC(19,12991,25)="KILLALL^XWBDLOG"
^DIC(19,12991,"U")="CLEAR XWB LOG FILES"
^DIC(19,12992,0)="ORE ORDERABLE ITEMS VALIDATION^Orderable Items Records Validation^^R^10000000020^^^^^^^170"
^DIC(19,12992,1,0)="^^21^21^3040413^"
^DIC(19,12992,1,1,0)="A utility to scan the Orderable Items file and confirm the records in "
^DIC(19,12992,1,2,0)="this file have matching source file records. The source files checked for "
^DIC(19,12992,1,3,0)="are documented in the OE/RR Version 3 Package Interface Specifications "
^DIC(19,12992,1,4,0)="July, 2001 document. This utility creates a report documenting the "
^DIC(19,12992,1,5,0)="following:"
^DIC(19,12992,1,6,0)="        1. Orderable Item records without a source IEN stored in the ID "
^DIC(19,12992,1,7,0)="           field."
^DIC(19,12992,1,8,0)="        2. Orderable Item records without a source Package code stored "
^DIC(19,12992,1,9,0)="           in the ID field."
^DIC(19,12992,1,10,0)="        3. Orderable Item records with an improperly formatted source"
^DIC(19,12992,1,11,0)="           Package code in the ID field."
^DIC(19,12992,1,12,0)="        4. Gives a summary of valid records by package."
^DIC(19,12992,1,13,0)="        5. Gives a detail of records without matching source records "
^DIC(19,12992,1,14,0)="           sorted by:"
^DIC(19,12992,1,15,0)="                5.1 Currently active records, will be flagged as "
^DIC(19,12992,1,16,0)="                    inactive, and subsorted by package."
^DIC(19,12992,1,17,0)="                5.2 Currently inactive records and subsorted by package."
^DIC(19,12992,1,18,0)="        6. A list of records with properly created ID field, but the "
^DIC(19,12992,1,19,0)="           package code is not on the package list in the Package "
^DIC(19,12992,1,20,0)="           Interface Specifications of July 2001. These will be listed as "
^DIC(19,12992,1,21,0)="           needing manual confirmation."
^DIC(19,12992,25)="OREORV"
^DIC(19,12992,"U")="ORDERABLE ITEMS RECORDS VALIDA"
^DIC(19,12994,0)="PSJU ECG^Clinic Groups^^R^10000000020^^^^^^^197"
^DIC(19,12994,1,0)="^^4^4^3040415^"
^DIC(19,12994,1,1,0)="For Inpatient Medication Orders for Outpatients, Clinic Groups allos the "
^DIC(19,12994,1,2,0)="user to sort these meds by groups of clinics. This option allows the user "
^DIC(19,12994,1,3,0)="to define clinic groupd to allow easier sorting for processing in "
^DIC(19,12994,1,4,0)="Non-Verified Pending items and certain reports."
^DIC(19,12994,25)="ENCG^PSGFILED"
^DIC(19,12994,"U")="CLINIC GROUPS"
^DIC(19,12995,0)="OR BDC MENU^Clinical Indicator Data Capture Configuration^^M^10000000020^^^^^^^170"
^DIC(19,12995,1,0)="^^6^6^3040316^"
^DIC(19,12995,1,1,0)="This is the menu to start the Clinical Indicator Data Capture"
^DIC(19,12995,1,2,0)="Configuration options. The first option will start the program to set the"
^DIC(19,12995,1,3,0)="CIDC Master Switch.  This will turn the clinical indicator data capture on"
^DIC(19,12995,1,4,0)="or off for the entire facility. The second option will start the program"
^DIC(19,12995,1,5,0)="to allow for the  turning on and off of the clinical indicator data"
^DIC(19,12995,1,6,0)="capture by individual providers."
^DIC(19,12995,10,0)="^19.01IP^2^2"
^DIC(19,12995,10,1,0)="12996^MS^10"
^DIC(19,12995,10,2,0)="12997^PP^20"
^DIC(19,12995,10,"B",12996,1)=""
^DIC(19,12995,10,"B",12997,2)=""
^DIC(19,12995,10,"C","MS",1)=""
^DIC(19,12995,10,"C","PP",2)=""
^DIC(19,12995,99)="59931,57033"
^DIC(19,12995,"U")="CLINICAL INDICATOR DATA CAPTUR"
^DIC(19,12996,0)="OR BDC MASTER SWITCH^Clinical Indicator Data Capture Master Switch^^R^10000000020^^^^^^^170^^"
^DIC(19,12996,1,0)="^19.06^2^2^3040423^^"
^DIC(19,12996,1,1,0)="This option runs the program to turn the Clinical Indicator Data Capture"
^DIC(19,12996,1,2,0)="Master Switch on and off for the entire facility."
^DIC(19,12996,20)=""
^DIC(19,12996,25)="BAMSTR^ORWDBA5"
^DIC(19,12996,"U")="CLINICAL INDICATOR DATA CAPTUR"
^DIC(19,12997,0)="OR BDC PROVIDER SWITCH^CIDC By Provider Parameter^^R^10000000020^^^^^^^170^^"
^DIC(19,12997,1,0)="^19.06^12^12^3040316^^"
^DIC(19,12997,1,1,0)="This program is used the manage the Clinical Indicator Data Capture"
^DIC(19,12997,1,2,0)="parameter (CIDC). This parameter controls the display of the CIDC options"
^DIC(19,12997,1,3,0)="in CPRS GUI. Once the parameter has been assigned to a provider its value"
^DIC(19,12997,1,4,0)="can be set to enabled. This switches on the capture of the clinical "
^DIC(19,12997,1,5,0)="indicator data. The parameter can be set to disabled. This switches off"
^DIC(19,12997,1,6,0)="the capture of the clinical indicator data."
^DIC(19,12997,1,7,0)=" "
^DIC(19,12997,1,8,0)="The user is presented with the following options:"
^DIC(19,12997,1,9,0)="Assign parameter to provider"
^DIC(19,12997,1,10,0)="Edit provider's assigned parameter"
^DIC(19,12997,1,11,0)="Delete provider's assigned parameter"
^DIC(19,12997,1,12,0)="List providers with the assigned parameter"
^DIC(19,12997,20)=""
^DIC(19,12997,25)="ORWDBA6"
^DIC(19,12997,99.1)="59773,53488"
^DIC(19,12997,"U")="CIDC BY PROVIDER PARAMETER"
^DIC(19,12998,0)="XIP SYNCHRONIZE COUNTY^Queuable Synchronize County Multiple With 5.13^^A^10000000020^^^^^^^163^^1"
^DIC(19,12998,1,0)="^^6^6^3031020^"
^DIC(19,12998,1,1,0)="This menu option will synchronize the master COUNTY CODE(#5.13) file and"
^DIC(19,12998,1,2,0)="the STATE(#5) file's COUNTY multiple."
^DIC(19,12998,1,3,0)=" "
^DIC(19,12998,1,4,0)="No output device is needed.  It is recommended that this option have a "
^DIC(19,12998,1,5,0)="scheduling frequency of every 3 months, at a time when little to no"
^DIC(19,12998,1,6,0)="patient registration activity will be taking place."
^DIC(19,12998,20)="D DEQUE^XIPSYNC"
^DIC(19,12998,200.9)="y"
^DIC(19,12998,"U")="QUEUABLE SYNCHRONIZE COUNTY MU"
^DIC(19,12999,0)="IBCNE IIV INACTIVE POLICY RPT^eIV Inactive Policy Report^^R^1^^^^^^^192"
