^DIC(19,7012,99)="55441,53302"
^DIC(19,7012,"U")="CREATE VITAL MEASUREMENT QUICK"
^DIC(19,7018,0)="PSJ UEUP^Edit Inpatient User Parameters^^R^11712^^^^^^^197"
^DIC(19,7018,1,0)="^^1^1^2991101^^^"
^DIC(19,7018,1,1,0)="  Allows users to edit various Inpatient User parameters."
^DIC(19,7018,25)="ENUUEP^PSGFILD0"
^DIC(19,7018,"U")="EDIT INPATIENT USER PARAMETERS"
^DIC(19,7019,0)="PSJ SEUP^Inpatient User Parameters Edit^^R^11712^^^^^^^197"
^DIC(19,7019,1,0)="^^2^2^2911202^^"
^DIC(19,7019,1,1,0)="  Allows the supervisor to edit the various Inpatient User parameters not"
^DIC(19,7019,1,2,0)="editable by the users."
^DIC(19,7019,25)="ENSUEP^PSGFILD0"
^DIC(19,7019,"U")="INPATIENT USER PARAMETERS EDIT"
^DIC(19,7020,0)="PSJ IWP EDIT^Inpatient Ward Parameters Edit^^R^11712^^^^^^^197"
^DIC(19,7020,1,0)="^^3^3^2920630^^"
^DIC(19,7020,1,1,0)="  Allows user to edit the Inpatient Ward Parameters.  These parameters"
^DIC(19,7020,1,2,0)="determine how the Inpatient Medications package will react for users acting"
^DIC(19,7020,1,3,0)="on patients who reside on the corresponding wards."
^DIC(19,7020,25)="ENIWPE^PSGFILD0"
^DIC(19,7020,"U")="INPATIENT WARD PARAMETERS EDIT"
^DIC(19,7022,0)="PSJ AC SET-UP^AUto-Discontinue Set-Up^^R^11712^^^^^^^197^^^1"
^DIC(19,7022,1,0)="^^4^4^2920709^^^^"
^DIC(19,7022,1,1,0)="  This allows the site to determine if patients' Inpatient Medications (IV"
^DIC(19,7022,1,2,0)="and Unit Dose) orders are d/c'd when the patient is transferred between"
^DIC(19,7022,1,3,0)="wards, between services, or to authorized absence.  This determination can"
^DIC(19,7022,1,4,0)="be made on a ward-by-ward and/or service-by-service basis."
^DIC(19,7022,15)="K C,I,I1,DIC,DLAYGO"
^DIC(19,7022,25)="ENOAOPT^PSGFILD0"
^DIC(19,7022,"U")="AUTO-DISCONTINUE SET-UP"
^DIC(19,7025,0)="PSJ SYS EDIT^Systems Parameters Edit^^R^10000000020^^^^^^^197"
^DIC(19,7025,1,0)="^^2^2^2931216^^"
^DIC(19,7025,1,1,0)="  This allows the user (supervisor or coordinator) to edit parameters that"
^DIC(19,7025,1,2,0)="affect the Inpatient Medications package as a whole."
^DIC(19,7025,25)="ENSYS^PSGFILED"
^DIC(19,7025,"U")="SYSTEMS PARAMETERS EDIT"
^DIC(19,7026,0)="PSJU AL^Align Labels (Unit Dose)^^R^11712^^^^^^^117"
^DIC(19,7026,1,0)="^^2^2^2920522^"
^DIC(19,7026,1,1,0)="  Allows the user to align the label stock on a printer so that Unit Dose"
^DIC(19,7026,1,2,0)="order information will print within the physical boundaries of the label."
^DIC(19,7026,25)="ENAL^PSGLBA"
^DIC(19,7026,"U")="ALIGN LABELS (UNIT DOSE)"
