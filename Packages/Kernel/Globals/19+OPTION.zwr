^DIC(19,8807,0)="MCARGICONV^Convert Old Records to Released Not Verified^^R^755^^^^^^^^^1^1"
^DIC(19,8807,1,0)="^^7^7^2950406^"
^DIC(19,8807,1,1,0)="This option will convert old records or records that do not have a"
^DIC(19,8807,1,2,0)="release status to Released Not Verified.  This option can only be used if"
^DIC(19,8807,1,3,0)="Release Control/Electronic Signature is turned on.  It allows"
^DIC(19,8807,1,4,0)="the non-key holders to view the old records but not edit them.  Before"
^DIC(19,8807,1,5,0)="executing this option, turn on Release Control/Electronic Signature then"
