^DIC(19,16473,1,6,0)="HEALTH FACTORS (#9999999.64)"
^DIC(19,16473,1,7,0)="IMMUNIZATION (#9999999.14)"
^DIC(19,16473,1,8,0)="IMM CONTRAINDICATION REASONS (#920.4)"
^DIC(19,16473,1,9,0)="IMM REFUSAL REASONS (#920.5)"
^DIC(19,16473,1,10,0)="SKIN TEST (#9999999.28)"
^DIC(19,16473,1,11,0)="TREATMENT (#9999999.17)"
^DIC(19,16473,1,12,0)="Cloned from ""PXTT FILE INQUIRY"" option."
^DIC(19,16473,3)=""
^DIC(19,16473,25)="PCEINQ^PXTTINQ"
^DIC(19,16473,30)=""
