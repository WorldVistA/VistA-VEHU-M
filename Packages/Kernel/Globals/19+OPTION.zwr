^DIC(19,8981,0)="XU USER SIGN-ON^User sign-on event^^X^1039^^^^^^^^^"
^DIC(19,8981,1,0)="^19.06^8^8^3020311^^^^"
^DIC(19,8981,1,1,0)="This is a protocol option to link other packages that want to know about"
^DIC(19,8981,1,2,0)="a user sign-on  event."
^DIC(19,8981,1,3,0)="The protocols must not read/write to the screen because we may be doing a"
^DIC(19,8981,1,4,0)="GUI sign-on.  They can set Text that will be displayed to the user by"
^DIC(19,8981,1,5,0)="calling SET^XUS1A(string)  The first character should be a ""!"" to cause the"
^DIC(19,8981,1,6,0)="text to be placed on a new line. DUZ will be defined but other variables"
^DIC(19,8981,1,7,0)="may not be."
^DIC(19,8981,1,8,0)="It is called from XUS1A."
^DIC(19,8981,10,0)="^19.01IP^6^5"
^DIC(19,8981,10,2,0)=8944
^DIC(19,8981,10,3,0)=9846
