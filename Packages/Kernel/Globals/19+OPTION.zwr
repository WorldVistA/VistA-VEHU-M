^DIC(19,6419,1,1,0)="Use this option to maintain the Eng Building File (#6928.3). The"
^DIC(19,6419,1,2,0)="BUILDING (or BUILDING-DIVISION) portion of the ROOM NUMBER field"
^DIC(19,6419,1,3,0)="of entries in the Eng Space File must match an entry in this"
^DIC(19,6419,1,4,0)="Eng Building File."
^DIC(19,6419,1,5,0)=" "
