^DIC(19,12988,1,0)="^19.06^7^7^3040727^^^^"
^DIC(19,12988,1,1,0)="'B' type option.  For users to be able to use the PFFS Detail Display GUI"
^DIC(19,12988,1,2,0)="front-end, this option must be on either their primary"
^DIC(19,12988,1,3,0)="or secondary menu options.  This option has also been"
^DIC(19,12988,1,4,0)="placed on RMPR NPPD TOOLS to give users who have access"
^DIC(19,12988,1,5,0)="to the current NPPD options, access to PFFS GUI Detail"
^DIC(19,12988,1,6,0)="Display.  Note: 'B' type options are not visible to roll"
^DIC(19,12988,1,7,0)="& scroll users."
^DIC(19,12988,21,0)="^^1^1^3040727^"
