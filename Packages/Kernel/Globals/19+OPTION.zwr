^DIC(19,7788,0)="FBCNH CENSUS REPORT^CNH Census Report^^R^1^^^^^^^344^^1^1"
^DIC(19,7788,1,0)="^19.06^4^4^3041207^^^^"
^DIC(19,7788,1,1,0)="This output provides a listing for all Contract Nursing Home patients"
^DIC(19,7788,1,2,0)="for a user specified census date.  Output includes the Vendor name and"
^DIC(19,7788,1,3,0)="Participation Code, veteran specifics such as DOB and ID, as well as"
