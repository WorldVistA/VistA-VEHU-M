^DIC(19,2666,0)="IB PRINT BILL^Print Bill^^R^10000000020^^^^^^^192"
^DIC(19,2666,1,0)="^^6^6^2960220^^^^"
^DIC(19,2666,1,1,0)="This option allows the user to print a third party bill "
^DIC(19,2666,1,2,0)="after all required information has been input, and after"
^DIC(19,2666,1,3,0)="the billing information has been reviewed and authorized."
^DIC(19,2666,1,4,0)="A reimbursable insurance bill that has been flagged for"
^DIC(19,2666,1,5,0)="transmission cannot be printed before it has been"
^DIC(19,2666,1,6,0)="transmitted at least once."
