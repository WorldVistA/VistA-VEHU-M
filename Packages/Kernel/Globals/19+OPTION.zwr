^DIC(19,11148,0)="WV EDIT DIAG TRANSLATION^Edit Diagnostic Code Translation File^^R^11597^^^^^^^522"
^DIC(19,11148,1,0)="^^3^3^2980903^"
^DIC(19,11148,1,1,0)="When mammograms are imported from the Radiology/NM package, the Diagnoses"
