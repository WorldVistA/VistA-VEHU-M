^DIC(19,4580,"U")="OTHER CENSUS OUTPUTS"
^DIC(19,4581,0)="DGPT CENSUS CODING CLERK RPT^Productivity Report by Clerk (Census Only)^^R^.5^DG PTFSUP^^^^^^114"
^DIC(19,4581,1,0)="^^1^1^2900613^^^^"
^DIC(19,4581,1,1,0)="Census coding report by clerk."
^DIC(19,4581,25)="6^DGPTCO"
^DIC(19,4581,"U")="PRODUCTIVITY REPORT BY CLERK ("
^DIC(19,4582,0)="DGPT CENSUS CODING REPORT^Records By Completion Status (Census Only)^^R^.5^DG PTFSUP^^^^^^114"
^DIC(19,4582,1,0)="^^1^1^2910603^^^^"
^DIC(19,4582,1,1,0)="Census coding report by status."
^DIC(19,4582,25)="7^DGPTCO"
^DIC(19,4582,"U")="RECORDS BY COMPLETION STATUS ("
^DIC(19,4583,0)="DGPT CENSUS 099 TRANSACTION^099 Transmission for Census Record^^R^.5^DG PTFTRANS^^^^^^114"
^DIC(19,4583,1,0)="^^14^14^2900810^^^^"
^DIC(19,4583,1,1,0)="This option allows the user to send a 099 transaction for a"
^DIC(19,4583,1,2,0)="census record.  When received in Austin, this 099 will result"
^DIC(19,4583,1,3,0)="in deletion of the master record."
^DIC(19,4583,1,4,0)=" "
^DIC(19,4583,1,5,0)="At the end of this option, the census record will be re-opened"
^DIC(19,4583,1,6,0)="(ie, deleted) from the PTF file in the DHCP database."
^DIC(19,4583,1,7,0)=" "
^DIC(19,4583,1,8,0)="Also, this option will allow the user to transmit a 'free-form'"
^DIC(19,4583,1,9,0)="099 to delete an Austin master record for an entry with"
^DIC(19,4583,1,10,0)="bad control data not represented in the DHCP database."
^DIC(19,4583,1,11,0)=" "
^DIC(19,4583,1,12,0)="This bad control data could have resulted from keypunch"
^DIC(19,4583,1,13,0)="error or a change in a patient's social security number or"
^DIC(19,4583,1,14,0)="admission date and/or time."
^DIC(19,4583,25)="9^DGPTC"
^DIC(19,4583,"U")="099 TRANSMISSION FOR CENSUS RE"
^DIC(19,4584,0)="IB LIST ALL BILLS FOR PAT.^List all Bills for a Patient^^R^.5^^^^^^^192"
^DIC(19,4584,1,0)="^^1^1^2900427^"
^DIC(19,4584,1,1,0)="This option will print a list of all bills for one patient."
^DIC(19,4584,25)="IBOA31"
^DIC(19,4584,"U")="LIST ALL BILLS FOR A PATIENT"
^DIC(19,4585,0)="DGPT CENSUS CLOSED FOR CENSUS^Close Open Census Record^^R^.5^^^^^^^114"
^DIC(19,4585,1,0)="^^7^7^2900810^^^^"
^DIC(19,4585,1,1,0)="This options allows the user to close a PTF record for census"
^DIC(19,4585,1,2,0)="purposes without having to use the 701 screen in the 'Load/Edit"
^DIC(19,4585,1,3,0)="PTF Data' option."
^DIC(19,4585,1,4,0)=" "
^DIC(19,4585,1,5,0)="However, if edit checks, which run during closing, determine that data"
^DIC(19,4585,1,6,0)="is missing or incorrect, it may be neccessary to use 'Load/Edit'"
^DIC(19,4585,1,7,0)="to correct the problem data elements."
^DIC(19,4585,25)="10^DGPTC"
^DIC(19,4585,"U")="CLOSE OPEN CENSUS RECORD"
^DIC(19,4586,0)="IB BILLING RATES FILE^Enter/Edit Billing Rates^^R^.5^IB SUPERVISOR^^^^^^192"
