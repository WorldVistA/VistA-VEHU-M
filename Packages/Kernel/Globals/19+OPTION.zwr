^DIC(19,14882,0)="SCENI IEMM VISIT CORRECTION^Correct Unique Visit ID^^R^1^SCENI ENCOUNTER EDIT^^^^^^16"
^DIC(19,14882,1,0)="^^6^6^3200504^"
^DIC(19,14882,1,1,0)="This option will update the Unique Visit ID in the Oupatient Encounter "
^DIC(19,14882,1,2,0)="file with the value found in the Visit File. This option can be run "
^DIC(19,14882,1,3,0)="for a single entry, or all entries. Also, if there is a TIU Document"
^DIC(19,14882,1,4,0)="associated with the Visit, the Visit ID will also be updated. If "
^DIC(19,14882,1,5,0)="no Visit ID exists in the Visit file, the user will receive the message: "
^DIC(19,14882,1,6,0)="""Error has occurred. Please make a note of the following""."
^DIC(19,14882,25)="EN^SD53103A"
^DIC(19,14882,"U")="CORRECT UNIQUE VISIT ID"
^DIC(19,14883,0)="PSS MED INST MED ROUTE REPORT^Med Instruction Med Term Route Report^^R^1^^^^^^^517"
^DIC(19,14883,1,0)="^^3^3^3200710^"
^DIC(19,14883,1,1,0)="This report displays matches between the Medication Instruction file (#51)"
^DIC(19,14883,1,2,0)="and the Medication Routes file (#51.2) when a Name in the Medication"
^DIC(19,14883,1,3,0)="Instruction file matches an Abbreviation in the Medication Routes file."
^DIC(19,14883,25)="REP^PSSINSTR"
^DIC(19,14883,99)="65492,57171"
^DIC(19,14883,"U")="MED INSTRUCTION MED TERM ROUTE"
^DIC(19,14884,0)="SDEC PENDING RTC - FULL^Pending RTC cleanup - FULL^^R^1^^^^^^^16"
^DIC(19,14884,1,0)="^^2^2^3200505^"
^DIC(19,14884,1,1,0)="This option closes pending RTC orders in CPRS where the SDEC Appointment"
^DIC(19,14884,1,2,0)="Request has been closed or dispositioned."
