^DIC(19,16473,80)=""
^DIC(19,16473,"U")="PCE FILE INQUIRY"
^DIC(19,16474,0)="EHM-01295^PCE Encounter Data Entry^^A^1^^^^^^^^^1^^"
^DIC(19,16474,1,0)="^^11^11^3240328^"
^DIC(19,16474,1,1,0)="This option is for users who can document a clinical encounter in the"
^DIC(19,16474,1,2,0)="V-files (visit related files), but can only delete V-File encounter"
^DIC(19,16474,1,3,0)="entries that they have created. The data entered via this option includes"
^DIC(19,16474,1,4,0)="visit information (where and when), and the following clinical data"
^DIC(19,16474,1,5,0)="related to the visit: providers of care, problems treated, procedures and"
^DIC(19,16474,1,6,0)="treatments done, and immunizations, skin tests, and patient education"
^DIC(19,16474,1,7,0)="given."
^DIC(19,16474,1,8,0)=" "
^DIC(19,16474,1,9,0)=" "
^DIC(19,16474,1,10,0)="This option is intended for data entry staff."
^DIC(19,16474,1,11,0)="Cloned from ""PXCE ENCOUNTER DATA ENTRY"" option."
^DIC(19,16474,3)=""
^DIC(19,16474,10.1)="PCE"
^DIC(19,16474,20)="D EN^PXCE(""d"")"
^DIC(19,16474,99.1)="56179,36316"
^DIC(19,16474,"U")="PCE ENCOUNTER DATA ENTRY"
^DIC(19,16475,0)="EHM-01296^PCE Encounter Data Entry and Delete^^A^1^^^^^^^^^1^^"
^DIC(19,16475,1,0)="^^11^11^3240328^"
^DIC(19,16475,1,1,0)="This option is for users who can document a clinical encounter in the"
^DIC(19,16475,1,2,0)="V-files (visit related files), and can also delete any V-File encounter"
^DIC(19,16475,1,3,0)="entries, even though they are not the creator of the entries."
^DIC(19,16475,1,4,0)="The data entered via this option includes visit information"
^DIC(19,16475,1,5,0)="(where and when), and the following clinical data related to the visit:"
^DIC(19,16475,1,6,0)="providers of care, problems treated, procedures and treatments done,"
^DIC(19,16475,1,7,0)="and immunizations, skin tests, and patient education given."
^DIC(19,16475,1,8,0)=" "
^DIC(19,16475,1,9,0)="This option is intended for the Coordinator for PCE and/or supervisor of"
^DIC(19,16475,1,10,0)="the encounter data entry staff."
^DIC(19,16475,1,11,0)="Cloned from ""PXCE ENCOUNTER ENTRY & DELETE"" option."
^DIC(19,16475,3)=""
^DIC(19,16475,10.1)="PCE"
^DIC(19,16475,20)="D EN^PXCE(""D"")"
^DIC(19,16475,99.1)="56179,36316"
^DIC(19,16475,"U")="PCE ENCOUNTER DATA ENTRY AND D"
^DIC(19,16476,0)="EHM-01297^PCE Encounter Data Entry without Delete^^A^1^^^^^^^^^1^^"
^DIC(19,16476,1,0)="^^8^8^3240328^"
^DIC(19,16476,1,1,0)="This option is for users who can document a clinical encounter in the"
^DIC(19,16476,1,2,0)="V-files (visit-related files), but should not be able to delete any"
^DIC(19,16476,1,3,0)="entries, including ones that they have created. The data entered via this"
^DIC(19,16476,1,4,0)="option includes visit information (where and when), and the"
^DIC(19,16476,1,5,0)="following clinical data related to the visit: providers of care, problems"
^DIC(19,16476,1,6,0)="treated, procedures and treatments done, and immunizations, skin tests,"
^DIC(19,16476,1,7,0)="and patient education given."
^DIC(19,16476,1,8,0)="Cloned from ""PXCE ENCOUNTER ENTRY NO DELETE"" option."
^DIC(19,16476,3)=""
^DIC(19,16476,10.1)="PCE"
^DIC(19,16476,20)="D EN^PXCE("""")"
^DIC(19,16476,99.1)="56179,36316"
^DIC(19,16476,"U")="PCE ENCOUNTER DATA ENTRY WITHO"
^DIC(19,16477,0)="EHM-01298^Directions to Patient's Home Add/Edit^^E^1^^^^^^^^^^^"
^DIC(19,16477,1,0)="^^6^6^3240328^^"
^DIC(19,16477,1,1,0)="This option lets you enter directions to a patient's home - especially"
^DIC(19,16477,1,2,0)="useful for Hospital-Based Home Care staff."
^DIC(19,16477,1,3,0)=" "
^DIC(19,16477,1,4,0)="The Health Summary package contains a new PCE component that displays the"
^DIC(19,16477,1,5,0)="directions entered through this option."
^DIC(19,16477,1,6,0)="Cloned from ""PX EDIT LOCATION OF HOME"" option."
^DIC(19,16477,3)=""
^DIC(19,16477,10.1)="Dir. to Pt Home"
^DIC(19,16477,30)="AUPNPAT("
^DIC(19,16477,31)="AEMQ"
^DIC(19,16477,50)="AUPNPAT("
^DIC(19,16477,51)="[PX LOCATION OF HOME]"
^DIC(19,16477,"U")="DIRECTIONS TO PATIENT'S HOME A"
^DIC(19,16478,0)="EHM-01299^PCE Encounter Data Entry - Supervisor^^A^1^^^^^^^507^^1^1^"
^DIC(19,16478,1,0)="^19.06^15^15^3240328^^^^"
^DIC(19,16478,1,1,0)="This option allows for the add/edit/deleting of information on certain"
^DIC(19,16478,1,2,0)="encounters that most users should not be changing and the other PCE"
^DIC(19,16478,1,3,0)="options will not allow to be changed. This option also does not"
^DIC(19,16478,1,4,0)="conditionally not ask some fields, i.e. it always ask all of the fields."
^DIC(19,16478,1,5,0)="In addition this option allows users to document a clinical encounter in"
^DIC(19,16478,1,6,0)="the V-files (visit related files), and can also delete any V-File"
^DIC(19,16478,1,7,0)="encounter entries, even though they are not the creator of the entries."
^DIC(19,16478,1,8,0)="The data entered via this option includes visit information (where and"
^DIC(19,16478,1,9,0)="when), and the following clinical data related to the visit: providers of"
^DIC(19,16478,1,10,0)="care, problems treated, procedures and treatments done, and immunizations,"
^DIC(19,16478,1,11,0)="skin tests, and patient education given."
^DIC(19,16478,1,12,0)=" "
^DIC(19,16478,1,13,0)="This option is intended for the Coordinator for PCE and/or supervisor of"
^DIC(19,16478,1,14,0)="the encounter data entry staff."
^DIC(19,16478,1,15,0)="Cloned from ""PXCE ENCOUNTER ENTRY SUPER"" option."
^DIC(19,16478,3)=""
^DIC(19,16478,10.1)="SUP"
^DIC(19,16478,15)="K SDSCEDIT"
^DIC(19,16478,20)="S SDSCEDIT=1 D EN^PXCE(""S"")"
^DIC(19,16478,99.1)="56179,36316"
^DIC(19,16478,"U")="PCE ENCOUNTER DATA ENTRY - SUP"
^DIC(19,16479,0)="EHM-01300^PCE HS/RPT Parameter Menu^^M^1^^^^^^^^^^^"
^DIC(19,16479,1,0)="^^12^12^3240328^"
^DIC(19,16479,1,1,0)="This menu option contains print and edit options for PCE fields related to"
^DIC(19,16479,1,2,0)="the PCE Reports module.  "
^DIC(19,16479,1,3,0)=" "
^DIC(19,16479,1,4,0)="Use the print option to see what the current definition is for these"
^DIC(19,16479,1,5,0)="fields.  "
^DIC(19,16479,1,6,0)=" "
^DIC(19,16479,1,7,0)="The report edit option allows your site to specify which clinics in file"
^DIC(19,16479,1,8,0)="44 represent ""Emergency Room"" clinics, and what Lab tests from file 60"
^DIC(19,16479,1,9,0)="should be used for looking up patient data for Glucose, Cholesterol, LDL"
^DIC(19,16479,1,10,0)="Cholesterol and HBA1C lab results.  These fields are used by the following"
^DIC(19,16479,1,11,0)="reports:  Caseload Profile by Clinic, and Patient Activity by Clinic."
^DIC(19,16479,1,12,0)="Cloned from ""PX HS/RPT PARAMETER MENU"" option."
^DIC(19,16479,3)=""
^DIC(19,16479,10,0)="^19.01IP^2^2"
^DIC(19,16479,10,1,0)="16480^RPT^10"
^DIC(19,16479,10,2,0)="16481^PRNT^1"
^DIC(19,16479,10,"B",16480,1)=""
^DIC(19,16479,10,"B",16481,2)=""
^DIC(19,16479,10,"C","PRNT",2)=""
^DIC(19,16479,10,"C","RPT",1)=""
^DIC(19,16479,99)="67411,49177"
^DIC(19,16479,"U")="PCE HS/RPT PARAMETER MENU"
^DIC(19,16480,0)="EHM-01301^PCE Report Parameter Edit^^E^1^^^^^^^507^^^^"
^DIC(19,16480,1,0)="^^10^10^3240328^"
^DIC(19,16480,1,1,0)="This option is used to define parameters that will be used by the PCE"
^DIC(19,16480,1,2,0)="Report Module.  The user will need to identify which clinics are viewed by"
^DIC(19,16480,1,3,0)="clinicians as being Emergency Room clinics.  The user will also need to"
^DIC(19,16480,1,4,0)="identify the lab test names that are used by your site to identify the"
^DIC(19,16480,1,5,0)="following types of Lab tests: Glucose, Cholesterol, LDL Cholesterol, and"
^DIC(19,16480,1,6,0)="HBA1C."
^DIC(19,16480,1,7,0)=" "
^DIC(19,16480,1,8,0)="To get a print out of current definitions in the PCE Parameters fields for"
^DIC(19,16480,1,9,0)="these fields, use the PCE HS/RPT Parameters Print."
^DIC(19,16480,1,10,0)="Cloned from ""PX REPORT PARAMETER EDIT"" option."
^DIC(19,16480,3)=""
^DIC(19,16480,30)="PX(815,"
^DIC(19,16480,31)="QAMEZL"
^DIC(19,16480,50)="PX(815,"
^DIC(19,16480,51)="801:805"
^DIC(19,16480,53)="BACKOUTOK"
^DIC(19,16480,"U")="PCE REPORT PARAMETER EDIT"
^DIC(19,16481,0)="EHM-01302^PCE HS/RPT Parameters Print^^P^1^^^^^^y^507^^^^"
^DIC(19,16481,1,0)="^^5^5^3240328^"
^DIC(19,16481,1,1,0)="This option prints the current PCE Parameter definitions that are used by"
^DIC(19,16481,1,2,0)="some of the PCE Reports. A brief explanation is included about editing and"
^DIC(19,16481,1,3,0)="viewing health summary disclaimers that are now managed from the Clinical"
^DIC(19,16481,1,4,0)="Reminders package."
^DIC(19,16481,1,5,0)="Cloned from ""PX HS/RPT PARAMETERS PRINT"" option."
^DIC(19,16481,3)=""
^DIC(19,16481,60)="PX(815,"
^DIC(19,16481,61)=""
^DIC(19,16481,62)=0
^DIC(19,16481,63)="[PX HS/RPT PARAMETERS PRINT]"
^DIC(19,16481,64)="[PX PARAMETERS PRINT]"
^DIC(19,16481,"U")="PCE HS/RPT PARAMETERS PRINT"
