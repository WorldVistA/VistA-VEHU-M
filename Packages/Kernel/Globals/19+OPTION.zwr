^DIC(19,14453,"U")="EDI DIAGNOSTIC MEASURES EXTRAC"
^DIC(19,14454,0)="RCDPE EDI NATIONAL REPORTS^EDI Diagnostic Measures Reports^^M^1^^^^^^^261^^"
^DIC(19,14454,1,0)="^19.06^3^3^3160112^^^^"
^DIC(19,14454,1,1,0)="This is a menu for AR's EDI Diagnostic Measures National Reports.  These "
^DIC(19,14454,1,2,0)="reports allow a facility to measure the current usage rates of electronic "
