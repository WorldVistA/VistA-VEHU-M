^DIC(19,8528,"U")="AMIS REPORT"
^DIC(19,8529,0)="PSD GS LISTING^Listing of Green Sheet Log^^R^11595^^^^^^^276"
^DIC(19,8529,1,0)="^^3^3^2940411^^"
^DIC(19,8529,1,1,0)="This option numerically lists all Green Sheets for a given date range or"
^DIC(19,8529,1,2,0)="for a given Green Sheet number range.  The logs list Green Sheet number,"
^DIC(19,8529,1,3,0)="date dispensed, and current status."
