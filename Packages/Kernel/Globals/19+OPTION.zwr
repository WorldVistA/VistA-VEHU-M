^DIC(19,10140,1,0)="^^5^5^2970522^"
^DIC(19,10140,1,1,0)="Edit a group of existing items in the inventory file without having to"
^DIC(19,10140,1,2,0)="enter common data for each item. Equipment is initially selected by"
^DIC(19,10140,1,3,0)="purchase order #. Therefore, the purchase order # field must already be"
^DIC(19,10140,1,4,0)="populated before this option can be used to edit equipment. Equipment with"
^DIC(19,10140,1,5,0)="the same purchase order # is selected for editing by line item."
^DIC(19,10140,25)="ENEQMED"
^DIC(19,10140,"U")="PURCHASE ORDER GROUP EDIT"
^DIC(19,10141,0)="ENEQTD^Turn-In/Disposition Equipment^^R^11596^^^^^^^33"
^DIC(19,10141,1,0)="^^2^2^2961120^"
^DIC(19,10141,1,1,0)="This option can be used to quickly update equipment records for the"
^DIC(19,10141,1,2,0)="turn-in or final disposition of equipment not reported to Fixed Assets."
^DIC(19,10141,25)="TD^ENEQTD"
^DIC(19,10141,"U")="TURN-IN/DISPOSITION EQUIPMENT"
^DIC(19,10142,0)="ENEQ-SYSTEM^Parent System/Component Hierarchy Report^^R^11596^^^^^^^33"
^DIC(19,10142,1,0)="^^3^3^2961024^"
^DIC(19,10142,1,1,0)="Prints a hierarchical list of a parent system and all of its components."
^DIC(19,10142,1,2,0)="Components are indented and listed beneath their parent system. Items that"
^DIC(19,10142,1,3,0)="are components of a component in the specified system are included."
^DIC(19,10142,25)="ENEQRP6"
^DIC(19,10142,"U")="PARENT SYSTEM/COMPONENT HIERAR"
^DIC(19,10143,0)="ENEQLT_E/E^Lockout/Tagout Enter/Edit^^R^11596^^^^^^^33"
^DIC(19,10143,1,0)="^^7^7^2961116^"
^DIC(19,10143,1,1,0)="Allows users to specify that equipment records (file #6914) and/or"
^DIC(19,10143,1,2,0)="equipment categories (file #6911) are subject to lockout/tagout"
^DIC(19,10143,1,3,0)="requirements. Lockout/tagout stipulates that the affected equipment must"
^DIC(19,10143,1,4,0)="be rendered inoperative (usually by opening and tagging a circuit breaker)"
^DIC(19,10143,1,5,0)="before the equipment is serviced."
^DIC(19,10143,1,6,0)=" "
^DIC(19,10143,1,7,0)="The intent is to protect maintenance personnel."
^DIC(19,10143,25)="EN^ENEQLT"
^DIC(19,10143,"U")="LOCKOUT/TAGOUT ENTER/EDIT"
^DIC(19,10144,0)="ENEQLT_PRER^Equipment Records with Lockout/Tagout SET^^R^11596^^^^^^^33"
^DIC(19,10144,1,0)="^^1^1^2961116^"
^DIC(19,10144,1,1,0)="Prints from the equipment file (#6914)."
^DIC(19,10144,25)="PRTER^ENEQLT2"
^DIC(19,10144,"U")="EQUIPMENT RECORDS WITH LOCKOUT"
^DIC(19,10145,0)="ENEQLT_PREC^Equipment Categories with Lockout/Tagout SET^^R^11596^^^^^^^33"
^DIC(19,10145,1,0)="^^1^1^2961116^"
^DIC(19,10145,1,1,0)="Prints from Equipment Category File (#6911)."
^DIC(19,10145,25)="PRTEC^ENEQLT2"
^DIC(19,10145,"U")="EQUIPMENT CATEGORIES WITH LOCK"
^DIC(19,10146,0)="ENEQLT_PREX^Equip with Lockout/Tagout CLEAR but Category SET^^R^11596^^^^^^^33"
^DIC(19,10146,1,0)="^^5^5^2961116^"
^DIC(19,10146,1,1,0)="Prints list of Equipment Records (file #6914) that have the LOCKOUT"
^DIC(19,10146,1,2,0)="REQUIRED? clear (not set to 'YES') but belonging to an Equipment Category"
^DIC(19,10146,1,3,0)="(file #6911) for which the LOCKOUT REQUIRED? field is 'YES'."
^DIC(19,10146,1,4,0)=" "
^DIC(19,10146,1,5,0)="Such records, if any exist, would represent exceptional situations."
^DIC(19,10146,25)="PRTEX^ENEQLT2"
^DIC(19,10146,"U")="EQUIP WITH LOCKOUT/TAGOUT CLEA"
^DIC(19,10147,0)="ENEQLT_REPORTS^Lockout/Tagout Flag Reports^^M^11596^^^^^^^33"
