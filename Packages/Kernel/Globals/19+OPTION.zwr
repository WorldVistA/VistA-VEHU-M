^DIC(19,9892,0)="PXRR CLINICAL REPORTS^PCE Clinical Reports^^M^10958^^^^^^^^^"
^DIC(19,9892,1,0)="^^3^3^2960515^^^^"
^DIC(19,9892,1,1,0)="This is a menu of PCE clinical reports that clinicians can use for"
^DIC(19,9892,1,2,0)="summary level information about their patients, workload activity, and"
^DIC(19,9892,1,3,0)="encounter counts."
^DIC(19,9892,10,0)="^19.01PI^8^6"
^DIC(19,9892,10,3,0)="9898^CP^10"
^DIC(19,9892,10,4,0)="9900^DX^20"
^DIC(19,9892,10,5,0)="9899^LE^30"
^DIC(19,9892,10,6,0)="9901^PE^35"
^DIC(19,9892,10,7,0)="10576^PA^5"
^DIC(19,9892,10,8,0)="10656^ES^15"
