^DIC(19,14246,"U")="KPA VRAM GUI"
^DIC(19,14247,0)="XUSSPKI UPN SET^ePCS Set SAN from PIV Card^^B^1^^^^^^^163^n"
^DIC(19,14247,1,0)="^19.06^5^5^3120829^^^^"
^DIC(19,14247,1,1,0)="This only needs to be run once for a user at a site."
^DIC(19,14247,1,2,0)="It sets the Subject Alternative Name (SAN) field in file #200"
^DIC(19,14247,1,3,0)="from the PIV Smart Card.  This is used with the DEA e-sig to be"
^DIC(19,14247,1,4,0)="sure the right certificate is selected from the PIV card."
