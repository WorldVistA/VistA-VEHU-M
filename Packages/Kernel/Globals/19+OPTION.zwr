^DIC(19,14874,0)="DG PRESUMP. PSYCHOSIS STATUS^Presumptive Psychosis Status Report^^R^1^^^^^^^"
^DIC(19,14874,1,0)="^19.06^3^3^3190821^^^^"
^DIC(19,14874,1,1,0)="This option outputs a list of patients treated under Presumptive "
^DIC(19,14874,1,2,0)="Psychosis, and any changes to Presumptive Psychosis categeroy with change "
