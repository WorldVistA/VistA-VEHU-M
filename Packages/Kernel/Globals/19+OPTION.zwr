^DIC(19,70,0)="XMEDITUSER^User Options Edit^^R^11748^^3155^^^^^54^^"
^DIC(19,70,1,0)="^19.06^21^21^3020509^^^^"
^DIC(19,70,1,1,0)="Enables the user to edit various fields which identify the user and"
^DIC(19,70,1,2,0)="specify his MailMan preferences."
^DIC(19,70,1,3,0)=""
^DIC(19,70,1,4,0)="Included are:"
^DIC(19,70,1,5,0)=" - Banner"
^DIC(19,70,1,6,0)=" - Message Display Order (Oldest/Newest First)"
^DIC(19,70,1,7,0)=" - Message Reader (Classic/Full Screen)"
^DIC(19,70,1,8,0)=" - Message Reader Prompt (ask/use default)"
^DIC(19,70,1,9,0)=" - Message Action Default (Ignore/Delete)"
^DIC(19,70,1,10,0)=" - Ask Baskets"
^DIC(19,70,1,11,0)=" - Show Titles"
^DIC(19,70,1,12,0)=" - Priority Responses Flag"
^DIC(19,70,1,13,0)=" - Priority Responses Prompt"
^DIC(19,70,1,14,0)=" - MailMan Institution"
^DIC(19,70,1,15,0)=" - Network Signature"
^DIC(19,70,1,16,0)=" - Introduction"
^DIC(19,70,1,17,0)=" - Preferred Editor"
^DIC(19,70,1,18,0)=" - Address"
^DIC(19,70,1,19,0)=" - Phone"
^DIC(19,70,1,20,0)=" - Fax"
^DIC(19,70,1,21,0)=" - Pager"
^DIC(19,70,25)="EDIT^XMVVITA"
^DIC(19,70,99)="55394,60823"
^DIC(19,70,"U")="USER OPTIONS EDIT"
^DIC(19,71,0)="XMASSUME^Become a Surrogate (SHARED,MAIL or Other)^^R^11748^^3147^^^^^54^^1^1"
^DIC(19,71,1,0)="^^27^27^2990510^^^^"
^DIC(19,71,1,1,0)="This option allows the user to act as a surrogate for another user"
^DIC(19,71,1,2,0)="or for SHARED,MAIL."
^DIC(19,71,1,3,0)=""
^DIC(19,71,1,4,0)="Before you can act as a surrogate for another user, that user must"
^DIC(19,71,1,5,0)="indicate permission by granting you surrogate privileges through"
^DIC(19,71,1,6,0)="his USER OPTIONS EDIT.  You will then be able to read, answer, and"
^DIC(19,71,1,7,0)="send mail for that user, depending on the level of access (read/write)"
^DIC(19,71,1,8,0)="that you were granted."
^DIC(19,71,1,9,0)=""
^DIC(19,71,1,10,0)="You may assume the identity of a special user, 'SHARED,MAIL',"
^DIC(19,71,1,11,0)="to read messages of general interest.  You will be able to read and"
^DIC(19,71,1,12,0)="respond to messages there, but you will not be able to send any."
^DIC(19,71,1,13,0)="If you have been given the XMNOPRIV key, you will not be able"
^DIC(19,71,1,14,0)="to access 'SHARED,MAIL'."
^DIC(19,71,1,15,0)=""
^DIC(19,71,1,16,0)="SHARED,MAIL is a place to send messages of general interest."
^DIC(19,71,1,17,0)="Almost all users may access this area.  When you send messages to"
^DIC(19,71,1,18,0)="SHARED,MAIL, you must indicate a BASKET to deliver the messages to"
^DIC(19,71,1,19,0)="so that helps others find yours."
^DIC(19,71,1,20,0)=""
^DIC(19,71,1,21,0)="Do not create new BASKETS unless it is really necessary."
^DIC(19,71,1,22,0)=""
^DIC(19,71,1,23,0)="Try to fit your message into a basket that already exists.  SHARED, MAIL"
^DIC(19,71,1,24,0)="is a LIBRARY, NOT a repository for trivial or personal communications."
^DIC(19,71,1,25,0)="Please respect your privilege to be SHARED,MAIL surrogate."
^DIC(19,71,1,26,0)=""
^DIC(19,71,1,27,0)="The PRIVILEGE to be a SURROGATE of SHARED,MAIL may be taken away."
^DIC(19,71,15)="D CHECKOUT^XM"
^DIC(19,71,20)="D CHECKIN^XM"
^DIC(19,71,25)="ASSUME^XMVSURR"
^DIC(19,71,"U")="BECOME A SURROGATE (SHARED,MAI"
^DIC(19,72,0)="DIWF^Forms Print^^R^1^^^^^^^"
^DIC(19,72,1,0)="^^7^7^2901206^"
^DIC(19,72,1,1,0)="This VA FileMan routine asks first for a 'document' file, which must be"
^DIC(19,72,1,2,0)="a file that contains a word processing field at the first level.  It then"
^DIC(19,72,1,3,0)="asks the user to choose an entry in that file for which the word"
^DIC(19,72,1,4,0)="processing field has some text on file.  It then uses that text as a "
^DIC(19,72,1,5,0)="'print template' for a file.  If the chosen document entry has a pointer"
^DIC(19,72,1,6,0)="to a file, that file is automatically the one from which the printing"
^DIC(19,72,1,7,0)="is done."
^DIC(19,72,25)="DIWF"
^DIC(19,72,"U")="FORMS PRINT"
^DIC(19,73,0)="XMBANNER^Banner Edit^^R^11748^^3145^^^^^54^^^"
^DIC(19,73,1,0)="^^3^3^2971229^^^^"
^DIC(19,73,1,1,0)="Enables a user to edit his ""banner"" message for MailMan."
^DIC(19,73,1,2,0)="When messages are addressed to users with banners, their banners"
^DIC(19,73,1,3,0)="may be displayed."
^DIC(19,73,15)=""
^DIC(19,73,20)=""
^DIC(19,73,25)="BANNER^XMVVITA"
