^DIC(19,15444,0)="EHM-00265^GUI Non-VA Med Statements/Reasons^^A^1^^^^^^^170^^1^^"
^DIC(19,15444,1,0)="^^5^5^3240328^"
^DIC(19,15444,1,1,0)="This option allows you to set up a list of statements/reasons why an "
^DIC(19,15444,1,2,0)="herbal/OTC/non-VA medication is documented (ordered.)  These "
^DIC(19,15444,1,3,0)="statements/reasons will be displayed for selection in the Non-VA Med "
^DIC(19,15444,1,4,0)="ordering dialog in CPRS GUI."
^DIC(19,15444,1,5,0)="Cloned from ""ORW NONVA REASON"" option."
^DIC(19,15444,3)=""
^DIC(19,15444,10.1)="Non-VA Med Statements"
^DIC(19,15444,20)="D EDITPAR^XPAREDIT(""ORWD NONVA REASON"")"
^DIC(19,15444,"U")="GUI NON-VA MED STATEMENTS/REAS"
^DIC(19,15445,0)="EHM-00266^GUI Expired Orders Search Hours^^A^1^^^^^^^170^^1^^"
^DIC(19,15445,1,0)="^^7^7^3240328^"
^DIC(19,15445,1,1,0)="This option allows you to set the number of hours to search for a"
^DIC(19,15445,1,2,0)="patient's expired orders.  For example, a value of ""24"" hours will search"
^DIC(19,15445,1,3,0)="for all of the patient's orders that have expired within the past 24 "
^DIC(19,15445,1,4,0)="hours. The number of hours determines what expired orders are displayed in"
^DIC(19,15445,1,5,0)="the Recently Expired Orders view.  This can be selected on the Orders tab"
^DIC(19,15445,1,6,0)="under the View menu."
^DIC(19,15445,1,7,0)="Cloned from ""ORWOR EXPIRED ORDERS"" option."
^DIC(19,15445,3)=""
^DIC(19,15445,10.1)="Expired Orders Hours"
^DIC(19,15445,20)="D EDITPAR^XPAREDIT(""ORWOR EXPIRED ORDERS"")"
^DIC(19,15445,"U")="GUI EXPIRED ORDERS SEARCH HOUR"
^DIC(19,15446,0)="EHM-00267^GUI Remove Button Enabled^^A^1^^^^^^^170^^1^^"
^DIC(19,15446,1,0)="^^6^6^3240328^"
^DIC(19,15446,1,1,0)="This option allows you to set the flag to indicate if a CPRS OR "
^DIC(19,15446,1,2,0)="notification/alert can be deleted without processing via the GUI alert "
^DIC(19,15446,1,3,0)="Remove button.  A ""yes"" value indicates the notification/alert can be"
^DIC(19,15446,1,4,0)="removed.  If a notification/alert has a blank value or a ""no"" value, the"
^DIC(19,15446,1,5,0)="notification/alert cannot be deleted without processing."
^DIC(19,15446,1,6,0)="Cloned from ""ORWORB REMOVE"" option."
^DIC(19,15446,3)=""
^DIC(19,15446,10.1)="Remove Button Flag"
^DIC(19,15446,20)="D EDITPAR^XPAREDIT(""ORB REMOVE"")"
^DIC(19,15446,"U")="GUI REMOVE BUTTON ENABLED"
^DIC(19,15447,0)="EHM-00268^GUI Remove Button Enabled for Non-OR Alerts^^A^1^^^^^^^170^^1^^"
^DIC(19,15447,1,0)="^^14^14^3240328^"
^DIC(19,15447,1,1,0)="This option allows you to set the flag to indicate if a non-OR alert can"
^DIC(19,15447,1,2,0)="be deleted without processing via the GUI alert Remove button. Enter the"
^DIC(19,15447,1,3,0)="Alert identifier (XQAID) or a portion of the Alert identifier for each"
^DIC(19,15447,1,4,0)="type of alert you want to be able to remove in the CPRS GUI via the Remove"
^DIC(19,15447,1,5,0)="button. For example, to remove NOIS alerts enter FSC.  You may enter as"
^DIC(19,15447,1,6,0)="many alert identifiers as desired.  Please note that most alert"
^DIC(19,15447,1,7,0)="identifiers include information specific to the patient or instance which"
^DIC(19,15447,1,8,0)="triggered the alert. For this parameter you should only enter the portion"
^DIC(19,15447,1,9,0)="of alert identifier which is consistent for all alerts of this type.  For"
^DIC(19,15447,1,10,0)="example, a NOIS alert's identifier might actually look like"
^DIC(19,15447,1,11,0)="FSC-M,275546.  Entering the entire alert identifier in this parameter will"
^DIC(19,15447,1,12,0)="only allow removal of this specific alert.  However if the parameter value"
^DIC(19,15447,1,13,0)="is FSC, all NOIS alerts can be removed."
^DIC(19,15447,1,14,0)="Cloned from ""ORWORB REMOVE NON-OR"" option."
^DIC(19,15447,3)=""
^DIC(19,15447,10.1)="Remove Button Flag Non-OR"
^DIC(19,15447,20)="D EDITPAR^XPAREDIT(""ORB REMOVE NON-OR"")"
^DIC(19,15447,"U")="GUI REMOVE BUTTON ENABLED FOR "
^DIC(19,15448,0)="EHM-00269^GUI Mark Allergy Entered in Error^^A^1^^^^^^^^^1^^"
^DIC(19,15448,1,0)="^19.06^6^6^3240328^^"
^DIC(19,15448,1,1,0)="The OR ALLERGY ENTERED IN ERROR parameter controls who can mark"
^DIC(19,15448,1,2,0)="an existing allergy as entered in error from the cover sheet.  Set"
^DIC(19,15448,1,3,0)="the appropriate level to ""yes"" if you wish to allow users to mark"
^DIC(19,15448,1,4,0)="allergies as entered in error.  This parameter can be set at"
^DIC(19,15448,1,5,0)="the system, division, class, and user level."
^DIC(19,15448,1,6,0)="Cloned from ""ORW ALLERGY EIE"" option."
^DIC(19,15448,3)=""
^DIC(19,15448,20)="D EDITPAR^XPAREDIT(""OR ALLERGY ENTERED IN ERROR"")"
^DIC(19,15448,"U")="GUI MARK ALLERGY ENTERED IN ER"
