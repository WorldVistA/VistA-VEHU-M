^DIC(19,8904,0)="QAP COPY SURVEY^Copy a Survey^Option has been placed out of order^R^.5^^^^^^^268"
^DIC(19,8904,1,0)="^^2^2^2941105^"
^DIC(19,8904,1,1,0)="This option allows the copying of the basic survey information and its"
^DIC(19,8904,1,2,0)="associated questions to a new survey."
^DIC(19,8904,25)="QAPCOPY"
^DIC(19,8904,"U")="COPY A SURVEY"
^DIC(19,8905,0)="QAP SURVEY MAINTENANCE^Create/Edit a Survey^Option has been placed out of order^R^.5^^^^^^^268"
^DIC(19,8905,1,0)="^^2^2^2941105^"
^DIC(19,8905,1,1,0)="This option allows the addition of a new survey or the editing of an"
^DIC(19,8905,1,2,0)="existing one."
^DIC(19,8905,25)="QAPEDIT"
^DIC(19,8905,"U")="CREATE/EDIT A SURVEY"
^DIC(19,8906,0)="QAP COUNT SURVEY PARTICIPANTS^Count Survey Participants^Option has been placed out of order^R^.5^^^^^^^268"
^DIC(19,8906,1,0)="^^2^2^2941105^"
^DIC(19,8906,1,1,0)="This option will talley the participants in a selected survey up until the"
^DIC(19,8906,1,2,0)="time it is run."
^DIC(19,8906,25)="QAPPART"
^DIC(19,8906,"U")="COUNT SURVEY PARTICIPANTS"
^DIC(19,8907,0)="QAP PRINT A SURVEY^Print a Survey^Option has been placed out of order^R^.5^^^^^^^268"
^DIC(19,8907,1,0)="^^3^3^2941105^"
^DIC(19,8907,1,1,0)="This option will print a draft or final copy of a survey.  It is used by"
^DIC(19,8907,1,2,0)="the survey author to review his work for errors (draft) or print a final"
^DIC(19,8907,1,3,0)="copy for distribution to users and later entry by a clerk or secretary."
^DIC(19,8907,25)="QAPPT0"
^DIC(19,8907,"U")="PRINT A SURVEY"
^DIC(19,8908,0)="QAP GENERATE SURVEY STATISTICS^Generate Survey Statistics^Option has been placed out of order^R^.5^^^^^^^268"
^DIC(19,8908,1,0)="^^1^1^2941105^"
^DIC(19,8908,1,1,0)="Generates statistics for the survey author."
^DIC(19,8908,25)="QAPSTATS"
^DIC(19,8908,"U")="GENERATE SURVEY STATISTICS"
^DIC(19,8909,0)="QAP PARTICIPATE^Participate in a Survey^Option has been placed out of order^R^.5^^^^^^^268"
^DIC(19,8909,1,0)="^^3^3^2941105^"
^DIC(19,8909,1,1,0)="This option will allow users to participate in a survey.  Participation is"
^DIC(19,8909,1,2,0)="limited to one per user, unless it is the special case of a clerk or"
^DIC(19,8909,1,3,0)="secretary entering surveys submitted by hand."
^DIC(19,8909,25)="QAPSCRN"
^DIC(19,8909,"U")="PARTICIPATE IN A SURVEY"
^DIC(19,8910,0)="QAP EDIT INCOMPLETE SURVEY^Edit an Incomplete Survey Response^Option has been placed out of order^R^.5^^^^^^^268"
^DIC(19,8910,1,0)="^^5^5^2950124^^"
^DIC(19,8910,1,1,0)="This option will allow a participant to edit answers in the survey he/she"
^DIC(19,8910,1,2,0)="has not yet completed, but without actually going back into the survey"
^DIC(19,8910,1,3,0)="participation itself.  This will be useful for participants who want to"
^DIC(19,8910,1,4,0)="edit particular answers but who do not have time to finish the survey"
^DIC(19,8910,1,5,0)="itself."
^DIC(19,8910,25)="QAPEDINC"
^DIC(19,8910,"U")="EDIT AN INCOMPLETE SURVEY RESP"
^DIC(19,8911,0)="QAP PARTICIPANT MENU^Survey Participant Menu^Option has been placed out of order^M^.5^^^^^^^268^^^^^1"
^DIC(19,8911,1,0)="^^1^1^2941105^"
^DIC(19,8911,1,1,0)="Main menu that allows someone to participate in a survey."
