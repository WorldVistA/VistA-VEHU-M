^DIC(19,13297,0)="BPS RPT TURNAROUND STATS^Turn-around time statistics^^R^1^BPS REPORTS^^^^^^^^^"
^DIC(19,13297,1,0)="^^4^4^3060602^"
^DIC(19,13297,1,1,0)="After the user selects a transaction date range, this report shows the "
^DIC(19,13297,1,2,0)="length of time for claims to complete, including breakouts for various "
^DIC(19,13297,1,3,0)="steps of claims creation.  The end of the report has the average time for "
^DIC(19,13297,1,4,0)="the claims displayed."
^DIC(19,13297,15)=""
^DIC(19,13297,25)="BPSRDT1"
^DIC(19,13297,"U")="TURN-AROUND TIME STATISTICS"
^DIC(19,13298,0)="BPS RPT RECENT TRANSACTIONS^Recent Transactions^^R^1^BPS REPORTS^^^^^^"
^DIC(19,13298,1,0)="^^6^6^3060602^"
^DIC(19,13298,1,1,0)="This report summarizes recently completed transactions for the selected "
^DIC(19,13298,1,2,0)="criteria. A claim (to be included in this Report) is defined as a claim "
^DIC(19,13298,1,3,0)="that has been successfully transmitted to the payer. These claims will "
^DIC(19,13298,1,4,0)="include submissions, reversals and resubmissions. Closed Claims will not "
^DIC(19,13298,1,5,0)="show up on this report since this report displays activity between ECME "
^DIC(19,13298,1,6,0)="and the payer only."
^DIC(19,13298,25)="EN^BPSRPT0(5)"
^DIC(19,13298,62)=0
^DIC(19,13298,"U")="RECENT TRANSACTIONS"
^DIC(19,13299,0)="BPS SETUP BASIC PARAMS^Edit Basic ECME Parameters^^R^1^BPS MASTER^^^^^^^^^"
^DIC(19,13299,1,0)="^^3^3^3060602^"
^DIC(19,13299,1,1,0)="Gives users the ability to edit the ECME timeout parameter, which "
^DIC(19,13299,1,2,0)="determines how long ECME claim progress messages are displayed on the "
^DIC(19,13299,1,3,0)="screen."
^DIC(19,13299,15)=""
^DIC(19,13299,25)="EN^BPSOSS8"
^DIC(19,13299,"U")="EDIT BASIC ECME PARAMETERS"
^DIC(19,13300,0)="PSO REJECTS WORKLIST^Third Party Payer Rejects - Worklist^^R^10000000216^PSORPH^^^^^^141^^"
^DIC(19,13300,1,0)="^19.06^5^5^3080305^^^^"
^DIC(19,13300,1,1,0)="This option gives user the ability to process Third Party Payer Rejects for"
^DIC(19,13300,1,2,0)="one, multiple or all Outpatient Pharmacy Divisions. Only OPEN/UNRESOLVED "
^DIC(19,13300,1,3,0)="rejects that have clinical significance, such as DUR (Drug Utilization Review)"
^DIC(19,13300,1,4,0)="and Fill Too Soon, are added to the Worklist. Once the reject is marked "
^DIC(19,13300,1,5,0)="CLOSED/RESOLVED it is automatically removed from the Worklist."
