^DIC(19,1675,0)="RA BTCHLIST^List Reports in a Batch^^R^11712^^^^^^^"
^DIC(19,1675,1,0)="^^3^3^2910509^^^^"
^DIC(19,1675,1,1,0)="This function allows the user to get a listing of all the reports"
^DIC(19,1675,1,2,0)="that are presently in a batch.  An asterisk(*) is placed next to"
^DIC(19,1675,1,3,0)="the report if the report has been previously printed from the batch."
^DIC(19,1675,25)="2^RABTCH"
^DIC(19,1675,"U")="LIST REPORTS IN A BATCH"
^DIC(19,1676,0)="RA BTCHPRINT^Print a Batch of Reports^^R^11712^^^^^^^"
^DIC(19,1676,1,0)="^^4^4^2940603^"
^DIC(19,1676,1,1,0)="This function allows the user to obtain a hardcopy of the reports"
^DIC(19,1676,1,2,0)="associated with a batch.  This report is usually accessed by the"
^DIC(19,1676,1,3,0)="'Report Enter/Edit' function after all reports have been entered"
^DIC(19,1676,1,4,0)="and the user requests the reports to be printed."
^DIC(19,1676,25)="3^RABTCH"
^DIC(19,1676,"U")="PRINT A BATCH OF REPORTS"
