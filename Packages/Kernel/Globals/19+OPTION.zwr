^DIC(19,15076,0)="SDES STUCK ORDER CLEANUP^Stuck ORDER Clean-up tool^^R^1^^^^^^^"
^DIC(19,15076,1,0)="^^5^5^3221209^"
^DIC(19,15076,1,1,0)="This option will prompt for an order (or list of orders) that is stuck in "
^DIC(19,15076,1,2,0)="a pending or partial results status.  It will then review the linked "
^DIC(19,15076,1,3,0)="appointment request to verify what the status should be.  If the status "
^DIC(19,15076,1,4,0)="should be completed or discontinued, the option will update the order "
^DIC(19,15076,1,5,0)="to correct that status."
^DIC(19,15076,25)="CLEANDATA^SDESORDCLEAN"
^DIC(19,15076,"U")="STUCK ORDER CLEAN-UP TOOL"
^DIC(19,15077,0)="DG VAS EXPORT^Export new AUDIT records to external archive^^R^1^^^^^^^114"
^DIC(19,15077,1,0)="^^6^6^3220107^"
^DIC(19,15077,1,1,0)="This option is intended to be initiated by TaskMan to send records from "
^DIC(19,15077,1,2,0)="the DG VAS QUEUE file to the VistA Audit Solution (VAS) external archive."
^DIC(19,15077,1,3,0)="The option should be configured to run at Startup, and should be scheduled"
^DIC(19,15077,1,4,0)="to run periodically. The process is not designed to run more than one"
^DIC(19,15077,1,5,0)="instance simultaneously; If the option is already running (based on a lock"
^DIC(19,15077,1,6,0)="on the ^DGAUDIT(0) global node), then it simply quits."
^DIC(19,15077,25)="EXPORT^DGAUDIT"
^DIC(19,15077,200.9)="y"
^DIC(19,15077,"U")="EXPORT NEW AUDIT RECORDS TO EX"
^DIC(19,15077,"W")="^ZTSK"
^DIC(19,15078,0)="DG VAS MODIFY^Modify VAS Parameters^^R^1^DG SECURITY OFFICER^^^^^^"
^DIC(19,15078,1,0)="^^3^3^3220118^"
^DIC(19,15078,1,1,0)="This option provides users with the ability to edit settings related "
^DIC(19,15078,1,2,0)="to the VistA Audit Solution (VAS) export of patient inquiry and"
^DIC(19,15078,1,3,0)="patient update audit records to the central VAS repository."
^DIC(19,15078,25)="EN^DGAUDIT3"
^DIC(19,15078,"U")="MODIFY VAS PARAMETERS"
