^DIC(19,10906,1,0)="^19.06^2^2^3031217^^^^"
^DIC(19,10906,1,1,0)="       This is the primary menu that contains the Lab Emerging Pathogens (EPI)"
^DIC(19,10906,1,2,0)="options."
^DIC(19,10906,10,0)="^19.01IP^8^7"
