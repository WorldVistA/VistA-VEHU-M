^DIC(19,1374,10,"C",2,2)=""
^DIC(19,1374,99)="56214,30324"
^DIC(19,1374,"U")="USER SELECTED LAB TEST/PATIENT"
^DIC(19,1375,0)="LRTASK DISCHARGE^Patient Lab Discharge Summary^^R^.5^^^^^^^26"
^DIC(19,1375,1,0)="^^9^9^2860324^^"
^DIC(19,1375,1,1,0)="This option is to allow for automatic queuing of a Laboratory "
^DIC(19,1375,1,2,0)="discharge summary for patients discharged 'T-1' from the date"
^DIC(19,1375,1,3,0)="this option is invoked.  The report is in a similar format as"
^DIC(19,1375,1,4,0)="the full patient summary and the Cumulative report.  The only"
^DIC(19,1375,1,5,0)="results that are printed are those that are ordered from the"
^DIC(19,1375,1,6,0)="date of admission to the date of discharge."
^DIC(19,1375,1,7,0)="To install this option, fill in the fields QUEUED TO RUN AT"
^DIC(19,1375,1,8,0)="WHAT TIME, DEVICE FOR QUEUED JOB OUTPUT, and RESCHEDULING"
^DIC(19,1375,1,9,0)="FREQUENCY in the OPTION file."
