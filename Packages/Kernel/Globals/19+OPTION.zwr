^DIC(19,9017,"U")="EDIT A BUILD"
^DIC(19,9018,0)="XPD MAIN^Kernel Installation & Distribution System^^M^1039^XUPROG^^^^^^"
^DIC(19,9018,1,0)="^^2^2^2950321^^^^"
^DIC(19,9018,1,1,0)="This menu contains options to prepare a module for distribution"
^DIC(19,9018,1,2,0)="and install a module at a site."
^DIC(19,9018,10,0)="^19.01IP^4^4"
^DIC(19,9018,10,1,0)="8980^^1"
