^DIC(19,6344,0)="XQALERT^View Alerts^^R^1039^^^^^^^^^"
^DIC(19,6344,1,0)="^^4^4^2911001^^"
^DIC(19,6344,1,1,0)=" "
^DIC(19,6344,1,2,0)="This option is used to select alerts or notifications produced by"
^DIC(19,6344,1,3,0)="application packages for viewing or to perform any actions associated"
^DIC(19,6344,1,4,0)="with the alert or notification received."
^DIC(19,6344,25)="DOIT^XQALERT"
^DIC(19,6344,99.1)="60606,34421"
^DIC(19,6344,"U")="VIEW ALERTS"
^DIC(19,6345,0)="XMEDITDIST^Edit Distribution List^^E^11748^^^^^^^^^"
^DIC(19,6345,1,0)="^^14^14^2901102^^^"
^DIC(19,6345,1,1,0)="Distribution Lists may be entered as part of the delivery list for messages"
^DIC(19,6345,1,2,0)="in Mail Groups.  They consist of a name and a list of domains that are "
^DIC(19,6345,1,3,0)="concatenated to the name for delivery of a message to multiple mail-boxes,"
^DIC(19,6345,1,4,0)="each of which have the same name that exist at different domains."
^DIC(19,6345,1,5,0)=""
^DIC(19,6345,1,6,0)="If the NAME is G.SUPPORT (It could be POSTMASTER.), and the domains are"
^DIC(19,6345,1,7,0)="FORUM.VA.GOV & ALTOONA.VA.GOV, the message will be send to:"
^DIC(19,6345,1,8,0)=" "
^DIC(19,6345,1,9,0)="     G.SUPPORT@FORUM.VA.GOV"
^DIC(19,6345,1,10,0)="and  G.SUPPORT@ALTOONA.VA.GOV"
^DIC(19,6345,1,11,0)=" "
^DIC(19,6345,1,12,0)="Each Distribution list may be added to more than one Mail Group.  Each Mail"
^DIC(19,6345,1,13,0)="Group may point at more than one Distribution List."
^DIC(19,6345,1,14,0)=""
^DIC(19,6345,30)="XMB(3.816,"
^DIC(19,6345,31)="AEMNL"
^DIC(19,6345,50)="XMB(3.816,"
^DIC(19,6345,51)=".01;1"
^DIC(19,6345,"U")="EDIT DISTRIBUTION LIST"
^DIC(19,6346,0)="XMSHARE^Assume the Identity of SHARED,MAIL^^R^11748^^3085^^^^^54^^1^1^1^^"
^DIC(19,6346,1,0)="^^14^14^2970731^^^^"
^DIC(19,6346,1,1,0)="Use this option to assume the identity of a special user, 'SHARED,MAIL',"
^DIC(19,6346,1,2,0)="so that you may read mail send to the general public.  Users who own the"
^DIC(19,6346,1,3,0)="XMNOPRIV key may not do this.  SHARED,MAIL is a place to send messages of"
^DIC(19,6346,1,4,0)="general interest.  Almost all users may access this area.  You must"
^DIC(19,6346,1,5,0)="indicate a BASKET to deliver the messages to so that helps others find "
^DIC(19,6346,1,6,0)="yours."
^DIC(19,6346,1,7,0)=""
^DIC(19,6346,1,8,0)="  Do not create new BASKETS unless it is really necessary."
^DIC(19,6346,1,9,0)=""
^DIC(19,6346,1,10,0)="Try to fit your message into a basket that already exists.  SHARED, MAIL"
^DIC(19,6346,1,11,0)="is a LIBRARY, NOT a repository for trivial or personal communications."
^DIC(19,6346,1,12,0)="Please respect your privilege to be SHARED,MAIL surrogate."
^DIC(19,6346,1,13,0)=""
^DIC(19,6346,1,14,0)="The PRIVILEGE to be a SURROGATE of SHARED,MAIL may be taken away."
^DIC(19,6346,3)="XMNOPRIV"
^DIC(19,6346,15)="D CHECKOUT^XM"
^DIC(19,6346,20)="D CHECKIN^XM"
^DIC(19,6346,25)="SHARE^XMVSURR"
^DIC(19,6346,99)="55054,48822"
^DIC(19,6346,"U")="ASSUME THE IDENTITY OF SHARED,"
^DIC(19,6347,0)="XQAB LIST LOW USAGE OPTS^Low Usage Alpha/Beta Test Options^^R^1039^^^^^^^^^"
^DIC(19,6347,1,0)="^^6^6^2901130^"
^DIC(19,6347,1,1,0)=" "
^DIC(19,6347,1,2,0)="This option is available for obtaining a listing of options which are in"
^DIC(19,6347,1,3,0)="a package which is under alpha or beta testing and which have low levels"
^DIC(19,6347,1,4,0)="of utilization since the last installation of the package.  An option"
^DIC(19,6347,1,5,0)="with low utilization is any option in the package namespace(s) with zero to"
^DIC(19,6347,1,6,0)="five accesses."
^DIC(19,6347,25)="LOW^XQABLIST"
^DIC(19,6347,"U")="LOW USAGE ALPHA/BETA TEST OPTI"
^DIC(19,6348,0)="XQAB ACTUAL OPTION USAGE^Actual Usage of Alpha/Beta Test Options^^R^1039^^^^^^^^^"
^DIC(19,6348,1,0)="^^5^5^2901130^"
^DIC(19,6348,1,1,0)=" "
^DIC(19,6348,1,2,0)="This option is available for listing actual usage of options within a package"
^DIC(19,6348,1,3,0)="which is in alpha or beta testing.  This will list only those options which"
^DIC(19,6348,1,4,0)="have been accessed one or more times since the last installation of the"
^DIC(19,6348,1,5,0)="package."
^DIC(19,6348,25)="ACTUAL^XQABLIST"
^DIC(19,6348,"U")="ACTUAL USAGE OF ALPHA/BETA TES"
^DIC(19,6349,0)="XQAB MENU^Alpha/Beta Test Option Usage Menu^^M^1039^^^^^^^^^"
^DIC(19,6349,1,0)="^^3^3^2901130^"
^DIC(19,6349,1,1,0)=" "
^DIC(19,6349,1,2,0)="This menu option is available for accessing those options related to usage"
^DIC(19,6349,1,3,0)="of options in alpha or beta test packages."
^DIC(19,6349,10,0)="^19.01PI^6^4"
^DIC(19,6349,10,1,0)="6348^"
^DIC(19,6349,10,2,0)="6347^"
^DIC(19,6349,10,3,0)="6379^"
^DIC(19,6349,10,6,0)="7883^"
^DIC(19,6349,10,"B",6347,2)=""
^DIC(19,6349,10,"B",6348,1)=""
^DIC(19,6349,10,"B",6379,3)=""
^DIC(19,6349,10,"B",7883,6)=""
