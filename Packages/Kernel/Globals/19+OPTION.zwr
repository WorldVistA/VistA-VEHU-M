^DIC(19,13374,0)="KMPD TMG MONITOR^Timing Monitor^^R^10000000216^^^^^^^547"
^DIC(19,13374,1,0)="^19.06^8^8^3040217^^"
^DIC(19,13374,1,1,0)="This option displays CPRS Coversheet time-to-load data, as a bar graph, "
^DIC(19,13374,1,2,0)="for the current day.  This option can be left running on a terminal (if "
^DIC(19,13374,1,3,0)="desired).  The monitor is updated every 10 minutes (site configurable "
^DIC(19,13374,1,4,0)="through the [KMPD PARAM EDIT] Edit CP Parameters File option), and "
^DIC(19,13374,1,5,0)="displays current average time-to-load data starting at midnight.  An alarm"
^DIC(19,13374,1,6,0)="message is displayed if the average time-to-load exceeds 30 seconds (site"
^DIC(19,13374,1,7,0)="configurable through the [KMPD PARAM EDIT] Edit CP Parameters File"
^DIC(19,13374,1,8,0)="option)."
^DIC(19,13374,25)="EN^KMPDTM"
^DIC(19,13374,"U")="TIMING MONITOR"
