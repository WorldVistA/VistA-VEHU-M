^DIC(19,7008,"U")="DISABLE/ENABLE HEALTH SUMMARY "
^DIC(19,7009,0)="GMTS IRM/ADPAC ADHOC EDIT^Edit Ad Hoc Health Summary Type^^A^.5^^^^^^y^160^^1"
^DIC(19,7009,1,0)="^^4^4^2950816^"
^DIC(19,7009,1,1,0)="Enter/edit the default parameters (Time and Occurrence limits, Hospital"
^DIC(19,7009,1,2,0)="Location displayed, ICD Text displayed, Provider Narrative displayed,"
^DIC(19,7009,1,3,0)="Selection Items and Header names) for components of the Ad Hoc Health"
^DIC(19,7009,1,4,0)="Summary Type. Components can also be deleted from this option."
^DIC(19,7009,20)="D ENADHOC^GMTSRM"
^DIC(19,7009,99.1)="59164,31865"
^DIC(19,7009,"U")="EDIT AD HOC HEALTH SUMMARY TYP"
