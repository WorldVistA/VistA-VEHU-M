^DIC(19,576,0)="DG SECURITY ENTER/EDIT^Enter/Edit Patient Security Level^^R^11748^DG SENSITIVITY^^^^^^"
^DIC(19,576,1,0)="^^7^7^2941107^^^^"
^DIC(19,576,1,1,0)="This option permits holders of the DG SENSITIVITY key to assign"
^DIC(19,576,1,2,0)="a security level to a patient. A patient can either be sensitive"
^DIC(19,576,1,3,0)="or non-sensitive."
^DIC(19,576,1,4,0)=" "
^DIC(19,576,1,5,0)="If the security level for a patient is changed from sensitive to"
^DIC(19,576,1,6,0)="non-sensitive a bulletin will be sent notifying the Station Security"
^DIC(19,576,1,7,0)="Officer of the change."
