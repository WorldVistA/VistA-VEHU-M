^DIC(19,15831,1,0)="^19.06^8^8^3240328^^"
^DIC(19,15831,1,1,0)="Allow team lists to be designated to be used by GUI applications for:"
^DIC(19,15831,1,2,0)=" "
^DIC(19,15831,1,3,0)="  0 = OWNER - only viewable by the owner "
^DIC(19,15831,1,4,0)="  1 = ALLUSERS - viewable by anyone"
