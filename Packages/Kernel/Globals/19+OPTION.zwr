^DIC(19,15218,"U")="PRINT SERVICE CONSULTS BY STAT"
^DIC(19,15219,0)="EHM-00040^Print Consults by Provider, Location, or Procedure^^R^1^^^^^^^^^^^"
^DIC(19,15219,1,0)="^^10^10^3240328^"
^DIC(19,15219,1,1,0)="This option will compile a list of consult requests based on Provider,"
^DIC(19,15219,1,2,0)="Location, or Procedure search criteria. Date range, status, and output"
^DIC(19,15219,1,3,0)="formats are selectable parameters."
^DIC(19,15219,1,4,0)=" "
^DIC(19,15219,1,5,0)="There are additional prompts for selection of local, remote, or both local"
^DIC(19,15219,1,6,0)="and remote Provider(s) and Location(s). For the purposes of this "
^DIC(19,15219,1,7,0)="option, ""local"" refers to non-Inter-facility requests and Inter-facility"
^DIC(19,15219,1,8,0)="requests originating locally; ""remote"" only refers to Inter-facility"
^DIC(19,15219,1,9,0)="requests originating at another site."
^DIC(19,15219,1,10,0)="Cloned from ""GMRC PRINT BY SEARCH"" option."
^DIC(19,15219,3)=""
^DIC(19,15219,25)="EN^GMRCPSL1"
^DIC(19,15219,99)="58686,53687"
^DIC(19,15219,"U")="PRINT CONSULTS BY PROVIDER, LO"
^DIC(19,15220,0)="EHM-00041^IFC Requests^^R^1^^^^^^^294^^^^"
^DIC(19,15220,1,0)="^^30^30^3240328^"
^DIC(19,15220,1,1,0)="This option provides detailed information regarding inter-facility "
^DIC(19,15220,1,2,0)="consults."
^DIC(19,15220,1,3,0)=" "
^DIC(19,15220,1,4,0)="If not specified, all status' are utilized."
^DIC(19,15220,1,5,0)=" "
^DIC(19,15220,1,6,0)="""Routing Facility"" data: If selecting requesting site information, this "
^DIC(19,15220,1,7,0)="refers to the facility the consult is sent to; if selecting consulting "
^DIC(19,15220,1,8,0)="site information, this refers to the facility the consult is sent from."
^DIC(19,15220,1,9,0)=" "
^DIC(19,15220,1,10,0)="""Days Diff"" data: This refers to the (whole number) of days difference "
^DIC(19,15220,1,11,0)="between the COMPLETE activity date/time and one of the following activity "
^DIC(19,15220,1,12,0)="date/time (if one doesn't exist, retrieve the next): RECEIVED, ENTERED IN "
^DIC(19,15220,1,13,0)="CPRS, SERVICE ENTERED, FILE ENTRY DATE. All date/time data must be in the"
^DIC(19,15220,1,14,0)="range selected. Field REMOTE ACTIVITY TIME ZONE is NOT figured into the"
^DIC(19,15220,1,15,0)="calculations."
^DIC(19,15220,1,16,0)=" "
^DIC(19,15220,1,17,0)="""Rec Date"" data: For IFC consulting site report requests only, the option"
^DIC(19,15220,1,18,0)="checks for DATE/TIME OF ACTION ENTRY for activity of REMOTE REQUEST"
^DIC(19,15220,1,19,0)="RECEIVED, and if that doesn't exist it checks for DATE/TIME OF ACTION"
^DIC(19,15220,1,20,0)="ENTRY for the activity of RECEIVED. Only date is listed in the report."
^DIC(19,15220,1,21,0)=" "
^DIC(19,15220,1,22,0)="""Mean Days Completed To Service <service> @ <facility>"" data: For only "
^DIC(19,15220,1,23,0)="those entries in which Days Diff exists, this calculation for each service"
^DIC(19,15220,1,24,0)="at each routing facility is: Days Diff total divided by Number of Days"
^DIC(19,15220,1,25,0)="Diff values."
^DIC(19,15220,1,26,0)=" "
^DIC(19,15220,1,27,0)="""Mean Days Completed To Service <service>"" data: For only those entries in"
^DIC(19,15220,1,28,0)="which Days Diff exists, this calculation for each service is: Days Diff"
^DIC(19,15220,1,29,0)="total divided by Number of Days Diff values."
^DIC(19,15220,1,30,0)="Cloned from ""GMRC IFC RPT CONSULTS"" option."
^DIC(19,15220,3)=""
^DIC(19,15220,25)="EN^GMRCIR"
^DIC(19,15220,"U")="IFC REQUESTS"
^DIC(19,15221,0)="EHM-00042^Print IFC Requests^^R^1^^^^^^^294^^^^"
^DIC(19,15221,1,0)="^^4^4^3240328^"
^DIC(19,15221,1,1,0)="Sends the Inter-facility Consult Requests report to a device without going"
^DIC(19,15221,1,2,0)="through the List Manager display of the report and waiting for the list to"
^DIC(19,15221,1,3,0)="be built."
^DIC(19,15221,1,4,0)="Cloned from ""GMRC IFC PRINT RPT NUMBERED"" option."
^DIC(19,15221,3)=""
^DIC(19,15221,25)="PRNTONLY^GMRCIR(120)"
^DIC(19,15221,"U")="PRINT IFC REQUESTS"
^DIC(19,15222,0)="EHM-00043^IFC Requests By Patient^^R^1^^^^^^^294^^1^1^"
^DIC(19,15222,1,0)="^^6^6^3240328^"
^DIC(19,15222,1,1,0)="This option provides actions which a service may use to track "
^DIC(19,15222,1,2,0)="inter-facility consults and requests.  "
^DIC(19,15222,1,3,0)="   "
^DIC(19,15222,1,4,0)="The processing flow is similiar to the OE/RR review screen.  Most of the"
^DIC(19,15222,1,5,0)="actions have the same mnemonics as OE/RR for clinician familiarity."
^DIC(19,15222,1,6,0)="Cloned from ""GMRC IFC RPT CONSULTS BY PT"" option."
^DIC(19,15222,3)=""
^DIC(19,15222,15)="K GMRCIS D ^GMRCREXT"
^DIC(19,15222,20)="S GMRCIS="""""
^DIC(19,15222,25)="EN^GMRCSLM"
^DIC(19,15222,"U")="IFC REQUESTS BY PATIENT"
^DIC(19,15223,0)="EHM-00044^IFC Requests by Remote Ordering Provider^^R^1^^^^^^^294^^1^1^"
^DIC(19,15223,1,0)="^^3^3^3240328^"
^DIC(19,15223,1,1,0)="This option provides detailed information regarding inter-facility"
^DIC(19,15223,1,2,0)="consults by remote ordering provider for consulting sites to utilize."
^DIC(19,15223,1,3,0)="Cloned from ""GMRC IFC RPT CONSULTS BY REMPR"" option."
^DIC(19,15223,3)=""
^DIC(19,15223,15)="K GMRCREMP,GMRCRF"
^DIC(19,15223,20)="S (GMRCREMP,GMRCRF)="""""
^DIC(19,15223,25)="EN^GMRCIR"
^DIC(19,15223,"U")="IFC REQUESTS BY REMOTE ORDERIN"
^DIC(19,15224,0)="EHM-00045^Consult Performance Monitor Report^^R^1^^^^^^^294^^^^"
^DIC(19,15224,1,0)="^^53^53^3240328^"
^DIC(19,15224,1,1,0)="This report provides data to be submitted for the National Performance "
^DIC(19,15224,1,2,0)="Monitor."
^DIC(19,15224,1,3,0)=" "
^DIC(19,15224,1,4,0)="Report Column Headers "
^DIC(19,15224,1,5,0)="""Within Facility"" - requests that originate and are completed locally."
^DIC(19,15224,1,6,0)="""IFC Sent"" - requests sent to another facility via IFC software."
^DIC(19,15224,1,7,0)="""IFC Rec'd"" - requests originating from another facility via IFC software."
^DIC(19,15224,1,8,0)=" "
^DIC(19,15224,1,9,0)="Report Row Headers"
^DIC(19,15224,1,10,0)="""All Requests in 30 Days Before the Start/End of Qtr"" - Total of all "
^DIC(19,15224,1,11,0)=" requests in the REQUEST/CONSULTATION file with a CPRS STATUS of Complete,"
^DIC(19,15224,1,12,0)=" Pending, Active, Scheduled and Partial Results and the DATE OF REQUEST "
^DIC(19,15224,1,13,0)=" occurs in a date range of 30 days before the start of the fiscal quarter "
^DIC(19,15224,1,14,0)=" and 30 days before the end of the fiscal quarter."
^DIC(19,15224,1,15,0)="""All Requests in 60 Days Before the Start/End of Qtr"" - Same as above only"
^DIC(19,15224,1,16,0)=" the date range is expanded to 60 days."
^DIC(19,15224,1,17,0)="""Complete w/Results in 30 Days of Request"" - Of the requests occurring in "
^DIC(19,15224,1,18,0)=" the 30 day before the start/end of the quarter range, the total of those"
^DIC(19,15224,1,19,0)=" that are Complete and have results attached."
^DIC(19,15224,1,20,0)="""Complete w/Results 31-60 Days of Request"" - Similar to above except using"
^DIC(19,15224,1,21,0)=" the 60 day before the start/end of the quarter range."
^DIC(19,15224,1,22,0)="""All Requests Created Before Qtr Start"" - Total entries in "
^DIC(19,15224,1,23,0)=" REQUEST/CONSULATION file where the DATE OF REQUEST occurs before the date"
^DIC(19,15224,1,24,0)=" which is 60 days before the start of the fiscal quarter for which "
^DIC(19,15224,1,25,0)=" reporting."
^DIC(19,15224,1,26,0)="""All Requests Pending Before Qtr Start"" - Total entries in above that are "
^DIC(19,15224,1,27,0)=" still considered to be pending - the CPRS STATUS value is Hold, Flagged, "
^DIC(19,15224,1,28,0)=" Pending, Scheduled, Partial Results, Unreleased, or No Status."
^DIC(19,15224,1,29,0)="""Percent Complete w/Results in 30 Days of Request"" - Complete w/Results "
^DIC(19,15224,1,30,0)=" in 30 Days of Request / All Requests in 30 Days Before the Start/End of"
^DIC(19,15224,1,31,0)=" Qtr"
^DIC(19,15224,1,32,0)="""Percent Complete w/Results 31-60 Days of Request"" - Complete w/Results "
^DIC(19,15224,1,33,0)=" in 31-60 Days of Request / All Requests in 60 Days Before the Start/End"
^DIC(19,15224,1,34,0)=" of Qtr"
^DIC(19,15224,1,35,0)="""Percent Still Pending Created Before Qtr Start"" - All Requests Pending "
^DIC(19,15224,1,36,0)=" Before Qtr Start / All Requests Created Before Qtr Start"
^DIC(19,15224,1,37,0)=" "
^DIC(19,15224,1,38,0)="Report Exclusions:"
^DIC(19,15224,1,39,0)="-Requests sent to test patients."
^DIC(19,15224,1,40,0)="-Requests not marked as Outpatient in the REQUEST/CONSULTATION file."
^DIC(19,15224,1,41,0)="-Services flagged as part of the interface between Consults/Request "
^DIC(19,15224,1,42,0)="  Tracking and Prosthetics."
^DIC(19,15224,1,43,0)="-Administrative requests flagged via the Administrative fields in the"
^DIC(19,15224,1,44,0)="  REQUEST SERVICES and REQUEST/CONSULTATION files. This is not retroactive"
^DIC(19,15224,1,45,0)="  and only applies to services/requests leveraging the Admin-flagging"
^DIC(19,15224,1,46,0)="  capability included in the FY08 performance monitor report update,"
^DIC(19,15224,1,47,0)="  GMRC*3.0*60."
^DIC(19,15224,1,48,0)=" "
^DIC(19,15224,1,49,0)="The report utilizes the DATE OF REQUEST field from the "
^DIC(19,15224,1,50,0)=" REQUEST/CONSULTATION file to determine request totals for a given date "
^DIC(19,15224,1,51,0)=" range.  This is true even for requests that have been re-submitted using "
^DIC(19,15224,1,52,0)=" the Edit/Resubmit functionality."
^DIC(19,15224,1,53,0)="Cloned from ""GMRC RPT PERF MONITOR"" option."
^DIC(19,15224,3)=""
^DIC(19,15224,25)="EN^GMRCSTL7"
^DIC(19,15224,"U")="CONSULT PERFORMANCE MONITOR RE"
^DIC(19,15225,0)="EHM-00046^Service Consults Schedule-Management Report^^R^1^^^^^^^294^^^^"
^DIC(19,15225,1,0)="^19.06^6^6^3240328^^^^"
^DIC(19,15225,1,1,0)="The SERVICE CONSULTS SCHEDULE-MANAGEMENT REPORT will provide individual "
^DIC(19,15225,1,2,0)="listings of all consults within a time frame and/or a summary listing."
^DIC(19,15225,1,3,0)="The report will identify patients placed on the Electronic Wait List"
^DIC(19,15225,1,4,0)="after the initializing date/time of the consult for a SERVICE with the"
^DIC(19,15225,1,5,0)="same Stop Code as the consult."
^DIC(19,15225,1,6,0)="Cloned from ""GMRC RPT SD SCH-MGT CONSULTS"" option."
^DIC(19,15225,3)=""
^DIC(19,15225,25)="EN^GMRCONS1"
^DIC(19,15225,"U")="SERVICE CONSULTS SCHEDULE-MANA"
^DIC(19,15226,0)="EHM-00047^Consults Local Completion Rate^^R^1^^^^^^^294^^^^"
^DIC(19,15226,1,0)="^^17^17^3240328^"
^DIC(19,15226,1,1,0)="This report will provide the local sites with an option to generate a"
^DIC(19,15226,1,2,0)="report listing consults requested, consults completed, consult completion"
^DIC(19,15226,1,3,0)="rates, completed consults with results attached and rate of completed"
^DIC(19,15226,1,4,0)="consults with results attached for a user determined date range."
^DIC(19,15226,1,5,0)=" "
^DIC(19,15226,1,6,0)="For completed consults with results attached, the report includes those "
^DIC(19,15226,1,7,0)="consults that have results attached either in the TIU, Medicine or "
^DIC(19,15226,1,8,0)="Clinical Procedures applications."
^DIC(19,15226,1,9,0)=" "
^DIC(19,15226,1,10,0)="Excluded from the report are: Prosthetics consults, Consults with a status"
^DIC(19,15226,1,11,0)="of Cancelled or Discontinued, and Inter-facility Consults (IFC) requests"
^DIC(19,15226,1,12,0)="where the reporting site is the sending site for the IFC."
^DIC(19,15226,1,13,0)=" "
^DIC(19,15226,1,14,0)="The report can be run in a summary format to view on screen or print and "
^DIC(19,15226,1,15,0)="a comma delimited format for importing into in spreadsheet and/or database"
^DIC(19,15226,1,16,0)="software."
^DIC(19,15226,1,17,0)="Cloned from ""GMRC RPT LOCAL COMPLETE RATE"" option."
^DIC(19,15226,3)=""
^DIC(19,15226,25)="EN^GMRCSTLA"
^DIC(19,15226,"U")="CONSULTS LOCAL COMPLETION RATE"
^DIC(19,15227,0)="EHM-00048^Administratively Released Consults by Title^^R^1^^^^^^n^294^^^^^1"
^DIC(19,15227,1,0)="^^6^6^3240328^"
^DIC(19,15227,1,1,0)="The ADMINISTRATIVELY RELEASED CONSULTS BY TITLE report displays counts of "
^DIC(19,15227,1,2,0)="the number of consults created by the OR ADMIN RBP TO CC security key "
^DIC(19,15227,1,3,0)="(ADMIN key) and ADMINISTRATIVELY RELEASED BY POLICY. The user will enter "
^DIC(19,15227,1,4,0)="a date range, and the report will be sorted by Consult Title (Request "
^DIC(19,15227,1,5,0)="Service name)."
^DIC(19,15227,1,6,0)="Cloned from ""GMRC RPT ADMIN RELEASE CONSULT"" option."
^DIC(19,15227,3)=""
^DIC(19,15227,10.1)="Admin Released Consult"
^DIC(19,15227,25)="EN^GMRCAD"
^DIC(19,15227,26)="D HDR^GMRCAD"
^DIC(19,15227,"U")="ADMINISTRATIVELY RELEASED CONS"
^DIC(19,15228,0)="EHM-00049^Administratively Released Consults by User^^R^1^^^^^^n^294^^^1^^1"
^DIC(19,15228,1,0)="^^5^5^3240328^"
^DIC(19,15228,1,1,0)="The ADMINISTRATIVELY RELEASED CONSULTS BY USER report displays counts of "
^DIC(19,15228,1,2,0)="the number of consults created by the OR ADMIN RBP TO CC security key "
^DIC(19,15228,1,3,0)="(ADMIN key) and ADMINISTRATIVELY RELEASED BY POLICY. The user will enter "
^DIC(19,15228,1,4,0)="a date range, and the report will be sorted by User."
^DIC(19,15228,1,5,0)="Cloned from ""GMRC RPT ADMIN REL CONS USER"" option."
^DIC(19,15228,3)=""
^DIC(19,15228,10.1)="Admin Rel Consult by User"
^DIC(19,15228,15)="D EXIT^GMRCADU"
^DIC(19,15228,20)=""
^DIC(19,15228,25)="EN^GMRCADU"
^DIC(19,15228,26)="D HDR^GMRCADU"
^DIC(19,15228,99)="64838,40926"
^DIC(19,15228,"U")="ADMINISTRATIVELY RELEASED CONS"
^DIC(19,15229,0)="EHM-00050^Administratively Released Consults by Group^^R^1^^^^^^n^294^^^1^^1"
^DIC(19,15229,1,0)="^^6^6^3240328^"
^DIC(19,15229,1,1,0)="The ADMINISTRATIVELY RELEASED CONSULTS BY GROUP report displays counts of "
^DIC(19,15229,1,2,0)="the number of consults created by the OR ADMIN RBP TO CC security key "
^DIC(19,15229,1,3,0)="(ADMIN key) and ADMINISTRATIVELY RELEASED BY POLICY. The user will enter "
^DIC(19,15229,1,4,0)="a date range, and the report will be sorted by Consult Group (DS or "
^DIC(19,15229,1,5,0)="ADMIN)."
^DIC(19,15229,1,6,0)="Cloned from ""GMRC RPT ADMIN REL CONS GROUPR"" option."
^DIC(19,15229,3)=""
^DIC(19,15229,10.1)="Admin Rel Consult by Grouper"
^DIC(19,15229,15)="D EXIT^GMRCADG"
^DIC(19,15229,20)=""
^DIC(19,15229,25)="EN^GMRCADG"
^DIC(19,15229,26)="D HDR^GMRCADG"
^DIC(19,15229,"U")="ADMINISTRATIVELY RELEASED CONS"
^DIC(19,15230,0)="EHM-00051^Print Test Page^^R^1^^^^^^^294^^^^"
^DIC(19,15230,1,0)="^^5^5^3240328^"
^DIC(19,15230,1,1,0)="This option allows a user to select a printer for reviewing print"
^DIC(19,15230,1,2,0)="parameters. A report is generated which includes the current device print"
^DIC(19,15230,1,3,0)="parameters and a ruler to verify the length of the current print page. A"
^DIC(19,15230,1,4,0)="description of how to use the ruler is included in the report."
^DIC(19,15230,1,5,0)="Cloned from ""GMRC PRINT TEST PAGE"" option."
^DIC(19,15230,3)=""
^DIC(19,15230,25)="SETUP^GMRCP5"
^DIC(19,15230,"U")="PRINT TEST PAGE"
^DIC(19,15231,0)="EHM-00052^Group update of consult/procedure requests^^R^1^^^^^^^294^^^^"
^DIC(19,15231,1,0)="^^17^17^3240328^"
^DIC(19,15231,1,1,0)="This option will allow a search of the REQUEST/CONSULTATION (#123) file "
^DIC(19,15231,1,2,0)="for requests to a particular service within a date range. The status of"
^DIC(19,15231,1,3,0)="the entries meeting the selected criteria may be updated to COMPLETE or"
^DIC(19,15231,1,4,0)="DISCONTINUED. A comment of up to 256 characters may be entered once and"
^DIC(19,15231,1,5,0)="attached to each of the entries. "
^DIC(19,15231,1,6,0)=" "
^DIC(19,15231,1,7,0)="A report of those records to be updated may be printed without performing"
^DIC(19,15231,1,8,0)="the status updates. The option also allows printing of the records along"
^DIC(19,15231,1,9,0)="with the status updates."
^DIC(19,15231,1,10,0)=" "
^DIC(19,15231,1,11,0)="The status of the corresponding order in CPRS will be updated to match"
^DIC(19,15231,1,12,0)="that in file 123."
^DIC(19,15231,1,13,0)=" "
^DIC(19,15231,1,14,0)="Only the user entered in the SPECIAL UPDATES INDIVIDUAL field #123.5 of"
^DIC(19,15231,1,15,0)="the REQUEST SERVICES (#123.5) file will be allowed to perform the updates"
^DIC(19,15231,1,16,0)="for the chosen service."
^DIC(19,15231,1,17,0)="Cloned from ""GMRCSTSU"" option."
^DIC(19,15231,3)=""
^DIC(19,15231,25)="GMRCSTS"
^DIC(19,15231,"U")="GROUP UPDATE OF CONSULT/PROCED"
^DIC(19,15232,0)="EHM-00053^Determine users' update authority^^R^1^^^^^^^294^^1^^"
^DIC(19,15232,1,0)="^^3^3^3240328^^"
^DIC(19,15232,1,1,0)="This option will determine a selected user's update authority for a"
^DIC(19,15232,1,2,0)="selected service in the consult hierarchy."
^DIC(19,15232,1,3,0)="Cloned from ""GMRC UPDATE AUTHORITY"" option."
^DIC(19,15232,3)=""
^DIC(19,15232,20)="D TSTINTRO^GMRCAU"
^DIC(19,15232,25)="TEST^GMRCAU"
^DIC(19,15232,"U")="DETERMINE USERS' UPDATE AUTHOR"
^DIC(19,15233,0)="EHM-00054^Determine if user is notification recipient^^R^1^^^^^^^294^^1^^"
^DIC(19,15233,1,0)="^^3^3^3240328^^"
^DIC(19,15233,1,1,0)="This option will determine if a user would be a notification recipient"
^DIC(19,15233,1,2,0)="for a selected service."
^DIC(19,15233,1,3,0)="Cloned from ""GMRC USER NOTIFICATION"" option."
^DIC(19,15233,3)=""
^DIC(19,15233,20)="D TSTINTRO^GMRCT"
^DIC(19,15233,25)="TEST^GMRCT"
^DIC(19,15233,99)="57911,75462"
^DIC(19,15233,"U")="DETERMINE IF USER IS NOTIFICAT"
^DIC(19,15234,0)="EHM-00055^Determine notification recipients for a service^^R^1^^^^^^^294^^^^"
^DIC(19,15234,1,0)="^19.06^1^1^3240328^^^^"
^DIC(19,15234,1,1,0)="Cloned from ""GMRC NOTIFICATION RECIPS"" option."
^DIC(19,15234,3)=""
^DIC(19,15234,25)="EN^GMRCNOTF"
^DIC(19,15234,"U")="DETERMINE NOTIFICATION RECIPIE"
^DIC(19,15235,0)="EHM-00056^Duplicate Sub-Service^^R^1^^^^^^^294^^^^"
^DIC(19,15235,1,0)="^^3^3^3240328^"
^DIC(19,15235,1,1,0)="This check if any Consult/Request Tracking REQUEST SERVICES (file #123.5)"
^DIC(19,15235,1,2,0)="are Sub-Services of more than one Service."
^DIC(19,15235,1,3,0)="Cloned from ""GMRC DUPLICATE SUB-SERVICE"" option."
^DIC(19,15235,3)=""
^DIC(19,15235,25)="EN^GMRCSUBS"
^DIC(19,15235,"U")="DUPLICATE SUB-SERVICE"
^DIC(19,15236,0)="EHM-00057^Test Default Reason for Request^^R^1^^^^^^^294^^^^"
^DIC(19,15236,1,0)="^^9^9^3240328^"
^DIC(19,15236,1,1,0)="This option will allow the Clinical Coordinator or IRM to test the default"
^DIC(19,15236,1,2,0)="reason for request for a given service or procedure without placing an"
^DIC(19,15236,1,3,0)="order."
^DIC(19,15236,1,4,0)=" "
^DIC(19,15236,1,5,0)="This option prompts for the selection of a procedure or a service from the"
^DIC(19,15236,1,6,0)="consult hierarchy and a patient name. The default reason will be presented"
^DIC(19,15236,1,7,0)="based on the selected patient in a list manager format. This format allows"
^DIC(19,15236,1,8,0)="searching, printing etc. "
^DIC(19,15236,1,9,0)="Cloned from ""GMRC TEST DEFAULT REASON"" option."
^DIC(19,15236,3)=""
^DIC(19,15236,25)="EN^GMRCDRFR"
^DIC(19,15236,"U")="TEST DEFAULT REASON FOR REQUES"
^DIC(19,15237,0)="EHM-00058^List Consult Service Hierarchy^^R^1^^^^^^^294^^^^"
^DIC(19,15237,1,0)="^^5^5^3240328^"
^DIC(19,15237,1,1,0)="This option will allow the Consult Service hierarchy to be printed. The"
^DIC(19,15237,1,2,0)="listing will include all disabled and tracking only services. Any services"
^DIC(19,15237,1,3,0)="in the REQUEST SERVICES (#123.5) file that are not part of the hierarchy"
^DIC(19,15237,1,4,0)="will be listed at the end. "
^DIC(19,15237,1,5,0)="Cloned from ""GMRC LIST HIERARCHY"" option."
^DIC(19,15237,3)=""
^DIC(19,15237,25)="LISTOPT^GMRCASV"
^DIC(19,15237,"U")="LIST CONSULT SERVICE HIERARCHY"
^DIC(19,15238,0)="EHM-00059^Copy Prosthetics services^^R^1^^^^^^^294^^^^"
^DIC(19,15238,1,0)="^^5^5^3240328^"
^DIC(19,15238,1,1,0)="This option allows the copying of one of the nationally exported"
^DIC(19,15238,1,2,0)="Prosthetics services. These services have specific data in certain fields"
^DIC(19,15238,1,3,0)="that are critical to the interface between Consult/Request Tracking and"
^DIC(19,15238,1,4,0)="Prosthetics."
^DIC(19,15238,1,5,0)="Cloned from ""GMRC CLONE PROSTHETICS"" option."
^DIC(19,15238,3)=""
^DIC(19,15238,25)="CLONPSAS^GMRCSRVS"
^DIC(19,15238,"U")="COPY PROSTHETICS SERVICES"
^DIC(19,15239,0)="EHM-00060^Setup procedures^^R^1^^^^^^^294^^^^"
^DIC(19,15239,1,0)="^19.06^1^1^3240328^^^^"
^DIC(19,15239,1,1,0)="Cloned from ""GMRC PROCEDURE SETUP"" option."
^DIC(19,15239,3)=""
^DIC(19,15239,25)="EN^GMRC1233"
^DIC(19,15239,"U")="SETUP PROCEDURES"
^DIC(19,15240,0)="EHM-00061^IFC Management Menu^^M^1^^^^^^^294^^^^"
^DIC(19,15240,1,0)="^19.06^3^3^3240328^^^^"
^DIC(19,15240,1,1,0)="This menu contains a collection of options used to implement and manage "
^DIC(19,15240,1,2,0)="the Inter-facility Consults interface."
^DIC(19,15240,1,3,0)="Cloned from ""GMRC IFC MGMT"" option."
^DIC(19,15240,3)=""
^DIC(19,15240,10,0)="^19.01IP^13^13"
^DIC(19,15240,10,1,0)="15241^IFC^3"
^DIC(19,15240,10,2,0)="15242^LI^2"
^DIC(19,15240,10,3,0)="15243^TI^1"
^DIC(19,15240,10,4,0)="15244^TR^4"
^DIC(19,15240,10,5,0)="15245^LK^5"
^DIC(19,15240,10,6,0)="15246^PI"
^DIC(19,15240,10,7,0)="15247^IP"
^DIC(19,15240,10,8,0)="15248^IR"
^DIC(19,15240,10,9,0)="15249^BK^6"
^DIC(19,15240,10,10,0)="15250^MP"
^DIC(19,15240,10,11,0)="15251^AI"
^DIC(19,15240,10,12,0)="15252^EP"
^DIC(19,15240,10,13,0)="15253^EC^7"
^DIC(19,15240,10,"B",15241,1)=""
^DIC(19,15240,10,"B",15242,2)=""
^DIC(19,15240,10,"B",15243,3)=""
^DIC(19,15240,10,"B",15244,4)=""
^DIC(19,15240,10,"B",15245,5)=""
^DIC(19,15240,10,"B",15246,6)=""
^DIC(19,15240,10,"B",15247,7)=""
^DIC(19,15240,10,"B",15248,8)=""
^DIC(19,15240,10,"B",15249,9)=""
^DIC(19,15240,10,"B",15250,10)=""
