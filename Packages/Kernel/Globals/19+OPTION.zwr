^DIC(19,14905,0)="DG OTH FSM ELIG. CHANGE REPORT^Former OTH Patient Eligibility Change Report^^R^1^^^^^^^"
^DIC(19,14905,1,0)="^19.06^5^5^3200713^^^"
^DIC(19,14905,1,1,0)="Assist users in reviewing past encounters of Former Service Member for "
^DIC(19,14905,1,2,0)="potential back-billing charges. This report provides data for all Former "
^DIC(19,14905,1,3,0)="OTH Service Member whose primary eligibility changed from EXPANDED MH "
^DIC(19,14905,1,4,0)="CARE NON-ENROLLEE to their verified/determined (VBA) primary eligibility "
^DIC(19,14905,1,5,0)="within a user specified date range."
^DIC(19,14905,25)="MAIN^DGOTHFSM"
^DIC(19,14905,"U")="FORMER OTH PATIENT ELIGIBILITY"
^DIC(19,14906,0)="DG OTH FSM DETAIL REPORT^Former OTH Patient Detail Report^^R^1^^^^^^^"
^DIC(19,14906,1,0)="^^3^3^3200805^"
^DIC(19,14906,1,1,0)="This option assist users in reviewing Former Service Members for"
^DIC(19,14906,1,2,0)="potential back-billing charges so veteran customer will be billed"
^DIC(19,14906,1,3,0)="appropriately."
^DIC(19,14906,25)="MAIN^DGOTHFS2"
^DIC(19,14906,"U")="FORMER OTH PATIENT DETAIL REPO"
^DIC(19,14907,0)="PREA AMPL GUI^AMPL GUI option^^B^1^^^^^^^589"
^DIC(19,14907,1,0)="^^3^3^3200812^"
^DIC(19,14907,1,1,0)="The purpose of this option is to serve as the context option for the "
^DIC(19,14907,1,2,0)="ADVANCED MEDICATION PLATFORM entry in the REMOTE APPLICATION (#8994.5) "
^DIC(19,14907,1,3,0)="File."
^DIC(19,14907,"U")="AMPL GUI OPTION"
^DIC(19,14908,0)="YSCL HL7 MAIN^Clozapine HL7 Transmission Options^^M^1^^^^^^^"
^DIC(19,14908,1,0)="^^8^8^3200508^"
^DIC(19,14908,1,1,0)="This menu can be placed on the Secondary Menu of site staff that are "
^DIC(19,14908,1,2,0)="involved in the National Clozapine Registry (NCR).  The options will "
^DIC(19,14908,1,3,0)="allow for monitoring the status of the HL7 transmissions to the NCR."
^DIC(19,14908,1,4,0)=" "
^DIC(19,14908,1,5,0)="The suggested synonym for this menu is 'YHL7' when adding it to a user's "
^DIC(19,14908,1,6,0)="Secondary Menu.  Holders of the PSOLOCKCLOZ and YSCL AUTHORIZED security "
^DIC(19,14908,1,7,0)="keys may need access to this menu, as well as other Mental Health and "
^DIC(19,14908,1,8,0)="Pharmacy staff at the site."
^DIC(19,14908,10,0)="^19.01IP^6^6"
^DIC(19,14908,10,2,0)="14913^^50"
^DIC(19,14908,10,3,0)="14909^^40"
^DIC(19,14908,10,4,0)="14910^^10"
^DIC(19,14908,10,5,0)="14911^^30"
^DIC(19,14908,10,6,0)="14912^^20"
^DIC(19,14908,10,"B",14909,3)=""
^DIC(19,14908,10,"B",14910,4)=""
^DIC(19,14908,10,"B",14911,5)=""
^DIC(19,14908,10,"B",14912,6)=""
^DIC(19,14908,10,"B",14913,2)=""
^DIC(19,14908,99)="66282,85161"
^DIC(19,14908,"U")="CLOZAPINE HL7 TRANSMISSION OPT"
^DIC(19,14909,0)="YSCL HL7 QUEUE TRANSMISSION^Queue Clozapine Rx HL7 Messages^^R^1^^^^^^^"
^DIC(19,14909,1,0)="^^8^8^3200303^"
^DIC(19,14909,1,1,0)="This option will schedule the HL7 messages to be sent for Clozapine "
^DIC(19,14909,1,2,0)="prescriptions.  It will perform the same logic as the Daily Clozapine"
^DIC(19,14909,1,3,0)="Transmission [YSCL DAILY TRANSMISSION] option. The message transmission"
^DIC(19,14909,1,4,0)="will be scheduled to run immediately."
^DIC(19,14909,1,5,0)=" "
^DIC(19,14909,1,6,0)="*Note: HL7 messages that have already been sent to the NCR for a Clozapine"
^DIC(19,14909,1,7,0)="prescription or order will NOT be re-sent.  A log of the HL7 messages is "
^DIC(19,14909,1,8,0)="kept in the CLOZAPINE HL7 TRANSMISSION file (#603.05)."
^DIC(19,14909,25)="ASK2QUE^YSCLHLOP"
^DIC(19,14909,"U")="QUEUE CLOZAPINE RX HL7 MESSAGE"
^DIC(19,14910,0)="YSCL HL7 STATUS REPORT^Clozapine HL7 Messages Summary^^R^1^^^^^^^"
^DIC(19,14910,1,0)="^^2^2^3200303^"
^DIC(19,14910,1,1,0)="This option will print a summary report for Clozapine HL7 message"
^DIC(19,14910,1,2,0)="transmission to the National Clozapine Registry (NCR)."
^DIC(19,14910,25)="HL7SMRY^YSCLHLPR"
^DIC(19,14910,"U")="CLOZAPINE HL7 MESSAGES SUMMARY"
^DIC(19,14911,0)="YSCL HL7 REPORT BY DATE^Print HL7 Report by Date^^R^1^^^^^^^"
^DIC(19,14911,1,0)="^^2^2^3200401^"
^DIC(19,14911,1,1,0)="Use this option to print entries from the CLOZAPINE HL7 TRANSMISSION file "
^DIC(19,14911,1,2,0)="(#603.05). You must specify the date range for the report."
^DIC(19,14911,25)="RPTBYDT^YSCLHLPR"
^DIC(19,14911,"U")="PRINT HL7 REPORT BY DATE"
^DIC(19,14912,0)="YSCL HL7 LIST CLOZAPINE RXS^List of Clozapine Prescriptions^^R^1^^^^^^^"
^DIC(19,14912,1,0)="^^4^4^3200428^"
^DIC(19,14912,1,1,0)="This will provide a list of all Clozapine prescriptions for a selected "
^DIC(19,14912,1,2,0)="range of fill dates.  A brief listing of each prescription is shown,"
^DIC(19,14912,1,3,0)="which includes the drug, the prescription status, the issue date, and the "
^DIC(19,14912,1,4,0)="fill date."
^DIC(19,14912,25)="RXBYDT^YSCLHLPR"
^DIC(19,14912,"U")="LIST OF CLOZAPINE PRESCRIPTION"
^DIC(19,14913,0)="YSCL HL7 CLOZ RETRANSMIT^Retransmit Clozapine Rx HL7 Messages^^R^1^^^^^^^166"
^DIC(19,14913,1,0)="^^7^7^3200303^"
^DIC(19,14913,1,1,0)="This option can be used to retransmit HL7 messages to the National"
^DIC(19,14913,1,2,0)="Clozapine Registry (NCR) which is maintained by the National Clozapine"
^DIC(19,14913,1,3,0)="Coordinating Center (NCCC). "
^DIC(19,14913,1,4,0)=" "
^DIC(19,14913,1,5,0)="*Note: This option will cause messages to be transmitted for all active"
^DIC(19,14913,1,6,0)="Clozapine prescriptions and orders. This may send duplicate HL7 messages"
^DIC(19,14913,1,7,0)="to the NCR."
^DIC(19,14913,25)="RETRHL7^YSCLHLOP"
^DIC(19,14913,"U")="RETRANSMIT CLOZAPINE RX HL7 ME"
^DIC(19,14914,0)="YSCL HL7 CLOZ TRANSMISSION^Transmit Clozapine Rx HL7 Messages^^R^1^^^^^^^166"
^DIC(19,14914,1,0)="^^12^12^3200508^"
^DIC(19,14914,1,1,0)="This option is to be queued via TaskMan to run daily in off-hours."
^DIC(19,14914,1,2,0)=" "
^DIC(19,14914,1,3,0)="It transmits HL7 messages to the National Clozapine Registry (NCR), which "
^DIC(19,14914,1,4,0)="is maintained by the National Clozapine Coordinating Center (NCCC). The"
^DIC(19,14914,1,5,0)="task should be scheduled to run so that it completes before 5:00 AM"
^DIC(19,14914,1,6,0)="Eastern time.  It should only take a few minutes to transmit the HL7"
^DIC(19,14914,1,7,0)="messages."
^DIC(19,14914,1,8,0)=" "
^DIC(19,14914,1,9,0)="The starting and ending times are stored in the CLOZAPINE PARAMETERS file "
