^DIC(19,13722,"U")="BATCH WORK LIST"
^DIC(19,13723,0)="PSA RET DRG MENU^Return Drug Credit Menu^^M^1^^^^^^^287"
^DIC(19,13723,1,0)="^19.06^4^4^3080716^^^^"
^DIC(19,13723,1,1,0)="This option provides sites with a means to improve internal control of"
^DIC(19,13723,1,2,0)="credits received for returned drugs. It will track drugs returned and"
^DIC(19,13723,1,3,0)="their status over time as they are picked up by the contracting company."
^DIC(19,13723,1,4,0)="It will also provide summary and detailed reports of all return drugs."
