^DIC(19,3322,10,"C","REF",14)=""
^DIC(19,3322,99)="66544,63933"
^DIC(19,3322,99.1)="60532,36126"
^DIC(19,3322,"U")="RADIOLOGY/NUCLEAR MED ORDER EN"
^DIC(19,3323,0)="RA ORDEREXAM^Request an Exam^^R^11712^^^^^^^^^1^1"
^DIC(19,3323,1,0)="^^3^3^2940606^"
^DIC(19,3323,1,1,0)="This option allows the user to order one or more procedures"
^DIC(19,3323,1,2,0)="for a patient. Once the request has been entered, the request is assigned"
^DIC(19,3323,1,3,0)="a status of 'pending'."
^DIC(19,3323,15)="K RAOPT(""ORDEREXAM"")"
^DIC(19,3323,20)="S RAOPT(""ORDEREXAM"")="""""
^DIC(19,3323,25)="RAORD1"
^DIC(19,3323,99)="55544,45494"
^DIC(19,3323,99.1)="56984,50944"
^DIC(19,3323,"U")="REQUEST AN EXAM"
^DIC(19,3324,0)="RA ORDERSCHEDULE^Schedule a Request^^R^11712^^^^^^^"
^DIC(19,3324,1,0)="^^4^4^2940606^"
^DIC(19,3324,1,1,0)="This option allows the user to schedule requested examinations"
^DIC(19,3324,1,2,0)="for a specific date/time. An order must already have been requested"
^DIC(19,3324,1,3,0)="through the 'Request an Exam' option. Only requests with a status of"
^DIC(19,3324,1,4,0)="'HOLD' or 'PENDING' are eligible for scheduling."
^DIC(19,3324,25)="2^RAORD"
^DIC(19,3324,"U")="SCHEDULE A REQUEST"
^DIC(19,3325,0)="RA ORDERCANCEL^Cancel a Request^^R^11712^^^^^^^"
^DIC(19,3325,1,0)="^^7^7^2940927^^"
^DIC(19,3325,1,1,0)="This option allows the user to cancel a request."
^DIC(19,3325,1,2,0)="If the user is not a department employee s/he"
^DIC(19,3325,1,3,0)="will only be able to cancel pending requests. If the user"
^DIC(19,3325,1,4,0)="is a department employee, s/he will be able to cancel"
^DIC(19,3325,1,5,0)="pending, held and scheduled requests. When an exam is"
^DIC(19,3325,1,6,0)="cancelled, a reason must be entered for the cancellation."
^DIC(19,3325,1,7,0)="If a reason is not entered, the request is not cancelled."
^DIC(19,3325,25)="3^RAORD"
^DIC(19,3325,"U")="CANCEL A REQUEST"
^DIC(19,3326,0)="RA ORDERHOLD^Hold a Request^^R^11712^^^^^^^"
^DIC(19,3326,1,0)="^^4^4^2940606^"
^DIC(19,3326,1,1,0)="This option allows the user to place a 'requested' exam in the 'HOLD'"
^DIC(19,3326,1,2,0)="status. The user will be asked to select a reason from the 'Rad/Nuc Med"
^DIC(19,3326,1,3,0)="Reason' file (#75.2).  Only requests with a status of 'pending' or"
^DIC(19,3326,1,4,0)="'scheduled'  may be placed on 'HOLD'."
^DIC(19,3326,25)="4^RAORD"
^DIC(19,3326,"U")="HOLD A REQUEST"
^DIC(19,3327,0)="RA ORDERLOG^Log of Scheduled Requests by Procedure^^R^1^^^^^^y^31^^1^1"
^DIC(19,3327,1,0)="^19.06^19^19^3220915^^"
^DIC(19,3327,1,1,0)="This option allows the user to generate a list of scheduled requests by"
^DIC(19,3327,1,2,0)="procedure.  The list includes the following information: procedure,"
^DIC(19,3327,1,3,0)="patient name, social security number, patient location, requesting"
^DIC(19,3327,1,4,0)="location if it was different than the current patient location, scheduled"
^DIC(19,3327,1,5,0)="time of examination and urgency. Before printing a report, the option will"
^DIC(19,3327,1,6,0)="prompt for imaging locations and allows selection of only the location(s)"
^DIC(19,3327,1,7,0)="to which the user has access through Personnel Classification. The"
^DIC(19,3327,1,8,0)="location(s) selected must also be within the current sign-on imaging type."
^DIC(19,3327,1,9,0)="Requests for which an imaging location has not been entered will print on"
^DIC(19,3327,1,10,0)="every report under location ""UNKNOWN"" regardless of which locations are"
^DIC(19,3327,1,11,0)="selected."
^DIC(19,3327,1,12,0)=" "
^DIC(19,3327,1,13,0)="If a date range in the past is specified, the user will also be asked if"
^DIC(19,3327,1,14,0)="only ""no-show's"" should appear on the log.  If the response is 'Yes', then"
^DIC(19,3327,1,15,0)="only requests with a Scheduled Date in the past that are still in the"
^DIC(19,3327,1,16,0)="'Scheduled' status will appear on the report.  (If the patient had shown"
^DIC(19,3327,1,17,0)="up, registration of the exam would have caused the request status to go to"
^DIC(19,3327,1,18,0)="'Active', so the log assumes that if a request is not yet active, the"
^DIC(19,3327,1,19,0)="patient didn't show up.)"
^DIC(19,3327,15)="K RAOPT(""SCH"")"
^DIC(19,3327,20)="S RAOPT(""SCH"")="""""
^DIC(19,3327,25)="RAORD7"
^DIC(19,3327,99)="53960,28980"
^DIC(19,3327,"U")="LOG OF SCHEDULED REQUESTS BY P"
^DIC(19,3328,0)="RA ORDERDISPLAY^Detailed Request Display^^R^11712^^^^^^y^^^1^1"
^DIC(19,3328,1,0)="^^8^8^2940606^^^^"
^DIC(19,3328,1,1,0)="This option allows the user to see a 'detailed' report on a requested "
^DIC(19,3328,1,2,0)="examination for a particular patient. The following information is"
^DIC(19,3328,1,3,0)="displayed: the request status, urgency, procedure, date exam was"
^DIC(19,3328,1,4,0)="ordered, requestor, and patient location. If the request was 'cancelled'"
^DIC(19,3328,1,5,0)="or placed on 'hold', the reason will be displayed. If the requested exam"
^DIC(19,3328,1,6,0)="is in an examination status, that status will also be displayed. If "
^DIC(19,3328,1,7,0)="information has been recorded in the status tracking log for the request,"
^DIC(19,3328,1,8,0)="the user will also have the option to view the log."
^DIC(19,3328,15)="K RASCREEN"
^DIC(19,3328,20)="S RASCREEN="""""
^DIC(19,3328,25)="RAORD2"
^DIC(19,3328,"U")="DETAILED REQUEST DISPLAY"
^DIC(19,3329,0)="RA OERR EXAM^Rad/Nuc Med^^O^11712^^^^^^^31^^1"
^DIC(19,3329,1,0)="^^2^2^2940609^"
^DIC(19,3329,1,1,0)="This option is used to link the Radiology/Nuclear Medicine Package with"
^DIC(19,3329,1,2,0)="the Order Entry Package (OE/RR) being developed by the Salt Lake City ISC."
^DIC(19,3329,10,0)="^19.01PI^0^0"
^DIC(19,3329,20)="D ^RAORR"
^DIC(19,3329,32)=""
^DIC(19,3329,33)=""
^DIC(19,3329,99)="55570,53266"
^DIC(19,3329,100)=""
^DIC(19,3329,100.1)=""
^DIC(19,3329,100.2)=""
^DIC(19,3329,"U")="RAD/NUC MED"
^DIC(19,3330,0)="RA ORDERPRINTS^Print Rad/Nuc Med Requests by Date^^R^11712^^^^^^^^^1^1"
^DIC(19,3330,1,0)="^^5^5^2940824^^^^"
^DIC(19,3330,1,1,0)="This option allows the user to print requests by status"
^DIC(19,3330,1,2,0)="for a specific range of date/times. The requests are printed by urgency,"
^DIC(19,3330,1,3,0)="beginning with 'STAT' and ending with 'ROUTINE'. The request contains"
^DIC(19,3330,1,4,0)="the department location, patient demographics, run date, urgency, request"
^DIC(19,3330,1,5,0)="and clinical history for the exam requested."
^DIC(19,3330,15)="K RAOPT(""ORDERPRINTS"")"
^DIC(19,3330,20)="S RAOPT(""ORDERPRINTS"")="""""
^DIC(19,3330,25)="RAORD4"
^DIC(19,3330,99)="55531,51704"
^DIC(19,3330,"U")="PRINT RAD/NUC MED REQUESTS BY "
^DIC(19,3332,0)="RA ORDERLOGLOC^Ward/Clinic Scheduled Request Log^^R^11712^^^^^^y^"
^DIC(19,3332,1,0)="^^4^4^2940811^^"
^DIC(19,3332,1,1,0)="This option allows the user to generate a list of scheduled requests by"
^DIC(19,3332,1,2,0)="ward/clinic. The list includes the following information:"
^DIC(19,3332,1,3,0)="patient name, social security number, procedure and imaging"
^DIC(19,3332,1,4,0)="location if the request was submitted to a specific imaging location."
^DIC(19,3332,25)="RAORD8"
^DIC(19,3332,"U")="WARD/CLINIC SCHEDULED REQUEST "
^DIC(19,3333,0)="RA ORDERPRINTPAT^Print Selected Requests by Patient^^R^11712^^^^^^^^^1^1"
^DIC(19,3333,1,0)="^^3^3^2940606^^"
^DIC(19,3333,1,1,0)="This option allows the user to print any request for a"
^DIC(19,3333,1,2,0)="selected patient. The request contains the department location, patient"
^DIC(19,3333,1,3,0)="demographics, run date, urgency, request and clinical history."
^DIC(19,3333,15)="K RAOPT(""ORDERPRINTPAT"")"
^DIC(19,3333,20)="S RAOPT(""ORDERPRINTPAT"")="""""
^DIC(19,3333,25)="9^RAORD"
^DIC(19,3333,"U")="PRINT SELECTED REQUESTS BY PAT"
^DIC(19,3334,0)="DG GECS READY FOR BATCH LIST^Code Sheets Ready for Batching^^A^.5^^^^^^^114^^1"
^DIC(19,3334,1,0)="^^4^4^2890928^^^^"
^DIC(19,3334,1,1,0)="This option allows the user to print the code sheets ready for"
^DIC(19,3334,1,2,0)="batching. This report contains the code sheet ID, scheduled"
^DIC(19,3334,1,3,0)="transmission date, station number, batch type and transaction"
^DIC(19,3334,1,4,0)="type/segment."
^DIC(19,3334,15)="K GECSSYS"
^DIC(19,3334,20)="S GECSSYS=""MAS"" D RCODEBA^GECSCALL"
^DIC(19,3334,"U")="CODE SHEETS READY FOR BATCHING"
