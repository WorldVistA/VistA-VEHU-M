^DIC(19,7008,0)="GMTS IRM/ADPAC ENABLE/DISABLE^Disable/Enable Health Summary Component^^E^.5^^^^^^y^160"
^DIC(19,7008,1,0)="^^3^3^2950816^^^^"
^DIC(19,7008,1,1,0)="Selectively enable or disable Health Summary Components.  Out of"
^DIC(19,7008,1,2,0)="order messages may be entered and the disable action may now be"
^DIC(19,7008,1,3,0)="identified as being either temporary or permanent."
