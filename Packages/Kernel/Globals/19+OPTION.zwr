^DIC(19,13009,"U")="REMINDER PARAMETERS"
^DIC(19,13010,0)="PXRM LIST RULE MANAGEMENT^List Rule Management^^A^1^^^^^^^534^^1"
^DIC(19,13010,1,0)="^^20^20^3060508^"
^DIC(19,13010,1,1,0)="This option allows creation/editing of list rules which are used to build "
^DIC(19,13010,1,2,0)="patient lists and test rule set criteria. "
^DIC(19,13010,1,3,0)="      "
^DIC(19,13010,1,4,0)="There are four types of list rules criteria managed from this list manage "
^DIC(19,13010,1,5,0)="option:"
^DIC(19,13010,1,6,0)=" "
^DIC(19,13010,1,7,0)="       PATIENT LIST RULE   defines an existing patient list to identify "
^DIC(19,13010,1,8,0)="                           patients."
^DIC(19,13010,1,9,0)="       FINDING RULE        defines reminder term findings to identify "
^DIC(19,13010,1,10,0)="                           patients."
^DIC(19,13010,1,11,0)="       REMINDER RULE       defines a reminder, where the patient cohort "
^DIC(19,13010,1,12,0)="                           logic is used to identify applicable patients."
^DIC(19,13010,1,13,0)="       LIST RULE SET       combines multiple list rule criteria (Patient "
^DIC(19,13010,1,14,0)="                           List, Finding Rule, and Reminder Rule) in a"
^DIC(19,13010,1,15,0)="                           specified sequence, where each sequence has"
^DIC(19,13010,1,16,0)="                           an operation (Add, Remove, Select) to "
^DIC(19,13010,1,17,0)="                           create/modify a patient list."
^DIC(19,13010,1,18,0)=" "
^DIC(19,13010,1,19,0)="Nationally released list rules are used by nationally released extract  "
^DIC(19,13010,1,20,0)="definitions for national extract runs."
^DIC(19,13010,20)="D START^PXRMLRM"
^DIC(19,13010,"U")="LIST RULE MANAGEMENT"
^DIC(19,13011,0)="PXRM EXTRACT DEFINITION^Extract Definition Management^^A^1^^^^^^^534^^1"
^DIC(19,13011,1,0)="^19.06^5^5^3060522^^"
^DIC(19,13011,1,1,0)="This option allows creation/editing of extract definitions for use in "
^DIC(19,13011,1,2,0)="extract processing. Each extract definition identifies what list rules "
^DIC(19,13011,1,3,0)="should be used to create patient lists, what reminders should be run "
^DIC(19,13011,1,4,0)="against each patient list, and what counting rules should be used to "
^DIC(19,13011,1,5,0)="count findings found during reminder evaluation."
^DIC(19,13011,20)="D START^PXRMEPM"
^DIC(19,13011,"U")="EXTRACT DEFINITION MANAGEMENT"
^DIC(19,13012,0)="PXRM EXTRACT COUNTING RULES^Extract Counting Rule Management^^A^1^^^^^^^534^^1"
^DIC(19,13012,1,0)="^^4^4^3060508^"
^DIC(19,13012,1,1,0)="This option allows creation/editing of extract counting rules used in the "
^DIC(19,13012,1,2,0)="extract process. The counting rules define how to count the findings "
^DIC(19,13012,1,3,0)="defined in an extract counting group (most recent for each finding, most "
^DIC(19,13012,1,4,0)="recent finding in the group, utilization counts for the reporting period)."
^DIC(19,13012,20)="D START^PXRMEFM(0)"
^DIC(19,13012,"U")="EXTRACT COUNTING RULE MANAGEME"
^DIC(19,13013,0)="PXRM LOCATION LIST MANAGEMENT^Reminder Location List Management^^M^10000000020^^^^^^^534"
^DIC(19,13013,1,0)="^19.06^1^1^3021205^^"
^DIC(19,13013,1,1,0)="This option provides the functions for Reminder Location Lists"
^DIC(19,13013,10,0)="^19.01IP^4^4"
^DIC(19,13013,10,1,0)="13016^LL^5"
^DIC(19,13013,10,2,0)="13015^LI^10"
^DIC(19,13013,10,3,0)="13014^LE^15"
^DIC(19,13013,10,4,0)="13592^LC^20"
