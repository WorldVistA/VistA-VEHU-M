^DIC(19,16104,1,1,0)="Use this option to add, edit or delete a Health Summary Type from"
^DIC(19,16104,1,2,0)="the list of Health Summary Types defined for a given entity (System,"
^DIC(19,16104,1,3,0)="Division, User, etc.)."
