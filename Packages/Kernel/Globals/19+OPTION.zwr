^DIC(19,15003,0)="IBCN EINSURANCE NIGHT PROCESS^eInsurance Night Process^^R^1^^^^^^n^192"
^DIC(19,15003,1,0)="^^5^5^3210308^"
^DIC(19,15003,1,1,0)="This option is not to be placed on any menu nor run by any user."
^DIC(19,15003,1,2,0)="This option is specifically designed to be scheduled in TaskMan to "
^DIC(19,15003,1,3,0)="be executed once a day during off-peak hours. Running this more"
^DIC(19,15003,1,4,0)="than once a day may cause unexpected results. This option controls"
^DIC(19,15003,1,5,0)="jobs for the ebusiness eInsurance team."
^DIC(19,15003,25)="EN^IBCNINS"
^DIC(19,15003,200.9)="y"
^DIC(19,15003,"U")="EINSURANCE NIGHT PROCESS"
^DIC(19,15004,0)="RA SYSINACT^Inactivate a Location^^R^1^^^^^^^31"
^DIC(19,15004,1,0)="^19.06^4^4^3210825^^^"
^DIC(19,15004,1,1,0)="This option will set the INACTIVE field of the selected imaging location "
^DIC(19,15004,1,2,0)="and the INACTIVE DATE field on the associated Occasion of Service (OOS) "
^DIC(19,15004,1,3,0)="clinic in the HOSPITAL LOCATION file. It can also be used to inactivate"
^DIC(19,15004,1,4,0)="the OOS clinic for an I-LOC that is already inactive."
^DIC(19,15004,25)="INACTIV8^RASYS1"
^DIC(19,15004,"U")="INACTIVATE A LOCATION"
