^DIC(19,3848,0)="FHPRF1^Enter/Edit Production Diet Percentages^^R^10000000020^^^^^^^"
^DIC(19,3848,1,0)="^19.06^3^3^3020722^^^^"
^DIC(19,3848,1,1,0)="This option is part of the Forecasting module and is used to"
^DIC(19,3848,1,2,0)="enter and edit the percentage of total census represented by"
^DIC(19,3848,1,3,0)="each production diet for each day of the week."
^DIC(19,3848,25)="EN1^FHPRF"
^DIC(19,3848,"U")="ENTER/EDIT PRODUCTION DIET PER"
^DIC(19,3849,0)="FHPRF2^Forecasted Diet Census^^R^10000000020^^^^^^^"
^DIC(19,3849,1,0)="^19.06^8^8^3041220^^^"
^DIC(19,3849,1,1,0)="This option allows for the forecast of the total census for"
^DIC(19,3849,1,2,0)="a Production Facility for a specified date. The forecast is based"
^DIC(19,3849,1,3,0)="upon MAS census counts for the same day of the week for"
^DIC(19,3849,1,4,0)="the last 9 occurrences and is then corrected by examining"
^DIC(19,3849,1,5,0)="the error between the forecast and the actual census for"
^DIC(19,3849,1,6,0)="the most recent three days.  This report also includes all the"
^DIC(19,3849,1,7,0)="outpatient meals in a specific Production Facility for a specified"
^DIC(19,3849,1,8,0)="date."
^DIC(19,3849,25)="FHPRF1"
^DIC(19,3849,"U")="FORECASTED DIET CENSUS"
^DIC(19,3851,0)="FHPRF4^List Production Diet Percentages^^R^10000000020^^^^^^^"
^DIC(19,3851,1,0)="^19.06^2^2^3020719^^^^"
^DIC(19,3851,1,1,0)="This option will list the percentage of total census represented"
^DIC(19,3851,1,2,0)="by each production diet for each day of the week for a Service Point."
^DIC(19,3851,25)="FHPRF2"
^DIC(19,3851,"U")="LIST PRODUCTION DIET PERCENTAG"
^DIC(19,3852,0)="FHPRO5^Meal Production Reports^^R^10000000020^^^^^^^"
^DIC(19,3852,1,0)="^19.06^7^7^3031119^^^^"
^DIC(19,3852,1,1,0)="This option will produce, for a selected Production Facility"
^DIC(19,3852,1,2,0)="and meal, the ingredient requirements in the form of a"
^DIC(19,3852,1,3,0)="stockroom requisition list, the preparation requirements in"
^DIC(19,3852,1,4,0)="terms of all recipes needing preparation and the required"
^DIC(19,3852,1,5,0)="ingredient amounts, and service reports indicating the number"
^DIC(19,3852,1,6,0)="of portions of each recipe needed by Service Point as well as"
^DIC(19,3852,1,7,0)="the production diets associated with each recipe."
^DIC(19,3852,25)="FHPRO1"
^DIC(19,3852,"U")="MEAL PRODUCTION REPORTS"
