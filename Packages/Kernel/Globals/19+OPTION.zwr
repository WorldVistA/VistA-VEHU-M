^DIC(19,1267,0)="LR COUNT ACC TESTS^Count accessioned tests^^R^.5^LRSUPER^^^^^^26"
^DIC(19,1267,1,0)="^^7^7^2940610^^^^"
^DIC(19,1267,1,1,0)="Provides a count of all verified tests by requesting area and cumulative totals"
^DIC(19,1267,1,2,0)="for a given accession area.  The report will list the # of accessions"
^DIC(19,1267,1,3,0)="and test counts by location and also give a total # of accessions"
^DIC(19,1267,1,4,0)="and total test count by accession area.  The option has two displays"
^DIC(19,1267,1,5,0)="""Counts by location"" and ""Counts by test."""
^DIC(19,1267,1,6,0)=" This option is different from the option 'LAB ACCESSION AND TEST"
^DIC(19,1267,1,7,0)="COUNTS' in that it only counts verified test'"
^DIC(19,1267,20)=""
^DIC(19,1267,25)="LRUPACA"
^DIC(19,1267,"U")="COUNT ACCESSIONED TESTS"
^DIC(19,1268,0)="LR INF WARN^Infection warning edit^^A^.5^LRSUPER^^^^^^26^^1"
^DIC(19,1268,1,0)="^^2^2^2870203^^^^"
^DIC(19,1268,1,1,0)="This function enables the user to edit the infection warning for a patient."
^DIC(19,1268,1,2,0)="The warning appears on all labels printed for this patient."
^DIC(19,1268,20)="K DIC D ^LRDPA Q:LRDFN<1  S DA=LRDFN,DR=.091,DIE=""^LR("" D ^DIE"
^DIC(19,1268,30)=""
^DIC(19,1268,31)=""
^DIC(19,1268,50)=""
^DIC(19,1268,51)=""
^DIC(19,1268,"U")="INFECTION WARNING EDIT"
^DIC(19,1272,0)="LRRP3^Interim report for chosen tests^^R^10000000020^^^^^^^26"
^DIC(19,1272,1,0)="^19.06^9^9^3021031^^^^"
^DIC(19,1272,1,1,0)="This report will display results in inverse date order.  The"
^DIC(19,1272,1,2,0)="option allows the user to select a specific test or panel of"
^DIC(19,1272,1,3,0)="tests for a specified time period.  Regardless of whether the orders"
^DIC(19,1272,1,4,0)="have been purged, the results may be displayed.  The report should not"
^DIC(19,1272,1,5,0)="be charted."
^DIC(19,1272,1,6,0)="The report prints site codes for tests.  You will be asked if you would"
^DIC(19,1272,1,7,0)="like to print an address page.  The address page prints on a separate page(s)"
^DIC(19,1272,1,8,0)="at the end of the report and lists the performing lab name, address and site"
^DIC(19,1272,1,9,0)="code."
^DIC(19,1272,25)="LRRP3"
^DIC(19,1272,99)="55620,52552"
^DIC(19,1272,"U")="INTERIM REPORT FOR CHOSEN TEST"
