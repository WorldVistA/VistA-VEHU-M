^DIC(19,15592,1,0)="^19.06^5^5^3240328^^^^"
^DIC(19,15592,1,1,0)="You can remove patients from a list that you have built by patient, ward"
^DIC(19,15592,1,2,0)="or clinic. "
^DIC(19,15592,1,3,0)="This is convenient if you want to add all of the patients from a"
^DIC(19,15592,1,4,0)="ward or clinic except for one or two."
^DIC(19,15592,1,5,0)="Cloned from ""ORLP DELETE PATIENT"" option."
^DIC(19,15592,3)=""
^DIC(19,15592,20)="D DEL^ORLP00"
^DIC(19,15592,"U")="REMOVE PATIENT(S) FROM PATIENT"
