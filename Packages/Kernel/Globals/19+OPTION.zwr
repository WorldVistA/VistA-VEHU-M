^DIC(19,13280,0)="RA PROC CPTWRVU^Procedure wRVU/CPT Report^^R^10000000020^^^^^^y^31"
^DIC(19,13280,1,0)="^^4^4^3051214^"
^DIC(19,13280,1,1,0)="This option will print data from the RAD/NUC MED PROCEDURES (#71) file "
^DIC(19,13280,1,2,0)="for series and detailed procedures. The data elements displayed will be:"
^DIC(19,13280,1,3,0)="procedure name, type of procedure, imaging type, CPT Code, and the"
^DIC(19,13280,1,4,0)="un-scaled wRVU value."
^DIC(19,13280,25)="EN^RAWRVUP(0)"
^DIC(19,13280,"U")="PROCEDURE WRVU/CPT REPORT"
^DIC(19,13281,0)="RA WKLIPHY CPT ITYPE^Physician CPT Report by Imaging Type^^R^10000000020^^^^^^y^31"
^DIC(19,13281,1,0)="^19.06^3^3^3051228^^"
^DIC(19,13281,1,1,0)="This option will display the total number of imaging type specific"
^DIC(19,13281,1,2,0)="procedures (CPTs) performed by an interpreting staff physician "
^DIC(19,13281,1,3,0)="over a user defined date range."
^DIC(19,13281,25)="EN^RAWKLU(""CPT"","""")"
^DIC(19,13281,"U")="PHYSICIAN CPT REPORT BY IMAGIN"
^DIC(19,13283,0)="RA WKLIPHY WRVU ITYPE^Physician wRVU Report by Imaging Type^^R^10000000020^^^^^^y^31"
^DIC(19,13283,1,0)="^19.06^11^11^3051129^^"
^DIC(19,13283,1,1,0)="This option will display the total number of wRVU units attributed "
^DIC(19,13283,1,2,0)="to an interpreting staff physician within imaging type over a user "
^DIC(19,13283,1,3,0)="defined date range."
^DIC(19,13283,1,4,0)=" "
^DIC(19,13283,1,5,0)="wRVU is a measure of the time and effort associated with the performance"
^DIC(19,13283,1,6,0)="of a given procedure. wRVU is a unit that is associated with an imaging "
^DIC(19,13283,1,7,0)="type and is applied to all procedures performed by an interpreting staff "
^DIC(19,13283,1,8,0)="physician within that imaging type."
^DIC(19,13283,1,9,0)=" "
^DIC(19,13283,1,10,0)="This report will show the wRVU for interpreting staff physician within "
^DIC(19,13283,1,11,0)="imaging type, their subtotals and grand total."
^DIC(19,13283,25)="EN^RAWKLU(""RVU"",0)"
^DIC(19,13283,"U")="PHYSICIAN WRVU REPORT BY IMAGI"
^DIC(19,13285,0)="RA WKLIPHY WRVU CPT^Physician wRVU Report by CPT^^R^10000000020^^^^^^y^31"
^DIC(19,13285,1,0)="^^6^6^3051221^"
^DIC(19,13285,1,1,0)="This option allows the user to select the physicians to be included and"
^DIC(19,13285,1,2,0)="the timeframe the report is to include. For each physician, the procedure"
^DIC(19,13285,1,3,0)="CPT and name is displayed, the number of instances of a procedure, and the"
^DIC(19,13285,1,4,0)="total wRVU value for that procedure are totaled and displayed."
^DIC(19,13285,1,5,0)=" "
^DIC(19,13285,1,6,0)="Overall exam and wRVU totals per physician are also displayed."
^DIC(19,13285,25)="EN^RAWKLU2(0)"
^DIC(19,13285,"U")="PHYSICIAN WRVU REPORT BY CPT"
^DIC(19,13287,0)="PSBO XA^Unknown Action Status Report^^R^10000000020^PSB MANAGER^^^^^^533"
^DIC(19,13287,25)="XQ^PSBO(""XA"")"
^DIC(19,13287,"U")="UNKNOWN ACTION STATUS REPORT"
^DIC(19,13288,0)="CLOZAPINE MULTI TEST LINK^Link Multiple Tests to Clozapine^^R^10000000020^^^^^^^"
^DIC(19,13288,1,0)="^^7^7^3060313^"
^DIC(19,13288,1,1,0)="This option allows the site to enter as many tests as necessary to "
^DIC(19,13288,1,2,0)="Clozapine.  A test representing the White Blood Count must be entered.  "
^DIC(19,13288,1,3,0)="Additional tests must be entered to represent the Absolute Neutrophil "
^DIC(19,13288,1,4,0)="Count.  These may be the Absolute Neutorphil Count, a Neutrophil "
^DIC(19,13288,1,5,0)="Percentage, or BANDS and SEGS.  If BANDS and SEGS are entered, both tests "
^DIC(19,13288,1,6,0)="must be entered.  If only one of the two are entered, dispense "
^DIC(19,13288,1,7,0)="authorization will not occur."
^DIC(19,13288,25)="TLIST^YSCLTST3"
^DIC(19,13288,"U")="LINK MULTIPLE TESTS TO CLOZAPI"
^DIC(19,13289,0)="BPS RPT CMOP/ECME ACTIVITY^CMOP/ECME Activity Report^^R^1^BPS REPORTS^^^^^^"
^DIC(19,13289,1,0)="^^3^3^3060602^"
^DIC(19,13289,1,1,0)="This report is necessary for monitoring CMOP activity during both the "
^DIC(19,13289,1,2,0)="Controlled Substances and General CMOP Transmissions. This report shall "
^DIC(19,13289,1,3,0)="contain reference information from File 550.2, CMOP Transmissions."
^DIC(19,13289,25)="PSXBPSRP"
^DIC(19,13289,62)=0
^DIC(19,13289,"U")="CMOP/ECME ACTIVITY REPORT"
