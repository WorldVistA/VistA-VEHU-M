^DIC(19,13827,1,7,0)="   Training Data Entry for MFH [HBHC MFH TRAINING INPUT]"
^DIC(19,13827,1,8,0)="   Edit MFH Form Errors Data [HBHCUPDM]"
^DIC(19,13827,1,9,0)="   MFH Reports ... [HBHC MFH REPORTS MENU]"
