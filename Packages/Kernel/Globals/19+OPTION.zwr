^DIC(19,8877,0)="MCWKLDG^Workload Reporting Mailgroup Selection^^R^755^^^^^^^^^^1"
^DIC(19,8877,1,0)="^^5^5^2950508^"
^DIC(19,8877,1,1,0)="This option provides a mechanism for the user to select a mail group"
^DIC(19,8877,1,2,0)="or groups to receive message transmissions (Patient ID, Provider ID,"
^DIC(19,8877,1,3,0)="Patient SSN, CPT Code, and date/time).  The message transmission occurs at"
