^DIC(19,7294,"U")="DELAY AND CANCELLATION REPORTS"
^DIC(19,7295,0)="SROCRAT^Report of Cancellation Rates^^R^10000000216^^^^^^^^^1^1"
^DIC(19,7295,1,0)="^^18^18^2911122^^^^"
^DIC(19,7295,1,1,0)="This option generates the Report of Cancellation Rates.  The report can be "
^DIC(19,7295,1,2,0)="printed for an individual Surgical Specialty, or the entire medical center."
^DIC(19,7295,1,3,0)="The report shows the following 3 rates:"
^DIC(19,7295,1,4,0)=" 1) The cancellation percentage of all scheduled cases, calculated as"
^DIC(19,7295,1,5,0)="    follows:"
^DIC(19,7295,1,6,0)="  "
^DIC(19,7295,1,7,0)="    (TOTAL CANCELS / TOTAL SCHEDULED) x 100"
^DIC(19,7295,1,8,0)="  "
^DIC(19,7295,1,9,0)=" 2) The avoidable cancellation percentage of all scheduled cases,"
^DIC(19,7295,1,10,0)="    calculated as follows:"
^DIC(19,7295,1,11,0)="  "
^DIC(19,7295,1,12,0)="    (TOTAL AVOIDABLE CANCELS / TOTAL SCHEDULED) x 100"
^DIC(19,7295,1,13,0)="  "
^DIC(19,7295,1,14,0)=" 3) The avoidable cancellation percentage of all cancelled cases,"
^DIC(19,7295,1,15,0)="    calculated as follows:"
^DIC(19,7295,1,16,0)="  "
^DIC(19,7295,1,17,0)="    (TOTAL AVOIDABLE CANCELS / TOTAL CANCELS) x 100"
^DIC(19,7295,1,18,0)="  "
^DIC(19,7295,15)="D EXIT^SROVAR"
^DIC(19,7295,20)="D ^SROVAR"
^DIC(19,7295,22)="Q"
^DIC(19,7295,25)="SROCRAT"
^DIC(19,7295,"U")="REPORT OF CANCELLATION RATES"
