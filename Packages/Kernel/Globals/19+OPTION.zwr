^DIC(19,6720,0)="PSD INVEN SHEET PRT^Inventory Sheet Print^^R^11595^^^^^^^276"
^DIC(19,6720,1,0)="^^6^6^2940411^^^^"
^DIC(19,6720,1,1,0)="This option prints an Inspector's Sheet which is used to inventory on-hand"
^DIC(19,6720,1,2,0)="amounts within a pharmacy dispensing site (vault).  This form lists"
^DIC(19,6720,1,3,0)="current on-hand amounts and provides a blank space for the inspector to"
^DIC(19,6720,1,4,0)="list actual on-hand counts.  A signature line is included on each page."
^DIC(19,6720,1,5,0)="This sheet may be generated for one drug, some drugs, or ALL drugs."
^DIC(19,6720,1,6,0)="The drugs are listed alphabetically."
^DIC(19,6720,25)="PSDBALI"
^DIC(19,6720,99)="55774,57084"
^DIC(19,6720,"U")="INVENTORY SHEET PRINT"
^DIC(19,6721,0)="PSD ON-HAND^List On-Hand Amounts^^R^11595^^^^^^^276"
^DIC(19,6721,1,0)="^^4^4^2940411^^^"
^DIC(19,6721,1,1,0)="This option lists current on-hand amounts for drugs stocked in a pharmacy"
^DIC(19,6721,1,2,0)="dispensing site (vault).  The drugs may be selected by one, some, or ALL."
^DIC(19,6721,1,3,0)="The drugs are listed alphabetically to the user's screen or a selected"
^DIC(19,6721,1,4,0)="printer."
^DIC(19,6721,25)="PSDBAL"
^DIC(19,6721,"U")="LIST ON-HAND AMOUNTS"
^DIC(19,6722,0)="PSD PRODUCTION REPORTS^Production Reports^^M^11595^^^^^^^276"
