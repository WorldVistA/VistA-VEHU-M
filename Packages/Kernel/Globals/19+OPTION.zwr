^DIC(19,8367,"U")="IVM UPLOAD MENU"
^DIC(19,8368,0)="IVM OUTPUT MENU^IVM Output Menu^^M^10000000020^^^^^^^312"
^DIC(19,8368,1,0)="^19.06^2^2^3051025^^^^"
^DIC(19,8368,1,1,0)="This menu option contains all outputs from the IVM package.  These"
^DIC(19,8368,1,2,0)="options should probably be placed on other menus as well."
^DIC(19,8368,10,0)="^19.01IP^4^4"
^DIC(19,8368,10,1,0)="8363^MTC"
^DIC(19,8368,10,2,0)="8362^BTR"
