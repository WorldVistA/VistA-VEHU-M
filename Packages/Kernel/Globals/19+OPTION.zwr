^DIC(19,7196,99)="59254,78270"
^DIC(19,7196,"U")="MENU DIAGRAMS"
^DIC(19,7197,0)="XQORPHANOPTIONS^Non-queuable options with no parents^Not runable^M^.5^^^^^^^163"
^DIC(19,7197,1,0)="^^5^5^2921022^^"
^DIC(19,7197,1,1,0)=" "
^DIC(19,7197,1,2,0)="The options on this menu are options that should not be assigned to a"
^DIC(19,7197,1,3,0)="user's menu.  They are also not queuable so they do not appear on the menu"
^DIC(19,7197,1,4,0)="ZTQUEUABLE OPTIONS.  They are collected on this menu so that they are not"
^DIC(19,7197,1,5,0)="accidentally deleated from the system.  Thank you for your support."
^DIC(19,7197,10,0)="^19.01PI^1^1"
^DIC(19,7197,10,1,0)="7195^"
