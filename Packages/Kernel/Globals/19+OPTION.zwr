^DIC(19,7710,0)="PRCA NOTIFICATION PARAMETERS^Statement Parameters^^A^1^PRCA STATEMENT PARAMETER^^^^^^261^^1"
^DIC(19,7710,1,0)="^^3^3^2930616^^^"
^DIC(19,7710,1,1,0)="This option will allow the AR Supervisor to edit parameters specific"
^DIC(19,7710,1,2,0)="to the Patient Statements.  This will allow the user to control"
^DIC(19,7710,1,3,0)="functionality related to statements."
^DIC(19,7710,20)="D STAT^RCMSITE K DTOUT"
^DIC(19,7710,99)="55686,33311"
^DIC(19,7710,"U")="STATEMENT PARAMETERS"
^DIC(19,7711,0)="PRCA BILL STATUS LISTING^Bill Status Listing^^A^.5^^^^^^^261^^1"
^DIC(19,7711,1,0)="^^2^2^2930220^"
^DIC(19,7711,1,1,0)="This option will allow a service to list bills in a certain status"
^DIC(19,7711,1,2,0)="for their respective service."
^DIC(19,7711,20)="D SVC^PRCABIL I $D(PRCAP(""S"")) D STAT^PRCAPCL(PRCAP(""S"")) K PRCAP(""S"")"
^DIC(19,7711,99)="55648,49703"
^DIC(19,7711,"U")="BILL STATUS LISTING"
^DIC(19,7714,0)="PRCA VIEW A BILL^View a Bill^^A^.5^^^^^^^261^^1"
^DIC(19,7714,1,0)="^^3^3^2930609^^^^"
^DIC(19,7714,1,1,0)="This option allows the service to view a bill that was entered.  The"
^DIC(19,7714,1,2,0)="information displayed will show the current status and follow-up action"
^DIC(19,7714,1,3,0)="taken and the final results (Written-off, collected, canceled, etc.)."
^DIC(19,7714,20)="D ^PRCAFOR K DTOUT"
^DIC(19,7714,99)="55591,32009"
^DIC(19,7714,"U")="VIEW A BILL"
^DIC(19,7715,0)="PRCA LIST ALL BILLS^List All Bills^^A^.5^^^^^^^261^^1"
^DIC(19,7715,1,0)="^^4^4^2930222^"
^DIC(19,7715,1,1,0)="This option will list all bills for the service of the person that"
^DIC(19,7715,1,2,0)="has generated the report.  The report will display information,"
^DIC(19,7715,1,3,0)="such as: Form Type, Original Amount, Current Balance, Debtor, and"
^DIC(19,7715,1,4,0)="Bill # sort by Status."
^DIC(19,7715,20)="D DIP^PRCABIL1 K DTOUT"
^DIC(19,7715,99)="55573,52374"
^DIC(19,7715,"U")="LIST ALL BILLS"
^DIC(19,7719,0)="PRCA DEBTOR COMMENT^Debtor Comment Log^^A^.5^^^^^^^261^^1"
^DIC(19,7719,1,0)="^^2^2^2930312^"
^DIC(19,7719,1,1,0)="This option will allow the user to enter a comment for a debtor that"
^DIC(19,7719,1,2,0)="can be later profiled."
^DIC(19,7719,20)="D EN^RCEVGEN($O(^RC(341.1,""AC"",1,0))) K DTOUT"
^DIC(19,7719,99)="55588,40807"
^DIC(19,7719,"U")="DEBTOR COMMENT LOG"
^DIC(19,7720,0)="PRCA BILL COMMENT^Bill Comment Log^^A^.5^^^^^^^261^^1"
^DIC(19,7720,1,0)="^^4^4^2931014^^"
^DIC(19,7720,1,1,0)="This option will allow the user to enter a COMMENT type"
^DIC(19,7720,1,2,0)="transaction for a bill.  This allows follow-up action or patient"
^DIC(19,7720,1,3,0)="contact to be logged against the bill for documenting follow-up"
^DIC(19,7720,1,4,0)="activity."
^DIC(19,7720,20)="D ^PRCACM K DTOUT"
^DIC(19,7720,99)="55644,31887"
^DIC(19,7720,"U")="BILL COMMENT LOG"
^DIC(19,7721,0)="PRCA FOLLOW-UP REPORTS^Follow-up Reports^^A^.5^^^^^^^261^^1"
^DIC(19,7721,1,0)="^^4^4^2930609^^"
^DIC(19,7721,1,1,0)="This option will print a report of the follow-up transactions"
^DIC(19,7721,1,2,0)="for bills and follow-up actions for a debtor.  The report will"
^DIC(19,7721,1,3,0)="prompt the user for date-range and any comment 'flagged' for"
^DIC(19,7721,1,4,0)="follow-up within the date-range will display on the report."
^DIC(19,7721,20)="D RPT^PRCACM"
^DIC(19,7721,99)="55706,47648"
^DIC(19,7721,"U")="FOLLOW-UP REPORTS"
^DIC(19,7722,0)="PRCAK ARCHIVE^Archive AR Records Menu^^M^.5^^^^^^^261"
^DIC(19,7722,1,0)="^^6^6^2931021^^^^"
^DIC(19,7722,1,1,0)="This menu contains Accounts Receivable archival options.  These"
^DIC(19,7722,1,2,0)="options should be executed in the order described in the AR Archival"
^DIC(19,7722,1,3,0)="documentation."
^DIC(19,7722,1,4,0)=" "
^DIC(19,7722,1,5,0)="Because some options may cause a lot of system activity, you should "
^DIC(19,7722,1,6,0)="coordinate the use of these options with your IRM System Manager."
^DIC(19,7722,10,0)="^19.01PI^6^6"
^DIC(19,7722,10,1,0)="7723^^2"
^DIC(19,7722,10,2,0)="7724^^3"
^DIC(19,7722,10,3,0)="7726^^1"
^DIC(19,7722,10,4,0)="7728^^6"
^DIC(19,7722,10,5,0)="7727^^4"
^DIC(19,7722,10,6,0)="7729^^5"
^DIC(19,7722,10,"B",7723,1)=""
^DIC(19,7722,10,"B",7724,2)=""
^DIC(19,7722,10,"B",7726,3)=""
^DIC(19,7722,10,"B",7727,5)=""
^DIC(19,7722,10,"B",7728,4)=""
^DIC(19,7722,10,"B",7729,6)=""
^DIC(19,7722,99)="62195,30816"
^DIC(19,7722,"U")="ARCHIVE AR RECORDS MENU"
^DIC(19,7723,0)="PRCAK ARCHIVE MARK PRINT^Detailed Report of Pending Archive Records^^A^.5^^^^^^^261^^1"
^DIC(19,7723,1,0)="^^9^9^2930709^^^^"
^DIC(19,7723,1,1,0)="This option will print a report of all the AR records that are"
^DIC(19,7723,1,2,0)="flagged for Archive. (The status is 'PENDING ARCHIVE').  This report"
^DIC(19,7723,1,3,0)="includes the Bill no., Debtor name, category, the previous status"
^DIC(19,7723,1,4,0)="before it was marked for Archive, the balance and the date of the last"
^DIC(19,7723,1,5,0)="activity."
^DIC(19,7723,1,6,0)=" "
^DIC(19,7723,1,7,0)="A total of entries marked as ARCHIVE will print at the end of the"
^DIC(19,7723,1,8,0)="report.  This total may be very useful in determining the amount of"
^DIC(19,7723,1,9,0)="systems activity the archive processes will create."
^DIC(19,7723,20)="D ST^PRCAKMR"
^DIC(19,7723,99)="55707,47418"
^DIC(19,7723,"U")="DETAILED REPORT OF PENDING ARC"
^DIC(19,7724,0)="PRCAK UNMARK ARCHIVE^Unmark Records Marked for Archival^^A^.5^^^^^^^261^^1"
^DIC(19,7724,1,0)="^^7^7^2930719^^^^"
^DIC(19,7724,1,1,0)="This option will allow the user to change the status of a record"
^DIC(19,7724,1,2,0)="from PENDING ARCHIVE back to the previous status."
^DIC(19,7724,1,3,0)="This will prevent the record from being archived. "
^DIC(19,7724,1,4,0)="The user may unmark ALL records or select each record."
^DIC(19,7724,1,5,0)=" "
^DIC(19,7724,1,6,0)="If the records marked for archiving were moved to the temporary storage"
^DIC(19,7724,1,7,0)="file, the status cannot be changed."
^DIC(19,7724,20)="D ^PRCAKUN"
^DIC(19,7724,99)="55707,47518"
^DIC(19,7724,"U")="UNMARK RECORDS MARKED FOR ARCH"
^DIC(19,7725,0)="PRCAC TR SUSPENDED^Suspend an AR bill^^R^11740^^^^^^^261^^"
^DIC(19,7725,1,0)="^^6^6^2950207^"
^DIC(19,7725,1,1,0)="This option will allow the user to place a selected AR bill that has a"
^DIC(19,7725,1,2,0)="principal balance into the Suspended status.  A bill in this status will"
^DIC(19,7725,1,3,0)="not print on the patient's statement but it does accrue administrative charges."
^DIC(19,7725,1,4,0)=" "
^DIC(19,7725,1,5,0)="The status of the selected bill will change to SUSPENDED and create a"
^DIC(19,7725,1,6,0)="SUSPENSE transaction for the current outstanding amount."
^DIC(19,7725,20)=""
^DIC(19,7725,25)="47^RCWROFF"
^DIC(19,7725,99.1)="58464,82913"
^DIC(19,7725,"U")="SUSPEND AN AR BILL"
^DIC(19,7726,0)="PRCAK MARK FOR ARCHIVE^Mark AR Records for Archival^^A^.5^^^^^^^261^^1"
^DIC(19,7726,1,0)="2^^7^7^2980202^^^^"
^DIC(19,7726,1,1,0)="This option will change the bill status of bills whose last date of "
^DIC(19,7726,1,2,0)="activity falls within the selected time-frame to PENDING ARCHIVE.  The "
^DIC(19,7726,1,3,0)="previous fiscal year and current fiscal year cannot be archived."
^DIC(19,7726,1,4,0)=" "
^DIC(19,7726,1,5,0)="A mailman bulletin will be sent containing the total number of "
^DIC(19,7726,1,6,0)="records marked for archival.  This total should be reviewed by"
^DIC(19,7726,1,7,0)="the IRM system manager for AR Archival system activity."
^DIC(19,7726,20)="D ^PRCAKM"
^DIC(19,7726,"U")="MARK AR RECORDS FOR ARCHIVAL"
^DIC(19,7727,0)="PRCAK BUILD TEMP^Build Temporary Archive File^^A^.5^^^^^^^261^^1"
^DIC(19,7727,1,0)="^^11^11^2940629^^^^"
^DIC(19,7727,1,1,0)="This option will move all of the data items including the transactions"
^DIC(19,7727,1,2,0)="for bills in the PENDING ARCHIVE status to a temporary storage file."
^DIC(19,7727,1,3,0)="You cannot unmark records marked for archiving once this process is "
^DIC(19,7727,1,4,0)="started.  A mail message will be sent to you when the file has "
^DIC(19,7727,1,5,0)="successfully been populated."
^DIC(19,7727,1,6,0)=" "
^DIC(19,7727,1,7,0)=" "
^DIC(19,7727,1,8,0)="WARNING:  This process may be very system intensive!  Please coordinate"
^DIC(19,7727,1,9,0)="the use of this option with your IRM System Manager.  Be sure you have"
^DIC(19,7727,1,10,0)="adequate disk and journal space available."
^DIC(19,7727,1,11,0)=" "
^DIC(19,7727,20)="D ^PRCAKBT"
^DIC(19,7727,"U")="BUILD TEMPORARY ARCHIVE FILE"
^DIC(19,7728,0)="PRCAK PURGE TEMP^Purge Temporary Archive Storage File^^A^.5^^^^^^^261^^1"
^DIC(19,7728,1,0)="^^6^6^2930709^^^^"
^DIC(19,7728,1,1,0)="This option will purge ALL of the archive data items in the temporary"
^DIC(19,7728,1,2,0)="storage archive file (AR ARCHIVE File 430.8).  If there are records"
^DIC(19,7728,1,3,0)="remaining in the Pending Archive status you will have to build this"
^DIC(19,7728,1,4,0)="file again. "
^DIC(19,7728,1,5,0)=" "
^DIC(19,7728,1,6,0)="** THIS OPTION DOES NOT RESET THE RECORDS TO THE ARCHIVED STATUS **"
^DIC(19,7728,20)="D ^PRCAKTP"
^DIC(19,7728,"U")="PURGE TEMPORARY ARCHIVE STORAG"
^DIC(19,7729,0)="PRCAK REMOVE AR RECORD^Remove AR Records from Files^^A^.5^^^^^^^261^^1"
^DIC(19,7729,1,0)="^^10^10^2931022^^^^"
^DIC(19,7729,1,1,0)="This option will remove the AR record data from the Account Receivable "
^DIC(19,7729,1,2,0)="File 430 and all corresponding transactions from the AR Transactions "
^DIC(19,7729,1,3,0)="File 433.  This option will change the status of the AR record in the "
^DIC(19,7729,1,4,0)="'Pending Archive' status to 'Archived'.  The date entered by the user "
^DIC(19,7729,1,5,0)="will be entered in the Date Bill Prepared field. "
^DIC(19,7729,1,6,0)=" "
^DIC(19,7729,1,7,0)="The entry in the temporary storage file will be deleted after the "
^DIC(19,7729,1,8,0)="AR records are updated."
^DIC(19,7729,1,9,0)=" "
^DIC(19,7729,1,10,0)="NOTE: The use of this option should be coordinated with IRM and MCCR."
^DIC(19,7729,20)="D ^PRCAKS"
^DIC(19,7729,"U")="REMOVE AR RECORDS FROM FILES"
^DIC(19,7730,0)="PRCAE PR STATEMENT^Reprint Patient Statements^^A^.5^^^^^^^261^^1"
^DIC(19,7730,1,0)="^^6^6^2980320^^"
^DIC(19,7730,1,1,0)="This option will reprint Patient Statements for the selected date."
^DIC(19,7730,1,2,0)="Enter a patient range in print order to have only the statements in that"
^DIC(19,7730,1,3,0)="sequence reprint or do not select a range to reprint all statements for"
^DIC(19,7730,1,4,0)="the selected date."
^DIC(19,7730,1,5,0)=" "
^DIC(19,7730,1,6,0)="NOTE:  This option will not reprint Follow-up Letters."
^DIC(19,7730,20)="D REP^PRCAG K DTOUT"
^DIC(19,7730,"U")="REPRINT PATIENT STATEMENTS"
^DIC(19,7731,0)="PRCA NIGHTLY PROCESS^Accounts Receivable Nightly Process Background Job^^A^1^^^^^^^^^1^^^^"
^DIC(19,7731,1,0)="^^21^21^3210706^"
^DIC(19,7731,1,1,0)="This process should run nightly to update the Accounts Receivable"
^DIC(19,7731,1,2,0)="records with interest and administrative charges and to print the patient"
^DIC(19,7731,1,3,0)="statements and follow-up. It will also check for the IRS offset letters"
^DIC(19,7731,1,4,0)="run date and the IRS code sheet creation dates and if applicable will"
^DIC(19,7731,1,5,0)="run those processes. This option should run when there is no account"
^DIC(19,7731,1,6,0)="activity in the Accounts Receivable package and after daily payments are"
^DIC(19,7731,1,7,0)="posted."
^DIC(19,7731,1,8,0)=" "
^DIC(19,7731,1,9,0)="In order to ensure that Pandemic period copays are properly cancelled and "
^DIC(19,7731,1,10,0)="don't appear on patient statements, as required by the American Rescue "
^DIC(19,7731,1,11,0)="Plan Act (ARPA) of 2021, the PRCA NIGHTLY PROCESS VistA TaskMan job will "
^DIC(19,7731,1,12,0)="need to follow the scheduling criteria below:"
^DIC(19,7731,1,13,0)=" "
^DIC(19,7731,1,14,0)="Starts after midnight local time."
^DIC(19,7731,1,15,0)=" "
^DIC(19,7731,1,16,0)="Starts at least 30 minutes after the start of the IB MT NIGHT COMP "
^DIC(19,7731,1,17,0)="nightly process."
^DIC(19,7731,1,18,0)=" "
^DIC(19,7731,1,19,0)="You may need to reschedule the IB MT NIGHT COMP TaskMan job as well to "
^DIC(19,7731,1,20,0)="ensure that it starts at least 30 minutes before the start of the PRCA "
^DIC(19,7731,1,21,0)="NIGHTLY PROCESS TaskMan job."
^DIC(19,7731,3.92,0)="^19.392A^^0"
^DIC(19,7731,15)=""
^DIC(19,7731,20)="D ^PRCABJ"
^DIC(19,7731,99)="55656,52427"
^DIC(19,7731,99.1)="59984,26972"
^DIC(19,7731,200)="2931115.02^^1D"
^DIC(19,7731,200.9)="y"
^DIC(19,7731,"U")="ACCOUNTS RECEIVABLE NIGHTLY PR"
^DIC(19,7732,0)="PRCA PAYMENT TRANS HISTORY^Patient Payment/Refund Transaction History Inquiry^^A^.5^^^^^^^^^1"
^DIC(19,7732,1,0)="^^2^2^2930602^^^^"
^DIC(19,7732,1,1,0)="    This report lists a history of payment/refund transactions for a patient"
^DIC(19,7732,1,2,0)="for a specified date range."
^DIC(19,7732,20)="D ^PRCACOL"
^DIC(19,7732,"U")="PATIENT PAYMENT/REFUND TRANSAC"
^DIC(19,7733,0)="PRCAE REPRINT UB^Reprint UB Letters^^A^.5^^^^^^^261^^1"
^DIC(19,7733,1,0)="^^4^4^2930601^^^"
^DIC(19,7733,1,1,0)="This option allows you to reprint a UB Letter for the selected"
^DIC(19,7733,1,2,0)="date.  You may enter a range of bills to print (print order range)"
^DIC(19,7733,1,3,0)="or have all the UB Letters reprint for that date by not selecting"
^DIC(19,7733,1,4,0)="a bill to start or end the sort."
^DIC(19,7733,20)="D UB^PRCAG K DTOUT"
^DIC(19,7733,"U")="REPRINT UB LETTERS"
^DIC(19,7734,0)="PRCAY FULL ACCOUNT PROFILE^Full Account Profile^^A^.5^^^^^^^261^^1"
^DIC(19,7734,1,0)="^^2^2^2990115^^^^"
^DIC(19,7734,1,1,0)="This option will display a full account profile of all bills for a debtor"
^DIC(19,7734,1,2,0)="regardless of the status of the bill."
^DIC(19,7734,20)="D EN^PRCAAPR(""ALL"") K DTOUT"
^DIC(19,7734,"U")="FULL ACCOUNT PROFILE"
^DIC(19,7735,0)="PRCA LAST ACTIVITY^Report of AR by Last Activity Date^^A^.5^^^^^^^261^^1"
^DIC(19,7735,1,0)="^^16^16^2950224^^"
^DIC(19,7735,1,1,0)="This report will print bills, sorted by category, by the date of Last"
^DIC(19,7735,1,2,0)="Activity.  The date of last activity is defined as the date when the"
^DIC(19,7735,1,3,0)="bill was last 'looked' at or had some activity."
^DIC(19,7735,1,4,0)=" "
^DIC(19,7735,1,5,0)="This date is derived by finding the most recent date of the following:"
^DIC(19,7735,1,6,0)=" "
^DIC(19,7735,1,7,0)="1) Last time a letter printed (LETTER1, LETTER2, LETTER3)"
^DIC(19,7735,1,8,0)="2) Date bill was prepared"
^DIC(19,7735,1,9,0)="3) Date status was last updated"
^DIC(19,7735,1,10,0)="4) Date the last transaction was entered into the system or Transaction date"
^DIC(19,7735,1,11,0)=" "
^DIC(19,7735,1,12,0)="If none of these dates are found, then the default date is 01/01/91."
