^DIC(19,422,1,6,0)=" "
^DIC(19,422,1,7,0)="This option is also used to enter the default output device to print"
^DIC(19,422,1,8,0)="the AMIS code sheets generated for the segments 334-341, 345&346 and"
^DIC(19,422,1,9,0)="401-420. The code sheet printer default must be defined for the user"
