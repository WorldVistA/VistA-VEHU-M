^DIC(19,14858,0)="TIU TEMPLATE CONSULT LOCK^Set consult templates to read-only.^^R^1^^^^^^^516"
^DIC(19,14858,1,0)="^19.06^16^16^3180530^^^^"
^DIC(19,14858,1,1,0)="This option allows the user to lock down a consult TIU Template, and it's "
^DIC(19,14858,1,2,0)="associated Template Fields. Once the template and fields are locked down,"
^DIC(19,14858,1,3,0)="they cannot be edited in the CPRS GUI Template Editor."
^DIC(19,14858,1,4,0)="Certain consult services depend on template content that should not be"
^DIC(19,14858,1,5,0)="edited at the local facility. For example, the NON VA CARE HCPS"
^DIC(19,14858,1,6,0)="HEMODIALYSIS and NON VA CARE HCPS PERITONEAL DIALYSIS templates should"
^DIC(19,14858,1,7,0)="never be edited at the facility. These templates are used in HL7"
^DIC(19,14858,1,8,0)="transmissions to the Referral & Authorization System (RAS) and those"
^DIC(19,14858,1,9,0)="transmissions may be disrupted if the template has been edited."
^DIC(19,14858,1,10,0)=" "
^DIC(19,14858,1,11,0)="When using this option, the user is prompted for the name of a TIU "
^DIC(19,14858,1,12,0)="Template. The selected template must have already been linked to a consult"
^DIC(19,14858,1,13,0)="service via the Template Editor. Unlinked templates are not avaiable for"
^DIC(19,14858,1,14,0)="selection. Adding or removing templates via this option is actually "
^DIC(19,14858,1,15,0)="setting/removing values into the TIU TEMPLATE CONSULT LOCK parameter."
^DIC(19,14858,1,16,0)="These parameter values are set at the System level."
^DIC(19,14858,25)="SETCNLOK^TIUSRVT5"
^DIC(19,14858,"U")="SET CONSULT TEMPLATES TO READ-"
^DIC(19,14859,0)="WV ADD/EDIT MAT CARE COORS^Add/Edit Maternity Care Coordinators^^R^1^^^^^^^522^^1^1"
^DIC(19,14859,1,0)="^19.06^2^2^3150430^^"
^DIC(19,14859,1,1,0)="This option allows adding and editing of maternity care coordinators from "
^DIC(19,14859,1,2,0)="the NEW PERSON file (#200)."
^DIC(19,14859,15)="K WVTYPE"
^DIC(19,14859,20)="S WVTYPE=""MCC"""
^DIC(19,14859,25)="WVCMGR"
^DIC(19,14859,"U")="ADD/EDIT MATERNITY CARE COORDI"
^DIC(19,14860,0)="WV TRANSFER MAT CARE COOR^Transfer a Maternity Care Coordinator's Patients^^R^1^^^^^^^522^^1^1"
^DIC(19,14860,1,0)="^^3^3^3150430^"
^DIC(19,14860,1,1,0)="This option aids in the transfer of all of one Maternity Care "
^DIC(19,14860,1,2,0)="Coordinator's patients to another Maternity Care Coordinator when there "
^DIC(19,14860,1,3,0)="is a turnover in staff."
^DIC(19,14860,15)="K WVTYPE"
^DIC(19,14860,20)="S WVTYPE=""MCC"""
^DIC(19,14860,25)="TRANS^WVCMGR"
^DIC(19,14860,"U")="TRANSFER A MATERNITY CARE COOR"
^DIC(19,14861,0)="WV EDIT PACKAGE PARAMETERS^Edit Package Parameters^^R^1^^^^^^^522"
^DIC(19,14861,1,0)="^^1^1^3190108^"
^DIC(19,14861,1,1,0)="This option allows the user to edit Women's Health parameters at the package level."
^DIC(19,14861,25)="EDIT^WVPKG"
^DIC(19,14861,"U")="EDIT PACKAGE PARAMETERS"
^DIC(19,14862,0)="DG EVENT NOTIFIER^Registration Event Notifier^^R^1^^^^^^^114"
^DIC(19,14862,1,0)="^19.06^5^5^3200922^^"
^DIC(19,14862,1,1,0)="This option will distribute data change notification messages to "
^DIC(19,14862,1,2,0)="subscribing packages. These messages are queued (i.e., not sent in real "
^DIC(19,14862,1,3,0)="time) and are distributed via the following protocols:"
^DIC(19,14862,1,4,0)="  DG PTF ICD DIAGNOSIS NOTIFIER"
^DIC(19,14862,1,5,0)="  DG SA FILE ENTRY NOTIFIER"
^DIC(19,14862,25)="EN^DGPTFN1"
^DIC(19,14862,200.9)="y"
^DIC(19,14862,"U")="REGISTRATION EVENT NOTIFIER"
^DIC(19,14863,0)="PXRM DIALOG VIMM PRE REPORT^Reminder Dialog CPRS 32 pre conversion report^^A^1^^^^^^^534^^1"
^DIC(19,14863,1,0)="^^2^2^3180522^"
^DIC(19,14863,1,1,0)="This options list any dialog item that needs to be updated before CPRS 32 "
^DIC(19,14863,1,2,0)="is installed."
^DIC(19,14863,20)="D EN^PXRMDRVI"
^DIC(19,14863,"U")="REMINDER DIALOG CPRS 32 PRE CO"
^DIC(19,14864,0)="PXRM TERM INTEGRITY CHECK ALL^Integrity Check All^^R^1^^^^^^^534"
^DIC(19,14864,1,0)="^19.06^3^3^3180830^^"
^DIC(19,14864,1,1,0)="This option runs the integrity check for all reminder terms on the"
^DIC(19,14864,1,2,0)="system."
^DIC(19,14864,1,3,0)=""
^DIC(19,14864,25)="TCHKALL^PXRMICK1"
^DIC(19,14864,"U")="INTEGRITY CHECK ALL"
^DIC(19,14865,0)="PXRM TERM INTEGRITY CHECK ONE^Integrity Check Selected^^R^1^^^^^^^534"
^DIC(19,14865,1,0)="^19.06^2^2^3180830^^"
^DIC(19,14865,1,1,0)="This option lets the user select a reminder term for integrity checking."
^DIC(19,14865,1,2,0)=""
^DIC(19,14865,25)="TCHKONE^PXRMICK1"
^DIC(19,14865,"U")="INTEGRITY CHECK SELECTED"
^DIC(19,14866,0)="PXRM EVALUATE COVERSHEET^Evaluate Coversheet List on Dialog Finish^^A^1^^^^^^^534^^1"
^DIC(19,14866,20)="D EDITPAR^XPAREDIT(""PXRM DIALOG EVAL DEFINITION"")"
^DIC(19,14866,"U")="EVALUATE COVERSHEET LIST ON DI"
^DIC(19,14867,0)="PXRM DIALOG LINK TO TEMPLATE^Link Reminder Dialog to Template^^R^1^^^^^^^534"
^DIC(19,14867,1,0)="^^2^2^3191015^"
^DIC(19,14867,1,1,0)="This option is use to automatically link a dialog to a TIU Template in "
^DIC(19,14867,1,2,0)="file 8927.1."
^DIC(19,14867,25)="EN^PXRMDLED"
^DIC(19,14867,"U")="LINK REMINDER DIALOG TO TEMPLA"
^DIC(19,14868,0)="GMRC FSC HCP MAIL GROUP^Define FSC HCP Mail Group^^A^1^^^^^^^294^^1"
^DIC(19,14868,1,0)="^^12^12^3170330^"
^DIC(19,14868,1,1,0)="This option is used to edit the GMRC FSC HCP MAIL GROUP parameter. This "
^DIC(19,14868,1,2,0)="parameter stores an email address for the VA FSC HCP Support group"
^DIC(19,14868,1,3,0)="(Financial Services Center, Healthcare Claims Processing). This mail group"
^DIC(19,14868,1,4,0)="will receive mail messages regarding transmission-related errors in"
^DIC(19,14868,1,5,0)="sending consults to HCPS. These mail messages are the same as those sent "
^DIC(19,14868,1,6,0)="to the VistA mail group GMRC HCP HL7 MESSAGES."
^DIC(19,14868,1,7,0)=" "
^DIC(19,14868,1,8,0)="This option was created to provide facilities with the ability to update"
^DIC(19,14868,1,9,0)="the mail group without the need for a new Consult/Request Tracking (GMRC)"
^DIC(19,14868,1,10,0)="patch. Ordinarily, the mail group value should not be edited. If an edit "
^DIC(19,14868,1,11,0)="is required, facilities will be advised of the need via national-level "
^DIC(19,14868,1,12,0)="communication."
^DIC(19,14868,20)="D TEDH^XPAREDIT(""GMRC FSC HCP MAIL GROUP"")"
^DIC(19,14868,"U")="DEFINE FSC HCP MAIL GROUP"
^DIC(19,14869,0)="ORK CANCELLED ORDER CHK VIEW^Cancelled Order Check Viewer/Report^^R^1^^^^^^^"
^DIC(19,14869,25)="EN^ORNORC"
^DIC(19,14869,"U")="CANCELLED ORDER CHECK VIEWER/R"
^DIC(19,14870,0)="ORLP TEAM LIST FROM REM^Update Team List From Reminder List Rule^^R^1^^^^^^^"
^DIC(19,14870,1,0)="^^7^7^3170502^"
^DIC(19,14870,1,1,0)="This option should be queued to run via TaskMan. This option will update "
^DIC(19,14870,1,2,0)="the patients in an OE/RR List (#100.21) based off a Reminder List Rule"
^DIC(19,14870,1,3,0)="(#810.4)."
^DIC(19,14870,1,4,0)=" "
^DIC(19,14870,1,5,0)="The mappings between a reminder list rule and a team list can be done via"
^DIC(19,14870,1,6,0)="the option Automate List Rule to Update List [ORLP SETUP TEAM LIST FROM"
^DIC(19,14870,1,7,0)="REM]."
^DIC(19,14870,25)="ENTASK^ORLPREM"
^DIC(19,14870,200.9)="y"
^DIC(19,14870,"U")="UPDATE TEAM LIST FROM REMINDER"
^DIC(19,14871,0)="ORLP SETUP TEAM LIST FROM REM^Automate           List Rule to Update List^^R^1^^^^^^^170"
^DIC(19,14871,1,0)="^^6^6^3170502^"
^DIC(19,14871,1,1,0)="This option allows a reminder list rule to be mapped to a team list, and "
^DIC(19,14871,1,2,0)="configure how often the list rule should be ran and update the team list."
^DIC(19,14871,1,3,0)=" "
^DIC(19,14871,1,4,0)="The tasked option, Update Team List From Reminder List Rule [ORLP TEAM"
^DIC(19,14871,1,5,0)="LIST FROM REM], will use these mappings and settings, to determine which"
^DIC(19,14871,1,6,0)="list rules should be ran and which team lists to update."
^DIC(19,14871,25)="EN^ORLPREML"
^DIC(19,14871,"U")="AUTOMATE           LIST RULE T"
^DIC(19,14872,0)="DG OTH STATISTICAL REPORT^Statistical Report (OTH-90)^^R^1^^^^^^^"
