^DIC(19,8021,1,0)="^^4^4^2930823^"
^DIC(19,8021,1,1,0)="This option is used to list all special inpatient billing cases.  After"
^DIC(19,8021,1,2,0)="a case has been dispositioned, the output will include either the reason"
^DIC(19,8021,1,3,0)="for non-billing, or all of the charges which have been billed for the"
^DIC(19,8021,1,4,0)="admission."
^DIC(19,8021,25)="LIST^IBAMTI2"
^DIC(19,8021,"U")="LIST SPECIAL INPATIENT BILLING"
