^DIC(19,13681,0)="PRSRFI EMP TOUR HR DISP^Display Employee Tour Hours^^R^1^^^^^^^"
^DIC(19,13681,1,0)="^19.06^4^4^3080709^^^"
^DIC(19,13681,1,1,0)="This option allows payroll to view any employee's tour of duty number, "
^DIC(19,13681,1,2,0)="tour of duty hours, tour hours on each day and 8B normal hours. The Tour"
^DIC(19,13681,1,3,0)="Hours column contains a total of any tour hours that fall on that day.  "
^DIC(19,13681,1,4,0)="So, two day tours will contribute hours to both days on which they fall."
^DIC(19,13681,25)="TOURHRP^PRSA8BTH"
^DIC(19,13681,"U")="DISPLAY EMPLOYEE TOUR HOURS"
^DIC(19,13682,0)="PRSRSU EMP TOUR HR DISP^Display Employee Tour Hours^^R^1^^^^^^^"
^DIC(19,13682,1,0)="^19.06^5^5^3080709^^^"
^DIC(19,13682,1,1,0)="This option allows T&A supervisors to view employee's tour of duty number,"
^DIC(19,13682,1,2,0)="tour of duty hours, tour hours on each day and 8B normal hours for a"
^DIC(19,13682,1,3,0)="selected pay period within the T&L units assigned to them. The Tour Hours"
^DIC(19,13682,1,4,0)="column contains a total of any tour hours that fall on that day.  So, two"
^DIC(19,13682,1,5,0)="day tours will contribute hours to both days on which they fall."
^DIC(19,13682,25)="TOURHRS^PRSA8BTH"
^DIC(19,13682,"U")="DISPLAY EMPLOYEE TOUR HOURS"
^DIC(19,13683,0)="PRSRTK EMP TOUR HR DISP^Display Employee Tour Hours^^R^1^^^^^^^"
^DIC(19,13683,1,0)="^19.06^5^5^3080709^^"
^DIC(19,13683,1,1,0)="This option allows timekeepers to view employee's tour of duty number,"
^DIC(19,13683,1,2,0)="tour of duty hours, tour hours on each day and 8B normal hours for a"
^DIC(19,13683,1,3,0)="selected pay period within the T&L units assigned to them. The Tour Hours"
^DIC(19,13683,1,4,0)="column contains a total of any tour hours that fall on that day.  So, two"
^DIC(19,13683,1,5,0)="day tours will contribute hours to both days on which they fall."
^DIC(19,13683,25)="TOURHRT^PRSA8BTH"
^DIC(19,13683,"U")="DISPLAY EMPLOYEE TOUR HOURS"
