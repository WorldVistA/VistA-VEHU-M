^DIC(19,11776,0)="PRCP CONVERT SECONDARY^Convert Secondary to Primary^^R^11740^PRCP MGRKEY^^^^^^"
^DIC(19,11776,1,0)="^^10^10^2990625^"
^DIC(19,11776,1,1,0)="Converts an existing secondary inventory point (must be a DISTRIBUTION"
^DIC(19,11776,1,2,0)="POINT FOR THE PRIMARY MOST RECENTLY SELECTED) into a primary. Existing"
^DIC(19,11776,1,3,0)="stock and reorder levels may be preserved."
^DIC(19,11776,1,4,0)=" "
^DIC(19,11776,1,5,0)="Existing PROCUREMENT SOURCES and the MANDATORY SOURCE (if present) in the"
^DIC(19,11776,1,6,0)="secondary being converted will be replaced with the corresponding fields"
^DIC(19,11776,1,7,0)="from the existing primary that supplies it."
^DIC(19,11776,1,8,0)=" "
^DIC(19,11776,1,9,0)="It is anticipated that this option will be used most frequently in"
^DIC(19,11776,1,10,0)="conjunction with linkage of multiple primaries to a single FCP."
^DIC(19,11776,25)="PRCPCSP"
^DIC(19,11776,"U")="CONVERT SECONDARY TO PRIMARY"
^DIC(19,11777,0)="PRCP UNDO CONVERSION^Undo a Secondary to Primary Conversion^^R^11720^PRCP MGRKEY^^^^^^121^^^"
^DIC(19,11777,1,0)="^19.06^8^8^3010108^^^^"
^DIC(19,11777,1,1,0)="Undoes a conversion from secondary to primary. That is, the inventory"
^DIC(19,11777,1,2,0)="point will become a secondary once again."
^DIC(19,11777,1,3,0)=" "
^DIC(19,11777,1,4,0)="All inventory parameters, stock levels, reorder points, procurement"
^DIC(19,11777,1,5,0)="sources, and MIS costing sections will automatically be restored to"
^DIC(19,11777,1,6,0)="whatever they were immediately prior to conversion."
^DIC(19,11777,1,7,0)=" "
^DIC(19,11777,1,8,0)="The inventory point will also be reconnected with its former primary."
^DIC(19,11777,15)=""
^DIC(19,11777,20)=""
^DIC(19,11777,25)="EN^PRCPCSPX"
^DIC(19,11777,"U")="UNDO A SECONDARY TO PRIMARY CO"
