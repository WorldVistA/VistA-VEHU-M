^DIC(19,9712,0)="GMRYMGR^Patient Intake/Output Menu^^M^10958^^^^^^^502^^"
^DIC(19,9712,1,0)="^^4^4^2960507^^^^"
^DIC(19,9712,1,1,0)="This is the main menu for the Intake and Output(I&O) application.  It"
^DIC(19,9712,1,2,0)="contains options for: (1) tracking patient intake and output, (2) starting"
^DIC(19,9712,1,3,0)="and discontinuing IV lines and fluids, (3) documenting IV care, and (4)"
^DIC(19,9712,1,4,0)="printing various intake and output reports."
^DIC(19,9712,10,0)="^19.01PI^11^9"
^DIC(19,9712,10,1,0)="9706^1^1"
^DIC(19,9712,10,2,0)="9693^2^2"
