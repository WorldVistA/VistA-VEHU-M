^DIC(19,15650,1,0)="^19.06^3^3^3240328^^^^"
^DIC(19,15650,1,1,0)="When you no longer need a patient list that you have built, you"
^DIC(19,15650,1,2,0)="can use this option to delete the list."
^DIC(19,15650,1,3,0)="Cloned from ""ORLP DELETE"" option."
