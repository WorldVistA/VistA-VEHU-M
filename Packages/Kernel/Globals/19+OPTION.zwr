^DIC(19,14968,0)="PSO MBM-VPS PRODUCTIVITY RPT^MbM-VPS Productivity Report^^R^1^^^^^^^"
^DIC(19,14968,1,0)="^19.06^5^5^3210503^^^"
^DIC(19,14968,1,1,0)="This option was created for the Meds by Mail (MbM) Virtual Pharmacy"
^DIC(19,14968,1,2,0)="Services (VPS) staff and generates a report that displays the names of"
^DIC(19,14968,1,3,0)="people who have finished Rx orders, the number of orders finished by each"
^DIC(19,14968,1,4,0)="person, and the total number of orders finished for a user-defined time"
^DIC(19,14968,1,5,0)="frame."
