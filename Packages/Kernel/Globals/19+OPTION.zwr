^DIC(19,8430,0)="LR WKLD STATS ON^Turn on site workload statistics^^E^.5^LRLIASON^^^^^^26"
^DIC(19,8430,1,0)="^^8^8^2940331^^^^"
^DIC(19,8430,1,1,0)="  This option is used to turn on workload compiling features of"
^DIC(19,8430,1,2,0)="Version 5.2 (Workload). In order for any workload statistics to be"
^DIC(19,8430,1,3,0)="gathered, this field must be turned on (answer YES). When this field"
^DIC(19,8430,1,4,0)="is turned on, phlebotomy workload data will be tallied."
^DIC(19,8430,1,5,0)="(the field is WKLD STATS ON, #17, in the Laboratory site file, #69.9)"
^DIC(19,8430,1,6,0)="  NOTE: There is a secondary switch to turn on workload data for"
^DIC(19,8430,1,7,0)="each accession area (WORKLOAD ON). Both this field and the field WORKLOAD ON"
^DIC(19,8430,1,8,0)="in the accession area (#68) must be answered YES."
^DIC(19,8430,30)="LAB(69.9,"
^DIC(19,8430,31)="AEQ"
^DIC(19,8430,50)=69.9
^DIC(19,8430,51)="[LR WKLD STATS ON]"
^DIC(19,8430,"U")="TURN ON SITE WORKLOAD STATISTI"
^DIC(19,8431,0)="LR WKLD STATS ON ACC AREA^Turn on workload stats for accession area^^E^.5^LRLIASON^^^^^^26"
^DIC(19,8431,1,0)="6^^7^7^2940331^"
^DIC(19,8431,1,1,0)="  This option turns on workload data collection for a specific"
^DIC(19,8431,1,2,0)="accession area. If you wish to begin collection workload data for"
^DIC(19,8431,1,3,0)="this accession area answer YES."
^DIC(19,8431,1,4,0)="(field WORKLOAD ON, #10, in the ACCESSION file, #68)"
^DIC(19,8431,1,5,0)="   NOTE:  YOU MUST ALSO HAVE (FIELD #17) WKLD STATS ON IN THE "
^DIC(19,8431,1,6,0)="LABORATORY SITE FILE (#69.9) ANSWERED YES.   BOTH FIELDS MUST"
^DIC(19,8431,1,7,0)="BE ANSWER 'YES' FOR DATA COLLECTION TO BE ACTIVATED."
^DIC(19,8431,30)="LRO(68,"
^DIC(19,8431,31)="AEQ"
^DIC(19,8431,50)=68
^DIC(19,8431,51)="[LR WKLD STATS ON ACC AREA]"
^DIC(19,8431,"U")="TURN ON WORKLOAD STATS FOR ACC"
