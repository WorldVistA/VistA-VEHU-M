^DIC(19,7875,"U")="MANAGER UTILITIES"
^DIC(19,7876,0)="XDR MAIN MENU^Duplicate Resolution System^^M^1039^XDR^^^^^^349^^1^1"
^DIC(19,7876,1,0)="^^1^1^2970806^^^^"
^DIC(19,7876,1,1,0)="This is the main menu for the Duplicate Resolution System."
^DIC(19,7876,10,0)="^19.01PI^3^3"
^DIC(19,7876,10,1,0)="7863^XDRO^1"
^DIC(19,7876,10,2,0)="7874^XDRU^2"
^DIC(19,7876,10,3,0)="7875^XDRM^3"
