^DIC(19,15586,20)="D ADD^ORLP0"
^DIC(19,15586,"U")="PATIENT        (ADD TO LIST)"
^DIC(19,15587,0)="EHM-00408^Ward           (Add to list)^^A^1^^^^^^^^^1^1^"
^DIC(19,15587,1,0)="^19.06^5^5^3240328^^^^"
^DIC(19,15587,1,1,0)="You can create a patient list by selecting 1 or more wards or"
^DIC(19,15587,1,2,0)="you can add wards to a currently existing list "
^DIC(19,15587,1,3,0)="using this menu.  After you have added a ward, you can delete"
^DIC(19,15587,1,4,0)="or add patients to customize the list."
^DIC(19,15587,1,5,0)="Cloned from ""ORLP ADD WARD"" option."
