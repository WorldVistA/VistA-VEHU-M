^DIC(19,9193,1,1,0)="This option will allow site staff to indicate a replacement device and to"
^DIC(19,9193,1,2,0)="then repoint and waiting and future tasks to the new device."
^DIC(19,9193,1,3,0)="This is useful when a site renames devices or device becomes deadicated to"
^DIC(19,9193,1,4,0)="a special task. The option can also go thru the OPTION SCVHEDULING file to"
^DIC(19,9193,1,5,0)="repoint devices in this file."
^DIC(19,9193,25)="XUTMRP"
^DIC(19,9193,"U")="CHANGE TASKS DEVICE"
