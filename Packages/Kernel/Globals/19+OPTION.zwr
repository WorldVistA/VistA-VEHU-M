^DIC(19,12634,0)="SRO ECS COMPLIANCE^Ensuring Correct Surgery Compliance Report^Not used after patch SR*3*175^R^10000000216^^^^^^^167^^1^1"
^DIC(19,12634,1,0)="^^6^6^3030623^"
^DIC(19,12634,1,1,0)="This option produces the Ensuring Correct Surgery Compliance Report. "
^DIC(19,12634,1,2,0)="This report is a two-part report: (1) the compliance summary and (2) the "
^DIC(19,12634,1,3,0)="list of non-compliant cases. The report is printed for a selected date "
^DIC(19,12634,1,4,0)="range and may be sorted by surgical specialty. This report is a tool for"
^DIC(19,12634,1,5,0)="reviewing compliance with the documentation process for ensuring correct"
^DIC(19,12634,1,6,0)="surgery."
^DIC(19,12634,15)="D EXIT^SROVAR"
^DIC(19,12634,20)="D ^SROVAR"
^DIC(19,12634,25)="SROPECS"
^DIC(19,12634,"U")="ENSURING CORRECT SURGERY COMPL"
