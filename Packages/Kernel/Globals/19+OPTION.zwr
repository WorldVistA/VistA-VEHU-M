^DIC(19,8527,1,2,0)="Substances drugs used in IV orders. Only infusion orders requiring the VA"
^DIC(19,8527,1,3,0)="FORM 10-2638 should be requested using this"
^DIC(19,8527,1,4,0)="option."
^DIC(19,8527,25)="PSDORV"
^DIC(19,8527,"U")="INFUSION ORDER ENTRY"
