^DIC(19,11200,1,0)="^19.06^5^5^3030814^^"
^DIC(19,11200,1,1,0)="This option prints HBPC Provider CPT Code Summary Report.  User is prompted"
^DIC(19,11200,1,2,0)="to enter date range, CPT code(s) (can be range of CPTs), & Provider for"
^DIC(19,11200,1,3,0)="inclusion on report.   Report includes:  Provider Name in header, CPT code(s)"
^DIC(19,11200,1,4,0)="with summary total(s) & grand total for all CPTs.  Report prints in 80 column"
^DIC(19,11200,1,5,0)="format. "
^DIC(19,11200,25)="HBHCRP22"
