^DIC(19,16659,0)="EHM-01480^Edit HT PERIODIC Reminder Definition Frequency^^R^1^^^^^^^534^^^^"
^DIC(19,16659,1,0)="^^7^7^3240328^"
^DIC(19,16659,1,1,0)="This option will allow an edit of the REMINDER FREQUENCY value of the "
^DIC(19,16659,1,2,0)="VA-HT PERIODIC EVALUATION reminder definition. This option will also use "
^DIC(19,16659,1,3,0)="the new frequency value to automatically update both of the function"
^DIC(19,16659,1,4,0)="findings defined for this reminder definition. The default frequency for"
^DIC(19,16659,1,5,0)="this reminder is 180D. These are the frequencies available via this"
^DIC(19,16659,1,6,0)="option: 90D (or 3M), 120D (or 4M), 180D (or 6M)"
^DIC(19,16659,1,7,0)="Cloned from ""PXRM HT DEFINITION EDIT"" option."
^DIC(19,16659,3)=""
^DIC(19,16659,25)="EDIT^PXRMHTED"
