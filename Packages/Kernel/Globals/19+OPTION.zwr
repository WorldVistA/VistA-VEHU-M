^DIC(19,1352,0)="LRUAC^Print accession list(s)^^M^.5^^^^^^^26"
^DIC(19,1352,1,0)="^^2^2^2930513^^^^"
^DIC(19,1352,1,1,0)="Lists of accessions for an accession area"
^DIC(19,1352,1,2,0)=" Choice of by date, by number, by patient or for a collection sample"
