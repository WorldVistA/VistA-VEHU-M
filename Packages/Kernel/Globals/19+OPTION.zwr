^DIC(19,6751,1,1,0)="This report lists all Controlled Substances drugs being held for"
^DIC(19,6751,1,2,0)="destruction."
^DIC(19,6751,25)="PSDHRPT"
^DIC(19,6751,"U")="DESTRUCTIONS HOLDING REPORT"
