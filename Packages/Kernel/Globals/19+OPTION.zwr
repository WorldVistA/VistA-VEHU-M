^DIC(19,16502,0)="EHM-01323^CPRS Lookup Categories^^A^1^^^^^^^534^^1^^"
^DIC(19,16502,1,0)="^^7^7^3240328^"
^DIC(19,16502,1,1,0)="This option allows a user to modify the ""Reminder Categories for Lookup"""
^DIC(19,16502,1,2,0)="CPRS parameter.  This parameter defines reminder categories to display in"
^DIC(19,16502,1,3,0)="the ""reminders available"" window and the note tabs' reminder drawer under"
^DIC(19,16502,1,4,0)="""OTHER"". The reminders that are defined in the categories are available to"
^DIC(19,16502,1,5,0)="the CPRS GUI user to selectively evaluate and process. They are not"
^DIC(19,16502,1,6,0)="automatically evaluated when the cover sheet is built."
^DIC(19,16502,1,7,0)="Cloned from ""PXRM CPRS LOOKUP CATEGORIES"" option."
^DIC(19,16502,3)=""
^DIC(19,16502,20)="D EDITPAR^XPAREDIT(""PXRM CPRS LOOKUP CATEGORIES"")"
^DIC(19,16502,"U")="CPRS LOOKUP CATEGORIES"
