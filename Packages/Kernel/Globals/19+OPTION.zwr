^DIC(19,12051,0)="PSXR ACTIVATE^Activate/Inactivate CMOP Processing^^R^10000000020^PSXCMOPMGR^^^^^^528^^"
^DIC(19,12051,1,0)="^^3^3^2941115^^^^"
^DIC(19,12051,1,1,0)="The site manager for the Consolidated Mail Outpatient Pharmacy selects"
^DIC(19,12051,1,2,0)="this option to activate the medical center for CMOP processing of outpatient"
^DIC(19,12051,1,3,0)="prescriptions."
^DIC(19,12051,20)=""
^DIC(19,12051,25)="EN1^PSXSITE"
^DIC(19,12051,"U")="ACTIVATE/INACTIVATE CMOP PROCE"
^DIC(19,12052,0)="PSXR PURGE^Purge Status of CMOP Rx Queue^^R^10000000020^^^^^^^"
^DIC(19,12052,1,0)="^^2^2^2941218^"
^DIC(19,12052,1,1,0)="This option provides a report of the latest purge of the CMOP RX QUEUE"
^DIC(19,12052,1,2,0)="file (#550.1)."
^DIC(19,12052,25)="REPT^PSXPURG"
^DIC(19,12052,"U")="PURGE STATUS OF CMOP RX QUEUE"
^DIC(19,12053,0)="PSXR RX WORKLOAD REPORT^Rx Workload Report^^R^10000000020^^^^^^^528"
^DIC(19,12053,1,0)="^^6^6^2941209^"
^DIC(19,12053,1,1,0)=" "
^DIC(19,12053,1,2,0)="This report provides daily totals for a selected date range listing"
^DIC(19,12053,1,3,0)="prescriptions entered with a mail and window routing, mail and window"
^DIC(19,12053,1,4,0)="prescriptions released by Outpatient, and prescriptions released by CMOP."
^DIC(19,12053,1,5,0)="The OTHER column totals all other prescriptions, i.e., cancelled, deleted,"
^DIC(19,12053,1,6,0)="etc."
^DIC(19,12053,25)="PSXRSTAT"
^DIC(19,12053,"U")="RX WORKLOAD REPORT"
^DIC(19,12054,0)="PSXR REPORTS MENU^Reports Menu^^M^10000000020^^^^^^^528"
^DIC(19,12054,1,0)="^^3^3^2960628^^"
^DIC(19,12054,1,1,0)=" "
^DIC(19,12054,1,2,0)="This menu provides reports available at the CMOP remote medical centers"
^DIC(19,12054,1,3,0)="which contain information on data transmitted to the host facility."
^DIC(19,12054,10,0)="^19.01PI^4^4"
^DIC(19,12054,10,1,0)="12055^"
^DIC(19,12054,10,2,0)="12056^"
^DIC(19,12054,10,3,0)="12053^"
^DIC(19,12054,10,4,0)=12058
