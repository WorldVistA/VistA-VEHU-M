^DIC(19,13795,0)="SDRR DELETE RECALL^Delete/Cancel Clinic Recall Entry^^R^10000000020^^^^^^^16^^1"
^DIC(19,13795,1,0)="^^1^1^3090817^"
^DIC(19,13795,1,1,0)="This option allows Recall Reminder entries to be cancelled or deleted.  "
^DIC(19,13795,20)="S DIDEL=403.5"
^DIC(19,13795,25)="SDRRDEL"
^DIC(19,13795,30)="SD(403.5"
^DIC(19,13795,31)="AEMQ"
^DIC(19,13795,50)=""
^DIC(19,13795,51)=""
