^DIC(19,6639,0)="ONCO FOLL PROCEDURE MENU^Follow-up Procedures Menu^^M^.5^^^^^^^^^1^1"
^DIC(19,6639,1,0)="^^1^1^2910327^^^^"
^DIC(19,6639,1,1,0)="Takes the place of Followup System and performs same functions."
^DIC(19,6639,10,0)="^19.01PI^7^6"
^DIC(19,6639,10,1,0)="6640^AC^10"
^DIC(19,6639,10,2,0)="6641^AF^40"
