^DIC(19,6800,1,2,0)="DRUG file (#50) for entries not yet linked to the ITEM MASTER file (#441)."
^DIC(19,6800,1,3,0)="It links all National Drug Code (NDC) matches found in the ITEM MASTER"
^DIC(19,6800,1,4,0)="file and reports the matches to the user as links occur."
^DIC(19,6800,25)="PSALNA"
^DIC(19,6800,"U")="AUTOMATED DRUG/ITEM MASTER FIL"
^DIC(19,6801,0)="PSA FSN REPORT^Report Potential FSN Matches^^R^11595^^^^^^^287"
^DIC(19,6801,1,0)="^^4^4^2970923^"
^DIC(19,6801,1,1,0)="The Report Potential FSN Matches option scans the DRUG file (#50) for"
^DIC(19,6801,1,2,0)="entries not yet linked to the ITEM MASTER file (#441) that have a Federal"
^DIC(19,6801,1,3,0)="Stock Number (FSN) entered. It then checks the ITEM MASTER file for a FSN"
^DIC(19,6801,1,4,0)="match."
^DIC(19,6801,25)="PSALFS"
^DIC(19,6801,"U")="REPORT POTENTIAL FSN MATCHES"
^DIC(19,6802,0)="PSA FSN CONTROL LOOP^Controlled Connection by FSN Match^^R^11595^^^^^^^287"
^DIC(19,6802,1,0)="^^4^4^2970923^"
^DIC(19,6802,1,1,0)="The Controlled Connection by FSN Match option loops through the DRUG file"
^DIC(19,6802,1,2,0)="(#50) for entries not yet linked to the ITEM MASTER file (#441). It checks"
^DIC(19,6802,1,3,0)="for a Federal Stock Number (FSN) match with the ITEM MASTER file and, if"
^DIC(19,6802,1,4,0)="one is located, the user is asked to approve the link."
^DIC(19,6802,25)="PSALFM"
^DIC(19,6802,"U")="CONTROLLED CONNECTION BY FSN M"
^DIC(19,6803,0)="PSA FSN AUTO LOOP^Automated DRUG/ITEM MASTER file Link by FSN^^R^11595^^^^^^^287"
^DIC(19,6803,1,0)="^^4^4^2970923^"
^DIC(19,6803,1,1,0)="The Automated DRUG/ITEM MASTER file Link by FSN option loops through the"
^DIC(19,6803,1,2,0)="DRUG file (#50) for entries not yet linked to the ITEM MASTER file (#441)."
^DIC(19,6803,1,3,0)="It links all Federal Stock Numbers (FSN) matches found in the ITEM MASTER"
^DIC(19,6803,1,4,0)="file, reporting matches to the user as links occur."
^DIC(19,6803,25)="PSALFA"
^DIC(19,6803,"U")="AUTOMATED DRUG/ITEM MASTER FIL"
^DIC(19,6804,0)="PSA FSN MENU^FSN Menu^^M^11595^^^^^^^287^^1"
^DIC(19,6804,1,0)="^^3^3^2970923^^"
^DIC(19,6804,1,1,0)="The FSN menu contains options that report and match drugs by the Federal"
^DIC(19,6804,1,2,0)="Stock Number (FSN) link between the DRUG (#50) and ITEM MASTER (#441)"
^DIC(19,6804,1,3,0)="files."
