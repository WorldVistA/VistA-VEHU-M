^DIC(19,569,0)="PSJI ORDER^Order Entry (IV)^^R^11712^^^^^^^115^^1"
^DIC(19,569,1,0)="^^4^4^2920124^"
^DIC(19,569,1,1,0)="  The option allows for the entry of new orders, editing of existing"
^DIC(19,569,1,2,0)="orders, renewing orders, discontinuing orders, and holding orders.  A"
^DIC(19,569,1,3,0)="profile is always displayed for the patient so that an episode of care can"
^DIC(19,569,1,4,0)="be viewed as a whole by the pharmacist."
^DIC(19,569,20)=";"
^DIC(19,569,25)="PSIVORE"
^DIC(19,569,99)="55444,31495"
