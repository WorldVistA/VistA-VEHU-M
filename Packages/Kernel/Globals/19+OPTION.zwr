^DIC(19,15690,"U")="ALLOCATE OE/RR SECURITY KEYS"
^DIC(19,15691,0)="EHM-00512^Print Formats^^A^1^^^^^^^^^1^^"
^DIC(19,15691,1,0)="^^3^3^3240328^^^^"
^DIC(19,15691,1,1,0)="This option allows the user to define formats for printing labels and"
^DIC(19,15691,1,2,0)="requisitions for orders."
^DIC(19,15691,1,3,0)="Cloned from ""ORCL PRINT FORMAT"" option."
^DIC(19,15691,3)=""
^DIC(19,15691,20)="D EN^ORPR00"
^DIC(19,15691,"U")="PRINT FORMATS"
^DIC(19,15692,0)="EHM-00513^Notification Mgmt Menu^^M^1^^^^^^^^^^^"
^DIC(19,15692,1,0)="^^6^6^3240328^^^^"
^DIC(19,15692,1,1,0)="This menu is used by clinical coordinators and IRM staff to turn"
^DIC(19,15692,1,2,0)="notifications on or off for a provider.  It prompts the coordinator for the"
^DIC(19,15692,1,3,0)="user/provider for whom they are turning on/off notifications then calls "
^DIC(19,15692,1,4,0)="other notification mgmt options.  It also contains options that can"
^DIC(19,15692,1,5,0)="purge exisitng notifications."
^DIC(19,15692,1,6,0)="Cloned from ""ORB NOT COORD MENU"" option."
^DIC(19,15692,3)=""
^DIC(19,15692,10,0)="^19.01IP^17^17"
