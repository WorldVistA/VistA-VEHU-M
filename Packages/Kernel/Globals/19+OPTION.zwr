^DIC(19,10990,0)="ORE LAB ORDERS CHECK 100=>69^Check Lab orders from file 100 to 69^^A^11712^^^^^^^170^^1"
^DIC(19,10990,1,0)="^^5^5^2990521^"
^DIC(19,10990,1,1,0)="This option checks for inconsistencies between OE/RR and Lab files"
^DIC(19,10990,1,2,0)="and attempts to correct them.  There is no set frequency for running this"
^DIC(19,10990,1,3,0)="option, but it should be run every few months to check for"
^DIC(19,10990,1,4,0)="inconsistencies.  This option will take a long time to run, so run it at"
^DIC(19,10990,1,5,0)="night or over a weekend."
^DIC(19,10990,20)="D EN^ORELR"
^DIC(19,10990,"U")="CHECK LAB ORDERS FROM FILE 100"
