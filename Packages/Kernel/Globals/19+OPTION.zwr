^DIC(19,6967,20)=""
^DIC(19,6967,25)="EN^GMRCPZ"
^DIC(19,6967,"U")="PHARMACY TPN CONSULTS"
^DIC(19,6969,0)="GMRC SERVICE USER MGMT^Service User Management^^E^11712^^^^^^^"
^DIC(19,6969,1,0)="^^12^12^2970703^^^^"
^DIC(19,6969,1,1,0)="This option is used to identify individuals or teams which should be "
^DIC(19,6969,1,2,0)="notified when a Consult/Request is being sent to their receiving service."
^DIC(19,6969,1,3,0)="  "
^DIC(19,6969,1,4,0)="It is also used to identify individuals who will not be notified when"
^DIC(19,6969,1,5,0)="consults are being sent to the service, but DO have update/tracking"
^DIC(19,6969,1,6,0)="capabilities for the service."
^DIC(19,6969,1,7,0)=" "
^DIC(19,6969,1,8,0)="Individuals or teams may also be notified of a new consult based on the"
^DIC(19,6969,1,9,0)="Patient's Location.  When a Consult/Request is sent to a service, the"
^DIC(19,6969,1,10,0)="Patient Location will be checked.  If the receiving service has broken"
^DIC(19,6969,1,11,0)="down their service notification by Hospital location, the notification "
^DIC(19,6969,1,12,0)="will be sent to the individual and/or a team defined in this option."
^DIC(19,6969,30)="GMR(123.5,"
^DIC(19,6969,31)="AEMQZ"
^DIC(19,6969,32)="Select Service/Specialty:"
^DIC(19,6969,50)="GMR(123.5,"
^DIC(19,6969,51)="[GMRC SERVICE USER MGMT]"
