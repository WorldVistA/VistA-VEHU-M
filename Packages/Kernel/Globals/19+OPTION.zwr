^DIC(19,12917,0)="SCRPW APM TASK JOB^Schedule APM Performance Monitor Task^This functionality is now accomplished by CDW/VSSC.^R^10000000020^^^^^^^16"
^DIC(19,12917,1,0)="^19.06^4^4^3031022^^^^"
^DIC(19,12917,1,1,0)="JOB FOR APM DATA EXTRACT [SCRPW APM TASK JOB], will be scheduled to run on"
^DIC(19,12917,1,2,0)="the 15th of each month as a background job through the OPTIONSCHEDULING"
^DIC(19,12917,1,3,0)="file. It will collect data for the previous month and it will transmit an"
^DIC(19,12917,1,4,0)="HL7 message to AAC. "
^DIC(19,12917,25)="EN^SDPMHLS"
^DIC(19,12917,200.9)="y"
