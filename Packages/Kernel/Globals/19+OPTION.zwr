^DIC(19,16618,0)="EHM-01439^Automate           List Rule to Update List^^R^1^^^^^^^170^^^^"
^DIC(19,16618,1,0)="^^7^7^3240328^"
^DIC(19,16618,1,1,0)="This option allows a reminder list rule to be mapped to a team list, and "
^DIC(19,16618,1,2,0)="configure how often the list rule should be ran and update the team list."
^DIC(19,16618,1,3,0)=" "
^DIC(19,16618,1,4,0)="The tasked option, Update Team List From Reminder List Rule [ORLP TEAM"
^DIC(19,16618,1,5,0)="LIST FROM REM], will use these mappings and settings, to determine which"
^DIC(19,16618,1,6,0)="list rules should be ran and which team lists to update."
^DIC(19,16618,1,7,0)="Cloned from ""ORLP SETUP TEAM LIST FROM REM"" option."
^DIC(19,16618,3)=""
^DIC(19,16618,25)="EN^ORLPREML"
