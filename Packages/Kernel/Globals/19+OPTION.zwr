^DIC(19,12389,"U")="REPORT - ALL ADDRESS CHANGES"
^DIC(19,12390,0)="IVM ADDR UPDT PENDING REVIEW^IVM Address Updates Pending Review^^R^10000000020^^^^^^^312^y"
^DIC(19,12390,1,0)="^19.06^8^8^3030908^^^^"
^DIC(19,12390,1,1,0)="It is recommended that this menu option should be tasked to run daily."
^DIC(19,12390,1,2,0)=""
^DIC(19,12390,1,3,0)="This report will display information related to patient address"
^DIC(19,12390,1,4,0)="data received from HEC for patient with active pharmacy prescriptions."
^DIC(19,12390,1,5,0)=""
^DIC(19,12390,1,6,0)="The report also lists the date on which the address information will be "
^DIC(19,12390,1,7,0)="automatically uploaded if it has not yet been reviewed manually."
^DIC(19,12390,1,8,0)=""
^DIC(19,12390,25)="EN2^IVMLDEM9"
^DIC(19,12390,200.9)="y"
^DIC(19,12390,"U")="IVM ADDRESS UPDATES PENDING RE"
^DIC(19,12391,0)="DG PTF TRANS MT EQUAL U RPT^PTF Records Transmitted with MT Indicator of U^^A^10000000020^^^^^^^114^^1"
^DIC(19,12391,1,0)="^^6^6^3030724^"
^DIC(19,12391,1,1,0)="This report prints a list of patients who have transmitted PTF records and"
^DIC(19,12391,1,2,0)="require a Means Test.  The patient will be included on the report only if"
^DIC(19,12391,1,3,0)="ALL the patient's transmitted PTF records within the date range selected"
^DIC(19,12391,1,4,0)="have a Means Test Indicator equal to Required.  This will focus the list"
^DIC(19,12391,1,5,0)="on patients who have no valid MT status in the National Patient Care"
^DIC(19,12391,1,6,0)="Database (NPCD) for the date range chosen.  This report requires 132 col. "
^DIC(19,12391,20)="D EN^DGPTFRU1"
^DIC(19,12391,"U")="PTF RECORDS TRANSMITTED WITH M"
^DIC(19,12393,0)="DGPF RECORD FLAG ASSIGNMENT^Record Flag Assignment^^R^1^DGPF ASSIGNMENT^^^^^^114^^"
^DIC(19,12393,1,0)="^19.06^10^10^3050616^^"
^DIC(19,12393,1,1,0)="This option provides a List Manager user interface for assigning Patient "
^DIC(19,12393,1,2,0)="Record Flags to patients.  Additionally, this option provides the "
^DIC(19,12393,1,3,0)="ability to review and manage Patient Record Flag assignments.  The "
^DIC(19,12393,1,4,0)="following actions are provided within the patient Record Flag Assignment"
^DIC(19,12393,1,5,0)="option."
^DIC(19,12393,1,6,0)=" - Assign a Patient Record Flag to a patient."
^DIC(19,12393,1,7,0)=" - Display the details of a patient's record flag assignments including"
^DIC(19,12393,1,8,0)="   the history of the assignment."
^DIC(19,12393,1,9,0)=" - Review/Edit a patient's record flag assignment."
^DIC(19,12393,1,10,0)=" - Change the site ownership of a patient's record flag assignment."
^DIC(19,12393,20)=""
^DIC(19,12393,25)="EN^DGPFLMA"
^DIC(19,12393,"U")="RECORD FLAG ASSIGNMENT"
