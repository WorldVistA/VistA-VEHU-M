^DIC(19,"%D",0)="^^10^10^2960430^^^^"
^DIC(19,"%D",1,0)="Information in this file is used to drive the menu system.  Options are"
^DIC(19,"%D",2,0)="created, associated with others on menus, locked, set out-of-order,"
^DIC(19,"%D",3,0)="assigned prohibited times or devices, or given entry/exit actions.  The"
^DIC(19,"%D",4,0)="Edit Options of Menu Management should be used (instead of VA FileMan)"
^DIC(19,"%D",5,0)="so that the global root (DIC) and other such fields are given the correct"
^DIC(19,"%D",6,0)="values.  Options may be tailored by setting FileMan variables via this file. "
^DIC(19,"%D",7,0)="The Order Enter/Results Reporting package is accessed by using the appropriate"
^DIC(19,"%D",8,0)="option type.  It is cross-referenced by name, menu text, uppercase menu text,"
^DIC(19,"%D",9,0)="type, item, synonym, help frame, out-of-order message, lock, prohibited times,"
^DIC(19,"%D",10,0)="restricted devices, and priority. "
^DIC(19,"%MSC")=3190312.141355
