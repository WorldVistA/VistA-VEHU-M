^DIC(19,8241,0)="XMMGR-DISK-MANY-MESSAGE-MAINT^Ask users with many messages to do maintenance^^R^11748^^^^^^^54"
^DIC(19,8241,1,0)="^^2^2^2971003^^^"
^DIC(19,8241,1,1,0)="This option sends messages asking users to clean out mail boxes if"
^DIC(19,8241,1,2,0)="they have too many messages."
^DIC(19,8241,25)="ENTER^XMAI2"
^DIC(19,8241,200.9)="y"
^DIC(19,8241,"U")="ASK USERS WITH MANY MESSAGES T"
^DIC(19,8242,0)="XMNET-TWIX-TRANSMIT^Transmit TWIX's^^R^11748^^^^^^^54"
^DIC(19,8242,1,0)="^^2^2^2931205^"
^DIC(19,8242,1,1,0)="This option can be run interactively or scheduled as a task to run in"
^DIC(19,8242,1,2,0)="background to transmit TWIXs (PCTS messages)."
^DIC(19,8242,25)="RQ^XMRPCTS0"
^DIC(19,8242,"U")="TRANSMIT TWIX'S"
^DIC(19,8243,0)="XMNET-TWIX-SEND^Send a TWIX via PCTS^^R^11748^^^^^^^54"
^DIC(19,8243,1,0)="^^2^2^2931205^"
^DIC(19,8243,1,1,0)="This option is to be used to send messages formatted especially as"
^DIC(19,8243,1,2,0)="TWIXs to be sent via the PCTS system."
^DIC(19,8243,25)="PCTS^XMRPCTS"
^DIC(19,8243,"U")="SEND A TWIX VIA PCTS"
^DIC(19,8244,0)="XMEDIT-REMOTE-USER^Enter/Edit Remote User^^R^11748^^^^^^^54"
^DIC(19,8244,1,0)="^19.06^2^2^3020509^^"
^DIC(19,8244,1,1,0)="This option allows a person's remote address to be put into the"
^DIC(19,8244,1,2,0)="Remote User Directory so messages can be automatically addressed to him."
^DIC(19,8244,25)="REMOTES^XMDIR1B"
^DIC(19,8244,"U")="ENTER/EDIT REMOTE USER"
^DIC(19,8245,0)="XM-FTP-GET^Get (Retrieve) File from Remote System^^R^11748^^^^^^^54"
^DIC(19,8245,1,0)="^19.06^5^5^3020509^^^"
^DIC(19,8245,1,1,0)="This option allows a user to GET a file from another system using"
^DIC(19,8245,1,2,0)="the FTP protocol.  The user supplies all the information about where"
^DIC(19,8245,1,3,0)="the file is and MailMan creates a file that when executed will do the"
^DIC(19,8245,1,4,0)="retrieval.  The actual process of getting the file is handled in"
^DIC(19,8245,1,5,0)="the background.  See XM-FTP-PUT."
^DIC(19,8245,25)="GET^XMAFTP"
^DIC(19,8245,"U")="GET (RETRIEVE) FILE FROM REMOT"
^DIC(19,8246,0)="XM-FTP-PUT^Send (Put) File to Remote Location^^R^11748^^^^^^^54"
^DIC(19,8246,1,0)="^19.06^5^5^3020509^^^^"
^DIC(19,8246,1,1,0)="This option allows a user to PUT a file on another system using"
^DIC(19,8246,1,2,0)="the FTP protocol.  The user supplies all the information about where"
^DIC(19,8246,1,3,0)="the file should go and MailMan creates a file that when executed will"
^DIC(19,8246,1,4,0)="do the sending.  The actual process of putting the file is handled in"
^DIC(19,8246,1,5,0)="the background.  See XM-FTP-GET."
^DIC(19,8246,25)="PUT^XMAFTP"
^DIC(19,8246,"U")="SEND (PUT) FILE TO REMOTE LOCA"
^DIC(19,8247,0)="XMOTHER-COMMUNICATIONS^Communications^^M^11748^XMNET^^^^^^54"
^DIC(19,8247,1,0)="^^3^3^2940222^^"
^DIC(19,8247,1,1,0)="This menu contains options that allow users to send and receive data that"
^DIC(19,8247,1,2,0)="is not necessarily in an electronic mail message form.  FTP options to get"
^DIC(19,8247,1,3,0)="and put files are here."
^DIC(19,8247,10,0)="^19.01PI^2^2"
^DIC(19,8247,10,1,0)="8245^GET"
^DIC(19,8247,10,2,0)="8246^PUT"
^DIC(19,8247,10,"B",8245,1)=""
^DIC(19,8247,10,"B",8246,2)=""
^DIC(19,8247,10,"C","GET",1)=""
^DIC(19,8247,10,"C","PUT",2)=""
^DIC(19,8247,99)="59254,80398"
^DIC(19,8247,"U")="COMMUNICATIONS"
^DIC(19,8248,0)="XMR-BROADCAST-VA-WIDE^Server / not for a menu^^S^11748^^^^^^^54"
^DIC(19,8248,1,0)="^^12^12^2971003^^^^"
^DIC(19,8248,1,1,0)="This option is set up as a server.  When a message is addressed to"
^DIC(19,8248,1,2,0)="this server (S.XMR-BROADCAST-VA-WIDE), It runs routine ENT^XMGAPI3"
^DIC(19,8248,1,3,0)="to send the message to SHARED,MAIL."
^DIC(19,8248,1,4,0)=""
^DIC(19,8248,1,5,0)="The message is marked 'closed' (may not forward) and"
^DIC(19,8248,1,6,0)="'information only' (may not reply)."
^DIC(19,8248,1,7,0)=""
^DIC(19,8248,1,8,0)="The message is marked with a vaporization date of 30 days from"
^DIC(19,8248,1,9,0)="date of receipt."
^DIC(19,8248,1,10,0)=""
^DIC(19,8248,1,11,0)="Note that server XMYB-BROADCAST-VA-WIDE is similar to this one, except"
^DIC(19,8248,1,12,0)="that it sends the message to all users."
^DIC(19,8248,25)="ENT^XMGAPI3(.6)"
^DIC(19,8248,220)="109^R^^N^Y^N"
^DIC(19,8248,"U")="SERVER / NOT FOR A MENU"
^DIC(19,8249,0)="XMSUGGESTION^Suggestion Box^^R^11748^^^^^^^54"
^DIC(19,8249,1,0)="^^11^11^2970730^^"
^DIC(19,8249,1,1,0)="Enables a user to send an anonymous message to the SUGGESTION BOX basket"
^DIC(19,8249,1,2,0)="of SHARED,MAIL.  If the basket does not exist, it will be created."
^DIC(19,8249,1,3,0)=""
^DIC(19,8249,1,4,0)="MailMan carefully fails to record the actual identity of the sender."
^DIC(19,8249,1,5,0)=""
^DIC(19,8249,1,6,0)="The option allows users to voice complaints and concerns anonymously.  "
^DIC(19,8249,1,7,0)=" "
^DIC(19,8249,1,8,0)="To use it, put the XMSUGGESTION option onto the appropriate menu."
^DIC(19,8249,1,9,0)=""
^DIC(19,8249,1,10,0)="To stop a particular user from using it, put a 'Reverse/negative Lock'"
^DIC(19,8249,1,11,0)="onto the XMSUGGESTION option and assign that key to the user."
^DIC(19,8249,25)="SEND^XMJMSA"
^DIC(19,8249,"U")="SUGGESTION BOX"
^DIC(19,8250,0)="IB OUTPUT IVM BILLING ACTIVITY^IVM Billing Activity Report^^R^.5^^^^^^^192"
^DIC(19,8250,1,0)="^^5^5^2940505^"
^DIC(19,8250,1,1,0)="This option is used to generate a list of bills which have been"
^DIC(19,8250,1,2,0)="generated against insurance policies which were identified by the"
^DIC(19,8250,1,3,0)="IVM Center.  The user has the option of electronically transmitting"
^DIC(19,8250,1,4,0)="the report to the IVM Center when the option is executed in the"
^DIC(19,8250,1,5,0)="Production account."
^DIC(19,8250,25)="IBCOIVM"
^DIC(19,8250,"U")="IVM BILLING ACTIVITY REPORT"
