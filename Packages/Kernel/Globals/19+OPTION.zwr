^DIC(19,16380,"U")="BUILD HEALTH SUMMARY TYPE MENU"
^DIC(19,16381,0)="EHM-01202^Print Health Summary Menu^^M^1^^^^^^^160^^^^"
^DIC(19,16381,1,0)="^^6^6^3240328^"
^DIC(19,16381,1,1,0)="This menu includes all of the various print options available for Health"
^DIC(19,16381,1,2,0)="Summaries, allowing the user to generate Health Summaries by Patient, by"
^DIC(19,16381,1,3,0)="Patient and a date range, by patient and a outpatient visit or an"
^DIC(19,16381,1,4,0)="admission, by Location, for patients at all clinics, and on an Ad Hoc"
^DIC(19,16381,1,5,0)="basis."
^DIC(19,16381,1,6,0)="Cloned from ""GMTS HS MENU"" option."
^DIC(19,16381,3)=""
^DIC(19,16381,10,0)="^19.01IP^6^6"
^DIC(19,16381,10,1,0)="16382^1^1"
^DIC(19,16381,10,2,0)="16383^5^5"
^DIC(19,16381,10,3,0)="16384^2^2"
^DIC(19,16381,10,4,0)="16385^4^4"
^DIC(19,16381,10,5,0)="16386^6^6"
^DIC(19,16381,10,6,0)="16387^3^3"
