^DIC(19,11962,"U")="DENTAL DSS DRM GUI"
^DIC(19,11964,0)="PRCP LET STAFF REPLACE QOH^Let Staff Replace Inventory Quantities^^R^10000000020^PRCPAQOH^^^^^^"
^DIC(19,11964,1,0)="^^4^4^3010601^"
^DIC(19,11964,1,1,0)="This option will be accessible only to the application coordinator. It"
^DIC(19,11964,1,2,0)="allows the coordinator to authorize OA&MM staff to create requests that"
^DIC(19,11964,1,3,0)="force their GIP inventory to be automatically adjusted to what exists in"
^DIC(19,11964,1,4,0)="the linked supply station at the time the request is made."
^DIC(19,11964,25)="AC^PRCPSSQA"
^DIC(19,11964,"U")="LET STAFF REPLACE INVENTORY QU"
^DIC(19,11965,0)="PRCP REPLACE ON-HAND INVENTORY^Adjust Quantity to Supply Station Values^^R^10000000020^PRCPSSQOH^^^^^^"
^DIC(19,11965,1,0)="^^3^3^3010425^"
^DIC(19,11965,1,1,0)="This option enables an authorized user to request that the quantities of"
^DIC(19,11965,1,2,0)="items in the inventory point are adjusted to the quantities reported by"
^DIC(19,11965,1,3,0)="the linked supply station at the time the request is made."
^DIC(19,11965,25)="PRCPSSQT"
^DIC(19,11965,"U")="ADJUST QUANTITY TO SUPPLY STAT"
^DIC(19,11967,0)="XUSER DIV CHG^Change my Division^^R^10000000020^^^^^^^^y"
^DIC(19,11967,1,0)="^^7^7^3010816^"
^DIC(19,11967,1,1,0)="The Kernel option ""Change my Division"" allows you to change the"
^DIC(19,11967,1,2,0)="division to which you are currently assigned. This option performs"
^DIC(19,11967,1,3,0)="the same function as entering your current division at the signon"
^DIC(19,11967,1,4,0)="prompt ""Select DIVISION: default division //""."
^DIC(19,11967,1,5,0)=" "
^DIC(19,11967,1,6,0)="If you only have one division to select from, XUSER DIV CHG will show you"
^DIC(19,11967,1,7,0)="your current division and indicate that you cannot change it."
^DIC(19,11967,25)="DIVCHG^XUSER1"
^DIC(19,11967,"U")="CHANGE MY DIVISION"
^DIC(19,11968,0)="RGMT DIAG MGR^MPI/PD HL7 Diagnostic Menu^^M^10000000020^^^^^^^525"
^DIC(19,11968,1,0)="^19.06^2^2^3011004^^^^"
^DIC(19,11968,1,1,0)="This menu contains a diagnostic tool and reports to assist with problem"
^DIC(19,11968,1,2,0)="resolution for MPI/PD HL7 messaging."
^DIC(19,11968,10,0)="^19.01IP^4^4"
^DIC(19,11968,10,1,0)="11969^CMP^10"
^DIC(19,11968,10,2,0)="11970^RPT^20"
^DIC(19,11968,10,3,0)="11971^SNG^30"
^DIC(19,11968,10,4,0)="11972^ALL^40"
^DIC(19,11968,10,"B",11969,1)=""
^DIC(19,11968,10,"B",11970,2)=""
^DIC(19,11968,10,"B",11971,3)=""
^DIC(19,11968,10,"B",11972,4)=""
^DIC(19,11968,10,"C","ALL",4)=""
^DIC(19,11968,10,"C","CMP",1)=""
^DIC(19,11968,10,"C","RPT",2)=""
^DIC(19,11968,10,"C","SNG",3)=""
^DIC(19,11968,99)="61957,33175"
^DIC(19,11968,"U")="MPI/PD HL7 DIAGNOSTIC MENU"
^DIC(19,11969,0)="RGMT DIAG COMPILE HL7 DATA^Compile MPI/PD HL7 Data^^R^10000000020^^^^^^^525"
^DIC(19,11969,1,0)="^19.06^8^8^3011004^^^"
^DIC(19,11969,1,1,0)="This option searches the HL7 MESSAGE ADMINISTRATION (#773) file"
^DIC(19,11969,1,2,0)="for a selected date range.  For each message in the date range,"
^DIC(19,11969,1,3,0)="the HL7 MESSAGE TEXT (#772) file is examined.  If the RELATED EVENT"
^DIC(19,11969,1,4,0)="PROTOCOL (#10) field contains the MPI/PD protocols (e.g., ""VAF"" ""RG"""
^DIC(19,11969,1,5,0)="or ""MPIF""), information is compiled into the ^XTMP(""RGMT"",""HL"" array."
^DIC(19,11969,1,6,0)="The data elements include the protocol name, date, transmission type"
^DIC(19,11969,1,7,0)="(i.e., incoming or outgoing), status, and internal entry number (IEN)"
^DIC(19,11969,1,8,0)="of the HL7 MESSAGE TEXT entry."
^DIC(19,11969,25)="RGMTHL2"
^DIC(19,11969,"U")="COMPILE MPI/PD HL7 DATA"
^DIC(19,11970,0)="RGMT DIAG STATUS REPORT^MPI/PD HL7 Message Status Report^^R^10000000020^^^^^^^525"
^DIC(19,11970,1,0)="^19.06^17^17^3011004^^^^"
^DIC(19,11970,1,1,0)="This option prints information found during the Compile MPI/PD HL7"
^DIC(19,11970,1,2,0)="Data compilation.  The MPI/PD HL7 Message Status Report is generated"
^DIC(19,11970,1,3,0)="from the ^XTMP(""RGMT"",""HL"" array.  The report is sorted by RELATED "
^DIC(19,11970,1,4,0)="EVENT PROTOCOL, date, transmission type, and status."
^DIC(19,11970,1,5,0)="   "
^DIC(19,11970,1,6,0)="Either a detailed or summary report can be printed for a selected"
^DIC(19,11970,1,7,0)="date range.  The summary report displays the total number of messages"
^DIC(19,11970,1,8,0)="for each date, transmission type, and status. The right margin for this"
^DIC(19,11970,1,9,0)="report is 80."
^DIC(19,11970,1,10,0)="   "
^DIC(19,11970,1,11,0)="The detailed report can be printed for a single or all protocols "
^DIC(19,11970,1,12,0)="and includes information from each HL7 message.  The detailed report"
^DIC(19,11970,1,13,0)="displays the related event protocol date, transmission type, status,"
^DIC(19,11970,1,14,0)="message header date, date processed, internal entry number (IEN) from"
^DIC(19,11970,1,15,0)="the HL7 MESSAGE TEXT (#772) file, message identification number, and"
^DIC(19,11970,1,16,0)="whether or not the message has been purged.  The right margin for this"
^DIC(19,11970,1,17,0)="report is 132."
^DIC(19,11970,25)="RGMTHLP"
^DIC(19,11970,"U")="MPI/PD HL7 MESSAGE STATUS REPO"
^DIC(19,11971,0)="RGMT DIAG SINGLE PROTOCOL^MPI/PD HL7 Activity by Patient/Single Protocol^^R^10000000020^^^^^^^525"
^DIC(19,11971,1,0)="^19.06^10^10^3011004^^^^"
^DIC(19,11971,1,1,0)="This option prints information found during the Compile MPI/PD"
^DIC(19,11971,1,2,0)="HL7 Data compilation for activity related to a specific protocol."
^DIC(19,11971,1,3,0)="The ^XTMP(""RGMT"",""HL"" array is searched for a user selected"
^DIC(19,11971,1,4,0)="protocol, date range, transmission type and patient."
^DIC(19,11971,1,5,0)="   "
^DIC(19,11971,1,6,0)="The report prints the patient's name, protocol, date range,"
^DIC(19,11971,1,7,0)="transmission type, internal entry number (IEN) from the HL7 "
^DIC(19,11971,1,8,0)="MESSAGE TEXT (#772) file, the date and status.  The HL7 message"
^DIC(19,11971,1,9,0)="data found in the MESSAGE TEXT field is displayed.  The right"
^DIC(19,11971,1,10,0)="margin for this report is 80."
^DIC(19,11971,25)="RGMTHLDB"
^DIC(19,11971,"U")="MPI/PD HL7 ACTIVITY BY PATIENT"
^DIC(19,11972,0)="RGMT DIAG ALL PROTOCOLS^MPI/PD HL7 Activity by Patient/All Protocols^^R^10000000020^^^^^^^525"
^DIC(19,11972,1,0)="^19.06^10^10^3011004^^^^"
^DIC(19,11972,1,1,0)="This option prints information found during the Compile MPI/PD"
^DIC(19,11972,1,2,0)="HL7 Data compilation for activity related to ALL protocols.  The"
^DIC(19,11972,1,3,0)="^XTMP(""RGMT"",""HL"" array is searched for a user selected patient "
^DIC(19,11972,1,4,0)="and date range."
^DIC(19,11972,1,5,0)="   "
^DIC(19,11972,1,6,0)="The report prints the patient's name, date range, protocol,"
^DIC(19,11972,1,7,0)="transmission type, internal entry number (IEN) from the HL7 MESSAGE"
^DIC(19,11972,1,8,0)="TEXT (#772) file, the date and status.  The HL7 message data found"
^DIC(19,11972,1,9,0)="in the MESSAGE TEXT field is displayed.  The right margin for this"
^DIC(19,11972,1,10,0)="report is 80."
^DIC(19,11972,25)="RGMTHLDP"
^DIC(19,11972,"U")="MPI/PD HL7 ACTIVITY BY PATIENT"
^DIC(19,11973,0)="RG UPDATE POINT OF CONTACT^Add/Edit Point of Contact^Obsolete with RG*1.0*61.^R^1^^^^^^^525"
^DIC(19,11973,1,0)="^19.06^7^7^3011106^^^^"
^DIC(19,11973,1,1,0)="This option allows a facility to update their point of contact"
^DIC(19,11973,1,2,0)="information for Master Patient Index/Patient Demographics (MPI/PD)."
^DIC(19,11973,1,3,0)="Names and phone numbers can be edited for the administrative, IRM,"
^DIC(19,11973,1,4,0)="HL7, and alternate contacts.  At the conclusion of the edit process,"
^DIC(19,11973,1,5,0)="the information is transmitted to a remote mail group on the Austin"
^DIC(19,11973,1,6,0)="MPI system.  The Data Management staff will use this information to"
^DIC(19,11973,1,7,0)="update the website."
^DIC(19,11973,25)="RGPOC"
^DIC(19,11973,"U")="ADD/EDIT POINT OF CONTACT"
^DIC(19,11974,0)="RMPR VERIFY/REPAIR PC NUMBER^VERIFY/REPAIR PURCHASE CARD NUMBER^^R^10000000020^^^^^^^"
^DIC(19,11974,1,0)="^^10^10^3011107^"
^DIC(19,11974,1,1,0)="This option was created temporarily to be used by sites that has problem"
^DIC(19,11974,1,2,0)="of reconciling Purchase Card order.  When Citi Bank replaces the old"
^DIC(19,11974,1,3,0)="Credit Card number,  Oracle data that comes back has a new Credit Card"
^DIC(19,11974,1,4,0)="number, thus prosthetics reconciliation doesn't work.  In order for"
^DIC(19,11974,1,5,0)="prostehtics user to reconcile, oracle data must be changed back to the old"
^DIC(19,11974,1,6,0)="Credit Card  number. This option also prints a report that shows all the"
^DIC(19,11974,1,7,0)="Purchase Order by 16 digit credit card number entered based on the date "
^DIC(19,11974,1,8,0)="range.  This option will be removed,  once IFCAP released a patch to allow"
^DIC(19,11974,1,9,0)="reconciliation of purchase card  order with a different credit card"
^DIC(19,11974,1,10,0)="number."
^DIC(19,11974,25)="EN^RMPR4C2"
^DIC(19,11974,"U")="VERIFY/REPAIR PURCHASE CARD NU"
^DIC(19,11975,0)="LR LOINC MAP ANTIMICROBIAL^Map/Unmap Antimicrobial Default LOINC Code^^R^10000000020^^^^^^^26"
^DIC(19,11975,1,0)="^^9^9^3011011^"
^DIC(19,11975,1,1,0)="This option allows you to map a default LOINC code for antimicrobials."
^DIC(19,11975,1,2,0)=" "
^DIC(19,11975,1,3,0)="It is recommended that the LOINC code be mapped a suffixed WKLD CODE that"
^DIC(19,11975,1,4,0)="is different than the WKLD CODE used for chemical detection of body fluid"
^DIC(19,11975,1,5,0)="concentration."
^DIC(19,11975,1,6,0)=" "
^DIC(19,11975,1,7,0)="Failure to create or select a unique WKLD CODE specific for the"
^DIC(19,11975,1,8,0)="antimicrobial drug could result in the incorrect LOINC code being"
^DIC(19,11975,1,9,0)="assigned."
^DIC(19,11975,25)="6206^LRLNC0"
^DIC(19,11975,30)=""
^DIC(19,11975,31)=""
^DIC(19,11975,50)=""
^DIC(19,11975,51)=""
^DIC(19,11975,"U")="MAP/UNMAP ANTIMICROBIAL DEFAUL"
^DIC(19,11976,0)="LRCAPCEX^PCE Retransmit^^R^10000000020^^^^^^^26"
^DIC(19,11976,1,0)="^^22^22^3010921^"
^DIC(19,11976,1,1,0)="This option will reset entries in the LAB ORDER ENTRY (#69) file. This"
^DIC(19,11976,1,2,0)="option is useful if WKLD CODE did not have CPT code assigned when PCE"
^DIC(19,11976,1,3,0)="workload reporting software initially ran."
^DIC(19,11976,1,4,0)=" "
^DIC(19,11976,1,5,0)="This option will only attempt to resend PCE workload if NO PCE CPT"
^DIC(19,11976,1,6,0)="workload was reported FOR THE ENTIRE ORDER NUMBER during the initial scan"
^DIC(19,11976,1,7,0)="of collected orders. All original requirements for PCE workload reporting"
^DIC(19,11976,1,8,0)="are enforced."
^DIC(19,11976,1,9,0)=" "
^DIC(19,11976,1,10,0)="This option maybe useful if linked CPT codes were inactivated during the"
^DIC(19,11976,1,11,0)="yearly upgrade of the CPT (#81) file. The LIM can edit the WKLD CODE (#64)"
^DIC(19,11976,1,12,0)="file with current valid CPT codes and run this option."
^DIC(19,11976,1,13,0)=" "
^DIC(19,11976,1,14,0)="This option can not be run while the normal PCE workload reporting"
^DIC(19,11976,1,15,0)="background software is running."
^DIC(19,11976,1,16,0)=" "
^DIC(19,11976,1,17,0)="The option will scan the dates range entered, printing a ""."" for every"
^DIC(19,11976,1,18,0)="20th. order processed. Then the option will determine if the order should"
^DIC(19,11976,1,19,0)="be reported to PCE. As the data is processed, every 20th. order number is"
^DIC(19,11976,1,20,0)="printed."
^DIC(19,11976,1,21,0)=" "
^DIC(19,11976,1,22,0)="This option can not be queued."
^DIC(19,11976,10.1)="Lab PCE Retransmit"
^DIC(19,11976,25)="EN^LRCAPPHX"
^DIC(19,11976,"U")="PCE RETRANSMIT"
