^DIC(19,10640,0)="PRCA RCDMC LESSER WITHHOLDING^Enter Lesser DMC Withholding Amount^^R^11594^^^^^^^"
^DIC(19,10640,1,0)="^^4^4^2970813^"
^DIC(19,10640,1,1,0)="Normally, when a patient is referred to DMC, the total amount owed is"
^DIC(19,10640,1,2,0)="withheld.  This option will allow the local sites to enter a lesser"
^DIC(19,10640,1,3,0)="amount.  That amount then will be deducted from the debtor monthly until"
^DIC(19,10640,1,4,0)="the full amount owed is collected."
^DIC(19,10640,25)="LESSW^RCDMC90U"
