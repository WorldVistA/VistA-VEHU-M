^DIC(19,14728,0)="VPR HS ENABLE^Enable Data Monitoring^^R^1^VPR HS ENABLE^^^^^^572"
^DIC(19,14728,1,0)="^^4^4^3210211^"
^DIC(19,14728,1,1,0)="This option enables or disables the tracking of patient data changes in"
^DIC(19,14728,1,2,0)="the ^VPR(""AVPR"") index, for retrieval by the Regional Health Connect server."
^DIC(19,14728,1,3,0)="** DO NOT DISABLE DATA MONITORING in a production system unless directed"
