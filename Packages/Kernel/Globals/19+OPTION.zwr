^DIC(19,1648,1,1,0)="This function allows the user to obtain a list of the sharing"
^DIC(19,1648,1,2,0)="agreements/contracts as specified by the 'Sharing Agreement/Contract"
^DIC(19,1648,1,3,0)="Entry/Edit' function."
^DIC(19,1648,25)="8^RAMAINP"
^DIC(19,1648,"U")="SHARING AGREEMENT/CONTRACT LIS"
^DIC(19,1649,0)="RA EXAMSTATUSP^Examination Status List^^R^11712^^^^^^^"
^DIC(19,1649,1,0)="^^2^2^2960807^^^^"
^DIC(19,1649,1,1,0)="This function allows the user to obtain a list of the examination"
^DIC(19,1649,1,2,0)="statuses as specified by the 'Examination Status Enter/Edit' function."
^DIC(19,1649,25)="EN1^RAXSTAT"
^DIC(19,1649,"U")="EXAMINATION STATUS LIST"
^DIC(19,1650,0)="RA PROCLONG^Active Procedure List (Long)^^R^11712^^^^^^^"
^DIC(19,1650,1,0)="^^7^7^2940606^"
^DIC(19,1650,1,1,0)="This option allows the supervisor to generate a list of"
^DIC(19,1650,1,2,0)="'active' procedures. The list includes the following"
^DIC(19,1650,1,3,0)="information: CPT code, procedure, AMIS code, AMIS category, multiplier,"
^DIC(19,1650,1,4,0)="whether the procedure is 'bilateral' and if the procedure is CT Head/Body."
^DIC(19,1650,1,5,0)="The list also includes the following information: Type of procedure,"
^DIC(19,1650,1,6,0)="required flash card printer, required flash card format, staff review of"
^DIC(19,1650,1,7,0)="reports required, interpreting physician approval of request required."
^DIC(19,1650,25)="2^RAMAINP"
^DIC(19,1650,"U")="ACTIVE PROCEDURE LIST (LONG)"
^DIC(19,1651,0)="RA PROCSHORT^Active Procedure List (Short)^^R^11712^^^^^^^"
^DIC(19,1651,1,0)="^^4^4^2940606^"
^DIC(19,1651,1,1,0)="This option allows the supervisor to generate a list of 'active'"
^DIC(19,1651,1,2,0)="procedures. The list includes the following information: CPT code, procedure,"
^DIC(19,1651,1,3,0)="AMIS code, multiplier, whether the procedure is 'bilateral', and if the"
^DIC(19,1651,1,4,0)="procedure is CT Head/Body."
^DIC(19,1651,25)="9^RAMAINP"
^DIC(19,1651,"U")="ACTIVE PROCEDURE LIST (SHORT)"
^DIC(19,1652,0)="RA INACPRCLONG^Inactive Procedure List (Long)^^R^11712^^^^^^^"
^DIC(19,1652,1,0)="^^7^7^2940606^"
^DIC(19,1652,1,1,0)="This option allows the supervisor to generate a list of"
^DIC(19,1652,1,2,0)="'inactive' procedures. The list includes the following"
^DIC(19,1652,1,3,0)="information: CPT code, procedure, AMIS code, AMIS category, multiplier,"
^DIC(19,1652,1,4,0)="whether the procedure is 'bilateral' and if the procedure is CT Head/Body."
^DIC(19,1652,1,5,0)="The list also includes the following: Type of procedure, required flash"
^DIC(19,1652,1,6,0)="card printer, required flash card format, staff review of reports required,"
^DIC(19,1652,1,7,0)="interpreting physician approval of request required."
^DIC(19,1652,25)="10^RAMAINP"
^DIC(19,1652,"U")="INACTIVE PROCEDURE LIST (LONG)"
^DIC(19,1653,0)="RA INACPRCSHORT^List of Inactive Procedures (Short)^^R^11712^^^^^^^"
^DIC(19,1653,1,0)="^^4^4^2940606^"
^DIC(19,1653,1,1,0)="This option allows the supervisor to generate a list of 'inactive'"
^DIC(19,1653,1,2,0)="procedures. The list includes the following information: CPT"
^DIC(19,1653,1,3,0)="code, procedure, AMIS code, AMIS category, multiplier, whether the procedure"
^DIC(19,1653,1,4,0)="is 'bilateral', and if the procedure is CT Head/Body."
^DIC(19,1653,25)="11^RAMAINP"
^DIC(19,1653,"U")="LIST OF INACTIVE PROCEDURES (S"
