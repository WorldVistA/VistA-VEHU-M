^DIC(19,13078,"U")="CLINICAL APPLICATIONS MENU"
^DIC(19,13079,0)="GMRC RPT PERF MONITOR^Consult Performance Monitor Report^^R^1^^^^^^^294"
^DIC(19,13079,1,0)="^^52^52^3080404^"
^DIC(19,13079,1,1,0)="This report provides data to be submitted for the National Performance "
^DIC(19,13079,1,2,0)="Monitor."
^DIC(19,13079,1,3,0)=" "
^DIC(19,13079,1,4,0)="Report Column Headers "
^DIC(19,13079,1,5,0)="""Within Facility"" - requests that originate and are completed locally."
^DIC(19,13079,1,6,0)="""IFC Sent"" - requests sent to another facility via IFC software."
^DIC(19,13079,1,7,0)="""IFC Rec'd"" - requests originating from another facility via IFC software."
^DIC(19,13079,1,8,0)=" "
^DIC(19,13079,1,9,0)="Report Row Headers"
^DIC(19,13079,1,10,0)="""All Requests in 30 Days Before the Start/End of Qtr"" - Total of all "
^DIC(19,13079,1,11,0)=" requests in the REQUEST/CONSULTATION file with a CPRS STATUS of Complete,"
^DIC(19,13079,1,12,0)=" Pending, Active, Scheduled and Partial Results and the DATE OF REQUEST "
^DIC(19,13079,1,13,0)=" occurs in a date range of 30 days before the start of the fiscal quarter "
^DIC(19,13079,1,14,0)=" and 30 days before the end of the fiscal quarter."
^DIC(19,13079,1,15,0)="""All Requests in 60 Days Before the Start/End of Qtr"" - Same as above only"
^DIC(19,13079,1,16,0)=" the date range is expanded to 60 days."
^DIC(19,13079,1,17,0)="""Complete w/Results in 30 Days of Request"" - Of the requests occurring in "
^DIC(19,13079,1,18,0)=" the 30 day before the start/end of the quarter range, the total of those"
^DIC(19,13079,1,19,0)=" that are Complete and have results attached."
^DIC(19,13079,1,20,0)="""Complete w/Results 31-60 Days of Request"" - Similar to above except using"
^DIC(19,13079,1,21,0)=" the 60 day before the start/end of the quarter range."
^DIC(19,13079,1,22,0)="""All Requests Created Before Qtr Start"" - Total entries in "
^DIC(19,13079,1,23,0)=" REQUEST/CONSULATION file where the DATE OF REQUEST occurs before the date"
^DIC(19,13079,1,24,0)=" which is 60 days before the start of the fiscal quarter for which "
^DIC(19,13079,1,25,0)=" reporting."
^DIC(19,13079,1,26,0)="""All Requests Pending Before Qtr Start"" - Total entries in above that are "
^DIC(19,13079,1,27,0)=" still considered to be pending - the CPRS STATUS value is Hold, Flagged, "
^DIC(19,13079,1,28,0)=" Pending, Scheduled, Partial Results, Unreleased, or No Status."
^DIC(19,13079,1,29,0)="""Percent Complete w/Results in 30 Days of Request"" - Complete w/Results "
^DIC(19,13079,1,30,0)=" in 30 Days of Request / All Requests in 30 Days Before the Start/End of"
^DIC(19,13079,1,31,0)=" Qtr"
^DIC(19,13079,1,32,0)="""Percent Complete w/Results 31-60 Days of Request"" - Complete w/Results "
^DIC(19,13079,1,33,0)=" in 31-60 Days of Request / All Requests in 60 Days Before the Start/End"
^DIC(19,13079,1,34,0)=" of Qtr"
^DIC(19,13079,1,35,0)="""Percent Still Pending Created Before Qtr Start"" - All Requests Pending "
^DIC(19,13079,1,36,0)=" Before Qtr Start / All Requests Created Before Qtr Start"
^DIC(19,13079,1,37,0)=" "
^DIC(19,13079,1,38,0)="Report Exclusions:"
^DIC(19,13079,1,39,0)="-Requests sent to test patients."
^DIC(19,13079,1,40,0)="-Requests not marked as Outpatient in the REQUEST/CONSULTATION file."
^DIC(19,13079,1,41,0)="-Services flagged as part of the interface between Consults/Request "
^DIC(19,13079,1,42,0)="  Tracking and Prosthetics."
^DIC(19,13079,1,43,0)="-Administrative requests flagged via the Administrative fields in the"
^DIC(19,13079,1,44,0)="  REQUEST SERVICES and REQUEST/CONSULTATION files. This is not retroactive"
^DIC(19,13079,1,45,0)="  and only applies to services/requests leveraging the Admin-flagging"
^DIC(19,13079,1,46,0)="  capability included in the FY08 performance monitor report update,"
^DIC(19,13079,1,47,0)="  GMRC*3.0*60."
^DIC(19,13079,1,48,0)=" "
^DIC(19,13079,1,49,0)="The report utilizes the DATE OF REQUEST field from the "
^DIC(19,13079,1,50,0)=" REQUEST/CONSULTATION file to determine request totals for a given date "
^DIC(19,13079,1,51,0)=" range.  This is true even for requests that have been re-submitted using "
^DIC(19,13079,1,52,0)=" the Edit/Resubmit functionality."
^DIC(19,13079,25)="EN^GMRCSTL7"
^DIC(19,13079,"U")="CONSULT PERFORMANCE MONITOR RE"
^DIC(19,13080,0)="DG PATIENT CE REPORT^Report - Patient Catastrophic Edits^^R^10000000020^DG SUPERVISOR^^^^^^114"
^DIC(19,13080,1,0)="^19.06^6^6^3050301^^"
^DIC(19,13080,1,1,0)="This report will list patients, edited through Registration, who were "
^DIC(19,13080,1,2,0)="flagged as having a pontential catastrophic edit alert created for "
^DIC(19,13080,1,3,0)="supervisory review.  A catatrophic edit alert is created when two or more "
^DIC(19,13080,1,4,0)="edits to fields: name, ssn, date of birth, or gender are performed.  "
^DIC(19,13080,1,5,0)="Alerts are retained for 365 days, leaving the report to only listing a "
^DIC(19,13080,1,6,0)="years worth of information."
^DIC(19,13080,25)="DGRPECE2"
^DIC(19,13080,"U")="REPORT - PATIENT CATASTROPHIC "
^DIC(19,13081,0)="HBHCRP23^Patient Days of Care by Date Range Report (80)^^R^10000000020^^^^^^^328"
^DIC(19,13081,1,0)="^^8^8^3050921^"
^DIC(19,13081,1,1,0)="The option prints HBPC Patient Days of Care by Date Range Report.  Report"
^DIC(19,13081,1,2,0)="includes:  file internal entry number (IEN), Patient Name, Last Four,"
^DIC(19,13081,1,3,0)="Date, Discharge Date, & Patient Days.  Patient Days is calculated based on"
^DIC(19,13081,1,4,0)="the user selectable date range.  Summary totals of Patients and Patient"
^DIC(19,13081,1,5,0)="Days are included for both Complete Episodes of Care and Active Cases. "
^DIC(19,13081,1,6,0)="Date of Discharge is omitted from the Patient Days total (e.g.  Adm Date:"
^DIC(19,13081,1,7,0)="7/1/03, D/C Date: 7/5/03  would total 4 Patient Days, not 5).  Report "
^DIC(19,13081,1,8,0)="prints in 80 column format."
^DIC(19,13081,25)="HBHCRP23"
^DIC(19,13081,"U")="PATIENT DAYS OF CARE BY DATE R"
^DIC(19,13082,0)="HBHCRP24^Expanded Program Census Report  (80)^^R^10000000020^^^^^^^328"
^DIC(19,13082,1,0)="^^11^11^3051003^"
^DIC(19,13082,1,1,0)="This option prints the HBPC Expanded Program Census Report.  The user is "
^DIC(19,13082,1,2,0)="prompted to enter the date range for inclusion on the report.  The report"
^DIC(19,13082,1,3,0)="is sorted by patient name and includes:  Patient Name, Last 4, Admission"
^DIC(19,13082,1,4,0)="Date, Case Manager, Most Recent Visit Date, Visit Discipline, & total. "
^DIC(19,13082,1,5,0)="Report prints in 80 column format."
^DIC(19,13082,1,6,0)=" "
^DIC(19,13082,1,7,0)="Note: '* No HBPC Visits *' text will appear in the Most Recent Visit"
^DIC(19,13082,1,8,0)="Date/Time column on the report until after either the Build/Verify"
^DIC(19,13082,1,9,0)="Transmission File [HBHCFILE] or Auto-queue HBHC File Update [HBHC"
^DIC(19,13082,1,10,0)="AUTO-QUEUED FILE UPDATE] option has run & updated the HBHC Visit File"
^DIC(19,13082,1,11,0)="(#632)."
^DIC(19,13082,25)="HBHCRP24"
^DIC(19,13082,"U")="EXPANDED PROGRAM CENSUS REPORT"
^DIC(19,13083,0)="HBHCRP25^Address Included Program Census  (132)^^R^10000000020^^^^^^^328"
^DIC(19,13083,1,0)="^19.06^5^5^3030912^^"
^DIC(19,13083,1,1,0)="This option prints the HBPC Address Included Program Census Report.  The"
^DIC(19,13083,1,2,0)="user is prompted to enter a date range for inclusion on the report.  The"
^DIC(19,13083,1,3,0)="report is sorted alphabetically by patient name & includes:  Patient Name,"
^DIC(19,13083,1,4,0)="Last 4, Admission Date, Address, City, ZIP Code, Phone Number, Case Manager"
^DIC(19,13083,1,5,0)="& Total.  Report prints in 132 column format. "
^DIC(19,13083,25)="HBHCRP25"
^DIC(19,13083,"U")="ADDRESS INCLUDED PROGRAM CENSU"
^DIC(19,13084,0)="RA PROCMEDIA^List of Procedures with Contrast^^R^10000000020^^^^^^y^31"
^DIC(19,13084,1,0)="^19.06^8^8^3040803^^"
^DIC(19,13084,1,1,0)="This option allows the supervisor to generate a list of procedures, which "
^DIC(19,13084,1,2,0)="are associated with contrast media or medium. The option allows the user "
^DIC(19,13084,1,3,0)="to select procedures by imaging type and whether the procedures are active"
^DIC(19,13084,1,4,0)="or inactive."
^DIC(19,13084,1,5,0)=" "
^DIC(19,13084,1,6,0)="The format of the report includes: Procedure Name, CPT Code, CPT "
^DIC(19,13084,1,7,0)="Modifier(s), Procedure Type, Imaging Type, and Inactivation Date (if "
^DIC(19,13084,1,8,0)="applicable)."
^DIC(19,13084,25)="CMPRT^RAMAINP1"
^DIC(19,13084,"U")="LIST OF PROCEDURES WITH CONTRA"
^DIC(19,13085,0)="RA CMAUDIT HISTORY^Display Rad/NM Procedure Contrast Media History^^R^10000000020^^^^^^y^31"
^DIC(19,13085,1,0)="^19.06^2^2^3040804^^^^"
^DIC(19,13085,1,1,0)="This option allows the user to look back at the prior contrast medium/"
^DIC(19,13085,1,2,0)="media data associated with a Rad/Nuc Med Procedure."
^DIC(19,13085,25)="EN^RACMHIS"
^DIC(19,13085,"U")="DISPLAY RAD/NM PROCEDURE CONTR"
^DIC(19,13086,0)="PSJ CD^Clinic Definition^^R^1^^^^^^^197"
^DIC(19,13086,1,0)="^19.06^2^2^3130717^^"
^DIC(19,13086,1,1,0)="This option allows the site to define how Inpatient Orders for "
^DIC(19,13086,1,2,0)="Outpatients will behave and be handled on a clinic-by-clinic basis."
^DIC(19,13086,25)="ENCD^PSGFILD3"
^DIC(19,13086,"U")="CLINIC DEFINITION"
^DIC(19,13087,0)="LA7 POC SETUP^Lab Point of Care Setup^^R^1^^^^^^^53"
^DIC(19,13087,1,0)="^^35^35^3231101^"
^DIC(19,13087,1,1,0)="This option is used to configure and setup the Lab HL7 Point of Care"
^DIC(19,13087,1,2,0)="interface. It provides the means for configuring the various files"
^DIC(19,13087,1,3,0)="related to receiving and processing POC test results in the VistA"
^DIC(19,13087,1,4,0)="Laboratory package."
^DIC(19,13087,1,5,0)=" "
^DIC(19,13087,1,6,0)="The user can configure the three main files relating to this interface, "
^DIC(19,13087,1,7,0)="print a report of the interface configuration which should be used in"
^DIC(19,13087,1,8,0)="configuring the POC system, and define which reporting facility should be "
^DIC(19,13087,1,9,0)="stored for point of care results."
^DIC(19,13087,1,10,0)=" "
^DIC(19,13087,1,11,0)="1  LA7 MESSAGE PARAMETER (#62.48)"
^DIC(19,13087,1,12,0)="   - configure entries (LA7POC*) in file #62.48 relating to interface"
^DIC(19,13087,1,13,0)="     status, alerts and mail groups to notify when alerts are triggered."
^DIC(19,13087,1,14,0)=" "
^DIC(19,13087,1,15,0)="2  LOAD/WORK LIST (#68.2)"
^DIC(19,13087,1,16,0)="   - configure related loadlist entry in file #68.2 to determine"
^DIC(19,13087,1,17,0)="     orderable tests, specimen and collection samples and related"
^DIC(19,13087,1,18,0)="     accession areas involved in test ordering process."
^DIC(19,13087,1,19,0)=" "
^DIC(19,13087,1,20,0)="3  AUTO INSTRUMENT (#62.4)"
^DIC(19,13087,1,21,0)="   - configure corresponding entries (LA7POC*) in file #62.4 which"
^DIC(19,13087,1,22,0)="     determine how test results are processed."
^DIC(19,13087,1,23,0)="   "
^DIC(19,13087,1,24,0)="4  Print POC Test Code Mapping"
^DIC(19,13087,1,25,0)="   - prints a report which displays the orderable and result tests"
^DIC(19,13087,1,26,0)="     configured for an interface, what order and result codes are"
^DIC(19,13087,1,27,0)="     specified, the specimens and collection types and accession areas"
^DIC(19,13087,1,28,0)="     that are used by the interface. It also warns if supporting"
^DIC(19,13087,1,29,0)="     information is missing for these or other laboratory related files"
^DIC(19,13087,1,30,0)="     which the interface is dependent on to successfully process a"
^DIC(19,13087,1,31,0)="     POC test result."
^DIC(19,13087,1,32,0)=" "
^DIC(19,13087,1,33,0)="5  Define Reporting Lab"
^DIC(19,13087,1,34,0)="   - If Reporting Lab is not displaying the correct facility for Point of "
^DIC(19,13087,1,35,0)="     Care results, the LR POC REPORTING LAB parameter may be defined."
^DIC(19,13087,25)="EN^LA7PCFG"
^DIC(19,13087,"U")="LAB POINT OF CARE SETUP"
^DIC(19,13088,0)="FHOMRL^Recurring Meals List by Location^^R^10000000020^^^^^^^"
^DIC(19,13088,1,0)="^^2^2^3050331^"
^DIC(19,13088,1,1,0)="This option allows the user to display a list of all recurring meals"
^DIC(19,13088,1,2,0)="within the selected timeframe, which can be displayed by location or ALL."
^DIC(19,13088,25)="FHOMRL1"
^DIC(19,13088,"U")="RECURRING MEALS LIST BY LOCATI"
^DIC(19,13089,0)="TIU182 DDEFS, MED CONVERSION^Create DDEFS for Med Conversion^^A^10000000020^^^^^^n^516^^1"
^DIC(19,13089,1,0)="^19.06^13^13^3040510^^"
^DIC(19,13089,1,1,0)="This option creates new Historical Procedure Document Definitions (DDEFS)"
^DIC(19,13089,1,2,0)="for the Medicine Package Conversion. The option is exported with patch"
^DIC(19,13089,1,3,0)="TIU*1*182.  It is this option, not the patch itself, which actually"
^DIC(19,13089,1,4,0)="creates the new Document Definitions."
^DIC(19,13089,1,5,0)=" "
^DIC(19,13089,1,6,0)="This option must be run after the patch is installed.  When the option has"
^DIC(19,13089,1,7,0)="run successfully to the end and messages have indicated that all DDEFS"
^DIC(19,13089,1,8,0)="have been created successfully with no problems encountered, the option"
^DIC(19,13089,1,9,0)="may be deleted."
^DIC(19,13089,1,10,0)=" "
^DIC(19,13089,1,11,0)="This option may be rerun if desired.  However, it will not attempt to"
^DIC(19,13089,1,12,0)="recreate entries that were already created successfully the first time the"
^DIC(19,13089,1,13,0)="option was run."
^DIC(19,13089,20)="D BEGIN^TIU182DF"
^DIC(19,13089,"U")="CREATE DDEFS FOR MED CONVERSIO"
^DIC(19,13090,0)="ONCO UTIL-CS RESTAGING^Restage CS cases using latest version^^R^1^^^^^^^"
^DIC(19,13090,25)="ONCCSRS"
^DIC(19,13090,"U")="RESTAGE CS CASES USING LATEST "
^DIC(19,13091,0)="DG SENSITIVE RCDS RPT-TASK^ISO Sensitive Records Report Tasked^^R^10000000020^^^^^^^114"
^DIC(19,13091,1,0)="^^6^6^3050518^"
^DIC(19,13091,1,1,0)="This option will automatically send a VistA email to the mail group of "
^DIC(19,13091,1,2,0)="DG ISO SENSITIVE RCRDS.  This report gives a summary of all sensitive"
^DIC(19,13091,1,3,0)="patient records accessed for the previous day.  It includes: patient "
^DIC(19,13091,1,4,0)="name, user name, title of user, option/protocol that was used when the "
^DIC(19,13091,1,5,0)="patient record was accessed, date/time the record was accessed and if the "
^DIC(19,13091,1,6,0)="patient record was an inpatient at the time."
^DIC(19,13091,25)="EN^DGISORPT"
^DIC(19,13091,"U")="ISO SENSITIVE RECORDS REPORT T"
^DIC(19,13092,0)="DG SENSITIVE RCDS RPT-EXPORT^ISO Sensitive Records Report-Export^^P^10000000020^^^^^^^114^^1^1"
^DIC(19,13092,1,0)="^^6^6^3050606^"
^DIC(19,13092,1,1,0)="This report will provided a list of patients accessed by a date range.  It"
^DIC(19,13092,1,2,0)="includes: patient name, user name, title of user, option/protocol that was"
^DIC(19,13092,1,3,0)="used when the patient record was accessed, date/time the record was"
^DIC(19,13092,1,4,0)="accessed and if the patient record was an inpatient at the time."
^DIC(19,13092,1,5,0)=" "
^DIC(19,13092,1,6,0)="Report is in a downloadable format."
^DIC(19,13092,15)="K DGCNT"
^DIC(19,13092,20)="W !!,""THIS REPORT MAY TAKE A WHILE, YOU MAY WANT TO QUEUE IT."",!,""***256 COLUMNS AND WRAP AROUND NEEDED***"",!"
