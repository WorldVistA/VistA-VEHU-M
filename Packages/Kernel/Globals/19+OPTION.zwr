^DIC(19,7886,10,"C","TLS",12)=""
^DIC(19,7886,10,"C","VSM",14)=""
^DIC(19,7886,99)="64947,50979"
^DIC(19,7886,99.1)="55707,82829"
^DIC(19,7886,"U")="CAPACITY PLANNING"
^DIC(19,7887,0)="XTVR RESTORE PREV ROUTINE^UNDO Edits (Restore to Older Version of Routine)^^R^.5^^^^^^^349"
^DIC(19,7887,1,0)="^^6^6^2930902^"
^DIC(19,7887,1,1,0)="This option is used to restore a routine back to a previous version which is"
^DIC(19,7887,1,2,0)="available in the previous version edits shown by the Routine Compare option."
^DIC(19,7887,1,3,0)="The user must specify a routine name to be used for the restored routine that"
^DIC(19,7887,1,4,0)="is not currently used (so that no current routine is destroyed as a result of"
^DIC(19,7887,1,5,0)="saving the newly restored routine).  After checking that the restored routine"
^DIC(19,7887,1,6,0)="is the desired version, the user may rename it as desired."
^DIC(19,7887,10.1)="UNDO Routine Edits"
^DIC(19,7887,25)="XTVRCRES"
^DIC(19,7887,"U")="UNDO EDITS (RESTORE TO OLDER V"
^DIC(19,7888,0)="ZEE FIZZIES^FIZZIES^^M^11277"
^DIC(19,7888,1,0)="^^1^1^2960404^^^^"
^DIC(19,7888,1,1,0)="LOCAL MENU FOR FISMAP"
^DIC(19,7888,10,0)="^19.01IP^18^10"
^DIC(19,7888,10,1,0)="297^^"
^DIC(19,7888,10,2,0)="3839^^"
^DIC(19,7888,10,5,0)="6065^^"
^DIC(19,7888,10,10,0)="7989^^"
