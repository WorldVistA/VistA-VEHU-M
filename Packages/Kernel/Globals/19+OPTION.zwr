^DIC(19,11824,"U")="CLAIMS MATCHING REPORT"
^DIC(19,11825,0)="RMPO HO PAT TEMPLATE UPDATE^Home Oxygen Patient Template Update^^R^11720^RMPRSUPERVISOR^^^^^^"
^DIC(19,11825,1,0)="^^5^5^3001221^"
^DIC(19,11825,1,1,0)="This is a utility for updating VENDOR, HCPCS, FCP, ITEM, and UNIT COST of"
^DIC(19,11825,1,2,0)="all Home Oxygen patients in a particular station at once.  Only the"
^DIC(19,11825,1,3,0)="patient template is changed not the monthly billing.  If the monthly"
^DIC(19,11825,1,4,0)="billing is already been created for a certain month, changes on the"
^DIC(19,11825,1,5,0)="template will not affect the billing cycle."
^DIC(19,11825,25)="START^RMPOVDC"
^DIC(19,11825,"U")="HOME OXYGEN PATIENT TEMPLATE U"
^DIC(19,11826,0)="PRCS TERMINATE^Remove a deactivated user from IFCAP^^A^11740^^^^^^n^121^^1"
^DIC(19,11826,1,0)="^19.06^4^4^3001228^^"
^DIC(19,11826,1,1,0)="This option is linked to the Kernel XU USER TERMINATE option/protocol"
^DIC(19,11826,1,2,0)="so that a terminated user is removed from all IFCAP control points."
^DIC(19,11826,1,3,0)="XUIFN is the Kernel variable used to determine the user's identity."
^DIC(19,11826,1,4,0)=""
^DIC(19,11826,20)="S DA=XUIFN DO USEROUT^PRCSUT41"
^DIC(19,11826,25)=""
^DIC(19,11826,"U")="REMOVE A DEACTIVATED USER FROM"
^DIC(19,11827,0)="ENFA CT MENU^Capitalization Threshold 100K Task Menu^^M^10000000033^^^^^^^33"
^DIC(19,11827,1,0)="^19.06^4^4^3020502^^^^"
^DIC(19,11827,1,1,0)="This menu holds options related to the one-time task to expense"
^DIC(19,11827,1,2,0)="capitalized equipment that does not meet the new capitalization threshold"
^DIC(19,11827,1,3,0)="of $100,000.  The menu and the options attached to it will be obsolete"
^DIC(19,11827,1,4,0)="after the one-time task runs on July 24, 2002."
^DIC(19,11827,10,0)="^19.01IP^4^4"
^DIC(19,11827,10,1,0)="11829^^1"
^DIC(19,11827,10,2,0)="11828^^2"
^DIC(19,11827,10,3,0)="11830^^3"
^DIC(19,11827,10,4,0)="11831^^4"
^DIC(19,11827,10,"B",11828,2)=""
^DIC(19,11827,10,"B",11829,1)=""
^DIC(19,11827,10,"B",11830,3)=""
^DIC(19,11827,10,"B",11831,4)=""
^DIC(19,11827,99)="59560,59274"
^DIC(19,11827,99.1)="58975,3870"
^DIC(19,11827,"U")="CAPITALIZATION THRESHOLD 100K "
^DIC(19,11828,0)="ENFA CT EXP EDIT^Adjust List of Equipment to be Expensed by Task^^R^10000000033^^^^^^^33^^1"
^DIC(19,11828,1,0)="^19.06^6^6^3020502^^^^"
^DIC(19,11828,1,1,0)="This option is used to prevent selected equipment from being expensed by"
^DIC(19,11828,1,2,0)="the one-time task. The task will run on July 24, 2002, examine all"
^DIC(19,11828,1,3,0)="capitalized equipment that is reported to Fixed Assets/FMS, and expense"
^DIC(19,11828,1,4,0)="those items which do not meet the new capitalization threshold. Any"
^DIC(19,11828,1,5,0)="equipment that has been set to remain capitalized by this option will be"
^DIC(19,11828,1,6,0)="skipped by the one-time task."
^DIC(19,11828,20)="I $G(DT)>3020725 W $C(7),!,"" *** This option is obsolete and it should not be used.***"""
^DIC(19,11828,25)="ENFACTE"
^DIC(19,11828,"U")="ADJUST LIST OF EQUIPMENT TO BE"
^DIC(19,11829,0)="ENFA CT EXP LIST^List Equipment to be Expensed by Task^^R^10000000033^^^^^^^33^^1"
^DIC(19,11829,1,0)="^19.06^13^13^3020502^^^^"
^DIC(19,11829,1,1,0)="The option generates a report of equipment that currently meets the"
^DIC(19,11829,1,2,0)="criteria to be expensed by the one-time task. The output is sorted by"
^DIC(19,11829,1,3,0)="station and then by value.  Equipment that is currently capitalized and"
^DIC(19,11829,1,4,0)="reported to Fixed Assets/FMS would be expensed unless it meets one or more"
^DIC(19,11829,1,5,0)="of the following criteria:"
^DIC(19,11829,1,6,0)="  SGL = 1524 (EXCESS)"
^DIC(19,11829,1,7,0)="  FUND = 4539 (FRANCHISE)"
^DIC(19,11829,1,8,0)="  ASSET VALUE greater than $99,999.99"
^DIC(19,11829,1,9,0)="  SYSTEM ASSET VALUE greater than $99,999.99 "
^DIC(19,11829,1,10,0)="  Item edited by user to Remain Capitalized"
^DIC(19,11829,1,11,0)="The system asset value is determined by adding the asset values of all"
^DIC(19,11829,1,12,0)="equipment which is part of a system and also reported to Fixed Assets/FMS."
^DIC(19,11829,1,13,0)="Equipment can be placed in a system using the PARENT field."
^DIC(19,11829,20)="I $G(DT)>3020725 W $C(7),!,"" *** This option is obsolete and it should not be used.***"""
^DIC(19,11829,25)="ENFACTL"
^DIC(19,11829,"U")="LIST EQUIPMENT TO BE EXPENSED "
^DIC(19,11830,0)="ENFA CT RC LIST^Equipment Removed from Expense List by User^^R^10000000033^^^^^^^33^^1"
^DIC(19,11830,1,0)="^19.06^4^4^3020502^^^^"
^DIC(19,11830,1,1,0)="This options generates a list of any equipment items that were set to"
^DIC(19,11830,1,2,0)="remain capitalized by a user.  This equipment will not be expensed by the"
^DIC(19,11830,1,3,0)="one-time task on July 24, 2002 even though it meets the other criteria"
^DIC(19,11830,1,4,0)="to be expensed."
^DIC(19,11830,20)="I $G(DT)>3020725 W $C(7),!,"" *** This option is obsolete and it should not be used.***"""
^DIC(19,11830,25)="ENFACTR"
^DIC(19,11830,"U")="EQUIPMENT REMOVED FROM EXPENSE"
^DIC(19,11831,0)="ENFA CT CAP LIST^Show Equipment Task Will Leave Capitalized^^R^10000000033^^^^^^^33^^1"
^DIC(19,11831,1,0)="^^6^6^3000223^^^^"
^DIC(19,11831,1,1,0)="The option generates a report of currently capitalized equipment that does"
^DIC(19,11831,1,2,0)="NOT meet the criteria to be expensed by the one-time task. The output is"
^DIC(19,11831,1,3,0)="sorted by station and then by value. The reason why the equipment will not"
^DIC(19,11831,1,4,0)="be expensed by the one-time task is shown. See the description of the List"
^DIC(19,11831,1,5,0)="Equipment to be Expensed by Task option for more information on the"
^DIC(19,11831,1,6,0)="criteria."
^DIC(19,11831,20)="I $G(DT)>3020725 W $C(7),!,"" *** This option is obsolete and it should not be used.***"""
^DIC(19,11831,25)="ENFACTS"
^DIC(19,11831,"U")="SHOW EQUIPMENT TASK WILL LEAVE"
^DIC(19,11832,0)="PRCP REMOVE SS FROM DIST ORD^Remove Supply Station From Dist Order^^R^11740^^^^^^^"
^DIC(19,11832,1,0)="^^4^4^3001102^"
^DIC(19,11832,1,1,0)="This option will only be used when the interface between GIP and the"
^DIC(19,11832,1,2,0)="supply stations is down for a long time.  It allows the user to identify"
^DIC(19,11832,1,3,0)="an individually orders that will be processed further in GIP and not by"
^DIC(19,11832,1,4,0)="the supply stations."
