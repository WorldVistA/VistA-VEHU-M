^DIC(19,9828,"U")="PCMM REPORTS"
^DIC(19,9829,0)="SC PCMM PT LIST W/TEAM ASSIGN^Patient Listing for Team Assignments^^R^11281^^^^^^^16^^"
^DIC(19,9829,1,0)="^^4^4^2990908^^"
^DIC(19,9829,1,1,0)="This report lists patients along with selected team information (Team name,"
^DIC(19,9829,1,2,0)="practitioners in positions assigned to patients, etc.).  If 'NONE' is"
^DIC(19,9829,1,3,0)="selected for the practitioner, the report will list patients without"
^DIC(19,9829,1,4,0)="that kind of assignment (e.g., no Primary Care Practitioner)."
^DIC(19,9829,20)=""
^DIC(19,9829,25)="PROMPTS^SCRPTA"
^DIC(19,9829,99)="56649,58071"
^DIC(19,9829,"U")="PATIENT LISTING FOR TEAM ASSIG"
^DIC(19,9830,0)="SC PCMM DETAIL LIST PTS^Detailed Patient Assignments^Obsolete with SD*5.3*535^R^1^^^^^^^16^^"
^DIC(19,9830,1,0)="^19.06^6^6^3080421^^"
^DIC(19,9830,1,1,0)="This report lists patients and the clinics in which they are enrolled.  "
^DIC(19,9830,1,2,0)="This report may be used prior to team/position assignments in order to"
^DIC(19,9830,1,3,0)="help validate clinic enrollments.  The report can be printed for those "
^DIC(19,9830,1,4,0)="patients who are assigned to the team for primary care or for those"
^DIC(19,9830,1,5,0)="patients who are assigned to the team for something other than primary"
^DIC(19,9830,1,6,0)="care."
^DIC(19,9830,20)=""
^DIC(19,9830,25)="PROMPTS^SCRPEC"
^DIC(19,9830,99)="56693,59580"
^DIC(19,9830,99.1)="58437,14480"
^DIC(19,9830,"U")="DETAILED PATIENT ASSIGNMENTS"
^DIC(19,9831,0)="SC PCMM PRACT DEMO^Practitioner Demographics^^R^11281^^^^^^^16^^"
^DIC(19,9831,1,0)="^^2^2^2960226^^^^"
^DIC(19,9831,1,1,0)="This report displays administrative information for a chosen practitioner."
^DIC(19,9831,1,2,0)="This will be similar to or may replace the Clinic Profile option."
^DIC(19,9831,20)=""
^DIC(19,9831,25)="PROMPTS^SCRPRAC"
^DIC(19,9831,99)="56649,58102"
^DIC(19,9831,"U")="PRACTITIONER DEMOGRAPHICS"
^DIC(19,9832,0)="SC PCMM PRACT PATIENTS^Practitioner's Patients^^R^11281^^^^^^^16^y^"
^DIC(19,9832,1,0)="^^2^2^2960228^^"
^DIC(19,9832,1,1,0)="This report identifies the size and constituents of a practitioner's"
^DIC(19,9832,1,2,0)="patient panel."
^DIC(19,9832,20)=""
^DIC(19,9832,25)="PROMPTS^SCRPPAT"
^DIC(19,9832,"U")="PRACTITIONER'S PATIENTS"
^DIC(19,9833,0)="SC PCMM IND TEAM PROFILE^Individual Team Profile^^R^1^^^^^^^16^y"
^DIC(19,9833,1,0)="^^1^1^2960206^"
^DIC(19,9833,1,1,0)="This displays basic team definition information."
^DIC(19,9833,25)="PROMPTS^SCRPITP"
^DIC(19,9833,"U")="INDIVIDUAL TEAM PROFILE"
^DIC(19,9834,0)="SC PCMM SUM LIST OF TEAMS^Summary Listing of Teams^^R^1^^^^^^^16"
^DIC(19,9834,1,0)="^^3^3^2990908^^"
^DIC(19,9834,1,1,0)="Often practitioners will be interested in knowing the size of their"
^DIC(19,9834,1,2,0)="patient panel.  This report tallies the number of patients assigned"
^DIC(19,9834,1,3,0)="for each practitioner currently assigned to the team."
^DIC(19,9834,25)="PROMPTS^SCRPSLT"
^DIC(19,9834,"U")="SUMMARY LISTING OF TEAMS"
^DIC(19,9835,0)="SC PCMM LIST TEAM'S PATIENTS^Team Patient Listing^^R^1^^^^^^^16^^"
^DIC(19,9835,1,0)="^^3^3^2990820^"
^DIC(19,9835,1,1,0)="This report lists a team's patients and the clinic associated with the"
^DIC(19,9835,1,2,0)="team posistion. It is useful for obtaining the names in the team's patient"
^DIC(19,9835,1,3,0)="panel and for reviewing the clinics related to team positions."
^DIC(19,9835,20)=""
^DIC(19,9835,25)="PROMPTS^SCRPTP"
^DIC(19,9835,"U")="TEAM PATIENT LISTING"
^DIC(19,9836,0)="SC PCMM LIST TEAM'S MEMBERS^Team Member Listing^^R^1^^^^^^^16"
^DIC(19,9836,1,0)="^^3^3^2960206^^^^"
^DIC(19,9836,1,1,0)="This report shows basic information on the Team and member practitioners."
^DIC(19,9836,1,2,0)="It will be used to review the names of the Practitioners assigned to the"
^DIC(19,9836,1,3,0)="team during a certain time period."
^DIC(19,9836,25)="PROMPTS^SCRPTM"
^DIC(19,9836,"U")="TEAM MEMBER LISTING"
^DIC(19,9837,0)="SC PCMM CONVERT PATIENTS^Convert Patient File Fields to PCMM^^A^11289^^^^^^^^^1^"
^DIC(19,9837,1,0)="^^8^8^2960410^^"
^DIC(19,9837,1,1,0)="This takes fields #404.01 (CURRENT PC PRACTITIONER) & #404.42"
^DIC(19,9837,1,2,0)="(CURRENT PC TEAM) of the PATIENT file and if:"
^DIC(19,9837,1,3,0)="   1) The Team is full defined in PCMM"
^DIC(19,9837,1,4,0)="   2) There is only one position for the practitioner on the team"
^DIC(19,9837,1,5,0)="It assigns patients to positions."
^DIC(19,9837,1,6,0)=" "
^DIC(19,9837,1,7,0)="The user may choose to get output only - in this case, no data will"
^DIC(19,9837,1,8,0)="be changed."
^DIC(19,9837,15)=""
^DIC(19,9837,20)="D EN^SCMCCV"
^DIC(19,9837,99)="56697,10383"
^DIC(19,9837,"U")="CONVERT PATIENT FILE FIELDS TO"
^DIC(19,9838,0)="SC MAKE CONSULT APPOINTMENT^Make Consult Appointment^^R^11289^SC CONSULT^^^^^^16^^1^1"
^DIC(19,9838,1,0)="^^5^5^2960430^^"
^DIC(19,9838,1,1,0)="Allows user to make a consult appointment for a specific time for"
^DIC(19,9838,1,2,0)="a patient in a clinic.  This is a clone of the 'Make Appointment'"
^DIC(19,9838,1,3,0)="option except that it allows users to make appointments for patients"
^DIC(19,9838,1,4,0)="who are not enrolled in a clinic and who are designated as 'Restricted"
^DIC(19,9838,1,5,0)="Consults' through certain patient-team assignments."
^DIC(19,9838,15)="K SCOKCONS D SDM^SDKILL K ORACTION,ORVP,XQORQUIT D HDLKILL^SDAMEVT"
^DIC(19,9838,20)="S SCOKCONS=1 K ORACTION,ORVP,XQORQUIT D HDLKILL^SDAMEVT"
^DIC(19,9838,25)="SDM"
^DIC(19,9838,"U")="MAKE CONSULT APPOINTMENT"
^DIC(19,9839,0)="SCMC PCMM GUI WORKSTATION^PCMM GUI WORKSTATION^This functionality is now accomplished by the PCMM Web Application.^B^10000000216^^^^^^^16^^"
^DIC(19,9839,1,0)="^19.06^6^6^3080729^^^^"
^DIC(19,9839,1,1,0)="'B' type option for use after installation of PCMM client version"
^DIC(19,9839,1,2,0)="1.2.0.0/server version SD*5.3*177.  For users to be able to use the"
^DIC(19,9839,1,3,0)="Primary Care Management Module's GUI front-end, this option must be on"
^DIC(19,9839,1,4,0)="either their primary or secondary menu options.  Putting this option on a"
^DIC(19,9839,1,5,0)="menu will give users who have access to that menu, access to PCMM.  Note:"
^DIC(19,9839,1,6,0)="'B' type options are not visible to roll & scroll users."
^DIC(19,9839,20)=""
