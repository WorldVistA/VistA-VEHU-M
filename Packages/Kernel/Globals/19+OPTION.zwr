^DIC(19,15802,0)="EHM-00623^Enable or Disable Debug Message Logging^^R^1^^^^^^^^^^^"
^DIC(19,15802,1,0)="^^6^6^3240328^^^^"
^DIC(19,15802,1,1,0)="Determines if order check debug messages will be logged to ^XTMP(""ORKLOG""."
^DIC(19,15802,1,2,0)="'E' or 'Enabled' enables the logging of order checking debug information."
^DIC(19,15802,1,3,0)="'D' or 'Disabled' disables logging debug messages and cleans out"
^DIC(19,15802,1,4,0)="^XTMP(""ORKLOG"").  ^XTMP(""ORKLOG"" is also killed when more than 5,000 "
^DIC(19,15802,1,5,0)="entries exist.  Therefore, ^XTMP(""ORKLOG"") can only hold 5,000 entries."
^DIC(19,15802,1,6,0)="Cloned from ""ORK DEBUG ENABLE/DISABLE"" option."
^DIC(19,15802,3)=""
^DIC(19,15802,25)="DEBUG^ORKMGR"
^DIC(19,15802,"U")="ENABLE OR DISABLE DEBUG MESSAG"
