^DIC(19,9346,0)="LA7 PRINT 0070 TABLE^Print Source of Specimen Table^^R^.5^^^^^^^480"
^DIC(19,9346,1,0)="^^3^3^2950823^"
^DIC(19,9346,1,1,0)="This option should be used to print the Source of Specimen Table (0070)"
^DIC(19,9346,1,2,0)="from the HL7 standard.  This table contains the possible choices for "
^DIC(19,9346,1,3,0)="filling in field .08 of the Topography file #61."
