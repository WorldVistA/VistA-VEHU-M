^DIC(19,537,0)="DG MEANS TEST DELETE^Delete a Means Test^^A^.5^DG MTDELETE^^^^^^114^^1"
^DIC(19,537,1,0)="11^^13^13^2920715^^"
^DIC(19,537,1,1,0)="This option is used to delete means test data which may have been "
^DIC(19,537,1,2,0)="inadvertantly entered.  Under normal circumstances only individual dates"
^DIC(19,537,1,3,0)="of test may be deleted using this option.  The exception is non-veterans."
^DIC(19,537,1,4,0)="All means tests found for a non-veteran may be deleted."
^DIC(19,537,1,5,0)="  "
^DIC(19,537,1,6,0)="This option invokes the means test event driver."
^DIC(19,537,1,7,0)="   o Deletion of a means test will cause any associated changes to that "
^DIC(19,537,1,8,0)="      means test to also be deleted from the MEANS TEST CHANGES file."
^DIC(19,537,1,9,0)="   o If another means test remains on file for the same patient, and the"
^DIC(19,537,1,10,0)="     status of the remaining means test differs from the one which was"
^DIC(19,537,1,11,0)="     deleted, a 'Means Test Category Change' is entered into the MEANS"
^DIC(19,537,1,12,0)="     TEST CHANGES file.  This can be viewed using the View Means Test"
^DIC(19,537,1,13,0)="     Editing Activity option."
^DIC(19,537,20)="S DGMTYPT=1 D EN^DGMTDEL"
^DIC(19,537,25)=""
^DIC(19,537,99)="55637,44583"
^DIC(19,537,"U")="DELETE A MEANS TEST"
