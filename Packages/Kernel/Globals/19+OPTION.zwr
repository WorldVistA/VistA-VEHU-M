^DIC(19,7177,"U")="EDIT PATIENT ADDRESS INFORMATI"
^DIC(19,7178,0)="DGYP IRT PARM LIST^List of IRT Parameters That Need Updating^^R^.5^^^^^^^307"
^DIC(19,7178,1,0)="^^17^17^2930714^^^^"
^DIC(19,7178,1,1,0)="This option will not interfere with v5.2 in any way."
^DIC(19,7178,1,2,0)=" "
^DIC(19,7178,1,3,0)="This option will check the parameters for the IRT package to make sure"
^DIC(19,7178,1,4,0)="information is contained in the parameters needed to run the IRT "
^DIC(19,7178,1,5,0)="conversion, with the installation of PIMS v5.3."
^DIC(19,7178,1,6,0)=" "
^DIC(19,7178,1,7,0)="A list of those parameters that need to be updated will be provided "
^DIC(19,7178,1,8,0)="by this option.  The parameters on the list will need to be answered "
^DIC(19,7178,1,9,0)="prior to the installation of v5.3. If the parameters are not answered "
^DIC(19,7178,1,10,0)="prior to the installation of v5.3 the IRT conversion will abort and "
^DIC(19,7178,1,11,0)="will need to be run at a later date, when parameters are answered."
^DIC(19,7178,1,12,0)=" "
^DIC(19,7178,1,13,0)="Only those divisions that are running IRT and have parameters that "
^DIC(19,7178,1,14,0)="need to be updated will appear on this list."
^DIC(19,7178,1,15,0)=" "
^DIC(19,7178,1,16,0)="*** Please contact your MAS office if you have any questions as to "
^DIC(19,7178,1,17,0)="how the parameters should be answered."
^DIC(19,7178,25)="EN^DGYPRT1"
^DIC(19,7178,99)="55621,52905"
^DIC(19,7178,"U")="LIST OF IRT PARAMETERS THAT NE"
^DIC(19,7179,0)="DGYP IRT UPDATE PARM^Update IRT Parameters^^R^.5^^^^^^^307"
^DIC(19,7179,1,0)="^^21^21^2930709^^^^"
^DIC(19,7179,1,1,0)="This option will not interfere with v5.2 in any way."
^DIC(19,7179,1,2,0)=" "
^DIC(19,7179,1,3,0)="This option allows the user to update the parameters for the IRT "
^DIC(19,7179,1,4,0)="package that will be needed to run the IRT conversion with the "
^DIC(19,7179,1,5,0)="installation of PIMS v5.3."
^DIC(19,7179,1,6,0)=" "
^DIC(19,7179,1,7,0)="Parameters for all divisions must be answered."
^DIC(19,7179,1,8,0)=" "
^DIC(19,7179,1,9,0)="Parameters will need to be answered prior to the installation of v5.3."
^DIC(19,7179,1,10,0)=" "
^DIC(19,7179,1,11,0)="***Failure to answer any of the parameters prior to installation of "
^DIC(19,7179,1,12,0)="v5.3 will cause the IRT conversion to abort at time of installation.  "
^DIC(19,7179,1,13,0)="You will need to run the IRT conversion again at a later date once"
^DIC(19,7179,1,14,0)="the parameters are answered."
^DIC(19,7179,1,15,0)=" "
^DIC(19,7179,1,16,0)="A list of the parameters that need to be updated can be obtained by "
^DIC(19,7179,1,17,0)="running the option DGYP IRT PARM LIST (List of IRT Parameters That "
^DIC(19,7179,1,18,0)="Need Updating)."
^DIC(19,7179,1,19,0)=" "
^DIC(19,7179,1,20,0)="*** Please contact your MAS office if you have any questions as to"
^DIC(19,7179,1,21,0)="how the parameters should be answered."
^DIC(19,7179,25)="EN1^DGYPRT1"
^DIC(19,7179,99)="55623,42302"
^DIC(19,7179,"U")="UPDATE IRT PARAMETERS"
