^DIC(19,12507,25)="EN^ECXALAR"
^DIC(19,12507,"U")="LAB RESULTS EXTRACT UNTRANSLAT"
^DIC(19,12508,0)="ECX CBOC REPORT^CBOC Activity Report^^R^10000000020^^^^^^^513"
^DIC(19,12508,1,0)="^19.06^6^6^3030923^^^^"
^DIC(19,12508,1,1,0)="This option displays all records from the CLI Extract that have a "
^DIC(19,12508,1,2,0)="Community Based Outpatient Clinic (CBOC) status of Y (=yes).  The "
^DIC(19,12508,1,3,0)="report is grouped by Feeder Key,Division, and Clinic; it lists the P"
^DIC(19,12508,1,4,0)="atient Name, SSN, and Date of Visit for each record.  Totals for "
^DIC(19,12508,1,5,0)="unique SSNs and Visits will be printed for each Clinic, Division, "
^DIC(19,12508,1,6,0)="and Feeder Key, as well as overall totals for the station."
^DIC(19,12508,25)="EN^ECXUCBOC"
^DIC(19,12508,"U")="CBOC ACTIVITY REPORT"
^DIC(19,12509,0)="ECX UNUSUAL REPORTS^Extracts Unusual Reports^^M^10000000033^^^^^^^513"
^DIC(19,12509,1,0)="^19.06^2^2^3030715^^"
^DIC(19,12509,1,1,0)="This menu provides the extract manager with a set of report"
^DIC(19,12509,1,2,0)="with unusual results."
^DIC(19,12509,10,0)="^19.01IP^4^3"
^DIC(19,12509,10,2,0)="12510^2^20"
^DIC(19,12509,10,3,0)="12511^3^30"
^DIC(19,12509,10,4,0)="12514^1^10"
^DIC(19,12509,10,"B",12510,2)=""
^DIC(19,12509,10,"B",12511,3)=""
^DIC(19,12509,10,"B",12514,4)=""
^DIC(19,12509,10,"C",1,4)=""
^DIC(19,12509,10,"C",2,2)=""
^DIC(19,12509,10,"C",3,3)=""
^DIC(19,12509,99)="66805,4238"
^DIC(19,12509,"U")="EXTRACTS UNUSUAL REPORTS"
^DIC(19,12510,0)="ECX PRO COST^Prosthetic Pre-Extract Unusual Cost Report^^R^1^^^^^^^513"
^DIC(19,12510,1,0)=0
^DIC(19,12510,25)="EN^ECXUPRO"
^DIC(19,12510,"U")="PROSTHETIC PRE-EXTRACT UNUSUAL"
^DIC(19,12511,0)="ECX SUR VOL^Surgery Pre-Extract Unusual Volume Report^^R^1^^^^^^^513"
^DIC(19,12511,1,0)="^^9^9^3170531^"
^DIC(19,12511,1,1,0)="This option creates a report that lists unusual volumes that would be generated"
^DIC(19,12511,1,2,0)="by the Surgery (SUR) extract as determined by a user-defined threshold"
^DIC(19,12511,1,3,0)="value.  It should be run prior to the generation of the actual extract to"
^DIC(19,12511,1,4,0)="identify and fix, as necessary, any volumes determined to be erroneous."
^DIC(19,12511,1,5,0)=" "
^DIC(19,12511,1,6,0)="Unusual volumes are defined as Operation Time, Patient Time, or Anesthesia Time"
^DIC(19,12511,1,7,0)="fields greater than the threshold value."
^DIC(19,12511,1,8,0)=" "
^DIC(19,12511,1,9,0)="The report is sorted by descending Volume and Case Number."
^DIC(19,12511,25)="EN^ECXUSUR"
^DIC(19,12511,"U")="SURGERY PRE-EXTRACT UNUSUAL VO"
^DIC(19,12512,0)="ECX FISCAL YEAR EXTRACT^Fiscal Year Logic - DSS Testing Only^^R^11720^ECXMGR^^^^^^513"
^DIC(19,12512,1,0)="^19.06^10^10^3170719^^"
^DIC(19,12512,1,1,0)="This option should be used with caution as it allows the user to run"
^DIC(19,12512,1,2,0)="any supported DSS Extract using specific fiscal year logic.  By"
^DIC(19,12512,1,3,0)="running this option, you may negatively impact your extract data."
^DIC(19,12512,1,4,0)="  "
^DIC(19,12512,1,5,0)="DO NOT USE this option unless you are an official test site for"
^DIC(19,12512,1,6,0)="the DSS Fiscal Year Conversion."
^DIC(19,12512,1,7,0)=" "
^DIC(19,12512,1,8,0)="Extracts for current fiscal year data using current fiscal year logic"
^DIC(19,12512,1,9,0)="will go to the AITC production queue; everything else will go to the"
^DIC(19,12512,1,10,0)="AITC test queue."
^DIC(19,12512,25)="EN^ECXTREX"
^DIC(19,12512,"U")="FISCAL YEAR LOGIC - DSS TESTIN"
^DIC(19,12513,0)="ECX CPT INQUIRY^CPT Inquiry^^R^10000000020^^^^^^^513"
^DIC(19,12513,1,0)="^19.06^2^2^3030923^^^"
^DIC(19,12513,1,1,0)="This inquiry allows the user to select a CPT code, then displays the Short"
^DIC(19,12513,1,2,0)="Name, Category, and Description for the selected code."
^DIC(19,12513,25)="EN^ECXUCPT"
^DIC(19,12513,"U")="CPT INQUIRY"
^DIC(19,12514,0)="ECX PHA VOL^Pharmacy Pre-Extract Unusual Volume Reports^^R^1^^^^^^^513"
^DIC(19,12514,25)="EN^ECXAPHA"
^DIC(19,12514,99)="59457,58244"
^DIC(19,12514,"U")="PHARMACY PRE-EXTRACT UNUSUAL V"
^DIC(19,12515,0)="SD CLN STOP CODE REP^Non-Conforming Clinics Stop Code Report^^R^10000000033^^^^^^y^16"
^DIC(19,12515,1,0)="^19.06^6^6^3030811^^^^"
^DIC(19,12515,1,1,0)="This option lists all the clinic entries in the HOSPITAL LOCATION "
^DIC(19,12515,1,2,0)="file (#44) that have invalid primary or secondary stop codes.  The "
^DIC(19,12515,1,3,0)="report will list the clinic name, primary stop code, secondary stop "
^DIC(19,12515,1,4,0)="code and the reason for non conformance.  If the clinics have all "
^DIC(19,12515,1,5,0)="conforming primary and secondary clinic stop codes then NO PROBLEM "
^DIC(19,12515,1,6,0)="CLINICS FOUND will be listed on the report."
^DIC(19,12515,10.1)="Cln Non-Conform Stop Code Rep"
^DIC(19,12515,25)="SDSCRP"
^DIC(19,12515,"U")="NON-CONFORMING CLINICS STOP CO"
^DIC(19,12516,0)="ECX CLN STOP REP^Stop Code Non-Conforming Clinics Report^OUT OF ORDER, DO NOT USE THIS OPTION!!!^R^10000000020^^^^^^^513"
^DIC(19,12516,1,0)="^19.06^5^5^3030811^^^^"
^DIC(19,12516,1,1,0)="This option synchronizes the Primary and Secondary Stop Codes found "
^DIC(19,12516,1,2,0)="in the Clinics and Stop Codes File #728.44 with the Primary and "
^DIC(19,12516,1,3,0)="Secondary Stop codes found in the Hospital Location File #44.  It "
^DIC(19,12516,1,4,0)="produces a report of the Clinics that are non-conforming to the stop "
^DIC(19,12516,1,5,0)="code restriction types."
^DIC(19,12516,10.1)="DSS Id. Non-Conform Cln Rep"
^DIC(19,12516,25)="ECXSCRP"
^DIC(19,12516,"U")="STOP CODE NON-CONFORMING CLINI"
^DIC(19,12517,0)="MPIF SEEDING TASK^SEEDING BACKGROUND TASK^^R^10000000033^^^^^^^537"
^DIC(19,12517,1,0)="^19.06^5^5^3030205^^"
^DIC(19,12517,1,1,0)="This is a background task that will send the A31 seeding messages to the "
^DIC(19,12517,1,2,0)="MPI. This job should only be run as a background tasked job.  It will be "
^DIC(19,12517,1,3,0)="scheduled to run every hour until the seeding has completed.  When the "
^DIC(19,12517,1,4,0)="seeding has been completed, the site will be sent a message to unschedule "
^DIC(19,12517,1,5,0)="the job."
^DIC(19,12517,25)="START^MPIFSEED"
^DIC(19,12517,"U")="SEEDING BACKGROUND TASK"
^DIC(19,12518,0)="EASEC LTC COPAY TEST EXPIRE^Expiring or Expired LTC Copayment Tests^^R^10000000033^^^^^^^"
^DIC(19,12518,1,0)="^^9^9^3030915^"
^DIC(19,12518,1,1,0)="This option will print a choice of two reports:  one is a list of "
^DIC(19,12518,1,2,0)="veterans whose LTC copayment test (10-10EC) is about to be a year old "
^DIC(19,12518,1,3,0)="within a user-specified time frame (up to 60 days), the other is a "
^DIC(19,12518,1,4,0)="list of veterans whose LTC copayment test (10-10EC) is more than a year"
^DIC(19,12518,1,5,0)="old since a user-specified date. The user will be prompted to select which"
^DIC(19,12518,1,6,0)="report to produce. These reports will not include deceased veterans,"
^DIC(19,12518,1,7,0)="veterans who were exempt from LTC copayments due to a compensable"
^DIC(19,12518,1,8,0)="service-connected disability, or veterans whose LTC episode began before"
^DIC(19,12518,1,9,0)="11/30/99."
^DIC(19,12518,25)="EN^EASECEXP"
^DIC(19,12518,"U")="EXPIRING OR EXPIRED LTC COPAYM"
^DIC(19,12519,0)="FB FPPS UPDATE MENU^FPPS Update & Transmit Menu^^M^10000000033^^^^^^^344"
^DIC(19,12519,1,0)="^19.06^2^2^3030825^^^^"
^DIC(19,12519,1,1,0)="Menu for fee supervisor options that are related to the interface with the"
^DIC(19,12519,1,2,0)="FPPS system."
^DIC(19,12519,10,0)="^19.01IP^7^6"
^DIC(19,12519,10,1,0)="12520^^1"
^DIC(19,12519,10,2,0)="12521^^3"
^DIC(19,12519,10,3,0)="12522^^2"
^DIC(19,12519,10,4,0)="12523^^4"
^DIC(19,12519,10,6,0)="12526^^6"
^DIC(19,12519,10,7,0)="12527^^7"
^DIC(19,12519,10,"B",12520,1)=""
^DIC(19,12519,10,"B",12521,2)=""
^DIC(19,12519,10,"B",12522,3)=""
^DIC(19,12519,10,"B",12523,4)=""
^DIC(19,12519,10,"B",12526,6)=""
^DIC(19,12519,10,"B",12527,7)=""
^DIC(19,12519,99)="64951,66937"
^DIC(19,12519,"U")="FPPS UPDATE & TRANSMIT MENU"
^DIC(19,12520,0)="FBAA FPPS EDIT INVOICE^Outpatient/Ancillary Invoice Edit^^R^1^FBAA LEVEL 2^^^^^^344"
^DIC(19,12520,1,0)="^19.06^3^3^3140515^^^"
^DIC(19,12520,1,1,0)="This option is used to edit an outpatient or ancillary invoice that has"
^DIC(19,12520,1,2,0)="previously been transmitted to FPPS.  If changes are made, the invoice"
^DIC(19,12520,1,3,0)="will be queued to be resent to FPPS."
^DIC(19,12520,25)="FBAAFED"
^DIC(19,12520,"U")="OUTPATIENT/ANCILLARY INVOICE E"
^DIC(19,12521,0)="FBCH FPPS EDIT INVOICE^Inpatient Invoice Edit^^R^1^FBAA LEVEL 2^^^^^^344"
^DIC(19,12521,1,0)="^19.06^3^3^3140515^^"
^DIC(19,12521,1,1,0)="This option is used to edit an inpatient (civil hospital or community "
^DIC(19,12521,1,2,0)="nursing home) invoice that has previously been transmitted to FPPS.  If"
^DIC(19,12521,1,3,0)="changes are made, the invoice will be queued to be resent to FPPS."
^DIC(19,12521,25)="FBCHFED"
^DIC(19,12521,"U")="INPATIENT INVOICE EDIT"
^DIC(19,12522,0)="FBRX FPPS EDIT INVOICE^Pharmacy Invoice Edit^^R^1^FBAA LEVEL 2^^^^^^344"
^DIC(19,12522,1,0)="^19.06^3^3^3140516^^^"
^DIC(19,12522,1,1,0)="This option is used to edit a pharmacy invoice that has previously been"
^DIC(19,12522,1,2,0)="transmitted to FPPS.  If changes are made, the invoice will be queued to"
^DIC(19,12522,1,3,0)="be resent to FPPS."
^DIC(19,12522,25)="FBRXFED"
^DIC(19,12522,"U")="PHARMACY INVOICE EDIT"
^DIC(19,12523,0)="FB FPPS AUDIT REPORT^Audit Report for FPPS Data^^R^10000000033^^^^^^^344"
^DIC(19,12523,1,0)="^^4^4^3030718^"
^DIC(19,12523,1,1,0)="This option generates a report from the FEE BASIS FPPS AUDIT file.  This "
^DIC(19,12523,1,2,0)="file contains an audit log of changes made to an invoice using special"
^DIC(19,12523,1,3,0)="edit options.  The options allow editing of selected data after the"
^DIC(19,12523,1,4,0)="invoice has been transmitted to FPPS to resolve exceptions."
^DIC(19,12523,25)="FBFPAR"
^DIC(19,12523,"U")="AUDIT REPORT FOR FPPS DATA"
^DIC(19,12524,0)="FB FPPS CLAIM INQ^FPPS Claim Inquiry^^R^10000000033^^^^^^^344"
^DIC(19,12524,1,0)="^19.06^2^2^3030807^^"
^DIC(19,12524,1,1,0)="This option lists VistA invoices and unauthorized claims that are "
^DIC(19,12524,1,2,0)="associated with a user-specified FPPS Claim ID."
^DIC(19,12524,25)="FBFPCI"
^DIC(19,12524,"U")="FPPS CLAIM INQUIRY"
^DIC(19,12525,0)="FB FPPS TRANSMIT^Transmit Invoices to FPPS^^R^10000000033^^^^^^^344^y"
^DIC(19,12525,1,0)="^^12^12^3030825^"
^DIC(19,12525,1,1,0)="This option transmits invoice data to the Fee Payment Processing System "
^DIC(19,12525,1,2,0)="(FPPS) located at the Health Administration Center (HAC) so FPPS can "
^DIC(19,12525,1,3,0)="send electronic remittance advice to the vendor for claims that were "
^DIC(19,12525,1,4,0)="electronically submitted to VA."
^DIC(19,12525,1,5,0)=" "
^DIC(19,12525,1,6,0)="This option can be scheduled (with no output device needed) or it can be"
^DIC(19,12525,1,7,0)="run interactively from a menu. If scheduled, it will transmit all pending"
^DIC(19,12525,1,8,0)="invoices. If run interactively, the user is given an option to transmit a"
^DIC(19,12525,1,9,0)="selected invoice or all pending invoices.  If necessary, an invoice that"
^DIC(19,12525,1,10,0)="has been previously sent to FPPS can be re-transmitted by selecting it.  "
^DIC(19,12525,1,11,0)="When all pending invoices are sent, a summary message will be mailed to"
^DIC(19,12525,1,12,0)="the FEE mail group."
^DIC(19,12525,25)="EN^FBFHLX"
^DIC(19,12525,200.9)="y"
^DIC(19,12525,"U")="TRANSMIT INVOICES TO FPPS"
^DIC(19,12526,0)="FB FPPS TRANSMIT REPORT^Report of Transmissions to FPPS^^R^10000000033^^^^^^^344"
^DIC(19,12526,1,0)="^^14^14^3030910^"
^DIC(19,12526,1,1,0)="This option generates a report of fee invoices transmitted to the VistA"
^DIC(19,12526,1,2,0)="HL7 package for delivery to the Fee Payment Processing System (FPPS) at"
^DIC(19,12526,1,3,0)="the Health Administration Center (HAC)."
^DIC(19,12526,1,4,0)=" "
^DIC(19,12526,1,5,0)="Note that the count displayed under the Accepted By Interface Engine"
^DIC(19,12526,1,6,0)="column will only reflect acknowledgements received prior to the most"
^DIC(19,12526,1,7,0)="recent transmit of all pending invoices.  This is because the check for"
^DIC(19,12526,1,8,0)="acknowledgements is performed at the beginning of the transmit all pending"
^DIC(19,12526,1,9,0)="process.  Therefore, if the user-specified period includes the date of the"
^DIC(19,12526,1,10,0)="most recent transmit, the recently transmitted invoices will be included"
^DIC(19,12526,1,11,0)="in the counts under the Payment Confirm and Payment Cancelled columns, but"
^DIC(19,12526,1,12,0)="not under the Accepted By Interface Engine column.  This is because VistA"
^DIC(19,12526,1,13,0)="Fee Basis will not yet have checked to see if those invoices were"
^DIC(19,12526,1,14,0)="acknowledged."
^DIC(19,12526,25)="FBFPTR"
^DIC(19,12526,"U")="REPORT OF TRANSMISSIONS TO FPP"
^DIC(19,12527,0)="FB FPPS PURGE^Purge Message Text^^R^1^FBAA LEVEL 2^^^^^^344"
^DIC(19,12527,1,0)="^19.06^7^7^3030909^^"
^DIC(19,12527,1,1,0)="When an invoice is transmitted to FPPS via the HL7 package, a copy of the "
^DIC(19,12527,1,2,0)="HL7 message text is saved in the FPPS QUEUED INVOICES (#163.5) file."
^DIC(19,12527,1,3,0)=" "
^DIC(19,12527,1,4,0)="This option purges the message text for invoices transmitted prior to a"
^DIC(19,12527,1,5,0)="specified date.  Messages that have not been accepted by the VistA "
^DIC(19,12527,1,6,0)="Interface Engine will not be purged unless there is a later message for"
^DIC(19,12527,1,7,0)="the same invoice number that has been accepted."
^DIC(19,12527,25)="FBFHLP"
^DIC(19,12527,"U")="PURGE MESSAGE TEXT"
^DIC(19,12528,0)="RCDPE EDI LOCKBOX PARAMETERS^EDI Lockbox Parameters^^R^1^RCDPE AUTO DEC^^^^^^261"
^DIC(19,12528,1,0)="^19.06^3^3^3140218^^^^"
^DIC(19,12528,1,1,0)="This option allows users to edit the EDI Lockbox site parameters.  These"
^DIC(19,12528,1,2,0)="parameters include: Number of Days EFT Unmatched, and Number of Days ERA"
^DIC(19,12528,1,3,0)="Unmatched. "
^DIC(19,12528,25)="EN^RCDPESP"
^DIC(19,12528,"U")="EDI LOCKBOX PARAMETERS"
^DIC(19,12529,0)="RCDPE EDI LOCKBOX SERVER^EDI Lockbox EFT/ERA/EEOB Processing Server^^S^10000000033^^^^^^^261^^"
^DIC(19,12529,1,0)="^19.06^2^2^3020829^^^^"
^DIC(19,12529,1,1,0)="This option is the server for receiving EDI Lockbox payments and ERA's"
^DIC(19,12529,1,2,0)="for automatic processing in AR."
^DIC(19,12529,20)=""
^DIC(19,12529,25)="SERVER^RCDPESRV"
^DIC(19,12529,220)="^R^^^Y^^1^^7"
^DIC(19,12529,"U")="EDI LOCKBOX EFT/ERA/EEOB PROCE"
^DIC(19,12530,0)="RCDPE EXCEPTION PROCESSING^EDI Lockbox 3rd Party Exceptions^^R^1^^^^^^^261"
^DIC(19,12530,1,0)="^19.06^5^5^3021105^^^^"
^DIC(19,12530,1,1,0)="This option provides a list of ERA/EOB records that are currently marked with"
^DIC(19,12530,1,2,0)="an exception condition.  The option allows you to list either the ERA"
^DIC(19,12530,1,3,0)="messages that are unfiled in VistA (transmission exceptions) or those"
^DIC(19,12530,1,4,0)="that were filed, but have data exceptions.  The records can then be"
^DIC(19,12530,1,5,0)="viewed and various options are provided to reconcile the exceptions."
^DIC(19,12530,25)="EN^RCDPEX1"
^DIC(19,12530,"U")="EDI LOCKBOX 3RD PARTY EXCEPTIO"
^DIC(19,12531,0)="RCDPE EFT AGING REPORT^EFT Unmatched Aging Report^^R^1^^^^^^^261"
^DIC(19,12531,1,0)="^19.06^4^4^3021105^^^^"
^DIC(19,12531,1,1,0)="This option produces the EFT aging report.  This report contains a list"
^DIC(19,12531,1,2,0)="of all Electronic Funds Transfer (EFT) records that have not been"
^DIC(19,12531,1,3,0)="successfully matched to ERAs within the user specified number"
^DIC(19,12531,1,4,0)="of days.  The report can be run with or without details for each record."
^DIC(19,12531,25)="EN1^RCDPEAR2"
^DIC(19,12531,"U")="EFT UNMATCHED AGING REPORT"
^DIC(19,12532,0)="RCDPE ERA AGING REPORT^ERA Unmatched Aging Report^^R^1^^^^^^^261"
^DIC(19,12532,1,0)="^19.06^4^4^3021216^^^^"
^DIC(19,12532,1,1,0)="This option produces the ERA aging report.  This report contains a list"
^DIC(19,12532,1,2,0)="of all Electronic Remittance Advice (ERA) records that have not been"
^DIC(19,12532,1,3,0)="successfully matched to electronic EFTs within the user specified number"
^DIC(19,12532,1,4,0)="of days.  The report can be run with or without details for each record."
^DIC(19,12532,25)="EN1^RCDPEAR1"
^DIC(19,12532,"U")="ERA UNMATCHED AGING REPORT"
^DIC(19,12533,0)="RCDPE MATCH EFT TO ERA^Automatic Match EFTs to ERAs^^R^1^^^^^^^261"
^DIC(19,12533,1,0)="^19.06^5^5^3021216^^^^"
^DIC(19,12533,1,1,0)="This option will start the job to match the 3rd Party Lockbox EFT records"
^DIC(19,12533,1,2,0)="that have not yet been matched to the electronic ERAs currently on file."
^DIC(19,12533,1,3,0)="This option runs a part of the normal nightly processing, but can be run"
^DIC(19,12533,1,4,0)="on demand here.  The job must be queued and only one of these jobs can"
^DIC(19,12533,1,5,0)="be running at any given time."
^DIC(19,12533,25)="EN1^RCDPEM1"
^DIC(19,12533,"U")="AUTOMATIC MATCH EFTS TO ERAS"
^DIC(19,12534,0)="RCDPE EDI LOCKBOX WORKLIST^ERA Worklist^^R^1^^^^^^^261"
^DIC(19,12534,1,0)="^19.06^6^6^3030610^^^^"
^DIC(19,12534,1,1,0)="This option provides a list of electronic EOB detail records that were"
^DIC(19,12534,1,2,0)="included on a selected electronic remittance advice (ERA).  It allows for"
^DIC(19,12534,1,3,0)="the creation of a receipt that will post the detail contained in each EOB"
^DIC(19,12534,1,4,0)="against the site's A/R and to FMS.  To accomplish this, some manipulation"
^DIC(19,12534,1,5,0)="of the payment data may be necessary and some of the tools for performing"
^DIC(19,12534,1,6,0)="this manipulation are included in this function."
^DIC(19,12534,25)="EN^RCDPEWL"
^DIC(19,12534,"U")="ERA WORKLIST"
^DIC(19,12536,0)="RCDPE EDI LOCKBOX MENU^EDI Lockbox (ePayments)^^M^1^^^^^^^261"
^DIC(19,12536,1,0)="^19.06^1^1^3250611^^^^"
^DIC(19,12536,1,1,0)="This is the menu that contains the EDI Lockbox functionality."
