^DIC(19,5894,0)="RT INACT-MENU^Inactivate Records Menu^^M^.5^^^^^^^^^1^1"
^DIC(19,5894,1,0)="^^7^7^2910528^^^^"
^DIC(19,5894,1,1,0)="If a record is going to be taken out of service it is inactivated so"
^DIC(19,5894,1,2,0)="it is not requested, charged out, etc."
^DIC(19,5894,1,3,0)="This menu includes the options for Record Retirement tasks."
^DIC(19,5894,1,4,0)="The options are ordered as a guide for the work flow.  Pull lists"
^DIC(19,5894,1,5,0)="are generated, printed, managed, perpetual records created and "
^DIC(19,5894,1,6,0)="then the record retirement pull lists are 'charged out' when the"
^DIC(19,5894,1,7,0)="records are transferred to the appropriate facility."
