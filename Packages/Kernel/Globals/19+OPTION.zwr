^DIC(19,13752,10,"C",2,2)=""
^DIC(19,13752,99)="61564,56794"
^DIC(19,13752,"U")="UTILITIES THAT MANIPULATE TRAN"
^DIC(19,13753,0)="VBEC ANTIBODY/ANTIGEN UTIL.^Utilities that manipulate Antibody/Antigen data^^M^1^^^^^^^"
^DIC(19,13753,1,0)="^19.06^8^8^3030103^^^"
^DIC(19,13753,1,1,0)="This is a menu that contains options to manipulate Antibody/Antigen "
^DIC(19,13753,1,2,0)="data.  VistA antibody/antigen data must be matched to a standard list of "
^DIC(19,13753,1,3,0)="antigens and antibodies prior to data conversion.  This menu contains "
^DIC(19,13753,1,4,0)="options that facilitate matching.  Antibody/antigen records must first be "
^DIC(19,13753,1,5,0)="moved to a temporary file, which can be kept in synchronization with the "
^DIC(19,13753,1,6,0)="VistA data by using the updating feature.  Matches can be assigned and "
^DIC(19,13753,1,7,0)="undone, and a list of matches can be printed.  The temporary table can be "
^DIC(19,13753,1,8,0)="completely deleted."
^DIC(19,13753,10,0)="^19.01IP^5^5"
^DIC(19,13753,10,1,0)=13741
^DIC(19,13753,10,2,0)="13745^2^2"
^DIC(19,13753,10,3,0)="13734^^"
