^XMB(3.9,146056,2,2526,0)="CMOP(RX) ; -- return CMOP indicator for RX"
^XMB(3.9,146056,2,2527,0)="""RTN"",""VPRSDAP"",123,0)"
^XMB(3.9,146056,2,2528,0)=" N Y S Y="""",RX=+$G(RX)"
