^XMB(3.9,146091,2,476,0)=" Q"
^XMB(3.9,146091,2,477,0)="""RTN"",""MAGQBUT4"",114,0)"
^XMB(3.9,146091,2,478,0)="GPACHX(PV) ; Get Package File Install History of Imaging"
^XMB(3.9,146091,2,479,0)="""RTN"",""MAGQBUT4"",115,0)"
^XMB(3.9,146091,2,480,0)=" N I,LCNT,MSG,PKG"
^XMB(3.9,146091,2,481,0)="""RTN"",""MAGQBUT4"",116,0)"
^XMB(3.9,146091,2,482,0)=" S LCNT=0"
^XMB(3.9,146091,2,483,0)="""RTN"",""MAGQBUT4"",117,0)"
^XMB(3.9,146091,2,484,0)=" S PV(0)=""Version^Install Date"""
^XMB(3.9,146091,2,485,0)="""RTN"",""MAGQBUT4"",118,0)"
^XMB(3.9,146091,2,486,0)=" F PKG=""IMAGING"" D"
^XMB(3.9,146091,2,487,0)="""RTN"",""MAGQBUT4"",119,0)"
^XMB(3.9,146091,2,488,0)=" . N J,K,L,VERS,DATE,X,Y"
^XMB(3.9,146091,2,489,0)="""RTN"",""MAGQBUT4"",120,0)"
^XMB(3.9,146091,2,490,0)=" . S J=$O(^DIC(9.4,""B"",PKG,"""")) Q:'J"
^XMB(3.9,146091,2,491,0)="""RTN"",""MAGQBUT4"",121,0)"
^XMB(3.9,146091,2,492,0)=" . S VERS="""" F  S VERS=$O(^DIC(9.4,J,22,""B"",VERS)) Q:VERS=""""  D"
^XMB(3.9,146091,2,493,0)="""RTN"",""MAGQBUT4"",122,0)"
^XMB(3.9,146091,2,494,0)=" . . N MSG,TAR"
^XMB(3.9,146091,2,495,0)="""RTN"",""MAGQBUT4"",123,0)"
^XMB(3.9,146091,2,496,0)=" . . S K=$O(^DIC(9.4,J,22,""B"",VERS,""""))"
^XMB(3.9,146091,2,497,0)="""RTN"",""MAGQBUT4"",124,0)"
^XMB(3.9,146091,2,498,0)=" . . D LIST^DIC(9.4901,"",""_K_"",""_J_"","",""@;.01;.02;.03"","""","""","""","""","""","""","""",""TAR"",""MSG"")"
^XMB(3.9,146091,2,499,0)="""RTN"",""MAGQBUT4"",125,0)"
^XMB(3.9,146091,2,500,0)=" . . Q:$D(MSG(""DIERR""))"
^XMB(3.9,146091,2,501,0)="""RTN"",""MAGQBUT4"",126,0)"
^XMB(3.9,146091,2,502,0)=" . . S L=0 F  S L=$O(TAR(""DILIST"",""ID"",L)) Q:'L  D"
