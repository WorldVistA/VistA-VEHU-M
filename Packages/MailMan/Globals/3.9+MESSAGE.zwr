^XMB(3.9,146087,2,3257,0)="""RTN"",""YTQRQAD4"",115,0)"
^XMB(3.9,146087,2,3258,0)=" . S STR=""{""""instrumentName"""":""""""_NAME_"""""", """"staffOnly"""":""""""_STAFF_"""""" , """"allowNote"""":""""""_ALWN_"""""" ,"""
^XMB(3.9,146087,2,3259,0)="""RTN"",""YTQRQAD4"",116,0)"
