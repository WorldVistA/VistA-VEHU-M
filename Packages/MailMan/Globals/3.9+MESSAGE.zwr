^XMB(3.9,146047,2,3005,0)="""RTN"",""IBJPI"",17,0)"
^XMB(3.9,146047,2,3006,0)=" ;"
^XMB(3.9,146047,2,3007,0)="""RTN"",""IBJPI"",18,0)"
^XMB(3.9,146047,2,3008,0)="INIT ; init vars & list array"
^XMB(3.9,146047,2,3009,0)="""RTN"",""IBJPI"",19,0)"
^XMB(3.9,146047,2,3010,0)=" K ^TMP($J,""IBJPI"")"
^XMB(3.9,146047,2,3011,0)="""RTN"",""IBJPI"",20,0)"
^XMB(3.9,146047,2,3012,0)=" ; Kills data and video control arrays with active list"
^XMB(3.9,146047,2,3013,0)="""RTN"",""IBJPI"",21,0)"
^XMB(3.9,146047,2,3014,0)=" D CLEAN^VALM10"
