^XMB(3.9,146047,2,3019,0)="""RTN"",""IBJPI"",24,0)"
^XMB(3.9,146047,2,3020,0)=" ;"
^XMB(3.9,146047,2,3021,0)="""RTN"",""IBJPI"",25,0)"
^XMB(3.9,146047,2,3022,0)="HELP ; help"
^XMB(3.9,146047,2,3023,0)="""RTN"",""IBJPI"",26,0)"
^XMB(3.9,146047,2,3024,0)=" ; IB*2.0*601,IB*2.0*621/DM adjust help text"
^XMB(3.9,146047,2,3025,0)="""RTN"",""IBJPI"",27,0)"
^XMB(3.9,146047,2,3026,0)=" D FULL^VALM1"
^XMB(3.9,146047,2,3027,0)="""RTN"",""IBJPI"",28,0)"
^XMB(3.9,146047,2,3028,0)=" W @IOF"
^XMB(3.9,146047,2,3029,0)="""RTN"",""IBJPI"",29,0)"
^XMB(3.9,146047,2,3030,0)=" ;IB*732/CKB - modified the text & added text for the Fix Corrupt Buffers action"
^XMB(3.9,146047,2,3031,0)="""RTN"",""IBJPI"",30,0)"
^XMB(3.9,146047,2,3032,0)=" W !,""This screen displays all the eIV and IIU Site Parameters used to manage"""
^XMB(3.9,146047,2,3033,0)="""RTN"",""IBJPI"",31,0)"
^XMB(3.9,146047,2,3034,0)=" W !,""electronic Insurance Verification."""
^XMB(3.9,146047,2,3035,0)="""RTN"",""IBJPI"",32,0)"
^XMB(3.9,146047,2,3036,0)=" W !!,""The General Parameters section concerns overall parameters for"""
^XMB(3.9,146047,2,3037,0)="""RTN"",""IBJPI"",33,0)"
^XMB(3.9,146047,2,3038,0)=" W !,""monitoring the interface and controlling eIV and IIU communication"""
^XMB(3.9,146047,2,3039,0)="""RTN"",""IBJPI"",34,0)"
^XMB(3.9,146047,2,3040,0)=" W !,""between VistA and the EC located in Austin."""
^XMB(3.9,146047,2,3041,0)="""RTN"",""IBJPI"",35,0)"
^XMB(3.9,146047,2,3042,0)=" W !!,""The Batch Extracts section concerns extract-specific parameters"""
^XMB(3.9,146047,2,3043,0)="""RTN"",""IBJPI"",36,0)"
^XMB(3.9,146047,2,3044,0)=" W !,""including active/inactive status and selection criteria. Parameters"""
^XMB(3.9,146047,2,3045,0)="""RTN"",""IBJPI"",37,0)"
^XMB(3.9,146047,2,3046,0)=" W !,""associated with a specific extract may also be detailed here."""
^XMB(3.9,146047,2,3047,0)="""RTN"",""IBJPI"",38,0)"
^XMB(3.9,146047,2,3048,0)=" W !!,""The Fix Corrupt Buffers action allows a user to list or fix corrupted entries in"""
^XMB(3.9,146047,2,3049,0)="""RTN"",""IBJPI"",39,0)"
^XMB(3.9,146047,2,3050,0)=" W !,""the INSURANCE VERIFICATION PROCESSOR file (#355.33) aka """"the buffer file""""."""
^XMB(3.9,146047,2,3051,0)="""RTN"",""IBJPI"",40,0)"
^XMB(3.9,146047,2,3052,0)=" ;IB*806/CKB - add help text for 'Duplicate Buffer Clean up'"
^XMB(3.9,146047,2,3053,0)="""RTN"",""IBJPI"",41,0)"
^XMB(3.9,146047,2,3054,0)=" W !!,""The Duplicate Buffer Clean up action is a nightly process that rejects"""
^XMB(3.9,146047,2,3055,0)="""RTN"",""IBJPI"",42,0)"
^XMB(3.9,146047,2,3056,0)=" W !,""duplicate entries from the INSURANCE VERIFICATION PROCESSOR file (#355.33)."""
^XMB(3.9,146047,2,3057,0)="""RTN"",""IBJPI"",43,0)"
^XMB(3.9,146047,2,3058,0)=" W !,""Duplicate entries are defined as having identical Insurance Company name,"""
^XMB(3.9,146047,2,3059,0)="""RTN"",""IBJPI"",44,0)"
^XMB(3.9,146047,2,3060,0)=" W !,""Subscriber ID and Group Number for a unique patient. When the action is set"""
^XMB(3.9,146047,2,3061,0)="""RTN"",""IBJPI"",45,0)"
^XMB(3.9,146047,2,3062,0)=" W !,""to YES, the cleanup process will reject the most recent duplicates, leaving"""
^XMB(3.9,146047,2,3063,0)="""RTN"",""IBJPI"",46,0)"
^XMB(3.9,146047,2,3064,0)=" W !,""the oldest entry."""
^XMB(3.9,146047,2,3065,0)="""RTN"",""IBJPI"",47,0)"
^XMB(3.9,146047,2,3066,0)=" D PAUSE^VALM1"
^XMB(3.9,146047,2,3067,0)="""RTN"",""IBJPI"",48,0)"
^XMB(3.9,146047,2,3068,0)=" W @IOF"
^XMB(3.9,146047,2,3069,0)="""RTN"",""IBJPI"",49,0)"
^XMB(3.9,146047,2,3070,0)=" S VALMBCK=""R"""
^XMB(3.9,146047,2,3071,0)="""RTN"",""IBJPI"",50,0)"
^XMB(3.9,146047,2,3072,0)=" Q"
^XMB(3.9,146047,2,3073,0)="""RTN"",""IBJPI"",51,0)"
