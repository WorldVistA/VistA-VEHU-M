^XMB(3.9,146052,2,881,0)="""RTN"",""FBAAMST"",15,0)"
^XMB(3.9,146052,2,882,0)=" S DIR(0)=""DA^""_FBDT1_""::EX"",DIR(""A"")=""To Date: """
^XMB(3.9,146052,2,883,0)="""RTN"",""FBAAMST"",16,0)"
