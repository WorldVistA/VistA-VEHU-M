^XMB(3.9,146020,2,1008,0)="SE(MPIN,MPIA) ; - used for the parser to call back with STARTELEMENT"
^XMB(3.9,146020,2,1009,0)="""RTN"",""MPIFXMLP"",169,0)"
^XMB(3.9,146020,2,1010,0)=" ;"
