^XMB(3.9,146036,2,2133,0)="""RTN"",""DVBCTXML"",44,0)"
^XMB(3.9,146036,2,2134,0)=" ...;Added the Worksheet Originator (DVBWOI,DVBWON) to the return list for CAPRI-11238."
^XMB(3.9,146036,2,2135,0)="""RTN"",""DVBCTXML"",45,0)"
^XMB(3.9,146036,2,2136,0)=" ...S DVBLIST=DVBIEN_U_DVBCT_U_DVBNAME_U_DVBPT_U_DVBORG_U_DVBFLAG_U_DVBWON_"";"""
^XMB(3.9,146036,2,2137,0)="""RTN"",""DVBCTXML"",46,0)"
^XMB(3.9,146036,2,2138,0)=" ...S DVBNCT=DVBNCT+1 M ^TMP(""CAPRI XML LIST"",$J,DVBNCT)=DVBLIST"
^XMB(3.9,146036,2,2139,0)="""RTN"",""DVBCTXML"",47,0)"
