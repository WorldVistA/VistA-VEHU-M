^XMB(3.9,146036,2,3386,0)=" ;RPC: DVBA CAPRI WORKSHEET BY EXAM"
^XMB(3.9,146036,2,3387,0)="""RTN"",""DVBUTIL"",138,0)"
^XMB(3.9,146036,2,3388,0)=" N DVBIEN1,DVBIEN2"
^XMB(3.9,146036,2,3389,0)="""RTN"",""DVBUTIL"",139,0)"
^XMB(3.9,146036,2,3390,0)=" S DVBIEN1="""""
^XMB(3.9,146036,2,3391,0)="""RTN"",""DVBUTIL"",140,0)"
^XMB(3.9,146036,2,3392,0)=" ;"
^XMB(3.9,146036,2,3393,0)="""RTN"",""DVBUTIL"",141,0)"
^XMB(3.9,146036,2,3394,0)=" I DVBEXAM="""" S DVBRETURN=""-1^Missing Exam Reference Number"" Q "
^XMB(3.9,146036,2,3395,0)="""RTN"",""DVBUTIL"",142,0)"
^XMB(3.9,146036,2,3396,0)=" I $D(^DVB(396.4,""B"",DVBEXAM))<10 S DVBRETURN=""-1^Invalid Exam Reference Number"" Q"
^XMB(3.9,146036,2,3397,0)="""RTN"",""DVBUTIL"",143,0)"
^XMB(3.9,146036,2,3398,0)=" S DVBIEN1=$O(^DVB(396.4,""B"",DVBEXAM,DVBIEN1))"
^XMB(3.9,146036,2,3399,0)="""RTN"",""DVBUTIL"",144,0)"
^XMB(3.9,146036,2,3400,0)=" S DVBIEN2=$G(^DVB(396.4,DVBIEN1,2))"
^XMB(3.9,146036,2,3401,0)="""RTN"",""DVBUTIL"",145,0)"
^XMB(3.9,146036,2,3402,0)=" I DVBIEN2="""" S DVBRETURN=""-1^NO worksheet IEN found"" Q"
^XMB(3.9,146036,2,3403,0)="""RTN"",""DVBUTIL"",146,0)"
^XMB(3.9,146036,2,3404,0)=" I $D(^DVB(396.17,DVBIEN2))<10 S DVBRETURN=""-1^Invalid Worksheet pointer saved"" Q"
^XMB(3.9,146036,2,3405,0)="""RTN"",""DVBUTIL"",147,0)"
^XMB(3.9,146036,2,3406,0)=" S DVBRETURN=DVBIEN2"
