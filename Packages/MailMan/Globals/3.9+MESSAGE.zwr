^XMB(3.9,146106,2,3028,0)=" ; Remove the Reactivation Date on HOSPITAL LOCATION & SDEC RESOURCE"
^XMB(3.9,146106,2,3029,0)="""RTN"",""SDES2DELCLNREADT"",40,0)"
