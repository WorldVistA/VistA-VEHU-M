^XMB(3.9,146104,2,237,0)="""RTN"",""IBAMTC"",1,0)"
^XMB(3.9,146104,2,238,0)="IBAMTC ;ALB/CPM - MEANS TEST NIGHTLY COMPILATION JOB ; 07 Jun 2021  4:17 PM"
^XMB(3.9,146104,2,239,0)="""RTN"",""IBAMTC"",2,0)"
^XMB(3.9,146104,2,240,0)=" ;;2.0;INTEGRATED BILLING;**34,52,70,93,100,118,115,132,150,153,137,176,215,275,321,312,457,519,549,614,703,706,630,704,760**;21-MAR-94;Build 0"
^XMB(3.9,146104,2,241,0)="""RTN"",""IBAMTC"",3,0)"
^XMB(3.9,146104,2,242,0)=" ;;Per VA Directive 6402, this routine should not be modified."
^XMB(3.9,146104,2,243,0)="""RTN"",""IBAMTC"",4,0)"
^XMB(3.9,146104,2,244,0)=" ;"
^XMB(3.9,146104,2,245,0)="""RTN"",""IBAMTC"",5,0)"
^XMB(3.9,146104,2,246,0)="INIT ; Entry point - initialize variables and parameters"
^XMB(3.9,146104,2,247,0)="""RTN"",""IBAMTC"",6,0)"
^XMB(3.9,146104,2,248,0)=" ;"
^XMB(3.9,146104,2,249,0)="""RTN"",""IBAMTC"",7,0)"
^XMB(3.9,146104,2,250,0)=" N X1,X2  ; IB*2.0*760"
^XMB(3.9,146104,2,251,0)="""RTN"",""IBAMTC"",8,0)"
^XMB(3.9,146104,2,252,0)=" ;Set Nightly task flag for Billing Clock query"
^XMB(3.9,146104,2,253,0)="""RTN"",""IBAMTC"",9,0)"
^XMB(3.9,146104,2,254,0)=" N IBNGHTSK"
^XMB(3.9,146104,2,255,0)="""RTN"",""IBAMTC"",10,0)"
^XMB(3.9,146104,2,256,0)=" S IBNGHTSK=1"
^XMB(3.9,146104,2,257,0)="""RTN"",""IBAMTC"",11,0)"
^XMB(3.9,146104,2,258,0)=" D CANCEL($$FMADD^XLFDT(DT,-7),$$NOW^XLFDT(),1) ; cancel copays (covid relief)   IB*2.0*706"
^XMB(3.9,146104,2,259,0)="""RTN"",""IBAMTC"",12,0)"
^XMB(3.9,146104,2,260,0)=" S (IBY,Y)=1 D SITE^IBAUTL I Y<1 S IBY=Y D ERR G CLEAN  ; moved from below  IB*2.0*760"
^XMB(3.9,146104,2,261,0)="""RTN"",""IBAMTC"",13,0)"
^XMB(3.9,146104,2,262,0)=" D CANCCD ; cancel copays (Cleland-Dole)  IB*2.0*760"
^XMB(3.9,146104,2,263,0)="""RTN"",""IBAMTC"",14,0)"
^XMB(3.9,146104,2,264,0)=" ;"
^XMB(3.9,146104,2,265,0)="""RTN"",""IBAMTC"",15,0)"
^XMB(3.9,146104,2,266,0)=" D UPDT^IBARXEPS($$FMADD^XLFDT(DT,-30),DT,1)"
^XMB(3.9,146104,2,267,0)="""RTN"",""IBAMTC"",16,0)"
^XMB(3.9,146104,2,268,0)=" ;"
^XMB(3.9,146104,2,269,0)="""RTN"",""IBAMTC"",17,0)"
^XMB(3.9,146104,2,270,0)=" D NIGHTLY^IBTRKR ; claims tracking nightly update"
^XMB(3.9,146104,2,271,0)="""RTN"",""IBAMTC"",18,0)"
^XMB(3.9,146104,2,272,0)=" ;"
^XMB(3.9,146104,2,273,0)="""RTN"",""IBAMTC"",19,0)"
^XMB(3.9,146104,2,274,0)=" D ^IBCD ; automated biller"
^XMB(3.9,146104,2,275,0)="""RTN"",""IBAMTC"",20,0)"
^XMB(3.9,146104,2,276,0)=" ;"
^XMB(3.9,146104,2,277,0)="""RTN"",""IBAMTC"",21,0)"
^XMB(3.9,146104,2,278,0)=" D RELPR^IBAMTV3 ; auto-release patient charges on hold at least 60 days"
^XMB(3.9,146104,2,279,0)="""RTN"",""IBAMTC"",22,0)"
^XMB(3.9,146104,2,280,0)=" ;"
^XMB(3.9,146104,2,281,0)="""RTN"",""IBAMTC"",23,0)"
^XMB(3.9,146104,2,282,0)=" D EN^IBOHRL ; auto-release patient charges on hold longer than 90 days"
^XMB(3.9,146104,2,283,0)="""RTN"",""IBAMTC"",24,0)"
^XMB(3.9,146104,2,284,0)=" ;"
^XMB(3.9,146104,2,285,0)="""RTN"",""IBAMTC"",25,0)"
^XMB(3.9,146104,2,286,0)=" K IBDT D BJ^IBJDE  ; Automated DM extract monthly background job."
^XMB(3.9,146104,2,287,0)="""RTN"",""IBAMTC"",26,0)"
^XMB(3.9,146104,2,288,0)=" ;"
^XMB(3.9,146104,2,289,0)="""RTN"",""IBAMTC"",27,0)"
^XMB(3.9,146104,2,290,0)=" ; - transfer pricing background job"
^XMB(3.9,146104,2,291,0)="""RTN"",""IBAMTC"",28,0)"
^XMB(3.9,146104,2,292,0)=" I '+$$SWSTAT^IBBAPI() D ^IBATEI1                           ;IB*2.0*312"
^XMB(3.9,146104,2,293,0)="""RTN"",""IBAMTC"",29,0)"
^XMB(3.9,146104,2,294,0)=" ;"
^XMB(3.9,146104,2,295,0)="""RTN"",""IBAMTC"",30,0)"
^XMB(3.9,146104,2,296,0)=" D NIGHT^IBARXMA ; transmit copay cap info"
^XMB(3.9,146104,2,297,0)="""RTN"",""IBAMTC"",31,0)"
^XMB(3.9,146104,2,298,0)=" ;"
^XMB(3.9,146104,2,299,0)="""RTN"",""IBAMTC"",32,0)"
^XMB(3.9,146104,2,300,0)=" D NOW^%DTC S IBAFY=$$FY^IBOUTL(X),DT=X,U=""^"""
^XMB(3.9,146104,2,301,0)="""RTN"",""IBAMTC"",33,0)"
^XMB(3.9,146104,2,302,0)=" S (IBERRN,IBWHER,IBJOB,IBY,Y)=1,IBCNT=0 K ^TMP($J,""IBAMTC"")"
^XMB(3.9,146104,2,303,0)="""RTN"",""IBAMTC"",34,0)"
^XMB(3.9,146104,2,304,0)=" D SERV^IBAUTL2 I IBY<1 D ERR G CLEAN"
^XMB(3.9,146104,2,305,0)="""RTN"",""IBAMTC"",35,0)"
^XMB(3.9,146104,2,306,0)=" ;"
^XMB(3.9,146104,2,307,0)="""RTN"",""IBAMTC"",36,0)"
^XMB(3.9,146104,2,308,0)=" ; Compile Means Test copay and per diem charges for all inpatients"
^XMB(3.9,146104,2,309,0)="""RTN"",""IBAMTC"",37,0)"
^XMB(3.9,146104,2,310,0)=" ; Check PFSS Switch                                        ;IB*2.0*312"
^XMB(3.9,146104,2,311,0)="""RTN"",""IBAMTC"",38,0)"
^XMB(3.9,146104,2,312,0)=" ; IB*2.0*549 Remove naked global"
^XMB(3.9,146104,2,313,0)="""RTN"",""IBAMTC"",39,0)"
^XMB(3.9,146104,2,314,0)=" I '+$$SWSTAT^IBBAPI() S (IBWARD,DFN)="""" F  S IBWARD=$O(^DPT(""CN"",IBWARD)) Q:IBWARD=""""  F  S DFN=$O(^DPT(""CN"",IBWARD,DFN)) Q:'DFN  W !,DFN S IBA=^DPT(""CN"",IBWARD,DFN),IBY=1 D PROC"
^XMB(3.9,146104,2,315,0)="""RTN"",""IBAMTC"",40,0)"
^XMB(3.9,146104,2,316,0)=" ;"
^XMB(3.9,146104,2,317,0)="""RTN"",""IBAMTC"",41,0)"
^XMB(3.9,146104,2,318,0)=" ;send inpatients' CV (CombatVet) expiration e-mail alert"
^XMB(3.9,146104,2,319,0)="""RTN"",""IBAMTC"",42,0)"
^XMB(3.9,146104,2,320,0)=" D CVEXMAIL^IBACV(DT)"
^XMB(3.9,146104,2,321,0)="""RTN"",""IBAMTC"",43,0)"
^XMB(3.9,146104,2,322,0)=" ;"
^XMB(3.9,146104,2,323,0)="""RTN"",""IBAMTC"",44,0)"
^XMB(3.9,146104,2,324,0)=" ;check & start LTC Monthly Job if necessary"
^XMB(3.9,146104,2,325,0)="""RTN"",""IBAMTC"",45,0)"
^XMB(3.9,146104,2,326,0)=" ; This code may need to be expanded, IF we don't          ;IB*2.0*312 "
^XMB(3.9,146104,2,327,0)="""RTN"",""IBAMTC"",46,0)"
^XMB(3.9,146104,2,328,0)=" ; implement on the 1st of the month, for a clean cut over ;IB*2.0*312"
^XMB(3.9,146104,2,329,0)="""RTN"",""IBAMTC"",47,0)"
^XMB(3.9,146104,2,330,0)=" I '+$$SWSTAT^IBBAPI() D NJ^IBAECN1                        ;IB*2.0*312"
^XMB(3.9,146104,2,331,0)="""RTN"",""IBAMTC"",48,0)"
^XMB(3.9,146104,2,332,0)=" ;"
^XMB(3.9,146104,2,333,0)="""RTN"",""IBAMTC"",49,0)"
^XMB(3.9,146104,2,334,0)=" ;Run a nightly process to see if a Patient had the CAT I HRfS flag activated/de-activated during the past two days."
^XMB(3.9,146104,2,335,0)="""RTN"",""IBAMTC"",50,0)"
^XMB(3.9,146104,2,336,0)=" ; If so generate a bulletin to IB MEANS TEST mailgroup"
^XMB(3.9,146104,2,337,0)="""RTN"",""IBAMTC"",51,0)"
^XMB(3.9,146104,2,338,0)=" D NIGHTLY^IBAMTS3                                                    ;IB*2.0*614"
^XMB(3.9,146104,2,339,0)="""RTN"",""IBAMTC"",52,0)"
^XMB(3.9,146104,2,340,0)=" ;"
^XMB(3.9,146104,2,341,0)="""RTN"",""IBAMTC"",53,0)"
^XMB(3.9,146104,2,342,0)=" D EN^IBCE ; Transmit electronic bills"
^XMB(3.9,146104,2,343,0)="""RTN"",""IBAMTC"",54,0)"
^XMB(3.9,146104,2,344,0)=" ; Clean up expired Means Test billing clocks"
^XMB(3.9,146104,2,345,0)="""RTN"",""IBAMTC"",55,0)"
^XMB(3.9,146104,2,346,0)="CLEAN S %H=+$H-1 D YMD^%DTC S IBDT=X,(IBN,DFN)=0,IBWHER=23"
^XMB(3.9,146104,2,347,0)="""RTN"",""IBAMTC"",56,0)"
^XMB(3.9,146104,2,348,0)=" F  S DFN=$O(^IBE(351,""ACT"",DFN)) Q:'DFN  D"
^XMB(3.9,146104,2,349,0)="""RTN"",""IBAMTC"",57,0)"
^XMB(3.9,146104,2,350,0)=" . F  S IBN=$O(^IBE(351,""ACT"",DFN,IBN)) Q:'IBN  D"
^XMB(3.9,146104,2,351,0)="""RTN"",""IBAMTC"",58,0)"
^XMB(3.9,146104,2,352,0)=" ..  S IBY=1,X1=IBDT,(X2,IBCLDT)=+$P($G(^IBE(351,+IBN,0)),""^"",3) D ^%DTC"
^XMB(3.9,146104,2,353,0)="""RTN"",""IBAMTC"",59,0)"
^XMB(3.9,146104,2,354,0)=" ..  I X>364 S IBCLDA=IBN D CLOCKCL^IBAUTL3,ERR:IBY<1"
^XMB(3.9,146104,2,355,0)="""RTN"",""IBAMTC"",60,0)"
^XMB(3.9,146104,2,356,0)=" ;"
^XMB(3.9,146104,2,357,0)="""RTN"",""IBAMTC"",61,0)"
^XMB(3.9,146104,2,358,0)=" ; Close out incomplete events where the patient has been discharged,"
^XMB(3.9,146104,2,359,0)="""RTN"",""IBAMTC"",62,0)"
^XMB(3.9,146104,2,360,0)=" ; pass the related charges if they appear correct, and send a bulletin"
^XMB(3.9,146104,2,361,0)="""RTN"",""IBAMTC"",63,0)"
^XMB(3.9,146104,2,362,0)=" ; - also, send bulletins on old incomplete charges where there is no"
^XMB(3.9,146104,2,363,0)="""RTN"",""IBAMTC"",64,0)"
^XMB(3.9,146104,2,364,0)=" ; incomplete event"
^XMB(3.9,146104,2,365,0)="""RTN"",""IBAMTC"",65,0)"
^XMB(3.9,146104,2,366,0)=" D MAIN^IBAMTC2"
^XMB(3.9,146104,2,367,0)="""RTN"",""IBAMTC"",66,0)"
^XMB(3.9,146104,2,368,0)=" ;"
^XMB(3.9,146104,2,369,0)="""RTN"",""IBAMTC"",67,0)"
^XMB(3.9,146104,2,370,0)=" ;D ^IBAMTC1"
^XMB(3.9,146104,2,371,0)="""RTN"",""IBAMTC"",68,0)"
^XMB(3.9,146104,2,372,0)=" ;"
^XMB(3.9,146104,2,373,0)="""RTN"",""IBAMTC"",69,0)"
^XMB(3.9,146104,2,374,0)=" ; Send bulletin reporting job completion"
^XMB(3.9,146104,2,375,0)="""RTN"",""IBAMTC"",70,0)"
^XMB(3.9,146104,2,376,0)=" I '+$$SWSTAT^IBBAPI() D BULL^IBAMTC1                     ;IB*2.0*312"
^XMB(3.9,146104,2,377,0)="""RTN"",""IBAMTC"",71,0)"
^XMB(3.9,146104,2,378,0)=" ;"
^XMB(3.9,146104,2,379,0)="""RTN"",""IBAMTC"",72,0)"
^XMB(3.9,146104,2,380,0)=" ; -- purge alerts"
^XMB(3.9,146104,2,381,0)="""RTN"",""IBAMTC"",73,0)"
^XMB(3.9,146104,2,382,0)=" D PURGE^IBAERR3"
^XMB(3.9,146104,2,383,0)="""RTN"",""IBAMTC"",74,0)"
^XMB(3.9,146104,2,384,0)=" ;"
^XMB(3.9,146104,2,385,0)="""RTN"",""IBAMTC"",75,0)"
^XMB(3.9,146104,2,386,0)=" ; purge HPID files -- IB*2.0*519"
