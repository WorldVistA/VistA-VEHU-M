^XMB(3.9,146056,2,1429,0)="""RTN"",""VPREVNT"",88,0)"
^XMB(3.9,146056,2,1430,0)=" I $G(VPRSQ) D SAVST^VPRENC(VPRSQ)"
^XMB(3.9,146056,2,1431,0)="""RTN"",""VPREVNT"",89,0)"
^XMB(3.9,146056,2,1432,0)=" Q"
^XMB(3.9,146056,2,1433,0)="""RTN"",""VPREVNT"",90,0)"
^XMB(3.9,146056,2,1434,0)=" ;"
^XMB(3.9,146056,2,1435,0)="""RTN"",""VPREVNT"",91,0)"
^XMB(3.9,146056,2,1436,0)="DGS ; -- DG SA FILE ENTRY NOTIFIER protocol listener"
^XMB(3.9,146056,2,1437,0)="""RTN"",""VPREVNT"",92,0)"
^XMB(3.9,146056,2,1438,0)=" N IEN,DFN,ACT S ACT="""""
^XMB(3.9,146056,2,1439,0)="""RTN"",""VPREVNT"",93,0)"
^XMB(3.9,146056,2,1440,0)=" S IEN=+$G(^TMP(""DG SA FILE ENTRY NOTIFIER"",$J,""IEN"")) Q:IEN<1"
^XMB(3.9,146056,2,1441,0)="""RTN"",""VPREVNT"",94,0)"
^XMB(3.9,146056,2,1442,0)=" S DFN=+$G(^TMP(""DG SA FILE ENTRY NOTIFIER"",$J,""DFN"",""CURRENT""))"
^XMB(3.9,146056,2,1443,0)="""RTN"",""VPREVNT"",95,0)"
^XMB(3.9,146056,2,1444,0)=" I DFN<1 S DFN=+$G(^TMP(""DG SA FILE ENTRY NOTIFIER"",$J,""DFN"",""OLD"")) Q:DFN<1"
^XMB(3.9,146056,2,1445,0)="""RTN"",""VPREVNT"",96,0)"
^XMB(3.9,146056,2,1446,0)=" ;I $G(^TMP(""DG SA FILE ENTRY NOTIFIER"",$J,""ACTION""))=""DELETED"" S ACT=""@"""
^XMB(3.9,146056,2,1447,0)="""RTN"",""VPREVNT"",97,0)"
^XMB(3.9,146056,2,1448,0)=" ;I $G(^TMP(""DG SA FILE ENTRY NOTIFIER"",$J,""ACTION""))=""MODIFIED"",$P($G(^DGS(41.1,IEN,0)),U,13) S ACT=""@"""
^XMB(3.9,146056,2,1449,0)="""RTN"",""VPREVNT"",98,0)"
^XMB(3.9,146056,2,1450,0)=" D POST^VPRHS(DFN,""Appointment"",IEN_"";41.1"",ACT)"
^XMB(3.9,146056,2,1451,0)="""RTN"",""VPREVNT"",99,0)"
^XMB(3.9,146056,2,1452,0)=" Q"
^XMB(3.9,146056,2,1453,0)="""RTN"",""VPREVNT"",100,0)"
^XMB(3.9,146056,2,1454,0)=" ;"
^XMB(3.9,146056,2,1455,0)="""RTN"",""VPREVNT"",101,0)"
^XMB(3.9,146056,2,1456,0)="SDAM ; -- SDAM APPOINTMENT EVENTS protocol listener"
^XMB(3.9,146056,2,1457,0)="""RTN"",""VPREVNT"",102,0)"
^XMB(3.9,146056,2,1458,0)=" ;    [expects variables SDATA, SDAMEVT]"
^XMB(3.9,146056,2,1459,0)="""RTN"",""VPREVNT"",103,0)"
