^XMB(3.9,146056,2,1495,0)="""RTN"",""VPREVNT"",121,0)"
^XMB(3.9,146056,2,1496,0)=" N ACT S ACT=$S($P($G(^GMR(120.86,DFN,0)),U,2):""@"",1:"""")"
^XMB(3.9,146056,2,1497,0)="""RTN"",""VPREVNT"",122,0)"
^XMB(3.9,146056,2,1498,0)=" D POST^VPRHS(DFN,""Allergy"",DFN_"";120.86"",ACT)"
^XMB(3.9,146056,2,1499,0)="""RTN"",""VPREVNT"",123,0)"
^XMB(3.9,146056,2,1500,0)=" Q"
^XMB(3.9,146056,2,1501,0)="""RTN"",""VPREVNT"",124,0)"
^XMB(3.9,146056,2,1502,0)=" ;"
^XMB(3.9,146056,2,1503,0)="""RTN"",""VPREVNT"",125,0)"
^XMB(3.9,146056,2,1504,0)="GMPL(DFN,IEN) ; -- GMPL EVENT protocol listener"
^XMB(3.9,146056,2,1505,0)="""RTN"",""VPREVNT"",126,0)"
^XMB(3.9,146056,2,1506,0)=" S DFN=+$G(DFN),IEN=+$G(IEN)"
^XMB(3.9,146056,2,1507,0)="""RTN"",""VPREVNT"",127,0)"
^XMB(3.9,146056,2,1508,0)=" N ACT S ACT=$S($P($G(^AUPNPROB(IEN,1)),U,2)=""H"":""@"",1:"""")"
^XMB(3.9,146056,2,1509,0)="""RTN"",""VPREVNT"",128,0)"
^XMB(3.9,146056,2,1510,0)=" D POST^VPRHS(DFN,""Problem"",IEN_"";9000011"",ACT)"
