^XMB(3.9,146087,2,3465,0)="""RTN"",""YTQRQAD4"",219,0)"
^XMB(3.9,146087,2,3466,0)=" ....Q:$D(MHADLST(""patient"",ADMINID))  ;If part of PE Assignment, PE trumps SE - Legacy MHA flow."
^XMB(3.9,146087,2,3467,0)="""RTN"",""YTQRQAD4"",220,0)"
