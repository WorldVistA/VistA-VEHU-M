^XMB(3.9,146056,2,2556,0)=" ;"
^XMB(3.9,146056,2,2557,0)="""RTN"",""VPRSDAP"",138,0)"
^XMB(3.9,146056,2,2558,0)="DOSEFORM(IEN) ; -- return dose form"
^XMB(3.9,146056,2,2559,0)="""RTN"",""VPRSDAP"",139,0)"
^XMB(3.9,146056,2,2560,0)=" N Y S Y="""""
^XMB(3.9,146056,2,2561,0)="""RTN"",""VPRSDAP"",140,0)"
^XMB(3.9,146056,2,2562,0)=" I +$G(PSOI),'$D(^TMP(""VPRX"",$J,""PSOI"",PSOI)) D"
^XMB(3.9,146056,2,2563,0)="""RTN"",""VPRSDAP"",141,0)"
^XMB(3.9,146056,2,2564,0)=" . D ZERO^PSS50P7(PSOI,,,""PSOI"")"
^XMB(3.9,146056,2,2565,0)="""RTN"",""VPRSDAP"",142,0)"
^XMB(3.9,146056,2,2566,0)=" . M ^TMP(""VPRX"",$J,""PSOI"",PSOI)=^TMP($J,""PSOI"",PSOI)"
^XMB(3.9,146056,2,2567,0)="""RTN"",""VPRSDAP"",143,0)"
^XMB(3.9,146056,2,2568,0)=" . K ^TMP($J,""PSOI"",PSOI)"
^XMB(3.9,146056,2,2569,0)="""RTN"",""VPRSDAP"",144,0)"
^XMB(3.9,146056,2,2570,0)=" S Y=$G(^TMP(""VPRX"",$J,""PSOI"",+$G(PSOI),.02)) S:Y Y=Y_""^VA50.606"""
