^XMB(3.9,146106,2,2934,0)=" I $$FMDIFF^XLFDT($G(APPOINTMENT(""END DATE TIME"")),$G(APPOINTMENT(""START DATE TIME"")),2)/60'=$G(APPOINTMENT(""APPOINTMENT LENGTH"")) D ERRLOG^SDESJSON(.ERRORS,116)"
