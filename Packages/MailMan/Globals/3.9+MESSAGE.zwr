^XMB(3.9,146037,2,319,0)="""RTN"",""RCDPEM"")"
^XMB(3.9,146037,2,320,0)="0^4^B78149188"
^XMB(3.9,146037,2,321,0)="""RTN"",""RCDPEM"",1,0)"
^XMB(3.9,146037,2,322,0)="RCDPEM ;ALB/TMK/PJH - POST EFT, ERA MATCHING TO EFT ;Jun 06, 2014@19:11:19"
^XMB(3.9,146037,2,323,0)="""RTN"",""RCDPEM"",2,0)"
^XMB(3.9,146037,2,324,0)=" ;;4.5;Accounts Receivable;**173,255,269,276,283,298,304,318,321,326,345,349,424**;Mar 20, 1995;Build 0"
^XMB(3.9,146037,2,325,0)="""RTN"",""RCDPEM"",3,0)"
^XMB(3.9,146037,2,326,0)=" ;Per VA Directive 6402, this routine should not be modified."
^XMB(3.9,146037,2,327,0)="""RTN"",""RCDPEM"",4,0)"
^XMB(3.9,146037,2,328,0)=" ; IA 4050 covers call to SPL1^IBCEOBAR"
^XMB(3.9,146037,2,329,0)="""RTN"",""RCDPEM"",5,0)"
^XMB(3.9,146037,2,330,0)=" ; Note - keep processing in line with RCDPXPAP"
^XMB(3.9,146037,2,331,0)="""RTN"",""RCDPEM"",6,0)"
^XMB(3.9,146037,2,332,0)=" ;"
^XMB(3.9,146037,2,333,0)="""RTN"",""RCDPEM"",7,0)"
^XMB(3.9,146037,2,334,0)="EN ; Post EFT deposits, auto-match EFT's and ERA's "
^XMB(3.9,146037,2,335,0)="""RTN"",""RCDPEM"",8,0)"
^XMB(3.9,146037,2,336,0)=" ;"
^XMB(3.9,146037,2,337,0)="""RTN"",""RCDPEM"",9,0)"
^XMB(3.9,146037,2,338,0)=" K ^TMP($J,""RCDPETOT""),^TMP(""RCDPEAP"",$J)"
^XMB(3.9,146037,2,339,0)="""RTN"",""RCDPEM"",10,0)"
^XMB(3.9,146037,2,340,0)=" ; ^TMP($J,""RCDPETOT"",344.3 or 344.31,file ien)="
^XMB(3.9,146037,2,341,0)="""RTN"",""RCDPEM"",11,0)"
^XMB(3.9,146037,2,342,0)=" ;  (1) match (0/1/-1)   (2) total $   (3) posted (0/1)  (4) error ref"
^XMB(3.9,146037,2,343,0)="""RTN"",""RCDPEM"",12,0)"
^XMB(3.9,146037,2,344,0)=" ;  (5) EFT deposit ien 344.1 if added for EFT"
^XMB(3.9,146037,2,345,0)="""RTN"",""RCDPEM"",13,0)"
^XMB(3.9,146037,2,346,0)=" ;"
^XMB(3.9,146037,2,347,0)="""RTN"",""RCDPEM"",14,0)"
^XMB(3.9,146037,2,348,0)=" N RCZ,RCSUM,RCDEP,RECTDA,RC0,RCER,RCDUZ,Z,Z0,Z1,DA,X,Y,DIE,DR"
^XMB(3.9,146037,2,349,0)="""RTN"",""RCDPEM"",15,0)"
^XMB(3.9,146037,2,350,0)=" M RCDUZ=DUZ"
^XMB(3.9,146037,2,351,0)="""RTN"",""RCDPEM"",16,0)"
^XMB(3.9,146037,2,352,0)=" N DUZ S DUZ=+$O(^VA(200,""B"",""EDILOCKBOX,AUTOMATIC"",0)),DUZ(0)="""",DUZ(2)=$G(RCDUZ(2)) S:'DUZ DUZ=.5"
^XMB(3.9,146037,2,353,0)="""RTN"",""RCDPEM"",17,0)"
^XMB(3.9,146037,2,354,0)=" K ^TMP($J,""RCXM""),^TMP($J,""RCTOT"")"
^XMB(3.9,146037,2,355,0)="""RTN"",""RCDPEM"",18,0)"
^XMB(3.9,146037,2,356,0)=" S ZTREQ=""@"""
^XMB(3.9,146037,2,357,0)="""RTN"",""RCDPEM"",19,0)"
^XMB(3.9,146037,2,358,0)=" L +^RCY(344.3,""ALOCK""):5 I '$T D  G ENQ ; Lock record"
^XMB(3.9,146037,2,359,0)="""RTN"",""RCDPEM"",20,0)"
^XMB(3.9,146037,2,360,0)=" . ; Send bulletin that job could not be run"
^XMB(3.9,146037,2,361,0)="""RTN"",""RCDPEM"",21,0)"
^XMB(3.9,146037,2,362,0)=" . S ^TMP($J,""RCXM"",1)=""The nightly job to post EFT deposits and match EFTs to ERAs could not be run"",^TMP($J,""RCXM"",2)=""Another match process was already running (lock on ^RCY(344.3,""""ALOCK"""") )"""
^XMB(3.9,146037,2,363,0)="""RTN"",""RCDPEM"",22,0)"
^XMB(3.9,146037,2,364,0)=" . D SENDBULL^RCDPEM1"
^XMB(3.9,146037,2,365,0)="""RTN"",""RCDPEM"",23,0)"
^XMB(3.9,146037,2,366,0)=" ;"
^XMB(3.9,146037,2,367,0)="""RTN"",""RCDPEM"",24,0)"
^XMB(3.9,146037,2,368,0)=" ; Post deposits for any unposted EFTs in file 344.3"
^XMB(3.9,146037,2,369,0)="""RTN"",""RCDPEM"",25,0)"
^XMB(3.9,146037,2,370,0)=" ; 'Unposted' EFTs have a 0 in AMOUNT POSTED field"
^XMB(3.9,146037,2,371,0)="""RTN"",""RCDPEM"",26,0)"
^XMB(3.9,146037,2,372,0)=" S ^TMP($J,""RCTOT"",""EFT_DEP"")=0"
^XMB(3.9,146037,2,373,0)="""RTN"",""RCDPEM"",27,0)"
^XMB(3.9,146037,2,374,0)=" S RCZ=0 F  S RCZ=$O(^RCY(344.3,""APOST"",0,RCZ)) Q:'RCZ  S RC0=$G(^RCY(344.3,RCZ,0))  I RC0'="""",$P(RC0,U,8) D"
^XMB(3.9,146037,2,375,0)="""RTN"",""RCDPEM"",28,0)"
^XMB(3.9,146037,2,376,0)=" . S ^TMP($J,""RCTOT"",""EFT_DEP"")=^TMP($J,""RCTOT"",""EFT_DEP"")+1"
^XMB(3.9,146037,2,377,0)="""RTN"",""RCDPEM"",29,0)"
^XMB(3.9,146037,2,378,0)=" . ; Verify check sums"
^XMB(3.9,146037,2,379,0)="""RTN"",""RCDPEM"",30,0)"
^XMB(3.9,146037,2,380,0)=" . S RCSUM=$$CHKSUM^RCDPESR3(RCZ)"
^XMB(3.9,146037,2,381,0)="""RTN"",""RCDPEM"",31,0)"
^XMB(3.9,146037,2,382,0)=" . I RCSUM'=$P(RC0,U,9) D  Q"
^XMB(3.9,146037,2,383,0)="""RTN"",""RCDPEM"",32,0)"
^XMB(3.9,146037,2,384,0)=" .. ; Bulletin that check sums do not match"
^XMB(3.9,146037,2,385,0)="""RTN"",""RCDPEM"",33,0)"
^XMB(3.9,146037,2,386,0)=" .. ; Update record error list and checksum error field"
^XMB(3.9,146037,2,387,0)="""RTN"",""RCDPEM"",34,0)"
^XMB(3.9,146037,2,388,0)=" .. S RCER(1)=$$SETERR^RCDPEM0(2)"
^XMB(3.9,146037,2,389,0)="""RTN"",""RCDPEM"",35,0)"
^XMB(3.9,146037,2,390,0)=" .. S RCER(2)=""  Checksum is invalid and the EFT deposit record is corrupted."",RCER(3)=""  Stored Checksum = ""_$P(RC0,U,9)_"" Calculated Checksum: ""_RCSUM,RCER(4)=""  This EFT deposit cannot be sent to FMS.  You must ask for it to be"""
^XMB(3.9,146037,2,391,0)="""RTN"",""RCDPEM"",36,0)"
^XMB(3.9,146037,2,392,0)=" .. S RCER(5)=""   retransmitted to your site."""
^XMB(3.9,146037,2,393,0)="""RTN"",""RCDPEM"",37,0)"
^XMB(3.9,146037,2,394,0)=" .. D BULL^RCDPEM1(344.3,RC0,.RCER)"
^XMB(3.9,146037,2,395,0)="""RTN"",""RCDPEM"",38,0)"
^XMB(3.9,146037,2,396,0)=" .. S $P(^TMP($J,""RCDPETOT"",344.3,RCZ),U,4)=+$G(^TMP($J,""RCXM"",0))"
^XMB(3.9,146037,2,397,0)="""RTN"",""RCDPEM"",39,0)"
^XMB(3.9,146037,2,398,0)=" .. D STORERR^RCDPEM0(344.3,RCZ,.RCER) ; PRCA*4.5*424. Old bug. Add file to parameter list."
^XMB(3.9,146037,2,399,0)="""RTN"",""RCDPEM"",40,0)"
^XMB(3.9,146037,2,400,0)=" .. S DIE=""^RCY(344.3,"",DA=RCZ,DR="".1////1"" D ^DIE"
^XMB(3.9,146037,2,401,0)="""RTN"",""RCDPEM"",41,0)"
^XMB(3.9,146037,2,402,0)=" .. S ^TMP($J,""RCTOT"",""CSUM"")=$G(^TMP($J,""RCTOT"",""CSUM""))+1"
^XMB(3.9,146037,2,403,0)="""RTN"",""RCDPEM"",42,0)"
^XMB(3.9,146037,2,404,0)=" . ;"
^XMB(3.9,146037,2,405,0)="""RTN"",""RCDPEM"",43,0)"
^XMB(3.9,146037,2,406,0)=" . S RCDEP=+$P(RC0,U,3),RECTDA=+$O(^RCY(344,""AD"",RCDEP,0))"
^XMB(3.9,146037,2,407,0)="""RTN"",""RCDPEM"",44,0)"
^XMB(3.9,146037,2,408,0)=" . I RCDEP D LOCKDEP(RCDEP,1)"
^XMB(3.9,146037,2,409,0)="""RTN"",""RCDPEM"",45,0)"
^XMB(3.9,146037,2,410,0)=" . I 'RCDEP!'RECTDA D  ;  Add deposit and/or receipt to files 344.1, 344"
^XMB(3.9,146037,2,411,0)="""RTN"",""RCDPEM"",46,0)"
^XMB(3.9,146037,2,412,0)=" .. I 'RCDEP D  ; Add dep record RCDEP, update field .03 with the pointer"
^XMB(3.9,146037,2,413,0)="""RTN"",""RCDPEM"",47,0)"
^XMB(3.9,146037,2,414,0)=" ... S RCDEP=+$$ADDDEP^RCDPEM0($P(RC0,U,6),$P(RC0,U,7),RCZ)"
^XMB(3.9,146037,2,415,0)="""RTN"",""RCDPEM"",48,0)"
^XMB(3.9,146037,2,416,0)=" ... S ^TMP($J,""RCTOT"",""DEPOSIT"")=$G(^TMP($J,""RCTOT"",""DEPOSIT""))+1"
^XMB(3.9,146037,2,417,0)="""RTN"",""RCDPEM"",49,0)"
^XMB(3.9,146037,2,418,0)=" .. ;"
^XMB(3.9,146037,2,419,0)="""RTN"",""RCDPEM"",50,0)"
^XMB(3.9,146037,2,420,0)=" .. I 'RECTDA,RCDEP D  ; Add receipt record, post to rev source cd 8NZZ"
^XMB(3.9,146037,2,421,0)="""RTN"",""RCDPEM"",51,0)"
^XMB(3.9,146037,2,422,0)=" ... S RECTDA=+$$ADDREC^RCDPEM0(RCDEP,RCZ)"
^XMB(3.9,146037,2,423,0)="""RTN"",""RCDPEM"",52,0)"
^XMB(3.9,146037,2,424,0)=" .. ;"
^XMB(3.9,146037,2,425,0)="""RTN"",""RCDPEM"",53,0)"
^XMB(3.9,146037,2,426,0)=" . I RCDEP D LOCKDEP(RCDEP,0)"
^XMB(3.9,146037,2,427,0)="""RTN"",""RCDPEM"",54,0)"
^XMB(3.9,146037,2,428,0)=" . ;"
^XMB(3.9,146037,2,429,0)="""RTN"",""RCDPEM"",55,0)"
^XMB(3.9,146037,2,430,0)=" . I 'RCDEP!'RECTDA D  Q  ; Could not add entry to file 344.1 or 344 "
^XMB(3.9,146037,2,431,0)="""RTN"",""RCDPEM"",56,0)"
^XMB(3.9,146037,2,432,0)=" .. ; Send a bulletin, update error text"
^XMB(3.9,146037,2,433,0)="""RTN"",""RCDPEM"",57,0)"
^XMB(3.9,146037,2,434,0)=" .. S RCER(1)=$$SETERR^RCDPEM0(2),RCER(2)=""  ""_$S('RCDEP:""Neither a deposit nor a receipt were able"",1:""A receipt was not able"")_"" to be added - no match attempted"""
^XMB(3.9,146037,2,435,0)="""RTN"",""RCDPEM"",58,0)"
^XMB(3.9,146037,2,436,0)=" .. I RCDEP,'RECTDA S RCER(3)=""  Deposit Ticket # created: ""_$P($G(^RCY(344.1,+$P(RC0,U,3),0)),U)"
^XMB(3.9,146037,2,437,0)="""RTN"",""RCDPEM"",59,0)"
^XMB(3.9,146037,2,438,0)=" .. S RCER($O(RCER(""""),-1)+1)=""This EFT deposit can't be sent to FMS.  You must ask Austin to retransmit"""
^XMB(3.9,146037,2,439,0)="""RTN"",""RCDPEM"",60,0)"
^XMB(3.9,146037,2,440,0)=" .. D BULL^RCDPEM1(344.3,RC0,.RCER)"
^XMB(3.9,146037,2,441,0)="""RTN"",""RCDPEM"",61,0)"
^XMB(3.9,146037,2,442,0)=" .. S $P(^TMP($J,""RCDPETOT"",344.3,RCZ),U,4)=+$G(^TMP($J,""RCXM"",0))"
^XMB(3.9,146037,2,443,0)="""RTN"",""RCDPEM"",62,0)"
^XMB(3.9,146037,2,444,0)=" .. D STORERR^RCDPEM0(344.3,RCZ,.RCER) ; PRCA*4.5*424.Old bug. Added file to parameter list"
^XMB(3.9,146037,2,445,0)="""RTN"",""RCDPEM"",63,0)"
^XMB(3.9,146037,2,446,0)=" .. S ^TMP($J,""RCTOT"",""ERR"")=$G(^TMP($J,""RCTOT"",""ERR""))+1"
^XMB(3.9,146037,2,447,0)="""RTN"",""RCDPEM"",64,0)"
^XMB(3.9,146037,2,448,0)=" . ;"
^XMB(3.9,146037,2,449,0)="""RTN"",""RCDPEM"",65,0)"
^XMB(3.9,146037,2,450,0)=" . S DIE=""^RCY(344.31,"" S Z=0 F  S Z=$O(^RCY(344.31,""B"",RCZ,Z)) Q:'Z  S DA=Z,DR="".11////1"" D ^DIE"
