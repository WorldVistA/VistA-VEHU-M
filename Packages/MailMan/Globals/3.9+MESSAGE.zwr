^XMB(3.9,146052,2,1302,0)=" S VAR="""",PGM=""START^FBAAPCC"" D ZIS^FBAAUTL G:FBPOP Q"
^XMB(3.9,146052,2,1303,0)="""RTN"",""FBAAPCC"",5,0)"
^XMB(3.9,146052,2,1304,0)="START U IO S UL="""",FBAAOUT=0 W:$E(IOST,1,2)[""C-"" @IOF F A=1:1:80 S UL=UL_""="""
^XMB(3.9,146052,2,1305,0)="""RTN"",""FBAAPCC"",6,0)"
^XMB(3.9,146052,2,1306,0)=" D HED S J=0 F JJ=0:0 S J=$O(^FBAAA(""AE"",J)) Q:J=""""!(FBAAOUT)  F DFN=0:0 S DFN=$O(^FBAAA(""AE"",J,DFN)) Q:DFN'>0!(FBAAOUT)  I $D(^FBAAA(DFN,4)) S Y(0)=^(4) D GOT"
^XMB(3.9,146052,2,1307,0)="""RTN"",""FBAAPCC"",7,0)"
^XMB(3.9,146052,2,1308,0)="Q W ! K A,J,DFN,UL,I,JJ,X,Y,FBAAOUT,FBDT,FBNM,FBSSN D CLOSE^FBAAUTL"
