^XMB(3.9,146047,2,1743,0)="""RTN"",""IBCNEHLM"",44,0)"
^XMB(3.9,146047,2,1744,0)="REG ;  Registration message for when a site installs"
^XMB(3.9,146047,2,1745,0)="""RTN"",""IBCNEHLM"",45,0)"
^XMB(3.9,146047,2,1746,0)=" ;"
^XMB(3.9,146047,2,1747,0)="""RTN"",""IBCNEHLM"",46,0)"
^XMB(3.9,146047,2,1748,0)=" ;/vd-IB*2.0*659 - Quit if VAMC Site is MANILA (#358) & EIV is disabled for MANILA."
^XMB(3.9,146047,2,1749,0)="""RTN"",""IBCNEHLM"",47,0)"
^XMB(3.9,146047,2,1750,0)=" I $P($$SITE^VASITE,U,3)=358,$$GET1^DIQ(350.9,""1,"",51.33,""I"")=""N"" Q"
^XMB(3.9,146047,2,1751,0)="""RTN"",""IBCNEHLM"",48,0)"
^XMB(3.9,146047,2,1752,0)=" ;"
^XMB(3.9,146047,2,1753,0)="""RTN"",""IBCNEHLM"",49,0)"
^XMB(3.9,146047,2,1754,0)=" N APP,CNTCEM,CNTCNM,CNTCPH,CODE,EDT,EVENT,FRSH,HL,HLCDOM,HLCINS,HLCS"
^XMB(3.9,146047,2,1755,0)="""RTN"",""IBCNEHLM"",50,0)"
^XMB(3.9,146047,2,1756,0)=" N HLCSTCP,HLECH,HLEID,HLFS,HLHDR,HLINST,HLIP,HLN,HLNHLQ,HLPROD,HLQ,HLREP"
^XMB(3.9,146047,2,1757,0)="""RTN"",""IBCNEHLM"",51,0)"
^XMB(3.9,146047,2,1758,0)=" N HLRESLT,HLSAN,HLTYPE,HLX,IBCNE,IBCNEDAT,IHLP,IHLS,IHLT,ID,INACT,IPA,IPP"
^XMB(3.9,146047,2,1759,0)="""RTN"",""IBCNEHLM"",52,0)"
^XMB(3.9,146047,2,1760,0)=" N MCT,MFE,MFN,MGRP,QFL,RESP,TAXID,ZMID,%I"
^XMB(3.9,146047,2,1761,0)="""RTN"",""IBCNEHLM"",53,0)"
^XMB(3.9,146047,2,1762,0)=" N IVER,RETRY,TIMOUT,VMFE         ; IB*2.0*506"
^XMB(3.9,146047,2,1763,0)="""RTN"",""IBCNEHLM"",54,0)"
^XMB(3.9,146047,2,1764,0)=" K ^TMP(""HLS"",$J) S MCT=0,QFL=0"
^XMB(3.9,146047,2,1765,0)="""RTN"",""IBCNEHLM"",55,0)"
^XMB(3.9,146047,2,1766,0)=" ;"
^XMB(3.9,146047,2,1767,0)="""RTN"",""IBCNEHLM"",56,0)"
^XMB(3.9,146047,2,1768,0)=" ;  Get data from IB Parameters File"
^XMB(3.9,146047,2,1769,0)="""RTN"",""IBCNEHLM"",57,0)"
^XMB(3.9,146047,2,1770,0)=" S TAXID=$TR($P($G(^IBE(350.9,1,1)),U,5),""-"",""""),CNTCPH="""",CNTCEM="""",CNTCNM="""""
^XMB(3.9,146047,2,1771,0)="""RTN"",""IBCNEHLM"",58,0)"
^XMB(3.9,146047,2,1772,0)=" S IBCNE=$G(^IBE(350.9,1,51))"
^XMB(3.9,146047,2,1773,0)="""RTN"",""IBCNEHLM"",59,0)"
^XMB(3.9,146047,2,1774,0)=" S FRSH=$P(IBCNE,U,1),TIMOUT=$P(IBCNE,U,5),RETRY=$P(IBCNE,U,26) ; IB*2.0*506"
^XMB(3.9,146047,2,1775,0)="""RTN"",""IBCNEHLM"",60,0)"
^XMB(3.9,146047,2,1776,0)=" S MGRP=$$MGRP^IBCNEUT5()"
^XMB(3.9,146047,2,1777,0)="""RTN"",""IBCNEHLM"",61,0)"
^XMB(3.9,146047,2,1778,0)=" S INACT=$E($$GET1^DIQ(350.9,""1,"",51.08,""E""))"
^XMB(3.9,146047,2,1779,0)="""RTN"",""IBCNEHLM"",62,0)"
^XMB(3.9,146047,2,1780,0)=" S IHLP=$P(IBCNE,U,13),IHLT=$P(IBCNE,U,14)"
^XMB(3.9,146047,2,1781,0)="""RTN"",""IBCNEHLM"",63,0)"
^XMB(3.9,146047,2,1782,0)=" S IHLS=$P(IBCNE,U,19)"
^XMB(3.9,146047,2,1783,0)="""RTN"",""IBCNEHLM"",64,0)"
^XMB(3.9,146047,2,1784,0)=" ;"
^XMB(3.9,146047,2,1785,0)="""RTN"",""IBCNEHLM"",65,0)"
^XMB(3.9,146047,2,1786,0)=" ; IB*2.0*184 version 1, initial release of IIV"
^XMB(3.9,146047,2,1787,0)="""RTN"",""IBCNEHLM"",66,0)"
^XMB(3.9,146047,2,1788,0)=" ; IB*2.0*549 Updated version to 7, Removed retrieval of Contact Name, Phone, email"
^XMB(3.9,146047,2,1789,0)="""RTN"",""IBCNEHLM"",67,0)"
^XMB(3.9,146047,2,1790,0)=" ; IB*2.0*601 Updated version to 8"
^XMB(3.9,146047,2,1791,0)="""RTN"",""IBCNEHLM"",68,0)"
^XMB(3.9,146047,2,1792,0)=" ; IB*2.0*621 Updated version to 9, EICD"
^XMB(3.9,146047,2,1793,0)="""RTN"",""IBCNEHLM"",69,0)"
^XMB(3.9,146047,2,1794,0)=" ; IB*2.0*631 Updated version to 10"
^XMB(3.9,146047,2,1795,0)="""RTN"",""IBCNEHLM"",70,0)"
^XMB(3.9,146047,2,1796,0)=" ; IB*2.0*659 Updated version to 11, Added Medicare Freshness Days to this registration msg"
^XMB(3.9,146047,2,1797,0)="""RTN"",""IBCNEHLM"",71,0)"
^XMB(3.9,146047,2,1798,0)=" ; IB*2.0*664 Now version 12, Stats going to FSC: auto update #s split (non-medicare vs medicare)"
^XMB(3.9,146047,2,1799,0)="""RTN"",""IBCNEHLM"",72,0)"
^XMB(3.9,146047,2,1800,0)=" ; IB*2.0*687 Now version 13, IIU Functionality Added."
^XMB(3.9,146047,2,1801,0)="""RTN"",""IBCNEHLM"",73,0)"
^XMB(3.9,146047,2,1802,0)=" ; IB*2.0*702 Now version 14, Added EICD & MBI stats (pieces 27-30)"
^XMB(3.9,146047,2,1803,0)="""RTN"",""IBCNEHLM"",74,0)"
^XMB(3.9,146047,2,1804,0)=" ; IB*2.0*732 Now version 15, Added ISBLUE indicator (365.12,.09) and NUMBER RETRIES (#350.9,51.06) to Table Updates"
^XMB(3.9,146047,2,1805,0)="""RTN"",""IBCNEHLM"",75,0)"
^XMB(3.9,146047,2,1806,0)=" ; IB*2.0*752 Now version 16, To allow FSC to send IN1 & GT1 data (including SUBSCRIBER ID, etc.)"
^XMB(3.9,146047,2,1807,0)="""RTN"",""IBCNEHLM"",76,0)"
^XMB(3.9,146047,2,1808,0)=" ;                            for a 271 w/ a AAA error. Also added FSC control of file numbers #365.022 - #365.046 "
^XMB(3.9,146047,2,1809,0)="""RTN"",""IBCNEHLM"",77,0)"
^XMB(3.9,146047,2,1810,0)=" ;                            (minus #365.030 & #365.040)"
^XMB(3.9,146047,2,1811,0)="""RTN"",""IBCNEHLM"",78,0)"
^XMB(3.9,146047,2,1812,0)=" ;"
^XMB(3.9,146047,2,1813,0)="""RTN"",""IBCNEHLM"",79,0)"
^XMB(3.9,146047,2,1814,0)=" S IVER=""16"""
^XMB(3.9,146047,2,1815,0)="""RTN"",""IBCNEHLM"",80,0)"
^XMB(3.9,146047,2,1816,0)=" I IHLP=""I"" S (IHLT,IHLS)="""""
^XMB(3.9,146047,2,1817,0)="""RTN"",""IBCNEHLM"",81,0)"
^XMB(3.9,146047,2,1818,0)=" ;"
^XMB(3.9,146047,2,1819,0)="""RTN"",""IBCNEHLM"",82,0)"
^XMB(3.9,146047,2,1820,0)=" I IHLP=""B"",IHLT=""""!(IHLS="""") D  S QFL=1"
^XMB(3.9,146047,2,1821,0)="""RTN"",""IBCNEHLM"",83,0)"
^XMB(3.9,146047,2,1822,0)=" . S MCT=MCT+1,MSG(MCT)=""The """"HL7 Response Processing Method"""" selected is Batch but the HL7 Batch """
^XMB(3.9,146047,2,1823,0)="""RTN"",""IBCNEHLM"",84,0)"
^XMB(3.9,146047,2,1824,0)=" . I IHLT="""",IHLS="""" S MSG(MCT)=MSG(MCT)_""Start and End Times are blank.  "" Q"
^XMB(3.9,146047,2,1825,0)="""RTN"",""IBCNEHLM"",85,0)"
^XMB(3.9,146047,2,1826,0)=" . S MSG(MCT)=MSG(MCT)_$S(IHLT="""":""Start"",1:""End"")_"" Time is blank.  """
^XMB(3.9,146047,2,1827,0)="""RTN"",""IBCNEHLM"",86,0)"
^XMB(3.9,146047,2,1828,0)=" ;"
^XMB(3.9,146047,2,1829,0)="""RTN"",""IBCNEHLM"",87,0)"
^XMB(3.9,146047,2,1830,0)=" I FRSH=""""!(INACT="""")!(IHLP="""") D"
^XMB(3.9,146047,2,1831,0)="""RTN"",""IBCNEHLM"",88,0)"
^XMB(3.9,146047,2,1832,0)=" . S MCT=MCT+1,MSG(MCT)=""The following eIV Site Parameters are not defined:  """
^XMB(3.9,146047,2,1833,0)="""RTN"",""IBCNEHLM"",89,0)"
^XMB(3.9,146047,2,1834,0)=" . I FRSH="""" S MCT=MCT+1,MSG(MCT)=""""""Days between electronic re-verification checks"""" is blank.  """
^XMB(3.9,146047,2,1835,0)="""RTN"",""IBCNEHLM"",90,0)"
^XMB(3.9,146047,2,1836,0)=" . I INACT="""" S MCT=MCT+1,MSG(MCT)=""""""Look at a patient's inactive insurance?"""" is blank.  """
^XMB(3.9,146047,2,1837,0)="""RTN"",""IBCNEHLM"",91,0)"
^XMB(3.9,146047,2,1838,0)=" . I IHLP="""" S MCT=MCT+1,MSG(MCT)=""""""HL7 Response Processing Method"""" is blank.  """
^XMB(3.9,146047,2,1839,0)="""RTN"",""IBCNEHLM"",92,0)"
^XMB(3.9,146047,2,1840,0)=" . Q"
^XMB(3.9,146047,2,1841,0)="""RTN"",""IBCNEHLM"",93,0)"
^XMB(3.9,146047,2,1842,0)=" ;"
^XMB(3.9,146047,2,1843,0)="""RTN"",""IBCNEHLM"",94,0)"
^XMB(3.9,146047,2,1844,0)=" I $O(MSG(""""))'="""" D MLMN"
^XMB(3.9,146047,2,1845,0)="""RTN"",""IBCNEHLM"",95,0)"
^XMB(3.9,146047,2,1846,0)=" I QFL=1 Q"
^XMB(3.9,146047,2,1847,0)="""RTN"",""IBCNEHLM"",96,0)"
^XMB(3.9,146047,2,1848,0)=" ;"
^XMB(3.9,146047,2,1849,0)="""RTN"",""IBCNEHLM"",97,0)"
^XMB(3.9,146047,2,1850,0)="HL ;  When a site installs, the enrollment should be an"
^XMB(3.9,146047,2,1851,0)="""RTN"",""IBCNEHLM"",98,0)"
^XMB(3.9,146047,2,1852,0)=" ;  ""MUP"" (update) record."
^XMB(3.9,146047,2,1853,0)="""RTN"",""IBCNEHLM"",99,0)"
^XMB(3.9,146047,2,1854,0)=" N DSTAT,DSTAT2,VNTE,VZRR                   ; IB*2.0*549 added DSTAT2"
^XMB(3.9,146047,2,1855,0)="""RTN"",""IBCNEHLM"",100,0)"
^XMB(3.9,146047,2,1856,0)=" S MFE(1)=""MUP"""
^XMB(3.9,146047,2,1857,0)="""RTN"",""IBCNEHLM"",101,0)"
^XMB(3.9,146047,2,1858,0)=" ;"
^XMB(3.9,146047,2,1859,0)="""RTN"",""IBCNEHLM"",102,0)"
^XMB(3.9,146047,2,1860,0)=" ;  Initialize the HL7"
^XMB(3.9,146047,2,1861,0)="""RTN"",""IBCNEHLM"",103,0)"
^XMB(3.9,146047,2,1862,0)=" D INIT^HLFNC2(""IBCNE IIV REGISTER"",.HL)"
^XMB(3.9,146047,2,1863,0)="""RTN"",""IBCNEHLM"",104,0)"
^XMB(3.9,146047,2,1864,0)=" S HLFS=HL(""FS""),HLECH=HL(""ECH""),HL(""SAF"")=$P($$SITE^VASITE,U,2,3),HLREP=$E(HL(""ECH""),2)"
^XMB(3.9,146047,2,1865,0)="""RTN"",""IBCNEHLM"",105,0)"
^XMB(3.9,146047,2,1866,0)=" ; S HLEID=$$HLP^IBCNEHLU(""IBCNE IIV REGISTER"")"
^XMB(3.9,146047,2,1867,0)="""RTN"",""IBCNEHLM"",106,0)"
^XMB(3.9,146047,2,1868,0)=" ;"
^XMB(3.9,146047,2,1869,0)="""RTN"",""IBCNEHLM"",107,0)"
^XMB(3.9,146047,2,1870,0)=" ;   Set the MFI segment"
^XMB(3.9,146047,2,1871,0)="""RTN"",""IBCNEHLM"",108,0)"
^XMB(3.9,146047,2,1872,0)=" S ID=""Facility Table"",APP="""",EVENT=""UPD"",RESP=""NE"""
^XMB(3.9,146047,2,1873,0)="""RTN"",""IBCNEHLM"",109,0)"
^XMB(3.9,146047,2,1874,0)=" S ^TMP(""HLS"",$J,1)=$$MFI^VAFHLMFI(ID,APP,EVENT,,,RESP)"
^XMB(3.9,146047,2,1875,0)="""RTN"",""IBCNEHLM"",110,0)"
^XMB(3.9,146047,2,1876,0)=" ;"
^XMB(3.9,146047,2,1877,0)="""RTN"",""IBCNEHLM"",111,0)"
^XMB(3.9,146047,2,1878,0)=" ;  Set the MFE segment"
^XMB(3.9,146047,2,1879,0)="""RTN"",""IBCNEHLM"",112,0)"
^XMB(3.9,146047,2,1880,0)=" S EVENT=MFE(1),MFN="""",EDT=$$DT^XLFDT()"
^XMB(3.9,146047,2,1881,0)="""RTN"",""IBCNEHLM"",113,0)"
^XMB(3.9,146047,2,1882,0)=" S CODE=$P($$SITE^VASITE,U,3)_$E(HLECH)"
^XMB(3.9,146047,2,1883,0)="""RTN"",""IBCNEHLM"",114,0)"
