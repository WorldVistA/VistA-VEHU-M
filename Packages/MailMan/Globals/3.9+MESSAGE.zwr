^XMB(3.9,146044,2,232,0)="Want to MOVE routines to other CPUs"
^XMB(3.9,146044,2,233,0)="""QUES"",""XPZ2"",""B"")"
^XMB(3.9,146044,2,234,0)="NO"
^XMB(3.9,146044,2,235,0)="""QUES"",""XPZ2"",""M"")"
^XMB(3.9,146044,2,236,0)="D XPZ2^XPDIQ"
^XMB(3.9,146044,2,237,0)="""RTN"")"
