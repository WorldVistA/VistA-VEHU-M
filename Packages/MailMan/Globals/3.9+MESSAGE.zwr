^XMB(3.9,146084,2,1166,0)="CREATE(JSON,SDCONTEXT,AVAILABILITY) ;"
^XMB(3.9,146084,2,1167,0)="""RTN"",""SDES2CRTCLNAVAL2"",9,0)"
^XMB(3.9,146084,2,1168,0)=" N ERRORS,RETURNAVAIL,CLINICIEN,CLINICSTARTHOUR,NUMBEROFENTRIES,INPUTS,INDEFINITEUNTIL,SDDISPPERHR,SDCLINSTARTHR,SLOTSTOCANCEL,%,%DT"
