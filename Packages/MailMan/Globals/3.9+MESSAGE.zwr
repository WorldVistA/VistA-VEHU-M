^XMB(3.9,146037,2,2805,0)="""RTN"",""RCDPTAR1"",246,0)"
^XMB(3.9,146037,2,2806,0)=" S EFTIEN=0 F  S EFTIEN=$O(^TMP(""RCDPTAR1"",$J,EFTIEN)) Q:'EFTIEN  D  I RCPG=0 Q"
^XMB(3.9,146037,2,2807,0)="""RTN"",""RCDPTAR1"",247,0)"
^XMB(3.9,146037,2,2808,0)=" . S DATA=^TMP(""RCDPTAR1"",$J,EFTIEN)"
