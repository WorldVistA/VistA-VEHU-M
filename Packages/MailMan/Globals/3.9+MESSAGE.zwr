^XMB(3.9,146052,2,712,0)="0^1^B17356437"
^XMB(3.9,146052,2,713,0)="""RTN"",""FBAACIE"",1,0)"
^XMB(3.9,146052,2,714,0)="FBAACIE ;AISC/GRR - COMPLETE PHARMACY INVOICE ;1/22/2015"
^XMB(3.9,146052,2,715,0)="""RTN"",""FBAACIE"",2,0)"
^XMB(3.9,146052,2,716,0)=" ;;3.5;FEE BASIS;**38,61,91,154,158**;JAN 30, 1995;Build 0"
^XMB(3.9,146052,2,717,0)="""RTN"",""FBAACIE"",3,0)"
^XMB(3.9,146052,2,718,0)=" ;;Per VA Directive 6402, this routine should not be modified."
^XMB(3.9,146052,2,719,0)="""RTN"",""FBAACIE"",4,0)"
^XMB(3.9,146052,2,720,0)=" D DT^DICRW,HOME^%ZIS I '$D(^FBAA(162.1,""AC"",2)) W !!,*7,""There are no Invoices Pending completion!"",!! Q"
^XMB(3.9,146052,2,721,0)="""RTN"",""FBAACIE"",5,0)"
^XMB(3.9,146052,2,722,0)=" D SITEP^FBAAUTL I FBPOP W !,*7,""Fee Site Parameters must be Initialized!"" K FBPOP Q"
^XMB(3.9,146052,2,723,0)="""RTN"",""FBAACIE"",6,0)"
^XMB(3.9,146052,2,724,0)=" S FBAAOUT=1,FBMDF=$P(FBSITE(0),""^"",10),UL="""",$P(UL,""="",79)=""="""
^XMB(3.9,146052,2,725,0)="""RTN"",""FBAACIE"",7,0)"
^XMB(3.9,146052,2,726,0)="RINV W ! S FBINTOT=0,DIC=""^FBAA(162.1,"",DIC(0)=""AEQM"",DIC(""S"")=""I $P(^(0),U,5)=2&($D(^(""""RX"""",""""AC"""",2)))"" D ^DIC K DIC(""S"") G END:X=""^""!(X=""""),RINV:Y<0 S FBIN=+Y,FBINTOT=+$P(^(0),""^"",7)"
^XMB(3.9,146052,2,727,0)="""RTN"",""FBAACIE"",8,0)"
^XMB(3.9,146052,2,728,0)=" I '$D(^FBAA(162.1,FBIN,""RX"",""AC"",2)) G RINV"
^XMB(3.9,146052,2,729,0)="""RTN"",""FBAACIE"",9,0)"
^XMB(3.9,146052,2,730,0)=" S J=0 F  S J=$O(^FBAA(162.1,FBIN,""RX"",""AC"",2,J)) Q:'J  I $D(^FBAA(162.1,FBIN,""RX"",J,0)) S Y(0)=^(0) D GOT"
^XMB(3.9,146052,2,731,0)="""RTN"",""FBAACIE"",10,0)"
^XMB(3.9,146052,2,732,0)=" I '$D(^FBAA(162.1,FBIN,""RX"",""AC"",2)) K ^FBAA(162.1,""AC"",2,FBIN) S ^FBAA(162.1,""AC"",3,FBIN)="""",$P(^FBAA(162.1,FBIN,0),""^"",5)=3"
^XMB(3.9,146052,2,733,0)="""RTN"",""FBAACIE"",11,0)"
^XMB(3.9,146052,2,734,0)=" I $D(^FBAA(162.1,""AC"",3,FBIN)) W !!,""Invoice is Complete"",?30,""Totals: $ ""_$J(FBINTOT,1,2)"
^XMB(3.9,146052,2,735,0)="""RTN"",""FBAACIE"",12,0)"
^XMB(3.9,146052,2,736,0)=" G RINV"
^XMB(3.9,146052,2,737,0)="""RTN"",""FBAACIE"",13,0)"
^XMB(3.9,146052,2,738,0)="END K FBAAOUT,FBIN,FBRX,FBSITE,FBDATEF,FBDRUG,FBPATN,FBPID,FBVNAME,FBVID,FBAC,FBAAPR,DA,X,Y,D0,D1,DI,DIC,DIE,DIRUT,DIV,DQ,DR,FBAP,FBGEN,FBGENSUB,FBINTOT,FBMDF,FBQTY,FBRBC,FBSTR,FBVEN,S,UL,ULL,POP,J,DFN,Z,ZZ,FBSW,FBPOP,FB1725"
^XMB(3.9,146052,2,739,0)="""RTN"",""FBAACIE"",14,0)"
^XMB(3.9,146052,2,740,0)=" K FBADJ,FBFPPSC,FBFPPSL,FBRRMK,DTOUT,FBX,FTP"
^XMB(3.9,146052,2,741,0)="""RTN"",""FBAACIE"",15,0)"
^XMB(3.9,146052,2,742,0)=" Q"
^XMB(3.9,146052,2,743,0)="""RTN"",""FBAACIE"",16,0)"
^XMB(3.9,146052,2,744,0)="GOT S FBDRUG=$P(Y(0),""^"",2)"
^XMB(3.9,146052,2,745,0)="""RTN"",""FBAACIE"",17,0)"
^XMB(3.9,146052,2,746,0)=" S FBGENSUB=$$GET1^DIQ(162.11,J_"",""_FBIN_"","",8.5)"
^XMB(3.9,146052,2,747,0)="""RTN"",""FBAACIE"",18,0)"
^XMB(3.9,146052,2,748,0)=" S FBGEN=$$GET1^DIQ(162.11,J_"",""_FBIN_"","",9)"
^XMB(3.9,146052,2,749,0)="""RTN"",""FBAACIE"",19,0)"
^XMB(3.9,146052,2,750,0)=" S FBRX=$P(Y(0),""^""),FBDATEF=$P(Y(0),""^"",3),FBAC=$P(Y(0),""^"",4),DFN=+$P(Y(0),""^"",5),FBPATN=$$VET^FBUCUTL(DFN),FBPID=$$SSN^FBAAUTL(DFN)"
^XMB(3.9,146052,2,751,0)="""RTN"",""FBAACIE"",20,0)"
^XMB(3.9,146052,2,752,0)=" S FBSTR=$P(Y(0),""^"",12),FBQTY=$P(Y(0),""^"",13),FBAAPR=$P(Y(0),""^"",22)"
^XMB(3.9,146052,2,753,0)="""RTN"",""FBAACIE"",21,0)"
