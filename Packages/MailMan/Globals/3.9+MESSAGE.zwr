^XMB(3.9,146106,2,2930,0)=" S CLINICDT=$P($$ISOTFM^SDAMUTDT($$FMTISO^SDAMUTDT($$NOW^XLFDT()),$G(APPOINTMENT(""CLINIC IEN""))),""."")"
^XMB(3.9,146106,2,2931,0)="""RTN"",""SDES2CREATEAPPT2"",289,0)"
^XMB(3.9,146106,2,2932,0)=" I $G(APPOINTMENT(""WALKIN""))=""y"",$P($G(APPOINTMENT(""START DATE TIME"")),""."")<CLINICDT!($P($G(APPOINTMENT(""START DATE TIME"")),""."")>CLINICDT) D ERRLOG^SDESJSON(.ERRORS,166)"
