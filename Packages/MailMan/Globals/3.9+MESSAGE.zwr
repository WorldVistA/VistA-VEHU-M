^XMB(3.9,146009,2,531,0)="""RTN"",""XUIAMNPB"",133,0)"
^XMB(3.9,146009,2,532,0)=" ..D UPDNP(XUDUZ,.XURET,.XUIAM) ;update new person file with returned data"
^XMB(3.9,146009,2,533,0)="""RTN"",""XUIAMNPB"",134,0)"
