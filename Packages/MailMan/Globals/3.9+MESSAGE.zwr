^XMB(3.9,146099,2,2464,0)=" ;;Per VHA Directive 6402, this routine should not be modified"
^XMB(3.9,146099,2,2465,0)="""RTN"",""SDES2GETCANSLOTS"",4,0)"
^XMB(3.9,146099,2,2466,0)=" ;"
^XMB(3.9,146099,2,2467,0)="""RTN"",""SDES2GETCANSLOTS"",5,0)"
^XMB(3.9,146099,2,2468,0)=" ; External References"
^XMB(3.9,146099,2,2469,0)="""RTN"",""SDES2GETCANSLOTS"",6,0)"
^XMB(3.9,146099,2,2470,0)=" ; -------------------"
^XMB(3.9,146099,2,2471,0)="""RTN"",""SDES2GETCANSLOTS"",7,0)"
^XMB(3.9,146099,2,2472,0)=" ; Reference to $$FIND1^DIC in ICR #2051"
^XMB(3.9,146099,2,2473,0)="""RTN"",""SDES2GETCANSLOTS"",8,0)"
^XMB(3.9,146099,2,2474,0)=" ; *** The above reference will not be called but a call to $$GETRES^SDES2UTIL1 will done instead*** VSE-10427"
^XMB(3.9,146099,2,2475,0)="""RTN"",""SDES2GETCANSLOTS"",9,0)"
^XMB(3.9,146099,2,2476,0)=" ; Reference to $$GET1^DIQ  in ICR #2056"
^XMB(3.9,146099,2,2477,0)="""RTN"",""SDES2GETCANSLOTS"",10,0)"
^XMB(3.9,146099,2,2478,0)=" ; Reference to DUZ^XUP is supported by IA #7487"
^XMB(3.9,146099,2,2479,0)="""RTN"",""SDES2GETCANSLOTS"",11,0)"
^XMB(3.9,146099,2,2480,0)=" ;"
^XMB(3.9,146099,2,2481,0)="""RTN"",""SDES2GETCANSLOTS"",12,0)"
^XMB(3.9,146099,2,2482,0)=" Q  ;No Direct Call"
^XMB(3.9,146099,2,2483,0)="""RTN"",""SDES2GETCANSLOTS"",13,0)"
^XMB(3.9,146099,2,2484,0)=" ;"
^XMB(3.9,146099,2,2485,0)="""RTN"",""SDES2GETCANSLOTS"",14,0)"
^XMB(3.9,146099,2,2486,0)=" ; RPC: SDES2 GET CANCELLED SLOTS"
^XMB(3.9,146099,2,2487,0)="""RTN"",""SDES2GETCANSLOTS"",15,0)"
^XMB(3.9,146099,2,2488,0)=" ;"
^XMB(3.9,146099,2,2489,0)="""RTN"",""SDES2GETCANSLOTS"",16,0)"
^XMB(3.9,146099,2,2490,0)="GETCANCSLOTS(JSONRETURN,SDCONTEXT,SDCANCDATA) ;"
^XMB(3.9,146099,2,2491,0)="""RTN"",""SDES2GETCANSLOTS"",17,0)"
^XMB(3.9,146099,2,2492,0)=" ; This RPC returns cancelled slots within a given timeframe for a given clinic in JSON format."
^XMB(3.9,146099,2,2493,0)="""RTN"",""SDES2GETCANSLOTS"",18,0)"
^XMB(3.9,146099,2,2494,0)=" ; Input:"
^XMB(3.9,146099,2,2495,0)="""RTN"",""SDES2GETCANSLOTS"",19,0)"
^XMB(3.9,146099,2,2496,0)=" ; SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number. Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XMB(3.9,146099,2,2497,0)="""RTN"",""SDES2GETCANSLOTS"",20,0)"
^XMB(3.9,146099,2,2498,0)=" ; SDCONTEXT(""USER DUZ"")    = [required] - The DUZ of the user taking action in the calling application."
^XMB(3.9,146099,2,2499,0)="""RTN"",""SDES2GETCANSLOTS"",21,0)"
^XMB(3.9,146099,2,2500,0)=" ; SDCONTEXT(""USER SECID"")  = [optional] - The SECID of the user taking action in the calling application."
^XMB(3.9,146099,2,2501,0)="""RTN"",""SDES2GETCANSLOTS"",22,0)"
^XMB(3.9,146099,2,2502,0)=" ; SDCONTEXT(""PATIENT DFN"") = [optional] - The DFN/IEN of the target patient from the calling application."
^XMB(3.9,146099,2,2503,0)="""RTN"",""SDES2GETCANSLOTS"",23,0)"
^XMB(3.9,146099,2,2504,0)=" ; SDCONTEXT(""PATIENT ICN"") = [optional] - The ICN of the target patient from the calling application."
^XMB(3.9,146099,2,2505,0)="""RTN"",""SDES2GETCANSLOTS"",24,0)"
^XMB(3.9,146099,2,2506,0)=" ;"
^XMB(3.9,146099,2,2507,0)="""RTN"",""SDES2GETCANSLOTS"",25,0)"
^XMB(3.9,146099,2,2508,0)=" ; SDCANCDATA(""CLINICIEN"")   = [required] - The Internal Entry Number (IEN) from the HOSPITAL LOCATION File #44"
^XMB(3.9,146099,2,2509,0)="""RTN"",""SDES2GETCANSLOTS"",26,0)"
^XMB(3.9,146099,2,2510,0)=" ; SDCANCDATA(""SDESSTART"")   = [required] - The Start Date of search in ISO8601 format CCYY-MM-DDTHH:MM-OFFSET"
^XMB(3.9,146099,2,2511,0)="""RTN"",""SDES2GETCANSLOTS"",27,0)"
^XMB(3.9,146099,2,2512,0)=" ; SDCANCDATA(""SDESENDDATE"") = [required] - The End Date of search in ISO8601 format CCYY-MM-DDTHH:MM-OFFSET"
^XMB(3.9,146099,2,2513,0)="""RTN"",""SDES2GETCANSLOTS"",28,0)"
^XMB(3.9,146099,2,2514,0)=" ;"
^XMB(3.9,146099,2,2515,0)="""RTN"",""SDES2GETCANSLOTS"",29,0)"
^XMB(3.9,146099,2,2516,0)=" ; JSONRETURN = [required] - This is where the retrieved data is stored in JSON format."
^XMB(3.9,146099,2,2517,0)="""RTN"",""SDES2GETCANSLOTS"",30,0)"
^XMB(3.9,146099,2,2518,0)=" ;"
^XMB(3.9,146099,2,2519,0)="""RTN"",""SDES2GETCANSLOTS"",31,0)"
^XMB(3.9,146099,2,2520,0)=" N SDGETCANCSLOTS,SDCLNAME,ERROR,SDCLRESIEN,SDTMPARY,I,%DT"
^XMB(3.9,146099,2,2521,0)="""RTN"",""SDES2GETCANSLOTS"",32,0)"
^XMB(3.9,146099,2,2522,0)=" S ERROR=0"
^XMB(3.9,146099,2,2523,0)="""RTN"",""SDES2GETCANSLOTS"",33,0)"
^XMB(3.9,146099,2,2524,0)=" ; validate context"
^XMB(3.9,146099,2,2525,0)="""RTN"",""SDES2GETCANSLOTS"",34,0)"
^XMB(3.9,146099,2,2526,0)=" D VALCONTEXT^SDES2VALCONTEXT(.SDGETCANCSLOTS,.SDCONTEXT)"
^XMB(3.9,146099,2,2527,0)="""RTN"",""SDES2GETCANSLOTS"",35,0)"
^XMB(3.9,146099,2,2528,0)=" I $D(SDGETCANCSLOTS) S SDGETCANCSLOTS(""CancelledSlots"",1)="""" D BUILDJSON^SDES2JSON(.JSONRETURN,.SDGETCANCSLOTS) Q"
^XMB(3.9,146099,2,2529,0)="""RTN"",""SDES2GETCANSLOTS"",36,0)"
^XMB(3.9,146099,2,2530,0)=" I $G(SDCONTEXT(""USER DUZ""))'="""" N DUZ D DUZ^XUP(SDCONTEXT(""USER DUZ""))"
^XMB(3.9,146099,2,2531,0)="""RTN"",""SDES2GETCANSLOTS"",37,0)"
^XMB(3.9,146099,2,2532,0)=" ;"
^XMB(3.9,146099,2,2533,0)="""RTN"",""SDES2GETCANSLOTS"",38,0)"
^XMB(3.9,146099,2,2534,0)=" ; validate cancdata input parameters"
^XMB(3.9,146099,2,2535,0)="""RTN"",""SDES2GETCANSLOTS"",39,0)"
^XMB(3.9,146099,2,2536,0)=" D VALIDATEINPUT(.SDGETCANCSLOTS,.SDCANCDATA,.ERROR)"
^XMB(3.9,146099,2,2537,0)="""RTN"",""SDES2GETCANSLOTS"",40,0)"
^XMB(3.9,146099,2,2538,0)=" I ERROR S SDGETCANCSLOTS(""CancelledSlots"",1)="""" D BUILDJSON^SDES2JSON(.JSONRETURN,.SDGETCANCSLOTS) Q"
^XMB(3.9,146099,2,2539,0)="""RTN"",""SDES2GETCANSLOTS"",41,0)"
^XMB(3.9,146099,2,2540,0)=" K SDTMPARY"
^XMB(3.9,146099,2,2541,0)="""RTN"",""SDES2GETCANSLOTS"",42,0)"
^XMB(3.9,146099,2,2542,0)=" S SDTMPARY=$NA(^TMP($J,""CLNCANCSLOTS""))"
^XMB(3.9,146099,2,2543,0)="""RTN"",""SDES2GETCANSLOTS"",43,0)"
^XMB(3.9,146099,2,2544,0)=" K @SDTMPARY"
^XMB(3.9,146099,2,2545,0)="""RTN"",""SDES2GETCANSLOTS"",44,0)"
^XMB(3.9,146099,2,2546,0)=" D GETSLOTS^SDEC57(SDTMPARY,$G(SDCANCDATA(""SDCLRESIEN"")),$G(SDCANCDATA(""SDESSTART"")),$G(SDCANCDATA(""SDESENDDATE"")))"
^XMB(3.9,146099,2,2547,0)="""RTN"",""SDES2GETCANSLOTS"",45,0)"
^XMB(3.9,146099,2,2548,0)=" D BUILDDATA(.SDGETCANCSLOTS,.SDCANCDATA,SDTMPARY)"
^XMB(3.9,146099,2,2549,0)="""RTN"",""SDES2GETCANSLOTS"",46,0)"
^XMB(3.9,146099,2,2550,0)=" K @SDTMPARY"
^XMB(3.9,146099,2,2551,0)="""RTN"",""SDES2GETCANSLOTS"",47,0)"
^XMB(3.9,146099,2,2552,0)=" I ERROR!('$D(SDGETCANCSLOTS(""CancelledSlots""))) S SDGETCANCSLOTS(""CancelledSlots"",1)="""""
^XMB(3.9,146099,2,2553,0)="""RTN"",""SDES2GETCANSLOTS"",48,0)"
^XMB(3.9,146099,2,2554,0)=" D BUILDJSON^SDES2JSON(.JSONRETURN,.SDGETCANCSLOTS)"
^XMB(3.9,146099,2,2555,0)="""RTN"",""SDES2GETCANSLOTS"",49,0)"
^XMB(3.9,146099,2,2556,0)=" K SDGETCANCSLOTS"
^XMB(3.9,146099,2,2557,0)="""RTN"",""SDES2GETCANSLOTS"",50,0)"
^XMB(3.9,146099,2,2558,0)=" Q"
^XMB(3.9,146099,2,2559,0)="""RTN"",""SDES2GETCANSLOTS"",51,0)"
^XMB(3.9,146099,2,2560,0)=" ;"
^XMB(3.9,146099,2,2561,0)="""RTN"",""SDES2GETCANSLOTS"",52,0)"
^XMB(3.9,146099,2,2562,0)="VALIDATEINPUT(SDGETCANCSLOTS,SDCANCDATA,ERROR) ;validate input parameters"
^XMB(3.9,146099,2,2563,0)="""RTN"",""SDES2GETCANSLOTS"",53,0)"
^XMB(3.9,146099,2,2564,0)=" N CLINICIEN,EFLAG,SFLAG,SDESSTART,SDESENDDATE,SDVALERROR"
^XMB(3.9,146099,2,2565,0)="""RTN"",""SDES2GETCANSLOTS"",54,0)"
^XMB(3.9,146099,2,2566,0)=" S (SFLAG,EFLAG)=0"
^XMB(3.9,146099,2,2567,0)="""RTN"",""SDES2GETCANSLOTS"",55,0)"
^XMB(3.9,146099,2,2568,0)=" ;validate CLINIC IEN"
^XMB(3.9,146099,2,2569,0)="""RTN"",""SDES2GETCANSLOTS"",56,0)"
^XMB(3.9,146099,2,2570,0)=" S CLINICIEN=$G(SDCANCDATA(""CLINICIEN""))"
^XMB(3.9,146099,2,2571,0)="""RTN"",""SDES2GETCANSLOTS"",57,0)"
^XMB(3.9,146099,2,2572,0)=" D VALFILEIEN^SDES2VALUTIL(.SDVALERROR,.SDGETCANCSLOTS,44,CLINICIEN,1,,67,19)"
^XMB(3.9,146099,2,2573,0)="""RTN"",""SDES2GETCANSLOTS"",58,0)"
^XMB(3.9,146099,2,2574,0)=" I SDVALERROR=0 S ERROR=1 Q"
^XMB(3.9,146099,2,2575,0)="""RTN"",""SDES2GETCANSLOTS"",59,0)"
^XMB(3.9,146099,2,2576,0)=" I +CLINICIEN>0 D  Q:ERROR"
^XMB(3.9,146099,2,2577,0)="""RTN"",""SDES2GETCANSLOTS"",60,0)"
^XMB(3.9,146099,2,2578,0)=" . S SDCLNAME=$$GET1^DIQ(44,CLINICIEN_"","",.01,""I"")  ;retrieve the clinic name"
^XMB(3.9,146099,2,2579,0)="""RTN"",""SDES2GETCANSLOTS"",61,0)"
^XMB(3.9,146099,2,2580,0)=" . I SDCLNAME="""" D ERRLOG^SDESJSON(.SDGETCANCSLOTS,80) S ERROR=1 Q  ;clinic IEN not found"
^XMB(3.9,146099,2,2581,0)="""RTN"",""SDES2GETCANSLOTS"",62,0)"
^XMB(3.9,146099,2,2582,0)=" . S SDCLRESIEN=$$GETRES^SDES2UTIL1(CLINICIEN,1) ;retrieve the resource IEN for the clinic"
^XMB(3.9,146099,2,2583,0)="""RTN"",""SDES2GETCANSLOTS"",63,0)"
^XMB(3.9,146099,2,2584,0)=" . I SDCLRESIEN="""" D ERRLOG^SDESJSON(.SDGETCANCSLOTS,70) S ERROR=1 Q  ;invalid clinic resource id"
^XMB(3.9,146099,2,2585,0)="""RTN"",""SDES2GETCANSLOTS"",64,0)"
^XMB(3.9,146099,2,2586,0)=" . S SDCANCDATA(""SDCLRESIEN"")=SDCLRESIEN"
^XMB(3.9,146099,2,2587,0)="""RTN"",""SDES2GETCANSLOTS"",65,0)"
^XMB(3.9,146099,2,2588,0)=" ;"
^XMB(3.9,146099,2,2589,0)="""RTN"",""SDES2GETCANSLOTS"",66,0)"
^XMB(3.9,146099,2,2590,0)=" ;validate start date"
^XMB(3.9,146099,2,2591,0)="""RTN"",""SDES2GETCANSLOTS"",67,0)"
^XMB(3.9,146099,2,2592,0)=" S SDESSTART=$G(SDCANCDATA(""SDESSTART""))"
^XMB(3.9,146099,2,2593,0)="""RTN"",""SDES2GETCANSLOTS"",68,0)"
^XMB(3.9,146099,2,2594,0)=" S SDESSTART=$$VALISODTTM^SDES2VALISODTTM(.SDGETCANCSLOTS,SDESSTART,CLINICIEN,1,25,27)"
^XMB(3.9,146099,2,2595,0)="""RTN"",""SDES2GETCANSLOTS"",69,0)"
^XMB(3.9,146099,2,2596,0)=" I SDESSTART="""" S ERROR=1 Q"
^XMB(3.9,146099,2,2597,0)="""RTN"",""SDES2GETCANSLOTS"",70,0)"
^XMB(3.9,146099,2,2598,0)=" I $P(SDESSTART,""."",2)="""" S ERROR=1 D ERRLOG^SDES2JSON(.SDGETCANCSLOTS,27) Q"
^XMB(3.9,146099,2,2599,0)="""RTN"",""SDES2GETCANSLOTS"",71,0)"
^XMB(3.9,146099,2,2600,0)=" S SDCANCDATA(""SDESSTARTDTTM"")=SDESSTART"
^XMB(3.9,146099,2,2601,0)="""RTN"",""SDES2GETCANSLOTS"",72,0)"
^XMB(3.9,146099,2,2602,0)=" S SDCANCDATA(""SDESSTART"")=$P(SDESSTART,""."",1)"
^XMB(3.9,146099,2,2603,0)="""RTN"",""SDES2GETCANSLOTS"",73,0)"
^XMB(3.9,146099,2,2604,0)=" ;"
^XMB(3.9,146099,2,2605,0)="""RTN"",""SDES2GETCANSLOTS"",74,0)"
^XMB(3.9,146099,2,2606,0)=" ;validate end date"
^XMB(3.9,146099,2,2607,0)="""RTN"",""SDES2GETCANSLOTS"",75,0)"
^XMB(3.9,146099,2,2608,0)=" S SDESENDDATE=$G(SDCANCDATA(""SDESENDDATE""))"
^XMB(3.9,146099,2,2609,0)="""RTN"",""SDES2GETCANSLOTS"",76,0)"
^XMB(3.9,146099,2,2610,0)=" S SDESENDDATE=$$VALISODTTM^SDES2VALISODTTM(.SDGETCANCSLOTS,SDESENDDATE,CLINICIEN,1,26,28)"
^XMB(3.9,146099,2,2611,0)="""RTN"",""SDES2GETCANSLOTS"",77,0)"
^XMB(3.9,146099,2,2612,0)=" I SDESENDDATE="""" S ERROR=1 Q"
^XMB(3.9,146099,2,2613,0)="""RTN"",""SDES2GETCANSLOTS"",78,0)"
^XMB(3.9,146099,2,2614,0)=" I $P(SDESENDDATE,""."",2)="""" S ERROR=1 D ERRLOG^SDES2JSON(.SDGETCANCSLOTS,28) Q"
^XMB(3.9,146099,2,2615,0)="""RTN"",""SDES2GETCANSLOTS"",79,0)"
^XMB(3.9,146099,2,2616,0)=" S SDCANCDATA(""SDESENDDTTM"")=SDESENDDATE"
^XMB(3.9,146099,2,2617,0)="""RTN"",""SDES2GETCANSLOTS"",80,0)"
^XMB(3.9,146099,2,2618,0)=" S SDCANCDATA(""SDESENDDATE"")=$P(SDESENDDATE,""."",1)"
^XMB(3.9,146099,2,2619,0)="""RTN"",""SDES2GETCANSLOTS"",81,0)"
^XMB(3.9,146099,2,2620,0)=" ;"
^XMB(3.9,146099,2,2621,0)="""RTN"",""SDES2GETCANSLOTS"",82,0)"
^XMB(3.9,146099,2,2622,0)=" ;validate end date after start date"
^XMB(3.9,146099,2,2623,0)="""RTN"",""SDES2GETCANSLOTS"",83,0)"
^XMB(3.9,146099,2,2624,0)=" I SDESSTART>SDESENDDATE S ERROR=1 D ERRLOG^SDESJSON(.SDGETCANCSLOTS,242)"
^XMB(3.9,146099,2,2625,0)="""RTN"",""SDES2GETCANSLOTS"",84,0)"
^XMB(3.9,146099,2,2626,0)=" Q"
^XMB(3.9,146099,2,2627,0)="""RTN"",""SDES2GETCANSLOTS"",85,0)"
^XMB(3.9,146099,2,2628,0)=" ;"
^XMB(3.9,146099,2,2629,0)="""RTN"",""SDES2GETCANSLOTS"",86,0)"
^XMB(3.9,146099,2,2630,0)="BUILDDATA(SDGETCANCSLOTS,SDCANCDATA,SDTMPARY) ; retrieve clinic availability data"
^XMB(3.9,146099,2,2631,0)="""RTN"",""SDES2GETCANSLOTS"",87,0)"
^XMB(3.9,146099,2,2632,0)=" N CLINICIEN,SDP1,SDP2,SDP3,SDP4,SDSLOTS,SDSTOPTM,SDSTRTTM,SDTOTAL,II,SDDIV,SDINST,SDAPDTTM,SDCANMSG,SDFIRST,CANCELDATE"
^XMB(3.9,146099,2,2633,0)="""RTN"",""SDES2GETCANSLOTS"",88,0)"
^XMB(3.9,146099,2,2634,0)=" I $O(@SDTMPARY@(""""))="""" Q"
^XMB(3.9,146099,2,2635,0)="""RTN"",""SDES2GETCANSLOTS"",89,0)"
^XMB(3.9,146099,2,2636,0)=" S CLINICIEN=$G(SDCANCDATA(""CLINICIEN""))"
^XMB(3.9,146099,2,2637,0)="""RTN"",""SDES2GETCANSLOTS"",90,0)"
^XMB(3.9,146099,2,2638,0)=" S SDTOTAL=@SDTMPARY@(""CNT""),SDFIRST=1"
^XMB(3.9,146099,2,2639,0)="""RTN"",""SDES2GETCANSLOTS"",91,0)"
^XMB(3.9,146099,2,2640,0)=" F II=1:1:SDTOTAL D"
^XMB(3.9,146099,2,2641,0)="""RTN"",""SDES2GETCANSLOTS"",92,0)"
^XMB(3.9,146099,2,2642,0)=" . S SDP1=$P(@SDTMPARY@(II),U,2) ;start date"
^XMB(3.9,146099,2,2643,0)="""RTN"",""SDES2GETCANSLOTS"",93,0)"
^XMB(3.9,146099,2,2644,0)=" . S SDP2=$P(@SDTMPARY@(II),U,3) ;end date"
^XMB(3.9,146099,2,2645,0)="""RTN"",""SDES2GETCANSLOTS"",94,0)"
^XMB(3.9,146099,2,2646,0)=" . I (SDP1<SDCANCDATA(""SDESSTARTDTTM""))!(('SDFIRST)&(SDP1>SDCANCDATA(""SDESENDDTTM""))) Q"
^XMB(3.9,146099,2,2647,0)="""RTN"",""SDES2GETCANSLOTS"",95,0)"
^XMB(3.9,146099,2,2648,0)=" . I SDFIRST,$D(^SC(CLINICIEN,""S"",+SDP1))<1 D  ; Use first populated slot"
^XMB(3.9,146099,2,2649,0)="""RTN"",""SDES2GETCANSLOTS"",96,0)"
^XMB(3.9,146099,2,2650,0)=" . . I II=1 S SDFIRST=0 Q"
^XMB(3.9,146099,2,2651,0)="""RTN"",""SDES2GETCANSLOTS"",97,0)"
^XMB(3.9,146099,2,2652,0)=" . . S II=II-1,SDFIRST=0"
^XMB(3.9,146099,2,2653,0)="""RTN"",""SDES2GETCANSLOTS"",98,0)"
^XMB(3.9,146099,2,2654,0)=" . . S SDP1=$P(@SDTMPARY@(II),U,2)  ; Use first populated slot"
^XMB(3.9,146099,2,2655,0)="""RTN"",""SDES2GETCANSLOTS"",99,0)"
^XMB(3.9,146099,2,2656,0)=" . . S SDP2=$P(@SDTMPARY@(II),U,3)"
^XMB(3.9,146099,2,2657,0)="""RTN"",""SDES2GETCANSLOTS"",100,0)"
^XMB(3.9,146099,2,2658,0)=" . S SDP3=+$P(@SDTMPARY@(II),U,4) ;open slots available"
^XMB(3.9,146099,2,2659,0)="""RTN"",""SDES2GETCANSLOTS"",101,0)"
^XMB(3.9,146099,2,2660,0)=" . S SDP4=$P(@SDTMPARY@(II),U,5) ;access type  (1=available, 2=not available, 3=cancelled)"
^XMB(3.9,146099,2,2661,0)="""RTN"",""SDES2GETCANSLOTS"",102,0)"
^XMB(3.9,146099,2,2662,0)=" . Q:SDP4'=3  ; Only return cancelled slots"
^XMB(3.9,146099,2,2663,0)="""RTN"",""SDES2GETCANSLOTS"",103,0)"
^XMB(3.9,146099,2,2664,0)=" . I $P(SDP1,""."",2)=""""!($P(SDP1,""."",2)=""00"") S $P(SDP1,""."",2)=""0001"""
^XMB(3.9,146099,2,2665,0)="""RTN"",""SDES2GETCANSLOTS"",104,0)"
^XMB(3.9,146099,2,2666,0)=" . S SDSTRTTM=$$FMTISO^SDAMUTDT(SDP1,CLINICIEN)"
^XMB(3.9,146099,2,2667,0)="""RTN"",""SDES2GETCANSLOTS"",105,0)"
^XMB(3.9,146099,2,2668,0)=" . S SDSTOPTM=$$FMTISO^SDAMUTDT(SDP2,CLINICIEN)"
^XMB(3.9,146099,2,2669,0)="""RTN"",""SDES2GETCANSLOTS"",106,0)"
^XMB(3.9,146099,2,2670,0)="  .S CANCELDATE=$P($$ISOTFM^SDAMUTDT(SDSTRTTM),""."")"
^XMB(3.9,146099,2,2671,0)="""RTN"",""SDES2GETCANSLOTS"",107,0)"
^XMB(3.9,146099,2,2672,0)=" . S SDSLOTS=$P(@SDTMPARY@(II),U,4)"
^XMB(3.9,146099,2,2673,0)="""RTN"",""SDES2GETCANSLOTS"",108,0)"
^XMB(3.9,146099,2,2674,0)=" . S SDSLOTS=$S(SDSLOTS="" "":"""",1:SDSLOTS)"
^XMB(3.9,146099,2,2675,0)="""RTN"",""SDES2GETCANSLOTS"",109,0)"
^XMB(3.9,146099,2,2676,0)=" . S SDSLOTS=$S(SDP4=3:""X"",1:SDSLOTS)"
^XMB(3.9,146099,2,2677,0)="""RTN"",""SDES2GETCANSLOTS"",110,0)"
^XMB(3.9,146099,2,2678,0)=" . S SDGETCANCSLOTS(""CancelledSlots"",II,""BeginTime"")=SDSTRTTM"
^XMB(3.9,146099,2,2679,0)="""RTN"",""SDES2GETCANSLOTS"",111,0)"
^XMB(3.9,146099,2,2680,0)=" . S SDGETCANCSLOTS(""CancelledSlots"",II,""EndTime"")=SDSTOPTM"
^XMB(3.9,146099,2,2681,0)="""RTN"",""SDES2GETCANSLOTS"",112,0)"
^XMB(3.9,146099,2,2682,0)=" . S SDGETCANCSLOTS(""CancelledSlots"",II,""SlotsAvail"")=SDSLOTS"
^XMB(3.9,146099,2,2683,0)="""RTN"",""SDES2GETCANSLOTS"",113,0)"
^XMB(3.9,146099,2,2684,0)=" . S SDAPDTTM=+SDP1"
^XMB(3.9,146099,2,2685,0)="""RTN"",""SDES2GETCANSLOTS"",114,0)"
^XMB(3.9,146099,2,2686,0)=" . S SDCANMSG=$S($D(^SC(CLINICIEN,""FULL DAY CANCEL"",CANCELDATE)):$$GET1^DIQ(44.1902,CANCELDATE_"",""_CLINICIEN_"","",.02),1:$$GET1^DIQ(44.001,SDAPDTTM_"",""_CLINICIEN_"","",1400))"
^XMB(3.9,146099,2,2687,0)="""RTN"",""SDES2GETCANSLOTS"",115,0)"
^XMB(3.9,146099,2,2688,0)=" . S SDGETCANCSLOTS(""CancelledSlots"",II,""fullDayCancel"")=$S($D(^SC(CLINICIEN,""FULL DAY CANCEL"",CANCELDATE)):""1"",1:0)"
^XMB(3.9,146099,2,2689,0)="""RTN"",""SDES2GETCANSLOTS"",116,0)"
^XMB(3.9,146099,2,2690,0)=" . S SDGETCANCSLOTS(""CancelledSlots"",II,""CancelMessage"")=SDCANMSG"
^XMB(3.9,146099,2,2691,0)="""RTN"",""SDES2GETCANSLOTS"",117,0)"
^XMB(3.9,146099,2,2692,0)=" ; Changes for 831 start"
^XMB(3.9,146099,2,2693,0)="""RTN"",""SDES2GETCANSLOTS"",118,0)"
^XMB(3.9,146099,2,2694,0)=" I $G(CLINICIEN) D"
^XMB(3.9,146099,2,2695,0)="""RTN"",""SDES2GETCANSLOTS"",119,0)"
^XMB(3.9,146099,2,2696,0)=" .S SDDIV=$$GET1^DIQ(44,CLINICIEN_"","",3.5,""I"")"
^XMB(3.9,146099,2,2697,0)="""RTN"",""SDES2GETCANSLOTS"",120,0)"
^XMB(3.9,146099,2,2698,0)=" .S:SDDIV SDINST=$$GET1^DIQ(40.8,SDDIV_"","",.07,""I"")"
^XMB(3.9,146099,2,2699,0)="""RTN"",""SDES2GETCANSLOTS"",121,0)"
^XMB(3.9,146099,2,2700,0)=" .I $$GET1^DIQ(4,SDINST,800,""I"")="""" D"
^XMB(3.9,146099,2,2701,0)="""RTN"",""SDES2GETCANSLOTS"",122,0)"
^XMB(3.9,146099,2,2702,0)=" ..S SDGETCANCSLOTS(""CancelledSlots"",0.1,""Error"")=""No Timezone set for Clinic."""
^XMB(3.9,146099,2,2703,0)="""RTN"",""SDES2GETCANSLOTS"",123,0)"
^XMB(3.9,146099,2,2704,0)=" ..I $$GET1^DIQ(8989.3,1,217,""I"")="""" S SDGETCANCSLOTS(""CancelledSlots"",0.2,""Error"")=""No Timezone set for Institution in Kernel Parameters (#8989.3) file."""
^XMB(3.9,146099,2,2705,0)="""RTN"",""SDES2GETCANSLOTS"",124,0)"
^XMB(3.9,146099,2,2706,0)=" ; Changes for 831 end"
^XMB(3.9,146099,2,2707,0)="""RTN"",""SDES2GETCANSLOTS"",125,0)"
^XMB(3.9,146099,2,2708,0)=" Q"
^XMB(3.9,146099,2,2709,0)="""RTN"",""SDES2PATSEARCH"")"
^XMB(3.9,146099,2,2710,0)="0^1^B117728628"
^XMB(3.9,146099,2,2711,0)="""RTN"",""SDES2PATSEARCH"",1,0)"
^XMB(3.9,146099,2,2712,0)="SDES2PATSEARCH  ;ALB/ANU,BLB,BWF,MCB,JDJ,MGD,MCB,JAS,AGW - SDES2 PATIENT SEARCH; FEB 13, 2026"
^XMB(3.9,146099,2,2713,0)="""RTN"",""SDES2PATSEARCH"",2,0)"
^XMB(3.9,146099,2,2714,0)=" ;;5.3;Scheduling;**864,866,881,899,903,904,906,909,930**;Aug 13, 1993;Build 0"
^XMB(3.9,146099,2,2715,0)="""RTN"",""SDES2PATSEARCH"",3,0)"
^XMB(3.9,146099,2,2716,0)=" ;;Per VHA Directive 6402, this routine should not be modified"
^XMB(3.9,146099,2,2717,0)="""RTN"",""SDES2PATSEARCH"",4,0)"
^XMB(3.9,146099,2,2718,0)=" ;"
^XMB(3.9,146099,2,2719,0)="""RTN"",""SDES2PATSEARCH"",5,0)"
^XMB(3.9,146099,2,2720,0)=" ; clone of SDESPATSEARCH - BLB"
^XMB(3.9,146099,2,2721,0)="""RTN"",""SDES2PATSEARCH"",6,0)"
^XMB(3.9,146099,2,2722,0)=" ;"
^XMB(3.9,146099,2,2723,0)="""RTN"",""SDES2PATSEARCH"",7,0)"
^XMB(3.9,146099,2,2724,0)=" ; Reference to PATIENT in ICR #7030"
^XMB(3.9,146099,2,2725,0)="""RTN"",""SDES2PATSEARCH"",8,0)"
^XMB(3.9,146099,2,2726,0)=" ; Reference to PATIENT in ICR #7029"
^XMB(3.9,146099,2,2727,0)="""RTN"",""SDES2PATSEARCH"",9,0)"
^XMB(3.9,146099,2,2728,0)=" ; Reference to PATIENT in ICR #1476"
^XMB(3.9,146099,2,2729,0)="""RTN"",""SDES2PATSEARCH"",10,0)"
^XMB(3.9,146099,2,2730,0)=" ; Reference to PATIENT in ICR #10035"
^XMB(3.9,146099,2,2731,0)="""RTN"",""SDES2PATSEARCH"",11,0)"
^XMB(3.9,146099,2,2732,0)=" ; Reference to RATED DISABILITIES sub-file in ICR #4807"
^XMB(3.9,146099,2,2733,0)="""RTN"",""SDES2PATSEARCH"",12,0)"
^XMB(3.9,146099,2,2734,0)=" ; Reference to DISABILITY CONDITION in #733"
^XMB(3.9,146099,2,2735,0)="""RTN"",""SDES2PATSEARCH"",13,0)"
^XMB(3.9,146099,2,2736,0)=" ; Reference to DUZ^XUP is supported by IA #7487"
^XMB(3.9,146099,2,2737,0)="""RTN"",""SDES2PATSEARCH"",14,0)"
^XMB(3.9,146099,2,2738,0)=" ;"
^XMB(3.9,146099,2,2739,0)="""RTN"",""SDES2PATSEARCH"",15,0)"
^XMB(3.9,146099,2,2740,0)=" Q"
^XMB(3.9,146099,2,2741,0)="""RTN"",""SDES2PATSEARCH"",16,0)"
^XMB(3.9,146099,2,2742,0)=" ;"
^XMB(3.9,146099,2,2743,0)="""RTN"",""SDES2PATSEARCH"",17,0)"
^XMB(3.9,146099,2,2744,0)="SEARCH(JSONRETURN,SDCONTEXT,PARAMS) ; SDES2 PATIENT SEARCH"
^XMB(3.9,146099,2,2745,0)="""RTN"",""SDES2PATSEARCH"",18,0)"
^XMB(3.9,146099,2,2746,0)=" N RETURN,ERRORS,PATIENTLIST,INDEX,VALRET,NUMOFRECORDS,SEARCHSTRING"
^XMB(3.9,146099,2,2747,0)="""RTN"",""SDES2PATSEARCH"",19,0)"
^XMB(3.9,146099,2,2748,0)=" ; Next line of news for variables leaking from other APIs"
^XMB(3.9,146099,2,2749,0)="""RTN"",""SDES2PATSEARCH"",20,0)"
^XMB(3.9,146099,2,2750,0)=" N MHTC,VA,YSZ"
^XMB(3.9,146099,2,2751,0)="""RTN"",""SDES2PATSEARCH"",21,0)"
^XMB(3.9,146099,2,2752,0)=" ;"
^XMB(3.9,146099,2,2753,0)="""RTN"",""SDES2PATSEARCH"",22,0)"
^XMB(3.9,146099,2,2754,0)=" D VALCONTEXT^SDES2VALCONTEXT(.ERRORS,.SDCONTEXT)"
^XMB(3.9,146099,2,2755,0)="""RTN"",""SDES2PATSEARCH"",23,0)"
^XMB(3.9,146099,2,2756,0)=" I $D(ERRORS) S ERRORS(""Patient"",1)="""" D BUILDJSON^SDES2JSON(.JSONRETURN,.ERRORS) Q"
^XMB(3.9,146099,2,2757,0)="""RTN"",""SDES2PATSEARCH"",24,0)"
^XMB(3.9,146099,2,2758,0)=" I $G(SDCONTEXT(""USER DUZ""))'="""" N DUZ D DUZ^XUP(SDCONTEXT(""USER DUZ""))"
^XMB(3.9,146099,2,2759,0)="""RTN"",""SDES2PATSEARCH"",25,0)"
^XMB(3.9,146099,2,2760,0)=" ;"
^XMB(3.9,146099,2,2761,0)="""RTN"",""SDES2PATSEARCH"",26,0)"
^XMB(3.9,146099,2,2762,0)=" D POPULATEINPUTS(.PARAMS,.SEARCHSTRING,.NUMOFRECORDS,.INDEX)"
^XMB(3.9,146099,2,2763,0)="""RTN"",""SDES2PATSEARCH"",27,0)"
^XMB(3.9,146099,2,2764,0)=" D VALIDATE(.ERRORS,.NUMOFRECORDS,.SEARCHSTRING)"
^XMB(3.9,146099,2,2765,0)="""RTN"",""SDES2PATSEARCH"",28,0)"
^XMB(3.9,146099,2,2766,0)=" I $D(ERRORS) S ERRORS(""Patient"",1)="""" D BUILDJSON^SDES2JSON(.JSONRETURN,.ERRORS) Q"
^XMB(3.9,146099,2,2767,0)="""RTN"",""SDES2PATSEARCH"",29,0)"
^XMB(3.9,146099,2,2768,0)=" ;"
^XMB(3.9,146099,2,2769,0)="""RTN"",""SDES2PATSEARCH"",30,0)"
^XMB(3.9,146099,2,2770,0)=" D BUILDPATIENTLIST(.PATIENTLIST,$G(SEARCHSTRING),$G(NUMOFRECORDS),$G(INDEX))"
^XMB(3.9,146099,2,2771,0)="""RTN"",""SDES2PATSEARCH"",31,0)"
^XMB(3.9,146099,2,2772,0)=" ;"
^XMB(3.9,146099,2,2773,0)="""RTN"",""SDES2PATSEARCH"",32,0)"
^XMB(3.9,146099,2,2774,0)=" I '$D(PATIENTLIST) S PATIENTLIST(""Patient"",1)="""""
^XMB(3.9,146099,2,2775,0)="""RTN"",""SDES2PATSEARCH"",33,0)"
^XMB(3.9,146099,2,2776,0)=" M RETURN=PATIENTLIST D BUILDJSON(.JSONRETURN,.RETURN)"
^XMB(3.9,146099,2,2777,0)="""RTN"",""SDES2PATSEARCH"",34,0)"
^XMB(3.9,146099,2,2778,0)=" Q"
^XMB(3.9,146099,2,2779,0)="""RTN"",""SDES2PATSEARCH"",35,0)"
^XMB(3.9,146099,2,2780,0)=" ;"
^XMB(3.9,146099,2,2781,0)="""RTN"",""SDES2PATSEARCH"",36,0)"
^XMB(3.9,146099,2,2782,0)="POPULATEINPUTS(PARAMS,SEARCHSTRING,NUMOFRECORDS,INDEX) ;"
^XMB(3.9,146099,2,2783,0)="""RTN"",""SDES2PATSEARCH"",37,0)"
^XMB(3.9,146099,2,2784,0)=" S NUMOFRECORDS=$G(PARAMS(""NUMOFRECORDS""))"
^XMB(3.9,146099,2,2785,0)="""RTN"",""SDES2PATSEARCH"",38,0)"
^XMB(3.9,146099,2,2786,0)=" S SEARCHSTRING=$G(PARAMS(""SEARCHSTRING""))"
^XMB(3.9,146099,2,2787,0)="""RTN"",""SDES2PATSEARCH"",39,0)"
^XMB(3.9,146099,2,2788,0)=" S SEARCHSTRING=$E(SEARCHSTRING,1,30)"
^XMB(3.9,146099,2,2789,0)="""RTN"",""SDES2PATSEARCH"",40,0)"
^XMB(3.9,146099,2,2790,0)=" S SEARCHSTRING=$$CTRL^XMXUTIL1(SEARCHSTRING)"
^XMB(3.9,146099,2,2791,0)="""RTN"",""SDES2PATSEARCH"",41,0)"
^XMB(3.9,146099,2,2792,0)=" S INDEX=$$INDEX(.SEARCHSTRING)"
^XMB(3.9,146099,2,2793,0)="""RTN"",""SDES2PATSEARCH"",42,0)"
^XMB(3.9,146099,2,2794,0)=" Q"
^XMB(3.9,146099,2,2795,0)="""RTN"",""SDES2PATSEARCH"",43,0)"
^XMB(3.9,146099,2,2796,0)=" ;"
^XMB(3.9,146099,2,2797,0)="""RTN"",""SDES2PATSEARCH"",44,0)"
^XMB(3.9,146099,2,2798,0)="INDEX(SEARCHSTRING) ; returns the index to be searched in ^DPT"
^XMB(3.9,146099,2,2799,0)="""RTN"",""SDES2PATSEARCH"",45,0)"
^XMB(3.9,146099,2,2800,0)=" I $G(SEARCHSTRING)?1A4N Q ""BS5"" ;initial+4SSN"
^XMB(3.9,146099,2,2801,0)="""RTN"",""SDES2PATSEARCH"",46,0)"
^XMB(3.9,146099,2,2802,0)=" ;"
^XMB(3.9,146099,2,2803,0)="""RTN"",""SDES2PATSEARCH"",47,0)"
^XMB(3.9,146099,2,2804,0)=" I $$ISOTFM^SDAMUTDT($G(SEARCHSTRING))'=-1 D  Q ""ADOB"" ;DOB"
^XMB(3.9,146099,2,2805,0)="""RTN"",""SDES2PATSEARCH"",48,0)"
^XMB(3.9,146099,2,2806,0)=" .S SEARCHSTRING=$$ISOTFM^SDAMUTDT($G(SEARCHSTRING))"
^XMB(3.9,146099,2,2807,0)="""RTN"",""SDES2PATSEARCH"",49,0)"
^XMB(3.9,146099,2,2808,0)=" ;"
^XMB(3.9,146099,2,2809,0)="""RTN"",""SDES2PATSEARCH"",50,0)"
^XMB(3.9,146099,2,2810,0)=" I $G(SEARCHSTRING)?9N!($G(SEARCHSTRING)?3N1""-""2N1""-""4N)!($G(SEARCHSTRING)?9N.1""P"")!($G(SEARCHSTRING)?3N1""-""2N1""-""4N.1""P"") D  Q ""SSN"" ;SSN"
^XMB(3.9,146099,2,2811,0)="""RTN"",""SDES2PATSEARCH"",51,0)"
^XMB(3.9,146099,2,2812,0)=" .S SEARCHSTRING=$TR($G(SEARCHSTRING),""-"","""")"
^XMB(3.9,146099,2,2813,0)="""RTN"",""SDES2PATSEARCH"",52,0)"
^XMB(3.9,146099,2,2814,0)=" ;"
^XMB(3.9,146099,2,2815,0)="""RTN"",""SDES2PATSEARCH"",53,0)"
^XMB(3.9,146099,2,2816,0)=" Q ""B"""
^XMB(3.9,146099,2,2817,0)="""RTN"",""SDES2PATSEARCH"",54,0)"
^XMB(3.9,146099,2,2818,0)=" ;"
^XMB(3.9,146099,2,2819,0)="""RTN"",""SDES2PATSEARCH"",55,0)"
^XMB(3.9,146099,2,2820,0)="BUILDPATIENTLIST(PATIENTLIST,SEARCHSTRING,NUMOFRECORDS,INDEX) ;"
^XMB(3.9,146099,2,2821,0)="""RTN"",""SDES2PATSEARCH"",56,0)"
^XMB(3.9,146099,2,2822,0)=" N NUM,DFN,SEARCHCRITERIA,USED"
^XMB(3.9,146099,2,2823,0)="""RTN"",""SDES2PATSEARCH"",57,0)"
^XMB(3.9,146099,2,2824,0)=" ;"
^XMB(3.9,146099,2,2825,0)="""RTN"",""SDES2PATSEARCH"",58,0)"
^XMB(3.9,146099,2,2826,0)=" I INDEX=""B"" S SEARCHSTRING=$$TRAILINGSPACES(SEARCHSTRING)"
^XMB(3.9,146099,2,2827,0)="""RTN"",""SDES2PATSEARCH"",59,0)"
^XMB(3.9,146099,2,2828,0)=" I SEARCHSTRING?9N D"
^XMB(3.9,146099,2,2829,0)="""RTN"",""SDES2PATSEARCH"",60,0)"
^XMB(3.9,146099,2,2830,0)=" . I $E(SEARCHSTRING,1)=0,$E(SEARCHSTRING,9)=0 S SEARCHCRITERIA=$E(SEARCHSTRING,1,8)_""/"" Q"
^XMB(3.9,146099,2,2831,0)="""RTN"",""SDES2PATSEARCH"",61,0)"
^XMB(3.9,146099,2,2832,0)=" . I $E(SEARCHSTRING,1)=0,$E(SEARCHSTRING,9)>0 S SEARCHCRITERIA=$E(SEARCHSTRING,1,8)_($E(SEARCHSTRING,9)-1) Q"
^XMB(3.9,146099,2,2833,0)="""RTN"",""SDES2PATSEARCH"",62,0)"
^XMB(3.9,146099,2,2834,0)=" . I $E(SEARCHSTRING,1)>0 S SEARCHCRITERIA=SEARCHSTRING-1"
^XMB(3.9,146099,2,2835,0)="""RTN"",""SDES2PATSEARCH"",63,0)"
^XMB(3.9,146099,2,2836,0)=" I SEARCHSTRING'?9N S SEARCHCRITERIA=$$GETSUB^SDES2UTIL(SEARCHSTRING) ; If not full SSN decrement all input types by 1"
^XMB(3.9,146099,2,2837,0)="""RTN"",""SDES2PATSEARCH"",64,0)"
^XMB(3.9,146099,2,2838,0)=" I $G(SEARCHSTRING)="""" S SEARCHCRITERIA=0"
^XMB(3.9,146099,2,2839,0)="""RTN"",""SDES2PATSEARCH"",65,0)"
^XMB(3.9,146099,2,2840,0)=" S NUM=0"
^XMB(3.9,146099,2,2841,0)="""RTN"",""SDES2PATSEARCH"",66,0)"
^XMB(3.9,146099,2,2842,0)=" F  S SEARCHCRITERIA=$O(^DPT(INDEX,SEARCHCRITERIA)) Q:SEARCHCRITERIA=""""!(NUM=NUMOFRECORDS)!(SEARCHCRITERIA'[SEARCHSTRING)  D"
^XMB(3.9,146099,2,2843,0)="""RTN"",""SDES2PATSEARCH"",67,0)"
