^XMB(3.9,146106,2,3231,0)="""RTN"",""SDES2VAL200"",13,0)"
^XMB(3.9,146106,2,3232,0)="VALUSERDUZ(SDERRORS,SDUSERDUZ,SDISREQUIRED) ; Validate DUZ"
^XMB(3.9,146106,2,3233,0)="""RTN"",""SDES2VAL200"",14,0)"
^XMB(3.9,146106,2,3234,0)=" I SDUSERDUZ="""",$G(SDISREQUIRED) D ERRLOG^SDES2JSON(.SDERRORS,441) Q"
^XMB(3.9,146106,2,3235,0)="""RTN"",""SDES2VAL200"",15,0)"
^XMB(3.9,146106,2,3236,0)=" I SDUSERDUZ="""" Q"
^XMB(3.9,146106,2,3237,0)="""RTN"",""SDES2VAL200"",16,0)"
^XMB(3.9,146106,2,3238,0)=" I '$D(^VA(200,SDUSERDUZ,0)) D ERRLOG^SDES2JSON(.SDERRORS,442,""""_SDUSERDUZ) Q"
^XMB(3.9,146106,2,3239,0)="""RTN"",""SDES2VAL200"",17,0)"
^XMB(3.9,146106,2,3240,0)=" I $$GET1^DIQ(200,SDUSERDUZ,.01,""E"")=""SDESOITEAS,SRV"" Q"
^XMB(3.9,146106,2,3241,0)="""RTN"",""SDES2VAL200"",18,0)"
^XMB(3.9,146106,2,3242,0)=" I '$$ACTIVE^XUSER(SDUSERDUZ) D ERRLOG^SDES2JSON(.SDERRORS,458)"
^XMB(3.9,146106,2,3243,0)="""RTN"",""SDES2VAL200"",19,0)"
^XMB(3.9,146106,2,3244,0)=" Q"
^XMB(3.9,146106,2,3245,0)="""RTN"",""SDES2VAL200"",20,0)"
^XMB(3.9,146106,2,3246,0)=" ;"
^XMB(3.9,146106,2,3247,0)="""RTN"",""SDES2VAL200"",21,0)"
^XMB(3.9,146106,2,3248,0)="VALPROVIDER(SDERRORS,SDPROV,SDISREQUIRED) ; Validate Provider"
^XMB(3.9,146106,2,3249,0)="""RTN"",""SDES2VAL200"",22,0)"
^XMB(3.9,146106,2,3250,0)=" N SDPROVSTATUS"
^XMB(3.9,146106,2,3251,0)="""RTN"",""SDES2VAL200"",23,0)"
^XMB(3.9,146106,2,3252,0)=" I SDPROV="""",$G(SDISREQUIRED) D ERRLOG^SDES2JSON(.SDERRORS,53) Q"
^XMB(3.9,146106,2,3253,0)="""RTN"",""SDES2VAL200"",24,0)"
^XMB(3.9,146106,2,3254,0)=" I SDPROV="""" Q"
^XMB(3.9,146106,2,3255,0)="""RTN"",""SDES2VAL200"",25,0)"
^XMB(3.9,146106,2,3256,0)=" I '$D(^VA(200,SDPROV,0)) D ERRLOG^SDES2JSON(.SDERRORS,54) Q"
^XMB(3.9,146106,2,3257,0)="""RTN"",""SDES2VAL200"",26,0)"
^XMB(3.9,146106,2,3258,0)=" S SDPROVSTATUS=$$PROVIDER^XUSER(SDPROV)"
^XMB(3.9,146106,2,3259,0)="""RTN"",""SDES2VAL200"",27,0)"
^XMB(3.9,146106,2,3260,0)=" I '+SDPROVSTATUS D"
^XMB(3.9,146106,2,3261,0)="""RTN"",""SDES2VAL200"",28,0)"
^XMB(3.9,146106,2,3262,0)=" . I $P(SDPROVSTATUS,U,2)=""NOT A PROVIDER"" D ERRLOG^SDES2JSON(.SDERRORS,52,""User is not a provider.""_SDPROV) Q"
^XMB(3.9,146106,2,3263,0)="""RTN"",""SDES2VAL200"",29,0)"
^XMB(3.9,146106,2,3264,0)=" . I $P(SDPROVSTATUS,U,2)=""TERMINATED"" D ERRLOG^SDES2JSON(.SDERRORS,460,SDPROV) Q"
^XMB(3.9,146106,2,3265,0)="""RTN"",""SDES2VAL200"",30,0)"
^XMB(3.9,146106,2,3266,0)=" I '$$ACTIVPRV^PXAPI(SDPROV,DT) D ERRLOG^SDES2JSON(.SDERRORS,460) Q  ;DBIA #2349"
^XMB(3.9,146106,2,3267,0)="""RTN"",""SDES2VAL200"",31,0)"
^XMB(3.9,146106,2,3268,0)=" Q"
^XMB(3.9,146106,2,3269,0)="""RTN"",""SDES2VAL200"",32,0)"
^XMB(3.9,146106,2,3270,0)=" ;"
^XMB(3.9,146106,2,3271,0)="""RTN"",""SDES2VAL200"",33,0)"
^XMB(3.9,146106,2,3272,0)="VALACTIVUSER(SDERRORS,SDUSERDUZ) ; Active User"
^XMB(3.9,146106,2,3273,0)="""RTN"",""SDES2VAL200"",34,0)"
^XMB(3.9,146106,2,3274,0)=" Q '$$ACTIVE^XUSER(SDUSERDUZ)"
^XMB(3.9,146106,2,3275,0)="""RTN"",""SDES2VAL200"",35,0)"
^XMB(3.9,146106,2,3276,0)=" ;"
^XMB(3.9,146106,2,3277,0)="""RTN"",""SDES2VAL200"",36,0)"
^XMB(3.9,146106,2,3278,0)="VALSECID(SDERRORS,SDSECID) ;"
^XMB(3.9,146106,2,3279,0)="""RTN"",""SDES2VAL200"",37,0)"
^XMB(3.9,146106,2,3280,0)=" I SDSECID="""" Q"
^XMB(3.9,146106,2,3281,0)="""RTN"",""SDES2VAL200"",38,0)"
^XMB(3.9,146106,2,3282,0)=" I $L(SDSECID)<3!$L(SDSECID)>40 D ERRLOG^SDES2JSON(.SDERRORS,156) Q"
^XMB(3.9,146106,2,3283,0)="""RTN"",""SDES2VAL200"",39,0)"
^XMB(3.9,146106,2,3284,0)=" I '$$FIND1^DIC(200,,""X"",SDSECID,""ASECID"",,""SCERR"") D ERRLOG^SDES2JSON(.SDERRORS,156)"
^XMB(3.9,146106,2,3285,0)="""RTN"",""SDES2VAL200"",40,0)"
^XMB(3.9,146106,2,3286,0)=" Q"
^XMB(3.9,146106,2,3287,0)="""RTN"",""SDES2VALCONTEXT"")"
^XMB(3.9,146106,2,3288,0)="0^11^B5084950"
^XMB(3.9,146106,2,3289,0)="""RTN"",""SDES2VALCONTEXT"",1,0)"
^XMB(3.9,146106,2,3290,0)="SDES2VALCONTEXT ;ALB/MGD,LAB,LAB,RN - ACHERON CONTEXT VALIDATION UTILITIES ;JUL 14,2026"
^XMB(3.9,146106,2,3291,0)="""RTN"",""SDES2VALCONTEXT"",2,0)"
^XMB(3.9,146106,2,3292,0)=" ;;5.3;Scheduling;**853,860,895,951**;Aug 13, 1993;Build 0"
^XMB(3.9,146106,2,3293,0)="""RTN"",""SDES2VALCONTEXT"",3,0)"
^XMB(3.9,146106,2,3294,0)=" ;;Per VHA Directive 6402, this routine should not be modified"
^XMB(3.9,146106,2,3295,0)="""RTN"",""SDES2VALCONTEXT"",4,0)"
^XMB(3.9,146106,2,3296,0)=" ;"
^XMB(3.9,146106,2,3297,0)="""RTN"",""SDES2VALCONTEXT"",5,0)"
^XMB(3.9,146106,2,3298,0)=" Q"
^XMB(3.9,146106,2,3299,0)="""RTN"",""SDES2VALCONTEXT"",6,0)"
^XMB(3.9,146106,2,3300,0)=" ;"
^XMB(3.9,146106,2,3301,0)="""RTN"",""SDES2VALCONTEXT"",7,0)"
^XMB(3.9,146106,2,3302,0)="VALCONTEXT(SDERRORS,SDCONTEXT) ; Validate SDCONTEXT Array"
^XMB(3.9,146106,2,3303,0)="""RTN"",""SDES2VALCONTEXT"",8,0)"
^XMB(3.9,146106,2,3304,0)=" ; Required Input Variables"
^XMB(3.9,146106,2,3305,0)="""RTN"",""SDES2VALCONTEXT"",9,0)"
^XMB(3.9,146106,2,3306,0)=" D VALACHERONID(.SDERRORS,$G(SDCONTEXT(""ACHERON AUDIT ID"")))"
^XMB(3.9,146106,2,3307,0)="""RTN"",""SDES2VALCONTEXT"",10,0)"
^XMB(3.9,146106,2,3308,0)=" ; Optional Input Variables"
^XMB(3.9,146106,2,3309,0)="""RTN"",""SDES2VALCONTEXT"",11,0)"
^XMB(3.9,146106,2,3310,0)=" I $G(SDCONTEXT(""PATIENT DFN""))'="""" D VALPATDFN^SDES2VAL2(.SDERRORS,SDCONTEXT(""PATIENT DFN""))"
^XMB(3.9,146106,2,3311,0)="""RTN"",""SDES2VALCONTEXT"",12,0)"
^XMB(3.9,146106,2,3312,0)=" I $G(SDCONTEXT(""PATIENT ICN""))'="""" D VALPATICN^SDES2VAL2(.SDERRORS,SDCONTEXT(""PATIENT ICN""))"
^XMB(3.9,146106,2,3313,0)="""RTN"",""SDES2VALCONTEXT"",13,0)"
^XMB(3.9,146106,2,3314,0)=" I $G(SDCONTEXT(""USER DUZ""))'="""" D VALUSERDUZ^SDES2VAL200(.SDERRORS,SDCONTEXT(""USER DUZ""))"
^XMB(3.9,146106,2,3315,0)="""RTN"",""SDES2VALCONTEXT"",14,0)"
^XMB(3.9,146106,2,3316,0)=" I $G(SDCONTEXT(""USER SECID""))'="""" D VALSECID(.SDERRORS,SDCONTEXT(""USER SECID""),$G(SDCONTEXT(""USER DUZ"")))"
^XMB(3.9,146106,2,3317,0)="""RTN"",""SDES2VALCONTEXT"",15,0)"
^XMB(3.9,146106,2,3318,0)=" I $G(SDCONTEXT(""APPID""))'="""" D VALAPPID(.SDERRORS,SDCONTEXT(""APPID""))"
^XMB(3.9,146106,2,3319,0)="""RTN"",""SDES2VALCONTEXT"",16,0)"
^XMB(3.9,146106,2,3320,0)=" I '$D(SDERRORS) D"
^XMB(3.9,146106,2,3321,0)="""RTN"",""SDES2VALCONTEXT"",17,0)"
^XMB(3.9,146106,2,3322,0)=" . D DFNICNMATCH(.SDERRORS,$G(SDCONTEXT(""PATIENT DFN"")),$G(SDCONTEXT(""PATIENT ICN"")))"
^XMB(3.9,146106,2,3323,0)="""RTN"",""SDES2VALCONTEXT"",18,0)"
^XMB(3.9,146106,2,3324,0)=" Q"
^XMB(3.9,146106,2,3325,0)="""RTN"",""SDES2VALCONTEXT"",19,0)"
^XMB(3.9,146106,2,3326,0)=" ;"
^XMB(3.9,146106,2,3327,0)="""RTN"",""SDES2VALCONTEXT"",20,0)"
^XMB(3.9,146106,2,3328,0)="VALACHERONID(SDERRORS,SDACHERONID) ; Validate Acheron EAS ID"
^XMB(3.9,146106,2,3329,0)="""RTN"",""SDES2VALCONTEXT"",21,0)"
^XMB(3.9,146106,2,3330,0)=" I SDACHERONID="""" D ERRLOG^SDES2JSON(.SDERRORS,474) Q"
^XMB(3.9,146106,2,3331,0)="""RTN"",""SDES2VALCONTEXT"",22,0)"
^XMB(3.9,146106,2,3332,0)=" I $$VALACHERONID^SDES2UTIL(SDACHERONID)=-1 D ERRLOG^SDES2JSON(.SDERRORS,475)"
^XMB(3.9,146106,2,3333,0)="""RTN"",""SDES2VALCONTEXT"",23,0)"
^XMB(3.9,146106,2,3334,0)=" Q"
^XMB(3.9,146106,2,3335,0)="""RTN"",""SDES2VALCONTEXT"",24,0)"
^XMB(3.9,146106,2,3336,0)=" ;"
^XMB(3.9,146106,2,3337,0)="""RTN"",""SDES2VALCONTEXT"",25,0)"
^XMB(3.9,146106,2,3338,0)="DFNICNMATCH(SDERRORS,PATDFN,PATICN) ;verify that sent in values are same for patient"
^XMB(3.9,146106,2,3339,0)="""RTN"",""SDES2VALCONTEXT"",26,0)"
^XMB(3.9,146106,2,3340,0)=" I (PATDFN'="""")&(PATICN'="""") D"
^XMB(3.9,146106,2,3341,0)="""RTN"",""SDES2VALCONTEXT"",27,0)"
^XMB(3.9,146106,2,3342,0)=" . I $O(^DPT(""AICN"",PATICN,""""))'=PATDFN D ERRLOG^SDES2JSON(.SDERRORS,516)"
^XMB(3.9,146106,2,3343,0)="""RTN"",""SDES2VALCONTEXT"",28,0)"
^XMB(3.9,146106,2,3344,0)=" Q"
^XMB(3.9,146106,2,3345,0)="""RTN"",""SDES2VALCONTEXT"",29,0)"
^XMB(3.9,146106,2,3346,0)=" ;"
^XMB(3.9,146106,2,3347,0)="""RTN"",""SDES2VALCONTEXT"",30,0)"
^XMB(3.9,146106,2,3348,0)="VALSECID(SDERRORS,SDSECID,SDUSERDUZ) ;"
^XMB(3.9,146106,2,3349,0)="""RTN"",""SDES2VALCONTEXT"",31,0)"
^XMB(3.9,146106,2,3350,0)=" I SDSECID="""" Q"
^XMB(3.9,146106,2,3351,0)="""RTN"",""SDES2VALCONTEXT"",32,0)"
^XMB(3.9,146106,2,3352,0)=" I $L(SDSECID)<3!$L(SDSECID)>40 D ERRLOG^SDES2JSON(.SDERRORS,156) Q"
^XMB(3.9,146106,2,3353,0)="""RTN"",""SDES2VALCONTEXT"",33,0)"
^XMB(3.9,146106,2,3354,0)=" I $$GET1^DIQ(200,SDUSERDUZ,205.1,""I"")'=SDSECID D ERRLOG^SDES2JSON(.SDERRORS,156)"
^XMB(3.9,146106,2,3355,0)="""RTN"",""SDES2VALCONTEXT"",34,0)"
^XMB(3.9,146106,2,3356,0)=" Q"
^XMB(3.9,146106,2,3357,0)="""RTN"",""SDES2VALCONTEXT"",35,0)"
^XMB(3.9,146106,2,3358,0)=" ;"
^XMB(3.9,146106,2,3359,0)="""RTN"",""SDES2VALCONTEXT"",36,0)"
^XMB(3.9,146106,2,3360,0)="VALAPPID(SDERRORS,SDAPPID) ;"
^XMB(3.9,146106,2,3361,0)="""RTN"",""SDES2VALCONTEXT"",37,0)"
^XMB(3.9,146106,2,3362,0)=" I SDAPPID="""" Q"
^XMB(3.9,146106,2,3363,0)="""RTN"",""SDES2VALCONTEXT"",38,0)"
^XMB(3.9,146106,2,3364,0)=" I $L(SDAPPID)>40 D ERRLOG^SDES2JSON(.SDERRORS,52,""EAS APPID more than 40 characters"")"
^XMB(3.9,146106,2,3365,0)="""RTN"",""SDES2VALCONTEXT"",39,0)"
^XMB(3.9,146106,2,3366,0)=" Q"
^XMB(3.9,146106,2,3367,0)="""VER"")"
