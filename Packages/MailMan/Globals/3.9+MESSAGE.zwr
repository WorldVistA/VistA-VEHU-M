^XMB(3.9,146015,2,248,0)="0^1^B23547289"
^XMB(3.9,146015,2,249,0)="""RTN"",""PSODEM"",1,0)"
^XMB(3.9,146015,2,250,0)="PSODEM ;BIR/SAB - PATIENT DEMOGRAPHICS ;Jan 21, 2021@16:15"
^XMB(3.9,146015,2,251,0)="""RTN"",""PSODEM"",2,0)"
^XMB(3.9,146015,2,252,0)=" ;;7.0;OUTPATIENT PHARMACY;**5,19,233,258,326,390,411,402,500,452,556,622**;DEC 1997;Build 0"
^XMB(3.9,146015,2,253,0)="""RTN"",""PSODEM"",3,0)"
^XMB(3.9,146015,2,254,0)=" ;External reference to ^GMRADPT supported by DBIA 10099"
^XMB(3.9,146015,2,255,0)="""RTN"",""PSODEM"",4,0)"
^XMB(3.9,146015,2,256,0)=" ;External reference to ^DIC(31 supported by DBIA 658"
^XMB(3.9,146015,2,257,0)="""RTN"",""PSODEM"",5,0)"
^XMB(3.9,146015,2,258,0)=" ;External reference to $$BSA^PSSDSAPI supported by DBIA 5425"
^XMB(3.9,146015,2,259,0)="""RTN"",""PSODEM"",6,0)"
^XMB(3.9,146015,2,260,0)=" ;"
^XMB(3.9,146015,2,261,0)="""RTN"",""PSODEM"",7,0)"
^XMB(3.9,146015,2,262,0)=" ;RTW BEGIN PATIENT DEMOGRAPHIC CHANGE INFORMATION---------------------------"
^XMB(3.9,146015,2,263,0)="""RTN"",""PSODEM"",8,0)"
^XMB(3.9,146015,2,264,0)=" ;EPIP NSR20151001 PATIENT DEMOGRAPHICS and Clinical Alerts added"
^XMB(3.9,146015,2,265,0)="""RTN"",""PSODEM"",9,0)"
^XMB(3.9,146015,2,266,0)=" ;output, which will appear right after the Pharmacy Narrative:"
^XMB(3.9,146015,2,267,0)="""RTN"",""PSODEM"",10,0)"
^XMB(3.9,146015,2,268,0)=" ;   * Primary Care Team and their office Phone"
^XMB(3.9,146015,2,269,0)="""RTN"",""PSODEM"",11,0)"
^XMB(3.9,146015,2,270,0)=" ;   * PC Provider and Position"
^XMB(3.9,146015,2,271,0)="""RTN"",""PSODEM"",12,0)"
^XMB(3.9,146015,2,272,0)=" ;   * PC Provider's pager and office phone number"
^XMB(3.9,146015,2,273,0)="""RTN"",""PSODEM"",13,0)"
^XMB(3.9,146015,2,274,0)=" ;   * Current facility (or institution) of the Patient based on PC Team or appointment & visit history}"
^XMB(3.9,146015,2,275,0)="""RTN"",""PSODEM"",14,0)"
^XMB(3.9,146015,2,276,0)=" ;   * Patient file REMARKS"
^XMB(3.9,146015,2,277,0)="""RTN"",""PSODEM"",15,0)"
^XMB(3.9,146015,2,278,0)=" ;   * Clinical Alerts (for example, when a patient part of a researh study)"
^XMB(3.9,146015,2,279,0)="""RTN"",""PSODEM"",16,0)"
^XMB(3.9,146015,2,280,0)=" ;   * then pause the screen until the user pressed the <ENTER> key"
^XMB(3.9,146015,2,281,0)="""RTN"",""PSODEM"",17,0)"
^XMB(3.9,146015,2,282,0)=" ;RTW END PATIENT DEMOGRAPHIC CHANGE INFORMATION---------------------------"
^XMB(3.9,146015,2,283,0)="""RTN"",""PSODEM"",18,0)"
^XMB(3.9,146015,2,284,0)="GET S DFN=DA D 6^VADPT,PID^VADPT U IO W @IOF,!,VADM(1)"
^XMB(3.9,146015,2,285,0)="""RTN"",""PSODEM"",19,0)"
^XMB(3.9,146015,2,286,0)=" I +VAPA(9) W !?5,""(TEMP ADDRESS from ""_$P(VAPA(9),""^"",2)_"" till ""_$S($P(VAPA(10),""^"",2)]"""":$P(VAPA(10),""^"",2),1:""(no end date)"")_"")"""
