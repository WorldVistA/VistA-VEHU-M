^XMB(3.9,146018,2,1868,0)=" N CURR,DIERR,DIMSG,DIHELP,FDA,MSG,NCIENS"
^XMB(3.9,146018,2,1869,0)="""RTN"",""VAFCPTAD"",277,0)"
^XMB(3.9,146018,2,1870,0)=" Q:$G(NAME)?.""^"" 0"
^XMB(3.9,146018,2,1871,0)="""RTN"",""VAFCPTAD"",278,0)"
^XMB(3.9,146018,2,1872,0)=" Q:$G(VAFCDFN)'>0 0"
^XMB(3.9,146018,2,1873,0)="""RTN"",""VAFCPTAD"",279,0)"
^XMB(3.9,146018,2,1874,0)=" S NCIENS=$P($G(^DPT(+VAFCDFN,""NAME"")),U)_"","" Q:'NCIENS 0"
^XMB(3.9,146018,2,1875,0)="""RTN"",""VAFCPTAD"",280,0)"
^XMB(3.9,146018,2,1876,0)=" ;"
^XMB(3.9,146018,2,1877,0)="""RTN"",""VAFCPTAD"",281,0)"
^XMB(3.9,146018,2,1878,0)=" ;Get current values"
