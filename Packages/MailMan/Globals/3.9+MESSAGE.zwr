^XMB(3.9,146087,2,4210,0)="destination account, the JSON data may be used to update Mental Health"
^XMB(3.9,146087,2,4211,0)="""^DIC"",601.95,601.95,""%D"",5,0)"
^XMB(3.9,146087,2,4212,0)="instrument files.  This allows the specification for Mental Health"
^XMB(3.9,146087,2,4213,0)="""^DIC"",601.95,601.95,""%D"",6,0)"
^XMB(3.9,146087,2,4214,0)="instruments to be transmitted via a KIDS build or a host file.  It "
^XMB(3.9,146087,2,4215,0)="""^DIC"",601.95,601.95,""%D"",7,0)"
^XMB(3.9,146087,2,4216,0)="also allows instrument specifications to be backed up."
^XMB(3.9,146087,2,4217,0)="""^DIC"",601.95,""B"",""MH INSTRUMENT EXCHANGE"",601.95)"
^XMB(3.9,146087,2,4218,0)=""
