^XMB(3.9,146036,2,2050,0)=" ;;2.7;AMIE;**250,252,254,255**;Apr 10, 1995;Build 0"
^XMB(3.9,146036,2,2051,0)="""RTN"",""DVBCTXML"",3,0)"
^XMB(3.9,146036,2,2052,0)=" ; Per VHA Directive 6402 this routine should not be modified"
