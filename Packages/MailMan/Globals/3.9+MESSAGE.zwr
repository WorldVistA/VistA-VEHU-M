^XMB(3.9,146091,2,325,0)="""RTN"",""MAGQBUT4"",38,0)"
^XMB(3.9,146091,2,326,0)=" S RESULT=$S(CVERS=VER:1,1:0)_U_CVERS"
^XMB(3.9,146091,2,327,0)="""RTN"",""MAGQBUT4"",39,0)"
^XMB(3.9,146091,2,328,0)=" Q"
^XMB(3.9,146091,2,329,0)="""RTN"",""MAGQBUT4"",40,0)"
^XMB(3.9,146091,2,330,0)=" ; "
^XMB(3.9,146091,2,331,0)="""RTN"",""MAGQBUT4"",41,0)"
^XMB(3.9,146091,2,332,0)="CONV(ARR,ICT) ;Convert any single node array to FM Style multiple"
^XMB(3.9,146091,2,333,0)="""RTN"",""MAGQBUT4"",42,0)"
^XMB(3.9,146091,2,334,0)=" ;  The node subscripts of ARR are ignored, and not retained"
^XMB(3.9,146091,2,335,0)="""RTN"",""MAGQBUT4"",43,0)"
^XMB(3.9,146091,2,336,0)=" ; i.e.  ARR(34)=8"
^XMB(3.9,146091,2,337,0)="""RTN"",""MAGQBUT4"",44,0)"
^XMB(3.9,146091,2,338,0)=" ;       ARR(""BLUE"")=9"
^XMB(3.9,146091,2,339,0)="""RTN"",""MAGQBUT4"",45,0)"
^XMB(3.9,146091,2,340,0)=" ;       ARR(""D"")=10"
^XMB(3.9,146091,2,341,0)="""RTN"",""MAGQBUT4"",46,0)"
^XMB(3.9,146091,2,342,0)=" ; converts to"
^XMB(3.9,146091,2,343,0)="""RTN"",""MAGQBUT4"",47,0)"
^XMB(3.9,146091,2,344,0)=" ;      ARR(1,0)=8"
^XMB(3.9,146091,2,345,0)="""RTN"",""MAGQBUT4"",48,0)"
^XMB(3.9,146091,2,346,0)=" ;      ARR(2,0)=9"
^XMB(3.9,146091,2,347,0)="""RTN"",""MAGQBUT4"",49,0)"
^XMB(3.9,146091,2,348,0)=" ;      ARR(3,0)=10"
^XMB(3.9,146091,2,349,0)="""RTN"",""MAGQBUT4"",50,0)"
^XMB(3.9,146091,2,350,0)=" N I,ARO"
^XMB(3.9,146091,2,351,0)="""RTN"",""MAGQBUT4"",51,0)"
^XMB(3.9,146091,2,352,0)=" S ICT=0,I="""""
^XMB(3.9,146091,2,353,0)="""RTN"",""MAGQBUT4"",52,0)"
^XMB(3.9,146091,2,354,0)=" F  S I=$O(ARR(I)) Q:(I="""")  D"
^XMB(3.9,146091,2,355,0)="""RTN"",""MAGQBUT4"",53,0)"
^XMB(3.9,146091,2,356,0)=" . S ICT=ICT+1"
^XMB(3.9,146091,2,357,0)="""RTN"",""MAGQBUT4"",54,0)"
^XMB(3.9,146091,2,358,0)=" . S ARO(ICT,0)=ARR(I)"
