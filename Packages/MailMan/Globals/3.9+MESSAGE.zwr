^XMB(3.9,146083,2,233,0)="""RTN"")"
^XMB(3.9,146083,2,234,0)=1
^XMB(3.9,146083,2,235,0)="""RTN"",""XUSNPIE2"")"
^XMB(3.9,146083,2,236,0)="0^1^B91191856"
^XMB(3.9,146083,2,237,0)="""RTN"",""XUSNPIE2"",1,0)"
^XMB(3.9,146083,2,238,0)="XUSNPIE2 ;FO-OAKLAND/JLI - DATA ENTRY FOR INITIAL NPI VALUES ; Dec 16, 2021@08:24:28"
^XMB(3.9,146083,2,239,0)="""RTN"",""XUSNPIE2"",2,0)"
^XMB(3.9,146083,2,240,0)=" ;;8.0;KERNEL;**410,435,454,462,480,519,752,764**;Jul 10, 1995;Build 0"
^XMB(3.9,146083,2,241,0)="""RTN"",""XUSNPIE2"",3,0)"
^XMB(3.9,146083,2,242,0)=" ;;Per VHA Directive 2004-038, this routine should not be modified"
^XMB(3.9,146083,2,243,0)="""RTN"",""XUSNPIE2"",4,0)"
^XMB(3.9,146083,2,244,0)=" Q"
^XMB(3.9,146083,2,245,0)="""RTN"",""XUSNPIE2"",5,0)"
^XMB(3.9,146083,2,246,0)=" ;"
^XMB(3.9,146083,2,247,0)="""RTN"",""XUSNPIE2"",6,0)"
^XMB(3.9,146083,2,248,0)="PRINTOPT ;"
^XMB(3.9,146083,2,249,0)="""RTN"",""XUSNPIE2"",7,0)"
^XMB(3.9,146083,2,250,0)=" N DIR,%ZIS,ION,OPTION,PRNTFRMT,XUSDIV,XUSSORT,XUSRESO,Y,ZTDESC,ZTIO,ZTRTN,ZTSAVE,ZTSK,XUSER"
^XMB(3.9,146083,2,251,0)="""RTN"",""XUSNPIE2"",8,0)"
^XMB(3.9,146083,2,252,0)=" K IO(""Q"")"
^XMB(3.9,146083,2,253,0)="""RTN"",""XUSNPIE2"",9,0)"
^XMB(3.9,146083,2,254,0)=" W !,""Select one of the following:"",!!,?11,""1"",?21,""All providers"",!,?11,""2"",?21,""All providers without NPI numbers"",!"
^XMB(3.9,146083,2,255,0)="""RTN"",""XUSNPIE2"",10,0)"
^XMB(3.9,146083,2,256,0)=" S DIR(0)=""N^1:2"",DIR(""A"")=""Select a report option"",DIR(""B"")=""1"" D ^DIR K DIR Q:Y'>0  S OPTION=+Y"
^XMB(3.9,146083,2,257,0)="""RTN"",""XUSNPIE2"",11,0)"
^XMB(3.9,146083,2,258,0)=" S XUSRESO="""" D  Q:XUSRESO="""""
^XMB(3.9,146083,2,259,0)="""RTN"",""XUSNPIE2"",12,0)"
^XMB(3.9,146083,2,260,0)=" . S DIR(0)=""S^P:Providers who are not residents;R:Residents only;B:Both"""
^XMB(3.9,146083,2,261,0)="""RTN"",""XUSNPIE2"",13,0)"
^XMB(3.9,146083,2,262,0)=" . S DIR(""B"")=""P"",DIR(""A"")=""Selection: """
^XMB(3.9,146083,2,263,0)="""RTN"",""XUSNPIE2"",14,0)"
^XMB(3.9,146083,2,264,0)=" . D ^DIR K DIR Q:""PRB""'[Y"
^XMB(3.9,146083,2,265,0)="""RTN"",""XUSNPIE2"",15,0)"
^XMB(3.9,146083,2,266,0)=" . S XUSRESO=Y Q"
^XMB(3.9,146083,2,267,0)="""RTN"",""XUSNPIE2"",16,0)"
^XMB(3.9,146083,2,268,0)=" ; Change of XU*8*519 #1 (add 3 lines of code below)"
^XMB(3.9,146083,2,269,0)="""RTN"",""XUSNPIE2"",17,0)"
^XMB(3.9,146083,2,270,0)=" W !!,""Select one of the following:"",!!,?11,""1"",?21,""ACTIVE users only"",!,?11,""2"",?21,""ACTIVE and DISUSERed users"",!"
^XMB(3.9,146083,2,271,0)="""RTN"",""XUSNPIE2"",18,0)"
^XMB(3.9,146083,2,272,0)=" S DIR(0)=""N^1:2"",DIR(""A"")=""Select a report option"",DIR(""B"")=""1"" D ^DIR K DIR Q:Y'>0  S XUSER=+Y"
^XMB(3.9,146083,2,273,0)="""RTN"",""XUSNPIE2"",19,0)"
^XMB(3.9,146083,2,274,0)=" ; End XU*8*519 #1"
^XMB(3.9,146083,2,275,0)="""RTN"",""XUSNPIE2"",20,0)"
^XMB(3.9,146083,2,276,0)=" ; "
^XMB(3.9,146083,2,277,0)="""RTN"",""XUSNPIE2"",21,0)"
^XMB(3.9,146083,2,278,0)=" S DIR(0)=""Y"",DIR(""B"")=""NO"",DIR(""A"")=""Sort by DIVISION"" D ^DIR K DIR Q:Y=""^""  S XUSDIV=+Y"
^XMB(3.9,146083,2,279,0)="""RTN"",""XUSNPIE2"",22,0)"
^XMB(3.9,146083,2,280,0)=" S PRNTFRMT=1"
^XMB(3.9,146083,2,281,0)="""RTN"",""XUSNPIE2"",23,0)"
^XMB(3.9,146083,2,282,0)=" I XUSDIV S DIR(0)=""N^1:2"",DIR(""A"")=""Output type (1=Printed text or 2=^-delimited)"" D ^DIR K DIR Q:Y'>0  S PRNTFRMT=Y"
^XMB(3.9,146083,2,283,0)="""RTN"",""XUSNPIE2"",24,0)"
^XMB(3.9,146083,2,284,0)=" S DIR(0)=""Y"",DIR(""B"")=""YES"",DIR(""A"")=""Sort by SERVICE/SECTION""_$S(XUSDIV>0:"" (as well)"",1:"""") D ^DIR K DIR Q:Y=""^""  S XUSSORT=+Y"
^XMB(3.9,146083,2,285,0)="""RTN"",""XUSNPIE2"",25,0)"
^XMB(3.9,146083,2,286,0)=" W !!,"">>> Report processing time is approximately 10 minutes."""
^XMB(3.9,146083,2,287,0)="""RTN"",""XUSNPIE2"",26,0)"
^XMB(3.9,146083,2,288,0)=" W !,""    Recommend text output be queued to a network printer."""
^XMB(3.9,146083,2,289,0)="""RTN"",""XUSNPIE2"",27,0)"
^XMB(3.9,146083,2,290,0)=" W !"
^XMB(3.9,146083,2,291,0)="""RTN"",""XUSNPIE2"",28,0)"
^XMB(3.9,146083,2,292,0)=" S %ZIS=""MQ"" D ^%ZIS Q:POP"
^XMB(3.9,146083,2,293,0)="""RTN"",""XUSNPIE2"",29,0)"
^XMB(3.9,146083,2,294,0)=" I $D(IO(""Q"")) D  Q"
^XMB(3.9,146083,2,295,0)="""RTN"",""XUSNPIE2"",30,0)"
^XMB(3.9,146083,2,296,0)=" . S ZTSAVE(""OPTION"")="""",ZTSAVE(""XUSSORT"")="""",ZTSAVE(""XUSDIV"")="""",ZTSAVE(""PRNTFRMT"")="""",ZTSAVE(""XUSRESO"")="""",ZTSAVE(""XUSER"")="""""
^XMB(3.9,146083,2,297,0)="""RTN"",""XUSNPIE2"",31,0)"
^XMB(3.9,146083,2,298,0)=" . S ZTIO=ION,ZTRTN=""DQ^XUSNPIE2"",ZTDESC=""NPI PRINT JOB FOR OPTION ""_OPTION"
^XMB(3.9,146083,2,299,0)="""RTN"",""XUSNPIE2"",32,0)"
^XMB(3.9,146083,2,300,0)=" . D ^%ZTLOAD W:$D(ZTSK) !,""Queued as Task ""_ZTSK D HOME^%ZIS Q"
^XMB(3.9,146083,2,301,0)="""RTN"",""XUSNPIE2"",33,0)"
^XMB(3.9,146083,2,302,0)=" ;"
^XMB(3.9,146083,2,303,0)="""RTN"",""XUSNPIE2"",34,0)"
^XMB(3.9,146083,2,304,0)="DQ ; entry point for queued print job"
^XMB(3.9,146083,2,305,0)="""RTN"",""XUSNPIE2"",35,0)"
^XMB(3.9,146083,2,306,0)=" U IO D PRNTPROV(OPTION,XUSSORT,XUSDIV,PRNTFRMT,XUSRESO,XUSER)"
^XMB(3.9,146083,2,307,0)="""RTN"",""XUSNPIE2"",36,0)"
^XMB(3.9,146083,2,308,0)=" U IO D ^%ZISC"
^XMB(3.9,146083,2,309,0)="""RTN"",""XUSNPIE2"",37,0)"
^XMB(3.9,146083,2,310,0)=" Q"
^XMB(3.9,146083,2,311,0)="""RTN"",""XUSNPIE2"",38,0)"
^XMB(3.9,146083,2,312,0)=" ;"
^XMB(3.9,146083,2,313,0)="""RTN"",""XUSNPIE2"",39,0)"
^XMB(3.9,146083,2,314,0)="PRNTPROV(OPTION,XUSSORT,XUSDIV,PRNTFRMT,XUSRESO,XUSER) ;"
^XMB(3.9,146083,2,315,0)="""RTN"",""XUSNPIE2"",40,0)"
^XMB(3.9,146083,2,316,0)=" ; PRINT PROVIDER INFO"
^XMB(3.9,146083,2,317,0)="""RTN"",""XUSNPIE2"",41,0)"
^XMB(3.9,146083,2,318,0)=" ;"
^XMB(3.9,146083,2,319,0)="""RTN"",""XUSNPIE2"",42,0)"
^XMB(3.9,146083,2,320,0)=" ; OPTION   SPECIFIES TYPE OF PRINT - 1=ALL PROVIDERS, 2=NEEDS NPI ONLY"
^XMB(3.9,146083,2,321,0)="""RTN"",""XUSNPIE2"",43,0)"
^XMB(3.9,146083,2,322,0)=" ; XUSSORT  INDICATES WHETHER SORTED BY SERVICE/SECTION"
^XMB(3.9,146083,2,323,0)="""RTN"",""XUSNPIE2"",44,0)"
^XMB(3.9,146083,2,324,0)=" ; XUSDIV   INDICATES WHETHER SORTED BY DIVISION"
^XMB(3.9,146083,2,325,0)="""RTN"",""XUSNPIE2"",45,0)"
^XMB(3.9,146083,2,326,0)=" ; PRNTFRMT INDICATES TYPE OF OUTPUT, PRINTED OR ^-DELIMITED"
^XMB(3.9,146083,2,327,0)="""RTN"",""XUSNPIE2"",46,0)"
^XMB(3.9,146083,2,328,0)=" ;"
^XMB(3.9,146083,2,329,0)="""RTN"",""XUSNPIE2"",47,0)"
^XMB(3.9,146083,2,330,0)=" ; ZEXCEPT: IOSL    - KERNEL VARIABLE"
^XMB(3.9,146083,2,331,0)="""RTN"",""XUSNPIE2"",48,0)"
^XMB(3.9,146083,2,332,0)=" S XUSER=$G(XUSER) ;add p 519"
^XMB(3.9,146083,2,333,0)="""RTN"",""XUSNPIE2"",49,0)"
^XMB(3.9,146083,2,334,0)=" N PAGENUM,LINENUM,PROVNAME,TAXDESCR,TAXONOMY,SERVSECT,DIRUT,DTOUT"
^XMB(3.9,146083,2,335,0)="""RTN"",""XUSNPIE2"",50,0)"
^XMB(3.9,146083,2,336,0)=" N GLOBLOC,IEN,NPI,DATETIME,GLOBVALU,NCOUNT,GLOBLOC1,XUSDIVNM,CNTTOTAL,CNTNONE,CNTEXMPT,CNTDONE,MULTDIV,MULTDIVC,XUSDIS"
^XMB(3.9,146083,2,337,0)="""RTN"",""XUSNPIE2"",51,0)"
^XMB(3.9,146083,2,338,0)=" S CNTTOTAL=0,CNTNONE=0,CNTEXMPT=0,CNTDONE=0,XUSDIS="""""
^XMB(3.9,146083,2,339,0)="""RTN"",""XUSNPIE2"",52,0)"
^XMB(3.9,146083,2,340,0)=" S PAGENUM=0,LINENUM=0"
^XMB(3.9,146083,2,341,0)="""RTN"",""XUSNPIE2"",53,0)"
^XMB(3.9,146083,2,342,0)=" S DATETIME=$$NOW^XLFDT()"
^XMB(3.9,146083,2,343,0)="""RTN"",""XUSNPIE2"",54,0)"
^XMB(3.9,146083,2,344,0)=" S XUSNPIBA=""XUSNPIPRNT"""
^XMB(3.9,146083,2,345,0)="""RTN"",""XUSNPIE2"",55,0)"
^XMB(3.9,146083,2,346,0)=" S GLOBLOC1=$$GETDATA(OPTION,XUSSORT,XUSDIV,XUSRESO,XUSER)"
^XMB(3.9,146083,2,347,0)="""RTN"",""XUSNPIE2"",56,0)"
^XMB(3.9,146083,2,348,0)=" I PRNTFRMT'=1 W !,""PROVIDER_NAME^LAST4^IEN^NPI^TAXONOMY_CODE^TAXONOMY DESCRIPTION""_$S(XUSDIV:""^DIVISION"",1:"""")_$S(XUSSORT:""^SERVICE/SECTION"",1:"""")"
^XMB(3.9,146083,2,349,0)="""RTN"",""XUSNPIE2"",57,0)"
^XMB(3.9,146083,2,350,0)=" S GLOBLOC=GLOBLOC1,XUSDIVNM="""" F  S XUSDIVNM=$O(@GLOBLOC1@(XUSDIVNM)) Q:XUSDIVNM=""""  D  Q:$D(DIRUT)!$D(DTOUT)"
^XMB(3.9,146083,2,351,0)="""RTN"",""XUSNPIE2"",58,0)"
^XMB(3.9,146083,2,352,0)=" . S SERVSECT="""" F  S SERVSECT=$O(@GLOBLOC1@(XUSDIVNM,SERVSECT)) Q:SERVSECT=""""  S GLOBLOC=$NA(@GLOBLOC1@(XUSDIVNM,SERVSECT)) D  Q:$D(DIRUT)!$D(DTOUT)"
^XMB(3.9,146083,2,353,0)="""RTN"",""XUSNPIE2"",59,0)"
^XMB(3.9,146083,2,354,0)=" . . I PRNTFRMT=1 D HEADER(OPTION,DATETIME,.PAGENUM,.LINENUM,XUSDIV,XUSDIVNM,XUSSORT,SERVSECT,XUSRESO,XUSER) Q:$D(DIRUT)!$D(DTOUT)"
^XMB(3.9,146083,2,355,0)="""RTN"",""XUSNPIE2"",60,0)"
^XMB(3.9,146083,2,356,0)=" . . S PROVNAME="""" F  S PROVNAME=$O(@GLOBLOC@(PROVNAME)) Q:PROVNAME=""""  Q:$D(DIRUT)!$D(DTOUT)  S IEN=0 F  S IEN=$O(@GLOBLOC@(PROVNAME,IEN)) Q:IEN'>0  D  Q:$D(DIRUT)!$D(DTOUT)"
^XMB(3.9,146083,2,357,0)="""RTN"",""XUSNPIE2"",61,0)"
^XMB(3.9,146083,2,358,0)=" . . . S NCOUNT=0"
^XMB(3.9,146083,2,359,0)="""RTN"",""XUSNPIE2"",62,0)"
^XMB(3.9,146083,2,360,0)=" . . . S TAXDESCR="""" F  S TAXDESCR=$O(@GLOBLOC@(PROVNAME,IEN,TAXDESCR)) Q:TAXDESCR=""""  S GLOBVALU=@GLOBLOC@(PROVNAME,IEN,TAXDESCR) D"
^XMB(3.9,146083,2,361,0)="""RTN"",""XUSNPIE2"",63,0)"
^XMB(3.9,146083,2,362,0)=" . . . . S NPI=$P(GLOBVALU,U,3),TAXONOMY=$P(GLOBVALU,U,4),XUSDIS=$P(GLOBVALU,U,6)"
^XMB(3.9,146083,2,363,0)="""RTN"",""XUSNPIE2"",64,0)"
^XMB(3.9,146083,2,364,0)=" . . . . I PRNTFRMT=1 S NCOUNT=NCOUNT+1 W:NCOUNT=1 !,PROVNAME,?33,$$ALIGNRGT(IEN,11),?49,NPI,?65,XUSDIS W !,?6,TAXONOMY,""  "",TAXDESCR"
^XMB(3.9,146083,2,365,0)="""RTN"",""XUSNPIE2"",65,0)"
^XMB(3.9,146083,2,366,0)=" . . . . I PRNTFRMT'=1 W !,PROVNAME_U_$E($$GET1^DIQ(200,IEN_"","",9),6,9)_U_IEN_U_NPI_U_TAXONOMY_U_TAXDESCR_$S(XUSDIV:U_XUSDIVNM,1:"""")_$S(XUSSORT:U_SERVSECT,1:"""")"
^XMB(3.9,146083,2,367,0)="""RTN"",""XUSNPIE2"",66,0)"
^XMB(3.9,146083,2,368,0)=" . . . . Q"
^XMB(3.9,146083,2,369,0)="""RTN"",""XUSNPIE2"",67,0)"
^XMB(3.9,146083,2,370,0)=" . . . I PRNTFRMT=1 S LINENUM=LINENUM+NCOUNT+1 I LINENUM>(IOSL-4) D HEADER(OPTION,DATETIME,.PAGENUM,.LINENUM,XUSDIV,XUSDIVNM,XUSSORT,SERVSECT,XUSRESO,XUSER) Q:$D(DIRUT)!$D(DTOUT)"
^XMB(3.9,146083,2,371,0)="""RTN"",""XUSNPIE2"",68,0)"
^XMB(3.9,146083,2,372,0)=" . . . Q"
^XMB(3.9,146083,2,373,0)="""RTN"",""XUSNPIE2"",69,0)"
^XMB(3.9,146083,2,374,0)=" . . Q"
^XMB(3.9,146083,2,375,0)="""RTN"",""XUSNPIE2"",70,0)"
^XMB(3.9,146083,2,376,0)=" . Q"
^XMB(3.9,146083,2,377,0)="""RTN"",""XUSNPIE2"",71,0)"
^XMB(3.9,146083,2,378,0)=" I '($D(DIRUT)!$D(DTOUT)),PRNTFRMT=1 D"
^XMB(3.9,146083,2,379,0)="""RTN"",""XUSNPIE2"",72,0)"
^XMB(3.9,146083,2,380,0)=" . S PROVNAME="""" I $O(@GLOBLOC@(PROVNAME))="""" W !,?20,""* * * N O  D A T A  F O U N D * * *"",!! I 1"
^XMB(3.9,146083,2,381,0)="""RTN"",""XUSNPIE2"",73,0)"
^XMB(3.9,146083,2,382,0)=" . E  D"
^XMB(3.9,146083,2,383,0)="""RTN"",""XUSNPIE2"",74,0)"
^XMB(3.9,146083,2,384,0)=" . . N TOTTYP S TOTTYP=$S(XUSRESO=""R"":""Residents"",1:""Billable Providers"")"
^XMB(3.9,146083,2,385,0)="""RTN"",""XUSNPIE2"",75,0)"
^XMB(3.9,146083,2,386,0)=" . . W !!,""Total ""_TOTTYP_"":"",?43,CNTTOTAL,!,TOTTYP_"" with an NPI:"",?43,CNTDONE,!,""EXEMPT ""_TOTTYP_"":"",?43,CNTEXMPT,!,TOTTYP_"" Still Needing an NPI:"",?43,CNTNONE"
^XMB(3.9,146083,2,387,0)="""RTN"",""XUSNPIE2"",76,0)"
^XMB(3.9,146083,2,388,0)=" . . I $G(MULTDIV)>0 W !!,MULTDIV,"" Providers were repeated a total of "",MULTDIVC,"" times"",!,"" due to listing under multiple divisions"""
^XMB(3.9,146083,2,389,0)="""RTN"",""XUSNPIE2"",77,0)"
^XMB(3.9,146083,2,390,0)=" . . Q"
^XMB(3.9,146083,2,391,0)="""RTN"",""XUSNPIE2"",78,0)"
^XMB(3.9,146083,2,392,0)=" . W !!,?27,""*** End of Report ***"""
^XMB(3.9,146083,2,393,0)="""RTN"",""XUSNPIE2"",79,0)"
^XMB(3.9,146083,2,394,0)=" . Q"
^XMB(3.9,146083,2,395,0)="""RTN"",""XUSNPIE2"",80,0)"
^XMB(3.9,146083,2,396,0)=" Q"
^XMB(3.9,146083,2,397,0)="""RTN"",""XUSNPIE2"",81,0)"
^XMB(3.9,146083,2,398,0)=" ;"
^XMB(3.9,146083,2,399,0)="""RTN"",""XUSNPIE2"",82,0)"
^XMB(3.9,146083,2,400,0)="HEADER(OPTION,DATETIME,PAGNOREF,LINNOREF,XUSDIV,XUSDIVNM,XUSSORT,SERVSECT,XUSRESO,XUSER) ;"
^XMB(3.9,146083,2,401,0)="""RTN"",""XUSNPIE2"",83,0)"
^XMB(3.9,146083,2,402,0)=" ; ZEXCEPT: IOF,IOST  KERNEL IO VARIABLES"
^XMB(3.9,146083,2,403,0)="""RTN"",""XUSNPIE2"",84,0)"
^XMB(3.9,146083,2,404,0)=" ; ZEXCEPT: DIRUT,DTOUT  NEWED IN CALLING PRNTPROV - INDICATE QUIT TO PRNTPROV"
^XMB(3.9,146083,2,405,0)="""RTN"",""XUSNPIE2"",85,0)"
^XMB(3.9,146083,2,406,0)=" N TEMPVAL,DIR,X,Y"
^XMB(3.9,146083,2,407,0)="""RTN"",""XUSNPIE2"",86,0)"
^XMB(3.9,146083,2,408,0)=" S PAGNOREF=PAGNOREF+1"
^XMB(3.9,146083,2,409,0)="""RTN"",""XUSNPIE2"",87,0)"
^XMB(3.9,146083,2,410,0)=" S XUSER=$G(XUSER) ; add p 519"
^XMB(3.9,146083,2,411,0)="""RTN"",""XUSNPIE2"",88,0)"
^XMB(3.9,146083,2,412,0)=" ; Don't page feed on the first page"
^XMB(3.9,146083,2,413,0)="""RTN"",""XUSNPIE2"",89,0)"
^XMB(3.9,146083,2,414,0)=" IF PAGNOREF>1 I $E(IOST,1,2)=""C-"" S DIR(0)=""E"" D ^DIR I 'Y S DIRUT=1 Q"
^XMB(3.9,146083,2,415,0)="""RTN"",""XUSNPIE2"",90,0)"
^XMB(3.9,146083,2,416,0)=" IF PAGNOREF>1 W @IOF"
^XMB(3.9,146083,2,417,0)="""RTN"",""XUSNPIE2"",91,0)"
^XMB(3.9,146083,2,418,0)=" W:$E(IOST,1,2)'=""C-"" !"
^XMB(3.9,146083,2,419,0)="""RTN"",""XUSNPIE2"",92,0)"
^XMB(3.9,146083,2,420,0)=" W ""Active Provider Report (""_$S(XUSRESO=""P"":""no residents)"",XUSRESO=""R"":""residents only)"",1:""includes residents)"")"
^XMB(3.9,146083,2,421,0)="""RTN"",""XUSNPIE2"",93,0)"
^XMB(3.9,146083,2,422,0)=" W ?48,$$FMTE^XLFDT(DATETIME),""  Page: "",PAGNOREF"
^XMB(3.9,146083,2,423,0)="""RTN"",""XUSNPIE2"",94,0)"
^XMB(3.9,146083,2,424,0)=" W !,""Report Option: Provider List    Active "",$S(XUSER=2:""and Disuser "",1:""""),""Providers"",$S(OPTION=2:"" Without NPI Numbers"",1:"""")"
^XMB(3.9,146083,2,425,0)="""RTN"",""XUSNPIE2"",95,0)"
^XMB(3.9,146083,2,426,0)=" W !!,""Provider Name"",?39,""IEN"",?49,$S(OPTION'=2:""NPI"",1:""""),?65,$S(XUSER=2:""Disuser"",1:"""")"
^XMB(3.9,146083,2,427,0)="""RTN"",""XUSNPIE2"",96,0)"
^XMB(3.9,146083,2,428,0)=" W !,""      Taxonomy"""
^XMB(3.9,146083,2,429,0)="""RTN"",""XUSNPIE2"",97,0)"
^XMB(3.9,146083,2,430,0)=" W !,""--------------------------------------------------------------------------------"""
^XMB(3.9,146083,2,431,0)="""RTN"",""XUSNPIE2"",98,0)"
^XMB(3.9,146083,2,432,0)=" S LINNOREF=6"
^XMB(3.9,146083,2,433,0)="""RTN"",""XUSNPIE2"",99,0)"
^XMB(3.9,146083,2,434,0)=" I XUSDIV W !,""DIVISION: "",XUSDIVNM,""   "" S LINNOREF=LINNOREF+1"
^XMB(3.9,146083,2,435,0)="""RTN"",""XUSNPIE2"",100,0)"
^XMB(3.9,146083,2,436,0)=" I XUSSORT W:'XUSDIV ! W ""SERVICE/SECTION: "",SERVSECT S:'XUSDIV LINNOREF=LINNOREF+1"
^XMB(3.9,146083,2,437,0)="""RTN"",""XUSNPIE2"",101,0)"
^XMB(3.9,146083,2,438,0)=" Q"
^XMB(3.9,146083,2,439,0)="""RTN"",""XUSNPIE2"",102,0)"
^XMB(3.9,146083,2,440,0)=" ;"
^XMB(3.9,146083,2,441,0)="""RTN"",""XUSNPIE2"",103,0)"
^XMB(3.9,146083,2,442,0)="GETDATA(OPTION,XUSSORT,XUSDIV,XUSRESO,XUSER) ; get data for reports for providers"
^XMB(3.9,146083,2,443,0)="""RTN"",""XUSNPIE2"",104,0)"
^XMB(3.9,146083,2,444,0)=" N NPI,PROVNAME,TAXDESCR,TAXONOMY,XUSDEFLT,XUSDIVCN,XUSDIVN,XUSDIVNM,XUSGLOB,XUSACTV,XUSSKIP"
^XMB(3.9,146083,2,445,0)="""RTN"",""XUSNPIE2"",105,0)"
^XMB(3.9,146083,2,446,0)=" N XUSIEN,XUSSERVC,XUSVAL,CNTCLEAN,X,XUSDIS"
^XMB(3.9,146083,2,447,0)="""RTN"",""XUSNPIE2"",106,0)"
^XMB(3.9,146083,2,448,0)=" S XUSRESO=$G(XUSRESO)"
^XMB(3.9,146083,2,449,0)="""RTN"",""XUSNPIE2"",107,0)"
^XMB(3.9,146083,2,450,0)=" S XUSER=$G(XUSER) I XUSER="""" S XUSER=1 ;add p 519 - active users only reported"
^XMB(3.9,146083,2,451,0)="""RTN"",""XUSNPIE2"",108,0)"
^XMB(3.9,146083,2,452,0)=" S XUSDIS="""" ; p 519"
^XMB(3.9,146083,2,453,0)="""RTN"",""XUSNPIE2"",109,0)"
^XMB(3.9,146083,2,454,0)=" ; ZEXCEPT: CNTTOTAL,CNTNONE,CNTEXMPT,CNTDONE - NEWed and initialized in PRNTPROV or killed based on CNTCLEAN"
^XMB(3.9,146083,2,455,0)="""RTN"",""XUSNPIE2"",110,0)"
^XMB(3.9,146083,2,456,0)=" S CNTCLEAN=0 I '$D(CNTTOTAL) S CNTCLEAN=1"
^XMB(3.9,146083,2,457,0)="""RTN"",""XUSNPIE2"",111,0)"
^XMB(3.9,146083,2,458,0)=" S XUSGLOB=$NA(^TMP($J,""XUSNPIPRNT"")) K @XUSGLOB"
^XMB(3.9,146083,2,459,0)="""RTN"",""XUSNPIE2"",112,0)"
^XMB(3.9,146083,2,460,0)=" I 'XUSDIV S XUSDIVNM(1)="" "",XUSDEFLT="" """
^XMB(3.9,146083,2,461,0)="""RTN"",""XUSNPIE2"",113,0)"
^XMB(3.9,146083,2,462,0)=" I XUSDIV S XUSDEFLT=$$NS^XUAF4($$KSP^XUPARAM(""INST"")),XUSDEFLT=$P(XUSDEFLT,U)"
^XMB(3.9,146083,2,463,0)="""RTN"",""XUSNPIE2"",114,0)"
^XMB(3.9,146083,2,464,0)=" I 'XUSSORT S XUSSERVC="" """
^XMB(3.9,146083,2,465,0)="""RTN"",""XUSNPIE2"",115,0)"
^XMB(3.9,146083,2,466,0)=" N XUS1,XUS2"
^XMB(3.9,146083,2,467,0)="""RTN"",""XUSNPIE2"",116,0)"
^XMB(3.9,146083,2,468,0)=" F XUSIEN=0:0 S XUSIEN=$O(^VA(200,XUSIEN)) Q:(XUSIEN'>0)!(XUSIEN'=+XUSIEN)  D"
^XMB(3.9,146083,2,469,0)="""RTN"",""XUSNPIE2"",117,0)"
^XMB(3.9,146083,2,470,0)=" . ; Don't report TERMINATED"
^XMB(3.9,146083,2,471,0)="""RTN"",""XUSNPIE2"",118,0)"
^XMB(3.9,146083,2,472,0)=" . S XUSACTV=$$ACTIVE^XUSER(XUSIEN)"
^XMB(3.9,146083,2,473,0)="""RTN"",""XUSNPIE2"",119,0)"
^XMB(3.9,146083,2,474,0)=" . I XUSACTV=""""!($P(XUSACTV,U,2)=""TERMINATED"") Q  ;p 519"
^XMB(3.9,146083,2,475,0)="""RTN"",""XUSNPIE2"",120,0)"
^XMB(3.9,146083,2,476,0)=" . I XUSER=1,$P(XUSACTV,U)=0 Q  ;p 519"
^XMB(3.9,146083,2,477,0)="""RTN"",""XUSNPIE2"",121,0)"
^XMB(3.9,146083,2,478,0)=" . S XUSDIS="""" I $P(XUSACTV,U,2)=""DISUSER"" S XUSDIS=""Yes"" ;p 519"
^XMB(3.9,146083,2,479,0)="""RTN"",""XUSNPIE2"",122,0)"
^XMB(3.9,146083,2,480,0)=" . ; Don't report users with null NPI ENTRY STATUS"
^XMB(3.9,146083,2,481,0)="""RTN"",""XUSNPIE2"",123,0)"
^XMB(3.9,146083,2,482,0)=" . S XUSVAL=$$CHEKNPI^XUSNPIED(XUSIEN),XUSVAL=$$NPISTATS^XUSNPIED(XUSIEN)"
^XMB(3.9,146083,2,483,0)="""RTN"",""XUSNPIE2"",124,0)"
^XMB(3.9,146083,2,484,0)=" . I $$GETNPI^XUSNPIED(XUSIEN)>0 S $P(^VA(200,XUSIEN,""NPI""),""^"",2)=""D"",XUSVAL=$$NPISTATS^XUSNPIED(XUSIEN) ; p764"
^XMB(3.9,146083,2,485,0)="""RTN"",""XUSNPIE2"",125,0)"
^XMB(3.9,146083,2,486,0)=" . Q:XUSVAL="""""
^XMB(3.9,146083,2,487,0)="""RTN"",""XUSNPIE2"",126,0)"
^XMB(3.9,146083,2,488,0)=" . S PROVNAME=$$GET1^DIQ(200,XUSIEN_"","",.01),NPI=$$GETNPI^XUSNPIED(XUSIEN),TAXONOMY=$$GETTAXON^XUSNPIED(XUSIEN,.TAXDESCR) I TAXONOMY=-1 S TAXONOMY="" "",TAXDESCR="" """
^XMB(3.9,146083,2,489,0)="""RTN"",""XUSNPIE2"",127,0)"
^XMB(3.9,146083,2,490,0)=" . ; Determine whether provider is a resident for local reports."
^XMB(3.9,146083,2,491,0)="""RTN"",""XUSNPIE2"",128,0)"
^XMB(3.9,146083,2,492,0)=" . I OPTION'=3,XUSRESO'=""B"" S XUSSKIP=0 D  Q:XUSSKIP"
^XMB(3.9,146083,2,493,0)="""RTN"",""XUSNPIE2"",129,0)"
^XMB(3.9,146083,2,494,0)=" . . I XUSRESO=""R"",TAXONOMY'=""390200000X"" S XUSSKIP=1 Q"
^XMB(3.9,146083,2,495,0)="""RTN"",""XUSNPIE2"",130,0)"
^XMB(3.9,146083,2,496,0)=" . . I XUSRESO=""P"",TAXONOMY=""390200000X"" S XUSSKIP=1"
^XMB(3.9,146083,2,497,0)="""RTN"",""XUSNPIE2"",131,0)"
^XMB(3.9,146083,2,498,0)=" . . Q"
^XMB(3.9,146083,2,499,0)="""RTN"",""XUSNPIE2"",132,0)"
^XMB(3.9,146083,2,500,0)=" . I NPI="""",$$EXMPTNPI^XUSNPIED(XUSIEN) S NPI=""EXEMPTED  """
^XMB(3.9,146083,2,501,0)="""RTN"",""XUSNPIE2"",133,0)"
^XMB(3.9,146083,2,502,0)=" . I NPI="""",XUSVAL=""D"" S XUSVAL=""N"",$P(^VA(200,XUSIEN,""NPI""),""^"",2)=XUSVAL ;p752 to correct the NPI ENTRY STATUS"
^XMB(3.9,146083,2,503,0)="""RTN"",""XUSNPIE2"",134,0)"
^XMB(3.9,146083,2,504,0)=" . S CNTTOTAL=$G(CNTTOTAL)+1 S:NPI="""" CNTNONE=$G(CNTNONE)+1 S:NPI=""EXEMPTED  "" CNTEXMPT=$G(CNTEXMPT)+1 S:NPI?10N CNTDONE=$G(CNTDONE)+1"
^XMB(3.9,146083,2,505,0)="""RTN"",""XUSNPIE2"",135,0)"
^XMB(3.9,146083,2,506,0)=" . I '((XUSVAL=""N"")!(OPTION'=2)) Q"
^XMB(3.9,146083,2,507,0)="""RTN"",""XUSNPIE2"",136,0)"
^XMB(3.9,146083,2,508,0)=" . I XUSSORT S XUSSERVC=$$GET1^DIQ(200,XUSIEN_"","",29) I XUSSERVC="""" S XUSSERVC="" """
^XMB(3.9,146083,2,509,0)="""RTN"",""XUSNPIE2"",137,0)"
^XMB(3.9,146083,2,510,0)=" . I XUSDIV D"
^XMB(3.9,146083,2,511,0)="""RTN"",""XUSNPIE2"",138,0)"
^XMB(3.9,146083,2,512,0)=" . . K XUSDIVNM S XUSDIVCN=0,XUSDIVNM(1)=XUSDEFLT"
^XMB(3.9,146083,2,513,0)="""RTN"",""XUSNPIE2"",139,0)"
^XMB(3.9,146083,2,514,0)=" . . F XUSDIVN=0:0 S XUSDIVN=$O(^VA(200,XUSIEN,2,XUSDIVN)) Q:XUSDIVN'>0  S XUSDIVCN=XUSDIVCN+1,XUSDIVNM(XUSDIVCN)=$$GET1^DIQ(200.02,XUSDIVN_"",""_XUSIEN_"","",.01)"
^XMB(3.9,146083,2,515,0)="""RTN"",""XUSNPIE2"",140,0)"
^XMB(3.9,146083,2,516,0)=" . . I XUSDIVCN>1 S MULTDIV=$G(MULTDIV)+1,MULTDIVC=$G(MULTDIVC)+XUSDIVCN-1"
^XMB(3.9,146083,2,517,0)="""RTN"",""XUSNPIE2"",141,0)"
^XMB(3.9,146083,2,518,0)=" . . Q"
^XMB(3.9,146083,2,519,0)="""RTN"",""XUSNPIE2"",142,0)"
^XMB(3.9,146083,2,520,0)=" . F XUSDIVN=0:0 S XUSDIVN=$O(XUSDIVNM(XUSDIVN)) Q:XUSDIVN'>0  D"
^XMB(3.9,146083,2,521,0)="""RTN"",""XUSNPIE2"",143,0)"
^XMB(3.9,146083,2,522,0)=" . . S X=PROVNAME_U_XUSIEN_U_NPI_U_TAXONOMY_U_TAXDESCR I XUSDIS=""Yes"" S X=X_U_XUSDIS  ;p 519 add piece #6 on X"
^XMB(3.9,146083,2,523,0)="""RTN"",""XUSNPIE2"",144,0)"
^XMB(3.9,146083,2,524,0)=" . . S @XUSGLOB@(XUSDIVNM(XUSDIVN),XUSSERVC,PROVNAME,XUSIEN,TAXDESCR)=X"
^XMB(3.9,146083,2,525,0)="""RTN"",""XUSNPIE2"",145,0)"
^XMB(3.9,146083,2,526,0)=" . . Q "
^XMB(3.9,146083,2,527,0)="""RTN"",""XUSNPIE2"",146,0)"
^XMB(3.9,146083,2,528,0)=" . Q"
^XMB(3.9,146083,2,529,0)="""RTN"",""XUSNPIE2"",147,0)"
^XMB(3.9,146083,2,530,0)=" I CNTCLEAN K CNTTOTAL,CNTNONE,CNTEXMPT,CNTDONE"
^XMB(3.9,146083,2,531,0)="""RTN"",""XUSNPIE2"",148,0)"
^XMB(3.9,146083,2,532,0)=" Q XUSGLOB"
^XMB(3.9,146083,2,533,0)="""RTN"",""XUSNPIE2"",149,0)"
^XMB(3.9,146083,2,534,0)=" ;"
^XMB(3.9,146083,2,535,0)="""RTN"",""XUSNPIE2"",150,0)"
^XMB(3.9,146083,2,536,0)="ALIGNRGT(TEXT,WIDTH) ; align text right in a specified width"
^XMB(3.9,146083,2,537,0)="""RTN"",""XUSNPIE2"",151,0)"
^XMB(3.9,146083,2,538,0)=" N RESULT"
^XMB(3.9,146083,2,539,0)="""RTN"",""XUSNPIE2"",152,0)"
^XMB(3.9,146083,2,540,0)=" S $P(RESULT,"" "",WIDTH)="" "",RESULT=RESULT_TEXT,RESULT=$E(RESULT,$L(RESULT)-WIDTH+1,$L(RESULT))"
^XMB(3.9,146083,2,541,0)="""RTN"",""XUSNPIE2"",153,0)"
^XMB(3.9,146083,2,542,0)=" Q RESULT"
^XMB(3.9,146083,2,543,0)="""RTN"",""XUSNPIE2"",154,0)"
^XMB(3.9,146083,2,544,0)=" ;"
^XMB(3.9,146083,2,545,0)="""RTN"",""XUSNPIE2"",155,0)"
^XMB(3.9,146083,2,546,0)="CHKOLD1(IEN) ; check for earlier value, and activate if present"
^XMB(3.9,146083,2,547,0)="""RTN"",""XUSNPIE2"",156,0)"
^XMB(3.9,146083,2,548,0)=" N IEN1,STATUS,NPI,DATE,XUFDA"
^XMB(3.9,146083,2,549,0)="""RTN"",""XUSNPIE2"",157,0)"
^XMB(3.9,146083,2,550,0)=" S IEN1=$O(^VA(200,IEN,""NPISTATUS"","" ""),-1) I IEN1>0 D  I STATUS=0 D CHKOLD1(IEN)"
^XMB(3.9,146083,2,551,0)="""RTN"",""XUSNPIE2"",158,0)"
^XMB(3.9,146083,2,552,0)=" . S STATUS=^VA(200,IEN,""NPISTATUS"",IEN1,0),NPI=$P(STATUS,U,3),DATE=$P(STATUS,U),STATUS=$P(STATUS,U,2)"
^XMB(3.9,146083,2,553,0)="""RTN"",""XUSNPIE2"",159,0)"
^XMB(3.9,146083,2,554,0)=" . I STATUS=0 D DELETNPI(IEN,IEN1,DATE) Q  ; entry making it INACTIVE - remove it"
^XMB(3.9,146083,2,555,0)="""RTN"",""XUSNPIE2"",160,0)"
^XMB(3.9,146083,2,556,0)=" . I STATUS=1 D SET^XUSNPIE1(IEN,NPI)"
^XMB(3.9,146083,2,557,0)="""RTN"",""XUSNPIE2"",161,0)"
^XMB(3.9,146083,2,558,0)=" . Q"
^XMB(3.9,146083,2,559,0)="""RTN"",""XUSNPIE2"",162,0)"
^XMB(3.9,146083,2,560,0)=" Q"
^XMB(3.9,146083,2,561,0)="""RTN"",""XUSNPIE2"",163,0)"
^XMB(3.9,146083,2,562,0)=" ;"
^XMB(3.9,146083,2,563,0)="""RTN"",""XUSNPIE2"",164,0)"
^XMB(3.9,146083,2,564,0)="DELETNPI(IEN,OIEN,ODATEVAL) ;"
^XMB(3.9,146083,2,565,0)="""RTN"",""XUSNPIE2"",165,0)"
^XMB(3.9,146083,2,566,0)=" N XUFDA"
^XMB(3.9,146083,2,567,0)="""RTN"",""XUSNPIE2"",166,0)"
^XMB(3.9,146083,2,568,0)=" I $D(ODATEVAL) S XUFDA(200.042,OIEN_"",""_IEN_"","",.01)=""@"" D FILE^DIE("""",""XUFDA"")"
^XMB(3.9,146083,2,569,0)="""RTN"",""XUSNPIE2"",167,0)"
^XMB(3.9,146083,2,570,0)=" I $O(^VA(200,IEN,""NPISTATUS"",0))>0 Q"
^XMB(3.9,146083,2,571,0)="""RTN"",""XUSNPIE2"",168,0)"
^XMB(3.9,146083,2,572,0)=" N XUFDA"
^XMB(3.9,146083,2,573,0)="""RTN"",""XUSNPIE2"",169,0)"
^XMB(3.9,146083,2,574,0)=" I $$GET1^DIQ(200,IEN_"","",41.99) S XUFDA(200,IEN_"","",41.99)=""@"""
^XMB(3.9,146083,2,575,0)="""RTN"",""XUSNPIE2"",170,0)"
^XMB(3.9,146083,2,576,0)=" I $$GET1^DIQ(200,IEN_"","",41.98)'="""" S XUFDA(200,IEN_"","",41.98)=""@"""
^XMB(3.9,146083,2,577,0)="""RTN"",""XUSNPIE2"",171,0)"
^XMB(3.9,146083,2,578,0)=" I $D(XUFDA) D FILE^DIE("""",""XUFDA"")"
^XMB(3.9,146083,2,579,0)="""RTN"",""XUSNPIE2"",172,0)"
^XMB(3.9,146083,2,580,0)=" Q"
^XMB(3.9,146083,2,581,0)="""RTN"",""XUSNPIE2"",173,0)"
^XMB(3.9,146083,2,582,0)=" ;"
^XMB(3.9,146083,2,583,0)="""RTN"",""XUSNPIE2"",174,0)"
^XMB(3.9,146083,2,584,0)="CLERXMPT ; edit entry indicating whether a provider is exempt from needing an NPI"
^XMB(3.9,146083,2,585,0)="""RTN"",""XUSNPIE2"",175,0)"
^XMB(3.9,146083,2,586,0)=" N DIC,DIR,FDA,IEN,Y"
^XMB(3.9,146083,2,587,0)="""RTN"",""XUSNPIE2"",176,0)"
^XMB(3.9,146083,2,588,0)=" W ! S DIC=""^VA(200,"",DIC(0)=""AEQ"" S DIC(""A"")=""select Provider: "" D ^DIC Q:Y'>0  S IEN=+Y"
^XMB(3.9,146083,2,589,0)="""RTN"",""XUSNPIE2"",177,0)"
^XMB(3.9,146083,2,590,0)=" I $$HASNPI^XUSNPIED(IEN) W !,""This Provider already has an NPI value.  Nothing to do."" Q"
^XMB(3.9,146083,2,591,0)="""RTN"",""XUSNPIE2"",178,0)"
^XMB(3.9,146083,2,592,0)=" I '$$CHEKNPI^XUSNPIED(IEN),'$$EXMPTNPI^XUSNPIED(IEN) W !,""This Provider does not appear to need an NPI or Exemption."" Q"
^XMB(3.9,146083,2,593,0)="""RTN"",""XUSNPIE2"",179,0)"
^XMB(3.9,146083,2,594,0)=" I $$EXMPTNPI^XUSNPIED(IEN) D  Q  ; currently marked as Exempt"
^XMB(3.9,146083,2,595,0)="""RTN"",""XUSNPIE2"",180,0)"
^XMB(3.9,146083,2,596,0)=" . S DIR(0)=""Y"",DIR(""A"")=""Provider is currently EXEMPT from needing an NPI, set to NEEDS an NPI (Y/N)"" D ^DIR I 'Y Q"
^XMB(3.9,146083,2,597,0)="""RTN"",""XUSNPIE2"",181,0)"
^XMB(3.9,146083,2,598,0)=" . S FDA(200,IEN_"","",41.98)=""N"" D FILE^DIE("""",""FDA"")"
^XMB(3.9,146083,2,599,0)="""RTN"",""XUSNPIE2"",182,0)"
^XMB(3.9,146083,2,600,0)=" . W !,$S($$NEEDSNPI^XUSNPIED(IEN):""File updated"",1:""Ecountered a problem updating file, status NOT set to NEEDS an NPI"")"
^XMB(3.9,146083,2,601,0)="""RTN"",""XUSNPIE2"",183,0)"
^XMB(3.9,146083,2,602,0)=" . Q"
^XMB(3.9,146083,2,603,0)="""RTN"",""XUSNPIE2"",184,0)"
^XMB(3.9,146083,2,604,0)=" ; check to make sure provider should be exempt"
^XMB(3.9,146083,2,605,0)="""RTN"",""XUSNPIE2"",185,0)"
^XMB(3.9,146083,2,606,0)=" S DIR(0)=""Y"",DIR(""A"")=""Confirm that Provider should be Exempt from needing an NPI (Y/N)"" D ^DIR I 'Y Q"
^XMB(3.9,146083,2,607,0)="""RTN"",""XUSNPIE2"",186,0)"
^XMB(3.9,146083,2,608,0)=" ; and update file to show as exempt"
^XMB(3.9,146083,2,609,0)="""RTN"",""XUSNPIE2"",187,0)"
^XMB(3.9,146083,2,610,0)=" S FDA(200,IEN_"","",41.98)=""E"" D FILE^DIE("""",""FDA"")"
^XMB(3.9,146083,2,611,0)="""RTN"",""XUSNPIE2"",188,0)"
^XMB(3.9,146083,2,612,0)=" W !,$S($$EXMPTNPI^XUSNPIED(IEN):""File updated"",1:""Ecountered a problem updating file, status NOT set to EXEMPT"")"
^XMB(3.9,146083,2,613,0)="""RTN"",""XUSNPIE2"",189,0)"
^XMB(3.9,146083,2,614,0)=" Q"
^XMB(3.9,146083,2,615,0)="""VER"")"
