^XMB(3.9,146011,2,451,0)="""RTN"",""PSOHLD"",1,0)"
^XMB(3.9,146011,2,452,0)="PSOHLD ;BIR/SAB - hold unhold functionality ; OCT 04, 2023@11:10:12"
^XMB(3.9,146011,2,453,0)="""RTN"",""PSOHLD"",2,0)"
^XMB(3.9,146011,2,454,0)=" ;;7.0;OUTPATIENT PHARMACY;**1,16,21,24,27,32,55,82,114,130,166,148,268,281,298,358,353,385,386,370,488,562,441,712,780**;DEC 1997;Build 0"
