^XMB(3.9,146087,2,693,0)="""RTN"",""YTQRCDB"",27,0)"
^XMB(3.9,146087,2,694,0)=" ;Used when scoring algorithm for this instrument not yet implemented in cloud app"
^XMB(3.9,146087,2,695,0)="""RTN"",""YTQRCDB"",28,0)"
^XMB(3.9,146087,2,696,0)=" N DATAOUT,ERRARY,JSONOUT,SCORES,I"
