^XMB(3.9,146089,2,1605,0)="""RTN"",""PSOORFIN"",20,0)"
^XMB(3.9,146089,2,1606,0)=" S DIR(""?"")=""^D ST^PSOORFI1"",DIR(""A"")=""Select By"",DIR(""B"")=""PATIENT"""
