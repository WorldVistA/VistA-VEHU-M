^XMB(3.9,146039,2,3298,0)=" I $D(SDRETURN) D"
^XMB(3.9,146039,2,3299,0)="""RTN"",""SDES2UNDOCHKOUT"",34,0)"
^XMB(3.9,146039,2,3300,0)=" . S PARAMETERS(""APPOINTMENT IEN"")=PARAMETERS"
