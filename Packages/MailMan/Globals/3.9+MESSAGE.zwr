^XMB(3.9,146091,2,522,0)="TRIM(X) ; remove both leading and trailing blanks"
^XMB(3.9,146091,2,523,0)="""RTN"",""MAGQBUT4"",137,0)"
^XMB(3.9,146091,2,524,0)=" N I,J"
^XMB(3.9,146091,2,525,0)="""RTN"",""MAGQBUT4"",138,0)"
^XMB(3.9,146091,2,526,0)=" F I=1:1:$L(X) Q:$E(X,I)'="" """
