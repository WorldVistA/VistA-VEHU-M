^XMB(3.9,146098,2,1178,0)=" Q"
^XMB(3.9,146098,2,1179,0)="""RTN"",""SDES2APTLETTER"",268,0)"
^XMB(3.9,146098,2,1180,0)="FILL(PADS,CHAR)  ;pad string"
^XMB(3.9,146098,2,1181,0)="""RTN"",""SDES2APTLETTER"",269,0)"
^XMB(3.9,146098,2,1182,0)=" N I,RET"
^XMB(3.9,146098,2,1183,0)="""RTN"",""SDES2APTLETTER"",270,0)"
^XMB(3.9,146098,2,1184,0)=" S CHAR=$G(CHAR)"
^XMB(3.9,146098,2,1185,0)="""RTN"",""SDES2APTLETTER"",271,0)"
^XMB(3.9,146098,2,1186,0)=" S:CHAR="""" CHAR="" """
^XMB(3.9,146098,2,1187,0)="""RTN"",""SDES2APTLETTER"",272,0)"
^XMB(3.9,146098,2,1188,0)=" S RET="""""
