^XMB(3.9,146036,2,1677,0)="""RTN"",""DVBCPUSH"",95,0)"
^XMB(3.9,146036,2,1678,0)=" ..S DVBRT(DVBCT)=DVBTMP(8989.51,DVBIENS,20,DVBX)"
