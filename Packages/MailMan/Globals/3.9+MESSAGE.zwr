^XMB(3.9,146037,2,2818,0)=" . S RCDIEN=$P(DATA,U,10),RCDBAL=$$DEPBAL^RCDPTAR2(RCDIEN),RCDBAL=+RCDBAL,RCDBAL=$S('RCDBAL:""UNBALANCED"",1:"""")"
