^XMB(3.9,146098,2,1460,0)=" ; RPC: SDES2 DISPOSITION RECALL REQ"
^XMB(3.9,146098,2,1461,0)="""RTN"",""SDES2DISPRECALL"",11,0)"
^XMB(3.9,146098,2,1462,0)=" ;"
^XMB(3.9,146098,2,1463,0)="""RTN"",""SDES2DISPRECALL"",12,0)"
^XMB(3.9,146098,2,1464,0)=" ; SDCONTEXT INPUT"
^XMB(3.9,146098,2,1465,0)="""RTN"",""SDES2DISPRECALL"",13,0)"
^XMB(3.9,146098,2,1466,0)=" ;"
^XMB(3.9,146098,2,1467,0)="""RTN"",""SDES2DISPRECALL"",14,0)"
^XMB(3.9,146098,2,1468,0)=" ;S SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number. Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XMB(3.9,146098,2,1469,0)="""RTN"",""SDES2DISPRECALL"",15,0)"
^XMB(3.9,146098,2,1470,0)=" ;S SDCONTEXT(""USER DUZ"") = The DUZ of the user taking action in the calling application."
