^XMB(3.9,146090,2,735,0)="""RTN"",""PSOSPML4"",248,0)"
^XMB(3.9,146090,2,736,0)=" K ^TMP(""PSOSPML4"",$J)"
^XMB(3.9,146090,2,737,0)="""RTN"",""PSOSPML4"",249,0)"
^XMB(3.9,146090,2,738,0)=" Q"
^XMB(3.9,146090,2,739,0)="""RTN"",""PSOSPML4"",250,0)"
