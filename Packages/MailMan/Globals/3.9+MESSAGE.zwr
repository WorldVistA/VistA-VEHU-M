^XMB(3.9,146083,2,195,0)="""QUES"",""XPM1"",""??"")"
^XMB(3.9,146083,2,196,0)="^D MG^XPDH"
^XMB(3.9,146083,2,197,0)="""QUES"",""XPM1"",""A"")"
^XMB(3.9,146083,2,198,0)="Enter the Coordinator for Mail Group '|FLAG|'"
