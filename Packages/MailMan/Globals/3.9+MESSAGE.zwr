^XMB(3.9,146035,2,260,0)=" ;-------------------------------------------------------------------"
^XMB(3.9,146035,2,261,0)="""RTN"",""PSOBBC"",11,0)"
^XMB(3.9,146035,2,262,0)="START ;"
^XMB(3.9,146035,2,263,0)="""RTN"",""PSOBBC"",12,0)"
^XMB(3.9,146035,2,264,0)=" N PSODFN,PSOBBCNO"
^XMB(3.9,146035,2,265,0)="""RTN"",""PSOBBC"",13,0)"
^XMB(3.9,146035,2,266,0)=" D INIT I '$D(PSOPAR) D ^PSOLSET G:'$D(PSOPAR) EOJ"
^XMB(3.9,146035,2,267,0)="""RTN"",""PSOBBC"",14,0)"
^XMB(3.9,146035,2,268,0)=" I $P($G(PSOPAR),""^"",2),'$D(^XUSEC(""PSORPH"",DUZ)) S PSORX(""VERIFY"")=1  ;337"
^XMB(3.9,146035,2,269,0)="""RTN"",""PSOBBC"",15,0)"
^XMB(3.9,146035,2,270,0)=" I $G(PSOSITE) S PSOBARID=$G(^PS(59,PSOSITE,""IB"")) I '$D(^IBE(350.1,""ANEW"",+PSOBARID,1,1)) D  S PSORX(""QFLG"")=1 K PSOBARID G END"
^XMB(3.9,146035,2,271,0)="""RTN"",""PSOBBC"",16,0)"
^XMB(3.9,146035,2,272,0)=" .W $C(7),!!,""WARNING: Pharmacy Copay not working,"",!,?10,""Check IB SERVICE/SECTION in Pharmacy Site File."",!!!,""You will not be able to enter any new prescriptions until this is corrected!"""
^XMB(3.9,146035,2,273,0)="""RTN"",""PSOBBC"",17,0)"
^XMB(3.9,146035,2,274,0)=" S PSOBBC(""QFLG"")=0,PSORX(""BAR CODE"")=1"
^XMB(3.9,146035,2,275,0)="""RTN"",""PSOBBC"",18,0)"
^XMB(3.9,146035,2,276,0)=" D FROM I PSOBBC(""QFLG"") S PSORX(""QFLG"")=1 G END"
^XMB(3.9,146035,2,277,0)="""RTN"",""PSOBBC"",19,0)"
^XMB(3.9,146035,2,278,0)=" D ASK I PSOBBC(""QFLG"") S PSORX(""QFLG"")=1 G END"
