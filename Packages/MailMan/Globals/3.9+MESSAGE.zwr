^XMB(3.9,146089,2,403,0)="""RTN"",""PSOORFI2"",76,0)"
^XMB(3.9,146089,2,404,0)=" S PSORX(""MAIL/WINDOW"")=$S($P(OR0,""^"",17)=""M"":""MAIL"",1:""WINDOW"")"
^XMB(3.9,146089,2,405,0)="""RTN"",""PSOORFI2"",77,0)"
