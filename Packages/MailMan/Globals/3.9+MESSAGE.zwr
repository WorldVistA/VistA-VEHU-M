^XMB(3.9,146036,2,2141,0)="""RTN"",""DVBCTXML"",48,0)"
^XMB(3.9,146036,2,2142,0)=" S DVBFAIL=$NA(^TMP(""CAPRI XML LIST"",$J))"
^XMB(3.9,146036,2,2143,0)="""RTN"",""DVBCTXML"",49,0)"
^XMB(3.9,146036,2,2144,0)=" Q"
