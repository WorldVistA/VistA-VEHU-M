^XMB(3.9,146021,2,251,0)="""RTN"",""PSGCAPP0"",4,0)"
^XMB(3.9,146021,2,252,0)="H1 ; first header for patient"
^XMB(3.9,146021,2,253,0)="""RTN"",""PSGCAPP0"",5,0)"
^XMB(3.9,146021,2,254,0)=" I $E(IOST,1)=""C"" K DIR S DIR(0)=""E"" D ^DIR K DIR S:$D(DTOUT)!$D(DUOUT) PSJDLW=1 I $D(DTOUT)!$D(DUOUT) Q"
^XMB(3.9,146021,2,255,0)="""RTN"",""PSGCAPP0"",6,0)"
^XMB(3.9,146021,2,256,0)=" S (N,DF)=0,PSEX=$P(PI,""^""),PDOB=$P(PI,""^"",2),PID=$P(PI,""^"",3),RB=$P(PI,""^"",5),AD=$P(PI,""^"",6),TD=$P(PI,""^"",7),WT=$P(PI,""^"",8),WTD=$P(PI,""^"",9),HT=$P(PI,""^"",10),HTD=$P(PI,""^"",11),PPN=$P(PI,""^"",12),PI=$P(PI,""^"",4),PSGP=$P(PN,""^"",2)"
^XMB(3.9,146021,2,257,0)="""RTN"",""PSGCAPP0"",7,0)"
^XMB(3.9,146021,2,258,0)=" S PAGE=$P(PDOB,"";"",2),PDOB=$P(PDOB,"";""),PG=1"
^XMB(3.9,146021,2,259,0)="""RTN"",""PSGCAPP0"",8,0)"
^XMB(3.9,146021,2,260,0)=" W:$Y @IOF W !?26,""UNIT DOSE ACTION PROFILE #2"",?62,PSGPDT,!?+PSGVAMC,$P(PSGVAMC,U,2),!?23,""(Continuation of VA FORM 10-1158)"",?72,""Page: 1"",!,LINE"
^XMB(3.9,146021,2,261,0)="""RTN"",""PSGCAPP0"",9,0)"
^XMB(3.9,146021,2,262,0)=" W !,""   A new order must be written for any new medication or to make any changes"",!,"" in dosage or directions on an existing order."",!,LINE"
^XMB(3.9,146021,2,263,0)="""RTN"",""PSGCAPP0"",10,0)"
^XMB(3.9,146021,2,264,0)=" W !?32-(PSGAPS=""P""*13),$S(PSGAPS=""T"":""Team: "",1:""Treating Provider: ""),PS1,!?1,PPN,?32,""Ward: ""_WD,!?4,""PID: ""_PID W:'PSJPDD ?28 W:PSJPDD ?23,""Last "" W ""Room-Bed: "",RB,?53,""Ht(cm): "",HT,"" "",HTD"
^XMB(3.9,146021,2,265,0)="""RTN"",""PSGCAPP0"",11,0)"
^XMB(3.9,146021,2,266,0)=" W !?4,""DOB: ""_PDOB_""  (""_PAGE_"")"",?53,""Wt(kg): ""_WT,"" "",WTD"
^XMB(3.9,146021,2,267,0)="""RTN"",""PSGCAPP0"",12,0)"
^XMB(3.9,146021,2,268,0)=" W !?4,""Sex: ""_PSEX,?51,""Admitted: ""_AD"
^XMB(3.9,146021,2,269,0)="""RTN"",""PSGCAPP0"",13,0)"
^XMB(3.9,146021,2,270,0)=" ;"
^XMB(3.9,146021,2,271,0)="""RTN"",""PSGCAPP0"",14,0)"
^XMB(3.9,146021,2,272,0)=" W !?5,""Dx: ""_PI W:TD ?43,""Last Transferred: ""_TD"
^XMB(3.9,146021,2,273,0)="""RTN"",""PSGCAPP0"",15,0)"
^XMB(3.9,146021,2,274,0)=" ;   Display serum creatinine if CrCl can't be calculated"
^XMB(3.9,146021,2,275,0)="""RTN"",""PSGCAPP0"",16,0)"
^XMB(3.9,146021,2,276,0)=" S PSJBSA=$$BSA^PSSDSAPI(DFN),PSJBSA=$P(PSJBSA,""^"",3),PSJBSA=$S(PSJBSA'>0:""_________"",1:$J(PSJBSA,4,2))"
^XMB(3.9,146021,2,277,0)="""RTN"",""PSGCAPP0"",17,0)"
^XMB(3.9,146021,2,278,0)=" S RSLT=$$CRCL^PSJLMHED(DFN)"
^XMB(3.9,146021,2,279,0)="""RTN"",""PSGCAPP0"",18,0)"
^XMB(3.9,146021,2,280,0)=" ; Display format of CrCL and Creatinine results updated - PSJ*5.0*387"
^XMB(3.9,146021,2,281,0)="""RTN"",""PSGCAPP0"",19,0)"
^XMB(3.9,146021,2,282,0)=" I ($P($G(RSLT),""^"",2)[""Not Found"")&($P($G(RSLT),""^"",3)<.01) S ZDSPL=""  CrCL: ""_$P(RSLT,""^"",2)_"" (CREAT: Not Found)"""
^XMB(3.9,146021,2,283,0)="""RTN"",""PSGCAPP0"",20,0)"
^XMB(3.9,146021,2,284,0)=" I ($P($G(RSLT),""^"",2)[""Not Found"")&($P($G(RSLT),""^"",3)>=.01) S ZDSPL=""  CrCL: ""_$P(RSLT,""^"",2)_""  (CREAT: ""_$P($G(RSLT),""^"",3)_""mg/dL ""_$P($G(RSLT),""^"")_"")"""
^XMB(3.9,146021,2,285,0)="""RTN"",""PSGCAPP0"",21,0)"
^XMB(3.9,146021,2,286,0)=" I ($P($G(RSLT),""^"",2)'[""Not Found"")&($P($G(RSLT),""^"",3)<.01) S ZDSPL=""  CrCL: ""_$P(RSLT,""^"",2)_"" (CREAT: Not Found)"""
^XMB(3.9,146021,2,287,0)="""RTN"",""PSGCAPP0"",22,0)"
^XMB(3.9,146021,2,288,0)=" I ($P($G(RSLT),""^"",2)'[""Not Found"")&($P($G(RSLT),""^"",3)>=.01) S ZDSPL=""  CrCL: ""_$P(RSLT,""^"",2)_""(est.)""_"" (CREAT: ""_$P($G(RSLT),""^"",3)_""mg/dL ""_$P($G(RSLT),""^"")_"")"""
^XMB(3.9,146021,2,289,0)="""RTN"",""PSGCAPP0"",23,0)"
^XMB(3.9,146021,2,290,0)=" W !?2,$G(ZDSPL),?51,""BSA (m2): "",$G(PSJBSA) K ZDSPL,RSLT,PSJBSA"
^XMB(3.9,146021,2,291,0)="""RTN"",""PSGCAPP0"",24,0)"
^XMB(3.9,146021,2,292,0)=" ;  "
^XMB(3.9,146021,2,293,0)="""RTN"",""PSGCAPP0"",25,0)"
^XMB(3.9,146021,2,294,0)=" S PSGP=$P(PN,U,2) S:PSGP=$G(PSGPTMP) PPAGE=PPAGE+1 I PSGP'=$G(PSGPTMP) S PSGPTMP=PSGP,PPAGE=1"
^XMB(3.9,146021,2,295,0)="""RTN"",""PSGCAPP0"",26,0)"
^XMB(3.9,146021,2,296,0)=" S ALFLG=0 D ATS^PSJMUTL(68,68,2)"
^XMB(3.9,146021,2,297,0)="""RTN"",""PSGCAPP0"",27,0)"
^XMB(3.9,146021,2,298,0)=" ; PSJ*5*169 Make the allergy/ADR algorithm consistent with one used in PSJHEAD for AP-1 report."
^XMB(3.9,146021,2,299,0)="""RTN"",""PSGCAPP0"",28,0)"
^XMB(3.9,146021,2,300,0)=" W !?1,""Allergies: "" D:PSGALG+PSGVALG+PSGADR+PSGVADR=0 NONE I PSGALG+PSGVALG+PSGADR+PSGVADR>0 D ALG^PSJHEAD,ADR^PSJHEAD I ALFLG D"
^XMB(3.9,146021,2,301,0)="""RTN"",""PSGCAPP0"",29,0)"
^XMB(3.9,146021,2,302,0)=" .W ""See patient's first "",$S($E(IOST)=""C"":""screen"",1:""page""),"" for Allergies/Adverse Reactions"""
^XMB(3.9,146021,2,303,0)="""RTN"",""PSGCAPP0"",30,0)"
^XMB(3.9,146021,2,304,0)=" W !,LINE,!,""No. Action"",?16,""Drug"",?46,""ST Start Stop  Status/Info"",!,ALN"
^XMB(3.9,146021,2,305,0)="""RTN"",""PSGCAPP0"",31,0)"
^XMB(3.9,146021,2,306,0)=" Q"
^XMB(3.9,146021,2,307,0)="""RTN"",""PSGCAPP0"",32,0)"
^XMB(3.9,146021,2,308,0)="NONE ;    "
^XMB(3.9,146021,2,309,0)="""RTN"",""PSGCAPP0"",33,0)"
^XMB(3.9,146021,2,310,0)=" ;W:$E(IOST)=""P"" ""______________________________"" W !?7,""ADR: "" W:$E(IOST)=""P"" ""____________________________________"""
^XMB(3.9,146021,2,311,0)="""RTN"",""PSGCAPP0"",34,0)"
^XMB(3.9,146021,2,312,0)=" W ""No Allergy Assessment"" W !?7,""ADR: "" W:$E(IOST)=""P"" ""____________________________________"""
^XMB(3.9,146021,2,313,0)="""RTN"",""PSGCAPP0"",35,0)"
^XMB(3.9,146021,2,314,0)=" Q"
^XMB(3.9,146021,2,315,0)="""RTN"",""PSGCAPP0"",36,0)"
^XMB(3.9,146021,2,316,0)="ALG ; NOT USED ANYMORE, ALG^PSJHEAD    "
^XMB(3.9,146021,2,317,0)="""RTN"",""PSGCAPP0"",37,0)"
^XMB(3.9,146021,2,318,0)=" I PPAGE>1&((PSGALG'<68)!(PSGADR'<63)) S ALFLG=1 Q"
^XMB(3.9,146021,2,319,0)="""RTN"",""PSGCAPP0"",38,0)"
^XMB(3.9,146021,2,320,0)=" S KKA=0 F  S KKA=$O(PSGALG(KKA)) Q:'KKA  W:KKA>1 !?12 W PSGALG(KKA)"
^XMB(3.9,146021,2,321,0)="""RTN"",""PSGCAPP0"",39,0)"
^XMB(3.9,146021,2,322,0)=" Q"
^XMB(3.9,146021,2,323,0)="""RTN"",""PSGCAPP0"",40,0)"
^XMB(3.9,146021,2,324,0)="ADR ; NOT USED ANYMORE, ADR^PSJHEAD "
^XMB(3.9,146021,2,325,0)="""RTN"",""PSGCAPP0"",41,0)"
^XMB(3.9,146021,2,326,0)=" Q:ALFLG"
^XMB(3.9,146021,2,327,0)="""RTN"",""PSGCAPP0"",42,0)"
^XMB(3.9,146021,2,328,0)=" W !?7,""ADR: """
^XMB(3.9,146021,2,329,0)="""RTN"",""PSGCAPP0"",43,0)"
^XMB(3.9,146021,2,330,0)=" S KKA=0 F  S KKA=$O(PSGADR(KKA)) Q:'KKA  W:KKA>1 !?12 W PSGADR(KKA)"
^XMB(3.9,146021,2,331,0)="""RTN"",""PSGCAPP0"",44,0)"
^XMB(3.9,146021,2,332,0)=" Q"
^XMB(3.9,146021,2,333,0)="""RTN"",""PSGCAPP0"",45,0)"
^XMB(3.9,146021,2,334,0)=" ;"
^XMB(3.9,146021,2,335,0)="""RTN"",""PSGCAPP0"",46,0)"
^XMB(3.9,146021,2,336,0)="ENRCT ;"
^XMB(3.9,146021,2,337,0)="""RTN"",""PSGCAPP0"",47,0)"
^XMB(3.9,146021,2,338,0)=" N DFN,GMRA,GMRAL,RCT,X S DFN=PSGP,GMRA=""0^0^111"" D ^GMRADPT"
^XMB(3.9,146021,2,339,0)="""RTN"",""PSGCAPP0"",48,0)"
^XMB(3.9,146021,2,340,0)=" S X=0 F  S X=$O(GMRAL(X)) Q:'X  I $P(GMRAL(X),U,2)]"""" S RCT($P(GMRAL(X),U,2))="""""
^XMB(3.9,146021,2,341,0)="""RTN"",""PSGCAPP0"",49,0)"
^XMB(3.9,146021,2,342,0)=" ;W:'$D(RCT) ""____________________"" S RCT="""" F X=1:1 S RCT=$O(RCT(RCT)) Q:RCT=""""  W:X>1 "","" W:$X+$L(RCT)>77 ! W "" "",RCT"
^XMB(3.9,146021,2,343,0)="""RTN"",""PSGCAPP0"",50,0)"
^XMB(3.9,146021,2,344,0)=" W:'$D(RCT) ""No Allergy Assessment"" S RCT="""" F X=1:1 S RCT=$O(RCT(RCT)) Q:RCT=""""  W:X>1 "","" W:$X+$L(RCT)>77 ! W "" "",RCT"
^XMB(3.9,146021,2,345,0)="""RTN"",""PSGCAPP0"",51,0)"
^XMB(3.9,146021,2,346,0)=" W !,LINE,!,"" No."",?11,""Drug"",?46,""ST Start Stop  Status/Info"",!,ALN"
^XMB(3.9,146021,2,347,0)="""RTN"",""PSGCAPP0"",52,0)"
^XMB(3.9,146021,2,348,0)=" Q"
^XMB(3.9,146021,2,349,0)="""RTN"",""PSJHEAD"")"
^XMB(3.9,146021,2,350,0)="0^3^B34063978"
^XMB(3.9,146021,2,351,0)="""RTN"",""PSJHEAD"",1,0)"
^XMB(3.9,146021,2,352,0)="PSJHEAD ;BIR/KKA-PROFILE HEADER ; 4/1/08 4:29pm"
^XMB(3.9,146021,2,353,0)="""RTN"",""PSJHEAD"",2,0)"
^XMB(3.9,146021,2,354,0)=" ;;5.0;INPATIENT MEDICATIONS;**8,20,85,95,203,260,256,387**;16 DEC 97;Build 0"
^XMB(3.9,146021,2,355,0)="""RTN"",""PSJHEAD"",3,0)"
^XMB(3.9,146021,2,356,0)=" ;"
^XMB(3.9,146021,2,357,0)="""RTN"",""PSJHEAD"",4,0)"
^XMB(3.9,146021,2,358,0)=" ; Reference to ^PS(55 supported by DBIA #2191."
^XMB(3.9,146021,2,359,0)="""RTN"",""PSJHEAD"",5,0)"
^XMB(3.9,146021,2,360,0)=" ;External reference to $$BSA^PSSDSAPI supported by DBIA 5425."
^XMB(3.9,146021,2,361,0)="""RTN"",""PSJHEAD"",6,0)"
^XMB(3.9,146021,2,362,0)=" ;"
^XMB(3.9,146021,2,363,0)="""RTN"",""PSJHEAD"",7,0)"
^XMB(3.9,146021,2,364,0)="ENTRY(DFN,PSJOPC,PG,PSJNARC,PSJTEAM,PSJY2K)   ;"
^XMB(3.9,146021,2,365,0)="""RTN"",""PSJHEAD"",8,0)"
^XMB(3.9,146021,2,366,0)=" ;DFN=patient internal entry number"
^XMB(3.9,146021,2,367,0)="""RTN"",""PSJHEAD"",9,0)"
^XMB(3.9,146021,2,368,0)=" ;PSJOPC=a code showing what type of option is printing the header"
^XMB(3.9,146021,2,369,0)="""RTN"",""PSJHEAD"",10,0)"
^XMB(3.9,146021,2,370,0)=" ;PG=page number"
^XMB(3.9,146021,2,371,0)="""RTN"",""PSJHEAD"",11,0)"
^XMB(3.9,146021,2,372,0)=" ;PSJNARC=code telling whether or not to print narrative"
^XMB(3.9,146021,2,373,0)="""RTN"",""PSJHEAD"",12,0)"
^XMB(3.9,146021,2,374,0)=" ;PSJTEAM=code telling whether or not to print team"
^XMB(3.9,146021,2,375,0)="""RTN"",""PSJHEAD"",13,0)"
^XMB(3.9,146021,2,376,0)=" ;PSJY2K=code telling whether or not to print 4 digit year"
^XMB(3.9,146021,2,377,0)="""RTN"",""PSJHEAD"",14,0)"
^XMB(3.9,146021,2,378,0)="STUFF ;"
^XMB(3.9,146021,2,379,0)="""RTN"",""PSJHEAD"",15,0)"
^XMB(3.9,146021,2,380,0)=" N %,ALFLG,GONE,HDT,KKA,LEN,LENCHK,PSGALG,PSGADR,PSGDT,PSGVWA,PSJPAD,PSJPAGE,PSJPDD,PSJPDOB,PSJPDX,PSJPHT,PSJPHTD,PSJPPID,PSJPR,PSJPRB,PSJPSEX,PSJPTD,PSJPWD,PSJPWDN,PSJPWT,PSJWTD,RB,SI,TEAM,WCNT,WRD,X"
^XMB(3.9,146021,2,381,0)="""RTN"",""PSJHEAD"",16,0)"
^XMB(3.9,146021,2,382,0)=" ;"
^XMB(3.9,146021,2,383,0)="""RTN"",""PSJHEAD"",17,0)"
^XMB(3.9,146021,2,384,0)=" ;PPAGE=the page of the individual we are now printing. This is needed to keep track of how we print the Allergy/ADR info"
^XMB(3.9,146021,2,385,0)="""RTN"",""PSJHEAD"",18,0)"
^XMB(3.9,146021,2,386,0)=" ;PSJNEW is set at the top of all options which call this header, if this is the first time the option has called the routine, PSJNEW will exist"
^XMB(3.9,146021,2,387,0)="""RTN"",""PSJHEAD"",19,0)"
^XMB(3.9,146021,2,388,0)=" ;"
^XMB(3.9,146021,2,389,0)="""RTN"",""PSJHEAD"",20,0)"
^XMB(3.9,146021,2,390,0)=" I $D(PSJNEW) S PSGPTMP=0,PPAGE=1 K PSJNEW"
^XMB(3.9,146021,2,391,0)="""RTN"",""PSJHEAD"",21,0)"
^XMB(3.9,146021,2,392,0)=" S PSGP=DFN S:PSGP=$G(PSGPTMP) PPAGE=PPAGE+1 I PSGP'=$G(PSGPTMP) S PSGPTMP=PSGP,PPAGE=1"
^XMB(3.9,146021,2,393,0)="""RTN"",""PSJHEAD"",22,0)"
^XMB(3.9,146021,2,394,0)=" D NOW^%DTC S PSGDT=%,HDT=$$ENDTC^PSGMI(PSGDT)"
^XMB(3.9,146021,2,395,0)="""RTN"",""PSJHEAD"",23,0)"
^XMB(3.9,146021,2,396,0)=" S VA200=1 D INP^VADPT"
^XMB(3.9,146021,2,397,0)="""RTN"",""PSJHEAD"",24,0)"
^XMB(3.9,146021,2,398,0)=" I VAIN(4) S PSJPWD=+VAIN(4),PSJPWDN=$P(VAIN(4),""^"",2),(PSJPRB,RB)=VAIN(5),PSJPAD=+VAIN(7),PSJPDX=VAIN(9),PSJPDD="""",PSJPTD=$S($D(^PS(55,DFN,5.1)):$P(^(5.1),""^"",4),1:"""")"
^XMB(3.9,146021,2,399,0)="""RTN"",""PSJHEAD"",25,0)"
^XMB(3.9,146021,2,400,0)=" I 'VAIN(4) S VAIP(""D"")=""L"" D IN5^VADPT S PSJPWD=+VAIP(5),PSJPWDN=$P(VAIP(5),""^"",2),(PSJPRB,RB)=$P(VAIP(6),""^"",2),PSJPAD=+VAIP(13,1),PSJPDX=VAIP(9) D"
^XMB(3.9,146021,2,401,0)="""RTN"",""PSJHEAD"",26,0)"
^XMB(3.9,146021,2,402,0)=" .S PSGID=+VAIP(3),X=+VAIP(4)=12!(+VAIP(4)=38),PSJPTD="""",PSJPDD=PSGID_""^""_$$ENDTC^PSGMI(PSGID) S:X PSJPDD=PSJPDD_""^1"""
^XMB(3.9,146021,2,403,0)="""RTN"",""PSJHEAD"",27,0)"
^XMB(3.9,146021,2,404,0)=" D DEM^VADPT,HTWT^PSJAC(DFN)"
^XMB(3.9,146021,2,405,0)="""RTN"",""PSJHEAD"",28,0)"
^XMB(3.9,146021,2,406,0)=" S PSGP(0)=VADM(1),PSJPDOB=+VADM(3),PSJPAGE=VADM(4),PSJPSEX=$S(VADM(5)]"""":VADM(5),1:""?^____""),PSJPPID=VA(""PID"")"
^XMB(3.9,146021,2,407,0)="""RTN"",""PSJHEAD"",29,0)"
^XMB(3.9,146021,2,408,0)=" F X=""PSJPAD"",""PSJPDOB"",""PSJPTD"" I $G(@X) S $P(@X,""^"",2)=$S($D(PSJY2K):$$ENDTC2^PSGMI(+@X),1:$$ENDTC^PSGMI(+@X))"
^XMB(3.9,146021,2,409,0)="""RTN"",""PSJHEAD"",30,0)"
^XMB(3.9,146021,2,410,0)="ENHEAD ; print new page, name, ssn, dob, and ward"
^XMB(3.9,146021,2,411,0)="""RTN"",""PSJHEAD"",31,0)"
^XMB(3.9,146021,2,412,0)=" I $D(ENGET) S RB=$S($G(PSJPRB)]"""":PSJPRB,1:""* NF *"")"
^XMB(3.9,146021,2,413,0)="""RTN"",""PSJHEAD"",32,0)"
^XMB(3.9,146021,2,414,0)=" S SLS="""",$P(SLS,"" -"",15)="""""
^XMB(3.9,146021,2,415,0)="""RTN"",""PSJHEAD"",33,0)"
^XMB(3.9,146021,2,416,0)=" ;* I PSJOPC]"""" W:$Y @IOF W ! W:PSJOPC=""ALL"" ?16,""I N P A T I E N T   M E D I C A T I O N S"" W:PSJOPC=""UD"" ?19,""U N I T   D O S E   P R O F I L E"" W:PSJOPC=""IV"" !,?19,""I V  P A T I E N T  P R O F I L E"" W ?64,HDT,!,SLS,SLS,$E(SLS,1,24),!"
^XMB(3.9,146021,2,417,0)="""RTN"",""PSJHEAD"",34,0)"
^XMB(3.9,146021,2,418,0)=" I PSJOPC]"""" D"
^XMB(3.9,146021,2,419,0)="""RTN"",""PSJHEAD"",35,0)"
