^XMB(3.9,146037,2,2769,0)="""RTN"",""RCDPTAR1"",228,0)"
^XMB(3.9,146037,2,2770,0)="REPORT(RCDT1,RCDT2,RCEXCEL) ; Output the report (original summary mode)"
^XMB(3.9,146037,2,2771,0)="""RTN"",""RCDPTAR1"",229,0)"
