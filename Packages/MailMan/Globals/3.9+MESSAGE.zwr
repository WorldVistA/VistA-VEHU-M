^XMB(3.9,146103,2,201,0)="""QUES"",""XPM1"",""A"")"
^XMB(3.9,146103,2,202,0)="Enter the Coordinator for Mail Group '|FLAG|'"
^XMB(3.9,146103,2,203,0)="""QUES"",""XPM1"",""B"")"
