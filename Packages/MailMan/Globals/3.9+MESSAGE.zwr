^XMB(3.9,146047,2,3119,0)="""RTN"",""IBJPI"",74,0)"
^XMB(3.9,146047,2,3120,0)=" ;"
^XMB(3.9,146047,2,3121,0)="""RTN"",""IBJPI"",75,0)"
^XMB(3.9,146047,2,3122,0)="BLDGENE(SLINE,ELINE) ; Build the General Editable Parameters Section"
^XMB(3.9,146047,2,3123,0)="""RTN"",""IBJPI"",76,0)"
^XMB(3.9,146047,2,3124,0)=" ; Input:   SLINE   - Starting Section Line Number"
