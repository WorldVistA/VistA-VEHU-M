^XMB(3.9,146036,2,2612,0)=" Q"
^XMB(3.9,146036,2,2613,0)="""RTN"",""DVBCUTIL"",96,0)"
^XMB(3.9,146036,2,2614,0)=" ;"
^XMB(3.9,146036,2,2615,0)="""RTN"",""DVBCUTIL"",97,0)"
^XMB(3.9,146036,2,2616,0)="SSNSHRT ;  ** Set SSN in the Format '***********' **"
^XMB(3.9,146036,2,2617,0)="""RTN"",""DVBCUTIL"",98,0)"
^XMB(3.9,146036,2,2618,0)=" K DVBCSSNO"
^XMB(3.9,146036,2,2619,0)="""RTN"",""DVBCUTIL"",99,0)"
