^XMB(3.9,146083,2,203,0)="""QUES"",""XPO1"",0)"
^XMB(3.9,146083,2,204,0)="Y"
^XMB(3.9,146083,2,205,0)="""QUES"",""XPO1"",""??"")"
^XMB(3.9,146083,2,206,0)="^D MENU^XPDH"
^XMB(3.9,146083,2,207,0)="""QUES"",""XPO1"",""A"")"
^XMB(3.9,146083,2,208,0)="Want KIDS to Rebuild Menu Trees Upon Completion of Install"
