^XMB(3.9,146106,2,2975,0)="""RTN"",""SDES2DELCLNREADT"",13,0)"
^XMB(3.9,146106,2,2976,0)="SDDELREACTDT(SDRETURN,SDCONTEXT,SDPARAM) ; RPC: SDES2 DEL CLINIC REACT DATE"
^XMB(3.9,146106,2,2977,0)="""RTN"",""SDES2DELCLNREADT"",14,0)"
^XMB(3.9,146106,2,2978,0)=" ;INPUT -"
^XMB(3.9,146106,2,2979,0)="""RTN"",""SDES2DELCLNREADT"",15,0)"
^XMB(3.9,146106,2,2980,0)=" ; SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number. Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XMB(3.9,146106,2,2981,0)="""RTN"",""SDES2DELCLNREADT"",16,0)"
^XMB(3.9,146106,2,2982,0)=" ; SDCONTEXT(""PATIENT DFN"") = The DFN/IEN of the target patient from the calling application."
^XMB(3.9,146106,2,2983,0)="""RTN"",""SDES2DELCLNREADT"",17,0)"
^XMB(3.9,146106,2,2984,0)=" ; SDCONTEXT(""PATIENT ICN"") = The ICN of the target patient from the calling application."
^XMB(3.9,146106,2,2985,0)="""RTN"",""SDES2DELCLNREADT"",18,0)"
^XMB(3.9,146106,2,2986,0)=" ; SDCONTEXT(""USER DUZ"") = The DUZ of the user taking action in the calling application."
^XMB(3.9,146106,2,2987,0)="""RTN"",""SDES2DELCLNREADT"",19,0)"
^XMB(3.9,146106,2,2988,0)=" ; SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the calling application."
^XMB(3.9,146106,2,2989,0)="""RTN"",""SDES2DELCLNREADT"",20,0)"
