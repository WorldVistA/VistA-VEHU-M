^XMB(3.9,146087,2,657,0)="""RTN"",""YTQRCDB"",9,0)"
^XMB(3.9,146087,2,658,0)="SAVEADM(ARGS,DATA) ; Save instrument administration and answers"
^XMB(3.9,146087,2,659,0)="""RTN"",""YTQRCDB"",10,0)"
^XMB(3.9,146087,2,660,0)=" N YSARR,ADMM,ANSRES,SCRRES,TEST,YSLG"
^XMB(3.9,146087,2,661,0)="""RTN"",""YTQRCDB"",11,0)"
^XMB(3.9,146087,2,662,0)=" S TEST=$G(DATA(""name"")) I TEST="""" D SETERROR^YTQRUTL(404,""Missing Test"") Q ""/api/mha/cdb/instrument/admin/""_0"
^XMB(3.9,146087,2,663,0)="""RTN"",""YTQRCDB"",12,0)"
^XMB(3.9,146087,2,664,0)=" S DATA(""instrumentId"")=$O(^YTT(601.71,""B"",TEST,0))"
^XMB(3.9,146087,2,665,0)="""RTN"",""YTQRCDB"",13,0)"
^XMB(3.9,146087,2,666,0)=" I DATA(""instrumentId"")="""" S DATA(""instrumentId"")=$O(^YTT(601.71,""B"",$TR(TEST,""_"","" ""),0))"
^XMB(3.9,146087,2,667,0)="""RTN"",""YTQRCDB"",14,0)"
^XMB(3.9,146087,2,668,0)=" I DATA(""instrumentId"")="""" D SETERROR^YTQRUTL(404,""Test not found"") Q ""/api/mha/cdb/instrument/admin/""_0"
^XMB(3.9,146087,2,669,0)="""RTN"",""YTQRCDB"",15,0)"
^XMB(3.9,146087,2,670,0)=" S ADMM=$$FILADMIN(.DATA)  ; Passed in ADMIN ID for previously scored, New ADMIN ID, 0=Error"
^XMB(3.9,146087,2,671,0)="""RTN"",""YTQRCDB"",16,0)"
^XMB(3.9,146087,2,672,0)=" I ADMM=0 Q ""/api/mha/cdb/instrument/admin/""_ADMM"
^XMB(3.9,146087,2,673,0)="""RTN"",""YTQRCDB"",17,0)"
^XMB(3.9,146087,2,674,0)=" S ANSRES=$$FILANS(ADMM,.DATA)"
^XMB(3.9,146087,2,675,0)="""RTN"",""YTQRCDB"",18,0)"
^XMB(3.9,146087,2,676,0)=" I ANSRES<1 D SETERROR^YTQRUTL(500,""Error Filing Answers"") Q ""/api/mha/cdb/instrument/admin/""_0"
^XMB(3.9,146087,2,677,0)="""RTN"",""YTQRCDB"",19,0)"
^XMB(3.9,146087,2,678,0)=" S YSLG=$$GET1^DIQ(601.71,DATA(""instrumentId"")_"","",23)"
^XMB(3.9,146087,2,679,0)="""RTN"",""YTQRCDB"",20,0)"
^XMB(3.9,146087,2,680,0)=" I YSLG=""Yes"" K ^TMP($J) Q ""/api/mha/cdb/instrument/admin/""_ADMM  ; Don't score legacy instruments"
^XMB(3.9,146087,2,681,0)="""RTN"",""YTQRCDB"",21,0)"
^XMB(3.9,146087,2,682,0)=" S SCRRES=-1 I ADMM'=0 S SCRRES=$$SAVESCR(ADMM,.DATA)"
^XMB(3.9,146087,2,683,0)="""RTN"",""YTQRCDB"",22,0)"
