^XMB(3.9,146037,2,1311,0)="""RTN"",""RCDPESR1"",17,0)"
^XMB(3.9,146037,2,1312,0)=" S CT=0"
^XMB(3.9,146037,2,1313,0)="""RTN"",""RCDPESR1"",18,0)"
^XMB(3.9,146037,2,1314,0)=" ;"
^XMB(3.9,146037,2,1315,0)="""RTN"",""RCDPESR1"",19,0)"
^XMB(3.9,146037,2,1316,0)=" I $G(RCEMG)="""" S CT=CT+1,RCXM(CT)=$P($T(ERROR+2),"";;"",2),XMTO(.5)="""""
^XMB(3.9,146037,2,1317,0)="""RTN"",""RCDPESR1"",20,0)"
^XMB(3.9,146037,2,1318,0)=" ;"
^XMB(3.9,146037,2,1319,0)="""RTN"",""RCDPESR1"",21,0)"
^XMB(3.9,146037,2,1320,0)=" I $D(RCEMG) D"
^XMB(3.9,146037,2,1321,0)="""RTN"",""RCDPESR1"",22,0)"
^XMB(3.9,146037,2,1322,0)=" . S:RCEMG="""" RCEMG=""RCDPE PAYMENTS EXCEPTIONS"""
^XMB(3.9,146037,2,1323,0)="""RTN"",""RCDPESR1"",23,0)"
^XMB(3.9,146037,2,1324,0)=" . S:$E(RCEMG,1,2)'=""G."" RCEMG=""G.""_RCEMG"
^XMB(3.9,146037,2,1325,0)="""RTN"",""RCDPESR1"",24,0)"
^XMB(3.9,146037,2,1326,0)=" . S XMTO(""I:""_RCEMG)="""""
^XMB(3.9,146037,2,1327,0)="""RTN"",""RCDPESR1"",25,0)"
^XMB(3.9,146037,2,1328,0)=" ;"
^XMB(3.9,146037,2,1329,0)="""RTN"",""RCDPESR1"",26,0)"
^XMB(3.9,146037,2,1330,0)=" S Z=$O(XMTO("""")) I Z=.5,'$O(XMTO(.5)) S XMTO(""I:G.RCDPE PAYMENTS EXCEPTIONS"")="""""
^XMB(3.9,146037,2,1331,0)="""RTN"",""RCDPESR1"",27,0)"
^XMB(3.9,146037,2,1332,0)=" D EMFORM(CT,.RCERR,.RCXM,RCXMZ)"
^XMB(3.9,146037,2,1333,0)="""RTN"",""RCDPESR1"",28,0)"
^XMB(3.9,146037,2,1334,0)=" ;"
^XMB(3.9,146037,2,1335,0)="""RTN"",""RCDPESR1"",29,0)"
^XMB(3.9,146037,2,1336,0)=" S XMDUZ="""""
^XMB(3.9,146037,2,1337,0)="""RTN"",""RCDPESR1"",30,0)"
^XMB(3.9,146037,2,1338,0)=" S XMSUBJ=""EDI LBOX SERVER OPTION ERROR"",XMBODY=""RCXM"""
^XMB(3.9,146037,2,1339,0)="""RTN"",""RCDPESR1"",31,0)"
^XMB(3.9,146037,2,1340,0)=" D"
^XMB(3.9,146037,2,1341,0)="""RTN"",""RCDPESR1"",32,0)"
^XMB(3.9,146037,2,1342,0)=" . N DUZ S DUZ=.5,DUZ(0)=""@"""
^XMB(3.9,146037,2,1343,0)="""RTN"",""RCDPESR1"",33,0)"
^XMB(3.9,146037,2,1344,0)=" . D SENDMSG^XMXAPI(.5,XMSUBJ,XMBODY,.XMTO,,.XMZ)"
^XMB(3.9,146037,2,1345,0)="""RTN"",""RCDPESR1"",34,0)"
^XMB(3.9,146037,2,1346,0)=" ;"
^XMB(3.9,146037,2,1347,0)="""RTN"",""RCDPESR1"",35,0)"
^XMB(3.9,146037,2,1348,0)=" ; PRCA*4.5*349 - Send a new message to an Outlook email group notifying of error"
^XMB(3.9,146037,2,1349,0)="""RTN"",""RCDPESR1"",36,0)"
^XMB(3.9,146037,2,1350,0)=" D OUTMSG(.RCERR,RCXMZ)"
^XMB(3.9,146037,2,1351,0)="""RTN"",""RCDPESR1"",37,0)"
^XMB(3.9,146037,2,1352,0)=" K ^TMP(""RCRAW"",$J)"
^XMB(3.9,146037,2,1353,0)="""RTN"",""RCDPESR1"",38,0)"
^XMB(3.9,146037,2,1354,0)=" Q"
^XMB(3.9,146037,2,1355,0)="""RTN"",""RCDPESR1"",39,0)"
^XMB(3.9,146037,2,1356,0)=" ;"
^XMB(3.9,146037,2,1357,0)="""RTN"",""RCDPESR1"",40,0)"
^XMB(3.9,146037,2,1358,0)="OUTMSG(RCERR,RCXMZ) ; Build message to send to Outlook address"
^XMB(3.9,146037,2,1359,0)="""RTN"",""RCDPESR1"",41,0)"
^XMB(3.9,146037,2,1360,0)=" ; PRCA*4.5*349 - New subroutine"
^XMB(3.9,146037,2,1361,0)="""RTN"",""RCDPESR1"",42,0)"
^XMB(3.9,146037,2,1362,0)=" ; RCERR = Error text array"
^XMB(3.9,146037,2,1363,0)="""RTN"",""RCDPESR1"",43,0)"
^XMB(3.9,146037,2,1364,0)=" ; RCXMZ = internal entry # of the mailman msg"
^XMB(3.9,146037,2,1365,0)="""RTN"",""RCDPESR1"",44,0)"
^XMB(3.9,146037,2,1366,0)=" N CT,RCMTXT,RCXM,TDATE,TTYPE,XMBODY,XMDUZ,XMSUBJ,XMTO,XMZ"
^XMB(3.9,146037,2,1367,0)="""RTN"",""RCDPESR1"",45,0)"
^XMB(3.9,146037,2,1368,0)=" S TDATE=$G(^TMP(""RCERR"",$J,""DATE"")),TDATE=$$FMTE^XLFDT(TDATE)"
^XMB(3.9,146037,2,1369,0)="""RTN"",""RCDPESR1"",46,0)"
^XMB(3.9,146037,2,1370,0)=" S TTYPE=$G(^TMP(""RCMSG"",$J))"
^XMB(3.9,146037,2,1371,0)="""RTN"",""RCDPESR1"",47,0)"
^XMB(3.9,146037,2,1372,0)=" S XMBODY=""RCXM"""
^XMB(3.9,146037,2,1373,0)="""RTN"",""RCDPESR1"",48,0)"
^XMB(3.9,146037,2,1374,0)=" ;"
^XMB(3.9,146037,2,1375,0)="""RTN"",""RCDPESR1"",49,0)"
^XMB(3.9,146037,2,1376,0)=" S CT=1"
^XMB(3.9,146037,2,1377,0)="""RTN"",""RCDPESR1"",50,0)"
^XMB(3.9,146037,2,1378,0)=" S RCXM(CT)=""** AN EXCEPTION HAS BEEN DETECTED FOR AN EDI LOCKBOX MESSAGE **"",CT=CT+1,RCXM(CT)="" """
^XMB(3.9,146037,2,1379,0)="""RTN"",""RCDPESR1"",51,0)"
^XMB(3.9,146037,2,1380,0)=" S CT=CT+1"
^XMB(3.9,146037,2,1381,0)="""RTN"",""RCDPESR1"",52,0)"
^XMB(3.9,146037,2,1382,0)=" S RCXM(CT)=""Message Type: ""_$S(TTYPE="""":$S($G(^TMP(""RCERR"",$J,""TYPE""))'="""":^(""TYPE""),1:""Cannot be determined""),1:TTYPE)"
^XMB(3.9,146037,2,1383,0)="""RTN"",""RCDPESR1"",53,0)"
^XMB(3.9,146037,2,1384,0)=" ;"
^XMB(3.9,146037,2,1385,0)="""RTN"",""RCDPESR1"",54,0)"
^XMB(3.9,146037,2,1386,0)=" S CT=CT+2"
^XMB(3.9,146037,2,1387,0)="""RTN"",""RCDPESR1"",55,0)"
^XMB(3.9,146037,2,1388,0)=" S RCXM(CT-1)="" "",RCXM(CT)=""Message Date: ""_TDATE"
^XMB(3.9,146037,2,1389,0)="""RTN"",""RCDPESR1"",56,0)"
^XMB(3.9,146037,2,1390,0)=" ;"
^XMB(3.9,146037,2,1391,0)="""RTN"",""RCDPESR1"",57,0)"
^XMB(3.9,146037,2,1392,0)=" S CT=CT+1,RCXM(CT)=""Mailman Message #: ""_$G(RCXMZ)"
^XMB(3.9,146037,2,1393,0)="""RTN"",""RCDPESR1"",58,0)"
^XMB(3.9,146037,2,1394,0)=" S CT=CT+1,RCXM(CT)="" """
^XMB(3.9,146037,2,1395,0)="""RTN"",""RCDPESR1"",59,0)"
^XMB(3.9,146037,2,1396,0)=" S CT=CT+1,RCXM(CT)=""Error: ""_$S($D(^TMP(""RCERR"",$J,""TEXT"")):^TMP(""RCERR"",$J,""TEXT""),1:""Unknown error"")"
^XMB(3.9,146037,2,1397,0)="""RTN"",""RCDPESR1"",60,0)"
^XMB(3.9,146037,2,1398,0)=" I TTYPE[""EFT"" D"
^XMB(3.9,146037,2,1399,0)="""RTN"",""RCDPESR1"",61,0)"
^XMB(3.9,146037,2,1400,0)=" . D OUTEFT($NA(^TMP(""RCERR"",$J,""MSG"")),.CT,""RCXM"")"
^XMB(3.9,146037,2,1401,0)="""RTN"",""RCDPESR1"",62,0)"
^XMB(3.9,146037,2,1402,0)=" ; To be safe, try to parse unknown message types as ERAs for the purpose of"
^XMB(3.9,146037,2,1403,0)="""RTN"",""RCDPESR1"",63,0)"
^XMB(3.9,146037,2,1404,0)=" ; masking PII"
^XMB(3.9,146037,2,1405,0)="""RTN"",""RCDPESR1"",64,0)"
^XMB(3.9,146037,2,1406,0)=" I TTYPE'[""EFT"" D"
^XMB(3.9,146037,2,1407,0)="""RTN"",""RCDPESR1"",65,0)"
^XMB(3.9,146037,2,1408,0)=" . D OUTERA($NA(^TMP(""RCERR"",$J,""MSG"")),.CT,""RCXM"")"
^XMB(3.9,146037,2,1409,0)="""RTN"",""RCDPESR1"",66,0)"
^XMB(3.9,146037,2,1410,0)=" ;"
^XMB(3.9,146037,2,1411,0)="""RTN"",""RCDPESR1"",67,0)"
^XMB(3.9,146037,2,1412,0)=" S XMDUZ="""",XMSUBJ=""EDI LBOX-STA# ""_$P($$SITE^VASITE,""^"",3)_""-TRANSMISSION ERROR"""
^XMB(3.9,146037,2,1413,0)="""RTN"",""RCDPESR1"",68,0)"
^XMB(3.9,146037,2,1414,0)=" S XMTO(""vha835payerinquiry@domain"")="""""
^XMB(3.9,146037,2,1415,0)="""RTN"",""RCDPESR1"",69,0)"
^XMB(3.9,146037,2,1416,0)=" D"
^XMB(3.9,146037,2,1417,0)="""RTN"",""RCDPESR1"",70,0)"
^XMB(3.9,146037,2,1418,0)=" . N DUZ S DUZ=.5,DUZ(0)=""@"""
^XMB(3.9,146037,2,1419,0)="""RTN"",""RCDPESR1"",71,0)"
^XMB(3.9,146037,2,1420,0)=" . D SENDMSG^XMXAPI(.5,XMSUBJ,XMBODY,.XMTO,,.XMZ)"
^XMB(3.9,146037,2,1421,0)="""RTN"",""RCDPESR1"",72,0)"
^XMB(3.9,146037,2,1422,0)=" Q"
^XMB(3.9,146037,2,1423,0)="""RTN"",""RCDPESR1"",73,0)"
^XMB(3.9,146037,2,1424,0)="OUTERA(RAW,CT,RCMTXT) ; Format ERA/EEOB for Outlook message"
^XMB(3.9,146037,2,1425,0)="""RTN"",""RCDPESR1"",74,0)"
^XMB(3.9,146037,2,1426,0)=" ; PRCA*4.5*349 - New Subroutine"
^XMB(3.9,146037,2,1427,0)="""RTN"",""RCDPESR1"",75,0)"
^XMB(3.9,146037,2,1428,0)=" ; RAW - Points to raw data from the message"
^XMB(3.9,146037,2,1429,0)="""RTN"",""RCDPESR1"",76,0)"
^XMB(3.9,146037,2,1430,0)=" ; CT - (Passed by Reference) Current message text line count"
^XMB(3.9,146037,2,1431,0)="""RTN"",""RCDPESR1"",77,0)"
^XMB(3.9,146037,2,1432,0)=" ; RCMTXT - Pointer to message text array"
^XMB(3.9,146037,2,1433,0)="""RTN"",""RCDPESR1"",78,0)"
^XMB(3.9,146037,2,1434,0)=" N I,J,LN,RC,RCDAT,RCREF,OUTXFRM,X,Y,Z"
^XMB(3.9,146037,2,1435,0)="""RTN"",""RCDPESR1"",79,0)"
^XMB(3.9,146037,2,1436,0)=" Q:RCMTXT=""""!(RAW="""")"
^XMB(3.9,146037,2,1437,0)="""RTN"",""RCDPESR1"",80,0)"
^XMB(3.9,146037,2,1438,0)=" S J="""" F  S J=$O(@RAW@(J)) Q:J=""""  I +$G(@RAW@(J))=835 D  Q"
^XMB(3.9,146037,2,1439,0)="""RTN"",""RCDPESR1"",81,0)"
^XMB(3.9,146037,2,1440,0)=" . S LN=$G(@RAW@(J))"
^XMB(3.9,146037,2,1441,0)="""RTN"",""RCDPESR1"",82,0)"
^XMB(3.9,146037,2,1442,0)=" . F I=8,10,6,7 D"
^XMB(3.9,146037,2,1443,0)="""RTN"",""RCDPESR1"",83,0)"
^XMB(3.9,146037,2,1444,0)=" . . S RCDAT=$P(LN,U,I)"
^XMB(3.9,146037,2,1445,0)="""RTN"",""RCDPESR1"",84,0)"
^XMB(3.9,146037,2,1446,0)=" . . S RCREF=""835+""_I_""^RCDPESR9"",RC=$P($T(@RCREF),"";;"",2)"
^XMB(3.9,146037,2,1447,0)="""RTN"",""RCDPESR1"",85,0)"
^XMB(3.9,146037,2,1448,0)=" . . S OUTXFRM=$P(RC,U,4,99)"
^XMB(3.9,146037,2,1449,0)="""RTN"",""RCDPESR1"",86,0)"
^XMB(3.9,146037,2,1450,0)=" . . I OUTXFRM'="""" S X=RCDAT X OUTXFRM S RCDAT=Y"
^XMB(3.9,146037,2,1451,0)="""RTN"",""RCDPESR1"",87,0)"
^XMB(3.9,146037,2,1452,0)=" . . S CT=CT+1,@RCMTXT@(CT)=$P(RC,U,3)_"": ""_RCDAT"
^XMB(3.9,146037,2,1453,0)="""RTN"",""RCDPESR1"",88,0)"
^XMB(3.9,146037,2,1454,0)=" S Z=0 F  S Z=$O(@RAW@(Z)) Q:Z=""""  D"
^XMB(3.9,146037,2,1455,0)="""RTN"",""RCDPESR1"",89,0)"
^XMB(3.9,146037,2,1456,0)=" . S CT=CT+1,@RCMTXT@(CT)=$$MASKPII(@RAW@(Z))"
^XMB(3.9,146037,2,1457,0)="""RTN"",""RCDPESR1"",90,0)"
^XMB(3.9,146037,2,1458,0)=" Q"
^XMB(3.9,146037,2,1459,0)="""RTN"",""RCDPESR1"",91,0)"
^XMB(3.9,146037,2,1460,0)="OUTEFT(RAW,CT,RCMTXT) ; Format EFT for Outlook message"
^XMB(3.9,146037,2,1461,0)="""RTN"",""RCDPESR1"",92,0)"
^XMB(3.9,146037,2,1462,0)=" ; PRCA*4.5*349 - New Subroutine ; PRCA*4.5*439 - Substantial changes to data in outlook message"
^XMB(3.9,146037,2,1463,0)="""RTN"",""RCDPESR1"",93,0)"
^XMB(3.9,146037,2,1464,0)=" ; RAW - Points to raw data from the message"
^XMB(3.9,146037,2,1465,0)="""RTN"",""RCDPESR1"",94,0)"
^XMB(3.9,146037,2,1466,0)=" ; CT - (Passed by Reference) Current message text line count"
^XMB(3.9,146037,2,1467,0)="""RTN"",""RCDPESR1"",95,0)"
^XMB(3.9,146037,2,1468,0)=" ; RCMTXT - Pointer to message text array"
^XMB(3.9,146037,2,1469,0)="""RTN"",""RCDPESR1"",96,0)"
^XMB(3.9,146037,2,1470,0)=" N AMT,DATA,EFTCNT,EFTTOT,I,Z"
^XMB(3.9,146037,2,1471,0)="""RTN"",""RCDPESR1"",97,0)"
^XMB(3.9,146037,2,1472,0)=" Q:RCMTXT=""""!(RAW="""")"
^XMB(3.9,146037,2,1473,0)="""RTN"",""RCDPESR1"",98,0)"
^XMB(3.9,146037,2,1474,0)=" S (EFTCNT,EFTTOT)=0"
^XMB(3.9,146037,2,1475,0)="""RTN"",""RCDPESR1"",99,0)"
^XMB(3.9,146037,2,1476,0)=" S I="""" F  S I=$O(@RAW@(I)) Q:'I  D"
^XMB(3.9,146037,2,1477,0)="""RTN"",""RCDPESR1"",100,0)"
^XMB(3.9,146037,2,1478,0)=" . S DATA=$G(@RAW@(I))"
^XMB(3.9,146037,2,1479,0)="""RTN"",""RCDPESR1"",101,0)"
^XMB(3.9,146037,2,1480,0)=" . I $P(DATA,U)=""835EFT"" D  ;"
^XMB(3.9,146037,2,1481,0)="""RTN"",""RCDPESR1"",102,0)"
^XMB(3.9,146037,2,1482,0)=" . . S DATA(""HEAD"",1)=""Deposit Number: ""_$P(DATA,U,6)"
^XMB(3.9,146037,2,1483,0)="""RTN"",""RCDPESR1"",103,0)"
^XMB(3.9,146037,2,1484,0)=" . . S DATA(""HEAD"",2)=""Deposit Date: ""_$P(DATA,U,7)"
^XMB(3.9,146037,2,1485,0)="""RTN"",""RCDPESR1"",104,0)"
^XMB(3.9,146037,2,1486,0)=" . . S DATA(""HEAD"",3)=""Deposit Total: ""_$$ZERO^RCDPESR9($P(DATA,U,8),1)"
^XMB(3.9,146037,2,1487,0)="""RTN"",""RCDPESR1"",105,0)"
^XMB(3.9,146037,2,1488,0)=" . I $P(DATA,U)=""01"" D  ;"
^XMB(3.9,146037,2,1489,0)="""RTN"",""RCDPESR1"",106,0)"
^XMB(3.9,146037,2,1490,0)=" . . I EFTCNT=0 D  ;"
^XMB(3.9,146037,2,1491,0)="""RTN"",""RCDPESR1"",107,0)"
^XMB(3.9,146037,2,1492,0)=" . . . S EFTCNT=EFTCNT+1"
^XMB(3.9,146037,2,1493,0)="""RTN"",""RCDPESR1"",108,0)"
^XMB(3.9,146037,2,1494,0)=" . . . S DATA(""EFT"",EFTCNT)=""*** EFT DETAIL ***"""
^XMB(3.9,146037,2,1495,0)="""RTN"",""RCDPESR1"",109,0)"
^XMB(3.9,146037,2,1496,0)=" . . S AMT=$$ZERO^RCDPESR9($P(DATA,U,4),1)"
^XMB(3.9,146037,2,1497,0)="""RTN"",""RCDPESR1"",110,0)"
^XMB(3.9,146037,2,1498,0)=" . . S EFTCNT=EFTCNT+1 S DATA(""EFT"",EFTCNT)="" """
^XMB(3.9,146037,2,1499,0)="""RTN"",""RCDPESR1"",111,0)"
^XMB(3.9,146037,2,1500,0)=" . . S EFTCNT=EFTCNT+1 S DATA(""EFT"",EFTCNT)=""Trace Number: ""_$P(DATA,U,2)"
^XMB(3.9,146037,2,1501,0)="""RTN"",""RCDPESR1"",112,0)"
^XMB(3.9,146037,2,1502,0)=" . . S EFTCNT=EFTCNT+1 S DATA(""EFT"",EFTCNT)=""Dollar Amt: ""_AMT"
^XMB(3.9,146037,2,1503,0)="""RTN"",""RCDPESR1"",113,0)"
^XMB(3.9,146037,2,1504,0)=" . . S EFTCNT=EFTCNT+1 S DATA(""EFT"",EFTCNT)=""Payer Name: ""_$P(DATA,U,5)"
^XMB(3.9,146037,2,1505,0)="""RTN"",""RCDPESR1"",114,0)"
^XMB(3.9,146037,2,1506,0)=" . . S EFTCNT=EFTCNT+1 S DATA(""EFT"",EFTCNT)=""Payer ID: ""_$P(DATA,U,6)"
^XMB(3.9,146037,2,1507,0)="""RTN"",""RCDPESR1"",115,0)"
^XMB(3.9,146037,2,1508,0)=" . . S EFTTOT=EFTTOT+AMT"
^XMB(3.9,146037,2,1509,0)="""RTN"",""RCDPESR1"",116,0)"
^XMB(3.9,146037,2,1510,0)=" S DATA(""HEAD"",4)=""EFT Total Amt: ""_$J(EFTTOT,$L(EFTTOT),2)"
^XMB(3.9,146037,2,1511,0)="""RTN"",""RCDPESR1"",117,0)"
^XMB(3.9,146037,2,1512,0)=" ;"
^XMB(3.9,146037,2,1513,0)="""RTN"",""RCDPESR1"",118,0)"
^XMB(3.9,146037,2,1514,0)=" ; Add header data to message"
^XMB(3.9,146037,2,1515,0)="""RTN"",""RCDPESR1"",119,0)"
^XMB(3.9,146037,2,1516,0)=" S Z=0 F  S Z=$O(DATA(""HEAD"",Z)) Q:'Z  D"
^XMB(3.9,146037,2,1517,0)="""RTN"",""RCDPESR1"",120,0)"
^XMB(3.9,146037,2,1518,0)=" . S CT=CT+1,@RCMTXT@(CT)=DATA(""HEAD"",Z)"
^XMB(3.9,146037,2,1519,0)="""RTN"",""RCDPESR1"",121,0)"
^XMB(3.9,146037,2,1520,0)=" S CT=CT+1,@RCMTXT@(CT)="" """
^XMB(3.9,146037,2,1521,0)="""RTN"",""RCDPESR1"",122,0)"
^XMB(3.9,146037,2,1522,0)=" ; Add EFT data to message"
^XMB(3.9,146037,2,1523,0)="""RTN"",""RCDPESR1"",123,0)"
^XMB(3.9,146037,2,1524,0)=" S Z=0 F  S Z=$O(DATA(""EFT"",Z)) Q:'Z  D"
^XMB(3.9,146037,2,1525,0)="""RTN"",""RCDPESR1"",124,0)"
^XMB(3.9,146037,2,1526,0)=" . S CT=CT+1,@RCMTXT@(CT)=DATA(""EFT"",Z)"
^XMB(3.9,146037,2,1527,0)="""RTN"",""RCDPESR1"",125,0)"
^XMB(3.9,146037,2,1528,0)=" ;"
^XMB(3.9,146037,2,1529,0)="""RTN"",""RCDPESR1"",126,0)"
^XMB(3.9,146037,2,1530,0)=" S Z=0 F  S Z=$O(@RAW@(Z)) Q:'Z  D"
^XMB(3.9,146037,2,1531,0)="""RTN"",""RCDPESR1"",127,0)"
^XMB(3.9,146037,2,1532,0)=" . S CT=CT+1,@RCMTXT@(CT)=$G(@RAW@(Z))"
^XMB(3.9,146037,2,1533,0)="""RTN"",""RCDPESR1"",128,0)"
^XMB(3.9,146037,2,1534,0)=" Q"
^XMB(3.9,146037,2,1535,0)="""RTN"",""RCDPESR1"",129,0)"
^XMB(3.9,146037,2,1536,0)="EMFORM(CT,RCERR,RCXM,RCXMZ) ; Format error msgs"
^XMB(3.9,146037,2,1537,0)="""RTN"",""RCDPESR1"",130,0)"
^XMB(3.9,146037,2,1538,0)=" ; INPUT:"
^XMB(3.9,146037,2,1539,0)="""RTN"",""RCDPESR1"",131,0)"
^XMB(3.9,146037,2,1540,0)=" ;   CT = # of lines previously populated in error msg"
^XMB(3.9,146037,2,1541,0)="""RTN"",""RCDPESR1"",132,0)"
^XMB(3.9,146037,2,1542,0)=" ;   RCERR = array of errors"
^XMB(3.9,146037,2,1543,0)="""RTN"",""RCDPESR1"",133,0)"
^XMB(3.9,146037,2,1544,0)=" ;   RCXMZ = internal entry # of mailman msg"
^XMB(3.9,146037,2,1545,0)="""RTN"",""RCDPESR1"",134,0)"
^XMB(3.9,146037,2,1546,0)=" ;"
^XMB(3.9,146037,2,1547,0)="""RTN"",""RCDPESR1"",135,0)"
^XMB(3.9,146037,2,1548,0)=" ; OUTPUT:"
^XMB(3.9,146037,2,1549,0)="""RTN"",""RCDPESR1"",136,0)"
^XMB(3.9,146037,2,1550,0)=" ;   RCXM = array containing the complete error msg text"
^XMB(3.9,146037,2,1551,0)="""RTN"",""RCDPESR1"",137,0)"
^XMB(3.9,146037,2,1552,0)=" ;"
^XMB(3.9,146037,2,1553,0)="""RTN"",""RCDPESR1"",138,0)"
^XMB(3.9,146037,2,1554,0)=" N TTYPE,TDATE,TTIME,Z"
^XMB(3.9,146037,2,1555,0)="""RTN"",""RCDPESR1"",139,0)"
^XMB(3.9,146037,2,1556,0)=" ;"
^XMB(3.9,146037,2,1557,0)="""RTN"",""RCDPESR1"",140,0)"
^XMB(3.9,146037,2,1558,0)=" S TDATE=$G(^TMP(""RCERR"",$J,""DATE"")),TTIME=$P(TDATE,""."",2)_""000000"",TDATE=$$FMTE^XLFDT($P(TDATE,"".""),""2D"")"
^XMB(3.9,146037,2,1559,0)="""RTN"",""RCDPESR1"",141,0)"
^XMB(3.9,146037,2,1560,0)=" S TTYPE=$G(^TMP(""RCMSG"",$J))"
^XMB(3.9,146037,2,1561,0)="""RTN"",""RCDPESR1"",142,0)"
^XMB(3.9,146037,2,1562,0)=" ;"
^XMB(3.9,146037,2,1563,0)="""RTN"",""RCDPESR1"",143,0)"
^XMB(3.9,146037,2,1564,0)=" S CT=CT+1"
^XMB(3.9,146037,2,1565,0)="""RTN"",""RCDPESR1"",144,0)"
^XMB(3.9,146037,2,1566,0)=" S RCXM(CT)=""** AN EXCEPTION HAS BEEN DETECTED FOR AN EDI LOCKBOX RETURN MESSAGE **"",CT=CT+1,RCXM(CT)="" """
^XMB(3.9,146037,2,1567,0)="""RTN"",""RCDPESR1"",145,0)"
^XMB(3.9,146037,2,1568,0)=" S CT=CT+1"
^XMB(3.9,146037,2,1569,0)="""RTN"",""RCDPESR1"",146,0)"
^XMB(3.9,146037,2,1570,0)=" S RCXM(CT)=""             Return Message Code: ""_$S(TTYPE="""":$S($G(^TMP(""RCERR"",$J,""TYPE""))'="""":^(""TYPE""),1:""Cannot be determined""),1:TTYPE)"
^XMB(3.9,146037,2,1571,0)="""RTN"",""RCDPESR1"",147,0)"
^XMB(3.9,146037,2,1572,0)=" ;"
^XMB(3.9,146037,2,1573,0)="""RTN"",""RCDPESR1"",148,0)"
^XMB(3.9,146037,2,1574,0)=" S CT=CT+2"
^XMB(3.9,146037,2,1575,0)="""RTN"",""RCDPESR1"",149,0)"
^XMB(3.9,146037,2,1576,0)=" S RCXM(CT-1)="" "",RCXM(CT)=$J("""",13)_""Return Message Date: ""_TDATE_""    Message Time: ""_$E(TTIME,1,2)_"":""_$E(TTIME,3,4)_"":""_$E(TTIME,5,6),CT=CT+1"
^XMB(3.9,146037,2,1577,0)="""RTN"",""RCDPESR1"",150,0)"
^XMB(3.9,146037,2,1578,0)=" ;"
^XMB(3.9,146037,2,1579,0)="""RTN"",""RCDPESR1"",151,0)"
^XMB(3.9,146037,2,1580,0)=" S CT=CT+2,RCXM(CT-1)="" "",RCXM(CT)=$J("""",15)_""Mailman Message #: ""_$G(RCXMZ)"
^XMB(3.9,146037,2,1581,0)="""RTN"",""RCDPESR1"",152,0)"
^XMB(3.9,146037,2,1582,0)=" ;"
^XMB(3.9,146037,2,1583,0)="""RTN"",""RCDPESR1"",153,0)"
^XMB(3.9,146037,2,1584,0)=" I $G(RCERR)'="""",RCERR?1A.E S CT=CT+2,RCXM(CT-1)="" "",RCXM(CT)=RCERR"
^XMB(3.9,146037,2,1585,0)="""RTN"",""RCDPESR1"",154,0)"
^XMB(3.9,146037,2,1586,0)=" I $G(^TMP(""RCERR"",$J,""TEXT""))'="""" S CT=CT+2,RCXM(CT)=^(""TEXT""),RCXM(CT-1)="" """
^XMB(3.9,146037,2,1587,0)="""RTN"",""RCDPESR1"",155,0)"
^XMB(3.9,146037,2,1588,0)=" ;"
^XMB(3.9,146037,2,1589,0)="""RTN"",""RCDPESR1"",156,0)"
^XMB(3.9,146037,2,1590,0)=" S Z="""" F  S Z=$O(RCERR(Z)) Q:Z=""""  S:$G(^TMP(""RCERR"",$J,""TEXT""))="""" CT=CT+1,RCXM(CT)="" "" I $G(RCERR(Z))'="""",RCERR(Z)'="" "" S CT=CT+1,RCXM(CT)=RCERR(Z)"
^XMB(3.9,146037,2,1591,0)="""RTN"",""RCDPESR1"",157,0)"
^XMB(3.9,146037,2,1592,0)=" S Z=0 F  S Z=$O(^TMP(""RCERR"",$J,""MSG"",Z)) Q:'Z  S CT=CT+1,RCXM(CT)=^(Z)"
^XMB(3.9,146037,2,1593,0)="""RTN"",""RCDPESR1"",158,0)"
^XMB(3.9,146037,2,1594,0)=" ;"
^XMB(3.9,146037,2,1595,0)="""RTN"",""RCDPESR1"",159,0)"
^XMB(3.9,146037,2,1596,0)=" Q"
^XMB(3.9,146037,2,1597,0)="""RTN"",""RCDPESR1"",160,0)"
^XMB(3.9,146037,2,1598,0)=" ;"
^XMB(3.9,146037,2,1599,0)="""RTN"",""RCDPESR1"",161,0)"
^XMB(3.9,146037,2,1600,0)="MASKPII(X) ; Return a ""05"" field with PII masked for sending errors"
^XMB(3.9,146037,2,1601,0)="""RTN"",""RCDPESR1"",162,0)"
^XMB(3.9,146037,2,1602,0)=" ; PRCA*4.5*349 - Subroutine added"
^XMB(3.9,146037,2,1603,0)="""RTN"",""RCDPESR1"",163,0)"
^XMB(3.9,146037,2,1604,0)=" N I"
^XMB(3.9,146037,2,1605,0)="""RTN"",""RCDPESR1"",164,0)"
^XMB(3.9,146037,2,1606,0)=" I +X,+X'=""835"" D"
^XMB(3.9,146037,2,1607,0)="""RTN"",""RCDPESR1"",165,0)"
^XMB(3.9,146037,2,1608,0)=" . S $P(X,U,2)=""**REDACTED**"""
^XMB(3.9,146037,2,1609,0)="""RTN"",""RCDPESR1"",166,0)"
^XMB(3.9,146037,2,1610,0)=" I $P(X,U)=""05"" D"
^XMB(3.9,146037,2,1611,0)="""RTN"",""RCDPESR1"",167,0)"
^XMB(3.9,146037,2,1612,0)=" . F I=3:1:6 D"
^XMB(3.9,146037,2,1613,0)="""RTN"",""RCDPESR1"",168,0)"
^XMB(3.9,146037,2,1614,0)=" . . S $P(X,U,I)=""**REDACTED**"""
^XMB(3.9,146037,2,1615,0)="""RTN"",""RCDPESR1"",169,0)"
^XMB(3.9,146037,2,1616,0)=" Q X"
^XMB(3.9,146037,2,1617,0)="""RTN"",""RCDPESR1"",170,0)"
^XMB(3.9,146037,2,1618,0)=" ;"
^XMB(3.9,146037,2,1619,0)="""RTN"",""RCDPESR1"",171,0)"
^XMB(3.9,146037,2,1620,0)="EXTERR(RCERR,RCE) ; Put error into error array"
^XMB(3.9,146037,2,1621,0)="""RTN"",""RCDPESR1"",172,0)"
^XMB(3.9,146037,2,1622,0)=" ; Returns: (must be passed by reference)"
^XMB(3.9,146037,2,1623,0)="""RTN"",""RCDPESR1"",173,0)"
^XMB(3.9,146037,2,1624,0)=" ;   RCERR = specific error encountered, returned as 4"
^XMB(3.9,146037,2,1625,0)="""RTN"",""RCDPESR1"",174,0)"
^XMB(3.9,146037,2,1626,0)=" ;   RCE = error text from the word processing field update error global"
^XMB(3.9,146037,2,1627,0)="""RTN"",""RCDPESR1"",175,0)"
^XMB(3.9,146037,2,1628,0)=" N RCZ,Q"
^XMB(3.9,146037,2,1629,0)="""RTN"",""RCDPESR1"",176,0)"
^XMB(3.9,146037,2,1630,0)=" S RCE="""",RCERR=4 ; error reported as 'record was partially stored'"
^XMB(3.9,146037,2,1631,0)="""RTN"",""RCDPESR1"",177,0)"
^XMB(3.9,146037,2,1632,0)=" S RCZ=0 F  S RCZ=$O(RCE(""DIERR"",RCZ)) Q:'RCZ  S Q=$G(RCE(""DIERR"",RCZ,""TEXT"",1)) I $L(Q),$L(Q)+$L(RCE)<99 S RCE=RCE_Q_"";;"""
^XMB(3.9,146037,2,1633,0)="""RTN"",""RCDPESR1"",178,0)"
^XMB(3.9,146037,2,1634,0)=" Q"
^XMB(3.9,146037,2,1635,0)="""RTN"",""RCDPESR1"",179,0)"
^XMB(3.9,146037,2,1636,0)=" ;"
^XMB(3.9,146037,2,1637,0)="""RTN"",""RCDPESR1"",180,0)"
^XMB(3.9,146037,2,1638,0)="ERRUPD(RCGBL,RCD,RCTYPE,RCERR) ; Set up global array to hold msg data"
^XMB(3.9,146037,2,1639,0)="""RTN"",""RCDPESR1"",181,0)"
^XMB(3.9,146037,2,1640,0)=" ; RCGBL = name of the global or array where msg data is found"
^XMB(3.9,146037,2,1641,0)="""RTN"",""RCDPESR1"",182,0)"
^XMB(3.9,146037,2,1642,0)=" ; RCD = array containing mail header data for the msg"
^XMB(3.9,146037,2,1643,0)="""RTN"",""RCDPESR1"",183,0)"
^XMB(3.9,146037,2,1644,0)=" ; RCTYPE = type of msg (835ERA/835XFR/etc)"
^XMB(3.9,146037,2,1645,0)="""RTN"",""RCDPESR1"",184,0)"
^XMB(3.9,146037,2,1646,0)=" ; RCERR = error array - text or reference to error tables below"
^XMB(3.9,146037,2,1647,0)="""RTN"",""RCDPESR1"",185,0)"
^XMB(3.9,146037,2,1648,0)=" ;"
^XMB(3.9,146037,2,1649,0)="""RTN"",""RCDPESR1"",186,0)"
^XMB(3.9,146037,2,1650,0)=" ; Returns ^TMP(""RCERR"",$J,""MSG"" array with formatted error text"
^XMB(3.9,146037,2,1651,0)="""RTN"",""RCDPESR1"",187,0)"
^XMB(3.9,146037,2,1652,0)=" ;"
^XMB(3.9,146037,2,1653,0)="""RTN"",""RCDPESR1"",188,0)"
^XMB(3.9,146037,2,1654,0)=" N Z,Z0,Z1,Z2,CT,RCE"
^XMB(3.9,146037,2,1655,0)="""RTN"",""RCDPESR1"",189,0)"
^XMB(3.9,146037,2,1656,0)=" ;"
^XMB(3.9,146037,2,1657,0)="""RTN"",""RCDPESR1"",190,0)"
^XMB(3.9,146037,2,1658,0)=" Q:$G(RCERR)<0"
^XMB(3.9,146037,2,1659,0)="""RTN"",""RCDPESR1"",191,0)"
^XMB(3.9,146037,2,1660,0)=" K ^TMP(""RCERR"",$J)"
^XMB(3.9,146037,2,1661,0)="""RTN"",""RCDPESR1"",192,0)"
^XMB(3.9,146037,2,1662,0)=" S CT=0"
^XMB(3.9,146037,2,1663,0)="""RTN"",""RCDPESR1"",193,0)"
^XMB(3.9,146037,2,1664,0)=" ;"
^XMB(3.9,146037,2,1665,0)="""RTN"",""RCDPESR1"",194,0)"
^XMB(3.9,146037,2,1666,0)=" S ^TMP(""RCERR"",$J,""DATE"")=$G(RCD(""DATE""))"
^XMB(3.9,146037,2,1667,0)="""RTN"",""RCDPESR1"",195,0)"
^XMB(3.9,146037,2,1668,0)=" S ^TMP(""RCERR"",$J,""TYPE"")=$G(RCTYPE)"
^XMB(3.9,146037,2,1669,0)="""RTN"",""RCDPESR1"",196,0)"
^XMB(3.9,146037,2,1670,0)=" S ^TMP(""RCERR"",$J,""SUBJ"")=$G(RCD(""SUBJ""))"
^XMB(3.9,146037,2,1671,0)="""RTN"",""RCDPESR1"",197,0)"
^XMB(3.9,146037,2,1672,0)=" ;"
^XMB(3.9,146037,2,1673,0)="""RTN"",""RCDPESR1"",198,0)"
^XMB(3.9,146037,2,1674,0)=" I $G(RCERR)>0,RCERR<20 D"
^XMB(3.9,146037,2,1675,0)="""RTN"",""RCDPESR1"",199,0)"
^XMB(3.9,146037,2,1676,0)=" . S Z=""ERROR2+""_RCERR"
^XMB(3.9,146037,2,1677,0)="""RTN"",""RCDPESR1"",200,0)"
^XMB(3.9,146037,2,1678,0)=" . S RCE=$P($T(@Z),"";;"",2)"
^XMB(3.9,146037,2,1679,0)="""RTN"",""RCDPESR1"",201,0)"
^XMB(3.9,146037,2,1680,0)=" . I RCE'="""" S ^TMP(""RCERR"",$J,""TEXT"")=RCE"
^XMB(3.9,146037,2,1681,0)="""RTN"",""RCDPESR1"",202,0)"
^XMB(3.9,146037,2,1682,0)=" ;"
^XMB(3.9,146037,2,1683,0)="""RTN"",""RCDPESR1"",203,0)"
^XMB(3.9,146037,2,1684,0)=" S Z="""" F  S Z=$O(RCERR(Z)) Q:Z=""""  S Z0="""" F  S Z0=$O(RCERR(Z,Z0)) Q:Z0=""""  S RCE=$G(RCERR(Z,Z0)) D"
^XMB(3.9,146037,2,1685,0)="""RTN"",""RCDPESR1"",204,0)"
^XMB(3.9,146037,2,1686,0)=" . I $L(RCE) S CT=CT+1,^TMP(""RCERR"",$J,""MSG"",CT)=$S(RCE:$P($T(ERROR+RCE),"";;"",2),1:RCE)"
^XMB(3.9,146037,2,1687,0)="""RTN"",""RCDPESR1"",205,0)"
^XMB(3.9,146037,2,1688,0)=" . S RCTYPE=$P($G(@RCGBL@(0)),U)"
^XMB(3.9,146037,2,1689,0)="""RTN"",""RCDPESR1"",206,0)"
^XMB(3.9,146037,2,1690,0)=" . S:$G(^TMP(""RCERR"",$J,""TYPE""))="""" ^(""TYPE"")=RCTYPE"
^XMB(3.9,146037,2,1691,0)="""RTN"",""RCDPESR1"",207,0)"
^XMB(3.9,146037,2,1692,0)=" . S Z1="""""
^XMB(3.9,146037,2,1693,0)="""RTN"",""RCDPESR1"",208,0)"
^XMB(3.9,146037,2,1694,0)=" . F  S Z1=$O(@RCGBL@(1,""D"",Z1)) Q:Z1=""""  S CT=CT+1,^TMP(""RCERR"",$J,""MSG"",CT)=$G(@RCGBL@(1,""D"",Z1))"
^XMB(3.9,146037,2,1695,0)="""RTN"",""RCDPESR1"",209,0)"
^XMB(3.9,146037,2,1696,0)=" ;"
^XMB(3.9,146037,2,1697,0)="""RTN"",""RCDPESR1"",210,0)"
^XMB(3.9,146037,2,1698,0)=" I $D(@RCGBL@(2,""D"")) D"
^XMB(3.9,146037,2,1699,0)="""RTN"",""RCDPESR1"",211,0)"
^XMB(3.9,146037,2,1700,0)=" . S CT=CT+2,^TMP(""RCERR"",$J,""MSG"",CT-1)="" "",^TMP(""RCERR"",$J,""MSG"",CT)=""**** RAW MESSAGE DATA ****:"""
^XMB(3.9,146037,2,1701,0)="""RTN"",""RCDPESR1"",212,0)"
^XMB(3.9,146037,2,1702,0)=" . I $G(^TMP(""RCMSGH"",$J,0))'="""" S CT=CT+1,^TMP(""RCERR"",$J,""MSG"",CT)=^TMP(""RCMSGH"",$J,0)"
^XMB(3.9,146037,2,1703,0)="""RTN"",""RCDPESR1"",213,0)"
^XMB(3.9,146037,2,1704,0)=" . S Z2="""" F  S Z2=$O(@RCGBL@(2,""D"",Z2)) Q:Z2=""""  S CT=CT+1,^TMP(""RCERR"",$J,""MSG"",CT)=$G(@RCGBL@(2,""D"",Z2))"
^XMB(3.9,146037,2,1705,0)="""RTN"",""RCDPESR1"",214,0)"
^XMB(3.9,146037,2,1706,0)=" E  D"
^XMB(3.9,146037,2,1707,0)="""RTN"",""RCDPESR1"",215,0)"
^XMB(3.9,146037,2,1708,0)=" . Q:'$D(^TMP(""RCRAW"",$J))"
^XMB(3.9,146037,2,1709,0)="""RTN"",""RCDPESR1"",216,0)"
^XMB(3.9,146037,2,1710,0)=" . S CT=CT+2,^TMP(""RCERR"",$J,""MSG"",CT-1)="" "",^TMP(""RCERR"",$J,""MSG"",CT)=""**** RAW MESSAGE DATA ****:"""
^XMB(3.9,146037,2,1711,0)="""RTN"",""RCDPESR1"",217,0)"
^XMB(3.9,146037,2,1712,0)=" . I $G(^TMP(""RCMSGH"",$J,0))'="""" S CT=CT+1,^TMP(""RCERR"",$J,""MSG"",CT)=^TMP(""RCMSGH"",$J,0)"
^XMB(3.9,146037,2,1713,0)="""RTN"",""RCDPESR1"",218,0)"
^XMB(3.9,146037,2,1714,0)=" . S Z2="""" F  S Z2=$O(^TMP(""RCRAW"",$J,Z2)) Q:Z2=""""  S CT=CT+1,^TMP(""RCERR"",$J,""MSG"",CT)=$G(^TMP(""RCRAW"",$J,Z2))"
^XMB(3.9,146037,2,1715,0)="""RTN"",""RCDPESR1"",219,0)"
^XMB(3.9,146037,2,1716,0)=" ;"
^XMB(3.9,146037,2,1717,0)="""RTN"",""RCDPESR1"",220,0)"
^XMB(3.9,146037,2,1718,0)=" Q"
^XMB(3.9,146037,2,1719,0)="""RTN"",""RCDPESR1"",221,0)"
^XMB(3.9,146037,2,1720,0)=" ;"
^XMB(3.9,146037,2,1721,0)="""RTN"",""RCDPESR1"",222,0)"
^XMB(3.9,146037,2,1722,0)="DKILL(RCXMZ) ; Delete server mail msg from postmaster mailbox"
^XMB(3.9,146037,2,1723,0)="""RTN"",""RCDPESR1"",223,0)"
^XMB(3.9,146037,2,1724,0)=" ; RCXMZ = ien of mailman msg"
^XMB(3.9,146037,2,1725,0)="""RTN"",""RCDPESR1"",224,0)"
^XMB(3.9,146037,2,1726,0)=" ;"
^XMB(3.9,146037,2,1727,0)="""RTN"",""RCDPESR1"",225,0)"
^XMB(3.9,146037,2,1728,0)=" D ZAPSERV^XMXAPI(""S.RCDPE EDI LOCKBOX SERVER"",RCXMZ)"
^XMB(3.9,146037,2,1729,0)="""RTN"",""RCDPESR1"",226,0)"
^XMB(3.9,146037,2,1730,0)=" Q"
^XMB(3.9,146037,2,1731,0)="""RTN"",""RCDPESR1"",227,0)"
^XMB(3.9,146037,2,1732,0)=" ;"
^XMB(3.9,146037,2,1733,0)="""RTN"",""RCDPESR1"",228,0)"
^XMB(3.9,146037,2,1734,0)="TEMPDEL(DA) ; Delete msg from temporary msg file"
^XMB(3.9,146037,2,1735,0)="""RTN"",""RCDPESR1"",229,0)"
^XMB(3.9,146037,2,1736,0)=" ; DA = ien of the entry in file 344.5"
^XMB(3.9,146037,2,1737,0)="""RTN"",""RCDPESR1"",230,0)"
^XMB(3.9,146037,2,1738,0)=" ;"
^XMB(3.9,146037,2,1739,0)="""RTN"",""RCDPESR1"",231,0)"
^XMB(3.9,146037,2,1740,0)=" N DIK,Y,X"
^XMB(3.9,146037,2,1741,0)="""RTN"",""RCDPESR1"",232,0)"
^XMB(3.9,146037,2,1742,0)=" S DIK=""^RCY(344.5,"" D ^DIK"
^XMB(3.9,146037,2,1743,0)="""RTN"",""RCDPESR1"",233,0)"
^XMB(3.9,146037,2,1744,0)=" L -^RCY(344.5,DA,0)"
^XMB(3.9,146037,2,1745,0)="""RTN"",""RCDPESR1"",234,0)"
^XMB(3.9,146037,2,1746,0)=" Q"
^XMB(3.9,146037,2,1747,0)="""RTN"",""RCDPESR1"",235,0)"
^XMB(3.9,146037,2,1748,0)=" ;"
^XMB(3.9,146037,2,1749,0)="""RTN"",""RCDPESR1"",236,0)"
^XMB(3.9,146037,2,1750,0)="RESTMSG(RCD,RCARRAY,XMZ) ; Read rest of msg, store in array"
^XMB(3.9,146037,2,1751,0)="""RTN"",""RCDPESR1"",237,0)"
^XMB(3.9,146037,2,1752,0)=" ; RCD = last line # already in the msg"
^XMB(3.9,146037,2,1753,0)="""RTN"",""RCDPESR1"",238,0)"
^XMB(3.9,146037,2,1754,0)=" ; RCARRAY = name of the array to store the data in"
^XMB(3.9,146037,2,1755,0)="""RTN"",""RCDPESR1"",239,0)"
^XMB(3.9,146037,2,1756,0)=" ; XMZ = ien of the mailman msg"
^XMB(3.9,146037,2,1757,0)="""RTN"",""RCDPESR1"",240,0)"
^XMB(3.9,146037,2,1758,0)=" ;"
^XMB(3.9,146037,2,1759,0)="""RTN"",""RCDPESR1"",241,0)"
^XMB(3.9,146037,2,1760,0)=" F  X XMREC Q:XMER<0  S RCD=RCD+1,@RCARRAY@(RCD)=XMRG"
^XMB(3.9,146037,2,1761,0)="""RTN"",""RCDPESR1"",242,0)"
^XMB(3.9,146037,2,1762,0)=" Q"
^XMB(3.9,146037,2,1763,0)="""RTN"",""RCDPESR1"",243,0)"
^XMB(3.9,146037,2,1764,0)=" ;"
^XMB(3.9,146037,2,1765,0)="""RTN"",""RCDPESR1"",244,0)"
^XMB(3.9,146037,2,1766,0)="TAXERR(RCTYPE,RCINS,RCTID,RCCHG) ; Send a bulletin for a bad tax id"
^XMB(3.9,146037,2,1767,0)="""RTN"",""RCDPESR1"",245,0)"
^XMB(3.9,146037,2,1768,0)=" ; RCTYPE = ""ERA"" for an ERA record,  ""EFT"" for an EFT record"
^XMB(3.9,146037,2,1769,0)="""RTN"",""RCDPESR1"",246,0)"
^XMB(3.9,146037,2,1770,0)=" ; RCINS = name and id to identify the ins co"
^XMB(3.9,146037,2,1771,0)="""RTN"",""RCDPESR1"",247,0)"
^XMB(3.9,146037,2,1772,0)=" ; RCTID = tax id sent in error"
^XMB(3.9,146037,2,1773,0)="""RTN"",""RCDPESR1"",248,0)"
^XMB(3.9,146037,2,1774,0)=" ; RCCHG = code describing how correction was made"
^XMB(3.9,146037,2,1775,0)="""RTN"",""RCDPESR1"",249,0)"
^XMB(3.9,146037,2,1776,0)=" ;         'E'=EPHRA, 'C'=Changed by looking at claim #'s"
^XMB(3.9,146037,2,1777,0)="""RTN"",""RCDPESR1"",250,0)"
^XMB(3.9,146037,2,1778,0)=" ;"
^XMB(3.9,146037,2,1779,0)="""RTN"",""RCDPESR1"",251,0)"
^XMB(3.9,146037,2,1780,0)=" N XMBODY,XMB,XMINSTR,XMTYPE,XMFULL,XMTO,RCDXM,XMZ,XMERR,RCCT,RCDXM,RCCT"
^XMB(3.9,146037,2,1781,0)="""RTN"",""RCDPESR1"",252,0)"
^XMB(3.9,146037,2,1782,0)=" S RCCT=0"
^XMB(3.9,146037,2,1783,0)="""RTN"",""RCDPESR1"",253,0)"
^XMB(3.9,146037,2,1784,0)=" S RCCT=RCCT+1,RCDXM(RCCT)=""An ""_RCTYPE_"" was received at your site ""_$$FMTE^XLFDT($$NOW^XLFDT(),2)_"" with an invalid tax id."",RCCT=RCCT+1,RCDXM(RCCT)="" From: ""_RCINS"
^XMB(3.9,146037,2,1785,0)="""RTN"",""RCDPESR1"",254,0)"
^XMB(3.9,146037,2,1786,0)=" S RCCT=RCCT+1,RCDXM(RCCT)="" The tax id sent was: ""_RCTID_"" and it was corrected by: """
^XMB(3.9,146037,2,1787,0)="""RTN"",""RCDPESR1"",255,0)"
^XMB(3.9,146037,2,1788,0)=" S RCCT=RCCT+1,RCDXM(RCCT)="" ""_$S(RCCHG=""E"":""EPHRA"",1:""Extracting it based on bill numbers in the ERA"")"
^XMB(3.9,146037,2,1789,0)="""RTN"",""RCDPESR1"",256,0)"
^XMB(3.9,146037,2,1790,0)=" S RCCT=RCCT+2,RCDXM(RCCT-1)="" "",RCDXM(RCCT)=""If your site continues to receive these bulletins for this payer,"",RCCT=RCCT+1,RCDXM(RCCT)=""contact the payer and request they correct their tax id for your site"""
^XMB(3.9,146037,2,1791,0)="""RTN"",""RCDPESR1"",257,0)"
^XMB(3.9,146037,2,1792,0)=" ;"
^XMB(3.9,146037,2,1793,0)="""RTN"",""RCDPESR1"",258,0)"
^XMB(3.9,146037,2,1794,0)=" S XMTO(""I:G.RCDPE PAYMENTS"")="""",XMBODY=""RCDXM"""
^XMB(3.9,146037,2,1795,0)="""RTN"",""RCDPESR1"",259,0)"
^XMB(3.9,146037,2,1796,0)=" D"
^XMB(3.9,146037,2,1797,0)="""RTN"",""RCDPESR1"",260,0)"
^XMB(3.9,146037,2,1798,0)=" . N DUZ S DUZ=.5,DUZ(0)=""@"""
^XMB(3.9,146037,2,1799,0)="""RTN"",""RCDPESR1"",261,0)"
^XMB(3.9,146037,2,1800,0)=" . D SENDMSG^XMXAPI(.5,""EDI LBOX ERRONEOUS TAX ID ON ""_RCTYPE,XMBODY,.XMTO,,.XMZ)"
^XMB(3.9,146037,2,1801,0)="""RTN"",""RCDPESR1"",262,0)"
^XMB(3.9,146037,2,1802,0)=" Q"
^XMB(3.9,146037,2,1803,0)="""RTN"",""RCDPESR1"",263,0)"
^XMB(3.9,146037,2,1804,0)=" ;"
^XMB(3.9,146037,2,1805,0)="""RTN"",""RCDPESR1"",264,0)"
^XMB(3.9,146037,2,1806,0)="BILL(X,RCDT,RCIB) ; Returns ien of bill in X or -1 if not valid"
^XMB(3.9,146037,2,1807,0)="""RTN"",""RCDPESR1"",265,0)"
^XMB(3.9,146037,2,1808,0)=" ; RCDT = the Statement from date (used for Rx bills)"
^XMB(3.9,146037,2,1809,0)="""RTN"",""RCDPESR1"",266,0)"
^XMB(3.9,146037,2,1810,0)=" ; and, if passed by reference, RCIB = 1 if an insurance bill"
^XMB(3.9,146037,2,1811,0)="""RTN"",""RCDPESR1"",267,0)"
^XMB(3.9,146037,2,1812,0)=" N ARRAY,DIC,Y,Z"
^XMB(3.9,146037,2,1813,0)="""RTN"",""RCDPESR1"",268,0)"
^XMB(3.9,146037,2,1814,0)=" S RCIB=0"
^XMB(3.9,146037,2,1815,0)="""RTN"",""RCDPESR1"",269,0)"
^XMB(3.9,146037,2,1816,0)=" S X=$TR(X,"" ""),(X,Z)=$TR(X,""O"",""0"") ; Remove spaces, change ohs to zeroes"
^XMB(3.9,146037,2,1817,0)="""RTN"",""RCDPESR1"",270,0)"
^XMB(3.9,146037,2,1818,0)=" I X'[""-"",$E(X,1,3)?3N,+$E(X,1,3),$L(X)>7,$L(X)<12 S X=$E(X,1,3)_""-""_$E(X,4,$L(X))"
^XMB(3.9,146037,2,1819,0)="""RTN"",""RCDPESR1"",271,0)"
^XMB(3.9,146037,2,1820,0)=" S DIC=""^PRCA(430,"",DIC(0)=""MZ"" D ^DIC"
^XMB(3.9,146037,2,1821,0)="""RTN"",""RCDPESR1"",272,0)"
^XMB(3.9,146037,2,1822,0)=" ; Checks if the ECME# is valid"
^XMB(3.9,146037,2,1823,0)="""RTN"",""RCDPESR1"",273,0)"
^XMB(3.9,146037,2,1824,0)=" I Y<0,$$VALECME^BPSUTIL2(Z) D"
^XMB(3.9,146037,2,1825,0)="""RTN"",""RCDPESR1"",274,0)"
^XMB(3.9,146037,2,1826,0)=" . S ARRAY(""ECME"")=Z,ARRAY(""FILLDT"")=$G(RCDT)"
^XMB(3.9,146037,2,1827,0)="""RTN"",""RCDPESR1"",275,0)"
^XMB(3.9,146037,2,1828,0)=" . S Y=$$RXBIL^IBNCPDPU(.ARRAY)     ; DBIA 4435"
^XMB(3.9,146037,2,1829,0)="""RTN"",""RCDPESR1"",276,0)"
^XMB(3.9,146037,2,1830,0)=" . I Y>0 S Y(0)=$G(^PRCA(430,+Y,0))"
^XMB(3.9,146037,2,1831,0)="""RTN"",""RCDPESR1"",277,0)"
^XMB(3.9,146037,2,1832,0)=" I Y>0 S RCIB=($P($G(^RCD(340,+$P(Y(0),U,9),0)),U)[""DIC(36,"")"
^XMB(3.9,146037,2,1833,0)="""RTN"",""RCDPESR1"",278,0)"
^XMB(3.9,146037,2,1834,0)=" Q +Y"
^XMB(3.9,146037,2,1835,0)="""RTN"",""RCDPESR1"",279,0)"
^XMB(3.9,146037,2,1836,0)=" ;"
^XMB(3.9,146037,2,1837,0)="""RTN"",""RCDPESR1"",280,0)"
^XMB(3.9,146037,2,1838,0)="FMDT(X) ; Format date (X) in YYYYMMDD to Fileman format"
^XMB(3.9,146037,2,1839,0)="""RTN"",""RCDPESR1"",281,0)"
^XMB(3.9,146037,2,1840,0)=" I $L(X)=8 D"
^XMB(3.9,146037,2,1841,0)="""RTN"",""RCDPESR1"",282,0)"
^XMB(3.9,146037,2,1842,0)=" . S X=$E(X,1,4)-1700_$E(X,5,8)"
^XMB(3.9,146037,2,1843,0)="""RTN"",""RCDPESR1"",283,0)"
^XMB(3.9,146037,2,1844,0)=" Q X"
^XMB(3.9,146037,2,1845,0)="""RTN"",""RCDPESR1"",284,0)"
^XMB(3.9,146037,2,1846,0)=" ;"
^XMB(3.9,146037,2,1847,0)="""RTN"",""RCDPESR1"",285,0)"
^XMB(3.9,146037,2,1848,0)="ERROR ; Top level error msgs for msgs"
^XMB(3.9,146037,2,1849,0)="""RTN"",""RCDPESR1"",286,0)"
^XMB(3.9,146037,2,1850,0)=" ;;Invalid mailgroup designated for EDI Lockbox errors"
