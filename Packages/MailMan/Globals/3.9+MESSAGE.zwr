^XMB(3.9,146098,2,1929,0)="""RTN"",""SDESAPPTLETTERS"",152,0)"
^XMB(3.9,146098,2,1930,0)=" S SDECI=SDECI+1 S ^TMP(""SDEC"",$J,SDECI)="""""
^XMB(3.9,146098,2,1931,0)="""RTN"",""SDESAPPTLETTERS"",153,0)"
