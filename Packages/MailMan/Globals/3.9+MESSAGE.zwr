^XMB(3.9,146035,2,450,0)=" .S RXN1=^TMP(""PSORXN"",$J,RXN) D EN^PSOHLSN1(RXN,$P(RXN1,""^""),$P(RXN1,""^"",2),"""",$P(RXN1,""^"",3))"
