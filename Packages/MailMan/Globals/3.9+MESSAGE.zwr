^XMB(3.9,146047,2,3079,0)="""RTN"",""IBJPI"",54,0)"
^XMB(3.9,146047,2,3080,0)=" D CLEAN^VALM10"
^XMB(3.9,146047,2,3081,0)="""RTN"",""IBJPI"",55,0)"
^XMB(3.9,146047,2,3082,0)=" Q"
^XMB(3.9,146047,2,3083,0)="""RTN"",""IBJPI"",56,0)"
^XMB(3.9,146047,2,3084,0)=" ;"
^XMB(3.9,146047,2,3085,0)="""RTN"",""IBJPI"",57,0)"
^XMB(3.9,146047,2,3086,0)="BLD ; Creates the body of the worklist"
^XMB(3.9,146047,2,3087,0)="""RTN"",""IBJPI"",58,0)"
^XMB(3.9,146047,2,3088,0)=" ; IB*2.0*549 - rewrote this entire method and all methods called from it to"
^XMB(3.9,146047,2,3089,0)="""RTN"",""IBJPI"",59,0)"
^XMB(3.9,146047,2,3090,0)=" ;              change to a totally new display of fields"
^XMB(3.9,146047,2,3091,0)="""RTN"",""IBJPI"",60,0)"
^XMB(3.9,146047,2,3092,0)=" N ELINEL,ELINER,SLINE,STARTR"
^XMB(3.9,146047,2,3093,0)="""RTN"",""IBJPI"",61,0)"
^XMB(3.9,146047,2,3094,0)=" S VALMCNT=0,SLINE=1"
^XMB(3.9,146047,2,3095,0)="""RTN"",""IBJPI"",62,0)"
^XMB(3.9,146047,2,3096,0)=" D BLDGENE(SLINE,.ELINEL)                       ; Build Editable General Parameters"
^XMB(3.9,146047,2,3097,0)="""RTN"",""IBJPI"",63,0)"
^XMB(3.9,146047,2,3098,0)=" D BLDGENNL(ELINEL,.STARTR,.ELINEL)             ; Build Non-Editable Gen Param left"
^XMB(3.9,146047,2,3099,0)="""RTN"",""IBJPI"",64,0)"
^XMB(3.9,146047,2,3100,0)=" D BLDGENNR(STARTR,.ELINER)                     ; Build Non-Editable Gen Param Right"
^XMB(3.9,146047,2,3101,0)="""RTN"",""IBJPI"",65,0)"
^XMB(3.9,146047,2,3102,0)=" S SLINE=$S(ELINEL>ELINER:ELINEL,1:ELINER)"
^XMB(3.9,146047,2,3103,0)="""RTN"",""IBJPI"",66,0)"
^XMB(3.9,146047,2,3104,0)=" D BLDGENNB(SLINE,.ELINEL)                      ; Build Non-Editable Bottom Params"
^XMB(3.9,146047,2,3105,0)="""RTN"",""IBJPI"",67,0)"
^XMB(3.9,146047,2,3106,0)=" ;IB*806/CKB - added update SLINE and call to BLDBC"
^XMB(3.9,146047,2,3107,0)="""RTN"",""IBJPI"",68,0)"
^XMB(3.9,146047,2,3108,0)=" S SLINE=$S(ELINEL>ELINER:ELINEL,1:ELINER)"
^XMB(3.9,146047,2,3109,0)="""RTN"",""IBJPI"",69,0)"
^XMB(3.9,146047,2,3110,0)=" D BLDBC(SLINE,.ELINEL)                         ; Build Buffer Cleanup Parameters - IB*806/CKB"
^XMB(3.9,146047,2,3111,0)="""RTN"",""IBJPI"",70,0)"
^XMB(3.9,146047,2,3112,0)=" D BLDBE(ELINEL,.ELINEL)                        ; Build Batch Extract Gen Parameters"
