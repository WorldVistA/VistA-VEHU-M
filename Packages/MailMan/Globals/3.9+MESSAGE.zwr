^XMB(3.9,146018,2,796,0)=" ;  DUOUT=1 if ^, timeout, or other issue"
^XMB(3.9,146018,2,797,0)="""RTN"",""DPTLK7"",275,0)"
^XMB(3.9,146018,2,798,0)=" N DFN,DGVV,DIC,DO,DPT,DPTCT,DPTDFN,DPTGID,DPTID,DPTID0,DPTSET,DPTX,I,X,Y"
