^XMB(3.9,146087,2,3543,0)="""RTN"",""YTQRQAD4"",258,0)"
^XMB(3.9,146087,2,3544,0)=" S STR=""{""""assignmentId"""":""""""_ASMT_"""""" , """"entryMode"""":""""""_ENTRY_"""""",""""assignDt"""":""""""_$P($$FMTE^XLFDT($P(ASSGNDT,""."")),"":"",1,2)_"""""", """"instruments"""": ["""
