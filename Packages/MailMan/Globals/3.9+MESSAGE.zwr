^XMB(3.9,146081,2,4544,0)="Code       Inactivation  Brief Description"
^XMB(3.9,146081,2,4545,0)="---------  ------------  -----------------"
^XMB(3.9,146081,2,4546,0)="V03.5      10/01/2015    Need for Prophylactic Vaccination against    "
^XMB(3.9,146081,2,4547,0)="                         Diphtheria                                   "
^XMB(3.9,146081,2,4548,0)="V03.7      10/01/2015    Need for Prophylactic Vaccination with       "
^XMB(3.9,146081,2,4549,0)="                         Tetanus Toxoid Alone                         "
^XMB(3.9,146081,2,4550,0)="V06.1      10/01/2015    Diphtheria-Tetanus-Pertussis Combined (DPT)  "
^XMB(3.9,146081,2,4551,0)="                         (DTAP)                                       "
^XMB(3.9,146081,2,4552,0)="V06.2      10/01/2015    Need for Prophylactic Vaccination and        "
^XMB(3.9,146081,2,4553,0)="                         Inoculation Against Diptheria-Tetanus-Pertuss"
^XMB(3.9,146081,2,4554,0)="                         is with Typhoid-Paratyphoid (DTP + TAB)      "
^XMB(3.9,146081,2,4555,0)="V06.3      10/01/2015    Need for Prophylactic Vaccination with       "
^XMB(3.9,146081,2,4556,0)="                         Diptheria-Tetanus-Pertussis with             "
^XMB(3.9,146081,2,4557,0)="                         Poliomyelitis (DTP + Polio) Vaccine          "
^XMB(3.9,146081,2,4558,0)="V06.4      10/01/2015    Need for Prophylactic Vaccination with       "
^XMB(3.9,146081,2,4559,0)="                         Measles-Mumps-Rubella (MMR) Vaccine          "
^XMB(3.9,146081,2,4560,0)="V06.5      10/01/2015    Tetanus-Diphtheria (TD) (DT)                 "
^XMB(3.9,146081,2,4561,0)=""
