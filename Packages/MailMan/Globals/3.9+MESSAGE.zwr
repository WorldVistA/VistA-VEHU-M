^XMB(3.9,146056,2,2575,0)="""RTN"",""VPRSDAP"",147,0)"
^XMB(3.9,146056,2,2576,0)="INGRD(NAME) ; -- reset NAME to ingredient IEN"
^XMB(3.9,146056,2,2577,0)="""RTN"",""VPRSDAP"",148,0)"
^XMB(3.9,146056,2,2578,0)=" ; Also return VPRCODE=code^name^system"
^XMB(3.9,146056,2,2579,0)="""RTN"",""VPRSDAP"",149,0)"
^XMB(3.9,146056,2,2580,0)=" N IEN S IEN="""""
^XMB(3.9,146056,2,2581,0)="""RTN"",""VPRSDAP"",150,0)"
^XMB(3.9,146056,2,2582,0)=" S NAME=$G(NAME),VPRCODE="""""
^XMB(3.9,146056,2,2583,0)="""RTN"",""VPRSDAP"",151,0)"
^XMB(3.9,146056,2,2584,0)=" I $L(NAME) D"
^XMB(3.9,146056,2,2585,0)="""RTN"",""VPRSDAP"",152,0)"
^XMB(3.9,146056,2,2586,0)=" . D NAME^PSN50P41(NAME,""VPRDI"") S IEN=+$O(^TMP($J,""VPRDI"",""P"",NAME,0))"
^XMB(3.9,146056,2,2587,0)="""RTN"",""VPRSDAP"",153,0)"
^XMB(3.9,146056,2,2588,0)=" . K ^TMP($J,""VPRDI"")"
^XMB(3.9,146056,2,2589,0)="""RTN"",""VPRSDAP"",154,0)"
^XMB(3.9,146056,2,2590,0)=" I IEN<1 S DDEOUT=1 Q"
^XMB(3.9,146056,2,2591,0)="""RTN"",""VPRSDAP"",155,0)"
^XMB(3.9,146056,2,2592,0)=" S VPRCODE=IEN_U_NAME,NAME=IEN ;reset, if passed by reference"
^XMB(3.9,146056,2,2593,0)="""RTN"",""VPRSDAP"",156,0)"
^XMB(3.9,146056,2,2594,0)=" D CODE(.VPRCODE,50.416)"
^XMB(3.9,146056,2,2595,0)="""RTN"",""VPRSDAP"",157,0)"
^XMB(3.9,146056,2,2596,0)=" Q"
^XMB(3.9,146056,2,2597,0)="""RTN"",""VPRSDAP"",158,0)"
^XMB(3.9,146056,2,2598,0)=" ;"
^XMB(3.9,146056,2,2599,0)="""RTN"",""VPRSDAP"",159,0)"
^XMB(3.9,146056,2,2600,0)="NDF(DRUG) ; -- return VA Drug Product info for DRUG (#50 ien)"
^XMB(3.9,146056,2,2601,0)="""RTN"",""VPRSDAP"",160,0)"
^XMB(3.9,146056,2,2602,0)=" ; also returns DATA = code^name^system for RXN/VUID"
^XMB(3.9,146056,2,2603,0)="""RTN"",""VPRSDAP"",161,0)"
^XMB(3.9,146056,2,2604,0)=" I '$D(^TMP(""VPRX"",$J,""NDF"",DRUG)) D"
^XMB(3.9,146056,2,2605,0)="""RTN"",""VPRSDAP"",162,0)"
^XMB(3.9,146056,2,2606,0)=" . D NDF^PSS50(DRUG,,,,,""NDF"")"
^XMB(3.9,146056,2,2607,0)="""RTN"",""VPRSDAP"",163,0)"
^XMB(3.9,146056,2,2608,0)=" . M ^TMP(""VPRX"",$J,""NDF"",DRUG)=^TMP($J,""NDF"",DRUG)"
^XMB(3.9,146056,2,2609,0)="""RTN"",""VPRSDAP"",164,0)"
^XMB(3.9,146056,2,2610,0)=" . K ^TMP($J,""NDF"",DRUG)"
^XMB(3.9,146056,2,2611,0)="""RTN"",""VPRSDAP"",165,0)"
^XMB(3.9,146056,2,2612,0)=" S VPRVAP=$NA(^TMP(""VPRX"",$J,""NDF"",DRUG))"
^XMB(3.9,146056,2,2613,0)="""RTN"",""VPRSDAP"",166,0)"
^XMB(3.9,146056,2,2614,0)=" S DATA=$G(^TMP(""VPRX"",$J,""NDF"",DRUG,22)) I DATA D  ;#50.68"
^XMB(3.9,146056,2,2615,0)="""RTN"",""VPRSDAP"",167,0)"
^XMB(3.9,146056,2,2616,0)=" . D CODE(.DATA,50.68)"
^XMB(3.9,146056,2,2617,0)="""RTN"",""VPRSDAP"",168,0)"
^XMB(3.9,146056,2,2618,0)=" . S $P(DATA,U,2)=$P($G(@VPRVAP@(22)),U,2) ;RXN text unreliable"
^XMB(3.9,146056,2,2619,0)="""RTN"",""VPRSDAP"",169,0)"
^XMB(3.9,146056,2,2620,0)=" . S:'$L($P(DATA,U,3)) $P(DATA,U,3)=""VA50.68"""
^XMB(3.9,146056,2,2621,0)="""RTN"",""VPRSDAP"",170,0)"
^XMB(3.9,146056,2,2622,0)=" I 'DATA S DATA=DRUG_U_$G(@VPRVAP@(.01))_""^VA50"""
