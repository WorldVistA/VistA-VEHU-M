^XMB(3.9,146056,2,2224,0)=" ;"
^XMB(3.9,146056,2,2225,0)="""RTN"",""VPRSDAHX"",39,0)"
^XMB(3.9,146056,2,2226,0)="HF1 ; -- get info for single HF record [ID Action]"
^XMB(3.9,146056,2,2227,0)="""RTN"",""VPRSDAHX"",40,0)"
^XMB(3.9,146056,2,2228,0)=" ; Expects/updates DIEN = #9000010.23 ien"
^XMB(3.9,146056,2,2229,0)="""RTN"",""VPRSDAHX"",41,0)"
^XMB(3.9,146056,2,2230,0)=" ;       Returns VPRVST = #9000010 ien"
^XMB(3.9,146056,2,2231,0)="""RTN"",""VPRSDAHX"",42,0)"
^XMB(3.9,146056,2,2232,0)=" ;              VPRVST0 = Visit zero node"
^XMB(3.9,146056,2,2233,0)="""RTN"",""VPRSDAHX"",43,0)"
^XMB(3.9,146056,2,2234,0)=" ;                VPRHF array"
^XMB(3.9,146056,2,2235,0)="""RTN"",""VPRSDAHX"",44,0)"
^XMB(3.9,146056,2,2236,0)=" K VPRHF D:$$ZERO^VPRENC(""HF"",+DIEN) VHF^PXPXRM(+DIEN,.VPRHF)"
^XMB(3.9,146056,2,2237,0)="""RTN"",""VPRSDAHX"",45,0)"
^XMB(3.9,146056,2,2238,0)=" S VPRVST=+$G(VPRHF(""VISIT"")),VPRVST0=$G(^AUPNVSIT(+VPRVST,0))"
^XMB(3.9,146056,2,2239,0)="""RTN"",""VPRSDAHX"",46,0)"
^XMB(3.9,146056,2,2240,0)=" S VPRHF=DIEN,DIEN=+DIEN"
^XMB(3.9,146056,2,2241,0)="""RTN"",""VPRSDAHX"",47,0)"
^XMB(3.9,146056,2,2242,0)=" Q"
^XMB(3.9,146056,2,2243,0)="""RTN"",""VPRSDAHX"",48,0)"
^XMB(3.9,146056,2,2244,0)=" ;"
^XMB(3.9,146056,2,2245,0)="""RTN"",""VPRSDAHX"",49,0)"
^XMB(3.9,146056,2,2246,0)="WVPLQ ; -- Women's Health Pregnancy Log [Query]"
^XMB(3.9,146056,2,2247,0)="""RTN"",""VPRSDAHX"",50,0)"
^XMB(3.9,146056,2,2248,0)=" ; Query called from GET^DDE, returns DLIST(1)=DFN if data"
^XMB(3.9,146056,2,2249,0)="""RTN"",""VPRSDAHX"",51,0)"
^XMB(3.9,146056,2,2250,0)=" ; Expects context variables DFN, DSTRT, DSTOP, DMAX"
^XMB(3.9,146056,2,2251,0)="""RTN"",""VPRSDAHX"",52,0)"
^XMB(3.9,146056,2,2252,0)=" ;"
^XMB(3.9,146056,2,2253,0)="""RTN"",""VPRSDAHX"",53,0)"
^XMB(3.9,146056,2,2254,0)=" K ^TMP(""WVPREGST"",$J)"
^XMB(3.9,146056,2,2255,0)="""RTN"",""VPRSDAHX"",54,0)"
^XMB(3.9,146056,2,2256,0)=" D BASELINE^WVRPCVPR(DFN)"
^XMB(3.9,146056,2,2257,0)="""RTN"",""VPRSDAHX"",55,0)"
^XMB(3.9,146056,2,2258,0)=" S:$D(^TMP(""WVPREGST"",$J,""BASELINE"")) DLIST(1)=DFN"
^XMB(3.9,146056,2,2259,0)="""RTN"",""VPRSDAHX"",56,0)"
^XMB(3.9,146056,2,2260,0)=" ;S:$G(^TMP(""WVPREGST"",$J,""BASELINE"",""TO TIME""))'<$$FMADD^XLFDT(DT,-14) DLIST(1)=DFN"
