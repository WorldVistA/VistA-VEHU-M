^XMB(3.9,146011,2,794,0)=" .S PSONOOR=$$NA^ORX1(""W"",0,""B"",""Nature of Order"",0,""WPSDIVR""_$S(+$G(^VA(200,DUZ,""PS"")):""E"",1:""""))"
