^XMB(3.9,146098,2,2198,0)="TST(SDCL,DOW) ; handle scheduled tests"
^XMB(3.9,146098,2,2199,0)="""RTN"",""SDESAPPTLETTERS"",287,0)"
^XMB(3.9,146098,2,2200,0)=" I ($L(SDCL)=3&($E(SDCL,1,3)=""LAB"")) D"
