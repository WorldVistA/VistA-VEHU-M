^XMB(3.9,146011,2,659,0)="""RTN"",""PSOHLD"",105,0)"
^XMB(3.9,146011,2,660,0)=" I $G(PSORX(""PSOL"",1))']"""" S PSORX(""PSOL"",1)=RXIEN_"","" D ULP G EX"
^XMB(3.9,146011,2,661,0)="""RTN"",""PSOHLD"",106,0)"
^XMB(3.9,146011,2,662,0)=" F PSOX1=0:0 S PSOX1=$O(PSORX(""PSOL"",PSOX1)) Q:'PSOX1  S PSOX2=PSOX1"
