^XMB(3.9,146089,2,418,0)="S D KPRI,KPRIZ F  S ORD=$O(^PS(52.41,""AP"",PAT,""S"",ORD)) Q:'ORD!($G(POERR(""QFLG"")))  I $P(^PS(52.41,ORD,0),""^"",3)'=""DC"",$P(^(0),""^"",3)'=""DE"" D LOCK1^PSOORFI1,ORD^PSOORFIN S PSOSTATZ=1"
