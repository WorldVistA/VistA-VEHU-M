^XMB(3.9,146087,2,626,0)="ERR(YSDATA,YSRETMSG,YSLOGMSG) ; Set return error array (YSDATA); and log error to VistA error trap"
^XMB(3.9,146087,2,627,0)="""RTN"",""YTQAPI1"",141,0)"
^XMB(3.9,146087,2,628,0)=" N %ZT"
^XMB(3.9,146087,2,629,0)="""RTN"",""YTQAPI1"",142,0)"
^XMB(3.9,146087,2,630,0)=" S YSDATA(1)=""[ERROR]"""
^XMB(3.9,146087,2,631,0)="""RTN"",""YTQAPI1"",143,0)"
^XMB(3.9,146087,2,632,0)=" S YSDATA(2)=YSRETMSG"
^XMB(3.9,146087,2,633,0)="""RTN"",""YTQAPI1"",144,0)"
^XMB(3.9,146087,2,634,0)=" I +$$GET^XPAR(""ALL"",""YS MHA LOG APPLICATION ERRORS"",1,""I"") D APPERROR^%ZTER(YSLOGMSG)"
