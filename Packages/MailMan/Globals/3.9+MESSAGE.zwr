^XMB(3.9,146089,2,410,0)=" S:'$G(PSOFROM)'=""NEW"" PSOFROM=""REFILL"" S PSOREF(""DFLG"")=0"
^XMB(3.9,146089,2,411,0)="""RTN"",""PSOORFI2"",80,0)"
^XMB(3.9,146089,2,412,0)=" D ^PSOREF0"
^XMB(3.9,146089,2,413,0)="""RTN"",""PSOORFI2"",81,0)"
