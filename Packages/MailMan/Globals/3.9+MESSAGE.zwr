^XMB(3.9,146056,2,702,0)="VUID has been assigned, it will be returned as the Code with a coding"
^XMB(3.9,146056,2,703,0)="""KRN"",1.5,42,19,4,0)"
^XMB(3.9,146056,2,704,0)="system of VHAT. This entity also expects the variable VPRTYPE, defined by"
^XMB(3.9,146056,2,705,0)="""KRN"",1.5,42,19,5,0)"
^XMB(3.9,146056,2,706,0)="the main GET ID ACTION."
