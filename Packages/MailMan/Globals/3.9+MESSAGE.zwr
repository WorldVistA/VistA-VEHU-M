^XMB(3.9,146106,2,528,0)="SDES2APPTUTIL ;ALB/BLB,TJB/ANU/BLB/LAB,BLB,LAB,BWF,JAS,JAS,AGW,JHC,AGW - SDES2 CREATE APPOINTMENT UTILITIES ; MAY 08 2026"
^XMB(3.9,146106,2,529,0)="""RTN"",""SDES2APPTUTIL"",2,0)"
^XMB(3.9,146106,2,530,0)=" ;;5.3;Scheduling;**866,871,875,877,878,880,881,890,893,905,907,922,909,944**;Aug 13, 1993;Build 0"
^XMB(3.9,146106,2,531,0)="""RTN"",""SDES2APPTUTIL"",3,0)"
^XMB(3.9,146106,2,532,0)=" ;;Per VHA Directive 6402, this routine should not be modified"
^XMB(3.9,146106,2,533,0)="""RTN"",""SDES2APPTUTIL"",4,0)"
^XMB(3.9,146106,2,534,0)=" ;---------------------------------------------------------------"
