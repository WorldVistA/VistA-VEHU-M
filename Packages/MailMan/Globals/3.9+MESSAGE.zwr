^XMB(3.9,146017,2,2354,0)="CLINICAVAIL(RESULT,SDCONTEXT,SDINPUT) ;"
^XMB(3.9,146017,2,2355,0)="""RTN"",""SDES2GETCLINAVL"",19,0)"
^XMB(3.9,146017,2,2356,0)=" N CLINLIST,ERRORS,CLINAVAIL,STARTDTFM,ENDDTFM,PRIMARYSTOP,SECSTOPLIST,NUMBERRET,RESULTDATA"
^XMB(3.9,146017,2,2357,0)="""RTN"",""SDES2GETCLINAVL"",20,0)"
^XMB(3.9,146017,2,2358,0)=" K ^TMP(""SDES2CLINAVAIL"",$J)"
^XMB(3.9,146017,2,2359,0)="""RTN"",""SDES2GETCLINAVL"",21,0)"
^XMB(3.9,146017,2,2360,0)=" S RESULT=$NA(^TMP(""SDES2CLINAVAIL"",$J,""JSON""))"
^XMB(3.9,146017,2,2361,0)="""RTN"",""SDES2GETCLINAVL"",22,0)"
^XMB(3.9,146017,2,2362,0)=" S RESULTDATA=$NA(^TMP(""SDES2CLINAVAIL"",$J,""DATA""))"
^XMB(3.9,146017,2,2363,0)="""RTN"",""SDES2GETCLINAVL"",23,0)"
^XMB(3.9,146017,2,2364,0)=" S CLINLIST=$NA(^TMP(""SDES2CLINAVAIL"",$J,""CLINLIST""))"
^XMB(3.9,146017,2,2365,0)="""RTN"",""SDES2GETCLINAVL"",24,0)"
^XMB(3.9,146017,2,2366,0)=" D VALCONTEXT^SDES2VALCONTEXT(.ERRORS,.SDCONTEXT)"
^XMB(3.9,146017,2,2367,0)="""RTN"",""SDES2GETCLINAVL"",25,0)"
^XMB(3.9,146017,2,2368,0)=" I $D(ERRORS) S ERRORS(""ClinicAvailability"",1)="""" D ENCODE^XLFJSON(""ERRORS"",.RESULT) Q"
^XMB(3.9,146017,2,2369,0)="""RTN"",""SDES2GETCLINAVL"",26,0)"
^XMB(3.9,146017,2,2370,0)=" I $G(SDCONTEXT(""USER DUZ""))'="""" N DUZ D DUZ^XUP(SDCONTEXT(""USER DUZ""))"
^XMB(3.9,146017,2,2371,0)="""RTN"",""SDES2GETCLINAVL"",27,0)"
^XMB(3.9,146017,2,2372,0)=" D VALIDATE(.ERRORS,.SDINPUT,.STARTDTFM,.ENDDTFM,.NUMBERRET)"
^XMB(3.9,146017,2,2373,0)="""RTN"",""SDES2GETCLINAVL"",28,0)"
^XMB(3.9,146017,2,2374,0)=" I $D(ERRORS) D  Q"
^XMB(3.9,146017,2,2375,0)="""RTN"",""SDES2GETCLINAVL"",29,0)"
^XMB(3.9,146017,2,2376,0)=" . S ERRORS(""ClinicAvailability"",1)="""""
^XMB(3.9,146017,2,2377,0)="""RTN"",""SDES2GETCLINAVL"",30,0)"
^XMB(3.9,146017,2,2378,0)=" . D ENCODE^XLFJSON(""ERRORS"",.RESULT)"
^XMB(3.9,146017,2,2379,0)="""RTN"",""SDES2GETCLINAVL"",31,0)"
^XMB(3.9,146017,2,2380,0)=" I NUMBERRET=500 S NUMBERRET=501"
^XMB(3.9,146017,2,2381,0)="""RTN"",""SDES2GETCLINAVL"",32,0)"
^XMB(3.9,146017,2,2382,0)=" D MATCHCLIN(.CLINLIST,$G(SDINPUT(""PRIMARY AMIS"")),.SDINPUT)"
^XMB(3.9,146017,2,2383,0)="""RTN"",""SDES2GETCLINAVL"",33,0)"
^XMB(3.9,146017,2,2384,0)=" D GETAVAIL(.RESULTDATA,.CLINLIST,STARTDTFM,ENDDTFM,$G(SDINPUT(""STATION"")),NUMBERRET)"
^XMB(3.9,146017,2,2385,0)="""RTN"",""SDES2GETCLINAVL"",34,0)"
^XMB(3.9,146017,2,2386,0)=" I '$D(@RESULTDATA) S @RESULTDATA@(""ClinicAvailability"",1)="""""
