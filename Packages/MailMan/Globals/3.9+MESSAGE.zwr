^XMB(3.9,146039,2,3257,0)="""RTN"",""SDES2UNDOCHKOUT"",13,0)"
^XMB(3.9,146039,2,3258,0)=" ; INPUT"
^XMB(3.9,146039,2,3259,0)="""RTN"",""SDES2UNDOCHKOUT"",14,0)"
^XMB(3.9,146039,2,3260,0)=" ;"
^XMB(3.9,146039,2,3261,0)="""RTN"",""SDES2UNDOCHKOUT"",15,0)"
^XMB(3.9,146039,2,3262,0)=" ; SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number. Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XMB(3.9,146039,2,3263,0)="""RTN"",""SDES2UNDOCHKOUT"",16,0)"
^XMB(3.9,146039,2,3264,0)=" ; SDCONTEXT(""USER DUZ"") = The DUZ of the user taking action in the calling application."
^XMB(3.9,146039,2,3265,0)="""RTN"",""SDES2UNDOCHKOUT"",17,0)"
^XMB(3.9,146039,2,3266,0)=" ; SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the calling application."
^XMB(3.9,146039,2,3267,0)="""RTN"",""SDES2UNDOCHKOUT"",18,0)"
^XMB(3.9,146039,2,3268,0)=" ; SDCONTEXT(""PATIENT DFN"") = The DFN/IEN of the target patient from the calling application."
^XMB(3.9,146039,2,3269,0)="""RTN"",""SDES2UNDOCHKOUT"",19,0)"
^XMB(3.9,146039,2,3270,0)=" ; SDCONTEXT(""PATIENT ICN"") = The ICN of the target patient from the calling application."
^XMB(3.9,146039,2,3271,0)="""RTN"",""SDES2UNDOCHKOUT"",20,0)"
^XMB(3.9,146039,2,3272,0)=" ; SDINPUT(""APPOINTMENT IEN"") = (Required) Appointment IEN"
^XMB(3.9,146039,2,3273,0)="""RTN"",""SDES2UNDOCHKOUT"",21,0)"
^XMB(3.9,146039,2,3274,0)=" ;"
^XMB(3.9,146039,2,3275,0)="""RTN"",""SDES2UNDOCHKOUT"",22,0)"
^XMB(3.9,146039,2,3276,0)="UNDOCHECKOUT(JSONRETURN,SDCONTEXT,SDINPUT) ;"
^XMB(3.9,146039,2,3277,0)="""RTN"",""SDES2UNDOCHKOUT"",23,0)"
^XMB(3.9,146039,2,3278,0)=" N ERRORS,SDRETURN,PARAMETERS,Y"
^XMB(3.9,146039,2,3279,0)="""RTN"",""SDES2UNDOCHKOUT"",24,0)"
^XMB(3.9,146039,2,3280,0)=" ; Newed Y due to it leaking"
^XMB(3.9,146039,2,3281,0)="""RTN"",""SDES2UNDOCHKOUT"",25,0)"
^XMB(3.9,146039,2,3282,0)=" D VALCONTEXT^SDES2VALCONTEXT(.ERRORS,.SDCONTEXT)"
^XMB(3.9,146039,2,3283,0)="""RTN"",""SDES2UNDOCHKOUT"",26,0)"
^XMB(3.9,146039,2,3284,0)=" I $D(ERRORS) S ERRORS(""UndoCheckOut"",1)="""",ERRORS(""Appointment"",1)="""" D BUILDJSON^SDES2JSON(.JSONRETURN,.ERRORS) Q"
^XMB(3.9,146039,2,3285,0)="""RTN"",""SDES2UNDOCHKOUT"",27,0)"
^XMB(3.9,146039,2,3286,0)=" I $G(SDCONTEXT(""USER DUZ""))'="""" N DUZ D DUZ^XUP(SDCONTEXT(""USER DUZ""))"
^XMB(3.9,146039,2,3287,0)="""RTN"",""SDES2UNDOCHKOUT"",28,0)"
^XMB(3.9,146039,2,3288,0)=" ;"
^XMB(3.9,146039,2,3289,0)="""RTN"",""SDES2UNDOCHKOUT"",29,0)"
^XMB(3.9,146039,2,3290,0)=" S PARAMETERS=$$VALPARAMS(.SDINPUT,.ERRORS)"
^XMB(3.9,146039,2,3291,0)="""RTN"",""SDES2UNDOCHKOUT"",30,0)"
^XMB(3.9,146039,2,3292,0)=" I $D(ERRORS) S ERRORS(""UndoCheckOut"",1)="""",ERRORS(""Appointment"",1)="""" D BUILDJSON^SDES2JSON(.JSONRETURN,.ERRORS) Q"
^XMB(3.9,146039,2,3293,0)="""RTN"",""SDES2UNDOCHKOUT"",31,0)"
^XMB(3.9,146039,2,3294,0)=" ;"
^XMB(3.9,146039,2,3295,0)="""RTN"",""SDES2UNDOCHKOUT"",32,0)"
^XMB(3.9,146039,2,3296,0)=" D UNDOCKOUT(.SDRETURN,PARAMETERS)"
