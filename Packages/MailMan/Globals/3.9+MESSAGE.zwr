^XMB(3.9,146087,2,3452,0)=" ... S HIT=1 D SETASGN(ASMT) Q  ;Always include Patient Assignment for possible Staff completion"
^XMB(3.9,146087,2,3453,0)="""RTN"",""YTQRQAD4"",213,0)"
^XMB(3.9,146087,2,3454,0)=" ..S ASGNDT=$P(^XTMP(NOD,1,""date""),""."")"
^XMB(3.9,146087,2,3455,0)="""RTN"",""YTQRQAD4"",214,0)"
^XMB(3.9,146087,2,3456,0)=" ..S HASINST=$D(^XTMP(NOD,1,""instruments""))"
^XMB(3.9,146087,2,3457,0)="""RTN"",""YTQRQAD4"",215,0)"
