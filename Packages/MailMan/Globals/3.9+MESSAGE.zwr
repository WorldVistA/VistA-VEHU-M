^XMB(3.9,146084,2,4251,0)="""RTN"",""SDES2VAL44"",338,0)"
^XMB(3.9,146084,2,4252,0)=" ;"
^XMB(3.9,146084,2,4253,0)="""RTN"",""SDES2VAL44"",339,0)"
^XMB(3.9,146084,2,4254,0)="VALCREDITAMIS(ERRORS,SDCLINIC,FDATA) ; CREDIT AMIS STOP CODE"
^XMB(3.9,146084,2,4255,0)="""RTN"",""SDES2VAL44"",340,0)"
^XMB(3.9,146084,2,4256,0)=" N SDCREDITAMIS,SDAMISERROR"
^XMB(3.9,146084,2,4257,0)="""RTN"",""SDES2VAL44"",341,0)"
^XMB(3.9,146084,2,4258,0)=" S SDCREDITAMIS=$G(SDCLINIC(""CREDIT AMIS""))"
^XMB(3.9,146084,2,4259,0)="""RTN"",""SDES2VAL44"",342,0)"
^XMB(3.9,146084,2,4260,0)=" I SDCREDITAMIS=""""!(SDCREDITAMIS=""@"") S FDATA(""CREDIT AMIS"")=SDCREDITAMIS Q"
^XMB(3.9,146084,2,4261,0)="""RTN"",""SDES2VAL44"",343,0)"
^XMB(3.9,146084,2,4262,0)=" S SDAMISERROR=$$VALIDATEAMIS^SDES2UTIL(.SDCREDITAMIS,""C"")"
^XMB(3.9,146084,2,4263,0)="""RTN"",""SDES2VAL44"",344,0)"
^XMB(3.9,146084,2,4264,0)=" I SDAMISERROR D ERRLOG^SDES2JSON(.ERRORS,SDAMISERROR) Q"
^XMB(3.9,146084,2,4265,0)="""RTN"",""SDES2VAL44"",345,0)"
^XMB(3.9,146084,2,4266,0)=" S FDATA(""CREDIT AMIS"")=SDCREDITAMIS"
^XMB(3.9,146084,2,4267,0)="""RTN"",""SDES2VAL44"",346,0)"
^XMB(3.9,146084,2,4268,0)=" Q"
^XMB(3.9,146084,2,4269,0)="""RTN"",""SDES2VAL44"",347,0)"
^XMB(3.9,146084,2,4270,0)=" ;"
^XMB(3.9,146084,2,4271,0)="""RTN"",""SDES2VAL44"",348,0)"
^XMB(3.9,146084,2,4272,0)="CONDAMISCHECK(ERRORS,SDPRIMAMIS,SDCREDITAMIS) ;"
^XMB(3.9,146084,2,4273,0)="""RTN"",""SDES2VAL44"",349,0)"
^XMB(3.9,146084,2,4274,0)=" ; Primary & Credit Stop Codes can't be the same"
^XMB(3.9,146084,2,4275,0)="""RTN"",""SDES2VAL44"",350,0)"
^XMB(3.9,146084,2,4276,0)=" I SDPRIMAMIS=SDCREDITAMIS D ERRLOG^SDES2JSON(.ERRORS,380)"
^XMB(3.9,146084,2,4277,0)="""RTN"",""SDES2VAL44"",351,0)"
^XMB(3.9,146084,2,4278,0)=" Q"
^XMB(3.9,146084,2,4279,0)="""RTN"",""SDES2VAL44"",352,0)"
^XMB(3.9,146084,2,4280,0)=" ;"
^XMB(3.9,146084,2,4281,0)="""RTN"",""SDES2VAL44"",353,0)"
^XMB(3.9,146084,2,4282,0)="LETTER(ERRORS,LETTER) ;Look up the letter IEN"
^XMB(3.9,146084,2,4283,0)="""RTN"",""SDES2VAL44"",354,0)"
^XMB(3.9,146084,2,4284,0)=" I LETTER'=""@"",LETTER'="""" D"
^XMB(3.9,146084,2,4285,0)="""RTN"",""SDES2VAL44"",355,0)"
^XMB(3.9,146084,2,4286,0)=" .I +LETTER,$$GET1^DIQ(407.5,LETTER,.01)'="""" Q"
^XMB(3.9,146084,2,4287,0)="""RTN"",""SDES2VAL44"",356,0)"
^XMB(3.9,146084,2,4288,0)=" .S LETTER=$O(^VA(407.5,""B"",$E(LETTER,1,30),""""))"
^XMB(3.9,146084,2,4289,0)="""RTN"",""SDES2VAL44"",357,0)"
^XMB(3.9,146084,2,4290,0)=" Q LETTER"
^XMB(3.9,146084,2,4291,0)="""RTN"",""SDES2VAL44"",358,0)"
^XMB(3.9,146084,2,4292,0)=" ;"
^XMB(3.9,146084,2,4293,0)="""RTN"",""SDES2VAL44"",359,0)"
^XMB(3.9,146084,2,4294,0)="VALPBSPID(ERRORS,PBSPID,FDATA) ;"
^XMB(3.9,146084,2,4295,0)="""RTN"",""SDES2VAL44"",360,0)"
^XMB(3.9,146084,2,4296,0)=" N VAL"
