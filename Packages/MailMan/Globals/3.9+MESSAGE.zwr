^XMB(3.9,146106,2,2899,0)="""RTN"",""SDES2CREATEAPPT2"",273,0)"
^XMB(3.9,146106,2,2900,0)=" .D REQUESTTYPE^SDES2APPTUTIL(.ERRORS,.APPOINTMENT,$P($G(APPOINTMENT(""REQUEST TYPE"")),""|""),$P($G(APPOINTMENT(""REQUEST TYPE"")),""|"",2),$G(APPOINTMENT(""DFN"")))"
^XMB(3.9,146106,2,2901,0)="""RTN"",""SDES2CREATEAPPT2"",274,0)"
^XMB(3.9,146106,2,2902,0)=" D GETAPPTTYPE^SDES2APPTUTIL(.ERRORS,.APPOINTMENT,$G(APPOINTMENT(""APPOINTMENT TYPE"")),$G(APPOINTMENT(""APPOINTMENT TYPE NAME"")))"
^XMB(3.9,146106,2,2903,0)="""RTN"",""SDES2CREATEAPPT2"",275,0)"
^XMB(3.9,146106,2,2904,0)=" D GETPID^SDES2APPTUTIL(.APPOINTMENT,$G(APPOINTMENT(""PATIENT INDICATED DATE"")),$P($G(APPOINTMENT(""REQUEST TYPE"")),""|""),$P($G(APPOINTMENT(""REQUEST TYPE"")),""|"",2))"
^XMB(3.9,146106,2,2905,0)="""RTN"",""SDES2CREATEAPPT2"",276,0)"
^XMB(3.9,146106,2,2906,0)=" I $D(ERRORS) Q"
^XMB(3.9,146106,2,2907,0)="""RTN"",""SDES2CREATEAPPT2"",277,0)"
