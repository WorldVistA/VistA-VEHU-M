^XMB(3.9,146087,2,3653,0)="""RTN"",""YTQRQAD4"",313,0)"
^XMB(3.9,146087,2,3654,0)="CHKADM(YSADMIN,YSNAM,YSDFN) ;Check Instrument Ad= what is in XTMP"
^XMB(3.9,146087,2,3655,0)="""RTN"",""YTQRQAD4"",314,0)"
^XMB(3.9,146087,2,3656,0)=" N STAT,YSIENS,YSARR,YSERR"
^XMB(3.9,146087,2,3657,0)="""RTN"",""YTQRQAD4"",315,0)"
^XMB(3.9,146087,2,3658,0)=" I $G(YSNAM)="""" S STAT=0 Q STAT"
^XMB(3.9,146087,2,3659,0)="""RTN"",""YTQRQAD4"",316,0)"
^XMB(3.9,146087,2,3660,0)=" I +$G(YSDFN)=0 S STAT=0 Q STAT"
^XMB(3.9,146087,2,3661,0)="""RTN"",""YTQRQAD4"",317,0)"
^XMB(3.9,146087,2,3662,0)=" I +$G(YSADMIN)=0 S STAT=0 Q STAT"
^XMB(3.9,146087,2,3663,0)="""RTN"",""YTQRQAD4"",318,0)"
^XMB(3.9,146087,2,3664,0)=" S STAT=1  ;OK"
