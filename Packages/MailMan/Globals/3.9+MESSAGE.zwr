^XMB(3.9,146012,2,1148,0)=" I '$O(^PS(52.49,""AVPAT"",DFN,0)) D  Q"
^XMB(3.9,146012,2,1149,0)="""RTN"",""PSOERRX0"",337,0)"
^XMB(3.9,146012,2,1150,0)=" . S VALMSG=""No corresponding eRx Patient found"" W $C(7)"
