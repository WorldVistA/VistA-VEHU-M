^XMB(3.9,146087,2,346,0)="0^16^B38971544"
^XMB(3.9,146087,2,347,0)="""RTN"",""YTQAPI1"",1,0)"
^XMB(3.9,146087,2,348,0)="YTQAPI1 ;ASF/ALB - MHAX REMOTE PROCEDURES ;Oct 31, 2024@14:00:33"
^XMB(3.9,146087,2,349,0)="""RTN"",""YTQAPI1"",2,0)"
^XMB(3.9,146087,2,350,0)=" ;;5.01;MENTAL HEALTH;**85,119,121,141,217,249,252,240,250**;Dec 30, 1994;Build 0"
^XMB(3.9,146087,2,351,0)="""RTN"",""YTQAPI1"",3,0)"
^XMB(3.9,146087,2,352,0)=" ;"
^XMB(3.9,146087,2,353,0)="""RTN"",""YTQAPI1"",4,0)"
^XMB(3.9,146087,2,354,0)=" ;"
^XMB(3.9,146087,2,355,0)="""RTN"",""YTQAPI1"",5,0)"
^XMB(3.9,146087,2,356,0)=" ;"
^XMB(3.9,146087,2,357,0)="""RTN"",""YTQAPI1"",6,0)"
^XMB(3.9,146087,2,358,0)=" Q"
^XMB(3.9,146087,2,359,0)="""RTN"",""YTQAPI1"",7,0)"
^XMB(3.9,146087,2,360,0)="RULES(YSDATA,YS) ;list rules for a survey"
^XMB(3.9,146087,2,361,0)="""RTN"",""YTQAPI1"",8,0)"
^XMB(3.9,146087,2,362,0)=" ;entry point for YTQ RULES rpc"
^XMB(3.9,146087,2,363,0)="""RTN"",""YTQAPI1"",9,0)"
^XMB(3.9,146087,2,364,0)=" ;input: CODE as test name"
^XMB(3.9,146087,2,365,0)="""RTN"",""YTQAPI1"",10,0)"
^XMB(3.9,146087,2,366,0)=" ;output: Field^Value"
^XMB(3.9,146087,2,367,0)="""RTN"",""YTQAPI1"",11,0)"
^XMB(3.9,146087,2,368,0)=" N YSBOOL,YSQID,YSRID,YSTESTN,YSTEST,G,G1,G2,N,N1,N2,Z"
^XMB(3.9,146087,2,369,0)="""RTN"",""YTQAPI1"",12,0)"
^XMB(3.9,146087,2,370,0)=" S YSTEST=$G(YS(""CODE""))"
^XMB(3.9,146087,2,371,0)="""RTN"",""YTQAPI1"",13,0)"
^XMB(3.9,146087,2,372,0)=" I YSTEST="""" S YSDATA(1)=""[ERROR]"",YSDATA(2)=""NO code"" Q  ;-->out"
^XMB(3.9,146087,2,373,0)="""RTN"",""YTQAPI1"",14,0)"
^XMB(3.9,146087,2,374,0)=" S YSTESTN=$O(^YTT(601.71,""B"",YSTEST,0))"
^XMB(3.9,146087,2,375,0)="""RTN"",""YTQAPI1"",15,0)"
^XMB(3.9,146087,2,376,0)=" I YSTESTN'>0 S YSDATA(1)=""[ERROR]"",YSDATA(2)=""bad code"" Q  ;-->out"
^XMB(3.9,146087,2,377,0)="""RTN"",""YTQAPI1"",16,0)"
^XMB(3.9,146087,2,378,0)=" S YSDATA(1)=""[DATA]"""
^XMB(3.9,146087,2,379,0)="""RTN"",""YTQAPI1"",17,0)"
^XMB(3.9,146087,2,380,0)=" S N1=1"
^XMB(3.9,146087,2,381,0)="""RTN"",""YTQAPI1"",18,0)"
^XMB(3.9,146087,2,382,0)=" I '$D(^YTT(601.83,""C"",YSTESTN)) S YSDATA(2)=""No Rules"" Q  ;--> out"
^XMB(3.9,146087,2,383,0)="""RTN"",""YTQAPI1"",19,0)"
^XMB(3.9,146087,2,384,0)=" S N=0 F  S N=$O(^YTT(601.83,""C"",YSTESTN,N)) Q:N'>0  D"
^XMB(3.9,146087,2,385,0)="""RTN"",""YTQAPI1"",20,0)"
^XMB(3.9,146087,2,386,0)=" . S YSRID=$P(^YTT(601.83,N,0),U,4)"
^XMB(3.9,146087,2,387,0)="""RTN"",""YTQAPI1"",21,0)"
^XMB(3.9,146087,2,388,0)=" . S G=$G(^YTT(601.82,YSRID,0)) Q:G=""""  ;-->cross bad 83 vs 82"
^XMB(3.9,146087,2,389,0)="""RTN"",""YTQAPI1"",22,0)"
^XMB(3.9,146087,2,390,0)=" . S G1=$G(^YTT(601.82,YSRID,1)),G2=$G(^YTT(601.82,YSRID,2))"
^XMB(3.9,146087,2,391,0)="""RTN"",""YTQAPI1"",23,0)"
^XMB(3.9,146087,2,392,0)=" . S YSQID=$P(G,U,2) S:YSQID="""" YSQID=0"
^XMB(3.9,146087,2,393,0)="""RTN"",""YTQAPI1"",24,0)"
^XMB(3.9,146087,2,394,0)=" . S YSBOOL=$P(G,U,6) S:YSBOOL="""" YSBOOL=0"
^XMB(3.9,146087,2,395,0)="""RTN"",""YTQAPI1"",25,0)"
^XMB(3.9,146087,2,396,0)=" . S N1=N1+1"
^XMB(3.9,146087,2,397,0)="""RTN"",""YTQAPI1"",26,0)"
^XMB(3.9,146087,2,398,0)=" . S Z(YSQID,YSBOOL,N1,1)=$P(G,U)_""=""_$P(G,U,2)_U_$P(G,U,4)_U_$P(G,U,5)_U_$P(G,U,3)_U_$P(G,U,6)_U_$P(G,U,7)"
^XMB(3.9,146087,2,399,0)="""RTN"",""YTQAPI1"",27,0)"
^XMB(3.9,146087,2,400,0)=" . S Z(YSQID,YSBOOL,N1,2)=$P(G1,U,2)_U_$P(G1,U,3)_U_$P(G1,U)"
^XMB(3.9,146087,2,401,0)="""RTN"",""YTQAPI1"",28,0)"
^XMB(3.9,146087,2,402,0)=" . S Z(YSQID,YSBOOL,N1,3)=$P(G2,U)_U_$S($P(G2,U,2)=""Y"":""YES"",$P(G2,U,2)=""N"":""NO"",1:"""")"
^XMB(3.9,146087,2,403,0)="""RTN"",""YTQAPI1"",29,0)"
^XMB(3.9,146087,2,404,0)=" S N2=1"
^XMB(3.9,146087,2,405,0)="""RTN"",""YTQAPI1"",30,0)"
^XMB(3.9,146087,2,406,0)=" S YSQID=0 F  S YSQID=$O(Z(YSQID)) Q:YSQID'>0  S YSBOOL=""Z"" F  S YSBOOL=$O(Z(YSQID,YSBOOL),-1) Q:YSBOOL=""""  S N1=0 F  S N1=$O(Z(YSQID,YSBOOL,N1)) Q:N1'>0  D"
^XMB(3.9,146087,2,407,0)="""RTN"",""YTQAPI1"",31,0)"
^XMB(3.9,146087,2,408,0)=" . S N2=N2+1,YSDATA(N2)=Z(YSQID,YSBOOL,N1,1)"
^XMB(3.9,146087,2,409,0)="""RTN"",""YTQAPI1"",32,0)"
^XMB(3.9,146087,2,410,0)=" . S N2=N2+1,YSDATA(N2)=Z(YSQID,YSBOOL,N1,2)"
^XMB(3.9,146087,2,411,0)="""RTN"",""YTQAPI1"",33,0)"
^XMB(3.9,146087,2,412,0)=" . S N2=N2+1,YSDATA(N2)=Z(YSQID,YSBOOL,N1,3)"
^XMB(3.9,146087,2,413,0)="""RTN"",""YTQAPI1"",34,0)"
^XMB(3.9,146087,2,414,0)=" Q"
^XMB(3.9,146087,2,415,0)="""RTN"",""YTQAPI1"",35,0)"
^XMB(3.9,146087,2,416,0)="EDAD(YSDATA,YS) ;Edit and Save Data"
^XMB(3.9,146087,2,417,0)="""RTN"",""YTQAPI1"",36,0)"
^XMB(3.9,146087,2,418,0)=" N YSERR,YSX,YSNN,YSRESULT,G,YSF,YSV,N,YSIEN,YSFILEN,YSERRLOG"
^XMB(3.9,146087,2,419,0)="""RTN"",""YTQAPI1"",37,0)"
^XMB(3.9,146087,2,420,0)=" N YTTLKUP S YTTLKUP=1  ; don't filter 601.71"
^XMB(3.9,146087,2,421,0)="""RTN"",""YTQAPI1"",38,0)"
^XMB(3.9,146087,2,422,0)=" S YSERRLOG=""EDAD^YTQAPI1 : Error Saving MH Administration"""
^XMB(3.9,146087,2,423,0)="""RTN"",""YTQAPI1"",39,0)"
^XMB(3.9,146087,2,424,0)=" K ^TMP(""YSMHI"",$J)"
^XMB(3.9,146087,2,425,0)="""RTN"",""YTQAPI1"",40,0)"
^XMB(3.9,146087,2,426,0)=" S YSFILEN=$G(YS(""FILEN""))"
^XMB(3.9,146087,2,427,0)="""RTN"",""YTQAPI1"",41,0)"
^XMB(3.9,146087,2,428,0)=" I (YSFILEN<601)!(YSFILEN>605) D  QUIT"
^XMB(3.9,146087,2,429,0)="""RTN"",""YTQAPI1"",42,0)"
^XMB(3.9,146087,2,430,0)=" . D ERR(.YSDATA,""bad filen "",YSERRLOG)"
^XMB(3.9,146087,2,431,0)="""RTN"",""YTQAPI1"",43,0)"
^XMB(3.9,146087,2,432,0)=" S YSIEN=$G(YS(""IEN""),""?+1"")_"","""
^XMB(3.9,146087,2,433,0)="""RTN"",""YTQAPI1"",44,0)"
^XMB(3.9,146087,2,434,0)=" I YSFILEN=601.84 S N=$O(YS(""FILEN""),-1)+1 S:'$D(YS(N)) YS(N)=""18^`""_DUZ"
^XMB(3.9,146087,2,435,0)="""RTN"",""YTQAPI1"",45,0)"
^XMB(3.9,146087,2,436,0)=" S N=0 F  S N=$O(YS(N)) Q:N'>0  D  Q:$G(YSRESULT)=""^"""
^XMB(3.9,146087,2,437,0)="""RTN"",""YTQAPI1"",46,0)"
^XMB(3.9,146087,2,438,0)=" . S G=YS(N)"
^XMB(3.9,146087,2,439,0)="""RTN"",""YTQAPI1"",47,0)"
^XMB(3.9,146087,2,440,0)=" . S YSF=$P(G,U),YSV=$P(G,U,2),YSX=$P(G,U,3)"
^XMB(3.9,146087,2,441,0)="""RTN"",""YTQAPI1"",48,0)"
^XMB(3.9,146087,2,442,0)=" . I '$$VFIELD^DILFD(YSFILEN,YSF) S YSRESULT=1 Q"
^XMB(3.9,146087,2,443,0)="""RTN"",""YTQAPI1"",49,0)"
^XMB(3.9,146087,2,444,0)=" . I YSV="""" S YSRESULT=1 Q"
^XMB(3.9,146087,2,445,0)="""RTN"",""YTQAPI1"",50,0)"
^XMB(3.9,146087,2,446,0)=" . S ^TMP(""YSMHI"",$J,YSFILEN,YSIEN,YSF)=YSV"
^XMB(3.9,146087,2,447,0)="""RTN"",""YTQAPI1"",51,0)"
^XMB(3.9,146087,2,448,0)=" . D:YSX'=1 VAL^DIE(YSFILEN,YSIEN,+YSF,""E"",YSV,.YSRESULT)"
^XMB(3.9,146087,2,449,0)="""RTN"",""YTQAPI1"",52,0)"
^XMB(3.9,146087,2,450,0)=" . ;"
^XMB(3.9,146087,2,451,0)="""RTN"",""YTQAPI1"",53,0)"
^XMB(3.9,146087,2,452,0)=" I $G(YSRESULT)=""^"" D  QUIT"
^XMB(3.9,146087,2,453,0)="""RTN"",""YTQAPI1"",54,0)"
^XMB(3.9,146087,2,454,0)=" . D ERR(.YSDATA,""Value for Field Not Valid^""_YSV_U_YSF,YSERRLOG)"
^XMB(3.9,146087,2,455,0)="""RTN"",""YTQAPI1"",55,0)"
^XMB(3.9,146087,2,456,0)=" L +^YTT(YSFILEN,0):DILOCKTM"
^XMB(3.9,146087,2,457,0)="""RTN"",""YTQAPI1"",56,0)"
^XMB(3.9,146087,2,458,0)=" I '$T D  QUIT"
^XMB(3.9,146087,2,459,0)="""RTN"",""YTQAPI1"",57,0)"
^XMB(3.9,146087,2,460,0)=" . D ERR(.YSDATA,""Could not save administration. (Failed to get lock on File #""_YSFILEN_"")."",YSERRLOG)"
^XMB(3.9,146087,2,461,0)="""RTN"",""YTQAPI1"",58,0)"
^XMB(3.9,146087,2,462,0)=" D UPDATE^DIE(""E"",""^TMP(""""YSMHI"""",$J)"",""YSNN"",""YSERR"")"
^XMB(3.9,146087,2,463,0)="""RTN"",""YTQAPI1"",59,0)"
^XMB(3.9,146087,2,464,0)=" L -^YTT(YSFILEN,0)"
