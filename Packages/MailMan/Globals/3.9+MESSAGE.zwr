^XMB(3.9,146047,2,2972,0)="0^2^B108698085"
^XMB(3.9,146047,2,2973,0)="""RTN"",""IBJPI"",1,0)"
^XMB(3.9,146047,2,2974,0)="IBJPI ;DAOU/BHS - IBJP eIV SITE PARAMETERS SCREEN ; 01-APR-2015"
^XMB(3.9,146047,2,2975,0)="""RTN"",""IBJPI"",2,0)"
^XMB(3.9,146047,2,2976,0)=" ;;2.0;INTEGRATED BILLING;**184,271,316,416,438,479,506,528,549,601,621,659,668,687,702,732,763,771,806,822**;21-MAR-94;Build 0"
^XMB(3.9,146047,2,2977,0)="""RTN"",""IBJPI"",3,0)"
^XMB(3.9,146047,2,2978,0)=" ;;Per VA Directive 6402, this routine should not be modified."
