^XMB(3.9,146084,2,2634,0)=" ;;5.3;Scheduling;**866,881,890,895,901,907,909**;Aug 13, 1993;Build 0"
^XMB(3.9,146084,2,2635,0)="""RTN"",""SDES2RECLLREQ"",3,0)"
^XMB(3.9,146084,2,2636,0)=" ;;Per VHA Directive 6402, this routine should not be modified"
^XMB(3.9,146084,2,2637,0)="""RTN"",""SDES2RECLLREQ"",4,0)"
^XMB(3.9,146084,2,2638,0)=" ;"
^XMB(3.9,146084,2,2639,0)="""RTN"",""SDES2RECLLREQ"",5,0)"
^XMB(3.9,146084,2,2640,0)=" ; Reference to DUZ^XUP is supported by IA #7487"
^XMB(3.9,146084,2,2641,0)="""RTN"",""SDES2RECLLREQ"",6,0)"
^XMB(3.9,146084,2,2642,0)=" ;"
^XMB(3.9,146084,2,2643,0)="""RTN"",""SDES2RECLLREQ"",7,0)"
^XMB(3.9,146084,2,2644,0)=" Q  ;No Direct Call"
^XMB(3.9,146084,2,2645,0)="""RTN"",""SDES2RECLLREQ"",8,0)"
^XMB(3.9,146084,2,2646,0)=" ;"
^XMB(3.9,146084,2,2647,0)="""RTN"",""SDES2RECLLREQ"",9,0)"
^XMB(3.9,146084,2,2648,0)=" ; SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number. Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XMB(3.9,146084,2,2649,0)="""RTN"",""SDES2RECLLREQ"",10,0)"
^XMB(3.9,146084,2,2650,0)=" ; SDCONTEXT(""PATIENT DFN"") = The DFN/IEN of the target patient from the calling application."
^XMB(3.9,146084,2,2651,0)="""RTN"",""SDES2RECLLREQ"",11,0)"
^XMB(3.9,146084,2,2652,0)=" ; SDCONTEXT(""PATIENT ICN"") = The ICN of the target patient from the calling application."
^XMB(3.9,146084,2,2653,0)="""RTN"",""SDES2RECLLREQ"",12,0)"
^XMB(3.9,146084,2,2654,0)=" ; SDCONTEXT(""USER DUZ"") = The DUZ of the user taking action in the calling application."
^XMB(3.9,146084,2,2655,0)="""RTN"",""SDES2RECLLREQ"",13,0)"
^XMB(3.9,146084,2,2656,0)=" ; SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the calling application."
^XMB(3.9,146084,2,2657,0)="""RTN"",""SDES2RECLLREQ"",14,0)"
^XMB(3.9,146084,2,2658,0)=" ;"
^XMB(3.9,146084,2,2659,0)="""RTN"",""SDES2RECLLREQ"",15,0)"
^XMB(3.9,146084,2,2660,0)=" ; SDES2 CREATE RECALL REQUEST:"
^XMB(3.9,146084,2,2661,0)="""RTN"",""SDES2RECLLREQ"",16,0)"
^XMB(3.9,146084,2,2662,0)=" ; SDINPUT(""DFN"") = POINTER TO PATIENT (#2) FILE (required)"
^XMB(3.9,146084,2,2663,0)="""RTN"",""SDES2RECLLREQ"",17,0)"
^XMB(3.9,146084,2,2664,0)=" ; SDINPUT(""ACCESSION NUMBER"") = ACCESSION # (FREE TEXT)"
^XMB(3.9,146084,2,2665,0)="""RTN"",""SDES2RECLLREQ"",18,0)"
^XMB(3.9,146084,2,2666,0)=" ; SDINPUT(""COMMENT"""") = COMMENT (FREE TEXT)"
^XMB(3.9,146084,2,2667,0)="""RTN"",""SDES2RECLLREQ"",19,0)"
^XMB(3.9,146084,2,2668,0)=" ; SDINPUT(""FASTING"") = Labs: FASTING ; NON-FASTING ; @ - None (required)"
^XMB(3.9,146084,2,2669,0)="""RTN"",""SDES2RECLLREQ"",20,0)"
^XMB(3.9,146084,2,2670,0)=" ; SDINPUT(APPOINTMENT TYPE"") = (required) ; Name of the RECALL REMINDERS APPT TYPE (#403.51) FILE"
^XMB(3.9,146084,2,2671,0)="""RTN"",""SDES2RECLLREQ"",21,0)"
^XMB(3.9,146084,2,2672,0)=" ; SDINPUT(""RECALL PROVIDER IEN"") = RECALL PROVIDER - POINTER TO RECALL REMINDERS PROVIDERS (#403.54) FILE (required)"
^XMB(3.9,146084,2,2673,0)="""RTN"",""SDES2RECLLREQ"",22,0)"
^XMB(3.9,146084,2,2674,0)=" ; SDINPUT(""CLINIC IEN"") = CLINIC POINTER TO HOSPITAL LOCATION (#44) FILE (required)"
^XMB(3.9,146084,2,2675,0)="""RTN"",""SDES2RECLLREQ"",23,0)"
^XMB(3.9,146084,2,2676,0)=" ; SDINPUT(""APPOINTMENT LENGTH"") = LENGTH OF APPOINTMENT NUMERIC BETWEEN 10 AND 240."
^XMB(3.9,146084,2,2677,0)="""RTN"",""SDES2RECLLREQ"",24,0)"
^XMB(3.9,146084,2,2678,0)=" ; SDINPUT(""RECALL DATE"") = Recall date in ISO8601 date format (no time). e.g., CCYY-MM-DD (required)"
^XMB(3.9,146084,2,2679,0)="""RTN"",""SDES2RECLLREQ"",25,0)"
^XMB(3.9,146084,2,2680,0)=" ; SDINPUT(RECALL DATE PER PATIENT"") = Recall date (per patient) in ISO8601 date format (no time). e.g., CCYY-MM-DD"
^XMB(3.9,146084,2,2681,0)="""RTN"",""SDES2RECLLREQ"",26,0)"
^XMB(3.9,146084,2,2682,0)=" ; SDINPUT(""DATE REMINDER SENT"") = Date Reminder was sent in ISO8601 date format (no time). e.g., CCYY-MM-DD"
^XMB(3.9,146084,2,2683,0)="""RTN"",""SDES2RECLLREQ"",27,0)"
^XMB(3.9,146084,2,2684,0)=" ; SDINPUT(""SECOND PRINT DATE"") = Second print date in ISO8601 date format (no time). e.g., CCYY-MM-DD"
^XMB(3.9,146084,2,2685,0)="""RTN"",""SDES2RECLLREQ"",28,0)"
^XMB(3.9,146084,2,2686,0)=" ; SDINPUT(""DATE ENTERED"") = Date recall was added. Date is in ISO8601 format (e.g., CCYY-MM-DD)"
^XMB(3.9,146084,2,2687,0)="""RTN"",""SDES2RECLLREQ"",29,0)"
