^XMB(3.9,146012,2,912,0)=" . W !,PRV,""."",?4,$E(PRVLST(""DILIST"",""ID"",PRV,.01),1,30),?35,PRVLST(""DILIST"",""ID"",PRV,1.5)"
^XMB(3.9,146012,2,913,0)="""RTN"",""PSOERRX0"",219,0)"
