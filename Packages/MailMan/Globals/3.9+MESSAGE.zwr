^XMB(3.9,146098,2,2409,0)="""RTN"",""SDLT"",88,0)"
^XMB(3.9,146098,2,2410,0)=" ;if confidential address is not active for scheduling/appointment letters, print to regular address"
^XMB(3.9,146098,2,2411,0)="""RTN"",""SDLT"",89,0)"
^XMB(3.9,146098,2,2412,0)=" I ($G(SDCCACT1)=0)!($G(SDCCACT2)'=""Y"") D"
^XMB(3.9,146098,2,2413,0)="""RTN"",""SDLT"",90,0)"
^XMB(3.9,146098,2,2414,0)=" .F LL=1:1:3 W:VAPA(LL)]"""" !,?12,VAPA(LL)"
^XMB(3.9,146098,2,2415,0)="""RTN"",""SDLT"",91,0)"
^XMB(3.9,146098,2,2416,0)=" .;if country is blank display as USA"
^XMB(3.9,146098,2,2417,0)="""RTN"",""SDLT"",92,0)"
^XMB(3.9,146098,2,2418,0)=" .I (VAPA(25)="""")!($P(VAPA(25),""^"",2)=""UNITED STATES"")  D  ;display city,state,zip"
^XMB(3.9,146098,2,2419,0)="""RTN"",""SDLT"",93,0)"
^XMB(3.9,146098,2,2420,0)=" ..W !,?12,VAPA(4)_"" ""_$P(VAPA(5),U,2)_""  ""_$P(VAPA(11),U,2)"
^XMB(3.9,146098,2,2421,0)="""RTN"",""SDLT"",94,0)"
^XMB(3.9,146098,2,2422,0)=" .E  D  ;display postal code,city,province"
^XMB(3.9,146098,2,2423,0)="""RTN"",""SDLT"",95,0)"
