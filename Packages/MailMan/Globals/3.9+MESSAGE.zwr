^XMB(3.9,146021,2,816,0)=" .S BWDIFF=$S(ABW>IBW:ABW-IBW,1:0)"
^XMB(3.9,146021,2,817,0)="""RTN"",""PSJLMHED"",146,0)"
^XMB(3.9,146021,2,818,0)=" .S LOWBW=$S(IBW<ABW:IBW,1:ABW)"
^XMB(3.9,146021,2,819,0)="""RTN"",""PSJLMHED"",147,0)"
^XMB(3.9,146021,2,820,0)=" .I BWRATIO>1.3,(BWDIFF>0) S ADJBW=((0.3*BWDIFF)+IBW)"
