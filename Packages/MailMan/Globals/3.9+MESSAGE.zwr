^XMB(3.9,146104,2,745,0)="""RTN"",""IBAMTC"",255,0)"
^XMB(3.9,146104,2,746,0)=" Q"
^XMB(3.9,146104,2,747,0)="""RTN"",""IBAMTC"",256,0)"
^XMB(3.9,146104,2,748,0)=" ;"
^XMB(3.9,146104,2,749,0)="""RTN"",""IBAMTC"",257,0)"
^XMB(3.9,146104,2,750,0)="FNDMHVST(DFN,IBEVDT) ; find existing MH visit on a given date  IB*2.0*760"
