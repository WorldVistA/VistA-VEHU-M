^XMB(3.9,146009,2,381,0)="""RTN"",""XUIAMNPB"",58,0)"
^XMB(3.9,146009,2,382,0)=" .S XUFLDS=XUFLDS_""747.44;53.4;53.5;53.6;53.9;53.91;53.92;55.1;55.2;55.3;55.4;55.5;55.6;8910*"""
^XMB(3.9,146009,2,383,0)="""RTN"",""XUIAMNPB"",59,0)"
^XMB(3.9,146009,2,384,0)=" .S:($$PATCH^XPDUTL(""XU*8.0*688"")) XUFLDS=XUFLDS_"";9001;53.21*""  ;NEW DETOX CALCULATED and DEA #'S multiple | DBIA #10141 (Supported)"
