^XMB(3.9,146047,2,1004,0)=" ;"
^XMB(3.9,146047,2,1005,0)="""RTN"",""IBCNBCD2"",314,0)"
^XMB(3.9,146047,2,1006,0)="EDTREC(IBIEN,IBDR) ; Edit Coverage Limitaitons"
^XMB(3.9,146047,2,1007,0)="""RTN"",""IBCNBCD2"",315,0)"
^XMB(3.9,146047,2,1008,0)=" N DA,DR,DIE"
^XMB(3.9,146047,2,1009,0)="""RTN"",""IBCNBCD2"",316,0)"
^XMB(3.9,146047,2,1010,0)=" S DA=IBIEN,DR=IBDR"
