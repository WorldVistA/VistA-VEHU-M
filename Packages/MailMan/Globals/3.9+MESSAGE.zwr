^XMB(3.9,146042,2,254,0)="XTHC ;HCIOFO/SG - HTTP 1.0 CLIENT ;11/10/2009"
^XMB(3.9,146042,2,255,0)="""RTN"",""XTHC"",2,0)"
^XMB(3.9,146042,2,256,0)=" ;;7.3;TOOLKIT;**123**;Apr 25, 1995;Build 0"
^XMB(3.9,146042,2,257,0)="""RTN"",""XTHC"",3,0)"
^XMB(3.9,146042,2,258,0)=" ;"
^XMB(3.9,146042,2,259,0)="""RTN"",""XTHC"",4,0)"
^XMB(3.9,146042,2,260,0)=" ; API ENTRY POINTS ---- DESCRIPTIONS"
^XMB(3.9,146042,2,261,0)="""RTN"",""XTHC"",5,0)"
^XMB(3.9,146042,2,262,0)=" ;"
^XMB(3.9,146042,2,263,0)="""RTN"",""XTHC"",6,0)"
^XMB(3.9,146042,2,264,0)=" ;   $$GETURL^XTHC10     Gets the data from the provided URL"
^XMB(3.9,146042,2,265,0)="""RTN"",""XTHC"",7,0)"
^XMB(3.9,146042,2,266,0)=" ;"
^XMB(3.9,146042,2,267,0)="""RTN"",""XTHC"",8,0)"
^XMB(3.9,146042,2,268,0)=" ;       DEMO^XTHCDEM    Demonstartion entry point"
^XMB(3.9,146042,2,269,0)="""RTN"",""XTHC"",9,0)"
^XMB(3.9,146042,2,270,0)=" ;"
^XMB(3.9,146042,2,271,0)="""RTN"",""XTHC"",10,0)"
^XMB(3.9,146042,2,272,0)=" ;   $$ENCODE^XTHCURL    Encodes the string"
^XMB(3.9,146042,2,273,0)="""RTN"",""XTHC"",11,0)"
^XMB(3.9,146042,2,274,0)=" ;  $$MAKEURL^XTHCURL    Creates a URL from components"
^XMB(3.9,146042,2,275,0)="""RTN"",""XTHC"",12,0)"
^XMB(3.9,146042,2,276,0)=" ; $$PARSEURL^XTHCURL    Parses the URL into components"
^XMB(3.9,146042,2,277,0)="""RTN"",""XTHC"",13,0)"
^XMB(3.9,146042,2,278,0)=" ; $$NORMPATH^XTHCURL    Returns ""normalized"" path"
^XMB(3.9,146042,2,279,0)="""RTN"",""XTHC"",14,0)"
^XMB(3.9,146042,2,280,0)=" ;"
^XMB(3.9,146042,2,281,0)="""RTN"",""XTHC"",15,0)"
^XMB(3.9,146042,2,282,0)=" ;   $$DECODE^XTHCUTL    Decodes one string replacing"
^XMB(3.9,146042,2,283,0)="""RTN"",""XTHC"",16,0)"
^XMB(3.9,146042,2,284,0)=" ;                       &lt; <, &gt; >, &amp; &, &nbsp; "" ""."
^XMB(3.9,146042,2,285,0)="""RTN"",""XTHC"",17,0)"
^XMB(3.9,146042,2,286,0)=" ;"
^XMB(3.9,146042,2,287,0)="""RTN"",""XTHC"",18,0)"
^XMB(3.9,146042,2,288,0)=" ; INTERNAL TOOLS ------ DESCRIPTIONS"
^XMB(3.9,146042,2,289,0)="""RTN"",""XTHC"",19,0)"
^XMB(3.9,146042,2,290,0)=" ;"
^XMB(3.9,146042,2,291,0)="""RTN"",""XTHC"",20,0)"
^XMB(3.9,146042,2,292,0)=" ;  $$RECEIVE^XTHC10A    Reads the HTTP response"
^XMB(3.9,146042,2,293,0)="""RTN"",""XTHC"",21,0)"
^XMB(3.9,146042,2,294,0)=" ;  $$REQUEST^XTHC10A    Sends the HTTP request"
^XMB(3.9,146042,2,295,0)="""RTN"",""XTHC"",22,0)"
^XMB(3.9,146042,2,296,0)=" ;"
^XMB(3.9,146042,2,297,0)="""RTN"",""XTHC"",23,0)"
^XMB(3.9,146042,2,298,0)=" Q"
^XMB(3.9,146042,2,299,0)="""RTN"",""XTHC10"")"
^XMB(3.9,146042,2,300,0)="0^5^B20611631"
^XMB(3.9,146042,2,301,0)="""RTN"",""XTHC10"",1,0)"
^XMB(3.9,146042,2,302,0)="XTHC10 ;HCIOFO/SG - HTTP 1.0 CLIENT ;12/07/2011"
^XMB(3.9,146042,2,303,0)="""RTN"",""XTHC10"",2,0)"
^XMB(3.9,146042,2,304,0)=" ;;7.3;TOOLKIT;**123,566,LOCAL**;Apr 25, 1995;Build 0"
^XMB(3.9,146042,2,305,0)="""RTN"",""XTHC10"",3,0)"
^XMB(3.9,146042,2,306,0)=" ;"
^XMB(3.9,146042,2,307,0)="""RTN"",""XTHC10"",4,0)"
^XMB(3.9,146042,2,308,0)=" Q"
^XMB(3.9,146042,2,309,0)="""RTN"",""XTHC10"",5,0)"
^XMB(3.9,146042,2,310,0)=" ;"
^XMB(3.9,146042,2,311,0)="""RTN"",""XTHC10"",6,0)"
^XMB(3.9,146042,2,312,0)=" ;##### GETS THE DATA FROM THE PROVIDED URL USING HTTP 1.0"
^XMB(3.9,146042,2,313,0)="""RTN"",""XTHC10"",7,0)"
^XMB(3.9,146042,2,314,0)=" ;"
^XMB(3.9,146042,2,315,0)="""RTN"",""XTHC10"",8,0)"
^XMB(3.9,146042,2,316,0)=" ; URL           URL (http://host:port/path)"
^XMB(3.9,146042,2,317,0)="""RTN"",""XTHC10"",9,0)"
^XMB(3.9,146042,2,318,0)=" ;"
^XMB(3.9,146042,2,319,0)="""RTN"",""XTHC10"",10,0)"
^XMB(3.9,146042,2,320,0)=" ; [XT8FLG]      Timeout and flags to control processing."
^XMB(3.9,146042,2,321,0)="""RTN"",""XTHC10"",11,0)"
^XMB(3.9,146042,2,322,0)=" ;               If a value of  this parameter starts from a number"
^XMB(3.9,146042,2,323,0)="""RTN"",""XTHC10"",12,0)"
^XMB(3.9,146042,2,324,0)=" ;               then this number is used as a value of the timeout"
^XMB(3.9,146042,2,325,0)="""RTN"",""XTHC10"",13,0)"
^XMB(3.9,146042,2,326,0)=" ;               (in seconds). Otherwise, the default value of 5"
^XMB(3.9,146042,2,327,0)="""RTN"",""XTHC10"",14,0)"
^XMB(3.9,146042,2,328,0)=" ;               seconds is used."
^XMB(3.9,146042,2,329,0)="""RTN"",""XTHC10"",15,0)"
^XMB(3.9,146042,2,330,0)=" ;"
^XMB(3.9,146042,2,331,0)="""RTN"",""XTHC10"",16,0)"
^XMB(3.9,146042,2,332,0)=" ; [XT8RDAT]     Closed root of the variable where the message"
^XMB(3.9,146042,2,333,0)="""RTN"",""XTHC10"",17,0)"
^XMB(3.9,146042,2,334,0)=" ;               body is returned. Data is stored in consecutive"
^XMB(3.9,146042,2,335,0)="""RTN"",""XTHC10"",18,0)"
^XMB(3.9,146042,2,336,0)=" ;               nodes (numbers starting from 1). If a line is"
^XMB(3.9,146042,2,337,0)="""RTN"",""XTHC10"",19,0)"
^XMB(3.9,146042,2,338,0)=" ;               longer than 245 characters, only 245 characters"
^XMB(3.9,146042,2,339,0)="""RTN"",""XTHC10"",20,0)"
^XMB(3.9,146042,2,340,0)=" ;               are stored in the corresponding node. After that,"
^XMB(3.9,146042,2,341,0)="""RTN"",""XTHC10"",21,0)"
^XMB(3.9,146042,2,342,0)=" ;               overflow sub-nodes are created. For example:"
^XMB(3.9,146042,2,343,0)="""RTN"",""XTHC10"",22,0)"
^XMB(3.9,146042,2,344,0)=" ;"
^XMB(3.9,146042,2,345,0)="""RTN"",""XTHC10"",23,0)"
^XMB(3.9,146042,2,346,0)=" ;                 @XT8DATA@(1)=""<html>"""
^XMB(3.9,146042,2,347,0)="""RTN"",""XTHC10"",24,0)"
^XMB(3.9,146042,2,348,0)=" ;                 @XT8DATA@(2)=""<head><title>VistA</title></head>"""
^XMB(3.9,146042,2,349,0)="""RTN"",""XTHC10"",25,0)"
^XMB(3.9,146042,2,350,0)=" ;                 @XT8DATA@(3)=""<body>"""
^XMB(3.9,146042,2,351,0)="""RTN"",""XTHC10"",26,0)"
^XMB(3.9,146042,2,352,0)=" ;                 @XT8DATA@(4)=""<p>"""
^XMB(3.9,146042,2,353,0)="""RTN"",""XTHC10"",27,0)"
^XMB(3.9,146042,2,354,0)=" ;                 @XT8DATA@(5)=""Beginning of a very long line"""
^XMB(3.9,146042,2,355,0)="""RTN"",""XTHC10"",28,0)"
^XMB(3.9,146042,2,356,0)=" ;                 @XT8DATA@(5,1)=""Continuation #1 of the long line"""
^XMB(3.9,146042,2,357,0)="""RTN"",""XTHC10"",29,0)"
^XMB(3.9,146042,2,358,0)=" ;                 @XT8DATA@(5,2)=""Continuation #2 of the long line"""
^XMB(3.9,146042,2,359,0)="""RTN"",""XTHC10"",30,0)"
^XMB(3.9,146042,2,360,0)=" ;                 @XT8DATA@(5,...)=..."
^XMB(3.9,146042,2,361,0)="""RTN"",""XTHC10"",31,0)"
^XMB(3.9,146042,2,362,0)=" ;                 @XT8DATA@(6)=""</p>"""
^XMB(3.9,146042,2,363,0)="""RTN"",""XTHC10"",32,0)"
^XMB(3.9,146042,2,364,0)=" ;                 ..."
^XMB(3.9,146042,2,365,0)="""RTN"",""XTHC10"",33,0)"
^XMB(3.9,146042,2,366,0)=" ;"
^XMB(3.9,146042,2,367,0)="""RTN"",""XTHC10"",34,0)"
^XMB(3.9,146042,2,368,0)=" ; [.XT8RHDR]    Reference to a local variable where the parsed"
^XMB(3.9,146042,2,369,0)="""RTN"",""XTHC10"",35,0)"
^XMB(3.9,146042,2,370,0)=" ;               headers are returned. Header names are converted to"
^XMB(3.9,146042,2,371,0)="""RTN"",""XTHC10"",36,0)"
^XMB(3.9,146042,2,372,0)=" ;               upper case; the values are left ""as is"". The root"
^XMB(3.9,146042,2,373,0)="""RTN"",""XTHC10"",37,0)"
^XMB(3.9,146042,2,374,0)=" ;               node contains the status line. For example:"
^XMB(3.9,146042,2,375,0)="""RTN"",""XTHC10"",38,0)"
^XMB(3.9,146042,2,376,0)=" ;"
^XMB(3.9,146042,2,377,0)="""RTN"",""XTHC10"",39,0)"
^XMB(3.9,146042,2,378,0)=" ;                 XT8HDR=""HTTP/1.0 200 OK"""
^XMB(3.9,146042,2,379,0)="""RTN"",""XTHC10"",40,0)"
^XMB(3.9,146042,2,380,0)=" ;                 XT8HDR(""CACHE-CONTROL"")=""private"""
^XMB(3.9,146042,2,381,0)="""RTN"",""XTHC10"",41,0)"
^XMB(3.9,146042,2,382,0)=" ;                 XT8HDR(""CONNECTION"")=""Keep-Alive"""
^XMB(3.9,146042,2,383,0)="""RTN"",""XTHC10"",42,0)"
^XMB(3.9,146042,2,384,0)=" ;                 XT8HDR(""CONTENT-LENGTH"")=""2690"""
^XMB(3.9,146042,2,385,0)="""RTN"",""XTHC10"",43,0)"
^XMB(3.9,146042,2,386,0)=" ;                 XT8HDR(""CONTENT-TYPE"")=""text/html"""
^XMB(3.9,146042,2,387,0)="""RTN"",""XTHC10"",44,0)"
^XMB(3.9,146042,2,388,0)=" ;                 XT8HDR(""DATE"")=""Fri, 26 Sep 2003 16:04:10 GMT"""
^XMB(3.9,146042,2,389,0)="""RTN"",""XTHC10"",45,0)"
^XMB(3.9,146042,2,390,0)=" ;                 XT8HDR(""SERVER"")=""GWS/2.1"""
^XMB(3.9,146042,2,391,0)="""RTN"",""XTHC10"",46,0)"
^XMB(3.9,146042,2,392,0)=" ;"
^XMB(3.9,146042,2,393,0)="""RTN"",""XTHC10"",47,0)"
^XMB(3.9,146042,2,394,0)=" ; [XT8SDAT]     Closed root of a variable containing body of the"
^XMB(3.9,146042,2,395,0)="""RTN"",""XTHC10"",48,0)"
^XMB(3.9,146042,2,396,0)=" ;               request message. Data should be formatted as"
^XMB(3.9,146042,2,397,0)="""RTN"",""XTHC10"",49,0)"
^XMB(3.9,146042,2,398,0)=" ;               described earlier (see the XT8RDAT parameter)."
^XMB(3.9,146042,2,399,0)="""RTN"",""XTHC10"",50,0)"
^XMB(3.9,146042,2,400,0)=" ;"
^XMB(3.9,146042,2,401,0)="""RTN"",""XTHC10"",51,0)"
^XMB(3.9,146042,2,402,0)=" ;               NOTE: If this parameter is defined, not empty, and"
^XMB(3.9,146042,2,403,0)="""RTN"",""XTHC10"",52,0)"
^XMB(3.9,146042,2,404,0)=" ;                     the referenced array contains data then the"
^XMB(3.9,146042,2,405,0)="""RTN"",""XTHC10"",53,0)"
^XMB(3.9,146042,2,406,0)=" ;                     POST request is generated. Otherwise, the GET"
^XMB(3.9,146042,2,407,0)="""RTN"",""XTHC10"",54,0)"
^XMB(3.9,146042,2,408,0)=" ;                     request is sent."
^XMB(3.9,146042,2,409,0)="""RTN"",""XTHC10"",55,0)"
^XMB(3.9,146042,2,410,0)=" ;"
^XMB(3.9,146042,2,411,0)="""RTN"",""XTHC10"",56,0)"
^XMB(3.9,146042,2,412,0)=" ; [.XT8SHDR]    Reference to a local variable containing header"
^XMB(3.9,146042,2,413,0)="""RTN"",""XTHC10"",57,0)"
^XMB(3.9,146042,2,414,0)=" ;               values, which will be added to the request."
^XMB(3.9,146042,2,415,0)="""RTN"",""XTHC10"",58,0)"
^XMB(3.9,146042,2,416,0)=" ;"
^XMB(3.9,146042,2,417,0)="""RTN"",""XTHC10"",59,0)"
^XMB(3.9,146042,2,418,0)=" ; [REDIR]       This IS NOT a published parameter. It is used"
^XMB(3.9,146042,2,419,0)="""RTN"",""XTHC10"",60,0)"
^XMB(3.9,146042,2,420,0)=" ;               internally to limit number of redirections."
^XMB(3.9,146042,2,421,0)="""RTN"",""XTHC10"",61,0)"
^XMB(3.9,146042,2,422,0)=" ;"
^XMB(3.9,146042,2,423,0)="""RTN"",""XTHC10"",62,0)"
^XMB(3.9,146042,2,424,0)=" ; Return values:"
^XMB(3.9,146042,2,425,0)="""RTN"",""XTHC10"",63,0)"
^XMB(3.9,146042,2,426,0)=" ;"
^XMB(3.9,146042,2,427,0)="""RTN"",""XTHC10"",64,0)"
^XMB(3.9,146042,2,428,0)=" ;           <0  Error Descriptor (see the $$ERROR^XTERROR)"
^XMB(3.9,146042,2,429,0)="""RTN"",""XTHC10"",65,0)"
^XMB(3.9,146042,2,430,0)=" ;           >0  HTTP Status Code^Description"
^XMB(3.9,146042,2,431,0)="""RTN"",""XTHC10"",66,0)"
^XMB(3.9,146042,2,432,0)=" ;"
^XMB(3.9,146042,2,433,0)="""RTN"",""XTHC10"",67,0)"
^XMB(3.9,146042,2,434,0)=" ;    Most common HTTP status codes:"
^XMB(3.9,146042,2,435,0)="""RTN"",""XTHC10"",68,0)"
^XMB(3.9,146042,2,436,0)=" ;"
^XMB(3.9,146042,2,437,0)="""RTN"",""XTHC10"",69,0)"
^XMB(3.9,146042,2,438,0)=" ;          200  Ok"
^XMB(3.9,146042,2,439,0)="""RTN"",""XTHC10"",70,0)"
^XMB(3.9,146042,2,440,0)=" ;"
^XMB(3.9,146042,2,441,0)="""RTN"",""XTHC10"",71,0)"
^XMB(3.9,146042,2,442,0)=" ;          301  Moved Permanently (The application should either"
^XMB(3.9,146042,2,443,0)="""RTN"",""XTHC10"",72,0)"
^XMB(3.9,146042,2,444,0)=" ;               automatically update the URL with the new one from"
^XMB(3.9,146042,2,445,0)="""RTN"",""XTHC10"",73,0)"
^XMB(3.9,146042,2,446,0)=" ;               the Location response header or instruct the user"
^XMB(3.9,146042,2,447,0)="""RTN"",""XTHC10"",74,0)"
^XMB(3.9,146042,2,448,0)=" ;               how to do this)."
^XMB(3.9,146042,2,449,0)="""RTN"",""XTHC10"",75,0)"
^XMB(3.9,146042,2,450,0)=" ;"
^XMB(3.9,146042,2,451,0)="""RTN"",""XTHC10"",76,0)"
^XMB(3.9,146042,2,452,0)=" ;          302  Moved Temporarily (The application should continue"
^XMB(3.9,146042,2,453,0)="""RTN"",""XTHC10"",77,0)"
^XMB(3.9,146042,2,454,0)=" ;               using the original URL)."
^XMB(3.9,146042,2,455,0)="""RTN"",""XTHC10"",78,0)"
^XMB(3.9,146042,2,456,0)=" ;"
^XMB(3.9,146042,2,457,0)="""RTN"",""XTHC10"",79,0)"
^XMB(3.9,146042,2,458,0)=" ;               NOTE: You will not see this code for GET requests."
^XMB(3.9,146042,2,459,0)="""RTN"",""XTHC10"",80,0)"
^XMB(3.9,146042,2,460,0)=" ;                     They are redirected automatically."
^XMB(3.9,146042,2,461,0)="""RTN"",""XTHC10"",81,0)"
^XMB(3.9,146042,2,462,0)=" ;"
^XMB(3.9,146042,2,463,0)="""RTN"",""XTHC10"",82,0)"
^XMB(3.9,146042,2,464,0)=" ;          303  See Other (The resource has moved to another URL"
^XMB(3.9,146042,2,465,0)="""RTN"",""XTHC10"",83,0)"
^XMB(3.9,146042,2,466,0)=" ;               given by the Location response header, and should"
^XMB(3.9,146042,2,467,0)="""RTN"",""XTHC10"",84,0)"
^XMB(3.9,146042,2,468,0)=" ;               be automatically retrieved by the client using the"
^XMB(3.9,146042,2,469,0)="""RTN"",""XTHC10"",85,0)"
^XMB(3.9,146042,2,470,0)=" ;               GET method. This is often used by a CGI script to"
^XMB(3.9,146042,2,471,0)="""RTN"",""XTHC10"",86,0)"
^XMB(3.9,146042,2,472,0)=" ;               redirect the client to an existing file)."
^XMB(3.9,146042,2,473,0)="""RTN"",""XTHC10"",87,0)"
^XMB(3.9,146042,2,474,0)=" ;"
^XMB(3.9,146042,2,475,0)="""RTN"",""XTHC10"",88,0)"
^XMB(3.9,146042,2,476,0)=" ;               NOTE: You will not see this status code because it"
^XMB(3.9,146042,2,477,0)="""RTN"",""XTHC10"",89,0)"
^XMB(3.9,146042,2,478,0)=" ;                     is handled automatically inside the function."
^XMB(3.9,146042,2,479,0)="""RTN"",""XTHC10"",90,0)"
^XMB(3.9,146042,2,480,0)=" ;"
^XMB(3.9,146042,2,481,0)="""RTN"",""XTHC10"",91,0)"
^XMB(3.9,146042,2,482,0)=" ;          400  Bad Request"
^XMB(3.9,146042,2,483,0)="""RTN"",""XTHC10"",92,0)"
^XMB(3.9,146042,2,484,0)=" ;"
^XMB(3.9,146042,2,485,0)="""RTN"",""XTHC10"",93,0)"
^XMB(3.9,146042,2,486,0)=" ;          404  Not Found"
^XMB(3.9,146042,2,487,0)="""RTN"",""XTHC10"",94,0)"
^XMB(3.9,146042,2,488,0)=" ;"
^XMB(3.9,146042,2,489,0)="""RTN"",""XTHC10"",95,0)"
^XMB(3.9,146042,2,490,0)=" ;          500  Server Error (An unexpected server error. The most"
^XMB(3.9,146042,2,491,0)="""RTN"",""XTHC10"",96,0)"
^XMB(3.9,146042,2,492,0)=" ;               common cause is a server-side script that has bad"
^XMB(3.9,146042,2,493,0)="""RTN"",""XTHC10"",97,0)"
^XMB(3.9,146042,2,494,0)=" ;               syntax, fails, or otherwise can't run correctly)."
^XMB(3.9,146042,2,495,0)="""RTN"",""XTHC10"",98,0)"
^XMB(3.9,146042,2,496,0)=" ;"
^XMB(3.9,146042,2,497,0)="""RTN"",""XTHC10"",99,0)"
^XMB(3.9,146042,2,498,0)=" ; See the http://www.faqs.org/rfcs/rfc1945.html for more details."
^XMB(3.9,146042,2,499,0)="""RTN"",""XTHC10"",100,0)"
^XMB(3.9,146042,2,500,0)=" ;"
^XMB(3.9,146042,2,501,0)="""RTN"",""XTHC10"",101,0)"
^XMB(3.9,146042,2,502,0)="GETURL(URL,XT8FLG,XT8RDAT,XT8RHDR,XT8SDAT,XT8SHDR,REDIR) ;"
^XMB(3.9,146042,2,503,0)="""RTN"",""XTHC10"",102,0)"
^XMB(3.9,146042,2,504,0)=" N HOST,I,IP,IPADDR,PATH,PORT,RQS,STATUS,X"
^XMB(3.9,146042,2,505,0)="""RTN"",""XTHC10"",103,0)"
^XMB(3.9,146042,2,506,0)=" ;**P566 START CJM"
^XMB(3.9,146042,2,507,0)="""RTN"",""XTHC10"",104,0)"
^XMB(3.9,146042,2,508,0)=" N IO,POP"
^XMB(3.9,146042,2,509,0)="""RTN"",""XTHC10"",105,0)"
^XMB(3.9,146042,2,510,0)=" ;**P566 END CJM"
^XMB(3.9,146042,2,511,0)="""RTN"",""XTHC10"",106,0)"
^XMB(3.9,146042,2,512,0)=" S XT8FLG=$G(XT8FLG)  S:XT8FLG'?1.N.E XT8FLG=""5""_XT8FLG"
^XMB(3.9,146042,2,513,0)="""RTN"",""XTHC10"",107,0)"
^XMB(3.9,146042,2,514,0)=" ;"
^XMB(3.9,146042,2,515,0)="""RTN"",""XTHC10"",108,0)"
^XMB(3.9,146042,2,516,0)=" ;Check IO"
^XMB(3.9,146042,2,517,0)="""RTN"",""XTHC10"",109,0)"
^XMB(3.9,146042,2,518,0)=" I '$D(IO(0)) D HOME^%ZIS"
^XMB(3.9,146042,2,519,0)="""RTN"",""XTHC10"",110,0)"
^XMB(3.9,146042,2,520,0)=" ;=== Parse the URL"
^XMB(3.9,146042,2,521,0)="""RTN"",""XTHC10"",111,0)"
^XMB(3.9,146042,2,522,0)=" S I=$$PARSEURL^XTHCURL(URL,.HOST,.PORT,.PATH)  Q:I<0 I"
^XMB(3.9,146042,2,523,0)="""RTN"",""XTHC10"",112,0)"
^XMB(3.9,146042,2,524,0)=" ;"
^XMB(3.9,146042,2,525,0)="""RTN"",""XTHC10"",113,0)"
^XMB(3.9,146042,2,526,0)=" ;=== Check the host name/address"
^XMB(3.9,146042,2,527,0)="""RTN"",""XTHC10"",114,0)"
^XMB(3.9,146042,2,528,0)=" N ISGTM S ISGTM=^%ZOSF(""OS"")[""GT.M"" ; *LOCAL"
^XMB(3.9,146042,2,529,0)="""RTN"",""XTHC10"",115,0)"
^XMB(3.9,146042,2,530,0)=" I 'ISGTM,HOST'?1.3N3(1"".""1.3N)  D  Q:IPADDR="""" $$ERROR(2,HOST)  ; *LOCAL"
^XMB(3.9,146042,2,531,0)="""RTN"",""XTHC10"",116,0)"
^XMB(3.9,146042,2,532,0)=" . ;--- Resolve the host name into the IP address(es)"
^XMB(3.9,146042,2,533,0)="""RTN"",""XTHC10"",117,0)"
^XMB(3.9,146042,2,534,0)=" . S IPADDR=$$ADDRESS^XLFNSLK(HOST)  Q:IPADDR="""""
^XMB(3.9,146042,2,535,0)="""RTN"",""XTHC10"",118,0)"
^XMB(3.9,146042,2,536,0)=" . ;--- Check for the Host header value"
^XMB(3.9,146042,2,537,0)="""RTN"",""XTHC10"",119,0)"
^XMB(3.9,146042,2,538,0)=" . S I="""""
^XMB(3.9,146042,2,539,0)="""RTN"",""XTHC10"",120,0)"
^XMB(3.9,146042,2,540,0)=" . F  S I=$O(XT8SHDR(I))  Q:(I="""")!($$UP^XLFSTR(I)=""HOST"")"
^XMB(3.9,146042,2,541,0)="""RTN"",""XTHC10"",121,0)"
^XMB(3.9,146042,2,542,0)=" . S:I="""" XT8SHDR(""Host"")=HOST"
^XMB(3.9,146042,2,543,0)="""RTN"",""XTHC10"",122,0)"
^XMB(3.9,146042,2,544,0)=" E  S IPADDR=HOST"
^XMB(3.9,146042,2,545,0)="""RTN"",""XTHC10"",123,0)"
^XMB(3.9,146042,2,546,0)=" ;"
^XMB(3.9,146042,2,547,0)="""RTN"",""XTHC10"",124,0)"
^XMB(3.9,146042,2,548,0)=" ;=== Connect to the host"
^XMB(3.9,146042,2,549,0)="""RTN"",""XTHC10"",125,0)"
^XMB(3.9,146042,2,550,0)=" F I=1:1  S IP=$P(IPADDR,"","",I)  Q:IP=""""  D  Q:'$G(POP)"
^XMB(3.9,146042,2,551,0)="""RTN"",""XTHC10"",126,0)"
^XMB(3.9,146042,2,552,0)=" . D CALL^%ZISTCP(IP,PORT,+XT8FLG)"
^XMB(3.9,146042,2,553,0)="""RTN"",""XTHC10"",127,0)"
^XMB(3.9,146042,2,554,0)=" Q:$G(POP) $$ERROR(3,IPADDR)"
^XMB(3.9,146042,2,555,0)="""RTN"",""XTHC10"",128,0)"
^XMB(3.9,146042,2,556,0)=" ;"
^XMB(3.9,146042,2,557,0)="""RTN"",""XTHC10"",129,0)"
^XMB(3.9,146042,2,558,0)=" ;=== Perform the transaction"
^XMB(3.9,146042,2,559,0)="""RTN"",""XTHC10"",130,0)"
^XMB(3.9,146042,2,560,0)=" D"
^XMB(3.9,146042,2,561,0)="""RTN"",""XTHC10"",131,0)"
^XMB(3.9,146042,2,562,0)=" . N $ESTACK,$ETRAP"
^XMB(3.9,146042,2,563,0)="""RTN"",""XTHC10"",132,0)"
^XMB(3.9,146042,2,564,0)=" . ;--- Setup the error processing"
^XMB(3.9,146042,2,565,0)="""RTN"",""XTHC10"",133,0)"
^XMB(3.9,146042,2,566,0)=" . ;D SETDEFEH^XTERROR(""STATUS"")"
^XMB(3.9,146042,2,567,0)="""RTN"",""XTHC10"",134,0)"
^XMB(3.9,146042,2,568,0)=" . S $ET=""D ETRAP^XTHC10"""
^XMB(3.9,146042,2,569,0)="""RTN"",""XTHC10"",135,0)"
^XMB(3.9,146042,2,570,0)=" . ;--- Send the request and get the response"
^XMB(3.9,146042,2,571,0)="""RTN"",""XTHC10"",136,0)"
^XMB(3.9,146042,2,572,0)=" . S RQS=$$REQUEST^XTHC10A(PATH,$G(XT8SDAT),.XT8SHDR)"
^XMB(3.9,146042,2,573,0)="""RTN"",""XTHC10"",137,0)"
^XMB(3.9,146042,2,574,0)=" . I RQS<0  S STATUS=RQS  Q"
^XMB(3.9,146042,2,575,0)="""RTN"",""XTHC10"",138,0)"
^XMB(3.9,146042,2,576,0)=" . S STATUS=$$RECEIVE^XTHC10A(+XT8FLG,$G(XT8RDAT),.XT8RHDR)"
^XMB(3.9,146042,2,577,0)="""RTN"",""XTHC10"",139,0)"
^XMB(3.9,146042,2,578,0)=" ;"
^XMB(3.9,146042,2,579,0)="""RTN"",""XTHC10"",140,0)"
^XMB(3.9,146042,2,580,0)=" ;=== Close the socket"
^XMB(3.9,146042,2,581,0)="""RTN"",""XTHC10"",141,0)"
^XMB(3.9,146042,2,582,0)=" D CLOSE^%ZISTCP"
^XMB(3.9,146042,2,583,0)="""RTN"",""XTHC10"",142,0)"
^XMB(3.9,146042,2,584,0)=" ;"
^XMB(3.9,146042,2,585,0)="""RTN"",""XTHC10"",143,0)"
^XMB(3.9,146042,2,586,0)=" ;=== Redirect if requested by the server"
^XMB(3.9,146042,2,587,0)="""RTN"",""XTHC10"",144,0)"
^XMB(3.9,146042,2,588,0)=" S I=+STATUS"
^XMB(3.9,146042,2,589,0)="""RTN"",""XTHC10"",145,0)"
^XMB(3.9,146042,2,590,0)=" I (I\100)=3  D:$S(I=303:1,I=301:0,1:RQS=""GET"")"
^XMB(3.9,146042,2,591,0)="""RTN"",""XTHC10"",146,0)"
^XMB(3.9,146042,2,592,0)=" . I $G(REDIR)>5  S STATUS=$$ERROR(5)  Q"
^XMB(3.9,146042,2,593,0)="""RTN"",""XTHC10"",147,0)"
^XMB(3.9,146042,2,594,0)=" . S URL=$G(XT8RHDR(""LOCATION""))"
^XMB(3.9,146042,2,595,0)="""RTN"",""XTHC10"",148,0)"
^XMB(3.9,146042,2,596,0)=" . ;I URL=""""  S STATUS=$$ERROR^XTERROR(-150000.024)  Q"
^XMB(3.9,146042,2,597,0)="""RTN"",""XTHC10"",149,0)"
^XMB(3.9,146042,2,598,0)=" . I URL=""""  S STATUS=$$ERROR(4)  Q"
^XMB(3.9,146042,2,599,0)="""RTN"",""XTHC10"",150,0)"
^XMB(3.9,146042,2,600,0)=" . I RQS=""POST""  N XT8SDAT  ; Force the GET request"
^XMB(3.9,146042,2,601,0)="""RTN"",""XTHC10"",151,0)"
^XMB(3.9,146042,2,602,0)=" . S STATUS=$$GETURL(URL,XT8FLG,$G(XT8RDAT),.XT8RHDR,$G(XT8SDAT),.XT8SHDR,$G(REDIR)+1)"
^XMB(3.9,146042,2,603,0)="""RTN"",""XTHC10"",152,0)"
^XMB(3.9,146042,2,604,0)=" ;"
^XMB(3.9,146042,2,605,0)="""RTN"",""XTHC10"",153,0)"
^XMB(3.9,146042,2,606,0)=" ;=== Return the status"
^XMB(3.9,146042,2,607,0)="""RTN"",""XTHC10"",154,0)"
^XMB(3.9,146042,2,608,0)=" ;I +STATUS=-150000.004  S X=$$LASTERR^XTERROR1()  S:X STATUS=X"
^XMB(3.9,146042,2,609,0)="""RTN"",""XTHC10"",155,0)"
^XMB(3.9,146042,2,610,0)=" I +STATUS=-6 S STATUS=STATUS(""ERROR"")"
^XMB(3.9,146042,2,611,0)="""RTN"",""XTHC10"",156,0)"
^XMB(3.9,146042,2,612,0)=" Q STATUS"
^XMB(3.9,146042,2,613,0)="""RTN"",""XTHC10"",157,0)"
^XMB(3.9,146042,2,614,0)=" ;"
^XMB(3.9,146042,2,615,0)="""RTN"",""XTHC10"",158,0)"
^XMB(3.9,146042,2,616,0)="ETRAP ;Catch a runtime error"
^XMB(3.9,146042,2,617,0)="""RTN"",""XTHC10"",159,0)"
^XMB(3.9,146042,2,618,0)=" N EC"
^XMB(3.9,146042,2,619,0)="""RTN"",""XTHC10"",160,0)"
^XMB(3.9,146042,2,620,0)=" S STATUS(""ERROR"")=$$EC^%ZOSV D ^%ZTER"
^XMB(3.9,146042,2,621,0)="""RTN"",""XTHC10"",161,0)"
^XMB(3.9,146042,2,622,0)=" S STATUS=-6"
^XMB(3.9,146042,2,623,0)="""RTN"",""XTHC10"",162,0)"
^XMB(3.9,146042,2,624,0)=" I $L($EC) S $ECODE="""" S $ETRAP=""D UNW^%ZTER Q:$QUIT STATUS Q  "" S $ECODE="",U1,"""
^XMB(3.9,146042,2,625,0)="""RTN"",""XTHC10"",163,0)"
^XMB(3.9,146042,2,626,0)=" Q"
^XMB(3.9,146042,2,627,0)="""RTN"",""XTHC10"",164,0)"
^XMB(3.9,146042,2,628,0)=" ;"
^XMB(3.9,146042,2,629,0)="""RTN"",""XTHC10"",165,0)"
^XMB(3.9,146042,2,630,0)="ERROR(ENUM,PARAM) ;Expand error"
^XMB(3.9,146042,2,631,0)="""RTN"",""XTHC10"",166,0)"
^XMB(3.9,146042,2,632,0)=" N MSG"
^XMB(3.9,146042,2,633,0)="""RTN"",""XTHC10"",167,0)"
^XMB(3.9,146042,2,634,0)=" S MSG=$P($T(@ENUM),"";;"",2) S:MSG[""|"" MSG=$P(MSG,""|"")_$G(PARAM)_$P(MSG,""|"",2)"
^XMB(3.9,146042,2,635,0)="""RTN"",""XTHC10"",168,0)"
^XMB(3.9,146042,2,636,0)=" Q MSG"
^XMB(3.9,146042,2,637,0)="""RTN"",""XTHC10"",169,0)"
^XMB(3.9,146042,2,638,0)=" ;"
^XMB(3.9,146042,2,639,0)="""RTN"",""XTHC10"",170,0)"
^XMB(3.9,146042,2,640,0)="1 ;;-1^Missing host name."
^XMB(3.9,146042,2,641,0)="""RTN"",""XTHC10"",171,0)"
^XMB(3.9,146042,2,642,0)="2 ;;-1^Cannot resolve the host name: |."
^XMB(3.9,146042,2,643,0)="""RTN"",""XTHC10"",172,0)"
^XMB(3.9,146042,2,644,0)="3 ;;-1^Cannot connect to host."
^XMB(3.9,146042,2,645,0)="""RTN"",""XTHC10"",173,0)"
^XMB(3.9,146042,2,646,0)="4 ;;-1^Missing redirection URL."
^XMB(3.9,146042,2,647,0)="""RTN"",""XTHC10"",174,0)"
^XMB(3.9,146042,2,648,0)="5 ;;-1^Too many redirections."
^XMB(3.9,146042,2,649,0)="""RTN"",""XTHC10"",175,0)"
^XMB(3.9,146042,2,650,0)="6 ;;-6^Run Time Error."
^XMB(3.9,146042,2,651,0)="""RTN"",""XTHC10"",176,0)"
^XMB(3.9,146042,2,652,0)="7 ;;-1^Time Out."
^XMB(3.9,146042,2,653,0)="""RTN"",""XTHCDEM"")"
^XMB(3.9,146042,2,654,0)="0^4^B2836502"
^XMB(3.9,146042,2,655,0)="""RTN"",""XTHCDEM"",1,0)"
^XMB(3.9,146042,2,656,0)="XTHCDEM ;HCIOFO/SG - HTTP 1.0 CLIENT (DEMO) ;11/05/09  17:19"
^XMB(3.9,146042,2,657,0)="""RTN"",""XTHCDEM"",2,0)"
^XMB(3.9,146042,2,658,0)=" ;;7.3;TOOLKIT;**123**;Apr 25, 1995;Build 0"
^XMB(3.9,146042,2,659,0)="""RTN"",""XTHCDEM"",3,0)"
^XMB(3.9,146042,2,660,0)=" ;"
^XMB(3.9,146042,2,661,0)="""RTN"",""XTHCDEM"",4,0)"
^XMB(3.9,146042,2,662,0)=" ;##### DEMO ENTRY POINT"
^XMB(3.9,146042,2,663,0)="""RTN"",""XTHCDEM"",5,0)"
^XMB(3.9,146042,2,664,0)=" ;"
^XMB(3.9,146042,2,665,0)="""RTN"",""XTHCDEM"",6,0)"
^XMB(3.9,146042,2,666,0)=" ; The ^TMP($J,""XTHC"") global node is used by the entry point."
^XMB(3.9,146042,2,667,0)="""RTN"",""XTHCDEM"",7,0)"
^XMB(3.9,146042,2,668,0)=" ;"
^XMB(3.9,146042,2,669,0)="""RTN"",""XTHCDEM"",8,0)"
^XMB(3.9,146042,2,670,0)="DEMO ;"
^XMB(3.9,146042,2,671,0)="""RTN"",""XTHCDEM"",9,0)"
^XMB(3.9,146042,2,672,0)=" N BODY,DIR,DIRUT,DTOUT,DUOUT,HEADER,RC,URL,X,Y"
^XMB(3.9,146042,2,673,0)="""RTN"",""XTHCDEM"",10,0)"
^XMB(3.9,146042,2,674,0)=" S BODY=$NA(^TMP($J,""XTHC""))"
^XMB(3.9,146042,2,675,0)="""RTN"",""XTHCDEM"",11,0)"
^XMB(3.9,146042,2,676,0)=" S URL=""http://www.hardhats.org"""
^XMB(3.9,146042,2,677,0)="""RTN"",""XTHCDEM"",12,0)"
^XMB(3.9,146042,2,678,0)=" ;"
^XMB(3.9,146042,2,679,0)="""RTN"",""XTHCDEM"",13,0)"
^XMB(3.9,146042,2,680,0)=" S RC=0"
^XMB(3.9,146042,2,681,0)="""RTN"",""XTHCDEM"",14,0)"
^XMB(3.9,146042,2,682,0)=" F  D  Q:RC"
^XMB(3.9,146042,2,683,0)="""RTN"",""XTHCDEM"",15,0)"
^XMB(3.9,146042,2,684,0)=" . K @BODY,HEADER  W !"
^XMB(3.9,146042,2,685,0)="""RTN"",""XTHCDEM"",16,0)"
^XMB(3.9,146042,2,686,0)=" . ;--- Request a URL from the user"
^XMB(3.9,146042,2,687,0)="""RTN"",""XTHCDEM"",17,0)"
^XMB(3.9,146042,2,688,0)=" . K DIR  S DIR(0)=""F"""
^XMB(3.9,146042,2,689,0)="""RTN"",""XTHCDEM"",18,0)"
^XMB(3.9,146042,2,690,0)=" . S DIR(""A"")=""URL"",DIR(""B"")=URL"
^XMB(3.9,146042,2,691,0)="""RTN"",""XTHCDEM"",19,0)"
^XMB(3.9,146042,2,692,0)=" . D ^DIR  I $D(DIRUT)  S RC=1  Q"
^XMB(3.9,146042,2,693,0)="""RTN"",""XTHCDEM"",20,0)"
^XMB(3.9,146042,2,694,0)=" . S URL=$$TRIM^XLFSTR(Y)"
^XMB(3.9,146042,2,695,0)="""RTN"",""XTHCDEM"",21,0)"
^XMB(3.9,146042,2,696,0)=" . ;--- Request the resource"
^XMB(3.9,146042,2,697,0)="""RTN"",""XTHCDEM"",22,0)"
^XMB(3.9,146042,2,698,0)=" . S RC=$$GETURL^XTHC10(URL,,BODY,.HEADER)"
^XMB(3.9,146042,2,699,0)="""RTN"",""XTHCDEM"",23,0)"
^XMB(3.9,146042,2,700,0)=" . I RC<0  W !,RC S RC=0 Q  ; D PRTERRS^XTERROR1(RC)  S RC=0  Q"
^XMB(3.9,146042,2,701,0)="""RTN"",""XTHCDEM"",24,0)"
^XMB(3.9,146042,2,702,0)=" . ;--- Print the data"
^XMB(3.9,146042,2,703,0)="""RTN"",""XTHCDEM"",25,0)"
^XMB(3.9,146042,2,704,0)=" . D PRINT(BODY,.HEADER)"
^XMB(3.9,146042,2,705,0)="""RTN"",""XTHCDEM"",26,0)"
^XMB(3.9,146042,2,706,0)=" . S RC=0"
^XMB(3.9,146042,2,707,0)="""RTN"",""XTHCDEM"",27,0)"
^XMB(3.9,146042,2,708,0)=" ;"
^XMB(3.9,146042,2,709,0)="""RTN"",""XTHCDEM"",28,0)"
^XMB(3.9,146042,2,710,0)=" ;--- Cleanup"
^XMB(3.9,146042,2,711,0)="""RTN"",""XTHCDEM"",29,0)"
^XMB(3.9,146042,2,712,0)=" K @BODY"
^XMB(3.9,146042,2,713,0)="""RTN"",""XTHCDEM"",30,0)"
^XMB(3.9,146042,2,714,0)=" Q"
^XMB(3.9,146042,2,715,0)="""RTN"",""XTHCDEM"",31,0)"
^XMB(3.9,146042,2,716,0)=" ;"
^XMB(3.9,146042,2,717,0)="""RTN"",""XTHCDEM"",32,0)"
^XMB(3.9,146042,2,718,0)=" ;+++++ PRINTS THE RESPONSE"
^XMB(3.9,146042,2,719,0)="""RTN"",""XTHCDEM"",33,0)"
^XMB(3.9,146042,2,720,0)="PRINT(XTHC8DAT,HEADER) ;"
^XMB(3.9,146042,2,721,0)="""RTN"",""XTHCDEM"",34,0)"
^XMB(3.9,146042,2,722,0)=" N I,J"
^XMB(3.9,146042,2,723,0)="""RTN"",""XTHCDEM"",35,0)"
^XMB(3.9,146042,2,724,0)=" ;---"
^XMB(3.9,146042,2,725,0)="""RTN"",""XTHCDEM"",36,0)"
^XMB(3.9,146042,2,726,0)=" I $D(HEADER)>0  D  Q:$$PAGE"
^XMB(3.9,146042,2,727,0)="""RTN"",""XTHCDEM"",37,0)"
^XMB(3.9,146042,2,728,0)=" . W @IOF,""----- HTTP HEADER -----"",!!"
^XMB(3.9,146042,2,729,0)="""RTN"",""XTHCDEM"",38,0)"
^XMB(3.9,146042,2,730,0)=" . W $G(HEADER),!"
^XMB(3.9,146042,2,731,0)="""RTN"",""XTHCDEM"",39,0)"
^XMB(3.9,146042,2,732,0)=" . S I="""""
^XMB(3.9,146042,2,733,0)="""RTN"",""XTHCDEM"",40,0)"
^XMB(3.9,146042,2,734,0)=" . F  S I=$O(HEADER(I))  Q:I=""""  W I_""=""_HEADER(I),!"
^XMB(3.9,146042,2,735,0)="""RTN"",""XTHCDEM"",41,0)"
^XMB(3.9,146042,2,736,0)=" ;---"
^XMB(3.9,146042,2,737,0)="""RTN"",""XTHCDEM"",42,0)"
^XMB(3.9,146042,2,738,0)=" D:$D(@XTHC8DAT)>1"
^XMB(3.9,146042,2,739,0)="""RTN"",""XTHCDEM"",43,0)"
^XMB(3.9,146042,2,740,0)=" . W @IOF,""----- MESSAGE XTHC8DAT -----"",!!"
^XMB(3.9,146042,2,741,0)="""RTN"",""XTHCDEM"",44,0)"
^XMB(3.9,146042,2,742,0)=" . S I="""""
^XMB(3.9,146042,2,743,0)="""RTN"",""XTHCDEM"",45,0)"
^XMB(3.9,146042,2,744,0)=" . F  S I=$O(@XTHC8DAT@(I))  Q:I=""""  W @XTHC8DAT@(I)  D  W !"
^XMB(3.9,146042,2,745,0)="""RTN"",""XTHCDEM"",46,0)"
^XMB(3.9,146042,2,746,0)=" . . S J=""""  F  S J=$O(@XTHC8DAT@(I,J))  Q:J=""""  W @XTHC8DAT@(I,J)"
^XMB(3.9,146042,2,747,0)="""RTN"",""XTHCDEM"",47,0)"
^XMB(3.9,146042,2,748,0)=" Q"
^XMB(3.9,146042,2,749,0)="""RTN"",""XTHCDEM"",48,0)"
^XMB(3.9,146042,2,750,0)=" ;"
^XMB(3.9,146042,2,751,0)="""RTN"",""XTHCDEM"",49,0)"
^XMB(3.9,146042,2,752,0)="PAGE() ;Page break"
^XMB(3.9,146042,2,753,0)="""RTN"",""XTHCDEM"",50,0)"
^XMB(3.9,146042,2,754,0)=" N DIR,DIROUT,DTOUT,DUOUT"
^XMB(3.9,146042,2,755,0)="""RTN"",""XTHCDEM"",51,0)"
^XMB(3.9,146042,2,756,0)=" S DIR(0)=""E"""
^XMB(3.9,146042,2,757,0)="""RTN"",""XTHCDEM"",52,0)"
^XMB(3.9,146042,2,758,0)=" D ^DIR"
^XMB(3.9,146042,2,759,0)="""RTN"",""XTHCDEM"",53,0)"
^XMB(3.9,146042,2,760,0)=" Q $S($D(DUOUT):1,$D(DTOUT):1,1:0)"
^XMB(3.9,146042,2,761,0)="""RTN"",""XTHCDEM"",54,0)"
^XMB(3.9,146042,2,762,0)=" ;"
^XMB(3.9,146042,2,763,0)="""RTN"",""XTHCURL"")"
^XMB(3.9,146042,2,764,0)="0^2^B3579375"
^XMB(3.9,146042,2,765,0)="""RTN"",""XTHCURL"",1,0)"
^XMB(3.9,146042,2,766,0)="XTHCURL ;HCIOFO/SG - HTTP 1.0 CLIENT (URL TOOLS) ;07/29/10  14:01"
^XMB(3.9,146042,2,767,0)="""RTN"",""XTHCURL"",2,0)"
^XMB(3.9,146042,2,768,0)=" ;;7.3;TOOLKIT;**123**;Apr 25, 1995;Build 0"
^XMB(3.9,146042,2,769,0)="""RTN"",""XTHCURL"",3,0)"
^XMB(3.9,146042,2,770,0)=" ;Per VHA Directive 2004-038, this routine should not be modified"
^XMB(3.9,146042,2,771,0)="""RTN"",""XTHCURL"",4,0)"
^XMB(3.9,146042,2,772,0)=" Q"
^XMB(3.9,146042,2,773,0)="""RTN"",""XTHCURL"",5,0)"
^XMB(3.9,146042,2,774,0)=" ;"
^XMB(3.9,146042,2,775,0)="""RTN"",""XTHCURL"",6,0)"
^XMB(3.9,146042,2,776,0)=" ;***** ENCODES THE STRING"
^XMB(3.9,146042,2,777,0)="""RTN"",""XTHCURL"",7,0)"
^XMB(3.9,146042,2,778,0)=" ;"
^XMB(3.9,146042,2,779,0)="""RTN"",""XTHCURL"",8,0)"
^XMB(3.9,146042,2,780,0)=" ; STR           String to be encoded"
^XMB(3.9,146042,2,781,0)="""RTN"",""XTHCURL"",9,0)"
^XMB(3.9,146042,2,782,0)=" ;"
^XMB(3.9,146042,2,783,0)="""RTN"",""XTHCURL"",10,0)"
^XMB(3.9,146042,2,784,0)="ENCODE(STR) ;"
^XMB(3.9,146042,2,785,0)="""RTN"",""XTHCURL"",11,0)"
^XMB(3.9,146042,2,786,0)=" N CH,I"
^XMB(3.9,146042,2,787,0)="""RTN"",""XTHCURL"",12,0)"
^XMB(3.9,146042,2,788,0)=" F I=1:1  S CH=$E(STR,I)  Q:CH=""""  I CH?1CP  D"
^XMB(3.9,146042,2,789,0)="""RTN"",""XTHCURL"",13,0)"
^XMB(3.9,146042,2,790,0)=" . I CH=""."" Q"
^XMB(3.9,146042,2,791,0)="""RTN"",""XTHCURL"",14,0)"
^XMB(3.9,146042,2,792,0)=" . I CH="" ""  S $E(STR,I)=""+""  Q"
^XMB(3.9,146042,2,793,0)="""RTN"",""XTHCURL"",15,0)"
^XMB(3.9,146042,2,794,0)=" . S $E(STR,I)=""%""_$$RJ^XLFSTR($$CNV^XLFUTL($A(CH),16),2,""0""),I=I+2"
^XMB(3.9,146042,2,795,0)="""RTN"",""XTHCURL"",16,0)"
^XMB(3.9,146042,2,796,0)=" Q STR"
^XMB(3.9,146042,2,797,0)="""RTN"",""XTHCURL"",17,0)"
^XMB(3.9,146042,2,798,0)=" ;"
^XMB(3.9,146042,2,799,0)="""RTN"",""XTHCURL"",18,0)"
^XMB(3.9,146042,2,800,0)=" ;##### CREATES URL FROM COMPONENTS"
^XMB(3.9,146042,2,801,0)="""RTN"",""XTHCURL"",19,0)"
^XMB(3.9,146042,2,802,0)=" ;"
^XMB(3.9,146042,2,803,0)="""RTN"",""XTHCURL"",20,0)"
^XMB(3.9,146042,2,804,0)=" ; HOST          Host name"
^XMB(3.9,146042,2,805,0)="""RTN"",""XTHCURL"",21,0)"
^XMB(3.9,146042,2,806,0)=" ; [PORT]        Port number (80, by default)"
^XMB(3.9,146042,2,807,0)="""RTN"",""XTHCURL"",22,0)"
^XMB(3.9,146042,2,808,0)=" ; [PATH]        Resource path (""/"", by default)"
^XMB(3.9,146042,2,809,0)="""RTN"",""XTHCURL"",23,0)"
^XMB(3.9,146042,2,810,0)=" ;"
^XMB(3.9,146042,2,811,0)="""RTN"",""XTHCURL"",24,0)"
^XMB(3.9,146042,2,812,0)=" ; [.QUERY]      Reference to a local variable containing values of"
^XMB(3.9,146042,2,813,0)="""RTN"",""XTHCURL"",25,0)"
^XMB(3.9,146042,2,814,0)=" ;               the query parameters: QUERY(Name)=Value."
^XMB(3.9,146042,2,815,0)="""RTN"",""XTHCURL"",26,0)"
^XMB(3.9,146042,2,816,0)=" ;"
^XMB(3.9,146042,2,817,0)="""RTN"",""XTHCURL"",27,0)"
^XMB(3.9,146042,2,818,0)=" ; Return values:"
^XMB(3.9,146042,2,819,0)="""RTN"",""XTHCURL"",28,0)"
^XMB(3.9,146042,2,820,0)=" ;           <0  Error Descriptor"
^XMB(3.9,146042,2,821,0)="""RTN"",""XTHCURL"",29,0)"
^XMB(3.9,146042,2,822,0)=" ;          ...  Resulting URL"
^XMB(3.9,146042,2,823,0)="""RTN"",""XTHCURL"",30,0)"
^XMB(3.9,146042,2,824,0)=" ;"
^XMB(3.9,146042,2,825,0)="""RTN"",""XTHCURL"",31,0)"
^XMB(3.9,146042,2,826,0)="MAKEURL(HOST,PORT,PATH,QUERY) ;"
^XMB(3.9,146042,2,827,0)="""RTN"",""XTHCURL"",32,0)"
^XMB(3.9,146042,2,828,0)=" N NAME,QSTR,VAL"
^XMB(3.9,146042,2,829,0)="""RTN"",""XTHCURL"",33,0)"
^XMB(3.9,146042,2,830,0)=" S:HOST'[""://"" HOST=""http://""_HOST"
^XMB(3.9,146042,2,831,0)="""RTN"",""XTHCURL"",34,0)"
^XMB(3.9,146042,2,832,0)=" S PORT=$S($G(PORT)>0:"":""_(+PORT),1:"""")"
^XMB(3.9,146042,2,833,0)="""RTN"",""XTHCURL"",35,0)"
^XMB(3.9,146042,2,834,0)=" ;---"
^XMB(3.9,146042,2,835,0)="""RTN"",""XTHCURL"",36,0)"
^XMB(3.9,146042,2,836,0)=" S (NAME,QSTR)="""""
^XMB(3.9,146042,2,837,0)="""RTN"",""XTHCURL"",37,0)"
^XMB(3.9,146042,2,838,0)=" F  S NAME=$O(QUERY(NAME))  Q:NAME=""""  D"
^XMB(3.9,146042,2,839,0)="""RTN"",""XTHCURL"",38,0)"
^XMB(3.9,146042,2,840,0)=" . S VAL=$G(QUERY(NAME))"
^XMB(3.9,146042,2,841,0)="""RTN"",""XTHCURL"",39,0)"
^XMB(3.9,146042,2,842,0)=" . S QSTR=QSTR_""&""_$$ENCODE(NAME)_""=""_$$ENCODE(VAL)"
^XMB(3.9,146042,2,843,0)="""RTN"",""XTHCURL"",40,0)"
^XMB(3.9,146042,2,844,0)=" S:QSTR'="""" $E(QSTR,1)=""?"""
^XMB(3.9,146042,2,845,0)="""RTN"",""XTHCURL"",41,0)"
^XMB(3.9,146042,2,846,0)=" ;---"
^XMB(3.9,146042,2,847,0)="""RTN"",""XTHCURL"",42,0)"
^XMB(3.9,146042,2,848,0)=" S:$G(PATH)="""" PATH=""/"""
^XMB(3.9,146042,2,849,0)="""RTN"",""XTHCURL"",43,0)"
^XMB(3.9,146042,2,850,0)=" Q HOST_PORT_$$NORMPATH($G(PATH)_QSTR)"
^XMB(3.9,146042,2,851,0)="""RTN"",""XTHCURL"",44,0)"
^XMB(3.9,146042,2,852,0)=" ;"
^XMB(3.9,146042,2,853,0)="""RTN"",""XTHCURL"",45,0)"
^XMB(3.9,146042,2,854,0)=" ;##### RETURNS ""NORMALIZED"" PATH"
^XMB(3.9,146042,2,855,0)="""RTN"",""XTHCURL"",46,0)"
^XMB(3.9,146042,2,856,0)=" ;"
^XMB(3.9,146042,2,857,0)="""RTN"",""XTHCURL"",47,0)"
^XMB(3.9,146042,2,858,0)=" ; PATH          Source path"
^XMB(3.9,146042,2,859,0)="""RTN"",""XTHCURL"",48,0)"
^XMB(3.9,146042,2,860,0)=" ;"
^XMB(3.9,146042,2,861,0)="""RTN"",""XTHCURL"",49,0)"
^XMB(3.9,146042,2,862,0)="NORMPATH(PATH) ;"
^XMB(3.9,146042,2,863,0)="""RTN"",""XTHCURL"",50,0)"
^XMB(3.9,146042,2,864,0)=" N LAST"
^XMB(3.9,146042,2,865,0)="""RTN"",""XTHCURL"",51,0)"
^XMB(3.9,146042,2,866,0)=" ;--- Make sure the path has a leading slash if it"
^XMB(3.9,146042,2,867,0)="""RTN"",""XTHCURL"",52,0)"
^XMB(3.9,146042,2,868,0)=" ;--- is not empty and has no query string"
^XMB(3.9,146042,2,869,0)="""RTN"",""XTHCURL"",53,0)"
^XMB(3.9,146042,2,870,0)=" I $E(PATH,1)'=""/""  S:$E(PATH,1)'=""?"" PATH=""/""_PATH"
^XMB(3.9,146042,2,871,0)="""RTN"",""XTHCURL"",54,0)"
^XMB(3.9,146042,2,872,0)=" ;--- Append a trailing slash to the path if it has"
^XMB(3.9,146042,2,873,0)="""RTN"",""XTHCURL"",55,0)"
^XMB(3.9,146042,2,874,0)=" ;--- neither a file name nor a query string"
^XMB(3.9,146042,2,875,0)="""RTN"",""XTHCURL"",56,0)"
^XMB(3.9,146042,2,876,0)=" S LAST=$L(PATH,""/""),LAST=$P(PATH,""/"",LAST)"
^XMB(3.9,146042,2,877,0)="""RTN"",""XTHCURL"",57,0)"
^XMB(3.9,146042,2,878,0)=" I LAST'="""",LAST'[""?"",LAST'["".""  S PATH=PATH_""/"""
^XMB(3.9,146042,2,879,0)="""RTN"",""XTHCURL"",58,0)"
^XMB(3.9,146042,2,880,0)=" Q PATH"
^XMB(3.9,146042,2,881,0)="""RTN"",""XTHCURL"",59,0)"
^XMB(3.9,146042,2,882,0)=" ;"
^XMB(3.9,146042,2,883,0)="""RTN"",""XTHCURL"",60,0)"
^XMB(3.9,146042,2,884,0)=" ;##### PARSES THE URL INTO COMPONENTS"
^XMB(3.9,146042,2,885,0)="""RTN"",""XTHCURL"",61,0)"
^XMB(3.9,146042,2,886,0)=" ;"
^XMB(3.9,146042,2,887,0)="""RTN"",""XTHCURL"",62,0)"
^XMB(3.9,146042,2,888,0)=" ; URL           Source URL"
^XMB(3.9,146042,2,889,0)="""RTN"",""XTHCURL"",63,0)"
^XMB(3.9,146042,2,890,0)=" ;"
^XMB(3.9,146042,2,891,0)="""RTN"",""XTHCURL"",64,0)"
^XMB(3.9,146042,2,892,0)=" ; .HOST         Reference to a local variable for the host name"
^XMB(3.9,146042,2,893,0)="""RTN"",""XTHCURL"",65,0)"
^XMB(3.9,146042,2,894,0)=" ; .PORT         Reference to a local variable for the port number"
^XMB(3.9,146042,2,895,0)="""RTN"",""XTHCURL"",66,0)"
^XMB(3.9,146042,2,896,0)=" ; .PATH         Reference to a local variable for the path"
^XMB(3.9,146042,2,897,0)="""RTN"",""XTHCURL"",67,0)"
^XMB(3.9,146042,2,898,0)=" ;"
^XMB(3.9,146042,2,899,0)="""RTN"",""XTHCURL"",68,0)"
^XMB(3.9,146042,2,900,0)=" ; Return values:"
^XMB(3.9,146042,2,901,0)="""RTN"",""XTHCURL"",69,0)"
^XMB(3.9,146042,2,902,0)=" ;           <0  Error Descriptor"
^XMB(3.9,146042,2,903,0)="""RTN"",""XTHCURL"",70,0)"
^XMB(3.9,146042,2,904,0)=" ;            0  Ok"
^XMB(3.9,146042,2,905,0)="""RTN"",""XTHCURL"",71,0)"
^XMB(3.9,146042,2,906,0)=" ;"
^XMB(3.9,146042,2,907,0)="""RTN"",""XTHCURL"",72,0)"
^XMB(3.9,146042,2,908,0)="PARSEURL(URL,HOST,PORT,PATH) ;"
^XMB(3.9,146042,2,909,0)="""RTN"",""XTHCURL"",73,0)"
^XMB(3.9,146042,2,910,0)=" S:$F(URL,""://"") URL=$P(URL,""://"",2,999)"
^XMB(3.9,146042,2,911,0)="""RTN"",""XTHCURL"",74,0)"
^XMB(3.9,146042,2,912,0)=" S HOST=$TR($P(URL,""/""),"" "")"
^XMB(3.9,146042,2,913,0)="""RTN"",""XTHCURL"",75,0)"
^XMB(3.9,146042,2,914,0)=" S PATH=$$NORMPATH($P(URL,""/"",2,999))"
^XMB(3.9,146042,2,915,0)="""RTN"",""XTHCURL"",76,0)"
^XMB(3.9,146042,2,916,0)=" S PORT=$P(HOST,"":"",2),HOST=$P(HOST,"":"")"
^XMB(3.9,146042,2,917,0)="""RTN"",""XTHCURL"",77,0)"
^XMB(3.9,146042,2,918,0)=" Q:HOST?."" "" $$ERROR^XTHC10(1,URL)"
^XMB(3.9,146042,2,919,0)="""RTN"",""XTHCURL"",78,0)"
^XMB(3.9,146042,2,920,0)=" S:PORT'>0 PORT=80"
^XMB(3.9,146042,2,921,0)="""RTN"",""XTHCURL"",79,0)"
^XMB(3.9,146042,2,922,0)=" Q 0"
^XMB(3.9,146042,2,923,0)="""RTN"",""XTHCUTL"")"
^XMB(3.9,146042,2,924,0)="0^3^B3432229"
^XMB(3.9,146042,2,925,0)="""RTN"",""XTHCUTL"",1,0)"
^XMB(3.9,146042,2,926,0)="XTHCUTL ;ISF/RWF - HTTP 1.0 CLIENT Utilities ;11/10/09  15:12"
^XMB(3.9,146042,2,927,0)="""RTN"",""XTHCUTL"",2,0)"
^XMB(3.9,146042,2,928,0)=" ;;7.3;TOOLKIT;**123**;;Build 0"
^XMB(3.9,146042,2,929,0)="""RTN"",""XTHCUTL"",3,0)"
^XMB(3.9,146042,2,930,0)=" Q"
^XMB(3.9,146042,2,931,0)="""RTN"",""XTHCUTL"",4,0)"
^XMB(3.9,146042,2,932,0)=" ;<LI>  <A HREF=""#Payroll_&_Personnel"" TITLE=""Payroll & Personnel Links"">Payroll &amp;  Personnel</A> </LI>"
^XMB(3.9,146042,2,933,0)="""RTN"",""XTHCUTL"",5,0)"
^XMB(3.9,146042,2,934,0)=" ;"
^XMB(3.9,146042,2,935,0)="""RTN"",""XTHCUTL"",6,0)"
^XMB(3.9,146042,2,936,0)="DECODE(STR) ;DeCode a string &#32="" "", &lt;=<, &gt;=>, &nbsp;="" """
^XMB(3.9,146042,2,937,0)="""RTN"",""XTHCUTL"",7,0)"
^XMB(3.9,146042,2,938,0)=" N I,J"
^XMB(3.9,146042,2,939,0)="""RTN"",""XTHCUTL"",8,0)"
^XMB(3.9,146042,2,940,0)=" S I=0"
^XMB(3.9,146042,2,941,0)="""RTN"",""XTHCUTL"",9,0)"
^XMB(3.9,146042,2,942,0)=" F  S I=$F(STR,""&"",I) Q:'I  S J=$P($E(STR,I,I+5),"";""),J=$$LOW^XLFSTR(J),K=$S(J=""nbsp"":"" "",J=""lt"":""<"",J=""gt"":"">"",J=""amp"":""&"",J=""apos"":""'"",J=""quot"":"""""""",$E(J)=""#"":$E(J,2,4),1:"""") D:$L(K)"
^XMB(3.9,146042,2,943,0)="""RTN"",""XTHCUTL"",10,0)"
^XMB(3.9,146042,2,944,0)=" . I +K S K=$C(+K) ;&#65; The decimal value in ISO-latin-1 for A"
^XMB(3.9,146042,2,945,0)="""RTN"",""XTHCUTL"",11,0)"
^XMB(3.9,146042,2,946,0)=" . S STR=$E(STR,1,I-2)_K_$E(STR,I+$L(J)+1,$L(STR))"
^XMB(3.9,146042,2,947,0)="""RTN"",""XTHCUTL"",12,0)"
^XMB(3.9,146042,2,948,0)=" Q STR"
^XMB(3.9,146042,2,949,0)="""RTN"",""XTHCUTL"",13,0)"
^XMB(3.9,146042,2,950,0)=" ;"
^XMB(3.9,146042,2,951,0)="""RTN"",""XTHCUTL"",14,0)"
^XMB(3.9,146042,2,952,0)="UNHEX(HH) ;function - decode one pair of hex digits to ASCII char"
^XMB(3.9,146042,2,953,0)="""RTN"",""XTHCUTL"",15,0)"
^XMB(3.9,146042,2,954,0)=" S HH=$TR(HH,""abcdef"",""ABCDEF"")"
^XMB(3.9,146042,2,955,0)="""RTN"",""XTHCUTL"",16,0)"
^XMB(3.9,146042,2,956,0)=" I $TR(HH,""0123456789ABCDEF"")'="""" Q ""???"" ;-- error - bad hex code --;"
^XMB(3.9,146042,2,957,0)="""RTN"",""XTHCUTL"",17,0)"
^XMB(3.9,146042,2,958,0)=" S HH=$TR(HH,""ABCDEF"","":;<=>?"")"
^XMB(3.9,146042,2,959,0)="""RTN"",""XTHCUTL"",18,0)"
^XMB(3.9,146042,2,960,0)=" Q $C($$UNHEXD($E(HH,1))*16+$$UNHEXD($E(HH,2)))"
^XMB(3.9,146042,2,961,0)="""RTN"",""XTHCUTL"",19,0)"
^XMB(3.9,146042,2,962,0)=" ;"
^XMB(3.9,146042,2,963,0)="""RTN"",""XTHCUTL"",20,0)"
^XMB(3.9,146042,2,964,0)="UNHEXD(X) ;function - convert hex digit back to decimal"
^XMB(3.9,146042,2,965,0)="""RTN"",""XTHCUTL"",21,0)"
^XMB(3.9,146042,2,966,0)=" Q $A(X)-48"
^XMB(3.9,146042,2,967,0)="""RTN"",""XTHCUTL"",22,0)"
^XMB(3.9,146042,2,968,0)=" ;"
^XMB(3.9,146042,2,969,0)="""RTN"",""XTHCUTL"",23,0)"
^XMB(3.9,146042,2,970,0)="QUOTE ;"
^XMB(3.9,146042,2,971,0)="""RTN"",""XTHCUTL"",24,0)"
^XMB(3.9,146042,2,972,0)=" F I=I+1:1 S CH=$E(STR,I) Q:CH=""""!(CH=Q)"
^XMB(3.9,146042,2,973,0)="""RTN"",""XTHCUTL"",25,0)"
^XMB(3.9,146042,2,974,0)=" I $E(STR,I+1)=Q S I=I+1 G QUOTE"
^XMB(3.9,146042,2,975,0)="""RTN"",""XTHCUTL"",26,0)"
^XMB(3.9,146042,2,976,0)=" Q"
^XMB(3.9,146042,2,977,0)="""RTN"",""XTHCUTL"",27,0)"
^XMB(3.9,146042,2,978,0)=" ;"
^XMB(3.9,146042,2,979,0)="""RTN"",""XTHCUTL"",28,0)"
^XMB(3.9,146042,2,980,0)="TEST ;Unit Tests"
^XMB(3.9,146042,2,981,0)="""RTN"",""XTHCUTL"",29,0)"
^XMB(3.9,146042,2,982,0)=" S STR=""[&#32;&lt;&amp;&quot;&apos;&gt;&nbsp;]&#109;"" I $$DECODE(STR)'=""[ <&""""'> ]m"" W !,""Fail: "",STR"
