^XMB(3.9,146054,2,421,0)="""RTN"",""XQARPRT2"",90,0)"
^XMB(3.9,146054,2,422,0)=" Q"
^XMB(3.9,146054,2,423,0)="""RTN"",""XQARPRT2"",91,0)"
^XMB(3.9,146054,2,424,0)=" ;"
^XMB(3.9,146054,2,425,0)="""RTN"",""XQARPRT2"",92,0)"
^XMB(3.9,146054,2,426,0)="HEADER(XQANAME,DOFF) ; Output header at start of report XQANAME indicates who report is for"
^XMB(3.9,146054,2,427,0)="""RTN"",""XQARPRT2"",93,0)"
^XMB(3.9,146054,2,428,0)=" IF '$D(ZTQUEUED) W:DOFF @IOF ; XU*8*690 - Remove initial FormFeed when queued to task job (Printer)"
^XMB(3.9,146054,2,429,0)="""RTN"",""XQARPRT2"",94,0)"
^XMB(3.9,146054,2,430,0)=" W:'DOFF ! W $S('DOFF:""Found ""_XQATOT_"" "",1:""""),$S($D(XQAWORDS)>1:""Selected "",1:""""),""Alerts for "",XQANAME,!,""  for dates "",$$FMTE^XLFDT(XQASDATE),"" through """
^XMB(3.9,146054,2,431,0)="""RTN"",""XQARPRT2"",95,0)"
^XMB(3.9,146054,2,432,0)=" N OUTDATE S OUTDATE=$$FMTE^XLFDT(XQAEDATE,""D"") I 'DOFF,$D(XQADATE),XQADATE<XQAEDATE,'$D(ZTQUEUED) S OUTDATE=$$FMTE^XLFDT(XQADATE)"
^XMB(3.9,146054,2,433,0)="""RTN"",""XQARPRT2"",96,0)"
^XMB(3.9,146054,2,434,0)=" W OUTDATE S XQACTR=2"
^XMB(3.9,146054,2,435,0)="""RTN"",""XQARPRT2"",97,0)"
^XMB(3.9,146054,2,436,0)=" D WORDHDR"
^XMB(3.9,146054,2,437,0)="""RTN"",""XQARPRT2"",98,0)"
^XMB(3.9,146054,2,438,0)=" W ! S XQACTR=XQACTR+1"
^XMB(3.9,146054,2,439,0)="""RTN"",""XQARPRT2"",99,0)"
^XMB(3.9,146054,2,440,0)=" S XQATOT=0"
^XMB(3.9,146054,2,441,0)="""RTN"",""XQARPRT2"",100,0)"
^XMB(3.9,146054,2,442,0)=" Q"
^XMB(3.9,146054,2,443,0)="""RTN"",""XQARPRT2"",101,0)"
^XMB(3.9,146054,2,444,0)=" ;"
^XMB(3.9,146054,2,445,0)="""RTN"",""XQARPRT2"",102,0)"
^XMB(3.9,146054,2,446,0)="WORDHDR ;"
^XMB(3.9,146054,2,447,0)="""RTN"",""XQARPRT2"",103,0)"
^XMB(3.9,146054,2,448,0)=" N I,J"
^XMB(3.9,146054,2,449,0)="""RTN"",""XQARPRT2"",104,0)"
^XMB(3.9,146054,2,450,0)=" F I=0:0 S I=$O(XQAWORDS(I)) Q:I'>0  W:I>1 !?10,""--- OR ---"" D"
^XMB(3.9,146054,2,451,0)="""RTN"",""XQARPRT2"",105,0)"
^XMB(3.9,146054,2,452,0)=" . F J=0:0 S J=$O(XQAWORDS(I,J)) Q:J'>0  W !?5,$S(J=1:""Selected alerts containing:"",1:""            and containing:""),?35,XQAWORDS(I,J) S XQACTR=XQACTR+1"
^XMB(3.9,146054,2,453,0)="""RTN"",""XQARPRT2"",106,0)"
