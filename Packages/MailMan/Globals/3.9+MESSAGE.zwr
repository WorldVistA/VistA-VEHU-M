^XMB(3.9,146089,2,1726,0)=" .Q:$G(POERR(""QFLG""))"
^XMB(3.9,146089,2,1727,0)="""RTN"",""PSOORFIN"",81,0)"
^XMB(3.9,146089,2,1728,0)=" .D KQ F  S ORD=$O(^PS(52.41,""AC"",PAT,""M"",ORD)) Q:'ORD!($G(POERR(""QFLG"")))  D:$P(^PS(52.41,ORD,0),""^"",3)'=""DC""&($P(^(0),""^"",3)'=""DE"") LK1,ORD"
^XMB(3.9,146089,2,1729,0)="""RTN"",""PSOORFIN"",82,0)"
^XMB(3.9,146089,2,1730,0)=" .Q:$G(POERR(""QFLG""))"
^XMB(3.9,146089,2,1731,0)="""RTN"",""PSOORFIN"",83,0)"
^XMB(3.9,146089,2,1732,0)=" .D KQ F  S ORD=$O(^PS(52.41,""AC"",PAT,""C"",ORD)) Q:'ORD!($G(POERR(""QFLG"")))  D:$P(^PS(52.41,ORD,0),""^"",3)'=""DC""&($P(^(0),""^"",3)'=""DE"") LK1,ORD"
^XMB(3.9,146089,2,1733,0)="""RTN"",""PSOORFIN"",84,0)"
^XMB(3.9,146089,2,1734,0)=" Q"
^XMB(3.9,146089,2,1735,0)="""RTN"",""PSOORFIN"",85,0)"
^XMB(3.9,146089,2,1736,0)="PAT W ! K MEDP,MEDA,POERR(""DFLG""),DIR D KQ S PSOSORT=""PATIENT"""
^XMB(3.9,146089,2,1737,0)="""RTN"",""PSOORFIN"",86,0)"
^XMB(3.9,146089,2,1738,0)=" S DIR(""?"")=""^D PT^PSOORFI1"",DIR(""A"")=""All Patients or Single Patient"",DIR(0)=""SBM^A:ALL;S:SINGLE;E:EXIT"",DIR(""B"")=""SINGLE"""
^XMB(3.9,146089,2,1739,0)="""RTN"",""PSOORFIN"",87,0)"
^XMB(3.9,146089,2,1740,0)=" D ^DIR K DIR I $D(DIRUT)!(Y=""E"") G EX"
^XMB(3.9,146089,2,1741,0)="""RTN"",""PSOORFIN"",88,0)"
^XMB(3.9,146089,2,1742,0)=" I Y=""S"" S PSOSORT=PSOSORT_""^""_""SINGLE"" G SPAT"
^XMB(3.9,146089,2,1743,0)="""RTN"",""PSOORFIN"",89,0)"
^XMB(3.9,146089,2,1744,0)="ALLPATS ; All Patient Processing"
^XMB(3.9,146089,2,1745,0)="""RTN"",""PSOORFIN"",90,0)"
^XMB(3.9,146089,2,1746,0)=" S PSOSORT=PSOSORT_""^ALL"",(MEDA,MEDP)=1 K POERR(""DFLG""),DIR D KQ S PSOSORT=""PATIENT"""
^XMB(3.9,146089,2,1747,0)="""RTN"",""PSOORFIN"",91,0)"
^XMB(3.9,146089,2,1748,0)=" N PAT,PATA,SECSORT,WPT,WPPAT,WPPATS,DIR,DUOUT,DIROUT,DTOUT,DIRUT,PSOQUIT,ERXIEN,EPATLCK,EPATIEN"
^XMB(3.9,146089,2,1749,0)="""RTN"",""PSOORFIN"",92,0)"
^XMB(3.9,146089,2,1750,0)=" I '$D(^XUSEC(""PSO ERX WORKLOAD RPH"",DUZ)) S SECSORT=$$DIR^PSOORFI6(""PA:PATIENT"",Y) I SECSORT=""^"" Q"
^XMB(3.9,146089,2,1751,0)="""RTN"",""PSOORFIN"",93,0)"
^XMB(3.9,146089,2,1752,0)=" I $D(^XUSEC(""PSO ERX WORKLOAD RPH"",DUZ)) D  I $G(PSOQUIT) G EX"
^XMB(3.9,146089,2,1753,0)="""RTN"",""PSOORFIN"",94,0)"
^XMB(3.9,146089,2,1754,0)=" . W ! K DIR S DIR(""A"")=""Process FLAGGED orders only? "",DIR(0)=""YA"",DIR(""B"")=""NO"""
^XMB(3.9,146089,2,1755,0)="""RTN"",""PSOORFIN"",95,0)"
^XMB(3.9,146089,2,1756,0)=" . D ^DIR I $G(DUOUT)!$G(DIROUT)!$G(DTOUT)!$G(DIRUT) S PSOQUIT=1"
^XMB(3.9,146089,2,1757,0)="""RTN"",""PSOORFIN"",96,0)"
^XMB(3.9,146089,2,1758,0)=" . S SECSORT=0 I $G(Y) S SECSORT=""FL^FLAGGED^FLAGGED"""
^XMB(3.9,146089,2,1759,0)="""RTN"",""PSOORFIN"",97,0)"
^XMB(3.9,146089,2,1760,0)=" ;Cleaning up Workload Processing Patient List and setting 'tagged' patient to user"
^XMB(3.9,146089,2,1761,0)="""RTN"",""PSOORFIN"",98,0)"
^XMB(3.9,146089,2,1762,0)=" S WPPAT=0,WPT=0 F  S WPT=$O(^XTMP(""PSOORWP"",PSOCLIN,WPT)) Q:'WPT  D"
^XMB(3.9,146089,2,1763,0)="""RTN"",""PSOORFIN"",99,0)"
^XMB(3.9,146089,2,1764,0)=" . I '$$HASACTPO^PSOORUT3(WPT) K ^XTMP(""PSOORWP"",PSOCLIN,WPT) Q"
^XMB(3.9,146089,2,1765,0)="""RTN"",""PSOORFIN"",100,0)"
^XMB(3.9,146089,2,1766,0)=" . I $D(^XTMP(""PSOORWP"",PSOCLIN,WPT,DUZ)),'$D(WPPAT(PSOCLIN)) S WPPAT(PSOCLIN)=WPT"
^XMB(3.9,146089,2,1767,0)="""RTN"",""PSOORFIN"",101,0)"
^XMB(3.9,146089,2,1768,0)=" S (LG,PATA)=0"
^XMB(3.9,146089,2,1769,0)="""RTN"",""PSOORFIN"",102,0)"
^XMB(3.9,146089,2,1770,0)=" F  S LG=$O(^PS(52.41,""AD"",LG)) Q:'LG  D  I $G(POERR(""QFLG"")) Q"
^XMB(3.9,146089,2,1771,0)="""RTN"",""PSOORFIN"",103,0)"
^XMB(3.9,146089,2,1772,0)=" . F PSOD=0:0 S PSOD=$O(^PS(52.41,""AD"",LG,PSOPINST,PSOD)) Q:'PSOD  D  I $G(POERR(""QFLG"")) Q"
^XMB(3.9,146089,2,1773,0)="""RTN"",""PSOORFIN"",104,0)"
^XMB(3.9,146089,2,1774,0)=" . . Q:'$D(^PS(52.41,PSOD,0))"
^XMB(3.9,146089,2,1775,0)="""RTN"",""PSOORFIN"",105,0)"
^XMB(3.9,146089,2,1776,0)=" . . I '$D(^XUSEC(""PSO ERX WORKLOAD RPH"",DUZ)),$P($G(^PS(52.41,PSOD,0)),""^"",23),$P(SECSORT,""^"",1)'=""FL"" Q"
^XMB(3.9,146089,2,1777,0)="""RTN"",""PSOORFIN"",106,0)"
^XMB(3.9,146089,2,1778,0)=" . . I "" DE DC""[$$GET1^DIQ(52.41,PSOD,2,""I"") Q"
^XMB(3.9,146089,2,1779,0)="""RTN"",""PSOORFIN"",107,0)"
^XMB(3.9,146089,2,1780,0)=" . . Q:$G(PAT($P(^PS(52.41,PSOD,0),""^"",2)))  ; Patient already marked to be skipped"
^XMB(3.9,146089,2,1781,0)="""RTN"",""PSOORFIN"",108,0)"
^XMB(3.9,146089,2,1782,0)=" . . I $D(^XUSEC(""PSO ERX WORKLOAD RPH"",DUZ)),$G(PSOCLIN)'=$$GET1^DIQ(52.41,PSOD,1.1,""I"") Q"
^XMB(3.9,146089,2,1783,0)="""RTN"",""PSOORFIN"",109,0)"
^XMB(3.9,146089,2,1784,0)=" . . S PAT=+$P(^PS(52.41,PSOD,0),""^"",2)"
^XMB(3.9,146089,2,1785,0)="""RTN"",""PSOORFIN"",110,0)"
^XMB(3.9,146089,2,1786,0)=" . . ; Patient assigned/tagged to another user"
^XMB(3.9,146089,2,1787,0)="""RTN"",""PSOORFIN"",111,0)"
^XMB(3.9,146089,2,1788,0)=" . . I SECSORT'=""FL^FLAGGED^FLAGGED"",$D(^XTMP(""PSOORWP"",PSOCLIN,PAT)),'$D(^XTMP(""PSOORWP"",PSOCLIN,PAT,DUZ)) S PAT(PAT)=PAT Q"
^XMB(3.9,146089,2,1789,0)="""RTN"",""PSOORFIN"",112,0)"
^XMB(3.9,146089,2,1790,0)=" . . I SECSORT'=""FL^FLAGGED^FLAGGED"",$D(^XUSEC(""PSO ERX WORKLOAD RPH"",DUZ)),'$$HASACTPO^PSOORUT3(PAT) S PAT(PAT)=PAT Q"
^XMB(3.9,146089,2,1791,0)="""RTN"",""PSOORFIN"",113,0)"
^XMB(3.9,146089,2,1792,0)=" . . ; MbM only: Checking whether the eRx Patient is locked on the eRx Holding Queue, if so, skip record"
^XMB(3.9,146089,2,1793,0)="""RTN"",""PSOORFIN"",114,0)"
^XMB(3.9,146089,2,1794,0)=" . . S ERXIEN=$$ERXIEN^PSOERXUT(PSOD_""P"")"
^XMB(3.9,146089,2,1795,0)="""RTN"",""PSOORFIN"",115,0)"
^XMB(3.9,146089,2,1796,0)=" . . I $$GET1^DIQ(59.7,1,102,""I"")=""MBM"",ERXIEN D  I $G(EPATLCK) S PAT(PAT)=PAT Q"
^XMB(3.9,146089,2,1797,0)="""RTN"",""PSOORFIN"",116,0)"
^XMB(3.9,146089,2,1798,0)=" . . . S EPATLCK=0,EPATIEN=+$$GET1^DIQ(52.49,ERXIEN,.04,""I"") I 'EPATIEN Q"
^XMB(3.9,146089,2,1799,0)="""RTN"",""PSOORFIN"",117,0)"
^XMB(3.9,146089,2,1800,0)=" . . . I $$L^PSOERX1A(EPATIEN,1,1) D"
^XMB(3.9,146089,2,1801,0)="""RTN"",""PSOORFIN"",118,0)"
^XMB(3.9,146089,2,1802,0)=" . . . . D UL^PSOERX1A(EPATIEN)"
^XMB(3.9,146089,2,1803,0)="""RTN"",""PSOORFIN"",119,0)"
^XMB(3.9,146089,2,1804,0)=" . . . E  I +$G(^XTMP(""PSOERXLOCK"",EPATIEN))'=DUZ S EPATLCK=1 I $G(WPPAT(+PSOCLIN))=PAT K WPPAT(+PSOCLIN)"
^XMB(3.9,146089,2,1805,0)="""RTN"",""PSOORFIN"",120,0)"
^XMB(3.9,146089,2,1806,0)=" . . ;Secondary sort filter"
^XMB(3.9,146089,2,1807,0)="""RTN"",""PSOORFIN"",121,0)"
^XMB(3.9,146089,2,1808,0)=" . . I SECSORT'=0,'$$CHKFLTR^PSOORFI6(PSOD,SECSORT) Q"
^XMB(3.9,146089,2,1809,0)="""RTN"",""PSOORFIN"",122,0)"
^XMB(3.9,146089,2,1810,0)=" . . ;Workload Processing - Patient assigned to another Rph | Forced 'tagged' patient on User"
^XMB(3.9,146089,2,1811,0)="""RTN"",""PSOORFIN"",123,0)"
^XMB(3.9,146089,2,1812,0)=" . . I SECSORT'=""FL^FLAGGED^FLAGGED"",$D(^XUSEC(""PSO ERX WORKLOAD RPH"",DUZ)),$G(WPPAT(+PSOCLIN)),WPPAT(PSOCLIN)'=PAT Q"
^XMB(3.9,146089,2,1813,0)="""RTN"",""PSOORFIN"",124,0)"
^XMB(3.9,146089,2,1814,0)=" . . I SECSORT'=""FL^FLAGGED^FLAGGED"",$G(WPPAT(+PSOCLIN)) S PAT=$G(WPPAT(+PSOCLIN))"
^XMB(3.9,146089,2,1815,0)="""RTN"",""PSOORFIN"",125,0)"
^XMB(3.9,146089,2,1816,0)=" . . ;PSO*7*266"
^XMB(3.9,146089,2,1817,0)="""RTN"",""PSOORFIN"",126,0)"
^XMB(3.9,146089,2,1818,0)=" . . I PAT'=PATA D LBL"
^XMB(3.9,146089,2,1819,0)="""RTN"",""PSOORFIN"",127,0)"
^XMB(3.9,146089,2,1820,0)=" . . D LK I $G(POERR(""QFLG"")),$D(^XUSEC(""PSO ERX WORKLOAD RPH"",DUZ)),+$G(WPPAT(+PSOCLIN))=PAT K POERR(""QFLG"")"
^XMB(3.9,146089,2,1821,0)="""RTN"",""PSOORFIN"",128,0)"
^XMB(3.9,146089,2,1822,0)=" . . I $G(POERR(""QFLG"")) K POERR(""QFLG"") S PSOLK=1,PAT(PAT)=PAT Q"
^XMB(3.9,146089,2,1823,0)="""RTN"",""PSOORFIN"",129,0)"
^XMB(3.9,146089,2,1824,0)=" . . S PSONOLCK=0 I $G(PSOERR(""QFLG"")) K POERR(""QFLG"") S PSONOLCK=1"
^XMB(3.9,146089,2,1825,0)="""RTN"",""PSOORFIN"",130,0)"
^XMB(3.9,146089,2,1826,0)=" . . I $$CHK^PSODPT(PAT_""^""_$P($G(^DPT(PAT,0)),""^""),1,1)<0 S PSOLK=1,PAT(PAT)=PAT S X=PAT D ULP K PSOQFLG,PSOQQ Q"
^XMB(3.9,146089,2,1827,0)="""RTN"",""PSOORFIN"",131,0)"
^XMB(3.9,146089,2,1828,0)=" . . S (PSODFN,Y)=PAT_""^""_$P($G(^DPT(PAT,0)),""^""),PATA=PAT"
^XMB(3.9,146089,2,1829,0)="""RTN"",""PSOORFIN"",132,0)"
^XMB(3.9,146089,2,1830,0)=" . . D:'$G(MEDA) PROFILE^PSOORFI2 S Y=PSODFN"
^XMB(3.9,146089,2,1831,0)="""RTN"",""PSOORFIN"",133,0)"
^XMB(3.9,146089,2,1832,0)=" . . I $G(MEDP) D  Q"
^XMB(3.9,146089,2,1833,0)="""RTN"",""PSOORFIN"",134,0)"
^XMB(3.9,146089,2,1834,0)=" . . . I SECSORT'=""FL^FLAGGED^FLAGGED"",$D(^XUSEC(""PSO ERX WORKLOAD RPH"",DUZ)) S ^XTMP(""PSOORWP"",PSOCLIN,PAT,DUZ)="""""
^XMB(3.9,146089,2,1835,0)="""RTN"",""PSOORFIN"",135,0)"
^XMB(3.9,146089,2,1836,0)=" . . . D SPL D OERR^PSORX1"
^XMB(3.9,146089,2,1837,0)="""RTN"",""PSOORFIN"",136,0)"
^XMB(3.9,146089,2,1838,0)=" . . . S PSOFIN=1 D QU S X=PSOPTLOK D KLLP,ULP,KLL"
^XMB(3.9,146089,2,1839,0)="""RTN"",""PSOORFIN"",137,0)"
^XMB(3.9,146089,2,1840,0)=" . . . ;Forcing the Workload Processing user to the beginning of the Queue"
^XMB(3.9,146089,2,1841,0)="""RTN"",""PSOORFIN"",138,0)"
^XMB(3.9,146089,2,1842,0)=" . . . I SECSORT'=""FL^FLAGGED^FLAGGED"",$D(^XUSEC(""PSO ERX WORKLOAD RPH"",DUZ)) D"
^XMB(3.9,146089,2,1843,0)="""RTN"",""PSOORFIN"",139,0)"
^XMB(3.9,146089,2,1844,0)=" . . . . I $$HASACTPO^PSOORUT3(PAT) S POERR(""QFLG"")=1 Q"
^XMB(3.9,146089,2,1845,0)="""RTN"",""PSOORFIN"",140,0)"
^XMB(3.9,146089,2,1846,0)=" . . . . K WPPAT(+PSOCLIN) S (LG,PSOD)=0 K ^XTMP(""PSOORWP"",PSOCLIN,PAT,DUZ)"
^XMB(3.9,146089,2,1847,0)="""RTN"",""PSOORFIN"",141,0)"
^XMB(3.9,146089,2,1848,0)=" . . D SDFN D POST^PSOORFI1 I $G(PSOQFLG)!($G(PSOQUIT)) S:$G(PSOQUIT) POERR(""QFLG"")=1 S:$G(PSOQFLG) PAT(PAT)=PAT S X=PAT D ULP K PSOQFLG Q"
^XMB(3.9,146089,2,1849,0)="""RTN"",""PSOORFIN"",142,0)"
^XMB(3.9,146089,2,1850,0)=" . . S PAT(PAT)=PAT"
^XMB(3.9,146089,2,1851,0)="""RTN"",""PSOORFIN"",143,0)"
^XMB(3.9,146089,2,1852,0)=" . . F ORD=0:0 S ORD=$O(^PS(52.41,""AOR"",PAT,PSOPINST,ORD)) Q:'ORD!($G(POERR(""QFLG"")))!($G(PSOQQ))  D"
^XMB(3.9,146089,2,1853,0)="""RTN"",""PSOORFIN"",144,0)"
^XMB(3.9,146089,2,1854,0)=" . . . I SECSORT'=0,'$$CHKFLTR^PSOORFI6(ORD,SECSORT) Q"
^XMB(3.9,146089,2,1855,0)="""RTN"",""PSOORFIN"",145,0)"
^XMB(3.9,146089,2,1856,0)=" . . . I $P($G(^PS(52.41,ORD,0)),""^"",23),$P(SECSORT,""^"",1)'=""FL"" Q"
^XMB(3.9,146089,2,1857,0)="""RTN"",""PSOORFIN"",146,0)"
^XMB(3.9,146089,2,1858,0)=" . . . D PP,LK1,ORD"
^XMB(3.9,146089,2,1859,0)="""RTN"",""PSOORFIN"",147,0)"
^XMB(3.9,146089,2,1860,0)=" . . S X=PAT D ULP K PSOQQ"
^XMB(3.9,146089,2,1861,0)="""RTN"",""PSOORFIN"",148,0)"
^XMB(3.9,146089,2,1862,0)=" I $O(PSORX(""PSOL"",0))!($D(RXRS)) D LBL"
^XMB(3.9,146089,2,1863,0)="""RTN"",""PSOORFIN"",149,0)"
^XMB(3.9,146089,2,1864,0)=" I $G(PSOQUIT) K PSOQUIT D EX G PSOORFIN"
^XMB(3.9,146089,2,1865,0)="""RTN"",""PSOORFIN"",150,0)"
^XMB(3.9,146089,2,1866,0)=" G EX"
^XMB(3.9,146089,2,1867,0)="""RTN"",""PSOORFIN"",151,0)"
^XMB(3.9,146089,2,1868,0)=" ;PSO*7*266 kill BINGCRT,BINGRTE when selecting pat."
^XMB(3.9,146089,2,1869,0)="""RTN"",""PSOORFIN"",152,0)"
^XMB(3.9,146089,2,1870,0)="SPAT ; Single Patient Selection"
^XMB(3.9,146089,2,1871,0)="""RTN"",""PSOORFIN"",153,0)"
^XMB(3.9,146089,2,1872,0)=" I $G(PSOJUMP) Q "
^XMB(3.9,146089,2,1873,0)="""RTN"",""PSOORFIN"",154,0)"
^XMB(3.9,146089,2,1874,0)=" K MEDA,MEDP,PSOQFLG,PSORX(""FN""),BINGCRT,BINGRTE D KQ,KV^PSOVER1"
^XMB(3.9,146089,2,1875,0)="""RTN"",""PSOORFIN"",155,0)"
^XMB(3.9,146089,2,1876,0)=" S DIR(0)=""FO^2:30"",DIR(""A"")=""Select Patient"",DIR(""?"")=""^D HELP^PSOORFI2"" D ^DIR I $E(X)=""?"" G SPAT"
^XMB(3.9,146089,2,1877,0)="""RTN"",""PSOORFIN"",156,0)"
^XMB(3.9,146089,2,1878,0)=" G:$D(DIRUT) EX D KV^PSOVER1"
^XMB(3.9,146089,2,1879,0)="""RTN"",""PSOORFIN"",157,0)"
^XMB(3.9,146089,2,1880,0)=" S DIC(0)=""EQM"",DIC=2,DIC(""S"")=""I $D(^PS(52.41,""""AOR"""",+Y,PSOPINST))"""
^XMB(3.9,146089,2,1881,0)="""RTN"",""PSOORFIN"",158,0)"
^XMB(3.9,146089,2,1882,0)=" D ^DIC K DIC G:""^""[X EX G:Y=-1 SPAT S (PSODFN,PAT)=+Y,PSOFINY=Y"
^XMB(3.9,146089,2,1883,0)="""RTN"",""PSOORFIN"",159,0)"
^XMB(3.9,146089,2,1884,0)="SPAT2 D LK I $G(POERR(""QFLG"")) G SPAT"
^XMB(3.9,146089,2,1885,0)="""RTN"",""PSOORFIN"",160,0)"
^XMB(3.9,146089,2,1886,0)=" N SNGLPAT S SNGLPAT=1"
^XMB(3.9,146089,2,1887,0)="""RTN"",""PSOORFIN"",161,0)"
^XMB(3.9,146089,2,1888,0)=" ; PSO*7*505 - SECONDARY SORT"
^XMB(3.9,146089,2,1889,0)="""RTN"",""PSOORFIN"",162,0)"
^XMB(3.9,146089,2,1890,0)=" N SECSORT S SECSORT=$S($G(PSOJUMP):0,1:$$DIR^PSOORFI6(""PA:PATIENT"",PSODFN)) I SECSORT'=0,$P(SECSORT,U,1)=""CS"" N PSRT S PSRT=$P(SECSORT,U,3)"
^XMB(3.9,146089,2,1891,0)="""RTN"",""PSOORFIN"",163,0)"
^XMB(3.9,146089,2,1892,0)=" Q:SECSORT=U"
^XMB(3.9,146089,2,1893,0)="""RTN"",""PSOORFIN"",164,0)"
