^XMB(3.9,146052,2,1710,0)="RDV W !! S DIC=""^FBAAV("",DIC(0)=""AEQM"",DA(1)=DFN D ^DIC G RDP:X=""^""!(X=""""),RDV:Y<0 S DA=+Y G:'$D(^FBAAC(DFN,DA,""AD"")) NOCL^FBAAVP0 D EN1"
