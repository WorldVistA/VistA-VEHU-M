^XMB(3.9,146012,2,1191,0)="""RTN"",""PSOERRX1"",4,0)"
^XMB(3.9,146012,2,1192,0)="HDR ; - Builds the Header section"
^XMB(3.9,146012,2,1193,0)="""RTN"",""PSOERRX1"",5,0)"
^XMB(3.9,146012,2,1194,0)=" N LINE1,LINE2,LINE3,ARR"
^XMB(3.9,146012,2,1195,0)="""RTN"",""PSOERRX1"",6,0)"
