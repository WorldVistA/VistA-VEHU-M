^XMB(3.9,146047,2,1919,0)="""RTN"",""IBCNEHLM"",132,0)"
^XMB(3.9,146047,2,1920,0)=" ; DSTAT3 is set in IBCNEDST"
^XMB(3.9,146047,2,1921,0)="""RTN"",""IBCNEHLM"",133,0)"
^XMB(3.9,146047,2,1922,0)=" N DSTATI,DSTAT3,DSTATPA"
^XMB(3.9,146047,2,1923,0)="""RTN"",""IBCNEHLM"",134,0)"
^XMB(3.9,146047,2,1924,0)=" S DSTATI=1,DSTAT3="""",DSTATPA=HLREP"
^XMB(3.9,146047,2,1925,0)="""RTN"",""IBCNEHLM"",135,0)"
^XMB(3.9,146047,2,1926,0)=" ; IB*2.0*702/DTG- end Added"
^XMB(3.9,146047,2,1927,0)="""RTN"",""IBCNEHLM"",136,0)"
^XMB(3.9,146047,2,1928,0)=" S DSTAT=$$GETSTAT^IBCNEDST(.MCAUTO)"
^XMB(3.9,146047,2,1929,0)="""RTN"",""IBCNEHLM"",137,0)"
^XMB(3.9,146047,2,1930,0)=" S DSTAT2=$$GETSTAT2^IBCNEDST()                 ; IB*2.0*549 Added line"
^XMB(3.9,146047,2,1931,0)="""RTN"",""IBCNEHLM"",138,0)"
^XMB(3.9,146047,2,1932,0)=" S VNTE=""NTE""_HLFS_""1""_HLFS_HLFS_IBPERSIST_HLREP_$TR(DSTAT,U,HLREP)"
^XMB(3.9,146047,2,1933,0)="""RTN"",""IBCNEHLM"",139,0)"
^XMB(3.9,146047,2,1934,0)=" S VNTE=VNTE_HLREP_RETRY_HLREP_TIMOUT           ; IB*2.0*506"
^XMB(3.9,146047,2,1935,0)="""RTN"",""IBCNEHLM"",140,0)"
^XMB(3.9,146047,2,1936,0)=" S VNTE=VNTE_HLREP_$TR(DSTAT2,U,HLREP)          ; IB*2.0*549 Added line"
^XMB(3.9,146047,2,1937,0)="""RTN"",""IBCNEHLM"",141,0)"
^XMB(3.9,146047,2,1938,0)=" S VNTE=VNTE_HLREP_MCAUTO"
^XMB(3.9,146047,2,1939,0)="""RTN"",""IBCNEHLM"",142,0)"
^XMB(3.9,146047,2,1940,0)=" ; IB*2.0*702/DTG- Added start"
^XMB(3.9,146047,2,1941,0)="""RTN"",""IBCNEHLM"",143,0)"
^XMB(3.9,146047,2,1942,0)=" I $G(DSTAT3)'="""" S VNTE=VNTE_HLREP_DSTAT3"
^XMB(3.9,146047,2,1943,0)="""RTN"",""IBCNEHLM"",144,0)"
^XMB(3.9,146047,2,1944,0)=" ; IB*2.0*702/DTG Added end"
^XMB(3.9,146047,2,1945,0)="""RTN"",""IBCNEHLM"",145,0)"
^XMB(3.9,146047,2,1946,0)=" S ^TMP(""HLS"",$J,4)=VNTE"
^XMB(3.9,146047,2,1947,0)="""RTN"",""IBCNEHLM"",146,0)"
^XMB(3.9,146047,2,1948,0)=" ;"
^XMB(3.9,146047,2,1949,0)="""RTN"",""IBCNEHLM"",147,0)"
^XMB(3.9,146047,2,1950,0)=" D GENERATE^HLMA(""IBCNE IIV REGISTER"",""GM"",1,.HLRESLT,"""")"
^XMB(3.9,146047,2,1951,0)="""RTN"",""IBCNEHLM"",148,0)"
^XMB(3.9,146047,2,1952,0)=" I $P(HLRESLT,U,2)]"""" S HLRESLT=""Error - ""_$P(HLRESLT,U,2,99) D  Q"
^XMB(3.9,146047,2,1953,0)="""RTN"",""IBCNEHLM"",149,0)"
^XMB(3.9,146047,2,1954,0)=" . S MSG(1)=""HL7 eIV Registration Message not created."""
^XMB(3.9,146047,2,1955,0)="""RTN"",""IBCNEHLM"",150,0)"
^XMB(3.9,146047,2,1956,0)=" . S MSG(2)=HLRESLT"
^XMB(3.9,146047,2,1957,0)="""RTN"",""IBCNEHLM"",151,0)"
^XMB(3.9,146047,2,1958,0)=" . D MLMN"
^XMB(3.9,146047,2,1959,0)="""RTN"",""IBCNEHLM"",152,0)"
^XMB(3.9,146047,2,1960,0)=" K ^TMP(""HLS"",$J)"
^XMB(3.9,146047,2,1961,0)="""RTN"",""IBCNEHLM"",153,0)"
^XMB(3.9,146047,2,1962,0)=" Q"
^XMB(3.9,146047,2,1963,0)="""RTN"",""IBCNEHLM"",154,0)"
^XMB(3.9,146047,2,1964,0)=" ;"
^XMB(3.9,146047,2,1965,0)="""RTN"",""IBCNEHLM"",155,0)"
^XMB(3.9,146047,2,1966,0)="MLMN ;  MailMan Message"
^XMB(3.9,146047,2,1967,0)="""RTN"",""IBCNEHLM"",156,0)"
^XMB(3.9,146047,2,1968,0)=" D TXT^IBCNEUT7(""MSG"")"
^XMB(3.9,146047,2,1969,0)="""RTN"",""IBCNEHLM"",157,0)"
^XMB(3.9,146047,2,1970,0)=" S XMSUB=""eIV Registration Failure"""
^XMB(3.9,146047,2,1971,0)="""RTN"",""IBCNEHLM"",158,0)"
^XMB(3.9,146047,2,1972,0)=" D MSG^IBCNEUT5(MGRP,XMSUB,""MSG("")"
^XMB(3.9,146047,2,1973,0)="""RTN"",""IBCNEHLM"",159,0)"
^XMB(3.9,146047,2,1974,0)=" K XMSUB,XMY,MSG,XMZ,XMDUZ"
^XMB(3.9,146047,2,1975,0)="""RTN"",""IBCNEHLM"",160,0)"
^XMB(3.9,146047,2,1976,0)=" Q"
^XMB(3.9,146047,2,1977,0)="""RTN"",""IBCNERPO"")"
^XMB(3.9,146047,2,1978,0)="1^5"
^XMB(3.9,146047,2,1979,0)="""RTN"",""IBCNERPO1"")"
^XMB(3.9,146047,2,1980,0)="1^6"
^XMB(3.9,146047,2,1981,0)="""RTN"",""IBCNERTC"")"
^XMB(3.9,146047,2,1982,0)="0^8^B52899581"
^XMB(3.9,146047,2,1983,0)="""RTN"",""IBCNERTC"",1,0)"
^XMB(3.9,146047,2,1984,0)="IBCNERTC ;AITC/HN - Covered by Health Insurance ;03-MAR-2017"
^XMB(3.9,146047,2,1985,0)="""RTN"",""IBCNERTC"",2,0)"
^XMB(3.9,146047,2,1986,0)=" ;;2.0;INTEGRATED BILLING;**593,822**;21-MAR-94;Build 0"
^XMB(3.9,146047,2,1987,0)="""RTN"",""IBCNERTC"",3,0)"
^XMB(3.9,146047,2,1988,0)=" ;;Per VA Directive 6402, this routine should not be modified."
^XMB(3.9,146047,2,1989,0)="""RTN"",""IBCNERTC"",4,0)"
^XMB(3.9,146047,2,1990,0)=" ;"
^XMB(3.9,146047,2,1991,0)="""RTN"",""IBCNERTC"",5,0)"
^XMB(3.9,146047,2,1992,0)=" ;**Program Description**"
^XMB(3.9,146047,2,1993,0)="""RTN"",""IBCNERTC"",6,0)"
^XMB(3.9,146047,2,1994,0)=" ;  This program will loop through the ACHI Index of the Patient (2) file to update the "
^XMB(3.9,146047,2,1995,0)="""RTN"",""IBCNERTC"",7,0)"
^XMB(3.9,146047,2,1996,0)=" ;  Covered by Health Insurance (2.3192) field based on current active policies."
^XMB(3.9,146047,2,1997,0)="""RTN"",""IBCNERTC"",8,0)"
^XMB(3.9,146047,2,1998,0)=" ;"
^XMB(3.9,146047,2,1999,0)="""RTN"",""IBCNERTC"",9,0)"
^XMB(3.9,146047,2,2000,0)=" ;  This option is designed to run through TaskMan after midnight.  It shouldn't take long since there"
^XMB(3.9,146047,2,2001,0)="""RTN"",""IBCNERTC"",10,0)"
^XMB(3.9,146047,2,2002,0)=" ;  should not be many entries in the ACHI index per day."
^XMB(3.9,146047,2,2003,0)="""RTN"",""IBCNERTC"",11,0)"
^XMB(3.9,146047,2,2004,0)=" ;"
^XMB(3.9,146047,2,2005,0)="""RTN"",""IBCNERTC"",12,0)"
^XMB(3.9,146047,2,2006,0)=" ;  UPATF should be used with care since it will process the entire Patient File"
^XMB(3.9,146047,2,2007,0)="""RTN"",""IBCNERTC"",13,0)"
^XMB(3.9,146047,2,2008,0)=" ;"
^XMB(3.9,146047,2,2009,0)="""RTN"",""IBCNERTC"",14,0)"
^XMB(3.9,146047,2,2010,0)=" Q"
^XMB(3.9,146047,2,2011,0)="""RTN"",""IBCNERTC"",15,0)"
^XMB(3.9,146047,2,2012,0)=" ;"
^XMB(3.9,146047,2,2013,0)="""RTN"",""IBCNERTC"",16,0)"
^XMB(3.9,146047,2,2014,0)="EN(IBDT) ;From Taskman nightly job.  Call from label TASK."
^XMB(3.9,146047,2,2015,0)="""RTN"",""IBCNERTC"",17,0)"
^XMB(3.9,146047,2,2016,0)=" N DFN"
^XMB(3.9,146047,2,2017,0)="""RTN"",""IBCNERTC"",18,0)"
^XMB(3.9,146047,2,2018,0)=" S DFN="""""
^XMB(3.9,146047,2,2019,0)="""RTN"",""IBCNERTC"",19,0)"
^XMB(3.9,146047,2,2020,0)=" F  S DFN=$O(^DPT(""ACHI"",IBDT,DFN)) Q:'DFN  D INS(DFN,IBDT)"
^XMB(3.9,146047,2,2021,0)="""RTN"",""IBCNERTC"",20,0)"
^XMB(3.9,146047,2,2022,0)=" Q"
^XMB(3.9,146047,2,2023,0)="""RTN"",""IBCNERTC"",21,0)"
^XMB(3.9,146047,2,2024,0)=" ;"
^XMB(3.9,146047,2,2025,0)="""RTN"",""IBCNERTC"",22,0)"
^XMB(3.9,146047,2,2026,0)="INS(DFN,IBDT) ;Check insurance"
^XMB(3.9,146047,2,2027,0)="""RTN"",""IBCNERTC"",23,0)"
^XMB(3.9,146047,2,2028,0)=" N DA,DIE,IBCOV,IBIND,IBINS,IBNCOV,DR,IBINSD,IENS,EFFDT,IBIENS,DEFIND,IBIEN,IBSYM"
^XMB(3.9,146047,2,2029,0)="""RTN"",""IBCNERTC"",24,0)"
^XMB(3.9,146047,2,2030,0)=" S (IBCOV,IBNCOV)=$$GET1^DIQ(2,DFN_"","",""COVERED BY HEALTH INSURANCE?"",""I"")"
^XMB(3.9,146047,2,2031,0)="""RTN"",""IBCNERTC"",25,0)"
^XMB(3.9,146047,2,2032,0)=" D ALL^IBCNS1(DFN,""IBINS"",2,IBDT) S IBINSD=+$G(IBINS(0))"
^XMB(3.9,146047,2,2033,0)="""RTN"",""IBCNERTC"",26,0)"
^XMB(3.9,146047,2,2034,0)=" ;"
^XMB(3.9,146047,2,2035,0)="""RTN"",""IBCNERTC"",27,0)"
^XMB(3.9,146047,2,2036,0)=" ; -- initial value ="""" or Unknown"
^XMB(3.9,146047,2,2037,0)="""RTN"",""IBCNERTC"",28,0)"
^XMB(3.9,146047,2,2038,0)=" I $TR(IBCOV,""U"","""")']"""" S IBNCOV=$S('$O(^DPT(DFN,.312,0)):""U"",IBINSD:""Y"",1:""N"")"
^XMB(3.9,146047,2,2039,0)="""RTN"",""IBCNERTC"",29,0)"
^XMB(3.9,146047,2,2040,0)=" ; -- initial value = YES or NO (treat the same)"
^XMB(3.9,146047,2,2041,0)="""RTN"",""IBCNERTC"",30,0)"
^XMB(3.9,146047,2,2042,0)=" I ""YN""[IBCOV S IBNCOV=$S('$O(^DPT(DFN,.312,0)):""N"",IBINSD:""Y"",1:""N"")"
^XMB(3.9,146047,2,2043,0)="""RTN"",""IBCNERTC"",31,0)"
^XMB(3.9,146047,2,2044,0)=" ;"
^XMB(3.9,146047,2,2045,0)="""RTN"",""IBCNERTC"",32,0)"
^XMB(3.9,146047,2,2046,0)=" I IBCOV'=IBNCOV S DIE=""^DPT("",DR="".3192///""_IBNCOV,DA=DFN D ^DIE"
^XMB(3.9,146047,2,2047,0)="""RTN"",""IBCNERTC"",33,0)"
^XMB(3.9,146047,2,2048,0)=" ;"
^XMB(3.9,146047,2,2049,0)="""RTN"",""IBCNERTC"",34,0)"
^XMB(3.9,146047,2,2050,0)=" ; Create Buffer entry for those whose Effective Date = IBDT"
^XMB(3.9,146047,2,2051,0)="""RTN"",""IBCNERTC"",35,0)"
^XMB(3.9,146047,2,2052,0)=" ;"
^XMB(3.9,146047,2,2053,0)="""RTN"",""IBCNERTC"",36,0)"
^XMB(3.9,146047,2,2054,0)=" S DA=0 F  S DA=$O(IBINS(DA)) Q:'DA  D"
^XMB(3.9,146047,2,2055,0)="""RTN"",""IBCNERTC"",37,0)"
^XMB(3.9,146047,2,2056,0)=" . S IBIEN=+IBINS(DA,0)"
^XMB(3.9,146047,2,2057,0)="""RTN"",""IBCNERTC"",38,0)"
^XMB(3.9,146047,2,2058,0)=" . S IBIENS=DA_"",""_DFN_"","""
^XMB(3.9,146047,2,2059,0)="""RTN"",""IBCNERTC"",39,0)"
^XMB(3.9,146047,2,2060,0)=" . S EFFDT=$$GET1^DIQ(2.312,IBIENS,8,""I"")"
^XMB(3.9,146047,2,2061,0)="""RTN"",""IBCNERTC"",40,0)"
^XMB(3.9,146047,2,2062,0)=" . I EFFDT'=IBDT Q"
^XMB(3.9,146047,2,2063,0)="""RTN"",""IBCNERTC"",41,0)"
^XMB(3.9,146047,2,2064,0)=" . ; Add check to see if already in buffer"
^XMB(3.9,146047,2,2065,0)="""RTN"",""IBCNERTC"",42,0)"
^XMB(3.9,146047,2,2066,0)=" . S DEFIND=$$BFEXIST(DFN,IBIEN) Q:DEFIND=1"
^XMB(3.9,146047,2,2067,0)="""RTN"",""IBCNERTC"",43,0)"
^XMB(3.9,146047,2,2068,0)=" . S IBSYM=$P($$INSERROR^IBCNEUT3(""I"",IBIEN),""^"",1)"
^XMB(3.9,146047,2,2069,0)="""RTN"",""IBCNERTC"",44,0)"
^XMB(3.9,146047,2,2070,0)=" . D PT^IBCNEBF(DFN,DA,IBSYM,,1)"
^XMB(3.9,146047,2,2071,0)="""RTN"",""IBCNERTC"",45,0)"
^XMB(3.9,146047,2,2072,0)=" Q"
^XMB(3.9,146047,2,2073,0)="""RTN"",""IBCNERTC"",46,0)"
^XMB(3.9,146047,2,2074,0)=" ;"
^XMB(3.9,146047,2,2075,0)="""RTN"",""IBCNERTC"",47,0)"
^XMB(3.9,146047,2,2076,0)="UPATF ;Update the entire Patient File"
^XMB(3.9,146047,2,2077,0)="""RTN"",""IBCNERTC"",48,0)"
^XMB(3.9,146047,2,2078,0)=" ; This should be tasked for late evening since it will take awhile to run."
^XMB(3.9,146047,2,2079,0)="""RTN"",""IBCNERTC"",49,0)"
^XMB(3.9,146047,2,2080,0)=" N DFN,IENS"
^XMB(3.9,146047,2,2081,0)="""RTN"",""IBCNERTC"",50,0)"
^XMB(3.9,146047,2,2082,0)=" S DFN=0"
^XMB(3.9,146047,2,2083,0)="""RTN"",""IBCNERTC"",51,0)"
^XMB(3.9,146047,2,2084,0)=" F  S DFN=$O(^DPT(DFN)) Q:'DFN  D"
^XMB(3.9,146047,2,2085,0)="""RTN"",""IBCNERTC"",52,0)"
^XMB(3.9,146047,2,2086,0)=" . D INS(DFN,DT)"
^XMB(3.9,146047,2,2087,0)="""RTN"",""IBCNERTC"",53,0)"
^XMB(3.9,146047,2,2088,0)=" Q"
^XMB(3.9,146047,2,2089,0)="""RTN"",""IBCNERTC"",54,0)"
^XMB(3.9,146047,2,2090,0)=" ;"
^XMB(3.9,146047,2,2091,0)="""RTN"",""IBCNERTC"",55,0)"
^XMB(3.9,146047,2,2092,0)="BFEXIST(DFN,INSNAME) ; Function returns 1 if an Entered Ins Buffer File "
^XMB(3.9,146047,2,2093,0)="""RTN"",""IBCNERTC"",56,0)"
^XMB(3.9,146047,2,2094,0)=" ; entry exists with the same DFN and INSNAME, otherwise it returns a 0"
^XMB(3.9,146047,2,2095,0)="""RTN"",""IBCNERTC"",57,0)"
^XMB(3.9,146047,2,2096,0)=" ;"
^XMB(3.9,146047,2,2097,0)="""RTN"",""IBCNERTC"",58,0)"
^XMB(3.9,146047,2,2098,0)=" ; DFN - Patient DFN"
^XMB(3.9,146047,2,2099,0)="""RTN"",""IBCNERTC"",59,0)"
^XMB(3.9,146047,2,2100,0)=" ; INSNAME - Insurance Company Name File 36 - Field .01"
^XMB(3.9,146047,2,2101,0)="""RTN"",""IBCNERTC"",60,0)"
^XMB(3.9,146047,2,2102,0)=" ;"
^XMB(3.9,146047,2,2103,0)="""RTN"",""IBCNERTC"",61,0)"
^XMB(3.9,146047,2,2104,0)=" NEW EXIST,IEN,EDATE"
^XMB(3.9,146047,2,2105,0)="""RTN"",""IBCNERTC"",62,0)"
^XMB(3.9,146047,2,2106,0)=" S EXIST=0"
^XMB(3.9,146047,2,2107,0)="""RTN"",""IBCNERTC"",63,0)"
^XMB(3.9,146047,2,2108,0)=" S INSNAME=$P($G(^DIC(36,IBIEN,0)),U) ;$$TRIM^XLFSTR(INSNAME)  ; trimmed"
^XMB(3.9,146047,2,2109,0)="""RTN"",""IBCNERTC"",64,0)"
^XMB(3.9,146047,2,2110,0)=" I ('DFN)!(INSNAME="""") G BFEXIT"
^XMB(3.9,146047,2,2111,0)="""RTN"",""IBCNERTC"",65,0)"
^XMB(3.9,146047,2,2112,0)=" ;"
^XMB(3.9,146047,2,2113,0)="""RTN"",""IBCNERTC"",66,0)"
^XMB(3.9,146047,2,2114,0)=" S IEN=0"
^XMB(3.9,146047,2,2115,0)="""RTN"",""IBCNERTC"",67,0)"
^XMB(3.9,146047,2,2116,0)=" F  S IEN=$O(^IBA(355.33,""C"",DFN,IEN)) Q:'IEN!EXIST  D"
^XMB(3.9,146047,2,2117,0)="""RTN"",""IBCNERTC"",68,0)"
^XMB(3.9,146047,2,2118,0)=" .  ; Quit if status is NOT 'Entered'"
^XMB(3.9,146047,2,2119,0)="""RTN"",""IBCNERTC"",69,0)"
^XMB(3.9,146047,2,2120,0)=" .  I $$GET1^DIQ(355.33,IEN_"","",""STATUS"",""I"")'=""E"" Q"
^XMB(3.9,146047,2,2121,0)="""RTN"",""IBCNERTC"",70,0)"
^XMB(3.9,146047,2,2122,0)=" .  ; Quit if Ins Buffer Ins Co Name (trimmed) is NOT EQUAL to "
^XMB(3.9,146047,2,2123,0)="""RTN"",""IBCNERTC"",71,0)"
^XMB(3.9,146047,2,2124,0)=" .  ;  the Ins Co Name parameter (trimmed)"
^XMB(3.9,146047,2,2125,0)="""RTN"",""IBCNERTC"",72,0)"
^XMB(3.9,146047,2,2126,0)=" .  I $$TRIM^XLFSTR($$GET1^DIQ(355.33,IEN_"","",""INSURANCE COMPANY NAME""))'=INSNAME Q"
^XMB(3.9,146047,2,2127,0)="""RTN"",""IBCNERTC"",73,0)"
^XMB(3.9,146047,2,2128,0)=" .  ; Quit if Date Enterd Matches"
^XMB(3.9,146047,2,2129,0)="""RTN"",""IBCNERTC"",74,0)"
^XMB(3.9,146047,2,2130,0)=" .  S EDATE=$P($$GET1^DIQ(355.33,IEN_"","",""DATE ENTERED"",""I""),""."")"
