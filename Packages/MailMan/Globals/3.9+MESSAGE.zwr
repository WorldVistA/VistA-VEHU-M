^XMB(3.9,146036,2,2163,0)="""RTN"",""DVBCTXML"",59,0)"
^XMB(3.9,146036,2,2164,0)=" .S DVBFXML=$G(^DVB(396.17,DVBIEN,14,DVBCT,3,DVBABCNT,0))"
