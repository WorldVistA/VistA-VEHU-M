^XMB(3.9,146047,2,2965,0)="""RTN"",""IBCNEUT2"",280,0)"
^XMB(3.9,146047,2,2966,0)=" I IBPIEN=MWNRIEN S MWNRTYPA=1"
^XMB(3.9,146047,2,2967,0)="""RTN"",""IBCNEUT2"",281,0)"
^XMB(3.9,146047,2,2968,0)=" Q MWNRTYPA"
