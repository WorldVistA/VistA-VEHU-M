^XMB(3.9,146098,2,2487,0)="""RTN"",""SDLT"",127,0)"
^XMB(3.9,146098,2,2488,0)=" . S SDDFN=0 F  S SDDFN=$O(^TMP($J,""BADADD"",SDNAM,SDDFN)) Q:'SDDFN  D"
^XMB(3.9,146098,2,2489,0)="""RTN"",""SDLT"",128,0)"
^XMB(3.9,146098,2,2490,0)=" . . W !,$$LAST4(SDDFN),?10,SDNAM"
^XMB(3.9,146098,2,2491,0)="""RTN"",""SDLT"",129,0)"
