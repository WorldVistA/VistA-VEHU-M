^XMB(3.9,146012,2,1198,0)=" S LINE1=""LOOK BACK DAYS: ""_IOINHI_$S($G(REDTFLTR):""N/A"",1:PSOLKBKD)_IOINORM"
^XMB(3.9,146012,2,1199,0)="""RTN"",""PSOERRX1"",8,0)"
^XMB(3.9,146012,2,1200,0)=" S $E(LINE1,40)=""CS/NON-CS: ""_IOINHI_$S(PSOCSERX=""CS"":""CS ONLY"",PSOCSERX=""Non-CS"":""NON-CS ONLY"",1:""BOTH"")"
^XMB(3.9,146012,2,1201,0)="""RTN"",""PSOERRX1"",9,0)"
^XMB(3.9,146012,2,1202,0)=" S:PSOCSERX'=""Non-CS"" LINE1=LINE1_"" (""_$S(PSOCSSCH=1:""II"",PSOCSSCH=2:""III-V"",1:""II-V"")_"")"""
^XMB(3.9,146012,2,1203,0)="""RTN"",""PSOERRX1"",10,0)"
^XMB(3.9,146012,2,1204,0)=" S LINE1=LINE1_IOINORM"
^XMB(3.9,146012,2,1205,0)="""RTN"",""PSOERRX1"",11,0)"
^XMB(3.9,146012,2,1206,0)=" D INSTR^VALM1(""MAX. QUEUE SIZE: ""_IOINHI_$J(PSOMAXQS,4)_IOINORM,60,2)"
^XMB(3.9,146012,2,1207,0)="""RTN"",""PSOERRX1"",12,0)"
^XMB(3.9,146012,2,1208,0)=" ;"
^XMB(3.9,146012,2,1209,0)="""RTN"",""PSOERRX1"",13,0)"
^XMB(3.9,146012,2,1210,0)=" S LINE2=""ERX STATUS: ""_IOINHI"
^XMB(3.9,146012,2,1211,0)="""RTN"",""PSOERRX1"",14,0)"
^XMB(3.9,146012,2,1212,0)=" I PSOSTFLT=""A"" S LINE2=LINE2_""ALL"""
^XMB(3.9,146012,2,1213,0)="""RTN"",""PSOERRX1"",15,0)"
^XMB(3.9,146012,2,1214,0)=" I PSOSTFLT=""N"" S LINE2=LINE2_""NEW"""
^XMB(3.9,146012,2,1215,0)="""RTN"",""PSOERRX1"",16,0)"
^XMB(3.9,146012,2,1216,0)=" I PSOSTFLT=""I"" S LINE2=LINE2_""IN PROGRESS"""
^XMB(3.9,146012,2,1217,0)="""RTN"",""PSOERRX1"",17,0)"
^XMB(3.9,146012,2,1218,0)=" I PSOSTFLT=""W"" S LINE2=LINE2_""WAIT"""
^XMB(3.9,146012,2,1219,0)="""RTN"",""PSOERRX1"",18,0)"
^XMB(3.9,146012,2,1220,0)=" I PSOSTFLT=""H"" S LINE2=LINE2_$S(PSOHDSTS=""ALL"":""HOLD (ALL)"",1:""HOLD (""_PSOHDSTS_"")"")"
^XMB(3.9,146012,2,1221,0)="""RTN"",""PSOERRX1"",19,0)"
^XMB(3.9,146012,2,1222,0)=" I PSOSTFLT=""C"" S LINE2=LINE2_$S(PSOCCRST=""ALL"":""CCR (ALL)"",1:""CCR (""_PSOCCRST_"")"")"
^XMB(3.9,146012,2,1223,0)="""RTN"",""PSOERRX1"",20,0)"
^XMB(3.9,146012,2,1224,0)=" S LINE2=LINE2_IOINORM"
^XMB(3.9,146012,2,1225,0)="""RTN"",""PSOERRX1"",21,0)"
^XMB(3.9,146012,2,1226,0)=" S LINE3="""""
^XMB(3.9,146012,2,1227,0)="""RTN"",""PSOERRX1"",22,0)"
^XMB(3.9,146012,2,1228,0)=" I $D(PATFLTR)!$G(DOBFLTR)!$G(REDTFLTR)!$D(PRVFLTR)!$G(STSFLTR)!($G(DRGFLTR)'="""")!$G(MATFLTR)!($G(MSTPFLTR)'="""")!$G(VDRGFLTR) D"
^XMB(3.9,146012,2,1229,0)="""RTN"",""PSOERRX1"",23,0)"
^XMB(3.9,146012,2,1230,0)=" . N FILTER S FILTER="""""
^XMB(3.9,146012,2,1231,0)="""RTN"",""PSOERRX1"",24,0)"
^XMB(3.9,146012,2,1232,0)=" . I $G(REDTFLTR) S FILTER=FILTER_""|""_$$FMTE^XLFDT(+REDTFLTR,""2Z"")_""-""_$$FMTE^XLFDT($P(REDTFLTR,""^"",2),""2Z"")"
^XMB(3.9,146012,2,1233,0)="""RTN"",""PSOERRX1"",25,0)"
