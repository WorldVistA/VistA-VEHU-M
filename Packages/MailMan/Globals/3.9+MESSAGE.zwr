^XMB(3.9,146104,2,394,0)=" ;"
^XMB(3.9,146104,2,395,0)="""RTN"",""IBAMTC"",80,0)"
^XMB(3.9,146104,2,396,0)=" ; Monitor special inpatient billing cases"
^XMB(3.9,146104,2,397,0)="""RTN"",""IBAMTC"",81,0)"
^XMB(3.9,146104,2,398,0)=" D BGJ^IBAMTI"
^XMB(3.9,146104,2,399,0)="""RTN"",""IBAMTC"",82,0)"
^XMB(3.9,146104,2,400,0)=" ;"
^XMB(3.9,146104,2,401,0)="""RTN"",""IBAMTC"",83,0)"
^XMB(3.9,146104,2,402,0)=" ; Print Pharmacy Copay Exemption Income Test Reminder Letters"
^XMB(3.9,146104,2,403,0)="""RTN"",""IBAMTC"",84,0)"
^XMB(3.9,146104,2,404,0)=" D EN^IBARXEL"
^XMB(3.9,146104,2,405,0)="""RTN"",""IBAMTC"",85,0)"
^XMB(3.9,146104,2,406,0)=" ;"
^XMB(3.9,146104,2,407,0)="""RTN"",""IBAMTC"",86,0)"
^XMB(3.9,146104,2,408,0)=" ; Send HMS extract files to AITC DMI queues"
^XMB(3.9,146104,2,409,0)="""RTN"",""IBAMTC"",87,0)"
^XMB(3.9,146104,2,410,0)=" D SENDEII^IBCNFSND"
^XMB(3.9,146104,2,411,0)="""RTN"",""IBAMTC"",88,0)"
^XMB(3.9,146104,2,412,0)=" ; "
^XMB(3.9,146104,2,413,0)="""RTN"",""IBAMTC"",89,0)"
^XMB(3.9,146104,2,414,0)=" ; Send info on any Duplicate Transactions that were identified or corrected (IB*2.0*630)"
^XMB(3.9,146104,2,415,0)="""RTN"",""IBAMTC"",90,0)"
^XMB(3.9,146104,2,416,0)=" I $D(^XTMP(""IB TRANS"")) D XMIT^IBAUTL9"
^XMB(3.9,146104,2,417,0)="""RTN"",""IBAMTC"",91,0)"
^XMB(3.9,146104,2,418,0)=" ;"
^XMB(3.9,146104,2,419,0)="""RTN"",""IBAMTC"",92,0)"
^XMB(3.9,146104,2,420,0)=" ; Kill variables and quit."
^XMB(3.9,146104,2,421,0)="""RTN"",""IBAMTC"",93,0)"
^XMB(3.9,146104,2,422,0)=" D KILL1"
^XMB(3.9,146104,2,423,0)="""RTN"",""IBAMTC"",94,0)"
^XMB(3.9,146104,2,424,0)=" ;"
^XMB(3.9,146104,2,425,0)="""RTN"",""IBAMTC"",95,0)"
^XMB(3.9,146104,2,426,0)=" I $D(ZTQUEUED),$G(ZTSK) D KILL^%ZTLOAD"
^XMB(3.9,146104,2,427,0)="""RTN"",""IBAMTC"",96,0)"
^XMB(3.9,146104,2,428,0)=" ;"
^XMB(3.9,146104,2,429,0)="""RTN"",""IBAMTC"",97,0)"
^XMB(3.9,146104,2,430,0)=" D UPDTS ; update timestamp  IB*2.0*760"
^XMB(3.9,146104,2,431,0)="""RTN"",""IBAMTC"",98,0)"
^XMB(3.9,146104,2,432,0)=" Q"
^XMB(3.9,146104,2,433,0)="""RTN"",""IBAMTC"",99,0)"
^XMB(3.9,146104,2,434,0)=" ;"
^XMB(3.9,146104,2,435,0)="""RTN"",""IBAMTC"",100,0)"
^XMB(3.9,146104,2,436,0)=" ;"
^XMB(3.9,146104,2,437,0)="""RTN"",""IBAMTC"",101,0)"
^XMB(3.9,146104,2,438,0)="PROC ; Process all currently admitted patients."
^XMB(3.9,146104,2,439,0)="""RTN"",""IBAMTC"",102,0)"
^XMB(3.9,146104,2,440,0)=" ;"
^XMB(3.9,146104,2,441,0)="""RTN"",""IBAMTC"",103,0)"
^XMB(3.9,146104,2,442,0)=" D IFCVEXP^IBACV(DFN,DT,IBA) ;if CV has expired (see CVEXMAIL^IBACV)"
^XMB(3.9,146104,2,443,0)="""RTN"",""IBAMTC"",104,0)"
^XMB(3.9,146104,2,444,0)=" ;--"
^XMB(3.9,146104,2,445,0)="""RTN"",""IBAMTC"",105,0)"
^XMB(3.9,146104,2,446,0)=" ;1) checks effective date for LTC legislation."
^XMB(3.9,146104,2,447,0)="""RTN"",""IBAMTC"",106,0)"
^XMB(3.9,146104,2,448,0)=" ;2) determine current treating specialty (TS) for the "
^XMB(3.9,146104,2,449,0)="""RTN"",""IBAMTC"",107,0)"
^XMB(3.9,146104,2,450,0)=" ;""original"" admission."
^XMB(3.9,146104,2,451,0)="""RTN"",""IBAMTC"",108,0)"
^XMB(3.9,146104,2,452,0)=" ;if TS is LTC: "
^XMB(3.9,146104,2,453,0)="""RTN"",""IBAMTC"",109,0)"
^XMB(3.9,146104,2,454,0)=" ;  - creates new LTC #350 parent event entry if necessary."
^XMB(3.9,146104,2,455,0)="""RTN"",""IBAMTC"",110,0)"
^XMB(3.9,146104,2,456,0)=" ;NOTE: It doesn't stop MT billing for LTC. CALC^IBAUTL4 does it."
^XMB(3.9,146104,2,457,0)="""RTN"",""IBAMTC"",111,0)"
^XMB(3.9,146104,2,458,0)=" I $$ISLTCADM^IBAECN1(DFN,IBA)"
^XMB(3.9,146104,2,459,0)="""RTN"",""IBAMTC"",112,0)"
^XMB(3.9,146104,2,460,0)=" ;--"
^XMB(3.9,146104,2,461,0)="""RTN"",""IBAMTC"",113,0)"
^XMB(3.9,146104,2,462,0)=" D ORIG  ; find ""original"" admission date"
^XMB(3.9,146104,2,463,0)="""RTN"",""IBAMTC"",114,0)"
^XMB(3.9,146104,2,464,0)=" Q:$$BILST^DGMTUB(DFN)<IBADMDT  ; pat. was last billable before admission"
^XMB(3.9,146104,2,465,0)="""RTN"",""IBAMTC"",115,0)"
^XMB(3.9,146104,2,466,0)=" Q:IBADMDT\1=DT  ; patient was admitted today - process tomorrow"
^XMB(3.9,146104,2,467,0)="""RTN"",""IBAMTC"",116,0)"
^XMB(3.9,146104,2,468,0)=" Q:+$$MVT^DGPMOBS(IBA)  ; admitted for Observation & Examination"
^XMB(3.9,146104,2,469,0)="""RTN"",""IBAMTC"",117,0)"
^XMB(3.9,146104,2,470,0)=" Q:$O(^IBE(351.2,""AC"",IBA,0))  ; skip special inpatient admissions"
^XMB(3.9,146104,2,471,0)="""RTN"",""IBAMTC"",118,0)"
^XMB(3.9,146104,2,472,0)=" ;"
^XMB(3.9,146104,2,473,0)="""RTN"",""IBAMTC"",119,0)"
^XMB(3.9,146104,2,474,0)=" ; - if vet is SC, create a Special Inpatient Billing Case"
^XMB(3.9,146104,2,475,0)="""RTN"",""IBAMTC"",120,0)"
^XMB(3.9,146104,2,476,0)=" ;   in file #351.2 (use code 3 for SC, as it is changed to 4 in IBAMTI)"
^XMB(3.9,146104,2,477,0)="""RTN"",""IBAMTC"",121,0)"
^XMB(3.9,146104,2,478,0)=" D ELIG^VADPT I VAEL(3) D ADM^IBAMTI(DFN,IBA,3) Q"
^XMB(3.9,146104,2,479,0)="""RTN"",""IBAMTC"",122,0)"
^XMB(3.9,146104,2,480,0)=" ;"
^XMB(3.9,146104,2,481,0)="""RTN"",""IBAMTC"",123,0)"
^XMB(3.9,146104,2,482,0)=" ; - gather event information"
^XMB(3.9,146104,2,483,0)="""RTN"",""IBAMTC"",124,0)"
^XMB(3.9,146104,2,484,0)=" D EVFIND^IBAUTL3 I 'IBEVDA D BSEC Q:'IBBS  ; wasn't billable yesterday"
^XMB(3.9,146104,2,485,0)="""RTN"",""IBAMTC"",125,0)"
^XMB(3.9,146104,2,486,0)=" S X=IBADMDT D H^%DTC S IBBDT=%H D:'IBEVDA LAST^IBAUTL5"
^XMB(3.9,146104,2,487,0)="""RTN"",""IBAMTC"",126,0)"
^XMB(3.9,146104,2,488,0)=" I IBEVDA,IBEVCAL S X1=IBEVCAL,X2=1 D C^%DTC S IBBDT=%H"
^XMB(3.9,146104,2,489,0)="""RTN"",""IBAMTC"",127,0)"
^XMB(3.9,146104,2,490,0)=" S IBEDT=+$H-1"
^XMB(3.9,146104,2,491,0)="""RTN"",""IBAMTC"",128,0)"
^XMB(3.9,146104,2,492,0)=" ; - gather clock information"
^XMB(3.9,146104,2,493,0)="""RTN"",""IBAMTC"",129,0)"
^XMB(3.9,146104,2,494,0)=" S IBWHER=24 D CLOCK^IBAUTL3 I IBY<1 D ERR G PROCQ"
^XMB(3.9,146104,2,495,0)="""RTN"",""IBAMTC"",130,0)"
^XMB(3.9,146104,2,496,0)=" I IBCLDA S X=IBCLDT D H^%DTC S IBCLCT=IBBDT-%H"
^XMB(3.9,146104,2,497,0)="""RTN"",""IBAMTC"",131,0)"
^XMB(3.9,146104,2,498,0)=" ; - build charges for inpatient days"
^XMB(3.9,146104,2,499,0)="""RTN"",""IBAMTC"",132,0)"
^XMB(3.9,146104,2,500,0)=" D ^IBAUTL4 I IBY<1 D ERR G PROCQ"
^XMB(3.9,146104,2,501,0)="""RTN"",""IBAMTC"",133,0)"
^XMB(3.9,146104,2,502,0)=" ; - pass per diem if over 30 days old, or both per diem and the copay"
^XMB(3.9,146104,2,503,0)="""RTN"",""IBAMTC"",134,0)"
^XMB(3.9,146104,2,504,0)=" ; - if 4 days from patient's statement date; update event, clock"
^XMB(3.9,146104,2,505,0)="""RTN"",""IBAMTC"",135,0)"
^XMB(3.9,146104,2,506,0)=" S IBWHER=22"
^XMB(3.9,146104,2,507,0)="""RTN"",""IBAMTC"",136,0)"
^XMB(3.9,146104,2,508,0)=" I $G(IBCHPDA),$P($G(^IB(+IBCHPDA,0)),""^"",6)>30!($$STD^IBAUTL5(DFN)) S IBNOS=IBCHPDA D FILER^IBAUTL5 I IBY<1 D ERR G PROCQ"
^XMB(3.9,146104,2,509,0)="""RTN"",""IBAMTC"",137,0)"
^XMB(3.9,146104,2,510,0)=" I $G(IBCHCDA),$$STD^IBAUTL5(DFN) S IBNOS=IBCHCDA D FILER^IBAUTL5 I IBY<1 D ERR G PROCQ"
^XMB(3.9,146104,2,511,0)="""RTN"",""IBAMTC"",138,0)"
^XMB(3.9,146104,2,512,0)=" I IBEVDA,$D(IBDT) S IBEVCLD=IBDT D EVUPD^IBAUTL3"
^XMB(3.9,146104,2,513,0)="""RTN"",""IBAMTC"",139,0)"
^XMB(3.9,146104,2,514,0)=" I IBCLDA D CLUPD^IBAUTL3"
^XMB(3.9,146104,2,515,0)="""RTN"",""IBAMTC"",140,0)"
^XMB(3.9,146104,2,516,0)="PROCQ D KILL Q"
^XMB(3.9,146104,2,517,0)="""RTN"",""IBAMTC"",141,0)"
^XMB(3.9,146104,2,518,0)=" ;"
^XMB(3.9,146104,2,519,0)="""RTN"",""IBAMTC"",142,0)"
^XMB(3.9,146104,2,520,0)="BSEC ; Determine patient's bed section for the previous day."
^XMB(3.9,146104,2,521,0)="""RTN"",""IBAMTC"",143,0)"
^XMB(3.9,146104,2,522,0)=" S X1=DT,X2=-1 D C^%DTC"
^XMB(3.9,146104,2,523,0)="""RTN"",""IBAMTC"",144,0)"
^XMB(3.9,146104,2,524,0)=" S VAIP(""D"")=X_.2359 D IN5^VADPT S IBBS=$$SECT^IBAUTL5(+VAIP(8)) Q"
^XMB(3.9,146104,2,525,0)="""RTN"",""IBAMTC"",145,0)"
^XMB(3.9,146104,2,526,0)=" ;"
^XMB(3.9,146104,2,527,0)="""RTN"",""IBAMTC"",146,0)"
^XMB(3.9,146104,2,528,0)="ERR ; Error processing.  Input:  IBY, IBWHER, IBCNT"
^XMB(3.9,146104,2,529,0)="""RTN"",""IBAMTC"",147,0)"
^XMB(3.9,146104,2,530,0)=" S IBDUZ=DUZ,IBCNT=IBCNT+1 D ^IBAERR1 K IBDUZ Q"
^XMB(3.9,146104,2,531,0)="""RTN"",""IBAMTC"",148,0)"
^XMB(3.9,146104,2,532,0)=" ;S ^TMP($J,""IBAMTC"",""E"",IBERRN)=$P(IBY,""^"",2)_""^""_$S($D(DFN):DFN,1:"""")_""^""_IBWHER,IBERRN=IBERRN+1 Q"
^XMB(3.9,146104,2,533,0)="""RTN"",""IBAMTC"",149,0)"
^XMB(3.9,146104,2,534,0)=" ;"
^XMB(3.9,146104,2,535,0)="""RTN"",""IBAMTC"",150,0)"
^XMB(3.9,146104,2,536,0)="ORIG ; Find first admission date, considering ASIH movements"
^XMB(3.9,146104,2,537,0)="""RTN"",""IBAMTC"",151,0)"
^XMB(3.9,146104,2,538,0)=" ;  Input:  IBA    Output:  IBADMDT"
^XMB(3.9,146104,2,539,0)="""RTN"",""IBAMTC"",152,0)"
^XMB(3.9,146104,2,540,0)=" N X,Y,Z S Z=IBA"
^XMB(3.9,146104,2,541,0)="""RTN"",""IBAMTC"",153,0)"
^XMB(3.9,146104,2,542,0)=" F  S X=$G(^DGPM(Z,0)),Y=$P(X,""^"",21) Q:Y=""""  S Z=+$P($G(^DGPM(Y,0)),""^"",14)"
^XMB(3.9,146104,2,543,0)="""RTN"",""IBAMTC"",154,0)"
^XMB(3.9,146104,2,544,0)=" S IBADMDT=+X Q"
^XMB(3.9,146104,2,545,0)="""RTN"",""IBAMTC"",155,0)"
^XMB(3.9,146104,2,546,0)=" ;"
^XMB(3.9,146104,2,547,0)="""RTN"",""IBAMTC"",156,0)"
^XMB(3.9,146104,2,548,0)="CANCEL(STRTDT,ENDDT,MSG) ; cancel copays (covid relief)  IB*2.0*703"
^XMB(3.9,146104,2,549,0)="""RTN"",""IBAMTC"",157,0)"
^XMB(3.9,146104,2,550,0)=" ;"
^XMB(3.9,146104,2,551,0)="""RTN"",""IBAMTC"",158,0)"
^XMB(3.9,146104,2,552,0)=" ; STRTDT - starting date (internal)"
^XMB(3.9,146104,2,553,0)="""RTN"",""IBAMTC"",159,0)"
^XMB(3.9,146104,2,554,0)=" ; ENDDT - ending date (internal)"
^XMB(3.9,146104,2,555,0)="""RTN"",""IBAMTC"",160,0)"
^XMB(3.9,146104,2,556,0)=" ; MSG - 0 to skip Mailman bulletin, 1 to send full Mailman bulletin, 2 to send only error report"
^XMB(3.9,146104,2,557,0)="""RTN"",""IBAMTC"",161,0)"
^XMB(3.9,146104,2,558,0)=" ;"
^XMB(3.9,146104,2,559,0)="""RTN"",""IBAMTC"",162,0)"
^XMB(3.9,146104,2,560,0)=" N IBACT,IBCRES,IBDTM,IBECODE,IBEMSG,IBFR,IBIEN,IBN0,IBRES,IBSRVFR,IBSRVTO,IBSTAT,IBTO,IBXA,STATSTR"
^XMB(3.9,146104,2,561,0)="""RTN"",""IBAMTC"",163,0)"
^XMB(3.9,146104,2,562,0)=" ; service dates"
^XMB(3.9,146104,2,563,0)="""RTN"",""IBAMTC"",164,0)"
^XMB(3.9,146104,2,564,0)=" S IBSRVFR=3200406                 ; start date 04/06/20"
^XMB(3.9,146104,2,565,0)="""RTN"",""IBAMTC"",165,0)"
^XMB(3.9,146104,2,566,0)=" S IBSRVTO=$P(^IBE(350.9,1,71),U)  ; end date comes from 350.9/71.01"
^XMB(3.9,146104,2,567,0)="""RTN"",""IBAMTC"",166,0)"
^XMB(3.9,146104,2,568,0)=" S STATSTR=""^BILLED^HOLD - RATE^HOLD - REVIEW^INCOMPLETE^ON HOLD^""  ; bill statuses to include  IB*2.0*703"
^XMB(3.9,146104,2,569,0)="""RTN"",""IBAMTC"",167,0)"
^XMB(3.9,146104,2,570,0)=" ;"
^XMB(3.9,146104,2,571,0)="""RTN"",""IBAMTC"",168,0)"
^XMB(3.9,146104,2,572,0)=" I MSG K ^TMP(""IBAMTC3"",$J)"
^XMB(3.9,146104,2,573,0)="""RTN"",""IBAMTC"",169,0)"
^XMB(3.9,146104,2,574,0)=" S IBDTM=STRTDT F  S IBDTM=$O(^IB(""D"",IBDTM)) Q:'IBDTM!(IBDTM'<ENDDT)  D"
^XMB(3.9,146104,2,575,0)="""RTN"",""IBAMTC"",170,0)"
^XMB(3.9,146104,2,576,0)=" .S IBIEN=0 F  S IBIEN=$O(^IB(""D"",IBDTM,IBIEN)) Q:'IBIEN  D"
^XMB(3.9,146104,2,577,0)="""RTN"",""IBAMTC"",171,0)"
^XMB(3.9,146104,2,578,0)=" ..S IBN0=^IB(IBIEN,0)  ; file 350, node 0"
^XMB(3.9,146104,2,579,0)="""RTN"",""IBAMTC"",172,0)"
^XMB(3.9,146104,2,580,0)=" ..S IBSTAT=$$GET1^DIQ(350,IBIEN_"","",.05)  ; status from 350/.05 (external)"
^XMB(3.9,146104,2,581,0)="""RTN"",""IBAMTC"",173,0)"
^XMB(3.9,146104,2,582,0)=" ..I STATSTR'[(U_IBSTAT_U) Q  ; only cancel copays with specific status  IB*2.0*703"
^XMB(3.9,146104,2,583,0)="""RTN"",""IBAMTC"",174,0)"
^XMB(3.9,146104,2,584,0)=" ..S IBACT=$G(^IBE(350.1,+$P(IBN0,U,3),0))  ; node 0 in file 350.1 for the action type of this charge"
^XMB(3.9,146104,2,585,0)="""RTN"",""IBAMTC"",175,0)"
^XMB(3.9,146104,2,586,0)=" ..I $P(IBACT,U,5)'=1 Q  ; action type is not ""New"""
^XMB(3.9,146104,2,587,0)="""RTN"",""IBAMTC"",176,0)"
^XMB(3.9,146104,2,588,0)=" ..S IBXA=$P(IBACT,U,11)  ; billing group"
^XMB(3.9,146104,2,589,0)="""RTN"",""IBAMTC"",177,0)"
^XMB(3.9,146104,2,590,0)=" ..I IBXA=6!(IBXA=7) Q  ; skip CHAMPVA/TRICARE charges"
^XMB(3.9,146104,2,591,0)="""RTN"",""IBAMTC"",178,0)"
^XMB(3.9,146104,2,592,0)=" ..I IBSTAT=""INCOMPLETE"",IBXA=4!(IBXA=5) Q"
^XMB(3.9,146104,2,593,0)="""RTN"",""IBAMTC"",179,0)"
^XMB(3.9,146104,2,594,0)=" ..S IBFR=+$P(IBN0,U,14) I IBFR>IBSRVTO Q  ; Bill From date is outside the range"
^XMB(3.9,146104,2,595,0)="""RTN"",""IBAMTC"",180,0)"
^XMB(3.9,146104,2,596,0)=" ..S IBTO=+$P(IBN0,U,15) I IBTO<IBSRVFR Q  ; Bill To date is outside the range"
^XMB(3.9,146104,2,597,0)="""RTN"",""IBAMTC"",181,0)"
^XMB(3.9,146104,2,598,0)=" ..; cancel this copay with ""pandemic response"" reason"
^XMB(3.9,146104,2,599,0)="""RTN"",""IBAMTC"",182,0)"
^XMB(3.9,146104,2,600,0)=" ..S IBCRES=$O(^IBE(350.3,""B"",""PANDEMIC RESPONSE"",0))"
^XMB(3.9,146104,2,601,0)="""RTN"",""IBAMTC"",183,0)"
^XMB(3.9,146104,2,602,0)=" ..S IBRES=$$CANCEL^IBECEAU6(IBIEN,IBCRES,0,0)"
^XMB(3.9,146104,2,603,0)="""RTN"",""IBAMTC"",184,0)"
^XMB(3.9,146104,2,604,0)=" ..I MSG>0 D"
^XMB(3.9,146104,2,605,0)="""RTN"",""IBAMTC"",185,0)"
^XMB(3.9,146104,2,606,0)=" ...I +IBRES<0 D  Q"
^XMB(3.9,146104,2,607,0)="""RTN"",""IBAMTC"",186,0)"
^XMB(3.9,146104,2,608,0)=" ....S IBECODE=$P(IBRES,U,2),IBEMSG=$S(IBECODE'="""":$P($G(^IBE(350.8,+$O(^IBE(350.8,""AC"",$P(IBECODE,"";""),0)),0)),U,2),1:$P(IBRES,U,3))"
^XMB(3.9,146104,2,609,0)="""RTN"",""IBAMTC"",187,0)"
^XMB(3.9,146104,2,610,0)=" ....S ^TMP(""IBAMTC3"",$J,0,$P(IBN0,U))=$P(IBN0,U,11)_U_IBEMSG Q"
^XMB(3.9,146104,2,611,0)="""RTN"",""IBAMTC"",188,0)"
^XMB(3.9,146104,2,612,0)=" ....Q"
^XMB(3.9,146104,2,613,0)="""RTN"",""IBAMTC"",189,0)"
^XMB(3.9,146104,2,614,0)=" ...I MSG<2 S ^TMP(""IBAMTC3"",$J,1,$P(IBN0,U))=$P(IBN0,U,11)"
^XMB(3.9,146104,2,615,0)="""RTN"",""IBAMTC"",190,0)"
^XMB(3.9,146104,2,616,0)=" ..Q"
^XMB(3.9,146104,2,617,0)="""RTN"",""IBAMTC"",191,0)"
^XMB(3.9,146104,2,618,0)=" .Q"
^XMB(3.9,146104,2,619,0)="""RTN"",""IBAMTC"",192,0)"
^XMB(3.9,146104,2,620,0)=" ; send Mailman bulletin"
^XMB(3.9,146104,2,621,0)="""RTN"",""IBAMTC"",193,0)"
^XMB(3.9,146104,2,622,0)=" I MSG D CANCBLTN^IBAMTC3 K ^TMP(""IBAMTC3"",$J)"
^XMB(3.9,146104,2,623,0)="""RTN"",""IBAMTC"",194,0)"
^XMB(3.9,146104,2,624,0)=" Q"
^XMB(3.9,146104,2,625,0)="""RTN"",""IBAMTC"",195,0)"
^XMB(3.9,146104,2,626,0)=" ;"
^XMB(3.9,146104,2,627,0)="""RTN"",""IBAMTC"",196,0)"
^XMB(3.9,146104,2,628,0)="KILL1 ; Kill all IB variables."
^XMB(3.9,146104,2,629,0)="""RTN"",""IBAMTC"",197,0)"
^XMB(3.9,146104,2,630,0)=" K VAERR,VAEL,VAIP,IBA,IBADMDT,IBAFY,IBATYP,IBBDT,IBBS,IBCHARG,IBCHG,IBCNT,IBCUR,IBDESC,IBDISDT,IBDT,IBDUZ,IBFAC,IBI,IBIL,IBJOB,IBLC,IBMAX"
^XMB(3.9,146104,2,631,0)="""RTN"",""IBAMTC"",198,0)"
^XMB(3.9,146104,2,632,0)=" K IBN,IBNOS,IBSAVBS,IBSEQNO,IBSERV,IBSITE,IBSL,IBTRAN,IBX,IBY,IBWHER,IBWARD,IBEDT,IBCHCTY,IBCHPDE,IBERRN,IBASIH,IBRTED"
^XMB(3.9,146104,2,633,0)="""RTN"",""IBAMTC"",199,0)"
^XMB(3.9,146104,2,634,0)="KILL ; Kill all IB variables needed to build charges."
^XMB(3.9,146104,2,635,0)="""RTN"",""IBAMTC"",200,0)"
^XMB(3.9,146104,2,636,0)=" K IBCLCT,IBCLDA,IBCLDT,IBCLDAY,IBCLDOL,IBCHPDA,IBCHCDA,IBCHG,IBCHFR,IBCHTO,IBCHTOTL,IBBS,IBNH"
^XMB(3.9,146104,2,637,0)="""RTN"",""IBAMTC"",201,0)"
^XMB(3.9,146104,2,638,0)=" K IBEVDA,IBEVDT,IBEVCLD,IBEVCAL,IBEVNEW,IBEVOLD,IBMED,IBTOTL,IBDESC,IBIL,IBTRAN,IBATYP,IBDATE"
^XMB(3.9,146104,2,639,0)="""RTN"",""IBAMTC"",202,0)"
^XMB(3.9,146104,2,640,0)=" Q"
^XMB(3.9,146104,2,641,0)="""RTN"",""IBAMTC"",203,0)"
^XMB(3.9,146104,2,642,0)=" ;"
^XMB(3.9,146104,2,643,0)="""RTN"",""IBAMTC"",204,0)"
^XMB(3.9,146104,2,644,0)="UPDTS ; update completion timestamp (350.9/.17)  IB*2.0*760"
^XMB(3.9,146104,2,645,0)="""RTN"",""IBAMTC"",205,0)"
^XMB(3.9,146104,2,646,0)=" N FDA"
^XMB(3.9,146104,2,647,0)="""RTN"",""IBAMTC"",206,0)"
^XMB(3.9,146104,2,648,0)=" S FDA(350.9,""1,"",.17)=$$NOW^XLFDT()"
^XMB(3.9,146104,2,649,0)="""RTN"",""IBAMTC"",207,0)"
^XMB(3.9,146104,2,650,0)=" D FILE^DIE("""",""FDA"")"
^XMB(3.9,146104,2,651,0)="""RTN"",""IBAMTC"",208,0)"
^XMB(3.9,146104,2,652,0)=" Q"
^XMB(3.9,146104,2,653,0)="""RTN"",""IBAMTC"",209,0)"
^XMB(3.9,146104,2,654,0)=" ;"
^XMB(3.9,146104,2,655,0)="""RTN"",""IBAMTC"",210,0)"
^XMB(3.9,146104,2,656,0)="CANCCD ; cancel copays (Cleland-Dole)  IB*2.0*760"
^XMB(3.9,146104,2,657,0)="""RTN"",""IBAMTC"",211,0)"
^XMB(3.9,146104,2,658,0)=" N DFN,IBCRES,IBDTM,IBERROR,IBEVDT,IBFREE,IBIEN,IBIEN1,IBN0,IBRTN,IBSTAT,IBVSTIEN,IBVSTAT,STATSTR,Z"
^XMB(3.9,146104,2,659,0)="""RTN"",""IBAMTC"",212,0)"
^XMB(3.9,146104,2,660,0)=" S STATSTR=""^BILLED^HOLD - RATE^HOLD - REVIEW^ON HOLD^""  ; bill statuses to include"
^XMB(3.9,146104,2,661,0)="""RTN"",""IBAMTC"",213,0)"
^XMB(3.9,146104,2,662,0)=" S IBDTM=$$GET1^DIQ(350.9,""1,"",.17,""I"") I IBDTM'>0 S IBDTM=$$FMADD^XLFDT(DT,-1)"
^XMB(3.9,146104,2,663,0)="""RTN"",""IBAMTC"",214,0)"
^XMB(3.9,146104,2,664,0)=" F  S IBDTM=$O(^IB(""D"",IBDTM)) Q:'IBDTM  D"
^XMB(3.9,146104,2,665,0)="""RTN"",""IBAMTC"",215,0)"
^XMB(3.9,146104,2,666,0)=" .S IBIEN=0 F  S IBIEN=$O(^IB(""D"",IBDTM,IBIEN)) Q:'IBIEN  D"
^XMB(3.9,146104,2,667,0)="""RTN"",""IBAMTC"",216,0)"
^XMB(3.9,146104,2,668,0)=" ..S IBN0=^IB(IBIEN,0)  ; file 350, node 0"
^XMB(3.9,146104,2,669,0)="""RTN"",""IBAMTC"",217,0)"
^XMB(3.9,146104,2,670,0)=" ..S IBIEN1=$P(IBN0,U,9)  ; parent charge ien"
^XMB(3.9,146104,2,671,0)="""RTN"",""IBAMTC"",218,0)"
^XMB(3.9,146104,2,672,0)=" ..I IBIEN'=IBIEN1 Q  ; not the parent charge"
^XMB(3.9,146104,2,673,0)="""RTN"",""IBAMTC"",219,0)"
^XMB(3.9,146104,2,674,0)=" ..S IBSTAT=$$GET1^DIQ(350,IBIEN_"","",.05)  ; status from 350/.05 (external)"
^XMB(3.9,146104,2,675,0)="""RTN"",""IBAMTC"",220,0)"
^XMB(3.9,146104,2,676,0)=" ..I STATSTR'[(U_IBSTAT_U) Q  ; only cancel copays with specific status"
^XMB(3.9,146104,2,677,0)="""RTN"",""IBAMTC"",221,0)"
^XMB(3.9,146104,2,678,0)=" ..S IBACT=$G(^IBE(350.1,+$P(IBN0,U,3),0))  ; node 0 in file 350.1 for the action type of this charge"
^XMB(3.9,146104,2,679,0)="""RTN"",""IBAMTC"",222,0)"
^XMB(3.9,146104,2,680,0)=" ..I $P(IBACT,U,5)'=1 Q  ; action type is not ""New"""
^XMB(3.9,146104,2,681,0)="""RTN"",""IBAMTC"",223,0)"
^XMB(3.9,146104,2,682,0)=" ..I $$ISCMPCT(IBIEN) Q  ; COMPACT Act related"
^XMB(3.9,146104,2,683,0)="""RTN"",""IBAMTC"",224,0)"
^XMB(3.9,146104,2,684,0)=" ..I '$$ISCLDL(IBIEN) Q  ; not Cleland-Dole eligible"
^XMB(3.9,146104,2,685,0)="""RTN"",""IBAMTC"",225,0)"
^XMB(3.9,146104,2,686,0)=" ..S DFN=$P(IBN0,U,2),IBEVDT=$P(IBN0,U,17)"
^XMB(3.9,146104,2,687,0)="""RTN"",""IBAMTC"",226,0)"
^XMB(3.9,146104,2,688,0)=" ..S IBCRES=$O(^IBE(350.3,""B"",""CLELAND-DOLE"",0))"
^XMB(3.9,146104,2,689,0)="""RTN"",""IBAMTC"",227,0)"
^XMB(3.9,146104,2,690,0)=" ..S Z=$$FNDMHVST(DFN,IBEVDT),IBVSTIEN=$P(Z,U),IBVSTAT=$P(Z,U,2)  ; find exisiting visit"
^XMB(3.9,146104,2,691,0)="""RTN"",""IBAMTC"",228,0)"
^XMB(3.9,146104,2,692,0)=" ..S IBFREE=$$GETMHFR(DFN,IBEVDT)  ; 1 if there's a free visit on this date"
^XMB(3.9,146104,2,693,0)="""RTN"",""IBAMTC"",229,0)"
^XMB(3.9,146104,2,694,0)=" ..I IBFREE D  Q"
^XMB(3.9,146104,2,695,0)="""RTN"",""IBAMTC"",230,0)"
^XMB(3.9,146104,2,696,0)=" ...S IBRTN=$$CANCEL^IBECEAU6(IBIEN,IBCRES,0,0)  ; cancel this copay with ""Cleland-Dole"" reason"
^XMB(3.9,146104,2,697,0)="""RTN"",""IBAMTC"",231,0)"
^XMB(3.9,146104,2,698,0)=" ...I IBVSTIEN,IBVSTAT'=1 S IBRTN=$$UPDATE^IBECEAMH(1,IBVSTIEN,4,"""",2,1,.IBERROR)  ; update to visit only"
^XMB(3.9,146104,2,699,0)="""RTN"",""IBAMTC"",232,0)"
^XMB(3.9,146104,2,700,0)=" ...Q"
^XMB(3.9,146104,2,701,0)="""RTN"",""IBAMTC"",233,0)"
^XMB(3.9,146104,2,702,0)=" ..; check if there are free visits available"
^XMB(3.9,146104,2,703,0)="""RTN"",""IBAMTC"",234,0)"
^XMB(3.9,146104,2,704,0)=" ..I $$NUMVSTCK^IBECEAMH(DFN,IBEVDT) D  Q"
^XMB(3.9,146104,2,705,0)="""RTN"",""IBAMTC"",235,0)"
^XMB(3.9,146104,2,706,0)=" ...S IBRTN=$$CANCEL^IBECEAU6(IBIEN,IBCRES,0,0)  ; cancel this copay with ""Cleland-Dole"" reason"
^XMB(3.9,146104,2,707,0)="""RTN"",""IBAMTC"",236,0)"
^XMB(3.9,146104,2,708,0)=" ...I IBVSTIEN,IBVSTAT'=1 S IBRTN=$$UPDATE^IBECEAMH(1,IBVSTIEN,1,"""",2,1,.IBERROR) Q  ; update to free visit"
^XMB(3.9,146104,2,709,0)="""RTN"",""IBAMTC"",237,0)"
^XMB(3.9,146104,2,710,0)=" ...; if there's no visit for this date, add a free visit"
^XMB(3.9,146104,2,711,0)="""RTN"",""IBAMTC"",238,0)"
^XMB(3.9,146104,2,712,0)=" ...I 'IBVSTIEN D ADDVST^IBECEAMH(DFN,IBEVDT,"""",1,2)"
^XMB(3.9,146104,2,713,0)="""RTN"",""IBAMTC"",239,0)"
^XMB(3.9,146104,2,714,0)=" ...Q"
^XMB(3.9,146104,2,715,0)="""RTN"",""IBAMTC"",240,0)"
^XMB(3.9,146104,2,716,0)=" ..I $O(^IBMH(351.83,""D"",IBIEN,"""")) Q  ; corresponding MH visit entry already exists"
^XMB(3.9,146104,2,717,0)="""RTN"",""IBAMTC"",241,0)"
^XMB(3.9,146104,2,718,0)=" ..D ADDVST^IBECEAMH(DFN,IBEVDT,IBIEN,2)  ; add ""billed"" MH visit entry"
^XMB(3.9,146104,2,719,0)="""RTN"",""IBAMTC"",242,0)"
^XMB(3.9,146104,2,720,0)=" ..Q"
^XMB(3.9,146104,2,721,0)="""RTN"",""IBAMTC"",243,0)"
^XMB(3.9,146104,2,722,0)=" .Q"
^XMB(3.9,146104,2,723,0)="""RTN"",""IBAMTC"",244,0)"
^XMB(3.9,146104,2,724,0)=" Q"
^XMB(3.9,146104,2,725,0)="""RTN"",""IBAMTC"",245,0)"
^XMB(3.9,146104,2,726,0)=" ;"
^XMB(3.9,146104,2,727,0)="""RTN"",""IBAMTC"",246,0)"
^XMB(3.9,146104,2,728,0)="UPDCANC(IBIEN) ; update MH visit tracking for cancelled copay"
^XMB(3.9,146104,2,729,0)="""RTN"",""IBAMTC"",247,0)"
^XMB(3.9,146104,2,730,0)=" N IBERROR,IBRTN,IBSTAT,IBVSTIEN"
^XMB(3.9,146104,2,731,0)="""RTN"",""IBAMTC"",248,0)"
^XMB(3.9,146104,2,732,0)=" I 'IBIEN Q"
^XMB(3.9,146104,2,733,0)="""RTN"",""IBAMTC"",249,0)"
^XMB(3.9,146104,2,734,0)=" S IBSTAT=$$GET1^DIQ(350,IBIEN_"","",.05)  ; status from 350/.05 (external)"
^XMB(3.9,146104,2,735,0)="""RTN"",""IBAMTC"",250,0)"
^XMB(3.9,146104,2,736,0)=" I IBSTAT=""CANCELLED"" D"
^XMB(3.9,146104,2,737,0)="""RTN"",""IBAMTC"",251,0)"
^XMB(3.9,146104,2,738,0)=" .; if there's a ""billed"" visit tracking entry linked to a cancelled copay, change that entry to ""visit only"" / ""duplicate visit"" reason"
^XMB(3.9,146104,2,739,0)="""RTN"",""IBAMTC"",252,0)"
^XMB(3.9,146104,2,740,0)=" .S IBVSTIEN=$O(^IBMH(351.83,""D"",IBIEN,"""")) I 'IBVSTIEN Q"
^XMB(3.9,146104,2,741,0)="""RTN"",""IBAMTC"",253,0)"
^XMB(3.9,146104,2,742,0)=" .I $P(^IBMH(351.83,IBVSTIEN,0),U,4)=2 S IBRTN=$$UPDATE^IBECEAMH(1,IBVSTIEN,4,"""",4,1,.IBERROR)"
