^XMB(3.9,146043,2,784,0)="AUDIT(Y) ; Looks up the audit records for an observation in external format"
^XMB(3.9,146043,2,785,0)="""RTN"",""MDCLIO1"",272,0)"
^XMB(3.9,146043,2,786,0)=" S MDROOT=$NA(^MDC(704.119,""ALOG"",+$O(^MDC(704.117,""PK"",Y,0))))"
^XMB(3.9,146043,2,787,0)="""RTN"",""MDCLIO1"",273,0)"
^XMB(3.9,146043,2,788,0)=" Q"
^XMB(3.9,146043,2,789,0)="""RTN"",""MDCLIO1"",274,0)"
^XMB(3.9,146043,2,790,0)="QUAL ; Retrieves all qualifiers for an observation - MDIENS = iens of observation from MDCLIO"
^XMB(3.9,146043,2,791,0)="""RTN"",""MDCLIO1"",275,0)"
^XMB(3.9,146043,2,792,0)=" N MDQUAL"
^XMB(3.9,146043,2,793,0)="""RTN"",""MDCLIO1"",276,0)"
^XMB(3.9,146043,2,794,0)=" F MDQUAL=0:0 S MDQUAL=$O(^MDC(704.118,""PK"",+MDIENS,MDQUAL)) Q:'MDQUAL  D"
^XMB(3.9,146043,2,795,0)="""RTN"",""MDCLIO1"",277,0)"
^XMB(3.9,146043,2,796,0)=" .D XMLDATA^MDCLIO($$GET1^DIQ(704.101,MDQUAL_"","","".05:.02"",""I""),$$GET1^DIQ(704.101,MDQUAL_"","","".01"",""I""))"
^XMB(3.9,146043,2,797,0)="""RTN"",""MDCLIO1"",278,0)"
^XMB(3.9,146043,2,798,0)=" Q"
^XMB(3.9,146043,2,799,0)="""RTN"",""MDCLIO1"",279,0)"
^XMB(3.9,146043,2,800,0)="SETS ; Retrieve the sets this observation belongs to"
^XMB(3.9,146043,2,801,0)="""RTN"",""MDCLIO1"",280,0)"
^XMB(3.9,146043,2,802,0)=" D XMLHDR^MDCLIO(""SETS"")"
^XMB(3.9,146043,2,803,0)="""RTN"",""MDCLIO1"",281,0)"
^XMB(3.9,146043,2,804,0)=" N MDSET F MDSET=0:0 S MDSET=$O(^MDC(704.1161,""AS"",+MDIENS,MDSET)) Q:'MDSET  D"
^XMB(3.9,146043,2,805,0)="""RTN"",""MDCLIO1"",282,0)"
^XMB(3.9,146043,2,806,0)=" .F MDX=0:0 S MDX=$O(^MDC(704.1161,""AS"",+MDIENS,MDSET,MDX)) Q:'MDX  D"
^XMB(3.9,146043,2,807,0)="""RTN"",""MDCLIO1"",283,0)"
^XMB(3.9,146043,2,808,0)=" ..D XMLHDR^MDCLIO(""SET"")"
^XMB(3.9,146043,2,809,0)="""RTN"",""MDCLIO1"",284,0)"
^XMB(3.9,146043,2,810,0)=" ..D XMLDATA^MDCLIO(""VALUE"",$$GET1^DIQ(704.1161,MDX_"","",.01))"
^XMB(3.9,146043,2,811,0)="""RTN"",""MDCLIO1"",285,0)"
^XMB(3.9,146043,2,812,0)=" ..D XMLFTR^MDCLIO(""SET"")"
^XMB(3.9,146043,2,813,0)="""RTN"",""MDCLIO1"",286,0)"
