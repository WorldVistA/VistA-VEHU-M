^XMB(3.9,146057,2,195,0)="""QUES"",""XPI1"",""M"")"
^XMB(3.9,146057,2,196,0)="D XPI1^XPDIQ"
^XMB(3.9,146057,2,197,0)="""QUES"",""XPM1"",0)"
^XMB(3.9,146057,2,198,0)="PO^VA(200,:EM"
^XMB(3.9,146057,2,199,0)="""QUES"",""XPM1"",""??"")"
^XMB(3.9,146057,2,200,0)="^D MG^XPDH"
^XMB(3.9,146057,2,201,0)="""QUES"",""XPM1"",""A"")"
^XMB(3.9,146057,2,202,0)="Enter the Coordinator for Mail Group '|FLAG|'"
