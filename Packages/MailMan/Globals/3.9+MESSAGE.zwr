^XMB(3.9,146090,2,526,0)=" Q"
^XMB(3.9,146090,2,527,0)="""RTN"",""PSOSPML4"",144,0)"
^XMB(3.9,146090,2,528,0)=" ;"
^XMB(3.9,146090,2,529,0)="""RTN"",""PSOSPML4"",145,0)"
^XMB(3.9,146090,2,530,0)="EXPORT ; - Export Rx"
^XMB(3.9,146090,2,531,0)="""RTN"",""PSOSPML4"",146,0)"
^XMB(3.9,146090,2,532,0)=" N STATEIEN,PSOASVER,PSOTXRTS,BATIEN,DIR,X,Y,DIRUT,DUOUT,RECTYPE,SCREEN,DFN,PSOSECK,STATELST,LST,MBMST"
^XMB(3.9,146090,2,533,0)="""RTN"",""PSOSPML4"",147,0)"
^XMB(3.9,146090,2,534,0)=" S VALMBCK=""R"""
^XMB(3.9,146090,2,535,0)="""RTN"",""PSOSPML4"",148,0)"
^XMB(3.9,146090,2,536,0)=" ;"
^XMB(3.9,146090,2,537,0)="""RTN"",""PSOSPML4"",149,0)"
^XMB(3.9,146090,2,538,0)=" D FULL^VALM1"
^XMB(3.9,146090,2,539,0)="""RTN"",""PSOSPML4"",150,0)"
^XMB(3.9,146090,2,540,0)=" S SCREEN=$$SCREEN^PSOSPMUT(RXIEN,FILLNUM)"
^XMB(3.9,146090,2,541,0)="""RTN"",""PSOSPML4"",151,0)"
^XMB(3.9,146090,2,542,0)=" I +SCREEN D  Q:$P(SCREEN,""^"",3)=""E"""
^XMB(3.9,146090,2,543,0)="""RTN"",""PSOSPML4"",152,0)"
^XMB(3.9,146090,2,544,0)=" . W $C(7) I $P(SCREEN,""^"",3)=""E"" S VALMSG=$P(SCREEN,""^"",2) Q"
^XMB(3.9,146090,2,545,0)="""RTN"",""PSOSPML4"",153,0)"
^XMB(3.9,146090,2,546,0)=" . W !!,""WARNING: "",$P(SCREEN,""^"",2)"
^XMB(3.9,146090,2,547,0)="""RTN"",""PSOSPML4"",154,0)"
^XMB(3.9,146090,2,548,0)=" ;"
^XMB(3.9,146090,2,549,0)="""RTN"",""PSOSPML4"",155,0)"
^XMB(3.9,146090,2,550,0)=" ;p810 PSOASVER needs to be defined for help menu"
^XMB(3.9,146090,2,551,0)="""RTN"",""PSOSPML4"",156,0)"
^XMB(3.9,146090,2,552,0)=" I '$G(PSOASVER) D"
^XMB(3.9,146090,2,553,0)="""RTN"",""PSOSPML4"",157,0)"
^XMB(3.9,146090,2,554,0)=" . N STATE"
^XMB(3.9,146090,2,555,0)="""RTN"",""PSOSPML4"",158,0)"
^XMB(3.9,146090,2,556,0)=" . S STATE=$$RXSTATE^PSOBPSUT(RXIEN,0)"
^XMB(3.9,146090,2,557,0)="""RTN"",""PSOSPML4"",159,0)"
^XMB(3.9,146090,2,558,0)=" . S PSOASVER=$$GET1^DIQ(58.41,STATE,1,""I"") S:PSOASVER="""" PSOASVER=""4.2"""
^XMB(3.9,146090,2,559,0)="""RTN"",""PSOSPML4"",160,0)"
^XMB(3.9,146090,2,560,0)=" ;"
^XMB(3.9,146090,2,561,0)="""RTN"",""PSOSPML4"",161,0)"
^XMB(3.9,146090,2,562,0)=" K DIR S DIR(""A"")=""Record Type"""
^XMB(3.9,146090,2,563,0)="""RTN"",""PSOSPML4"",162,0)"
^XMB(3.9,146090,2,564,0)=" S DIR(""L"",1)=""Enter the type of record to be sent for this prescription fill:"""
^XMB(3.9,146090,2,565,0)="""RTN"",""PSOSPML4"",163,0)"
^XMB(3.9,146090,2,566,0)=" S DIR(""L"",2)="" """
^XMB(3.9,146090,2,567,0)="""RTN"",""PSOSPML4"",164,0)"
^XMB(3.9,146090,2,568,0)=" ; PSO*7*625: PSU-14 Begin"
^XMB(3.9,146090,2,569,0)="""RTN"",""PSOSPML4"",165,0)"
^XMB(3.9,146090,2,570,0)=" S PSOSECK=$$SECKEY^PSOSPMA3()"
^XMB(3.9,146090,2,571,0)="""RTN"",""PSOSPML4"",166,0)"
^XMB(3.9,146090,2,572,0)=" S DIR(""??"")=""^D ASAPHELP^PSOSPMU2(PSOASVER,""""DSP"""",1)"""
^XMB(3.9,146090,2,573,0)="""RTN"",""PSOSPML4"",167,0)"
^XMB(3.9,146090,2,574,0)=" I $$RXRLDT^PSOBPSUT(RXIEN,FILLNUM) D"
^XMB(3.9,146090,2,575,0)="""RTN"",""PSOSPML4"",168,0)"
^XMB(3.9,146090,2,576,0)=" . S DIR(""PRE"")=""D VRECMSG^PSOSPML4(X,RXIEN,FILLNUM,PSOSECK)"""
^XMB(3.9,146090,2,577,0)="""RTN"",""PSOSPML4"",169,0)"
^XMB(3.9,146090,2,578,0)=" . S DIR(0)=""S^N:NEW;R:REVISE""_$S($G(PSOSECK):"";V:VOID"",1:"""")"
^XMB(3.9,146090,2,579,0)="""RTN"",""PSOSPML4"",170,0)"
^XMB(3.9,146090,2,580,0)=" . S DIR(""L"",3)=""  N     NEW"""
^XMB(3.9,146090,2,581,0)="""RTN"",""PSOSPML4"",171,0)"
^XMB(3.9,146090,2,582,0)=" . S DIR(""L"",4)=""  R     REVISE"""
^XMB(3.9,146090,2,583,0)="""RTN"",""PSOSPML4"",172,0)"
^XMB(3.9,146090,2,584,0)=" . S DIR(""L"")=$S($G(PSOSECK):""  V     VOID"",1:"" (V)    VOID"")"
^XMB(3.9,146090,2,585,0)="""RTN"",""PSOSPML4"",173,0)"
^XMB(3.9,146090,2,586,0)=" . ; PSO*7*625: PSU-14 End "
^XMB(3.9,146090,2,587,0)="""RTN"",""PSOSPML4"",174,0)"
^XMB(3.9,146090,2,588,0)=" . S DIR(""B"")=""NEW"""
^XMB(3.9,146090,2,589,0)="""RTN"",""PSOSPML4"",175,0)"
^XMB(3.9,146090,2,590,0)=" E  D"
^XMB(3.9,146090,2,591,0)="""RTN"",""PSOSPML4"",176,0)"
^XMB(3.9,146090,2,592,0)=" . S DIR(0)=""S^V:VOID"""
^XMB(3.9,146090,2,593,0)="""RTN"",""PSOSPML4"",177,0)"
^XMB(3.9,146090,2,594,0)=" . S DIR(""L"")=""  V     VOID RECORD"""
^XMB(3.9,146090,2,595,0)="""RTN"",""PSOSPML4"",178,0)"
^XMB(3.9,146090,2,596,0)=" . S DIR(""B"")=""VOID"""
^XMB(3.9,146090,2,597,0)="""RTN"",""PSOSPML4"",179,0)"
^XMB(3.9,146090,2,598,0)=" D ^DIR I $D(DUOUT)!($D(DIRUT)) K DIRUT,DUOUT,DIR Q"
^XMB(3.9,146090,2,599,0)="""RTN"",""PSOSPML4"",180,0)"
^XMB(3.9,146090,2,600,0)=" S RECTYPE=Y"
^XMB(3.9,146090,2,601,0)="""RTN"",""PSOSPML4"",181,0)"
^XMB(3.9,146090,2,602,0)=" ;"
^XMB(3.9,146090,2,603,0)="""RTN"",""PSOSPML4"",182,0)"
^XMB(3.9,146090,2,604,0)=" W ! K DIR,DTOUT,DUOUT"
^XMB(3.9,146090,2,605,0)="""RTN"",""PSOSPML4"",183,0)"
^XMB(3.9,146090,2,606,0)=" I (RECTYPE'=""V"") D"
^XMB(3.9,146090,2,607,0)="""RTN"",""PSOSPML4"",184,0)"
^XMB(3.9,146090,2,608,0)=" . S DIR(""A"",1)=""The Prescription Fill will be transmitted to the State(s)"",DIR(""A"",2)="""""
^XMB(3.9,146090,2,609,0)="""RTN"",""PSOSPML4"",185,0)"
^XMB(3.9,146090,2,610,0)=" S DIR(""A"")=""Confirm"",DIR(0)=""Y"",DIR(""B"")=""N"""
^XMB(3.9,146090,2,611,0)="""RTN"",""PSOSPML4"",186,0)"
^XMB(3.9,146090,2,612,0)=" D ^DIR I $G(DTOUT)!$G(DUOUT)!'Y Q"
^XMB(3.9,146090,2,613,0)="""RTN"",""PSOSPML4"",187,0)"
^XMB(3.9,146090,2,614,0)=" W ?40,""Please wait..."""
^XMB(3.9,146090,2,615,0)="""RTN"",""PSOSPML4"",188,0)"
^XMB(3.9,146090,2,616,0)=" ;"
^XMB(3.9,146090,2,617,0)="""RTN"",""PSOSPML4"",189,0)"
^XMB(3.9,146090,2,618,0)=" S STATE=$$RXSTATE^PSOBPSUT(RXIEN,0)     ;P662"
^XMB(3.9,146090,2,619,0)="""RTN"",""PSOSPML4"",190,0)"
^XMB(3.9,146090,2,620,0)=" S STATELST=$$RXSTATEP^PSOBPSUT(RXIEN,0,STATE)"
