^XMB(3.9,146096,2,342,0)=" ;       "
^XMB(3.9,146096,2,343,0)="""RTN"",""MAGVAQ01"",47,0)"
^XMB(3.9,146096,2,344,0)=" ; RPC: MAGVA GET ALL QUEUES"
^XMB(3.9,146096,2,345,0)="""RTN"",""MAGVAQ01"",48,0)"
^XMB(3.9,146096,2,346,0)=" ; "
^XMB(3.9,146096,2,347,0)="""RTN"",""MAGVAQ01"",49,0)"
^XMB(3.9,146096,2,348,0)=" ; if error found during execution"
^XMB(3.9,146096,2,349,0)="""RTN"",""MAGVAQ01"",50,0)"
^XMB(3.9,146096,2,350,0)=" ;   MAGRY(0) = Failure status ^ ""Error getting the list"""
^XMB(3.9,146096,2,351,0)="""RTN"",""MAGVAQ01"",51,0)"
^XMB(3.9,146096,2,352,0)=" ; if success"
^XMB(3.9,146096,2,353,0)="""RTN"",""MAGVAQ01"",52,0)"
^XMB(3.9,146096,2,354,0)=" ;   MAGRY(0)    = Success status ^^#CNT - where #CNT is a number of records returned"
^XMB(3.9,146096,2,355,0)="""RTN"",""MAGVAQ01"",53,0)"
^XMB(3.9,146096,2,356,0)=" ;   MAGRY(1)    = ""^"" delimited string with all field names in Queue "
^XMB(3.9,146096,2,357,0)="""RTN"",""MAGVAQ01"",54,0)"
^XMB(3.9,146096,2,358,0)=" ;   MAGRY(2..n) = ""^"" delimited string with values of fields listed in MAGRY(1) "
^XMB(3.9,146096,2,359,0)="""RTN"",""MAGVAQ01"",55,0)"
^XMB(3.9,146096,2,360,0)=" ;"
^XMB(3.9,146096,2,361,0)="""RTN"",""MAGVAQ01"",56,0)"
^XMB(3.9,146096,2,362,0)="GETQUEUE(MAGRY) ; RPC [MAGVA GET ALL QUEUES]"
^XMB(3.9,146096,2,363,0)="""RTN"",""MAGVAQ01"",57,0)"
^XMB(3.9,146096,2,364,0)=" D GALLLST^MAGVAF03(.MAGRY,2006.927,"""")"
^XMB(3.9,146096,2,365,0)="""RTN"",""MAGVAQ01"",58,0)"
^XMB(3.9,146096,2,366,0)=" ;"
^XMB(3.9,146096,2,367,0)="""RTN"",""MAGVAQ01"",59,0)"
^XMB(3.9,146096,2,368,0)=" ;*****  Add a record to QUEUE MESSAGE file (#2006.928)"
