^XMB(3.9,146087,2,3569,0)="""RTN"",""YTQRQAD4"",271,0)"
^XMB(3.9,146087,2,3570,0)=" .S (LSTADMIN,LSTDT)="""",STAFF=""false""  ;LSTINST set up from call to ASMTIDA2"
^XMB(3.9,146087,2,3571,0)="""RTN"",""YTQRQAD4"",272,0)"
^XMB(3.9,146087,2,3572,0)=" .S LSTDT=$O(LSTINST(TSTIEN,""""),-1) I LSTDT'="""" S LSTADMIN=$O(LSTINST(TSTIEN,LSTDT,""""),-1),STAFF=LSTINST(TSTIEN,LSTDT,LSTADMIN)"
^XMB(3.9,146087,2,3573,0)="""RTN"",""YTQRQAD4"",273,0)"
^XMB(3.9,146087,2,3574,0)=" .S XSTR=""{""""instrumentName"""":""""""_NAME_"""""",""""lastDone"""":""""""_$P($$FMTE^XLFDT($P(LSTDT,""."")),"":"",1,2)_"""""",""""adminId"""":""""""_XADMIN_"""""",""""instrumentComplete"""":""""""_CMPL_"""""",""""staffOnly"""":""_STAFF"
