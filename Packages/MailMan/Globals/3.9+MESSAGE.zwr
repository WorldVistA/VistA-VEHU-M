^XMB(3.9,146009,2,963,0)="""RTN"",""XUMVINPB"",143,0)"
^XMB(3.9,146009,2,964,0)=" S XUGBL=""^TMP(""_""""""XUMVINPB""""""_"",""_$J_"")"""
^XMB(3.9,146009,2,965,0)="""RTN"",""XUMVINPB"",144,0)"
^XMB(3.9,146009,2,966,0)=" K @XUGBL"
^XMB(3.9,146009,2,967,0)="""RTN"",""XUMVINPB"",145,0)"
^XMB(3.9,146009,2,968,0)=" ;"
^XMB(3.9,146009,2,969,0)="""RTN"",""XUMVINPB"",146,0)"
^XMB(3.9,146009,2,970,0)=" I '$D(XUDUZ) S XUDUZ=.9 ;skip over postmaster and shared mail"
^XMB(3.9,146009,2,971,0)="""RTN"",""XUMVINPB"",147,0)"
^XMB(3.9,146009,2,972,0)=" S LINETAG=$$LINETAG() ;get line label for type of extract requested"
^XMB(3.9,146009,2,973,0)="""RTN"",""XUMVINPB"",148,0)"
^XMB(3.9,146009,2,974,0)=" ;"
^XMB(3.9,146009,2,975,0)="""RTN"",""XUMVINPB"",149,0)"
^XMB(3.9,146009,2,976,0)=" ;lets only get the labels once per bulk run"
^XMB(3.9,146009,2,977,0)="""RTN"",""XUMVINPB"",150,0)"
^XMB(3.9,146009,2,978,0)=" S FILE=200"
^XMB(3.9,146009,2,979,0)="""RTN"",""XUMVINPB"",151,0)"
^XMB(3.9,146009,2,980,0)=" S FLDS="".01;.111;.112;.113;.114;.115;.116;.132;.151;4;5;7;8;9;9.2;16*;10.1;29;205.1;205.2;205.3;205.4;205.5;501.1;41.99;53.2;747.44;201;203*;51*;8910*;101.13*"""
^XMB(3.9,146009,2,981,0)="""RTN"",""XUMVINPB"",152,0)"
^XMB(3.9,146009,2,982,0)=" ;**819 STORY VAMPI-29086 (jfw) - Additional Fields | DBIA #10141 Supported (PATCH^XPDUTL)"
^XMB(3.9,146009,2,983,0)="""RTN"",""XUMVINPB"",153,0)"
^XMB(3.9,146009,2,984,0)=" S FLDS=FLDS_"";8932.1*;53.1;53.11;53.4;53.5;53.6;53.9;53.91;53.92;55.1;55.2;55.3;55.4;55.5;55.6""_$S($$PATCH^XPDUTL(""XU*8.0*688""):"";9001;53.21*"",1:"""")_"";20.2;20.3"""
^XMB(3.9,146009,2,985,0)="""RTN"",""XUMVINPB"",154,0)"
^XMB(3.9,146009,2,986,0)=" F I=1:1:$L(FLDS,"";"") S FLD=$P($P(FLDS,"";"",I),""*"") D"
^XMB(3.9,146009,2,987,0)="""RTN"",""XUMVINPB"",155,0)"
^XMB(3.9,146009,2,988,0)=" .D FIELD^DID(FILE,FLD,"""",""LABEL"",""FLDNM(FILE,FLD)"")"
^XMB(3.9,146009,2,989,0)="""RTN"",""XUMVINPB"",156,0)"
^XMB(3.9,146009,2,990,0)=" .I FLD=16 S SFILE=200.02,SFLD=.01 D FIELD^DID(SFILE,SFLD,"""",""LABEL"",""FLDNM(SFILE,SFLD)"") ;division multiple"
^XMB(3.9,146009,2,991,0)="""RTN"",""XUMVINPB"",157,0)"
^XMB(3.9,146009,2,992,0)=" .I FLD=10.1 S SFILE=20 F SFLD=1,2,3,4,5,6 D FIELD^DID(SFILE,SFLD,"""",""LABEL"",""FLDNM(SFILE,SFLD)"") ;name components"
^XMB(3.9,146009,2,993,0)="""RTN"",""XUMVINPB"",158,0)"
^XMB(3.9,146009,2,994,0)=" .I FLD=51 S SFILE=200.051,SFLD=.01 D FIELD^DID(SFILE,SFLD,"""",""LABEL"",""FLDNM(SFILE,SFLD)"") ;keys"
^XMB(3.9,146009,2,995,0)="""RTN"",""XUMVINPB"",159,0)"
^XMB(3.9,146009,2,996,0)=" .I FLD=101.13 S SFILE=200.010113 F SFLD=.01,.02,.03 D FIELD^DID(SFILE,SFLD,"""",""LABEL"",""FLDNM(SFILE,SFLD)"") ;cprs tab multiple"
^XMB(3.9,146009,2,997,0)="""RTN"",""XUMVINPB"",160,0)"
^XMB(3.9,146009,2,998,0)=" .I FLD=203 S SFILE=200.03,SFLD=.01 D FIELD^DID(SFILE,SFLD,"""",""LABEL"",""FLDNM(SFILE,SFLD)"") ;secondary menu options multiple"
^XMB(3.9,146009,2,999,0)="""RTN"",""XUMVINPB"",161,0)"
^XMB(3.9,146009,2,1000,0)=" .I FLD=8910 S SFILE=200.06 F SFLD=.01,2 D FIELD^DID(SFILE,SFLD,"""",""LABEL"",""FLDNM(SFILE,SFLD)"") ;visited from multiple"
^XMB(3.9,146009,2,1001,0)="""RTN"",""XUMVINPB"",162,0)"
^XMB(3.9,146009,2,1002,0)=" .;**819 STORY VAMPI-29086 (jfw) - New multiples added"
