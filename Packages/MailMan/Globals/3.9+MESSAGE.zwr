^XMB(3.9,146056,2,862,0)=" ;"
^XMB(3.9,146056,2,863,0)="""RTN"",""VPR1P37"",28,0)"
^XMB(3.9,146056,2,864,0)=" ; This code is called from the HealthShare CallToPopulate utility to"
^XMB(3.9,146056,2,865,0)="""RTN"",""VPR1P37"",29,0)"
^XMB(3.9,146056,2,866,0)=" ; resend records corrected by VPR*1*36 in:"
^XMB(3.9,146056,2,867,0)="""RTN"",""VPR1P37"",30,0)"
^XMB(3.9,146056,2,868,0)=" ;    Observation           - Vital Observations missing Unit of Measure"
^XMB(3.9,146056,2,869,0)="""RTN"",""VPR1P37"",31,0)"
^XMB(3.9,146056,2,870,0)=" ;"
^XMB(3.9,146056,2,871,0)="""RTN"",""VPR1P37"",32,0)"
^XMB(3.9,146056,2,872,0)=" ;"
^XMB(3.9,146056,2,873,0)="""RTN"",""VPR1P37"",33,0)"
^XMB(3.9,146056,2,874,0)="EN(START,STOP,TYPE,FMT,PAT,VPRY) ; -- entry point to test CTP"
^XMB(3.9,146056,2,875,0)="""RTN"",""VPR1P37"",34,0)"
^XMB(3.9,146056,2,876,0)=" N VPRBDT,VPREDT,VPRTYPE,VPRPAT,VPRPT,VPRFMT,VPRII,VPRN,VPR37"
^XMB(3.9,146056,2,877,0)="""RTN"",""VPR1P37"",35,0)"
^XMB(3.9,146056,2,878,0)=" S VPRBDT=$G(START,3190401)"
^XMB(3.9,146056,2,879,0)="""RTN"",""VPR1P37"",36,0)"
^XMB(3.9,146056,2,880,0)=" S VPR37=$$PATCH(37)"
