^XMB(3.9,146012,2,484,0)="EN ; Entry point for the RX Action in the Patient Centric View"
^XMB(3.9,146012,2,485,0)="""RTN"",""PSOERRX0"",5,0)"
^XMB(3.9,146012,2,486,0)=" N STSFLTR,MATFLTR,REDTFLTR,PRVFLTR,DRGFLTR,MSTPFLTR,MTARR,PSODETDP,VDRGFLTR,STSRMARY,RESARY,DNDARY,RXREQARY"
^XMB(3.9,146012,2,487,0)="""RTN"",""PSOERRX0"",6,0)"
