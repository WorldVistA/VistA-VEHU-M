^XMB(3.9,146087,2,710,0)=" . S ^TMP(""YTQ-JSON"",$J,1,0)=""{}"",YTQRRSLT=$NA(^TMP(""YTQ-JSON"",$J))"
^XMB(3.9,146087,2,711,0)="""RTN"",""YTQRCDB"",36,0)"
