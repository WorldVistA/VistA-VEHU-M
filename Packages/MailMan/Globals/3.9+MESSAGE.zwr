^XMB(3.9,146098,2,953,0)="""RTN"",""SDES2APTLETTER"",155,0)"
^XMB(3.9,146098,2,954,0)=" .S SDCL=""XRAY"",SDX=$$GET1^DIQ(2.98,PTAPPIENS,6,""I"") D FORM(SDC,SDCL,SDX,1)"
^XMB(3.9,146098,2,955,0)="""RTN"",""SDES2APTLETTER"",156,0)"
^XMB(3.9,146098,2,956,0)=" I $$GET1^DIQ(2.98,PTAPPIENS,7,""I"")]"""" D"
^XMB(3.9,146098,2,957,0)="""RTN"",""SDES2APTLETTER"",157,0)"
^XMB(3.9,146098,2,958,0)=" .S SDCL=""EKG"",SDX=$$GET1^DIQ(2.98,PTAPPIENS,7,""I"") D FORM(SDC,SDCL,SDX,1)"
^XMB(3.9,146098,2,959,0)="""RTN"",""SDES2APTLETTER"",158,0)"
^XMB(3.9,146098,2,960,0)=" S (SDX,X)=SDX1"
^XMB(3.9,146098,2,961,0)="""RTN"",""SDES2APTLETTER"",159,0)"
^XMB(3.9,146098,2,962,0)=" Q"
^XMB(3.9,146098,2,963,0)="""RTN"",""SDES2APTLETTER"",160,0)"
^XMB(3.9,146098,2,964,0)=" ; SD*5.3*622 - add more detail for appointment and format it"
^XMB(3.9,146098,2,965,0)="""RTN"",""SDES2APTLETTER"",161,0)"
^XMB(3.9,146098,2,966,0)=" ; SDC - clinic ien"
^XMB(3.9,146098,2,967,0)="""RTN"",""SDES2APTLETTER"",162,0)"
^XMB(3.9,146098,2,968,0)=" ; SDCL - clinic name or xray/lab/ekg"
^XMB(3.9,146098,2,969,0)="""RTN"",""SDES2APTLETTER"",163,0)"
