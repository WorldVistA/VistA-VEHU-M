^XMB(3.9,146037,2,2762,0)=" . . S $P(^TMP(""RCDPTAR1"",$J,EFTIEN),""^"",10)=RCDIEN   ; Save Deposit IEN, #344.3, PRCA*4.5*439"
^XMB(3.9,146037,2,2763,0)="""RTN"",""RCDPTAR1"",225,0)"
^XMB(3.9,146037,2,2764,0)=" S ^TMP(""RCDPTAR1"",$J)=GTOT"
