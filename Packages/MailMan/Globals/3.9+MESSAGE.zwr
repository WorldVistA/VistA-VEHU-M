^XMB(3.9,146106,2,2890,0)=" . S DUPDATE=$$GET1^DIQ(2.98,$G(APPOINTMENT(""START DATE TIME""))_"",""_$G(APPOINTMENT(""DFN"")),.001,""I"")"
^XMB(3.9,146106,2,2891,0)="""RTN"",""SDES2CREATEAPPT2"",269,0)"
^XMB(3.9,146106,2,2892,0)=" . S DUPSTAT="",""_$$GET1^DIQ(2.98,$G(APPOINTMENT(""START DATE TIME""))_"",""_$G(APPOINTMENT(""DFN"")),3,""I"")_"","""
^XMB(3.9,146106,2,2893,0)="""RTN"",""SDES2CREATEAPPT2"",270,0)"
^XMB(3.9,146106,2,2894,0)=" . I DUPDATE'="""",("",C,PC,""'[DUPSTAT) D ERRLOG^SDESJSON(.ERRORS,176,""Due to system limitations an appointment cannot be made at the same time in different time zones. Please add at least 1 minute to the appointment start time and try again"")"
^XMB(3.9,146106,2,2895,0)="""RTN"",""SDES2CREATEAPPT2"",271,0)"
^XMB(3.9,146106,2,2896,0)=" ;"
