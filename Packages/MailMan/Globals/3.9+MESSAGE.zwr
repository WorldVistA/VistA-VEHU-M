^XMB(3.9,146056,2,2270,0)=" I $G(IEN)<1 S DDEOUT=1 Q"
^XMB(3.9,146056,2,2271,0)="""RTN"",""VPRSDAHX"",62,0)"
^XMB(3.9,146056,2,2272,0)=" D:'$D(^TMP(""WVPREGST"",$J,""BASELINE"")) BASELINE^WVRPCVPR(IEN)"
^XMB(3.9,146056,2,2273,0)="""RTN"",""VPRSDAHX"",63,0)"
