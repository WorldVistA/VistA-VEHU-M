^XMB(3.9,146037,2,2536,0)="ASKDEV(WHICH) ; Prompt user for device"
^XMB(3.9,146037,2,2537,0)="""RTN"",""RCDPTAR1"",112,0)"
^XMB(3.9,146037,2,2538,0)=" ; Input:   WHICH - 0 - Original summary report, 1 - New summary report"
