^XMB(3.9,146012,2,929,0)="""RTN"",""PSOERRX0"",227,0)"
^XMB(3.9,146012,2,930,0)=" K DIR S DIR(""A"")=""SELECT (1-""_+$G(PRVLST(""DILIST"",0))_""): """
