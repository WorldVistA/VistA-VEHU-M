^XMB(3.9,146020,2,1095,0)="""RTN"",""MPIFXMLP"",212,0)"
^XMB(3.9,146020,2,1096,0)=" . I MPIA(""type"")=""NI"",MPIA(""subtype"")=""IDM"" S MPIUSE=""ICN"" Q"
^XMB(3.9,146020,2,1097,0)="""RTN"",""MPIFXMLP"",213,0)"
^XMB(3.9,146020,2,1098,0)=" . ;**74,Story 1258907 (mko): Add storing PIs in the ""IDS"" array; also store the type here as ""IDTYPE"""
^XMB(3.9,146020,2,1099,0)="""RTN"",""MPIFXMLP"",214,0)"
^XMB(3.9,146020,2,1100,0)=" . I ""^NI^PI^PN^EI^NPI^""[(""^""_MPIA(""type"")_""^""),MPIA(""subtype"")="""" S MPIIDS=MPIIDS+1,MPIUSE=""IDS"",@(MPILOC_"",""""IDS"""",""_MPIIDS_"",""""IDTYPE"""")"")=MPIA(""type"") Q"
