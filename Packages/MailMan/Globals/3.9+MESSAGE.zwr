^XMB(3.9,146036,2,3017,0)="""RTN"",""DVBSIGN"",129,0)"
^XMB(3.9,146036,2,3018,0)=" K DIE,DA,DR,X,Y"
^XMB(3.9,146036,2,3019,0)="""RTN"",""DVBSIGN"",130,0)"
^XMB(3.9,146036,2,3020,0)=" S DIE=396.17,DA=DVBIEN,DR=""2////""_DVBTRAINEE"
^XMB(3.9,146036,2,3021,0)="""RTN"",""DVBSIGN"",131,0)"
^XMB(3.9,146036,2,3022,0)=" D ^DIE"
^XMB(3.9,146036,2,3023,0)="""RTN"",""DVBSIGN"",132,0)"
^XMB(3.9,146036,2,3024,0)=" S DVBCKDAT=$P($G(^DVB(396.17,DVBIEN,0)),U,2)"
^XMB(3.9,146036,2,3025,0)="""RTN"",""DVBSIGN"",133,0)"
^XMB(3.9,146036,2,3026,0)=" I DVBCKDAT'=DVBTRAINEE S DVBRTN=""-1^No Update"" Q"
^XMB(3.9,146036,2,3027,0)="""RTN"",""DVBSIGN"",134,0)"
^XMB(3.9,146036,2,3028,0)=" S DVBRTN=1"
^XMB(3.9,146036,2,3029,0)="""RTN"",""DVBSIGN"",135,0)"
^XMB(3.9,146036,2,3030,0)=" K DVBTRAINEE"
^XMB(3.9,146036,2,3031,0)="""RTN"",""DVBSIGN"",136,0)"
^XMB(3.9,146036,2,3032,0)=" Q"
