^XMB(3.9,146089,2,251,0)="""RTN"",""PSOORFI2"")"
^XMB(3.9,146089,2,252,0)="0^5^B100326867"
^XMB(3.9,146089,2,253,0)="""RTN"",""PSOORFI2"",1,0)"
^XMB(3.9,146089,2,254,0)="PSOORFI2 ;BIR/BHW-finish cprs orders cont. ;07/29/96"
^XMB(3.9,146089,2,255,0)="""RTN"",""PSOORFI2"",2,0)"
^XMB(3.9,146089,2,256,0)=" ;;7.0;OUTPATIENT PHARMACY;**7,15,23,27,46,130,146,177,222,225,338,313,408,612,770**;DEC 1997;Build 0"
^XMB(3.9,146089,2,257,0)="""RTN"",""PSOORFI2"",3,0)"
^XMB(3.9,146089,2,258,0)=" ;External reference ^YSCL(603.01 supported by DBIA 2697"
^XMB(3.9,146089,2,259,0)="""RTN"",""PSOORFI2"",4,0)"
^XMB(3.9,146089,2,260,0)=" ;External references PSOL and PSOUL^PSSLOCK supported by DBIA 2789"
^XMB(3.9,146089,2,261,0)="""RTN"",""PSOORFI2"",5,0)"
^XMB(3.9,146089,2,262,0)=" ;External reference to EN1^ORCFLAG is supported by DBIA 3620"
^XMB(3.9,146089,2,263,0)="""RTN"",""PSOORFI2"",6,0)"
^XMB(3.9,146089,2,264,0)="HLP W !,""Enter 'S' to process orders with a priority of STAT"",!,""      'E' to process orders with an Emergency priority,"",!,""      'R' to process Routine orders."",! Q"
^XMB(3.9,146089,2,265,0)="""RTN"",""PSOORFI2"",7,0)"
^XMB(3.9,146089,2,266,0)="HELP ;"
^XMB(3.9,146089,2,267,0)="""RTN"",""PSOORFI2"",8,0)"
^XMB(3.9,146089,2,268,0)=" W !,""Please enter a minimum of two (2) characters."",!,""Enter Patient's name whose med orders are to be completed."",!"
^XMB(3.9,146089,2,269,0)="""RTN"",""PSOORFI2"",9,0)"
^XMB(3.9,146089,2,270,0)=" S (PATN,DPT)=0 F  S DPT=$O(^PS(52.41,""AOR"",DPT)) Q:'DPT  I $D(^PS(52.41,""AOR"",DPT,PSOPINST)) W !,$P(^DPT(DPT,0),""^"") S PATN=PATN+1 I PATN=20 D  I $D(DUOUT)!($D(DTOUT)) G HELPX"
^XMB(3.9,146089,2,271,0)="""RTN"",""PSOORFI2"",10,0)"
^XMB(3.9,146089,2,272,0)=" .K DIR,DUOUT,DTOUT,DIRUT S DIR(0)=""E"" D ^DIR S PATN=0 K DIR"
^XMB(3.9,146089,2,273,0)="""RTN"",""PSOORFI2"",11,0)"
^XMB(3.9,146089,2,274,0)="HELPX K DTOUT,DUOUT,DIRUT,PAINST S DIR(0)=""FO^2:30"",DIR(""A"")=""Select Patient"",DIR(""?"")=""^D HELP^PSOORFIN"""
^XMB(3.9,146089,2,275,0)="""RTN"",""PSOORFI2"",12,0)"
^XMB(3.9,146089,2,276,0)=" K PATN,DPT Q"
^XMB(3.9,146089,2,277,0)="""RTN"",""PSOORFI2"",13,0)"
^XMB(3.9,146089,2,278,0)="RTE ;"
^XMB(3.9,146089,2,279,0)="""RTN"",""PSOORFI2"",14,0)"
^XMB(3.9,146089,2,280,0)=" S PSZFIN=1"
^XMB(3.9,146089,2,281,0)="""RTN"",""PSOORFI2"",15,0)"
^XMB(3.9,146089,2,282,0)=" F PSZFZZ=0:0 S PSZFZZ=$O(^PS(52.41,""AC"",PAT,$E(PSRT),PSZFZZ)) Q:'PSZFZZ!('PSZFIN)  D"
^XMB(3.9,146089,2,283,0)="""RTN"",""PSOORFI2"",16,0)"
^XMB(3.9,146089,2,284,0)=" .I $P($G(^PS(52.41,PSZFZZ,0)),""^"",3)=""NW""!($P($G(^(0)),""^"",3)=""RNW"")!($P($G(^(0)),""^"",3)=""RF"") I $P($G(^PS(52.41,PSZFZZ,""INI"")),""^"")=$G(PSOPINST) S PSZFIN=0"
^XMB(3.9,146089,2,285,0)="""RTN"",""PSOORFI2"",17,0)"
^XMB(3.9,146089,2,286,0)=" Q"
^XMB(3.9,146089,2,287,0)="""RTN"",""PSOORFI2"",18,0)"
^XMB(3.9,146089,2,288,0)="PRI ;"
^XMB(3.9,146089,2,289,0)="""RTN"",""PSOORFI2"",19,0)"
^XMB(3.9,146089,2,290,0)=" S PSZFIN=1"
^XMB(3.9,146089,2,291,0)="""RTN"",""PSOORFI2"",20,0)"
^XMB(3.9,146089,2,292,0)=" F PSZFZZ=0:0 S PSZFZZ=$O(^PS(52.41,""AP"",PAT,$E(PSRT),PSZFZZ)) Q:'PSZFZZ!('PSZFIN)  D"
^XMB(3.9,146089,2,293,0)="""RTN"",""PSOORFI2"",21,0)"
^XMB(3.9,146089,2,294,0)=" .I $P($G(^PS(52.41,PSZFZZ,0)),""^"",3)=""NW""!($P($G(^(0)),""^"",3)=""RNW"")!($P($G(^(0)),""^"",3)=""RF"") I $P($G(^PS(52.41,PSZFZZ,""INI"")),""^"")=$G(PSOPINST) S PSZFIN=0"
^XMB(3.9,146089,2,295,0)="""RTN"",""PSOORFI2"",22,0)"
^XMB(3.9,146089,2,296,0)=" Q"
^XMB(3.9,146089,2,297,0)="""RTN"",""PSOORFI2"",23,0)"
^XMB(3.9,146089,2,298,0)="PROFILE ;display med profile"
^XMB(3.9,146089,2,299,0)="""RTN"",""PSOORFI2"",24,0)"
^XMB(3.9,146089,2,300,0)=" S MEDA=3 ;3=question asked already"
^XMB(3.9,146089,2,301,0)="""RTN"",""PSOORFI2"",25,0)"
^XMB(3.9,146089,2,302,0)=" W !!! K MEDP,DIR,DUOUT,DIRUT,DTOUT S DIR(0)=""Y"",DIR(""B"")=""Yes"",DIR(""A"")=""Do you want to see Medication Profile"" D ^DIR K DIR Q:$D(DIRUT)!('Y)"
^XMB(3.9,146089,2,303,0)="""RTN"",""PSOORFI2"",26,0)"
^XMB(3.9,146089,2,304,0)=" I Y S MEDP=1"
^XMB(3.9,146089,2,305,0)="""RTN"",""PSOORFI2"",27,0)"
^XMB(3.9,146089,2,306,0)=" K DIR,DUOUT,DIRUT,DTOUT"
^XMB(3.9,146089,2,307,0)="""RTN"",""PSOORFI2"",28,0)"
^XMB(3.9,146089,2,308,0)=" Q"
^XMB(3.9,146089,2,309,0)="""RTN"",""PSOORFI2"",29,0)"
^XMB(3.9,146089,2,310,0)="DC I '$G(PSOORRNW),$G(PSOOPT)=3 S PSORENW(""DFLG"")=1 S:'$D(PSOBBC1(""FROM"")) VALMBCK=""Q"",VALMSG=""Renew Rx Request Canceled."",Y=-1 Q"
^XMB(3.9,146089,2,311,0)="""RTN"",""PSOORFI2"",30,0)"
^XMB(3.9,146089,2,312,0)=" G DC^PSOORFI6"
^XMB(3.9,146089,2,313,0)="""RTN"",""PSOORFI2"",31,0)"
^XMB(3.9,146089,2,314,0)=" Q"
^XMB(3.9,146089,2,315,0)="""RTN"",""PSOORFI2"",32,0)"
^XMB(3.9,146089,2,316,0)="DE Q:'$D(^PS(52.41,ORD,0))"
^XMB(3.9,146089,2,317,0)="""RTN"",""PSOORFI2"",33,0)"
^XMB(3.9,146089,2,318,0)=" K ^PS(52.41,""AOR"",$P(^PS(52.41,ORD,0),""^"",2),+$P($G(^PS(52.41,ORD,""INI"")),""^""),ORD),^PS(52.41,""AD"",$P(^PS(52.41,ORD,0),""^"",12),+$P($G(^PS(52.41,ORD,""INI"")),""^""),ORD)"
^XMB(3.9,146089,2,319,0)="""RTN"",""PSOORFI2"",34,0)"
^XMB(3.9,146089,2,320,0)=" S $P(^PS(52.41,ORD,0),""^"",3)=""DC"",POERR(""PLACER"")=$P(^(0),""^""),POERR(""STAT"")=""OC"""
^XMB(3.9,146089,2,321,0)="""RTN"",""PSOORFI2"",35,0)"
^XMB(3.9,146089,2,322,0)=" S POERR(""COMM"")=$S($G(POERR(""DEAD"")):""Patient died on ""_$G(PSOPTPST(2,PSODFN,.351))_""."",1:ACOM),$P(^PS(52.41,ORD,4),""^"")=POERR(""COMM"")"
^XMB(3.9,146089,2,323,0)="""RTN"",""PSOORFI2"",36,0)"
^XMB(3.9,146089,2,324,0)=" D EN^PSOHLSN(POERR(""PLACER""),POERR(""STAT""),POERR(""COMM""),PSONOOR)"
^XMB(3.9,146089,2,325,0)="""RTN"",""PSOORFI2"",37,0)"
^XMB(3.9,146089,2,326,0)=" I '$G(POERR(""DEAD"")) S DIR(""A"")=""Press Return to Continue"" D PAUSE^VALM1"
^XMB(3.9,146089,2,327,0)="""RTN"",""PSOORFI2"",38,0)"
^XMB(3.9,146089,2,328,0)=" K PSONOOR,PDORUG,ACOM,CMOP,DEA,DEF,DREN,FDR,HDR,PHI,PRC,SIGOK,DIR,DTOUT,DUOUT,DIRUT"
^XMB(3.9,146089,2,329,0)="""RTN"",""PSOORFI2"",39,0)"
^XMB(3.9,146089,2,330,0)=" S Y=-1 Q"
^XMB(3.9,146089,2,331,0)="""RTN"",""PSOORFI2"",40,0)"
^XMB(3.9,146089,2,332,0)=" ;"
^XMB(3.9,146089,2,333,0)="""RTN"",""PSOORFI2"",41,0)"
^XMB(3.9,146089,2,334,0)="RF ;process refill request from CPRS"
^XMB(3.9,146089,2,335,0)="""RTN"",""PSOORFI2"",42,0)"
^XMB(3.9,146089,2,336,0)=" S PSOREF(""IRXN"")=$P(OR0,""^"",19) D PSOL^PSSLOCK($P(OR0,""^"",19)) I '$G(PSOMSG) D  D PAUSE^VALM1 K PSOREF,PSOMSG Q"
^XMB(3.9,146089,2,337,0)="""RTN"",""PSOORFI2"",43,0)"
^XMB(3.9,146089,2,338,0)=" .I $P($G(PSOMSG),""^"",2)'="""" W $C(7),!!,$P(PSOMSG,""^"",2),! Q"
^XMB(3.9,146089,2,339,0)="""RTN"",""PSOORFI2"",44,0)"
^XMB(3.9,146089,2,340,0)=" .W $C(7),!!,""Another person is editing Rx ""_$P(^PSRX($P(OR0,""^"",19),0),""^""),!"
^XMB(3.9,146089,2,341,0)="""RTN"",""PSOORFI2"",45,0)"
^XMB(3.9,146089,2,342,0)=" ;"
^XMB(3.9,146089,2,343,0)="""RTN"",""PSOORFI2"",46,0)"
^XMB(3.9,146089,2,344,0)=" D FULL^VALM1"
^XMB(3.9,146089,2,345,0)="""RTN"",""PSOORFI2"",47,0)"
^XMB(3.9,146089,2,346,0)=" I '$P($G(^PS(52.41,ORD,0)),""^"",23),+$G(^PS(52.41,ORD,""FLG"")) D  I $D(DIRUT)!'Y S VALMBCK=""B"" Q"
^XMB(3.9,146089,2,347,0)="""RTN"",""PSOORFI2"",48,0)"
^XMB(3.9,146089,2,348,0)=" . K DIRUT,DUOUT,DTOUT,DIR"
^XMB(3.9,146089,2,349,0)="""RTN"",""PSOORFI2"",49,0)"
^XMB(3.9,146089,2,350,0)=" . S DIR(""A"",1)=""Flagged by ""_$$GET1^DIQ(52.41,ORD,34)_"" on ""_$$GET1^DIQ(52.41,ORD,33)_"": ""_$$GET1^DIQ(52.41,ORD,35)"
^XMB(3.9,146089,2,351,0)="""RTN"",""PSOORFI2"",50,0)"
^XMB(3.9,146089,2,352,0)=" . S DIR(""A"",2)="""""
^XMB(3.9,146089,2,353,0)="""RTN"",""PSOORFI2"",51,0)"
^XMB(3.9,146089,2,354,0)=" . S DIR(""A"",3)=""Unflagged by ""_$$GET1^DIQ(52.41,ORD,37)_"" on ""_$$GET1^DIQ(52.41,ORD,36)_"": ""_$$GET1^DIQ(52.41,ORD,38)"
^XMB(3.9,146089,2,355,0)="""RTN"",""PSOORFI2"",52,0)"
^XMB(3.9,146089,2,356,0)=" . S DIR(""A"",4)="""""
^XMB(3.9,146089,2,357,0)="""RTN"",""PSOORFI2"",53,0)"
^XMB(3.9,146089,2,358,0)=" . S DIR(0)=""Y"",DIR(""B"")=""YES"",DIR(""A"")=""Continue"""
^XMB(3.9,146089,2,359,0)="""RTN"",""PSOORFI2"",54,0)"
^XMB(3.9,146089,2,360,0)=" . W ! D ^DIR"
^XMB(3.9,146089,2,361,0)="""RTN"",""PSOORFI2"",55,0)"
^XMB(3.9,146089,2,362,0)=" ;"
^XMB(3.9,146089,2,363,0)="""RTN"",""PSOORFI2"",56,0)"
^XMB(3.9,146089,2,364,0)=" I $G(ORD),+$P($G(^PS(52.41,+ORD,0)),""^"",23)=1 D  Q:$D(DIRUT)!'Y  D EN1^ORCFLAG(+$P($G(^PS(52.41,ORD,0)),""^"")) H 1"
^XMB(3.9,146089,2,365,0)="""RTN"",""PSOORFI2"",57,0)"
^XMB(3.9,146089,2,366,0)=" . K DIRUT,DUOUT,DTOUT,DIR"
^XMB(3.9,146089,2,367,0)="""RTN"",""PSOORFI2"",58,0)"
^XMB(3.9,146089,2,368,0)=" . S DIR(""A"",1)=""This Refill Request is flagged. In order to process it"""
^XMB(3.9,146089,2,369,0)="""RTN"",""PSOORFI2"",59,0)"
^XMB(3.9,146089,2,370,0)=" . S DIR(""A"",2)=""you must unflag it first."""
^XMB(3.9,146089,2,371,0)="""RTN"",""PSOORFI2"",60,0)"
^XMB(3.9,146089,2,372,0)=" . S DIR(""A"",3)="""""
^XMB(3.9,146089,2,373,0)="""RTN"",""PSOORFI2"",61,0)"
^XMB(3.9,146089,2,374,0)=" . S DIR(0)=""Y"",DIR(""A"")=""Unflag Refill Request"",DIR(""B"")=""NO"""
^XMB(3.9,146089,2,375,0)="""RTN"",""PSOORFI2"",62,0)"
^XMB(3.9,146089,2,376,0)=" . W ! D ^DIR I $D(DIRUT)!'Y S VALMBCK=""B"""
^XMB(3.9,146089,2,377,0)="""RTN"",""PSOORFI2"",63,0)"
^XMB(3.9,146089,2,378,0)=" I $G(ORD),+$P($G(^PS(52.41,+ORD,0)),""^"",23)=1 Q"
^XMB(3.9,146089,2,379,0)="""RTN"",""PSOORFI2"",64,0)"
^XMB(3.9,146089,2,380,0)=" ;"
^XMB(3.9,146089,2,381,0)="""RTN"",""PSOORFI2"",65,0)"
^XMB(3.9,146089,2,382,0)=" I $$TITRX^PSOUTL(PSOREF(""IRXN""))=""t"" D  D PAUSE^VALM1 K PSOREF Q"
^XMB(3.9,146089,2,383,0)="""RTN"",""PSOORFI2"",66,0)"
^XMB(3.9,146089,2,384,0)=" . W !!,$C(7),""Rx# ""_$P(^PSRX($P(OR0,""^"",19),0),""^"")_"" is marked as 'Titration Rx' and cannot be refilled."""
^XMB(3.9,146089,2,385,0)="""RTN"",""PSOORFI2"",67,0)"
^XMB(3.9,146089,2,386,0)=" ;"
^XMB(3.9,146089,2,387,0)="""RTN"",""PSOORFI2"",68,0)"
^XMB(3.9,146089,2,388,0)=" K PSOMSG S (PSOREF(""DFLG""),PSOREF(""FIELD""),PSOREF1)=0,X=""T-6M"",%DT=""X"" D ^%DT"
^XMB(3.9,146089,2,389,0)="""RTN"",""PSOORFI2"",69,0)"
^XMB(3.9,146089,2,390,0)=" S (PSOID,PSOREF(""ISSUE DATE""))=$S($P(^PSRX(PSOREF(""IRXN""),0),""^"",13)<Y:Y,1:$P(^PSRX(PSOREF(""IRXN""),0),""^"",13))"
^XMB(3.9,146089,2,391,0)="""RTN"",""PSOORFI2"",70,0)"
^XMB(3.9,146089,2,392,0)=" S:$G(PSORX(""BAR CODE""))&($G(PSOBBC1(""FROM""))=""NEW"") PSOREF(""ISSUE DATE"")=DT K X,X1,X2"
^XMB(3.9,146089,2,393,0)="""RTN"",""PSOORFI2"",71,0)"
^XMB(3.9,146089,2,394,0)=" ;"
^XMB(3.9,146089,2,395,0)="""RTN"",""PSOORFI2"",72,0)"
^XMB(3.9,146089,2,396,0)=" S PSONEW(""DAYS SUPPLY"")=$P(^PSRX(PSOREF(""IRXN""),0),""^"",8),PSONEW(""# OF REFILLS"")=$P(^(0),""^"",9)"
^XMB(3.9,146089,2,397,0)="""RTN"",""PSOORFI2"",73,0)"
^XMB(3.9,146089,2,398,0)=" W !!,""Processing Refill Request for Rx ""_$P(^PSRX(PSOREF(""IRXN""),0),""^"")"
^XMB(3.9,146089,2,399,0)="""RTN"",""PSOORFI2"",74,0)"
^XMB(3.9,146089,2,400,0)=" D FILLDT^PSODIR2(.PSOREF) I PSOREF(""DFLG"") S VALMBCK=""R"" G END"
^XMB(3.9,146089,2,401,0)="""RTN"",""PSOORFI2"",75,0)"
