^XMB(3.9,146052,2,1978,0)=" Q"
^XMB(3.9,146052,2,1979,0)="""RTN"",""FBCHVP"",54,0)"
^XMB(3.9,146052,2,1980,0)="SETR ;Set/delete void node on record."
^XMB(3.9,146052,2,1981,0)="""RTN"",""FBCHVP"",55,0)"
^XMB(3.9,146052,2,1982,0)=" S DA=FBI,VP=$S($D(FBVOID):"""",1:""VOID"")"
