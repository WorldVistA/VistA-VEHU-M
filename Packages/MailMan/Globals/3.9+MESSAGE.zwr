^XMB(3.9,146104,2,827,0)="""RTN"",""IBAMTC"",296,0)"
^XMB(3.9,146104,2,828,0)=" ;"
^XMB(3.9,146104,2,829,0)="""RTN"",""IBAMTC"",297,0)"
^XMB(3.9,146104,2,830,0)=" N IBATYP,IBATYPN,IBDATA,RES,Z"
^XMB(3.9,146104,2,831,0)="""RTN"",""IBAMTC"",298,0)"
^XMB(3.9,146104,2,832,0)=" S RES=0 I $G(IBN)'>0 Q 0  ; invalid ien"
^XMB(3.9,146104,2,833,0)="""RTN"",""IBAMTC"",299,0)"
^XMB(3.9,146104,2,834,0)=" S IBDATA=$G(^IB(IBN,0))"
^XMB(3.9,146104,2,835,0)="""RTN"",""IBAMTC"",300,0)"
^XMB(3.9,146104,2,836,0)=" S IBATYP=$P(IBDATA,U,3) I 'IBATYP Q 0"
^XMB(3.9,146104,2,837,0)="""RTN"",""IBAMTC"",301,0)"
^XMB(3.9,146104,2,838,0)=" S IBATYPN=$P($G(^IBE(350.1,IBATYP,0)),U) I IBATYPN'[""OPT"" Q 0  ; not an outpatient charge"
^XMB(3.9,146104,2,839,0)="""RTN"",""IBAMTC"",302,0)"
^XMB(3.9,146104,2,840,0)=" I IBATYPN[""CC MH"" Q 1"
^XMB(3.9,146104,2,841,0)="""RTN"",""IBAMTC"",303,0)"
^XMB(3.9,146104,2,842,0)=" I $$ISCDCANC^IBECEAMH(IBN) Q 1"
^XMB(3.9,146104,2,843,0)="""RTN"",""IBAMTC"",304,0)"
^XMB(3.9,146104,2,844,0)=" S Z=$P($P(IBDATA,U,4),"";"") I $P(Z,"":"")'=""409.68"" Q 0"
^XMB(3.9,146104,2,845,0)="""RTN"",""IBAMTC"",305,0)"
^XMB(3.9,146104,2,846,0)=" Q $$OECHK^IBECEAMH($P(Z,"":"",2),$P(IBDATA,U,17))"
^XMB(3.9,146104,2,847,0)="""RTN"",""IBAMTC"",306,0)"
^XMB(3.9,146104,2,848,0)=" ;"
^XMB(3.9,146104,2,849,0)="""RTN"",""IBAMTC"",307,0)"
^XMB(3.9,146104,2,850,0)="ISCMPCT(IBN) ; check if charge is COMPACT Act related  IB*2.0*760"
^XMB(3.9,146104,2,851,0)="""RTN"",""IBAMTC"",308,0)"
^XMB(3.9,146104,2,852,0)=" ;"
^XMB(3.9,146104,2,853,0)="""RTN"",""IBAMTC"",309,0)"
^XMB(3.9,146104,2,854,0)=" ; IBN - file 350 ien"
^XMB(3.9,146104,2,855,0)="""RTN"",""IBAMTC"",310,0)"
^XMB(3.9,146104,2,856,0)=" ;"
^XMB(3.9,146104,2,857,0)="""RTN"",""IBAMTC"",311,0)"
^XMB(3.9,146104,2,858,0)=" ; returns 1 if charge is COMPACT Act related, 0 otherwise"
^XMB(3.9,146104,2,859,0)="""RTN"",""IBAMTC"",312,0)"
^XMB(3.9,146104,2,860,0)=" ;"
^XMB(3.9,146104,2,861,0)="""RTN"",""IBAMTC"",313,0)"
^XMB(3.9,146104,2,862,0)=" N DFN,IBCHTYPE,I,IBCPTARY,IBDATA,IBDXARY,IBDXLIST,IBPCE,IBRF,IBRFFL,RES"
^XMB(3.9,146104,2,863,0)="""RTN"",""IBAMTC"",314,0)"
^XMB(3.9,146104,2,864,0)=" S RES=0 I $G(IBN)'>0 Q RES  ; invalid ien"
^XMB(3.9,146104,2,865,0)="""RTN"",""IBAMTC"",315,0)"
^XMB(3.9,146104,2,866,0)=" S IBDATA=$G(^IB(IBN,0))"
^XMB(3.9,146104,2,867,0)="""RTN"",""IBAMTC"",316,0)"
^XMB(3.9,146104,2,868,0)=" S DFN=$P(IBDATA,U,2) I '$$ISELIG^IBOMHC(DFN) Q RES  ; patient is not eligible"
^XMB(3.9,146104,2,869,0)="""RTN"",""IBAMTC"",317,0)"
^XMB(3.9,146104,2,870,0)=" ; parse ""resulting from"" field"
^XMB(3.9,146104,2,871,0)="""RTN"",""IBAMTC"",318,0)"
^XMB(3.9,146104,2,872,0)=" S IBRF=$P(IBDATA,U,4) I IBRF'["":"" Q RES"
^XMB(3.9,146104,2,873,0)="""RTN"",""IBAMTC"",319,0)"
^XMB(3.9,146104,2,874,0)=" S IBRFFL=$P(IBRF,"":"")"
^XMB(3.9,146104,2,875,0)="""RTN"",""IBAMTC"",320,0)"
^XMB(3.9,146104,2,876,0)=" ;"
^XMB(3.9,146104,2,877,0)="""RTN"",""IBAMTC"",321,0)"
^XMB(3.9,146104,2,878,0)=" S IBCHTYPE=$P(IBDATA,U,3) I IBCHTYPE="""" Q RES"
^XMB(3.9,146104,2,879,0)="""RTN"",""IBAMTC"",322,0)"
^XMB(3.9,146104,2,880,0)=" I $$GET1^DIQ(350.1,IBCHTYPE,.05,""E"")'=""NEW"" Q RES"
^XMB(3.9,146104,2,881,0)="""RTN"",""IBAMTC"",323,0)"
^XMB(3.9,146104,2,882,0)=" ; If RX copay, quit."
^XMB(3.9,146104,2,883,0)="""RTN"",""IBAMTC"",324,0)"
^XMB(3.9,146104,2,884,0)=" I $$GET1^DIQ(350.1,IBCHTYPE,.11,""I"")=5 Q RES"
^XMB(3.9,146104,2,885,0)="""RTN"",""IBAMTC"",325,0)"
^XMB(3.9,146104,2,886,0)=" D GETDX(.IBDXLIST)"
^XMB(3.9,146104,2,887,0)="""RTN"",""IBAMTC"",326,0)"
^XMB(3.9,146104,2,888,0)=" ; If file is 45 (PTF), lookup the primary and Secondary diagnoses"
^XMB(3.9,146104,2,889,0)="""RTN"",""IBAMTC"",327,0)"
^XMB(3.9,146104,2,890,0)=" I IBRFFL=45 D GETPTFDX^IBOMHC($P(IBRF,"":"",2),.IBDXARY)"
^XMB(3.9,146104,2,891,0)="""RTN"",""IBAMTC"",328,0)"
^XMB(3.9,146104,2,892,0)=" ; If file is 409.68, lookup the diagnoses using OPTDX^IBCSC4D"
^XMB(3.9,146104,2,893,0)="""RTN"",""IBAMTC"",329,0)"
^XMB(3.9,146104,2,894,0)=" I IBRFFL=409.68 S IBPCE=$P(IBRF,"":"",2) D GETPCEDX^IBOMHC(IBPCE,.IBDXARY),GETPCECP^IBOMHC(IBPCE,.IBCPTARY)"
^XMB(3.9,146104,2,895,0)="""RTN"",""IBAMTC"",330,0)"
^XMB(3.9,146104,2,896,0)=" ; If file is 405, grab the PTF or Diagnoses Text Strings."
^XMB(3.9,146104,2,897,0)="""RTN"",""IBAMTC"",331,0)"
^XMB(3.9,146104,2,898,0)=" I IBRFFL=405 D GETPMDX^IBOMHC($P(IBRF,"":"",2),.IBDXARY)"
^XMB(3.9,146104,2,899,0)="""RTN"",""IBAMTC"",332,0)"
^XMB(3.9,146104,2,900,0)=" S I="""" F  S I=$O(IBDXARY(I)) Q:I=""""  D  Q:RES"
^XMB(3.9,146104,2,901,0)="""RTN"",""IBAMTC"",333,0)"
^XMB(3.9,146104,2,902,0)=" .I $D(IBCPTARY(""T2034"")) S RES=1 Q  ; If there's T2034 cpt code, copay is eligible"
^XMB(3.9,146104,2,903,0)="""RTN"",""IBAMTC"",334,0)"
^XMB(3.9,146104,2,904,0)=" .I I=""R45.851"",$D(IBCPTARY(""80939"")) S RES=1 Q  ; If Dx is R45.851 and CPT code is 80939, copay is eligible"
^XMB(3.9,146104,2,905,0)="""RTN"",""IBAMTC"",335,0)"
^XMB(3.9,146104,2,906,0)=" .I $D(IBDXLIST(I)) S RES=1  ; If Dx is one the list, copay is eligible"
^XMB(3.9,146104,2,907,0)="""RTN"",""IBAMTC"",336,0)"
^XMB(3.9,146104,2,908,0)=" .Q"
^XMB(3.9,146104,2,909,0)="""RTN"",""IBAMTC"",337,0)"
^XMB(3.9,146104,2,910,0)=" Q RES"
^XMB(3.9,146104,2,911,0)="""RTN"",""IBAMTC"",338,0)"
^XMB(3.9,146104,2,912,0)=" ;"
^XMB(3.9,146104,2,913,0)="""RTN"",""IBAMTC"",339,0)"
^XMB(3.9,146104,2,914,0)="GETDX(IBDXLIST) ; Populate the list of Comact Act eligible DX codes  IB*2.0*760"
^XMB(3.9,146104,2,915,0)="""RTN"",""IBAMTC"",340,0)"
^XMB(3.9,146104,2,916,0)=" ;"
^XMB(3.9,146104,2,917,0)="""RTN"",""IBAMTC"",341,0)"
^XMB(3.9,146104,2,918,0)=" ; IBDLIST  - resulting array of Dx codes, passed by reference"
^XMB(3.9,146104,2,919,0)="""RTN"",""IBAMTC"",342,0)"
^XMB(3.9,146104,2,920,0)=" ;"
^XMB(3.9,146104,2,921,0)="""RTN"",""IBAMTC"",343,0)"
^XMB(3.9,146104,2,922,0)=" N I,IBDATA,IBDXD"
^XMB(3.9,146104,2,923,0)="""RTN"",""IBAMTC"",344,0)"
^XMB(3.9,146104,2,924,0)=" ; Retrieve Specific Diagnosis codes"
^XMB(3.9,146104,2,925,0)="""RTN"",""IBAMTC"",345,0)"
^XMB(3.9,146104,2,926,0)=" F I=1:1 S IBDATA=$T(DXSLIST+I) S IBDXD=$P(IBDATA,"";"",3) Q:IBDXD=""EXIT""  S IBDXLIST(IBDXD)=0"
^XMB(3.9,146104,2,927,0)="""RTN"",""IBAMTC"",346,0)"
^XMB(3.9,146104,2,928,0)=" ;"
^XMB(3.9,146104,2,929,0)="""RTN"",""IBAMTC"",347,0)"
^XMB(3.9,146104,2,930,0)=" Q"
^XMB(3.9,146104,2,931,0)="""RTN"",""IBAMTC"",348,0)"
^XMB(3.9,146104,2,932,0)=" ;"
^XMB(3.9,146104,2,933,0)="""RTN"",""IBAMTC"",349,0)"
^XMB(3.9,146104,2,934,0)="DXSLIST ; List of Specific Compact Act Related Diagnosis codes  IB*2.0*760"
^XMB(3.9,146104,2,935,0)="""RTN"",""IBAMTC"",350,0)"
^XMB(3.9,146104,2,936,0)=" ;;T14.91XA"
^XMB(3.9,146104,2,937,0)="""RTN"",""IBAMTC"",351,0)"
^XMB(3.9,146104,2,938,0)=" ;;T14.91XD"
^XMB(3.9,146104,2,939,0)="""RTN"",""IBAMTC"",352,0)"
^XMB(3.9,146104,2,940,0)=" ;;T14.91XS"
^XMB(3.9,146104,2,941,0)="""RTN"",""IBAMTC"",353,0)"
^XMB(3.9,146104,2,942,0)=" ;;EXIT"
^XMB(3.9,146104,2,943,0)="""RTN"",""IBAMTC"",354,0)"
^XMB(3.9,146104,2,944,0)=" Q"
^XMB(3.9,146104,2,945,0)="""VER"")"
^XMB(3.9,146104,2,946,0)="8.0^22.2"
^XMB(3.9,146104,2,947,0)="$END KID IB*2.0*807b"
