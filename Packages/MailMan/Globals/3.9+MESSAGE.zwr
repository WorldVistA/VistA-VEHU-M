^XMB(3.9,146098,2,2661,0)="""RTN"",""SDRRISRU"",67,0)"
^XMB(3.9,146098,2,2662,0)=" ; SD*648 - Add delete info"
^XMB(3.9,146098,2,2663,0)="""RTN"",""SDRRISRU"",68,0)"
