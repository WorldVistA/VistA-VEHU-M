^XMB(3.9,146091,2,360,0)=" K ARR"
^XMB(3.9,146091,2,361,0)="""RTN"",""MAGQBUT4"",56,0)"
^XMB(3.9,146091,2,362,0)=" M ARR=ARO"
^XMB(3.9,146091,2,363,0)="""RTN"",""MAGQBUT4"",57,0)"
^XMB(3.9,146091,2,364,0)=" Q"
^XMB(3.9,146091,2,365,0)="""RTN"",""MAGQBUT4"",58,0)"
^XMB(3.9,146091,2,366,0)="MRGMULT(ARR,RT,RTDSC,CT) ;Merge the FM formatted array into a FM File"
^XMB(3.9,146091,2,367,0)="""RTN"",""MAGQBUT4"",59,0)"
^XMB(3.9,146091,2,368,0)=" ;   multiple field."
^XMB(3.9,146091,2,369,0)="""RTN"",""MAGQBUT4"",60,0)"
^XMB(3.9,146091,2,370,0)=" ;   This isn't for general consumption."
^XMB(3.9,146091,2,371,0)="""RTN"",""MAGQBUT4"",61,0)"
^XMB(3.9,146091,2,372,0)=" ; RT = FILE ROOT, RECORD NUMBER, NODE"
^XMB(3.9,146091,2,373,0)="""RTN"",""MAGQBUT4"",62,0)"
^XMB(3.9,146091,2,374,0)=" ; i.e.  ""^MAG(2006.034,44,1,""   -> 44 is the IEN of MAG(2006.34"
^XMB(3.9,146091,2,375,0)="""RTN"",""MAGQBUT4"",63,0)"
^XMB(3.9,146091,2,376,0)=" ; RTDSC is the 2nd piece of the 0 node of the multiple field."
^XMB(3.9,146091,2,377,0)="""RTN"",""MAGQBUT4"",64,0)"
^XMB(3.9,146091,2,378,0)=" S RT=$E(RT,1,$L(RT)-1)_"")"""
^XMB(3.9,146091,2,379,0)="""RTN"",""MAGQBUT4"",65,0)"
^XMB(3.9,146091,2,380,0)=" S @RT@(0)=U_RTDSC_U_CT_U_CT ;  i.e.    ^2006.341A^13^13"
^XMB(3.9,146091,2,381,0)="""RTN"",""MAGQBUT4"",66,0)"
^XMB(3.9,146091,2,382,0)=" M @RT=ARR"
^XMB(3.9,146091,2,383,0)="""RTN"",""MAGQBUT4"",67,0)"
^XMB(3.9,146091,2,384,0)=" Q"
^XMB(3.9,146091,2,385,0)="""RTN"",""MAGQBUT4"",68,0)"
^XMB(3.9,146091,2,386,0)="DDLF(RESULTS,FILE,FIELD,FLAGS,ATTR) ;[MAG FLD ATT]"
^XMB(3.9,146091,2,387,0)="""RTN"",""MAGQBUT4"",69,0)"
^XMB(3.9,146091,2,388,0)=" S X=""ERR^MAGQBTM"",@^%ZOSF(""TRAP"")"
^XMB(3.9,146091,2,389,0)="""RTN"",""MAGQBUT4"",70,0)"
^XMB(3.9,146091,2,390,0)=" K X"
^XMB(3.9,146091,2,391,0)="""RTN"",""MAGQBUT4"",71,0)"
^XMB(3.9,146091,2,392,0)=" N I"
^XMB(3.9,146091,2,393,0)="""RTN"",""MAGQBUT4"",72,0)"
^XMB(3.9,146091,2,394,0)=" D FIELD^DID(FILE,FIELD,FLAGS,ATTR,""RESULTS"",""RESULTS"")"
^XMB(3.9,146091,2,395,0)="""RTN"",""MAGQBUT4"",73,0)"
^XMB(3.9,146091,2,396,0)=" S I=0 F  S I=I+1 Q:'$D(RESULTS(ATTR,I))  M RESULTS(I)=RESULTS(ATTR,I)"
^XMB(3.9,146091,2,397,0)="""RTN"",""MAGQBUT4"",74,0)"
^XMB(3.9,146091,2,398,0)=" Q"
^XMB(3.9,146091,2,399,0)="""RTN"",""MAGQBUT4"",75,0)"
^XMB(3.9,146091,2,400,0)="DDFA(RESULTS) ;[MAG ATT LST]"
^XMB(3.9,146091,2,401,0)="""RTN"",""MAGQBUT4"",76,0)"
