^XMB(3.9,146047,2,2980,0)=" ;"
^XMB(3.9,146047,2,2981,0)="""RTN"",""IBJPI"",5,0)"
^XMB(3.9,146047,2,2982,0)=" ;/vd-IB*2*668 - Removed the SSVI logic introduced with IB*2*528 in its entirety within VistA."
^XMB(3.9,146047,2,2983,0)="""RTN"",""IBJPI"",6,0)"
^XMB(3.9,146047,2,2984,0)=" ;"
^XMB(3.9,146047,2,2985,0)="""RTN"",""IBJPI"",7,0)"
^XMB(3.9,146047,2,2986,0)=" ; eIV - Electronic Insurance Verification Interface parameters"
^XMB(3.9,146047,2,2987,0)="""RTN"",""IBJPI"",8,0)"
^XMB(3.9,146047,2,2988,0)=" ;"
^XMB(3.9,146047,2,2989,0)="""RTN"",""IBJPI"",9,0)"
^XMB(3.9,146047,2,2990,0)="EN ; main entry pt for IBJP IIV SITE PARAMS"
