^XMB(3.9,146091,2,423,0)="""RTN"",""MAGQBUT4"",87,0)"
^XMB(3.9,146091,2,424,0)=" Q"
^XMB(3.9,146091,2,425,0)="""RTN"",""MAGQBUT4"",88,0)"
^XMB(3.9,146091,2,426,0)="KVAL(RESULTS,FLAGS,FDA) ;[MAG KEY VALIDATE]"
^XMB(3.9,146091,2,427,0)="""RTN"",""MAGQBUT4"",89,0)"
^XMB(3.9,146091,2,428,0)=" N TMP,DDRFDA"
^XMB(3.9,146091,2,429,0)="""RTN"",""MAGQBUT4"",90,0)"
^XMB(3.9,146091,2,430,0)=" S X=""ERR^MAGQBTM"",@^%ZOSF(""TRAP"")"
^XMB(3.9,146091,2,431,0)="""RTN"",""MAGQBUT4"",91,0)"
^XMB(3.9,146091,2,432,0)=" K X"
^XMB(3.9,146091,2,433,0)="""RTN"",""MAGQBUT4"",92,0)"
^XMB(3.9,146091,2,434,0)=" D FDASET(.FDA,.DDRFDA)"
