^XMB(3.9,146044,2,663,0)="""RTN"",""PRCABJ"",212,0)"
^XMB(3.9,146044,2,664,0)=" .S Z=$P(^RCD(340,RCDB,0),U) I $P(Z,"";"",2)'=""DPT("" Q"
^XMB(3.9,146044,2,665,0)="""RTN"",""PRCABJ"",213,0)"
^XMB(3.9,146044,2,666,0)=" .S RCDFN=$P(Z,"";""),HRFSFLG=$$CHKHRFS^RCHRFSUT(RCDFN,DT)"
^XMB(3.9,146044,2,667,0)="""RTN"",""PRCABJ"",214,0)"
^XMB(3.9,146044,2,668,0)=" .I HRFSFLG=1 S Z=$$RECALL^RCTCSPU(RCBILL)"
^XMB(3.9,146044,2,669,0)="""RTN"",""PRCABJ"",215,0)"
^XMB(3.9,146044,2,670,0)=" .Q"
^XMB(3.9,146044,2,671,0)="""RTN"",""PRCABJ"",216,0)"
^XMB(3.9,146044,2,672,0)=" ; TOP referrals"
^XMB(3.9,146044,2,673,0)="""RTN"",""PRCABJ"",217,0)"
^XMB(3.9,146044,2,674,0)=" S RCDB=0 F  S RCDB=$O(^RCD(340,""TOP"",RCDB)) Q:'RCDB  D"
^XMB(3.9,146044,2,675,0)="""RTN"",""PRCABJ"",218,0)"
^XMB(3.9,146044,2,676,0)=" .S Z=$P(^RCD(340,RCDB,0),U) I $P(Z,"";"",2)'=""DPT("" Q"
^XMB(3.9,146044,2,677,0)="""RTN"",""PRCABJ"",219,0)"
^XMB(3.9,146044,2,678,0)=" .I +$P($G(^RCD(340,RCDB,6)),U,2) Q  ; stop TOP referral flag has been set already"
^XMB(3.9,146044,2,679,0)="""RTN"",""PRCABJ"",220,0)"
^XMB(3.9,146044,2,680,0)=" .S RCDFN=$P(Z,"";""),HRFSFLG=$$CHKHRFS^RCHRFSUT(RCDFN,DT)"
^XMB(3.9,146044,2,681,0)="""RTN"",""PRCABJ"",221,0)"
^XMB(3.9,146044,2,682,0)=" .I HRFSFLG=1 S Z=$$STOPREF^RCTOPU(RCDB,""O"",""High Risk flag is set for this debtor"",DT) D HRFSCMNT^RCEVGEN(RCDB)"
^XMB(3.9,146044,2,683,0)="""RTN"",""PRCABJ"",222,0)"
^XMB(3.9,146044,2,684,0)=" .Q"
^XMB(3.9,146044,2,685,0)="""RTN"",""PRCABJ"",223,0)"
^XMB(3.9,146044,2,686,0)=" ; cancel DMC"
^XMB(3.9,146044,2,687,0)="""RTN"",""PRCABJ"",224,0)"
^XMB(3.9,146044,2,688,0)=" S RCDB=0 F  S RCDB=$O(^RCD(340,""DMC"",1,RCDB)) Q:'RCDB  D"
^XMB(3.9,146044,2,689,0)="""RTN"",""PRCABJ"",225,0)"
^XMB(3.9,146044,2,690,0)=" .S Z=$P(^RCD(340,RCDB,0),U) I $P(Z,"";"",2)'=""DPT("" Q"
^XMB(3.9,146044,2,691,0)="""RTN"",""PRCABJ"",226,0)"
^XMB(3.9,146044,2,692,0)=" .I +$P($G(^RCD(340,RCDB,3)),U,10) Q  ; DMC deletion flag has been set already"
^XMB(3.9,146044,2,693,0)="""RTN"",""PRCABJ"",227,0)"
^XMB(3.9,146044,2,694,0)=" .S RCDFN=$P(Z,"";""),HRFSFLG=$$CHKHRFS^RCHRFSUT(RCDFN,DT)"
^XMB(3.9,146044,2,695,0)="""RTN"",""PRCABJ"",228,0)"
^XMB(3.9,146044,2,696,0)=" .I HRFSFLG=1 S Z=$$CANCDMC^RCDMC90U(RCDB) D HRFSCMNT^RCEVGEN(RCDB)"
^XMB(3.9,146044,2,697,0)="""RTN"",""PRCABJ"",229,0)"
