^XMB(3.9,146009,2,1012,0)=" S DFLDS="".02;.03;.04;.06;.07;1.1;1.2;1.3;1.4;1.5;1.6;1.7;2.1;2.2;2.3;2.4;2.5;2.6;10.1;10.2;10.3"""
^XMB(3.9,146009,2,1013,0)="""RTN"",""XUMVINPB"",168,0)"
^XMB(3.9,146009,2,1014,0)=" F I=1:1:$L(DFLDS,"";"") S DFLD=$P(DFLDS,"";"",I) D FIELD^DID(8991.9,DFLD,"""",""LABEL"",""DFLDNM(8991.9,DFLD)"")"
^XMB(3.9,146009,2,1015,0)="""RTN"",""XUMVINPB"",169,0)"
^XMB(3.9,146009,2,1016,0)=" ;"
^XMB(3.9,146009,2,1017,0)="""RTN"",""XUMVINPB"",170,0)"
^XMB(3.9,146009,2,1018,0)=" S CNT=1"
^XMB(3.9,146009,2,1019,0)="""RTN"",""XUMVINPB"",171,0)"
^XMB(3.9,146009,2,1020,0)=" F  S XUDUZ=$O(^VA(200,XUDUZ)) Q:(('XUDUZ)!(XUDUZ'=+XUDUZ))  D @(LINETAG_""(.RETURN,""_XUDUZ_"")"") I RETURN D  Q  ;get next new person for type of extract"
^XMB(3.9,146009,2,1021,0)="""RTN"",""XUMVINPB"",172,0)"
^XMB(3.9,146009,2,1022,0)=" .N XUARR"
^XMB(3.9,146009,2,1023,0)="""RTN"",""XUMVINPB"",173,0)"
^XMB(3.9,146009,2,1024,0)=" .D GETS^DIQ(FILE,+XUDUZ_"","",FLDS,""EI"",""XUARR"") ;retrieve data"
^XMB(3.9,146009,2,1025,0)="""RTN"",""XUMVINPB"",174,0)"
^XMB(3.9,146009,2,1026,0)=" .;"
^XMB(3.9,146009,2,1027,0)="""RTN"",""XUMVINPB"",175,0)"
^XMB(3.9,146009,2,1028,0)=" .S @XUGBL@(CNT)=FILE_"";IEN^DUZ^^""_XUDUZ_""^""_XUDUZ S CNT=CNT+1"
