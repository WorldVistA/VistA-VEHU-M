^XMB(3.9,146018,2,670,0)=" ;.1173 | .11573 RESIDENTIAL COUNTRY (external^internal)"
^XMB(3.9,146018,2,671,0)="""RTN"",""DPTLK7"",212,0)"
^XMB(3.9,146018,2,672,0)=" ;.121 BAD ADDRESS INDICATOR (external^internal)"
^XMB(3.9,146018,2,673,0)="""RTN"",""DPTLK7"",213,0)"
^XMB(3.9,146018,2,674,0)=" W !,""Patient address--"""
