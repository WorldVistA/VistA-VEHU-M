^XMB(3.9,146037,2,1884,0)=" ;       in this routine."
^XMB(3.9,146037,2,1885,0)="""RTN"",""RCDPESR9"",7,0)"
^XMB(3.9,146037,2,1886,0)="835 ;;HEADER DATA"
^XMB(3.9,146037,2,1887,0)="""RTN"",""RCDPESR9"",8,0)"
^XMB(3.9,146037,2,1888,0)=" ;;835^^Return Message ID^S Y=X_"" (ERA HEADER DATA)"""
^XMB(3.9,146037,2,1889,0)="""RTN"",""RCDPESR9"",9,0)"
^XMB(3.9,146037,2,1890,0)=" ;;835^^X12/Proprietary flag^S Y=$S(X=""X"":""X12"",1:X)"
^XMB(3.9,146037,2,1891,0)="""RTN"",""RCDPESR9"",10,0)"
^XMB(3.9,146037,2,1892,0)=" ;;835^^File Date^S Y=$$FDT^RCDPESR9(X)"
^XMB(3.9,146037,2,1893,0)="""RTN"",""RCDPESR9"",11,0)"
^XMB(3.9,146037,2,1894,0)=" ;;835^^File Time^S Y=$E(X,1,2)-$S($E(X,1,2)>12:12,1:0)_"":""_$E(X,3,4)_$S($E(X,1,2)=24:"" AM"",$E(X,1,2)>11:"" PM"",1:"" AM"")"
^XMB(3.9,146037,2,1895,0)="""RTN"",""RCDPESR9"",12,0)"
^XMB(3.9,146037,2,1896,0)=" ;;835^1^MRA^S Y="""""
^XMB(3.9,146037,2,1897,0)="""RTN"",""RCDPESR9"",13,0)"
^XMB(3.9,146037,2,1898,0)=" ;;835^^Payer Name"
^XMB(3.9,146037,2,1899,0)="""RTN"",""RCDPESR9"",14,0)"
^XMB(3.9,146037,2,1900,0)=" ;;835^^Payer ID"
^XMB(3.9,146037,2,1901,0)="""RTN"",""RCDPESR9"",15,0)"
^XMB(3.9,146037,2,1902,0)=" ;;835^^Trace Number"
