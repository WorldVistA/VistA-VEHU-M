^XMB(3.9,146055,2,271,0)="""RTN"",""PSOSUCH1"",15,0)"
^XMB(3.9,146055,2,272,0)=" I '$D(^VA(200,+PSODUZ,0)) S PSODUZ=.5"
^XMB(3.9,146055,2,273,0)="""RTN"",""PSOSUCH1"",16,0)"
^XMB(3.9,146055,2,274,0)=" I 'DEAD S COM=""Change ""_$S($G(PSOSUSPA):""Partial"",'$G(SUB):""Fill"",1:""Refill"")_"" Date ""_$E(OLD,4,5)_""/""_$E(OLD,6,7)_""/""_$E(OLD,2,3)_"" to ""_$E(INDT,4,5)_""/""_$E(INDT,6,7)_""/""_$E(INDT,2,3)"
^XMB(3.9,146055,2,275,0)="""RTN"",""PSOSUCH1"",17,0)"
^XMB(3.9,146055,2,276,0)=" S CNT=0 F SUB=0:0 S SUB=$O(^PSRX(RXREC,""A"",SUB)) Q:'SUB  S CNT=SUB"
^XMB(3.9,146055,2,277,0)="""RTN"",""PSOSUCH1"",18,0)"
