^XMB(3.9,146098,2,2425,0)="""RTN"",""SDLT"",96,0)"
^XMB(3.9,146098,2,2426,0)=" .W:($P(VAPA(25),""^"",2)'=""UNITED STATES"") !,?12,$P(VAPA(25),U,2) ;display country"
^XMB(3.9,146098,2,2427,0)="""RTN"",""SDLT"",97,0)"
^XMB(3.9,146098,2,2428,0)=" ;if confidential address is active for scheduling/appointment letters, print to confidential address"
^XMB(3.9,146098,2,2429,0)="""RTN"",""SDLT"",98,0)"
^XMB(3.9,146098,2,2430,0)=" I $G(SDCCACT1)=1,$G(SDCCACT2)=""Y"" D"
^XMB(3.9,146098,2,2431,0)="""RTN"",""SDLT"",99,0)"
^XMB(3.9,146098,2,2432,0)=" .F LL=13:1:15 W:VAPA(LL)]"""" !,?12,VAPA(LL)"
^XMB(3.9,146098,2,2433,0)="""RTN"",""SDLT"",100,0)"
^XMB(3.9,146098,2,2434,0)=" .I (VAPA(28)="""")!($P(VAPA(28),""^"",2)=""UNITED STATES"") D"
^XMB(3.9,146098,2,2435,0)="""RTN"",""SDLT"",101,0)"
^XMB(3.9,146098,2,2436,0)=" ..W !,?12,VAPA(16)_"" ""_$P(VAPA(17),U,2)_""  ""_$P(VAPA(18),U,2)"
^XMB(3.9,146098,2,2437,0)="""RTN"",""SDLT"",102,0)"
^XMB(3.9,146098,2,2438,0)=" .E  D"
^XMB(3.9,146098,2,2439,0)="""RTN"",""SDLT"",103,0)"
^XMB(3.9,146098,2,2440,0)=" ..W !,?12,VAPA(27)_"" ""_VAPA(16)_"" ""_VAPA(26)"
^XMB(3.9,146098,2,2441,0)="""RTN"",""SDLT"",104,0)"
^XMB(3.9,146098,2,2442,0)=" .W:($P(VAPA(28),""^"",2)'=""UNITED STATES"") !?12,$P(VAPA(28),U,2)"
^XMB(3.9,146098,2,2443,0)="""RTN"",""SDLT"",105,0)"
^XMB(3.9,146098,2,2444,0)=" W ! D KVAR^VADPT Q"
^XMB(3.9,146098,2,2445,0)="""RTN"",""SDLT"",106,0)"
^XMB(3.9,146098,2,2446,0)=" ;"
^XMB(3.9,146098,2,2447,0)="""RTN"",""SDLT"",107,0)"
^XMB(3.9,146098,2,2448,0)=" ;"
^XMB(3.9,146098,2,2449,0)="""RTN"",""SDLT"",108,0)"
^XMB(3.9,146098,2,2450,0)="LAST4(DFN) ;Return patient ""last four"""
^XMB(3.9,146098,2,2451,0)="""RTN"",""SDLT"",109,0)"
^XMB(3.9,146098,2,2452,0)=" N SDX"
^XMB(3.9,146098,2,2453,0)="""RTN"",""SDLT"",110,0)"
^XMB(3.9,146098,2,2454,0)=" S SDX=""     "" Q SDX"
