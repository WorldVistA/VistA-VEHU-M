^XMB(3.9,146047,2,433,0)="""RTN"",""IBCNBCD2"",28,0)"
^XMB(3.9,146047,2,434,0)=" . ; -- user entered a new date not found in the display list"
^XMB(3.9,146047,2,435,0)="""RTN"",""IBCNBCD2"",29,0)"
