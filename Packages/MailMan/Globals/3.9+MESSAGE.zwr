^XMB(3.9,146098,2,2243,0)="""RTN"",""SDLT"",5,0)"
^XMB(3.9,146098,2,2244,0)=" ;**************************************************************************"
^XMB(3.9,146098,2,2245,0)="""RTN"",""SDLT"",6,0)"
^XMB(3.9,146098,2,2246,0)=" ;                          MODIFICATIONS"
^XMB(3.9,146098,2,2247,0)="""RTN"",""SDLT"",7,0)"
^XMB(3.9,146098,2,2248,0)=" ;   DATE      PATCH     DEVELOPER  DESCRIPTION OF CHANGES"
^XMB(3.9,146098,2,2249,0)="""RTN"",""SDLT"",8,0)"
^XMB(3.9,146098,2,2250,0)=" ; --------  ----------  ---------  ----------------------------------------"
^XMB(3.9,146098,2,2251,0)="""RTN"",""SDLT"",9,0)"
^XMB(3.9,146098,2,2252,0)=" ; 02/14/03  SD*5.3*281  SAUNDERS   Print letters to confidential address if"
^XMB(3.9,146098,2,2253,0)="""RTN"",""SDLT"",10,0)"
^XMB(3.9,146098,2,2254,0)=" ;                                  requested"
^XMB(3.9,146098,2,2255,0)="""RTN"",""SDLT"",11,0)"
^XMB(3.9,146098,2,2256,0)=" ; 12/2/03   SD*5.3*330  LUNDEN     Remove form feed from PRT+0"
^XMB(3.9,146098,2,2257,0)="""RTN"",""SDLT"",12,0)"
^XMB(3.9,146098,2,2258,0)=" ; 01/21/16  SD*5.3*641  HSI        Print 1st piece of 99 node"
^XMB(3.9,146098,2,2259,0)="""RTN"",""SDLT"",13,0)"
^XMB(3.9,146098,2,2260,0)=" ; 11/27/17  SD*5.3*680  JACKSON    Remove gender implications"
^XMB(3.9,146098,2,2261,0)="""RTN"",""SDLT"",14,0)"
^XMB(3.9,146098,2,2262,0)=" ; 06/13/18  SD*5.3*705  THOMAS     Add blank line between appointments in"
^XMB(3.9,146098,2,2263,0)="""RTN"",""SDLT"",15,0)"
^XMB(3.9,146098,2,2264,0)=" ;                                  letters"
^XMB(3.9,146098,2,2265,0)="""RTN"",""SDLT"",16,0)"
^XMB(3.9,146098,2,2266,0)=" ;**************************************************************************"
^XMB(3.9,146098,2,2267,0)="""RTN"",""SDLT"",17,0)"
^XMB(3.9,146098,2,2268,0)=" ;"
^XMB(3.9,146098,2,2269,0)="""RTN"",""SDLT"",18,0)"
^XMB(3.9,146098,2,2270,0)=" N Z0,X"
^XMB(3.9,146098,2,2271,0)="""RTN"",""SDLT"",19,0)"
^XMB(3.9,146098,2,2272,0)=" ;WRITE GREETING AND OPENING TEXT OF LETTER"
^XMB(3.9,146098,2,2273,0)="""RTN"",""SDLT"",20,0)"
^XMB(3.9,146098,2,2274,0)="PRT S DFN=$P(A,U,1)  ;SD*523"
^XMB(3.9,146098,2,2275,0)="""RTN"",""SDLT"",21,0)"
^XMB(3.9,146098,2,2276,0)=" I $D(SDNOSH) I $D(^DPT(DFN,.1)) S POP=1 Q:POP  ;SD/523"
^XMB(3.9,146098,2,2277,0)="""RTN"",""SDLT"",22,0)"
^XMB(3.9,146098,2,2278,0)=" S Y=DT D DTS^SDUTL"
^XMB(3.9,146098,2,2279,0)="""RTN"",""SDLT"",23,0)"
^XMB(3.9,146098,2,2280,0)=" I +$G(SDFIRST)=0 W @IOF ;SD*5.3*330 Form feed only after letter #1"
^XMB(3.9,146098,2,2281,0)="""RTN"",""SDLT"",24,0)"
^XMB(3.9,146098,2,2282,0)=" K SDFIRST"
^XMB(3.9,146098,2,2283,0)="""RTN"",""SDLT"",25,0)"
^XMB(3.9,146098,2,2284,0)=" ;S SDFIRST=0"
^XMB(3.9,146098,2,2285,0)="""RTN"",""SDLT"",26,0)"
^XMB(3.9,146098,2,2286,0)=" W !,?65,Y,!,?65,$$LAST4(A),!!!!"
^XMB(3.9,146098,2,2287,0)="""RTN"",""SDLT"",27,0)"
^XMB(3.9,146098,2,2288,0)=" I 'SDFORM W !!!!! D ADDR W !!!!"
^XMB(3.9,146098,2,2289,0)="""RTN"",""SDLT"",28,0)"
^XMB(3.9,146098,2,2290,0)="W1 W !,""Dear "" ;,$S($P(^DPT(+A,0),""^"",2)=""M"":""Mr. "",1:""Ms. "")   SD*5.3*680"
^XMB(3.9,146098,2,2291,0)="""RTN"",""SDLT"",29,0)"
^XMB(3.9,146098,2,2292,0)=" N DPTNAME"
^XMB(3.9,146098,2,2293,0)="""RTN"",""SDLT"",30,0)"
^XMB(3.9,146098,2,2294,0)=" S DPTNAME(""FILE"")=2,DPTNAME(""FIELD"")="".01"",DPTNAME(""IENS"")=(+A)_"","""
^XMB(3.9,146098,2,2295,0)="""RTN"",""SDLT"",31,0)"
^XMB(3.9,146098,2,2296,0)=" S X=$$NAMEFMT^XLFNAME(.DPTNAME,""G"",""M"") W X,"","""
^XMB(3.9,146098,2,2297,0)="""RTN"",""SDLT"",32,0)"
^XMB(3.9,146098,2,2298,0)=" W !! K ^UTILITY($J,""W""),DIWF,DIWR,DIWF S DIWL=1,DIWF=""C80WN"" F Z0=0:0 S Z0=$O(^VA(407.5,SDLET,1,Z0)) Q:Z0'>0  S X=^(Z0,0) D ^DIWP"
^XMB(3.9,146098,2,2299,0)="""RTN"",""SDLT"",33,0)"
^XMB(3.9,146098,2,2300,0)=" D ^DIWW K ^UTILITY($J,""W"") Q"
^XMB(3.9,146098,2,2301,0)="""RTN"",""SDLT"",34,0)"
^XMB(3.9,146098,2,2302,0)="WRAPP ;WRITE APPOINTMENT INFORMATION"
^XMB(3.9,146098,2,2303,0)="""RTN"",""SDLT"",35,0)"
^XMB(3.9,146098,2,2304,0)=" N B"
^XMB(3.9,146098,2,2305,0)="""RTN"",""SDLT"",36,0)"
^XMB(3.9,146098,2,2306,0)=" ; SD*5.3*622 - re-arrange display of clinic name"
^XMB(3.9,146098,2,2307,0)="""RTN"",""SDLT"",37,0)"
^XMB(3.9,146098,2,2308,0)=" ;S:$D(SC)&'$D(SDC) SDC=SC S SDCL=$P(^SC(+SDC,0),""^"",1),SDCL=SDCL_"" Clinic"" D FORM"
^XMB(3.9,146098,2,2309,0)="""RTN"",""SDLT"",38,0)"
^XMB(3.9,146098,2,2310,0)=" S:$D(SC)&'$D(SDC) SDC=SC S SDCL=$P(^SC(+SDC,0),""^"",1),SDCL=""   Clinic:  ""_SDCL D FORM ; SD*5.3*622 end changes"
^XMB(3.9,146098,2,2311,0)="""RTN"",""SDLT"",39,0)"
