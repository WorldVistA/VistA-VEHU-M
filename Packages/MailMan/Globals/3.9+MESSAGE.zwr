^XMB(3.9,146098,2,178,0)="0^2"
^XMB(3.9,146098,2,179,0)="""KRN"",8994,4471,0)"
^XMB(3.9,146098,2,180,0)="SDES2 ADD CONTACT ATTEMPT^ADDCONTACT^SDES2CONTACTS^2^R^^^^^^1"
^XMB(3.9,146098,2,181,0)="""KRN"",8994,4471,1,0)"
^XMB(3.9,146098,2,182,0)="^^11^11^3250212^"
^XMB(3.9,146098,2,183,0)="""KRN"",8994,4471,1,1,0)"
^XMB(3.9,146098,2,184,0)=" This RPC serves two functions."
^XMB(3.9,146098,2,185,0)="""KRN"",8994,4471,1,2,0)"
^XMB(3.9,146098,2,186,0)=" 1.) If no record exists for the given appointment request, it will create"
^XMB(3.9,146098,2,187,0)="""KRN"",8994,4471,1,3,0)"
^XMB(3.9,146098,2,188,0)="     a NEW record in the SDEC CONTACT file (#409.86), and add the first "
^XMB(3.9,146098,2,189,0)="""KRN"",8994,4471,1,4,0)"
^XMB(3.9,146098,2,190,0)="     contact attempt to the Date/Time of Contact subfile (#409.863)"
^XMB(3.9,146098,2,191,0)="""KRN"",8994,4471,1,5,0)"
^XMB(3.9,146098,2,192,0)=" 2.) If there is already a contact in the SDEC CONTACT file for this "
^XMB(3.9,146098,2,193,0)="""KRN"",8994,4471,1,6,0)"
^XMB(3.9,146098,2,194,0)="     appointment request, a new entry will be added to the Date/Time of "
^XMB(3.9,146098,2,195,0)="""KRN"",8994,4471,1,7,0)"
^XMB(3.9,146098,2,196,0)="     Contact subfile (#409.863), but will not change any values for the "
^XMB(3.9,146098,2,197,0)="""KRN"",8994,4471,1,8,0)"
^XMB(3.9,146098,2,198,0)="     SDEC CONTACT entry (#409.86). The parent record is not editable, only"
^XMB(3.9,146098,2,199,0)="""KRN"",8994,4471,1,9,0)"
^XMB(3.9,146098,2,200,0)="     new contact attempts may be added."
^XMB(3.9,146098,2,201,0)="""KRN"",8994,4471,1,10,0)"
^XMB(3.9,146098,2,202,0)=" "
^XMB(3.9,146098,2,203,0)="""KRN"",8994,4471,1,11,0)"
^XMB(3.9,146098,2,204,0)="Can only be invoked by Acheron"
^XMB(3.9,146098,2,205,0)="""KRN"",8994,4471,2,0)"
^XMB(3.9,146098,2,206,0)="^8994.02A^2^2"
^XMB(3.9,146098,2,207,0)="""KRN"",8994,4471,2,1,0)"
