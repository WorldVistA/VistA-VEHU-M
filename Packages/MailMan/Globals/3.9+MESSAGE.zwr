^XMB(3.9,146047,2,415,0)="""RTN"",""IBCNBCD2"",19,0)"
^XMB(3.9,146047,2,416,0)=" . ; -- display a list of coverage limitations years for the group policy"
^XMB(3.9,146047,2,417,0)="""RTN"",""IBCNBCD2"",20,0)"
^XMB(3.9,146047,2,418,0)=" . D CVDTS(IBGRPDA,.IBDTL)"
