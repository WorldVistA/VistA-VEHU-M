^XMB(3.9,146047,2,1733,0)="""RTN"",""IBCNEHLM"",39,0)"
^XMB(3.9,146047,2,1734,0)=" D REG"
^XMB(3.9,146047,2,1735,0)="""RTN"",""IBCNEHLM"",40,0)"
^XMB(3.9,146047,2,1736,0)=" ; Purge the task record"
