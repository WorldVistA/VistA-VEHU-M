^XMB(3.9,146082,2,306,0)=" S XPDTEXT(8,0)=""Installed by: ""_$P($G(^VA(200,+$P(XPD0,U,11),0)),U)"
^XMB(3.9,146082,2,307,0)="""RTN"",""XPDIST"",35,0)"
^XMB(3.9,146082,2,308,0)=" S XPDTEXT(9,0)=""Install Name: ""_$P(XPD0,U)"
^XMB(3.9,146082,2,309,0)="""RTN"",""XPDIST"",36,0)"
