^XMB(3.9,146052,2,1511,0)="""RTN"",""FBAAPIE1"",13,0)"
^XMB(3.9,146052,2,1512,0)="GETIT S FBRX=$P(Y(0),""^""),FBFD=$P(Y(0),""^"",3),FBAC=$P(Y(0),""^"",4),DFN=+$P(Y(0),""^"",5)"
^XMB(3.9,146052,2,1513,0)="""RTN"",""FBAAPIE1"",14,0)"
^XMB(3.9,146052,2,1514,0)=" S SSN=$$SSN^FBAAUTL(DFN),VID=+$P($G(^FBAA(162.1,DA,0)),""^"",4),VNAM=$P($G(^FBAAV(VID,0)),""^"")"
^XMB(3.9,146052,2,1515,0)="""RTN"",""FBAAPIE1"",15,0)"
^XMB(3.9,146052,2,1516,0)=" I FSW S FSW=0 D HED"
^XMB(3.9,146052,2,1517,0)="""RTN"",""FBAAPIE1"",16,0)"
^XMB(3.9,146052,2,1518,0)=" I $Y+5>IOSL S DIR(0)=""E"" D ^DIR K DIR S:'Y FBAAOUT=1 Q:FBAAOUT   D HED"
^XMB(3.9,146052,2,1519,0)="""RTN"",""FBAAPIE1"",17,0)"
^XMB(3.9,146052,2,1520,0)=" W !,SSN,?19,$E(FBFD,4,5),""-"",$E(FBFD,6,7),""-"",$E(FBFD,2,3),?31,FBRX,?44,FBAC"
^XMB(3.9,146052,2,1521,0)="""RTN"",""FBAAPIE1"",18,0)"
^XMB(3.9,146052,2,1522,0)=" Q"
^XMB(3.9,146052,2,1523,0)="""RTN"",""FBAAPIE1"",19,0)"
^XMB(3.9,146052,2,1524,0)="HED W @IOF,""Invoice #: "",DA,?25,""Vendor Name: "",VNAM,!!,""Patient  I.D."",?18,""Fill Date"",?30,"" RX  #"",?40,""Amt Claimed"",!"
^XMB(3.9,146052,2,1525,0)="""RTN"",""FBAAPIE1"",20,0)"
^XMB(3.9,146052,2,1526,0)=" Q"
^XMB(3.9,146052,2,1527,0)="""RTN"",""FBAAPIE1"",21,0)"
^XMB(3.9,146052,2,1528,0)="CHKK W !!,*7,""There already is a prescription number entered, from this vendor, "",!,""for that fill date. The invoice number is "",$O(^FBAA(162.1,""AL"",VIN,PSRX,DATEF,""""))_"" ."""
^XMB(3.9,146052,2,1529,0)="""RTN"",""FBAAPIE1"",22,0)"
^XMB(3.9,146052,2,1530,0)=" G RDD^FBAAPIE"
^XMB(3.9,146052,2,1531,0)="""RTN"",""FBAAPIE1"",23,0)"
^XMB(3.9,146052,2,1532,0)="CALC ;Calculate Invoice Total"
^XMB(3.9,146052,2,1533,0)="""RTN"",""FBAAPIE1"",24,0)"
^XMB(3.9,146052,2,1534,0)=" S FBINTOT=0 I $D(^FBAA(162.1,IN,""RX"")) F I=0:0 S I=$O(^FBAA(162.1,IN,""RX"",I)) Q:I'>0  I $D(^(I,0)) S FBINTOT=FBINTOT+$P(^FBAA(162.1,IN,""RX"",I,0),""^"",16)"
^XMB(3.9,146052,2,1535,0)="""RTN"",""FBAAPIE1"",25,0)"
^XMB(3.9,146052,2,1536,0)=" K I Q"
^XMB(3.9,146052,2,1537,0)="""RTN"",""FBAAPIE1"",26,0)"
^XMB(3.9,146052,2,1538,0)="RDM W ! S DIR(""A"")=""Do you want to continue a previously entered Invoice"",DIR(""B"")=""No"",DIR(0)=""Y"" D ^DIR K DIR G Q:$D(DIRUT)!('Y)"
^XMB(3.9,146052,2,1539,0)="""RTN"",""FBAAPIE1"",27,0)"
^XMB(3.9,146052,2,1540,0)="RD2 W !! S DIC=""^FBAA(162.1,"",DIC(0)=""AEQM"",DIC(""S"")=""I $P(^(0),U,5)'=4"" D ^DIC G Q:X=""^""!(X=""""),RD2:Y<0 S (DA,DA(1),IN)=+Y,VIN=$P(^(0),""^"",4)"
^XMB(3.9,146052,2,1541,0)="""RTN"",""FBAAPIE1"",28,0)"
^XMB(3.9,146052,2,1542,0)=" S INVDATE=$$GET1^DIQ(162.1,DA_"","",12,""I"") ;Load Inv Rcvd Date for validity check of Rx fill Date in RDD^FBAAPIE"
^XMB(3.9,146052,2,1543,0)="""RTN"",""FBAAPIE1"",29,0)"
^XMB(3.9,146052,2,1544,0)=" D CALC W:FBINTOT>0 !,?30,""Current Total: $ ""_$J(FBINTOT,1,2)"
^XMB(3.9,146052,2,1545,0)="""RTN"",""FBAAPIE1"",30,0)"
^XMB(3.9,146052,2,1546,0)="RD3 W ! S DIR(""A"")=""Want to list previously entered line items"",DIR(""B"")=""No"",DIR(0)=""Y"" D ^DIR K DIR G Q:$D(DIRUT) D:Y LISTLI"
^XMB(3.9,146052,2,1547,0)="""RTN"",""FBAAPIE1"",31,0)"
^XMB(3.9,146052,2,1548,0)=" S LCNT=+$P(^FBAA(162.1,IN,0),""^"",9),TAC=+$P(^(0),""^"",6),STAT=+$P(^(0),""^"",5),STAT(STAT)="""",FBFPPSC=$P(^FBAA(162.1,IN,0),""^"",13) G RDP^FBAAPIE"
^XMB(3.9,146052,2,1549,0)="""RTN"",""FBAAPIE1"",32,0)"
^XMB(3.9,146052,2,1550,0)=" Q"
^XMB(3.9,146052,2,1551,0)="""RTN"",""FBAAPIE1"",33,0)"
^XMB(3.9,146052,2,1552,0)="RX2 W !!,*7,""This prescription number already exsists in this invoice."",!"
^XMB(3.9,146052,2,1553,0)="""RTN"",""FBAAPIE1"",34,0)"
^XMB(3.9,146052,2,1554,0)=" W ! S DIR(""A"")=""Do you wish to enter this prescription again"",DIR(""B"")=""No"",DIR(0)=""Y"" D ^DIR K DIR G CHK^FBAAPIE:$D(DIRUT),RDRX^FBAAPIE:'Y,RXADD^FBAAPIE"
^XMB(3.9,146052,2,1555,0)="""RTN"",""FBAAPIE1"",35,0)"
^XMB(3.9,146052,2,1556,0)=" Q"
^XMB(3.9,146052,2,1557,0)="""RTN"",""FBAAPIE1"",36,0)"
^XMB(3.9,146052,2,1558,0)="PROB W !!,""You do not have access to the Fee Invoice File, contact your IRM Service."",! G Q"
^XMB(3.9,146052,2,1559,0)="""RTN"",""FBAAPIE1"",37,0)"
^XMB(3.9,146052,2,1560,0)="CHK2 ;Checks for duplicate payments on all linked vendors."
^XMB(3.9,146052,2,1561,0)="""RTN"",""FBAAPIE1"",38,0)"
^XMB(3.9,146052,2,1562,0)=" S FBJ=0 F  S FBJ=$O(FBAR(FBJ)) Q:$S('FBJ:1,$D(^FBAA(162.1,""AL"",FBJ,PSRX,DATEF)):1,1:0)"
^XMB(3.9,146052,2,1563,0)="""RTN"",""FBAAPIE1"",39,0)"
^XMB(3.9,146052,2,1564,0)=" Q"
^XMB(3.9,146052,2,1565,0)="""RTN"",""FBAAPPH"")"
^XMB(3.9,146052,2,1566,0)="0^6^B17311518"
^XMB(3.9,146052,2,1567,0)="""RTN"",""FBAAPPH"",1,0)"
^XMB(3.9,146052,2,1568,0)="FBAAPPH ;AISC/GRR-PHARMACY HISTORY LIST FOR PATIENT ;7/17/2003"
^XMB(3.9,146052,2,1569,0)="""RTN"",""FBAAPPH"",2,0)"
^XMB(3.9,146052,2,1570,0)=" ;;3.5;FEE BASIS;**12,61**;JAN 30, 1995;Build 0"
^XMB(3.9,146052,2,1571,0)="""RTN"",""FBAAPPH"",3,0)"
^XMB(3.9,146052,2,1572,0)=" ;;Per VHA Directive 10-93-142, this routine should not be modified."
^XMB(3.9,146052,2,1573,0)="""RTN"",""FBAAPPH"",4,0)"
^XMB(3.9,146052,2,1574,0)=" D DT^DICRW S FBAAOUT=0"
^XMB(3.9,146052,2,1575,0)="""RTN"",""FBAAPPH"",5,0)"
^XMB(3.9,146052,2,1576,0)="RD K FBAANQ W !! S FBAAOUT=0,DIC=""^FBAAA("",DIC(0)=""AEQM"" D ^DIC G Q:X=""""!(X=""^""),RD:Y<0 S DFN=+Y"
^XMB(3.9,146052,2,1577,0)="""RTN"",""FBAAPPH"",6,0)"
^XMB(3.9,146052,2,1578,0)=" I '$D(^FBAA(162.1,""AD"",DFN)) W !!,*7,""No payments for this patient!"" G RD"
^XMB(3.9,146052,2,1579,0)="""RTN"",""FBAAPPH"",7,0)"
^XMB(3.9,146052,2,1580,0)=" S VAR=""DFN"",VAL=DFN,PGM=""LIST^FBAAPPH"" D ZIS^FBAAUTL G:FBPOP Q S:IO=IO(0) FBAANQ=1"
^XMB(3.9,146052,2,1581,0)="""RTN"",""FBAAPPH"",8,0)"
^XMB(3.9,146052,2,1582,0)="LIST ; list prescriptions for patient (DFN)"
^XMB(3.9,146052,2,1583,0)="""RTN"",""FBAAPPH"",9,0)"
^XMB(3.9,146052,2,1584,0)=" N FBADJLA,FBADJLR,FBFPPSC,FBFPPSL,FBRRMKL,FBSUSPA,FBX"
^XMB(3.9,146052,2,1585,0)="""RTN"",""FBAAPPH"",10,0)"
^XMB(3.9,146052,2,1586,0)=" S Q="""" S $P(Q,""="",80)=""="""
^XMB(3.9,146052,2,1587,0)="""RTN"",""FBAAPPH"",11,0)"
^XMB(3.9,146052,2,1588,0)=" S FSW=1 U IO I $E(IOST,1,2)=""C-"" W @IOF"
^XMB(3.9,146052,2,1589,0)="""RTN"",""FBAAPPH"",12,0)"
^XMB(3.9,146052,2,1590,0)=" S (FBAAOUT,J,K,L)=0"
^XMB(3.9,146052,2,1591,0)="""RTN"",""FBAAPPH"",13,0)"
^XMB(3.9,146052,2,1592,0)=" I '$O(^FBAA(162.1,""AD"",DFN,0)) W !,""Patient has no Pharmacy payment history."",! Q"
^XMB(3.9,146052,2,1593,0)="""RTN"",""FBAAPPH"",14,0)"
^XMB(3.9,146052,2,1594,0)=" F  S J=$O(^FBAA(162.1,""AD"",DFN,J)) Q:J'>0!(FBAAOUT)  F  S K=$O(^FBAA(162.1,""AD"",DFN,J,K)) Q:K'>0!(FBAAOUT)  F  S L=$O(^FBAA(162.1,""AD"",DFN,J,K,L)) Q:L'>0!(FBAAOUT)  D GOT Q:FBAAOUT"
^XMB(3.9,146052,2,1595,0)="""RTN"",""FBAAPPH"",15,0)"
^XMB(3.9,146052,2,1596,0)=" I FBAAOUT,$E(IOST,1,2)=""C-"" W @IOF"
^XMB(3.9,146052,2,1597,0)="""RTN"",""FBAAPPH"",16,0)"
^XMB(3.9,146052,2,1598,0)=" G:$D(FBAANQ) RD"
^XMB(3.9,146052,2,1599,0)="""RTN"",""FBAAPPH"",17,0)"
^XMB(3.9,146052,2,1600,0)="Q K DIC,DOB,J,K,L,DFN,FBAANQ,FBRX,FBFD,FBAC,FBAP,A1,A2,FBPV,FBSUSP,FBSTR,FBQTY,FBAAOUT,FSW,FID,CHN,FBBATCH,FBDRUG,FBINVN,FBPD,FBREIM,N,NAME,Q,FBSSN,VAL,VAR,VID,PGM,VNAM,X,Y,I,FBSAR,FBI"
^XMB(3.9,146052,2,1601,0)="""RTN"",""FBAAPPH"",18,0)"
^XMB(3.9,146052,2,1602,0)=" W:$E(IOST,1,2)'=""C-"" @IOF D CLOSE^FBAAUTL Q"
^XMB(3.9,146052,2,1603,0)="""RTN"",""FBAAPPH"",19,0)"
^XMB(3.9,146052,2,1604,0)=" ;"
^XMB(3.9,146052,2,1605,0)="""RTN"",""FBAAPPH"",20,0)"
^XMB(3.9,146052,2,1606,0)="GOT S FBSSN=$$SSN^FBAAUTL(DFN),N=$G(^DPT(+DFN,0)),NAME=$P(N,""^""),DOB=$P(N,""^"",3),DOB=$S(DOB]"""":$$FMTE^XLFDT(DOB),1:"""")"
^XMB(3.9,146052,2,1607,0)="""RTN"",""FBAAPPH"",21,0)"
^XMB(3.9,146052,2,1608,0)=" Q:'$D(^FBAA(162.1,K,0))&('$D(^FBAA(162.1,K,""RX"",L,0)))"
^XMB(3.9,146052,2,1609,0)="""RTN"",""FBAAPPH"",22,0)"
^XMB(3.9,146052,2,1610,0)=" S Y(0)=$G(^FBAA(162.1,K,""RX"",L,0))"
^XMB(3.9,146052,2,1611,0)="""RTN"",""FBAAPPH"",23,0)"
^XMB(3.9,146052,2,1612,0)=" S Y(2)=$G(^FBAA(162.1,+K,0))"
^XMB(3.9,146052,2,1613,0)="""RTN"",""FBAAPPH"",24,0)"
^XMB(3.9,146052,2,1614,0)=" I $D(^FBAA(162.1,K,""RX"",L,2)) S Y(1)=^(2)"
^XMB(3.9,146052,2,1615,0)="""RTN"",""FBAAPPH"",25,0)"
^XMB(3.9,146052,2,1616,0)=" S FBFPPSL=$P($G(^FBAA(162.1,K,""RX"",L,3)),U)"
^XMB(3.9,146052,2,1617,0)="""RTN"",""FBAAPPH"",26,0)"
^XMB(3.9,146052,2,1618,0)=" S FBX=$$ADJLRA^FBRXFA(L_"",""_K_"","")"
^XMB(3.9,146052,2,1619,0)="""RTN"",""FBAAPPH"",27,0)"
^XMB(3.9,146052,2,1620,0)=" S FBADJLR=$P(FBX,U)"
^XMB(3.9,146052,2,1621,0)="""RTN"",""FBAAPPH"",28,0)"
^XMB(3.9,146052,2,1622,0)=" S FBADJLA=$P(FBX,U,2)"
^XMB(3.9,146052,2,1623,0)="""RTN"",""FBAAPPH"",29,0)"
^XMB(3.9,146052,2,1624,0)=" S FBRRMKL=$$RRL^FBRXFR(L_"",""_K_"","")"
^XMB(3.9,146052,2,1625,0)="""RTN"",""FBAAPPH"",30,0)"
^XMB(3.9,146052,2,1626,0)=" S FBINVN=$P(Y(2),""^""),VID=$P(Y(2),""^"",4),CHN=$G(^FBAAV(+VID,0)),VNAM=$P(CHN,""^""),FID=$P(CHN,""^"",2),CHN=$P(CHN,""^"",10)"
^XMB(3.9,146052,2,1627,0)="""RTN"",""FBAAPPH"",31,0)"
^XMB(3.9,146052,2,1628,0)=" S FBFPPSC=$P(Y(2),U,13)"
^XMB(3.9,146052,2,1629,0)="""RTN"",""FBAAPPH"",32,0)"
^XMB(3.9,146052,2,1630,0)=" S FBRX=$P(Y(0),""^"",1),FBDRUG=$P(Y(0),""^"",2),FBFD=$P(Y(0),""^"",3),FBAC=$P(Y(0),""^"",4),FBAP=$P(Y(0),""^"",16),FBSUSP=$P(Y(0),""^"",8),FBPD=$P(Y(0),""^"",19),FBBATCH=$P(Y(0),""^"",17),FBBATCH=$P($G(^FBAA(161.7,+FBBATCH,0)),""^"")"
^XMB(3.9,146052,2,1631,0)="""RTN"",""FBAAPPH"",33,0)"
^XMB(3.9,146052,2,1632,0)=" S FBSUSPA=$FN($P(Y(0),U,7),"""",2)"
^XMB(3.9,146052,2,1633,0)="""RTN"",""FBAAPPH"",34,0)"
^XMB(3.9,146052,2,1634,0)=" I FBSUSP=4,FBADJLR="""" S FBI=0 F  S FBI=$O(^FBAA(162.1,K,""RX"",L,1,FBI)) Q:'FBI  S FBSAR(FBI)=^(FBI,0)"
^XMB(3.9,146052,2,1635,0)="""RTN"",""FBAAPPH"",35,0)"
^XMB(3.9,146052,2,1636,0)=" I FBSUSP]"""" S FBSUSP=$P($G(^FBAA(161.27,+FBSUSP,0)),""^"")"
^XMB(3.9,146052,2,1637,0)="""RTN"",""FBAAPPH"",36,0)"
^XMB(3.9,146052,2,1638,0)=" S FBREIM=$S($P(Y(0),""^"",20)=""R"":""*"",1:""""),FBSTR=$P(Y(0),""^"",12),FBQTY=$P(Y(0),""^"",13),A1=FBAC+.00001,A2=FBAP+.00001,A1=$P(A1,""."",1)_"".""_$E($P(A1,""."",2),1,2),A2=$P(A2,""."",1)_"".""_$E($P(A2,""."",2),1,2),FBPV="""""
^XMB(3.9,146052,2,1639,0)="""RTN"",""FBAAPPH"",37,0)"
^XMB(3.9,146052,2,1640,0)=" I $D(Y(1)) S FBPV=$S($P(Y(1),""^"",3)=""V"":""#"",1:"""")"
^XMB(3.9,146052,2,1641,0)="""RTN"",""FBAAPPH"",38,0)"
^XMB(3.9,146052,2,1642,0)=" D FBCKP^FBAACCB1(K,L)"
^XMB(3.9,146052,2,1643,0)="""RTN"",""FBAAPPH"",39,0)"
^XMB(3.9,146052,2,1644,0)="WRT I FSW S FSW=0 D HED"
^XMB(3.9,146052,2,1645,0)="""RTN"",""FBAAPPH"",40,0)"
^XMB(3.9,146052,2,1646,0)=" I $E(IOST,1,2)=""C-"",$Y+7>IOSL S DIR(0)=""E"" D ^DIR K DIR S:'Y FBAAOUT=1 Q:FBAAOUT  W @IOF D HED"
^XMB(3.9,146052,2,1647,0)="""RTN"",""FBAAPPH"",41,0)"
^XMB(3.9,146052,2,1648,0)=" I $Y+6>IOSL W @IOF D HED"
^XMB(3.9,146052,2,1649,0)="""RTN"",""FBAAPPH"",42,0)"
^XMB(3.9,146052,2,1650,0)=" W !!,VNAM,?48,FID,?60,CHN"
^XMB(3.9,146052,2,1651,0)="""RTN"",""FBAAPPH"",43,0)"
^XMB(3.9,146052,2,1652,0)=" W !,FBREIM,FBPV,?3,$E(FBFD,4,5),""/"",$E(FBFD,6,7),""/"",$E(FBFD,2,3),?64,$S(FBPD="""":"""",1:$E(FBPD,4,5)_""/""_$E(FBPD,6,7)_""/""_$E(FBPD,2,3))"
^XMB(3.9,146052,2,1653,0)="""RTN"",""FBAAPPH"",44,0)"
^XMB(3.9,146052,2,1654,0)=" W !,"" Rx: ""_FBRX,?15,FBDRUG,?45,FBSTR,?63,FBQTY"
^XMB(3.9,146052,2,1655,0)="""RTN"",""FBAAPPH"",45,0)"
^XMB(3.9,146052,2,1656,0)=" W !,?4,$J(A1,6),?13,$J(A2,6)"
^XMB(3.9,146052,2,1657,0)="""RTN"",""FBAAPPH"",46,0)"
^XMB(3.9,146052,2,1658,0)=" ; write adjustment reasons, if null then write suspend code"
^XMB(3.9,146052,2,1659,0)="""RTN"",""FBAAPPH"",47,0)"
^XMB(3.9,146052,2,1660,0)=" W ?22,$S(FBADJLR]"""":FBADJLR,1:FBSUSP)"
^XMB(3.9,146052,2,1661,0)="""RTN"",""FBAAPPH"",48,0)"
^XMB(3.9,146052,2,1662,0)=" ; write adjustment amounts, if null then write amount suspended"
^XMB(3.9,146052,2,1663,0)="""RTN"",""FBAAPPH"",49,0)"
^XMB(3.9,146052,2,1664,0)=" W ?32,$S(FBADJLA]"""":FBADJLA,1:FBSUSPA)"
^XMB(3.9,146052,2,1665,0)="""RTN"",""FBAAPPH"",50,0)"
^XMB(3.9,146052,2,1666,0)=" W ?47,FBINVN,?58,FBBATCH,?67,FBRRMKL"
^XMB(3.9,146052,2,1667,0)="""RTN"",""FBAAPPH"",51,0)"
^XMB(3.9,146052,2,1668,0)=" I FBFPPSC]"""" W !,?5,""FPPS Claim ID: "",FBFPPSC,""   FPPS Line Item: "",FBFPPSL"
^XMB(3.9,146052,2,1669,0)="""RTN"",""FBAAPPH"",52,0)"
^XMB(3.9,146052,2,1670,0)=" I $D(FBSAR) W !?5,""Suspension Description: "" S FBI=0 F  S FBI=$O(FBSAR(FBI)) Q:'FBI  W "" "",FBSAR(FBI)"
^XMB(3.9,146052,2,1671,0)="""RTN"",""FBAAPPH"",53,0)"
^XMB(3.9,146052,2,1672,0)=" D PMNT^FBAACCB2"
^XMB(3.9,146052,2,1673,0)="""RTN"",""FBAAPPH"",54,0)"
