^XMB(3.9,146020,2,1020,0)=" S MPIA(""name"")=$G(MPIA(""name""))"
^XMB(3.9,146020,2,1021,0)="""RTN"",""MPIFXMLP"",175,0)"
^XMB(3.9,146020,2,1022,0)=" S MPIA(""value"")=$G(MPIA(""value""))"
^XMB(3.9,146020,2,1023,0)="""RTN"",""MPIFXMLP"",176,0)"
^XMB(3.9,146020,2,1024,0)=" ; my variable to protect"
^XMB(3.9,146020,2,1025,0)="""RTN"",""MPIFXMLP"",177,0)"
^XMB(3.9,146020,2,1026,0)=" S MPIUSE=$G(MPIUSE)"
^XMB(3.9,146020,2,1027,0)="""RTN"",""MPIFXMLP"",178,0)"
^XMB(3.9,146020,2,1028,0)=" ;"
^XMB(3.9,146020,2,1029,0)="""RTN"",""MPIFXMLP"",179,0)"
^XMB(3.9,146020,2,1030,0)=" ; got a business rule error"
^XMB(3.9,146020,2,1031,0)="""RTN"",""MPIFXMLP"",180,0)"
^XMB(3.9,146020,2,1032,0)=" I MPIN=""RESULT"",MPIA(""type"")=""AA"",MPIA(""subtype"")=""QE"" S MPIDATA(""Result"")=""QE"" Q"
^XMB(3.9,146020,2,1033,0)="""RTN"",""MPIFXMLP"",181,0)"
^XMB(3.9,146020,2,1034,0)=" ; don't use these"
^XMB(3.9,146020,2,1035,0)="""RTN"",""MPIFXMLP"",182,0)"
^XMB(3.9,146020,2,1036,0)=" I MPIN=""IDM_RESPONSE""!(MPIN=""METADATA"")!(MPIN=""IDATTR"") Q"
^XMB(3.9,146020,2,1037,0)="""RTN"",""MPIFXMLP"",183,0)"
^XMB(3.9,146020,2,1038,0)=" ;**74,Story 1258907 (mko): Don't ignore ISSUER or STATUS elements"
^XMB(3.9,146020,2,1039,0)="""RTN"",""MPIFXMLP"",184,0)"
^XMB(3.9,146020,2,1040,0)=" I MPIN=""RESULT"" Q  ;!(MPIN=""ISSUER"")!(MPIN=""STATUS"") Q"
^XMB(3.9,146020,2,1041,0)="""RTN"",""MPIFXMLP"",185,0)"
^XMB(3.9,146020,2,1042,0)=" I MPIN=""EFFECTIVE""!(MPIN=""BADADDRESSCODE"")!(MPIN=""BADADDRESSTEXT"") Q"
^XMB(3.9,146020,2,1043,0)="""RTN"",""MPIFXMLP"",186,0)"
^XMB(3.9,146020,2,1044,0)=" I MPIN=""IDATTR"",MPIA(""type"")=""PSEUDO_SSN"",MPIA(""subtype"")=""CODE"" Q"
^XMB(3.9,146020,2,1045,0)="""RTN"",""MPIFXMLP"",187,0)"
^XMB(3.9,146020,2,1046,0)=" I MPIN=""ASSOC"",MPIA(""type"")=""ALIAS_SSN"" Q"
^XMB(3.9,146020,2,1047,0)="""RTN"",""MPIFXMLP"",188,0)"
^XMB(3.9,146020,2,1048,0)=" ;"
^XMB(3.9,146020,2,1049,0)="""RTN"",""MPIFXMLP"",189,0)"
^XMB(3.9,146020,2,1050,0)=" ; save some field data"
^XMB(3.9,146020,2,1051,0)="""RTN"",""MPIFXMLP"",190,0)"
^XMB(3.9,146020,2,1052,0)=" I MPIN=""FIELD"" S:MPIA(""name"")]"""" MPIDATA(MPIA(""name""))=MPIA(""value"") Q"
^XMB(3.9,146020,2,1053,0)="""RTN"",""MPIFXMLP"",191,0)"
^XMB(3.9,146020,2,1054,0)=" ;"
^XMB(3.9,146020,2,1055,0)="""RTN"",""MPIFXMLP"",192,0)"
^XMB(3.9,146020,2,1056,0)=" ;**74,Story 1258907 (mko): For each PROFILE encountered, also initialize MPIIDS to 0"
^XMB(3.9,146020,2,1057,0)="""RTN"",""MPIFXMLP"",193,0)"
^XMB(3.9,146020,2,1058,0)=" I MPIN=""PROFILE"" S MPIPAT=MPIPAT+1,MPIALIAS=0,MPIIDS=0,MPILOC=""MPIDATA(""_MPIPAT Q"
^XMB(3.9,146020,2,1059,0)="""RTN"",""MPIFXMLP"",194,0)"
^XMB(3.9,146020,2,1060,0)=" I MPIN=""NAME"" D  Q"
^XMB(3.9,146020,2,1061,0)="""RTN"",""MPIFXMLP"",195,0)"
^XMB(3.9,146020,2,1062,0)=" . S MPIUSE=MPIA(""type"")"
^XMB(3.9,146020,2,1063,0)="""RTN"",""MPIFXMLP"",196,0)"
^XMB(3.9,146020,2,1064,0)=" . S:MPIUSE=""A"" MPIALIAS=MPIALIAS+1"
^XMB(3.9,146020,2,1065,0)="""RTN"",""MPIFXMLP"",197,0)"
^XMB(3.9,146020,2,1066,0)=" I MPIUSE=""D"",MPIN=""NAME"" S MPIVAR="",""""PreferName"""")"" q"
^XMB(3.9,146020,2,1067,0)="""RTN"",""MPIFXMLP"",198,0)"
^XMB(3.9,146020,2,1068,0)=" I MPIN=""FIRSTNAME"",MPIUSE=""L"" S MPIVAR="",""""FirstName"""")"" Q"
^XMB(3.9,146020,2,1069,0)="""RTN"",""MPIFXMLP"",199,0)"
^XMB(3.9,146020,2,1070,0)=" I MPIN=""LASTNAME"",MPIUSE=""L"" S MPIVAR="",""""Surname"""")"" Q"
^XMB(3.9,146020,2,1071,0)="""RTN"",""MPIFXMLP"",200,0)"
^XMB(3.9,146020,2,1072,0)=" I MPIN=""MIDDLENAME"",MPIUSE=""L"" S MPIVAR="",""""MiddleName"""")"" Q"
^XMB(3.9,146020,2,1073,0)="""RTN"",""MPIFXMLP"",201,0)"
^XMB(3.9,146020,2,1074,0)=" I MPIN=""SUFFIX"",MPIUSE=""L"" S MPIVAR="",""""Suffix"""")"" Q"
^XMB(3.9,146020,2,1075,0)="""RTN"",""MPIFXMLP"",202,0)"
^XMB(3.9,146020,2,1076,0)=" I MPIN=""PREFIX"",MPIUSE=""L"" S MPIVAR="",""""Prefix"""")"" Q"
^XMB(3.9,146020,2,1077,0)="""RTN"",""MPIFXMLP"",203,0)"
^XMB(3.9,146020,2,1078,0)=" I MPIN=""FIRSTNAME"",MPIUSE=""A"" S MPIVAR="",""""ALIAS"""",""_MPIALIAS_"",""""FirstName"""")"" Q"
