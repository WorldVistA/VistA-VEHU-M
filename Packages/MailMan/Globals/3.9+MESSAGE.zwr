^XMB(3.9,146101,2,1104,0)=" .D FORMATAI^PSSPGXP2(PSSRCEVL,79,0,,1)"
^XMB(3.9,146101,2,1105,0)="""RTN"",""PSSPGXPR"",224,0)"
^XMB(3.9,146101,2,1106,0)=" S PSSPHDT(""DISDATE"")=$S($G(PSSPHDT(""PSSDIFD""))>$G(PSSPHDT(""PSSCUSTD"")):$G(PSSPHDT(""PSSDIFD"")),1:$G(PSSPHDT(""PSSCUSTD"")))"
^XMB(3.9,146101,2,1107,0)="""RTN"",""PSSPGXPR"",225,0)"
