^XMB(3.9,146047,2,1125,0)="""RTN"",""IBCNEDST"",23,0)"
^XMB(3.9,146047,2,1126,0)=" S XX=$O(^IBE(350.9,1,51.17,""B"",2,""""))              ; Find Appointment multiple"
^XMB(3.9,146047,2,1127,0)="""RTN"",""IBCNEDST"",24,0)"
^XMB(3.9,146047,2,1128,0)=" S XX=$$GET1^DIQ(350.9002,XX_"",1,"",.05,""I"")         ; Maximum Appointment Extract"
^XMB(3.9,146047,2,1129,0)="""RTN"",""IBCNEDST"",25,0)"
^XMB(3.9,146047,2,1130,0)=" S $P(DATA,""^"",4)=XX"
^XMB(3.9,146047,2,1131,0)="""RTN"",""IBCNEDST"",26,0)"
^XMB(3.9,146047,2,1132,0)=" S XX=$O(^IBE(350.9,1,51.17,""B"",1,""""))              ; Find Buffer multiple"
^XMB(3.9,146047,2,1133,0)="""RTN"",""IBCNEDST"",27,0)"
^XMB(3.9,146047,2,1134,0)=" S XX=$$GET1^DIQ(350.9002,XX_"",1,"",.05,""I"")         ; Maximum Buffer Extract"
^XMB(3.9,146047,2,1135,0)="""RTN"",""IBCNEDST"",28,0)"
^XMB(3.9,146047,2,1136,0)=" S $P(DATA,""^"",5)=XX"
^XMB(3.9,146047,2,1137,0)="""RTN"",""IBCNEDST"",29,0)"
^XMB(3.9,146047,2,1138,0)=" S $P(DATA,""^"",6)=$$GET1^DIQ(350.9,""1,"",51.32,""I"") ; MEDICARE Freshness Days  ;/vd - IB*2*659"
^XMB(3.9,146047,2,1139,0)="""RTN"",""IBCNEDST"",30,0)"
^XMB(3.9,146047,2,1140,0)=" Q DATA"
^XMB(3.9,146047,2,1141,0)="""RTN"",""IBCNEDST"",31,0)"
^XMB(3.9,146047,2,1142,0)=" ;"
^XMB(3.9,146047,2,1143,0)="""RTN"",""IBCNEDST"",32,0)"
^XMB(3.9,146047,2,1144,0)="GETSTAT(MCAUTO) ; get statistical data"
^XMB(3.9,146047,2,1145,0)="""RTN"",""IBCNEDST"",33,0)"
^XMB(3.9,146047,2,1146,0)=" ; Statistics are to match the eIV Statistical Report (^IBCNEPR8)"
^XMB(3.9,146047,2,1147,0)="""RTN"",""IBCNEDST"",34,0)"
^XMB(3.9,146047,2,1148,0)=" ;   IB*664/DW Added parameter ""MCAUTO"" - this will be used to split out the count of"
^XMB(3.9,146047,2,1149,0)="""RTN"",""IBCNEDST"",35,0)"
^XMB(3.9,146047,2,1150,0)=" ;             Medicare auto-updated responses from the all other eIV responses that"
^XMB(3.9,146047,2,1151,0)="""RTN"",""IBCNEDST"",36,0)"
^XMB(3.9,146047,2,1152,0)=" ;             were auto updated. We now have two calculated totals.  Medicare and"
^XMB(3.9,146047,2,1153,0)="""RTN"",""IBCNEDST"",37,0)"
^XMB(3.9,146047,2,1154,0)=" ;             not Medicare eIV responses that were auto-updated."
^XMB(3.9,146047,2,1155,0)="""RTN"",""IBCNEDST"",38,0)"
^XMB(3.9,146047,2,1156,0)=" ;"
^XMB(3.9,146047,2,1157,0)="""RTN"",""IBCNEDST"",39,0)"
^XMB(3.9,146047,2,1158,0)=" ; returns the following string, delimited by ""^"":"
^XMB(3.9,146047,2,1159,0)="""RTN"",""IBCNEDST"",40,0)"
^XMB(3.9,146047,2,1160,0)=" ;"
^XMB(3.9,146047,2,1161,0)="""RTN"",""IBCNEDST"",41,0)"
^XMB(3.9,146047,2,1162,0)=" ;   piece 1  - Number of patients with potential secondary/tertiary insurance as identified by Medicare"
^XMB(3.9,146047,2,1163,0)="""RTN"",""IBCNEDST"",42,0)"
^XMB(3.9,146047,2,1164,0)=" ;   piece 2  - Number of automatically updated patient insurance records processed yesterday only "
^XMB(3.9,146047,2,1165,0)="""RTN"",""IBCNEDST"",43,0)"
^XMB(3.9,146047,2,1166,0)=" ;   piece 3  - Number of 270 inquiries pending receipt of 271 responses"
^XMB(3.9,146047,2,1167,0)="""RTN"",""IBCNEDST"",44,0)"
^XMB(3.9,146047,2,1168,0)=" ;   piece 4  - Number of queued 270 inquiries"
^XMB(3.9,146047,2,1169,0)="""RTN"",""IBCNEDST"",45,0)"
^XMB(3.9,146047,2,1170,0)=" ;   piece 5  - Number of deferred 270 inquiries"
^XMB(3.9,146047,2,1171,0)="""RTN"",""IBCNEDST"",46,0)"
^XMB(3.9,146047,2,1172,0)=" ;   piece 6  - Number of insurance companies with no National ID"
^XMB(3.9,146047,2,1173,0)="""RTN"",""IBCNEDST"",47,0)"
^XMB(3.9,146047,2,1174,0)=" ;   piece 7  - Number of locally disabled payers"
^XMB(3.9,146047,2,1175,0)="""RTN"",""IBCNEDST"",48,0)"
^XMB(3.9,146047,2,1176,0)=" ;   piece 8  - Number of Verified (*) buffer entries ; IB*737/DTG will be zero, not use '*' verified"
^XMB(3.9,146047,2,1177,0)="""RTN"",""IBCNEDST"",49,0)"
^XMB(3.9,146047,2,1178,0)=" ;   piece 9  - Number of buffer entries indicated as having Active insurance (+)"
^XMB(3.9,146047,2,1179,0)="""RTN"",""IBCNEDST"",50,0)"
^XMB(3.9,146047,2,1180,0)=" ;   piece 10 - Number of buffer entries indicated as having Inactive insurance (-)"
^XMB(3.9,146047,2,1181,0)="""RTN"",""IBCNEDST"",51,0)"
^XMB(3.9,146047,2,1182,0)=" ;   piece 11 - Number of buffer entries indicated as policy status undetermined (#)"
^XMB(3.9,146047,2,1183,0)="""RTN"",""IBCNEDST"",52,0)"
^XMB(3.9,146047,2,1184,0)=" ;   piece 12 - Number of buffer entries indicated as requiring correction before 270 can be sent (!)"
^XMB(3.9,146047,2,1185,0)="""RTN"",""IBCNEDST"",53,0)"
^XMB(3.9,146047,2,1186,0)=" ;   piece 13 - Number of buffer entries awaiting processing"
^XMB(3.9,146047,2,1187,0)="""RTN"",""IBCNEDST"",54,0)"
^XMB(3.9,146047,2,1188,0)=" ;   piece 14 - Number of buffer entries indicated as waiting for a 271 response (?)"
^XMB(3.9,146047,2,1189,0)="""RTN"",""IBCNEDST"",55,0)"
^XMB(3.9,146047,2,1190,0)=" ;   piece 15 - Number of buffer entries entered by manual process with no further processing (blank)"
^XMB(3.9,146047,2,1191,0)="""RTN"",""IBCNEDST"",56,0)"
^XMB(3.9,146047,2,1192,0)=" ;   piece 16 - Number of unlinked insurance companies"
^XMB(3.9,146047,2,1193,0)="""RTN"",""IBCNEDST"",57,0)"
^XMB(3.9,146047,2,1194,0)=" ;"
^XMB(3.9,146047,2,1195,0)="""RTN"",""IBCNEDST"",58,0)"
^XMB(3.9,146047,2,1196,0)=" N BUFINFO,PAYINFO,RESPINFO,STARTDTTM,TQINFO,STATS"
^XMB(3.9,146047,2,1197,0)="""RTN"",""IBCNEDST"",59,0)"
^XMB(3.9,146047,2,1198,0)=" ;"
^XMB(3.9,146047,2,1199,0)="""RTN"",""IBCNEDST"",60,0)"
^XMB(3.9,146047,2,1200,0)=" S STARTDTTM=$$FMADD^XLFDT($$NOW^XLFDT(),,-24) ; set to current date/time - 24 hours"
^XMB(3.9,146047,2,1201,0)="""RTN"",""IBCNEDST"",61,0)"
^XMB(3.9,146047,2,1202,0)=" ; IB*664/DW Added parameter ""MCAUTO"" to line below"
^XMB(3.9,146047,2,1203,0)="""RTN"",""IBCNEDST"",62,0)"
^XMB(3.9,146047,2,1204,0)=" S RESPINFO=$$RESPINFO(STARTDTTM,.MCAUTO) ; get data from file 365"
^XMB(3.9,146047,2,1205,0)="""RTN"",""IBCNEDST"",63,0)"
^XMB(3.9,146047,2,1206,0)=" S TQINFO=$$TQINFO() ; get data from file 365.1"
^XMB(3.9,146047,2,1207,0)="""RTN"",""IBCNEDST"",64,0)"
^XMB(3.9,146047,2,1208,0)=" S PAYINFO=$$PAYINFO() ; get data from file 36 & 365.12"
^XMB(3.9,146047,2,1209,0)="""RTN"",""IBCNEDST"",65,0)"
^XMB(3.9,146047,2,1210,0)=" S BUFINFO=$$BUFINFO() ; get data from file 355.33"
^XMB(3.9,146047,2,1211,0)="""RTN"",""IBCNEDST"",66,0)"
^XMB(3.9,146047,2,1212,0)=" S STATS=RESPINFO_U_TQINFO_U_$P(PAYINFO,U)_U_$P(PAYINFO,U,2)"
^XMB(3.9,146047,2,1213,0)="""RTN"",""IBCNEDST"",67,0)"
^XMB(3.9,146047,2,1214,0)=" S STATS=STATS_U_BUFINFO_U_$P(PAYINFO,U,3)"
^XMB(3.9,146047,2,1215,0)="""RTN"",""IBCNEDST"",68,0)"
^XMB(3.9,146047,2,1216,0)=" Q STATS"
^XMB(3.9,146047,2,1217,0)="""RTN"",""IBCNEDST"",69,0)"
^XMB(3.9,146047,2,1218,0)=" ;"
^XMB(3.9,146047,2,1219,0)="""RTN"",""IBCNEDST"",70,0)"
^XMB(3.9,146047,2,1220,0)="RESPINFO(DTTM,MCAUTO) ; get data from IIV Response file (file 365)"
^XMB(3.9,146047,2,1221,0)="""RTN"",""IBCNEDST"",71,0)"
^XMB(3.9,146047,2,1222,0)=" ; DTTM - start date/time"
^XMB(3.9,146047,2,1223,0)="""RTN"",""IBCNEDST"",72,0)"
^XMB(3.9,146047,2,1224,0)=" ; MCAUTO - total # of auto-updated eIV responses that ARE Medicare related"
^XMB(3.9,146047,2,1225,0)="""RTN"",""IBCNEDST"",73,0)"
^XMB(3.9,146047,2,1226,0)=" ;  IB*664/DW Added parameter ""MCAUTO"""
^XMB(3.9,146047,2,1227,0)="""RTN"",""IBCNEDST"",74,0)"
^XMB(3.9,146047,2,1228,0)=" ;"
^XMB(3.9,146047,2,1229,0)="""RTN"",""IBCNEDST"",75,0)"
^XMB(3.9,146047,2,1230,0)=" ; returns the following string, delimited by ""^"":"
^XMB(3.9,146047,2,1231,0)="""RTN"",""IBCNEDST"",76,0)"
^XMB(3.9,146047,2,1232,0)=" ;   piece 1: number of patients with potential secondary/tertiary insurance as identified by Medicare"
^XMB(3.9,146047,2,1233,0)="""RTN"",""IBCNEDST"",77,0)"
^XMB(3.9,146047,2,1234,0)=" ;   piece 2: Number of automatically updated patient insurance records processed yesterday only"
^XMB(3.9,146047,2,1235,0)="""RTN"",""IBCNEDST"",78,0)"
^XMB(3.9,146047,2,1236,0)=" ;   piece 3: Number of 270 inquiries pending receipt of 271 responses"
^XMB(3.9,146047,2,1237,0)="""RTN"",""IBCNEDST"",79,0)"
^XMB(3.9,146047,2,1238,0)=" ;"
^XMB(3.9,146047,2,1239,0)="""RTN"",""IBCNEDST"",80,0)"
^XMB(3.9,146047,2,1240,0)=" ; also returns MCAUTO - # of eIV responses from the Medicare payer that were auto-updated"
^XMB(3.9,146047,2,1241,0)="""RTN"",""IBCNEDST"",81,0)"
^XMB(3.9,146047,2,1242,0)=" ;"
^XMB(3.9,146047,2,1243,0)="""RTN"",""IBCNEDST"",82,0)"
^XMB(3.9,146047,2,1244,0)=" N AUTOUPD,DATE,DFN,EBIEN,IEN,INSNAMES,INSTYPE,INQP,POLICY,PAYER,PAYERWNR,PYRNAME,SECINS,Z"
^XMB(3.9,146047,2,1245,0)="""RTN"",""IBCNEDST"",83,0)"
^XMB(3.9,146047,2,1246,0)=" ; IB*2.0*702/DTG- start Added number of outgoing EICD (A1) 270 transactions."
^XMB(3.9,146047,2,1247,0)="""RTN"",""IBCNEDST"",84,0)"
^XMB(3.9,146047,2,1248,0)=" ;                      Number of outgoing EICD-triggered (A2) 270 transactions."
^XMB(3.9,146047,2,1249,0)="""RTN"",""IBCNEDST"",85,0)"
^XMB(3.9,146047,2,1250,0)=" ;                      Number of outgoing MBI Request 270 transactions."
^XMB(3.9,146047,2,1251,0)="""RTN"",""IBCNEDST"",86,0)"
^XMB(3.9,146047,2,1252,0)=" ;                      Number of incoming MBI positive responses that indicated as having returned the MBI (%)."
^XMB(3.9,146047,2,1253,0)="""RTN"",""IBCNEDST"",87,0)"
^XMB(3.9,146047,2,1254,0)=" N IB1P,IB2D,IB3IEN,IBA1,IBA2,IB40,IBTQ,IBTYP,IBQRY,IBAT1,IBAT2,IBSID,IBMBI,IBMBS"
^XMB(3.9,146047,2,1255,0)="""RTN"",""IBCNEDST"",88,0)"
^XMB(3.9,146047,2,1256,0)=" S (IB1P,IB2D,IB3IEN,IBA1,IBA2,IB40,IBAT1,IBAT2,IBMBI,IBMBS)="""""
^XMB(3.9,146047,2,1257,0)="""RTN"",""IBCNEDST"",89,0)"
^XMB(3.9,146047,2,1258,0)=" S DSTATPA=$G(DSTATPA),DSTATI=$G(DSTATI)"
^XMB(3.9,146047,2,1259,0)="""RTN"",""IBCNEDST"",90,0)"
^XMB(3.9,146047,2,1260,0)=" ; IB*2.0*702/DTG - end Added"
^XMB(3.9,146047,2,1261,0)="""RTN"",""IBCNEDST"",91,0)"
^XMB(3.9,146047,2,1262,0)=" S SECINS=0"
^XMB(3.9,146047,2,1263,0)="""RTN"",""IBCNEDST"",92,0)"
^XMB(3.9,146047,2,1264,0)=" S PAYERWNR=$P($G(^IBE(350.9,1,51)),U,25) ; get Medicare payer ien from IB site parameters"
^XMB(3.9,146047,2,1265,0)="""RTN"",""IBCNEDST"",93,0)"
^XMB(3.9,146047,2,1266,0)=" ;"
^XMB(3.9,146047,2,1267,0)="""RTN"",""IBCNEDST"",94,0)"
^XMB(3.9,146047,2,1268,0)=" ; IB*664/DW - Added 1st 3 parameters to PATINFO, changed from extrinsic function"
^XMB(3.9,146047,2,1269,0)="""RTN"",""IBCNEDST"",95,0)"
^XMB(3.9,146047,2,1270,0)=" D PATINFO(.AUTOUPD,PAYERWNR,.MCAUTO) ; IB*2*595/DM rewrote PATINFO"
^XMB(3.9,146047,2,1271,0)="""RTN"",""IBCNEDST"",96,0)"
^XMB(3.9,146047,2,1272,0)=" S DATE=DTTM-0.000001 F  S DATE=$O(^IBCN(365,""AD"",DATE)) Q:DATE=""""  D"
^XMB(3.9,146047,2,1273,0)="""RTN"",""IBCNEDST"",97,0)"
^XMB(3.9,146047,2,1274,0)=" .;IB*2*595/DM next 4 lines no longer applicable"
^XMB(3.9,146047,2,1275,0)="""RTN"",""IBCNEDST"",98,0)"
^XMB(3.9,146047,2,1276,0)=" .; if response received within the last 24 hrs, check if it auto-updated insurance policy"
^XMB(3.9,146047,2,1277,0)="""RTN"",""IBCNEDST"",99,0)"
^XMB(3.9,146047,2,1278,0)=" .;S PAYER=0 F  S PAYER=$O(^IBCN(365,""AD"",DATE,PAYER)) Q:PAYER=""""  D"
^XMB(3.9,146047,2,1279,0)="""RTN"",""IBCNEDST"",100,0)"
^XMB(3.9,146047,2,1280,0)=" .;.S DFN=0 F  S DFN=$O(^IBCN(365,""AD"",DATE,PAYER,DFN)) Q:DFN=""""  S AUTOUPD=AUTOUPD+$$PATINFO(DFN)"
^XMB(3.9,146047,2,1281,0)="""RTN"",""IBCNEDST"",101,0)"
^XMB(3.9,146047,2,1282,0)=" .;.Q"
^XMB(3.9,146047,2,1283,0)="""RTN"",""IBCNEDST"",102,0)"
^XMB(3.9,146047,2,1284,0)=" .I PAYERWNR,$D(^IBCN(365,""AD"",DATE,PAYERWNR)) D"
^XMB(3.9,146047,2,1285,0)="""RTN"",""IBCNEDST"",103,0)"
^XMB(3.9,146047,2,1286,0)=" ..S DFN=0 F  S DFN=$O(^IBCN(365,""AD"",DATE,PAYERWNR,DFN)) Q:DFN=""""  D"
^XMB(3.9,146047,2,1287,0)="""RTN"",""IBCNEDST"",104,0)"
^XMB(3.9,146047,2,1288,0)=" ...; create array of ins. company names for this patient (active policies only)"
^XMB(3.9,146047,2,1289,0)="""RTN"",""IBCNEDST"",105,0)"
^XMB(3.9,146047,2,1290,0)=" ...K INSNAMES S INSTYPE=0 F  S INSTYPE=$O(^DPT(DFN,.312,""B"",INSTYPE)) Q:INSTYPE=""""  D"
^XMB(3.9,146047,2,1291,0)="""RTN"",""IBCNEDST"",106,0)"
^XMB(3.9,146047,2,1292,0)=" ....S POLICY=0 F  S POLICY=$O(^DPT(DFN,.312,""B"",INSTYPE,POLICY)) Q:POLICY=""""  D"
^XMB(3.9,146047,2,1293,0)="""RTN"",""IBCNEDST"",107,0)"
^XMB(3.9,146047,2,1294,0)=" .....; skip policies that are not active"
^XMB(3.9,146047,2,1295,0)="""RTN"",""IBCNEDST"",108,0)"
^XMB(3.9,146047,2,1296,0)=" .....I $$CHK^IBCNS1(^DPT(DFN,.312,POLICY,0),DT,1) S INSNAMES($$EXTERNAL^DILFD(2.312,.01,,INSTYPE))="""""
^XMB(3.9,146047,2,1297,0)="""RTN"",""IBCNEDST"",109,0)"
^XMB(3.9,146047,2,1298,0)=" .....Q"
^XMB(3.9,146047,2,1299,0)="""RTN"",""IBCNEDST"",110,0)"
^XMB(3.9,146047,2,1300,0)=" ....Q"
^XMB(3.9,146047,2,1301,0)="""RTN"",""IBCNEDST"",111,0)"
^XMB(3.9,146047,2,1302,0)=" ...S IEN=0 F  S IEN=$O(^IBCN(365,""AD"",DATE,PAYERWNR,DFN,IEN)) Q:IEN=""""  D"
^XMB(3.9,146047,2,1303,0)="""RTN"",""IBCNEDST"",112,0)"
^XMB(3.9,146047,2,1304,0)=" ....S Z="""" F  S Z=$O(^IBCN(365,IEN,2,""B"",Z)) Q:Z=""""  D"
^XMB(3.9,146047,2,1305,0)="""RTN"",""IBCNEDST"",113,0)"
^XMB(3.9,146047,2,1306,0)=" .....S EBIEN=$O(^IBCN(365,IEN,2,""B"",Z,""""))"
^XMB(3.9,146047,2,1307,0)="""RTN"",""IBCNEDST"",114,0)"
^XMB(3.9,146047,2,1308,0)=" .....; make sure eligibility code is ""R"""
^XMB(3.9,146047,2,1309,0)="""RTN"",""IBCNEDST"",115,0)"
^XMB(3.9,146047,2,1310,0)=" .....I $$GET1^DIQ(365.02,EBIEN_"",""_IEN_"","",.02)'=""R"" Q"
^XMB(3.9,146047,2,1311,0)="""RTN"",""IBCNEDST"",116,0)"
^XMB(3.9,146047,2,1312,0)=" .....S PYRNAME=$E($P($G(^IBCN(365,IEN,2,EBIEN,3)),U,3),1,30) ; grab first 30 chars to compare to 36/.01"
^XMB(3.9,146047,2,1313,0)="""RTN"",""IBCNEDST"",117,0)"
^XMB(3.9,146047,2,1314,0)=" .....I PYRNAME'="""",'$D(INSNAMES(PYRNAME)) S SECINS=SECINS+1"
^XMB(3.9,146047,2,1315,0)="""RTN"",""IBCNEDST"",118,0)"
^XMB(3.9,146047,2,1316,0)=" . ; IB*2.0*702/DTG- start Added number of outgoing EICD (A1) 270 transactions. number of outgoing EICD-triggered (A2) 270 transactions"
^XMB(3.9,146047,2,1317,0)="""RTN"",""IBCNEDST"",119,0)"
^XMB(3.9,146047,2,1318,0)=" . ;                   number of outgoing MBI Request 270 transactions"
^XMB(3.9,146047,2,1319,0)="""RTN"",""IBCNEDST"",120,0)"
^XMB(3.9,146047,2,1320,0)=" . I $G(DSTATI)=1 D  ;<"
^XMB(3.9,146047,2,1321,0)="""RTN"",""IBCNEDST"",121,0)"
^XMB(3.9,146047,2,1322,0)=" . . S IB1P="""" F  S IB1P=$O(^IBCN(365,""AD"",DATE,IB1P)) Q:IB1P=""""  S IB2D="""" D  ;<"
^XMB(3.9,146047,2,1323,0)="""RTN"",""IBCNEDST"",122,0)"
^XMB(3.9,146047,2,1324,0)=" . . . F  S IB2D=$O(^IBCN(365,""AD"",DATE,IB1P,IB2D)) Q:IB2D=""""  S IB3IEN="""" D  ;<"
^XMB(3.9,146047,2,1325,0)="""RTN"",""IBCNEDST"",123,0)"
^XMB(3.9,146047,2,1326,0)=" . . . . F  S IB3IEN=$O(^IBCN(365,""AD"",DATE,IB1P,IB2D,IB3IEN)) Q:IB3IEN=""""  D  ;<"
^XMB(3.9,146047,2,1327,0)="""RTN"",""IBCNEDST"",124,0)"
^XMB(3.9,146047,2,1328,0)=" . . . . . S IENS=IB3IEN_"","" K IB40 D GETS^DIQ(365,IENS,""13.02;.05;.1"",""IE"",""IB40"")"
^XMB(3.9,146047,2,1329,0)="""RTN"",""IBCNEDST"",125,0)"
^XMB(3.9,146047,2,1330,0)=" . . . . . I $G(IB40(365,IENS,.1,""I""))'=""O"" Q"
^XMB(3.9,146047,2,1331,0)="""RTN"",""IBCNEDST"",126,0)"
^XMB(3.9,146047,2,1332,0)=" . . . . . S IBSID=$G(IB40(365,IENS,13.02,""I""))"
^XMB(3.9,146047,2,1333,0)="""RTN"",""IBCNEDST"",127,0)"
^XMB(3.9,146047,2,1334,0)=" . . . . . S IBTQ=$G(IB40(365,IENS,.05,""I""))"
^XMB(3.9,146047,2,1335,0)="""RTN"",""IBCNEDST"",128,0)"
^XMB(3.9,146047,2,1336,0)=" . . . . . S IBTYP=$$GET1^DIQ(365.1,IBTQ_"","",.1,""I""),IBQRY=$$GET1^DIQ(365.1,IBTQ_"","",.11,""I"")"
^XMB(3.9,146047,2,1337,0)="""RTN"",""IBCNEDST"",129,0)"
^XMB(3.9,146047,2,1338,0)=" . . . . . ; IBMBI - Number of incoming MBI positive responses that indicated as having returned the MBI (%)"
^XMB(3.9,146047,2,1339,0)="""RTN"",""IBCNEDST"",130,0)"
^XMB(3.9,146047,2,1340,0)=" . . . . . I IBTYP=7&(IBSID'="""") S IBMBI=$G(IBMBI)+1 Q"
^XMB(3.9,146047,2,1341,0)="""RTN"",""IBCNEDST"",131,0)"
^XMB(3.9,146047,2,1342,0)=" ;"
^XMB(3.9,146047,2,1343,0)="""RTN"",""IBCNEDST"",132,0)"
^XMB(3.9,146047,2,1344,0)=" I $G(DSTATI)=1 D  ;<"
^XMB(3.9,146047,2,1345,0)="""RTN"",""IBCNEDST"",133,0)"
^XMB(3.9,146047,2,1346,0)=" . S DATE=DTTM-0.000001 F  S DATE=$O(^IBCN(365,""AE"",DATE)) Q:DATE=""""  D  ;<"
^XMB(3.9,146047,2,1347,0)="""RTN"",""IBCNEDST"",134,0)"
^XMB(3.9,146047,2,1348,0)=" . . S IB3IEN="""" F  S IB3IEN=$O(^IBCN(365,""AE"",DATE,IB3IEN)) Q:IB3IEN=""""  D  ;<"
^XMB(3.9,146047,2,1349,0)="""RTN"",""IBCNEDST"",135,0)"
^XMB(3.9,146047,2,1350,0)=" . . . S IENS=IB3IEN_"","" K IB40 D GETS^DIQ(365,IENS,""13.02;.05;.1"",""IE"",""IB40"")"
^XMB(3.9,146047,2,1351,0)="""RTN"",""IBCNEDST"",136,0)"
^XMB(3.9,146047,2,1352,0)=" . . . I $G(IB40(365,IENS,.1,""I""))'=""O"" Q"
^XMB(3.9,146047,2,1353,0)="""RTN"",""IBCNEDST"",137,0)"
^XMB(3.9,146047,2,1354,0)=" . . . S IBSID=$G(IB40(365,IENS,13.02,""I""))"
^XMB(3.9,146047,2,1355,0)="""RTN"",""IBCNEDST"",138,0)"
^XMB(3.9,146047,2,1356,0)=" . . . S IBTQ=$G(IB40(365,IENS,.05,""I""))"
^XMB(3.9,146047,2,1357,0)="""RTN"",""IBCNEDST"",139,0)"
^XMB(3.9,146047,2,1358,0)=" . . . S IBTYP=$$GET1^DIQ(365.1,IBTQ_"","",.1,""I""),IBQRY=$$GET1^DIQ(365.1,IBTQ_"","",.11,""I"")"
^XMB(3.9,146047,2,1359,0)="""RTN"",""IBCNEDST"",140,0)"
^XMB(3.9,146047,2,1360,0)=" . . . ;  IBA1 - Number of outgoing EICD (A1) 270 transactions"
^XMB(3.9,146047,2,1361,0)="""RTN"",""IBCNEDST"",141,0)"
^XMB(3.9,146047,2,1362,0)=" . . . ;  IBA2 - Number of outgoing EICD-triggered (A2) 270 transactions"
^XMB(3.9,146047,2,1363,0)="""RTN"",""IBCNEDST"",142,0)"
^XMB(3.9,146047,2,1364,0)=" . . . ; IBMBS - Number of outgoing MBI Request 270 transactions"
^XMB(3.9,146047,2,1365,0)="""RTN"",""IBCNEDST"",143,0)"
^XMB(3.9,146047,2,1366,0)=" . . . I IBTYP=7 S IBMBS=$G(IBMBS)+1 Q"
^XMB(3.9,146047,2,1367,0)="""RTN"",""IBCNEDST"",144,0)"
^XMB(3.9,146047,2,1368,0)=" . . . I IBTYP=4 S:IBQRY=""I"" IBA1=$G(IBA1)+1 S:IBQRY=""V"" IBA2=$G(IBA2)+1"
^XMB(3.9,146047,2,1369,0)="""RTN"",""IBCNEDST"",145,0)"
^XMB(3.9,146047,2,1370,0)=" . . ; IB*2.0*702/DTG - end Added"
^XMB(3.9,146047,2,1371,0)="""RTN"",""IBCNEDST"",146,0)"
^XMB(3.9,146047,2,1372,0)=" ;"
^XMB(3.9,146047,2,1373,0)="""RTN"",""IBCNEDST"",147,0)"
^XMB(3.9,146047,2,1374,0)=" ; IB*2.0*702/DTG - start Added"
^XMB(3.9,146047,2,1375,0)="""RTN"",""IBCNEDST"",148,0)"
^XMB(3.9,146047,2,1376,0)=" I $G(DSTATI)=1 S DSTAT3=+$G(IBA1)_DSTATPA_+$G(IBA2)_DSTATPA_+$G(IBMBS)_DSTATPA_+$G(IBMBI)"
^XMB(3.9,146047,2,1377,0)="""RTN"",""IBCNEDST"",149,0)"
^XMB(3.9,146047,2,1378,0)=" ; IB*2.0*702/DTG - end Added"
^XMB(3.9,146047,2,1379,0)="""RTN"",""IBCNEDST"",150,0)"
^XMB(3.9,146047,2,1380,0)=" ;"
^XMB(3.9,146047,2,1381,0)="""RTN"",""IBCNEDST"",151,0)"
^XMB(3.9,146047,2,1382,0)=" ; Number of 270 inquiries pending receipt of 271 responses"
^XMB(3.9,146047,2,1383,0)="""RTN"",""IBCNEDST"",152,0)"
^XMB(3.9,146047,2,1384,0)=" S (INQP,IEN)=0 F  S IEN=$O(^IBCN(365,""AC"",2,IEN)) Q:'IEN  D   ; Transmitted status = 2"
^XMB(3.9,146047,2,1385,0)="""RTN"",""IBCNEDST"",153,0)"
^XMB(3.9,146047,2,1386,0)=" . S INQP=INQP+1"
^XMB(3.9,146047,2,1387,0)="""RTN"",""IBCNEDST"",154,0)"
^XMB(3.9,146047,2,1388,0)=" Q SECINS_U_AUTOUPD_U_INQP"
^XMB(3.9,146047,2,1389,0)="""RTN"",""IBCNEDST"",155,0)"
^XMB(3.9,146047,2,1390,0)=" ;"
^XMB(3.9,146047,2,1391,0)="""RTN"",""IBCNEDST"",156,0)"
^XMB(3.9,146047,2,1392,0)=" ;PATINFO() was fully replace for IB*2*595/DM"
^XMB(3.9,146047,2,1393,0)="""RTN"",""IBCNEDST"",157,0)"
^XMB(3.9,146047,2,1394,0)=" ;PATINFO(DFN) ; get data from pat. insurance multiple (file 2.312)"
^XMB(3.9,146047,2,1395,0)="""RTN"",""IBCNEDST"",158,0)"
^XMB(3.9,146047,2,1396,0)=" ;; DFN - file 2 ien"
^XMB(3.9,146047,2,1397,0)="""RTN"",""IBCNEDST"",159,0)"
^XMB(3.9,146047,2,1398,0)=" ;;"
^XMB(3.9,146047,2,1399,0)="""RTN"",""IBCNEDST"",160,0)"
^XMB(3.9,146047,2,1400,0)=" ;; returns"
^XMB(3.9,146047,2,1401,0)="""RTN"",""IBCNEDST"",161,0)"
^XMB(3.9,146047,2,1402,0)=" ;;   number of automatically updated patient insurance records for a given patient within last 24 hours"
^XMB(3.9,146047,2,1403,0)="""RTN"",""IBCNEDST"",162,0)"
^XMB(3.9,146047,2,1404,0)=" ;;"
^XMB(3.9,146047,2,1405,0)="""RTN"",""IBCNEDST"",163,0)"
^XMB(3.9,146047,2,1406,0)=" ;N AUTOUPD,INSTYPE,POLICY"
^XMB(3.9,146047,2,1407,0)="""RTN"",""IBCNEDST"",164,0)"
^XMB(3.9,146047,2,1408,0)=" ;I 'DFN Q"
^XMB(3.9,146047,2,1409,0)="""RTN"",""IBCNEDST"",165,0)"
^XMB(3.9,146047,2,1410,0)=" ;S AUTOUPD=0"
^XMB(3.9,146047,2,1411,0)="""RTN"",""IBCNEDST"",166,0)"
^XMB(3.9,146047,2,1412,0)=" ;S INSTYPE=0 F  S INSTYPE=$O(^DPT(DFN,.312,""B"",INSTYPE)) Q:INSTYPE=""""  D"
^XMB(3.9,146047,2,1413,0)="""RTN"",""IBCNEDST"",167,0)"
^XMB(3.9,146047,2,1414,0)=" ;.S POLICY=0 F  S POLICY=$O(^DPT(DFN,.312,""B"",INSTYPE,POLICY)) Q:POLICY=""""  D"
^XMB(3.9,146047,2,1415,0)="""RTN"",""IBCNEDST"",168,0)"
^XMB(3.9,146047,2,1416,0)=" ;..; if DATE LAST VERIFIED is no more than one day old and EIV AUTO-UPDATE is set, increment auto-update counter"
^XMB(3.9,146047,2,1417,0)="""RTN"",""IBCNEDST"",169,0)"
^XMB(3.9,146047,2,1418,0)=" ;..I +$P($G(^DPT(DFN,.312,POLICY,4)),U,4),$$FMDIFF^XLFDT(DT,+$P($G(^DPT(DFN,.312,POLICY,1)),U,3),1)<2 S AUTOUPD=AUTOUPD+1"
^XMB(3.9,146047,2,1419,0)="""RTN"",""IBCNEDST"",170,0)"
^XMB(3.9,146047,2,1420,0)=" ;..Q"
^XMB(3.9,146047,2,1421,0)="""RTN"",""IBCNEDST"",171,0)"
^XMB(3.9,146047,2,1422,0)=" ;.Q"
^XMB(3.9,146047,2,1423,0)="""RTN"",""IBCNEDST"",172,0)"
^XMB(3.9,146047,2,1424,0)=" ;Q AUTOUPD"
^XMB(3.9,146047,2,1425,0)="""RTN"",""IBCNEDST"",173,0)"
^XMB(3.9,146047,2,1426,0)=" ;;"
^XMB(3.9,146047,2,1427,0)="""RTN"",""IBCNEDST"",174,0)"
^XMB(3.9,146047,2,1428,0)="PATINFO(IBAUTO,PAYERWNR,MCAUTO) ; IB*2*595/DM "
^XMB(3.9,146047,2,1429,0)="""RTN"",""IBCNEDST"",175,0)"
^XMB(3.9,146047,2,1430,0)=" ; compile an auto-update count for all patient policies from yesterday"
^XMB(3.9,146047,2,1431,0)="""RTN"",""IBCNEDST"",176,0)"
^XMB(3.9,146047,2,1432,0)=" ; read all response records from yesterday via the ""AUTO"" cross reference "
^XMB(3.9,146047,2,1433,0)="""RTN"",""IBCNEDST"",177,0)"
^XMB(3.9,146047,2,1434,0)=" ; "
^XMB(3.9,146047,2,1435,0)="""RTN"",""IBCNEDST"",178,0)"
^XMB(3.9,146047,2,1436,0)=" ; PAYERWNR - ien of the current Medicare payer from file #350.9"
^XMB(3.9,146047,2,1437,0)="""RTN"",""IBCNEDST"",179,0)"
^XMB(3.9,146047,2,1438,0)=" ; returns:"
^XMB(3.9,146047,2,1439,0)="""RTN"",""IBCNEDST"",180,0)"
^XMB(3.9,146047,2,1440,0)=" ; IBAUTO - total count of auto-updated eIV responses that are not Medicare related"
^XMB(3.9,146047,2,1441,0)="""RTN"",""IBCNEDST"",181,0)"
^XMB(3.9,146047,2,1442,0)=" ; MCAUTO - total count of auto-updated eIV responses that ARE Medicare related"
^XMB(3.9,146047,2,1443,0)="""RTN"",""IBCNEDST"",182,0)"
^XMB(3.9,146047,2,1444,0)=" ; "
^XMB(3.9,146047,2,1445,0)="""RTN"",""IBCNEDST"",183,0)"
^XMB(3.9,146047,2,1446,0)=" ; IB*664/DW added 1st three parameters, added logic to split out Medicare auto-updates"
^XMB(3.9,146047,2,1447,0)="""RTN"",""IBCNEDST"",184,0)"
^XMB(3.9,146047,2,1448,0)=" ;   "
^XMB(3.9,146047,2,1449,0)="""RTN"",""IBCNEDST"",185,0)"
^XMB(3.9,146047,2,1450,0)=" N IBAUTOX,IBDATE,IBENDDT,IBIEN,IBPYRIEN,IBPATIEN,IBINSIEN"
^XMB(3.9,146047,2,1451,0)="""RTN"",""IBCNEDST"",186,0)"
^XMB(3.9,146047,2,1452,0)=" S (IBAUTO,MCAUTO)=0"
^XMB(3.9,146047,2,1453,0)="""RTN"",""IBCNEDST"",187,0)"
^XMB(3.9,146047,2,1454,0)=" S IBDATE=$$FMADD^XLFDT($$DT^XLFDT(),-2,23,59,59)"
^XMB(3.9,146047,2,1455,0)="""RTN"",""IBCNEDST"",188,0)"
^XMB(3.9,146047,2,1456,0)=" S IBENDDT=$$FMADD^XLFDT($$DT^XLFDT(),-1,23,59,59)"
^XMB(3.9,146047,2,1457,0)="""RTN"",""IBCNEDST"",189,0)"
^XMB(3.9,146047,2,1458,0)=" ;"
^XMB(3.9,146047,2,1459,0)="""RTN"",""IBCNEDST"",190,0)"
^XMB(3.9,146047,2,1460,0)=" F  S IBDATE=$O(^IBCN(365,""AUTO"",IBDATE)) Q:'IBDATE!(IBDATE>IBENDDT)  D"
^XMB(3.9,146047,2,1461,0)="""RTN"",""IBCNEDST"",191,0)"
^XMB(3.9,146047,2,1462,0)=" .S IBPYRIEN=0 F  S IBPYRIEN=$O(^IBCN(365,""AUTO"",IBDATE,IBPYRIEN)) Q:'IBPYRIEN  D"
^XMB(3.9,146047,2,1463,0)="""RTN"",""IBCNEDST"",192,0)"
^XMB(3.9,146047,2,1464,0)=" ..S IBPATIEN=0 F  S IBPATIEN=$O(^IBCN(365,""AUTO"",IBDATE,IBPYRIEN,IBPATIEN)) Q:'IBPATIEN  D"
^XMB(3.9,146047,2,1465,0)="""RTN"",""IBCNEDST"",193,0)"
^XMB(3.9,146047,2,1466,0)=" ...S IBINSIEN=0 F  S IBINSIEN=$O(^IBCN(365,""AUTO"",IBDATE,IBPYRIEN,IBPATIEN,IBINSIEN)) Q:'IBINSIEN  D"
^XMB(3.9,146047,2,1467,0)="""RTN"",""IBCNEDST"",194,0)"
^XMB(3.9,146047,2,1468,0)=" ....; IB*2.0*664/DW Count Medicare auto-updates separately"
^XMB(3.9,146047,2,1469,0)="""RTN"",""IBCNEDST"",195,0)"
^XMB(3.9,146047,2,1470,0)=" ....; IB*664        Added last 2 FOR-LOOPS, original counting was wrong)"
^XMB(3.9,146047,2,1471,0)="""RTN"",""IBCNEDST"",196,0)"
^XMB(3.9,146047,2,1472,0)=" ....;S IBAUTO=IBAUTO+1"
^XMB(3.9,146047,2,1473,0)="""RTN"",""IBCNEDST"",197,0)"
^XMB(3.9,146047,2,1474,0)=" ....S IBAUTOX=0 F  S IBAUTOX=$O(^IBCN(365,""AUTO"",IBDATE,IBPYRIEN,IBPATIEN,IBINSIEN,IBAUTOX)) Q:'IBAUTOX  D"
^XMB(3.9,146047,2,1475,0)="""RTN"",""IBCNEDST"",198,0)"
^XMB(3.9,146047,2,1476,0)=" .... .Q:IBAUTOX'=1   ;Auto updated records will be a ""1"" "
^XMB(3.9,146047,2,1477,0)="""RTN"",""IBCNEDST"",199,0)"
^XMB(3.9,146047,2,1478,0)=" .... .S IBIEN=0 F  S IBIEN=$O(^IBCN(365,""AUTO"",IBDATE,IBPYRIEN,IBPATIEN,IBINSIEN,IBAUTOX,IBIEN)) Q:'IBIEN  D"
^XMB(3.9,146047,2,1479,0)="""RTN"",""IBCNEDST"",200,0)"
^XMB(3.9,146047,2,1480,0)=" .... ..I IBPYRIEN=PAYERWNR S MCAUTO=MCAUTO+1 Q"
^XMB(3.9,146047,2,1481,0)="""RTN"",""IBCNEDST"",201,0)"
^XMB(3.9,146047,2,1482,0)=" .... ..S IBAUTO=IBAUTO+1   ; non-Medicare responses"
^XMB(3.9,146047,2,1483,0)="""RTN"",""IBCNEDST"",202,0)"
^XMB(3.9,146047,2,1484,0)=" Q"
^XMB(3.9,146047,2,1485,0)="""RTN"",""IBCNEDST"",203,0)"
^XMB(3.9,146047,2,1486,0)=" ; "
^XMB(3.9,146047,2,1487,0)="""RTN"",""IBCNEDST"",204,0)"
^XMB(3.9,146047,2,1488,0)="TQINFO() ; get data from transmission queue (file 365.1)"
^XMB(3.9,146047,2,1489,0)="""RTN"",""IBCNEDST"",205,0)"
^XMB(3.9,146047,2,1490,0)=" ; returns the following string, delimited by ""^"":"
^XMB(3.9,146047,2,1491,0)="""RTN"",""IBCNEDST"",206,0)"
^XMB(3.9,146047,2,1492,0)=" ;   piece 1  - Number of queued 270 inquiries"
^XMB(3.9,146047,2,1493,0)="""RTN"",""IBCNEDST"",207,0)"
^XMB(3.9,146047,2,1494,0)=" ;   piece 2  - Number of deferred 270 inquiries"
^XMB(3.9,146047,2,1495,0)="""RTN"",""IBCNEDST"",208,0)"
^XMB(3.9,146047,2,1496,0)=" ;"
^XMB(3.9,146047,2,1497,0)="""RTN"",""IBCNEDST"",209,0)"
^XMB(3.9,146047,2,1498,0)=" N INQD,INQQ,INQUIRY,INSTS,TQSTATUS"
^XMB(3.9,146047,2,1499,0)="""RTN"",""IBCNEDST"",210,0)"
^XMB(3.9,146047,2,1500,0)=" S (INQD,INQQ)=0"
^XMB(3.9,146047,2,1501,0)="""RTN"",""IBCNEDST"",211,0)"
^XMB(3.9,146047,2,1502,0)=" ;"
^XMB(3.9,146047,2,1503,0)="""RTN"",""IBCNEDST"",212,0)"
^XMB(3.9,146047,2,1504,0)=" ; Queued inquiries (Ready to Transmit - 1/Retry - 6) and"
^XMB(3.9,146047,2,1505,0)="""RTN"",""IBCNEDST"",213,0)"
^XMB(3.9,146047,2,1506,0)=" ; Deferred inquiries (Hold - 4)"
^XMB(3.9,146047,2,1507,0)="""RTN"",""IBCNEDST"",214,0)"
^XMB(3.9,146047,2,1508,0)=" F INSTS=1,6,4 D"
^XMB(3.9,146047,2,1509,0)="""RTN"",""IBCNEDST"",215,0)"
^XMB(3.9,146047,2,1510,0)=" .S INQUIRY=0 F  S INQUIRY=$O(^IBCN(365.1,""AC"",INSTS,INQUIRY)) Q:'INQUIRY  D"
^XMB(3.9,146047,2,1511,0)="""RTN"",""IBCNEDST"",216,0)"
^XMB(3.9,146047,2,1512,0)=" ..I INSTS'=4 S INQQ=INQQ+1 Q   ; counter for queued inquiries"
^XMB(3.9,146047,2,1513,0)="""RTN"",""IBCNEDST"",217,0)"
^XMB(3.9,146047,2,1514,0)=" ..S INQD=INQD+1 ; counter for deferred inquiries"
^XMB(3.9,146047,2,1515,0)="""RTN"",""IBCNEDST"",218,0)"
^XMB(3.9,146047,2,1516,0)=" ..Q"
^XMB(3.9,146047,2,1517,0)="""RTN"",""IBCNEDST"",219,0)"
^XMB(3.9,146047,2,1518,0)=" .Q"
^XMB(3.9,146047,2,1519,0)="""RTN"",""IBCNEDST"",220,0)"
^XMB(3.9,146047,2,1520,0)=" Q INQQ_U_INQD"
^XMB(3.9,146047,2,1521,0)="""RTN"",""IBCNEDST"",221,0)"
^XMB(3.9,146047,2,1522,0)=" ;"
^XMB(3.9,146047,2,1523,0)="""RTN"",""IBCNEDST"",222,0)"
^XMB(3.9,146047,2,1524,0)="PAYINFO() ; get data from payer (file 365.12) & insurance company (file #36)"
^XMB(3.9,146047,2,1525,0)="""RTN"",""IBCNEDST"",223,0)"
^XMB(3.9,146047,2,1526,0)=" ; returns the following string, delimited by ""^"":"
^XMB(3.9,146047,2,1527,0)="""RTN"",""IBCNEDST"",224,0)"
^XMB(3.9,146047,2,1528,0)=" ;   piece 1  - Number of insurance companies with no National ID"
^XMB(3.9,146047,2,1529,0)="""RTN"",""IBCNEDST"",225,0)"
^XMB(3.9,146047,2,1530,0)=" ;   piece 2  - Number of locally disabled payers"
^XMB(3.9,146047,2,1531,0)="""RTN"",""IBCNEDST"",226,0)"
^XMB(3.9,146047,2,1532,0)=" ;   piece 3  - Number of unlinked insurance companies"
^XMB(3.9,146047,2,1533,0)="""RTN"",""IBCNEDST"",227,0)"
^XMB(3.9,146047,2,1534,0)=" ;"
^XMB(3.9,146047,2,1535,0)="""RTN"",""IBCNEDST"",228,0)"
^XMB(3.9,146047,2,1536,0)=" N ACTIVE,APP,DATA,IDLIST,INSCO,INSTID,LOCDIS,NONATID,PAYER,PROFID,UNLINK"
^XMB(3.9,146047,2,1537,0)="""RTN"",""IBCNEDST"",229,0)"
^XMB(3.9,146047,2,1538,0)=" S (LOCDIS,NONATID,UNLINK)=0"
^XMB(3.9,146047,2,1539,0)="""RTN"",""IBCNEDST"",230,0)"
^XMB(3.9,146047,2,1540,0)=" ;"
^XMB(3.9,146047,2,1541,0)="""RTN"",""IBCNEDST"",231,0)"
^XMB(3.9,146047,2,1542,0)=" ; Determine # of locally disabled payers"
^XMB(3.9,146047,2,1543,0)="""RTN"",""IBCNEDST"",232,0)"
^XMB(3.9,146047,2,1544,0)=" ; loop through PAYER file"
^XMB(3.9,146047,2,1545,0)="""RTN"",""IBCNEDST"",233,0)"
^XMB(3.9,146047,2,1546,0)=" S PAYER=0 F  S PAYER=$O(^IBE(365.12,PAYER)) Q:'PAYER  D"
^XMB(3.9,146047,2,1547,0)="""RTN"",""IBCNEDST"",234,0)"
^XMB(3.9,146047,2,1548,0)=" .;I '$$ACTAPP^IBCNEUT5(PAYER) Q  ; no active payer applications"
^XMB(3.9,146047,2,1549,0)="""RTN"",""IBCNEDST"",235,0)"
^XMB(3.9,146047,2,1550,0)=" .; Check for National ID"
^XMB(3.9,146047,2,1551,0)="""RTN"",""IBCNEDST"",236,0)"
^XMB(3.9,146047,2,1552,0)=" .S DATA=^IBE(365.12,PAYER,0)"
^XMB(3.9,146047,2,1553,0)="""RTN"",""IBCNEDST"",237,0)"
^XMB(3.9,146047,2,1554,0)=" .I $P(DATA,U,2)="""" Q  ;Must have National ID"
^XMB(3.9,146047,2,1555,0)="""RTN"",""IBCNEDST"",238,0)"
^XMB(3.9,146047,2,1556,0)=" .;"
^XMB(3.9,146047,2,1557,0)="""RTN"",""IBCNEDST"",239,0)"
^XMB(3.9,146047,2,1558,0)=" .; Check for Locally Disabled"
^XMB(3.9,146047,2,1559,0)="""RTN"",""IBCNEDST"",240,0)"
^XMB(3.9,146047,2,1560,0)=" .;IB*668/TAZ - Changed Payer Application from IIV to EIV"
^XMB(3.9,146047,2,1561,0)="""RTN"",""IBCNEDST"",241,0)"
^XMB(3.9,146047,2,1562,0)=" .S APP=$$PYRAPP^IBCNEUT5(""EIV"",PAYER) I 'APP Q"
^XMB(3.9,146047,2,1563,0)="""RTN"",""IBCNEDST"",242,0)"
^XMB(3.9,146047,2,1564,0)=" .S DATA=$G(^IBE(365.12,PAYER,1,APP,0))"
^XMB(3.9,146047,2,1565,0)="""RTN"",""IBCNEDST"",243,0)"
^XMB(3.9,146047,2,1566,0)=" .I $P(DATA,U,2),'$P(DATA,U,3) S LOCDIS=LOCDIS+1 ; nationally active but locally disabled payers"
^XMB(3.9,146047,2,1567,0)="""RTN"",""IBCNEDST"",244,0)"
^XMB(3.9,146047,2,1568,0)=" .Q"
^XMB(3.9,146047,2,1569,0)="""RTN"",""IBCNEDST"",245,0)"
^XMB(3.9,146047,2,1570,0)=" ;"
^XMB(3.9,146047,2,1571,0)="""RTN"",""IBCNEDST"",246,0)"
^XMB(3.9,146047,2,1572,0)=" ; Loop through INSURANCE COMPANY file for insurance companies not linked to a payer"
^XMB(3.9,146047,2,1573,0)="""RTN"",""IBCNEDST"",247,0)"
^XMB(3.9,146047,2,1574,0)=" ; and insurance companies with No National ID "
^XMB(3.9,146047,2,1575,0)="""RTN"",""IBCNEDST"",248,0)"
^XMB(3.9,146047,2,1576,0)=" ; No National ID [defined by VA CBO as no EDI IDs fields (#36,3.02) & (#36,3.04) - 3/4/14]"
^XMB(3.9,146047,2,1577,0)="""RTN"",""IBCNEDST"",249,0)"
^XMB(3.9,146047,2,1578,0)=" ; This is *Not* a check for the 'VA NATIONAL ID' associated with linked payer."
^XMB(3.9,146047,2,1579,0)="""RTN"",""IBCNEDST"",250,0)"
^XMB(3.9,146047,2,1580,0)=" ; "
^XMB(3.9,146047,2,1581,0)="""RTN"",""IBCNEDST"",251,0)"
^XMB(3.9,146047,2,1582,0)=" S INSCO=0 F  S INSCO=$O(^DIC(36,INSCO)) Q:'INSCO  D"
^XMB(3.9,146047,2,1583,0)="""RTN"",""IBCNEDST"",252,0)"
^XMB(3.9,146047,2,1584,0)=" .S ACTIVE=$$ACTIVE^IBCNEUT4(INSCO) Q:'ACTIVE  I $$EXCLUDE^IBCNEUT4($P(ACTIVE,U,2)) Q  ; Exclude Medicaid, etc."
^XMB(3.9,146047,2,1585,0)="""RTN"",""IBCNEDST"",253,0)"
^XMB(3.9,146047,2,1586,0)=" .S PAYER=$P($G(^DIC(36,INSCO,3)),U,10)  ; associated payer"
^XMB(3.9,146047,2,1587,0)="""RTN"",""IBCNEDST"",254,0)"
^XMB(3.9,146047,2,1588,0)=" .I 'PAYER S UNLINK=UNLINK+1             ; Not linked to a payer. Increment UNLINK"
^XMB(3.9,146047,2,1589,0)="""RTN"",""IBCNEDST"",255,0)"
^XMB(3.9,146047,2,1590,0)=" .I ($$GET1^DIQ(36,INSCO_"","",3.02)=""""),($$GET1^DIQ(36,INSCO_"","",3.04)="""") S NONATID=NONATID+1"
^XMB(3.9,146047,2,1591,0)="""RTN"",""IBCNEDST"",256,0)"
^XMB(3.9,146047,2,1592,0)=" .Q"
^XMB(3.9,146047,2,1593,0)="""RTN"",""IBCNEDST"",257,0)"
^XMB(3.9,146047,2,1594,0)=" Q NONATID_U_LOCDIS_U_UNLINK"
^XMB(3.9,146047,2,1595,0)="""RTN"",""IBCNEDST"",258,0)"
^XMB(3.9,146047,2,1596,0)=" ;"
^XMB(3.9,146047,2,1597,0)="""RTN"",""IBCNEDST"",259,0)"
^XMB(3.9,146047,2,1598,0)="BUFINFO() ; get data from insurance buffer (file 355.33)"
^XMB(3.9,146047,2,1599,0)="""RTN"",""IBCNEDST"",260,0)"
^XMB(3.9,146047,2,1600,0)=" ; DTTM - start date/time"
^XMB(3.9,146047,2,1601,0)="""RTN"",""IBCNEDST"",261,0)"
^XMB(3.9,146047,2,1602,0)=" ;"
^XMB(3.9,146047,2,1603,0)="""RTN"",""IBCNEDST"",262,0)"
^XMB(3.9,146047,2,1604,0)=" ; returns the following string, delimited by ""^"":"
^XMB(3.9,146047,2,1605,0)="""RTN"",""IBCNEDST"",263,0)"
^XMB(3.9,146047,2,1606,0)=" ;   piece 1 - Number of Verified (*) buffer entries within last 24 hours ; IB*737/DTG stop use of '*' verified"
^XMB(3.9,146047,2,1607,0)="""RTN"",""IBCNEDST"",264,0)"
^XMB(3.9,146047,2,1608,0)=" ;   piece 2 - Number of buffer entries indicated as having Active insurance (+) within last 24 hours"
^XMB(3.9,146047,2,1609,0)="""RTN"",""IBCNEDST"",265,0)"
^XMB(3.9,146047,2,1610,0)=" ;   piece 3 - Number of buffer entries indicated as having Inactive insurance (-) within last 24 hours"
^XMB(3.9,146047,2,1611,0)="""RTN"",""IBCNEDST"",266,0)"
^XMB(3.9,146047,2,1612,0)=" ;   piece 4 - Number of buffer entries indicated as policy status undetermined (#) within last 24 hours"
^XMB(3.9,146047,2,1613,0)="""RTN"",""IBCNEDST"",267,0)"
^XMB(3.9,146047,2,1614,0)=" ;   piece 5 - Number of buffer entries indicated as requiring correction before 270 can be sent (!) within last 24 hours"
^XMB(3.9,146047,2,1615,0)="""RTN"",""IBCNEDST"",268,0)"
^XMB(3.9,146047,2,1616,0)=" ;   piece 6 - Number of buffer entries awaiting processing within last 24 hours"
^XMB(3.9,146047,2,1617,0)="""RTN"",""IBCNEDST"",269,0)"
^XMB(3.9,146047,2,1618,0)=" ;   piece 7 - Number of buffer entries indicated as waiting for a 271 response (?) within last 24 hours"
^XMB(3.9,146047,2,1619,0)="""RTN"",""IBCNEDST"",270,0)"
^XMB(3.9,146047,2,1620,0)=" ;   piece 8 - Number of buffer entries entered by manual process with no further processing (blank) within last 24 hours "
^XMB(3.9,146047,2,1621,0)="""RTN"",""IBCNEDST"",271,0)"
^XMB(3.9,146047,2,1622,0)=" ;"
^XMB(3.9,146047,2,1623,0)="""RTN"",""IBCNEDST"",272,0)"
^XMB(3.9,146047,2,1624,0)=" N ACTIVE,AMBIG,BUFF,DATE,ERROR,INACTIVE,MANUAL,PROCWAIT,RESPWAIT,STATUS,SYM,VERIFIED"
^XMB(3.9,146047,2,1625,0)="""RTN"",""IBCNEDST"",273,0)"
^XMB(3.9,146047,2,1626,0)=" S (ACTIVE,AMBIG,ERROR,INACTIVE,MANUAL,PROCWAIT,RESPWAIT,VERIFIED)=0"
^XMB(3.9,146047,2,1627,0)="""RTN"",""IBCNEDST"",274,0)"
^XMB(3.9,146047,2,1628,0)=" S DATE=0 F  S DATE=$O(^IBA(355.33,""AEST"",""E"",DATE)) Q:DATE=""""  D"
^XMB(3.9,146047,2,1629,0)="""RTN"",""IBCNEDST"",275,0)"
^XMB(3.9,146047,2,1630,0)=" .S BUFF=0 F  S BUFF=$O(^IBA(355.33,""AEST"",""E"",DATE,BUFF)) Q:BUFF=""""  D"
^XMB(3.9,146047,2,1631,0)="""RTN"",""IBCNEDST"",276,0)"
^XMB(3.9,146047,2,1632,0)=" ..S SYM=$$SYMBOL^IBCNBLL(BUFF)"
^XMB(3.9,146047,2,1633,0)="""RTN"",""IBCNEDST"",277,0)"
^XMB(3.9,146047,2,1634,0)=" ..;I SYM=""*"" S VERIFIED=VERIFIED+1 Q  ; verified entries  ; IB*737/DTG stop use of '*' verified"
^XMB(3.9,146047,2,1635,0)="""RTN"",""IBCNEDST"",278,0)"
^XMB(3.9,146047,2,1636,0)=" ..I SYM=""+"" S ACTIVE=ACTIVE+1 Q      ; active insurance"
^XMB(3.9,146047,2,1637,0)="""RTN"",""IBCNEDST"",279,0)"
^XMB(3.9,146047,2,1638,0)=" ..I SYM=""$"" S ACTIVE=ACTIVE+1 Q      ; include ""$"" (Escalated entries) in with the active insurance  - IB*2.0*506 (vd)"
^XMB(3.9,146047,2,1639,0)="""RTN"",""IBCNEDST"",280,0)"
^XMB(3.9,146047,2,1640,0)=" ..I SYM=""-"" S INACTIVE=INACTIVE+1 Q  ; inactive insurance"
^XMB(3.9,146047,2,1641,0)="""RTN"",""IBCNEDST"",281,0)"
^XMB(3.9,146047,2,1642,0)=" ..I SYM=""#"" S AMBIG=AMBIG+1 Q        ; ambiguous response"
^XMB(3.9,146047,2,1643,0)="""RTN"",""IBCNEDST"",282,0)"
^XMB(3.9,146047,2,1644,0)=" ..I SYM=""!"" S ERROR=ERROR+1 Q        ; entries requiring correction"
^XMB(3.9,146047,2,1645,0)="""RTN"",""IBCNEDST"",283,0)"
^XMB(3.9,146047,2,1646,0)=" ..I SYM=""?"" S RESPWAIT=RESPWAIT+1 Q  ; awaiting response"
^XMB(3.9,146047,2,1647,0)="""RTN"",""IBCNEDST"",284,0)"
^XMB(3.9,146047,2,1648,0)=" ..I SYM="" "" S MANUAL=MANUAL+1        ; manually entered entries (no further processing)"
^XMB(3.9,146047,2,1649,0)="""RTN"",""IBCNEDST"",285,0)"
^XMB(3.9,146047,2,1650,0)=" .S PROCWAIT=RESPWAIT+MANUAL          ; entries awaiting processing"
^XMB(3.9,146047,2,1651,0)="""RTN"",""IBCNEDST"",286,0)"
^XMB(3.9,146047,2,1652,0)=" Q VERIFIED_U_ACTIVE_U_INACTIVE_U_AMBIG_U_ERROR_U_PROCWAIT_U_RESPWAIT_U_MANUAL"
^XMB(3.9,146047,2,1653,0)="""RTN"",""IBCNEDST"",287,0)"
^XMB(3.9,146047,2,1654,0)=" ;"
^XMB(3.9,146047,2,1655,0)="""RTN"",""IBCNEHLM"")"
^XMB(3.9,146047,2,1656,0)="0^3^B28864710"
^XMB(3.9,146047,2,1657,0)="""RTN"",""IBCNEHLM"",1,0)"
^XMB(3.9,146047,2,1658,0)="IBCNEHLM ;DAOU/ALA - HL7 Registration MFN Message ; 02-JUN-2015"
^XMB(3.9,146047,2,1659,0)="""RTN"",""IBCNEHLM"",2,0)"
^XMB(3.9,146047,2,1660,0)=" ;;2.0;INTEGRATED BILLING;**184,251,300,416,438,497,506,549,601,621,631,659,664,687,702,732,752**;21-MAR-94;Build 0"
^XMB(3.9,146047,2,1661,0)="""RTN"",""IBCNEHLM"",3,0)"
^XMB(3.9,146047,2,1662,0)=" ;;Per VA Directive 6402, this routine should not be modified."
^XMB(3.9,146047,2,1663,0)="""RTN"",""IBCNEHLM"",4,0)"
^XMB(3.9,146047,2,1664,0)=" ;"
^XMB(3.9,146047,2,1665,0)="""RTN"",""IBCNEHLM"",5,0)"
^XMB(3.9,146047,2,1666,0)=" ;**Program Description**"
^XMB(3.9,146047,2,1667,0)="""RTN"",""IBCNEHLM"",6,0)"
^XMB(3.9,146047,2,1668,0)=" ;  This program will process the outgoing registration MFN message"
^XMB(3.9,146047,2,1669,0)="""RTN"",""IBCNEHLM"",7,0)"
^XMB(3.9,146047,2,1670,0)=" ;"
^XMB(3.9,146047,2,1671,0)="""RTN"",""IBCNEHLM"",8,0)"
^XMB(3.9,146047,2,1672,0)=" ;  Variables"
^XMB(3.9,146047,2,1673,0)="""RTN"",""IBCNEHLM"",9,0)"
^XMB(3.9,146047,2,1674,0)=" ;    MCT = Lines of MailMan message counter"
^XMB(3.9,146047,2,1675,0)="""RTN"",""IBCNEHLM"",10,0)"
^XMB(3.9,146047,2,1676,0)=" ;    QFL = Quit flag"
^XMB(3.9,146047,2,1677,0)="""RTN"",""IBCNEHLM"",11,0)"
^XMB(3.9,146047,2,1678,0)=" ;    HL* = HL7 package specific variables"
^XMB(3.9,146047,2,1679,0)="""RTN"",""IBCNEHLM"",12,0)"
^XMB(3.9,146047,2,1680,0)=" ;    TAXID = Tax ID"
^XMB(3.9,146047,2,1681,0)="""RTN"",""IBCNEHLM"",13,0)"
^XMB(3.9,146047,2,1682,0)=" ;    CNTCPH = Contact Phone"
^XMB(3.9,146047,2,1683,0)="""RTN"",""IBCNEHLM"",14,0)"
^XMB(3.9,146047,2,1684,0)=" ;    CNTCEM = Contact Email"
^XMB(3.9,146047,2,1685,0)="""RTN"",""IBCNEHLM"",15,0)"
^XMB(3.9,146047,2,1686,0)=" ;    FRSH = Freshness Days"
^XMB(3.9,146047,2,1687,0)="""RTN"",""IBCNEHLM"",16,0)"
^XMB(3.9,146047,2,1688,0)=" ;    MGRP = Mailgroup to email messages to"
^XMB(3.9,146047,2,1689,0)="""RTN"",""IBCNEHLM"",17,0)"
^XMB(3.9,146047,2,1690,0)=" ;    INACT = Inactive Insurance Flag"
^XMB(3.9,146047,2,1691,0)="""RTN"",""IBCNEHLM"",18,0)"
^XMB(3.9,146047,2,1692,0)=" ;    APP = Application"
^XMB(3.9,146047,2,1693,0)="""RTN"",""IBCNEHLM"",19,0)"
^XMB(3.9,146047,2,1694,0)=" ;    EVENT = HL7 Event"
^XMB(3.9,146047,2,1695,0)="""RTN"",""IBCNEHLM"",20,0)"
^XMB(3.9,146047,2,1696,0)=" ;    CODE = Values sent in the MFN message"
^XMB(3.9,146047,2,1697,0)="""RTN"",""IBCNEHLM"",21,0)"
^XMB(3.9,146047,2,1698,0)=" ;    IPP = IP Port"
^XMB(3.9,146047,2,1699,0)="""RTN"",""IBCNEHLM"",22,0)"
^XMB(3.9,146047,2,1700,0)=" ;    IPA = IP Address"
^XMB(3.9,146047,2,1701,0)="""RTN"",""IBCNEHLM"",23,0)"
^XMB(3.9,146047,2,1702,0)=" ;    RESP = Response Code"
^XMB(3.9,146047,2,1703,0)="""RTN"",""IBCNEHLM"",24,0)"
^XMB(3.9,146047,2,1704,0)=" ;    IHLP = Interface HL7 Processing Type"
^XMB(3.9,146047,2,1705,0)="""RTN"",""IBCNEHLM"",25,0)"
^XMB(3.9,146047,2,1706,0)=" ;    IHLT = Interface HL7 Batch Start Time"
^XMB(3.9,146047,2,1707,0)="""RTN"",""IBCNEHLM"",26,0)"
^XMB(3.9,146047,2,1708,0)=" ;    IHLS = Interface HL7 Batch Stop Time"
^XMB(3.9,146047,2,1709,0)="""RTN"",""IBCNEHLM"",27,0)"
^XMB(3.9,146047,2,1710,0)=" ;    IVER = Interface Version"
^XMB(3.9,146047,2,1711,0)="""RTN"",""IBCNEHLM"",28,0)"
^XMB(3.9,146047,2,1712,0)=" ;    TIMOUT = Timeout Days Site Parameter"
^XMB(3.9,146047,2,1713,0)="""RTN"",""IBCNEHLM"",29,0)"
^XMB(3.9,146047,2,1714,0)=" ;    RETRY = Retry Flag Site Parameter"
^XMB(3.9,146047,2,1715,0)="""RTN"",""IBCNEHLM"",30,0)"
^XMB(3.9,146047,2,1716,0)=" ;"
^XMB(3.9,146047,2,1717,0)="""RTN"",""IBCNEHLM"",31,0)"
^XMB(3.9,146047,2,1718,0)=" N IBPERSIST"
^XMB(3.9,146047,2,1719,0)="""RTN"",""IBCNEHLM"",32,0)"
^XMB(3.9,146047,2,1720,0)=" S IBPERSIST=""N"" ; persistence flag - If ""N"", FSC will not use the statistics on the NTE segment"
^XMB(3.9,146047,2,1721,0)="""RTN"",""IBCNEHLM"",33,0)"
^XMB(3.9,146047,2,1722,0)=" D REG"
^XMB(3.9,146047,2,1723,0)="""RTN"",""IBCNEHLM"",34,0)"
^XMB(3.9,146047,2,1724,0)=" Q"
^XMB(3.9,146047,2,1725,0)="""RTN"",""IBCNEHLM"",35,0)"
^XMB(3.9,146047,2,1726,0)=" ;"
^XMB(3.9,146047,2,1727,0)="""RTN"",""IBCNEHLM"",36,0)"
^XMB(3.9,146047,2,1728,0)="EN1 ; TaskMan entry point"
^XMB(3.9,146047,2,1729,0)="""RTN"",""IBCNEHLM"",37,0)"
^XMB(3.9,146047,2,1730,0)=" N IBPERSIST"
^XMB(3.9,146047,2,1731,0)="""RTN"",""IBCNEHLM"",38,0)"
