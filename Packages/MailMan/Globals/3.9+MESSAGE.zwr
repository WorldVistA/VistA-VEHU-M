^XMB(3.9,146056,2,1907,0)="""RTN"",""VPRHSX1"",60,0)"
^XMB(3.9,146056,2,1908,0)=" . S ICN=""-1^Patient DIED on ""_$$FMTE^XLFDT(X)"
