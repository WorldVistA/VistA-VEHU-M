^XMB(3.9,146015,2,984,0)=" S ABW=ABW/2.2046226  ;ABW (actual body weight) in kg; changed 2.2 to 2.2046226 per CQ 10637 ; PSO 402"
^XMB(3.9,146015,2,985,0)="""RTN"",""PSOORUT2"",191,0)"
^XMB(3.9,146015,2,986,0)=" D VITAL^ORQQVI(""HEIGHT"",""HT"",DFN,.PSRH,0,"""",$$NOW^XLFDT)"
^XMB(3.9,146015,2,987,0)="""RTN"",""PSOORUT2"",192,0)"
^XMB(3.9,146015,2,988,0)=" Q:'$D(PSRH) RSLT"
^XMB(3.9,146015,2,989,0)="""RTN"",""PSOORUT2"",193,0)"
^XMB(3.9,146015,2,990,0)=" S ZHT=$P(PSRH(1),U,3) Q:+$G(ZHT)<1 RSLT"
^XMB(3.9,146015,2,991,0)="""RTN"",""PSOORUT2"",194,0)"
^XMB(3.9,146015,2,992,0)=" N VADM D DEM^VADPT S ZAGE=$G(VADM(4)) Q:'$L(ZAGE) RSLT"
^XMB(3.9,146015,2,993,0)="""RTN"",""PSOORUT2"",195,0)"
^XMB(3.9,146015,2,994,0)=" ;S ZAGE=$$AGE^ORQPTQ4(DFN) Q:'ZAGE RSLT"
^XMB(3.9,146015,2,995,0)="""RTN"",""PSOORUT2"",196,0)"
^XMB(3.9,146015,2,996,0)=" S SEX=$P($G(VADM(5)),""^"") Q:'$L(SEX) RSLT"
^XMB(3.9,146015,2,997,0)="""RTN"",""PSOORUT2"",197,0)"
^XMB(3.9,146015,2,998,0)=" ;S SEX=$P($$SEX^ORQPTQ4(DFN),U,1) Q:'$L(SEX) RSLT"
^XMB(3.9,146015,2,999,0)="""RTN"",""PSOORUT2"",198,0)"
^XMB(3.9,146015,2,1000,0)=" I '$G(ABW)!($G(ZHT)<1)!'$G(ZAGE)!'$D(SEX) Q RSLT"
^XMB(3.9,146015,2,1001,0)="""RTN"",""PSOORUT2"",199,0)"
^XMB(3.9,146015,2,1002,0)=" S SCRD=$P(SCR,U,7) Q:'$L(SCRD) RSLT"
^XMB(3.9,146015,2,1003,0)="""RTN"",""PSOORUT2"",200,0)"
^XMB(3.9,146015,2,1004,0)=" S HTGT60=$S(ZHT>60:(ZHT-60)*2.3,1:0)  ;if ht > 60 inches"
^XMB(3.9,146015,2,1005,0)="""RTN"",""PSOORUT2"",201,0)"
^XMB(3.9,146015,2,1006,0)=" I HTGT60>0 D"
^XMB(3.9,146015,2,1007,0)="""RTN"",""PSOORUT2"",202,0)"
^XMB(3.9,146015,2,1008,0)=" .S IBW=$S(SEX=""M"":50+HTGT60,1:45.5+HTGT60)  ;Ideal Body Weight"
^XMB(3.9,146015,2,1009,0)="""RTN"",""PSOORUT2"",203,0)"
^XMB(3.9,146015,2,1010,0)=" .S BWRATIO=(ABW/IBW)  ;body weight ratio"
^XMB(3.9,146015,2,1011,0)="""RTN"",""PSOORUT2"",204,0)"
^XMB(3.9,146015,2,1012,0)=" .S BWDIFF=$S(ABW>IBW:ABW-IBW,1:0)"
^XMB(3.9,146015,2,1013,0)="""RTN"",""PSOORUT2"",205,0)"
^XMB(3.9,146015,2,1014,0)=" .S LOWBW=$S(IBW<ABW:IBW,1:ABW)"
^XMB(3.9,146015,2,1015,0)="""RTN"",""PSOORUT2"",206,0)"
^XMB(3.9,146015,2,1016,0)=" .I BWRATIO>1.3,(BWDIFF>0) S ADJBW=((0.3*BWDIFF)+IBW)"
^XMB(3.9,146015,2,1017,0)="""RTN"",""PSOORUT2"",207,0)"
^XMB(3.9,146015,2,1018,0)=" .E  S ADJBW=LOWBW"
^XMB(3.9,146015,2,1019,0)="""RTN"",""PSOORUT2"",208,0)"
^XMB(3.9,146015,2,1020,0)=" I +$G(ADJBW)<1 D"
^XMB(3.9,146015,2,1021,0)="""RTN"",""PSOORUT2"",209,0)"
^XMB(3.9,146015,2,1022,0)=" .S ADJBW=ABW"
^XMB(3.9,146015,2,1023,0)="""RTN"",""PSOORUT2"",210,0)"
^XMB(3.9,146015,2,1024,0)=" S CRCL=(((140-ZAGE)*ADJBW)/(SCRV*72))"
^XMB(3.9,146015,2,1025,0)="""RTN"",""PSOORUT2"",211,0)"
^XMB(3.9,146015,2,1026,0)=" S:SEX=""M"" RSLT=SCRD_U_$J(CRCL,1,1)"
^XMB(3.9,146015,2,1027,0)="""RTN"",""PSOORUT2"",212,0)"
^XMB(3.9,146015,2,1028,0)=" S:SEX=""F"" RSLT=SCRD_U_$J((CRCL*.85),1,1)"
^XMB(3.9,146015,2,1029,0)="""RTN"",""PSOORUT2"",213,0)"
^XMB(3.9,146015,2,1030,0)=" S X1=$P(RSLT,""^""),X2=$$FMTE^XLFDT(X1,""2M""),$P(RSLT,""^"")=$P(X2,""@"") K X1,X2"
^XMB(3.9,146015,2,1031,0)="""RTN"",""PSOORUT2"",214,0)"
^XMB(3.9,146015,2,1032,0)=" S $P(RSLT,""^"",3)=$P($G(SCR),""^"",3)"
^XMB(3.9,146015,2,1033,0)="""RTN"",""PSOORUT2"",215,0)"
^XMB(3.9,146015,2,1034,0)=" K HTGT60,ABW,IBW,BWRATIO,BWDIFF,LOWBW,ADJBW,X1,X2,PSCR,PSRW,ABW,ZHT,PSRH,ZAGE,PSCXTL,PSCXTLS,SCR,OCXT,OCXTS,SCRV,CRCL,ZSERUM"
^XMB(3.9,146015,2,1035,0)="""RTN"",""PSOORUT2"",216,0)"
^XMB(3.9,146015,2,1036,0)=" Q RSLT"
^XMB(3.9,146015,2,1037,0)="""RTN"",""PSOORUT2"",217,0)"
^XMB(3.9,146015,2,1038,0)=" ;"
^XMB(3.9,146015,2,1039,0)="""RTN"",""PSOORUT2"",218,0)"
^XMB(3.9,146015,2,1040,0)="MAILECNT(PSODFN) ;entry for mail exemption count p753"
^XMB(3.9,146015,2,1041,0)="""RTN"",""PSOORUT2"",219,0)"
^XMB(3.9,146015,2,1042,0)=" ;called from PSOORUT2 above to count the number of mail exemptions for display on patient information"
^XMB(3.9,146015,2,1043,0)="""RTN"",""PSOORUT2"",220,0)"
^XMB(3.9,146015,2,1044,0)=" ;PSODFN - Patient IEN"
^XMB(3.9,146015,2,1045,0)="""RTN"",""PSOORUT2"",221,0)"
^XMB(3.9,146015,2,1046,0)=" N RXIEN,STA,DRUG,X1,X2,PSOSD,PSODTCUT,X,Y,CNT"
^XMB(3.9,146015,2,1047,0)="""RTN"",""PSOORUT2"",222,0)"
^XMB(3.9,146015,2,1048,0)=" S CNT=0"
^XMB(3.9,146015,2,1049,0)="""RTN"",""PSOORUT2"",223,0)"
^XMB(3.9,146015,2,1050,0)=" S X2=-120,X1=DT D C^%DTC S PSODTCUT=X ;date cutoff for prescriptions"
^XMB(3.9,146015,2,1051,0)="""RTN"",""PSOORUT2"",224,0)"
^XMB(3.9,146015,2,1052,0)=" D ^PSOBUILD ;build psosd array"
^XMB(3.9,146015,2,1053,0)="""RTN"",""PSOORUT2"",225,0)"
^XMB(3.9,146015,2,1054,0)=" S STA="""" F  S STA=$O(PSOSD(STA)) Q:STA=""""  I ""^ACTIVE^NON-VERIFIED^REFILL^HOLD^DRUG INTERACTIONS^SUSPENDED^""[STA  D"
^XMB(3.9,146015,2,1055,0)="""RTN"",""PSOORUT2"",226,0)"
^XMB(3.9,146015,2,1056,0)=" .S DRUG="""" F  S DRUG=$O(PSOSD(STA,DRUG)) Q:DRUG=""""  D"
^XMB(3.9,146015,2,1057,0)="""RTN"",""PSOORUT2"",227,0)"
^XMB(3.9,146015,2,1058,0)=" ..S RXIEN=+PSOSD(STA,DRUG)"
^XMB(3.9,146015,2,1059,0)="""RTN"",""PSOORUT2"",228,0)"
^XMB(3.9,146015,2,1060,0)=" ..I $$GET1^DIQ(52,RXIEN,100.2,""I"")']"""" Q"
^XMB(3.9,146015,2,1061,0)="""RTN"",""PSOORUT2"",229,0)"
^XMB(3.9,146015,2,1062,0)=" ..S CNT=CNT+1"
^XMB(3.9,146015,2,1063,0)="""RTN"",""PSOORUT2"",230,0)"
^XMB(3.9,146015,2,1064,0)=" Q CNT"
^XMB(3.9,146015,2,1065,0)="""RTN"",""PSORXEDT"")"
^XMB(3.9,146015,2,1066,0)="0^3^B57768627"
^XMB(3.9,146015,2,1067,0)="""RTN"",""PSORXEDT"",1,0)"
^XMB(3.9,146015,2,1068,0)="PSORXEDT ;BIR/SAB - Edit RX Routine ;Jan 05, 2021@12:04"
^XMB(3.9,146015,2,1069,0)="""RTN"",""PSORXEDT"",2,0)"
^XMB(3.9,146015,2,1070,0)=" ;;7.0;OUTPATIENT PHARMACY;**21,23,44,71,146,185,148,253,390,372,416,313,427,422,402,500,482,556,622,753**;DEC 1997;Build 0"
^XMB(3.9,146015,2,1071,0)="""RTN"",""PSORXEDT"",3,0)"
^XMB(3.9,146015,2,1072,0)=" ;External Reference to ^PS(55 supported by DBIA 2228"
^XMB(3.9,146015,2,1073,0)="""RTN"",""PSORXEDT"",4,0)"
^XMB(3.9,146015,2,1074,0)=" ;External reference to $$BSA^PSSDSAPI supported by DBIA 5425"
^XMB(3.9,146015,2,1075,0)="""RTN"",""PSORXEDT"",5,0)"
^XMB(3.9,146015,2,1076,0)=" D:'$D(PSOPAR) ^PSOLSET I '$D(PSOPAR) G EOJ Q"
^XMB(3.9,146015,2,1077,0)="""RTN"",""PSORXEDT"",6,0)"
^XMB(3.9,146015,2,1078,0)=" K PSODRUG,PSOLIST,DIR,DIRUT,DUOUT,X,Y,PSOFROM,^TMP(""PSOBEDT"",$J),NOPP,CLOZPST,PSOTITRX,PSOMTFLG"
^XMB(3.9,146015,2,1079,0)="""RTN"",""PSORXEDT"",7,0)"
^XMB(3.9,146015,2,1080,0)=" N PSOODOSP"
^XMB(3.9,146015,2,1081,0)="""RTN"",""PSORXEDT"",8,0)"
^XMB(3.9,146015,2,1082,0)=" W !! S DIR(0)=""FAO^1:245"",DIR(""A"")=""Edit Rx(s) => "",DIR(""?"",1)=""Enter Rx Number or A List of numbers Separated"",DIR(""?"")=""by Commas, e.g. 1234A,345,937002Q."""
^XMB(3.9,146015,2,1083,0)="""RTN"",""PSORXEDT"",9,0)"
^XMB(3.9,146015,2,1084,0)=" D ^DIR K DIR G:$D(DIRUT) EOJ"
^XMB(3.9,146015,2,1085,0)="""RTN"",""PSORXEDT"",10,0)"
^XMB(3.9,146015,2,1086,0)=" S END=$L(X,"",""),BAD=0"
^XMB(3.9,146015,2,1087,0)="""RTN"",""PSORXEDT"",11,0)"
^XMB(3.9,146015,2,1088,0)=" F I=1:1:END S RXM=$P(X,"","",I) I +RXM F J=I+1:1:END S DUP=$P(X,"","",J) I DUP=RXM S $P(X,"","",J)="""" W !?5,$C(7),""Duplicate Rx # ""_RXM_""  was found in your list, ignoring it!"",! S BAD=1"
^XMB(3.9,146015,2,1089,0)="""RTN"",""PSORXEDT"",12,0)"
^XMB(3.9,146015,2,1090,0)=" S PSORLST=$P(X,"","") F I=2:1:END S RXM=$P(X,"","",I) S:RXM'?1.N.A BAD=1 I RXM?1.N.A S PSORLST=PSORLST_"",""_RXM"
^XMB(3.9,146015,2,1091,0)="""RTN"",""PSORXEDT"",13,0)"
^XMB(3.9,146015,2,1092,0)=" F I=1:1:$L(PSORLST) S RXM=$P(PSORLST,"","",I) I +RXM F J=I+1:1:END S DUP=$P(PSORLST,"","",J) I DUP=RXM S $P(PSORLST,"","",J)="""""
^XMB(3.9,146015,2,1093,0)="""RTN"",""PSORXEDT"",14,0)"
^XMB(3.9,146015,2,1094,0)=" ;"
^XMB(3.9,146015,2,1095,0)="""RTN"",""PSORXEDT"",15,0)"
^XMB(3.9,146015,2,1096,0)="BAD I PSORLST D  I 'Y K Y G PSORXEDT"
^XMB(3.9,146015,2,1097,0)="""RTN"",""PSORXEDT"",16,0)"
^XMB(3.9,146015,2,1098,0)=" .W !?15,""=> ""_PSORLST"
^XMB(3.9,146015,2,1099,0)="""RTN"",""PSORXEDT"",17,0)"
^XMB(3.9,146015,2,1100,0)=" .K DIR,DIRUT S DIR(0)=""Y"",DIR(""A"")=""Is this OKAY "",DIR(""B"")=""Yes"""
^XMB(3.9,146015,2,1101,0)="""RTN"",""PSORXEDT"",18,0)"
^XMB(3.9,146015,2,1102,0)=" .D ^DIR K DIR"
^XMB(3.9,146015,2,1103,0)="""RTN"",""PSORXEDT"",19,0)"
^XMB(3.9,146015,2,1104,0)=" .I 'Y!$D(DIRUT) K X,PSORLST,BAD"
^XMB(3.9,146015,2,1105,0)="""RTN"",""PSORXEDT"",20,0)"
^XMB(3.9,146015,2,1106,0)=" K BAD I 'PSORLST K PSORLST G PSORXEDT"
^XMB(3.9,146015,2,1107,0)="""RTN"",""PSORXEDT"",21,0)"
^XMB(3.9,146015,2,1108,0)=" F I=1:1:$L(PSORLST,"","") S RXM=$P(PSORLST,"","",I) S GOOD=$D(^PSRX(""B"",RXM)) D"
^XMB(3.9,146015,2,1109,0)="""RTN"",""PSORXEDT"",22,0)"
^XMB(3.9,146015,2,1110,0)=" .I 'GOOD W !!?5,""Couldn't Find RX # ""_RXM H 3 Q"
^XMB(3.9,146015,2,1111,0)="""RTN"",""PSORXEDT"",23,0)"
^XMB(3.9,146015,2,1112,0)=" .S RXN=$O(^PSRX(""B"",RXM,0)) D  I $P(^PSRX(RXN,""STA""),""^"")=13 W !!?5,""Rx # ""_RXM_"" is marked for Deletion."" H 3 Q"
^XMB(3.9,146015,2,1113,0)="""RTN"",""PSORXEDT"",24,0)"
^XMB(3.9,146015,2,1114,0)=" ..I $G(RXN),$P($G(^PS(55,+$P($G(^PSRX(RXN,0)),""^"",2),0)),""^"",6)'=2 S PSOLOUD=1 D EN^PSOHLUP(+$P($G(^PSRX(RXN,0)),""^"",2)) K PSOLOUD"
^XMB(3.9,146015,2,1115,0)="""RTN"",""PSORXEDT"",25,0)"
^XMB(3.9,146015,2,1116,0)=" .D LIST K GOOD"
^XMB(3.9,146015,2,1117,0)="""RTN"",""PSORXEDT"",26,0)"
^XMB(3.9,146015,2,1118,0)=" K GOOD,END"
^XMB(3.9,146015,2,1119,0)="""RTN"",""PSORXEDT"",27,0)"
^XMB(3.9,146015,2,1120,0)=" ;"
^XMB(3.9,146015,2,1121,0)="""RTN"",""PSORXEDT"",28,0)"
^XMB(3.9,146015,2,1122,0)="EPH ; - Entry for Epharmacy Rx Edit (PSOREJP1)"
^XMB(3.9,146015,2,1123,0)="""RTN"",""PSORXEDT"",29,0)"
^XMB(3.9,146015,2,1124,0)=" F PSOT1=1:1 Q:'$D(PSOLIST(PSOT1))  F PSOLST2=1:1:$L(PSOLIST(PSOT1),"","") S ORN=$P(PSOLIST(PSOT1),"","",PSOLST2) D:+ORN PT"
^XMB(3.9,146015,2,1125,0)="""RTN"",""PSORXEDT"",30,0)"
^XMB(3.9,146015,2,1126,0)=" ;"
^XMB(3.9,146015,2,1127,0)="""RTN"",""PSORXEDT"",31,0)"
^XMB(3.9,146015,2,1128,0)=" ; If variable PSOREJCT is set, the EPH entry point was called by"
^XMB(3.9,146015,2,1129,0)="""RTN"",""PSORXEDT"",32,0)"
^XMB(3.9,146015,2,1130,0)=" ; EDT^PSOREJP1, which is invoked by the ED Edit Rx Action on the"
^XMB(3.9,146015,2,1131,0)="""RTN"",""PSORXEDT"",33,0)"
^XMB(3.9,146015,2,1132,0)=" ; ePharmacy Reject Info Screen.  If set, PSOREJCT will be Rx IEN ^ Fill."
^XMB(3.9,146015,2,1133,0)="""RTN"",""PSORXEDT"",34,0)"
^XMB(3.9,146015,2,1134,0)=" ; If the Rx is not released, and the Status is not Suspended, and the"
^XMB(3.9,146015,2,1135,0)="""RTN"",""PSORXEDT"",35,0)"
^XMB(3.9,146015,2,1136,0)=" ; PSORX(""NOLABEL"") flag is not set, then add this Rx to the PSORX(""PSOL"")"
^XMB(3.9,146015,2,1137,0)="""RTN"",""PSORXEDT"",36,0)"
^XMB(3.9,146015,2,1138,0)=" ; array.  The ED Edit Rx Action sends only one RX, so add as entry 1."
^XMB(3.9,146015,2,1139,0)="""RTN"",""PSORXEDT"",37,0)"
^XMB(3.9,146015,2,1140,0)=" I $G(PSOREJCT),'$$RXRLDT^PSOBPSUT(+PSOREJCT,$P(PSOREJCT,U,2)),$$GET1^DIQ(52,+PSOREJCT_"","",100,""I"")'=5,'$G(PSORX(""NOLABEL"")) S PSORX(""PSOL"",1)=+PSOREJCT"
^XMB(3.9,146015,2,1141,0)="""RTN"",""PSORXEDT"",38,0)"
^XMB(3.9,146015,2,1142,0)=" ;"
^XMB(3.9,146015,2,1143,0)="""RTN"",""PSORXEDT"",39,0)"
^XMB(3.9,146015,2,1144,0)=" ;call to add bingo board data to file 52.11"
^XMB(3.9,146015,2,1145,0)="""RTN"",""PSORXEDT"",40,0)"
^XMB(3.9,146015,2,1146,0)=" K POP,PSOLIST,TM,TM1 G:'$O(PSORX(""PSOL"",0)) NX"
^XMB(3.9,146015,2,1147,0)="""RTN"",""PSORXEDT"",41,0)"
^XMB(3.9,146015,2,1148,0)=" D:$G(PSORX(""PSOL"",1))]"""" ^PSORXL K PSORX G:$G(NOBG) NX"
^XMB(3.9,146015,2,1149,0)="""RTN"",""PSORXEDT"",42,0)"
^XMB(3.9,146015,2,1150,0)=" ;"
^XMB(3.9,146015,2,1151,0)="""RTN"",""PSORXEDT"",43,0)"
^XMB(3.9,146015,2,1152,0)="PRF G:'$P(PSOPAR,""^"",8)!($G(NOPP)=""H"")!($G(NOPP)=""S"")!('$D(^TMP(""PSOBEDT"",$J))) BBG"
^XMB(3.9,146015,2,1153,0)="""RTN"",""PSORXEDT"",44,0)"
^XMB(3.9,146015,2,1154,0)=" I $O(^TMP(""PSOBEDT"",$J,0)),$P(PSOPAR,""^"",8) S PSOFROM=""NEW"",PSOION=ION K RXRS"
^XMB(3.9,146015,2,1155,0)="""RTN"",""PSORXEDT"",45,0)"
^XMB(3.9,146015,2,1156,0)=" G:$D(PSOPROP)&($G(PSOPROP)'=ION) QUP"
^XMB(3.9,146015,2,1157,0)="""RTN"",""PSORXEDT"",46,0)"
^XMB(3.9,146015,2,1158,0)=" I '$D(PSOPROP)!($G(PSOPROP)=ION) D  G:$G(POP)!($E(IOST)[""C"")!(PSOION=ION) BBG"
^XMB(3.9,146015,2,1159,0)="""RTN"",""PSORXEDT"",47,0)"
^XMB(3.9,146015,2,1160,0)=" .S PSOION=ION W !,""Profiles must be sent to Printer !!"",! K IOP,%ZIS,IO(""Q""),POP"
^XMB(3.9,146015,2,1161,0)="""RTN"",""PSORXEDT"",48,0)"
^XMB(3.9,146015,2,1162,0)=" .S %ZIS=""MNQ"",%ZIS(""A"")=""Select Profile Device: "" D ^%ZIS K %ZIS(""A"")"
^XMB(3.9,146015,2,1163,0)="""RTN"",""PSORXEDT"",49,0)"
^XMB(3.9,146015,2,1164,0)=" .Q:$G(POP)!($E(IOST)[""C"")!(PSOION=ION)  S PSOPROP=ION"
^XMB(3.9,146015,2,1165,0)="""RTN"",""PSORXEDT"",50,0)"
