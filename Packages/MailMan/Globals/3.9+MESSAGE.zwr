^XMB(3.9,146009,2,711,0)="""RTN"",""XUMVINPB"",17,0)"
^XMB(3.9,146009,2,712,0)="BULKGET(XURET,XUDUZ,XUTYPE) ;rpc to retrieve bulk pull of new person file data"
