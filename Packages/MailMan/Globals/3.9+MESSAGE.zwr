^XMB(3.9,146103,2,162,0)="Warning:  Installing this backup patch message will install older versions"
^XMB(3.9,146103,2,163,0)="""PKG"",542,22,1,""PAH"",1,1,4,0)"
^XMB(3.9,146103,2,164,0)="of routines and Build Components (options, protocols, templates, etc.)."
^XMB(3.9,146103,2,165,0)="""PKG"",542,22,1,""PAH"",1,1,5,0)"
^XMB(3.9,146103,2,166,0)="Please verify with the Development Team that it is safe to install."
^XMB(3.9,146103,2,167,0)="""QUES"",""XPF1"",0)"
^XMB(3.9,146103,2,168,0)="Y"
^XMB(3.9,146103,2,169,0)="""QUES"",""XPF1"",""??"")"
^XMB(3.9,146103,2,170,0)="^D REP^XPDH"
^XMB(3.9,146103,2,171,0)="""QUES"",""XPF1"",""A"")"
^XMB(3.9,146103,2,172,0)="Shall I write over your |FLAG| File"
