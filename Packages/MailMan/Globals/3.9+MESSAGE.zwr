^XMB(3.9,146012,2,1486,0)=" S MSGDT=$P(ERXNODE0,""^"",3)"
^XMB(3.9,146012,2,1487,0)="""RTN"",""PSOERRX1"",152,0)"
^XMB(3.9,146012,2,1488,0)=" S EPATIEN=$P(ERXNODE0,""^"",4) I 'EPATIEN S EPATIEN=$$GETPAT^PSOERXU5(ERXIEN)"
^XMB(3.9,146012,2,1489,0)="""RTN"",""PSOERRX1"",153,0)"
^XMB(3.9,146012,2,1490,0)=" ; eRx Patient Filter"
^XMB(3.9,146012,2,1491,0)="""RTN"",""PSOERRX1"",154,0)"
^XMB(3.9,146012,2,1492,0)=" I $D(PATFLTR),'$D(PATFLTR(+EPATIEN)) Q"
^XMB(3.9,146012,2,1493,0)="""RTN"",""PSOERRX1"",155,0)"
^XMB(3.9,146012,2,1494,0)=" S EPROVIEN=+ERXNODE2 I 'EPROVIEN S EPROVIEN=$$GETPROV^PSOERXU5(ERXIEN)"
^XMB(3.9,146012,2,1495,0)="""RTN"",""PSOERRX1"",156,0)"
^XMB(3.9,146012,2,1496,0)=" ; eRx Provider Filter"
^XMB(3.9,146012,2,1497,0)="""RTN"",""PSOERRX1"",157,0)"
^XMB(3.9,146012,2,1498,0)=" I $D(PRVFLTR),'$D(PRVFLTR(EPROVIEN)) Q"
^XMB(3.9,146012,2,1499,0)="""RTN"",""PSOERRX1"",158,0)"
^XMB(3.9,146012,2,1500,0)=" S VPATIEN=$P(ERXNODE0,""^"",5),MTYPE=$P(ERXNODE0,""^"",8)"
^XMB(3.9,146012,2,1501,0)="""RTN"",""PSOERRX1"",159,0)"
^XMB(3.9,146012,2,1502,0)=" S STATIEN=+$G(^PS(52.49,ERXIEN,1)),ERXSTAT=$P(^PS(52.45,STATIEN,0),""^"")"
^XMB(3.9,146012,2,1503,0)="""RTN"",""PSOERRX1"",160,0)"
^XMB(3.9,146012,2,1504,0)=" ;p805 only actionable statuses should display for non-MBM site when Remove All Filters is selected."
^XMB(3.9,146012,2,1505,0)="""RTN"",""PSOERRX1"",161,0)"
^XMB(3.9,146012,2,1506,0)=" I '$G(MBMSITE),$G(Y)[""RAF^PSOERRX0"" S PSOALLST=0,STSFLTR=0"
^XMB(3.9,146012,2,1507,0)="""RTN"",""PSOERRX1"",162,0)"
^XMB(3.9,146012,2,1508,0)=" ; Actionable/Non-Actionable Status"
^XMB(3.9,146012,2,1509,0)="""RTN"",""PSOERRX1"",163,0)"
^XMB(3.9,146012,2,1510,0)=" I '$G(PSOALLST),'$G(STSFLTR),$F("",RJ,RM,REM,PR,E,RXA,CXA,CAA,CAN,CXP,RXP,RXA,ICA,CNP,CRP,CRC,RRC,CXC,CNE,CRN,CRR,CRX,CXQ,RXA,RXC,RRN,RRX,RRR,RRP,IRA,"","",""_$E(ERXSTAT,1,3)_"","") Q"
^XMB(3.9,146012,2,1511,0)="""RTN"",""PSOERRX1"",164,0)"
^XMB(3.9,146012,2,1512,0)=" S RESTYPE=$P($G(^PS(52.49,ERXIEN,52)),""^"",1)"
^XMB(3.9,146012,2,1513,0)="""RTN"",""PSOERRX1"",165,0)"
^XMB(3.9,146012,2,1514,0)=" S CSERX=+$G(^PS(52.49,ERXIEN,95))"
^XMB(3.9,146012,2,1515,0)="""RTN"",""PSOERRX1"",166,0)"
^XMB(3.9,146012,2,1516,0)=" S VPRVIEN=$P($G(^PS(52.49,ERXIEN,2)),""^"",3)"
^XMB(3.9,146012,2,1517,0)="""RTN"",""PSOERRX1"",167,0)"
^XMB(3.9,146012,2,1518,0)=" S VDRGIEN=$P($G(^PS(52.49,ERXIEN,3)),""^"",2)"
^XMB(3.9,146012,2,1519,0)="""RTN"",""PSOERRX1"",168,0)"
^XMB(3.9,146012,2,1520,0)=" S CHGMESRQ=$$GET1^DIQ(52.49,ERXIEN,315.1,""I"")"
^XMB(3.9,146012,2,1521,0)="""RTN"",""PSOERRX1"",169,0)"
^XMB(3.9,146012,2,1522,0)=" S CHGMESRI=$$GET1^DIQ(52.45,CHGMESRQ,.01,""I"")"
^XMB(3.9,146012,2,1523,0)="""RTN"",""PSOERRX1"",170,0)"
^XMB(3.9,146012,2,1524,0)=" S SKIP=0"
^XMB(3.9,146012,2,1525,0)="""RTN"",""PSOERRX1"",171,0)"
^XMB(3.9,146012,2,1526,0)=" ; Setting Drug Name (if Blank)"
^XMB(3.9,146012,2,1527,0)="""RTN"",""PSOERRX1"",172,0)"
^XMB(3.9,146012,2,1528,0)=" S EDRUG=$P(ERXNODE3,""^"",1)"
^XMB(3.9,146012,2,1529,0)="""RTN"",""PSOERRX1"",173,0)"
^XMB(3.9,146012,2,1530,0)=" I EDRUG="""" S EDRUG=$$GETDRUG^PSOERXU5(ERXIEN) I EDRUG="""" S EDRUG=$S(MTYPE=""IE"":""<<INBOUND ERROR>>"",1:""N/A"")"
^XMB(3.9,146012,2,1531,0)="""RTN"",""PSOERRX1"",174,0)"
^XMB(3.9,146012,2,1532,0)=" ; Applying Filters"
^XMB(3.9,146012,2,1533,0)="""RTN"",""PSOERRX1"",175,0)"
^XMB(3.9,146012,2,1534,0)=" ; Message Type Filter"
^XMB(3.9,146012,2,1535,0)="""RTN"",""PSOERRX1"",176,0)"
^XMB(3.9,146012,2,1536,0)=" I $G(MSTPFLTR)'="""",MTYPE'=MSTPFLTR Q"
^XMB(3.9,146012,2,1537,0)="""RTN"",""PSOERRX1"",177,0)"
^XMB(3.9,146012,2,1538,0)=" I $D(RESARY),$G(MSTPFLTR)'="""",("" RE CX ""[("" ""_MSTPFLTR_"" "")) D  Q:SKIP"
^XMB(3.9,146012,2,1539,0)="""RTN"",""PSOERRX1"",178,0)"
^XMB(3.9,146012,2,1540,0)=" . I RESTYPE="""" S SKIP=1 Q"
^XMB(3.9,146012,2,1541,0)="""RTN"",""PSOERRX1"",179,0)"
^XMB(3.9,146012,2,1542,0)=" . I '$D(RESARY(RESTYPE)) S SKIP=1"
^XMB(3.9,146012,2,1543,0)="""RTN"",""PSOERRX1"",180,0)"
^XMB(3.9,146012,2,1544,0)=" ; Match Status Filter"
^XMB(3.9,146012,2,1545,0)="""RTN"",""PSOERRX1"",181,0)"
^XMB(3.9,146012,2,1546,0)=" I $G(MATFLTR)=1,VPATIEN Q"
^XMB(3.9,146012,2,1547,0)="""RTN"",""PSOERRX1"",182,0)"
^XMB(3.9,146012,2,1548,0)=" I $G(MATFLTR)=2,VPRVIEN!'VPATIEN Q"
^XMB(3.9,146012,2,1549,0)="""RTN"",""PSOERRX1"",183,0)"
^XMB(3.9,146012,2,1550,0)=" I $G(MATFLTR)=3,VDRGIEN!'VPATIEN!'VPRVIEN Q"
^XMB(3.9,146012,2,1551,0)="""RTN"",""PSOERRX1"",184,0)"
^XMB(3.9,146012,2,1552,0)=" I $G(MATFLTR)=4,'VPATIEN!'VPRVIEN!'VDRGIEN Q"
^XMB(3.9,146012,2,1553,0)="""RTN"",""PSOERRX1"",185,0)"
^XMB(3.9,146012,2,1554,0)=" ; Main Filter Eligibility by Status"
^XMB(3.9,146012,2,1555,0)="""RTN"",""PSOERRX1"",186,0)"
^XMB(3.9,146012,2,1556,0)=" I '$G(PSOALLST)!(PSOSTFLT'=""A""),'$$ELIGSTS^PSOERPC1(""RX"",ERXSTAT,MTYPE) Q"
^XMB(3.9,146012,2,1557,0)="""RTN"",""PSOERRX1"",187,0)"
^XMB(3.9,146012,2,1558,0)=" I '$G(STSFLTR),$G(MSTPFLTR)="""",MTYPE=""CR"",ERXSTAT=""CRE"" Q"
^XMB(3.9,146012,2,1559,0)="""RTN"",""PSOERRX1"",188,0)"
^XMB(3.9,146012,2,1560,0)=" ; eRx Patient DOB Filter"
^XMB(3.9,146012,2,1561,0)="""RTN"",""PSOERRX1"",189,0)"
^XMB(3.9,146012,2,1562,0)=" I $G(DOBFLTR),$$GET1^DIQ(52.46,+EPATIEN,.08,""I"")'=DOBFLTR Q"
^XMB(3.9,146012,2,1563,0)="""RTN"",""PSOERRX1"",190,0)"
^XMB(3.9,146012,2,1564,0)=" ; eRx Status Filter"
^XMB(3.9,146012,2,1565,0)="""RTN"",""PSOERRX1"",191,0)"
^XMB(3.9,146012,2,1566,0)=" I $G(STSFLTR),STSFLTR'=+ERXNODE1 Q"
^XMB(3.9,146012,2,1567,0)="""RTN"",""PSOERRX1"",192,0)"
^XMB(3.9,146012,2,1568,0)=" I ($G(STSFLTR1)[""RM"")!($G(STSFLTR1)[""ALL""),'$$CHKSTSLST(ERXIEN,$G(STSFLTR)) Q"
^XMB(3.9,146012,2,1569,0)="""RTN"",""PSOERRX1"",193,0)"
^XMB(3.9,146012,2,1570,0)=" I ($G(STSFLTR1)[""RJ"")!($G(STSFLTR1)[""ALL""),'$$CHKSTSLST(ERXIEN,$G(STSFLTR)) Q"
^XMB(3.9,146012,2,1571,0)="""RTN"",""PSOERRX1"",194,0)"
^XMB(3.9,146012,2,1572,0)=" ; eRx Drug Name Filter"
^XMB(3.9,146012,2,1573,0)="""RTN"",""PSOERRX1"",195,0)"
^XMB(3.9,146012,2,1574,0)=" I $G(DRGFLTR)'="""",$$UP^XLFSTR(EDRUG)'[$$UP^XLFSTR(DRGFLTR) Q"
^XMB(3.9,146012,2,1575,0)="""RTN"",""PSOERRX1"",196,0)"
^XMB(3.9,146012,2,1576,0)=" ; Controlled Substance Filter"
^XMB(3.9,146012,2,1577,0)="""RTN"",""PSOERRX1"",197,0)"
^XMB(3.9,146012,2,1578,0)=" I $G(PSOCSERX)=""CS"",'CSERX Q"
^XMB(3.9,146012,2,1579,0)="""RTN"",""PSOERRX1"",198,0)"
^XMB(3.9,146012,2,1580,0)=" I $G(PSOCSERX)=""Non-CS"",CSERX Q"
^XMB(3.9,146012,2,1581,0)="""RTN"",""PSOERRX1"",199,0)"
^XMB(3.9,146012,2,1582,0)=" I '$$CSFILTER^PSOERXUT(ERXIEN) Q"
^XMB(3.9,146012,2,1583,0)="""RTN"",""PSOERRX1"",200,0)"
^XMB(3.9,146012,2,1584,0)=" I $G(VDRGFLTR),VDRGIEN'=VDRGFLTR Q"
^XMB(3.9,146012,2,1585,0)="""RTN"",""PSOERRX1"",201,0)"
^XMB(3.9,146012,2,1586,0)=" ; If the eRx is a new refill request and the status is refill request new, check for a response."
^XMB(3.9,146012,2,1587,0)="""RTN"",""PSOERRX1"",202,0)"
^XMB(3.9,146012,2,1588,0)=" ; If no response was received within 14 days, change to RRE (refill request expired)."
^XMB(3.9,146012,2,1589,0)="""RTN"",""PSOERRX1"",203,0)"
^XMB(3.9,146012,2,1590,0)=" I MTYPE=""RR"",ERXSTAT=""RRN"" D CHKEXP^PSOERX(ERXIEN,MTYPE)"
^XMB(3.9,146012,2,1591,0)="""RTN"",""PSOERRX1"",204,0)"
^XMB(3.9,146012,2,1592,0)=" ; ChangeRequest messages will be checked for expiration status, "
^XMB(3.9,146012,2,1593,0)="""RTN"",""PSOERRX1"",205,0)"
^XMB(3.9,146012,2,1594,0)=" ; but will not be displayed in the holding queue list view."
^XMB(3.9,146012,2,1595,0)="""RTN"",""PSOERRX1"",206,0)"
^XMB(3.9,146012,2,1596,0)=" I MTYPE=""CR"",ERXSTAT=""CRN"" D CHKEXP^PSOERX(ERXIEN,MTYPE)"
^XMB(3.9,146012,2,1597,0)="""RTN"",""PSOERRX1"",207,0)"
^XMB(3.9,146012,2,1598,0)=" I 'EPATIEN S EPATIEN=$$GETPAT^PSOERXU5(ERXIEN)"
^XMB(3.9,146012,2,1599,0)="""RTN"",""PSOERRX1"",208,0)"
^XMB(3.9,146012,2,1600,0)=" ; If this is not a search, is a refill response, and is a response type of 'approved',"
^XMB(3.9,146012,2,1601,0)="""RTN"",""PSOERRX1"",209,0)"
^XMB(3.9,146012,2,1602,0)=" ; do not show in the holding queue."
^XMB(3.9,146012,2,1603,0)="""RTN"",""PSOERRX1"",210,0)"
^XMB(3.9,146012,2,1604,0)=" I '$$FILTERED^PSOERPC1(""RX""),MTYPE=""RE"",RESTYPE=""A"" Q"
^XMB(3.9,146012,2,1605,0)="""RTN"",""PSOERRX1"",211,0)"
^XMB(3.9,146012,2,1606,0)=" ; Do not display refill response with 'approved with changes' status in the holding queue."
^XMB(3.9,146012,2,1607,0)="""RTN"",""PSOERRX1"",212,0)"
^XMB(3.9,146012,2,1608,0)=" I '$$FILTERED^PSOERPC1(""RX""),MTYPE=""RE"",""RXP,RXC,RXA,RRP,""[ERXSTAT Q"
^XMB(3.9,146012,2,1609,0)="""RTN"",""PSOERRX1"",213,0)"
^XMB(3.9,146012,2,1610,0)=" S SKIP=0"
^XMB(3.9,146012,2,1611,0)="""RTN"",""PSOERRX1"",214,0)"
^XMB(3.9,146012,2,1612,0)=" I $D(DNDARY),MTYPE=""RE"",$G(MSTPFLTR)=MTYPE,RESTYPE=""D"" D  Q:SKIP"
^XMB(3.9,146012,2,1613,0)="""RTN"",""PSOERRX1"",215,0)"
^XMB(3.9,146012,2,1614,0)=" . I $D(DNDARY) D  ;if user selected additional filter for DENIED"
^XMB(3.9,146012,2,1615,0)="""RTN"",""PSOERRX1"",216,0)"
^XMB(3.9,146012,2,1616,0)=" . . I $P(MSTPFLTR1,""/"",3)=""ALL"" Q"
^XMB(3.9,146012,2,1617,0)="""RTN"",""PSOERRX1"",217,0)"
^XMB(3.9,146012,2,1618,0)=" . . S DRSNCODE=$$DNDRCODE^PSOERRX2(ERXIEN) I $G(DRSNCODE)="""" S SKIP=1 Q  ;get the denied reason code"
^XMB(3.9,146012,2,1619,0)="""RTN"",""PSOERRX1"",218,0)"
^XMB(3.9,146012,2,1620,0)=" . . I $G(DRSNCODE)'="""",'$D(DNDARY(DRSNCODE)) S SKIP=1"
^XMB(3.9,146012,2,1621,0)="""RTN"",""PSOERRX1"",219,0)"
^XMB(3.9,146012,2,1622,0)=" S EPTNODE0=$G(^PS(52.46,EPATIEN,0)),EPTNODE1=$G(^PS(52.46,EPATIEN,1)),EPTNODE2=$G(^PS(52.46,EPATIEN,2))"
