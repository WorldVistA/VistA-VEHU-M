^XMB(3.9,146056,2,1805,0)="""RTN"",""VPRHSX1"",9,0)"
^XMB(3.9,146056,2,1806,0)=" ; ^GMR(120.86                   3449"
^XMB(3.9,146056,2,1807,0)="""RTN"",""VPRHSX1"",10,0)"
^XMB(3.9,146056,2,1808,0)=" ; DIQ                           2056"
^XMB(3.9,146056,2,1809,0)="""RTN"",""VPRHSX1"",11,0)"
^XMB(3.9,146056,2,1810,0)=" ; DIR                          10026"
^XMB(3.9,146056,2,1811,0)="""RTN"",""VPRHSX1"",12,0)"
^XMB(3.9,146056,2,1812,0)=" ; MPIF001                       2701"
^XMB(3.9,146056,2,1813,0)="""RTN"",""VPRHSX1"",13,0)"
^XMB(3.9,146056,2,1814,0)=" ; ORQ12                         5704"
^XMB(3.9,146056,2,1815,0)="""RTN"",""VPRHSX1"",14,0)"
^XMB(3.9,146056,2,1816,0)=" ; VADPT                         3744"
^XMB(3.9,146056,2,1817,0)="""RTN"",""VPRHSX1"",15,0)"
^XMB(3.9,146056,2,1818,0)=" ; XLFDT                        10103"
^XMB(3.9,146056,2,1819,0)="""RTN"",""VPRHSX1"",16,0)"
^XMB(3.9,146056,2,1820,0)=" ; XUPROD                        4440"
^XMB(3.9,146056,2,1821,0)="""RTN"",""VPRHSX1"",17,0)"
^XMB(3.9,146056,2,1822,0)=" ;"
^XMB(3.9,146056,2,1823,0)="""RTN"",""VPRHSX1"",18,0)"
^XMB(3.9,146056,2,1824,0)="GET ; -- Add patient/container/record to GET list [VPR HS PUSH]"
^XMB(3.9,146056,2,1825,0)="""RTN"",""VPRHSX1"",19,0)"
^XMB(3.9,146056,2,1826,0)=" N DFN,ICN,X"
^XMB(3.9,146056,2,1827,0)="""RTN"",""VPRHSX1"",20,0)"
^XMB(3.9,146056,2,1828,0)=" I '$P($G(^VPR(1,0)),U,2) W !,""WARNING: Data Monitoring is currently disabled!"",!"
^XMB(3.9,146056,2,1829,0)="""RTN"",""VPRHSX1"",21,0)"
^XMB(3.9,146056,2,1830,0)=" ;"
^XMB(3.9,146056,2,1831,0)="""RTN"",""VPRHSX1"",22,0)"
^XMB(3.9,146056,2,1832,0)=" W ! S DFN=+$$PATIENT^VPRHST Q:DFN<1"
^XMB(3.9,146056,2,1833,0)="""RTN"",""VPRHSX1"",23,0)"
^XMB(3.9,146056,2,1834,0)=" I '$$SUBS^VPRHS(DFN) D  Q"
^XMB(3.9,146056,2,1835,0)="""RTN"",""VPRHSX1"",24,0)"
^XMB(3.9,146056,2,1836,0)=" . W !,$C(7),""WARNING: This patient is not currently in the Edge Cache Repository (ECR)!"",!"
^XMB(3.9,146056,2,1837,0)="""RTN"",""VPRHSX1"",25,0)"
^XMB(3.9,146056,2,1838,0)=" . S ICN=$$ICN(DFN) I ICN<0 W !,$P(ICN,U,2),!,""Cannot add to ECR"",! Q"
^XMB(3.9,146056,2,1839,0)="""RTN"",""VPRHSX1"",26,0)"
^XMB(3.9,146056,2,1840,0)=" . I $G(^VPR(1,2,DFN,""ANEW"")) W !,""This patient already has a request for subscription."",! Q"
^XMB(3.9,146056,2,1841,0)="""RTN"",""VPRHSX1"",27,0)"
^XMB(3.9,146056,2,1842,0)=" . Q:'$$CONT  D NEW^VPRHS(DFN,ICN)"
^XMB(3.9,146056,2,1843,0)="""RTN"",""VPRHSX1"",28,0)"
^XMB(3.9,146056,2,1844,0)=" . S X=$G(^VPR(1,2,DFN,""ANEW""))"
^XMB(3.9,146056,2,1845,0)="""RTN"",""VPRHSX1"",29,0)"
^XMB(3.9,146056,2,1846,0)=" . W !,"" ... request ""_$S(X:"""",1:""NOT "")_""added to update queue."""
^XMB(3.9,146056,2,1847,0)="""RTN"",""VPRHSX1"",30,0)"
^XMB(3.9,146056,2,1848,0)=" ;"
^XMB(3.9,146056,2,1849,0)="""RTN"",""VPRHSX1"",31,0)"
^XMB(3.9,146056,2,1850,0)=" I $$MERGED^VPRHS(DFN) D  Q"
^XMB(3.9,146056,2,1851,0)="""RTN"",""VPRHSX1"",32,0)"
^XMB(3.9,146056,2,1852,0)=" . S X=$G(^DPT(DFN,-9))"
^XMB(3.9,146056,2,1853,0)="""RTN"",""VPRHSX1"",33,0)"
^XMB(3.9,146056,2,1854,0)=" . W !,""Patient is being merged""_$S(X:"" into DFN ""_X,1:""""),!"
^XMB(3.9,146056,2,1855,0)="""RTN"",""VPRHSX1"",34,0)"
^XMB(3.9,146056,2,1856,0)=" S ICN=$$GETICN^MPIF001(DFN) I ICN<0 W !,""ICN is required!"",! Q"
^XMB(3.9,146056,2,1857,0)="""RTN"",""VPRHSX1"",35,0)"
^XMB(3.9,146056,2,1858,0)=" N TYPE,ENT,FN,ACT,VST,DLIST,VPRX,VPRI,VPRN,ID"
^XMB(3.9,146056,2,1859,0)="""RTN"",""VPRHSX1"",36,0)"
^XMB(3.9,146056,2,1860,0)="G1 ;loop for prompting"
^XMB(3.9,146056,2,1861,0)="""RTN"",""VPRHSX1"",37,0)"
^XMB(3.9,146056,2,1862,0)=" S TYPE=$$CONTNR^VPRHST,ID="""" Q:""^""[TYPE"
^XMB(3.9,146056,2,1863,0)="""RTN"",""VPRHSX1"",38,0)"
^XMB(3.9,146056,2,1864,0)=" I $G(^VPR(1,2,DFN,""AVPR"",TYPE,""*"")) W !,""This patient already has a container update request in the queue!"",! G G1"
^XMB(3.9,146056,2,1865,0)="""RTN"",""VPRHSX1"",39,0)"
^XMB(3.9,146056,2,1866,0)=" I TYPE=""Patient"" D  G G1"
^XMB(3.9,146056,2,1867,0)="""RTN"",""VPRHSX1"",40,0)"
^XMB(3.9,146056,2,1868,0)=" . W !,""Entire container must be updated."""
^XMB(3.9,146056,2,1869,0)="""RTN"",""VPRHSX1"",41,0)"
^XMB(3.9,146056,2,1870,0)=" . S ID=DFN_"";2"""
^XMB(3.9,146056,2,1871,0)="""RTN"",""VPRHSX1"",42,0)"
^XMB(3.9,146056,2,1872,0)=" . D P1^VPRHS,OUT W !"
^XMB(3.9,146056,2,1873,0)="""RTN"",""VPRHSX1"",43,0)"
^XMB(3.9,146056,2,1874,0)=" I $$ALL D P1^VPRHS,OUT W ! G G1"
^XMB(3.9,146056,2,1875,0)="""RTN"",""VPRHSX1"",44,0)"
^XMB(3.9,146056,2,1876,0)=" ;"
^XMB(3.9,146056,2,1877,0)="""RTN"",""VPRHSX1"",45,0)"
^XMB(3.9,146056,2,1878,0)=" ; select source file, record(s)"
^XMB(3.9,146056,2,1879,0)="""RTN"",""VPRHSX1"",46,0)"
^XMB(3.9,146056,2,1880,0)=" S ENT=$$ENTITY(TYPE) G:""^""[ENT G1"
^XMB(3.9,146056,2,1881,0)="""RTN"",""VPRHSX1"",47,0)"
^XMB(3.9,146056,2,1882,0)=" S FN=$P(ENT,U,3),ACT=""U"""
^XMB(3.9,146056,2,1883,0)="""RTN"",""VPRHSX1"",48,0)"
^XMB(3.9,146056,2,1884,0)=" D QUERY I '$D(DLIST) W !,""No records available to update."",! G G1"
^XMB(3.9,146056,2,1885,0)="""RTN"",""VPRHSX1"",49,0)"
^XMB(3.9,146056,2,1886,0)=" S VPRX=$$SELECT(FN) I ""^""[VPRX W ! G G1"
^XMB(3.9,146056,2,1887,0)="""RTN"",""VPRHSX1"",50,0)"
^XMB(3.9,146056,2,1888,0)=" F VPRI=1:1 S VPRN=$P(VPRX,"","",VPRI) Q:VPRN<1  D"
^XMB(3.9,146056,2,1889,0)="""RTN"",""VPRHSX1"",51,0)"
^XMB(3.9,146056,2,1890,0)=" . S ID=$G(DLIST(VPRN))_"";""_FN"
^XMB(3.9,146056,2,1891,0)="""RTN"",""VPRHSX1"",52,0)"
^XMB(3.9,146056,2,1892,0)=" . D P1^VPRHS,OUT(VPRN)"
^XMB(3.9,146056,2,1893,0)="""RTN"",""VPRHSX1"",53,0)"
^XMB(3.9,146056,2,1894,0)=" ;"
^XMB(3.9,146056,2,1895,0)="""RTN"",""VPRHSX1"",54,0)"
^XMB(3.9,146056,2,1896,0)=" W ! G G1"
^XMB(3.9,146056,2,1897,0)="""RTN"",""VPRHSX1"",55,0)"
^XMB(3.9,146056,2,1898,0)=" Q"
^XMB(3.9,146056,2,1899,0)="""RTN"",""VPRHSX1"",56,0)"
^XMB(3.9,146056,2,1900,0)=" ;"
^XMB(3.9,146056,2,1901,0)="""RTN"",""VPRHSX1"",57,0)"
^XMB(3.9,146056,2,1902,0)="ICN(DFN) ; -- return ICN or -1^Message"
^XMB(3.9,146056,2,1903,0)="""RTN"",""VPRHSX1"",58,0)"
^XMB(3.9,146056,2,1904,0)=" N ICN,X I $G(DFN)<1 S ICN=""-1^INVALID PATIENT"" G ICQ"
