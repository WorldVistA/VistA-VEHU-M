^XMB(3.9,146052,2,1703,0)="""RTN"",""FBAAVP"",5,0)"
^XMB(3.9,146052,2,1704,0)=" D DT^DICRW"
^XMB(3.9,146052,2,1705,0)="""RTN"",""FBAAVP"",6,0)"
^XMB(3.9,146052,2,1706,0)="RDP K ^TMP($J) W !! S DIC=""^FBAAC("",DIC(0)=""AEQM"",DIC(""A"")=""Select Patient: "" D ^DIC K DIC(""A"") G Q:X=""^""!(X=""""),RDP:Y<0 S DFN=+Y"
