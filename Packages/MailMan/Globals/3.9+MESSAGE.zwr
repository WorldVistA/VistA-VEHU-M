^XMB(3.9,146087,2,748,0)=" . I YSTSC2'="""",(+YSTSC2'=YSTSC2) S YSTSC2=""""""""_YSTSC2_""""""""  ;String result"
^XMB(3.9,146087,2,749,0)="""RTN"",""YTQRCDB"",55,0)"
^XMB(3.9,146087,2,750,0)=" . I YSTSC2="""",$D(SCORES(I,""tscore2"")) S YSTSC2=""null"""
^XMB(3.9,146087,2,751,0)="""RTN"",""YTQRCDB"",56,0)"
^XMB(3.9,146087,2,752,0)=" . I YSTSC3'="""",(+YSTSC3'=YSTSC3) S YSTSC3=""""""""_YSTSC3_""""""""  ;String result"
^XMB(3.9,146087,2,753,0)="""RTN"",""YTQRCDB"",57,0)"
^XMB(3.9,146087,2,754,0)=" . I YSTSC3="""",$D(SCORES(I,""tscore3"")) S YSTSC3=""null"""
^XMB(3.9,146087,2,755,0)="""RTN"",""YTQRCDB"",58,0)"
^XMB(3.9,146087,2,756,0)=" . S CNT=CNT+1,^TMP(""YTQ-JSON"",$J,CNT,0)=""{""""id"""":""_YSID_"", """"name"""":""""""_YSNAM_"""""", """"raw"""":""_YSRAW_$S(YSTSC]"""":"", """"tscore"""":""_YSTSC,1:"""")_$S(YSTSC2]"""":"", """"tscore2"""":""_YSTSC2,1:"""")_$S(YSTSC3]"""":"", """"tscore3"""":""_YSTSC3,1:"""")_""},"""
