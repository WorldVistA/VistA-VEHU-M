^XMB(3.9,146041,2,1503,0)="""RTN"",""SDES2CRTCLNAVAL2"",7,0)"
^XMB(3.9,146041,2,1504,0)=" ;"
^XMB(3.9,146041,2,1505,0)="""RTN"",""SDES2CRTCLNAVAL2"",8,0)"
^XMB(3.9,146041,2,1506,0)="CREATE(JSON,SDCONTEXT,AVAILABILITY) ;"
^XMB(3.9,146041,2,1507,0)="""RTN"",""SDES2CRTCLNAVAL2"",9,0)"
^XMB(3.9,146041,2,1508,0)=" N ERRORS,RETURNAVAIL,CLINICIEN,CLINICSTARTHOUR,NUMBEROFENTRIES,INPUTS,INDEFINITEUNTIL,SDDISPPERHR,SDCLINSTARTHR,SLOTSTOCANCEL,%,%DT"
^XMB(3.9,146041,2,1509,0)="""RTN"",""SDES2CRTCLNAVAL2"",10,0)"
^XMB(3.9,146041,2,1510,0)=" N DIIX,X"
^XMB(3.9,146041,2,1511,0)="""RTN"",""SDES2CRTCLNAVAL2"",11,0)"
^XMB(3.9,146041,2,1512,0)=" M INPUTS=AVAILABILITY"
^XMB(3.9,146041,2,1513,0)="""RTN"",""SDES2CRTCLNAVAL2"",12,0)"
^XMB(3.9,146041,2,1514,0)=" D VALCONTEXT^SDES2VALCONTEXT(.ERRORS,.SDCONTEXT)"
^XMB(3.9,146041,2,1515,0)="""RTN"",""SDES2CRTCLNAVAL2"",13,0)"
^XMB(3.9,146041,2,1516,0)=" I $D(ERRORS) S ERRORS(""clinicAvailability"")="""" K CNT,I D BUILDJSON^SDES2JSON(.JSON,.ERRORS) Q"
^XMB(3.9,146041,2,1517,0)="""RTN"",""SDES2CRTCLNAVAL2"",14,0)"
^XMB(3.9,146041,2,1518,0)=" I $G(SDCONTEXT(""USER DUZ""))'="""" N DUZ D DUZ^XUP(SDCONTEXT(""USER DUZ""))"
^XMB(3.9,146041,2,1519,0)="""RTN"",""SDES2CRTCLNAVAL2"",15,0)"
^XMB(3.9,146041,2,1520,0)=" D VALIDATE(.ERRORS,.AVAILABILITY,.CLINICIEN,.CLINICSTARTHOUR,.NUMBEROFENTRIES,.INPUTS)"
^XMB(3.9,146041,2,1521,0)="""RTN"",""SDES2CRTCLNAVAL2"",16,0)"
^XMB(3.9,146041,2,1522,0)=" I $D(ERRORS) S ERRORS(""clinicAvailability"")="""" K CNT,I D BUILDJSON^SDES2JSON(.JSON,.ERRORS) Q"
^XMB(3.9,146041,2,1523,0)="""RTN"",""SDES2CRTCLNAVAL2"",17,0)"
^XMB(3.9,146041,2,1524,0)=" D CREATEAVAIL(.AVAILABILITY,.SDCONTEXT,.SLOTSTOCANCEL,CLINICIEN,CLINICSTARTHOUR,$$GET1^DIQ(44,CLINICIEN,1917,""I""),$$GET1^DIQ(44,CLINICIEN,1914,""I""),NUMBEROFENTRIES,.INPUTS,.INDEFINITEUNTIL,.RETURNAVAIL,.ERRORS)"
^XMB(3.9,146041,2,1525,0)="""RTN"",""SDES2CRTCLNAVAL2"",18,0)"
^XMB(3.9,146041,2,1526,0)=" I $L($G(SLOTSTOCANCEL(""CancelledSlots"",1,""BeginTime""))),$G(AVAILABILITY(""KEEP CANCELLED SLOTS""))=1 D"
^XMB(3.9,146041,2,1527,0)="""RTN"",""SDES2CRTCLNAVAL2"",19,0)"
^XMB(3.9,146041,2,1528,0)=" .D RECANCELSLOTS(.SLOTSTOCANCEL,CLINICIEN,.SDCONTEXT) K SLOTSTOCANCEL"
^XMB(3.9,146041,2,1529,0)="""RTN"",""SDES2CRTCLNAVAL2"",20,0)"
^XMB(3.9,146041,2,1530,0)=" I '$D(RETURNAVAIL) S RETURNAVAIL(""clinicAvailability"")="""""
^XMB(3.9,146041,2,1531,0)="""RTN"",""SDES2CRTCLNAVAL2"",21,0)"
^XMB(3.9,146041,2,1532,0)=" D BUILDJSON^SDES2JSON(.JSON,.RETURNAVAIL)"
^XMB(3.9,146041,2,1533,0)="""RTN"",""SDES2CRTCLNAVAL2"",22,0)"
^XMB(3.9,146041,2,1534,0)=" K CNT,I"
^XMB(3.9,146041,2,1535,0)="""RTN"",""SDES2CRTCLNAVAL2"",23,0)"
^XMB(3.9,146041,2,1536,0)=" Q"
^XMB(3.9,146041,2,1537,0)="""RTN"",""SDES2CRTCLNAVAL2"",24,0)"
^XMB(3.9,146041,2,1538,0)=" ;"
^XMB(3.9,146041,2,1539,0)="""RTN"",""SDES2CRTCLNAVAL2"",25,0)"
^XMB(3.9,146041,2,1540,0)="CREATEAVAIL(AVAILABILITY,SDCONTEXT,SLOTSTOCANCEL,CLINICIEN,CLINICSTARTHOUR,SDDISPPERHR,SDCLINSTARTHR,NUMBEROFENTRIES,INPUTS,INDEFINITEUNTIL,RETURNAVAIL,ERRORS) ;"
^XMB(3.9,146041,2,1541,0)="""RTN"",""SDES2CRTCLNAVAL2"",26,0)"
^XMB(3.9,146041,2,1542,0)=" N TIMESLOTCNT,CNT,ENDDATE,DATES,TIMES,NUMBEROFSLOTS,SCHEDULEDDAYS,DATENEXTTIMESLOT,CANSLOTSENDDATE,DONE,SDRETURN,SDONE,J,SDSAV,SDST1,SM,SS,SEQ,%H,ENDATE,SB,STARTDATE,CNT1,CANCELTYPE"
^XMB(3.9,146041,2,1543,0)="""RTN"",""SDES2CRTCLNAVAL2"",27,0)"
^XMB(3.9,146041,2,1544,0)=" ;"
^XMB(3.9,146041,2,1545,0)="""RTN"",""SDES2CRTCLNAVAL2"",28,0)"
^XMB(3.9,146041,2,1546,0)=" S TIMESLOTCNT=0,DONE=0"
^XMB(3.9,146041,2,1547,0)="""RTN"",""SDES2CRTCLNAVAL2"",29,0)"
^XMB(3.9,146041,2,1548,0)=" F  S TIMESLOTCNT=$O(AVAILABILITY(""TIMESLOT"",TIMESLOTCNT)) Q:'TIMESLOTCNT!(DONE=1)  D"
^XMB(3.9,146041,2,1549,0)="""RTN"",""SDES2CRTCLNAVAL2"",30,0)"
^XMB(3.9,146041,2,1550,0)=" .S CNT=0"
^XMB(3.9,146041,2,1551,0)="""RTN"",""SDES2CRTCLNAVAL2"",31,0)"
^XMB(3.9,146041,2,1552,0)=" .F  S CNT=$O(AVAILABILITY(""TIMESLOT"",TIMESLOTCNT,""START DATE TIME"",CNT)) Q:'CNT  D"
^XMB(3.9,146041,2,1553,0)="""RTN"",""SDES2CRTCLNAVAL2"",32,0)"
^XMB(3.9,146041,2,1554,0)=" ..I $G(SCHEDULEDDAYS)[$P($G(INPUTS(""TIMESLOT"",TIMESLOTCNT,""START DATE TIME"",CNT)),""T"") Q"
^XMB(3.9,146041,2,1555,0)="""RTN"",""SDES2CRTCLNAVAL2"",33,0)"
^XMB(3.9,146041,2,1556,0)=" ..D CREATEDATESTIMES(.DATES,.TIMES,.NUMBEROFSLOTS,.INPUTS,$P($G(INPUTS(""TIMESLOT"",TIMESLOTCNT,""START DATE TIME"",CNT)),""T""),NUMBEROFENTRIES,.SLOTSTOCANCEL)"
^XMB(3.9,146041,2,1557,0)="""RTN"",""SDES2CRTCLNAVAL2"",34,0)"
^XMB(3.9,146041,2,1558,0)=" ..I $D(SLOTSTOCANCEL(""Error"")) M RETURNAVAIL=SLOTSTOCANCEL S DONE=1 Q"
^XMB(3.9,146041,2,1559,0)="""RTN"",""SDES2CRTCLNAVAL2"",35,0)"
^XMB(3.9,146041,2,1560,0)=" ..S CNT1=0 F  S CNT1=$O(SLOTSTOCANCEL(""CancelledSlots"",CNT1)) Q:CNT1=""""  D"
^XMB(3.9,146041,2,1561,0)="""RTN"",""SDES2CRTCLNAVAL2"",36,0)"
^XMB(3.9,146041,2,1562,0)=" ...S STARTDATE=$$ISOTFM^SDAMUTDT($G(SLOTSTOCANCEL(""CancelledSlots"",CNT1,""BeginTime"")),CLINICIEN)"
^XMB(3.9,146041,2,1563,0)="""RTN"",""SDES2CRTCLNAVAL2"",37,0)"
^XMB(3.9,146041,2,1564,0)=" ...Q:STARTDATE="""""
^XMB(3.9,146041,2,1565,0)="""RTN"",""SDES2CRTCLNAVAL2"",38,0)"
^XMB(3.9,146041,2,1566,0)=" ...S CANCELTYPE=$S(STARTDATE[""."":""P"",1:""F"")"
^XMB(3.9,146041,2,1567,0)="""RTN"",""SDES2CRTCLNAVAL2"",39,0)"
^XMB(3.9,146041,2,1568,0)=" ...I ((CANCELTYPE=""P"")&($G(^SC(CLINICIEN,""SDCAN"",STARTDATE,0))="""")) K SLOTSTOCANCEL(""CancelledSlots"",CNT1) Q"
^XMB(3.9,146041,2,1569,0)="""RTN"",""SDES2CRTCLNAVAL2"",40,0)"
^XMB(3.9,146041,2,1570,0)=" ...I ((CANCELTYPE=""F"")&($G(^SC(CLINICIEN,""FULL DAY CANCEL"",STARTDATE,1))="""")) K SLOTSTOCANCEL(""CancelledSlots"",CNT1) Q"
^XMB(3.9,146041,2,1571,0)="""RTN"",""SDES2CRTCLNAVAL2"",41,0)"
^XMB(3.9,146041,2,1572,0)=" ...I CANCELTYPE=""P"" S SLOTSTOCANCEL(""CancelledSlots"",CNT1,""Remarks"")=$G(^SC(CLINICIEN,""S"",STARTDATE,""MES""))"
^XMB(3.9,146041,2,1573,0)="""RTN"",""SDES2CRTCLNAVAL2"",42,0)"
