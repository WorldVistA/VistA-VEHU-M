^XMB(3.9,146096,2,565,0)="""RTN"",""MAGVAQ01"",158,0)"
^XMB(3.9,146096,2,566,0)=" ;            "
^XMB(3.9,146096,2,567,0)="""RTN"",""MAGVAQ01"",159,0)"
^XMB(3.9,146096,2,568,0)=" ;            if IEN equals 0 that means nothing was found"
^XMB(3.9,146096,2,569,0)="""RTN"",""MAGVAQ01"",160,0)"
^XMB(3.9,146096,2,570,0)=" ;"
^XMB(3.9,146096,2,571,0)="""RTN"",""MAGVAQ01"",161,0)"
^XMB(3.9,146096,2,572,0)="PEEKQM(MAGRY,MAGPARAM) ; RPC [MAGVA PEEK Q MSG]"
^XMB(3.9,146096,2,573,0)="""RTN"",""MAGVAQ01"",162,0)"
^XMB(3.9,146096,2,574,0)=" K MAGRY"
^XMB(3.9,146096,2,575,0)="""RTN"",""MAGVAQ01"",163,0)"
^XMB(3.9,146096,2,576,0)=" D FINDQM^MAGVAQ01(.MAGRY,.MAGPARAM,"""")"
^XMB(3.9,146096,2,577,0)="""RTN"",""MAGVAQ01"",164,0)"
^XMB(3.9,146096,2,578,0)=" Q"
^XMB(3.9,146096,2,579,0)="""RTN"",""MAGVAQ01"",165,0)"
^XMB(3.9,146096,2,580,0)=" ;"
^XMB(3.9,146096,2,581,0)="""RTN"",""MAGVAQ01"",166,0)"
^XMB(3.9,146096,2,582,0)=" ;+++++  Find, return and remove a queue message from the QUEUE MESSAGE file (#2006.928)"
^XMB(3.9,146096,2,583,0)="""RTN"",""MAGVAQ01"",167,0)"
^XMB(3.9,146096,2,584,0)=" ;       by QUEUE - IEN of record in QUEUE file (#2006.927)"
^XMB(3.9,146096,2,585,0)="""RTN"",""MAGVAQ01"",168,0)"
^XMB(3.9,146096,2,586,0)=" ;       The message will have the EARLIEST DELIVERY DATE/TIME equals NULL or the EARLIEST DELIVERY DATE/TIME less than "
^XMB(3.9,146096,2,587,0)="""RTN"",""MAGVAQ01"",169,0)"
^XMB(3.9,146096,2,588,0)=" ;       current date/time "
^XMB(3.9,146096,2,589,0)="""RTN"",""MAGVAQ01"",170,0)"
^XMB(3.9,146096,2,590,0)=" ;       and the EXPIRATION DATE/TIME equals NULL or the EXPIRATION DATE/TIME greater than current date/time."
^XMB(3.9,146096,2,591,0)="""RTN"",""MAGVAQ01"",171,0)"
^XMB(3.9,146096,2,592,0)=" ;       "
^XMB(3.9,146096,2,593,0)="""RTN"",""MAGVAQ01"",172,0)"
^XMB(3.9,146096,2,594,0)=" ;       Delete the message if the flag is set "
^XMB(3.9,146096,2,595,0)="""RTN"",""MAGVAQ01"",173,0)"
^XMB(3.9,146096,2,596,0)=" ; "
^XMB(3.9,146096,2,597,0)="""RTN"",""MAGVAQ01"",174,0)"
^XMB(3.9,146096,2,598,0)=" ; Input Parameters"
^XMB(3.9,146096,2,599,0)="""RTN"",""MAGVAQ01"",175,0)"
^XMB(3.9,146096,2,600,0)=" ; ================"
^XMB(3.9,146096,2,601,0)="""RTN"",""MAGVAQ01"",176,0)"
^XMB(3.9,146096,2,602,0)=" ;  "
^XMB(3.9,146096,2,603,0)="""RTN"",""MAGVAQ01"",177,0)"
^XMB(3.9,146096,2,604,0)=" ;  MAGPARAM(""QUEUE"") = IEN in QUEUE file (#2006.927)"
^XMB(3.9,146096,2,605,0)="""RTN"",""MAGVAQ01"",178,0)"
^XMB(3.9,146096,2,606,0)=" ;  MAGPARAM(""MESSAGE GROUP ID"") = value of the field ""MESSAGE GROUP ID"""
^XMB(3.9,146096,2,607,0)="""RTN"",""MAGVAQ01"",179,0)"
^XMB(3.9,146096,2,608,0)=" ;                                  in QUEUE file (#2006.927) or ""*"" or """""
^XMB(3.9,146096,2,609,0)="""RTN"",""MAGVAQ01"",180,0)"
^XMB(3.9,146096,2,610,0)=" ;  FLAGS    =  [D] delete the message from QUEUE MESSAGE file (#2006.928)"
^XMB(3.9,146096,2,611,0)="""RTN"",""MAGVAQ01"",181,0)"
^XMB(3.9,146096,2,612,0)=" ;"
^XMB(3.9,146096,2,613,0)="""RTN"",""MAGVAQ01"",182,0)"
^XMB(3.9,146096,2,614,0)=" ; Return Values"
^XMB(3.9,146096,2,615,0)="""RTN"",""MAGVAQ01"",183,0)"
^XMB(3.9,146096,2,616,0)=" ; ============="
^XMB(3.9,146096,2,617,0)="""RTN"",""MAGVAQ01"",184,0)"
^XMB(3.9,146096,2,618,0)=" ; if error MAGRY(0) = Failure status ^ Error message"
^XMB(3.9,146096,2,619,0)="""RTN"",""MAGVAQ01"",185,0)"
^XMB(3.9,146096,2,620,0)=" ; if success MAGRY(0) = Success status ^^IEN"
^XMB(3.9,146096,2,621,0)="""RTN"",""MAGVAQ01"",186,0)"
^XMB(3.9,146096,2,622,0)=" ;            MAGRY(1..n) = The QUEUE MESSAGE"
^XMB(3.9,146096,2,623,0)="""RTN"",""MAGVAQ01"",187,0)"
^XMB(3.9,146096,2,624,0)=" ;            "
^XMB(3.9,146096,2,625,0)="""RTN"",""MAGVAQ01"",188,0)"
^XMB(3.9,146096,2,626,0)=" ;            if IEN equals 0 that means nothing was found"
^XMB(3.9,146096,2,627,0)="""RTN"",""MAGVAQ01"",189,0)"
^XMB(3.9,146096,2,628,0)=" ;"
^XMB(3.9,146096,2,629,0)="""RTN"",""MAGVAQ01"",190,0)"
^XMB(3.9,146096,2,630,0)="FINDQM(MAGRY,MAGPARAM,FLAGS) ;"
^XMB(3.9,146096,2,631,0)="""RTN"",""MAGVAQ01"",191,0)"
^XMB(3.9,146096,2,632,0)=" N MAGDT,IEN,FILE,FLDMINDT,FLDEXPDT"
^XMB(3.9,146096,2,633,0)="""RTN"",""MAGVAQ01"",192,0)"
^XMB(3.9,146096,2,634,0)=" N ERRMSG,FOUND"
^XMB(3.9,146096,2,635,0)="""RTN"",""MAGVAQ01"",193,0)"
^XMB(3.9,146096,2,636,0)=" N QUEUEIEN,MSGGRPID"
^XMB(3.9,146096,2,637,0)="""RTN"",""MAGVAQ01"",194,0)"
^XMB(3.9,146096,2,638,0)=" S QUEUEIEN=$G(MAGPARAM(""QUEUE""))"
^XMB(3.9,146096,2,639,0)="""RTN"",""MAGVAQ01"",195,0)"
^XMB(3.9,146096,2,640,0)=" S MSGGRPID=$G(MAGPARAM(""MESSAGE GROUP ID""))"
^XMB(3.9,146096,2,641,0)="""RTN"",""MAGVAQ01"",196,0)"
^XMB(3.9,146096,2,642,0)=" S FILE=2006.928  ; Queue Message file"
^XMB(3.9,146096,2,643,0)="""RTN"",""MAGVAQ01"",197,0)"
^XMB(3.9,146096,2,644,0)=" S FLDMINDT=$$GETFLDID^MAGVAF01(FILE,""EARLIEST DELIVERY DATE/TIME"")"
^XMB(3.9,146096,2,645,0)="""RTN"",""MAGVAQ01"",198,0)"
^XMB(3.9,146096,2,646,0)=" S FLDEXPDT=$$GETFLDID^MAGVAF01(FILE,""EXPIRATION DATE/TIME"")"
^XMB(3.9,146096,2,647,0)="""RTN"",""MAGVAQ01"",199,0)"
^XMB(3.9,146096,2,648,0)=" ; Check for QUEUE"
^XMB(3.9,146096,2,649,0)="""RTN"",""MAGVAQ01"",200,0)"
^XMB(3.9,146096,2,650,0)=" I QUEUEIEN="""" S MAGRY(0)=$$FAILED^MAGVAF02()_$$RESDEL^MAGVAF02()_""Input parameter QUEUE is required."" Q  ; Error getting the IEN"
^XMB(3.9,146096,2,651,0)="""RTN"",""MAGVAQ01"",201,0)"
^XMB(3.9,146096,2,652,0)=" S FOUND=0"
^XMB(3.9,146096,2,653,0)="""RTN"",""MAGVAQ01"",202,0)"
^XMB(3.9,146096,2,654,0)=" S ERRMSG="""""
^XMB(3.9,146096,2,655,0)="""RTN"",""MAGVAQ01"",203,0)"
^XMB(3.9,146096,2,656,0)=" I MSGGRPID=""*"" D"
^XMB(3.9,146096,2,657,0)="""RTN"",""MAGVAQ01"",204,0)"
^XMB(3.9,146096,2,658,0)=" . ; Use ENQDT index to loop through the queue and enqueued dates"
^XMB(3.9,146096,2,659,0)="""RTN"",""MAGVAQ01"",205,0)"
^XMB(3.9,146096,2,660,0)=" . ; For each IEN found check if the EARLIEST DELIVERY DATE/TIME is NULL OR the EARLIEST DELIVERY DATE/TIME < NOW) "
^XMB(3.9,146096,2,661,0)="""RTN"",""MAGVAQ01"",206,0)"
^XMB(3.9,146096,2,662,0)=" . ; and (the EXPIRATION DATE/TIME is NULL OR the EXPIRATION DATE/TIME > NOW) then quit and return the IEN"
^XMB(3.9,146096,2,663,0)="""RTN"",""MAGVAQ01"",207,0)"
^XMB(3.9,146096,2,664,0)=" . S MAGDT="""""
^XMB(3.9,146096,2,665,0)="""RTN"",""MAGVAQ01"",208,0)"
^XMB(3.9,146096,2,666,0)=" . S FOUND=0  ; If an eligible Queue message was found. IEN will be set to this record"
^XMB(3.9,146096,2,667,0)="""RTN"",""MAGVAQ01"",209,0)"
^XMB(3.9,146096,2,668,0)=" . F  Q:(ERRMSG'="""")!FOUND  S MAGDT=$O(^MAGV(FILE,""ENQDT"",QUEUEIEN,MAGDT)) Q:MAGDT=""""  D"
^XMB(3.9,146096,2,669,0)="""RTN"",""MAGVAQ01"",210,0)"
^XMB(3.9,146096,2,670,0)=" . . S IEN="""""
^XMB(3.9,146096,2,671,0)="""RTN"",""MAGVAQ01"",211,0)"
^XMB(3.9,146096,2,672,0)=" . . F  Q:(ERRMSG'="""")!FOUND  S IEN=$O(^MAGV(FILE,""ENQDT"",QUEUEIEN,MAGDT,IEN)) Q:IEN=""""  D"
^XMB(3.9,146096,2,673,0)="""RTN"",""MAGVAQ01"",212,0)"
^XMB(3.9,146096,2,674,0)=" . . . S FOUND=$$CHECKQM^MAGVAQ01(.ERRMSG,FILE,IEN,FLDMINDT,FLDEXPDT) ; see if we meet the criteria"
^XMB(3.9,146096,2,675,0)="""RTN"",""MAGVAQ01"",213,0)"
^XMB(3.9,146096,2,676,0)=" . . . I ERRMSG'="""" S MAGRY(0)=ERRMSG"
^XMB(3.9,146096,2,677,0)="""RTN"",""MAGVAQ01"",214,0)"
^XMB(3.9,146096,2,678,0)=" . . . Q"
^XMB(3.9,146096,2,679,0)="""RTN"",""MAGVAQ01"",215,0)"
^XMB(3.9,146096,2,680,0)=" . . Q"
^XMB(3.9,146096,2,681,0)="""RTN"",""MAGVAQ01"",216,0)"
^XMB(3.9,146096,2,682,0)=" . Q"
^XMB(3.9,146096,2,683,0)="""RTN"",""MAGVAQ01"",217,0)"
^XMB(3.9,146096,2,684,0)=" ;"
^XMB(3.9,146096,2,685,0)="""RTN"",""MAGVAQ01"",218,0)"
^XMB(3.9,146096,2,686,0)=" I MSGGRPID="""" D"
^XMB(3.9,146096,2,687,0)="""RTN"",""MAGVAQ01"",219,0)"
^XMB(3.9,146096,2,688,0)=" . ; Use ENQBLDT index to loop through the queue and enqueued dates"
^XMB(3.9,146096,2,689,0)="""RTN"",""MAGVAQ01"",220,0)"
^XMB(3.9,146096,2,690,0)=" . ; For each IEN found check if the EARLIEST DELIVERY DATE/TIME is NULL OR the EARLIEST DELIVERY DATE/TIME < NOW) "
^XMB(3.9,146096,2,691,0)="""RTN"",""MAGVAQ01"",221,0)"
^XMB(3.9,146096,2,692,0)=" . ; and (the EXPIRATION DATE/TIME is NULL OR the EXPIRATION DATE/TIME > NOW) then quit and return the IEN"
^XMB(3.9,146096,2,693,0)="""RTN"",""MAGVAQ01"",222,0)"
^XMB(3.9,146096,2,694,0)=" . S MAGDT="""""
^XMB(3.9,146096,2,695,0)="""RTN"",""MAGVAQ01"",223,0)"
^XMB(3.9,146096,2,696,0)=" . S FOUND=0  ; If an eligible Queue message was found. IEN will be set to this record"
^XMB(3.9,146096,2,697,0)="""RTN"",""MAGVAQ01"",224,0)"
^XMB(3.9,146096,2,698,0)=" . F  Q:(ERRMSG'="""")!FOUND  S MAGDT=$O(^MAGV(FILE,""ENQBLDT"",QUEUEIEN,MAGDT)) Q:MAGDT=""""  D"
^XMB(3.9,146096,2,699,0)="""RTN"",""MAGVAQ01"",225,0)"
^XMB(3.9,146096,2,700,0)=" . . S IEN="""""
^XMB(3.9,146096,2,701,0)="""RTN"",""MAGVAQ01"",226,0)"
^XMB(3.9,146096,2,702,0)=" . . F  Q:(ERRMSG'="""")!FOUND  S IEN=$O(^MAGV(FILE,""ENQBLDT"",QUEUEIEN,MAGDT,IEN)) Q:IEN=""""  D"
^XMB(3.9,146096,2,703,0)="""RTN"",""MAGVAQ01"",227,0)"
^XMB(3.9,146096,2,704,0)=" . . . S FOUND=$$CHECKQM^MAGVAQ01(.ERRMSG,FILE,IEN,FLDMINDT,FLDEXPDT) ; see if we meet the criteria"
^XMB(3.9,146096,2,705,0)="""RTN"",""MAGVAQ01"",228,0)"
^XMB(3.9,146096,2,706,0)=" . . . I ERRMSG'="""" S MAGRY(0)=ERRMSG"
^XMB(3.9,146096,2,707,0)="""RTN"",""MAGVAQ01"",229,0)"
^XMB(3.9,146096,2,708,0)=" . . . Q"
^XMB(3.9,146096,2,709,0)="""RTN"",""MAGVAQ01"",230,0)"
^XMB(3.9,146096,2,710,0)=" . . Q"
^XMB(3.9,146096,2,711,0)="""RTN"",""MAGVAQ01"",231,0)"
^XMB(3.9,146096,2,712,0)=" . Q"
^XMB(3.9,146096,2,713,0)="""RTN"",""MAGVAQ01"",232,0)"
^XMB(3.9,146096,2,714,0)=" ;"
^XMB(3.9,146096,2,715,0)="""RTN"",""MAGVAQ01"",233,0)"
^XMB(3.9,146096,2,716,0)=" I (MSGGRPID'=""""),(MSGGRPID'=""*"") D"
^XMB(3.9,146096,2,717,0)="""RTN"",""MAGVAQ01"",234,0)"
^XMB(3.9,146096,2,718,0)=" . ; Use ENQPLDT index to loop through the queue, place and enqueued dates"
^XMB(3.9,146096,2,719,0)="""RTN"",""MAGVAQ01"",235,0)"
^XMB(3.9,146096,2,720,0)=" . ; For each IEN found check if the EARLIEST DELIVERY DATE/TIME is NULL OR the EARLIEST DELIVERY DATE/TIME < NOW) "
^XMB(3.9,146096,2,721,0)="""RTN"",""MAGVAQ01"",236,0)"
^XMB(3.9,146096,2,722,0)=" . ; and (the EXPIRATION DATE/TIME is NULL OR the EXPIRATION DATE/TIME > NOW) then quit and return the IEN"
^XMB(3.9,146096,2,723,0)="""RTN"",""MAGVAQ01"",237,0)"
^XMB(3.9,146096,2,724,0)=" . S MAGDT="""""
^XMB(3.9,146096,2,725,0)="""RTN"",""MAGVAQ01"",238,0)"
^XMB(3.9,146096,2,726,0)=" . S FOUND=0  ; If an eligible Queue message was found. IEN will be set to this record"
^XMB(3.9,146096,2,727,0)="""RTN"",""MAGVAQ01"",239,0)"
^XMB(3.9,146096,2,728,0)=" . F  Q:(ERRMSG'="""")!FOUND  S MAGDT=$O(^MAGV(FILE,""ENQPLDT"",QUEUEIEN,MSGGRPID,MAGDT)) Q:MAGDT=""""  D"
^XMB(3.9,146096,2,729,0)="""RTN"",""MAGVAQ01"",240,0)"
^XMB(3.9,146096,2,730,0)=" . . S IEN="""""
^XMB(3.9,146096,2,731,0)="""RTN"",""MAGVAQ01"",241,0)"
^XMB(3.9,146096,2,732,0)=" . . F  Q:(ERRMSG'="""")!FOUND  S IEN=$O(^MAGV(FILE,""ENQPLDT"",QUEUEIEN,MSGGRPID,MAGDT,IEN)) Q:IEN=""""  D"
^XMB(3.9,146096,2,733,0)="""RTN"",""MAGVAQ01"",242,0)"
^XMB(3.9,146096,2,734,0)=" . . . S FOUND=$$CHECKQM^MAGVAQ01(.ERRMSG,FILE,IEN,FLDMINDT,FLDEXPDT) ; see if we meet the criteria"
^XMB(3.9,146096,2,735,0)="""RTN"",""MAGVAQ01"",243,0)"
^XMB(3.9,146096,2,736,0)=" . . . I ERRMSG'="""" S MAGRY(0)=ERRMSG"
^XMB(3.9,146096,2,737,0)="""RTN"",""MAGVAQ01"",244,0)"
^XMB(3.9,146096,2,738,0)=" . . . Q"
^XMB(3.9,146096,2,739,0)="""RTN"",""MAGVAQ01"",245,0)"
^XMB(3.9,146096,2,740,0)=" . . Q"
^XMB(3.9,146096,2,741,0)="""RTN"",""MAGVAQ01"",246,0)"
^XMB(3.9,146096,2,742,0)=" . Q"
^XMB(3.9,146096,2,743,0)="""RTN"",""MAGVAQ01"",247,0)"
^XMB(3.9,146096,2,744,0)=" I ERRMSG'="""" Q  ; Quit - Found error getting values"
^XMB(3.9,146096,2,745,0)="""RTN"",""MAGVAQ01"",248,0)"
^XMB(3.9,146096,2,746,0)=" ;"
^XMB(3.9,146096,2,747,0)="""RTN"",""MAGVAQ01"",249,0)"
^XMB(3.9,146096,2,748,0)=" I 'FOUND S MAGRY(0)=$$OK^MAGVAF02()_$$RESDEL^MAGVAF02()_$$RESDEL^MAGVAF02()_0 Q"
^XMB(3.9,146096,2,749,0)="""RTN"",""MAGVAQ01"",250,0)"
^XMB(3.9,146096,2,750,0)=" ; "
^XMB(3.9,146096,2,751,0)="""RTN"",""MAGVAQ01"",251,0)"
^XMB(3.9,146096,2,752,0)=" ; Get the message and delete it from the queue if the flag is set"
^XMB(3.9,146096,2,753,0)="""RTN"",""MAGVAQ01"",252,0)"
^XMB(3.9,146096,2,754,0)=" ;"
^XMB(3.9,146096,2,755,0)="""RTN"",""MAGVAQ01"",253,0)"
^XMB(3.9,146096,2,756,0)=" D GXMLBYPK^MAGVAF03(.MAGRY,FILE,IEN,0)"
^XMB(3.9,146096,2,757,0)="""RTN"",""MAGVAQ01"",254,0)"
^XMB(3.9,146096,2,758,0)=" I '$$ISOK^MAGVAF02(MAGRY(0)) Q  ; Check for error and quit if we have one"
^XMB(3.9,146096,2,759,0)="""RTN"",""MAGVAQ01"",255,0)"
^XMB(3.9,146096,2,760,0)=" ;"
^XMB(3.9,146096,2,761,0)="""RTN"",""MAGVAQ01"",256,0)"
^XMB(3.9,146096,2,762,0)=" ; Delete the message from QUEUE MESSAGE file (#2006.928)"
^XMB(3.9,146096,2,763,0)="""RTN"",""MAGVAQ01"",257,0)"
^XMB(3.9,146096,2,764,0)=" I FLAGS[""D"" D"
^XMB(3.9,146096,2,765,0)="""RTN"",""MAGVAQ01"",258,0)"
^XMB(3.9,146096,2,766,0)=" . N DA,DIK"
^XMB(3.9,146096,2,767,0)="""RTN"",""MAGVAQ01"",259,0)"
^XMB(3.9,146096,2,768,0)=" . S DIK=$$GETFILGL^MAGVAF01(FILE)"
^XMB(3.9,146096,2,769,0)="""RTN"",""MAGVAQ01"",260,0)"
^XMB(3.9,146096,2,770,0)=" . S DA=IEN"
^XMB(3.9,146096,2,771,0)="""RTN"",""MAGVAQ01"",261,0)"
^XMB(3.9,146096,2,772,0)=" . D ^DIK"
^XMB(3.9,146096,2,773,0)="""RTN"",""MAGVAQ01"",262,0)"
^XMB(3.9,146096,2,774,0)=" . Q"
^XMB(3.9,146096,2,775,0)="""RTN"",""MAGVAQ01"",263,0)"
