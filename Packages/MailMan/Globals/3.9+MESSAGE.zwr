^XMB(3.9,146009,2,1161,0)="""RTN"",""XUMVINPB"",242,0)"
^XMB(3.9,146009,2,1162,0)="LINETAG() ;return line tag for type of extract requested"
^XMB(3.9,146009,2,1163,0)="""RTN"",""XUMVINPB"",243,0)"
^XMB(3.9,146009,2,1164,0)=" Q $S(XUTYPE=""A"":""ACTIVE"",XUTYPE=""D"":""DISTERM"",XUTYPE=""V"":""VISITOR"",XUTYPE=""ALL"":""ALL"",1:""UNKNOWN"")"
^XMB(3.9,146009,2,1165,0)="""RTN"",""XUMVINPB"",244,0)"
