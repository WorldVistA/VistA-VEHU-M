^XMB(3.9,146087,2,3586,0)=" I CATHIT S STR=^TMP(""YTQ-JSON"",$J,CNT,0),STR=$E(STR,1,$L(STR)-1),^TMP(""YTQ-JSON"",$J,CNT,0)=STR"
^XMB(3.9,146087,2,3587,0)="""RTN"",""YTQRQAD4"",280,0)"
^XMB(3.9,146087,2,3588,0)=" D SETRES(""]},"")"
^XMB(3.9,146087,2,3589,0)="""RTN"",""YTQRQAD4"",281,0)"
^XMB(3.9,146087,2,3590,0)=" Q"
^XMB(3.9,146087,2,3591,0)="""RTN"",""YTQRQAD4"",282,0)"
^XMB(3.9,146087,2,3592,0)="INCMPLT(DFN,ORDBY,INCMPL) ; add list of incompl insts for DFN/ORDBY"
^XMB(3.9,146087,2,3593,0)="""RTN"",""YTQRQAD4"",283,0)"
^XMB(3.9,146087,2,3594,0)=" ; expects RSP,YSIDX,PTADMIN"
^XMB(3.9,146087,2,3595,0)="""RTN"",""YTQRQAD4"",284,0)"
^XMB(3.9,146087,2,3596,0)=" Q:'ORDBY  Q:'DFN"
^XMB(3.9,146087,2,3597,0)="""RTN"",""YTQRQAD4"",285,0)"
^XMB(3.9,146087,2,3598,0)=" N I,X,YS,YSDATA,YSNOW,YSDOW,OFFSET,YSDTSAV,YSRSTRT,YSDG,YSINAM,YSADMIN,YSORD,YSCONS,PID,PTNAM,YSARR"
^XMB(3.9,146087,2,3599,0)="""RTN"",""YTQRQAD4"",286,0)"
^XMB(3.9,146087,2,3600,0)=" N YSIN,YSINIEN,YSINTTL,YSLOC,YSINTRV,YSSRC"
^XMB(3.9,146087,2,3601,0)="""RTN"",""YTQRQAD4"",287,0)"
^XMB(3.9,146087,2,3602,0)=" N VA,VADM,VAERR"
^XMB(3.9,146087,2,3603,0)="""RTN"",""YTQRQAD4"",288,0)"
^XMB(3.9,146087,2,3604,0)=" D DEM^VADPT I $G(VAERR) D SETERROR^YTQRUTL(400,""Missing Pt Info"") Q"
^XMB(3.9,146087,2,3605,0)="""RTN"",""YTQRQAD4"",289,0)"
^XMB(3.9,146087,2,3606,0)=" S PID=VA(""BID""),PTNAM=VADM(1)"
^XMB(3.9,146087,2,3607,0)="""RTN"",""YTQRQAD4"",290,0)"
^XMB(3.9,146087,2,3608,0)=" S YSNOW=$$NOW^XLFDT"
^XMB(3.9,146087,2,3609,0)="""RTN"",""YTQRQAD4"",291,0)"
^XMB(3.9,146087,2,3610,0)=" S YSDOW=$$DOW^XLFDT(YSNOW)"
^XMB(3.9,146087,2,3611,0)="""RTN"",""YTQRQAD4"",292,0)"
^XMB(3.9,146087,2,3612,0)=" S OFFSET=$S(YSDOW=5:2,YSDOW=6:1,1:0)"
^XMB(3.9,146087,2,3613,0)="""RTN"",""YTQRQAD4"",293,0)"
^XMB(3.9,146087,2,3614,0)=" S YS(""DFN"")=DFN,YS(""COMPLETE"")=""N"""
^XMB(3.9,146087,2,3615,0)="""RTN"",""YTQRQAD4"",294,0)"
^XMB(3.9,146087,2,3616,0)=" D ADMINS^YTQAPI5(.YSDATA,.YS)"
^XMB(3.9,146087,2,3617,0)="""RTN"",""YTQRQAD4"",295,0)"
^XMB(3.9,146087,2,3618,0)=" S I=2 F  S I=$O(YSDATA(I)) Q:'I  D"
^XMB(3.9,146087,2,3619,0)="""RTN"",""YTQRQAD4"",296,0)"
^XMB(3.9,146087,2,3620,0)=" . I $P(YSDATA(I),U,5)'=ORDBY QUIT                    ; not same orderedBy"
^XMB(3.9,146087,2,3621,0)="""RTN"",""YTQRQAD4"",297,0)"
^XMB(3.9,146087,2,3622,0)=" . S YSDTSAV=$P(YSDATA(I),U,4) I 'YSDTSAV QUIT        ; no date, bad entry"
^XMB(3.9,146087,2,3623,0)="""RTN"",""YTQRQAD4"",298,0)"
^XMB(3.9,146087,2,3624,0)=" . S YSRSTRT=$P(YSDATA(I),U,15) S:'YSRSTRT YSRSTRT=2  ; account for weekends"
^XMB(3.9,146087,2,3625,0)="""RTN"",""YTQRQAD4"",299,0)"
^XMB(3.9,146087,2,3626,0)=" . ; always restartable is -1, comparing full 24 hour periods so use seconds"
^XMB(3.9,146087,2,3627,0)="""RTN"",""YTQRQAD4"",300,0)"
^XMB(3.9,146087,2,3628,0)=" . I (YSRSTRT'=-1),$$FMDIFF^XLFDT(YSNOW,YSDTSAV,2)>((YSRSTRT+OFFSET)*86400) Q"
^XMB(3.9,146087,2,3629,0)="""RTN"",""YTQRQAD4"",301,0)"
^XMB(3.9,146087,2,3630,0)=" . S YSADMIN=$P(YSDATA(I),U)                          ; admin ien"
^XMB(3.9,146087,2,3631,0)="""RTN"",""YTQRQAD4"",302,0)"
^XMB(3.9,146087,2,3632,0)=" . S YSINAM=$P(YSDATA(I),U,2)                         ; instrument name"
^XMB(3.9,146087,2,3633,0)="""RTN"",""YTQRQAD4"",303,0)"
^XMB(3.9,146087,2,3634,0)=" . S YSINIEN=$P(YSDATA(I),U,11)                       ; instrument ien"
^XMB(3.9,146087,2,3635,0)="""RTN"",""YTQRQAD4"",304,0)"
^XMB(3.9,146087,2,3636,0)=" . S YSDG=$P(YSDATA(I),U,3)                           ; date given"
^XMB(3.9,146087,2,3637,0)="""RTN"",""YTQRQAD4"",305,0)"
^XMB(3.9,146087,2,3638,0)=" . S YSDG=$P($P($$FMTE^XLFDT(YSDG,5),"":"",1,2),""."")"
^XMB(3.9,146087,2,3639,0)="""RTN"",""YTQRQAD4"",306,0)"
^XMB(3.9,146087,2,3640,0)=" . S YSLOC=$P(YSDATA(I),U,14)"
^XMB(3.9,146087,2,3641,0)="""RTN"",""YTQRQAD4"",307,0)"
^XMB(3.9,146087,2,3642,0)=" . S YSINTRV=$P(YSDATA(I),U,6)"
^XMB(3.9,146087,2,3643,0)="""RTN"",""YTQRQAD4"",308,0)"
^XMB(3.9,146087,2,3644,0)=" . D GETS^DIQ(601.84,YSADMIN_"","",""2;15;17"",""IE"",""YSARR"")"
^XMB(3.9,146087,2,3645,0)="""RTN"",""YTQRQAD4"",309,0)"
^XMB(3.9,146087,2,3646,0)=" . S YSCONS=$G(YSARR(601.84,YSADMIN_"","",17,""I""))"
^XMB(3.9,146087,2,3647,0)="""RTN"",""YTQRQAD4"",310,0)"
^XMB(3.9,146087,2,3648,0)=" . S YSSRC=$G(YSARR(601.84,YSADMIN_"","",15,""E"")) Q:YSSRC=""web""  ;Incomplete MHA admins"
^XMB(3.9,146087,2,3649,0)="""RTN"",""YTQRQAD4"",311,0)"
^XMB(3.9,146087,2,3650,0)=" . S INCMPL(YSADMIN)=YSADMIN_U_YSDG_U_YSDTSAV_U_YSINIEN_U_YSINAM_U_YSRSTRT_U_YSCONS_U_YSLOC_U_YSINTRV_U_YSSRC"
^XMB(3.9,146087,2,3651,0)="""RTN"",""YTQRQAD4"",312,0)"
