^XMB(3.9,146105,2,241,0)="""RTN"",""PRCHNPO1"")"
^XMB(3.9,146105,2,242,0)="0^1^B33193838"
^XMB(3.9,146105,2,243,0)="""RTN"",""PRCHNPO1"",1,0)"
^XMB(3.9,146105,2,244,0)="PRCHNPO1 ;SF-ISC/RSD/RHD-CONT. OF NEW PO ;Jul 10, 2025@14:43"
^XMB(3.9,146105,2,245,0)="""RTN"",""PRCHNPO1"",2,0)"
^XMB(3.9,146105,2,246,0)="V ;;5.1;IFCAP;**16,79,100,108,191,238,246**;Oct 20, 2000;Build 0"
^XMB(3.9,146105,2,247,0)="""RTN"",""PRCHNPO1"",3,0)"
^XMB(3.9,146105,2,248,0)=" ;Per VA Directive 6402, this routine should not be modified."
^XMB(3.9,146105,2,249,0)="""RTN"",""PRCHNPO1"",4,0)"
^XMB(3.9,146105,2,250,0)=" ;"
^XMB(3.9,146105,2,251,0)="""RTN"",""PRCHNPO1"",5,0)"
^XMB(3.9,146105,2,252,0)=" ;            insure ONLY one PP entry is allowed and only able"
^XMB(3.9,146105,2,253,0)="""RTN"",""PRCHNPO1"",6,0)"
^XMB(3.9,146105,2,254,0)=" ;            to allow/edit one entry in what is defined as a"
^XMB(3.9,146105,2,255,0)="""RTN"",""PRCHNPO1"",7,0)"
^XMB(3.9,146105,2,256,0)=" ;            multiple field.  Prompt Pay processing is NO "
^XMB(3.9,146105,2,257,0)="""RTN"",""PRCHNPO1"",8,0)"
^XMB(3.9,146105,2,258,0)=" ;            longer part of the order/del order templates,"
^XMB(3.9,146105,2,259,0)="""RTN"",""PRCHNPO1"",9,0)"
^XMB(3.9,146105,2,260,0)=" ;            but called as new routine PRCHNPOC."
^XMB(3.9,146105,2,261,0)="""RTN"",""PRCHNPO1"",10,0)"
^XMB(3.9,146105,2,262,0)=" ;"
^XMB(3.9,146105,2,263,0)="""RTN"",""PRCHNPO1"",11,0)"
^XMB(3.9,146105,2,264,0)=" ;            FPDS Questions removed PRC*5.1*238"
^XMB(3.9,146105,2,265,0)="""RTN"",""PRCHNPO1"",12,0)"
^XMB(3.9,146105,2,266,0)=" ;"
^XMB(3.9,146105,2,267,0)="""RTN"",""PRCHNPO1"",13,0)"
^XMB(3.9,146105,2,268,0)=" ;Integration agreements"
^XMB(3.9,146105,2,269,0)="""RTN"",""PRCHNPO1"",14,0)"
^XMB(3.9,146105,2,270,0)=" ; ICR #10018      ^DIE        EN+1,E2+2"
^XMB(3.9,146105,2,271,0)="""RTN"",""PRCHNPO1"",15,0)"
^XMB(3.9,146105,2,272,0)=" ; ICR #10056      ^DIC(5      POP+10,POP+16,POP1+4"
^XMB(3.9,146105,2,273,0)="""RTN"",""PRCHNPO1"",16,0)"
^XMB(3.9,146105,2,274,0)=" ;"
^XMB(3.9,146105,2,275,0)="""RTN"",""PRCHNPO1"",17,0)"
^XMB(3.9,146105,2,276,0)="EN I ('$G(PRCHPC)!($G(PRCHPC)=2)),'$G(PRCHPHAM) D"
^XMB(3.9,146105,2,277,0)="""RTN"",""PRCHNPO1"",18,0)"
^XMB(3.9,146105,2,278,0)=" .S PRCH=0,DIE=""^PRC(442,"",DR=""[PRCHDISCNT]"",(D0,DA,DA(1))=PRCHPO D ^DIE    ;PRC*5.1*191 & PRC*5.1*238"
^XMB(3.9,146105,2,279,0)="""RTN"",""PRCHNPO1"",19,0)"
^XMB(3.9,146105,2,280,0)=" . D PPEDIT^PRCHNPOC      ;PRC*5.1*191"
^XMB(3.9,146105,2,281,0)="""RTN"",""PRCHNPO1"",20,0)"
^XMB(3.9,146105,2,282,0)=" F I=1:1 S PRCH=$O(^PRC(442,PRCHPO,3,PRCH)) Q:PRCH=""""!(PRCH'>0)  S PRCHCN=$S($P(^(PRCH,0),U,5)]"""":$P(^(0),U,5),1:"".OM""),PRCHAC=$P(^(0),U,1),PRCHACT=$P(^(0),U,4),PRCHP=$P(^(0),U,2) D SET Q:'$D(PRCHPO)"
^XMB(3.9,146105,2,283,0)="""RTN"",""PRCHNPO1"",21,0)"
^XMB(3.9,146105,2,284,0)=" G ERR^PRCHNPO:'$D(PRCHPO) S $P(^PRC(442,PRCHPO,0),U,14)=$P(^PRC(442,PRCHPO,0),U,14)+I-1,PRCHLCNT=$P(^(0),U,14),Y=$G(^PRC(440,PRCHV,2)),PRCHN(""LSA"")=$P(Y,U,5),PRCHN(""MB"")=$S(PRCHDT:$P(Y,U,3),1:$P(Y,U,6))"
^XMB(3.9,146105,2,285,0)="""RTN"",""PRCHNPO1"",22,0)"
^XMB(3.9,146105,2,286,0)=" S PRCHBO=$S(PRCHDT:1.1,1:1) K PRCHB"
^XMB(3.9,146105,2,287,0)="""RTN"",""PRCHNPO1"",23,0)"
^XMB(3.9,146105,2,288,0)=" S X="""",PRCH="""" F I=0:0 S PRCH=$O(PRCH(""AM"",PRCH)) Q:PRCH=""""  S X=X+$P(PRCH(""AM"",PRCH),U,2)"
^XMB(3.9,146105,2,289,0)="""RTN"",""PRCHNPO1"",24,0)"
^XMB(3.9,146105,2,290,0)=" ;Comment line below for PRC*5.1*79, new FPDS report for Austin"
^XMB(3.9,146105,2,291,0)="""RTN"",""PRCHNPO1"",25,0)"
^XMB(3.9,146105,2,292,0)=" ;G:($G(PRCHPC)!$G(PRCHDELV)) EST"
^XMB(3.9,146105,2,293,0)="""RTN"",""PRCHNPO1"",26,0)"
^XMB(3.9,146105,2,294,0)=" I $G(PRCHPC)=1 G EST ;skip for Simplified PC orders, PRC*5.1*79"
^XMB(3.9,146105,2,295,0)="""RTN"",""PRCHNPO1"",27,0)"
^XMB(3.9,146105,2,296,0)=" I PRCHDT I (X+PRCHEST>25000&(""467B""'[PRCHSC))!(""013""[PRCHSC)!(PRCHN(""MP"")=12)!(PRCHN(""MP"")=5)!(PRCHN(""SFC"")=1) G E2"
^XMB(3.9,146105,2,297,0)="""RTN"",""PRCHNPO1"",28,0)"
^XMB(3.9,146105,2,298,0)=" I $O(^PRC(440,PRCHV,PRCHBO,0)) S PRCHB(0)=""^442.16PA^""_$P(^(0),U,3,4) F I=0:0 S I=$O(^PRC(440,PRCHV,PRCHBO,I)) Q:'I  S:$P(^PRCD(420.6,+I,0),""^"",5)'=""N"" PRCHB(I)=I"
^XMB(3.9,146105,2,299,0)="""RTN"",""PRCHNPO1"",29,0)"
^XMB(3.9,146105,2,300,0)=" I PRCHDT,'$D(PRCHB) D ER3^PRCHNPO6 G ERR^PRCHNPO"
^XMB(3.9,146105,2,301,0)="""RTN"",""PRCHNPO1"",30,0)"
^XMB(3.9,146105,2,302,0)=" D EN6^PRCHNPO2 G ERR^PRCHNPO:'$D(PRCHPO)"
^XMB(3.9,146105,2,303,0)="""RTN"",""PRCHNPO1"",31,0)"
^XMB(3.9,146105,2,304,0)=" ;FPDS coding removed via PRC*5.1*238"
^XMB(3.9,146105,2,305,0)="""RTN"",""PRCHNPO1"",32,0)"
^XMB(3.9,146105,2,306,0)="E2 S DR=""""  ;hnc"
^XMB(3.9,146105,2,307,0)="""RTN"",""PRCHNPO1"",33,0)"
^XMB(3.9,146105,2,308,0)=" S PRCHY=0 I PRCHEST>0,PRCHEC>0 S PRCHY=PRCHEST/PRCHEC,Y=$P(PRCHY,""."",2) I $L(Y)>2 S PRCHY=$P(PRCHY,""."",1)+$J("".""_Y,2,2)"
^XMB(3.9,146105,2,309,0)="""RTN"",""PRCHNPO1"",34,0)"
^XMB(3.9,146105,2,310,0)=" S PRCH=0 F PRCHI=1:1 S PRCH=$O(PRCH(""AM"",PRCH)) Q:PRCH=""""  D TYPE S PRCHAMT=PRCH(""AM"",PRCH),PRCHCN=$S(PRCH="".OM"":"""",1:PRCH),DIE(""NO^"")=""NO"" W ?40,""AMOUNT: "",PRCHAMT S $P(^PRC(442,PRCHPO,0),U,15)=PRCHAMT,PRCHAMT=""""""""_PRCHAMT_"""""""" D ^DIE ;"
^XMB(3.9,146105,2,311,0)="""RTN"",""PRCHNPO1"",35,0)"
^XMB(3.9,146105,2,312,0)=" ;"
^XMB(3.9,146105,2,313,0)="""RTN"",""PRCHNPO1"",36,0)"
^XMB(3.9,146105,2,314,0)="EST G ERR^PRCHNPO:'$D(PRCHPO) I 'PRCHEST,PRCHESTL S $P(^PRC(442,PRCHPO,0),U,18)="""""
^XMB(3.9,146105,2,315,0)="""RTN"",""PRCHNPO1"",37,0)"
^XMB(3.9,146105,2,316,0)=" D EN2^PRCHNPO7 I PRCHEST D EST^PRCHNPO6"
^XMB(3.9,146105,2,317,0)="""RTN"",""PRCHNPO1"",38,0)"
^XMB(3.9,146105,2,318,0)=" I $P($G(^PRC(442,PRCHPO,23)),U,11)="""",PRCHSTAT'=22 S (X,Y)=5,DA=PRCHPO D UPD^PRCHSTAT"
^XMB(3.9,146105,2,319,0)="""RTN"",""PRCHNPO1"",39,0)"
^XMB(3.9,146105,2,320,0)=" I $G(PRCHPC)=2!$G(PRCHDELV) S (D0,DA)=PRCHPO D ^PRCHSF"
^XMB(3.9,146105,2,321,0)="""RTN"",""PRCHNPO1"",40,0)"
^XMB(3.9,146105,2,322,0)=" I '$G(PRCPROST) S %=1,%B="""",%A=""     Review ""_$S($G(PRCHPC):""Purchase Card"",$G(PRCHDELV):""Delivery"",1:""Purchase"")_"" Order "" D ^PRCFYN I %=1 S D0=PRCHPO D ^PRCHDP1"
^XMB(3.9,146105,2,323,0)="""RTN"",""PRCHNPO1"",41,0)"
^XMB(3.9,146105,2,324,0)=" I PRCHSTAT=22 S (D0,DA)=PRCHPO D ^PRCHSF G Q^PRCHNPO4"
^XMB(3.9,146105,2,325,0)="""RTN"",""PRCHNPO1"",42,0)"
^XMB(3.9,146105,2,326,0)=" G ^PRCHNPO4"
^XMB(3.9,146105,2,327,0)="""RTN"",""PRCHNPO1"",43,0)"
^XMB(3.9,146105,2,328,0)=" ;"
^XMB(3.9,146105,2,329,0)="""RTN"",""PRCHNPO1"",44,0)"
^XMB(3.9,146105,2,330,0)="SET G:PRCHAC=""Q"" PCTQ"
^XMB(3.9,146105,2,331,0)="""RTN"",""PRCHNPO1"",45,0)"
^XMB(3.9,146105,2,332,0)=" I PRCHAC["":"" S PRCHAC=$P(PRCHAC,"":"",1)_"":1:""_$P(PRCHAC,"":"",2)"
^XMB(3.9,146105,2,333,0)="""RTN"",""PRCHNPO1"",46,0)"
^XMB(3.9,146105,2,334,0)=" ;"
^XMB(3.9,146105,2,335,0)="""RTN"",""PRCHNPO1"",47,0)"
^XMB(3.9,146105,2,336,0)="PCT S PRCHAMT=0,Y=""F J=""_PRCHAC_"" S PRCHN=J D PCT1 G:$D(PRCHER) Q"" X Y Q:'$D(PRCHPO)"
^XMB(3.9,146105,2,337,0)="""RTN"",""PRCHNPO1"",48,0)"
^XMB(3.9,146105,2,338,0)=" S PRCHAMT=PRCHAMT*100+.5\1/100,$P(PRCH(""AM"",PRCHCN),U,2)=$P(PRCH(""AM"",PRCHCN),U,2)-PRCHAMT"
^XMB(3.9,146105,2,339,0)="""RTN"",""PRCHNPO1"",49,0)"
^XMB(3.9,146105,2,340,0)=" S $P(^PRC(442,PRCHPO,3,PRCH,0),U,3)=PRCHAMT,$P(^(0),U,6)=I+PRCHLCNT"
^XMB(3.9,146105,2,341,0)="""RTN"",""PRCHNPO1"",50,0)"
^XMB(3.9,146105,2,342,0)=" Q"
^XMB(3.9,146105,2,343,0)="""RTN"",""PRCHNPO1"",51,0)"
^XMB(3.9,146105,2,344,0)=" ;"
^XMB(3.9,146105,2,345,0)="""RTN"",""PRCHNPO1"",52,0)"
^XMB(3.9,146105,2,346,0)="PCT1 I $D(^PRC(442,PRCHPO,2,""B"",PRCHN)) S GTFLAG="""" D  G:GTFLAG=1 ER^PRCHNPO6 G:GTFLAG=2 ER1^PRCHNPO6"
^XMB(3.9,146105,2,347,0)="""RTN"",""PRCHNPO1"",53,0)"
^XMB(3.9,146105,2,348,0)=" .S PRCHN=$O(^PRC(442,PRCHPO,2,""B"",PRCHN,0)),PRCHD=+$P($G(^PRC(442,PRCHPO,2,PRCHN,2)),U,1) I PRCHD'>0 S GTFLAG=1 Q"
^XMB(3.9,146105,2,349,0)="""RTN"",""PRCHNPO1"",54,0)"
^XMB(3.9,146105,2,350,0)=" .I $S(PRCHCN="".OM""&($P(^(2),U,2)=""""):0,PRCHCN=$P(^(2),U,2):0,1:1) S GTFLAG=2 Q"
^XMB(3.9,146105,2,351,0)="""RTN"",""PRCHNPO1"",55,0)"
^XMB(3.9,146105,2,352,0)=" .S PRCHDA=0"
^XMB(3.9,146105,2,353,0)="""RTN"",""PRCHNPO1"",56,0)"
^XMB(3.9,146105,2,354,0)=" .I $E(PRCHP,1)=""$"" S PRCHDA=$P(PRCHP,""$"",2)/PRCHACT"
^XMB(3.9,146105,2,355,0)="""RTN"",""PRCHNPO1"",57,0)"
^XMB(3.9,146105,2,356,0)=" .E  S PRCHDA=$J(PRCHD*(PRCHP/100),0,2)"
^XMB(3.9,146105,2,357,0)="""RTN"",""PRCHNPO1"",58,0)"
^XMB(3.9,146105,2,358,0)=" .S PRCHAMT=PRCHAMT+PRCHDA,$P(^PRC(442,PRCHPO,2,PRCHN,2),U,6)=PRCHDA"
^XMB(3.9,146105,2,359,0)="""RTN"",""PRCHNPO1"",59,0)"
^XMB(3.9,146105,2,360,0)=" Q"
^XMB(3.9,146105,2,361,0)="""RTN"",""PRCHNPO1"",60,0)"
^XMB(3.9,146105,2,362,0)=" ;"
^XMB(3.9,146105,2,363,0)="""RTN"",""PRCHNPO1"",61,0)"
^XMB(3.9,146105,2,364,0)="PCTQ S (PRCHAMT,PRCHCN,PRCHX)=0,PRCHACT=PRCHLCNT F K=0:0 S PRCHCN=$O(PRCH(""AM"",PRCHCN)) Q:PRCHCN=""""  S PRCHAC=$E($P(PRCH(""AM"",PRCHCN),U,3),1,$L($P(PRCH(""AM"",PRCHCN),U,3))-1) D PCT Q:'$D(PRCHPO)  S PRCHX=PRCHX+PRCHAMT"
^XMB(3.9,146105,2,365,0)="""RTN"",""PRCHNPO1"",62,0)"
^XMB(3.9,146105,2,366,0)=" Q:'$D(PRCHPO)  S $P(^PRC(442,PRCHPO,3,PRCH,0),U,3)=PRCHX"
^XMB(3.9,146105,2,367,0)="""RTN"",""PRCHNPO1"",63,0)"
^XMB(3.9,146105,2,368,0)=" Q"
^XMB(3.9,146105,2,369,0)="""RTN"",""PRCHNPO1"",64,0)"
^XMB(3.9,146105,2,370,0)=" ;"
^XMB(3.9,146105,2,371,0)="""RTN"",""PRCHNPO1"",65,0)"
^XMB(3.9,146105,2,372,0)="POP ;Set up place of performance for PRC*5.1*79, new FPDS. If station is the"
^XMB(3.9,146105,2,373,0)="""RTN"",""PRCHNPO1"",66,0)"
^XMB(3.9,146105,2,374,0)=" ;place of perf. for PO, send the state abbrev. and zip code, otherwise"
^XMB(3.9,146105,2,375,0)="""RTN"",""PRCHNPO1"",67,0)"
^XMB(3.9,146105,2,376,0)=" ;send the vendor's state and zip code. Applies to all Delivery POs."
^XMB(3.9,146105,2,377,0)="""RTN"",""PRCHNPO1"",68,0)"
^XMB(3.9,146105,2,378,0)=" ;For Guaranteed Delivery orders, we have to choose the VAMC since users"
^XMB(3.9,146105,2,379,0)="""RTN"",""PRCHNPO1"",69,0)"
^XMB(3.9,146105,2,380,0)=" ;are not asked for a SHIP TO location - PRC*5.1*100."
^XMB(3.9,146105,2,381,0)="""RTN"",""PRCHNPO1"",70,0)"
^XMB(3.9,146105,2,382,0)=" N PRCST,PRCSTL,PRCSZP,PRCPOP,PRCLOC,PRCROOT,PRCVAMC"
^XMB(3.9,146105,2,383,0)="""RTN"",""PRCHNPO1"",71,0)"
^XMB(3.9,146105,2,384,0)=" I $P(^PRC(442,PRCHPO,25),""^"",15)=""Y"" D"
^XMB(3.9,146105,2,385,0)="""RTN"",""PRCHNPO1"",72,0)"
^XMB(3.9,146105,2,386,0)=" . I $P(^PRC(442,PRCHPO,0),""^"",2)=4 D POP1 Q"
^XMB(3.9,146105,2,387,0)="""RTN"",""PRCHNPO1"",73,0)"
^XMB(3.9,146105,2,388,0)=" . S PRCLOC=$P(^PRC(442,PRCHPO,1),U,3) ;ship to location"
^XMB(3.9,146105,2,389,0)="""RTN"",""PRCHNPO1"",74,0)"
^XMB(3.9,146105,2,390,0)=" . S PRCST=$P(^PRC(411,PRC(""SITE""),1,PRCLOC,0),""^"",6)  ;station's state"
^XMB(3.9,146105,2,391,0)="""RTN"",""PRCHNPO1"",75,0)"
^XMB(3.9,146105,2,392,0)=" . S PRCSTL=$P(^DIC(5,PRCST,0),""^"",2)"
^XMB(3.9,146105,2,393,0)="""RTN"",""PRCHNPO1"",76,0)"
^XMB(3.9,146105,2,394,0)=" . S PRCSZP=$P(^PRC(411,PRC(""SITE""),1,PRCLOC,0),""^"",7) ;station's zip"
^XMB(3.9,146105,2,395,0)="""RTN"",""PRCHNPO1"",77,0)"
^XMB(3.9,146105,2,396,0)=" . S PRCPOP=PRCSTL_PRCSZP,$P(^PRC(442,PRCHPO,25),""^"",16)=PRCPOP"
^XMB(3.9,146105,2,397,0)="""RTN"",""PRCHNPO1"",78,0)"
^XMB(3.9,146105,2,398,0)=" . Q"
^XMB(3.9,146105,2,399,0)="""RTN"",""PRCHNPO1"",79,0)"
^XMB(3.9,146105,2,400,0)=" I $P(^PRC(442,PRCHPO,25),""^"",15)=""N"" D"
^XMB(3.9,146105,2,401,0)="""RTN"",""PRCHNPO1"",80,0)"
^XMB(3.9,146105,2,402,0)=" . S PRCST=$P(^PRC(440,PRCHV,0),""^"",7) ;vendor's state"
^XMB(3.9,146105,2,403,0)="""RTN"",""PRCHNPO1"",81,0)"
^XMB(3.9,146105,2,404,0)=" . S PRCSTL=$P(^DIC(5,PRCST,0),""^"",2)"
^XMB(3.9,146105,2,405,0)="""RTN"",""PRCHNPO1"",82,0)"
^XMB(3.9,146105,2,406,0)=" . S PRCSZP=$E($P(^PRC(440,PRCHV,0),""^"",8),1,5) ;vendor's zip"
^XMB(3.9,146105,2,407,0)="""RTN"",""PRCHNPO1"",83,0)"
^XMB(3.9,146105,2,408,0)=" . S PRCPOP=PRCSTL_PRCSZP,$P(^PRC(442,PRCHPO,25),""^"",16)=PRCPOP"
^XMB(3.9,146105,2,409,0)="""RTN"",""PRCHNPO1"",84,0)"
^XMB(3.9,146105,2,410,0)=" Q"
^XMB(3.9,146105,2,411,0)="""RTN"",""PRCHNPO1"",85,0)"
^XMB(3.9,146105,2,412,0)=" ;"
^XMB(3.9,146105,2,413,0)="""RTN"",""PRCHNPO1"",86,0)"
^XMB(3.9,146105,2,414,0)="POP1 ;Set up for Guaranteed Delivery orders - users are not asked for a SHIP"
^XMB(3.9,146105,2,415,0)="""RTN"",""PRCHNPO1"",87,0)"
^XMB(3.9,146105,2,416,0)=" ;TO location during PO creation - PRC*5.1*100."
^XMB(3.9,146105,2,417,0)="""RTN"",""PRCHNPO1"",88,0)"
^XMB(3.9,146105,2,418,0)=" S PRCROOT=$G(^PRC(411,PRC(""SITE""),0)),PRCVAMC=$G(^(3)) ; local VAMC"
^XMB(3.9,146105,2,419,0)="""RTN"",""PRCHNPO1"",89,0)"
^XMB(3.9,146105,2,420,0)=" S PRCST=$P(PRCVAMC,""^"",4)"
^XMB(3.9,146105,2,421,0)="""RTN"",""PRCHNPO1"",90,0)"
^XMB(3.9,146105,2,422,0)=" S PRCSTL=$P(^DIC(5,PRCST,0),""^"",2) ;station's state"
^XMB(3.9,146105,2,423,0)="""RTN"",""PRCHNPO1"",91,0)"
^XMB(3.9,146105,2,424,0)=" S PRCSZP=$E($P(PRCVAMC,""^"",5),1,5) ;station's zip"
^XMB(3.9,146105,2,425,0)="""RTN"",""PRCHNPO1"",92,0)"
^XMB(3.9,146105,2,426,0)=" S PRCPOP=PRCSTL_PRCSZP,$P(^PRC(442,PRCHPO,25),""^"",16)=PRCPOP"
^XMB(3.9,146105,2,427,0)="""RTN"",""PRCHNPO1"",93,0)"
^XMB(3.9,146105,2,428,0)=" Q"
^XMB(3.9,146105,2,429,0)="""RTN"",""PRCHNPO1"",94,0)"
^XMB(3.9,146105,2,430,0)=" ;"
^XMB(3.9,146105,2,431,0)="""RTN"",""PRCHNPO1"",95,0)"
^XMB(3.9,146105,2,432,0)="TYPE I PRCHI=PRCHEC,PRCHEST'=(PRCHY*PRCHEC) S PRCHY=PRCHY+(PRCHEST-(PRCHY*PRCHEC))"
^XMB(3.9,146105,2,433,0)="""RTN"",""PRCHNPO1"",96,0)"
^XMB(3.9,146105,2,434,0)=" I PRCHY>0 S PRCH(""AM"",PRCH)=$P(PRCH(""AM"",PRCH),U,1)_U_($P(PRCH(""AM"",PRCH),U,2)+PRCHY)_U_$P(PRCH(""AM"",PRCH),U,3)"
^XMB(3.9,146105,2,435,0)="""RTN"",""PRCHNPO1"",97,0)"
^XMB(3.9,146105,2,436,0)=" S PRCHX=$P(PRCH(""AM"",PRCH),U,3),K=0"
^XMB(3.9,146105,2,437,0)="""RTN"",""PRCHNPO1"",98,0)"
^XMB(3.9,146105,2,438,0)=" I PRCHX]"""" W !?1,""ITEM: "" W:PRCHX'["":1:"" PRCHX I PRCHX["":1:"" F J=0:0 S PRCHX=$P(PRCHX,"":1:"",1)_"":""_$P(PRCHX,"":1:"",2,99) I PRCHX'["":1:"" W PRCHX Q"
^XMB(3.9,146105,2,439,0)="""RTN"",""PRCHNPO1"",99,0)"
^XMB(3.9,146105,2,440,0)=" S:$P(PRCH(""AM"",PRCH),U,2)]"""" PRCH(""AM"",PRCH)=$P(PRCH(""AM"",PRCH),U,2)"
^XMB(3.9,146105,2,441,0)="""RTN"",""PRCHNPO1"",100,0)"
^XMB(3.9,146105,2,442,0)=" Q"
^XMB(3.9,146105,2,443,0)="""RTN"",""PRCHNPO1"",101,0)"
^XMB(3.9,146105,2,444,0)="Q I $D(PRCHPO) L -^PRC(442,PRCHPO)"
^XMB(3.9,146105,2,445,0)="""RTN"",""PRCHNPO1"",102,0)"
^XMB(3.9,146105,2,446,0)=" K PRCH,PRCHAC,PRCHACT,PRCHAM,PRCHAMT,PRCHB,PRCHBO,PRCHCN,PRCHCNT,PRCHD,PRCHDA,PRCHDT,PRCHEC,PRCHER,PRCHES,PRCHEST,PRCHFPDS,PRCHI,PRCHL0,PRCHL1,PRCHL2,PRCHL3,PRCHLCNT,PRCHLI"
^XMB(3.9,146105,2,447,0)="""RTN"",""PRCHNPO1"",103,0)"
^XMB(3.9,146105,2,448,0)=" K PRCHN,PRCHP,PRCHPO,PRCHSC,PRCHV,PRCHX,PRCHY,DIC,DIE,DR,D0,DA,X,Y"
^XMB(3.9,146105,2,449,0)="""RTN"",""PRCHNPO1"",104,0)"
^XMB(3.9,146105,2,450,0)=" Q"
^XMB(3.9,146105,2,451,0)="""VER"")"
