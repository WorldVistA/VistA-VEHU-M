^XMB(3.9,146047,2,2691,0)="""RTN"",""IBCNEUT2"",143,0)"
^XMB(3.9,146047,2,2692,0)=" ; ***********************"
^XMB(3.9,146047,2,2693,0)="""RTN"",""IBCNEUT2"",144,0)"
^XMB(3.9,146047,2,2694,0)=" ; DO NOT change this code without careful consideration !!!"
^XMB(3.9,146047,2,2695,0)="""RTN"",""IBCNEUT2"",145,0)"
^XMB(3.9,146047,2,2696,0)=" ; It is called by IBCNEHL5A to Auto-load policies as eIV Responses are processed"
^XMB(3.9,146047,2,2697,0)="""RTN"",""IBCNEUT2"",146,0)"
^XMB(3.9,146047,2,2698,0)=" ; Also, it is called by IBCNES for the ELIG. Benefits (from both file #2 and #365 perspectives)"
^XMB(3.9,146047,2,2699,0)="""RTN"",""IBCNEUT2"",147,0)"
^XMB(3.9,146047,2,2700,0)=" ; ***********************"
^XMB(3.9,146047,2,2701,0)="""RTN"",""IBCNEUT2"",148,0)"
^XMB(3.9,146047,2,2702,0)=" ;"
^XMB(3.9,146047,2,2703,0)="""RTN"",""IBCNEUT2"",149,0)"
^XMB(3.9,146047,2,2704,0)=" ; Example:"
^XMB(3.9,146047,2,2705,0)="""RTN"",""IBCNEUT2"",150,0)"
^XMB(3.9,146047,2,2706,0)=" ; Insurance Type: Medicare Part A Elig/Ben Info: Active Coverage"
^XMB(3.9,146047,2,2707,0)="""RTN"",""IBCNEUT2"",151,0)"
^XMB(3.9,146047,2,2708,0)=" ; Date/Time Qual: Plan D/T Period: 05/01/2019 "
^XMB(3.9,146047,2,2709,0)="""RTN"",""IBCNEUT2"",152,0)"
^XMB(3.9,146047,2,2710,0)=" ;"
^XMB(3.9,146047,2,2711,0)="""RTN"",""IBCNEUT2"",153,0)"
^XMB(3.9,146047,2,2712,0)=" ; Returns ARRAY(EBCNT,""Medicare Part A"")=DFN^""Medicare Part A""^3190501^SOI^""Active Coverage"""
^XMB(3.9,146047,2,2713,0)="""RTN"",""IBCNEUT2"",154,0)"
^XMB(3.9,146047,2,2714,0)=" ; - if Other Potential Insurance - ARRAY(""OHI)=1"
^XMB(3.9,146047,2,2715,0)="""RTN"",""IBCNEUT2"",155,0)"
^XMB(3.9,146047,2,2716,0)=" ; - if the Effective Date for an Active policy is missing - ARRAY(""MISSING_EFFDT"")=1"
^XMB(3.9,146047,2,2717,0)="""RTN"",""IBCNEUT2"",156,0)"
^XMB(3.9,146047,2,2718,0)=" ;"
^XMB(3.9,146047,2,2719,0)="""RTN"",""IBCNEUT2"",157,0)"
^XMB(3.9,146047,2,2720,0)=" ; How to determine effective date:"
^XMB(3.9,146047,2,2721,0)="""RTN"",""IBCNEUT2"",158,0)"
^XMB(3.9,146047,2,2722,0)=" ;   1st attempt to pull from EB loop "
^XMB(3.9,146047,2,2723,0)="""RTN"",""IBCNEUT2"",159,0)"
^XMB(3.9,146047,2,2724,0)=" ;      Loop must have:(INSTYP'="""") & ELGBENINFO=""Active Coverage"" or ""Inactive"""
^XMB(3.9,146047,2,2725,0)="""RTN"",""IBCNEUT2"",160,0)"
^XMB(3.9,146047,2,2726,0)=" ;        If Medicare pull the 1st date where qualifier = ""PLAN"""
^XMB(3.9,146047,2,2727,0)="""RTN"",""IBCNEUT2"",161,0)"
^XMB(3.9,146047,2,2728,0)=" ;        If not Medicare pull 1st date where qualifier =""PLAN"" or ""PLAN BEGIN"""
^XMB(3.9,146047,2,2729,0)="""RTN"",""IBCNEUT2"",162,0)"
^XMB(3.9,146047,2,2730,0)=" ;           check all dates as ""PLAN BEGIN"" trumps ""PLAN"""
^XMB(3.9,146047,2,2731,0)="""RTN"",""IBCNEUT2"",163,0)"
^XMB(3.9,146047,2,2732,0)=" ;   if no eff dt then continue other attempts"
^XMB(3.9,146047,2,2733,0)="""RTN"",""IBCNEUT2"",164,0)"
^XMB(3.9,146047,2,2734,0)=" ;      2nd attempt - If not Medicare pull from Subscriber dates (#365.28,.02)"
^XMB(3.9,146047,2,2735,0)="""RTN"",""IBCNEUT2"",165,0)"
^XMB(3.9,146047,2,2736,0)=" ;         pull 1st date where qualifier =""PLAN"" or ""PLAN BEGIN"""
^XMB(3.9,146047,2,2737,0)="""RTN"",""IBCNEUT2"",166,0)"
^XMB(3.9,146047,2,2738,0)=" ;           check all dates as ""PLAN BEGIN"" trumps ""PLAN"""
^XMB(3.9,146047,2,2739,0)="""RTN"",""IBCNEUT2"",167,0)"
^XMB(3.9,146047,2,2740,0)=" ;   if no eff dt then continue other attempts"
^XMB(3.9,146047,2,2741,0)="""RTN"",""IBCNEUT2"",168,0)"
^XMB(3.9,146047,2,2742,0)=" ;      LAST attempt - pull from Effective date (#365,1.11)"
^XMB(3.9,146047,2,2743,0)="""RTN"",""IBCNEUT2"",169,0)"
^XMB(3.9,146047,2,2744,0)=" ;        applies to both Medicare and non Medicare"
^XMB(3.9,146047,2,2745,0)="""RTN"",""IBCNEUT2"",170,0)"
^XMB(3.9,146047,2,2746,0)=" ;   Otherwise effective date is ""Unknown"""
^XMB(3.9,146047,2,2747,0)="""RTN"",""IBCNEUT2"",171,0)"
^XMB(3.9,146047,2,2748,0)=" ;"
^XMB(3.9,146047,2,2749,0)="""RTN"",""IBCNEUT2"",172,0)"
^XMB(3.9,146047,2,2750,0)=" ;"
^XMB(3.9,146047,2,2751,0)="""RTN"",""IBCNEUT2"",173,0)"
^XMB(3.9,146047,2,2752,0)=" N DTQUAL,EBCNT,ELGBENINFO,EXTELIG,FSCSTAT,HLDT,HLDNDT"
^XMB(3.9,146047,2,2753,0)="""RTN"",""IBCNEUT2"",174,0)"
^XMB(3.9,146047,2,2754,0)=" N IBA,IBBERR,IBCHK,IBEFFDT,IBEINFO,IBELGINF,IBNOTCOV,IBNOTDT,IBNOTTYP,IBPEDT,IBSPDT,IBSUSCT"
^XMB(3.9,146047,2,2755,0)="""RTN"",""IBCNEUT2"",175,0)"
^XMB(3.9,146047,2,2756,0)=" N IBVIENS,INSTYP,MWNRTYP,TMP,XXDT,ZIEN"
