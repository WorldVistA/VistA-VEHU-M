^XMB(3.9,146019,2,628,0)=" ..I $G(AVAILABILITY(""TIMESLOT"",TIMESLOTCNT,""NUMBER OF SLOTS"",CNT))=""@"" Q"
^XMB(3.9,146019,2,629,0)="""RTN"",""SDES2CRTCLNAVAL2"",195,0)"
