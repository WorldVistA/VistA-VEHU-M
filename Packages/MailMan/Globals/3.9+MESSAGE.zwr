^XMB(3.9,146036,2,2036,0)=" S DVBARTN=$NA(^TMP(""DVBASSNVAR"",$J))"
^XMB(3.9,146036,2,2037,0)="""RTN"",""DVBCTXM2"",39,0)"
^XMB(3.9,146036,2,2038,0)=" D GETLST^XPAR(DVBARTN,""PKG"",""DVBAB CAPRI CMT SSN VAR"",""Q"",.DVBAERROR,1)"
^XMB(3.9,146036,2,2039,0)="""RTN"",""DVBCTXM2"",40,0)"
