^XMB(3.9,146104,2,388,0)=" ; IB*2.0*549 - PUR^IBCNHUT2 also checks to make sure the HL7 link is still up and"
^XMB(3.9,146104,2,389,0)="""RTN"",""IBAMTC"",77,0)"
^XMB(3.9,146104,2,390,0)=" ;              running properly"
