^XMB(3.9,146090,2,746,0)="RXLKP(RXNUM) ; - Peforms Lookup on the PRESCRIPTION file"
^XMB(3.9,146090,2,747,0)="""RTN"",""PSOSPML4"",254,0)"
^XMB(3.9,146090,2,748,0)=" N DIC,X,Y,D"
