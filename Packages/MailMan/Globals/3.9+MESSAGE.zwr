^XMB(3.9,146052,2,2387,0)="""RTN"",""FBSHRAD"",141,0)"
^XMB(3.9,146052,2,2388,0)=" . . I $Y+5>IOSL D HD Q:FBQUIT  D HDPOV,HDVEN"
^XMB(3.9,146052,2,2389,0)="""RTN"",""FBSHRAD"",142,0)"
^XMB(3.9,146052,2,2390,0)=" . . W !,?32,""----"""
^XMB(3.9,146052,2,2391,0)="""RTN"",""FBSHRAD"",143,0)"
^XMB(3.9,146052,2,2392,0)=" . . W:FBDD ?47,""----"""
^XMB(3.9,146052,2,2393,0)="""RTN"",""FBSHRAD"",144,0)"
^XMB(3.9,146052,2,2394,0)=" . . W !,""  Vendor Subtotal:"",?25,""Count: "",$J(FBC(""VEN""),4)"
^XMB(3.9,146052,2,2395,0)="""RTN"",""FBSHRAD"",145,0)"
^XMB(3.9,146052,2,2396,0)=" . . W:FBDD ?41,""Days: "",$J(FBD(""VEN""),4)"
^XMB(3.9,146052,2,2397,0)="""RTN"",""FBSHRAD"",146,0)"
^XMB(3.9,146052,2,2398,0)=" . Q:FBQUIT"
^XMB(3.9,146052,2,2399,0)="""RTN"",""FBSHRAD"",147,0)"
^XMB(3.9,146052,2,2400,0)=" . S FBC(""TOT"")=FBC(""TOT"")+FBC(""POV"")"
^XMB(3.9,146052,2,2401,0)="""RTN"",""FBSHRAD"",148,0)"
^XMB(3.9,146052,2,2402,0)=" . I $Y+5>IOSL D HD Q:FBQUIT  D HDPOV"
^XMB(3.9,146052,2,2403,0)="""RTN"",""FBSHRAD"",149,0)"
^XMB(3.9,146052,2,2404,0)=" . W !,?32,""===="""
^XMB(3.9,146052,2,2405,0)="""RTN"",""FBSHRAD"",150,0)"
^XMB(3.9,146052,2,2406,0)=" . W:FBDD ?47,""===="""
^XMB(3.9,146052,2,2407,0)="""RTN"",""FBSHRAD"",151,0)"
^XMB(3.9,146052,2,2408,0)=" . W !,""POV Subtotal: "",?25,""Count: "",$J(FBC(""POV""),4)"
^XMB(3.9,146052,2,2409,0)="""RTN"",""FBSHRAD"",152,0)"
^XMB(3.9,146052,2,2410,0)=" . W:FBDD ?41,""Days: "",$J(FBD(""POV""),4)"
^XMB(3.9,146052,2,2411,0)="""RTN"",""FBSHRAD"",153,0)"
^XMB(3.9,146052,2,2412,0)=" . ;W !,FBC,"" Authorization"",$S(FBC=1:"""",1:""s""),"" for POV: "",FBPOV(""E"")"
^XMB(3.9,146052,2,2413,0)="""RTN"",""FBSHRAD"",154,0)"
