^XMB(3.9,146082,2,225,0)="""QUES"",""XPZ2"",0)"
^XMB(3.9,146082,2,226,0)="Y"
^XMB(3.9,146082,2,227,0)="""QUES"",""XPZ2"",""??"")"
^XMB(3.9,146082,2,228,0)="^D RTN^XPDH"
^XMB(3.9,146082,2,229,0)="""QUES"",""XPZ2"",""A"")"
^XMB(3.9,146082,2,230,0)="Want to MOVE routines to other CPUs"
^XMB(3.9,146082,2,231,0)="""QUES"",""XPZ2"",""B"")"
