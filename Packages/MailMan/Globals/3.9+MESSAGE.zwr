^XMB(3.9,146009,2,1174,0)=" S RETURN=0"
^XMB(3.9,146009,2,1175,0)="""RTN"",""XUMVINPB"",249,0)"
^XMB(3.9,146009,2,1176,0)=" S FILE=200,FLDS=""7;9.2;201"" ;disuser; termination date; primary menu option"
^XMB(3.9,146009,2,1177,0)="""RTN"",""XUMVINPB"",250,0)"
^XMB(3.9,146009,2,1178,0)=" D GETS^DIQ(FILE,+XUDUZ_"","",FLDS,""EI"",""XUARR"") ;retrieve data"
