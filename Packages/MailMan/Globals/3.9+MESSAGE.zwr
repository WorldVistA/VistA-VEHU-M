^XMB(3.9,146039,2,3348,0)=" S APPTSTARTTIME=$$GET1^DIQ(409.84,APPTIEN,.01,""I"")"
^XMB(3.9,146039,2,3349,0)="""RTN"",""SDES2UNDOCHKOUT"",59,0)"
^XMB(3.9,146039,2,3350,0)=" S DFN=$$GET1^DIQ(409.84,APPTIEN,.05,""I"")"
^XMB(3.9,146039,2,3351,0)="""RTN"",""SDES2UNDOCHKOUT"",60,0)"
^XMB(3.9,146039,2,3352,0)=" S RESOURCEIEN=$$GET1^DIQ(409.84,APPTIEN,.07,""I"")"
