^XMB(3.9,146098,2,643,0)="""RTN"",""SDES2APTLETTER"")"
^XMB(3.9,146098,2,644,0)="0^3^B135335854"
^XMB(3.9,146098,2,645,0)="""RTN"",""SDES2APTLETTER"",1,0)"
^XMB(3.9,146098,2,646,0)="SDES2APTLETTER ;ALB/TJB,TJB,TJB,MCB,JHC,TJB,TJB - VISTA SCHEDULING RPCS - LETTER PRINT ; OCT 20, 2025"
^XMB(3.9,146098,2,647,0)="""RTN"",""SDES2APTLETTER"",2,0)"
^XMB(3.9,146098,2,648,0)=" ;;5.3;Scheduling;**895,898,899,901,903,922,909**;Aug 13, 1993;Build 0"
^XMB(3.9,146098,2,649,0)="""RTN"",""SDES2APTLETTER"",3,0)"
^XMB(3.9,146098,2,650,0)=" ;;Per VHA Directive 6402, this routine should not be modified"
^XMB(3.9,146098,2,651,0)="""RTN"",""SDES2APTLETTER"",4,0)"
^XMB(3.9,146098,2,652,0)=" ;"
^XMB(3.9,146098,2,653,0)="""RTN"",""SDES2APTLETTER"",5,0)"
^XMB(3.9,146098,2,654,0)=" ; Reference to DIVISION in ICR #7024"
^XMB(3.9,146098,2,655,0)="""RTN"",""SDES2APTLETTER"",6,0)"
^XMB(3.9,146098,2,656,0)=" ; Reference to PATIENT in ICR #7025"
^XMB(3.9,146098,2,657,0)="""RTN"",""SDES2APTLETTER"",7,0)"
^XMB(3.9,146098,2,658,0)=" ; SDES2 PRINT APPT LETTER"
^XMB(3.9,146098,2,659,0)="""RTN"",""SDES2APTLETTER"",8,0)"
^XMB(3.9,146098,2,660,0)=" ;"
^XMB(3.9,146098,2,661,0)="""RTN"",""SDES2APTLETTER"",9,0)"
^XMB(3.9,146098,2,662,0)=" ; Reference to DUZ^XUP is supported by IA #7487"
^XMB(3.9,146098,2,663,0)="""RTN"",""SDES2APTLETTER"",10,0)"
^XMB(3.9,146098,2,664,0)=" Q"
^XMB(3.9,146098,2,665,0)="""RTN"",""SDES2APTLETTER"",11,0)"
^XMB(3.9,146098,2,666,0)=" ; print single letter"
^XMB(3.9,146098,2,667,0)="""RTN"",""SDES2APTLETTER"",12,0)"
^XMB(3.9,146098,2,668,0)=" ; SDINPUT(""Appointment IEN"")=IEN of the Appointment from file 409.84"
^XMB(3.9,146098,2,669,0)="""RTN"",""SDES2APTLETTER"",13,0)"
^XMB(3.9,146098,2,670,0)=" ; SDINPUT(""Letter Type"")=Letter type - ""N""=No Show; ""P""=Pre-Appointment; ""A""=Cancelled by Patient; ""C""=Cancelled by Clinic"
^XMB(3.9,146098,2,671,0)="""RTN"",""SDES2APTLETTER"",14,0)"
^XMB(3.9,146098,2,672,0)="PRINTLETTER(RESULTS,SDCONTEXT,SDINPUT) ;"
^XMB(3.9,146098,2,673,0)="""RTN"",""SDES2APTLETTER"",15,0)"
^XMB(3.9,146098,2,674,0)=" N APPTLIST,APPTIEN,ERRORS,GBL,LETTERS,LINE,LCNT,LETIEN,LTYPE"
^XMB(3.9,146098,2,675,0)="""RTN"",""SDES2APTLETTER"",16,0)"
^XMB(3.9,146098,2,676,0)=" N %H,%,%T,%Y ; To clear leaking variables from called routines"
^XMB(3.9,146098,2,677,0)="""RTN"",""SDES2APTLETTER"",17,0)"
^XMB(3.9,146098,2,678,0)=" S APPTIEN=$G(SDINPUT(""Appointment IEN"")),LTYPE=$G(SDINPUT(""Letter Type""))"
^XMB(3.9,146098,2,679,0)="""RTN"",""SDES2APTLETTER"",18,0)"
^XMB(3.9,146098,2,680,0)=" ; validate context array"
^XMB(3.9,146098,2,681,0)="""RTN"",""SDES2APTLETTER"",19,0)"
^XMB(3.9,146098,2,682,0)=" D VALCONTEXT^SDES2VALCONTEXT(.ERRORS,.SDCONTEXT)"
^XMB(3.9,146098,2,683,0)="""RTN"",""SDES2APTLETTER"",20,0)"
^XMB(3.9,146098,2,684,0)=" I $D(ERRORS) S ERRORS(""letters"",1)="""" D BUILDJSON^SDES2JSON(.RESULTS,.ERRORS) Q"
^XMB(3.9,146098,2,685,0)="""RTN"",""SDES2APTLETTER"",21,0)"
^XMB(3.9,146098,2,686,0)=" I $G(SDCONTEXT(""USER DUZ""))'="""" N DUZ D DUZ^XUP(SDCONTEXT(""USER DUZ""))"
^XMB(3.9,146098,2,687,0)="""RTN"",""SDES2APTLETTER"",22,0)"
^XMB(3.9,146098,2,688,0)=" S LETIEN=$$VALLETTYPE(.ERRORS,LTYPE)"
^XMB(3.9,146098,2,689,0)="""RTN"",""SDES2APTLETTER"",23,0)"
^XMB(3.9,146098,2,690,0)=" D VALAPPT(.ERRORS,APPTIEN,LTYPE)"
^XMB(3.9,146098,2,691,0)="""RTN"",""SDES2APTLETTER"",24,0)"
^XMB(3.9,146098,2,692,0)=" I $D(ERRORS) D  Q"
^XMB(3.9,146098,2,693,0)="""RTN"",""SDES2APTLETTER"",25,0)"
^XMB(3.9,146098,2,694,0)=" . S ERRORS(""letters"",1)="""""
^XMB(3.9,146098,2,695,0)="""RTN"",""SDES2APTLETTER"",26,0)"
^XMB(3.9,146098,2,696,0)=" . D BUILDJSON^SDES2JSON(.RESULTS,.ERRORS)"
^XMB(3.9,146098,2,697,0)="""RTN"",""SDES2APTLETTER"",27,0)"
^XMB(3.9,146098,2,698,0)=" D APPTLETTER(.GBL,APPTIEN,LTYPE)"
^XMB(3.9,146098,2,699,0)="""RTN"",""SDES2APTLETTER"",28,0)"
^XMB(3.9,146098,2,700,0)=" M LETTERS(""letters"",1)=@GBL"
^XMB(3.9,146098,2,701,0)="""RTN"",""SDES2APTLETTER"",29,0)"
^XMB(3.9,146098,2,702,0)=" S LETTERS(""letters"",1,""appointmentID"")=APPTIEN"
^XMB(3.9,146098,2,703,0)="""RTN"",""SDES2APTLETTER"",30,0)"
^XMB(3.9,146098,2,704,0)=" I $D(ERRORS) M LETTERS=ERRORS"
^XMB(3.9,146098,2,705,0)="""RTN"",""SDES2APTLETTER"",31,0)"
^XMB(3.9,146098,2,706,0)=" D BUILDJSON^SDES2JSON(.RESULTS,.LETTERS)"
^XMB(3.9,146098,2,707,0)="""RTN"",""SDES2APTLETTER"",32,0)"
^XMB(3.9,146098,2,708,0)=" Q"
^XMB(3.9,146098,2,709,0)="""RTN"",""SDES2APTLETTER"",33,0)"
^XMB(3.9,146098,2,710,0)=" ; print multiple letters"
^XMB(3.9,146098,2,711,0)="""RTN"",""SDES2APTLETTER"",34,0)"
^XMB(3.9,146098,2,712,0)=" ; SDES2 PRINT APPT LETTERS"
^XMB(3.9,146098,2,713,0)="""RTN"",""SDES2APTLETTER"",35,0)"
^XMB(3.9,146098,2,714,0)=" ; SDINPUT(""Appointment IEN"",IEN)="""" IEN of the Appointment from file 409.84"
^XMB(3.9,146098,2,715,0)="""RTN"",""SDES2APTLETTER"",36,0)"
^XMB(3.9,146098,2,716,0)=" ; SDINPUT(""Letter Type"")=Letter type - ""N""=No Show; ""P""=Pre-Appointment; ""A""=Cancelled by Patient; ""C""=Cancelled by Clinic"
^XMB(3.9,146098,2,717,0)="""RTN"",""SDES2APTLETTER"",37,0)"
^XMB(3.9,146098,2,718,0)="PRINTLETTERS(RESULTS,SDCONTEXT,SDINPUT) ;"
^XMB(3.9,146098,2,719,0)="""RTN"",""SDES2APTLETTER"",38,0)"
^XMB(3.9,146098,2,720,0)=" N APPTIEN,ERRORS,LETIEN,LCNT,GBL,LETTERS,LINE,LTYPE,ERRAPT,ECNT"
^XMB(3.9,146098,2,721,0)="""RTN"",""SDES2APTLETTER"",39,0)"
^XMB(3.9,146098,2,722,0)=" N %H,%,%T,%Y ; To clear leaking variables from called routines"
^XMB(3.9,146098,2,723,0)="""RTN"",""SDES2APTLETTER"",40,0)"
^XMB(3.9,146098,2,724,0)=" ; validate context array"
^XMB(3.9,146098,2,725,0)="""RTN"",""SDES2APTLETTER"",41,0)"
^XMB(3.9,146098,2,726,0)=" D VALCONTEXT^SDES2VALCONTEXT(.ERRORS,.SDCONTEXT)"
^XMB(3.9,146098,2,727,0)="""RTN"",""SDES2APTLETTER"",42,0)"
^XMB(3.9,146098,2,728,0)=" I $D(ERRORS) S ERRORS(""letters"",1)="""" D BUILDJSON^SDES2JSON(.RESULTS,.ERRORS) Q"
^XMB(3.9,146098,2,729,0)="""RTN"",""SDES2APTLETTER"",43,0)"
^XMB(3.9,146098,2,730,0)=" I $G(SDCONTEXT(""USER DUZ""))'="""" N DUZ D DUZ^XUP(SDCONTEXT(""USER DUZ""))"
^XMB(3.9,146098,2,731,0)="""RTN"",""SDES2APTLETTER"",44,0)"
^XMB(3.9,146098,2,732,0)=" I '$O(SDINPUT(""Appointment IEN"","""")) D"
^XMB(3.9,146098,2,733,0)="""RTN"",""SDES2APTLETTER"",45,0)"
^XMB(3.9,146098,2,734,0)=" . D ERRLOG^SDES2JSON(.ERRORS,254)"
^XMB(3.9,146098,2,735,0)="""RTN"",""SDES2APTLETTER"",46,0)"
^XMB(3.9,146098,2,736,0)=" ; All Letters to be produced are only one type"
^XMB(3.9,146098,2,737,0)="""RTN"",""SDES2APTLETTER"",47,0)"
^XMB(3.9,146098,2,738,0)=" S LTYPE=$G(SDINPUT(""Letter Type""))"
^XMB(3.9,146098,2,739,0)="""RTN"",""SDES2APTLETTER"",48,0)"
^XMB(3.9,146098,2,740,0)=" S LETIEN=$$VALLETTYPE(.ERRORS,LTYPE)"
^XMB(3.9,146098,2,741,0)="""RTN"",""SDES2APTLETTER"",49,0)"
^XMB(3.9,146098,2,742,0)=" I $D(ERRORS) S ERRORS(""letters"",1)="""" D BUILDJSON^SDES2JSON(.RESULTS,.ERRORS) Q"
^XMB(3.9,146098,2,743,0)="""RTN"",""SDES2APTLETTER"",50,0)"
^XMB(3.9,146098,2,744,0)=" S (APPTIEN,LCNT,ECNT)=0"
^XMB(3.9,146098,2,745,0)="""RTN"",""SDES2APTLETTER"",51,0)"
^XMB(3.9,146098,2,746,0)=" ; build appointment letter for each appointment"
^XMB(3.9,146098,2,747,0)="""RTN"",""SDES2APTLETTER"",52,0)"
^XMB(3.9,146098,2,748,0)=" F  S APPTIEN=$O(SDINPUT(""Appointment IEN"",APPTIEN)) Q:'APPTIEN  D"
^XMB(3.9,146098,2,749,0)="""RTN"",""SDES2APTLETTER"",53,0)"
^XMB(3.9,146098,2,750,0)=" . K ERRAPT D VALAPPT(.ERRAPT,APPTIEN,LTYPE) I $D(ERRAPT) S ECNT=ECNT+1 S ERRORS(""Error"",ECNT)=ERRAPT(""Error"",1) Q"
^XMB(3.9,146098,2,751,0)="""RTN"",""SDES2APTLETTER"",54,0)"
^XMB(3.9,146098,2,752,0)=" . D APPTLETTER(.GBL,APPTIEN,LTYPE)"
^XMB(3.9,146098,2,753,0)="""RTN"",""SDES2APTLETTER"",55,0)"
^XMB(3.9,146098,2,754,0)=" . S LCNT=LCNT+1"
^XMB(3.9,146098,2,755,0)="""RTN"",""SDES2APTLETTER"",56,0)"
^XMB(3.9,146098,2,756,0)=" . M LETTERS(""letters"",LCNT)=@GBL"
^XMB(3.9,146098,2,757,0)="""RTN"",""SDES2APTLETTER"",57,0)"
^XMB(3.9,146098,2,758,0)=" . S LETTERS(""letters"",LCNT,""appointmentID"")=APPTIEN"
^XMB(3.9,146098,2,759,0)="""RTN"",""SDES2APTLETTER"",58,0)"
^XMB(3.9,146098,2,760,0)=" I '$D(LETTERS) S LETTERS(""letters"",1)="""""
^XMB(3.9,146098,2,761,0)="""RTN"",""SDES2APTLETTER"",59,0)"
^XMB(3.9,146098,2,762,0)=" I $D(ERRORS) S:'$D(LETTERS) ERRORS(""letters"",1)="""" M LETTERS=ERRORS"
^XMB(3.9,146098,2,763,0)="""RTN"",""SDES2APTLETTER"",60,0)"
^XMB(3.9,146098,2,764,0)=" D BUILDJSON^SDES2JSON(.RESULTS,.LETTERS)"
^XMB(3.9,146098,2,765,0)="""RTN"",""SDES2APTLETTER"",61,0)"
^XMB(3.9,146098,2,766,0)=" Q"
^XMB(3.9,146098,2,767,0)="""RTN"",""SDES2APTLETTER"",62,0)"
^XMB(3.9,146098,2,768,0)=" ; validate appointment list"
^XMB(3.9,146098,2,769,0)="""RTN"",""SDES2APTLETTER"",63,0)"
^XMB(3.9,146098,2,770,0)="VALAPPTS(ERRORS,LIST,LTYPE) ;"
^XMB(3.9,146098,2,771,0)="""RTN"",""SDES2APTLETTER"",64,0)"
^XMB(3.9,146098,2,772,0)=" N APPT"
^XMB(3.9,146098,2,773,0)="""RTN"",""SDES2APTLETTER"",65,0)"
^XMB(3.9,146098,2,774,0)=" I '$O(LIST(""Appointment IEN"",0)) D ERRLOG^SDES2JSON(.ERRORS,254)"
^XMB(3.9,146098,2,775,0)="""RTN"",""SDES2APTLETTER"",66,0)"
^XMB(3.9,146098,2,776,0)=" S APPT=0 F  S APPT=$O(LIST(""Appointment IEN"",APPT)) Q:'APPT  D VALAPPT(.ERRORS,APPT,LTYPE)"
^XMB(3.9,146098,2,777,0)="""RTN"",""SDES2APTLETTER"",67,0)"
^XMB(3.9,146098,2,778,0)=" Q"
^XMB(3.9,146098,2,779,0)="""RTN"",""SDES2APTLETTER"",68,0)"
^XMB(3.9,146098,2,780,0)=" ; Validate appointment and check for proper letter on clinic"
^XMB(3.9,146098,2,781,0)="""RTN"",""SDES2APTLETTER"",69,0)"
^XMB(3.9,146098,2,782,0)="VALAPPT(ERRORS,APPTIEN,LTYPE) ;"
^XMB(3.9,146098,2,783,0)="""RTN"",""SDES2APTLETTER"",70,0)"
^XMB(3.9,146098,2,784,0)=" N RES,CLINIEN,SCLETFLD,SDLET,LT,ERRTXT"
^XMB(3.9,146098,2,785,0)="""RTN"",""SDES2APTLETTER"",71,0)"
^XMB(3.9,146098,2,786,0)=" S LT=$G(LTYPE)"
^XMB(3.9,146098,2,787,0)="""RTN"",""SDES2APTLETTER"",72,0)"
^XMB(3.9,146098,2,788,0)=" I APPTIEN="""" D ERRLOG^SDES2JSON(.ERRORS,14) Q"
^XMB(3.9,146098,2,789,0)="""RTN"",""SDES2APTLETTER"",73,0)"
^XMB(3.9,146098,2,790,0)=" I APPTIEN'="""",'$D(^SDEC(409.84,APPTIEN,0)) D ERRLOG^SDES2JSON(.ERRORS,15,APPTIEN) Q"
^XMB(3.9,146098,2,791,0)="""RTN"",""SDES2APTLETTER"",74,0)"
^XMB(3.9,146098,2,792,0)=" S RES=$$GET1^DIQ(409.84,APPTIEN,.07,""I"")"
^XMB(3.9,146098,2,793,0)="""RTN"",""SDES2APTLETTER"",75,0)"
^XMB(3.9,146098,2,794,0)=" S CLINIEN=$$GET1^DIQ(409.831,RES,.04,""I"")"
^XMB(3.9,146098,2,795,0)="""RTN"",""SDES2APTLETTER"",76,0)"
^XMB(3.9,146098,2,796,0)=" S SCLETFLD=$S(LT=""N"":2508,LT=""P"":2509,LT=""C"":2510,LT=""A"":2511,1:2509)"
^XMB(3.9,146098,2,797,0)="""RTN"",""SDES2APTLETTER"",77,0)"
^XMB(3.9,146098,2,798,0)=" S SDLET=$$GET1^DIQ(44,CLINIEN,SCLETFLD,""I"")"
^XMB(3.9,146098,2,799,0)="""RTN"",""SDES2APTLETTER"",78,0)"
^XMB(3.9,146098,2,800,0)=" I SDLET="""" D  Q"
^XMB(3.9,146098,2,801,0)="""RTN"",""SDES2APTLETTER"",79,0)"
^XMB(3.9,146098,2,802,0)=" . S ERRTXT=$S(LT=""N"":""No-Show"",LT=""P"":""Pre-Appointment"",LT=""C"":""Clinic Cancellation"",1:""Patient Cancellation"")_"" Letter not defined for Clinic ""_$$GET1^DIQ(44,CLINIEN,.01,""E"")"
^XMB(3.9,146098,2,803,0)="""RTN"",""SDES2APTLETTER"",80,0)"
^XMB(3.9,146098,2,804,0)=" . D ERRLOG^SDES2JSON(.ERRORS,227,ERRTXT)"
^XMB(3.9,146098,2,805,0)="""RTN"",""SDES2APTLETTER"",81,0)"
^XMB(3.9,146098,2,806,0)=" Q"
^XMB(3.9,146098,2,807,0)="""RTN"",""SDES2APTLETTER"",82,0)"
^XMB(3.9,146098,2,808,0)=" ; validate letter type"
^XMB(3.9,146098,2,809,0)="""RTN"",""SDES2APTLETTER"",83,0)"
^XMB(3.9,146098,2,810,0)="VALLETTYPE(ERRORS,LTYPE) ;"
^XMB(3.9,146098,2,811,0)="""RTN"",""SDES2APTLETTER"",84,0)"
^XMB(3.9,146098,2,812,0)=" N LIEN,RESOURCE,CLIN"
^XMB(3.9,146098,2,813,0)="""RTN"",""SDES2APTLETTER"",85,0)"
^XMB(3.9,146098,2,814,0)=" I '$L(LTYPE) D ERRLOG^SDES2JSON(.ERRORS,228) Q """" ; missing letter type"
^XMB(3.9,146098,2,815,0)="""RTN"",""SDES2APTLETTER"",86,0)"
^XMB(3.9,146098,2,816,0)=" I '$D(^VA(407.6,""B"",LTYPE)) D ERRLOG^SDES2JSON(.ERRORS,226,LTYPE) Q """"  ;Invalid letter type."
^XMB(3.9,146098,2,817,0)="""RTN"",""SDES2APTLETTER"",87,0)"
^XMB(3.9,146098,2,818,0)=" ;S LIEN=$$FIND1^DIC(407.6,,""B"",LTYPE)"
^XMB(3.9,146098,2,819,0)="""RTN"",""SDES2APTLETTER"",88,0)"
^XMB(3.9,146098,2,820,0)=" S LIEN="""",LIEN=$O(^VA(407.6,""B"",LTYPE,LIEN))"
^XMB(3.9,146098,2,821,0)="""RTN"",""SDES2APTLETTER"",89,0)"
^XMB(3.9,146098,2,822,0)=" Q LIEN"
^XMB(3.9,146098,2,823,0)="""RTN"",""SDES2APTLETTER"",90,0)"
^XMB(3.9,146098,2,824,0)=" ; print single appointment letter"
^XMB(3.9,146098,2,825,0)="""RTN"",""SDES2APTLETTER"",91,0)"
^XMB(3.9,146098,2,826,0)="APPTLETTER(SDECY,SDECAPID,LT)  ;Print Appointment Letter"
^XMB(3.9,146098,2,827,0)="""RTN"",""SDES2APTLETTER"",92,0)"
^XMB(3.9,146098,2,828,0)=" ;APPTLETR(SDECY,SDECAPID,LT)  external parameter tag is in SDEC"
^XMB(3.9,146098,2,829,0)="""RTN"",""SDES2APTLETTER"",93,0)"
^XMB(3.9,146098,2,830,0)=" ; SDECAPPT = Pointer to appointment in SDEC APPOINTMENT file 409.84"
^XMB(3.9,146098,2,831,0)="""RTN"",""SDES2APTLETTER"",94,0)"
^XMB(3.9,146098,2,832,0)=" ; LT       = Letter type - ""N""=No Show; ""P""=Pre-Appointment; ""A""=Cancelled by Patient; ""C""=Cancelled by Clinic"
^XMB(3.9,146098,2,833,0)="""RTN"",""SDES2APTLETTER"",95,0)"
^XMB(3.9,146098,2,834,0)=" ;"
^XMB(3.9,146098,2,835,0)="""RTN"",""SDES2APTLETTER"",96,0)"
^XMB(3.9,146098,2,836,0)=" N SDECI,DFN,RES,CLINICIEN,SDLET,SDT,X1,X2,Y,TIMEZONE"
^XMB(3.9,146098,2,837,0)="""RTN"",""SDES2APTLETTER"",97,0)"
^XMB(3.9,146098,2,838,0)=" N SDIV,SDFORM,SDNAM,SDECDATA,SCLETFLD,ERRTXT"
^XMB(3.9,146098,2,839,0)="""RTN"",""SDES2APTLETTER"",98,0)"
^XMB(3.9,146098,2,840,0)=" S SDECI=0"
^XMB(3.9,146098,2,841,0)="""RTN"",""SDES2APTLETTER"",99,0)"
^XMB(3.9,146098,2,842,0)=" K ^TMP(""SDEC_COMP"",$J)"
^XMB(3.9,146098,2,843,0)="""RTN"",""SDES2APTLETTER"",100,0)"
^XMB(3.9,146098,2,844,0)=" S SDECY=$NA(^TMP(""SDEC_COMP"",$J))"
^XMB(3.9,146098,2,845,0)="""RTN"",""SDES2APTLETTER"",101,0)"
^XMB(3.9,146098,2,846,0)=" D GETS^DIQ(409.84,SDECAPID_"","","".01;.05;.07"",""I"",""SDECDATA"")"
^XMB(3.9,146098,2,847,0)="""RTN"",""SDES2APTLETTER"",102,0)"
^XMB(3.9,146098,2,848,0)=" S SDT=$G(SDECDATA(409.84,SDECAPID_"","",.01,""I""))"
^XMB(3.9,146098,2,849,0)="""RTN"",""SDES2APTLETTER"",103,0)"
^XMB(3.9,146098,2,850,0)=" S DFN=$G(SDECDATA(409.84,SDECAPID_"","",.05,""I""))"
^XMB(3.9,146098,2,851,0)="""RTN"",""SDES2APTLETTER"",104,0)"
^XMB(3.9,146098,2,852,0)=" S RES=$G(SDECDATA(409.84,SDECAPID_"","",.07,""I""))"
^XMB(3.9,146098,2,853,0)="""RTN"",""SDES2APTLETTER"",105,0)"
^XMB(3.9,146098,2,854,0)=" S CLINICIEN=$$GET1^DIQ(409.831,RES,.04,""I"")"
^XMB(3.9,146098,2,855,0)="""RTN"",""SDES2APTLETTER"",106,0)"
^XMB(3.9,146098,2,856,0)=" S SCLETFLD=$S(LT=""N"":2508,LT=""P"":2509,LT=""C"":2510,LT=""A"":2511,1:2509)"
^XMB(3.9,146098,2,857,0)="""RTN"",""SDES2APTLETTER"",107,0)"
^XMB(3.9,146098,2,858,0)=" S SDLET=$$GET1^DIQ(44,CLINICIEN,SCLETFLD,""I"")"
^XMB(3.9,146098,2,859,0)="""RTN"",""SDES2APTLETTER"",108,0)"
^XMB(3.9,146098,2,860,0)=" S SDIV=$$GET1^DIQ(44,CLINICIEN,3.5,""I"")"
^XMB(3.9,146098,2,861,0)="""RTN"",""SDES2APTLETTER"",109,0)"
^XMB(3.9,146098,2,862,0)=" S SDIV=$S(SDIV:SDIV,1:$O(^DG(40.8,0)))"
^XMB(3.9,146098,2,863,0)="""RTN"",""SDES2APTLETTER"",110,0)"
^XMB(3.9,146098,2,864,0)=" ; address location on letters 1 - bottom, 0 - top"
^XMB(3.9,146098,2,865,0)="""RTN"",""SDES2APTLETTER"",111,0)"
^XMB(3.9,146098,2,866,0)=" S SDFORM=$$GET1^DIQ(40.8,SDIV,30.01,""I"")"
^XMB(3.9,146098,2,867,0)="""RTN"",""SDES2APTLETTER"",112,0)"
^XMB(3.9,146098,2,868,0)=" ; data header"
^XMB(3.9,146098,2,869,0)="""RTN"",""SDES2APTLETTER"",113,0)"
^XMB(3.9,146098,2,870,0)=" D PRT(DFN,CLINICIEN,SDT,LT,SDLET,SDFORM)"
^XMB(3.9,146098,2,871,0)="""RTN"",""SDES2APTLETTER"",114,0)"
^XMB(3.9,146098,2,872,0)=" D WRAPP(DFN,CLINICIEN,SDT,LT,SDLET)"
^XMB(3.9,146098,2,873,0)="""RTN"",""SDES2APTLETTER"",115,0)"
^XMB(3.9,146098,2,874,0)=" D REST(DFN,CLINICIEN,SDT,LT,SDLET,SDFORM)"
^XMB(3.9,146098,2,875,0)="""RTN"",""SDES2APTLETTER"",116,0)"
