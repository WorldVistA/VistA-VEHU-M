^XMB(3.9,146107,2,239,0)="""RTN"",""PSJORUT2"")"
^XMB(3.9,146107,2,240,0)="0^1^B47514615"
^XMB(3.9,146107,2,241,0)="""RTN"",""PSJORUT2"",1,0)"
^XMB(3.9,146107,2,242,0)="PSJORUT2 ;BIR/MLM-MISC. PROCEDURE CALLS FOR OE/RR 3.0 (CONT.) ;03 Aug 98 / 8:42 AM"
^XMB(3.9,146107,2,243,0)="""RTN"",""PSJORUT2"",2,0)"
^XMB(3.9,146107,2,244,0)=" ;;5.0; INPATIENT MEDICATIONS ;**14,29,50,56,58,107,152,134**;16 DEC 97;Build 0"
^XMB(3.9,146107,2,245,0)="""RTN"",""PSJORUT2"",3,0)"
^XMB(3.9,146107,2,246,0)=" ;"
^XMB(3.9,146107,2,247,0)="""RTN"",""PSJORUT2"",4,0)"
^XMB(3.9,146107,2,248,0)=" ; Reference to ^PS(55 is supported by DBIA 2191"
^XMB(3.9,146107,2,249,0)="""RTN"",""PSJORUT2"",5,0)"
^XMB(3.9,146107,2,250,0)=" ; Reference to ^PS(50.605 is supported by DBIA 2138,696."
^XMB(3.9,146107,2,251,0)="""RTN"",""PSJORUT2"",6,0)"
^XMB(3.9,146107,2,252,0)=" ; References to ^PS(52.6 supported by DBIA 1231"
^XMB(3.9,146107,2,253,0)="""RTN"",""PSJORUT2"",7,0)"
^XMB(3.9,146107,2,254,0)=" ; Reference to ^PS(52.7 supported by DBIA 2173."
^XMB(3.9,146107,2,255,0)="""RTN"",""PSJORUT2"",8,0)"
^XMB(3.9,146107,2,256,0)=" ; Reference to ^PSDRUG( is supported by DBIA 2192"
^XMB(3.9,146107,2,257,0)="""RTN"",""PSJORUT2"",9,0)"
^XMB(3.9,146107,2,258,0)=" ; Reference to ^PSNDF( is supported by DBIA 2195"
^XMB(3.9,146107,2,259,0)="""RTN"",""PSJORUT2"",10,0)"
^XMB(3.9,146107,2,260,0)=" ; Reference to ^PSRX( is supported by DBIA 824"
^XMB(3.9,146107,2,261,0)="""RTN"",""PSJORUT2"",11,0)"
^XMB(3.9,146107,2,262,0)=" ; Reference to ^PSNAPIS is supported by DBIA 2531"
^XMB(3.9,146107,2,263,0)="""RTN"",""PSJORUT2"",12,0)"
^XMB(3.9,146107,2,264,0)=" ;"
^XMB(3.9,146107,2,265,0)="""RTN"",""PSJORUT2"",13,0)"
^XMB(3.9,146107,2,266,0)="ENVAC(PN) ; Find VA CLASS of VA Product Name"
^XMB(3.9,146107,2,267,0)="""RTN"",""PSJORUT2"",14,0)"
^XMB(3.9,146107,2,268,0)=" ;Input: PN - See above"
^XMB(3.9,146107,2,269,0)="""RTN"",""PSJORUT2"",15,0)"
^XMB(3.9,146107,2,270,0)=" ;Output: VA Drug Class^Classification"
^XMB(3.9,146107,2,271,0)="""RTN"",""PSJORUT2"",16,0)"
^XMB(3.9,146107,2,272,0)=" ;"
^XMB(3.9,146107,2,273,0)="""RTN"",""PSJORUT2"",17,0)"
^XMB(3.9,146107,2,274,0)=" ; NEW NDF CALL "
^XMB(3.9,146107,2,275,0)="""RTN"",""PSJORUT2"",18,0)"
^XMB(3.9,146107,2,276,0)=" N X S X=""PSNAPIS"" X ^%ZOSF(""TEST"") I  N PSJC,X1,X2 S X1=+$P(PN,"".""),X2=+$P(PN,""."",2),PSJC=$$DCLASS^PSNAPIS(X1,X2) Q PSJC"
^XMB(3.9,146107,2,277,0)="""RTN"",""PSJORUT2"",19,0)"
^XMB(3.9,146107,2,278,0)=" ;"
^XMB(3.9,146107,2,279,0)="""RTN"",""PSJORUT2"",20,0)"
^XMB(3.9,146107,2,280,0)=" N GDP,PNP S GDP=$P(PN,"".""),PNP=$P(PN,""."",2)"
^XMB(3.9,146107,2,281,0)="""RTN"",""PSJORUT2"",21,0)"
^XMB(3.9,146107,2,282,0)=" S X=+$P($G(^PSNDF(+GDP,5,+PNP,0)),U,2),X=+$P($G(^PSNDF(GDP,2,X,0)),U,3),PSJC=$P($G(^PS(50.605,X,0)),U,2)"
^XMB(3.9,146107,2,283,0)="""RTN"",""PSJORUT2"",22,0)"
^XMB(3.9,146107,2,284,0)=" Q $S('X:0,PSJC="""":0,1:X_U_PSJC)"
^XMB(3.9,146107,2,285,0)="""RTN"",""PSJORUT2"",23,0)"
^XMB(3.9,146107,2,286,0)=" ;"
^XMB(3.9,146107,2,287,0)="""RTN"",""PSJORUT2"",24,0)"
^XMB(3.9,146107,2,288,0)="ENVAGN(PN) ; Return VA Generic Name for specified VA Product Name."
^XMB(3.9,146107,2,289,0)="""RTN"",""PSJORUT2"",25,0)"
^XMB(3.9,146107,2,290,0)=" ;Input:  PN - VA Product Name IEN"
^XMB(3.9,146107,2,291,0)="""RTN"",""PSJORUT2"",26,0)"
^XMB(3.9,146107,2,292,0)=" ;Output: VA Generic Name IEN^VA Generic Name"
^XMB(3.9,146107,2,293,0)="""RTN"",""PSJORUT2"",27,0)"
^XMB(3.9,146107,2,294,0)=" ;"
^XMB(3.9,146107,2,295,0)="""RTN"",""PSJORUT2"",28,0)"
^XMB(3.9,146107,2,296,0)=" ; NEW NDF CALL "
^XMB(3.9,146107,2,297,0)="""RTN"",""PSJORUT2"",29,0)"
^XMB(3.9,146107,2,298,0)=" N X S X=""PSNAPIS"" X ^%ZOSF(""TEST"") I  N GDP,X1,X2 S X1=+$P(PN,"".""),X2=+$P(PN,""."",2),GDP=$$VAGN^PSNAPIS(X1) Q $S(GDP=0:0,1:X1_U_GDP)"
^XMB(3.9,146107,2,299,0)="""RTN"",""PSJORUT2"",30,0)"
^XMB(3.9,146107,2,300,0)=" ;"
^XMB(3.9,146107,2,301,0)="""RTN"",""PSJORUT2"",31,0)"
^XMB(3.9,146107,2,302,0)=" N GDP,PNP S GDP=+$P(PN,"".""),PNP=+$P(PN,""."",2)"
^XMB(3.9,146107,2,303,0)="""RTN"",""PSJORUT2"",32,0)"
^XMB(3.9,146107,2,304,0)=" S X=$P($G(^PSNDF(GDP,0)),U)"
^XMB(3.9,146107,2,305,0)="""RTN"",""PSJORUT2"",33,0)"
^XMB(3.9,146107,2,306,0)=" Q $S('GDP:0,X="""":0,1:GDP_U_X)"
^XMB(3.9,146107,2,307,0)="""RTN"",""PSJORUT2"",34,0)"
^XMB(3.9,146107,2,308,0)="ENVOL(PN,ARRAY) ;"
^XMB(3.9,146107,2,309,0)="""RTN"",""PSJORUT2"",35,0)"
^XMB(3.9,146107,2,310,0)=" I (PN'[""A"")&(PN'[""B"") S ARRAY=""0"" Q"
^XMB(3.9,146107,2,311,0)="""RTN"",""PSJORUT2"",36,0)"
^XMB(3.9,146107,2,312,0)=" N X,XX,F,INACT,IVFL"
^XMB(3.9,146107,2,313,0)="""RTN"",""PSJORUT2"",37,0)"
^XMB(3.9,146107,2,314,0)=" S X(1)=""ML"",X(2)=""LITER"",X(3)=""MCG"",X(4)=""MG"",X(5)=""GM"",X(6)=""UNITS"",X(7)=""IU"",X(8)=""MEQ"",X(9)=""MM"",X(10)=""MU"",X(11)=""THOUU"",X(12)=""MG-PE"",X(13)=""NANOGRAM"",X(14)=""MMOL"""
^XMB(3.9,146107,2,315,0)="""RTN"",""PSJORUT2"",38,0)"
^XMB(3.9,146107,2,316,0)=" I PN[""A"" N ADD S (ADD,X,XX)=0 F  S ADD=$O(^PS(52.6,""AOI"",+PN,ADD))  Q:ADD=""""  D"
^XMB(3.9,146107,2,317,0)="""RTN"",""PSJORUT2"",39,0)"
^XMB(3.9,146107,2,318,0)=" .S INACT=$G(^PS(52.6,ADD,""I"")) I INACT']""""!(INACT>DT) S IVFL=$P($G(^(0)),""^"",13) Q:'IVFL  S XX=XX+1,ARRAY(ADD)=""^""_X($P($G(^PS(52.6,ADD,0)),U,3)) Q"
^XMB(3.9,146107,2,319,0)="""RTN"",""PSJORUT2"",40,0)"
^XMB(3.9,146107,2,320,0)=" I PN[""B"" N SOL S SOL=0,XX=0 F  S SOL=$O(^PS(52.7,""AOI"",+PN,SOL)) Q:SOL=""""  D"
^XMB(3.9,146107,2,321,0)="""RTN"",""PSJORUT2"",41,0)"
^XMB(3.9,146107,2,322,0)=" .S INACT=$G(^PS(52.7,SOL,""I"")) I INACT']""""!(INACT>DT) S IVFL=$P($G(^(0)),""^"",13) Q:'IVFL  S XX=XX+1,ARRAY(SOL)=$P($G(^PS(52.7,SOL,0)),""^"",3)"
^XMB(3.9,146107,2,323,0)="""RTN"",""PSJORUT2"",42,0)"
^XMB(3.9,146107,2,324,0)=" S ARRAY=XX>0"
