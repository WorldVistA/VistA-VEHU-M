^XMB(3.9,146098,2,2171,0)="""RTN"",""SDESAPPTLETTERS"",273,0)"
^XMB(3.9,146098,2,2172,0)=" S SDHDR=""BAD ADDRESS INDICATOR LIST"" S SDECI=SDECI+1 S ^TMP(""SDEC"",$J,SDECI)=$$FILL((80-$L(SDHDR)/2),"" "")_SDHDR"
