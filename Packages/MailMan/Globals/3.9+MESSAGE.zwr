^XMB(3.9,146096,2,381,0)="""RTN"",""MAGVAQ01"",66,0)"
^XMB(3.9,146096,2,382,0)=" ; MAGPARAM(""EXPIRATION DATE/TIME"")"
^XMB(3.9,146096,2,383,0)="""RTN"",""MAGVAQ01"",67,0)"
^XMB(3.9,146096,2,384,0)=" ; MAGPARAM(""EARLIEST DELIVERY DATE/TIME"")"
^XMB(3.9,146096,2,385,0)="""RTN"",""MAGVAQ01"",68,0)"
^XMB(3.9,146096,2,386,0)=" ; MAGPARAM(""PRIORITY"")"
^XMB(3.9,146096,2,387,0)="""RTN"",""MAGVAQ01"",69,0)"
^XMB(3.9,146096,2,388,0)=" ; MAGPARAM(""QUEUE"") = Pointer to QUEUE file (#2006.927)"
^XMB(3.9,146096,2,389,0)="""RTN"",""MAGVAQ01"",70,0)"
^XMB(3.9,146096,2,390,0)=" ; MAGPARAM(""MESSAGE GROUP ID"") =  value of the field ""MESSAGE GROUP ID"""
^XMB(3.9,146096,2,391,0)="""RTN"",""MAGVAQ01"",71,0)"
^XMB(3.9,146096,2,392,0)=" ;                                  in QUEUE file (#2006.927) or ""*"" or """""
^XMB(3.9,146096,2,393,0)="""RTN"",""MAGVAQ01"",72,0)"
^XMB(3.9,146096,2,394,0)=" ; MAGMSG(1..n)= MESSAGE"
^XMB(3.9,146096,2,395,0)="""RTN"",""MAGVAQ01"",73,0)"
^XMB(3.9,146096,2,396,0)=" ; "
^XMB(3.9,146096,2,397,0)="""RTN"",""MAGVAQ01"",74,0)"
^XMB(3.9,146096,2,398,0)=" ; Return Values"
^XMB(3.9,146096,2,399,0)="""RTN"",""MAGVAQ01"",75,0)"
^XMB(3.9,146096,2,400,0)=" ; ============="
^XMB(3.9,146096,2,401,0)="""RTN"",""MAGVAQ01"",76,0)"
^XMB(3.9,146096,2,402,0)=" ; if error MAGRY = Failure status ^ Error message^"
^XMB(3.9,146096,2,403,0)="""RTN"",""MAGVAQ01"",77,0)"
^XMB(3.9,146096,2,404,0)=" ; if success MAGRY = Success status ^^IEN - IEN of the new record "
^XMB(3.9,146096,2,405,0)="""RTN"",""MAGVAQ01"",78,0)"
^XMB(3.9,146096,2,406,0)=" ; "
^XMB(3.9,146096,2,407,0)="""RTN"",""MAGVAQ01"",79,0)"
^XMB(3.9,146096,2,408,0)="ADDQM(MAGRY,MAGPARAM,MAGMSG) ; RPC [MAGVA ENQUEUE Q MSG]"
^XMB(3.9,146096,2,409,0)="""RTN"",""MAGVAQ01"",80,0)"
^XMB(3.9,146096,2,410,0)=" ; build MAGMSG first - workaround for Old broker listener"
^XMB(3.9,146096,2,411,0)="""RTN"",""MAGVAQ01"",81,0)"
^XMB(3.9,146096,2,412,0)=" N L,LL"
^XMB(3.9,146096,2,413,0)="""RTN"",""MAGVAQ01"",82,0)"
^XMB(3.9,146096,2,414,0)=" S L=""MAGMSG"",LL=0"
^XMB(3.9,146096,2,415,0)="""RTN"",""MAGVAQ01"",83,0)"
^XMB(3.9,146096,2,416,0)=" K MAGMSG"
^XMB(3.9,146096,2,417,0)="""RTN"",""MAGVAQ01"",84,0)"
^XMB(3.9,146096,2,418,0)=" F  S L=$O(MAGPARAM(L)) Q:(L="""")!($E(L,1,6)'=""MAGMSG"")  S LL=LL+1,MAGMSG(LL)=MAGPARAM(L) K MAGPARAM(L)"
^XMB(3.9,146096,2,419,0)="""RTN"",""MAGVAQ01"",85,0)"
^XMB(3.9,146096,2,420,0)=" ;"
^XMB(3.9,146096,2,421,0)="""RTN"",""MAGVAQ01"",86,0)"
^XMB(3.9,146096,2,422,0)=" N FILE,FILEQM,IENS,FLD,ISACTIVE"
^XMB(3.9,146096,2,423,0)="""RTN"",""MAGVAQ01"",87,0)"
^XMB(3.9,146096,2,424,0)=" N MAGWP"
^XMB(3.9,146096,2,425,0)="""RTN"",""MAGVAQ01"",88,0)"
^XMB(3.9,146096,2,426,0)=" K MAGRY"
^XMB(3.9,146096,2,427,0)="""RTN"",""MAGVAQ01"",89,0)"
^XMB(3.9,146096,2,428,0)=" ; Check if the queue exist and it is active"
^XMB(3.9,146096,2,429,0)="""RTN"",""MAGVAQ01"",90,0)"
^XMB(3.9,146096,2,430,0)=" S IEN=$G(MAGPARAM(""QUEUE""))"
^XMB(3.9,146096,2,431,0)="""RTN"",""MAGVAQ01"",91,0)"
^XMB(3.9,146096,2,432,0)=" ; Check for QUEUE"
^XMB(3.9,146096,2,433,0)="""RTN"",""MAGVAQ01"",92,0)"
^XMB(3.9,146096,2,434,0)=" I IEN="""" S MAGRY=$$FAILED^MAGVAF02()_$$RESDEL^MAGVAF02()_""Input parameter QUEUE is required."" Q  ; Error getting the IEN"
^XMB(3.9,146096,2,435,0)="""RTN"",""MAGVAQ01"",93,0)"
^XMB(3.9,146096,2,436,0)=" ; Check if queue is active"
^XMB(3.9,146096,2,437,0)="""RTN"",""MAGVAQ01"",94,0)"
^XMB(3.9,146096,2,438,0)=" S FILE=2006.927  ; Queue file"
^XMB(3.9,146096,2,439,0)="""RTN"",""MAGVAQ01"",95,0)"
^XMB(3.9,146096,2,440,0)=" S IENS=IEN_"","""
^XMB(3.9,146096,2,441,0)="""RTN"",""MAGVAQ01"",96,0)"
^XMB(3.9,146096,2,442,0)=" S FLD=$$GETFLDID^MAGVAF01(FILE,""ACTIVE"")"
^XMB(3.9,146096,2,443,0)="""RTN"",""MAGVAQ01"",97,0)"
^XMB(3.9,146096,2,444,0)=" S ISACTIVE=$$GET1^DIQ(FILE,IENS,FLD,""I"")  ; get ACTIVE value"
^XMB(3.9,146096,2,445,0)="""RTN"",""MAGVAQ01"",98,0)"
^XMB(3.9,146096,2,446,0)=" I 'ISACTIVE S MAGRY=$$FAILED^MAGVAF02()_$$RESDEL^MAGVAF02()_""The queue is inactive"" Q"
^XMB(3.9,146096,2,447,0)="""RTN"",""MAGVAQ01"",99,0)"
^XMB(3.9,146096,2,448,0)=" ; "
^XMB(3.9,146096,2,449,0)="""RTN"",""MAGVAQ01"",100,0)"
^XMB(3.9,146096,2,450,0)=" S MAGPARAM(""EXPIRATION DATE/TIME"")=$$IDF2FM^MAGVAF01($G(MAGPARAM(""EXPIRATION DATE/TIME"")))"
^XMB(3.9,146096,2,451,0)="""RTN"",""MAGVAQ01"",101,0)"
^XMB(3.9,146096,2,452,0)=" S MAGPARAM(""EARLIEST DELIVERY DATE/TIME"")=$$IDF2FM^MAGVAF01($G(MAGPARAM(""EARLIEST DELIVERY DATE/TIME"")))"
^XMB(3.9,146096,2,453,0)="""RTN"",""MAGVAQ01"",102,0)"
^XMB(3.9,146096,2,454,0)=" S MAGPARAM(""ENQUEUED DATE/TIME"")=$$NOW^XLFDT"
^XMB(3.9,146096,2,455,0)="""RTN"",""MAGVAQ01"",103,0)"
^XMB(3.9,146096,2,456,0)=" M MAGWP(""MESSAGE"")=MAGMSG"
^XMB(3.9,146096,2,457,0)="""RTN"",""MAGVAQ01"",104,0)"
^XMB(3.9,146096,2,458,0)=" S FILEQM=2006.928"
^XMB(3.9,146096,2,459,0)="""RTN"",""MAGVAQ01"",105,0)"
^XMB(3.9,146096,2,460,0)=" D ADDRCD^MAGVAF01(.MAGRY,FILEQM,.MAGPARAM,.MAGWP)  ; add the record"
^XMB(3.9,146096,2,461,0)="""RTN"",""MAGVAQ01"",106,0)"
^XMB(3.9,146096,2,462,0)=" Q"
^XMB(3.9,146096,2,463,0)="""RTN"",""MAGVAQ01"",107,0)"
^XMB(3.9,146096,2,464,0)=" ;"
^XMB(3.9,146096,2,465,0)="""RTN"",""MAGVAQ01"",108,0)"
^XMB(3.9,146096,2,466,0)=" ;*****  Find, return and remove a queue message from the QUEUE MESSAGE file (#2006.928)"
^XMB(3.9,146096,2,467,0)="""RTN"",""MAGVAQ01"",109,0)"
^XMB(3.9,146096,2,468,0)=" ;       by QUEUE - IEN of record in QUEUE file (#2006.927)"
^XMB(3.9,146096,2,469,0)="""RTN"",""MAGVAQ01"",110,0)"
