^XMB(3.9,146012,2,916,0)=" . S CNT=CNT+1"
^XMB(3.9,146012,2,917,0)="""RTN"",""PSOERRX0"",221,0)"
^XMB(3.9,146012,2,918,0)=" . I CNT>18,$O(PRVLST(""DILIST"",""ID"",PRV)),$Y>(IOSL-4) D"
^XMB(3.9,146012,2,919,0)="""RTN"",""PSOERRX0"",222,0)"
^XMB(3.9,146012,2,920,0)=" . . K DIR S DIR(0)=""E"" D ^DIR I $D(DIRUT)!$D(DIROUT) S QUIT=1 Q"
