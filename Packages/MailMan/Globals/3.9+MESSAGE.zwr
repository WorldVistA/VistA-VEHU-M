^XMB(3.9,146052,2,962,0)=" . ; loop thru authorizations"
^XMB(3.9,146052,2,963,0)="""RTN"",""FBAAMST"",56,0)"
^XMB(3.9,146052,2,964,0)=" . S FBAU=0 F  S FBAU=$O(^FBAAA(FBDFN,1,FBAU)) Q:'FBAU  D"
^XMB(3.9,146052,2,965,0)="""RTN"",""FBAAMST"",57,0)"
^XMB(3.9,146052,2,966,0)=" . . S FBA=$G(^FBAAA(FBDFN,1,FBAU,0))"
^XMB(3.9,146052,2,967,0)="""RTN"",""FBAAMST"",58,0)"
^XMB(3.9,146052,2,968,0)=" . . Q:$P($G(^FBAAA(FBDFN,1,FBAU,""ADEL"")),U)  ; austin deleted"
^XMB(3.9,146052,2,969,0)="""RTN"",""FBAAMST"",59,0)"
^XMB(3.9,146052,2,970,0)=" . . Q:$P(FBA,U,7)'=FBPOV  ; not MST purpose of visit"
^XMB(3.9,146052,2,971,0)="""RTN"",""FBAAMST"",60,0)"
^XMB(3.9,146052,2,972,0)=" . . ; ensure authorization is not outside the period of interest"
^XMB(3.9,146052,2,973,0)="""RTN"",""FBAAMST"",61,0)"
^XMB(3.9,146052,2,974,0)=" . . Q:$P(FBA,U)>FBDT2  ; auth from date after specified rpt end"
^XMB(3.9,146052,2,975,0)="""RTN"",""FBAAMST"",62,0)"
^XMB(3.9,146052,2,976,0)=" . . Q:$P(FBA,U,2)<FBDT1  ; auth to date before specified rpt begin"
^XMB(3.9,146052,2,977,0)="""RTN"",""FBAAMST"",63,0)"
^XMB(3.9,146052,2,978,0)=" . . ; passed all criteria"
^XMB(3.9,146052,2,979,0)="""RTN"",""FBAAMST"",64,0)"
^XMB(3.9,146052,2,980,0)=" . . I 'FBFNDAUT D"
^XMB(3.9,146052,2,981,0)="""RTN"",""FBAAMST"",65,0)"
^XMB(3.9,146052,2,982,0)=" . . . ; this is the first MST authorization selected for patient"
^XMB(3.9,146052,2,983,0)="""RTN"",""FBAAMST"",66,0)"
^XMB(3.9,146052,2,984,0)=" . . . ; get patient name"
^XMB(3.9,146052,2,985,0)="""RTN"",""FBAAMST"",67,0)"
^XMB(3.9,146052,2,986,0)=" . . . S FBPNAME=$$GET1^DIQ(161,FBDFN,.01)"
^XMB(3.9,146052,2,987,0)="""RTN"",""FBAAMST"",68,0)"
^XMB(3.9,146052,2,988,0)=" . . . S:FBPNAME="""" FBPNAME=""UNKNOWN"""
^XMB(3.9,146052,2,989,0)="""RTN"",""FBAAMST"",69,0)"
^XMB(3.9,146052,2,990,0)=" . . . ; get gender "
^XMB(3.9,146052,2,991,0)="""RTN"",""FBAAMST"",70,0)"
^XMB(3.9,146052,2,992,0)=" . . . S DFN=FBDFN K VAPTYP,VAHOW,VAROOT D DEM^VADPT"
^XMB(3.9,146052,2,993,0)="""RTN"",""FBAAMST"",71,0)"
^XMB(3.9,146052,2,994,0)=" . . . S FBGEN=$P(VADM(5),U) ; gender internal value"
^XMB(3.9,146052,2,995,0)="""RTN"",""FBAAMST"",72,0)"
^XMB(3.9,146052,2,996,0)=" . . . S FBSSN=$P(VADM(2),U,2) ; SSN external value "
^XMB(3.9,146052,2,997,0)="""RTN"",""FBAAMST"",73,0)"
^XMB(3.9,146052,2,998,0)=" . . . I ""^F^M^""'[(U_FBGEN_U) S FBGEN=""U"""
^XMB(3.9,146052,2,999,0)="""RTN"",""FBAAMST"",74,0)"
^XMB(3.9,146052,2,1000,0)=" . . . ; increment count of unique patients"
^XMB(3.9,146052,2,1001,0)="""RTN"",""FBAAMST"",75,0)"
^XMB(3.9,146052,2,1002,0)=" . . . S FBT(""PATIENT"",FBGEN)=FBT(""PATIENT"",FBGEN)+1"
^XMB(3.9,146052,2,1003,0)="""RTN"",""FBAAMST"",76,0)"
^XMB(3.9,146052,2,1004,0)=" . . . S ^TMP($J,""FBA"",FBPNAME_U_FBDFN)=FBSSN_U_FBGEN"
^XMB(3.9,146052,2,1005,0)="""RTN"",""FBAAMST"",77,0)"
^XMB(3.9,146052,2,1006,0)=" . . . S FBFNDAUT=1 ; note that a MST authorization was found for patient"
^XMB(3.9,146052,2,1007,0)="""RTN"",""FBAAMST"",78,0)"
^XMB(3.9,146052,2,1008,0)=" . . . D KVA^VADPT ; clean up patient demographics"
^XMB(3.9,146052,2,1009,0)="""RTN"",""FBAAMST"",79,0)"
^XMB(3.9,146052,2,1010,0)=" . . ; save authorization by patient name^dfn,auth to date^auth ien"
^XMB(3.9,146052,2,1011,0)="""RTN"",""FBAAMST"",80,0)"
^XMB(3.9,146052,2,1012,0)=" . . S ^TMP($J,""FBA"",FBPNAME_U_FBDFN,$P(FBA,U,2)_U_FBAU)=FBA"
^XMB(3.9,146052,2,1013,0)="""RTN"",""FBAAMST"",81,0)"
^XMB(3.9,146052,2,1014,0)=" . ;"
^XMB(3.9,146052,2,1015,0)="""RTN"",""FBAAMST"",82,0)"
^XMB(3.9,146052,2,1016,0)=" . ; look for payments related to the selected patient authorizations"
^XMB(3.9,146052,2,1017,0)="""RTN"",""FBAAMST"",83,0)"
^XMB(3.9,146052,2,1018,0)=" . Q:'FBFNDAUT  ; no selected MST authorizations for patient"
^XMB(3.9,146052,2,1019,0)="""RTN"",""FBAAMST"",84,0)"
^XMB(3.9,146052,2,1020,0)=" . ; loop thru vendor multiple"
^XMB(3.9,146052,2,1021,0)="""RTN"",""FBAAMST"",85,0)"
^XMB(3.9,146052,2,1022,0)=" . S FBV=0 F  S FBV=$O(^FBAAC(FBDFN,1,FBV)) Q:'FBV  D"
^XMB(3.9,146052,2,1023,0)="""RTN"",""FBAAMST"",86,0)"
^XMB(3.9,146052,2,1024,0)=" . . ; loop thru initial treatment date multiple"
^XMB(3.9,146052,2,1025,0)="""RTN"",""FBAAMST"",87,0)"
^XMB(3.9,146052,2,1026,0)=" . . S FBTDI=0 F  S FBTDI=$O(^FBAAC(FBDFN,1,FBV,1,FBTDI)) Q:'FBTDI  D"
^XMB(3.9,146052,2,1027,0)="""RTN"",""FBAAMST"",88,0)"
^XMB(3.9,146052,2,1028,0)=" . . . S FBY2=$G(^FBAAC(FBDFN,1,FBV,1,FBTDI,0))"
^XMB(3.9,146052,2,1029,0)="""RTN"",""FBAAMST"",89,0)"
^XMB(3.9,146052,2,1030,0)=" . . . Q:$P(FBY2,U)<FBDT1  ; date of service prior to report start"
^XMB(3.9,146052,2,1031,0)="""RTN"",""FBAAMST"",90,0)"
^XMB(3.9,146052,2,1032,0)=" . . . Q:$P(FBY2,U)>FBDT2  ; date of service after report end"
^XMB(3.9,146052,2,1033,0)="""RTN"",""FBAAMST"",91,0)"
^XMB(3.9,146052,2,1034,0)=" . . . S FBATO=$P($G(^FBAAA(FBDFN,1,$P(FBY2,U,4),0)),U,2) ; auth to date"
^XMB(3.9,146052,2,1035,0)="""RTN"",""FBAAMST"",92,0)"
^XMB(3.9,146052,2,1036,0)=" . . . Q:'$D(^TMP($J,""FBA"",FBPNAME_U_FBDFN,FBATO_U_$P(FBY2,U,4)))  ; not one of the selected authorizations"
^XMB(3.9,146052,2,1037,0)="""RTN"",""FBAAMST"",93,0)"
^XMB(3.9,146052,2,1038,0)=" . . . ; loop thru service provided multiple"
^XMB(3.9,146052,2,1039,0)="""RTN"",""FBAAMST"",94,0)"
^XMB(3.9,146052,2,1040,0)=" . . . S FBSPI=0"
^XMB(3.9,146052,2,1041,0)="""RTN"",""FBAAMST"",95,0)"
^XMB(3.9,146052,2,1042,0)=" . . . F  S FBSPI=$O(^FBAAC(FBDFN,1,FBV,1,FBTDI,1,FBSPI)) Q:'FBSPI  D"
^XMB(3.9,146052,2,1043,0)="""RTN"",""FBAAMST"",96,0)"
^XMB(3.9,146052,2,1044,0)=" . . . . S FBY3=$G(^FBAAC(FBDFN,1,FBV,1,FBTDI,1,FBSPI,0))"
^XMB(3.9,146052,2,1045,0)="""RTN"",""FBAAMST"",97,0)"
^XMB(3.9,146052,2,1046,0)=" . . . . Q:$P(FBY3,U,6)=""""  ; not finalized"
^XMB(3.9,146052,2,1047,0)="""RTN"",""FBAAMST"",98,0)"
^XMB(3.9,146052,2,1048,0)=" . . . . S ^TMP($J,""FBA"",FBPNAME_U_FBDFN,FBATO_U_$P(FBY2,U,4),$P(FBY2,U)_U_FBSPI_"",""_FBTDI_"",""_FBV_"",""_FBDFN_"","")="""""
^XMB(3.9,146052,2,1049,0)="""RTN"",""FBAAMST"",99,0)"
^XMB(3.9,146052,2,1050,0)=" . . . . S FBT(""AMTPAID"",FBGEN)=FBT(""AMTPAID"",FBGEN)+$P(FBY3,U,3)"
^XMB(3.9,146052,2,1051,0)="""RTN"",""FBAAMST"",100,0)"
^XMB(3.9,146052,2,1052,0)=" . . . . I '$D(^TMP($J,""FBV"",FBDFN,$P(FBY2,U))) D"
^XMB(3.9,146052,2,1053,0)="""RTN"",""FBAAMST"",101,0)"
^XMB(3.9,146052,2,1054,0)=" . . . . . ; new visit"
^XMB(3.9,146052,2,1055,0)="""RTN"",""FBAAMST"",102,0)"
^XMB(3.9,146052,2,1056,0)=" . . . . . S FBT(""VISIT"",FBGEN)=FBT(""VISIT"",FBGEN)+1"
^XMB(3.9,146052,2,1057,0)="""RTN"",""FBAAMST"",103,0)"
^XMB(3.9,146052,2,1058,0)=" . . . . . S ^TMP($J,""FBV"",FBDFN,$P(FBY2,U))="""""
^XMB(3.9,146052,2,1059,0)="""RTN"",""FBAAMST"",104,0)"
^XMB(3.9,146052,2,1060,0)=" ;"
^XMB(3.9,146052,2,1061,0)="""RTN"",""FBAAMST"",105,0)"
^XMB(3.9,146052,2,1062,0)="PRINT ; report data"
^XMB(3.9,146052,2,1063,0)="""RTN"",""FBAAMST"",106,0)"
^XMB(3.9,146052,2,1064,0)=" S FBPG=0 D NOW^%DTC S Y=% D DD^%DT S FBDTR=Y"
^XMB(3.9,146052,2,1065,0)="""RTN"",""FBAAMST"",107,0)"
^XMB(3.9,146052,2,1066,0)=" K FBDL S FBDL="""",$P(FBDL,""-"",IOM)="""""
^XMB(3.9,146052,2,1067,0)="""RTN"",""FBAAMST"",108,0)"
^XMB(3.9,146052,2,1068,0)=" ;"
^XMB(3.9,146052,2,1069,0)="""RTN"",""FBAAMST"",109,0)"
^XMB(3.9,146052,2,1070,0)=" ; build page header text for selection criteria"
^XMB(3.9,146052,2,1071,0)="""RTN"",""FBAAMST"",110,0)"
^XMB(3.9,146052,2,1072,0)=" K FBHDT"
^XMB(3.9,146052,2,1073,0)="""RTN"",""FBAAMST"",111,0)"
^XMB(3.9,146052,2,1074,0)=" S FBHDT(1)=""  For ""_$$FMTE^XLFDT(FBDT1)_"" through ""_$$FMTE^XLFDT(FBDT2)"
^XMB(3.9,146052,2,1075,0)="""RTN"",""FBAAMST"",112,0)"
^XMB(3.9,146052,2,1076,0)=" ;"
^XMB(3.9,146052,2,1077,0)="""RTN"",""FBAAMST"",113,0)"
^XMB(3.9,146052,2,1078,0)=" ;"
^XMB(3.9,146052,2,1079,0)="""RTN"",""FBAAMST"",114,0)"
^XMB(3.9,146052,2,1080,0)=" D HD"
^XMB(3.9,146052,2,1081,0)="""RTN"",""FBAAMST"",115,0)"
^XMB(3.9,146052,2,1082,0)=" I 'FBQUIT,'$D(^TMP($J)) W !,""No MST authorizations found during period."""
^XMB(3.9,146052,2,1083,0)="""RTN"",""FBAAMST"",116,0)"
^XMB(3.9,146052,2,1084,0)=" I 'FBQUIT,FBDETAIL D"
^XMB(3.9,146052,2,1085,0)="""RTN"",""FBAAMST"",117,0)"
^XMB(3.9,146052,2,1086,0)=" . ; loop thru veterans"
^XMB(3.9,146052,2,1087,0)="""RTN"",""FBAAMST"",118,0)"
^XMB(3.9,146052,2,1088,0)=" . S FBPAT="""""
^XMB(3.9,146052,2,1089,0)="""RTN"",""FBAAMST"",119,0)"
^XMB(3.9,146052,2,1090,0)=" . F  S FBPAT=$O(^TMP($J,""FBA"",FBPAT)) Q:FBPAT=""""  D  Q:FBQUIT"
^XMB(3.9,146052,2,1091,0)="""RTN"",""FBAAMST"",120,0)"
^XMB(3.9,146052,2,1092,0)=" . . S FBPNAME=$P(FBPAT,U)"
^XMB(3.9,146052,2,1093,0)="""RTN"",""FBAAMST"",121,0)"
^XMB(3.9,146052,2,1094,0)=" . . S FBDFN=$P(FBPAT,U,2)"
^XMB(3.9,146052,2,1095,0)="""RTN"",""FBAAMST"",122,0)"
^XMB(3.9,146052,2,1096,0)=" . . S FBX=$G(^TMP($J,""FBA"",FBPAT))"
^XMB(3.9,146052,2,1097,0)="""RTN"",""FBAAMST"",123,0)"
^XMB(3.9,146052,2,1098,0)=" . . W !!,FBPNAME,?40,""Patient ID: "",$P(FBX,U),?67,""Gender: "",$P(FBX,U,2)"
^XMB(3.9,146052,2,1099,0)="""RTN"",""FBAAMST"",124,0)"
^XMB(3.9,146052,2,1100,0)=" . . ; loop thru authorizations"
^XMB(3.9,146052,2,1101,0)="""RTN"",""FBAAMST"",125,0)"
^XMB(3.9,146052,2,1102,0)=" . . S FBAUT="""""
^XMB(3.9,146052,2,1103,0)="""RTN"",""FBAAMST"",126,0)"
^XMB(3.9,146052,2,1104,0)=" . . F  S FBAUT=$O(^TMP($J,""FBA"",FBPAT,FBAUT)) Q:FBAUT=""""  D  Q:FBQUIT"
^XMB(3.9,146052,2,1105,0)="""RTN"",""FBAAMST"",127,0)"
^XMB(3.9,146052,2,1106,0)=" . . . S FBAU=$P(FBAUT,U,2)"
^XMB(3.9,146052,2,1107,0)="""RTN"",""FBAAMST"",128,0)"
^XMB(3.9,146052,2,1108,0)=" . . . S FBA=^TMP($J,""FBA"",FBPAT,FBAUT)"
^XMB(3.9,146052,2,1109,0)="""RTN"",""FBAAMST"",129,0)"
^XMB(3.9,146052,2,1110,0)=" . . . I $Y+9>IOSL D HD Q:FBQUIT  D HDPAT"
^XMB(3.9,146052,2,1111,0)="""RTN"",""FBAAMST"",130,0)"
^XMB(3.9,146052,2,1112,0)=" . . . W !!,?2,""Authorization #: "",FBDFN,""-"",FBAU"
^XMB(3.9,146052,2,1113,0)="""RTN"",""FBAAMST"",131,0)"
^XMB(3.9,146052,2,1114,0)=" . . . W ?32,""FR: "",$$FMTE^XLFDT($P(FBA,U),""2DF"")"
^XMB(3.9,146052,2,1115,0)="""RTN"",""FBAAMST"",132,0)"
^XMB(3.9,146052,2,1116,0)=" . . . W ?47,""TO: "",$$FMTE^XLFDT($P(FBA,U,2),""2DF"")"
^XMB(3.9,146052,2,1117,0)="""RTN"",""FBAAMST"",133,0)"
^XMB(3.9,146052,2,1118,0)=" . . . ; loop thru payments"
^XMB(3.9,146052,2,1119,0)="""RTN"",""FBAAMST"",134,0)"
^XMB(3.9,146052,2,1120,0)=" . . . I $O(^TMP($J,""FBA"",FBPAT,FBAUT,""""))']"""" W !!,?4,""No finalized payments on file."""
^XMB(3.9,146052,2,1121,0)="""RTN"",""FBAAMST"",135,0)"
^XMB(3.9,146052,2,1122,0)=" . . . E  S FBPAY="""" F  S FBPAY=$O(^TMP($J,""FBA"",FBPAT,FBAUT,FBPAY)) Q:FBPAY=""""  D  Q:FBQUIT"
^XMB(3.9,146052,2,1123,0)="""RTN"",""FBAAMST"",136,0)"
^XMB(3.9,146052,2,1124,0)=" . . . . S FBIENS=$P(FBPAY,U,2)"
^XMB(3.9,146052,2,1125,0)="""RTN"",""FBAAMST"",137,0)"
^XMB(3.9,146052,2,1126,0)=" . . . . S FBV=$P(FBIENS,"","",3)"
^XMB(3.9,146052,2,1127,0)="""RTN"",""FBAAMST"",138,0)"
^XMB(3.9,146052,2,1128,0)=" . . . . S FBTDI=$P(FBIENS,"","",2)"
^XMB(3.9,146052,2,1129,0)="""RTN"",""FBAAMST"",139,0)"
^XMB(3.9,146052,2,1130,0)=" . . . . S FBSPI=$P(FBIENS,"","",1)"
^XMB(3.9,146052,2,1131,0)="""RTN"",""FBAAMST"",140,0)"
^XMB(3.9,146052,2,1132,0)=" . . . . S FBVY=$S(FBV:$G(^FBAAV(FBV,0)),1:"""")"
^XMB(3.9,146052,2,1133,0)="""RTN"",""FBAAMST"",141,0)"
^XMB(3.9,146052,2,1134,0)=" . . . . S FBAACPT=$$GET1^DIQ(162.03,FBIENS,.01)"
^XMB(3.9,146052,2,1135,0)="""RTN"",""FBAAMST"",142,0)"
^XMB(3.9,146052,2,1136,0)=" . . . . S FBMODLE=$$MODL^FBAAUTL4(""^FBAAC(""_FBDFN_"",1,""_FBV_"",1,""_FBTDI_"",1,""_FBSPI_"",""""M"""")"",""E"")"
^XMB(3.9,146052,2,1137,0)="""RTN"",""FBAAMST"",143,0)"
^XMB(3.9,146052,2,1138,0)=" . . . . I $Y+7>IOSL D HD Q:FBQUIT  D HDPAT,HDAUT"
^XMB(3.9,146052,2,1139,0)="""RTN"",""FBAAMST"",144,0)"
^XMB(3.9,146052,2,1140,0)=" . . . . W !!,?4,""Svc Date: "",$$FMTE^XLFDT($P(FBPAY,U),""2DF"")"
^XMB(3.9,146052,2,1141,0)="""RTN"",""FBAAMST"",145,0)"
^XMB(3.9,146052,2,1142,0)=" . . . . W ?24,""CPT-MOD: """
^XMB(3.9,146052,2,1143,0)="""RTN"",""FBAAMST"",146,0)"
^XMB(3.9,146052,2,1144,0)=" . . . . W FBAACPT_$S($G(FBMODLE)]"""":""-""_$P(FBMODLE,"",""),1:"""")"
^XMB(3.9,146052,2,1145,0)="""RTN"",""FBAAMST"",147,0)"
^XMB(3.9,146052,2,1146,0)=" . . . . W ?43,""DIAG: "",$$GET1^DIQ(162.03,FBIENS,28)"
^XMB(3.9,146052,2,1147,0)="""RTN"",""FBAAMST"",148,0)"
^XMB(3.9,146052,2,1148,0)=" . . . . W ?58,""AMT PAID: "",$J($$GET1^DIQ(162.03,FBIENS,2,""I""),9,2)"
^XMB(3.9,146052,2,1149,0)="""RTN"",""FBAAMST"",149,0)"
^XMB(3.9,146052,2,1150,0)=" . . . . I $P($G(FBMODLE),"","",2)]"""" D  Q:FBQUIT"
^XMB(3.9,146052,2,1151,0)="""RTN"",""FBAAMST"",150,0)"
^XMB(3.9,146052,2,1152,0)=" . . . . . N FBI,FBMOD"
^XMB(3.9,146052,2,1153,0)="""RTN"",""FBAAMST"",151,0)"
^XMB(3.9,146052,2,1154,0)=" . . . . . F FBI=2:1 S FBMOD=$P(FBMODLE,"","",FBI) Q:FBMOD=""""  D  Q:FBQUIT"
^XMB(3.9,146052,2,1155,0)="""RTN"",""FBAAMST"",152,0)"
