^XMB(3.9,146020,2,414,0)=" W !"
^XMB(3.9,146020,2,415,0)="""RTN"",""MPIFVER"",86,0)"
^XMB(3.9,146020,2,416,0)=" D ASK I ENOUGH G ASK2"
^XMB(3.9,146020,2,417,0)="""RTN"",""MPIFVER"",87,0)"
^XMB(3.9,146020,2,418,0)=" I XCNT'="""" W !,""Please wait..."" D EXDISP(XCNT)"
