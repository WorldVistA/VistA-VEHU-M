^XMB(3.9,146056,2,1690,0)=" D POST^VPRHS(DFN,""MemberEnrollment"",ID_"";2.312"")"
^XMB(3.9,146056,2,1691,0)="""RTN"",""VPREVNT"",219,0)"
^XMB(3.9,146056,2,1692,0)=" Q"
^XMB(3.9,146056,2,1693,0)="""RTN"",""VPREVNT"",220,0)"
^XMB(3.9,146056,2,1694,0)=" ;"
^XMB(3.9,146056,2,1695,0)="""RTN"",""VPREVNT"",221,0)"
^XMB(3.9,146056,2,1696,0)="PCMMT ; -- SCMC PATIENT TEAM CHANGES protocol listener"
^XMB(3.9,146056,2,1697,0)="""RTN"",""VPREVNT"",222,0)"
^XMB(3.9,146056,2,1698,0)=" ;    [expects SCPTTM* variables]"
^XMB(3.9,146056,2,1699,0)="""RTN"",""VPREVNT"",223,0)"
^XMB(3.9,146056,2,1700,0)=" ;I '$G(SCPCTM) Q  ;not pc change"
^XMB(3.9,146056,2,1701,0)="""RTN"",""VPREVNT"",224,0)"
^XMB(3.9,146056,2,1702,0)=" N DFN S DFN=$S($G(SCPTTMAF):+SCPTTMAF,1:+$G(SCPTTMB4)) Q:'DFN"
^XMB(3.9,146056,2,1703,0)="""RTN"",""VPREVNT"",225,0)"
^XMB(3.9,146056,2,1704,0)=" D QUE^VPRHS(DFN) ;POST^VPRHS(DFN,""Patient"",DFN_"";2"")"
^XMB(3.9,146056,2,1705,0)="""RTN"",""VPREVNT"",226,0)"
^XMB(3.9,146056,2,1706,0)=" Q"
^XMB(3.9,146056,2,1707,0)="""RTN"",""VPREVNT"",227,0)"
^XMB(3.9,146056,2,1708,0)=" ;"
^XMB(3.9,146056,2,1709,0)="""RTN"",""VPREVNT"",228,0)"
^XMB(3.9,146056,2,1710,0)="PCMMTP ; -- SCMC PATIENT TEAM POSITION CHANGES protocol listener"
^XMB(3.9,146056,2,1711,0)="""RTN"",""VPREVNT"",229,0)"
^XMB(3.9,146056,2,1712,0)=" ;    [expects SCPTTP* variables]"
^XMB(3.9,146056,2,1713,0)="""RTN"",""VPREVNT"",230,0)"
^XMB(3.9,146056,2,1714,0)=" ;I '$G(SCPCTP) Q  ;not pc change"
^XMB(3.9,146056,2,1715,0)="""RTN"",""VPREVNT"",231,0)"
^XMB(3.9,146056,2,1716,0)=" N TM,DFN"
^XMB(3.9,146056,2,1717,0)="""RTN"",""VPREVNT"",232,0)"
^XMB(3.9,146056,2,1718,0)=" S TM=$S($G(SCPTTPAF):+SCPTTPAF,1:+$G(SCPTTPB4)) Q:'TM"
^XMB(3.9,146056,2,1719,0)="""RTN"",""VPREVNT"",233,0)"
^XMB(3.9,146056,2,1720,0)=" S DFN=+$$GET1^DIQ(404.42,TM_"","",.01,""I"")"
^XMB(3.9,146056,2,1721,0)="""RTN"",""VPREVNT"",234,0)"
^XMB(3.9,146056,2,1722,0)=" D QUE^VPRHS(DFN) ;POST^VPRHS(DFN,""Patient"",DFN_"";2"")"
^XMB(3.9,146056,2,1723,0)="""RTN"",""VPREVNT"",235,0)"
^XMB(3.9,146056,2,1724,0)=" Q"
^XMB(3.9,146056,2,1725,0)="""RTN"",""VPREVNT"",236,0)"
^XMB(3.9,146056,2,1726,0)=" ;"
^XMB(3.9,146056,2,1727,0)="""RTN"",""VPREVNT"",237,0)"
^XMB(3.9,146056,2,1728,0)="WV ; -- WV PREGNANCY STATUS CHANGE EVENT protocol listener"
^XMB(3.9,146056,2,1729,0)="""RTN"",""VPREVNT"",238,0)"
^XMB(3.9,146056,2,1730,0)=" N VPRPREG,VPRDFN,VPRFLD,VPRFLAG"
^XMB(3.9,146056,2,1731,0)="""RTN"",""VPREVNT"",239,0)"
^XMB(3.9,146056,2,1732,0)=" M VPRPREG=^TMP(""WVPREGST"",$J)"
^XMB(3.9,146056,2,1733,0)="""RTN"",""VPREVNT"",240,0)"
^XMB(3.9,146056,2,1734,0)=" Q:'$D(VPRPREG)"
^XMB(3.9,146056,2,1735,0)="""RTN"",""VPREVNT"",241,0)"
^XMB(3.9,146056,2,1736,0)=" S VPRDFN=+$P($G(VPRPREG(""AFTER"",""EXTERNAL ID"")),"","",2)"
^XMB(3.9,146056,2,1737,0)="""RTN"",""VPREVNT"",242,0)"
^XMB(3.9,146056,2,1738,0)=" Q:VPRDFN=0"
^XMB(3.9,146056,2,1739,0)="""RTN"",""VPREVNT"",243,0)"
^XMB(3.9,146056,2,1740,0)=" ; if no before value, then new record, post"
^XMB(3.9,146056,2,1741,0)="""RTN"",""VPREVNT"",244,0)"
^XMB(3.9,146056,2,1742,0)=" I '$D(VPRPREG(""BEFORE"")) D POST^VPRHS(VPRDFN,""SocialHistory"",VPRDFN_"";790.05"") Q"
^XMB(3.9,146056,2,1743,0)="""RTN"",""VPREVNT"",245,0)"
^XMB(3.9,146056,2,1744,0)=" Q:VPRDFN'=+$P($G(VPRPREG(""BEFORE"",""EXTERNAL ID"")),"","",2)"
^XMB(3.9,146056,2,1745,0)="""RTN"",""VPREVNT"",246,0)"
^XMB(3.9,146056,2,1746,0)=" ; if external ids do not match, then additional record, post"
^XMB(3.9,146056,2,1747,0)="""RTN"",""VPREVNT"",247,0)"
^XMB(3.9,146056,2,1748,0)=" I $G(VPRPREG(""BEFORE"",""EXTERNAL ID""))'=$G(VPRPREG(""AFTER"",""EXTERNAL ID"")) D POST^VPRHS(VPRDFN,""SocialHistory"",VPRDFN_"";790.05"") Q"
^XMB(3.9,146056,2,1749,0)="""RTN"",""VPREVNT"",248,0)"
^XMB(3.9,146056,2,1750,0)=" ; if change in fields we send to HS, post"
^XMB(3.9,146056,2,1751,0)="""RTN"",""VPREVNT"",249,0)"
^XMB(3.9,146056,2,1752,0)=" S VPRFLAG=0"
^XMB(3.9,146056,2,1753,0)="""RTN"",""VPREVNT"",250,0)"
^XMB(3.9,146056,2,1754,0)=" F VPRFLD=""FROM TIME"",""STATE"",""STATUS"",""TO TIME"" S:$G(VPRPREG(""BEFORE"",VPRFLD))'=$G(VPRPREG(""AFTER"",VPRFLD)) VPRFLAG=1 Q:VPRFLAG=1"
^XMB(3.9,146056,2,1755,0)="""RTN"",""VPREVNT"",251,0)"
^XMB(3.9,146056,2,1756,0)=" I VPRFLAG=1 D POST^VPRHS(VPRDFN,""SocialHistory"",VPRDFN_"";790.05"")"
^XMB(3.9,146056,2,1757,0)="""RTN"",""VPREVNT"",252,0)"
^XMB(3.9,146056,2,1758,0)=" Q"
^XMB(3.9,146056,2,1759,0)="""RTN"",""VPREVNT"",253,0)"
^XMB(3.9,146056,2,1760,0)=" ;"
^XMB(3.9,146056,2,1761,0)="""RTN"",""VPREVNT"",254,0)"
