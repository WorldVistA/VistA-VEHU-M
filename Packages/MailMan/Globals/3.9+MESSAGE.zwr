^XMB(3.9,146036,2,3152,0)=" ;BG CAPRI-8883"
^XMB(3.9,146036,2,3153,0)="""RTN"",""DVBUTIL"",21,0)"
^XMB(3.9,146036,2,3154,0)=" I DVBLOCK=""L"" D"
^XMB(3.9,146036,2,3155,0)="""RTN"",""DVBUTIL"",22,0)"
^XMB(3.9,146036,2,3156,0)=" .I DVBLOCKSTA'="""" D"
^XMB(3.9,146036,2,3157,0)="""RTN"",""DVBUTIL"",23,0)"
^XMB(3.9,146036,2,3158,0)=" ..I $P(DVBLOCKSTA,"":"",3)=DUZ S DVBRETURN=""1"" Q"
^XMB(3.9,146036,2,3159,0)="""RTN"",""DVBUTIL"",24,0)"
^XMB(3.9,146036,2,3160,0)=" ..I $P(DVBLOCKSTA,"":"",3)'=DUZ S DVBRETURN=""-1^Current worksheet is locked by ""_$P(DVBLOCKSTA,""@"",1)_"" and cannot be viewed, edited, copied or deleted at this time"" Q"
^XMB(3.9,146036,2,3161,0)="""RTN"",""DVBUTIL"",25,0)"
^XMB(3.9,146036,2,3162,0)=" .I DVBLOCKSTA="""" D"
