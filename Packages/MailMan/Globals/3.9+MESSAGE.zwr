^XMB(3.9,146089,2,2116,0)="INP I '$G(PSOXFLG),'$G(PSOFIN),$G(PSOPTPST(2,PSODFN,.1))]"""" S PSOXFLG=1,SSN=$P(^DPT(PSODFN,0),""^"",9) W !!?10,$C(7),PSORX(""NAME"")_"" (""_$E(SSN,1,3)_""-""_$E(SSN,4,5)_""-""_$E(SSN,6,9)_"")"" K SSN"
