^XMB(3.9,146096,2,251,0)="""RTN"",""MAGVAQ01"",1,0)"
^XMB(3.9,146096,2,252,0)="MAGVAQ01 ;WOIFO/NST - Utilities for RPC calls ; 28 Feb 2013 9:58 AM"
^XMB(3.9,146096,2,253,0)="""RTN"",""MAGVAQ01"",2,0)"
^XMB(3.9,146096,2,254,0)=" ;;3.0;IMAGING;**118**;Mar 19, 2002;Build 0;May 01, 2013"
^XMB(3.9,146096,2,255,0)="""RTN"",""MAGVAQ01"",3,0)"
^XMB(3.9,146096,2,256,0)=" ;; Per VHA Directive 2004-038, this routine should not be modified."
^XMB(3.9,146096,2,257,0)="""RTN"",""MAGVAQ01"",4,0)"
^XMB(3.9,146096,2,258,0)=" ;; +---------------------------------------------------------------+"
^XMB(3.9,146096,2,259,0)="""RTN"",""MAGVAQ01"",5,0)"
^XMB(3.9,146096,2,260,0)=" ;; | Property of the US Government.                                |"
^XMB(3.9,146096,2,261,0)="""RTN"",""MAGVAQ01"",6,0)"
^XMB(3.9,146096,2,262,0)=" ;; | No permission to copy or redistribute this software is given. |"
^XMB(3.9,146096,2,263,0)="""RTN"",""MAGVAQ01"",7,0)"
^XMB(3.9,146096,2,264,0)=" ;; | Use of unreleased versions of this software requires the user |"
^XMB(3.9,146096,2,265,0)="""RTN"",""MAGVAQ01"",8,0)"
^XMB(3.9,146096,2,266,0)=" ;; | to execute a written test agreement with the VistA Imaging    |"
^XMB(3.9,146096,2,267,0)="""RTN"",""MAGVAQ01"",9,0)"
^XMB(3.9,146096,2,268,0)=" ;; | Development Office of the Department of Veterans Affairs,     |"
^XMB(3.9,146096,2,269,0)="""RTN"",""MAGVAQ01"",10,0)"
^XMB(3.9,146096,2,270,0)=" ;; | telephone (301) 734-0100.                                     |"
^XMB(3.9,146096,2,271,0)="""RTN"",""MAGVAQ01"",11,0)"
^XMB(3.9,146096,2,272,0)=" ;; | The Food and Drug Administration classifies this software as  |"
^XMB(3.9,146096,2,273,0)="""RTN"",""MAGVAQ01"",12,0)"
^XMB(3.9,146096,2,274,0)=" ;; | a medical device.  As such, it may not be changed in any way. |"
^XMB(3.9,146096,2,275,0)="""RTN"",""MAGVAQ01"",13,0)"
^XMB(3.9,146096,2,276,0)=" ;; | Modifications to this software may result in an adulterated   |"
^XMB(3.9,146096,2,277,0)="""RTN"",""MAGVAQ01"",14,0)"
^XMB(3.9,146096,2,278,0)=" ;; | medical device under 21CFR820, the use of which is considered |"
^XMB(3.9,146096,2,279,0)="""RTN"",""MAGVAQ01"",15,0)"
^XMB(3.9,146096,2,280,0)=" ;; | to be a violation of US Federal Statutes.                     |"
^XMB(3.9,146096,2,281,0)="""RTN"",""MAGVAQ01"",16,0)"
^XMB(3.9,146096,2,282,0)=" ;; +---------------------------------------------------------------+"
^XMB(3.9,146096,2,283,0)="""RTN"",""MAGVAQ01"",17,0)"
^XMB(3.9,146096,2,284,0)=" ;;"
^XMB(3.9,146096,2,285,0)="""RTN"",""MAGVAQ01"",18,0)"
^XMB(3.9,146096,2,286,0)=" Q"
^XMB(3.9,146096,2,287,0)="""RTN"",""MAGVAQ01"",19,0)"
^XMB(3.9,146096,2,288,0)=" ;*****  Add a record to QUEUE file (#2006.927)"
^XMB(3.9,146096,2,289,0)="""RTN"",""MAGVAQ01"",20,0)"
^XMB(3.9,146096,2,290,0)=" ;       "
^XMB(3.9,146096,2,291,0)="""RTN"",""MAGVAQ01"",21,0)"
^XMB(3.9,146096,2,292,0)=" ; RPC: MAGVA CREATE QUEUE"
^XMB(3.9,146096,2,293,0)="""RTN"",""MAGVAQ01"",22,0)"
^XMB(3.9,146096,2,294,0)=" ; "
^XMB(3.9,146096,2,295,0)="""RTN"",""MAGVAQ01"",23,0)"
^XMB(3.9,146096,2,296,0)=" ; Input Parameters"
^XMB(3.9,146096,2,297,0)="""RTN"",""MAGVAQ01"",24,0)"
^XMB(3.9,146096,2,298,0)=" ; ================"
^XMB(3.9,146096,2,299,0)="""RTN"",""MAGVAQ01"",25,0)"
^XMB(3.9,146096,2,300,0)=" ; "
^XMB(3.9,146096,2,301,0)="""RTN"",""MAGVAQ01"",26,0)"
^XMB(3.9,146096,2,302,0)=" ;   MAGPARAM(""NAME"")"
^XMB(3.9,146096,2,303,0)="""RTN"",""MAGVAQ01"",27,0)"
^XMB(3.9,146096,2,304,0)=" ;   MAGPARAM(""ACTIVE"") = 0/1"
^XMB(3.9,146096,2,305,0)="""RTN"",""MAGVAQ01"",28,0)"
^XMB(3.9,146096,2,306,0)=" ;   MAGPARAM(""QUEUE TYPE"")"
^XMB(3.9,146096,2,307,0)="""RTN"",""MAGVAQ01"",29,0)"
^XMB(3.9,146096,2,308,0)=" ;   MAGPARAM(""NUM RETRIES"")"
^XMB(3.9,146096,2,309,0)="""RTN"",""MAGVAQ01"",30,0)"
^XMB(3.9,146096,2,310,0)=" ;   MAGPARAM(""RETRY DELAY IN SECONDS"")"
^XMB(3.9,146096,2,311,0)="""RTN"",""MAGVAQ01"",31,0)"
^XMB(3.9,146096,2,312,0)=" ;   MAGPARAM(""TRIGGER DELAY IN SECONDS"")"
^XMB(3.9,146096,2,313,0)="""RTN"",""MAGVAQ01"",32,0)"
^XMB(3.9,146096,2,314,0)=" ; "
^XMB(3.9,146096,2,315,0)="""RTN"",""MAGVAQ01"",33,0)"
^XMB(3.9,146096,2,316,0)=" ; Return Values"
^XMB(3.9,146096,2,317,0)="""RTN"",""MAGVAQ01"",34,0)"
^XMB(3.9,146096,2,318,0)=" ; ============="
^XMB(3.9,146096,2,319,0)="""RTN"",""MAGVAQ01"",35,0)"
^XMB(3.9,146096,2,320,0)=" ; if error MAGRY = Failure status ^ Error message^"
^XMB(3.9,146096,2,321,0)="""RTN"",""MAGVAQ01"",36,0)"
^XMB(3.9,146096,2,322,0)=" ; if success MAGRY = Success status ^^IEN - IEN of the new record "
^XMB(3.9,146096,2,323,0)="""RTN"",""MAGVAQ01"",37,0)"
^XMB(3.9,146096,2,324,0)=" ;"
^XMB(3.9,146096,2,325,0)="""RTN"",""MAGVAQ01"",38,0)"
^XMB(3.9,146096,2,326,0)="ADDQUEUE(MAGRY,MAGPARAM) ; RPC [MAGVA CREATE QUEUE]"
