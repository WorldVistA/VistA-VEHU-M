^XMB(3.9,146087,2,599,0)="""RTN"",""YTQAPI1"",127,0)"
^XMB(3.9,146087,2,600,0)=" Q"
^XMB(3.9,146087,2,601,0)="""RTN"",""YTQAPI1"",128,0)"
^XMB(3.9,146087,2,602,0)="SRC(ANAME) ; return IEN for entry source, adding if needed"
^XMB(3.9,146087,2,603,0)="""RTN"",""YTQAPI1"",129,0)"
