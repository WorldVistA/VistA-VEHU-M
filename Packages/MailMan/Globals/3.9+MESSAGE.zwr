^XMB(3.9,146087,2,854,0)="FILADMIN(DATA)  ;Get YSARR and file mh administration"
^XMB(3.9,146087,2,855,0)="""RTN"",""YTQRCDB"",108,0)"
^XMB(3.9,146087,2,856,0)=" ; Expects required MH ADMINISTRATION fields in DATA(prop)"
