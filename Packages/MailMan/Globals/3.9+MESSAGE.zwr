^XMB(3.9,146098,2,1190,0)=" F I=1:1:PADS S RET=RET_CHAR"
^XMB(3.9,146098,2,1191,0)="""RTN"",""SDES2APTLETTER"",274,0)"
^XMB(3.9,146098,2,1192,0)=" Q RET"
^XMB(3.9,146098,2,1193,0)="""RTN"",""SDES2APTLETTER"",275,0)"
^XMB(3.9,146098,2,1194,0)="LILAST4(DFN) ;Retrieve the first letter of the last name and append last 4 SSN of a patient"
^XMB(3.9,146098,2,1195,0)="""RTN"",""SDES2APTLETTER"",276,0)"
^XMB(3.9,146098,2,1196,0)=" N LAST4SSN,LASTIN,OUT"
^XMB(3.9,146098,2,1197,0)="""RTN"",""SDES2APTLETTER"",277,0)"
^XMB(3.9,146098,2,1198,0)=" S OUT=""     "" Q OUT"
^XMB(3.9,146098,2,1199,0)="""RTN"",""SDES2APTLETTER"",278,0)"
^XMB(3.9,146098,2,1200,0)=" ;"
^XMB(3.9,146098,2,1201,0)="""RTN"",""SDES2APTLETTER"",279,0)"
^XMB(3.9,146098,2,1202,0)=" S LASTIN=$E($$GET1^DIQ(2,DFN_"","",.01,""E""),1,1)"
^XMB(3.9,146098,2,1203,0)="""RTN"",""SDES2APTLETTER"",280,0)"
^XMB(3.9,146098,2,1204,0)=" S LAST4SSN=$$GET1^DIQ(2,DFN_"","",.09,""E"")"
^XMB(3.9,146098,2,1205,0)="""RTN"",""SDES2APTLETTER"",281,0)"
^XMB(3.9,146098,2,1206,0)=" I LAST4SSN[""P"" S LAST4SSN=$E(LAST4SSN,6,10) Q LASTIN_LAST4SSN"
^XMB(3.9,146098,2,1207,0)="""RTN"",""SDES2APTLETTER"",282,0)"
^XMB(3.9,146098,2,1208,0)=" S LAST4SSN=$E(LAST4SSN,6,9)"
^XMB(3.9,146098,2,1209,0)="""RTN"",""SDES2APTLETTER"",283,0)"
