^XMB(3.9,146036,2,1760,0)="PURGEMET(DVBRTN,DUZ,DVBDTP) ;"
^XMB(3.9,146036,2,1761,0)="""RTN"",""DVBCPUSH"",137,0)"
^XMB(3.9,146036,2,1762,0)=" ;RPC: DVBA CAPRI PURGE MET"
^XMB(3.9,146036,2,1763,0)="""RTN"",""DVBCPUSH"",138,0)"
^XMB(3.9,146036,2,1764,0)=" ;input: DUZ user must have the DVBA METRICS DATA PURGE key"
^XMB(3.9,146036,2,1765,0)="""RTN"",""DVBCPUSH"",139,0)"
^XMB(3.9,146036,2,1766,0)=" ;     : Date to purge up to"
^XMB(3.9,146036,2,1767,0)="""RTN"",""DVBCPUSH"",140,0)"
^XMB(3.9,146036,2,1768,0)=" N DVBDT,DVBDA,DVBKEY,DVBDATE"
^XMB(3.9,146036,2,1769,0)="""RTN"",""DVBCPUSH"",141,0)"
^XMB(3.9,146036,2,1770,0)=" I DUZ="""" S DVBRTN=""0^Missing DUZ"" Q"
^XMB(3.9,146036,2,1771,0)="""RTN"",""DVBCPUSH"",142,0)"
^XMB(3.9,146036,2,1772,0)=" I DVBDTP="""" S DVBRTN=""0^Missing Date"" Q"
^XMB(3.9,146036,2,1773,0)="""RTN"",""DVBCPUSH"",143,0)"
^XMB(3.9,146036,2,1774,0)=" S X=DVBDTP D ^%DT S DVBDATE=Y"
^XMB(3.9,146036,2,1775,0)="""RTN"",""DVBCPUSH"",144,0)"
^XMB(3.9,146036,2,1776,0)=" D OWNSKEY^XUSRB(.DVBKEY,""DVBA CAPRI METRICS PURGE"",DUZ)"
^XMB(3.9,146036,2,1777,0)="""RTN"",""DVBCPUSH"",145,0)"
^XMB(3.9,146036,2,1778,0)=" I DVBKEY(0)=0 S DVBRTN=""0^Missing security key"" Q"
^XMB(3.9,146036,2,1779,0)="""RTN"",""DVBCPUSH"",146,0)"
^XMB(3.9,146036,2,1780,0)=" S DVBDT="""" F  S DVBDT=$O(^DVB(396.21,""B"",DVBDT)) Q:DVBDT=""""  D"
^XMB(3.9,146036,2,1781,0)="""RTN"",""DVBCPUSH"",147,0)"
^XMB(3.9,146036,2,1782,0)=" .S DVBDA="""" F  S DVBDA=$O(^DVB(396.21,""B"",DVBDT,DVBDA)) Q:DVBDA=""""  D"
^XMB(3.9,146036,2,1783,0)="""RTN"",""DVBCPUSH"",148,0)"
^XMB(3.9,146036,2,1784,0)=" ..I $P(DVBDT,""."")>DVBDATE Q"
^XMB(3.9,146036,2,1785,0)="""RTN"",""DVBCPUSH"",149,0)"
^XMB(3.9,146036,2,1786,0)=" ..K DIC,DA,DIK"
^XMB(3.9,146036,2,1787,0)="""RTN"",""DVBCPUSH"",150,0)"
^XMB(3.9,146036,2,1788,0)=" ..S DIC=""^DVB(396.21,"",DA=DVBDA"
^XMB(3.9,146036,2,1789,0)="""RTN"",""DVBCPUSH"",151,0)"
^XMB(3.9,146036,2,1790,0)=" ..S DIK=DIC D ^DIK K DIK,DIC"
^XMB(3.9,146036,2,1791,0)="""RTN"",""DVBCPUSH"",152,0)"
^XMB(3.9,146036,2,1792,0)=" ..S DVBRTN=1"
^XMB(3.9,146036,2,1793,0)="""RTN"",""DVBCPUSH"",153,0)"
^XMB(3.9,146036,2,1794,0)=" I $G(DVBRTN)'=1 S DVBRTN=""-1"""
^XMB(3.9,146036,2,1795,0)="""RTN"",""DVBCPUSH"",154,0)"
^XMB(3.9,146036,2,1796,0)=" Q"
^XMB(3.9,146036,2,1797,0)="""RTN"",""DVBCPUSH"",155,0)"
^XMB(3.9,146036,2,1798,0)="PURGEOPT ;"
^XMB(3.9,146036,2,1799,0)="""RTN"",""DVBCPUSH"",156,0)"
^XMB(3.9,146036,2,1800,0)=" W !!,""CAPRI CLINICAL DOCUMENTS EFOLDER METRIC DATA PURGE"",!!"
^XMB(3.9,146036,2,1801,0)="""RTN"",""DVBCPUSH"",157,0)"
^XMB(3.9,146036,2,1802,0)=" S DIR(""?"")=""Enter date to purge CAPRI Clinical Documents EFolder Metrics file up to.  For Example, to purge from today and older enter today's date"""
^XMB(3.9,146036,2,1803,0)="""RTN"",""DVBCPUSH"",158,0)"
^XMB(3.9,146036,2,1804,0)=" S DIR(""A"")=""Enter date to purge CAPRI Clinical Documents EFolder Metrics file."""
^XMB(3.9,146036,2,1805,0)="""RTN"",""DVBCPUSH"",159,0)"
^XMB(3.9,146036,2,1806,0)=" S DIR(0)=""D"" D ^DIR K DIR Q:$D(DIRUT)!($D(DTOUT))"
^XMB(3.9,146036,2,1807,0)="""RTN"",""DVBCPUSH"",160,0)"
^XMB(3.9,146036,2,1808,0)=" D PURGEMET(.DVBRTN,DUZ,Y)"
^XMB(3.9,146036,2,1809,0)="""RTN"",""DVBCPUSH"",161,0)"
^XMB(3.9,146036,2,1810,0)=" I DVBRTN[""Miss"" W !!,""Missing Security Key, please check with your manager for additional assistance"" Q"
^XMB(3.9,146036,2,1811,0)="""RTN"",""DVBCPUSH"",162,0)"
^XMB(3.9,146036,2,1812,0)=" I DVBRTN'=1 W !!,""No records were purged"",!! D PURGEOPT Q"
^XMB(3.9,146036,2,1813,0)="""RTN"",""DVBCPUSH"",163,0)"
^XMB(3.9,146036,2,1814,0)=" I DVBRTN=1 W !!,""Purge completed"""
^XMB(3.9,146036,2,1815,0)="""RTN"",""DVBCPUSH"",164,0)"
^XMB(3.9,146036,2,1816,0)=" Q"
^XMB(3.9,146036,2,1817,0)="""RTN"",""DVBCPUSH"",165,0)"
^XMB(3.9,146036,2,1818,0)="ALL(DVBLIST) ;"
^XMB(3.9,146036,2,1819,0)="""RTN"",""DVBCPUSH"",166,0)"
