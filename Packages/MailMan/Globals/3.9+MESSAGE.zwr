^XMB(3.9,146084,2,943,0)="""RTN"",""SDES2ADDDELCGI"",16,0)"
^XMB(3.9,146084,2,944,0)=" ;S SDCONTEXT(""USER DUZ"") = The DUZ of the user taking action in the calling application."
