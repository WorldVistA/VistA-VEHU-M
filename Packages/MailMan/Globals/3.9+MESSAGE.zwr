^XMB(3.9,146098,2,2456,0)=" ;"
^XMB(3.9,146098,2,2457,0)="""RTN"",""SDLT"",112,0)"
^XMB(3.9,146098,2,2458,0)=" S SDX=$G(^DPT(+DFN,0))"
