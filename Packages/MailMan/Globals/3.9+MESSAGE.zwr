^XMB(3.9,146107,2,481,0)="""RTN"",""PSJORUT2"",121,0)"
^XMB(3.9,146107,2,482,0)=" S ON=$O(DRGOC(0)),PSJORIEN="""" Q:'+ON"
^XMB(3.9,146107,2,483,0)="""RTN"",""PSJORUT2"",122,0)"
^XMB(3.9,146107,2,484,0)=" F PSIVX=0:0 S PSIVX=$O(DRGOC(ON,""AD"",PSIVX)) Q:'PSIVX  S DDRUG=$P(^PS(52.6,+DRGOC(ON,""AD"",PSIVX),0),U,2),COD=ON55 D DDRUG"
^XMB(3.9,146107,2,485,0)="""RTN"",""PSJORUT2"",123,0)"
