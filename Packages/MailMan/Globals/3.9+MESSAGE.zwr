^XMB(3.9,146084,2,3471,0)="""RTN"",""SDES2RECLLREQ2"",164,0)"
^XMB(3.9,146084,2,3472,0)=" I RECPPTDT=-1 S RECPPTDT=""""  ;VSE-2396"
