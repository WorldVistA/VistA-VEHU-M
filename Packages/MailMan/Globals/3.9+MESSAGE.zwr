^XMB(3.9,146017,2,2321,0)="""RTN"",""SDES2GETCLINAVL"",2,0)"
^XMB(3.9,146017,2,2322,0)=" ;;5.3;Scheduling;**880,887,898,901,902,909**;Aug 13, 1993;Build 0"
