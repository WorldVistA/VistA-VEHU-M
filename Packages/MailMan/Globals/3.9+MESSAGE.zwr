^XMB(3.9,146047,2,3636,0)="8.0^22.2"
^XMB(3.9,146047,2,3637,0)="""^DD"",2,2.342,.03,0)"
^XMB(3.9,146047,2,3638,0)="COMMENT^FX^^1;1^K:$L(X)>245!($L(X)<3) X"
