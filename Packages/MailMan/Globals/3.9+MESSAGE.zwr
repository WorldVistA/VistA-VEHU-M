^XMB(3.9,146012,2,1249,0)="""RTN"",""PSOERRX1"",33,0)"
^XMB(3.9,146012,2,1250,0)=" . S $E(FILTER,1)="""" I $L(FILTER)>63 S FILTER=$E(FILTER,1,60)_""..."""
^XMB(3.9,146012,2,1251,0)="""RTN"",""PSOERRX1"",34,0)"
^XMB(3.9,146012,2,1252,0)=" . S LINE2=""FILTERED BY: ""_IOINHI_FILTER_IOINORM"
^XMB(3.9,146012,2,1253,0)="""RTN"",""PSOERRX1"",35,0)"
^XMB(3.9,146012,2,1254,0)=" K VALMHDR S VALMHDR(1)=LINE1,VALMHDR(2)=LINE2 ;S:LINE3'="""" VALMHDR(3)=LINE3 S VALMHDR(4)=IOINORM"
