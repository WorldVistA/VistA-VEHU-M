^XMB(3.9,146009,2,267,0)="""RTN"",""XUIAMNPB"",1,0)"
^XMB(3.9,146009,2,268,0)="XUIAMNPB ;BHM/DRI - IAM BACKGROUND JOB TO TRANSMIT NEW PERSON DATA ;26-Feb-2025 11:02 AM"
^XMB(3.9,146009,2,269,0)="""RTN"",""XUIAMNPB"",2,0)"
^XMB(3.9,146009,2,270,0)=" ;;8.0;KERNEL;**799**;Jul 10, 1995;Build 0"
^XMB(3.9,146009,2,271,0)="""RTN"",""XUIAMNPB"",3,0)"
^XMB(3.9,146009,2,272,0)=" ;;Per VHA Directive 2004-038, this routine should not be modified"
^XMB(3.9,146009,2,273,0)="""RTN"",""XUIAMNPB"",4,0)"
^XMB(3.9,146009,2,274,0)=" ;"
^XMB(3.9,146009,2,275,0)="""RTN"",""XUIAMNPB"",5,0)"
^XMB(3.9,146009,2,276,0)=" Q"
^XMB(3.9,146009,2,277,0)="""RTN"",""XUIAMNPB"",6,0)"
^XMB(3.9,146009,2,278,0)=" ;"
^XMB(3.9,146009,2,279,0)="""RTN"",""XUIAMNPB"",7,0)"
^XMB(3.9,146009,2,280,0)="EN1 ;entry point for new person field monitor batch update background job"
^XMB(3.9,146009,2,281,0)="""RTN"",""XUIAMNPB"",8,0)"
^XMB(3.9,146009,2,282,0)=" ;**663 - STORY 1203257 (dri) Background job monitoring New Person Field Monitor file"
^XMB(3.9,146009,2,283,0)="""RTN"",""XUIAMNPB"",9,0)"
^XMB(3.9,146009,2,284,0)=" ; **799 VAMPI-22625          Option Name: XUS IAM NPFM BATCH UPDATE"
^XMB(3.9,146009,2,285,0)="""RTN"",""XUIAMNPB"",10,0)"
^XMB(3.9,146009,2,286,0)=" ;"
^XMB(3.9,146009,2,287,0)="""RTN"",""XUIAMNPB"",11,0)"
^XMB(3.9,146009,2,288,0)=" ;attempt lock to insure only one process running"
^XMB(3.9,146009,2,289,0)="""RTN"",""XUIAMNPB"",12,0)"
^XMB(3.9,146009,2,290,0)=" L +^XTV(8933.1,""XUS IAM NPFM BATCH UPDATE""):1 I '$T Q"
^XMB(3.9,146009,2,291,0)="""RTN"",""XUIAMNPB"",13,0)"
^XMB(3.9,146009,2,292,0)=" ;"
^XMB(3.9,146009,2,293,0)="""RTN"",""XUIAMNPB"",14,0)"
^XMB(3.9,146009,2,294,0)=" NEW XUDUZ,XUMIEN,CT,EN,FLDCNT,STN"
^XMB(3.9,146009,2,295,0)="""RTN"",""XUIAMNPB"",15,0)"
^XMB(3.9,146009,2,296,0)=" S XUDUZ=0 F  S XUDUZ=$O(^XTV(8933.1,""ACXMIT"",XUDUZ)) Q:'XUDUZ  S XUMIEN=0 F  S XUMIEN=$O(^XTV(8933.1,""ACXMIT"",XUDUZ,XUMIEN)) Q:'XUMIEN  D  ;new person who was modified"
^XMB(3.9,146009,2,297,0)="""RTN"",""XUIAMNPB"",16,0)"
^XMB(3.9,146009,2,298,0)=" .NEW XUARR,XUFILE,XUFLDS,XUIAM,XURET,XUWHO"
^XMB(3.9,146009,2,299,0)="""RTN"",""XUIAMNPB"",17,0)"
^XMB(3.9,146009,2,300,0)=" .I '$D(^VA(200,XUDUZ,0)) D XMITFLG(XUMIEN) Q  ;if user doesn't exist mark record so it will get purged"
^XMB(3.9,146009,2,301,0)="""RTN"",""XUIAMNPB"",18,0)"
^XMB(3.9,146009,2,302,0)=" .S XUWHO=$P($G(^XTV(8933.1,XUMIEN,0)),""^"",5) ;last edited by"
^XMB(3.9,146009,2,303,0)="""RTN"",""XUIAMNPB"",19,0)"
^XMB(3.9,146009,2,304,0)=" .I XUWHO="""" S XUWHO=XUDUZ ;if only fields like 'LAST SIGN-ON DATE/TIME' logged we won't have a 'LAST EDITED BY'"
^XMB(3.9,146009,2,305,0)="""RTN"",""XUIAMNPB"",20,0)"
^XMB(3.9,146009,2,306,0)=" .S XUFILE=200 ;new person file"
^XMB(3.9,146009,2,307,0)="""RTN"",""XUIAMNPB"",21,0)"
^XMB(3.9,146009,2,308,0)=" .S XUFLDS="".151;4;5;7;9;9.2;10.1;41.99;205.1;205.2;205.3;205.4;205.5;202;501.1;201"""
^XMB(3.9,146009,2,309,0)="""RTN"",""XUIAMNPB"",22,0)"
^XMB(3.9,146009,2,310,0)=" .D GETS^DIQ(XUFILE,XUDUZ_"","",XUFLDS,""IE"",""XUARR"") ;retrieve data"
^XMB(3.9,146009,2,311,0)="""RTN"",""XUIAMNPB"",23,0)"
^XMB(3.9,146009,2,312,0)=" .I $G(XUARR(200,XUDUZ_"","",10.1,""I"")) D"
^XMB(3.9,146009,2,313,0)="""RTN"",""XUIAMNPB"",24,0)"
^XMB(3.9,146009,2,314,0)=" ..D GETS^DIQ(20,+$G(XUARR(XUFILE,XUDUZ_"","",10.1,""I""))_"","",""1;2;3;4;5;6"",""I"",""XUARR"")"
^XMB(3.9,146009,2,315,0)="""RTN"",""XUIAMNPB"",25,0)"
^XMB(3.9,146009,2,316,0)=" ..S XUIAM(""firstName"")=XUARR(20,+XUARR(200,XUDUZ_"","",10.1,""I"")_"","",2,""I"") ;given (first) name"
^XMB(3.9,146009,2,317,0)="""RTN"",""XUIAMNPB"",26,0)"
^XMB(3.9,146009,2,318,0)=" ..S XUIAM(""lastName"")=XUARR(20,+XUARR(200,XUDUZ_"","",10.1,""I"")_"","",1,""I"") ;family (last) name"
^XMB(3.9,146009,2,319,0)="""RTN"",""XUIAMNPB"",27,0)"
^XMB(3.9,146009,2,320,0)=" ..S XUIAM(""middleName"")=XUARR(20,+XUARR(200,XUDUZ_"","",10.1,""I"")_"","",3,""I"") ;middle name"
^XMB(3.9,146009,2,321,0)="""RTN"",""XUIAMNPB"",28,0)"
^XMB(3.9,146009,2,322,0)=" ..S XUIAM(""prefixName"")=XUARR(20,+XUARR(200,XUDUZ_"","",10.1,""I"")_"","",4,""I"") ;prefix name"
^XMB(3.9,146009,2,323,0)="""RTN"",""XUIAMNPB"",29,0)"
^XMB(3.9,146009,2,324,0)=" ..S XUIAM(""suffixName"")=XUARR(20,+XUARR(200,XUDUZ_"","",10.1,""I"")_"","",5,""I"") ;suffix name"
^XMB(3.9,146009,2,325,0)="""RTN"",""XUIAMNPB"",30,0)"
^XMB(3.9,146009,2,326,0)=" ..S XUIAM(""degree"")=XUARR(20,+XUARR(200,XUDUZ_"","",10.1,""I"")_"","",6,""I"") ;degree"
^XMB(3.9,146009,2,327,0)="""RTN"",""XUIAMNPB"",31,0)"
^XMB(3.9,146009,2,328,0)=" .S XUIAM(""gender"")=XUARR(200,XUDUZ_"","",4,""I"") ;sex/gender"
^XMB(3.9,146009,2,329,0)="""RTN"",""XUIAMNPB"",32,0)"
^XMB(3.9,146009,2,330,0)=" .S XUIAM(""dob"")=$$FMTHL7^XLFDT(XUARR(200,XUDUZ_"","",5,""I"")) ;dob - convert to hl7 format"
^XMB(3.9,146009,2,331,0)="""RTN"",""XUIAMNPB"",33,0)"
^XMB(3.9,146009,2,332,0)=" .S XUIAM(""email"")=$$ESC(XUARR(200,XUDUZ_"","",.151,""I"")) ;external or va email"
