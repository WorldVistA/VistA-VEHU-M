^XMB(3.9,146098,2,1147,0)="""RTN"",""SDES2APTLETTER"",252,0)"
^XMB(3.9,146098,2,1148,0)=" . S SDDFN=0 F  S SDDFN=$O(^TMP($J,""BADADD"",SDNAM,SDDFN)) Q:'SDDFN  D"
^XMB(3.9,146098,2,1149,0)="""RTN"",""SDES2APTLETTER"",253,0)"
^XMB(3.9,146098,2,1150,0)=" .. S SDECI=SDECI+1,^TMP(""SDEC_COMP"",$J,""BadAddress"",SDECI)=$$LILAST4(SDDFN)_""      ""_SDNAM_$C(13,10)"
