^XMB(3.9,146084,2,3507,0)="""RTN"",""SDES2RECLLREQ2"",182,0)"
^XMB(3.9,146084,2,3508,0)=" ;"
^XMB(3.9,146084,2,3509,0)="""RTN"",""SDES2RECLLREQ2"",183,0)"
^XMB(3.9,146084,2,3510,0)="VALIDATEACCNUM(ERRORS,SDACC) ;Validate ACCESSION NUMBER"
^XMB(3.9,146084,2,3511,0)="""RTN"",""SDES2RECLLREQ2"",184,0)"
^XMB(3.9,146084,2,3512,0)=" S SDACC=$G(SDACC,"""")"
^XMB(3.9,146084,2,3513,0)="""RTN"",""SDES2RECLLREQ2"",185,0)"
^XMB(3.9,146084,2,3514,0)=" S SDACC=$TR($G(SDACC),""^"","" "")"
^XMB(3.9,146084,2,3515,0)="""RTN"",""SDES2RECLLREQ2"",186,0)"
^XMB(3.9,146084,2,3516,0)=" Q SDACC"
^XMB(3.9,146084,2,3517,0)="""RTN"",""SDES2RECLLREQ2"",187,0)"
^XMB(3.9,146084,2,3518,0)=" ;"
^XMB(3.9,146084,2,3519,0)="""RTN"",""SDES2RECLLREQ2"",188,0)"
^XMB(3.9,146084,2,3520,0)="RETURNERROR(ERRORS,SDRECREQ,RETN,REQIEN) ;"
^XMB(3.9,146084,2,3521,0)="""RTN"",""SDES2RECLLREQ2"",189,0)"
^XMB(3.9,146084,2,3522,0)=" M SDRECREQ=ERRORS"
^XMB(3.9,146084,2,3523,0)="""RTN"",""SDES2RECLLREQ2"",190,0)"
^XMB(3.9,146084,2,3524,0)=" D SETEMPTYOBJ(.SDRECREQ,REQIEN)"
^XMB(3.9,146084,2,3525,0)="""RTN"",""SDES2RECLLREQ2"",191,0)"
^XMB(3.9,146084,2,3526,0)=" D BUILDJSON^SDES2JSON(.RETN,.SDRECREQ)"
^XMB(3.9,146084,2,3527,0)="""RTN"",""SDES2RECLLREQ2"",192,0)"
^XMB(3.9,146084,2,3528,0)=" Q"
^XMB(3.9,146084,2,3529,0)="""RTN"",""SDES2RECLLREQ2"",193,0)"
^XMB(3.9,146084,2,3530,0)=" ;"
^XMB(3.9,146084,2,3531,0)="""RTN"",""SDES2RECLLREQ2"",194,0)"
^XMB(3.9,146084,2,3532,0)="SETEMPTYOBJ(SDRECREQ,SDCREATE) ;Set the object to NULL"
^XMB(3.9,146084,2,3533,0)="""RTN"",""SDES2RECLLREQ2"",195,0)"
^XMB(3.9,146084,2,3534,0)=" I SDCREATE=""+1"" S SDRECREQ(""Request"",""IEN"")="""" Q"
^XMB(3.9,146084,2,3535,0)="""RTN"",""SDES2RECLLREQ2"",196,0)"
^XMB(3.9,146084,2,3536,0)=" S SDRECREQ(""Request"",""IEN"")="""""
^XMB(3.9,146084,2,3537,0)="""RTN"",""SDES2RECLLREQ2"",197,0)"
^XMB(3.9,146084,2,3538,0)=" Q"
^XMB(3.9,146084,2,3539,0)="""RTN"",""SDES2RECLLREQ2"",198,0)"
^XMB(3.9,146084,2,3540,0)=" ;"
^XMB(3.9,146084,2,3541,0)="""RTN"",""SDES2RECLLREQ2"",199,0)"
^XMB(3.9,146084,2,3542,0)="KEY(RECALLIEN) ;check that user has the correct SECURITY KEY"
^XMB(3.9,146084,2,3543,0)="""RTN"",""SDES2RECLLREQ2"",200,0)"
^XMB(3.9,146084,2,3544,0)=" ;INPUT:"
^XMB(3.9,146084,2,3545,0)="""RTN"",""SDES2RECLLREQ2"",201,0)"
^XMB(3.9,146084,2,3546,0)=" ; RECALLIEN - Pointer to RECALL REMINDERS file 403.5"
^XMB(3.9,146084,2,3547,0)="""RTN"",""SDES2RECLLREQ2"",202,0)"
^XMB(3.9,146084,2,3548,0)=" ;RETURN"
^XMB(3.9,146084,2,3549,0)="""RTN"",""SDES2RECLLREQ2"",203,0)"
^XMB(3.9,146084,2,3550,0)=" ;  0=User has the correct SECURITY KEY"
^XMB(3.9,146084,2,3551,0)="""RTN"",""SDES2RECLLREQ2"",204,0)"
^XMB(3.9,146084,2,3552,0)=" ;  135=error number - user does not have correct security keys"
^XMB(3.9,146084,2,3553,0)="""RTN"",""SDES2RECLLREQ2"",205,0)"
^XMB(3.9,146084,2,3554,0)=" N KEY,KY,RET,SDPRV,SDFLAG"
^XMB(3.9,146084,2,3555,0)="""RTN"",""SDES2RECLLREQ2"",206,0)"
^XMB(3.9,146084,2,3556,0)=" S RET=135"
^XMB(3.9,146084,2,3557,0)="""RTN"",""SDES2RECLLREQ2"",207,0)"
^XMB(3.9,146084,2,3558,0)=" S (SDPRV,KEY,SDFLAG)="""" S SDPRV=$P($G(^SD(403.5,+RECALLIEN,0)),U,5) D"
^XMB(3.9,146084,2,3559,0)="""RTN"",""SDES2RECLLREQ2"",208,0)"
^XMB(3.9,146084,2,3560,0)=" .I SDPRV="""" S RET=0"
^XMB(3.9,146084,2,3561,0)="""RTN"",""SDES2RECLLREQ2"",209,0)"
^XMB(3.9,146084,2,3562,0)=" .I SDPRV'="""" S KEY=$P($G(^SD(403.54,SDPRV,0)),U,7) D"
^XMB(3.9,146084,2,3563,0)="""RTN"",""SDES2RECLLREQ2"",210,0)"
^XMB(3.9,146084,2,3564,0)=" ..I KEY="""" S RET=0 Q"
^XMB(3.9,146084,2,3565,0)="""RTN"",""SDES2RECLLREQ2"",211,0)"
^XMB(3.9,146084,2,3566,0)=" ..N VALUE"
^XMB(3.9,146084,2,3567,0)="""RTN"",""SDES2RECLLREQ2"",212,0)"
^XMB(3.9,146084,2,3568,0)=" ..S VALUE=$$LKUP^XPDKEY(KEY) K KY D OWNSKEY^XUSRB(.KY,VALUE)"
^XMB(3.9,146084,2,3569,0)="""RTN"",""SDES2RECLLREQ2"",213,0)"
^XMB(3.9,146084,2,3570,0)=" ..I $G(KY(0))'=0 S RET=0"
^XMB(3.9,146084,2,3571,0)="""RTN"",""SDES2RECLLREQ2"",214,0)"
^XMB(3.9,146084,2,3572,0)=" Q RET"
^XMB(3.9,146084,2,3573,0)="""RTN"",""SDES2RECLLREQ2"",215,0)"
^XMB(3.9,146084,2,3574,0)=" ;"
^XMB(3.9,146084,2,3575,0)="""RTN"",""SDES2VAL44"")"
^XMB(3.9,146084,2,3576,0)="0^7^B204056986"
^XMB(3.9,146084,2,3577,0)="""RTN"",""SDES2VAL44"",1,0)"
^XMB(3.9,146084,2,3578,0)="SDES2VAL44 ;ALB/BWF,MGD/BLB/TAW,TJB,JHC - SDES2 Clinic validation utilities ;JUN 16, 2026"
^XMB(3.9,146084,2,3579,0)="""RTN"",""SDES2VAL44"",2,0)"
^XMB(3.9,146084,2,3580,0)=" ;;5.3;Scheduling;**853,857,864,866,871,890,914,930,949**;Aug 13, 1993;Build 0"
^XMB(3.9,146084,2,3581,0)="""RTN"",""SDES2VAL44"",3,0)"
^XMB(3.9,146084,2,3582,0)=" ;;Per VHA Directive 6402, this routine should not be modified"
^XMB(3.9,146084,2,3583,0)="""RTN"",""SDES2VAL44"",4,0)"
^XMB(3.9,146084,2,3584,0)=" ;"
^XMB(3.9,146084,2,3585,0)="""RTN"",""SDES2VAL44"",5,0)"
^XMB(3.9,146084,2,3586,0)=" Q"
^XMB(3.9,146084,2,3587,0)="""RTN"",""SDES2VAL44"",6,0)"
^XMB(3.9,146084,2,3588,0)=" ;"
^XMB(3.9,146084,2,3589,0)="""RTN"",""SDES2VAL44"",7,0)"
^XMB(3.9,146084,2,3590,0)="VALCLINIEN(ERRORS,SDIEN,ISREQUIRED,ALLOWDELETE) ;"
^XMB(3.9,146084,2,3591,0)="""RTN"",""SDES2VAL44"",8,0)"
^XMB(3.9,146084,2,3592,0)=" I $G(ISREQUIRED),SDIEN="""" D ERRLOG^SDES2JSON(.ERRORS,18) Q"
^XMB(3.9,146084,2,3593,0)="""RTN"",""SDES2VAL44"",9,0)"
^XMB(3.9,146084,2,3594,0)=" I '$G(ISREQUIRED),SDIEN="""" Q"
^XMB(3.9,146084,2,3595,0)="""RTN"",""SDES2VAL44"",10,0)"
^XMB(3.9,146084,2,3596,0)=" I $G(ALLOWDELETE),(SDIEN=""@"")!(SDIEN="""") Q"
^XMB(3.9,146084,2,3597,0)="""RTN"",""SDES2VAL44"",11,0)"
^XMB(3.9,146084,2,3598,0)=" I '$G(ALLOWDELETE),SDIEN=""@"" D ERRLOG^SDES2JSON(.ERRORS,229,""Clinic ID"") Q"
^XMB(3.9,146084,2,3599,0)="""RTN"",""SDES2VAL44"",12,0)"
^XMB(3.9,146084,2,3600,0)=" I '$D(^SC(SDIEN,0)) D ERRLOG^SDES2JSON(.ERRORS,19)"
^XMB(3.9,146084,2,3601,0)="""RTN"",""SDES2VAL44"",13,0)"
^XMB(3.9,146084,2,3602,0)=" Q"
^XMB(3.9,146084,2,3603,0)="""RTN"",""SDES2VAL44"",14,0)"
^XMB(3.9,146084,2,3604,0)=" ;"
^XMB(3.9,146084,2,3605,0)="""RTN"",""SDES2VAL44"",15,0)"
^XMB(3.9,146084,2,3606,0)="VALNAME(ERRORS,SDNAME,FDATA) ;"
^XMB(3.9,146084,2,3607,0)="""RTN"",""SDES2VAL44"",16,0)"
^XMB(3.9,146084,2,3608,0)=" I SDNAME=""@"" D ERRLOG^SDES2JSON(.ERRORS,229,""Clinic Name"") Q"
^XMB(3.9,146084,2,3609,0)="""RTN"",""SDES2VAL44"",17,0)"
^XMB(3.9,146084,2,3610,0)=" I SDNAME="""" D ERRLOG^SDES2JSON(.ERRORS,50) Q"
^XMB(3.9,146084,2,3611,0)="""RTN"",""SDES2VAL44"",18,0)"
^XMB(3.9,146084,2,3612,0)=" S SDNAME=$$UP^XLFSTR(SDNAME)"
^XMB(3.9,146084,2,3613,0)="""RTN"",""SDES2VAL44"",19,0)"
^XMB(3.9,146084,2,3614,0)=" I $L(SDNAME)>30!($L(SDNAME)<2)!'(SDNAME'?1P.E)!(SDNAME'?.ANP) D ERRLOG^SDES2JSON(.ERRORS,51) Q"
^XMB(3.9,146084,2,3615,0)="""RTN"",""SDES2VAL44"",20,0)"
^XMB(3.9,146084,2,3616,0)=" I SDNAME'="""",$D(^SC(""B"",$E(SDNAME,1,30))) D ERRLOG^SDES2JSON(.ERRORS,481) Q"
^XMB(3.9,146084,2,3617,0)="""RTN"",""SDES2VAL44"",21,0)"
^XMB(3.9,146084,2,3618,0)=" S FDATA(""NAME"")=SDNAME"
^XMB(3.9,146084,2,3619,0)="""RTN"",""SDES2VAL44"",22,0)"
^XMB(3.9,146084,2,3620,0)=" Q"
^XMB(3.9,146084,2,3621,0)="""RTN"",""SDES2VAL44"",23,0)"
^XMB(3.9,146084,2,3622,0)=" ;"
^XMB(3.9,146084,2,3623,0)="""RTN"",""SDES2VAL44"",24,0)"
^XMB(3.9,146084,2,3624,0)="VALABBR(ERRORS,SDABR,FDATA) ;"
^XMB(3.9,146084,2,3625,0)="""RTN"",""SDES2VAL44"",25,0)"
^XMB(3.9,146084,2,3626,0)=" I SDABR=""@"" S FDATA(""ABBREVIATION"")="""" Q"
^XMB(3.9,146084,2,3627,0)="""RTN"",""SDES2VAL44"",26,0)"
^XMB(3.9,146084,2,3628,0)=" I SDABR'="""",$L(SDABR)>7 D ERRLOG^SDES2JSON(.ERRORS,251) Q"
^XMB(3.9,146084,2,3629,0)="""RTN"",""SDES2VAL44"",27,0)"
^XMB(3.9,146084,2,3630,0)=" S FDATA(""ABBREVIATION"")=SDABR"
^XMB(3.9,146084,2,3631,0)="""RTN"",""SDES2VAL44"",28,0)"
^XMB(3.9,146084,2,3632,0)=" Q"
^XMB(3.9,146084,2,3633,0)="""RTN"",""SDES2VAL44"",29,0)"
^XMB(3.9,146084,2,3634,0)=" ;"
^XMB(3.9,146084,2,3635,0)="""RTN"",""SDES2VAL44"",30,0)"
^XMB(3.9,146084,2,3636,0)="VALPATFNAME(ERRORS,SDPATNAME,FDATA) ;"
^XMB(3.9,146084,2,3637,0)="""RTN"",""SDES2VAL44"",31,0)"
^XMB(3.9,146084,2,3638,0)=" I SDPATNAME=""@"" S FDATA(""PATIENT FRIENDLY NAME"")="""" Q"
^XMB(3.9,146084,2,3639,0)="""RTN"",""SDES2VAL44"",32,0)"
^XMB(3.9,146084,2,3640,0)=" I SDPATNAME'="""",(($L(SDPATNAME)<3)!($L(SDPATNAME)>80)) D ERRLOG^SDES2JSON(.ERRORS,482) Q"
^XMB(3.9,146084,2,3641,0)="""RTN"",""SDES2VAL44"",33,0)"
^XMB(3.9,146084,2,3642,0)=" S FDATA(""PATIENT FRIENDLY NAME"")=SDPATNAME"
^XMB(3.9,146084,2,3643,0)="""RTN"",""SDES2VAL44"",34,0)"
^XMB(3.9,146084,2,3644,0)=" Q"
^XMB(3.9,146084,2,3645,0)="""RTN"",""SDES2VAL44"",35,0)"
^XMB(3.9,146084,2,3646,0)=" ;"
^XMB(3.9,146084,2,3647,0)="""RTN"",""SDES2VAL44"",36,0)"
^XMB(3.9,146084,2,3648,0)="VALMEETATFACIL(ERRORS,SDMEETATFAC,FDATA) ;"
^XMB(3.9,146084,2,3649,0)="""RTN"",""SDES2VAL44"",37,0)"
