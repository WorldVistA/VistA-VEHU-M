^XMB(3.9,146037,2,1874,0)="RCDPESR9 ;ALB/TMK,DWA - ERA return file field captions ;09-SEP-2003"
^XMB(3.9,146037,2,1875,0)="""RTN"",""RCDPESR9"",2,0)"
^XMB(3.9,146037,2,1876,0)=" ;;4.5;Accounts Receivable;**173,252,269,302,371**;Mar 20, 1995;Build 0"
^XMB(3.9,146037,2,1877,0)="""RTN"",""RCDPESR9"",3,0)"
^XMB(3.9,146037,2,1878,0)=" ;;Per VA Directive 6402, this routine should not be modified."
