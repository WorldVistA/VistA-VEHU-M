^XMB(3.9,146036,2,3342,0)="DBQLOGIC(DVBRETURN) ;"
^XMB(3.9,146036,2,3343,0)="""RTN"",""DVBUTIL"",116,0)"
^XMB(3.9,146036,2,3344,0)=" ;New RPC to pull list of DBQs with conditional Logic CAPRI-13314 CP 9-4-24"
^XMB(3.9,146036,2,3345,0)="""RTN"",""DVBUTIL"",117,0)"
^XMB(3.9,146036,2,3346,0)=" ;RPC: DVBA CAPRI PDF LOGIC TOGGLE "
^XMB(3.9,146036,2,3347,0)="""RTN"",""DVBUTIL"",118,0)"
^XMB(3.9,146036,2,3348,0)=" N DVBLIST,DVBLEN,DVBSEQ,DVBRTN,DVBERR,DVBDATA,DVBI"
^XMB(3.9,146036,2,3349,0)="""RTN"",""DVBUTIL"",119,0)"
^XMB(3.9,146036,2,3350,0)=" K ^TMP(""DBQLOGIC"",$J)"
^XMB(3.9,146036,2,3351,0)="""RTN"",""DVBUTIL"",120,0)"
^XMB(3.9,146036,2,3352,0)=" S DVBSEQ=0,(DVBLIST,DVBDATA)="""""
^XMB(3.9,146036,2,3353,0)="""RTN"",""DVBUTIL"",121,0)"
^XMB(3.9,146036,2,3354,0)=" D GETWP^XPAR(.DVBLIST,""PKG"",""DVBAB CAPRI DBQ COND LOGIC"",1,.DVBERR)"
^XMB(3.9,146036,2,3355,0)="""RTN"",""DVBUTIL"",122,0)"
^XMB(3.9,146036,2,3356,0)=" I DVBERR'=0 S DVBRETURN=""-1^""_DVBERR Q"
