^XMB(3.9,146047,2,3377,0)="""RTN"",""IBJPI"",203,0)"
^XMB(3.9,146047,2,3378,0)=" ;. Q:'IEN"
^XMB(3.9,146047,2,3379,0)="""RTN"",""IBJPI"",204,0)"
^XMB(3.9,146047,2,3380,0)=" ;. S IBIIVB=$G(^IBE(350.9,1,51.17,IEN,0))       ; Batch Extract multiple line"
^XMB(3.9,146047,2,3381,0)="""RTN"",""IBJPI"",205,0)"
^XMB(3.9,146047,2,3382,0)=" ;. S IBEX=+$P(IBIIVB,""^"",1)                     ; Type"
^XMB(3.9,146047,2,3383,0)="""RTN"",""IBJPI"",206,0)"
^XMB(3.9,146047,2,3384,0)=" ;. Q:'$F("".1.2."","".""_IBEX_""."")"
^XMB(3.9,146047,2,3385,0)="""RTN"",""IBJPI"",207,0)"
^XMB(3.9,146047,2,3386,0)=" ;. S IBST=$$FO^IBCNEUT1($S($P(IBIIVB,""^"",1)'="""":$$GET1^DIQ(350.9002,IEN_"",1,"",.01,""E""),1:""""),14)"
^XMB(3.9,146047,2,3387,0)="""RTN"",""IBJPI"",208,0)"
^XMB(3.9,146047,2,3388,0)=" ;. S IBST=IBST_$$FO^IBCNEUT1($S(+$P(IBIIVB,""^"",2):""ON"",1:""OFF""),9)"
^XMB(3.9,146047,2,3389,0)="""RTN"",""IBJPI"",209,0)"
^XMB(3.9,146047,2,3390,0)=" ;. S IBEX1=$S(+$P(IBIIVB,U,3)'=0:+$P(IBIIVB,""^"",3),1:$P(IBIIVB,""^"",3))"
^XMB(3.9,146047,2,3391,0)="""RTN"",""IBJPI"",210,0)"
^XMB(3.9,146047,2,3392,0)=" ;. S IBEX2=$S(+$P(IBIIVB,U,4)'=0:+$P(IBIIVB,""^"",4),1:$P(IBIIVB,""^"",4))"
^XMB(3.9,146047,2,3393,0)="""RTN"",""IBJPI"",211,0)"
^XMB(3.9,146047,2,3394,0)=" ;. S IBST=IBST_$$FO^IBCNEUT1($S(IBEX=1:""n/a"",IBEX=2:IBEX1,IBEX=3:IBEX1_""/""_IBEX2,1:""ERROR""),13)"
^XMB(3.9,146047,2,3395,0)="""RTN"",""IBJPI"",212,0)"
^XMB(3.9,146047,2,3396,0)=" ;. S IBST=IBST_$$FO^IBCNEUT1($S(+$P(IBIIVB,""^"",5):+$P(IBIIVB,""^"",5),1:$P(IBIIVB,""^"",5)),14)"
^XMB(3.9,146047,2,3397,0)="""RTN"",""IBJPI"",213,0)"
^XMB(3.9,146047,2,3398,0)=" ;. S ELINE=$$SET(IBST,"""",ELINE,1)"
^XMB(3.9,146047,2,3399,0)="""RTN"",""IBJPI"",214,0)"
^XMB(3.9,146047,2,3400,0)=" ;; IB*2.0*621/DM display EICD extract (#4), eventually, other extracts will migrate to this structure "
^XMB(3.9,146047,2,3401,0)="""RTN"",""IBJPI"",215,0)"
^XMB(3.9,146047,2,3402,0)=" ;S ELINE=$$SET("""",$J("""",40),ELINE,1)  ; Spacing Blank Line "
^XMB(3.9,146047,2,3403,0)="""RTN"",""IBJPI"",216,0)"
^XMB(3.9,146047,2,3404,0)=" ;S ELINE=$$SET("""",$J("""",40),ELINE,1)  ; Spacing Blank Line"
^XMB(3.9,146047,2,3405,0)="""RTN"",""IBJPI"",217,0)"
^XMB(3.9,146047,2,3406,0)=" ;S ELINE=$$SET("" Extract               Start Days   Days After           Maximum # to"","""",ELINE,1)"
^XMB(3.9,146047,2,3407,0)="""RTN"",""IBJPI"",218,0)"
^XMB(3.9,146047,2,3408,0)=" ;S ELINE=$$SETN(""Name         On/Off   From Today   Start        Freq.   Extract/Day"",ELINE,1,"""",1)"
^XMB(3.9,146047,2,3409,0)="""RTN"",""IBJPI"",219,0)"
^XMB(3.9,146047,2,3410,0)=" ;I $$GET1^DIQ(350.9002,""4,1,"",.01)=""EICD"" D "
^XMB(3.9,146047,2,3411,0)="""RTN"",""IBJPI"",220,0)"
^XMB(3.9,146047,2,3412,0)=" ;. S IBEX=$$SETTINGS^IBCNEDE7(4) ; collect EICD parameters "
^XMB(3.9,146047,2,3413,0)="""RTN"",""IBJPI"",221,0)"
^XMB(3.9,146047,2,3414,0)=" ;. S IBST=$$FO^IBCNEUT1(""EICD"",14)"
^XMB(3.9,146047,2,3415,0)="""RTN"",""IBJPI"",222,0)"
^XMB(3.9,146047,2,3416,0)=" ;. S IBST=IBST_$$FO^IBCNEUT1($S(+IBEX:""ON"",1:""OFF""),9)"
^XMB(3.9,146047,2,3417,0)="""RTN"",""IBJPI"",223,0)"
^XMB(3.9,146047,2,3418,0)=" ;. S IBST=IBST_$$FO^IBCNEUT1(+$P(IBEX,""^"",6),13) ; Start Days"
^XMB(3.9,146047,2,3419,0)="""RTN"",""IBJPI"",224,0)"
^XMB(3.9,146047,2,3420,0)=" ;. S IBST=IBST_$$FO^IBCNEUT1(+$P(IBEX,""^"",7),13) ; Days After "
^XMB(3.9,146047,2,3421,0)="""RTN"",""IBJPI"",225,0)"
^XMB(3.9,146047,2,3422,0)=" ;. S IBST=IBST_$$FO^IBCNEUT1(+$P(IBEX,""^"",8),8) ; Frequency"
^XMB(3.9,146047,2,3423,0)="""RTN"",""IBJPI"",226,0)"
^XMB(3.9,146047,2,3424,0)=" ;. S IBST=IBST_$$FO^IBCNEUT1(+$P(IBEX,""^"",4),8) ; Max extract"
^XMB(3.9,146047,2,3425,0)="""RTN"",""IBJPI"",227,0)"
^XMB(3.9,146047,2,3426,0)=" ;. S ELINE=$$SET(IBST,"""",ELINE,1)"
^XMB(3.9,146047,2,3427,0)="""RTN"",""IBJPI"",228,0)"
^XMB(3.9,146047,2,3428,0)=" ;"
^XMB(3.9,146047,2,3429,0)="""RTN"",""IBJPI"",229,0)"
^XMB(3.9,146047,2,3430,0)=" ;/vd-IB*2*687 - Beginning of new/restructured code."
^XMB(3.9,146047,2,3431,0)="""RTN"",""IBJPI"",230,0)"
^XMB(3.9,146047,2,3432,0)=" N APPTBE,BENAME,FRESHDAY"
^XMB(3.9,146047,2,3433,0)="""RTN"",""IBJPI"",231,0)"
^XMB(3.9,146047,2,3434,0)=" S FRESHDAY=$$GET1^DIQ(350.9,""1,"",51.01)  ; FRESHNESS DAYS - used by Buffer/Appt as ""Frequency"""
^XMB(3.9,146047,2,3435,0)="""RTN"",""IBJPI"",232,0)"
^XMB(3.9,146047,2,3436,0)=" S ELINE=$$SET("" Extract               Start Days   Days After           Maximum # to"","""",ELINE,1)"
^XMB(3.9,146047,2,3437,0)="""RTN"",""IBJPI"",233,0)"
^XMB(3.9,146047,2,3438,0)=" S ELINE=$$SETN(""Name         On/Off   From Today   Start        Freq.   Extract/Day"",ELINE,1,"""",1)"
^XMB(3.9,146047,2,3439,0)="""RTN"",""IBJPI"",234,0)"
^XMB(3.9,146047,2,3440,0)=" ;"
^XMB(3.9,146047,2,3441,0)="""RTN"",""IBJPI"",235,0)"
^XMB(3.9,146047,2,3442,0)=" ; Loop thru Batch Extracts."
^XMB(3.9,146047,2,3443,0)="""RTN"",""IBJPI"",236,0)"
^XMB(3.9,146047,2,3444,0)=" S IEN=0"
^XMB(3.9,146047,2,3445,0)="""RTN"",""IBJPI"",237,0)"
^XMB(3.9,146047,2,3446,0)=" F  S IEN=$O(^IBE(350.9,1,51.17,IEN)) Q:'IEN  D"
^XMB(3.9,146047,2,3447,0)="""RTN"",""IBJPI"",238,0)"
^XMB(3.9,146047,2,3448,0)=" . S IBEX=+$P($G(^IBE(350.9,1,51.17,IEN,0)),U)    ; Type"
^XMB(3.9,146047,2,3449,0)="""RTN"",""IBJPI"",239,0)"
^XMB(3.9,146047,2,3450,0)=" . I ""^1^2^4^""'[(U_IBEX_U) Q          ; Only want Buffer, Appt and EICD Batch Extracts."
^XMB(3.9,146047,2,3451,0)="""RTN"",""IBJPI"",240,0)"
^XMB(3.9,146047,2,3452,0)=" . S IBEIVB=$$SETTINGS^IBCNEDE7(IBEX) ; collect specific extract's site parameter settings"
^XMB(3.9,146047,2,3453,0)="""RTN"",""IBJPI"",241,0)"
^XMB(3.9,146047,2,3454,0)=" . S BENAME=$S($P(IBEIVB,U,1)'="""":$$GET1^DIQ(350.9002,IEN_"",1,"",.01,""E""),1:"""")"
^XMB(3.9,146047,2,3455,0)="""RTN"",""IBJPI"",242,0)"
^XMB(3.9,146047,2,3456,0)=" . I BENAME=""Appt"" S APPTBE=1,BENAME=BENAME_"" *""   ; If this is the APPT extract, need to add footnote."
^XMB(3.9,146047,2,3457,0)="""RTN"",""IBJPI"",243,0)"
^XMB(3.9,146047,2,3458,0)=" . S IBST=$$FO^IBCNEUT1(BENAME,14)    ; Extract Name "
^XMB(3.9,146047,2,3459,0)="""RTN"",""IBJPI"",244,0)"
^XMB(3.9,146047,2,3460,0)=" . S IBST=IBST_$$FO^IBCNEUT1($S(+$P(IBEIVB,""^"",1):""ON"",1:""OFF""),9)"
^XMB(3.9,146047,2,3461,0)="""RTN"",""IBJPI"",245,0)"
^XMB(3.9,146047,2,3462,0)=" . S IBEX1=$P(IBEIVB,U,6)"
^XMB(3.9,146047,2,3463,0)="""RTN"",""IBJPI"",246,0)"
^XMB(3.9,146047,2,3464,0)=" . S IBST=IBST_$$FO^IBCNEUT1($S(""^1^2^""[(U_IBEX_U):""Today"",IBEX=4:IBEX1,1:""n/a""),13) ; Start Days"
^XMB(3.9,146047,2,3465,0)="""RTN"",""IBJPI"",247,0)"
^XMB(3.9,146047,2,3466,0)=" . S IBST=IBST_$$FO^IBCNEUT1($S(IBEX=1:""Today"",IBEX=2:$$GET1^DIQ(350.9002,IEN_"",1,"",.03),IBEX=4:+$P(IBEIVB,U,7),1:""n/a""),13)   ; Days After Start"
^XMB(3.9,146047,2,3467,0)="""RTN"",""IBJPI"",248,0)"
^XMB(3.9,146047,2,3468,0)=" . S IBST=IBST_$$FO^IBCNEUT1($S(IBEX=4:+$P(IBEIVB,U,8),1:FRESHDAY),8) ; Frequency"
^XMB(3.9,146047,2,3469,0)="""RTN"",""IBJPI"",249,0)"
^XMB(3.9,146047,2,3470,0)=" . S IBST=IBST_$$FO^IBCNEUT1(+$P(IBEIVB,U,4),8)                       ; Max extract"
^XMB(3.9,146047,2,3471,0)="""RTN"",""IBJPI"",250,0)"
^XMB(3.9,146047,2,3472,0)=" . S ELINE=$$SET(IBST,"""",ELINE,1)"
^XMB(3.9,146047,2,3473,0)="""RTN"",""IBJPI"",251,0)"
^XMB(3.9,146047,2,3474,0)=" ;/vd-IB*2*687 - End of new/restructured code."
^XMB(3.9,146047,2,3475,0)="""RTN"",""IBJPI"",252,0)"
^XMB(3.9,146047,2,3476,0)=" ;"
^XMB(3.9,146047,2,3477,0)="""RTN"",""IBJPI"",253,0)"
^XMB(3.9,146047,2,3478,0)=" I +APPTBE D   ;/vd-IB*2*687 - Added to indicate ""APPT"" Buffer Entry."
^XMB(3.9,146047,2,3479,0)="""RTN"",""IBJPI"",254,0)"
^XMB(3.9,146047,2,3480,0)=" . S ELINE=$$SET("""","""",ELINE,1)            ; Spacing Blank Line"
^XMB(3.9,146047,2,3481,0)="""RTN"",""IBJPI"",255,0)"
^XMB(3.9,146047,2,3482,0)=" . S ELINE=$$SET(""   * Appt extract - Medicare frequency is ""_$$GET1^DIQ(350.9,""1,"",51.32)_"" days"","""",ELINE,1)"
^XMB(3.9,146047,2,3483,0)="""RTN"",""IBJPI"",256,0)"
^XMB(3.9,146047,2,3484,0)=" Q"
^XMB(3.9,146047,2,3485,0)="""RTN"",""IBJPI"",257,0)"
^XMB(3.9,146047,2,3486,0)=" ;"
^XMB(3.9,146047,2,3487,0)="""RTN"",""IBJPI"",258,0)"
^XMB(3.9,146047,2,3488,0)=" ;/vd - IB*2.0*687 - The BLDGENNS module was added for the IIU Parameters."
^XMB(3.9,146047,2,3489,0)="""RTN"",""IBJPI"",259,0)"
^XMB(3.9,146047,2,3490,0)="BLDGENNS(ELINE) ; Build the IIU Parameters Non-editable Section"
^XMB(3.9,146047,2,3491,0)="""RTN"",""IBJPI"",260,0)"
^XMB(3.9,146047,2,3492,0)=" ; Input: SLINE - Starting Section Line Number"
^XMB(3.9,146047,2,3493,0)="""RTN"",""IBJPI"",261,0)"
^XMB(3.9,146047,2,3494,0)=" ; ELINE - Current Ending Section Line Number"
^XMB(3.9,146047,2,3495,0)="""RTN"",""IBJPI"",262,0)"
^XMB(3.9,146047,2,3496,0)=" ; Output: ELINE - Updated Ending Section Line Number"
^XMB(3.9,146047,2,3497,0)="""RTN"",""IBJPI"",263,0)"
^XMB(3.9,146047,2,3498,0)=" ;"
^XMB(3.9,146047,2,3499,0)="""RTN"",""IBJPI"",264,0)"
^XMB(3.9,146047,2,3500,0)=" N STRTLN,XX"
^XMB(3.9,146047,2,3501,0)="""RTN"",""IBJPI"",265,0)"
^XMB(3.9,146047,2,3502,0)=" S ELINE=$$SET("""",$J("""",40),ELINE,1) ; Spacing Blank Line"
^XMB(3.9,146047,2,3503,0)="""RTN"",""IBJPI"",266,0)"
^XMB(3.9,146047,2,3504,0)=" S ELINE=$$SETN(""IIU Parameters (non-editable)"",ELINE,1,1)"
^XMB(3.9,146047,2,3505,0)="""RTN"",""IBJPI"",267,0)"
^XMB(3.9,146047,2,3506,0)=" S STRTLN=ELINE"
^XMB(3.9,146047,2,3507,0)="""RTN"",""IBJPI"",268,0)"
^XMB(3.9,146047,2,3508,0)=" S ELINE=$$SET(""     Max Days of Recent Visit: "",$$GET1^DIQ(350.9,""1,"",53.03),ELINE,1)"
^XMB(3.9,146047,2,3509,0)="""RTN"",""IBJPI"",269,0)"
^XMB(3.9,146047,2,3510,0)=" S ELINE=$$SET(""Min Days Before Sharing Again: "",$$GET1^DIQ(350.9,""1,"",53.04),ELINE,1)"
^XMB(3.9,146047,2,3511,0)="""RTN"",""IBJPI"",270,0)"
^XMB(3.9,146047,2,3512,0)=" S ELINE=$$SET(""            IIU Master Switch: "",$$GET1^DIQ(350.9,""1,"",53.01),ELINE,1)"
^XMB(3.9,146047,2,3513,0)="""RTN"",""IBJPI"",271,0)"
^XMB(3.9,146047,2,3514,0)=" S ELINE=STRTLN"
^XMB(3.9,146047,2,3515,0)="""RTN"",""IBJPI"",272,0)"
^XMB(3.9,146047,2,3516,0)=" S ELINE=$$SET(""      Purging Sent Records: "",$$GET1^DIQ(350.9,""1,"",53.05),ELINE,41)"
^XMB(3.9,146047,2,3517,0)="""RTN"",""IBJPI"",273,0)"
^XMB(3.9,146047,2,3518,0)=" S ELINE=$$SET(""  Purging Received Records: "",$$GET1^DIQ(350.9,""1,"",53.07),ELINE,41)"
^XMB(3.9,146047,2,3519,0)="""RTN"",""IBJPI"",274,0)"
^XMB(3.9,146047,2,3520,0)=" S ELINE=$$SET("" Purging Candidate Records: "",$$GET1^DIQ(350.9,""1,"",53.06),ELINE,41)"
^XMB(3.9,146047,2,3521,0)="""RTN"",""IBJPI"",275,0)"
^XMB(3.9,146047,2,3522,0)=" Q"
^XMB(3.9,146047,2,3523,0)="""RTN"",""IBJPI"",276,0)"
^XMB(3.9,146047,2,3524,0)=" ;"
^XMB(3.9,146047,2,3525,0)="""RTN"",""IBJPI"",277,0)"
^XMB(3.9,146047,2,3526,0)="SET(LABEL,DATA,LINE,COL) ; Sets text into the body of the worklist"
^XMB(3.9,146047,2,3527,0)="""RTN"",""IBJPI"",278,0)"
^XMB(3.9,146047,2,3528,0)=" ; Input:   LABEL   - Label text to set into the line"
^XMB(3.9,146047,2,3529,0)="""RTN"",""IBJPI"",279,0)"
^XMB(3.9,146047,2,3530,0)=" ;          DATA    - Field Data to set into the line"
^XMB(3.9,146047,2,3531,0)="""RTN"",""IBJPI"",280,0)"
^XMB(3.9,146047,2,3532,0)=" ;          LINE    - Line to set LABEL and DATA into"
^XMB(3.9,146047,2,3533,0)="""RTN"",""IBJPI"",281,0)"
^XMB(3.9,146047,2,3534,0)=" ;          COL     - Starting column position in LINE to insert"
^XMB(3.9,146047,2,3535,0)="""RTN"",""IBJPI"",282,0)"
^XMB(3.9,146047,2,3536,0)=" ;                    LABEL_DATA text"
^XMB(3.9,146047,2,3537,0)="""RTN"",""IBJPI"",283,0)"
^XMB(3.9,146047,2,3538,0)=" ; Returns: LINE    - Updated Line by 1"
^XMB(3.9,146047,2,3539,0)="""RTN"",""IBJPI"",284,0)"
^XMB(3.9,146047,2,3540,0)=" ;"
^XMB(3.9,146047,2,3541,0)="""RTN"",""IBJPI"",285,0)"
^XMB(3.9,146047,2,3542,0)=" N IBY"
^XMB(3.9,146047,2,3543,0)="""RTN"",""IBJPI"",286,0)"
^XMB(3.9,146047,2,3544,0)=" S IBY=LABEL_DATA"
^XMB(3.9,146047,2,3545,0)="""RTN"",""IBJPI"",287,0)"
^XMB(3.9,146047,2,3546,0)=" D SET1(IBY,LINE,COL,$L(IBY))"
^XMB(3.9,146047,2,3547,0)="""RTN"",""IBJPI"",288,0)"
^XMB(3.9,146047,2,3548,0)=" S LINE=LINE+1"
^XMB(3.9,146047,2,3549,0)="""RTN"",""IBJPI"",289,0)"
^XMB(3.9,146047,2,3550,0)=" Q LINE"
^XMB(3.9,146047,2,3551,0)="""RTN"",""IBJPI"",290,0)"
^XMB(3.9,146047,2,3552,0)=" ;"
^XMB(3.9,146047,2,3553,0)="""RTN"",""IBJPI"",291,0)"
^XMB(3.9,146047,2,3554,0)="SETN(TITLE,LINE,COL,RV,ULINE) ; Sets a field Section title into the body of the worklist"
^XMB(3.9,146047,2,3555,0)="""RTN"",""IBJPI"",292,0)"
^XMB(3.9,146047,2,3556,0)=" ; Input:   TITLE   - Text to be used for the field Section Title"
^XMB(3.9,146047,2,3557,0)="""RTN"",""IBJPI"",293,0)"
^XMB(3.9,146047,2,3558,0)=" ;          LINE    - Line number in the body to insert the field section title"
^XMB(3.9,146047,2,3559,0)="""RTN"",""IBJPI"",294,0)"
^XMB(3.9,146047,2,3560,0)=" ;          COL     - Starting Column position to set Section Title into"
^XMB(3.9,146047,2,3561,0)="""RTN"",""IBJPI"",295,0)"
^XMB(3.9,146047,2,3562,0)=" ;          RV      - 1 - Set Reverse Video, 0 or null don't use Reverse Video"
^XMB(3.9,146047,2,3563,0)="""RTN"",""IBJPI"",296,0)"
^XMB(3.9,146047,2,3564,0)=" ;                        Optional, defaults to """""
^XMB(3.9,146047,2,3565,0)="""RTN"",""IBJPI"",297,0)"
^XMB(3.9,146047,2,3566,0)=" ;          ULINE   - 1 - Set Underline, 0 or null don't use underline"
^XMB(3.9,146047,2,3567,0)="""RTN"",""IBJPI"",298,0)"
^XMB(3.9,146047,2,3568,0)=" ;                        Optional, defaults to """""
^XMB(3.9,146047,2,3569,0)="""RTN"",""IBJPI"",299,0)"
