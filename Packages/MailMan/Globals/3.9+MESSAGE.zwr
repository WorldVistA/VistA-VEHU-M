^XMB(3.9,146017,2,2394,0)="VALIDATE(ERRORS,SDINPUT,STARTDTFM,ENDDTFM,NUMBERRET) ;"
^XMB(3.9,146017,2,2395,0)="""RTN"",""SDES2GETCLINAVL"",39,0)"
^XMB(3.9,146017,2,2396,0)=" N ERRORNUM,PRIMAMIS,STARTDT,ENDDT,DATERESULT,INST"
^XMB(3.9,146017,2,2397,0)="""RTN"",""SDES2GETCLINAVL"",40,0)"
^XMB(3.9,146017,2,2398,0)=" ; Validate Station Number"
^XMB(3.9,146017,2,2399,0)="""RTN"",""SDES2GETCLINAVL"",41,0)"
^XMB(3.9,146017,2,2400,0)=" I $G(SDINPUT(""STATION""))="""" D ERRLOG^SDES2JSON(.ERRORS,196)"
^XMB(3.9,146017,2,2401,0)="""RTN"",""SDES2GETCLINAVL"",42,0)"
^XMB(3.9,146017,2,2402,0)=" I $G(SDINPUT(""STATION""))'="""" D"
^XMB(3.9,146017,2,2403,0)="""RTN"",""SDES2GETCLINAVL"",43,0)"
^XMB(3.9,146017,2,2404,0)=" .S INST=$$IEN^XUAF4($G(SDINPUT(""STATION"")))"
^XMB(3.9,146017,2,2405,0)="""RTN"",""SDES2GETCLINAVL"",44,0)"
^XMB(3.9,146017,2,2406,0)=" .I 'INST D ERRLOG^SDES2JSON(.ERRORS,197)"
^XMB(3.9,146017,2,2407,0)="""RTN"",""SDES2GETCLINAVL"",45,0)"
^XMB(3.9,146017,2,2408,0)=" ; Validate Primary Amis"
^XMB(3.9,146017,2,2409,0)="""RTN"",""SDES2GETCLINAVL"",46,0)"
^XMB(3.9,146017,2,2410,0)=" S PRIMAMIS=$G(SDINPUT(""PRIMARY AMIS""))"
^XMB(3.9,146017,2,2411,0)="""RTN"",""SDES2GETCLINAVL"",47,0)"
^XMB(3.9,146017,2,2412,0)=" I PRIMAMIS D"
^XMB(3.9,146017,2,2413,0)="""RTN"",""SDES2GETCLINAVL"",48,0)"
^XMB(3.9,146017,2,2414,0)=" .S ERRORNUM=$$VALIDATEAMIS^SDES2UTIL($G(SDINPUT(""PRIMARY AMIS"")),""P"")"
^XMB(3.9,146017,2,2415,0)="""RTN"",""SDES2GETCLINAVL"",49,0)"
^XMB(3.9,146017,2,2416,0)=" .I ERRORNUM D ERRLOG^SDES2JSON(.ERRORS,ERRORNUM,PRIMAMIS) Q"
^XMB(3.9,146017,2,2417,0)="""RTN"",""SDES2GETCLINAVL"",50,0)"
^XMB(3.9,146017,2,2418,0)=" I 'PRIMAMIS D ERRLOG^SDES2JSON(.ERRORS,479)"
^XMB(3.9,146017,2,2419,0)="""RTN"",""SDES2GETCLINAVL"",51,0)"
^XMB(3.9,146017,2,2420,0)=" ; Validate secondary Amis"
^XMB(3.9,146017,2,2421,0)="""RTN"",""SDES2GETCLINAVL"",52,0)"
^XMB(3.9,146017,2,2422,0)=" I $D(SDINPUT(""CREDIT AMIS"")) D VALCRSTOP(.ERRORS,.SDINPUT)"
^XMB(3.9,146017,2,2423,0)="""RTN"",""SDES2GETCLINAVL"",53,0)"
^XMB(3.9,146017,2,2424,0)=" ;"
^XMB(3.9,146017,2,2425,0)="""RTN"",""SDES2GETCLINAVL"",54,0)"
^XMB(3.9,146017,2,2426,0)=" ; Validate start/end dates"
^XMB(3.9,146017,2,2427,0)="""RTN"",""SDES2GETCLINAVL"",55,0)"
^XMB(3.9,146017,2,2428,0)=" S DATERESULT=$$VALISODATERANGE^SDES2VALISODTTM(.ERRORS,$G(SDINPUT(""START DATE"")),$G(SDINPUT(""END DATE"")),1)"
^XMB(3.9,146017,2,2429,0)="""RTN"",""SDES2GETCLINAVL"",56,0)"
^XMB(3.9,146017,2,2430,0)=" I '$D(ERRORS) S STARTDTFM=$P(DATERESULT,U),ENDDTFM=$P(DATERESULT,U,2)"
^XMB(3.9,146017,2,2431,0)="""RTN"",""SDES2GETCLINAVL"",57,0)"
^XMB(3.9,146017,2,2432,0)=" ; Validate number returned"
^XMB(3.9,146017,2,2433,0)="""RTN"",""SDES2GETCLINAVL"",58,0)"
^XMB(3.9,146017,2,2434,0)=" I '$D(SDINPUT(""NUMBER RETURNED"")) S NUMBERRET=500"
^XMB(3.9,146017,2,2435,0)="""RTN"",""SDES2GETCLINAVL"",59,0)"
^XMB(3.9,146017,2,2436,0)=" I $D(SDINPUT(""NUMBER RETURNED"")) S NUMBERRET=$G(SDINPUT(""NUMBER RETURNED""))"
^XMB(3.9,146017,2,2437,0)="""RTN"",""SDES2GETCLINAVL"",60,0)"
^XMB(3.9,146017,2,2438,0)=" D VALNUM(.ERRORS,NUMBERRET)"
^XMB(3.9,146017,2,2439,0)="""RTN"",""SDES2GETCLINAVL"",61,0)"
^XMB(3.9,146017,2,2440,0)=" Q"
^XMB(3.9,146017,2,2441,0)="""RTN"",""SDES2GETCLINAVL"",62,0)"
^XMB(3.9,146017,2,2442,0)="GETAVAIL(RETURN,CLINLIST,START,END,STATION,NUMBER) ;"
^XMB(3.9,146017,2,2443,0)="""RTN"",""SDES2GETCLINAVL"",63,0)"
^XMB(3.9,146017,2,2444,0)=" N CLINNAME,RESOURCEIEN,SDERR,CLIN,GLOB,CNT,DONE,APPTDAT,APPTSTRT,APPTEND,AVAIL,SLOTS,DONE,AVAILDATE,SDECEND,BADATE,LOOP"
^XMB(3.9,146017,2,2445,0)="""RTN"",""SDES2GETCLINAVL"",64,0)"
^XMB(3.9,146017,2,2446,0)=" N PROV,PRVCNT,PRVID,DEFAULTPROVIDER,APPTSTRTDTTM,TOTALAVAILCNT,APPTENDDTTM"
^XMB(3.9,146017,2,2447,0)="""RTN"",""SDES2GETCLINAVL"",65,0)"
^XMB(3.9,146017,2,2448,0)=" S (CNT,DONE)=0"
^XMB(3.9,146017,2,2449,0)="""RTN"",""SDES2GETCLINAVL"",66,0)"
^XMB(3.9,146017,2,2450,0)=" S CLIN="""" F  S CLIN=$O(@CLINLIST@(CLIN),-1) Q:'CLIN!(DONE)  D"
^XMB(3.9,146017,2,2451,0)="""RTN"",""SDES2GETCLINAVL"",67,0)"
^XMB(3.9,146017,2,2452,0)=" .S GLOB=$NA(^TMP(""SDES2CLINAVAIL"",$J,""CLINSCHED"",CLIN)) K @GLOB"
^XMB(3.9,146017,2,2453,0)="""RTN"",""SDES2GETCLINAVL"",68,0)"
^XMB(3.9,146017,2,2454,0)=" .S BADATE=0"
^XMB(3.9,146017,2,2455,0)="""RTN"",""SDES2GETCLINAVL"",69,0)"
^XMB(3.9,146017,2,2456,0)=" .S AVAILDATE=$$FMADD^XLFDT(START,-1),SDECEND=END"
^XMB(3.9,146017,2,2457,0)="""RTN"",""SDES2GETCLINAVL"",70,0)"
^XMB(3.9,146017,2,2458,0)=" .F  S AVAILDATE=$$FMADD^XLFDT(AVAILDATE,1) Q:AVAILDATE>$P(SDECEND,""."",1)!(BADATE>0)!(DONE)  D  ;"
^XMB(3.9,146017,2,2459,0)="""RTN"",""SDES2GETCLINAVL"",71,0)"
^XMB(3.9,146017,2,2460,0)=" ..I AVAILDATE<0 S BADATE=1 Q"
^XMB(3.9,146017,2,2461,0)="""RTN"",""SDES2GETCLINAVL"",72,0)"
^XMB(3.9,146017,2,2462,0)=" ..I ($O(^SC(CLIN,""T"",0))="""")!($O(^SC(CLIN,""T"",0))>AVAILDATE) Q"
^XMB(3.9,146017,2,2463,0)="""RTN"",""SDES2GETCLINAVL"",73,0)"
^XMB(3.9,146017,2,2464,0)=" ..I $$GET1^DIQ(44,CLIN_"","",1918.5,""I"")'=""Y"",$D(^HOLIDAY(""B"",AVAILDATE)) Q   ;do not schedule on holidays"
^XMB(3.9,146017,2,2465,0)="""RTN"",""SDES2GETCLINAVL"",74,0)"
^XMB(3.9,146017,2,2466,0)=" ..Q:$$INACTIVE^SDESUTIL(CLIN,$P(AVAILDATE,""."",1))   ;don't get availability if clinic inactive on day AVAILDATE"
^XMB(3.9,146017,2,2467,0)="""RTN"",""SDES2GETCLINAVL"",75,0)"
^XMB(3.9,146017,2,2468,0)=" ..D RESAB^SDEC57(GLOB,CLIN,AVAILDATE,AVAILDATE_"".""_2359) Q:'$D(^TMP(""SDES2CLINAVAIL"",$J,""CLINSCHED"",CLIN))"
^XMB(3.9,146017,2,2469,0)="""RTN"",""SDES2GETCLINAVL"",76,0)"
^XMB(3.9,146017,2,2470,0)=" ..S LOOP=0 F  S LOOP=$O(^TMP(""SDES2CLINAVAIL"",$J,""CLINSCHED"",CLIN,LOOP)) Q:'LOOP!(DONE)  D"
^XMB(3.9,146017,2,2471,0)="""RTN"",""SDES2GETCLINAVL"",77,0)"
^XMB(3.9,146017,2,2472,0)=" ...S APPTDAT=$G(^TMP(""SDES2CLINAVAIL"",$J,""CLINSCHED"",CLIN,LOOP))"
^XMB(3.9,146017,2,2473,0)="""RTN"",""SDES2GETCLINAVL"",78,0)"
^XMB(3.9,146017,2,2474,0)=" ...S APPTSTRT=$P(APPTDAT,U,2)"
^XMB(3.9,146017,2,2475,0)="""RTN"",""SDES2GETCLINAVL"",79,0)"
^XMB(3.9,146017,2,2476,0)=" ...S APPTEND=$P(APPTDAT,U,3)"
^XMB(3.9,146017,2,2477,0)="""RTN"",""SDES2GETCLINAVL"",80,0)"
^XMB(3.9,146017,2,2478,0)=" ...S SLOTS=$P(APPTDAT,U,4)"
^XMB(3.9,146017,2,2479,0)="""RTN"",""SDES2GETCLINAVL"",81,0)"
^XMB(3.9,146017,2,2480,0)=" ...Q:SLOTS=0!(SLOTS="""")"
^XMB(3.9,146017,2,2481,0)="""RTN"",""SDES2GETCLINAVL"",82,0)"
^XMB(3.9,146017,2,2482,0)=" ...S AVAIL=$P(APPTDAT,U,5)"
^XMB(3.9,146017,2,2483,0)="""RTN"",""SDES2GETCLINAVL"",83,0)"
