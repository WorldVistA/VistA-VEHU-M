^XMB(3.9,146087,2,3215,0)="""RTN"",""YTQRQAD4"",94,0)"
^XMB(3.9,146087,2,3216,0)=" S D0=+$G(^SC(LOC,42)) I D0 D WIN^DGPMDDCF Q 'X  ; OOS"
^XMB(3.9,146087,2,3217,0)="""RTN"",""YTQRQAD4"",95,0)"
^XMB(3.9,146087,2,3218,0)=" S X=$G(^SC(LOC,""I"")) I +X=0 Q 1                 ; no inact dte"
^XMB(3.9,146087,2,3219,0)="""RTN"",""YTQRQAD4"",96,0)"
^XMB(3.9,146087,2,3220,0)=" I DT>$P(X,U)&($P(X,U,2)=""""!(DT<$P(X,U,2))) Q 0  ; chk react dte"
