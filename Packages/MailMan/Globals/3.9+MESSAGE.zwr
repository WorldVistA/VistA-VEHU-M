^XMB(3.9,146009,2,693,0)="""RTN"",""XUMVINPB"",8,0)"
^XMB(3.9,146009,2,694,0)=" ;**733 - STORY 1291666 (dri) add field 101.13"
^XMB(3.9,146009,2,695,0)="""RTN"",""XUMVINPB"",9,0)"
^XMB(3.9,146009,2,696,0)=" ;**819 - STORY VAMPI-29086 (jfw) See below for new fields"
