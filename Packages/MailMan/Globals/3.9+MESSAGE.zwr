^XMB(3.9,146035,2,440,0)=" Q"
^XMB(3.9,146035,2,441,0)="""RTN"",""PSOBBC"",101,0)"
^XMB(3.9,146035,2,442,0)=" ;"
^XMB(3.9,146035,2,443,0)="""RTN"",""PSOBBC"",102,0)"
^XMB(3.9,146035,2,444,0)="PROCESS ;"
^XMB(3.9,146035,2,445,0)="""RTN"",""PSOBBC"",103,0)"
^XMB(3.9,146035,2,446,0)=" S PSOBBC(""DFLG"")=0 D NOW^%DTC S TM=$E(%,1,12),TM1=$P(TM,""."",2)"
