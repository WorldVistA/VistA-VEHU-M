^XMB(3.9,146087,2,3459,0)="""RTN"",""YTQRQAD4"",216,0)"
^XMB(3.9,146087,2,3460,0)=" ..S (I,IHIT)=0 F  S I=$O(^XTMP(NOD,1,""instruments"",I)) Q:+I=0  D"
^XMB(3.9,146087,2,3461,0)="""RTN"",""YTQRQAD4"",217,0)"
^XMB(3.9,146087,2,3462,0)=" ...S ADMINID=+$G(^XTMP(NOD,1,""instruments"",I,""adminId""))"
