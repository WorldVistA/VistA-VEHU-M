^XMB(3.9,146082,2,313,0)="""RTN"",""XPDIST"",38,0)"
^XMB(3.9,146082,2,314,0)=" D ^XMD"
^XMB(3.9,146082,2,315,0)="""RTN"",""XPDIST"",39,0)"
^XMB(3.9,146082,2,316,0)=" Q"
^XMB(3.9,146082,2,317,0)="""RTN"",""XPDIST"",40,0)"
^XMB(3.9,146082,2,318,0)="TRACK() ;EF. Should VA track the installation of this patch at a national level?"
^XMB(3.9,146082,2,319,0)="""RTN"",""XPDIST"",41,0)"
^XMB(3.9,146082,2,320,0)=" Q:$G(XPY)="""" 0  ; No - National site tracking was not requested"
^XMB(3.9,146082,2,321,0)="""RTN"",""XPDIST"",42,0)"
^XMB(3.9,146082,2,322,0)=" ;Quit if not VA production primary domain"
^XMB(3.9,146082,2,323,0)="""RTN"",""XPDIST"",43,0)"
^XMB(3.9,146082,2,324,0)=" I $G(^XMB(""NETNAME""))'["".DOMAIN.EXT"" D BMES^XPDUTL("" Not a VA primary domain"") Q 0"
