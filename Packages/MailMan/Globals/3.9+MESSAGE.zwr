^XMB(3.9,146052,2,1834,0)=" W ?40,L,?58,L,!,?8,"">>  REPORT  OF  CONTACT  <<"",?40,L,$E(FBSITE,1,18),?58,L,?60,$P(VADM(2),""^"",2),!,?40,L,$E(FBSITE,19,30),?58,L,""DOB: "",$P(VADM(3),""^"",2),!,Q,!,?3,"" Name of Veteran"",?34,L,""Telephone No. of Vet."",?58,L,""Date of Contact"",!"
^XMB(3.9,146052,2,1835,0)="""RTN"",""FBCHPRC1"",6,0)"
^XMB(3.9,146052,2,1836,0)=" W ?34,L,?58,L,!,?3,$E(VADM(1),1,30),?34,L,VAPA(8),?58,L,?61,FB(4),!,Q,!,?3,"" Address of Veteran"",?58,L,""Type of Contact"",!,?3,VAPA(1),?58,L,!,?3,VAPA(4),"","",$P(VAPA(5),""^"",2)"
^XMB(3.9,146052,2,1837,0)="""RTN"",""FBCHPRC1"",7,0)"
^XMB(3.9,146052,2,1838,0)=" W "" "",$S('+$G(VAPA(11)):VAPA(6),$P(VAPA(11),U,2)]"""":$P(VAPA(11),U,2),1:VAPA(6)),?58,L"
^XMB(3.9,146052,2,1839,0)="""RTN"",""FBCHPRC1"",8,0)"
^XMB(3.9,146052,2,1840,0)=" W ?63,$S(FB(6)=""T"":""Telephone"",1:""Personal""),!,Q,!,?3,"" Person Contacted"",?58,L,""Telephone Number of"",!,?3,FB(7),?58,L,""  Person Contacted"",!,?3,FB(8),?58,L,?61,FB(18)"
^XMB(3.9,146052,2,1841,0)="""RTN"",""FBCHPRC1"",9,0)"
^XMB(3.9,146052,2,1842,0)=" W !?3,$S(FB(9)]"""":FB(9),1:FB(10)_"", ""_$S(FB(11)="""":""Unknown"",$D(^DIC(5,FB(11),0)):$P(^(0),""^""),1:""Unknown"")_"", ""_FB(12)) I FB(9)="""" W !,Q"
^XMB(3.9,146052,2,1843,0)="""RTN"",""FBCHPRC1"",10,0)"
^XMB(3.9,146052,2,1844,0)=" I FB(9)]"""" W !?3,FB(10),"", "",$S($D(^DIC(5,+FB(11),0)):$P(^(0),""^""),1:""Unknown""),"", "",FB(12),!,Q"
^XMB(3.9,146052,2,1845,0)="""RTN"",""FBCHPRC1"",11,0)"
^XMB(3.9,146052,2,1846,0)=" W !?15,""NOTIFICATION OF ADMISSION TO PRIVATE HOSPITAL"",!?14,$E(Q,1,47)"
^XMB(3.9,146052,2,1847,0)="""RTN"",""FBCHPRC1"",12,0)"
^XMB(3.9,146052,2,1848,0)=" W !?3,""AUTHORIZATION FROM DATE/TIME: "",FB(5),!?3,""DATE/TIME OF ADMISSION: "",FB(19),!?9,""NAME of HOSPITAL: "",FBVEN,!?18,""ADDRESS: "",FBVEN(1),?54,""PHONE: "",FBVEN(6),!?27,$S(FBVEN(2)]"""":FBVEN(2),1:FBVEN(3)_"", ""_FBVEN(4)_"" ""_FBVEN(5))"
^XMB(3.9,146052,2,1849,0)="""RTN"",""FBCHPRC1"",13,0)"
^XMB(3.9,146052,2,1850,0)=" I FBVEN(2)]"""" W !?27,FBVEN(3),"", "",FBVEN(4),"" "",FBVEN(5)"
^XMB(3.9,146052,2,1851,0)="""RTN"",""FBCHPRC1"",14,0)"
^XMB(3.9,146052,2,1852,0)=" W !?9,""PHYSICIAN'S NAME: "",$S(FB(13)="""":""Not Entered"",1:FB(13))"
^XMB(3.9,146052,2,1853,0)="""RTN"",""FBCHPRC1"",15,0)"
^XMB(3.9,146052,2,1854,0)=" W ?50,""PHONE: "",FB(14)"
^XMB(3.9,146052,2,1855,0)="""RTN"",""FBCHPRC1"",16,0)"
^XMB(3.9,146052,2,1856,0)=" W !?6,""TENTATIVE DIAGNOSIS: "",FB(15),!?11,""INSURANCE TYPE: "",FB(16),!?3,""MODE of TRANSPORTATION: "",FB(17)"
^XMB(3.9,146052,2,1857,0)="""RTN"",""FBCHPRC1"",17,0)"
^XMB(3.9,146052,2,1858,0)=" W !,?3,""ELIGIBILITY: "",$P(VAEL(1),""^"",2),"", "" I $O(VAEL(1,0)) F J=0:0 S J=$O(VAEL(1,J)) Q:J'>0  S X=$P(VAEL(1,J),""^"",2)_"", "" W:$X+$L(X)>80 !,?16 W X"
^XMB(3.9,146052,2,1859,0)="""RTN"",""FBCHPRC1"",18,0)"
^XMB(3.9,146052,2,1860,0)=" W !,Q D RPTC^FBCHPRC"
^XMB(3.9,146052,2,1861,0)="""RTN"",""FBCHPRC1"",19,0)"
^XMB(3.9,146052,2,1862,0)="BOT W ! S BOT=IOSL-($Y+11) F BT=1:1:BOT W !"
^XMB(3.9,146052,2,1863,0)="""RTN"",""FBCHPRC1"",20,0)"
^XMB(3.9,146052,2,1864,0)=" W ?3,""APPROVED/DISAPPROVED"",!!?2,""______________________"""
^XMB(3.9,146052,2,1865,0)="""RTN"",""FBCHPRC1"",21,0)"
^XMB(3.9,146052,2,1866,0)=" W !?3,$$SIGBLK^FBAAPRC($P(FB1(0),U,6))"
^XMB(3.9,146052,2,1867,0)="""RTN"",""FBCHPRC1"",22,0)"
^XMB(3.9,146052,2,1868,0)=" W !,Q,!,?6,""Division or Section"",?40,L,""   Executed by(signature and title)"",!,?7,""FEE BASIS SECTION"",?40,L,""   "",!,Q,!?3,""VA form 119C"""
^XMB(3.9,146052,2,1869,0)="""RTN"",""FBCHPRC1"",23,0)"
^XMB(3.9,146052,2,1870,0)=" Q"
^XMB(3.9,146052,2,1871,0)="""RTN"",""FBCHVP"")"
^XMB(3.9,146052,2,1872,0)="0^12^B23175690"
^XMB(3.9,146052,2,1873,0)="""RTN"",""FBCHVP"",1,0)"
^XMB(3.9,146052,2,1874,0)="FBCHVP ;AISC/CMR - VOID & CANCEL VOIDED INPATIENT PAYMENT ;5/16/14  16:17"
^XMB(3.9,146052,2,1875,0)="""RTN"",""FBCHVP"",2,0)"
^XMB(3.9,146052,2,1876,0)=" ;;3.5;FEE BASIS;**55,69,154**;JAN 30, 1995;Build 0"
^XMB(3.9,146052,2,1877,0)="""RTN"",""FBCHVP"",3,0)"
^XMB(3.9,146052,2,1878,0)=" ;;Per VA Directive 6402, this routine should not be modified."
^XMB(3.9,146052,2,1879,0)="""RTN"",""FBCHVP"",4,0)"
^XMB(3.9,146052,2,1880,0)=" ;Variable 'FBVOID' is set if cancelling a voided payment."
^XMB(3.9,146052,2,1881,0)="""RTN"",""FBCHVP"",5,0)"
^XMB(3.9,146052,2,1882,0)=" ;Variable 'FBTYPE' is set to 6 for CH or 7 for CNH."
^XMB(3.9,146052,2,1883,0)="""RTN"",""FBCHVP"",6,0)"
^XMB(3.9,146052,2,1884,0)=" D DT^DICRW"
^XMB(3.9,146052,2,1885,0)="""RTN"",""FBCHVP"",7,0)"
^XMB(3.9,146052,2,1886,0)="RDP ;Get veteran if they have an inpatient invoice (DFN)."
^XMB(3.9,146052,2,1887,0)="""RTN"",""FBCHVP"",8,0)"
^XMB(3.9,146052,2,1888,0)=" K ^TMP($J) W !! S DIC=161,DIC(0)=""AEMZ"",DIC(""S"")=""I $D(^FBAAI(""""AK"""",+Y))"" D ^DIC K DIC G Q:X=""""!($D(DTOUT))!($D(DUOUT)),RDP:Y<0 S DFN=+Y"
^XMB(3.9,146052,2,1889,0)="""RTN"",""FBCHVP"",9,0)"
^XMB(3.9,146052,2,1890,0)="RDV ;Get vendor if an inpatient provider for this patient (FBV)."
^XMB(3.9,146052,2,1891,0)="""RTN"",""FBCHVP"",10,0)"
^XMB(3.9,146052,2,1892,0)=" W !! S DIC=161.2,DIC(0)=""AEMZ"",DIC(""S"")=""I $D(^FBAAI(""""AK"""",DFN,+Y))"" D ^DIC K DIC G Q:X=""""!($D(DTOUT))!($D(DUOUT)),RDV:Y<0 S FBV=+Y"
^XMB(3.9,146052,2,1893,0)="""RTN"",""FBCHVP"",11,0)"
^XMB(3.9,146052,2,1894,0)=" D EN1"
^XMB(3.9,146052,2,1895,0)="""RTN"",""FBCHVP"",12,0)"
^XMB(3.9,146052,2,1896,0)=" I FBCTR=0 W !!?12,*7,""Vendor has no"",$S($D(FBVOID):"" VOIDED"",1:""""),"" finalized payments "",$S('$D(FBVOID):""to VOID"",1:""""),!?12,""for this patient under the "",$S(FBTYPE=6:""CIVIL HOSPITAL"",1:""COMMUNITY NURSING HOME""),"" program."" G RDV"
^XMB(3.9,146052,2,1897,0)="""RTN"",""FBCHVP"",13,0)"
^XMB(3.9,146052,2,1898,0)=" W !!,""Which payment item(s) would you like to "",$S($D(FBVOID):""Cancel the void on"",1:""Void""),"" ? "" S DIR(0)=""L^1:""_FBCTR D ^DIR G RDV:$D(DIRUT) S FBX=Y W @IOF D HED"
^XMB(3.9,146052,2,1899,0)="""RTN"",""FBCHVP"",14,0)"
^XMB(3.9,146052,2,1900,0)=" F A=1:1:FBCTR S X=$P(FBX,"","",A) Q:X=""""  S FBI=+FBI(X),FBINV=^TMP($J,""FBCHVP"",FBI),FBVD=$P(FBINV,""^"",14) W ! D WRT1 S ^TMP($J,""FBCHVP"",""VOID"",FBI)="""""
^XMB(3.9,146052,2,1901,0)="""RTN"",""FBCHVP"",15,0)"
^XMB(3.9,146052,2,1902,0)=" W ! S DIR(0)=""Y"",DIR(""A"")=""Are you sure you want to ""_$S($D(FBVOID):""Cancel the void on"",1:""Void"")_"" the payment(s)"",DIR(""B"")=""No"" D ^DIR K DIR G RDP:$D(DIRUT)!'Y"
^XMB(3.9,146052,2,1903,0)="""RTN"",""FBCHVP"",16,0)"
^XMB(3.9,146052,2,1904,0)=" S FBI=0 F  S FBI=$O(^TMP($J,""FBCHVP"",""VOID"",FBI)) Q:FBI'>0  D SETR,CONF W !,?5,"".... Done."",!"
^XMB(3.9,146052,2,1905,0)="""RTN"",""FBCHVP"",17,0)"
^XMB(3.9,146052,2,1906,0)="Q K DFN,FBV,FBI,FBTYPE,FBVOID,FBCTR,FBAMTC,FBAMTP,FBBAT,FBDRG,FBFDT,FBINV,FBNUM,FBREIM,FBTDT,FBVD,Q,FBX,VP,^TMP($J,""FBCHVP""),Y,DIE,DR,FBVR,DA"
^XMB(3.9,146052,2,1907,0)="""RTN"",""FBCHVP"",18,0)"
^XMB(3.9,146052,2,1908,0)=" Q"
^XMB(3.9,146052,2,1909,0)="""RTN"",""FBCHVP"",19,0)"
^XMB(3.9,146052,2,1910,0)="EN1 ;Find finalized payments that match FBTYPE and store in ^TMP."
^XMB(3.9,146052,2,1911,0)="""RTN"",""FBCHVP"",20,0)"
^XMB(3.9,146052,2,1912,0)=" S (FBI,FBCTR)=0,Q=""-"",$P(Q,""-"",80)=""-"""
^XMB(3.9,146052,2,1913,0)="""RTN"",""FBCHVP"",21,0)"
^XMB(3.9,146052,2,1914,0)=" S IOP=$S($D(ION):ION,1:""HOME"") D ^%ZIS K IOP"
^XMB(3.9,146052,2,1915,0)="""RTN"",""FBCHVP"",22,0)"
^XMB(3.9,146052,2,1916,0)=" F  S FBI=$O(^FBAAI(""AK"",DFN,FBV,FBI)) Q:FBI'>0  I $D(^FBAAI(FBI,0)),'$D(^(""FBREJ"")) S FBINV=^(0),FBVD=$P(FBINV,""^"",14) I $P(FBINV,""^"",16)'=""""&($P(FBINV,""^"",12)=FBTYPE)&($S($D(FBVOID):(FBVD=""VP""),1:(FBVD=""""))) D WRT"
^XMB(3.9,146052,2,1917,0)="""RTN"",""FBCHVP"",23,0)"
^XMB(3.9,146052,2,1918,0)=" Q"
^XMB(3.9,146052,2,1919,0)="""RTN"",""FBCHVP"",24,0)"
^XMB(3.9,146052,2,1920,0)="WRT N FBX,FBY2,FBY3,FBCDAYS,FBSCID,FBFPPSC,FBFPPSL,FBADJLR,FBRRMKL"
^XMB(3.9,146052,2,1921,0)="""RTN"",""FBCHVP"",25,0)"
^XMB(3.9,146052,2,1922,0)=" S FBX=$$ADJLRA^FBCHFA(FBI_"","")"
^XMB(3.9,146052,2,1923,0)="""RTN"",""FBCHVP"",26,0)"
^XMB(3.9,146052,2,1924,0)=" S FBY2=$G(^FBAAI(FBI,2))"
^XMB(3.9,146052,2,1925,0)="""RTN"",""FBCHVP"",27,0)"
^XMB(3.9,146052,2,1926,0)=" S FBY3=$G(^FBAAI(FBI,3))"
^XMB(3.9,146052,2,1927,0)="""RTN"",""FBCHVP"",28,0)"
^XMB(3.9,146052,2,1928,0)=" S FBCDAYS=$P(FBY2,U,10)  ; covered days"
^XMB(3.9,146052,2,1929,0)="""RTN"",""FBCHVP"",29,0)"
^XMB(3.9,146052,2,1930,0)=" S FBSCID=$P(FBY2,U,11)  ; patient control number"
^XMB(3.9,146052,2,1931,0)="""RTN"",""FBCHVP"",30,0)"
^XMB(3.9,146052,2,1932,0)=" S FBFPPSC=$P(FBY3,U)  ; fpps claim id"
^XMB(3.9,146052,2,1933,0)="""RTN"",""FBCHVP"",31,0)"
^XMB(3.9,146052,2,1934,0)=" S FBFPPSL=$P(FBY3,U,2)  ; fpps line item"
^XMB(3.9,146052,2,1935,0)="""RTN"",""FBCHVP"",32,0)"
^XMB(3.9,146052,2,1936,0)=" S FBRRMKL=$$RRL^FBCHFR(FBI_"","")  ; remit remarks"
^XMB(3.9,146052,2,1937,0)="""RTN"",""FBCHVP"",33,0)"
^XMB(3.9,146052,2,1938,0)=" S FBADJLR=$P(FBX,U)  ; adjustment reason"
^XMB(3.9,146052,2,1939,0)="""RTN"",""FBCHVP"",34,0)"
^XMB(3.9,146052,2,1940,0)=" S ^TMP($J,""FBCHVP"",FBI)=FBINV"
^XMB(3.9,146052,2,1941,0)="""RTN"",""FBCHVP"",35,0)"
^XMB(3.9,146052,2,1942,0)=" S ^TMP($J,""FBCHVP"",FBI,""FBMR"")=FBCDAYS_U_FBADJLR_U_FBRRMKL_U_FBSCID_U_FBFPPSC_U_FBFPPSL"
^XMB(3.9,146052,2,1943,0)="""RTN"",""FBCHVP"",36,0)"
^XMB(3.9,146052,2,1944,0)=" I FBCTR=0!($Y+5>IOSL) W @IOF D HED"
^XMB(3.9,146052,2,1945,0)="""RTN"",""FBCHVP"",37,0)"
^XMB(3.9,146052,2,1946,0)=" S FBCTR=FBCTR+1,FBI(FBCTR)=FBI"
^XMB(3.9,146052,2,1947,0)="""RTN"",""FBCHVP"",38,0)"
^XMB(3.9,146052,2,1948,0)=" W !,FBCTR_"") "" D WRT1 I $D(FBVOID)&($D(^FBAAI(FBI,""R""))) W !?3,""Reason:"",!?10,^(""R""),!"
^XMB(3.9,146052,2,1949,0)="""RTN"",""FBCHVP"",39,0)"
^XMB(3.9,146052,2,1950,0)=" Q"
^XMB(3.9,146052,2,1951,0)="""RTN"",""FBCHVP"",40,0)"
^XMB(3.9,146052,2,1952,0)="WRT1 N FBMRVP S FBMRVP=^TMP($J,""FBCHVP"",FBI,""FBMR"")"
^XMB(3.9,146052,2,1953,0)="""RTN"",""FBCHVP"",41,0)"
^XMB(3.9,146052,2,1954,0)=" S FBREIM=$P(FBINV,""^"",13),FBFDT=$P(FBINV,""^"",6),FBTDT=$P(FBINV,""^"",7),FBDRG=$P(FBINV,""^"",24),FBAMTC=$P(FBINV,""^"",8),FBAMTP=$P(FBINV,""^"",9),FBNUM=+FBINV,FBBAT=$P(FBINV,""^"",17)"
^XMB(3.9,146052,2,1955,0)="""RTN"",""FBCHVP"",42,0)"
^XMB(3.9,146052,2,1956,0)=" D FBCKI^FBAACCB1(FBI)"
^XMB(3.9,146052,2,1957,0)="""RTN"",""FBCHVP"",43,0)"
^XMB(3.9,146052,2,1958,0)=" W $S(FBREIM=""R"":""*"",1:""""),$S(FBVD=""VP"":""#"",1:""""),?3,$$DATX^FBAAUTL(FBFDT),?16,$$DATX^FBAAUTL(FBTDT)"
^XMB(3.9,146052,2,1959,0)="""RTN"",""FBCHVP"",44,0)"
^XMB(3.9,146052,2,1960,0)=" W ?26,$S($G(FBDRG):$J($$ICD^FBCSV1(FBDRG,$G(FBFDT)),4),1:""""),?35,$J($FN(FBAMTC,"","",2),8),?48,$J($FN(FBAMTP,"","",2),8),?62,$J(FBNUM,5),?72,$J($P($G(^FBAA(161.7,+FBBAT,0)),""^""),6)"
^XMB(3.9,146052,2,1961,0)="""RTN"",""FBCHVP"",45,0)"
^XMB(3.9,146052,2,1962,0)=" W !,?5,$P(FBMRVP,U),?19,$P(FBMRVP,U,2),?34,$P(FBMRVP,U,3),?54,$P(FBMRVP,U,4)"
^XMB(3.9,146052,2,1963,0)="""RTN"",""FBCHVP"",46,0)"
^XMB(3.9,146052,2,1964,0)=" I $P(FBMRVP,U,5)]"""" W !,?5,""FPPS Claim ID: "",$P(FBMRVP,U,5),?33,""FPPS Line Item: "",$P(FBMRVP,U,6)"
^XMB(3.9,146052,2,1965,0)="""RTN"",""FBCHVP"",47,0)"
^XMB(3.9,146052,2,1966,0)=" N A2 S A2=+FBAMTP D PMNT^FBAACCB2"
^XMB(3.9,146052,2,1967,0)="""RTN"",""FBCHVP"",48,0)"
^XMB(3.9,146052,2,1968,0)=" Q"
^XMB(3.9,146052,2,1969,0)="""RTN"",""FBCHVP"",49,0)"
^XMB(3.9,146052,2,1970,0)="HED W !,""Patient Name: "",$P(^DPT(DFN,0),""^""),?50,""Pt.ID "",$$SSN^FBAAUTL(DFN),!!,?2,""VENDOR: "",$P(^FBAAV(FBV,0),""^""),!,?10,""('*' Represents Reimbursement to Patient)"",!,?10,""('#' Represents a Voided Payment)"""
^XMB(3.9,146052,2,1971,0)="""RTN"",""FBCHVP"",50,0)"
^XMB(3.9,146052,2,1972,0)=" W !,""   FROM DATE"",?16,""TO DATE"",?26,""DRG"",?33,""AMT CLAIMED"",?48,""AMT PAID"",?60,""INVOICE #"",?72,""BATCH #"""
^XMB(3.9,146052,2,1973,0)="""RTN"",""FBCHVP"",51,0)"
^XMB(3.9,146052,2,1974,0)=" W !,?5,""COV.DAYS"",?19,""ADJ CODE"",?34,""REMIT REMARKS"",?55,""PATIENT CONTROL #"""
^XMB(3.9,146052,2,1975,0)="""RTN"",""FBCHVP"",52,0)"
^XMB(3.9,146052,2,1976,0)=" W !,Q,!"
