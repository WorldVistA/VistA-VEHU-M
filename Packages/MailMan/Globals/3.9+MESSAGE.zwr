^XMB(3.9,146057,2,446,0)=" . ;"
^XMB(3.9,146057,2,447,0)="""RTN"",""HLCS2"",104,0)"
^XMB(3.9,146057,2,448,0)=" . ;4=status,10=Time Stopped,9=Time Started,11=Task Number,3=Device Type,14=shutdown?"
^XMB(3.9,146057,2,449,0)="""RTN"",""HLCS2"",105,0)"
^XMB(3.9,146057,2,450,0)=" . S X=""HLJ(870,""""""_HLDP_"","""")"",@X@(10)=$$NOW^XLFDT,(@X@(11),@X@(9))=""@"",@X@(14)=1"
^XMB(3.9,146057,2,451,0)="""RTN"",""HLCS2"",106,0)"
^XMB(3.9,146057,2,452,0)=" . I ""Shutdown,SHUTDOWN""'[$P(HLDP0,U,5) S @X@(4)=""Halting"""
^XMB(3.9,146057,2,453,0)="""RTN"",""HLCS2"",107,0)"
^XMB(3.9,146057,2,454,0)=" . I $P(HLPARM4,U,3)=""C""&(""N""[$P(HLPARM4,U,4)),'$P(HLDP0,U,12) S @X@(4)=""Shutdown"""
^XMB(3.9,146057,2,455,0)="""RTN"",""HLCS2"",108,0)"
