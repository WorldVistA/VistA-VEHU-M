^XMB(3.9,146011,2,716,0)=" . S DIR(0)=""S^1:INSUFFICIENT QTY IN STOCK;7:BAD ADDRESS;8:PER PATIENT REQUEST;98:OTHER/TECH (NON-CLINICAL)"""
^XMB(3.9,146011,2,717,0)="""RTN"",""PSOHLD"",134,0)"
