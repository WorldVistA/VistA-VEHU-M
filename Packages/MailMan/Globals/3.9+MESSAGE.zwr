^XMB(3.9,146037,2,2542,0)=" ; Prompt for device"
^XMB(3.9,146037,2,2543,0)="""RTN"",""RCDPTAR1"",115,0)"
^XMB(3.9,146037,2,2544,0)=" N %ZIS,POP,ZTSK,ZTRTN,ZTIO,ZTDESC,ZTSAVE"
^XMB(3.9,146037,2,2545,0)="""RTN"",""RCDPTAR1"",116,0)"
