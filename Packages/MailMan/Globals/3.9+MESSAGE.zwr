^XMB(3.9,146091,2,319,0)="""RTN"",""MAGQBUT4"",35,0)"
^XMB(3.9,146091,2,320,0)=" S SLINE=$T(+2)"
^XMB(3.9,146091,2,321,0)="""RTN"",""MAGQBUT4"",36,0)"
^XMB(3.9,146091,2,322,0)=" S PNUM=$$TRIM($P(SLINE,""**"",2)),PNUM=$$TRIM($P(PNUM,"","",$L(PNUM,"","")))"
