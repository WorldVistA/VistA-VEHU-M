^XMB(3.9,146012,2,248,0)="0^3^B24701665"
^XMB(3.9,146012,2,249,0)="""RTN"",""PSOERPC2"",1,0)"
^XMB(3.9,146012,2,250,0)="PSOERPC2 ;BIRM/MFR - All Patients (Patient Centric) eRx Queue - Supporting APIs 2 ;09/28/22"
^XMB(3.9,146012,2,251,0)="""RTN"",""PSOERPC2"",2,0)"
^XMB(3.9,146012,2,252,0)=" ;;7.0;OUTPATIENT PHARMACY;**700,746**;DEC 1997;Build 0"
^XMB(3.9,146012,2,253,0)="""RTN"",""PSOERPC2"",3,0)"
^XMB(3.9,146012,2,254,0)=" ;"
^XMB(3.9,146012,2,255,0)="""RTN"",""PSOERPC2"",4,0)"
^XMB(3.9,146012,2,256,0)="INIT ; Initialization for the option (Setting global variables, Reviewing Locks, Holds, etc.)"
^XMB(3.9,146012,2,257,0)="""RTN"",""PSOERPC2"",5,0)"
^XMB(3.9,146012,2,258,0)=" ; MBMSITE indicates whether it's an MbM site or not, RESETLBD indicates whether the Look Back Days should be reset"
^XMB(3.9,146012,2,259,0)="""RTN"",""PSOERPC2"",6,0)"
^XMB(3.9,146012,2,260,0)=" S MBMSITE=$S($$GET1^DIQ(59.7,1,102,""I"")=""MBM"":1,1:0),RESETLBD=1"
^XMB(3.9,146012,2,261,0)="""RTN"",""PSOERPC2"",7,0)"
^XMB(3.9,146012,2,262,0)=" ;Review/Clean-up Locks (e.g.,Session crased and ^XTMP global remained)"
^XMB(3.9,146012,2,263,0)="""RTN"",""PSOERPC2"",8,0)"
^XMB(3.9,146012,2,264,0)=" D REVLOCKS"
^XMB(3.9,146012,2,265,0)="""RTN"",""PSOERPC2"",9,0)"
^XMB(3.9,146012,2,266,0)=" ;Review/Releases Future Fill Holds"
^XMB(3.9,146012,2,267,0)="""RTN"",""PSOERPC2"",10,0)"
^XMB(3.9,146012,2,268,0)=" D UHFFS"
^XMB(3.9,146012,2,269,0)="""RTN"",""PSOERPC2"",11,0)"
^XMB(3.9,146012,2,270,0)=" Q"
^XMB(3.9,146012,2,271,0)="""RTN"",""PSOERPC2"",12,0)"
^XMB(3.9,146012,2,272,0)=" ;"
^XMB(3.9,146012,2,273,0)="""RTN"",""PSOERPC2"",13,0)"
^XMB(3.9,146012,2,274,0)="REVLOCKS ; Review/Clean-up Locks"
^XMB(3.9,146012,2,275,0)="""RTN"",""PSOERPC2"",14,0)"
^XMB(3.9,146012,2,276,0)=" N ERXPATID,LKTOUT,DIE,DR,DA"
^XMB(3.9,146012,2,277,0)="""RTN"",""PSOERPC2"",15,0)"
^XMB(3.9,146012,2,278,0)=" S (ERXPATID,LKTOUT)=0 F  S ERXPATID=$O(^XTMP(""PSOERXLOCK"",ERXPATID)) Q:'ERXPATID  D"
^XMB(3.9,146012,2,279,0)="""RTN"",""PSOERPC2"",16,0)"
^XMB(3.9,146012,2,280,0)=" . L +^XTMP(""PSOERXLOCK"",ERXPATID):LKTOUT I '$T Q"
^XMB(3.9,146012,2,281,0)="""RTN"",""PSOERPC2"",17,0)"
^XMB(3.9,146012,2,282,0)=" . L -^XTMP(""PSOERXLOCK"",ERXPATID) K ^XTMP(""PSOERXLOCK"",ERXPATID)"
^XMB(3.9,146012,2,283,0)="""RTN"",""PSOERPC2"",18,0)"
^XMB(3.9,146012,2,284,0)=" . S DIE=""^PS(52.46,"",DR=""6///@"",DA=ERXPATID D ^DIE"
^XMB(3.9,146012,2,285,0)="""RTN"",""PSOERPC2"",19,0)"
^XMB(3.9,146012,2,286,0)=" Q"
^XMB(3.9,146012,2,287,0)="""RTN"",""PSOERPC2"",20,0)"
^XMB(3.9,146012,2,288,0)=" ;"
^XMB(3.9,146012,2,289,0)="""RTN"",""PSOERPC2"",21,0)"
^XMB(3.9,146012,2,290,0)="UHFFS ; Un-Hold Future Fills that are Due"
^XMB(3.9,146012,2,291,0)="""RTN"",""PSOERPC2"",22,0)"
^XMB(3.9,146012,2,292,0)=" N ERX,HFFIEN,INST,MSGDT,HFFDT,UHSTS,DIE,ERX,DA,DR"
^XMB(3.9,146012,2,293,0)="""RTN"",""PSOERPC2"",23,0)"
^XMB(3.9,146012,2,294,0)=" S HFFIEN=$O(^PS(52.45,""B"",""HFF"",0)) I 'HFFIEN Q"
^XMB(3.9,146012,2,295,0)="""RTN"",""PSOERPC2"",24,0)"
^XMB(3.9,146012,2,296,0)=" S (INST,ERX)=0,MSGDT="""""
^XMB(3.9,146012,2,297,0)="""RTN"",""PSOERPC2"",25,0)"
^XMB(3.9,146012,2,298,0)=" F  S INST=$O(^PS(52.49,""E"",INST)) Q:'INST  D"
^XMB(3.9,146012,2,299,0)="""RTN"",""PSOERPC2"",26,0)"
^XMB(3.9,146012,2,300,0)=" . F  S MSGDT=$O(^PS(52.49,""E"",INST,HFFIEN,MSGDT)) Q:'MSGDT  D"
^XMB(3.9,146012,2,301,0)="""RTN"",""PSOERPC2"",27,0)"
^XMB(3.9,146012,2,302,0)=" . . F  S ERX=$O(^PS(52.49,""E"",INST,HFFIEN,MSGDT,ERX)) Q:'ERX  D"
^XMB(3.9,146012,2,303,0)="""RTN"",""PSOERPC2"",28,0)"
^XMB(3.9,146012,2,304,0)=" . . . S HFFDT=$$GET1^DIQ(52.49,ERX,6.7,""I"") I HFFDT>DT Q"
^XMB(3.9,146012,2,305,0)="""RTN"",""PSOERPC2"",29,0)"
^XMB(3.9,146012,2,306,0)=" . . . S UHSTS=$$UHSTS^PSOERXH1(ERX)"
^XMB(3.9,146012,2,307,0)="""RTN"",""PSOERPC2"",30,0)"
^XMB(3.9,146012,2,308,0)=" . . . D UPDSTAT^PSOERXU1(ERX,UHSTS,""Future Fill Automatically Un-Held"",,$$PROXYDUZ^PSOERXUT())"
^XMB(3.9,146012,2,309,0)="""RTN"",""PSOERPC2"",31,0)"
^XMB(3.9,146012,2,310,0)=" . . . K DIE S DIE=""52.49"",DA=ERX,DR=""6.7///@"" D ^DIE K DIE"
^XMB(3.9,146012,2,311,0)="""RTN"",""PSOERPC2"",32,0)"
^XMB(3.9,146012,2,312,0)=" Q"
^XMB(3.9,146012,2,313,0)="""RTN"",""PSOERPC2"",33,0)"
^XMB(3.9,146012,2,314,0)=" ;"
^XMB(3.9,146012,2,315,0)="""RTN"",""PSOERPC2"",34,0)"
^XMB(3.9,146012,2,316,0)="MATCHLBL(MATCH) ; Match Filter Label"
^XMB(3.9,146012,2,317,0)="""RTN"",""PSOERPC2"",35,0)"
^XMB(3.9,146012,2,318,0)=" I MATCH=1 Q $S($G(MBMSITE):""PATIENT FAIL"",1:""PATIENT NOT MATCHED"")"
^XMB(3.9,146012,2,319,0)="""RTN"",""PSOERPC2"",36,0)"
^XMB(3.9,146012,2,320,0)=" I MATCH=2 Q $S($G(MBMSITE):""PROVIDER FAIL"",1:""PROVIDER NOT MATCHED"")"
^XMB(3.9,146012,2,321,0)="""RTN"",""PSOERPC2"",37,0)"
^XMB(3.9,146012,2,322,0)=" I MATCH=3 Q $S($G(MBMSITE):""DRUG FAIL"",1:""DRUG NOT MATCHED"")"
^XMB(3.9,146012,2,323,0)="""RTN"",""PSOERPC2"",38,0)"
^XMB(3.9,146012,2,324,0)=" I MATCH=4 Q $S($G(MBMSITE):""BASIC"",1:""ALL MATCHED"")"
^XMB(3.9,146012,2,325,0)="""RTN"",""PSOERPC2"",39,0)"
^XMB(3.9,146012,2,326,0)=" Q """""
^XMB(3.9,146012,2,327,0)="""RTN"",""PSOERPC2"",40,0)"
^XMB(3.9,146012,2,328,0)=" ;"
^XMB(3.9,146012,2,329,0)="""RTN"",""PSOERPC2"",41,0)"
^XMB(3.9,146012,2,330,0)="MATCHFLT(FILTER,ERXPAT) ; Check whether the patient qualifies for Match Filter"
^XMB(3.9,146012,2,331,0)="""RTN"",""PSOERPC2"",42,0)"
^XMB(3.9,146012,2,332,0)=" ; Input: FILTER - Filter Value: 1 - Patient Fail | 2 - Provider Fail | 3 - Drug Fail | 4 - Basic (All matched) | 5 - All"
^XMB(3.9,146012,2,333,0)="""RTN"",""PSOERPC2"",43,0)"
^XMB(3.9,146012,2,334,0)=" ;        ERXPAT - eRx Patient IEN (Pointer to #52.46)"
^XMB(3.9,146012,2,335,0)="""RTN"",""PSOERPC2"",44,0)"
^XMB(3.9,146012,2,336,0)=" ;Ouptut: 1 - Patient qualifies for Match Filter | 0 - Patient does not qualify"
^XMB(3.9,146012,2,337,0)="""RTN"",""PSOERPC2"",45,0)"
^XMB(3.9,146012,2,338,0)=" ;"
^XMB(3.9,146012,2,339,0)="""RTN"",""PSOERPC2"",46,0)"
^XMB(3.9,146012,2,340,0)=" N MATCHFLT,RECDAT,ERXIEN,CSERX,MTYPE,ERXSTAT,VPATIEN,VPRVIEN,VDRGIEN,FOUNDONE,STATIEN"
^XMB(3.9,146012,2,341,0)="""RTN"",""PSOERPC2"",47,0)"
^XMB(3.9,146012,2,342,0)=" S FILTER=+$G(FILTER) I FILTER=5!'FILTER Q 1"
^XMB(3.9,146012,2,343,0)="""RTN"",""PSOERPC2"",48,0)"
^XMB(3.9,146012,2,344,0)=" S FOUNDONE=0,MATCHFLT=0"
^XMB(3.9,146012,2,345,0)="""RTN"",""PSOERPC2"",49,0)"
^XMB(3.9,146012,2,346,0)=" I FILTER=4 S MATCHFLT=1"
^XMB(3.9,146012,2,347,0)="""RTN"",""PSOERPC2"",50,0)"
^XMB(3.9,146012,2,348,0)=" S RECDAT=$$FMADD^XLFDT(DT,-PSOLKBKD)"
^XMB(3.9,146012,2,349,0)="""RTN"",""PSOERPC2"",51,0)"
^XMB(3.9,146012,2,350,0)=" F  S RECDAT=$O(^PS(52.49,""PAT2"",ERXPAT,RECDAT)) Q:'RECDAT  D  Q:(FILTER=4&'MATCHFLT)  Q:(FILTER'=4&MATCHFLT)"
^XMB(3.9,146012,2,351,0)="""RTN"",""PSOERPC2"",52,0)"
^XMB(3.9,146012,2,352,0)=" . S ERXIEN=0 F  S ERXIEN=$O(^PS(52.49,""PAT2"",ERXPAT,RECDAT,ERXIEN)) Q:'ERXIEN  D  Q:(FILTER=4&'MATCHFLT)  Q:(FILTER'=4&MATCHFLT)"
^XMB(3.9,146012,2,353,0)="""RTN"",""PSOERPC2"",53,0)"
^XMB(3.9,146012,2,354,0)=" . . S CSERX=+$G(^PS(52.49,ERXIEN,95))"
^XMB(3.9,146012,2,355,0)="""RTN"",""PSOERPC2"",54,0)"
^XMB(3.9,146012,2,356,0)=" . . S MTYPE=$P($G(^PS(52.49,ERXIEN,0)),""^"",8)"
^XMB(3.9,146012,2,357,0)="""RTN"",""PSOERPC2"",55,0)"
^XMB(3.9,146012,2,358,0)=" . . S STATIEN=+$G(^PS(52.49,ERXIEN,1)),ERXSTAT=$P(^PS(52.45,STATIEN,0),""^"")"
^XMB(3.9,146012,2,359,0)="""RTN"",""PSOERPC2"",56,0)"
^XMB(3.9,146012,2,360,0)=" . . ; Exclude eRx's on Hold"
^XMB(3.9,146012,2,361,0)="""RTN"",""PSOERPC2"",57,0)"
^XMB(3.9,146012,2,362,0)=" . . I $E(ERXSTAT,1)=""H"" Q"
^XMB(3.9,146012,2,363,0)="""RTN"",""PSOERPC2"",58,0)"
^XMB(3.9,146012,2,364,0)=" . . I '$$ELIGSTS^PSOERPC1(""PC"",ERXSTAT,MTYPE) Q"
^XMB(3.9,146012,2,365,0)="""RTN"",""PSOERPC2"",59,0)"
^XMB(3.9,146012,2,366,0)=" . . ; - CS/Non-CS Filter"
^XMB(3.9,146012,2,367,0)="""RTN"",""PSOERPC2"",60,0)"
^XMB(3.9,146012,2,368,0)=" . . I $G(PSOCSERX)=""Non-CS"",CSERX Q"
^XMB(3.9,146012,2,369,0)="""RTN"",""PSOERPC2"",61,0)"
^XMB(3.9,146012,2,370,0)=" . . I $G(PSOCSERX)=""CS"",'CSERX Q"
^XMB(3.9,146012,2,371,0)="""RTN"",""PSOERPC2"",62,0)"
^XMB(3.9,146012,2,372,0)=" . . ; - Match Status Filter"
^XMB(3.9,146012,2,373,0)="""RTN"",""PSOERPC2"",63,0)"
^XMB(3.9,146012,2,374,0)=" . . S VPATIEN=+$P($G(^PS(52.49,ERXIEN,0)),""^"",5)  ; Vista Patient"
^XMB(3.9,146012,2,375,0)="""RTN"",""PSOERPC2"",64,0)"
^XMB(3.9,146012,2,376,0)=" . . S VPRVIEN=+$P($G(^PS(52.49,ERXIEN,2)),""^"",3)  ; Vista Provider"
^XMB(3.9,146012,2,377,0)="""RTN"",""PSOERPC2"",65,0)"
^XMB(3.9,146012,2,378,0)=" . . S VDRGIEN=+$P($G(^PS(52.49,ERXIEN,3)),""^"",2)  ; Vista Drug"
^XMB(3.9,146012,2,379,0)="""RTN"",""PSOERPC2"",66,0)"
^XMB(3.9,146012,2,380,0)=" . . S FOUNDONE=1"
^XMB(3.9,146012,2,381,0)="""RTN"",""PSOERPC2"",67,0)"
^XMB(3.9,146012,2,382,0)=" . . I FILTER=1,'VPATIEN S MATCHFLT=1 Q"
^XMB(3.9,146012,2,383,0)="""RTN"",""PSOERPC2"",68,0)"
^XMB(3.9,146012,2,384,0)=" . . I FILTER=2,'VPRVIEN,'$$MATCHFLT(1,ERXPAT) S MATCHFLT=1 Q"
^XMB(3.9,146012,2,385,0)="""RTN"",""PSOERPC2"",69,0)"
^XMB(3.9,146012,2,386,0)=" . . I FILTER=3,'VDRGIEN,'$$MATCHFLT(1,ERXPAT),'$$MATCHFLT(2,ERXPAT) S MATCHFLT=1 Q"
^XMB(3.9,146012,2,387,0)="""RTN"",""PSOERPC2"",70,0)"
^XMB(3.9,146012,2,388,0)=" . . I FILTER=4,'VDRGIEN!'VPATIEN!'VPRVIEN S MATCHFLT=0 Q"
^XMB(3.9,146012,2,389,0)="""RTN"",""PSOERPC2"",71,0)"
^XMB(3.9,146012,2,390,0)=" I '$G(FOUNDONE) S MATCHFLT=0"
^XMB(3.9,146012,2,391,0)="""RTN"",""PSOERPC2"",72,0)"
^XMB(3.9,146012,2,392,0)=" ;"
^XMB(3.9,146012,2,393,0)="""RTN"",""PSOERPC2"",73,0)"
^XMB(3.9,146012,2,394,0)=" Q MATCHFLT"
^XMB(3.9,146012,2,395,0)="""RTN"",""PSOERPC2"",74,0)"
^XMB(3.9,146012,2,396,0)=" ;"
^XMB(3.9,146012,2,397,0)="""RTN"",""PSOERPC2"",75,0)"
^XMB(3.9,146012,2,398,0)="SETLINE ; - Setting Listman line"
^XMB(3.9,146012,2,399,0)="""RTN"",""PSOERPC2"",76,0)"
^XMB(3.9,146012,2,400,0)=" N ERXPAT,PATIEN,X1,POS,SORTORD,GROUP,CSERX"
^XMB(3.9,146012,2,401,0)="""RTN"",""PSOERPC2"",77,0)"
^XMB(3.9,146012,2,402,0)=" K ^TMP(""PSOERPC0"",$J)"
^XMB(3.9,146012,2,403,0)="""RTN"",""PSOERPC2"",78,0)"
^XMB(3.9,146012,2,404,0)=" I '$D(^TMP(""PSOERPCS"",$J)) D  Q"
^XMB(3.9,146012,2,405,0)="""RTN"",""PSOERPC2"",79,0)"
^XMB(3.9,146012,2,406,0)=" . F I=1:1:6 S ^TMP(""PSOERPC0"",$J,I,0)="""""
^XMB(3.9,146012,2,407,0)="""RTN"",""PSOERPC2"",80,0)"
^XMB(3.9,146012,2,408,0)=" . S ^TMP(""PSOERPC0"",$J,7,0)=""               No patients with actionable prescriptions found."""
^XMB(3.9,146012,2,409,0)="""RTN"",""PSOERPC2"",81,0)"
^XMB(3.9,146012,2,410,0)=" . S VALMCNT=1"
^XMB(3.9,146012,2,411,0)="""RTN"",""PSOERPC2"",82,0)"
^XMB(3.9,146012,2,412,0)=" ;"
^XMB(3.9,146012,2,413,0)="""RTN"",""PSOERPC2"",83,0)"
^XMB(3.9,146012,2,414,0)=" ; - Resetting list to NORMAL video attributes"
^XMB(3.9,146012,2,415,0)="""RTN"",""PSOERPC2"",84,0)"
^XMB(3.9,146012,2,416,0)=" D RESET^PSOERUT0()"
^XMB(3.9,146012,2,417,0)="""RTN"",""PSOERPC2"",85,0)"
^XMB(3.9,146012,2,418,0)=" K GRPLN,PTMTCHLN,PRMTCHLN,DRMTCHLN"
^XMB(3.9,146012,2,419,0)="""RTN"",""PSOERPC2"",86,0)"
^XMB(3.9,146012,2,420,0)=" ;"
^XMB(3.9,146012,2,421,0)="""RTN"",""PSOERPC2"",87,0)"
^XMB(3.9,146012,2,422,0)=" ; - Building the list (line by line)"
^XMB(3.9,146012,2,423,0)="""RTN"",""PSOERPC2"",88,0)"
^XMB(3.9,146012,2,424,0)=" S (GROUP,SEQ)="""",LINE=0,SORTORD=$S(PSORDER=""A"":1,1:-1)"
^XMB(3.9,146012,2,425,0)="""RTN"",""PSOERPC2"",89,0)"
^XMB(3.9,146012,2,426,0)=" F  S GROUP=$O(^TMP(""PSOERPCS"",$J,GROUP)) Q:GROUP=""""  D"
^XMB(3.9,146012,2,427,0)="""RTN"",""PSOERPC2"",90,0)"
^XMB(3.9,146012,2,428,0)=" . I GROUP'=""ALL"" D"
^XMB(3.9,146012,2,429,0)="""RTN"",""PSOERPC2"",91,0)"
^XMB(3.9,146012,2,430,0)=" . . N LBL,POS,X"
^XMB(3.9,146012,2,431,0)="""RTN"",""PSOERPC2"",92,0)"
^XMB(3.9,146012,2,432,0)=" . . S LBL=$S(GROUP=""NON-CS"":""NON-"",1:"""")_""CONTROLLED SUBSTANCE Rx's"""
^XMB(3.9,146012,2,433,0)="""RTN"",""PSOERPC2"",93,0)"
^XMB(3.9,146012,2,434,0)=" . . S POS=41-($L(LBL)\2) S X="""",$P(X,"" "",81)="""",$E(X,POS,POS-1+$L(LBL))=LBL"
^XMB(3.9,146012,2,435,0)="""RTN"",""PSOERPC2"",94,0)"
^XMB(3.9,146012,2,436,0)=" . . S LINE=LINE+1,^TMP(""PSOERPC0"",$J,LINE,0)=X,GRPLN(LINE)=LBL"
^XMB(3.9,146012,2,437,0)="""RTN"",""PSOERPC2"",95,0)"
^XMB(3.9,146012,2,438,0)=" . S ERXPAT="""" F  S ERXPAT=$O(^TMP(""PSOERPCS"",$J,GROUP,ERXPAT),SORTORD) Q:ERXPAT=""""  D"
^XMB(3.9,146012,2,439,0)="""RTN"",""PSOERPC2"",96,0)"
^XMB(3.9,146012,2,440,0)=" . . S PATIEN=$G(^TMP(""PSOERPCS"",$J,GROUP,ERXPAT,""PATIEN""))"
^XMB(3.9,146012,2,441,0)="""RTN"",""PSOERPC2"",97,0)"
^XMB(3.9,146012,2,442,0)=" . . S Z=$G(^TMP(""PSOERPCS"",$J,GROUP,ERXPAT)),SEQ=SEQ+1"
^XMB(3.9,146012,2,443,0)="""RTN"",""PSOERPC2"",98,0)"
^XMB(3.9,146012,2,444,0)=" . . S X1=SEQ_$S($P(Z,""^"",11):""]"",1:""."")"
^XMB(3.9,146012,2,445,0)="""RTN"",""PSOERPC2"",99,0)"
^XMB(3.9,146012,2,446,0)=" . . S $E(X1,$S(SEQ>999:6,1:5))=$E($P(Z,""^"",1),1,$S(SEQ>999:23,1:24)),$E(X1,30)=$P(Z,""^"",2),$E(X1,41)=$$SSN^PSOERUT($P(Z,""^"",3))"
^XMB(3.9,146012,2,447,0)="""RTN"",""PSOERPC2"",100,0)"
^XMB(3.9,146012,2,448,0)=" . . S $E(X1,54)=$J(+$P(Z,""^"",4),3),$E(X1,58)=$J(+$P(Z,""^"",5),2),$E(X1,61)=$J(+$P(Z,""^"",6),2)"
^XMB(3.9,146012,2,449,0)="""RTN"",""PSOERPC2"",101,0)"
^XMB(3.9,146012,2,450,0)=" . . S $E(X1,64)=$J(+$P(Z,""^"",7),2),$E(X1,67)=$J(+$P(Z,""^"",8),2),$E(X1,70)=$J(+$P(Z,""^"",9),3)"
^XMB(3.9,146012,2,451,0)="""RTN"",""PSOERPC2"",102,0)"
^XMB(3.9,146012,2,452,0)=" . . S $E(X1,74)=$J(+$P(Z,""^"",10),3)"
^XMB(3.9,146012,2,453,0)="""RTN"",""PSOERPC2"",103,0)"
^XMB(3.9,146012,2,454,0)=" . . S $E(X1,78)=$J($P(Z,""^"",5)+$P(Z,""^"",6)+$P(Z,""^"",7)+$P(Z,""^"",8)+$P(Z,""^"",9)+$P(Z,""^"",10),3)"
^XMB(3.9,146012,2,455,0)="""RTN"",""PSOERPC2"",104,0)"
^XMB(3.9,146012,2,456,0)=" . . S LINE=LINE+1,^TMP(""PSOERPC0"",$J,LINE,0)=X1,^TMP(""PSOERPC0"",$J,SEQ,""PATIEN"")=PATIEN"
^XMB(3.9,146012,2,457,0)="""RTN"",""PSOERPC2"",105,0)"
^XMB(3.9,146012,2,458,0)=" . . I $D(LOCKPATS(PATIEN)) S HIGHLN(LINE)=1"
^XMB(3.9,146012,2,459,0)="""RTN"",""PSOERPC2"",106,0)"
^XMB(3.9,146012,2,460,0)=" ;"
^XMB(3.9,146012,2,461,0)="""RTN"",""PSOERPC2"",107,0)"
^XMB(3.9,146012,2,462,0)=" ; - Saving NORMAL video attributes to be reset later"
^XMB(3.9,146012,2,463,0)="""RTN"",""PSOERPC2"",108,0)"
^XMB(3.9,146012,2,464,0)=" I LINE>$G(LASTLINE) D"
^XMB(3.9,146012,2,465,0)="""RTN"",""PSOERPC2"",109,0)"
^XMB(3.9,146012,2,466,0)=" . F I=($G(LASTLINE)+1):1:LINE D SAVE^VALM10(I)"
^XMB(3.9,146012,2,467,0)="""RTN"",""PSOERPC2"",110,0)"
^XMB(3.9,146012,2,468,0)=" . S LASTLINE=LINE"
^XMB(3.9,146012,2,469,0)="""RTN"",""PSOERPC2"",111,0)"
^XMB(3.9,146012,2,470,0)=" D VIDEO^PSOERPT1()"
^XMB(3.9,146012,2,471,0)="""RTN"",""PSOERPC2"",112,0)"
^XMB(3.9,146012,2,472,0)=" S VALMCNT=+$G(LINE)"
^XMB(3.9,146012,2,473,0)="""RTN"",""PSOERPC2"",113,0)"
^XMB(3.9,146012,2,474,0)=" Q"
^XMB(3.9,146012,2,475,0)="""RTN"",""PSOERRX0"")"
^XMB(3.9,146012,2,476,0)="0^2^B167933274"
^XMB(3.9,146012,2,477,0)="""RTN"",""PSOERRX0"",1,0)"
