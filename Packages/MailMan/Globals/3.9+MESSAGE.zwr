^XMB(3.9,146090,2,626,0)=" . I (+MBMST=2),(STATELST'[(""^""_+VAPA(5)_""^"")) S STATELST=STATELST_+VAPA(5)_""^"""
^XMB(3.9,146090,2,627,0)="""RTN"",""PSOSPML4"",194,0)"
^XMB(3.9,146090,2,628,0)=" F LST=1:1:$L(STATELST,""^"") D"
