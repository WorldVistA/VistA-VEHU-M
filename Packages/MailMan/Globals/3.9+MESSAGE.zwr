^XMB(3.9,146089,2,1515,0)="""RTN"",""PSOORFI6"",247,0)"
^XMB(3.9,146089,2,1516,0)=" S DIEN=$$GET1^DIQ(52.41,IEN,11,""I"")"
^XMB(3.9,146089,2,1517,0)="""RTN"",""PSOORFI6"",248,0)"
^XMB(3.9,146089,2,1518,0)=" I DIEN S DEAHLDG=$$GET1^DIQ(50,DIEN,3,""E"")"
^XMB(3.9,146089,2,1519,0)="""RTN"",""PSOORFI6"",249,0)"
