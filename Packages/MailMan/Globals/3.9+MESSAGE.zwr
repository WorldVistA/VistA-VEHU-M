^XMB(3.9,146011,2,647,0)="""RTN"",""PSOHLD"",99,0)"
^XMB(3.9,146011,2,648,0)=" . D ECMESND^PSOBPSU1(RX,RFL,,$S(RFL:""RF"",1:""OF""))"
^XMB(3.9,146011,2,649,0)="""RTN"",""PSOHLD"",100,0)"
^XMB(3.9,146011,2,650,0)=" . ; Quit if there is an unresolved TRICARE/CHAMPVA non-billable reject code, PSO*7*358"
