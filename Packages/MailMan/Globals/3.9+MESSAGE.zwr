^XMB(3.9,146041,2,1491,0)="""RTN"",""SDES2CRTCLNAVAL2"",1,0)"
^XMB(3.9,146041,2,1492,0)="SDES2CRTCLNAVAL2 ;ALB/BLB,JDJ/BLB,JDJ,AGW,JDJ,AGW,AGW,AGW,AGW - SDES2 CREATE CLINIC AVAIL 2 ; JULY 15, 2026"
^XMB(3.9,146041,2,1493,0)="""RTN"",""SDES2CRTCLNAVAL2"",2,0)"
^XMB(3.9,146041,2,1494,0)=" ;;5.3;Scheduling;**904,914,919,920,922,909,941,944,945,947,959**;Aug 13, 1993;Build 0"
^XMB(3.9,146041,2,1495,0)="""RTN"",""SDES2CRTCLNAVAL2"",3,0)"
^XMB(3.9,146041,2,1496,0)=" ;;Per VHA Directive 6402, this routine should not be modified"
