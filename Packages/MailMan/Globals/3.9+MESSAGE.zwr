^XMB(3.9,146035,2,321,0)="""RTN"",""PSOBBC"",41,0)"
^XMB(3.9,146035,2,322,0)=" W !,""Please answer the following for this session of prescriptions:"",!"
^XMB(3.9,146035,2,323,0)="""RTN"",""PSOBBC"",42,0)"
^XMB(3.9,146035,2,324,0)=" D EN^PSOREF2(.PSOBBC) I PSOBBC(""DFLG"") S PSOBBC(""QFLG"")=1 G ASKX"
^XMB(3.9,146035,2,325,0)="""RTN"",""PSOBBC"",43,0)"
^XMB(3.9,146035,2,326,0)=" D SUSP G:PSOBBC(""QFLG"") ASKX"
