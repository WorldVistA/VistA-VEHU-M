^XMB(3.9,146047,2,1019,0)="""RTN"",""IBCNBCD2"",321,0)"
^XMB(3.9,146047,2,1020,0)="CVOUT(IBDATA) ; -- unlock coverage limitations records"
^XMB(3.9,146047,2,1021,0)="""RTN"",""IBCNBCD2"",322,0)"
^XMB(3.9,146047,2,1022,0)=" N IBI,IBIEN"
