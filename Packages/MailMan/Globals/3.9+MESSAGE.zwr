^XMB(3.9,146052,2,794,0)="FEE S DIR(0)=""161.4,9"",DIR(""B"")=FBMDF,DIR(""?"")=""Hit Return to accept default dispensing fee or enter a dollar amount between .01 and 20"" D ^DIR K DIR Q:$D(DIRUT)"
^XMB(3.9,146052,2,795,0)="""RTN"",""FBAACIE"",42,0)"
