^XMB(3.9,146009,2,729,0)="""RTN"",""XUMVINPB"",26,0)"
^XMB(3.9,146009,2,730,0)=" ;  Success:"
^XMB(3.9,146009,2,731,0)="""RTN"",""XUMVINPB"",27,0)"
^XMB(3.9,146009,2,732,0)=" ;   XURET = ^TMP(""XUMVINPB"",$J)"
^XMB(3.9,146009,2,733,0)="""RTN"",""XUMVINPB"",28,0)"
