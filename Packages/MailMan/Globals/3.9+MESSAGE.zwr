^XMB(3.9,146103,2,207,0)="""QUES"",""XPO1"",0)"
^XMB(3.9,146103,2,208,0)="Y"
^XMB(3.9,146103,2,209,0)="""QUES"",""XPO1"",""??"")"
^XMB(3.9,146103,2,210,0)="^D MENU^XPDH"
^XMB(3.9,146103,2,211,0)="""QUES"",""XPO1"",""A"")"
^XMB(3.9,146103,2,212,0)="Want KIDS to Rebuild Menu Trees Upon Completion of Install"
^XMB(3.9,146103,2,213,0)="""QUES"",""XPO1"",""B"")"
