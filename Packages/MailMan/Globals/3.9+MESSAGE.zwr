^XMB(3.9,146087,2,2062,0)=" S BODY=0"
^XMB(3.9,146087,2,2063,0)="""RTN"",""YTQREST0"",62,0)"
^XMB(3.9,146087,2,2064,0)=" S SWAP("""""":,"")="""""":null,"""
^XMB(3.9,146087,2,2065,0)="""RTN"",""YTQREST0"",63,0)"
^XMB(3.9,146087,2,2066,0)=" S SWAP("""""":}"")="""""":null}"""
^XMB(3.9,146087,2,2067,0)="""RTN"",""YTQREST0"",64,0)"
^XMB(3.9,146087,2,2068,0)=" S I=0 F  S I=$O(HTTPREQ(I)) Q:'I  D"
^XMB(3.9,146087,2,2069,0)="""RTN"",""YTQREST0"",65,0)"
^XMB(3.9,146087,2,2070,0)=" . I BODY S HTTPREQ(I)=$$REPLACE^XLFSTR(HTTPREQ(I),.SWAP)"
^XMB(3.9,146087,2,2071,0)="""RTN"",""YTQREST0"",66,0)"
^XMB(3.9,146087,2,2072,0)=" . I '$L(HTTPREQ(I)) S BODY=1"
^XMB(3.9,146087,2,2073,0)="""RTN"",""YTQREST0"",67,0)"
^XMB(3.9,146087,2,2074,0)=" Q"
^XMB(3.9,146087,2,2075,0)="""RTN"",""YTQRQAD1"")"
^XMB(3.9,146087,2,2076,0)="0^7^B131799098"
^XMB(3.9,146087,2,2077,0)="""RTN"",""YTQRQAD1"",1,0)"
^XMB(3.9,146087,2,2078,0)="YTQRQAD1 ;SLC/KCM - RESTful Calls to handle MHA assignments ; 1/25/2017"
^XMB(3.9,146087,2,2079,0)="""RTN"",""YTQRQAD1"",2,0)"
^XMB(3.9,146087,2,2080,0)=" ;;5.01;MENTAL HEALTH;**130,141,178,182,181,187,199,207,204,223,240**;Dec 30, 1994;Build 0"
^XMB(3.9,146087,2,2081,0)="""RTN"",""YTQRQAD1"",3,0)"
^XMB(3.9,146087,2,2082,0)=" ;"
^XMB(3.9,146087,2,2083,0)="""RTN"",""YTQRQAD1"",4,0)"
^XMB(3.9,146087,2,2084,0)=" ; Reference to VADPT in ICR #10061"
^XMB(3.9,146087,2,2085,0)="""RTN"",""YTQRQAD1"",5,0)"
^XMB(3.9,146087,2,2086,0)=" ; Reference to XLFDT in ICR #10103"
^XMB(3.9,146087,2,2087,0)="""RTN"",""YTQRQAD1"",6,0)"
^XMB(3.9,146087,2,2088,0)=" ; Reference to XLFSTR in ICR #10104"
^XMB(3.9,146087,2,2089,0)="""RTN"",""YTQRQAD1"",7,0)"
^XMB(3.9,146087,2,2090,0)=" ; Reference to XPDMENU in ICR #1157"
^XMB(3.9,146087,2,2091,0)="""RTN"",""YTQRQAD1"",8,0)"
^XMB(3.9,146087,2,2092,0)=" ; Reference to XQCHK in ICR #10078"
^XMB(3.9,146087,2,2093,0)="""RTN"",""YTQRQAD1"",9,0)"
^XMB(3.9,146087,2,2094,0)=" ;"
^XMB(3.9,146087,2,2095,0)="""RTN"",""YTQRQAD1"",10,0)"
^XMB(3.9,146087,2,2096,0)="ASMTBYID(ARGS,RESULTS) ; get assignment identified by assignmentId"
^XMB(3.9,146087,2,2097,0)="""RTN"",""YTQRQAD1"",11,0)"
^XMB(3.9,146087,2,2098,0)=" I $G(ARGS(""assignmentId""))?36ANP G GETASMT^YTQRCRW ; CPRS DLL"
^XMB(3.9,146087,2,2099,0)="""RTN"",""YTQRQAD1"",12,0)"
^XMB(3.9,146087,2,2100,0)=" ;"
^XMB(3.9,146087,2,2101,0)="""RTN"",""YTQRQAD1"",13,0)"
^XMB(3.9,146087,2,2102,0)=" N ASMT,ADMIN,TEST,I"
^XMB(3.9,146087,2,2103,0)="""RTN"",""YTQRQAD1"",14,0)"
^XMB(3.9,146087,2,2104,0)=" S ASMT=""YTQASMT-SET-""_$G(ARGS(""assignmentId""))"
^XMB(3.9,146087,2,2105,0)="""RTN"",""YTQRQAD1"",15,0)"
^XMB(3.9,146087,2,2106,0)=" I '$D(^XTMP(ASMT)) D SETERROR^YTQRUTL(404,""Not Found: ""_ARGS(""assignmentId"")) QUIT"
^XMB(3.9,146087,2,2107,0)="""RTN"",""YTQRQAD1"",16,0)"
^XMB(3.9,146087,2,2108,0)=" S I=0 F  S I=$O(^XTMP(ASMT,1,""instruments"",I)) Q:'I  D  ; calc progress"
^XMB(3.9,146087,2,2109,0)="""RTN"",""YTQRQAD1"",17,0)"
^XMB(3.9,146087,2,2110,0)=" . S ADMIN=+$G(^XTMP(ASMT,1,""instruments"",I,""adminId""))"
^XMB(3.9,146087,2,2111,0)="""RTN"",""YTQRQAD1"",18,0)"
^XMB(3.9,146087,2,2112,0)=" . S TEST=+$G(^XTMP(ASMT,1,""instruments"",I,""id""))"
^XMB(3.9,146087,2,2113,0)="""RTN"",""YTQRQAD1"",19,0)"
^XMB(3.9,146087,2,2114,0)=" . I $$ADMEXPD(ADMIN,TEST) D  ; start over if this admin has expired"
^XMB(3.9,146087,2,2115,0)="""RTN"",""YTQRQAD1"",20,0)"
^XMB(3.9,146087,2,2116,0)=" . . S ^XTMP(ASMT,1,""instruments"",I,""adminId"")=""null"""
^XMB(3.9,146087,2,2117,0)="""RTN"",""YTQRQAD1"",21,0)"
^XMB(3.9,146087,2,2118,0)=" . . I ^XTMP(ASMT,1,""patient"",""dfn"")=$P(^YTT(601.84,ADMIN,0),U,2) D"
^XMB(3.9,146087,2,2119,0)="""RTN"",""YTQRQAD1"",22,0)"
^XMB(3.9,146087,2,2120,0)=" . . . D DELADMIN(ADMIN) ; double check DFN match just to make sure"
^XMB(3.9,146087,2,2121,0)="""RTN"",""YTQRQAD1"",23,0)"
^XMB(3.9,146087,2,2122,0)=" . . S ADMIN=0"
^XMB(3.9,146087,2,2123,0)="""RTN"",""YTQRQAD1"",24,0)"
^XMB(3.9,146087,2,2124,0)=" . S ^XTMP(ASMT,1,""instruments"",I,""progress"")=$$PROGRESS(ADMIN,TEST,$G(ARGS(""assignmentId"")))"
^XMB(3.9,146087,2,2125,0)="""RTN"",""YTQRQAD1"",25,0)"
^XMB(3.9,146087,2,2126,0)=" M RESULTS=^XTMP(ASMT,1)                                 ; load assignment"
^XMB(3.9,146087,2,2127,0)="""RTN"",""YTQRQAD1"",26,0)"
^XMB(3.9,146087,2,2128,0)=" Q"
^XMB(3.9,146087,2,2129,0)="""RTN"",""YTQRQAD1"",27,0)"
^XMB(3.9,146087,2,2130,0)="ASMTBYNM(ARGS,RESULTS) ; get assignment identified by lastName and last4"
^XMB(3.9,146087,2,2131,0)="""RTN"",""YTQRQAD1"",28,0)"
^XMB(3.9,146087,2,2132,0)=" N ASMT,PID,PTNAME,LAST"
^XMB(3.9,146087,2,2133,0)="""RTN"",""YTQRQAD1"",29,0)"
^XMB(3.9,146087,2,2134,0)=" S PID=ARGS(""last4"")"
^XMB(3.9,146087,2,2135,0)="""RTN"",""YTQRQAD1"",30,0)"
^XMB(3.9,146087,2,2136,0)=" S PTNAME=$$UP^XLFSTR(ARGS(""lastName""))"
^XMB(3.9,146087,2,2137,0)="""RTN"",""YTQRQAD1"",31,0)"
^XMB(3.9,146087,2,2138,0)=" I 'PID!'$L(PTNAME) D SETERROR^YTQRUTL(400,""Missing Identifiers"") QUIT"
^XMB(3.9,146087,2,2139,0)="""RTN"",""YTQRQAD1"",32,0)"
^XMB(3.9,146087,2,2140,0)=" S LAST=$O(^XTMP(""YTQASMT-INDEX"",""AC"",PID,PTNAME,0))"
^XMB(3.9,146087,2,2141,0)="""RTN"",""YTQRQAD1"",33,0)"
^XMB(3.9,146087,2,2142,0)=" S ASMT=$G(^XTMP(""YTQASMT-INDEX"",""AC"",PID,PTNAME,LAST))"
^XMB(3.9,146087,2,2143,0)="""RTN"",""YTQRQAD1"",34,0)"
^XMB(3.9,146087,2,2144,0)=" I 'ASMT D SETERROR^YTQRUTL(404,""Not Found: Assignment for Patient"") QUIT"
^XMB(3.9,146087,2,2145,0)="""RTN"",""YTQRQAD1"",35,0)"
^XMB(3.9,146087,2,2146,0)=" S ARGS(""assignmentId"")=ASMT"
^XMB(3.9,146087,2,2147,0)="""RTN"",""YTQRQAD1"",36,0)"
^XMB(3.9,146087,2,2148,0)=" D ASMTBYID(.ARGS,.RESULTS)"
^XMB(3.9,146087,2,2149,0)="""RTN"",""YTQRQAD1"",37,0)"
^XMB(3.9,146087,2,2150,0)=" Q"
^XMB(3.9,146087,2,2151,0)="""RTN"",""YTQRQAD1"",38,0)"
^XMB(3.9,146087,2,2152,0)="PROGRESS(ADMIN,TEST,ASMTID) ; return the progress for an administration"
^XMB(3.9,146087,2,2153,0)="""RTN"",""YTQRQAD1"",39,0)"
^XMB(3.9,146087,2,2154,0)=" ; progress in 100% if administration is complete"
^XMB(3.9,146087,2,2155,0)="""RTN"",""YTQRQAD1"",40,0)"
^XMB(3.9,146087,2,2156,0)=" I ADMIN,$P($G(^YTT(601.84,ADMIN,0)),U,9)=""Y"" Q 100"
^XMB(3.9,146087,2,2157,0)="""RTN"",""YTQRQAD1"",41,0)"
^XMB(3.9,146087,2,2158,0)=" ; check to see if this is a CAT that has been started"
^XMB(3.9,146087,2,2159,0)="""RTN"",""YTQRQAD1"",42,0)"
^XMB(3.9,146087,2,2160,0)=" N CATPROG S CATPROG=-1"
^XMB(3.9,146087,2,2161,0)="""RTN"",""YTQRQAD1"",43,0)"
^XMB(3.9,146087,2,2162,0)=" I $G(ASMTID,0) D  I CATPROG>-1 Q CATPROG"
^XMB(3.9,146087,2,2163,0)="""RTN"",""YTQRQAD1"",44,0)"
^XMB(3.9,146087,2,2164,0)=" . I $G(^XTMP(""YTQASMT-SET-""_ASMTID,1,""catInfo"",""credentials"",""interviewID"")) S CATPROG=10"
^XMB(3.9,146087,2,2165,0)="""RTN"",""YTQRQAD1"",45,0)"
^XMB(3.9,146087,2,2166,0)=" ;"
^XMB(3.9,146087,2,2167,0)="""RTN"",""YTQRQAD1"",46,0)"
^XMB(3.9,146087,2,2168,0)=" Q:'ADMIN 0"
^XMB(3.9,146087,2,2169,0)="""RTN"",""YTQRQAD1"",47,0)"
^XMB(3.9,146087,2,2170,0)=" N I,QANS,QTOT"
^XMB(3.9,146087,2,2171,0)="""RTN"",""YTQRQAD1"",48,0)"
^XMB(3.9,146087,2,2172,0)=" S QANS=$P(^YTT(601.84,ADMIN,0),U,10)"
^XMB(3.9,146087,2,2173,0)="""RTN"",""YTQRQAD1"",49,0)"
^XMB(3.9,146087,2,2174,0)=" S (I,QTOT)=0 F  S I=$O(^YTT(601.76,""AC"",TEST,I)) Q:'I  S QTOT=QTOT+1"
^XMB(3.9,146087,2,2175,0)="""RTN"",""YTQRQAD1"",50,0)"
^XMB(3.9,146087,2,2176,0)=" Q $S(QTOT>0:$P(((QANS/QTOT)*100)+.5,"".""),1:0)"
^XMB(3.9,146087,2,2177,0)="""RTN"",""YTQRQAD1"",51,0)"
^XMB(3.9,146087,2,2178,0)=" ;"
^XMB(3.9,146087,2,2179,0)="""RTN"",""YTQRQAD1"",52,0)"
^XMB(3.9,146087,2,2180,0)="NEWASMT(ARGS,DATA) ; save assignment, return /api/mha/assignment/{assignmentId}"
^XMB(3.9,146087,2,2181,0)="""RTN"",""YTQRQAD1"",53,0)"
^XMB(3.9,146087,2,2182,0)=" N I,DFN,ORDBY,VA,VADM,VAERR,SETID,FOUND,PID,PTNAME,EXPIRE,CONS,COSIGN"
^XMB(3.9,146087,2,2183,0)="""RTN"",""YTQRQAD1"",54,0)"
^XMB(3.9,146087,2,2184,0)=" N RETSTAT,REPLACE"
^XMB(3.9,146087,2,2185,0)="""RTN"",""YTQRQAD1"",55,0)"
^XMB(3.9,146087,2,2186,0)=" S DFN=+$G(DATA(""patient"",""dfn""))"
^XMB(3.9,146087,2,2187,0)="""RTN"",""YTQRQAD1"",56,0)"
^XMB(3.9,146087,2,2188,0)=" S ORDBY=+$G(DATA(""orderedBy""))"
^XMB(3.9,146087,2,2189,0)="""RTN"",""YTQRQAD1"",57,0)"
^XMB(3.9,146087,2,2190,0)=" S CONS=+$G(DATA(""consult""))"
^XMB(3.9,146087,2,2191,0)="""RTN"",""YTQRQAD1"",58,0)"
^XMB(3.9,146087,2,2192,0)=" S COSIGN=+$G(DATA(""cosigner""))"
^XMB(3.9,146087,2,2193,0)="""RTN"",""YTQRQAD1"",59,0)"
^XMB(3.9,146087,2,2194,0)=" I 'DFN!'ORDBY D SETERROR^YTQRUTL(400,""Missing Reqd Fields"") QUIT """""
^XMB(3.9,146087,2,2195,0)="""RTN"",""YTQRQAD1"",60,0)"
^XMB(3.9,146087,2,2196,0)=" D DEM^VADPT I $G(VAERR) D SETERROR^YTQRUTL(400,""Missing Pt Info"") QUIT """""
^XMB(3.9,146087,2,2197,0)="""RTN"",""YTQRQAD1"",61,0)"
^XMB(3.9,146087,2,2198,0)=" S PID=VA(""BID""),PTNAME=VADM(1)"
^XMB(3.9,146087,2,2199,0)="""RTN"",""YTQRQAD1"",62,0)"
^XMB(3.9,146087,2,2200,0)=" ; set these ""patient"" nodes up in case called with just DFN"
^XMB(3.9,146087,2,2201,0)="""RTN"",""YTQRQAD1"",63,0)"
^XMB(3.9,146087,2,2202,0)=" S DATA(""patient"",""name"")=PTNAME"
^XMB(3.9,146087,2,2203,0)="""RTN"",""YTQRQAD1"",64,0)"
^XMB(3.9,146087,2,2204,0)=" S DATA(""patient"",""pid"")=""xxx-xx-""_PID"
^XMB(3.9,146087,2,2205,0)="""RTN"",""YTQRQAD1"",65,0)"
^XMB(3.9,146087,2,2206,0)=" S DATA(""patient"",""ssn"")=DATA(""patient"",""pid"")"
^XMB(3.9,146087,2,2207,0)="""RTN"",""YTQRQAD1"",66,0)"
^XMB(3.9,146087,2,2208,0)=" ; get instrument Admin Date"
^XMB(3.9,146087,2,2209,0)="""RTN"",""YTQRQAD1"",67,0)"
^XMB(3.9,146087,2,2210,0)=" S DATA(""adminDate"")=$G(DATA(""adminDate""))  ;Ensure adminDate is set"
^XMB(3.9,146087,2,2211,0)="""RTN"",""YTQRQAD1"",68,0)"
^XMB(3.9,146087,2,2212,0)=" I $G(DATA(""consult""))=""""!($G(DATA(""consult""))=""null"") K DATA(""consult"")"
^XMB(3.9,146087,2,2213,0)="""RTN"",""YTQRQAD1"",69,0)"
^XMB(3.9,146087,2,2214,0)=" S DATA(""appSrc"")=$G(DATA(""appSrc""))"
^XMB(3.9,146087,2,2215,0)="""RTN"",""YTQRQAD1"",70,0)"
^XMB(3.9,146087,2,2216,0)=" S FOUND="""""
^XMB(3.9,146087,2,2217,0)="""RTN"",""YTQRQAD1"",71,0)"
^XMB(3.9,146087,2,2218,0)=" S I=0 F  S I=$O(DATA(""instruments"",I)) Q:I=""""!FOUND  D"
^XMB(3.9,146087,2,2219,0)="""RTN"",""YTQRQAD1"",72,0)"
^XMB(3.9,146087,2,2220,0)=" . I $G(DATA(""instruments"",I,""replace""))]"""" D"
^XMB(3.9,146087,2,2221,0)="""RTN"",""YTQRQAD1"",73,0)"
^XMB(3.9,146087,2,2222,0)=" .. S REPLACE=DATA(""instruments"",I,""replace"") M DATA(2)=^XTMP(""YTQASMT-SET-""_REPLACE,2) S FOUND=1"
^XMB(3.9,146087,2,2223,0)="""RTN"",""YTQRQAD1"",74,0)"
^XMB(3.9,146087,2,2224,0)=" ; look up IEN for each instrument in the assignment"
^XMB(3.9,146087,2,2225,0)="""RTN"",""YTQRQAD1"",75,0)"
^XMB(3.9,146087,2,2226,0)=" S RETSTAT=$$FILASGN(.ARGS,.DATA,"""",""NEW"")"
^XMB(3.9,146087,2,2227,0)="""RTN"",""YTQRQAD1"",76,0)"
^XMB(3.9,146087,2,2228,0)=" Q RETSTAT"
^XMB(3.9,146087,2,2229,0)="""RTN"",""YTQRQAD1"",77,0)"
^XMB(3.9,146087,2,2230,0)="FILASGN(ARGS,DATA,SETID,TYPE) ;File the Assignment Data"
^XMB(3.9,146087,2,2231,0)="""RTN"",""YTQRQAD1"",78,0)"
^XMB(3.9,146087,2,2232,0)=" ; ARGS = incoming arguments"
^XMB(3.9,146087,2,2233,0)="""RTN"",""YTQRQAD1"",79,0)"
^XMB(3.9,146087,2,2234,0)=" ; DATA = incoming data"
^XMB(3.9,146087,2,2235,0)="""RTN"",""YTQRQAD1"",80,0)"
^XMB(3.9,146087,2,2236,0)=" ; SETID = Assignment number if existing assignment(EDIT)"
^XMB(3.9,146087,2,2237,0)="""RTN"",""YTQRQAD1"",81,0)"
^XMB(3.9,146087,2,2238,0)=" ; TYPE = NEW or EDIT"
^XMB(3.9,146087,2,2239,0)="""RTN"",""YTQRQAD1"",82,0)"
^XMB(3.9,146087,2,2240,0)=" N I,PREFIX,FOUND,EXPIRE,OLDSET,YSTAT"
^XMB(3.9,146087,2,2241,0)="""RTN"",""YTQRQAD1"",83,0)"
^XMB(3.9,146087,2,2242,0)=" I $G(TYPE)="""" S TYPE=""NEW""  ;default"
^XMB(3.9,146087,2,2243,0)="""RTN"",""YTQRQAD1"",84,0)"
^XMB(3.9,146087,2,2244,0)=" S SETID=$G(SETID)"
^XMB(3.9,146087,2,2245,0)="""RTN"",""YTQRQAD1"",85,0)"
^XMB(3.9,146087,2,2246,0)=" S I=0 F  S I=$O(DATA(""instruments"",I)) Q:'I  D"
^XMB(3.9,146087,2,2247,0)="""RTN"",""YTQRQAD1"",86,0)"
^XMB(3.9,146087,2,2248,0)=" . N TSTNM,TSTID,TSTFN,TSTRSTRT"
^XMB(3.9,146087,2,2249,0)="""RTN"",""YTQRQAD1"",87,0)"
^XMB(3.9,146087,2,2250,0)=" . S TSTNM=$G(DATA(""instruments"",I,""name"")) Q:'$L(TSTNM)"
^XMB(3.9,146087,2,2251,0)="""RTN"",""YTQRQAD1"",88,0)"
^XMB(3.9,146087,2,2252,0)=" . S TSTID=$O(^YTT(601.71,""B"",TSTNM,0)) Q:'TSTID"
^XMB(3.9,146087,2,2253,0)="""RTN"",""YTQRQAD1"",89,0)"
^XMB(3.9,146087,2,2254,0)=" . S TSTFN=$P(^YTT(601.71,TSTID,0),U,3)"
^XMB(3.9,146087,2,2255,0)="""RTN"",""YTQRQAD1"",90,0)"
^XMB(3.9,146087,2,2256,0)=" . S TSTRSTRT=$P($G(^YTT(601.71,TSTID,8)),U,7) S:TSTRSTRT="""" TSTRSTRT=-1"
^XMB(3.9,146087,2,2257,0)="""RTN"",""YTQRQAD1"",91,0)"
^XMB(3.9,146087,2,2258,0)=" . S DATA(""instruments"",I,""id"")=TSTID"
^XMB(3.9,146087,2,2259,0)="""RTN"",""YTQRQAD1"",92,0)"
^XMB(3.9,146087,2,2260,0)=" . S DATA(""instruments"",I,""printTitle"")=TSTFN"
^XMB(3.9,146087,2,2261,0)="""RTN"",""YTQRQAD1"",93,0)"
^XMB(3.9,146087,2,2262,0)=" . S DATA(""instruments"",I,""restartDays"")=TSTRSTRT"
^XMB(3.9,146087,2,2263,0)="""RTN"",""YTQRQAD1"",94,0)"
^XMB(3.9,146087,2,2264,0)=" . I +$G(DATA(""instruments"",I,""replace"")) D    ; creating from old asmt"
^XMB(3.9,146087,2,2265,0)="""RTN"",""YTQRQAD1"",95,0)"
^XMB(3.9,146087,2,2266,0)=" . . D RMVTEST(DATA(""instruments"",I,""replace""),DATA(""instruments"",I,""name""),,,1)"
^XMB(3.9,146087,2,2267,0)="""RTN"",""YTQRQAD1"",96,0)"
^XMB(3.9,146087,2,2268,0)=" . . I $E(DATA(""instruments"",I,""name""),1,4)=""CAT-"" D"
^XMB(3.9,146087,2,2269,0)="""RTN"",""YTQRQAD1"",97,0)"
^XMB(3.9,146087,2,2270,0)=" . . . S OLDSET=DATA(""instruments"",I,""replace"")"
^XMB(3.9,146087,2,2271,0)="""RTN"",""YTQRQAD1"",98,0)"
^XMB(3.9,146087,2,2272,0)=" . . K DATA(""instruments"",I,""replace"")"
^XMB(3.9,146087,2,2273,0)="""RTN"",""YTQRQAD1"",99,0)"
^XMB(3.9,146087,2,2274,0)=" ; randomly generate an instrument-set id and check for already used"
^XMB(3.9,146087,2,2275,0)="""RTN"",""YTQRQAD1"",100,0)"
^XMB(3.9,146087,2,2276,0)=" S YSTAT="""",PREFIX=""YTQASMT-SET-"""
^XMB(3.9,146087,2,2277,0)="""RTN"",""YTQRQAD1"",101,0)"
^XMB(3.9,146087,2,2278,0)=" I TYPE=""NEW""!(SETID="""") D"
^XMB(3.9,146087,2,2279,0)="""RTN"",""YTQRQAD1"",102,0)"
^XMB(3.9,146087,2,2280,0)=" . S FOUND=0,EXPIRE=$$FMADD^XLFDT(DT,7)"
^XMB(3.9,146087,2,2281,0)="""RTN"",""YTQRQAD1"",103,0)"
^XMB(3.9,146087,2,2282,0)=" . F I=1:1:500 S SETID=$R(100000) D  Q:FOUND     ; give up after 500 tries"
^XMB(3.9,146087,2,2283,0)="""RTN"",""YTQRQAD1"",104,0)"
^XMB(3.9,146087,2,2284,0)=" . . I $D(^XTMP(PREFIX_SETID)) QUIT              ; already occupied"
^XMB(3.9,146087,2,2285,0)="""RTN"",""YTQRQAD1"",105,0)"
^XMB(3.9,146087,2,2286,0)=" . . L +^XTMP(PREFIX_SETID,0):DILOCKTM E  S YSTAT=""500^Cannot get Lock for Assignment"" QUIT   ; didn't get lock in time"
^XMB(3.9,146087,2,2287,0)="""RTN"",""YTQRQAD1"",106,0)"
^XMB(3.9,146087,2,2288,0)=" . . S ^XTMP(PREFIX_SETID,0)=EXPIRE_U_DT_U_""MH Assignment"""
^XMB(3.9,146087,2,2289,0)="""RTN"",""YTQRQAD1"",107,0)"
^XMB(3.9,146087,2,2290,0)=" . . S ^XTMP(""YTQASMT-INDEX"",0)=^XTMP(PREFIX_SETID,0)_"" Index"""
^XMB(3.9,146087,2,2291,0)="""RTN"",""YTQRQAD1"",108,0)"
^XMB(3.9,146087,2,2292,0)=" . . L -^XTMP(PREFIX_SETID,0)"
^XMB(3.9,146087,2,2293,0)="""RTN"",""YTQRQAD1"",109,0)"
^XMB(3.9,146087,2,2294,0)=" . . ;M ^XTMP(PREFIX_SETID,1)=DATA                ; save assignment object"
^XMB(3.9,146087,2,2295,0)="""RTN"",""YTQRQAD1"",110,0)"
^XMB(3.9,146087,2,2296,0)=" . . S ^XTMP(PREFIX_SETID,1,""id"")=SETID"
^XMB(3.9,146087,2,2297,0)="""RTN"",""YTQRQAD1"",111,0)"
^XMB(3.9,146087,2,2298,0)=" . . S ^XTMP(""YTQASMT-INDEX"",""AC"",PID,$P(PTNAME,"",""),9999999-$$NOW^XLFDT)=SETID"
^XMB(3.9,146087,2,2299,0)="""RTN"",""YTQRQAD1"",112,0)"
^XMB(3.9,146087,2,2300,0)=" . . S ^XTMP(""YTQASMT-INDEX"",""AD"",DFN,ORDBY,SETID)=EXPIRE"
^XMB(3.9,146087,2,2301,0)="""RTN"",""YTQRQAD1"",113,0)"
^XMB(3.9,146087,2,2302,0)=" . . I +$G(OLDSET) D MVAUTOSV^YTQRCAT(OLDSET,SETID)"
^XMB(3.9,146087,2,2303,0)="""RTN"",""YTQRQAD1"",114,0)"
^XMB(3.9,146087,2,2304,0)=" . . S FOUND=1"
^XMB(3.9,146087,2,2305,0)="""RTN"",""YTQRQAD1"",115,0)"
^XMB(3.9,146087,2,2306,0)=" . I 'FOUND S YSTAT=""500^Could not create Assignment"""
^XMB(3.9,146087,2,2307,0)="""RTN"",""YTQRQAD1"",116,0)"
^XMB(3.9,146087,2,2308,0)=" I TYPE=""EDIT"" D"
^XMB(3.9,146087,2,2309,0)="""RTN"",""YTQRQAD1"",117,0)"
^XMB(3.9,146087,2,2310,0)=" . I SETID="""" S YSTAT=""500^Assignment not provided"" Q"
^XMB(3.9,146087,2,2311,0)="""RTN"",""YTQRQAD1"",118,0)"
^XMB(3.9,146087,2,2312,0)=" . K ^XTMP(""YTQASMT-SET-""_SETID,1,""instruments"")"
^XMB(3.9,146087,2,2313,0)="""RTN"",""YTQRQAD1"",119,0)"
^XMB(3.9,146087,2,2314,0)=" . ;S I=0 F  S I=$O(^XTMP(""YTQASMT-SET-""_SETID,1,""instruments"",I)) Q:I=""""  K ^XTMP(""YTQASMT-SET-""_SETID,1,""instruments"",I)"
^XMB(3.9,146087,2,2315,0)="""RTN"",""YTQRQAD1"",120,0)"
^XMB(3.9,146087,2,2316,0)=" . ;Re-file new instrument info into ^XTMP"
^XMB(3.9,146087,2,2317,0)="""RTN"",""YTQRQAD1"",121,0)"
^XMB(3.9,146087,2,2318,0)=" . I '$D(DATA(""instruments"")) D DELASMT1^YTQRQAD1(SETID) Q  ;Assignment has no instruments"
^XMB(3.9,146087,2,2319,0)="""RTN"",""YTQRQAD1"",122,0)"
^XMB(3.9,146087,2,2320,0)=" . M ^XTMP(PREFIX_SETID,1,""instruments"")=DATA(""instruments"") ; save assignment object"
^XMB(3.9,146087,2,2321,0)="""RTN"",""YTQRQAD1"",123,0)"
^XMB(3.9,146087,2,2322,0)=" . I $D(DATA(""catInfo"")) M ^XTMP(PREFIX_SETID,1,""catInfo"")=DATA(""catInfo"")"
^XMB(3.9,146087,2,2323,0)="""RTN"",""YTQRQAD1"",124,0)"
^XMB(3.9,146087,2,2324,0)=" . ;Kill any changes of omission before merging"
^XMB(3.9,146087,2,2325,0)="""RTN"",""YTQRQAD1"",125,0)"
^XMB(3.9,146087,2,2326,0)=" . I '$D(DATA(""consult"")) K ^XTMP(PREFIX_SETID,1,""consult"")  ;Removed Consult"
^XMB(3.9,146087,2,2327,0)="""RTN"",""YTQRQAD1"",126,0)"
^XMB(3.9,146087,2,2328,0)=" . I '$D(DATA(""adminDate"")) K ^XTMP(PREFIX_SETID,1,""adminDate"")  ;Removed admin date"
^XMB(3.9,146087,2,2329,0)="""RTN"",""YTQRQAD1"",127,0)"
^XMB(3.9,146087,2,2330,0)=" . I '$D(DATA(""cosigner"")) K ^XTMP(PREFIX_SETID,1,""cosigner"")  ;Removed Cosigner"
^XMB(3.9,146087,2,2331,0)="""RTN"",""YTQRQAD1"",128,0)"
^XMB(3.9,146087,2,2332,0)=" . I '$D(^XTMP(PREFIX_SETID,1,""instruments"")) S YSTAT=""500^ERROR"""
^XMB(3.9,146087,2,2333,0)="""RTN"",""YTQRQAD1"",129,0)"
^XMB(3.9,146087,2,2334,0)=" I $D(DATA(2,""PNOTE"")) M ^XTMP(PREFIX_SETID,2)=DATA(2) K DATA(2)"
^XMB(3.9,146087,2,2335,0)="""RTN"",""YTQRQAD1"",130,0)"
^XMB(3.9,146087,2,2336,0)=" I YSTAT'="""" D  Q """""
^XMB(3.9,146087,2,2337,0)="""RTN"",""YTQRQAD1"",131,0)"
^XMB(3.9,146087,2,2338,0)=" . I $P(YSTAT,U)'>300 Q"
^XMB(3.9,146087,2,2339,0)="""RTN"",""YTQRQAD1"",132,0)"
^XMB(3.9,146087,2,2340,0)=" . D SETERROR^YTQRUTL($P(YSTAT,U),$P(YSTAT,U,2))"
^XMB(3.9,146087,2,2341,0)="""RTN"",""YTQRQAD1"",133,0)"
^XMB(3.9,146087,2,2342,0)=" M ^XTMP(PREFIX_SETID,1)=DATA"
^XMB(3.9,146087,2,2343,0)="""RTN"",""YTQRQAD1"",134,0)"
^XMB(3.9,146087,2,2344,0)=" Q ""/api/mha/assignment/""_SETID"
^XMB(3.9,146087,2,2345,0)="""RTN"",""YTQRQAD1"",135,0)"
^XMB(3.9,146087,2,2346,0)=" ;"
^XMB(3.9,146087,2,2347,0)="""RTN"",""YTQRQAD1"",136,0)"
^XMB(3.9,146087,2,2348,0)="DELASMT(ARGS) ; delete the assignment identified in ARGS(""assignmentId"")"
^XMB(3.9,146087,2,2349,0)="""RTN"",""YTQRQAD1"",137,0)"
^XMB(3.9,146087,2,2350,0)=" D DELASMT1(ARGS(""assignmentId""))"
^XMB(3.9,146087,2,2351,0)="""RTN"",""YTQRQAD1"",138,0)"
^XMB(3.9,146087,2,2352,0)=" Q"
^XMB(3.9,146087,2,2353,0)="""RTN"",""YTQRQAD1"",139,0)"
^XMB(3.9,146087,2,2354,0)="TRSASMT(ARGS) ; Delete an assignment from Staff Entry by Trash icon"
^XMB(3.9,146087,2,2355,0)="""RTN"",""YTQRQAD1"",140,0)"
^XMB(3.9,146087,2,2356,0)=" ; Allows deletion of any incomplete assignment (ie no instruments complete)"
^XMB(3.9,146087,2,2357,0)="""RTN"",""YTQRQAD1"",141,0)"
^XMB(3.9,146087,2,2358,0)=" ; *Deletes any incomplete MH ADMINISTRATIONS"
^XMB(3.9,146087,2,2359,0)="""RTN"",""YTQRQAD1"",142,0)"
^XMB(3.9,146087,2,2360,0)=" D DELASMT1(ARGS(""assignmentId""),1)"
^XMB(3.9,146087,2,2361,0)="""RTN"",""YTQRQAD1"",143,0)"
^XMB(3.9,146087,2,2362,0)=" Q"
^XMB(3.9,146087,2,2363,0)="""RTN"",""YTQRQAD1"",144,0)"
^XMB(3.9,146087,2,2364,0)="DELASMT1(ASMT,TRS,REPLACE) ; delete the assignment given the assignment number"
^XMB(3.9,146087,2,2365,0)="""RTN"",""YTQRQAD1"",145,0)"
^XMB(3.9,146087,2,2366,0)=" ;ASMT=Assignment number"
^XMB(3.9,146087,2,2367,0)="""RTN"",""YTQRQAD1"",146,0)"
^XMB(3.9,146087,2,2368,0)=" ;TRS=Called from Trash Assignment - allow deletion of incomplete MH ADMINISTRATION"
^XMB(3.9,146087,2,2369,0)="""RTN"",""YTQRQAD1"",147,0)"
^XMB(3.9,146087,2,2370,0)=" ;REPLACE=1 if called from FILASGN for moving one AssignmentID to a new AssignmentID"
^XMB(3.9,146087,2,2371,0)="""RTN"",""YTQRQAD1"",148,0)"
^XMB(3.9,146087,2,2372,0)=" N DATA,DFN,ORDBY,IARR,INST,TRSERR,VAERR,VA,VADM"
^XMB(3.9,146087,2,2373,0)="""RTN"",""YTQRQAD1"",149,0)"
^XMB(3.9,146087,2,2374,0)=" N AGPROG,PNOT"
^XMB(3.9,146087,2,2375,0)="""RTN"",""YTQRQAD1"",150,0)"
^XMB(3.9,146087,2,2376,0)=" S TRS=$G(TRS),TRSERR="""""
^XMB(3.9,146087,2,2377,0)="""RTN"",""YTQRQAD1"",151,0)"
^XMB(3.9,146087,2,2378,0)=" S REPLACE=$G(REPLACE)"
^XMB(3.9,146087,2,2379,0)="""RTN"",""YTQRQAD1"",152,0)"
^XMB(3.9,146087,2,2380,0)=" M DATA=^XTMP(""YTQASMT-SET-""_ASMT,1)"
^XMB(3.9,146087,2,2381,0)="""RTN"",""YTQRQAD1"",153,0)"
^XMB(3.9,146087,2,2382,0)=" I $D(DATA)<10 D SETERROR^YTQRUTL(404,""Assignment not found"") QUIT"
^XMB(3.9,146087,2,2383,0)="""RTN"",""YTQRQAD1"",154,0)"
^XMB(3.9,146087,2,2384,0)=" S DFN=+$G(DATA(""patient"",""dfn""))"
^XMB(3.9,146087,2,2385,0)="""RTN"",""YTQRQAD1"",155,0)"
^XMB(3.9,146087,2,2386,0)=" S ORDBY=+$G(DATA(""orderedBy""))"
^XMB(3.9,146087,2,2387,0)="""RTN"",""YTQRQAD1"",156,0)"
^XMB(3.9,146087,2,2388,0)=" S AGPROG=$D(^XTMP(""YTQASMT-SET-""_ASMT,2))"
^XMB(3.9,146087,2,2389,0)="""RTN"",""YTQRQAD1"",157,0)"
^XMB(3.9,146087,2,2390,0)=" ; Moved Patient check here before deleting XREF otherwise XREF killed before Assignment killed/TRSERR=1"
^XMB(3.9,146087,2,2391,0)="""RTN"",""YTQRQAD1"",158,0)"
^XMB(3.9,146087,2,2392,0)=" D DEM^VADPT I $G(VAERR) D SETERROR^YTQRUTL(404,""Assignment missing pt info"") QUIT  ; missing pt info"
^XMB(3.9,146087,2,2393,0)="""RTN"",""YTQRQAD1"",159,0)"
^XMB(3.9,146087,2,2394,0)=" ;I '$$DELIDX^YTQRQAD1(ASMT,DFN,ORDBY) D SETERROR^YTQRUTL(404,""Assignment missing pt info"") QUIT  ; missing pt info"
^XMB(3.9,146087,2,2395,0)="""RTN"",""YTQRQAD1"",160,0)"
^XMB(3.9,146087,2,2396,0)=" I TRS=1 D"
^XMB(3.9,146087,2,2397,0)="""RTN"",""YTQRQAD1"",161,0)"
^XMB(3.9,146087,2,2398,0)=" . D AINSTS^YTQRQAD7(ASMT,.IARR)"
^XMB(3.9,146087,2,2399,0)="""RTN"",""YTQRQAD1"",162,0)"
^XMB(3.9,146087,2,2400,0)=" . I $G(IARR(""STAT""))=""NOTALLOWED"" D SETERROR^YTQRUTL(405,""Delete assignment not allowed"") S TRSERR=1 QUIT"
^XMB(3.9,146087,2,2401,0)="""RTN"",""YTQRQAD1"",163,0)"
^XMB(3.9,146087,2,2402,0)=" . I $G(IARR(""STAT""))=""NOTOK"" D SETERROR^YTQRUTL(405,""One or more instruments complete"") S TRSERR=1 QUIT"
^XMB(3.9,146087,2,2403,0)="""RTN"",""YTQRQAD1"",164,0)"
^XMB(3.9,146087,2,2404,0)=" . I '$$DELIDX^YTQRQAD1(ASMT,DFN,ORDBY) QUIT  ; missing pt info"
^XMB(3.9,146087,2,2405,0)="""RTN"",""YTQRQAD1"",165,0)"
^XMB(3.9,146087,2,2406,0)=" . S INST=0 F  S INST=$O(IARR(INST)) QUIT:+INST=0  D"
^XMB(3.9,146087,2,2407,0)="""RTN"",""YTQRQAD1"",166,0)"
^XMB(3.9,146087,2,2408,0)=" .. Q:IARR(INST)=0  ;Safety net"
^XMB(3.9,146087,2,2409,0)="""RTN"",""YTQRQAD1"",167,0)"
^XMB(3.9,146087,2,2410,0)=" .. Q:'$D(IARR(INST,""ADMINID""))"
^XMB(3.9,146087,2,2411,0)="""RTN"",""YTQRQAD1"",168,0)"
^XMB(3.9,146087,2,2412,0)=" .. D DELADMIN(IARR(INST,""ADMINID""))"
^XMB(3.9,146087,2,2413,0)="""RTN"",""YTQRQAD1"",169,0)"
^XMB(3.9,146087,2,2414,0)=" I TRSERR=1 QUIT"
^XMB(3.9,146087,2,2415,0)="""RTN"",""YTQRQAD1"",170,0)"
^XMB(3.9,146087,2,2416,0)=" I AGPROG>0,(REPLACE'=1) S PNOT=$$FILPNOT^YTQRQAD8(ASMT,,,,,1)  ;File any completed instrument Progress Note before deleting an Assignment if NOT from a moved assignment"
^XMB(3.9,146087,2,2417,0)="""RTN"",""YTQRQAD1"",171,0)"
^XMB(3.9,146087,2,2418,0)=" N OK S OK=$$DELIDX^YTQRQAD1(ASMT,DFN,ORDBY)"
^XMB(3.9,146087,2,2419,0)="""RTN"",""YTQRQAD1"",172,0)"
^XMB(3.9,146087,2,2420,0)=" K ^XTMP(""YTQASMT-SET-""_ASMT)"
^XMB(3.9,146087,2,2421,0)="""RTN"",""YTQRQAD1"",173,0)"
^XMB(3.9,146087,2,2422,0)=" Q"
^XMB(3.9,146087,2,2423,0)="""RTN"",""YTQRQAD1"",174,0)"
^XMB(3.9,146087,2,2424,0)="DELIDX(ASMT,DFN,ORDBY) ; return true if able to remove ""AC"", ""AD"" indexes"
^XMB(3.9,146087,2,2425,0)="""RTN"",""YTQRQAD1"",175,0)"
^XMB(3.9,146087,2,2426,0)=" N VA,VADM,VAERR,PID,LNAME,INVDT"
^XMB(3.9,146087,2,2427,0)="""RTN"",""YTQRQAD1"",176,0)"
^XMB(3.9,146087,2,2428,0)=" D DEM^VADPT I $G(VAERR) D SETERROR^YTQRUTL(400,""Missing Pt Info"") QUIT 0"
^XMB(3.9,146087,2,2429,0)="""RTN"",""YTQRQAD1"",177,0)"
^XMB(3.9,146087,2,2430,0)=" S PID=VA(""BID""),LNAME=$P(VADM(1),"","")  ;VA(""BID"")=last 4 SSN"
^XMB(3.9,146087,2,2431,0)="""RTN"",""YTQRQAD1"",178,0)"
^XMB(3.9,146087,2,2432,0)=" K ^XTMP(""YTQASMT-INDEX"",""AD"",DFN,ORDBY,ASMT)"
^XMB(3.9,146087,2,2433,0)="""RTN"",""YTQRQAD1"",179,0)"
^XMB(3.9,146087,2,2434,0)=" S INVDT=0 F  S INVDT=$O(^XTMP(""YTQASMT-INDEX"",""AC"",PID,LNAME,INVDT)) Q:'INVDT  D"
^XMB(3.9,146087,2,2435,0)="""RTN"",""YTQRQAD1"",180,0)"
^XMB(3.9,146087,2,2436,0)=" . I ^XTMP(""YTQASMT-INDEX"",""AC"",PID,LNAME,INVDT)=ASMT D"
^XMB(3.9,146087,2,2437,0)="""RTN"",""YTQRQAD1"",181,0)"
^XMB(3.9,146087,2,2438,0)=" . . K ^XTMP(""YTQASMT-INDEX"",""AC"",PID,LNAME,INVDT)"
^XMB(3.9,146087,2,2439,0)="""RTN"",""YTQRQAD1"",182,0)"
^XMB(3.9,146087,2,2440,0)=" Q 1"
^XMB(3.9,146087,2,2441,0)="""RTN"",""YTQRQAD1"",183,0)"
^XMB(3.9,146087,2,2442,0)=" ;"
^XMB(3.9,146087,2,2443,0)="""RTN"",""YTQRQAD1"",184,0)"
^XMB(3.9,146087,2,2444,0)="DELTEST(ARGS) ; remove an instrument from an assignment"
^XMB(3.9,146087,2,2445,0)="""RTN"",""YTQRQAD1"",185,0)"
^XMB(3.9,146087,2,2446,0)=" I $L($G(ARGS(""assignmentId"")))=32 G GETASMT^YTQRCRW ; CPRS DLL"
^XMB(3.9,146087,2,2447,0)="""RTN"",""YTQRQAD1"",186,0)"
^XMB(3.9,146087,2,2448,0)=" ;"
^XMB(3.9,146087,2,2449,0)="""RTN"",""YTQRQAD1"",187,0)"
^XMB(3.9,146087,2,2450,0)=" N ASMT,TEST,TSLIST,II,DELFASGN"
^XMB(3.9,146087,2,2451,0)="""RTN"",""YTQRQAD1"",188,0)"
^XMB(3.9,146087,2,2452,0)=" S ASMT=$G(ARGS(""assignmentId""))"
^XMB(3.9,146087,2,2453,0)="""RTN"",""YTQRQAD1"",189,0)"
^XMB(3.9,146087,2,2454,0)=" S DELFASGN=$G(ARGS(""delfrmassign""))  ;Flag to Delete Instrument from Assignment"
^XMB(3.9,146087,2,2455,0)="""RTN"",""YTQRQAD1"",190,0)"
^XMB(3.9,146087,2,2456,0)=" S:DELFASGN'=""NO"" DELFASGN=""YES""  ;Default is Delete from Assignment"
^XMB(3.9,146087,2,2457,0)="""RTN"",""YTQRQAD1"",191,0)"
^XMB(3.9,146087,2,2458,0)=" I $D(^XTMP(""YTQASMT-SET-""_ASMT))<10 D SETERROR^YTQRUTL(404,""Assignment not found"") QUIT"
^XMB(3.9,146087,2,2459,0)="""RTN"",""YTQRQAD1"",192,0)"
^XMB(3.9,146087,2,2460,0)=" S TSLIST=$G(ARGS(""instrument"")) I '$L(TSLIST) D SETERROR^YTQRUTL(404,""Instrument for deletion not sent"") QUIT"
^XMB(3.9,146087,2,2461,0)="""RTN"",""YTQRQAD1"",193,0)"
^XMB(3.9,146087,2,2462,0)=" F II=1:1:$L(TSLIST,"","") D"
^XMB(3.9,146087,2,2463,0)="""RTN"",""YTQRQAD1"",194,0)"
^XMB(3.9,146087,2,2464,0)=" . S TEST=$P(TSLIST,"","",II)"
^XMB(3.9,146087,2,2465,0)="""RTN"",""YTQRQAD1"",195,0)"
^XMB(3.9,146087,2,2466,0)=" . Q:TEST="""""
^XMB(3.9,146087,2,2467,0)="""RTN"",""YTQRQAD1"",196,0)"
^XMB(3.9,146087,2,2468,0)=" . I +TEST=TEST S TEST=$P($G(^YTT(601.71,TEST,0)),U) ; use instrument name"
^XMB(3.9,146087,2,2469,0)="""RTN"",""YTQRQAD1"",197,0)"
^XMB(3.9,146087,2,2470,0)=" . I '$L(TEST) D SETERROR^YTQRUTL(404,""Instrument not found"") QUIT"
^XMB(3.9,146087,2,2471,0)="""RTN"",""YTQRQAD1"",198,0)"
^XMB(3.9,146087,2,2472,0)=" . D RMVTEST(ASMT,TEST,1,DELFASGN)"
^XMB(3.9,146087,2,2473,0)="""RTN"",""YTQRQAD1"",199,0)"
^XMB(3.9,146087,2,2474,0)=" Q ""/api/mha/assignment/""_ASMT_""/""_TSLIST_""/OK"""
^XMB(3.9,146087,2,2475,0)="""RTN"",""YTQRQAD1"",200,0)"
^XMB(3.9,146087,2,2476,0)="RMVTEST(ASMT,TEST,DELADMIN,DELFASGN,REPLACE) ; remove test from assignment, delete assignment if empty"
^XMB(3.9,146087,2,2477,0)="""RTN"",""YTQRQAD1"",201,0)"
^XMB(3.9,146087,2,2478,0)=" ;Delete MH ADMINISTRATION if DELADMIN=1."
^XMB(3.9,146087,2,2479,0)="""RTN"",""YTQRQAD1"",202,0)"
^XMB(3.9,146087,2,2480,0)=" ;Do Not Delete Instrument from Assignment if DELFASGN=""NO"". Used for 0 days restart instruments that need to be restarted same day."
^XMB(3.9,146087,2,2481,0)="""RTN"",""YTQRQAD1"",203,0)"
^XMB(3.9,146087,2,2482,0)=" ;REPLACE=1 if called from FILASGN for moving one AssignmentID to a new AssignmentID"
^XMB(3.9,146087,2,2483,0)="""RTN"",""YTQRQAD1"",204,0)"
^XMB(3.9,146087,2,2484,0)=" N I,NODE,IARR"
^XMB(3.9,146087,2,2485,0)="""RTN"",""YTQRQAD1"",205,0)"
^XMB(3.9,146087,2,2486,0)=" S DELFASGN=$G(DELFASGN) S:DELFASGN'=""NO"" DELFASGN=""YES""  ;Default is to delete from Assignment"
^XMB(3.9,146087,2,2487,0)="""RTN"",""YTQRQAD1"",206,0)"
^XMB(3.9,146087,2,2488,0)=" S DELADMIN=$G(DELADMIN)"
^XMB(3.9,146087,2,2489,0)="""RTN"",""YTQRQAD1"",207,0)"
^XMB(3.9,146087,2,2490,0)=" S REPLACE=$G(REPLACE)"
^XMB(3.9,146087,2,2491,0)="""RTN"",""YTQRQAD1"",208,0)"
^XMB(3.9,146087,2,2492,0)=" D AINSTS^YTQRQAD7(ASMT,.IARR)  ;Get Delete status of instruments for an Assignment"
^XMB(3.9,146087,2,2493,0)="""RTN"",""YTQRQAD1"",209,0)"
^XMB(3.9,146087,2,2494,0)=" S NODE=""YTQASMT-SET-""_ASMT"
^XMB(3.9,146087,2,2495,0)="""RTN"",""YTQRQAD1"",210,0)"
^XMB(3.9,146087,2,2496,0)=" S I=0 F  S I=$O(^XTMP(NODE,1,""instruments"",I)) Q:'I  D"
^XMB(3.9,146087,2,2497,0)="""RTN"",""YTQRQAD1"",211,0)"
^XMB(3.9,146087,2,2498,0)=" . I ^XTMP(NODE,1,""instruments"",I,""name"")=TEST D"
^XMB(3.9,146087,2,2499,0)="""RTN"",""YTQRQAD1"",212,0)"
^XMB(3.9,146087,2,2500,0)=" . . ;I DELADMIN=1,(IARR(I)'=0),($D(IARR(I,""ADMINID""))) D"
^XMB(3.9,146087,2,2501,0)="""RTN"",""YTQRQAD1"",213,0)"
^XMB(3.9,146087,2,2502,0)=" . . I DELADMIN=1,($D(IARR(I,""ADMINID""))) D  ;Not Interview, Not Ordering OK"
^XMB(3.9,146087,2,2503,0)="""RTN"",""YTQRQAD1"",214,0)"
^XMB(3.9,146087,2,2504,0)=" . . . D DELADMIN(IARR(I,""ADMINID""))"
^XMB(3.9,146087,2,2505,0)="""RTN"",""YTQRQAD1"",215,0)"
^XMB(3.9,146087,2,2506,0)=" . . I DELFASGN=""YES"" K ^XTMP(NODE,1,""instruments"",I)"
^XMB(3.9,146087,2,2507,0)="""RTN"",""YTQRQAD1"",216,0)"
^XMB(3.9,146087,2,2508,0)=" . . I DELFASGN=""NO"" D"
^XMB(3.9,146087,2,2509,0)="""RTN"",""YTQRQAD1"",217,0)"
^XMB(3.9,146087,2,2510,0)=" . . . S ^XTMP(NODE,1,""instruments"",I,""adminId"")=""null"""
^XMB(3.9,146087,2,2511,0)="""RTN"",""YTQRQAD1"",218,0)"
^XMB(3.9,146087,2,2512,0)=" . . . S ^XTMP(NODE,1,""instruments"",I,""complete"")=""false"""
^XMB(3.9,146087,2,2513,0)="""RTN"",""YTQRQAD1"",219,0)"
^XMB(3.9,146087,2,2514,0)=" . . . S ^XTMP(NODE,1,""instruments"",I,""progress"")=0"
^XMB(3.9,146087,2,2515,0)="""RTN"",""YTQRQAD1"",220,0)"
^XMB(3.9,146087,2,2516,0)=" I $D(^XTMP(NODE,1,""instruments""))<10 D DELASMT1(ASMT,,REPLACE)"
^XMB(3.9,146087,2,2517,0)="""RTN"",""YTQRQAD1"",221,0)"
^XMB(3.9,146087,2,2518,0)=" Q"
^XMB(3.9,146087,2,2519,0)="""RTN"",""YTQRQAD1"",222,0)"
^XMB(3.9,146087,2,2520,0)=" ;"
^XMB(3.9,146087,2,2521,0)="""RTN"",""YTQRQAD1"",223,0)"
^XMB(3.9,146087,2,2522,0)="DELMHAD(ARGS,DATA) ;Delete Completed MH Admin"
^XMB(3.9,146087,2,2523,0)="""RTN"",""YTQRQAD1"",224,0)"
^XMB(3.9,146087,2,2524,0)=" N MGR,ADMINID,X0"
^XMB(3.9,146087,2,2525,0)="""RTN"",""YTQRQAD1"",225,0)"
^XMB(3.9,146087,2,2526,0)=" S MGR=$$ISMGR"
^XMB(3.9,146087,2,2527,0)="""RTN"",""YTQRQAD1"",226,0)"
^XMB(3.9,146087,2,2528,0)=" S ADMINID=$G(ARGS(""adminId""))"
^XMB(3.9,146087,2,2529,0)="""RTN"",""YTQRQAD1"",227,0)"
^XMB(3.9,146087,2,2530,0)=" I ADMINID="""" D SETERROR^YTQRUTL(404,""Admin ID Missing"") Q ""/api/mha/instrument/mhadmin/ERROR"""
^XMB(3.9,146087,2,2531,0)="""RTN"",""YTQRQAD1"",228,0)"
^XMB(3.9,146087,2,2532,0)=" I '$D(^YTT(601.84,ADMINID)) D SETERROR^YTQRUTL(404,""Admin ID not found"") Q ""/api/mha/instrument/mhadmin/ERROR"""
^XMB(3.9,146087,2,2533,0)="""RTN"",""YTQRQAD1"",229,0)"
^XMB(3.9,146087,2,2534,0)=" S X0=^YTT(601.84,ADMINID,0)"
^XMB(3.9,146087,2,2535,0)="""RTN"",""YTQRQAD1"",230,0)"
^XMB(3.9,146087,2,2536,0)=" ;I MGR!(DUZ=$P(X0,U,6))!(DUZ=$P(X0,U,7)) D DELADMIN(ADMINID) I 1"
^XMB(3.9,146087,2,2537,0)="""RTN"",""YTQRQAD1"",231,0)"
^XMB(3.9,146087,2,2538,0)=" I MGR D DELADMIN(ADMINID) I 1"
^XMB(3.9,146087,2,2539,0)="""RTN"",""YTQRQAD1"",232,0)"
^XMB(3.9,146087,2,2540,0)=" E  D SETERROR^YTQRUTL(404,""Deletion not allowed:  insufficient privilege"") Q ""/api/mha/instrument/mhadmin/ERROR"""
^XMB(3.9,146087,2,2541,0)="""RTN"",""YTQRQAD1"",233,0)"
^XMB(3.9,146087,2,2542,0)=" Q ""/api/mha/instrument/mhadmin/OK"""
^XMB(3.9,146087,2,2543,0)="""RTN"",""YTQRQAD1"",234,0)"
^XMB(3.9,146087,2,2544,0)="ISMGR() ; return 1 if admin access to admins"
^XMB(3.9,146087,2,2545,0)="""RTN"",""YTQRQAD1"",235,0)"
^XMB(3.9,146087,2,2546,0)=" N YSMENU,YSPRIV"
^XMB(3.9,146087,2,2547,0)="""RTN"",""YTQRQAD1"",236,0)"
^XMB(3.9,146087,2,2548,0)=" S YSMENU=$$LKOPT^XPDMENU(""YSMANAGER"") Q:'YSMENU 0"
^XMB(3.9,146087,2,2549,0)="""RTN"",""YTQRQAD1"",237,0)"
^XMB(3.9,146087,2,2550,0)=" S YSPRIV=$$ACCESS^XQCHK(DUZ,YSMENU)"
^XMB(3.9,146087,2,2551,0)="""RTN"",""YTQRQAD1"",238,0)"
^XMB(3.9,146087,2,2552,0)=" Q +YSPRIV>0"
^XMB(3.9,146087,2,2553,0)="""RTN"",""YTQRQAD1"",239,0)"
^XMB(3.9,146087,2,2554,0)=" ;"
^XMB(3.9,146087,2,2555,0)="""RTN"",""YTQRQAD1"",240,0)"
^XMB(3.9,146087,2,2556,0)="ADMEXPD(ADMIN,TEST) ; return 1 if incomplete admin has expired"
^XMB(3.9,146087,2,2557,0)="""RTN"",""YTQRQAD1"",241,0)"
^XMB(3.9,146087,2,2558,0)=" QUIT:'ADMIN 0"
^XMB(3.9,146087,2,2559,0)="""RTN"",""YTQRQAD1"",242,0)"
^XMB(3.9,146087,2,2560,0)=" N X0,YSNOW,YSDOW,OFFSET,SAVED,RESTRT"
^XMB(3.9,146087,2,2561,0)="""RTN"",""YTQRQAD1"",243,0)"
^XMB(3.9,146087,2,2562,0)=" S X0=$G(^YTT(601.84,ADMIN,0))"
^XMB(3.9,146087,2,2563,0)="""RTN"",""YTQRQAD1"",244,0)"
^XMB(3.9,146087,2,2564,0)=" QUIT:$P(X0,U,9)=""Y"" 0                     ; admin is complete"
^XMB(3.9,146087,2,2565,0)="""RTN"",""YTQRQAD1"",245,0)"
^XMB(3.9,146087,2,2566,0)=" QUIT:$P(X0,U,3)'=TEST 0                   ; test mismatch, something wrong"
^XMB(3.9,146087,2,2567,0)="""RTN"",""YTQRQAD1"",246,0)"
^XMB(3.9,146087,2,2568,0)=" S YSNOW=$$NOW^XLFDT,YSDOW=$$DOW^XLFDT(YSNOW)"
^XMB(3.9,146087,2,2569,0)="""RTN"",""YTQRQAD1"",247,0)"
^XMB(3.9,146087,2,2570,0)=" S OFFSET=$S(YSDOW=5:2,YSDOW=6:1,1:0)      ; account for weekends"
^XMB(3.9,146087,2,2571,0)="""RTN"",""YTQRQAD1"",248,0)"
^XMB(3.9,146087,2,2572,0)=" S SAVED=$P(X0,U,5)                        ; DATE SAVED (#4)"
^XMB(3.9,146087,2,2573,0)="""RTN"",""YTQRQAD1"",249,0)"
^XMB(3.9,146087,2,2574,0)=" S RESTRT=$P($G(^YTT(601.71,TEST,8)),U,7)  ; DAYS TO RESTART (#27)"
^XMB(3.9,146087,2,2575,0)="""RTN"",""YTQRQAD1"",250,0)"
^XMB(3.9,146087,2,2576,0)=" QUIT:RESTRT=-1 0                          ; -1 is always restartable"
^XMB(3.9,146087,2,2577,0)="""RTN"",""YTQRQAD1"",251,0)"
^XMB(3.9,146087,2,2578,0)=" S:'RESTRT RESTRT=2                        ; default restart is 2"
^XMB(3.9,146087,2,2579,0)="""RTN"",""YTQRQAD1"",252,0)"
^XMB(3.9,146087,2,2580,0)=" I $$FMDIFF^XLFDT(YSNOW,SAVED,2)>((RESTRT+OFFSET)*86400) QUIT 1"
^XMB(3.9,146087,2,2581,0)="""RTN"",""YTQRQAD1"",253,0)"
^XMB(3.9,146087,2,2582,0)=" Q 0"
^XMB(3.9,146087,2,2583,0)="""RTN"",""YTQRQAD1"",254,0)"
^XMB(3.9,146087,2,2584,0)=" ;"
^XMB(3.9,146087,2,2585,0)="""RTN"",""YTQRQAD1"",255,0)"
^XMB(3.9,146087,2,2586,0)="DELADMIN(YSADM) ; delete an admin & associated records"
^XMB(3.9,146087,2,2587,0)="""RTN"",""YTQRQAD1"",256,0)"
^XMB(3.9,146087,2,2588,0)=" N X,Y,DIK,DA,YSANS,YSRSLT,YSEVDFN,YSEVTST,YSEVCPLT"
^XMB(3.9,146087,2,2589,0)="""RTN"",""YTQRQAD1"",257,0)"
^XMB(3.9,146087,2,2590,0)=" S YSEVDFN=+$P($G(^YTT(601.84,+YSADM,0)),U,2)"
^XMB(3.9,146087,2,2591,0)="""RTN"",""YTQRQAD1"",258,0)"
^XMB(3.9,146087,2,2592,0)=" S YSEVTST=+$P($G(^YTT(601.84,+YSADM,0)),U,3)"
^XMB(3.9,146087,2,2593,0)="""RTN"",""YTQRQAD1"",259,0)"
^XMB(3.9,146087,2,2594,0)=" S YSEVTST=$P($G(^YTT(601.71,YSEVTST,0)),U)"
^XMB(3.9,146087,2,2595,0)="""RTN"",""YTQRQAD1"",260,0)"
^XMB(3.9,146087,2,2596,0)=" S YSEVCPLT=($P($G(^YTT(601.84,+YSADM,0)),U,9)=""Y"")"
^XMB(3.9,146087,2,2597,0)="""RTN"",""YTQRQAD1"",261,0)"
^XMB(3.9,146087,2,2598,0)=" ; delete the admin record"
^XMB(3.9,146087,2,2599,0)="""RTN"",""YTQRQAD1"",262,0)"
^XMB(3.9,146087,2,2600,0)=" S DIK=""^YTT(601.84,"",DA=YSADM D ^DIK"
^XMB(3.9,146087,2,2601,0)="""RTN"",""YTQRQAD1"",263,0)"
^XMB(3.9,146087,2,2602,0)=" ; delete the answer records"
^XMB(3.9,146087,2,2603,0)="""RTN"",""YTQRQAD1"",264,0)"
^XMB(3.9,146087,2,2604,0)=" S YSANS=0 F  S YSANS=$O(^YTT(601.85,""AD"",YSADM,YSANS)) Q:YSANS'>0  D"
^XMB(3.9,146087,2,2605,0)="""RTN"",""YTQRQAD1"",265,0)"
^XMB(3.9,146087,2,2606,0)=" . I $P(^YTT(601.85,YSANS,0),U,2)'=YSADM Q  ; admin doesn't match"
^XMB(3.9,146087,2,2607,0)="""RTN"",""YTQRQAD1"",266,0)"
^XMB(3.9,146087,2,2608,0)=" . S DIK=""^YTT(601.85,"",DA=YSANS D ^DIK"
^XMB(3.9,146087,2,2609,0)="""RTN"",""YTQRQAD1"",267,0)"
^XMB(3.9,146087,2,2610,0)=" ; delete the result records"
^XMB(3.9,146087,2,2611,0)="""RTN"",""YTQRQAD1"",268,0)"
^XMB(3.9,146087,2,2612,0)=" S YSRSLT=0 F  S YSRSLT=$O(^YTT(601.92,""AC"",YSADM,YSRSLT)) Q:YSRSLT'>0  D"
^XMB(3.9,146087,2,2613,0)="""RTN"",""YTQRQAD1"",269,0)"
^XMB(3.9,146087,2,2614,0)=" . I $P(^YTT(601.92,YSRSLT,0),U,2)'=YSADM Q  ; result doesn't match"
^XMB(3.9,146087,2,2615,0)="""RTN"",""YTQRQAD1"",270,0)"
^XMB(3.9,146087,2,2616,0)=" . S DIK=""^YTT(601.92,"",DA=YSRSLT D ^DIK"
^XMB(3.9,146087,2,2617,0)="""RTN"",""YTQRQAD1"",271,0)"
^XMB(3.9,146087,2,2618,0)=" ; publish delete event for admin if it was completed"
^XMB(3.9,146087,2,2619,0)="""RTN"",""YTQRQAD1"",272,0)"
^XMB(3.9,146087,2,2620,0)=" I YSEVCPLT D DELETE^YTQEVNT(YSADM,YSEVDFN,YSEVTST,""webdel"")"
^XMB(3.9,146087,2,2621,0)="""RTN"",""YTQRQAD1"",273,0)"
^XMB(3.9,146087,2,2622,0)=" Q"
^XMB(3.9,146087,2,2623,0)="""RTN"",""YTQRQAD2"")"
^XMB(3.9,146087,2,2624,0)="0^8^B71758288"
^XMB(3.9,146087,2,2625,0)="""RTN"",""YTQRQAD2"",1,0)"
^XMB(3.9,146087,2,2626,0)="YTQRQAD2 ;SLC/KCM - RESTful Calls to set/get MHA administrations ;Oct 31, 2024@13:37:11"
^XMB(3.9,146087,2,2627,0)="""RTN"",""YTQRQAD2"",2,0)"
^XMB(3.9,146087,2,2628,0)=" ;;5.01;MENTAL HEALTH;**130,141,173,178,182,181,199,202,204,208,233,223,234,238,250,236**;Dec 30, 1994;Build 0"
^XMB(3.9,146087,2,2629,0)="""RTN"",""YTQRQAD2"",3,0)"
^XMB(3.9,146087,2,2630,0)=" ;"
^XMB(3.9,146087,2,2631,0)="""RTN"",""YTQRQAD2"",4,0)"
^XMB(3.9,146087,2,2632,0)="SAVEADM(ARGS,DATA) ; save answers and return /ys/mha/admin/{adminId}"
^XMB(3.9,146087,2,2633,0)="""RTN"",""YTQRQAD2"",5,0)"
^XMB(3.9,146087,2,2634,0)=" I $G(DATA(""assignmentId""))?36ANP G POSTADM^YTQRCRW"
^XMB(3.9,146087,2,2635,0)="""RTN"",""YTQRQAD2"",6,0)"
^XMB(3.9,146087,2,2636,0)=" N ADMIN"
^XMB(3.9,146087,2,2637,0)="""RTN"",""YTQRQAD2"",7,0)"
^XMB(3.9,146087,2,2638,0)=" S ADMIN=$$QASAVE(.DATA) QUIT:'ADMIN """"  ; create admin & answer records"
^XMB(3.9,146087,2,2639,0)="""RTN"",""YTQRQAD2"",8,0)"
^XMB(3.9,146087,2,2640,0)=" ;"
^XMB(3.9,146087,2,2641,0)="""RTN"",""YTQRQAD2"",9,0)"
^XMB(3.9,146087,2,2642,0)=" ; create a note if this was patient-entered"
^XMB(3.9,146087,2,2643,0)="""RTN"",""YTQRQAD2"",10,0)"
^XMB(3.9,146087,2,2644,0)=" N ASMT,CPLT,PTENT,LSTASMT,PNOT,AGPROG,TMPYS"
^XMB(3.9,146087,2,2645,0)="""RTN"",""YTQRQAD2"",11,0)"
^XMB(3.9,146087,2,2646,0)=" N YSCERR"
^XMB(3.9,146087,2,2647,0)="""RTN"",""YTQRQAD2"",12,0)"
^XMB(3.9,146087,2,2648,0)=" S ASMT=DATA(""assignmentId"")"
^XMB(3.9,146087,2,2649,0)="""RTN"",""YTQRQAD2"",13,0)"
^XMB(3.9,146087,2,2650,0)=" S LSTASMT=$G(DATA(""lastAssignment""))"
^XMB(3.9,146087,2,2651,0)="""RTN"",""YTQRQAD2"",14,0)"
^XMB(3.9,146087,2,2652,0)=" S CPLT=$S(DATA(""complete"")=""true"":""Y"",1:""N"")"
^XMB(3.9,146087,2,2653,0)="""RTN"",""YTQRQAD2"",15,0)"
^XMB(3.9,146087,2,2654,0)=" S YSCERR="""""
^XMB(3.9,146087,2,2655,0)="""RTN"",""YTQRQAD2"",16,0)"
^XMB(3.9,146087,2,2656,0)=" I CPLT=""Y"" D  ;Score instrument results up front in MHA"
^XMB(3.9,146087,2,2657,0)="""RTN"",""YTQRQAD2"",17,0)"
^XMB(3.9,146087,2,2658,0)=" . N YS,YSDATA"
^XMB(3.9,146087,2,2659,0)="""RTN"",""YTQRQAD2"",18,0)"
^XMB(3.9,146087,2,2660,0)=" . K ^TMP($J,""YSCOR"")"
^XMB(3.9,146087,2,2661,0)="""RTN"",""YTQRQAD2"",19,0)"
^XMB(3.9,146087,2,2662,0)=" . S YS(""AD"")=ADMIN"
^XMB(3.9,146087,2,2663,0)="""RTN"",""YTQRQAD2"",20,0)"
^XMB(3.9,146087,2,2664,0)=" . D SCORSAVE^YTQAPI11(.YSDATA,.YS)"
^XMB(3.9,146087,2,2665,0)="""RTN"",""YTQRQAD2"",21,0)"
^XMB(3.9,146087,2,2666,0)=" . ; check and return any errors from SCORSAVE"
^XMB(3.9,146087,2,2667,0)="""RTN"",""YTQRQAD2"",22,0)"
^XMB(3.9,146087,2,2668,0)=" . I $G(^TMP($J,""YSCOR"",1))'=""[DATA]"" S YSCERR=$G(^TMP($J,""YSCOR"",2))"
^XMB(3.9,146087,2,2669,0)="""RTN"",""YTQRQAD2"",23,0)"
^XMB(3.9,146087,2,2670,0)=" S PTENT=($G(^XTMP(""YTQASMT-SET-""_ASMT,1,""entryMode""))=""patient"")"
^XMB(3.9,146087,2,2671,0)="""RTN"",""YTQRQAD2"",24,0)"
^XMB(3.9,146087,2,2672,0)=" I (CPLT=""Y""),PTENT,(LSTASMT'=""Yes"") D NOTE4PT^YTQRQAD3(ADMIN,.DATA)"
^XMB(3.9,146087,2,2673,0)="""RTN"",""YTQRQAD2"",25,0)"
^XMB(3.9,146087,2,2674,0)=" ;"
^XMB(3.9,146087,2,2675,0)="""RTN"",""YTQRQAD2"",26,0)"
^XMB(3.9,146087,2,2676,0)=" ; update the assignment with adminId, remove completed admins/assignments"
^XMB(3.9,146087,2,2677,0)="""RTN"",""YTQRQAD2"",27,0)"
^XMB(3.9,146087,2,2678,0)=" N I,NOD,REMAIN"
^XMB(3.9,146087,2,2679,0)="""RTN"",""YTQRQAD2"",28,0)"
^XMB(3.9,146087,2,2680,0)=" S NOD=""YTQASMT-SET-""_ASMT,REMAIN=0"
^XMB(3.9,146087,2,2681,0)="""RTN"",""YTQRQAD2"",29,0)"
^XMB(3.9,146087,2,2682,0)=" S I=0 F  S I=$O(^XTMP(NOD,1,""instruments"",I)) Q:'I  D"
^XMB(3.9,146087,2,2683,0)="""RTN"",""YTQRQAD2"",30,0)"
^XMB(3.9,146087,2,2684,0)=" . I ^XTMP(NOD,1,""instruments"",I,""id"")=DATA(""instrumentId"") D  QUIT"
^XMB(3.9,146087,2,2685,0)="""RTN"",""YTQRQAD2"",31,0)"
^XMB(3.9,146087,2,2686,0)=" . . ; remove instrument if complete and staff-entered"
^XMB(3.9,146087,2,2687,0)="""RTN"",""YTQRQAD2"",32,0)"
^XMB(3.9,146087,2,2688,0)=" . . I 'PTENT,(CPLT=""Y"") K ^XTMP(NOD,1,""instruments"",I) QUIT"
^XMB(3.9,146087,2,2689,0)="""RTN"",""YTQRQAD2"",33,0)"
^XMB(3.9,146087,2,2690,0)=" . . ;I CPLT=""Y"" K ^XTMP(NOD,1,""instruments"",I) QUIT  ; patient-entered (may need to keep)"
^XMB(3.9,146087,2,2691,0)="""RTN"",""YTQRQAD2"",34,0)"
^XMB(3.9,146087,2,2692,0)=" . . S ^XTMP(NOD,1,""instruments"",I,""adminId"")=ADMIN"
^XMB(3.9,146087,2,2693,0)="""RTN"",""YTQRQAD2"",35,0)"
^XMB(3.9,146087,2,2694,0)=" . . S ^XTMP(NOD,1,""instruments"",I,""complete"")=DATA(""complete"")"
^XMB(3.9,146087,2,2695,0)="""RTN"",""YTQRQAD2"",36,0)"
^XMB(3.9,146087,2,2696,0)=" . . I CPLT'=""Y"" S REMAIN=1"
^XMB(3.9,146087,2,2697,0)="""RTN"",""YTQRQAD2"",37,0)"
^XMB(3.9,146087,2,2698,0)=" . I $G(^XTMP(NOD,1,""instruments"",I,""complete""))'=""true"" S REMAIN=1"
^XMB(3.9,146087,2,2699,0)="""RTN"",""YTQRQAD2"",38,0)"
^XMB(3.9,146087,2,2700,0)=" I PTENT,(LSTASMT=""Yes""),(CPLT=""Y"") D"
^XMB(3.9,146087,2,2701,0)="""RTN"",""YTQRQAD2"",39,0)"
^XMB(3.9,146087,2,2702,0)=" . I $$ALWNOTE^YTQRQAD3(ADMIN)=""true"" D BLDRPT^YTQRRPT(.TMPYS,ADMIN,79)"
^XMB(3.9,146087,2,2703,0)="""RTN"",""YTQRQAD2"",40,0)"
^XMB(3.9,146087,2,2704,0)=" . D SPLTADM^YTQRCAT(ADMIN) ; separate out the admins if CAT"
^XMB(3.9,146087,2,2705,0)="""RTN"",""YTQRQAD2"",41,0)"
^XMB(3.9,146087,2,2706,0)=" S AGPROG=$D(^XTMP(NOD,2))"
^XMB(3.9,146087,2,2707,0)="""RTN"",""YTQRQAD2"",42,0)"
^XMB(3.9,146087,2,2708,0)=" ;I LSTASMT=""Yes"",AGPROG S PNOT=$$FILPNOT^YTQRQAD8(ASMT,"""","""","""",.TMPYS)"
^XMB(3.9,146087,2,2709,0)="""RTN"",""YTQRQAD2"",43,0)"
^XMB(3.9,146087,2,2710,0)=" ;Last instrument=Yes and either saved aggregate progress note or TMPYS from current PE instrument."
^XMB(3.9,146087,2,2711,0)="""RTN"",""YTQRQAD2"",44,0)"
^XMB(3.9,146087,2,2712,0)=" I LSTASMT=""Yes"",(AGPROG!$D(TMPYS)) S PNOT=$$FILPNOT^YTQRQAD8(ASMT,ADMIN,"""","""",.TMPYS)"
^XMB(3.9,146087,2,2713,0)="""RTN"",""YTQRQAD2"",45,0)"
^XMB(3.9,146087,2,2714,0)=" ;Check for consolidated progress note node 2. If exists, ASMT deleted in YTQRQAD8"
^XMB(3.9,146087,2,2715,0)="""RTN"",""YTQRQAD2"",46,0)"
^XMB(3.9,146087,2,2716,0)=" I 'REMAIN,'$D(^XTMP(NOD,2)),$D(^XTMP(NOD,0)) D DELASMT1^YTQRQAD1(ASMT)"
^XMB(3.9,146087,2,2717,0)="""RTN"",""YTQRQAD2"",47,0)"
^XMB(3.9,146087,2,2718,0)=" I YSCERR'=""""  ;need to format return with error message of result save."
^XMB(3.9,146087,2,2719,0)="""RTN"",""YTQRQAD2"",48,0)"
^XMB(3.9,146087,2,2720,0)=" Q ""/api/mha/instrument/admin/""_ADMIN ; was erroneously /ys/mha/admin/"
^XMB(3.9,146087,2,2721,0)="""RTN"",""YTQRQAD2"",49,0)"
^XMB(3.9,146087,2,2722,0)=" ;"
^XMB(3.9,146087,2,2723,0)="""RTN"",""YTQRQAD2"",50,0)"
^XMB(3.9,146087,2,2724,0)="QASAVE(DATA) ; save questions and answers in DATA"
^XMB(3.9,146087,2,2725,0)="""RTN"",""YTQRQAD2"",51,0)"
^XMB(3.9,146087,2,2726,0)=" ; loop through DATA to create ANS array, then YSDATA array"
^XMB(3.9,146087,2,2727,0)="""RTN"",""YTQRQAD2"",52,0)"
^XMB(3.9,146087,2,2728,0)=" ; ANS(#)=questionId^choiceId    <-- radio group question"
^XMB(3.9,146087,2,2729,0)="""RTN"",""YTQRQAD2"",53,0)"
^XMB(3.9,146087,2,2730,0)=" ; ANS(#,#)=wp value             <-- all others"
^XMB(3.9,146087,2,2731,0)="""RTN"",""YTQRQAD2"",54,0)"
^XMB(3.9,146087,2,2732,0)=" N I,QNUM,QANS,QID,VAL,ANS,RT1,ADMIN"
^XMB(3.9,146087,2,2733,0)="""RTN"",""YTQRQAD2"",55,0)"
^XMB(3.9,146087,2,2734,0)=" S QNUM=0,QANS=0"
^XMB(3.9,146087,2,2735,0)="""RTN"",""YTQRQAD2"",56,0)"
^XMB(3.9,146087,2,2736,0)=" S I=0 F  S I=$O(DATA(""answers"",I)) Q:'I  D"
^XMB(3.9,146087,2,2737,0)="""RTN"",""YTQRQAD2"",57,0)"
^XMB(3.9,146087,2,2738,0)=" . S QID=DATA(""answers"",I,""id"")"
^XMB(3.9,146087,2,2739,0)="""RTN"",""YTQRQAD2"",58,0)"
^XMB(3.9,146087,2,2740,0)=" . S VAL=DATA(""answers"",I,""value"")"
^XMB(3.9,146087,2,2741,0)="""RTN"",""YTQRQAD2"",59,0)"
^XMB(3.9,146087,2,2742,0)=" . QUIT:$E(QID)'=""q""   ; skip intros, sections"
^XMB(3.9,146087,2,2743,0)="""RTN"",""YTQRQAD2"",60,0)"
^XMB(3.9,146087,2,2744,0)=" . S QNUM=QNUM+1       ; QNUM is sequence w/o intros"
^XMB(3.9,146087,2,2745,0)="""RTN"",""YTQRQAD2"",61,0)"
^XMB(3.9,146087,2,2746,0)=" . S QID=$E(QID,2,999) ; remove the ""q"""
^XMB(3.9,146087,2,2747,0)="""RTN"",""YTQRQAD2"",62,0)"
^XMB(3.9,146087,2,2748,0)=" . I VAL=""null"" S ANS(QNUM)=QID_U_""NOT ASKED"" QUIT"
^XMB(3.9,146087,2,2749,0)="""RTN"",""YTQRQAD2"",63,0)"
^XMB(3.9,146087,2,2750,0)=" . ; QANS is number answered, don't include skipped (1155 or 1157)"
^XMB(3.9,146087,2,2751,0)="""RTN"",""YTQRQAD2"",64,0)"
^XMB(3.9,146087,2,2752,0)=" . I '((VAL=""c1155"")!(VAL=""c1157"")) S QANS=QANS+1"
^XMB(3.9,146087,2,2753,0)="""RTN"",""YTQRQAD2"",65,0)"
^XMB(3.9,146087,2,2754,0)=" . S RT1=0             ; response type 1 is choice question"
^XMB(3.9,146087,2,2755,0)="""RTN"",""YTQRQAD2"",66,0)"
^XMB(3.9,146087,2,2756,0)=" . I VAL=""c1155""!(VAL=""c1156"")!(VAL=""c1157"") S RT1=1"
^XMB(3.9,146087,2,2757,0)="""RTN"",""YTQRQAD2"",67,0)"
^XMB(3.9,146087,2,2758,0)=" . I $P($G(^YTT(601.72,QID,2)),U,2)=1 S RT1=1"
^XMB(3.9,146087,2,2759,0)="""RTN"",""YTQRQAD2"",68,0)"
^XMB(3.9,146087,2,2760,0)=" . I RT1 S ANS(QNUM)=QID_U_$E(VAL,2,999) QUIT"
^XMB(3.9,146087,2,2761,0)="""RTN"",""YTQRQAD2"",69,0)"
^XMB(3.9,146087,2,2762,0)=" . S ANS(QNUM)=QID D TXT2ANS(I,QNUM) ; handle longer WP values"
^XMB(3.9,146087,2,2763,0)="""RTN"",""YTQRQAD2"",70,0)"
^XMB(3.9,146087,2,2764,0)=" K DATA(""answers"") ; now in ANS array (which may be large)"
^XMB(3.9,146087,2,2765,0)="""RTN"",""YTQRQAD2"",71,0)"
^XMB(3.9,146087,2,2766,0)=" ; save admin itself"
^XMB(3.9,146087,2,2767,0)="""RTN"",""YTQRQAD2"",72,0)"
^XMB(3.9,146087,2,2768,0)=" S ADMIN=$$SETADM(.DATA,QANS)"
^XMB(3.9,146087,2,2769,0)="""RTN"",""YTQRQAD2"",73,0)"
^XMB(3.9,146087,2,2770,0)=" Q:'ADMIN """""
^XMB(3.9,146087,2,2771,0)="""RTN"",""YTQRQAD2"",74,0)"
^XMB(3.9,146087,2,2772,0)=" ; save the answers"
^XMB(3.9,146087,2,2773,0)="""RTN"",""YTQRQAD2"",75,0)"
^XMB(3.9,146087,2,2774,0)=" N YSDATA"
^XMB(3.9,146087,2,2775,0)="""RTN"",""YTQRQAD2"",76,0)"
^XMB(3.9,146087,2,2776,0)=" S ANS(""AD"")=ADMIN"
^XMB(3.9,146087,2,2777,0)="""RTN"",""YTQRQAD2"",77,0)"
^XMB(3.9,146087,2,2778,0)=" D SAVEALL^YTQAPI17(.YSDATA,.ANS)"
^XMB(3.9,146087,2,2779,0)="""RTN"",""YTQRQAD2"",78,0)"
^XMB(3.9,146087,2,2780,0)=" I YSDATA(1)'=""[DATA]"" D SETERROR^YTQRUTL(500,""Answers not saved"") Q """""
^XMB(3.9,146087,2,2781,0)="""RTN"",""YTQRQAD2"",79,0)"
^XMB(3.9,146087,2,2782,0)=" Q ADMIN"
^XMB(3.9,146087,2,2783,0)="""RTN"",""YTQRQAD2"",80,0)"
^XMB(3.9,146087,2,2784,0)=" ;"
^XMB(3.9,146087,2,2785,0)="""RTN"",""YTQRQAD2"",81,0)"
^XMB(3.9,146087,2,2786,0)="SETADM(DATA,NUM) ; return the id for new/updated admin"
^XMB(3.9,146087,2,2787,0)="""RTN"",""YTQRQAD2"",82,0)"
^XMB(3.9,146087,2,2788,0)=" N YSDATA,YS,NODE,ADMIN,ADMINDT,ASMTID,YSERR"
^XMB(3.9,146087,2,2789,0)="""RTN"",""YTQRQAD2"",83,0)"
^XMB(3.9,146087,2,2790,0)=" S ASMTID=DATA(""assignmentId"")"
^XMB(3.9,146087,2,2791,0)="""RTN"",""YTQRQAD2"",84,0)"
^XMB(3.9,146087,2,2792,0)=" S NODE=$S(ASMTID?36ANP:""YTQCPRS-"",1:""YTQASMT-SET-"")_ASMTID"
^XMB(3.9,146087,2,2793,0)="""RTN"",""YTQRQAD2"",85,0)"
^XMB(3.9,146087,2,2794,0)=" S ADMIN=+$G(DATA(""adminId""))"
^XMB(3.9,146087,2,2795,0)="""RTN"",""YTQRQAD2"",86,0)"
^XMB(3.9,146087,2,2796,0)=" I '$D(^XTMP(NODE)) D  QUIT 0"
^XMB(3.9,146087,2,2797,0)="""RTN"",""YTQRQAD2"",87,0)"
^XMB(3.9,146087,2,2798,0)=" . S YSERR=""Unable to create admin."""
^XMB(3.9,146087,2,2799,0)="""RTN"",""YTQRQAD2"",88,0)"
^XMB(3.9,146087,2,2800,0)=" . I ADMIN,$P($G(^YTT(601.84,ADMIN,0)),U,9)=""Y"" S YSERR=YSERR_"" Admin was already saved."" I 1"
^XMB(3.9,146087,2,2801,0)="""RTN"",""YTQRQAD2"",89,0)"
^XMB(3.9,146087,2,2802,0)=" . E  S YSERR=YSERR_"" (Scratch assignment was missing)."""
^XMB(3.9,146087,2,2803,0)="""RTN"",""YTQRQAD2"",90,0)"
^XMB(3.9,146087,2,2804,0)=" . D SETERROR^YTQRUTL(500,YSERR)"
^XMB(3.9,146087,2,2805,0)="""RTN"",""YTQRQAD2"",91,0)"
^XMB(3.9,146087,2,2806,0)=" I 'ADMIN S ADMIN=$$ADM4ASMT(NODE,DATA(""instrumentId"")) ; auto-save fix"
^XMB(3.9,146087,2,2807,0)="""RTN"",""YTQRQAD2"",92,0)"
^XMB(3.9,146087,2,2808,0)=" ;Admin Date added so user can select previous date, time is arbitrary based on current MHA standard"
^XMB(3.9,146087,2,2809,0)="""RTN"",""YTQRQAD2"",93,0)"
^XMB(3.9,146087,2,2810,0)=" S ADMINDT=$G(^XTMP(NODE,1,""adminDate"")) I ADMINDT]"""" S ADMINDT=$$ETFM(ADMINDT) S:ADMINDT ADMINDT=ADMINDT_"".""_$P($$NOW^XLFDT(),""."",2)"
^XMB(3.9,146087,2,2811,0)="""RTN"",""YTQRQAD2"",94,0)"
^XMB(3.9,146087,2,2812,0)=" S YS(""FILEN"")=601.84"
^XMB(3.9,146087,2,2813,0)="""RTN"",""YTQRQAD2"",95,0)"
^XMB(3.9,146087,2,2814,0)=" I ADMIN S YS(""IEN"")=ADMIN I 1"
^XMB(3.9,146087,2,2815,0)="""RTN"",""YTQRQAD2"",96,0)"
^XMB(3.9,146087,2,2816,0)=" E  S YS(1)="".01^NEW^1"""
^XMB(3.9,146087,2,2817,0)="""RTN"",""YTQRQAD2"",97,0)"
^XMB(3.9,146087,2,2818,0)=" S YS(2)=""1^`""_$G(^XTMP(NODE,1,""patient"",""dfn""))"
^XMB(3.9,146087,2,2819,0)="""RTN"",""YTQRQAD2"",98,0)"
^XMB(3.9,146087,2,2820,0)=" S YS(3)=""2^`""_DATA(""instrumentId"")"
^XMB(3.9,146087,2,2821,0)="""RTN"",""YTQRQAD2"",99,0)"
^XMB(3.9,146087,2,2822,0)=" S YS(4)=""3^""_$S(ADMINDT]"""":ADMINDT,1:$G(^XTMP(NODE,1,""date"")))"
^XMB(3.9,146087,2,2823,0)="""RTN"",""YTQRQAD2"",100,0)"
^XMB(3.9,146087,2,2824,0)=" ;S YS(4)=""3^""_$G(^XTMP(NODE,1,""date""))"
^XMB(3.9,146087,2,2825,0)="""RTN"",""YTQRQAD2"",101,0)"
^XMB(3.9,146087,2,2826,0)=" S YS(5)=""4^NOW"""
^XMB(3.9,146087,2,2827,0)="""RTN"",""YTQRQAD2"",102,0)"
^XMB(3.9,146087,2,2828,0)=" S YS(6)=""5^`""_$G(^XTMP(NODE,1,""orderedBy""))"
^XMB(3.9,146087,2,2829,0)="""RTN"",""YTQRQAD2"",103,0)"
^XMB(3.9,146087,2,2830,0)=" S YS(7)=""6^`""_$G(^XTMP(NODE,1,""interview""))"
^XMB(3.9,146087,2,2831,0)="""RTN"",""YTQRQAD2"",104,0)"
^XMB(3.9,146087,2,2832,0)=" S YS(8)=""7^N"""
^XMB(3.9,146087,2,2833,0)="""RTN"",""YTQRQAD2"",105,0)"
^XMB(3.9,146087,2,2834,0)=" S YS(9)=""8^""_$S(DATA(""complete"")=""true"":""YES"",1:""NO"")"
^XMB(3.9,146087,2,2835,0)="""RTN"",""YTQRQAD2"",106,0)"
^XMB(3.9,146087,2,2836,0)=" S YS(10)=""9^""_NUM"
^XMB(3.9,146087,2,2837,0)="""RTN"",""YTQRQAD2"",107,0)"
^XMB(3.9,146087,2,2838,0)=" S YS(11)=""13^`""_$G(^XTMP(NODE,1,""location""))"
^XMB(3.9,146087,2,2839,0)="""RTN"",""YTQRQAD2"",108,0)"
^XMB(3.9,146087,2,2840,0)=" I '$L($G(DATA(""source""))) S DATA(""source"")=""web"""
^XMB(3.9,146087,2,2841,0)="""RTN"",""YTQRQAD2"",109,0)"
^XMB(3.9,146087,2,2842,0)=" S YS(12)=""15^""_DATA(""source"")"
^XMB(3.9,146087,2,2843,0)="""RTN"",""YTQRQAD2"",110,0)"
^XMB(3.9,146087,2,2844,0)=" I $D(^XTMP(NODE,1,""consult"")),($G(^XTMP(NODE,1,""consult""))]"""") S YS(13)=""17^""_^XTMP(NODE,1,""consult"")"
^XMB(3.9,146087,2,2845,0)="""RTN"",""YTQRQAD2"",111,0)"
^XMB(3.9,146087,2,2846,0)=" D ADMSAVE^YTQAPI1(.YSDATA,.YS)"
^XMB(3.9,146087,2,2847,0)="""RTN"",""YTQRQAD2"",112,0)"
^XMB(3.9,146087,2,2848,0)=" I YSDATA(1)'=""[DATA]"" D SETERROR^YTQRUTL(500,""Unable to create admin"") Q 0"
^XMB(3.9,146087,2,2849,0)="""RTN"",""YTQRQAD2"",113,0)"
^XMB(3.9,146087,2,2850,0)=" I 'ADMIN Q $P(YSDATA(2),U,2)  ; create new admin, ien found in 2nd piece"
^XMB(3.9,146087,2,2851,0)="""RTN"",""YTQRQAD2"",114,0)"
^XMB(3.9,146087,2,2852,0)=" Q ADMIN                       ; otherwise we're updating existing admin"
^XMB(3.9,146087,2,2853,0)="""RTN"",""YTQRQAD2"",115,0)"
^XMB(3.9,146087,2,2854,0)=" ;"
^XMB(3.9,146087,2,2855,0)="""RTN"",""YTQRQAD2"",116,0)"
^XMB(3.9,146087,2,2856,0)="ETFM(YSDT) ;External to FM"
^XMB(3.9,146087,2,2857,0)="""RTN"",""YTQRQAD2"",117,0)"
^XMB(3.9,146087,2,2858,0)=" ;YSDT = DATE in external"
^XMB(3.9,146087,2,2859,0)="""RTN"",""YTQRQAD2"",118,0)"
^XMB(3.9,146087,2,2860,0)=" N X,Y"
^XMB(3.9,146087,2,2861,0)="""RTN"",""YTQRQAD2"",119,0)"
^XMB(3.9,146087,2,2862,0)=" I YSDT[""@"" S YSDT=$P(YSDT,""@"")"
^XMB(3.9,146087,2,2863,0)="""RTN"",""YTQRQAD2"",120,0)"
^XMB(3.9,146087,2,2864,0)=" S X=YSDT D ^%DT"
^XMB(3.9,146087,2,2865,0)="""RTN"",""YTQRQAD2"",121,0)"
^XMB(3.9,146087,2,2866,0)=" I Y<0 S Y=""""  ;Invalid YSDT"
^XMB(3.9,146087,2,2867,0)="""RTN"",""YTQRQAD2"",122,0)"
^XMB(3.9,146087,2,2868,0)=" Q Y"
^XMB(3.9,146087,2,2869,0)="""RTN"",""YTQRQAD2"",123,0)"
^XMB(3.9,146087,2,2870,0)="ADM4ASMT(NODE,TESTID) ; return adminId if one has been saved for assignment"
^XMB(3.9,146087,2,2871,0)="""RTN"",""YTQRQAD2"",124,0)"
^XMB(3.9,146087,2,2872,0)=" N I,CURADM"
^XMB(3.9,146087,2,2873,0)="""RTN"",""YTQRQAD2"",125,0)"
^XMB(3.9,146087,2,2874,0)=" S CURADM=0"
^XMB(3.9,146087,2,2875,0)="""RTN"",""YTQRQAD2"",126,0)"
^XMB(3.9,146087,2,2876,0)=" S I=0 F  S I=$O(^XTMP(NODE,1,""instruments"",I)) Q:'I  D  Q:CURADM"
^XMB(3.9,146087,2,2877,0)="""RTN"",""YTQRQAD2"",127,0)"
^XMB(3.9,146087,2,2878,0)=" . I $G(^XTMP(NODE,1,""instruments"",I,""id""))'=TESTID Q"
^XMB(3.9,146087,2,2879,0)="""RTN"",""YTQRQAD2"",128,0)"
^XMB(3.9,146087,2,2880,0)=" . I $G(^XTMP(NODE,1,""instruments"",I,""adminId""))>0 S CURADM=^XTMP(NODE,1,""instruments"",I,""adminId"")"
^XMB(3.9,146087,2,2881,0)="""RTN"",""YTQRQAD2"",129,0)"
^XMB(3.9,146087,2,2882,0)=" I $L(CURADM,""-"")>0 S CURADM=0  ; only ""real"" admins, not UUID's"
^XMB(3.9,146087,2,2883,0)="""RTN"",""YTQRQAD2"",130,0)"
^XMB(3.9,146087,2,2884,0)=" Q CURADM"
^XMB(3.9,146087,2,2885,0)="""RTN"",""YTQRQAD2"",131,0)"
^XMB(3.9,146087,2,2886,0)=" ;"
^XMB(3.9,146087,2,2887,0)="""RTN"",""YTQRQAD2"",132,0)"
^XMB(3.9,146087,2,2888,0)="GETADM(ARGS,RESULTS) ; get answers for administration identified by ARGS(""adminId"")"
^XMB(3.9,146087,2,2889,0)="""RTN"",""YTQRQAD2"",133,0)"
^XMB(3.9,146087,2,2890,0)=" I '$L($G(ARGS(""adminId""))) D SETERROR^YTQRUTL(404,""Missing admin parameter"") Q"
^XMB(3.9,146087,2,2891,0)="""RTN"",""YTQRQAD2"",134,0)"
^XMB(3.9,146087,2,2892,0)=" I ARGS(""adminId"")?36ANP1""-"".N G GETADM^YTQRCRW"
^XMB(3.9,146087,2,2893,0)="""RTN"",""YTQRQAD2"",135,0)"
^XMB(3.9,146087,2,2894,0)=" I $D(^YTT(601.84,ARGS(""adminId"")))<10 D  Q"
^XMB(3.9,146087,2,2895,0)="""RTN"",""YTQRQAD2"",136,0)"
^XMB(3.9,146087,2,2896,0)=" . D SETERROR^YTQRUTL(404,""Admin not found: ""_ARGS(""adminId""))"
^XMB(3.9,146087,2,2897,0)="""RTN"",""YTQRQAD2"",137,0)"
^XMB(3.9,146087,2,2898,0)=" ;"
^XMB(3.9,146087,2,2899,0)="""RTN"",""YTQRQAD2"",138,0)"
^XMB(3.9,146087,2,2900,0)=" N ADMIN,X0,TST,QID,ANS,CTNT,SEQ,TYP,VAL,TOT,NA,TMP,I,J,N,L"
^XMB(3.9,146087,2,2901,0)="""RTN"",""YTQRQAD2"",139,0)"
^XMB(3.9,146087,2,2902,0)=" S ADMIN=ARGS(""adminId""),X0=^YTT(601.84,ADMIN,0),TST=$P(X0,U,3)"
^XMB(3.9,146087,2,2903,0)="""RTN"",""YTQRQAD2"",140,0)"
^XMB(3.9,146087,2,2904,0)=" S RESULTS(""adminId"")=ADMIN"
^XMB(3.9,146087,2,2905,0)="""RTN"",""YTQRQAD2"",141,0)"
^XMB(3.9,146087,2,2906,0)=" S RESULTS(""complete"")=$S($P(X0,U,9)=""Y"":""true"",1:""false"")"
^XMB(3.9,146087,2,2907,0)="""RTN"",""YTQRQAD2"",142,0)"
^XMB(3.9,146087,2,2908,0)=" S RESULTS(""instrumentId"")=TST"
^XMB(3.9,146087,2,2909,0)="""RTN"",""YTQRQAD2"",143,0)"
^XMB(3.9,146087,2,2910,0)=" ; iterate through answers to get values and sort by sequence"
^XMB(3.9,146087,2,2911,0)="""RTN"",""YTQRQAD2"",144,0)"
^XMB(3.9,146087,2,2912,0)=" S (TOT,NA)=0  ; total questions & not answered count"
^XMB(3.9,146087,2,2913,0)="""RTN"",""YTQRQAD2"",145,0)"
^XMB(3.9,146087,2,2914,0)=" S QID=0 F  S QID=$O(^YTT(601.85,""AC"",ADMIN,QID)) Q:'QID  D"
^XMB(3.9,146087,2,2915,0)="""RTN"",""YTQRQAD2"",146,0)"
^XMB(3.9,146087,2,2916,0)=" . S CTNT=$O(^YTT(601.76,""AF"",TST,QID,0))"
^XMB(3.9,146087,2,2917,0)="""RTN"",""YTQRQAD2"",147,0)"
^XMB(3.9,146087,2,2918,0)=" . S SEQ=$P($G(^YTT(601.76,+CTNT,0)),U,3) S:'SEQ SEQ=1"
^XMB(3.9,146087,2,2919,0)="""RTN"",""YTQRQAD2"",148,0)"
^XMB(3.9,146087,2,2920,0)=" . S TYP=+$P($G(^YTT(601.72,QID,2)),U,2)"
^XMB(3.9,146087,2,2921,0)="""RTN"",""YTQRQAD2"",149,0)"
^XMB(3.9,146087,2,2922,0)=" . S ANS=0 F  S ANS=$O(^YTT(601.85,""AC"",ADMIN,QID,ANS)) Q:'ANS  D"
^XMB(3.9,146087,2,2923,0)="""RTN"",""YTQRQAD2"",150,0)"
^XMB(3.9,146087,2,2924,0)=" . . S VAL=$P(^YTT(601.85,ANS,0),U,4),TOT=TOT+1"
^XMB(3.9,146087,2,2925,0)="""RTN"",""YTQRQAD2"",151,0)"
^XMB(3.9,146087,2,2926,0)=" . . I VAL=""NOT ASKED""!(VAL=1155)!(VAL=1157) S NA=NA+1  ; skipped=not answered"
^XMB(3.9,146087,2,2927,0)="""RTN"",""YTQRQAD2"",152,0)"
^XMB(3.9,146087,2,2928,0)=" . . I VAL=""NOT ASKED"" S TMP(+SEQ)=QID_U_""null"" QUIT    ; not asked"
^XMB(3.9,146087,2,2929,0)="""RTN"",""YTQRQAD2"",153,0)"
^XMB(3.9,146087,2,2930,0)=" . . I VAL=1155!(VAL=1156)!(VAL=1157) S TYP=1           ; skipped values"
^XMB(3.9,146087,2,2931,0)="""RTN"",""YTQRQAD2"",154,0)"
^XMB(3.9,146087,2,2932,0)=" . . I TYP=1 S TMP(+SEQ)=QID_U_""c""_VAL QUIT             ; mult choice"
^XMB(3.9,146087,2,2933,0)="""RTN"",""YTQRQAD2"",155,0)"
^XMB(3.9,146087,2,2934,0)=" . . S VAL=$G(^YTT(601.85,ANS,1,1,0))                   ; integer, etc."
^XMB(3.9,146087,2,2935,0)="""RTN"",""YTQRQAD2"",156,0)"
^XMB(3.9,146087,2,2936,0)=" . . I TYP'=5,(TYP'=11) S TMP(+SEQ)=QID_U_VAL QUIT"
^XMB(3.9,146087,2,2937,0)="""RTN"",""YTQRQAD2"",157,0)"
^XMB(3.9,146087,2,2938,0)=" . . S (N,L)=0 F  S N=$O(^YTT(601.85,ANS,1,N)) Q:'N  D  ; memo and checkbox fields"
^XMB(3.9,146087,2,2939,0)="""RTN"",""YTQRQAD2"",158,0)"
^XMB(3.9,146087,2,2940,0)=" . . . S VAL=$G(^YTT(601.85,ANS,1,N,0))"
^XMB(3.9,146087,2,2941,0)="""RTN"",""YTQRQAD2"",159,0)"
^XMB(3.9,146087,2,2942,0)=" . . . I '$D(TMP(+SEQ)) S TMP(+SEQ)=QID_U_$TR(VAL,""|"",$C(10)) I 1"
^XMB(3.9,146087,2,2943,0)="""RTN"",""YTQRQAD2"",160,0)"
^XMB(3.9,146087,2,2944,0)=" . . . E  S L=L+1,TMP(+SEQ,L)=$TR(VAL,""|"",$C(10))"
^XMB(3.9,146087,2,2945,0)="""RTN"",""YTQRQAD2"",161,0)"
^XMB(3.9,146087,2,2946,0)=" N CATPROG S CATPROG=$$CHKPROG^YTQRCAT(ADMIN)"
^XMB(3.9,146087,2,2947,0)="""RTN"",""YTQRQAD2"",162,0)"
^XMB(3.9,146087,2,2948,0)=" I CATPROG>-1 S RESULTS(""progress"")=CATPROG I 1"
^XMB(3.9,146087,2,2949,0)="""RTN"",""YTQRQAD2"",163,0)"
^XMB(3.9,146087,2,2950,0)=" E  S RESULTS(""progress"")=$S(TOT>0:$P((((TOT-NA)/TOT)*100)+.5,"".""),1:0)"
^XMB(3.9,146087,2,2951,0)="""RTN"",""YTQRQAD2"",164,0)"
^XMB(3.9,146087,2,2952,0)=" ; now move sorted responses from TMP into ""answers"" nodes"
^XMB(3.9,146087,2,2953,0)="""RTN"",""YTQRQAD2"",165,0)"
^XMB(3.9,146087,2,2954,0)=" S I="""",N=0 F  S I=$O(TMP(I)) Q:'$L(I)  S N=N+1 D"
^XMB(3.9,146087,2,2955,0)="""RTN"",""YTQRQAD2"",166,0)"
^XMB(3.9,146087,2,2956,0)=" . S RESULTS(""answers"",N,""id"")=""q""_$P(TMP(I),U)"
^XMB(3.9,146087,2,2957,0)="""RTN"",""YTQRQAD2"",167,0)"
^XMB(3.9,146087,2,2958,0)=" . S RESULTS(""answers"",N,""value"")=$P(TMP(I),U,2,999)"
^XMB(3.9,146087,2,2959,0)="""RTN"",""YTQRQAD2"",168,0)"
^XMB(3.9,146087,2,2960,0)=" . I $D(TMP(I))>9 S J="""",L=0 F  S J=$O(TMP(I,J)) Q:'$L(J)  S L=L+1 D"
^XMB(3.9,146087,2,2961,0)="""RTN"",""YTQRQAD2"",169,0)"
^XMB(3.9,146087,2,2962,0)=" . . S RESULTS(""answers"",N,""value"",""\"",L)=TMP(I,J)"
^XMB(3.9,146087,2,2963,0)="""RTN"",""YTQRQAD2"",170,0)"
^XMB(3.9,146087,2,2964,0)=" Q"
^XMB(3.9,146087,2,2965,0)="""RTN"",""YTQRQAD2"",171,0)"
^XMB(3.9,146087,2,2966,0)="TXT2ANS(IDX,QNUM) ; Convert web to ANS format for DATA(IDX)"
^XMB(3.9,146087,2,2967,0)="""RTN"",""YTQRQAD2"",172,0)"
^XMB(3.9,146087,2,2968,0)=" ; expects DATA,ANS"
^XMB(3.9,146087,2,2969,0)="""RTN"",""YTQRQAD2"",173,0)"
^XMB(3.9,146087,2,2970,0)=" N LEN,LN,NODE,J"
^XMB(3.9,146087,2,2971,0)="""RTN"",""YTQRQAD2"",174,0)"
^XMB(3.9,146087,2,2972,0)=" S LEN=240,LN=0"
^XMB(3.9,146087,2,2973,0)="""RTN"",""YTQRQAD2"",175,0)"
^XMB(3.9,146087,2,2974,0)=" S NODE=DATA(""answers"",IDX,""value"")"
^XMB(3.9,146087,2,2975,0)="""RTN"",""YTQRQAD2"",176,0)"
^XMB(3.9,146087,2,2976,0)=" D ADDSEGS(NODE)"
^XMB(3.9,146087,2,2977,0)="""RTN"",""YTQRQAD2"",177,0)"
^XMB(3.9,146087,2,2978,0)=" I $D(DATA(""answers"",IDX,""value"",""\"")) D"
^XMB(3.9,146087,2,2979,0)="""RTN"",""YTQRQAD2"",178,0)"
^XMB(3.9,146087,2,2980,0)=" . F J=1:1 Q:'$D(DATA(""answers"",IDX,""value"",""\"",J))  D"
^XMB(3.9,146087,2,2981,0)="""RTN"",""YTQRQAD2"",179,0)"
^XMB(3.9,146087,2,2982,0)=" . . S NODE=DATA(""answers"",IDX,""value"",""\"",J)"
^XMB(3.9,146087,2,2983,0)="""RTN"",""YTQRQAD2"",180,0)"
^XMB(3.9,146087,2,2984,0)=" . . D ADDSEGS(NODE)"
^XMB(3.9,146087,2,2985,0)="""RTN"",""YTQRQAD2"",181,0)"
^XMB(3.9,146087,2,2986,0)=" Q"
^XMB(3.9,146087,2,2987,0)="""RTN"",""YTQRQAD2"",182,0)"
^XMB(3.9,146087,2,2988,0)="ADDSEGS(NODE) ; split text in node into LEN segments with ""|"" for newlines"
^XMB(3.9,146087,2,2989,0)="""RTN"",""YTQRQAD2"",183,0)"
^XMB(3.9,146087,2,2990,0)=" ; expects DATA,ANS,LEN,LN"
^XMB(3.9,146087,2,2991,0)="""RTN"",""YTQRQAD2"",184,0)"
^XMB(3.9,146087,2,2992,0)=" N I,X,END,FIRST,LAST"
^XMB(3.9,146087,2,2993,0)="""RTN"",""YTQRQAD2"",185,0)"
^XMB(3.9,146087,2,2994,0)=" S END=$L(NODE),LAST=0 F I=0:1 D  Q:LAST>END   ; iterate thru each segment"
^XMB(3.9,146087,2,2995,0)="""RTN"",""YTQRQAD2"",186,0)"
^XMB(3.9,146087,2,2996,0)=" . S FIRST=(I*LEN)+1,LAST=(I*LEN)+LEN,LN=LN+1  ; set first&last char positions"
^XMB(3.9,146087,2,2997,0)="""RTN"",""YTQRQAD2"",187,0)"
^XMB(3.9,146087,2,2998,0)=" . S X=$TR($E(NODE,FIRST,LAST),$C(10),""|"")     ; set segment, chg newline to |"
^XMB(3.9,146087,2,2999,0)="""RTN"",""YTQRQAD2"",188,0)"
^XMB(3.9,146087,2,3000,0)=" . S ANS(QNUM,LN)=X"
^XMB(3.9,146087,2,3001,0)="""RTN"",""YTQRQAD2"",189,0)"
^XMB(3.9,146087,2,3002,0)=" Q"
^XMB(3.9,146087,2,3003,0)="""RTN"",""YTQRQAD2"",190,0)"
^XMB(3.9,146087,2,3004,0)="GETCHKS(ARGS,RESULTS) ; verify answer string & return check messages if needed"
^XMB(3.9,146087,2,3005,0)="""RTN"",""YTQRQAD2"",191,0)"
^XMB(3.9,146087,2,3006,0)=" ;ARGS(""q6440"")=""c2420""      -- may be choice id"
^XMB(3.9,146087,2,3007,0)="""RTN"",""YTQRQAD2"",192,0)"
^XMB(3.9,146087,2,3008,0)=" ;ARGS(""q6439"")=""08/07/2019"" -- or literal"
^XMB(3.9,146087,2,3009,0)="""RTN"",""YTQRQAD2"",193,0)"
^XMB(3.9,146087,2,3010,0)=" S RESULTS(""count"")=0"
^XMB(3.9,146087,2,3011,0)="""RTN"",""YTQRQAD2"",194,0)"
^XMB(3.9,146087,2,3012,0)=" I ARGS(""instrumentName"")=""BAM-C"" D VERIFY^YTSBAMC(.ARGS,.RESULTS)"
^XMB(3.9,146087,2,3013,0)="""RTN"",""YTQRQAD2"",195,0)"
^XMB(3.9,146087,2,3014,0)=" I ARGS(""instrumentName"")=""BAM-R"" D VERIFY^YTSBAMR(.ARGS,.RESULTS)"
^XMB(3.9,146087,2,3015,0)="""RTN"",""YTQRQAD2"",196,0)"
^XMB(3.9,146087,2,3016,0)=" I ARGS(""instrumentName"")=""BAM-IOP"" D VERIFY^YTSBAMI(.ARGS,.RESULTS)"
^XMB(3.9,146087,2,3017,0)="""RTN"",""YTQRQAD2"",197,0)"
^XMB(3.9,146087,2,3018,0)=" I ARGS(""instrumentName"")=""BAM-C-CBT-SUD"" D VERIFY^YTSBAMCC(.ARGS,.RESULTS)"
^XMB(3.9,146087,2,3019,0)="""RTN"",""YTQRQAD2"",198,0)"
^XMB(3.9,146087,2,3020,0)=" I ARGS(""instrumentName"")=""BAM-R-CSG-SUD"" D VERIFY^YTSBAMRC(.ARGS,.RESULTS)"
