^XMB(3.9,146011,2,670,0)=" D ULP"
^XMB(3.9,146011,2,671,0)="""RTN"",""PSOHLD"",111,0)"
^XMB(3.9,146011,2,672,0)="EX D PSOUL^PSSLOCK($P(PSOLST(ORN),""^"",2)) D ^PSOBUILD"
^XMB(3.9,146011,2,673,0)="""RTN"",""PSOHLD"",112,0)"
^XMB(3.9,146011,2,674,0)=" K PSOHRL,PSOMSG,PSOPLCK,ST,PSL,PSNP,IR,NOW,DR,NEW1,NEW11,RTN,DA,PPL,RXN,RX0,RXS,DIK,RXP,FLD,ACT,DIE,DIC,DIR,DIE,X,Y,DIRUT,DUOUT,SUSPT,C,D0,LFD,I,RFDATE,DI,DQ,%,RFN,XFLAG"
^XMB(3.9,146011,2,675,0)="""RTN"",""PSOHLD"",113,0)"
^XMB(3.9,146011,2,676,0)=" K HRX,PSHLD,PSOLIST,PSORX(""FILL DATE""),STA,QTY,RFDT,PSORX0,PSRXN,RXF,JJ,PSOTOPK Q"
^XMB(3.9,146011,2,677,0)="""RTN"",""PSOHLD"",114,0)"
^XMB(3.9,146011,2,678,0)=" ;"
^XMB(3.9,146011,2,679,0)="""RTN"",""PSOHLD"",115,0)"
^XMB(3.9,146011,2,680,0)="HLD ;"
^XMB(3.9,146011,2,681,0)="""RTN"",""PSOHLD"",116,0)"
^XMB(3.9,146011,2,682,0)=" I $G(PSOBEDT) W $C(7),$C(7) S VALMSG=""Invalid Action at this time !"",VALMBCK="""" Q"
^XMB(3.9,146011,2,683,0)="""RTN"",""PSOHLD"",117,0)"
