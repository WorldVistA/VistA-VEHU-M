^XMB(3.9,146018,2,680,0)=" F DGVAL="".111;.1151"","".1112;.1156"","".112;.1152"","".113;.1153"","".114;.1154"","".115;.1155"","".117;.1157"","".1171;.11571"","".1172;.11572"","".1173;.11573""  D"
