^XMB(3.9,146015,2,304,0)=" .S X=$P(WT,""^"",8),Y=$J(X/2.2046226,0,2),$P(WT,""^"",9)=Y,X=$P(HT,""^"",8),Y=$J(2.54*X,0,2),$P(HT,""^"",9)=Y"
