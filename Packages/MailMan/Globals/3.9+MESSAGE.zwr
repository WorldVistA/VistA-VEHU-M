^XMB(3.9,146011,2,883,0)="""RTN"",""PSOPRKA"",6,0)"
^XMB(3.9,146011,2,884,0)=" ;NOTE for PaPI - check on ECME calls like in the PSOHLD* routines (e.g. reverse"
^XMB(3.9,146011,2,885,0)="""RTN"",""PSOPRKA"",7,0)"
^XMB(3.9,146011,2,886,0)=" ; below may need another code besides ""HLD"" for parking)"
