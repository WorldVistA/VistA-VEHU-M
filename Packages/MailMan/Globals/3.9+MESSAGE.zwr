^XMB(3.9,146085,2,275,0)="""RTN"")"
^XMB(3.9,146085,2,276,0)=1
^XMB(3.9,146085,2,277,0)="""RTN"",""XDRMERGB"")"
^XMB(3.9,146085,2,278,0)="0^1^B79750683"
^XMB(3.9,146085,2,279,0)="""RTN"",""XDRMERGB"",1,0)"
^XMB(3.9,146085,2,280,0)="XDRMERGB ;SF-IRMFO.SEA/JLI - TENATIVE UPDATE POINTER NODES ;5/14/98  10:30"
^XMB(3.9,146085,2,281,0)="""RTN"",""XDRMERGB"",2,0)"
^XMB(3.9,146085,2,282,0)=" ;;7.3;TOOLKIT;**23,137**;Apr 25, 1995;Build 0"
^XMB(3.9,146085,2,283,0)="""RTN"",""XDRMERGB"",3,0)"
^XMB(3.9,146085,2,284,0)=" ;;"
^XMB(3.9,146085,2,285,0)="""RTN"",""XDRMERGB"",4,0)"
^XMB(3.9,146085,2,286,0)=" Q"
^XMB(3.9,146085,2,287,0)="""RTN"",""XDRMERGB"",5,0)"
^XMB(3.9,146085,2,288,0)=" ;"
^XMB(3.9,146085,2,289,0)="""RTN"",""XDRMERGB"",6,0)"
^XMB(3.9,146085,2,290,0)="MERGEIT ; MERGE TWO ENTRIES IN FILE"
^XMB(3.9,146085,2,291,0)="""RTN"",""XDRMERGB"",7,0)"
^XMB(3.9,146085,2,292,0)=" N NODE,NODE1,NODE2,NODEA,SFILE,XDRFROM,XDRTO,NODEA,VALUE,XVALUE,XDRXX,NODEB,DIK,DA,I,Y,VREF,XNN,XFILNO,IENTOSTR,DFN,XDRZZ"
^XMB(3.9,146085,2,293,0)="""RTN"",""XDRMERGB"",8,0)"
^XMB(3.9,146085,2,294,0)=" N XDRAA ; DEBUG STATEMENT"
^XMB(3.9,146085,2,295,0)="""RTN"",""XDRMERGB"",9,0)"
^XMB(3.9,146085,2,296,0)=" ;"
^XMB(3.9,146085,2,297,0)="""RTN"",""XDRMERGB"",10,0)"
^XMB(3.9,146085,2,298,0)=" S XFILNO=+$P(@(XDRDIC_""0)""),U,2)"
^XMB(3.9,146085,2,299,0)="""RTN"",""XDRMERGB"",11,0)"
^XMB(3.9,146085,2,300,0)=" S IENTOSTR=IENTO_"",""_XDRIENS"
^XMB(3.9,146085,2,301,0)="""RTN"",""XDRMERGB"",12,0)"
^XMB(3.9,146085,2,302,0)=" S DFN=IENTO"
^XMB(3.9,146085,2,303,0)="""RTN"",""XDRMERGB"",13,0)"
^XMB(3.9,146085,2,304,0)=" ;"
^XMB(3.9,146085,2,305,0)="""RTN"",""XDRMERGB"",14,0)"
^XMB(3.9,146085,2,306,0)=" ; NOW MERGE DATA GOING NODE BY NODE"
^XMB(3.9,146085,2,307,0)="""RTN"",""XDRMERGB"",15,0)"
^XMB(3.9,146085,2,308,0)=" ;"
^XMB(3.9,146085,2,309,0)="""RTN"",""XDRMERGB"",16,0)"
^XMB(3.9,146085,2,310,0)=" S NODE="""""
^XMB(3.9,146085,2,311,0)="""RTN"",""XDRMERGB"",17,0)"
^XMB(3.9,146085,2,312,0)=" F  D  Q:NODE="""""
^XMB(3.9,146085,2,313,0)="""RTN"",""XDRMERGB"",18,0)"
^XMB(3.9,146085,2,314,0)=" . S NODE1=$O(@(XDRDIC_IENFROM_"",""""""_NODE_"""""")""))"
^XMB(3.9,146085,2,315,0)="""RTN"",""XDRMERGB"",19,0)"
^XMB(3.9,146085,2,316,0)=" . I NODE1="""" S NODE="""" Q  ; NOTHING MORE TO MOVE OVER"
^XMB(3.9,146085,2,317,0)="""RTN"",""XDRMERGB"",20,0)"
^XMB(3.9,146085,2,318,0)=" . S NODE2=$O(@(XDRDIC_IENTO_"",""""""_NODE_"""""")""))"
^XMB(3.9,146085,2,319,0)="""RTN"",""XDRMERGB"",21,0)"
^XMB(3.9,146085,2,320,0)=" . I NODE2'="""",NODE1]NODE2 S NODE=NODE2 Q  ; NODE ON TO, BUT NOT ON FROM - GO TO NEXT"
^XMB(3.9,146085,2,321,0)="""RTN"",""XDRMERGB"",22,0)"
^XMB(3.9,146085,2,322,0)=" . S NODE=NODE1"
^XMB(3.9,146085,2,323,0)="""RTN"",""XDRMERGB"",23,0)"
^XMB(3.9,146085,2,324,0)=" . I $D(@(XDRDIC_IENFROM_"",""""""_NODE_"""""")""))=1 D  Q  ; SINGLE NODE, MERGE DATA"
^XMB(3.9,146085,2,325,0)="""RTN"",""XDRMERGB"",24,0)"
^XMB(3.9,146085,2,326,0)=" . . I NODE2]NODE1!(NODE2="""") D  Q  ;  MISSING NODE, JUST MOVE IT OVER"
^XMB(3.9,146085,2,327,0)="""RTN"",""XDRMERGB"",25,0)"
^XMB(3.9,146085,2,328,0)=" . . . N XDRXX,FLD,N,J"
^XMB(3.9,146085,2,329,0)="""RTN"",""XDRMERGB"",26,0)"
^XMB(3.9,146085,2,330,0)=" . . . F N=0:0 S N=$O(^DD(XFILNO,""GL"",NODE,N)) Q:N'>0  S FLD=$O(^(N,0)) I $O(^DD(XFILNO,FLD,1,0))>0 D"
^XMB(3.9,146085,2,331,0)="""RTN"",""XDRMERGB"",27,0)"
^XMB(3.9,146085,2,332,0)=" . . . . S X=0 F J=0:0 S J=$O(^DD(XFILNO,FLD,1,J)) Q:J'>0  I $O(^(J,0))>0 S X=1 Q"
^XMB(3.9,146085,2,333,0)="""RTN"",""XDRMERGB"",28,0)"
^XMB(3.9,146085,2,334,0)=" . . . . I X>0 D"
^XMB(3.9,146085,2,335,0)="""RTN"",""XDRMERGB"",29,0)"
^XMB(3.9,146085,2,336,0)=" . . . . . S XDRXX(XFILNO,IENTOSTR,FLD)=$P(@(XDRDIC_IENFROM_"",""""""_NODE_"""""")""),U,N)"
^XMB(3.9,146085,2,337,0)="""RTN"",""XDRMERGB"",30,0)"
^XMB(3.9,146085,2,338,0)=" . . . K XDRAA I $D(XDRTESTK),$D(XDRXX) M XDRAA=XDRXX ; DEBUT STATEMENT"
^XMB(3.9,146085,2,339,0)="""RTN"",""XDRMERGB"",31,0)"
^XMB(3.9,146085,2,340,0)=" . . . K XDRZZ"
^XMB(3.9,146085,2,341,0)="""RTN"",""XDRMERGB"",32,0)"
^XMB(3.9,146085,2,342,0)=" . . . I $D(XDRXX) D FILE^DIE("""",""XDRXX"",""XDRZZ"")"
^XMB(3.9,146085,2,343,0)="""RTN"",""XDRMERGB"",33,0)"
^XMB(3.9,146085,2,344,0)=" . . . I $D(XDRTESTK),$D(XDRZZ) S XDRTESTK=XDRTESTK+1 M ^XTMP(""XDRTESTK"",$$NOW^XLFDT(),XDRTESTK,""XX"")=XDRAA,^(""ZZ"")=XDRZZ ; DEBUG STATMENT"
^XMB(3.9,146085,2,345,0)="""RTN"",""XDRMERGB"",34,0)"
^XMB(3.9,146085,2,346,0)=" . . . M @(XDRDIC_IENTO_"",""""""_NODE_"""""")"")=@(XDRDIC_IENFROM_"",""""""_NODE_"""""")"")"
^XMB(3.9,146085,2,347,0)="""RTN"",""XDRMERGB"",35,0)"
^XMB(3.9,146085,2,348,0)=" . . I $D(@(XDRDIC_IENTO_"",""""""_NODE_"""""")""))>1 Q  ; MISMATCH SO QUIT"
^XMB(3.9,146085,2,349,0)="""RTN"",""XDRMERGB"",36,0)"
^XMB(3.9,146085,2,350,0)=" . . N XDRXX,FLD"
^XMB(3.9,146085,2,351,0)="""RTN"",""XDRMERGB"",37,0)"
^XMB(3.9,146085,2,352,0)=" . . S X1=@(XDRDIC_IENFROM_"",""""""_NODE_"""""")"")"
^XMB(3.9,146085,2,353,0)="""RTN"",""XDRMERGB"",38,0)"
^XMB(3.9,146085,2,354,0)=" . . S (X2,X3)=@(XDRDIC_IENTO_"",""""""_NODE_"""""")"")"
^XMB(3.9,146085,2,355,0)="""RTN"",""XDRMERGB"",39,0)"
^XMB(3.9,146085,2,356,0)=" . . F I=1:1 Q:X1=""""  S X=$P(X1,U),X1=$P(X1,U,2,999) I X'="""" D"
^XMB(3.9,146085,2,357,0)="""RTN"",""XDRMERGB"",40,0)"
^XMB(3.9,146085,2,358,0)=" . . . S Y=$P(X2,U,I)"
^XMB(3.9,146085,2,359,0)="""RTN"",""XDRMERGB"",41,0)"
^XMB(3.9,146085,2,360,0)=" . . . I Y=""""  D"
^XMB(3.9,146085,2,361,0)="""RTN"",""XDRMERGB"",42,0)"
^XMB(3.9,146085,2,362,0)=" . . . . ;S $P(X2,U,I)=X ;LLS 26-OCT-2013 replaced with conditional SET below"
^XMB(3.9,146085,2,363,0)="""RTN"",""XDRMERGB"",43,0)"
^XMB(3.9,146085,2,364,0)=" . . . . S FLD=$O(^DD(XFILNO,""GL"",NODE,I,0)) S JXFLD=FLD"
^XMB(3.9,146085,2,365,0)="""RTN"",""XDRMERGB"",44,0)"
^XMB(3.9,146085,2,366,0)=" . . . . I (XFILNO'=2)!(FLD'=.6) S $P(X2,U,I)=X ;LLS 26-OCT-2013 - replaced set of X2 so do not move 'test patient indicator'"
^XMB(3.9,146085,2,367,0)="""RTN"",""XDRMERGB"",45,0)"
^XMB(3.9,146085,2,368,0)=" . . . . I XFILNO=2,FLD=.6 Q  ;LLS 26-OCT-2013 - Do not want to move 'test patient indicator' "
^XMB(3.9,146085,2,369,0)="""RTN"",""XDRMERGB"",46,0)"
^XMB(3.9,146085,2,370,0)=" . . . . I FLD>0,$O(^DD(XFILNO,FLD,1,0))>0 S XDRXX(XFILNO,IENTOSTR,FLD)=X"
^XMB(3.9,146085,2,371,0)="""RTN"",""XDRMERGB"",47,0)"
^XMB(3.9,146085,2,372,0)=" . . I X2'=X3 D"
^XMB(3.9,146085,2,373,0)="""RTN"",""XDRMERGB"",48,0)"
^XMB(3.9,146085,2,374,0)=" . . . I $D(XDRXX) D"
^XMB(3.9,146085,2,375,0)="""RTN"",""XDRMERGB"",49,0)"
^XMB(3.9,146085,2,376,0)=" . . . . K XDRAA I $D(XDRTESTK) M XDRAA=XDRXX ; DEBUG STATEMENT"
^XMB(3.9,146085,2,377,0)="""RTN"",""XDRMERGB"",50,0)"
^XMB(3.9,146085,2,378,0)=" . . . . K XDRZZ"
^XMB(3.9,146085,2,379,0)="""RTN"",""XDRMERGB"",51,0)"
^XMB(3.9,146085,2,380,0)=" . . . . N X2 D FILE^DIE("""",""XDRXX"",""XDRZZ"")"
^XMB(3.9,146085,2,381,0)="""RTN"",""XDRMERGB"",52,0)"
^XMB(3.9,146085,2,382,0)=" . . . . I $D(XDRTESTK),$D(XDRZZ) S XDRTESTK=XDRTESTK+1 M ^XTMP(""XDRTESTK"",$$NOW^XLFDT(),XDRTESTK,""XX"")=XDRAA,^(""ZZ"")=XDRZZ ; DEBUG STATMENT"
^XMB(3.9,146085,2,383,0)="""RTN"",""XDRMERGB"",53,0)"
^XMB(3.9,146085,2,384,0)=" . . . S @(XDRDIC_IENTO_"",""""""_NODE_"""""")"")=X2 ; SET MERGED DATA ON NODE"
^XMB(3.9,146085,2,385,0)="""RTN"",""XDRMERGB"",54,0)"
^XMB(3.9,146085,2,386,0)=" . ;"
^XMB(3.9,146085,2,387,0)="""RTN"",""XDRMERGB"",55,0)"
^XMB(3.9,146085,2,388,0)=" . ; THE FOLLOWING HANDLES NODES THAT HAVE MULTIPLES"
^XMB(3.9,146085,2,389,0)="""RTN"",""XDRMERGB"",56,0)"
