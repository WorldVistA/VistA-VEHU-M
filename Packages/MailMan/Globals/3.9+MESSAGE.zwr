^XMB(3.9,146057,2,416,0)=" F HLCNT=1:1:DEFCNT S TMP=$$TASKFLR^HLCS1(""OUT"")"
^XMB(3.9,146057,2,417,0)="""RTN"",""HLCS2"",89,0)"
^XMB(3.9,146057,2,418,0)=" Q"
^XMB(3.9,146057,2,419,0)="""RTN"",""HLCS2"",90,0)"
^XMB(3.9,146057,2,420,0)="LLP(ALL) ;Stop Logical Links"
^XMB(3.9,146057,2,421,0)="""RTN"",""HLCS2"",91,0)"
^XMB(3.9,146057,2,422,0)=" ;ALL=1 OR 0 IF zero, only AUTOSTART LINKS get stopped"
^XMB(3.9,146057,2,423,0)="""RTN"",""HLCS2"",92,0)"
^XMB(3.9,146057,2,424,0)=" N HLDP,HLDP0,HLPARM0,HLPARM4,HLJ,X,Y S HLDP=0"
^XMB(3.9,146057,2,425,0)="""RTN"",""HLCS2"",93,0)"
^XMB(3.9,146057,2,426,0)=" F  S HLDP=$O(^HLCS(870,HLDP)) Q:'HLDP  S HLDP0=$G(^(HLDP,0)),X=+$P(HLDP0,U,3) D:X"
^XMB(3.9,146057,2,427,0)="""RTN"",""HLCS2"",94,0)"
^XMB(3.9,146057,2,428,0)=" .;skip this link if not stopping all and Autostart not enabled"
