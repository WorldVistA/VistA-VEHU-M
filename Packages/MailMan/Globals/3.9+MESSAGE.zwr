^XMB(3.9,146009,2,716,0)=" ; called from rpc: XUS MVI NEW PERSON BULK GET"
^XMB(3.9,146009,2,717,0)="""RTN"",""XUMVINPB"",20,0)"
^XMB(3.9,146009,2,718,0)=" ;"
^XMB(3.9,146009,2,719,0)="""RTN"",""XUMVINPB"",21,0)"
^XMB(3.9,146009,2,720,0)=" ; Input:"
^XMB(3.9,146009,2,721,0)="""RTN"",""XUMVINPB"",22,0)"
^XMB(3.9,146009,2,722,0)=" ;  XUDUZ = NEW PERSON IEN TO BEGIN LOOPING ON"
^XMB(3.9,146009,2,723,0)="""RTN"",""XUMVINPB"",23,0)"
^XMB(3.9,146009,2,724,0)=" ;  XUTYPE = TYPE OF EXTRACT ('A'ctive, 'D'isuser/Terminated, 'V'isitor or 'ALL')"
^XMB(3.9,146009,2,725,0)="""RTN"",""XUMVINPB"",24,0)"
