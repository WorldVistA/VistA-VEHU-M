^XMB(3.9,146052,2,901,0)="""RTN"",""FBAAMST"",25,0)"
^XMB(3.9,146052,2,902,0)=" S DIR(""?"",1)=""Enter D to print veteran, authorization, and payment details."""
^XMB(3.9,146052,2,903,0)="""RTN"",""FBAAMST"",26,0)"
