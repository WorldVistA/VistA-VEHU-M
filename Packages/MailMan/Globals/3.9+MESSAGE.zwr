^XMB(3.9,146012,2,1184,0)="0^1^B153051449"
^XMB(3.9,146012,2,1185,0)="""RTN"",""PSOERRX1"",1,0)"
^XMB(3.9,146012,2,1186,0)="PSOERRX1 ;BIRM/MFR - All Rxs eRx Queue - Supporting APIs ;08/28/22"
^XMB(3.9,146012,2,1187,0)="""RTN"",""PSOERRX1"",2,0)"
^XMB(3.9,146012,2,1188,0)=" ;;7.0;OUTPATIENT PHARMACY;**700,769,770,805**;DEC 1997;Build 0"
^XMB(3.9,146012,2,1189,0)="""RTN"",""PSOERRX1"",3,0)"
