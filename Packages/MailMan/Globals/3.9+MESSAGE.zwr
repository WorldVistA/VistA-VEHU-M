^XMB(3.9,146084,2,1172,0)=" M INPUTS=AVAILABILITY"
^XMB(3.9,146084,2,1173,0)="""RTN"",""SDES2CRTCLNAVAL2"",12,0)"
^XMB(3.9,146084,2,1174,0)=" D VALCONTEXT^SDES2VALCONTEXT(.ERRORS,.SDCONTEXT)"
^XMB(3.9,146084,2,1175,0)="""RTN"",""SDES2CRTCLNAVAL2"",13,0)"
^XMB(3.9,146084,2,1176,0)=" I $D(ERRORS) S ERRORS(""clinicAvailability"")="""" K CNT,I D BUILDJSON^SDES2JSON(.JSON,.ERRORS) Q"
^XMB(3.9,146084,2,1177,0)="""RTN"",""SDES2CRTCLNAVAL2"",14,0)"
^XMB(3.9,146084,2,1178,0)=" I $G(SDCONTEXT(""USER DUZ""))'="""" N DUZ D DUZ^XUP(SDCONTEXT(""USER DUZ""))"
