^XMB(3.9,146011,2,482,0)=" I STA=16 S VALMSG=""Placed on HOLD by Provider!"" K Y,STA D PSOUL^PSSLOCK(DA) D ULP S VALMBCK="""" Q"
^XMB(3.9,146011,2,483,0)="""RTN"",""PSOHLD"",17,0)"
^XMB(3.9,146011,2,484,0)=" I STA'=3!(('$D(^XUSEC(""PSORPH"",DUZ)))&('$D(^XUSEC(""PSO TECH ADV"",DUZ)))) S VALMSG=""Invalid Action Selection!"",VALMBCK="""" K Y,STA D PSOUL^PSSLOCK(DA) D ULP Q"
