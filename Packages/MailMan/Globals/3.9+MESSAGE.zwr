^XMB(3.9,146011,2,569,0)="""RTN"",""PSOHLD"",60,0)"
^XMB(3.9,146011,2,570,0)=" ;PSO*7*298 Require an entry into fill date"
^XMB(3.9,146011,2,571,0)="""RTN"",""PSOHLD"",61,0)"
^XMB(3.9,146011,2,572,0)=" S ACT=1,DIE=""^PSRX("",FDT=$S($P(^PSRX(RXIEN,2),""^"",2):$P(^PSRX(RXIEN,2),""^"",2),1:DT)"
^XMB(3.9,146011,2,573,0)="""RTN"",""PSOHLD"",62,0)"
^XMB(3.9,146011,2,574,0)=" S RLDT=$P(^PSRX(RXIEN,2),""^"",13),DR="""",RLDTP1=$P(RLDT,""."",1)"
^XMB(3.9,146011,2,575,0)="""RTN"",""PSOHLD"",63,0)"
^XMB(3.9,146011,2,576,0)=" N MWPR S MWPR=0 I 'RXF&'RLDT S DR=""22R//^S X=FDT;Q;"" S MWPR=1"
^XMB(3.9,146011,2,577,0)="""RTN"",""PSOHLD"",64,0)"
^XMB(3.9,146011,2,578,0)=" I RLDT&($P(^PSRX(RXIEN,2),""^"",2)="""") S DR=""22R//^S X=RLDTP1;Q;"" S MWPR=1"
^XMB(3.9,146011,2,579,0)="""RTN"",""PSOHLD"",65,0)"
^XMB(3.9,146011,2,580,0)=" D ^DIE K FDT I $D(Y) S VALMBCK=""R"" D ULP G EX"
^XMB(3.9,146011,2,581,0)="""RTN"",""PSOHLD"",66,0)"
^XMB(3.9,146011,2,582,0)=" I MWPR D  I $D(DIRUT) K DIRUT S VALMBCK=""R"" D ULP G EX"
^XMB(3.9,146011,2,583,0)="""RTN"",""PSOHLD"",67,0)"
^XMB(3.9,146011,2,584,0)=" .D MWPR Q:$D(DIRUT)"
^XMB(3.9,146011,2,585,0)="""RTN"",""PSOHLD"",68,0)"
^XMB(3.9,146011,2,586,0)=" .S DR=""11////""_Y D ^DIE"
^XMB(3.9,146011,2,587,0)="""RTN"",""PSOHLD"",69,0)"
^XMB(3.9,146011,2,588,0)=" S DR=""100///0;101///^S X=$S(RXF:$G(ZD(RXIEN)),1:$P(^PSRX(RXIEN,2),""""^"""",2))"""
^XMB(3.9,146011,2,589,0)="""RTN"",""PSOHLD"",70,0)"
^XMB(3.9,146011,2,590,0)=" D ^DIE K FDT I $D(Y) S VALMBCK=""R"" D ULP G EX"
^XMB(3.9,146011,2,591,0)="""RTN"",""PSOHLD"",71,0)"
^XMB(3.9,146011,2,592,0)=" I 'RXF,$E($$GET1^DIQ(52,RXIEN,11))=""P"" S PSOTOPK=1  ;441"
^XMB(3.9,146011,2,593,0)="""RTN"",""PSOHLD"",72,0)"
^XMB(3.9,146011,2,594,0)=" I 'RXF,$$GET1^DIQ(52,RXIEN,11)[""W"" S BINGRTE=""W"",BINGCRT=1  ;*488"
^XMB(3.9,146011,2,595,0)="""RTN"",""PSOHLD"",73,0)"
^XMB(3.9,146011,2,596,0)=" ;"
^XMB(3.9,146011,2,597,0)="""RTN"",""PSOHLD"",74,0)"
^XMB(3.9,146011,2,598,0)=" ; - Saving UNHOLD COMMENTS in the Refill REMARKS field."
^XMB(3.9,146011,2,599,0)="""RTN"",""PSOHLD"",75,0)"
^XMB(3.9,146011,2,600,0)=" I $G(OTHCOM)'="""" D"
^XMB(3.9,146011,2,601,0)="""RTN"",""PSOHLD"",76,0)"
^XMB(3.9,146011,2,602,0)=" . N DA,DIE,DR S DA(1)=RXIEN,DA=RXF,DIE=""^PSRX(""_DA(1)_"",1,"",DR=""3///""_$E($TR(OTHCOM,"";"","",""),1,60) D ^DIE"
^XMB(3.9,146011,2,603,0)="""RTN"",""PSOHLD"",77,0)"
^XMB(3.9,146011,2,604,0)=" ; - Logging Rx Activity Log"
^XMB(3.9,146011,2,605,0)="""RTN"",""PSOHLD"",78,0)"
^XMB(3.9,146011,2,606,0)=" D RXACT(RXIEN,""U"",,$G(OTHCOM))"
^XMB(3.9,146011,2,607,0)="""RTN"",""PSOHLD"",79,0)"
^XMB(3.9,146011,2,608,0)=" ;"
^XMB(3.9,146011,2,609,0)="""RTN"",""PSOHLD"",80,0)"
^XMB(3.9,146011,2,610,0)=" S COMM=""Medication Removed from Hold by Pharmacy"" D EN^PSOHLSN1(RXIEN,""OE"","""",COMM,PSONOOR) K COMM,PSONOOR"
^XMB(3.9,146011,2,611,0)="""RTN"",""PSOHLD"",81,0)"
^XMB(3.9,146011,2,612,0)=" S PSORX(""FILL DATE"")=$S('RXF:$P(^PSRX(RXIEN,2),""^"",2),1:ZD(RXIEN)) I $G(^PSRX(RXIEN,""H"")) K ^PSRX(""AH"",$P(^PSRX(RXIEN,""H""),""^""),DA)"
^XMB(3.9,146011,2,613,0)="""RTN"",""PSOHLD"",82,0)"
^XMB(3.9,146011,2,614,0)=" S ^PSRX(RXIEN,""H"")="""""
^XMB(3.9,146011,2,615,0)="""RTN"",""PSOHLD"",83,0)"
^XMB(3.9,146011,2,616,0)=" ;D ACT^PSOHLDA"
^XMB(3.9,146011,2,617,0)="""RTN"",""PSOHLD"",84,0)"
^XMB(3.9,146011,2,618,0)=" S (NEW1,NEW11)=""^^"""
^XMB(3.9,146011,2,619,0)="""RTN"",""PSOHLD"",85,0)"
^XMB(3.9,146011,2,620,0)=" S (RXF,RXFL(RXIEN))=0 F JJ=0:0 S JJ=$O(^PSRX(RXIEN,1,JJ)) Q:'JJ  S (RXFL(RXIEN),RXF)=JJ"
^XMB(3.9,146011,2,621,0)="""RTN"",""PSOHLD"",86,0)"
^XMB(3.9,146011,2,622,0)=" I $G(PSXSYS) D UNHOLD^PSOCMOPA I $G(XFLAG) D ULP G EX"
^XMB(3.9,146011,2,623,0)="""RTN"",""PSOHLD"",87,0)"
^XMB(3.9,146011,2,624,0)=" I $G(RXIEN) D RELC I $G(PSOHRL) D ULP G EX"
^XMB(3.9,146011,2,625,0)="""RTN"",""PSOHLD"",88,0)"
^XMB(3.9,146011,2,626,0)=" I PSORX(""FILL DATE"")>DT,$P(PSOPAR,""^"",6) D S^PSORXL,EX,ULP Q"
^XMB(3.9,146011,2,627,0)="""RTN"",""PSOHLD"",89,0)"
^XMB(3.9,146011,2,628,0)=" S PCOMH(RXIEN)=""Medication Removed from Hold by Pharmacy"""
^XMB(3.9,146011,2,629,0)="""RTN"",""PSOHLD"",90,0)"
^XMB(3.9,146011,2,630,0)=" I $G(RXIEN) S RXRH(RXIEN)=RXIEN"
^XMB(3.9,146011,2,631,0)="""RTN"",""PSOHLD"",91,0)"
^XMB(3.9,146011,2,632,0)=" I $P($G(^PSRX(RXIEN,2)),""^"",15)'="""" S $P(^PSRX(RXIEN,2),""^"",14)=1,RXRP(RXIEN)=1,$P(RXRP(RXIEN),""^"",2)=$P($G(^PSRX(RXIEN,0)),""^"",18) ; MARK PRESCRIPTION AND LABEL AS BEING REPRINTED WHEN UNHOLDING A RETURNED TO STOCK PRESCRIPTION"
^XMB(3.9,146011,2,633,0)="""RTN"",""PSOHLD"",92,0)"
^XMB(3.9,146011,2,634,0)=" I $G(PSOTOPK) D PRK^PSOPRK(RXIEN) D ULP G EX ;441"
^XMB(3.9,146011,2,635,0)="""RTN"",""PSOHLD"",93,0)"
^XMB(3.9,146011,2,636,0)=" ;"
^XMB(3.9,146011,2,637,0)="""RTN"",""PSOHLD"",94,0)"
^XMB(3.9,146011,2,638,0)=" ; - Submitting Rx to ECME"
^XMB(3.9,146011,2,639,0)="""RTN"",""PSOHLD"",95,0)"
^XMB(3.9,146011,2,640,0)=" N ACTION"
^XMB(3.9,146011,2,641,0)="""RTN"",""PSOHLD"",96,0)"
^XMB(3.9,146011,2,642,0)=" I $$SUBMIT^PSOBPSUT(RXIEN,+$G(RXFL(RXIEN))) D  I ACTION=""Q""!(ACTION=""^"") D ULP G EX"
^XMB(3.9,146011,2,643,0)="""RTN"",""PSOHLD"",97,0)"
^XMB(3.9,146011,2,644,0)=" . N RX,RFL S RX=RXIEN,RFL=+$G(RXFL(RXIEN))"
