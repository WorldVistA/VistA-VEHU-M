^XMB(3.9,146012,2,1145,0)="""RTN"",""PSOERRX0"",335,0)"
^XMB(3.9,146012,2,1146,0)=" S DFN=+$G(DFN),VALMBCK=""R"",PSOJUMP=1,MBMSITE=$S($$GET1^DIQ(59.7,1,102,""I"")=""MBM"":1,1:0) S:MBMSITE PSOALLST=1"
