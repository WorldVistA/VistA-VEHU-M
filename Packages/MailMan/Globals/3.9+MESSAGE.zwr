^XMB(3.9,146036,2,1488,0)="0^2^B69738130"
^XMB(3.9,146036,2,1489,0)="""RTN"",""DVBCPUSH"",1,0)"
^XMB(3.9,146036,2,1490,0)="DVBCPUSH ;ALB/AKG/JD - CAPRI PUSH UTILITY RPC; APR 25, 2022@9:30am ; 5/19/23 9:07am"
^XMB(3.9,146036,2,1491,0)="""RTN"",""DVBCPUSH"",2,0)"
^XMB(3.9,146036,2,1492,0)=" ;;2.7;AMIE;**238,242,248,252,254**;Apr 10, 1995;Build 0"
^XMB(3.9,146036,2,1493,0)="""RTN"",""DVBCPUSH"",3,0)"
^XMB(3.9,146036,2,1494,0)=" ;Per VHA Directive 6402 this routine should not be modified"
^XMB(3.9,146036,2,1495,0)="""RTN"",""DVBCPUSH"",4,0)"
^XMB(3.9,146036,2,1496,0)=" ;ICR #2263 Supports all calls to Parameter File and XPAR usage"
^XMB(3.9,146036,2,1497,0)="""RTN"",""DVBCPUSH"",5,0)"
^XMB(3.9,146036,2,1498,0)=" ;"
^XMB(3.9,146036,2,1499,0)="""RTN"",""DVBCPUSH"",6,0)"
^XMB(3.9,146036,2,1500,0)=" Q"
^XMB(3.9,146036,2,1501,0)="""RTN"",""DVBCPUSH"",7,0)"
^XMB(3.9,146036,2,1502,0)=" ;"
^XMB(3.9,146036,2,1503,0)="""RTN"",""DVBCPUSH"",8,0)"
^XMB(3.9,146036,2,1504,0)="PARAMS(DVBLIST) ;returns data on the entire DVBA parameter list"
^XMB(3.9,146036,2,1505,0)="""RTN"",""DVBCPUSH"",9,0)"
^XMB(3.9,146036,2,1506,0)=" ;rpc returns all CAPRI namespaced Parameters"
^XMB(3.9,146036,2,1507,0)="""RTN"",""DVBCPUSH"",10,0)"
^XMB(3.9,146036,2,1508,0)=" ;RPC: DVBA CAPRI PARAM INQ"
^XMB(3.9,146036,2,1509,0)="""RTN"",""DVBCPUSH"",11,0)"
^XMB(3.9,146036,2,1510,0)=" ;Updated code to allow for multi-instance parameters for CAPRI-13378.  JD - 9/10/24"
^XMB(3.9,146036,2,1511,0)="""RTN"",""DVBCPUSH"",12,0)"
^XMB(3.9,146036,2,1512,0)=" ;Update to return word processing parameters CAPRI-16484 2/24/25 CP"
^XMB(3.9,146036,2,1513,0)="""RTN"",""DVBCPUSH"",13,0)"
^XMB(3.9,146036,2,1514,0)=" ;"
^XMB(3.9,146036,2,1515,0)="""RTN"",""DVBCPUSH"",14,0)"
^XMB(3.9,146036,2,1516,0)=" K DVBLIST"
^XMB(3.9,146036,2,1517,0)="""RTN"",""DVBCPUSH"",15,0)"
^XMB(3.9,146036,2,1518,0)=" N DVBCNT,DVBD,DVBI,DVBPARAM,DVBPAR,DVBVAL,DVBERR,DVBTYP"
^XMB(3.9,146036,2,1519,0)="""RTN"",""DVBCPUSH"",16,0)"
^XMB(3.9,146036,2,1520,0)=" S DVBCNT=0"
^XMB(3.9,146036,2,1521,0)="""RTN"",""DVBCPUSH"",17,0)"
^XMB(3.9,146036,2,1522,0)=" S DVBPARAM="""" F  S DVBPARAM=$O(^XTV(8989.51,""B"",DVBPARAM)) Q:DVBPARAM=""""  D"
^XMB(3.9,146036,2,1523,0)="""RTN"",""DVBCPUSH"",18,0)"
^XMB(3.9,146036,2,1524,0)=" .I $P($P(DVBPARAM,U,1),"" "")'[""DVBA"" Q"
^XMB(3.9,146036,2,1525,0)="""RTN"",""DVBCPUSH"",19,0)"
^XMB(3.9,146036,2,1526,0)=" .S DVBPAR="""" F  S DVBPAR=$O(^XTV(8989.51,""B"",DVBPARAM,DVBPAR)) Q:DVBPAR=""""  D"
^XMB(3.9,146036,2,1527,0)="""RTN"",""DVBCPUSH"",20,0)"
^XMB(3.9,146036,2,1528,0)=" ..S DVBTYP=$$GET1^DIQ(8989.51,DVBPAR,""1.1"",""I"")"
^XMB(3.9,146036,2,1529,0)="""RTN"",""DVBCPUSH"",21,0)"
^XMB(3.9,146036,2,1530,0)=" ..I DVBTYP'=""W"" D"
^XMB(3.9,146036,2,1531,0)="""RTN"",""DVBCPUSH"",22,0)"
^XMB(3.9,146036,2,1532,0)=" ...D GETLST^XPAR(.DVBVAL,""PKG"",DVBPARAM,""Q"")"
^XMB(3.9,146036,2,1533,0)="""RTN"",""DVBCPUSH"",23,0)"
^XMB(3.9,146036,2,1534,0)=" ...S (DVBD,DVBI)="""""
^XMB(3.9,146036,2,1535,0)="""RTN"",""DVBCPUSH"",24,0)"
^XMB(3.9,146036,2,1536,0)=" ...F  S DVBI=$O(DVBVAL(DVBI)) Q:DVBI=""""  S DVBD=DVBD_""|""_$P(DVBVAL(DVBI),U,2)"
^XMB(3.9,146036,2,1537,0)="""RTN"",""DVBCPUSH"",25,0)"
^XMB(3.9,146036,2,1538,0)=" ...S DVBLIST(DVBCNT)=DVBPAR_U_DVBPARAM_U_$P(DVBD,""|"",2,9999)"
^XMB(3.9,146036,2,1539,0)="""RTN"",""DVBCPUSH"",26,0)"
^XMB(3.9,146036,2,1540,0)=" ...S DVBCNT=DVBCNT+1"
^XMB(3.9,146036,2,1541,0)="""RTN"",""DVBCPUSH"",27,0)"
^XMB(3.9,146036,2,1542,0)=" ...Q"
^XMB(3.9,146036,2,1543,0)="""RTN"",""DVBCPUSH"",28,0)"
^XMB(3.9,146036,2,1544,0)=" ..I DVBTYP=""W"" D"
^XMB(3.9,146036,2,1545,0)="""RTN"",""DVBCPUSH"",29,0)"
^XMB(3.9,146036,2,1546,0)=" ...D GETWP^XPAR(.DVBVAL,""PKG"",DVBPARAM,1)"
^XMB(3.9,146036,2,1547,0)="""RTN"",""DVBCPUSH"",30,0)"
^XMB(3.9,146036,2,1548,0)=" ...S (DVBD,DVBI)="""""
^XMB(3.9,146036,2,1549,0)="""RTN"",""DVBCPUSH"",31,0)"
^XMB(3.9,146036,2,1550,0)=" ...F  S DVBI=$O(DVBVAL(DVBI)) Q:DVBI=""""  S DVBD=DVBD_""|""_$G(DVBVAL(DVBI,0))"
^XMB(3.9,146036,2,1551,0)="""RTN"",""DVBCPUSH"",32,0)"
^XMB(3.9,146036,2,1552,0)=" ...S DVBLIST(DVBCNT)=DVBPAR_U_DVBPARAM_U_$P(DVBD,""|"",2,9999)"
^XMB(3.9,146036,2,1553,0)="""RTN"",""DVBCPUSH"",33,0)"
^XMB(3.9,146036,2,1554,0)=" ...S DVBCNT=DVBCNT+1"
^XMB(3.9,146036,2,1555,0)="""RTN"",""DVBCPUSH"",34,0)"
^XMB(3.9,146036,2,1556,0)=" ...Q"
^XMB(3.9,146036,2,1557,0)="""RTN"",""DVBCPUSH"",35,0)"
^XMB(3.9,146036,2,1558,0)=" Q"
^XMB(3.9,146036,2,1559,0)="""RTN"",""DVBCPUSH"",36,0)"
^XMB(3.9,146036,2,1560,0)=" ;"
^XMB(3.9,146036,2,1561,0)="""RTN"",""DVBCPUSH"",37,0)"
^XMB(3.9,146036,2,1562,0)="PARAMED(DVBMSG,DVBNAME,DVBVAL) ;"
^XMB(3.9,146036,2,1563,0)="""RTN"",""DVBCPUSH"",38,0)"
^XMB(3.9,146036,2,1564,0)=" ;edits exiting parameter value from CAPRI Push Utility"
^XMB(3.9,146036,2,1565,0)="""RTN"",""DVBCPUSH"",39,0)"
^XMB(3.9,146036,2,1566,0)=" ;RPC: DVBA CAPRI PARAM UPDATE"
^XMB(3.9,146036,2,1567,0)="""RTN"",""DVBCPUSH"",40,0)"
^XMB(3.9,146036,2,1568,0)=" ;Updated code to allow for multi-instance parameters for CAPRI-13378. JD - 9/11/24"
^XMB(3.9,146036,2,1569,0)="""RTN"",""DVBCPUSH"",41,0)"
^XMB(3.9,146036,2,1570,0)=" ;Update to allow saving of word processing parameters CAPRI-16484 2/24/25 CP"
^XMB(3.9,146036,2,1571,0)="""RTN"",""DVBCPUSH"",42,0)"
^XMB(3.9,146036,2,1572,0)=" ;"
^XMB(3.9,146036,2,1573,0)="""RTN"",""DVBCPUSH"",43,0)"
^XMB(3.9,146036,2,1574,0)=" I $G(DVBNAME)="""" S DVBMSG=""Missing parameter name"" Q"
^XMB(3.9,146036,2,1575,0)="""RTN"",""DVBCPUSH"",44,0)"
^XMB(3.9,146036,2,1576,0)=" K DVBMSG S DVBMSG="""""
^XMB(3.9,146036,2,1577,0)="""RTN"",""DVBCPUSH"",45,0)"
^XMB(3.9,146036,2,1578,0)=" N DVBCNF,DVBCNS,DVBCNT,DVBDLER,DVBERR,DVBF,DVBI,DVBPI,DVBVALV"
^XMB(3.9,146036,2,1579,0)="""RTN"",""DVBCPUSH"",46,0)"
^XMB(3.9,146036,2,1580,0)=" N DVBTYP,DVBLEN,DVBI,DVBUPD,DVBTMP"
^XMB(3.9,146036,2,1581,0)="""RTN"",""DVBCPUSH"",47,0)"
^XMB(3.9,146036,2,1582,0)=" S (DVBCNF,DVBCNS,DVBCNT,DVBDLER,DVBERR)=0"
^XMB(3.9,146036,2,1583,0)="""RTN"",""DVBCPUSH"",48,0)"
^XMB(3.9,146036,2,1584,0)=" S DVBPI=$O(^XTV(8989.51,""B"",DVBNAME,""""))"
^XMB(3.9,146036,2,1585,0)="""RTN"",""DVBCPUSH"",49,0)"
^XMB(3.9,146036,2,1586,0)=" S DVBTYP=$$GET1^DIQ(8989.51,DVBPI,""1.1"",""I"")"
^XMB(3.9,146036,2,1587,0)="""RTN"",""DVBCPUSH"",50,0)"
^XMB(3.9,146036,2,1588,0)=" I $D(^XTV(8989.5,""AC"",DVBPI))>0 D NDEL^XPAR(""PKG"",DVBNAME,.DVBDLER)"
^XMB(3.9,146036,2,1589,0)="""RTN"",""DVBCPUSH"",51,0)"
^XMB(3.9,146036,2,1590,0)=" I DVBDLER'=0 S DVBMSG=DVBDLER Q"
^XMB(3.9,146036,2,1591,0)="""RTN"",""DVBCPUSH"",52,0)"
^XMB(3.9,146036,2,1592,0)=" I $G(DVBVAL)="""" S DVBMSG=""The entire parameter list has been deleted"" Q"
^XMB(3.9,146036,2,1593,0)="""RTN"",""DVBCPUSH"",53,0)"
^XMB(3.9,146036,2,1594,0)=" I DVBTYP'=""W"" D"
^XMB(3.9,146036,2,1595,0)="""RTN"",""DVBCPUSH"",54,0)"
^XMB(3.9,146036,2,1596,0)=" .S DVBF="""""
^XMB(3.9,146036,2,1597,0)="""RTN"",""DVBCPUSH"",55,0)"
^XMB(3.9,146036,2,1598,0)=" .F DVBI=1:1:$L(DVBVAL,""|"") D"
^XMB(3.9,146036,2,1599,0)="""RTN"",""DVBCPUSH"",56,0)"
^XMB(3.9,146036,2,1600,0)=" ..S DVBVALV=$P(DVBVAL,""|"",DVBI)"
^XMB(3.9,146036,2,1601,0)="""RTN"",""DVBCPUSH"",57,0)"
^XMB(3.9,146036,2,1602,0)=" ..D EN^XPAR(""PKG.AUTOMATED MED INFO EXCHANGE"",DVBNAME,DVBI,DVBVALV,.DVBERR)"
^XMB(3.9,146036,2,1603,0)="""RTN"",""DVBCPUSH"",58,0)"
^XMB(3.9,146036,2,1604,0)=" ..S DVBCNT=DVBCNT+1"
^XMB(3.9,146036,2,1605,0)="""RTN"",""DVBCPUSH"",59,0)"
^XMB(3.9,146036,2,1606,0)=" ..I DVBERR D  Q"
^XMB(3.9,146036,2,1607,0)="""RTN"",""DVBCPUSH"",60,0)"
^XMB(3.9,146036,2,1608,0)=" ...S DVBCNF=DVBCNF+1"
^XMB(3.9,146036,2,1609,0)="""RTN"",""DVBCPUSH"",61,0)"
^XMB(3.9,146036,2,1610,0)=" ...S DVBF=DVBF_""|""_DVBI_"",""_$P(DVBERR,U,2)"
^XMB(3.9,146036,2,1611,0)="""RTN"",""DVBCPUSH"",62,0)"
^XMB(3.9,146036,2,1612,0)=" ..S DVBCNS=DVBCNS+1"
^XMB(3.9,146036,2,1613,0)="""RTN"",""DVBCPUSH"",63,0)"
^XMB(3.9,146036,2,1614,0)=" .S DVBMSG=DVBCNS_""/""_DVBCNT_"" ""_$S(DVBCNS=1:""was"",1:""were"")_"" successful""_DVBF"
^XMB(3.9,146036,2,1615,0)="""RTN"",""DVBCPUSH"",64,0)"
^XMB(3.9,146036,2,1616,0)=" I DVBTYP=""W"" D"
^XMB(3.9,146036,2,1617,0)="""RTN"",""DVBCPUSH"",65,0)"
^XMB(3.9,146036,2,1618,0)=" . S DVBLEN=$L(DVBVAL,""|"")"
^XMB(3.9,146036,2,1619,0)="""RTN"",""DVBCPUSH"",66,0)"
^XMB(3.9,146036,2,1620,0)=" . I DVBLEN>1 F DVBI=1:1:DVBLEN S DVBUPD(DVBI)=$P(DVBVAL,""|"",DVBI)"
^XMB(3.9,146036,2,1621,0)="""RTN"",""DVBCPUSH"",67,0)"
^XMB(3.9,146036,2,1622,0)=" . I DVBLEN=1,$L(DVBVAL)>250 D SPLIT(.DVBUPD,DVBVAL)"
^XMB(3.9,146036,2,1623,0)="""RTN"",""DVBCPUSH"",68,0)"
^XMB(3.9,146036,2,1624,0)=" . I DVBLEN=1,$L(DVBVAL)<250 S DVBUPD(1)=$G(DVBVAL)"
^XMB(3.9,146036,2,1625,0)="""RTN"",""DVBCPUSH"",69,0)"
^XMB(3.9,146036,2,1626,0)=" . I DVBLEN=1,$D(DVBUPD)<10 S DVBMSG=""Issue trying to split Data"" Q"
^XMB(3.9,146036,2,1627,0)="""RTN"",""DVBCPUSH"",70,0)"
^XMB(3.9,146036,2,1628,0)=" . I DVBNAME=""DVBAB CAPRI GITHUB TOKEN"" D"
^XMB(3.9,146036,2,1629,0)="""RTN"",""DVBCPUSH"",71,0)"
^XMB(3.9,146036,2,1630,0)=" . . S DVBCNT=$O(DVBUPD(""""),-1)"
^XMB(3.9,146036,2,1631,0)="""RTN"",""DVBCPUSH"",72,0)"
^XMB(3.9,146036,2,1632,0)=" . . S DVBTMP(1)=""-----BEGIN RSA PRIVATE KEY-----"""
^XMB(3.9,146036,2,1633,0)="""RTN"",""DVBCPUSH"",73,0)"
^XMB(3.9,146036,2,1634,0)=" . . F DVBI=1:1:DVBCNT S DVBTMP(DVBI+1)=DVBUPD(DVBI)"
^XMB(3.9,146036,2,1635,0)="""RTN"",""DVBCPUSH"",74,0)"
^XMB(3.9,146036,2,1636,0)=" . . S DVBTMP(DVBCNT+2)=""-----END RSA PRIVATE KEY-----"""
^XMB(3.9,146036,2,1637,0)="""RTN"",""DVBCPUSH"",75,0)"
^XMB(3.9,146036,2,1638,0)=" . . K DVBUPD M DVBUPD=DVBTMP"
^XMB(3.9,146036,2,1639,0)="""RTN"",""DVBCPUSH"",76,0)"
^XMB(3.9,146036,2,1640,0)=" . . Q "
^XMB(3.9,146036,2,1641,0)="""RTN"",""DVBCPUSH"",77,0)"
^XMB(3.9,146036,2,1642,0)=" . D EN^XPAR(""PKG"",DVBNAME,1,.DVBUPD,.DVBERR)"
^XMB(3.9,146036,2,1643,0)="""RTN"",""DVBCPUSH"",78,0)"
^XMB(3.9,146036,2,1644,0)=" . I DVBERR'=0 S DVBMSG=DVBERR Q"
^XMB(3.9,146036,2,1645,0)="""RTN"",""DVBCPUSH"",79,0)"
^XMB(3.9,146036,2,1646,0)=" . S DVBMSG=DVBNAME_"" was updated successfully"" Q"
^XMB(3.9,146036,2,1647,0)="""RTN"",""DVBCPUSH"",80,0)"
^XMB(3.9,146036,2,1648,0)=" . Q"
^XMB(3.9,146036,2,1649,0)="""RTN"",""DVBCPUSH"",81,0)"
^XMB(3.9,146036,2,1650,0)=" Q"
^XMB(3.9,146036,2,1651,0)="""RTN"",""DVBCPUSH"",82,0)"
^XMB(3.9,146036,2,1652,0)=" ;"
^XMB(3.9,146036,2,1653,0)="""RTN"",""DVBCPUSH"",83,0)"
^XMB(3.9,146036,2,1654,0)="PARADESC(DVBRTN,DVBIEN) ;"
^XMB(3.9,146036,2,1655,0)="""RTN"",""DVBCPUSH"",84,0)"
^XMB(3.9,146036,2,1656,0)=" ;RPC; DVBA CAPRI GET PAR DESC"
^XMB(3.9,146036,2,1657,0)="""RTN"",""DVBCPUSH"",85,0)"
^XMB(3.9,146036,2,1658,0)=" ;returns description for selected parameter"
^XMB(3.9,146036,2,1659,0)="""RTN"",""DVBCPUSH"",86,0)"
^XMB(3.9,146036,2,1660,0)=" N DVBX,DVBTWP,DVBERR,DVBCT,DVBRT,DVBIENS,DVBTMP"
^XMB(3.9,146036,2,1661,0)="""RTN"",""DVBCPUSH"",87,0)"
^XMB(3.9,146036,2,1662,0)=" I $G(DVBIEN)="""" S DVBRTN=""Missing Parameter IEN"" Q"
^XMB(3.9,146036,2,1663,0)="""RTN"",""DVBCPUSH"",88,0)"
^XMB(3.9,146036,2,1664,0)=" D GETS^DIQ(8989.51,DVBIEN,20,"""",""DVBTWP"",""DVBERR"")"
^XMB(3.9,146036,2,1665,0)="""RTN"",""DVBCPUSH"",89,0)"
^XMB(3.9,146036,2,1666,0)=" I $D(DVBERR) S DVBRTN=DVBERR Q"
^XMB(3.9,146036,2,1667,0)="""RTN"",""DVBCPUSH"",90,0)"
^XMB(3.9,146036,2,1668,0)=" K DVBTMP M DVBTMP=DVBTWP"
^XMB(3.9,146036,2,1669,0)="""RTN"",""DVBCPUSH"",91,0)"
^XMB(3.9,146036,2,1670,0)=" S DVBIENS=""""_DVBIEN_"","""
^XMB(3.9,146036,2,1671,0)="""RTN"",""DVBCPUSH"",92,0)"
^XMB(3.9,146036,2,1672,0)=" I $D(DVBTMP) D"
^XMB(3.9,146036,2,1673,0)="""RTN"",""DVBCPUSH"",93,0)"
^XMB(3.9,146036,2,1674,0)=" .S DVBCT="""",DVBX="""" F  S DVBX=$O(DVBTMP(8989.51,DVBIENS,20,DVBX)) Q:DVBX=""""  D"
^XMB(3.9,146036,2,1675,0)="""RTN"",""DVBCPUSH"",94,0)"
