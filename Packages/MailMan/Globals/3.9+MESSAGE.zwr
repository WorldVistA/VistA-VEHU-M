^XMB(3.9,146036,2,1705,0)="""RTN"",""DVBCPUSH"",109,0)"
^XMB(3.9,146036,2,1706,0)=" ;"
^XMB(3.9,146036,2,1707,0)="""RTN"",""DVBCPUSH"",110,0)"
^XMB(3.9,146036,2,1708,0)=" N DVBDT,DIC,X,Y,DA,DTOUT,DUOUT,DLAYGO,DVBI,DVBRPC,DVBN1,DVBAIEN,DVBNUM"
^XMB(3.9,146036,2,1709,0)="""RTN"",""DVBCPUSH"",111,0)"
^XMB(3.9,146036,2,1710,0)=" I DVBAUTH="""" S DVBRTN=""0^MISSING AUTHORIZED USER IEN"" Q"
^XMB(3.9,146036,2,1711,0)="""RTN"",""DVBCPUSH"",112,0)"
^XMB(3.9,146036,2,1712,0)=" I DVBPIEN="""" S DVBRTN=""0^MISSING PATIENT IEN"" Q"
^XMB(3.9,146036,2,1713,0)="""RTN"",""DVBCPUSH"",113,0)"
^XMB(3.9,146036,2,1714,0)=" I DVBTRANS="""" S DVBRTN=""0^MISSING TRANSMISSION PATH"" Q"
^XMB(3.9,146036,2,1715,0)="""RTN"",""DVBCPUSH"",114,0)"
^XMB(3.9,146036,2,1716,0)=" I DVBSTAT="""" S DVBRTN=""0^MISSING TRANSMISSION STATUS"" Q"
^XMB(3.9,146036,2,1717,0)="""RTN"",""DVBCPUSH"",115,0)"
^XMB(3.9,146036,2,1718,0)=" S DVBDT=$$NOW^XLFDT()"
^XMB(3.9,146036,2,1719,0)="""RTN"",""DVBCPUSH"",116,0)"
^XMB(3.9,146036,2,1720,0)=" K DIC,DIE,DR,DA"
^XMB(3.9,146036,2,1721,0)="""RTN"",""DVBCPUSH"",117,0)"
^XMB(3.9,146036,2,1722,0)=" S (DIC,DIE)=""^DVB(396.21,"",DIC(0)=""L"",DLAYGO=396.21 S X=DVBDT"
^XMB(3.9,146036,2,1723,0)="""RTN"",""DVBCPUSH"",118,0)"
^XMB(3.9,146036,2,1724,0)=" D ^DIC S DA=+Y K DIC"
^XMB(3.9,146036,2,1725,0)="""RTN"",""DVBCPUSH"",119,0)"
^XMB(3.9,146036,2,1726,0)=" I DA=-1 S DVBRTN=0 Q"
^XMB(3.9,146036,2,1727,0)="""RTN"",""DVBCPUSH"",120,0)"
^XMB(3.9,146036,2,1728,0)=" S DVBRTN=1"
^XMB(3.9,146036,2,1729,0)="""RTN"",""DVBCPUSH"",121,0)"
^XMB(3.9,146036,2,1730,0)=" S DR="".02////""_DVBAUTH_"";.03////""_DVBPIEN_"";1////""_DVBTRANS D ^DIE"
^XMB(3.9,146036,2,1731,0)="""RTN"",""DVBCPUSH"",122,0)"
^XMB(3.9,146036,2,1732,0)=" S DR=""1.1////""_DVBSTAT_"";1.2////""_DVBERR D ^DIE"
^XMB(3.9,146036,2,1733,0)="""RTN"",""DVBCPUSH"",123,0)"
^XMB(3.9,146036,2,1734,0)=" S DVBNUM=DA"
^XMB(3.9,146036,2,1735,0)="""RTN"",""DVBCPUSH"",124,0)"
^XMB(3.9,146036,2,1736,0)=" S DVBI="""" F  S DVBI=$O(DVBRPD(DVBI)) Q:DVBI=""""  D"
^XMB(3.9,146036,2,1737,0)="""RTN"",""DVBCPUSH"",125,0)"
^XMB(3.9,146036,2,1738,0)=" .S DA(1)=DVBNUM"
^XMB(3.9,146036,2,1739,0)="""RTN"",""DVBCPUSH"",126,0)"
^XMB(3.9,146036,2,1740,0)=" .S DIC=""^DVB(396.21,""_DA(1)_"",2,"",DIC(0)=""L"""
^XMB(3.9,146036,2,1741,0)="""RTN"",""DVBCPUSH"",127,0)"
^XMB(3.9,146036,2,1742,0)=" .D ^DIC S DA=+Y"
^XMB(3.9,146036,2,1743,0)="""RTN"",""DVBCPUSH"",128,0)"
^XMB(3.9,146036,2,1744,0)=" .S DIE=DIC"
^XMB(3.9,146036,2,1745,0)="""RTN"",""DVBCPUSH"",129,0)"
^XMB(3.9,146036,2,1746,0)=" .S DVBRPC=$P(DVBRPD(DVBI),U),DVBAIEN=$P(DVBRPD(DVBI),U,2)"
^XMB(3.9,146036,2,1747,0)="""RTN"",""DVBCPUSH"",130,0)"
^XMB(3.9,146036,2,1748,0)=" .S DVBN1=$P(DVBRPD(DVBI),U,3,100)"
^XMB(3.9,146036,2,1749,0)="""RTN"",""DVBCPUSH"",131,0)"
^XMB(3.9,146036,2,1750,0)=" .S DR="".01////""_DVBRPC_"";.02////""_DVBAIEN_"";.03////""_DVBN1"
^XMB(3.9,146036,2,1751,0)="""RTN"",""DVBCPUSH"",132,0)"
^XMB(3.9,146036,2,1752,0)=" .D ^DIE"
^XMB(3.9,146036,2,1753,0)="""RTN"",""DVBCPUSH"",133,0)"
^XMB(3.9,146036,2,1754,0)=" K DIC,DIE,DA,DR,DIRUT"
