^XMB(3.9,146039,2,3433,0)="""RTN"",""SDES2UNDOCHKOUT"",101,0)"
^XMB(3.9,146039,2,3434,0)=" ;"
^XMB(3.9,146039,2,3435,0)="""RTN"",""SDES2UNDOCHKOUT"",102,0)"
^XMB(3.9,146039,2,3436,0)="BEFOREEVENT(APPTSTARTTIME,DFN,CLINICIEN,APPTSUBIEN44,SDCIHDL,SDATA) ;"
^XMB(3.9,146039,2,3437,0)="""RTN"",""SDES2UNDOCHKOUT"",103,0)"
^XMB(3.9,146039,2,3438,0)=" D BEFORE^SDAMEVT(.SDATA,DFN,APPTSTARTTIME,CLINICIEN,APPTSUBIEN44,SDCIHDL)"
^XMB(3.9,146039,2,3439,0)="""RTN"",""SDES2UNDOCHKOUT"",104,0)"
^XMB(3.9,146039,2,3440,0)=" Q"
^XMB(3.9,146039,2,3441,0)="""RTN"",""SDES2UNDOCHKOUT"",105,0)"
^XMB(3.9,146039,2,3442,0)=" ;"
^XMB(3.9,146039,2,3443,0)="""RTN"",""SDES2UNDOCHKOUT"",106,0)"
^XMB(3.9,146039,2,3444,0)="AFTEREVENT(APPTSTARTTIME,DFN,CLINICIEN,APPTSUBIEN44,SDCIHDL,SDATA) ;"
^XMB(3.9,146039,2,3445,0)="""RTN"",""SDES2UNDOCHKOUT"",107,0)"
^XMB(3.9,146039,2,3446,0)=" N %,%DT,%H,%I,ANS,C,DA,DGMT,DGNOCOPF,DGWRT,DSIHCL,DSIHFS,DSPV150,EVN,FS,HL16,HL7STRG,HLA,HLECH,HLFS,HLHDR"
^XMB(3.9,146039,2,3447,0)="""RTN"",""SDES2UNDOCHKOUT"",108,0)"
^XMB(3.9,146039,2,3448,0)=" N HLN,HLPARAM,HLQ,HLSAN,HLTYPE,HLX,IEN,IVMZ10F,J,PIVOT,R,REF,S,SDLOC,VA,VACNTRY,VAERR,XQXFLG,XX,Z0,ZMID,ZTSK"
^XMB(3.9,146039,2,3449,0)="""RTN"",""SDES2UNDOCHKOUT"",109,0)"
^XMB(3.9,146039,2,3450,0)=" ; Newed all the leaking variables from EVT^SDAMEVT"
^XMB(3.9,146039,2,3451,0)="""RTN"",""SDES2UNDOCHKOUT"",110,0)"
^XMB(3.9,146039,2,3452,0)=" D AFTER^SDAMEVT(.SDATA,DFN,APPTSTARTTIME,CLINICIEN,APPTSUBIEN44,SDCIHDL)"
^XMB(3.9,146039,2,3453,0)="""RTN"",""SDES2UNDOCHKOUT"",111,0)"
^XMB(3.9,146039,2,3454,0)=" D EVT^SDAMEVT(.SDATA,5,2,SDCIHDL) ;"
^XMB(3.9,146039,2,3455,0)="""RTN"",""SDES2UNDOCHKOUT"",112,0)"
^XMB(3.9,146039,2,3456,0)=" Q"
^XMB(3.9,146039,2,3457,0)="""RTN"",""SDES2UNDOCHKOUT"",113,0)"
^XMB(3.9,146039,2,3458,0)=" ;"
^XMB(3.9,146039,2,3459,0)="""RTN"",""SDES2VAL44"")"
^XMB(3.9,146039,2,3460,0)="0^6^B209070859"
^XMB(3.9,146039,2,3461,0)="""RTN"",""SDES2VAL44"",1,0)"
^XMB(3.9,146039,2,3462,0)="SDES2VAL44 ;ALB/BWF,MGD/BLB/TAW,TJB - SDES2 Clinic validation utilities ;FEB 13, 2026"
^XMB(3.9,146039,2,3463,0)="""RTN"",""SDES2VAL44"",2,0)"
^XMB(3.9,146039,2,3464,0)=" ;;5.3;Scheduling;**853,857,864,866,871,890,914,930**;Aug 13, 1993;Build 0"
^XMB(3.9,146039,2,3465,0)="""RTN"",""SDES2VAL44"",3,0)"
^XMB(3.9,146039,2,3466,0)=" ;;Per VHA Directive 6402, this routine should not be modified"
^XMB(3.9,146039,2,3467,0)="""RTN"",""SDES2VAL44"",4,0)"
^XMB(3.9,146039,2,3468,0)=" ;"
^XMB(3.9,146039,2,3469,0)="""RTN"",""SDES2VAL44"",5,0)"
^XMB(3.9,146039,2,3470,0)=" Q"
^XMB(3.9,146039,2,3471,0)="""RTN"",""SDES2VAL44"",6,0)"
^XMB(3.9,146039,2,3472,0)=" ; ISREQUIRED - 1       = true  - this forces a clinic ien to be passed in and must be valid"
^XMB(3.9,146039,2,3473,0)="""RTN"",""SDES2VAL44"",7,0)"
^XMB(3.9,146039,2,3474,0)=" ;              0 or """" = false - the incoming value of """" will pass validation - i.e. not required"
^XMB(3.9,146039,2,3475,0)="""RTN"",""SDES2VAL44"",8,0)"
^XMB(3.9,146039,2,3476,0)=" ; ALLOWDELETE - 1      = true  - this allows '@' to be valid for deletion. """" is also valid since"
^XMB(3.9,146039,2,3477,0)="""RTN"",""SDES2VAL44"",9,0)"
^XMB(3.9,146039,2,3478,0)=" ;                                it does the same as '@' from a data perspective"
^XMB(3.9,146039,2,3479,0)="""RTN"",""SDES2VAL44"",10,0)"
^XMB(3.9,146039,2,3480,0)=" ;              0 or """" = false - '@' will not be valid"
^XMB(3.9,146039,2,3481,0)="""RTN"",""SDES2VAL44"",11,0)"
^XMB(3.9,146039,2,3482,0)="VALCLINIEN(ERRORS,SDIEN,ISREQUIRED,ALLOWDELETE) ;"
^XMB(3.9,146039,2,3483,0)="""RTN"",""SDES2VAL44"",12,0)"
^XMB(3.9,146039,2,3484,0)=" I $G(ISREQUIRED),SDIEN="""" D ERRLOG^SDES2JSON(.ERRORS,18) Q"
^XMB(3.9,146039,2,3485,0)="""RTN"",""SDES2VAL44"",13,0)"
^XMB(3.9,146039,2,3486,0)=" I '$G(ISREQUIRED),SDIEN="""" Q"
^XMB(3.9,146039,2,3487,0)="""RTN"",""SDES2VAL44"",14,0)"
^XMB(3.9,146039,2,3488,0)=" I $G(ALLOWDELETE),(SDIEN=""@"")!(SDIEN="""") Q"
^XMB(3.9,146039,2,3489,0)="""RTN"",""SDES2VAL44"",15,0)"
^XMB(3.9,146039,2,3490,0)=" I '$G(ALLOWDELETE),SDIEN=""@"" D ERRLOG^SDES2JSON(.ERRORS,229,""Clinic ID"") Q"
^XMB(3.9,146039,2,3491,0)="""RTN"",""SDES2VAL44"",16,0)"
^XMB(3.9,146039,2,3492,0)=" I '$D(^SC(SDIEN,0)) D ERRLOG^SDES2JSON(.ERRORS,19)"
^XMB(3.9,146039,2,3493,0)="""RTN"",""SDES2VAL44"",17,0)"
^XMB(3.9,146039,2,3494,0)=" Q"
^XMB(3.9,146039,2,3495,0)="""RTN"",""SDES2VAL44"",18,0)"
^XMB(3.9,146039,2,3496,0)=" ;"
^XMB(3.9,146039,2,3497,0)="""RTN"",""SDES2VAL44"",19,0)"
^XMB(3.9,146039,2,3498,0)="VALNAME(ERRORS,SDNAME,FDATA) ; required - cannot be deleted with @ or """" - can be changed"
^XMB(3.9,146039,2,3499,0)="""RTN"",""SDES2VAL44"",20,0)"
^XMB(3.9,146039,2,3500,0)=" I SDNAME=""@"" D ERRLOG^SDES2JSON(.ERRORS,229,""Clinic Name"") Q"
^XMB(3.9,146039,2,3501,0)="""RTN"",""SDES2VAL44"",21,0)"
^XMB(3.9,146039,2,3502,0)=" I SDNAME="""" D ERRLOG^SDES2JSON(.ERRORS,50) Q"
^XMB(3.9,146039,2,3503,0)="""RTN"",""SDES2VAL44"",22,0)"
^XMB(3.9,146039,2,3504,0)=" S SDNAME=$$UP^XLFSTR(SDNAME)"
^XMB(3.9,146039,2,3505,0)="""RTN"",""SDES2VAL44"",23,0)"
^XMB(3.9,146039,2,3506,0)=" I $L(SDNAME)>30!($L(SDNAME)<2)!'(SDNAME'?1P.E)!(SDNAME'?.ANP) D ERRLOG^SDES2JSON(.ERRORS,51) Q"
^XMB(3.9,146039,2,3507,0)="""RTN"",""SDES2VAL44"",24,0)"
^XMB(3.9,146039,2,3508,0)=" I SDNAME'="""",$D(^SC(""B"",$E(SDNAME,1,30))) D ERRLOG^SDES2JSON(.ERRORS,481) Q"
^XMB(3.9,146039,2,3509,0)="""RTN"",""SDES2VAL44"",25,0)"
^XMB(3.9,146039,2,3510,0)=" S FDATA(""NAME"")=SDNAME"
^XMB(3.9,146039,2,3511,0)="""RTN"",""SDES2VAL44"",26,0)"
^XMB(3.9,146039,2,3512,0)=" Q"
^XMB(3.9,146039,2,3513,0)="""RTN"",""SDES2VAL44"",27,0)"
^XMB(3.9,146039,2,3514,0)=" ;"
^XMB(3.9,146039,2,3515,0)="""RTN"",""SDES2VAL44"",28,0)"
^XMB(3.9,146039,2,3516,0)="VALABBR(ERRORS,SDABR,FDATA) ;"
^XMB(3.9,146039,2,3517,0)="""RTN"",""SDES2VAL44"",29,0)"
^XMB(3.9,146039,2,3518,0)=" I SDABR=""@"" S FDATA(""ABBREVIATION"")="""" Q"
^XMB(3.9,146039,2,3519,0)="""RTN"",""SDES2VAL44"",30,0)"
^XMB(3.9,146039,2,3520,0)=" I SDABR'="""",$L(SDABR)>7 D ERRLOG^SDES2JSON(.ERRORS,251) Q"
^XMB(3.9,146039,2,3521,0)="""RTN"",""SDES2VAL44"",31,0)"
^XMB(3.9,146039,2,3522,0)=" S FDATA(""ABBREVIATION"")=SDABR"
^XMB(3.9,146039,2,3523,0)="""RTN"",""SDES2VAL44"",32,0)"
^XMB(3.9,146039,2,3524,0)=" Q"
^XMB(3.9,146039,2,3525,0)="""RTN"",""SDES2VAL44"",33,0)"
^XMB(3.9,146039,2,3526,0)=" ;"
^XMB(3.9,146039,2,3527,0)="""RTN"",""SDES2VAL44"",34,0)"
^XMB(3.9,146039,2,3528,0)="VALPATFNAME(ERRORS,SDPATNAME,FDATA) ;"
^XMB(3.9,146039,2,3529,0)="""RTN"",""SDES2VAL44"",35,0)"
^XMB(3.9,146039,2,3530,0)=" I SDPATNAME=""@"" S FDATA(""PATIENT FRIENDLY NAME"")="""" Q"
^XMB(3.9,146039,2,3531,0)="""RTN"",""SDES2VAL44"",36,0)"
^XMB(3.9,146039,2,3532,0)=" I SDPATNAME'="""",(($L(SDPATNAME)<3)!($L(SDPATNAME)>80)) D ERRLOG^SDES2JSON(.ERRORS,482) Q"
^XMB(3.9,146039,2,3533,0)="""RTN"",""SDES2VAL44"",37,0)"
^XMB(3.9,146039,2,3534,0)=" S FDATA(""PATIENT FRIENDLY NAME"")=SDPATNAME"
^XMB(3.9,146039,2,3535,0)="""RTN"",""SDES2VAL44"",38,0)"
^XMB(3.9,146039,2,3536,0)=" Q"
^XMB(3.9,146039,2,3537,0)="""RTN"",""SDES2VAL44"",39,0)"
^XMB(3.9,146039,2,3538,0)=" ;"
^XMB(3.9,146039,2,3539,0)="""RTN"",""SDES2VAL44"",40,0)"
^XMB(3.9,146039,2,3540,0)="VALMEETATFACIL(ERRORS,SDMEETATFAC,FDATA) ; required, cannot be deleted with ""@"" or """" - can be changed"
^XMB(3.9,146039,2,3541,0)="""RTN"",""SDES2VAL44"",41,0)"
^XMB(3.9,146039,2,3542,0)=" I SDMEETATFAC=""@"" D ERRLOG^SDES2JSON(.ERRORS,229,""Clinic meets at this facility?"") Q"
^XMB(3.9,146039,2,3543,0)="""RTN"",""SDES2VAL44"",42,0)"
^XMB(3.9,146039,2,3544,0)=" ; Default to Y like SDBUILD"
^XMB(3.9,146039,2,3545,0)="""RTN"",""SDES2VAL44"",43,0)"
^XMB(3.9,146039,2,3546,0)=" I SDMEETATFAC="""" S SDMEETATFAC=""Y"""
^XMB(3.9,146039,2,3547,0)="""RTN"",""SDES2VAL44"",44,0)"
^XMB(3.9,146039,2,3548,0)=" I '$$CHECKYN^SDES2UTIL(SDMEETATFAC) D ERRLOG^SDES2JSON(.ERRORS,87) Q"
^XMB(3.9,146039,2,3549,0)="""RTN"",""SDES2VAL44"",45,0)"
^XMB(3.9,146039,2,3550,0)=" S FDATA(""MEETS AT FACILITY"")=SDMEETATFAC"
^XMB(3.9,146039,2,3551,0)="""RTN"",""SDES2VAL44"",46,0)"
^XMB(3.9,146039,2,3552,0)=" Q"
^XMB(3.9,146039,2,3553,0)="""RTN"",""SDES2VAL44"",47,0)"
^XMB(3.9,146039,2,3554,0)=" ;"
^XMB(3.9,146039,2,3555,0)="""RTN"",""SDES2VAL44"",48,0)"
^XMB(3.9,146039,2,3556,0)="VALDIRPATSCHED(ERRORS,SDPATSCHED,FDATA) ; required, cannot be deleted with ""@"" or """" - can be changed"
^XMB(3.9,146039,2,3557,0)="""RTN"",""SDES2VAL44"",49,0)"
^XMB(3.9,146039,2,3558,0)=" I SDPATSCHED=""@"" D ERRLOG^SDES2JSON(.ERRORS,229,""Direct Patient Scheduling"") Q"
^XMB(3.9,146039,2,3559,0)="""RTN"",""SDES2VAL44"",50,0)"
^XMB(3.9,146039,2,3560,0)=" I SDPATSCHED="""" D ERRLOG^SDES2JSON(.ERRORS,88) Q"
^XMB(3.9,146039,2,3561,0)="""RTN"",""SDES2VAL44"",51,0)"
^XMB(3.9,146039,2,3562,0)=" I '$$CHECKYN^SDES2UTIL(SDPATSCHED) D ERRLOG^SDES2JSON(.ERRORS,89) Q"
^XMB(3.9,146039,2,3563,0)="""RTN"",""SDES2VAL44"",52,0)"
^XMB(3.9,146039,2,3564,0)=" S FDATA(""DIRECT PATIENT SCHEDULING"")=SDPATSCHED"
^XMB(3.9,146039,2,3565,0)="""RTN"",""SDES2VAL44"",53,0)"
^XMB(3.9,146039,2,3566,0)=" Q"
^XMB(3.9,146039,2,3567,0)="""RTN"",""SDES2VAL44"",54,0)"
^XMB(3.9,146039,2,3568,0)=" ;"
^XMB(3.9,146039,2,3569,0)="""RTN"",""SDES2VAL44"",55,0)"
^XMB(3.9,146039,2,3570,0)="VALDISPAPPT(ERRORS,SDCLINIC,FDATA) ; required, cannot be deleted with ""@"" or """" - can be changed"
^XMB(3.9,146039,2,3571,0)="""RTN"",""SDES2VAL44"",56,0)"
