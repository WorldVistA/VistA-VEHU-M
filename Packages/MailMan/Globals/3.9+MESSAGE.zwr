^XMB(3.9,146037,2,1295,0)="""RTN"",""RCDPESR1"",9,0)"
^XMB(3.9,146037,2,1296,0)=" ;"
^XMB(3.9,146037,2,1297,0)="""RTN"",""RCDPESR1"",10,0)"
^XMB(3.9,146037,2,1298,0)="PERROR(RCERR,RCEMG,RCXMZ) ; Process Errors - Send bulletin to mail group"
^XMB(3.9,146037,2,1299,0)="""RTN"",""RCDPESR1"",11,0)"
^XMB(3.9,146037,2,1300,0)=" ; RCERR = Error text array"
