^XMB(3.9,146089,2,1590,0)=" ; Workload Processing Key assigned to User"
^XMB(3.9,146089,2,1591,0)="""RTN"",""PSOORFIN"",13,0)"
^XMB(3.9,146089,2,1592,0)=" I $D(^XUSEC(""PSO ERX WORKLOAD RPH"",DUZ)) D  G EX:$G(PSOIQUIT) G ALLPATS"
^XMB(3.9,146089,2,1593,0)="""RTN"",""PSOORFIN"",14,0)"
^XMB(3.9,146089,2,1594,0)=" . N DIC S DIC=""^SC("",DIC(0)=""QEAMZ"",DIC(""A"")=""Select CLINIC: """
^XMB(3.9,146089,2,1595,0)="""RTN"",""PSOORFIN"",15,0)"
^XMB(3.9,146089,2,1596,0)=" . I +$$GET1^DIQ(59,PSOSITE,10,""I"") S DIC(""B"")=$$GET1^DIQ(44,+$$GET1^DIQ(59,PSOSITE,10,""I""),.01)"
^XMB(3.9,146089,2,1597,0)="""RTN"",""PSOORFIN"",16,0)"
^XMB(3.9,146089,2,1598,0)=" . S DIC(""S"")=""I $$CHECKCLN^PSOORUT3(+$G(Y))"""
