^XMB(3.9,146037,2,2776,0)=" ;          RCEXCEL - 1 - Excel output, 0 otherwise"
^XMB(3.9,146037,2,2777,0)="""RTN"",""RCDPTAR1"",232,0)"
^XMB(3.9,146037,2,2778,0)=" N DATA,EFTIEN,LINES,RCDBAL,RCDIEN,RCHR,RCNOW,RCPG,RCSCR"
