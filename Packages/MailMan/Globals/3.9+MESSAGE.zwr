^XMB(3.9,146047,2,990,0)=" S IBDIF=0"
^XMB(3.9,146047,2,991,0)="""RTN"",""IBCNBCD2"",307,0)"
^XMB(3.9,146047,2,992,0)=" I $G(@IBSYS@(IBIEN,0))'=$G(@IBGSAV@(IBIEN,0)) S IBDIF=1 Q IBDIF"
^XMB(3.9,146047,2,993,0)="""RTN"",""IBCNBCD2"",308,0)"
^XMB(3.9,146047,2,994,0)=" I $G(@IBSYS@(IBIEN,1))'=$G(@IBGSAV@(IBIEN,1)) S IBDIF=1 Q IBDIF"
^XMB(3.9,146047,2,995,0)="""RTN"",""IBCNBCD2"",309,0)"
^XMB(3.9,146047,2,996,0)=" I $G(@IBSYS@(IBIEN,2,0))'=$G(@IBGSAV@(IBIEN,2,0)) S IBDIF=1 Q IBDIF"
^XMB(3.9,146047,2,997,0)="""RTN"",""IBCNBCD2"",310,0)"
^XMB(3.9,146047,2,998,0)=" I $D(@IBSYS@(IBIEN,2,0)) D"
^XMB(3.9,146047,2,999,0)="""RTN"",""IBCNBCD2"",311,0)"
^XMB(3.9,146047,2,1000,0)=" . F IBI=0:0 S IBI=$O(@IBSYS@(IBIEN,2,IBI)) Q:IBI'>0!(IBDIF)  I $G(@IBSYS@(IBIEN,2,IBI,0))'=$G(@IBGSAV@(IBIEN,2,IBI,0)) S IBDIF=1 Q"
^XMB(3.9,146047,2,1001,0)="""RTN"",""IBCNBCD2"",312,0)"
^XMB(3.9,146047,2,1002,0)=" Q IBDIF"
