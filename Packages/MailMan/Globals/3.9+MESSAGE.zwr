^XMB(3.9,146011,2,710,0)=" K DIR S DIR(""A"")=$P(^DD(52,99,0),""^""),DIR(0)=""52,99"""
^XMB(3.9,146011,2,711,0)="""RTN"",""PSOHLD"",131,0)"
^XMB(3.9,146011,2,712,0)=" ; A reduced set of HOLD REASON CODEs is available for Pharmacy Techs"
^XMB(3.9,146011,2,713,0)="""RTN"",""PSOHLD"",132,0)"
^XMB(3.9,146011,2,714,0)=" I '$D(^XUSEC(""PSORPH"",DUZ)) D"
