^XMB(3.9,146055,2,258,0)="PSOINST S PSOINST=$P($G(^DIC(4,+$P($G(^XMB(1,1,""XUS"")),""^"",17),99)),""^"") I Y[""-"",'$D(^PSRX($P(Y,""-"",2),0)) W !,?7,$C(7),$C(7),$C(7),""   NON-EXISTENT PRESCRIPTION"" G SPEC^PSOSUCHG:ACT=""S"" G ALL^PSOSUCHG:ACT=""A"""
