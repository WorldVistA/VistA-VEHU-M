^XMB(3.9,146084,2,3499,0)="""RTN"",""SDES2RECLLREQ2"",178,0)"
^XMB(3.9,146084,2,3500,0)=" ;"
^XMB(3.9,146084,2,3501,0)="""RTN"",""SDES2RECLLREQ2"",179,0)"
^XMB(3.9,146084,2,3502,0)="VALIDATESDCMT(ERRORS,SDCMT) ;Validate Comment"
^XMB(3.9,146084,2,3503,0)="""RTN"",""SDES2RECLLREQ2"",180,0)"
^XMB(3.9,146084,2,3504,0)=" S SDCMT=$$CLEANCMMTS^SDES2APPTUTIL(SDCMT)"
