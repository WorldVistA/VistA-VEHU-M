^XMB(3.9,146089,2,1942,0)=" I '$D(^PS(52.41,ORD,0)) K PSOMSG Q"
^XMB(3.9,146089,2,1943,0)="""RTN"",""PSOORFIN"",189,0)"
^XMB(3.9,146089,2,1944,0)=" ;628 Add below line"
^XMB(3.9,146089,2,1945,0)="""RTN"",""PSOORFIN"",190,0)"
^XMB(3.9,146089,2,1946,0)=" I $P($G(^PS(52.41,ORD,0)),""^"",3)=""DC""!($P($G(^PS(52.41,ORD,0)),""^"",3)=""DE"") W !!,""This Order had been Discontinued."",$C(7),! K DIR S DIR(0)=""E"",DIR(""A"")=""Press Return to Continue"" D ^DIR K DIR Q"
^XMB(3.9,146089,2,1947,0)="""RTN"",""PSOORFIN"",191,0)"
^XMB(3.9,146089,2,1948,0)=" K DRET,SIG,PSOPRC,PHI,PRC,PSOSIGFL,OBX,PSOMSG,PSOFOERR S OR0=^PS(52.41,ORD,0),PSOTITRF=$G(^PS(52.41,ORD,""TIT""))"
^XMB(3.9,146089,2,1949,0)="""RTN"",""PSOORFIN"",192,0)"
^XMB(3.9,146089,2,1950,0)=" I $P(OR0,""^"",24),($P(OR0,""^"",3)=""RNW""!($P(OR0,""^"",3)=""NW"")) N PKI,PKI1,PKIR,PKIE,PKID S PKI=0 D CER^PSOPKIV1 I PKI<1 D UL1^PSOORFI3 K OR0 Q"
