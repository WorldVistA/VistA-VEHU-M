^XMB(3.9,146044,2,239,0)="""RTN"",""PRCABJ"")"
^XMB(3.9,146044,2,240,0)="0^1^B61989759"
^XMB(3.9,146044,2,241,0)="""RTN"",""PRCABJ"",1,0)"
^XMB(3.9,146044,2,242,0)="PRCABJ ;WASH-ISC@ALTOONA,PA/LDB,TJK - NIGHTLY PROCESS FOR ACCOUNTS RECEIVABLE ;11/8/96  3:54 PM"
^XMB(3.9,146044,2,243,0)="""RTN"",""PRCABJ"",2,0)"
^XMB(3.9,146044,2,244,0)=" ;;4.5;Accounts Receivable;**11,34,101,114,155,153,141,165,167,173,201,237,304,301,378,400,447**;Mar 20, 1995;Build 0"
^XMB(3.9,146044,2,245,0)="""RTN"",""PRCABJ"",3,0)"
^XMB(3.9,146044,2,246,0)=" ;Per VA Directive 6402, this routine should not be modified."
^XMB(3.9,146044,2,247,0)="""RTN"",""PRCABJ"",4,0)"
^XMB(3.9,146044,2,248,0)=" ;"
^XMB(3.9,146044,2,249,0)="""RTN"",""PRCABJ"",5,0)"
^XMB(3.9,146044,2,250,0)=" ;This routine is called by the PRCA NIGHTLY PROCESS option which should be run nightly to call the following tasks"
^XMB(3.9,146044,2,251,0)="""RTN"",""PRCABJ"",6,0)"
^XMB(3.9,146044,2,252,0)=" ;1) Update of interest/admin charges on patients' accounts"
^XMB(3.9,146044,2,253,0)="""RTN"",""PRCABJ"",7,0)"
^XMB(3.9,146044,2,254,0)=" ;2) Update statement days"
^XMB(3.9,146044,2,255,0)="""RTN"",""PRCABJ"",8,0)"
^XMB(3.9,146044,2,256,0)=" ;3) Print of Patient Statements, Uniform Billing forms, and non-patient follow-up letters"
^XMB(3.9,146044,2,257,0)="""RTN"",""PRCABJ"",9,0)"
^XMB(3.9,146044,2,258,0)=" ;4) Purge of Receipts"
^XMB(3.9,146044,2,259,0)="""RTN"",""PRCABJ"",10,0)"
^XMB(3.9,146044,2,260,0)=" ;5) Creation of TOP (Treasury Offset Program) documents"
^XMB(3.9,146044,2,261,0)="""RTN"",""PRCABJ"",11,0)"
^XMB(3.9,146044,2,262,0)=" ;6) Creation of Cross-Servicing (Treasury Cross-Servicing Project) documents"
^XMB(3.9,146044,2,263,0)="""RTN"",""PRCABJ"",12,0)"
^XMB(3.9,146044,2,264,0)=" ;7) Print of the Follow-up list"
^XMB(3.9,146044,2,265,0)="""RTN"",""PRCABJ"",13,0)"
^XMB(3.9,146044,2,266,0)=" ;8) Purge AR Events"
^XMB(3.9,146044,2,267,0)="""RTN"",""PRCABJ"",14,0)"
^XMB(3.9,146044,2,268,0)=" ;9) Flag prepayments for refund review"
^XMB(3.9,146044,2,269,0)="""RTN"",""PRCABJ"",15,0)"
^XMB(3.9,146044,2,270,0)=" ;10) Print Comment List"
^XMB(3.9,146044,2,271,0)="""RTN"",""PRCABJ"",16,0)"
^XMB(3.9,146044,2,272,0)=" ;11) Starts the Repayment Plan Monitor"
^XMB(3.9,146044,2,273,0)="""RTN"",""PRCABJ"",17,0)"
^XMB(3.9,146044,2,274,0)=" ;12) Generates Diagnostic Measures Workload Reports"
^XMB(3.9,146044,2,275,0)="""RTN"",""PRCABJ"",18,0)"
^XMB(3.9,146044,2,276,0)=" ;13) Matches EFT with ERA"
^XMB(3.9,146044,2,277,0)="""RTN"",""PRCABJ"",19,0)"
^XMB(3.9,146044,2,278,0)=" ;14) Generates CBO Data Extract files for Boston ARC - Removed by PRCA*4.5*447 (Extract sunsetted)"
^XMB(3.9,146044,2,279,0)="""RTN"",""PRCABJ"",20,0)"
^XMB(3.9,146044,2,280,0)=" ;15) Auto-audit of Paper Bills"
^XMB(3.9,146044,2,281,0)="""RTN"",""PRCABJ"",21,0)"
^XMB(3.9,146044,2,282,0)=" ;16) Generate the AR Diagnostic Measures Statistical Reports (for a defined period)"
^XMB(3.9,146044,2,283,0)="""RTN"",""PRCABJ"",22,0)"
^XMB(3.9,146044,2,284,0)=" ;17) Auto Updates Repayment Plans"
^XMB(3.9,146044,2,285,0)="""RTN"",""PRCABJ"",23,0)"
^XMB(3.9,146044,2,286,0)=" ;18) Clean out older AR Metrics data."
^XMB(3.9,146044,2,287,0)="""RTN"",""PRCABJ"",24,0)"
^XMB(3.9,146044,2,288,0)=" ;"
^XMB(3.9,146044,2,289,0)="""RTN"",""PRCABJ"",25,0)"
^XMB(3.9,146044,2,290,0)=" ;Process will first check and Validate AR pointer files 341.1,"
^XMB(3.9,146044,2,291,0)="""RTN"",""PRCABJ"",26,0)"
^XMB(3.9,146044,2,292,0)=" ;430.2, and 430.3."
^XMB(3.9,146044,2,293,0)="""RTN"",""PRCABJ"",27,0)"
^XMB(3.9,146044,2,294,0)=" ;Process will terminate and send bulletin if files are not valid"
^XMB(3.9,146044,2,295,0)="""RTN"",""PRCABJ"",28,0)"
^XMB(3.9,146044,2,296,0)=" ;"
^XMB(3.9,146044,2,297,0)="""RTN"",""PRCABJ"",29,0)"
^XMB(3.9,146044,2,298,0)="EN ;Start of nightly process-check to see if process is already running"
^XMB(3.9,146044,2,299,0)="""RTN"",""PRCABJ"",30,0)"
^XMB(3.9,146044,2,300,0)=" L +^RC(""PRCABJ""):5 Q:'$T"
^XMB(3.9,146044,2,301,0)="""RTN"",""PRCABJ"",31,0)"
^XMB(3.9,146044,2,302,0)=" NEW ERROR S ERROR=0"
^XMB(3.9,146044,2,303,0)="""RTN"",""PRCABJ"",32,0)"
^XMB(3.9,146044,2,304,0)=" D VERIFY I ERROR L -^RC(""PRCABJ"") Q"
^XMB(3.9,146044,2,305,0)="""RTN"",""PRCABJ"",33,0)"
^XMB(3.9,146044,2,306,0)=" ;"
^XMB(3.9,146044,2,307,0)="""RTN"",""PRCABJ"",34,0)"
^XMB(3.9,146044,2,308,0)="DRIVER ;All processes are called from this point"
^XMB(3.9,146044,2,309,0)="""RTN"",""PRCABJ"",35,0)"
^XMB(3.9,146044,2,310,0)=" N CHK,POP,% S CHK=0"
^XMB(3.9,146044,2,311,0)="""RTN"",""PRCABJ"",36,0)"
^XMB(3.9,146044,2,312,0)=" D CHK,RECALL,CHK,INT,CHK,RPP,CHK,EN^RCCPCBJ,CHK,STM,CHK,RECPT,CHK,TOP,CHK,TCSP,CHK,EVNT,CHK,BNUM  ; PRCA*4.5*400"
^XMB(3.9,146044,2,313,0)="""RTN"",""PRCABJ"",37,0)"
^XMB(3.9,146044,2,314,0)=" D CHK,ENUM,CHK,PURFMS,CHK,EN3^RCFMOBR,CHK,START^RCRJR,CHK,UB"
^XMB(3.9,146044,2,315,0)="""RTN"",""PRCABJ"",38,0)"
^XMB(3.9,146044,2,316,0)=" D CHK,STATMNT,CHK,UDLIST^PRCABJ1,CHK,LIST,CHK,COMMENT  ; PRCA*4.5*400 removed call to REPAY tag"
^XMB(3.9,146044,2,317,0)="""RTN"",""PRCABJ"",39,0)"
^XMB(3.9,146044,2,318,0)=" D CHK,WRKLD,CHK,EFT,CHK,ABAUDIT,CHK,ARDM,CHK,CLNMTR  ; PRCA*4.5*447 removed call to CBO tag"
^XMB(3.9,146044,2,319,0)="""RTN"",""PRCABJ"",40,0)"
^XMB(3.9,146044,2,320,0)=" D NOW^%DTC S $P(^RC(342,1,0),""^"",10)=%"
^XMB(3.9,146044,2,321,0)="""RTN"",""PRCABJ"",41,0)"
^XMB(3.9,146044,2,322,0)=" L -^RC(""PRCABJ"")"
^XMB(3.9,146044,2,323,0)="""RTN"",""PRCABJ"",42,0)"
^XMB(3.9,146044,2,324,0)=" K ^RC(""PRCABJ"")"
^XMB(3.9,146044,2,325,0)="""RTN"",""PRCABJ"",43,0)"
^XMB(3.9,146044,2,326,0)=" Q"
^XMB(3.9,146044,2,327,0)="""RTN"",""PRCABJ"",44,0)"
^XMB(3.9,146044,2,328,0)=" ;"
^XMB(3.9,146044,2,329,0)="""RTN"",""PRCABJ"",45,0)"
^XMB(3.9,146044,2,330,0)="CHK ;checkpoint of process"
^XMB(3.9,146044,2,331,0)="""RTN"",""PRCABJ"",46,0)"
^XMB(3.9,146044,2,332,0)=" S CHK=CHK+1 S ^RC(""PRCABJ"")=CHK"
^XMB(3.9,146044,2,333,0)="""RTN"",""PRCABJ"",47,0)"
^XMB(3.9,146044,2,334,0)=" Q"
^XMB(3.9,146044,2,335,0)="""RTN"",""PRCABJ"",48,0)"
^XMB(3.9,146044,2,336,0)=" ;"
^XMB(3.9,146044,2,337,0)="""RTN"",""PRCABJ"",49,0)"
^XMB(3.9,146044,2,338,0)="VERIFY ;Verifies Pointer Files--Will HALT Process if Pointer Files Invalid"
^XMB(3.9,146044,2,339,0)="""RTN"",""PRCABJ"",50,0)"
^XMB(3.9,146044,2,340,0)=" NEW A,B,FILE"
^XMB(3.9,146044,2,341,0)="""RTN"",""PRCABJ"",51,0)"
^XMB(3.9,146044,2,342,0)=" F FILE=341.1,430.2,430.3 D  Q:ERROR"
^XMB(3.9,146044,2,343,0)="""RTN"",""PRCABJ"",52,0)"
^XMB(3.9,146044,2,344,0)="    .S A=$S(FILE=341.1:""AC;0;2"",FILE=430.2:""AC;0;7"",1:""AC;0;3"")"
^XMB(3.9,146044,2,345,0)="""RTN"",""PRCABJ"",53,0)"
^XMB(3.9,146044,2,346,0)="    .S B=$S(FILE=341.1:"""",1:""C;0;2"")"
^XMB(3.9,146044,2,347,0)="""RTN"",""PRCABJ"",54,0)"
^XMB(3.9,146044,2,348,0)="    .D EN1^PRCABJV(FILE,A,B,.ERROR)"
^XMB(3.9,146044,2,349,0)="""RTN"",""PRCABJ"",55,0)"
^XMB(3.9,146044,2,350,0)="    .Q:'ERROR"
^XMB(3.9,146044,2,351,0)="""RTN"",""PRCABJ"",56,0)"
^XMB(3.9,146044,2,352,0)="    .;SEND BULLETIN HERE IF FILE IN ERROR"
^XMB(3.9,146044,2,353,0)="""RTN"",""PRCABJ"",57,0)"
^XMB(3.9,146044,2,354,0)="    .NEW XMB,XMTEXT,XMDUZ"
^XMB(3.9,146044,2,355,0)="""RTN"",""PRCABJ"",58,0)"
^XMB(3.9,146044,2,356,0)="    .S XMDUZ=""ACCOUNTS RECEIVABLE PACKAGE"""
^XMB(3.9,146044,2,357,0)="""RTN"",""PRCABJ"",59,0)"
^XMB(3.9,146044,2,358,0)="    .S XMB=""PRCA NIGHTLY PROCESS ABORT"""
^XMB(3.9,146044,2,359,0)="""RTN"",""PRCABJ"",60,0)"
^XMB(3.9,146044,2,360,0)="    .S XMTEXT=""ERROR("""
^XMB(3.9,146044,2,361,0)="""RTN"",""PRCABJ"",61,0)"
^XMB(3.9,146044,2,362,0)="    .D ^XMB"
^XMB(3.9,146044,2,363,0)="""RTN"",""PRCABJ"",62,0)"
^XMB(3.9,146044,2,364,0)="    .Q"
^XMB(3.9,146044,2,365,0)="""RTN"",""PRCABJ"",63,0)"
^XMB(3.9,146044,2,366,0)=" Q"
^XMB(3.9,146044,2,367,0)="""RTN"",""PRCABJ"",64,0)"
^XMB(3.9,146044,2,368,0)=" ;"
^XMB(3.9,146044,2,369,0)="""RTN"",""PRCABJ"",65,0)"
^XMB(3.9,146044,2,370,0)="INT ;  update interest and admin charges for non-benefit debts"
^XMB(3.9,146044,2,371,0)="""RTN"",""PRCABJ"",66,0)"
^XMB(3.9,146044,2,372,0)=" ;  example: vendor, employee, ex-employee"
^XMB(3.9,146044,2,373,0)="""RTN"",""PRCABJ"",67,0)"
^XMB(3.9,146044,2,374,0)=" D NONBENE^RCBECHGS"
^XMB(3.9,146044,2,375,0)="""RTN"",""PRCABJ"",68,0)"
^XMB(3.9,146044,2,376,0)=" Q"
^XMB(3.9,146044,2,377,0)="""RTN"",""PRCABJ"",69,0)"
^XMB(3.9,146044,2,378,0)=" ;"
^XMB(3.9,146044,2,379,0)="""RTN"",""PRCABJ"",70,0)"
^XMB(3.9,146044,2,380,0)="STM ;Update statement days for PERSONS, VENDORS, and Institutions"
^XMB(3.9,146044,2,381,0)="""RTN"",""PRCABJ"",71,0)"
^XMB(3.9,146044,2,382,0)=" D STM^PRCABJ1"
^XMB(3.9,146044,2,383,0)="""RTN"",""PRCABJ"",72,0)"
^XMB(3.9,146044,2,384,0)=" Q"
^XMB(3.9,146044,2,385,0)="""RTN"",""PRCABJ"",73,0)"
^XMB(3.9,146044,2,386,0)=" ;"
^XMB(3.9,146044,2,387,0)="""RTN"",""PRCABJ"",74,0)"
^XMB(3.9,146044,2,388,0)="STATMNT ;Print patient statements"
^XMB(3.9,146044,2,389,0)="""RTN"",""PRCABJ"",75,0)"
^XMB(3.9,146044,2,390,0)=" N IOP,ZTIO,ZTSAVE,ZTRTN,ZTDESC,ZTASK,%ZIS,ZTDTH,PRCADEV"
^XMB(3.9,146044,2,391,0)="""RTN"",""PRCABJ"",76,0)"
^XMB(3.9,146044,2,392,0)=" S (IOP,PRCADEV)=$P($G(^RC(342,1,0)),""^"",8)"
^XMB(3.9,146044,2,393,0)="""RTN"",""PRCABJ"",77,0)"
^XMB(3.9,146044,2,394,0)=" I IOP]"""" D"
^XMB(3.9,146044,2,395,0)="""RTN"",""PRCABJ"",78,0)"
^XMB(3.9,146044,2,396,0)=" .S ZTRTN=""PRCAGS"",ZTDTH=$H,ZTDESC=""Print AR Statements/Letters"""
^XMB(3.9,146044,2,397,0)="""RTN"",""PRCABJ"",79,0)"
^XMB(3.9,146044,2,398,0)=" .S %ZIS=""N0"" D ^%ZIS Q:POP"
^XMB(3.9,146044,2,399,0)="""RTN"",""PRCABJ"",80,0)"
^XMB(3.9,146044,2,400,0)=" .S ZTSAVE(""PRCADEV"")="""" D ^%ZTLOAD,^%ZISC"
^XMB(3.9,146044,2,401,0)="""RTN"",""PRCABJ"",81,0)"
^XMB(3.9,146044,2,402,0)=" Q"
^XMB(3.9,146044,2,403,0)="""RTN"",""PRCABJ"",82,0)"
^XMB(3.9,146044,2,404,0)=" ;"
^XMB(3.9,146044,2,405,0)="""RTN"",""PRCABJ"",83,0)"
^XMB(3.9,146044,2,406,0)="RECPT ;Manage Receipts and Deposits"
^XMB(3.9,146044,2,407,0)="""RTN"",""PRCABJ"",84,0)"
^XMB(3.9,146044,2,408,0)=" N IOP,ZTIO,ZTSAVE,ZTRTN,ZTDESC,ZTASK,%ZIS,ZTDTH"
^XMB(3.9,146044,2,409,0)="""RTN"",""PRCABJ"",85,0)"
^XMB(3.9,146044,2,410,0)=" S ZTIO="""",ZTRTN=""MAN^RCDPUT"",ZTDTH=$H,ZTDESC=""Manage Receipts and Deposits"""
^XMB(3.9,146044,2,411,0)="""RTN"",""PRCABJ"",86,0)"
^XMB(3.9,146044,2,412,0)=" D ^%ZTLOAD"
^XMB(3.9,146044,2,413,0)="""RTN"",""PRCABJ"",87,0)"
^XMB(3.9,146044,2,414,0)=" Q"
^XMB(3.9,146044,2,415,0)="""RTN"",""PRCABJ"",88,0)"
^XMB(3.9,146044,2,416,0)=" ;"
^XMB(3.9,146044,2,417,0)="""RTN"",""PRCABJ"",89,0)"
^XMB(3.9,146044,2,418,0)="TOP ;Transmit TOP documents"
^XMB(3.9,146044,2,419,0)="""RTN"",""PRCABJ"",90,0)"
^XMB(3.9,146044,2,420,0)=" Q:$$DOW^XLFDT(DT,1)'=1"
^XMB(3.9,146044,2,421,0)="""RTN"",""PRCABJ"",91,0)"
^XMB(3.9,146044,2,422,0)=" I DT'<$P($G(^RC(342,1,30)),""^"",1)&(DT'>$P($G(^RC(342,1,30)),""^"",2)) D ^RCEXINAD"
^XMB(3.9,146044,2,423,0)="""RTN"",""PRCABJ"",92,0)"
^XMB(3.9,146044,2,424,0)=" N RCM,RCDOC"
^XMB(3.9,146044,2,425,0)="""RTN"",""PRCABJ"",93,0)"
^XMB(3.9,146044,2,426,0)=" ;Run of TOP documents every Monday"
^XMB(3.9,146044,2,427,0)="""RTN"",""PRCABJ"",94,0)"
^XMB(3.9,146044,2,428,0)=" I +$E(DT,6,7)>7,$E(DT,6,7)<15 S RCM=1"
^XMB(3.9,146044,2,429,0)="""RTN"",""PRCABJ"",95,0)"
^XMB(3.9,146044,2,430,0)=" I '$D(^RCD(340,""TOP"")),'$G(RCM) Q"
^XMB(3.9,146044,2,431,0)="""RTN"",""PRCABJ"",96,0)"
^XMB(3.9,146044,2,432,0)=" S RCDOC=$S($G(RCM):""M"",1:""U"")"
^XMB(3.9,146044,2,433,0)="""RTN"",""PRCABJ"",97,0)"
^XMB(3.9,146044,2,434,0)=" I $E(DT,4,5)=12,RCDOC=""M"" S RCDOC=""Y"""
^XMB(3.9,146044,2,435,0)="""RTN"",""PRCABJ"",98,0)"
^XMB(3.9,146044,2,436,0)="TOPQUE N ZTDESC,ZTASK,ZTDTH,ZTIO,ZTRTN,ARDUZ,ZTSAVE"
^XMB(3.9,146044,2,437,0)="""RTN"",""PRCABJ"",99,0)"
^XMB(3.9,146044,2,438,0)=" S ZTIO="""",ZTRTN=""^RCTOPD"",ZTSAVE(""RCDOC"")="""""
^XMB(3.9,146044,2,439,0)="""RTN"",""PRCABJ"",100,0)"
^XMB(3.9,146044,2,440,0)=" S ZTDESC=""TOP REFERRAL DOCUMENTS"",ZTDTH=$H"
^XMB(3.9,146044,2,441,0)="""RTN"",""PRCABJ"",101,0)"
^XMB(3.9,146044,2,442,0)=" D ^%ZTLOAD"
^XMB(3.9,146044,2,443,0)="""RTN"",""PRCABJ"",102,0)"
^XMB(3.9,146044,2,444,0)=" Q"
^XMB(3.9,146044,2,445,0)="""RTN"",""PRCABJ"",103,0)"
^XMB(3.9,146044,2,446,0)=" ;"
