^XMB(3.9,146035,2,331,0)="""RTN"",""PSOBBC"",46,0)"
^XMB(3.9,146035,2,332,0)=" D:'$P($G(PSOPAR),""^"",6) EARLY G:PSOBBC(""QFLG"") ASKX"
^XMB(3.9,146035,2,333,0)="""RTN"",""PSOBBC"",47,0)"
^XMB(3.9,146035,2,334,0)=" D SET"
^XMB(3.9,146035,2,335,0)="""RTN"",""PSOBBC"",48,0)"
^XMB(3.9,146035,2,336,0)=" D:PSOBBC1(""FROM"")=""NEW"" NOORE^PSONEW(.PSOBBC) S:$G(PSOBBC(""NOO""))'="""" PSOBBCNO=$G(PSOBBC(""NOO"")) S:$G(PSOBBC(""DFLG"")) PSOBBC(""QFLG"")=1"
^XMB(3.9,146035,2,337,0)="""RTN"",""PSOBBC"",49,0)"
^XMB(3.9,146035,2,338,0)="ASKX Q"
^XMB(3.9,146035,2,339,0)="""RTN"",""PSOBBC"",50,0)"
^XMB(3.9,146035,2,340,0)=" ;"
^XMB(3.9,146035,2,341,0)="""RTN"",""PSOBBC"",51,0)"
^XMB(3.9,146035,2,342,0)="SUSP ;"
^XMB(3.9,146035,2,343,0)="""RTN"",""PSOBBC"",52,0)"
^XMB(3.9,146035,2,344,0)=" S DIR(0)=""SAB^Q:QUEUED;S:SUSPENDED"""
^XMB(3.9,146035,2,345,0)="""RTN"",""PSOBBC"",53,0)"
