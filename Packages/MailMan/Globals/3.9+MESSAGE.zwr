^XMB(3.9,146057,2,181,0)="""QUES"",""XPF2"",""A"")"
^XMB(3.9,146057,2,182,0)="Want my data |FLAG| yours"
^XMB(3.9,146057,2,183,0)="""QUES"",""XPF2"",""B"")"
