^XMB(3.9,146040,2,2288,0)="  4. HospLocID - (required) Hospital Location ID - pointer to the"
^XMB(3.9,146040,2,2289,0)="""KRN"",8994,3671,2,1,1,12,0)"
^XMB(3.9,146040,2,2290,0)="                        HOSPITAL LOCATION file 44"
