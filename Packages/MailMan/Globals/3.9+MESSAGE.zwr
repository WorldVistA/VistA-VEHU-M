^XMB(3.9,146052,2,590,0)=" N DFN,DIR,DIROUT,DIRUT,DTOUT,DUOUT,FTP,%ZIS,POP,X,Y"
^XMB(3.9,146052,2,591,0)="""RTN"",""FBAAAUDR"",16,0)"
^XMB(3.9,146052,2,592,0)=" ;"
^XMB(3.9,146052,2,593,0)="""RTN"",""FBAAAUDR"",17,0)"
^XMB(3.9,146052,2,594,0)=" ; ask patient"
^XMB(3.9,146052,2,595,0)="""RTN"",""FBAAAUDR"",18,0)"
^XMB(3.9,146052,2,596,0)=" S DFN=$$ASKVET^FBAAUTL1()"
^XMB(3.9,146052,2,597,0)="""RTN"",""FBAAAUDR"",19,0)"
^XMB(3.9,146052,2,598,0)=" G:'DFN EXIT"
^XMB(3.9,146052,2,599,0)="""RTN"",""FBAAAUDR"",20,0)"
^XMB(3.9,146052,2,600,0)=" ;"
^XMB(3.9,146052,2,601,0)="""RTN"",""FBAAAUDR"",21,0)"
^XMB(3.9,146052,2,602,0)=" ; ask authorization"
^XMB(3.9,146052,2,603,0)="""RTN"",""FBAAAUDR"",22,0)"
^XMB(3.9,146052,2,604,0)=" D GETAUTH^FBAAUTL1"
^XMB(3.9,146052,2,605,0)="""RTN"",""FBAAAUDR"",23,0)"
^XMB(3.9,146052,2,606,0)=" G:$G(FTP)="""" EXIT"
^XMB(3.9,146052,2,607,0)="""RTN"",""FBAAAUDR"",24,0)"
^XMB(3.9,146052,2,608,0)=" ;"
^XMB(3.9,146052,2,609,0)="""RTN"",""FBAAAUDR"",25,0)"
^XMB(3.9,146052,2,610,0)=" ; ask device"
^XMB(3.9,146052,2,611,0)="""RTN"",""FBAAAUDR"",26,0)"
^XMB(3.9,146052,2,612,0)=" S %ZIS=""Q"" D ^%ZIS G:POP EXIT"
^XMB(3.9,146052,2,613,0)="""RTN"",""FBAAAUDR"",27,0)"
^XMB(3.9,146052,2,614,0)=" I $D(IO(""Q"")) D  G EXIT"
^XMB(3.9,146052,2,615,0)="""RTN"",""FBAAAUDR"",28,0)"
^XMB(3.9,146052,2,616,0)=" . N ZTRTN,ZTDESC,ZTDTH,ZTIO,ZTUCI,ZTCPU,ZTPRI,ZTSAVE,ZTKIL,ZTSYNC,ZTSK"
^XMB(3.9,146052,2,617,0)="""RTN"",""FBAAAUDR"",29,0)"
^XMB(3.9,146052,2,618,0)=" . S ZTRTN=""QEN^FBAAAUDR"",ZTDESC=""Historical Authorization Data Report"""
^XMB(3.9,146052,2,619,0)="""RTN"",""FBAAAUDR"",30,0)"
^XMB(3.9,146052,2,620,0)=" . F FBX=""DFN"",""FTP"" S ZTSAVE(FBX)="""""
^XMB(3.9,146052,2,621,0)="""RTN"",""FBAAAUDR"",31,0)"
^XMB(3.9,146052,2,622,0)=" . D ^%ZTLOAD,HOME^%ZIS"
^XMB(3.9,146052,2,623,0)="""RTN"",""FBAAAUDR"",32,0)"
^XMB(3.9,146052,2,624,0)=" ;"
^XMB(3.9,146052,2,625,0)="""RTN"",""FBAAAUDR"",33,0)"
^XMB(3.9,146052,2,626,0)="QEN ; queued entry point"
^XMB(3.9,146052,2,627,0)="""RTN"",""FBAAAUDR"",34,0)"
^XMB(3.9,146052,2,628,0)=" N %"
^XMB(3.9,146052,2,629,0)="""RTN"",""FBAAAUDR"",35,0)"
^XMB(3.9,146052,2,630,0)=" ;"
^XMB(3.9,146052,2,631,0)="""RTN"",""FBAAAUDR"",36,0)"
^XMB(3.9,146052,2,632,0)=" U IO"
^XMB(3.9,146052,2,633,0)="""RTN"",""FBAAAUDR"",37,0)"
^XMB(3.9,146052,2,634,0)=" ;"
^XMB(3.9,146052,2,635,0)="""RTN"",""FBAAAUDR"",38,0)"
^XMB(3.9,146052,2,636,0)=" S FBQUIT=0"
^XMB(3.9,146052,2,637,0)="""RTN"",""FBAAAUDR"",39,0)"
^XMB(3.9,146052,2,638,0)=" D NOW^%DTC S Y=% D DD^%DT S FBDTR=Y"
^XMB(3.9,146052,2,639,0)="""RTN"",""FBAAAUDR"",40,0)"
^XMB(3.9,146052,2,640,0)=" ;"
^XMB(3.9,146052,2,641,0)="""RTN"",""FBAAAUDR"",41,0)"
^XMB(3.9,146052,2,642,0)=" I $E(IOST,1,2)=""C-"" W @IOF"
^XMB(3.9,146052,2,643,0)="""RTN"",""FBAAAUDR"",42,0)"
^XMB(3.9,146052,2,644,0)=" W !,""Historical Authorization Data Report"",?49,FBDTR"
^XMB(3.9,146052,2,645,0)="""RTN"",""FBAAAUDR"",43,0)"
^XMB(3.9,146052,2,646,0)=" ;"
^XMB(3.9,146052,2,647,0)="""RTN"",""FBAAAUDR"",44,0)"
^XMB(3.9,146052,2,648,0)=" ; display patient"
^XMB(3.9,146052,2,649,0)="""RTN"",""FBAAAUDR"",45,0)"
^XMB(3.9,146052,2,650,0)=" W !,""Patient: "",$$GET1^DIQ(161,DFN_"","",.01)"
^XMB(3.9,146052,2,651,0)="""RTN"",""FBAAAUDR"",46,0)"
^XMB(3.9,146052,2,652,0)=" W ""   Pt.ID: "",$$SSN^FBAAUTL(DFN),!"
^XMB(3.9,146052,2,653,0)="""RTN"",""FBAAAUDR"",47,0)"
^XMB(3.9,146052,2,654,0)=" ;"
^XMB(3.9,146052,2,655,0)="""RTN"",""FBAAAUDR"",48,0)"
^XMB(3.9,146052,2,656,0)=" ; display current authorization data"
^XMB(3.9,146052,2,657,0)="""RTN"",""FBAAAUDR"",49,0)"
^XMB(3.9,146052,2,658,0)=" W !,""Current Authorization Data: """
^XMB(3.9,146052,2,659,0)="""RTN"",""FBAAAUDR"",50,0)"
^XMB(3.9,146052,2,660,0)=" S DIC=""^FBAAA(""_DFN_"",1,"",DA(1)=DFN,DA=FTP,DR=""0:LOG"""
^XMB(3.9,146052,2,661,0)="""RTN"",""FBAAAUDR"",51,0)"
^XMB(3.9,146052,2,662,0)=" D EN^DIQ"
^XMB(3.9,146052,2,663,0)="""RTN"",""FBAAAUDR"",52,0)"
^XMB(3.9,146052,2,664,0)=" ;"
^XMB(3.9,146052,2,665,0)="""RTN"",""FBAAAUDR"",53,0)"
^XMB(3.9,146052,2,666,0)=" I $E(IOST,1,2)=""C-"",IOSL<($Y+18) S DIR(0)=""E"" D ^DIR K DIR I 'Y S FBQUIT=1"
^XMB(3.9,146052,2,667,0)="""RTN"",""FBAAAUDR"",54,0)"
^XMB(3.9,146052,2,668,0)=" ;"
^XMB(3.9,146052,2,669,0)="""RTN"",""FBAAAUDR"",55,0)"
