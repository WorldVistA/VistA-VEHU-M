^XMB(3.9,146098,2,209,0)="""KRN"",8994,4471,2,1,1,0)"
^XMB(3.9,146098,2,210,0)="^^10^10^3240618^"
^XMB(3.9,146098,2,211,0)="""KRN"",8994,4471,2,1,1,1,0)"
^XMB(3.9,146098,2,212,0)=" SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number."
^XMB(3.9,146098,2,213,0)="""KRN"",8994,4471,2,1,1,2,0)"
^XMB(3.9,146098,2,214,0)="                           Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XMB(3.9,146098,2,215,0)="""KRN"",8994,4471,2,1,1,3,0)"
^XMB(3.9,146098,2,216,0)=" SDCONTEXT(""USER DUZ"")   = The DUZ of the user taking action on the"
