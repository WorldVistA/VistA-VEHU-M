^XMB(3.9,146015,2,299,0)="""RTN"",""PSODEM"",26,0)"
^XMB(3.9,146015,2,300,0)=" S (WT,HT)="""",X=""GMRVUTL"" X ^%ZOSF(""TEST"") I $T D"
^XMB(3.9,146015,2,301,0)="""RTN"",""PSODEM"",27,0)"
^XMB(3.9,146015,2,302,0)=" .F GMRVSTR=""WT"",""HT"" S VM=GMRVSTR D EN6^GMRVUTL S @VM=X,$P(@VM,""^"")=$E($P(@VM,""^""),4,5)_""/""_$E($P(@VM,""^""),6,7)_""/""_($E($P(@VM,""^""),1,3)+1700)"
