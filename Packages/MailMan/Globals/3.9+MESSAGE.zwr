^XMB(3.9,146037,2,2326,0)=" ; PRCA*4.5*303 - EFT TRANSACTION AUDIT REPORT (SUMMARY VERSION)"
^XMB(3.9,146037,2,2327,0)="""RTN"",""RCDPTAR1"",7,0)"
^XMB(3.9,146037,2,2328,0)=" ;"
^XMB(3.9,146037,2,2329,0)="""RTN"",""RCDPTAR1"",8,0)"
^XMB(3.9,146037,2,2330,0)="SUM ;EP from RCDPTAR"
^XMB(3.9,146037,2,2331,0)="""RTN"",""RCDPTAR1"",9,0)"
^XMB(3.9,146037,2,2332,0)=" ; Display EFT Transaction Audit Report in original summary mode by Deposit Date"
^XMB(3.9,146037,2,2333,0)="""RTN"",""RCDPTAR1"",10,0)"
^XMB(3.9,146037,2,2334,0)=" N DIR,DIROUT,DIRUT,DTOUT,DUOUT,RCDT1,RCDT2,RCEXCEL,X,Y"
^XMB(3.9,146037,2,2335,0)="""RTN"",""RCDPTAR1"",11,0)"
^XMB(3.9,146037,2,2336,0)=" ;"
^XMB(3.9,146037,2,2337,0)="""RTN"",""RCDPTAR1"",12,0)"
^XMB(3.9,146037,2,2338,0)=" ; Start Date"
^XMB(3.9,146037,2,2339,0)="""RTN"",""RCDPTAR1"",13,0)"
^XMB(3.9,146037,2,2340,0)=" S DIR(0)=""DAO^:""_DT_"":APE"",DIR(""A"")=""Start Date: "",DIR(""B"")=""T"""
^XMB(3.9,146037,2,2341,0)="""RTN"",""RCDPTAR1"",14,0)"
^XMB(3.9,146037,2,2342,0)=" S DIR(""?"")=""ENTER THE EARLIEST DATE OF RECEIPT OF DEPOSIT TO INCLUDE ON THE REPORT"""
^XMB(3.9,146037,2,2343,0)="""RTN"",""RCDPTAR1"",15,0)"
^XMB(3.9,146037,2,2344,0)=" D ^DIR"
^XMB(3.9,146037,2,2345,0)="""RTN"",""RCDPTAR1"",16,0)"
^XMB(3.9,146037,2,2346,0)=" I $D(DTOUT)!$D(DUOUT)!(Y="""") Q"
^XMB(3.9,146037,2,2347,0)="""RTN"",""RCDPTAR1"",17,0)"
^XMB(3.9,146037,2,2348,0)=" S RCDT1=Y"
^XMB(3.9,146037,2,2349,0)="""RTN"",""RCDPTAR1"",18,0)"
^XMB(3.9,146037,2,2350,0)=" ;"
^XMB(3.9,146037,2,2351,0)="""RTN"",""RCDPTAR1"",19,0)"
^XMB(3.9,146037,2,2352,0)=" ; End Date"
^XMB(3.9,146037,2,2353,0)="""RTN"",""RCDPTAR1"",20,0)"
^XMB(3.9,146037,2,2354,0)=" K DIR"
^XMB(3.9,146037,2,2355,0)="""RTN"",""RCDPTAR1"",21,0)"
^XMB(3.9,146037,2,2356,0)=" S DIR(0)=""DAO^""_RCDT1_"":""_DT_"":APE"",DIR(""A"")=""End Date: "",DIR(""B"")=""T"""
^XMB(3.9,146037,2,2357,0)="""RTN"",""RCDPTAR1"",22,0)"
^XMB(3.9,146037,2,2358,0)=" S DIR(""?"")=""ENTER THE LATEST DATE OF RECEIPT OF DEPOSIT TO INCLUDE ON THE REPORT"""
^XMB(3.9,146037,2,2359,0)="""RTN"",""RCDPTAR1"",23,0)"
^XMB(3.9,146037,2,2360,0)=" D ^DIR"
^XMB(3.9,146037,2,2361,0)="""RTN"",""RCDPTAR1"",24,0)"
^XMB(3.9,146037,2,2362,0)=" I $D(DTOUT)!$D(DUOUT)!(Y="""") Q"
^XMB(3.9,146037,2,2363,0)="""RTN"",""RCDPTAR1"",25,0)"
^XMB(3.9,146037,2,2364,0)=" S RCDT2=Y"
^XMB(3.9,146037,2,2365,0)="""RTN"",""RCDPTAR1"",26,0)"
^XMB(3.9,146037,2,2366,0)=" ;"
^XMB(3.9,146037,2,2367,0)="""RTN"",""RCDPTAR1"",27,0)"
^XMB(3.9,146037,2,2368,0)=" S RCEXCEL=$$EXCEL^RCDMCUT2()                   ; Ask Excel output"
^XMB(3.9,146037,2,2369,0)="""RTN"",""RCDPTAR1"",28,0)"
^XMB(3.9,146037,2,2370,0)=" I RCEXCEL=""^"" Q"
^XMB(3.9,146037,2,2371,0)="""RTN"",""RCDPTAR1"",29,0)"
^XMB(3.9,146037,2,2372,0)=" I RCEXCEL D EXMSG"
^XMB(3.9,146037,2,2373,0)="""RTN"",""RCDPTAR1"",30,0)"
^XMB(3.9,146037,2,2374,0)=" ;"
^XMB(3.9,146037,2,2375,0)="""RTN"",""RCDPTAR1"",31,0)"
^XMB(3.9,146037,2,2376,0)=" Q:$$ASKDEV(0)=-1                               ; PRCA*4.5*380 - Prompt for device"
^XMB(3.9,146037,2,2377,0)="""RTN"",""RCDPTAR1"",32,0)"
^XMB(3.9,146037,2,2378,0)=" ;"
^XMB(3.9,146037,2,2379,0)="""RTN"",""RCDPTAR1"",33,0)"
^XMB(3.9,146037,2,2380,0)=" U IO"
^XMB(3.9,146037,2,2381,0)="""RTN"",""RCDPTAR1"",34,0)"
^XMB(3.9,146037,2,2382,0)=" D RUN(RCDT1,RCDT2,RCEXCEL)"
^XMB(3.9,146037,2,2383,0)="""RTN"",""RCDPTAR1"",35,0)"
^XMB(3.9,146037,2,2384,0)=" Q"
^XMB(3.9,146037,2,2385,0)="""RTN"",""RCDPTAR1"",36,0)"
^XMB(3.9,146037,2,2386,0)=" ;"
^XMB(3.9,146037,2,2387,0)="""RTN"",""RCDPTAR1"",37,0)"
^XMB(3.9,146037,2,2388,0)=" ; PRCA*4.5*380 - Added subroutine"
^XMB(3.9,146037,2,2389,0)="""RTN"",""RCDPTAR1"",38,0)"
^XMB(3.9,146037,2,2390,0)="SUM2 ;EP from RCDPTAR"
^XMB(3.9,146037,2,2391,0)="""RTN"",""RCDPTAR1"",39,0)"
^XMB(3.9,146037,2,2392,0)=" ; Display EFT Transaction Audit Report in summary mode by Deposit Number"
^XMB(3.9,146037,2,2393,0)="""RTN"",""RCDPTAR1"",40,0)"
^XMB(3.9,146037,2,2394,0)=" N ARR,CDDT,CTR,DIR,DIROUT,DIRUT,DTOUT,DUOUT"
^XMB(3.9,146037,2,2395,0)="""RTN"",""RCDPTAR1"",41,0)"
^XMB(3.9,146037,2,2396,0)=" N RCDBAL,RCDDT,RCDIEN,RCDNUM,RCDT1,RCDT2,RCEXCEL,RCLOOP,RCSTOP,X,XX,Y     ; PRCA*4.5*409 - Added RCSTOP ; PRCA*4.5*439 - Added RCDBAL, RCDIEN"
^XMB(3.9,146037,2,2397,0)="""RTN"",""RCDPTAR1"",42,0)"
^XMB(3.9,146037,2,2398,0)=" S RCDNUM=$$ASKDNUM()"
^XMB(3.9,146037,2,2399,0)="""RTN"",""RCDPTAR1"",43,0)"
^XMB(3.9,146037,2,2400,0)=" Q:RCDNUM=-1"
^XMB(3.9,146037,2,2401,0)="""RTN"",""RCDPTAR1"",44,0)"
^XMB(3.9,146037,2,2402,0)=" S CTR=0,RCDDT="""",CDDT="""",RCSTOP=0,RCLOOP=0     ; PRCA*4.5*409 - Added RCSTOP=0,RCLOOP=0"
^XMB(3.9,146037,2,2403,0)="""RTN"",""RCDPTAR1"",45,0)"
^XMB(3.9,146037,2,2404,0)=" W !,""Select Deposit:"""
^XMB(3.9,146037,2,2405,0)="""RTN"",""RCDPTAR1"",46,0)"
^XMB(3.9,146037,2,2406,0)=" F  D  Q:RCDDT'=""""  Q:RCSTOP                    ; PRCA*4.5*409 - Added Q:RCSTOP"
^XMB(3.9,146037,2,2407,0)="""RTN"",""RCDPTAR1"",47,0)"
^XMB(3.9,146037,2,2408,0)=" . S CDDT=$O(^RCY(344.3,""ADEP2"",RCDNUM,CDDT),-1)"
^XMB(3.9,146037,2,2409,0)="""RTN"",""RCDPTAR1"",48,0)"
^XMB(3.9,146037,2,2410,0)=" . I CDDT="""" D  Q                               ; No more Deposit Dates to display for Deposit Number"
^XMB(3.9,146037,2,2411,0)="""RTN"",""RCDPTAR1"",49,0)"
^XMB(3.9,146037,2,2412,0)="  . . Q:CTR=0"
^XMB(3.9,146037,2,2413,0)="""RTN"",""RCDPTAR1"",50,0)"
^XMB(3.9,146037,2,2414,0)=" . . S RCDDT=$$SELDT(CTR,.ARR,RCLOOP)  ; Final selection choice ; PRCA*4.5*439 add RCLOOP to call"
^XMB(3.9,146037,2,2415,0)="""RTN"",""RCDPTAR1"",51,0)"
^XMB(3.9,146037,2,2416,0)=" . . I RCDDT=-1 S RCSTOP=1"
^XMB(3.9,146037,2,2417,0)="""RTN"",""RCDPTAR1"",52,0)"
^XMB(3.9,146037,2,2418,0)=" . S CTR=CTR+1,ARR(CTR)=CDDT"
^XMB(3.9,146037,2,2419,0)="""RTN"",""RCDPTAR1"",53,0)"
^XMB(3.9,146037,2,2420,0)=" . S XX=$$FMTE^XLFDT(CDDT,""5DZ"")"
^XMB(3.9,146037,2,2421,0)="""RTN"",""RCDPTAR1"",54,0)"
^XMB(3.9,146037,2,2422,0)=" . W !,$J(CTR,3),"" "",RCDNUM,"" on: "",XX"
^XMB(3.9,146037,2,2423,0)="""RTN"",""RCDPTAR1"",55,0)"
^XMB(3.9,146037,2,2424,0)=" . S RCDIEN="""",RCDBAL=""1^0^0"""
^XMB(3.9,146037,2,2425,0)="""RTN"",""RCDPTAR1"",56,0)"
^XMB(3.9,146037,2,2426,0)=" . F  S RCDIEN=$O(^RCY(344.3,""ADEP2"",RCDNUM,CDDT,RCDIEN)) Q:'RCDIEN  D  ; PRCA*4.5*439"
^XMB(3.9,146037,2,2427,0)="""RTN"",""RCDPTAR1"",57,0)"
^XMB(3.9,146037,2,2428,0)=" . . S RCDBAL1=$$DEPBAL^RCDPTAR2(RCDIEN)               ; Is deposit out of balance, PRCA*4.5*446"
^XMB(3.9,146037,2,2429,0)="""RTN"",""RCDPTAR1"",58,0)"
^XMB(3.9,146037,2,2430,0)=" . . S $P(RCDBAL,U,3)=$P(RCDBAL,U,3)+$P(RCDBAL1,U,3)"
^XMB(3.9,146037,2,2431,0)="""RTN"",""RCDPTAR1"",59,0)"
^XMB(3.9,146037,2,2432,0)=" . . S:'$P(RCDBAL1,U,1) $P(RCDBAL,U,1)=0        ; Check for out of balance, PRCA*4.5*446"
^XMB(3.9,146037,2,2433,0)="""RTN"",""RCDPTAR1"",60,0)"
^XMB(3.9,146037,2,2434,0)=" . W $J($P(RCDBAL,U,3),19,2)                    ; Deposit total"
^XMB(3.9,146037,2,2435,0)="""RTN"",""RCDPTAR1"",61,0)"
^XMB(3.9,146037,2,2436,0)=" . I 'RCDBAL W "" **UNBALANCED**""                ; Add UNBALANCED indicator if deposit is not in balance, PRCA*4.5*439"
^XMB(3.9,146037,2,2437,0)="""RTN"",""RCDPTAR1"",62,0)"
^XMB(3.9,146037,2,2438,0)=" . I CTR#10=0 D  Q:RCDDT'=""""                    ; Ask selection every 10 times"
^XMB(3.9,146037,2,2439,0)="""RTN"",""RCDPTAR1"",63,0)"
^XMB(3.9,146037,2,2440,0)=" . . S RCDDT=$$SELDT(CTR,.ARR,RCLOOP)           ; PRCA*4.5*439 add RCLOOP to parameters"
^XMB(3.9,146037,2,2441,0)="""RTN"",""RCDPTAR1"",64,0)"
^XMB(3.9,146037,2,2442,0)=" . . I RCDDT=-1 S RCSTOP=1"
^XMB(3.9,146037,2,2443,0)="""RTN"",""RCDPTAR1"",65,0)"
^XMB(3.9,146037,2,2444,0)=" Q:RCDDT=""""  Q:RCSTOP                           ; No Deposit Date selected"
^XMB(3.9,146037,2,2445,0)="""RTN"",""RCDPTAR1"",66,0)"
^XMB(3.9,146037,2,2446,0)=" S RCEXCEL=$$EXCEL^RCDMCUT2()                   ; Ask Excel output"
^XMB(3.9,146037,2,2447,0)="""RTN"",""RCDPTAR1"",67,0)"
^XMB(3.9,146037,2,2448,0)=" Q:RCEXCEL=""^"""
^XMB(3.9,146037,2,2449,0)="""RTN"",""RCDPTAR1"",68,0)"
^XMB(3.9,146037,2,2450,0)=" I RCEXCEL D EXMSG"
^XMB(3.9,146037,2,2451,0)="""RTN"",""RCDPTAR1"",69,0)"
^XMB(3.9,146037,2,2452,0)=" ;"
^XMB(3.9,146037,2,2453,0)="""RTN"",""RCDPTAR1"",70,0)"
^XMB(3.9,146037,2,2454,0)=" Q:$$ASKDEV(0)=-1                               ; Prompt for device"
^XMB(3.9,146037,2,2455,0)="""RTN"",""RCDPTAR1"",71,0)"
^XMB(3.9,146037,2,2456,0)=" U IO"
^XMB(3.9,146037,2,2457,0)="""RTN"",""RCDPTAR1"",72,0)"
^XMB(3.9,146037,2,2458,0)=" D RUN2(RCDNUM,RCDDT,RCEXCEL)                   ; Output the report"
^XMB(3.9,146037,2,2459,0)="""RTN"",""RCDPTAR1"",73,0)"
^XMB(3.9,146037,2,2460,0)=" Q"
^XMB(3.9,146037,2,2461,0)="""RTN"",""RCDPTAR1"",74,0)"
^XMB(3.9,146037,2,2462,0)=" ;"
^XMB(3.9,146037,2,2463,0)="""RTN"",""RCDPTAR1"",75,0)"
^XMB(3.9,146037,2,2464,0)=" ; PRCA*4.5*380 - Added subroutine"
^XMB(3.9,146037,2,2465,0)="""RTN"",""RCDPTAR1"",76,0)"
^XMB(3.9,146037,2,2466,0)="ASKDNUM() ; Ask the user for the deposit number to select"
^XMB(3.9,146037,2,2467,0)="""RTN"",""RCDPTAR1"",77,0)"
^XMB(3.9,146037,2,2468,0)=" ; Input:   None"
^XMB(3.9,146037,2,2469,0)="""RTN"",""RCDPTAR1"",78,0)"
^XMB(3.9,146037,2,2470,0)=" ; Returns: -1 - User quit or timed out"
^XMB(3.9,146037,2,2471,0)="""RTN"",""RCDPTAR1"",79,0)"
^XMB(3.9,146037,2,2472,0)=" ;           Deposit Number"
^XMB(3.9,146037,2,2473,0)="""RTN"",""RCDPTAR1"",80,0)"
^XMB(3.9,146037,2,2474,0)=" N DA,DIR,DIRUT,DIROUT,DTOUT,DUOUT,X,Y"
^XMB(3.9,146037,2,2475,0)="""RTN"",""RCDPTAR1"",81,0)"
^XMB(3.9,146037,2,2476,0)="DNUM2 ; looping tag"
^XMB(3.9,146037,2,2477,0)="""RTN"",""RCDPTAR1"",82,0)"
^XMB(3.9,146037,2,2478,0)=" S DIR(0)=""344.3,.06"""
^XMB(3.9,146037,2,2479,0)="""RTN"",""RCDPTAR1"",83,0)"
^XMB(3.9,146037,2,2480,0)=" S DIR(""A"")=""Enter Deposit Number"""
^XMB(3.9,146037,2,2481,0)="""RTN"",""RCDPTAR1"",84,0)"
^XMB(3.9,146037,2,2482,0)=" S DIR(""?"")=""Enter a valid deposit number"""
^XMB(3.9,146037,2,2483,0)="""RTN"",""RCDPTAR1"",85,0)"
^XMB(3.9,146037,2,2484,0)=" D ^DIR"
^XMB(3.9,146037,2,2485,0)="""RTN"",""RCDPTAR1"",86,0)"
^XMB(3.9,146037,2,2486,0)=" I $D(DTOUT)!$D(DUOUT)!(Y="""") Q -1"
^XMB(3.9,146037,2,2487,0)="""RTN"",""RCDPTAR1"",87,0)"
^XMB(3.9,146037,2,2488,0)=" I '$D(^RCY(344.3,""ADEP2"",X)) D  G DNUM2"
^XMB(3.9,146037,2,2489,0)="""RTN"",""RCDPTAR1"",88,0)"
^XMB(3.9,146037,2,2490,0)=" .  W *7,""Deposit Number: "",X,"" does not exist"""
^XMB(3.9,146037,2,2491,0)="""RTN"",""RCDPTAR1"",89,0)"
^XMB(3.9,146037,2,2492,0)=" Q X"
^XMB(3.9,146037,2,2493,0)="""RTN"",""RCDPTAR1"",90,0)"
^XMB(3.9,146037,2,2494,0)=" ;"
^XMB(3.9,146037,2,2495,0)="""RTN"",""RCDPTAR1"",91,0)"
^XMB(3.9,146037,2,2496,0)=" ; PRCA*4.5*380 - Added subroutine"
^XMB(3.9,146037,2,2497,0)="""RTN"",""RCDPTAR1"",92,0)"
^XMB(3.9,146037,2,2498,0)="SELDT(CTR,ARR,RCLOOP) ; Ask the user to select a deposit date for the selected Deposit Number"
^XMB(3.9,146037,2,2499,0)="""RTN"",""RCDPTAR1"",93,0)"
^XMB(3.9,146037,2,2500,0)=" ; Input:   CTR - Current # of choices displayed"
^XMB(3.9,146037,2,2501,0)="""RTN"",""RCDPTAR1"",94,0)"
^XMB(3.9,146037,2,2502,0)=" ;          ARR - Array of available choices ARR(A1)=A2 Where:"
^XMB(3.9,146037,2,2503,0)="""RTN"",""RCDPTAR1"",95,0)"
^XMB(3.9,146037,2,2504,0)=" ;                  A1 - Selection #"
^XMB(3.9,146037,2,2505,0)="""RTN"",""RCDPTAR1"",96,0)"
^XMB(3.9,146037,2,2506,0)=" ;                  A2 - Deposit Date"
^XMB(3.9,146037,2,2507,0)="""RTN"",""RCDPTAR1"",97,0)"
^XMB(3.9,146037,2,2508,0)=" ;          RCLOOP - Flag that indicates if selection is being made after displaying a EFT for the first time."
^XMB(3.9,146037,2,2509,0)="""RTN"",""RCDPTAR1"",98,0)"
^XMB(3.9,146037,2,2510,0)=" ;                   Makes selection optional. PRCA*4.5*439"
^XMB(3.9,146037,2,2511,0)="""RTN"",""RCDPTAR1"",99,0)"
^XMB(3.9,146037,2,2512,0)=" ; Returns: """"  - Nothing selected, Otherwise selected deposit date is returned"
^XMB(3.9,146037,2,2513,0)="""RTN"",""RCDPTAR1"",100,0)"
^XMB(3.9,146037,2,2514,0)=" ;                -1 if user '^' or timed out"
^XMB(3.9,146037,2,2515,0)="""RTN"",""RCDPTAR1"",101,0)"
^XMB(3.9,146037,2,2516,0)=" N DIR,DIROUT,DIRUT,DTOUT,DUOUT,X,Y"
^XMB(3.9,146037,2,2517,0)="""RTN"",""RCDPTAR1"",102,0)"
^XMB(3.9,146037,2,2518,0)=" S DIR(0)=""NA"" I $G(RCLOOP) S DIR(0)=""NAO""      ; PRCA*4.5*439"
^XMB(3.9,146037,2,2519,0)="""RTN"",""RCDPTAR1"",103,0)"
^XMB(3.9,146037,2,2520,0)=" S DIR(0)=DIR(0)_""^1:""_CTR_"":0"",DIR(""A"")=""CHOOSE 1 - ""_CTR_"": """
^XMB(3.9,146037,2,2521,0)="""RTN"",""RCDPTAR1"",104,0)"
^XMB(3.9,146037,2,2522,0)=" S DIR(""?"")=""Select a number between 1 and ""_CTR"
^XMB(3.9,146037,2,2523,0)="""RTN"",""RCDPTAR1"",105,0)"
^XMB(3.9,146037,2,2524,0)=" D ^DIR"
^XMB(3.9,146037,2,2525,0)="""RTN"",""RCDPTAR1"",106,0)"
^XMB(3.9,146037,2,2526,0)=" I $G(RCLOOP),Y="""" Q -1                             ; PRCA*4.5*439"
^XMB(3.9,146037,2,2527,0)="""RTN"",""RCDPTAR1"",107,0)"
^XMB(3.9,146037,2,2528,0)=" I $G(DTOUT)!$G(DUOUT)!(Y=-1) Q -1              ; PRCA*4.5*409 Added line"
^XMB(3.9,146037,2,2529,0)="""RTN"",""RCDPTAR1"",108,0)"
^XMB(3.9,146037,2,2530,0)=" Q $S($D(DIRUT):"""",1:ARR(Y))"
