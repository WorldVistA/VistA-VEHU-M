^XMB(3.9,146011,2,496,0)=" .S VALMSG=""Medication Expired on ""_$E($P(^PSRX(DA,2),""^"",6),4,5)_""-""_$E($P(^(2),""^"",6),6,7)_""-""_$E($P(^(2),""^"",6),2,3) I $P(^PSRX(DA,""STA""),""^"")<11 S $P(^PSRX(DA,""STA""),""^"")=11"
