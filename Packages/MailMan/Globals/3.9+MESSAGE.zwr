^XMB(3.9,146036,2,2631,0)="""RTN"",""DVBCUTIL"",105,0)"
^XMB(3.9,146036,2,2632,0)=" Q"
^XMB(3.9,146036,2,2633,0)="""RTN"",""DVBCUTIL"",106,0)"
^XMB(3.9,146036,2,2634,0)=" ;"
^XMB(3.9,146036,2,2635,0)="""RTN"",""DVBCUTIL"",107,0)"
^XMB(3.9,146036,2,2636,0)="ISFORGN(DVBIEN)  ;  ** Is country entry foreign? **"
^XMB(3.9,146036,2,2637,0)="""RTN"",""DVBCUTIL"",108,0)"
^XMB(3.9,146036,2,2638,0)=" ;  Input:  DVBIEN - IEN of COUNTRY CODE file"
^XMB(3.9,146036,2,2639,0)="""RTN"",""DVBCUTIL"",109,0)"
^XMB(3.9,146036,2,2640,0)=" ;"
^XMB(3.9,146036,2,2641,0)="""RTN"",""DVBCUTIL"",110,0)"
^XMB(3.9,146036,2,2642,0)=" ;  Output:  Return 1 when country is foreign"
^XMB(3.9,146036,2,2643,0)="""RTN"",""DVBCUTIL"",111,0)"
^XMB(3.9,146036,2,2644,0)=" ;           Return 0 when country is not foreign"
^XMB(3.9,146036,2,2645,0)="""RTN"",""DVBCUTIL"",112,0)"
^XMB(3.9,146036,2,2646,0)=" ;           Return -1 on error"
^XMB(3.9,146036,2,2647,0)="""RTN"",""DVBCUTIL"",113,0)"
^XMB(3.9,146036,2,2648,0)=" ;"
^XMB(3.9,146036,2,2649,0)="""RTN"",""DVBCUTIL"",114,0)"
^XMB(3.9,146036,2,2650,0)=" N DVBCNTRY"
^XMB(3.9,146036,2,2651,0)="""RTN"",""DVBCUTIL"",115,0)"
^XMB(3.9,146036,2,2652,0)=" N DVBERR"
^XMB(3.9,146036,2,2653,0)="""RTN"",""DVBCUTIL"",116,0)"
^XMB(3.9,146036,2,2654,0)=" Q:$G(DVBIEN)="""" -1"
^XMB(3.9,146036,2,2655,0)="""RTN"",""DVBCUTIL"",117,0)"
^XMB(3.9,146036,2,2656,0)=" S DVBCNTRY=$$GET1^DIQ(779.004,DVBIEN_"","","".01"","""","""",""DVBERR"")"
^XMB(3.9,146036,2,2657,0)="""RTN"",""DVBCUTIL"",118,0)"
^XMB(3.9,146036,2,2658,0)=" Q $S($D(DVBERR):-1,DVBCNTRY=""USA"":0,1:1)"
^XMB(3.9,146036,2,2659,0)="""RTN"",""DVBCUTIL"",119,0)"
^XMB(3.9,146036,2,2660,0)=" ;"
^XMB(3.9,146036,2,2661,0)="""RTN"",""DVBCUTIL"",120,0)"
^XMB(3.9,146036,2,2662,0)="GETCNTRY(DVBIEN)  ;  ** Get POSTAL NAME for country code **"
^XMB(3.9,146036,2,2663,0)="""RTN"",""DVBCUTIL"",121,0)"
^XMB(3.9,146036,2,2664,0)=" ;  Input:  DVBIEN - IEN of COUNTRY CODE file"
^XMB(3.9,146036,2,2665,0)="""RTN"",""DVBCUTIL"",122,0)"
^XMB(3.9,146036,2,2666,0)=" ;"
^XMB(3.9,146036,2,2667,0)="""RTN"",""DVBCUTIL"",123,0)"
^XMB(3.9,146036,2,2668,0)=" ;  Output:  Return POSTAL NAME field on success or"
^XMB(3.9,146036,2,2669,0)="""RTN"",""DVBCUTIL"",124,0)"
^XMB(3.9,146036,2,2670,0)=" ;           DESCRIPTION field when POSTAL NAME = ""<NULL>"";"
^XMB(3.9,146036,2,2671,0)="""RTN"",""DVBCUTIL"",125,0)"
^XMB(3.9,146036,2,2672,0)=" ;           Otherwise, return """" on failure."
^XMB(3.9,146036,2,2673,0)="""RTN"",""DVBCUTIL"",126,0)"
^XMB(3.9,146036,2,2674,0)=" ;"
^XMB(3.9,146036,2,2675,0)="""RTN"",""DVBCUTIL"",127,0)"
^XMB(3.9,146036,2,2676,0)=" N DVBCNTRY"
^XMB(3.9,146036,2,2677,0)="""RTN"",""DVBCUTIL"",128,0)"
^XMB(3.9,146036,2,2678,0)=" N DVBERR"
^XMB(3.9,146036,2,2679,0)="""RTN"",""DVBCUTIL"",129,0)"
^XMB(3.9,146036,2,2680,0)=" N DVBIENS"
^XMB(3.9,146036,2,2681,0)="""RTN"",""DVBCUTIL"",130,0)"
^XMB(3.9,146036,2,2682,0)=" N DVBNAME"
^XMB(3.9,146036,2,2683,0)="""RTN"",""DVBCUTIL"",131,0)"
^XMB(3.9,146036,2,2684,0)=" S DVBNAME="""""
^XMB(3.9,146036,2,2685,0)="""RTN"",""DVBCUTIL"",132,0)"
^XMB(3.9,146036,2,2686,0)=" I $G(DVBIEN)'="""" D"
^XMB(3.9,146036,2,2687,0)="""RTN"",""DVBCUTIL"",133,0)"
^XMB(3.9,146036,2,2688,0)=" . S DVBIENS=DVBIEN_"","""
^XMB(3.9,146036,2,2689,0)="""RTN"",""DVBCUTIL"",134,0)"
^XMB(3.9,146036,2,2690,0)=" . D GETS^DIQ(779.004,DVBIENS,""1.3;2"",""E"",""DVBCNTRY"",""DVBERR"")"
^XMB(3.9,146036,2,2691,0)="""RTN"",""DVBCUTIL"",135,0)"
^XMB(3.9,146036,2,2692,0)=" . I '$D(DVBERR) D"
^XMB(3.9,146036,2,2693,0)="""RTN"",""DVBCUTIL"",136,0)"
^XMB(3.9,146036,2,2694,0)=" . . S DVBNAME=$G(DVBCNTRY(779.004,DVBIENS,1.3,""E""))"
^XMB(3.9,146036,2,2695,0)="""RTN"",""DVBCUTIL"",137,0)"
^XMB(3.9,146036,2,2696,0)=" . . I DVBNAME=""<NULL>"" S DVBNAME=$$UP^XLFSTR($G(DVBCNTRY(779.004,DVBIENS,2,""E"")))"
^XMB(3.9,146036,2,2697,0)="""RTN"",""DVBCUTIL"",138,0)"
^XMB(3.9,146036,2,2698,0)=" Q DVBNAME"
^XMB(3.9,146036,2,2699,0)="""RTN"",""DVBCUTIL"",139,0)"
^XMB(3.9,146036,2,2700,0)=" ;"
^XMB(3.9,146036,2,2701,0)="""RTN"",""DVBCUTIL"",140,0)"
^XMB(3.9,146036,2,2702,0)="SVC(DFN,DVBCIE) ;Retrieve Last Military Service Data Info"
^XMB(3.9,146036,2,2703,0)="""RTN"",""DVBCUTIL"",141,0)"
^XMB(3.9,146036,2,2704,0)=" ; Using supported API SVC^VAPDT, which encapsulates the"
^XMB(3.9,146036,2,2705,0)="""RTN"",""DVBCUTIL"",142,0)"
^XMB(3.9,146036,2,2706,0)=" ; Military Service Episode (MSE) changes due to the"
^XMB(3.9,146036,2,2707,0)="""RTN"",""DVBCUTIL"",143,0)"
^XMB(3.9,146036,2,2708,0)=" ; Enrollment Military Service Data Sharing (MSDS) project "
^XMB(3.9,146036,2,2709,0)="""RTN"",""DVBCUTIL"",144,0)"
^XMB(3.9,146036,2,2710,0)=" ; (Patch DG*5.3*797)"
^XMB(3.9,146036,2,2711,0)="""RTN"",""DVBCUTIL"",145,0)"
^XMB(3.9,146036,2,2712,0)=" ; INPUT"
^XMB(3.9,146036,2,2713,0)="""RTN"",""DVBCUTIL"",146,0)"
^XMB(3.9,146036,2,2714,0)=" ;    DFN     - Patient (#2) file internal entry  number (Required)"
^XMB(3.9,146036,2,2715,0)="""RTN"",""DVBCUTIL"",147,0)"
^XMB(3.9,146036,2,2716,0)=" ;    DVBCIE  - ""I"" to return service dates in Fileman format (Default)"
^XMB(3.9,146036,2,2717,0)="""RTN"",""DVBCUTIL"",148,0)"
^XMB(3.9,146036,2,2718,0)=" ;              ""E"" to return servce dates in external format"
^XMB(3.9,146036,2,2719,0)="""RTN"",""DVBCUTIL"",149,0)"
^XMB(3.9,146036,2,2720,0)=" ; OUTPUT"
^XMB(3.9,146036,2,2721,0)="""RTN"",""DVBCUTIL"",150,0)"
^XMB(3.9,146036,2,2722,0)=" ;    Returns '^' delimitted string"
^XMB(3.9,146036,2,2723,0)="""RTN"",""DVBCUTIL"",151,0)"
^XMB(3.9,146036,2,2724,0)=" ;       1. Last Service Entry Date"
^XMB(3.9,146036,2,2725,0)="""RTN"",""DVBCUTIL"",152,0)"
^XMB(3.9,146036,2,2726,0)=" ;       2. Last Service Seperation Date"
^XMB(3.9,146036,2,2727,0)="""RTN"",""DVBCUTIL"",153,0)"
^XMB(3.9,146036,2,2728,0)=" ;       3. Last Service Branch"
^XMB(3.9,146036,2,2729,0)="""RTN"",""DVBCUTIL"",154,0)"
^XMB(3.9,146036,2,2730,0)=" ;       4. Last Service Discharge Type"
^XMB(3.9,146036,2,2731,0)="""RTN"",""DVBCUTIL"",155,0)"
^XMB(3.9,146036,2,2732,0)=" ; "
^XMB(3.9,146036,2,2733,0)="""RTN"",""DVBCUTIL"",156,0)"
^XMB(3.9,146036,2,2734,0)=" ;Quit if DFN not greater than zero"
^XMB(3.9,146036,2,2735,0)="""RTN"",""DVBCUTIL"",157,0)"
^XMB(3.9,146036,2,2736,0)=" Q:($G(DFN)'>0) """""
^XMB(3.9,146036,2,2737,0)="""RTN"",""DVBCUTIL"",158,0)"
^XMB(3.9,146036,2,2738,0)=" ;If DVBCIE not ""I"" or ""E"" set to default of ""I"""
^XMB(3.9,146036,2,2739,0)="""RTN"",""DVBCUTIL"",159,0)"
^XMB(3.9,146036,2,2740,0)=" S:""^I^E^""'[(U_$G(DVBCIE)_U) DVBCIE=""I"""
^XMB(3.9,146036,2,2741,0)="""RTN"",""DVBCUTIL"",160,0)"
^XMB(3.9,146036,2,2742,0)=" N VASV,VAHOW,VAROOT,DVBMSE"
^XMB(3.9,146036,2,2743,0)="""RTN"",""DVBCUTIL"",161,0)"
^XMB(3.9,146036,2,2744,0)=" D SVC^VADPT"
^XMB(3.9,146036,2,2745,0)="""RTN"",""DVBCUTIL"",162,0)"
^XMB(3.9,146036,2,2746,0)=" D:DVBCIE=""E""  ;external Last MSE data"
^XMB(3.9,146036,2,2747,0)="""RTN"",""DVBCUTIL"",163,0)"
^XMB(3.9,146036,2,2748,0)=" . S DVBMSE=$P($G(VASV(6,4)),U,2)_""^""_$P($G(VASV(6,5)),U,2)_""^"""
^XMB(3.9,146036,2,2749,0)="""RTN"",""DVBCUTIL"",164,0)"
^XMB(3.9,146036,2,2750,0)=" . S DVBMSE=DVBMSE_$P($G(VASV(6,1)),U,2)_""^""_$P($G(VASV(6,3)),U,2)"
^XMB(3.9,146036,2,2751,0)="""RTN"",""DVBCUTIL"",165,0)"
^XMB(3.9,146036,2,2752,0)=" D:DVBCIE=""I""  ;internal Last MSE data"
^XMB(3.9,146036,2,2753,0)="""RTN"",""DVBCUTIL"",166,0)"
^XMB(3.9,146036,2,2754,0)=" . S DVBMSE=$P($G(VASV(6,4)),U)_""^""_$P($G(VASV(6,5)),U)_""^"""
^XMB(3.9,146036,2,2755,0)="""RTN"",""DVBCUTIL"",167,0)"
^XMB(3.9,146036,2,2756,0)=" . S DVBMSE=DVBMSE_$P($G(VASV(6,1)),U)_""^""_$P($G(VASV(6,3)),U)"
^XMB(3.9,146036,2,2757,0)="""RTN"",""DVBCUTIL"",168,0)"
^XMB(3.9,146036,2,2758,0)=" Q DVBMSE"
^XMB(3.9,146036,2,2759,0)="""RTN"",""DVBSIGN"")"
^XMB(3.9,146036,2,2760,0)="0^5^B47340512"
^XMB(3.9,146036,2,2761,0)="""RTN"",""DVBSIGN"",1,0)"
^XMB(3.9,146036,2,2762,0)="DVBSIGN ;ALB/CP - CAPRI Signature RPCS; July, 2 2024@08:34 ; 7/2/24 8:35am"
^XMB(3.9,146036,2,2763,0)="""RTN"",""DVBSIGN"",2,0)"
^XMB(3.9,146036,2,2764,0)=" ;;2.7;AMIE;**252,254**;Apr 10, 1995;Build 0"
^XMB(3.9,146036,2,2765,0)="""RTN"",""DVBSIGN"",3,0)"
^XMB(3.9,146036,2,2766,0)=" ; Per VHA Directive 6402 this routine should not be modified"
^XMB(3.9,146036,2,2767,0)="""RTN"",""DVBSIGN"",4,0)"
^XMB(3.9,146036,2,2768,0)=" ; Reference to $$NOW^XLFDT in ICR #10103"
^XMB(3.9,146036,2,2769,0)="""RTN"",""DVBSIGN"",5,0)"
^XMB(3.9,146036,2,2770,0)=" ; Reference to ^TIU(8925 in IA #3376"
^XMB(3.9,146036,2,2771,0)="""RTN"",""DVBSIGN"",6,0)"
^XMB(3.9,146036,2,2772,0)=" ; Reference to $$GET1^DIQ(2 in DBIA #10035"
^XMB(3.9,146036,2,2773,0)="""RTN"",""DVBSIGN"",7,0)"
^XMB(3.9,146036,2,2774,0)=" ;"
^XMB(3.9,146036,2,2775,0)="""RTN"",""DVBSIGN"",8,0)"
^XMB(3.9,146036,2,2776,0)=" Q"
^XMB(3.9,146036,2,2777,0)="""RTN"",""DVBSIGN"",9,0)"
^XMB(3.9,146036,2,2778,0)=" ;"
^XMB(3.9,146036,2,2779,0)="""RTN"",""DVBSIGN"",10,0)"
^XMB(3.9,146036,2,2780,0)="SAVESIGN(DVBRTN,DVBIEN,DVBCOSIGNER) ;"
^XMB(3.9,146036,2,2781,0)="""RTN"",""DVBSIGN"",11,0)"
^XMB(3.9,146036,2,2782,0)=" ;;RPC:DVBA CAPRI SAVE SIGNER  "
^XMB(3.9,146036,2,2783,0)="""RTN"",""DVBSIGN"",12,0)"
^XMB(3.9,146036,2,2784,0)=" ;;New Routine for Signer Saves CAPRI-11532 CP 7-2-24"
^XMB(3.9,146036,2,2785,0)="""RTN"",""DVBSIGN"",13,0)"
^XMB(3.9,146036,2,2786,0)=" N DVBSIGNER,DVBFLAG,DVBDT,DVBDATA,DVBERR"
^XMB(3.9,146036,2,2787,0)="""RTN"",""DVBSIGN"",14,0)"
^XMB(3.9,146036,2,2788,0)=" S DVBSIGNER=DUZ"
^XMB(3.9,146036,2,2789,0)="""RTN"",""DVBSIGN"",15,0)"
^XMB(3.9,146036,2,2790,0)=" S DVBDT=$$NOW^XLFDT"
^XMB(3.9,146036,2,2791,0)="""RTN"",""DVBSIGN"",16,0)"
^XMB(3.9,146036,2,2792,0)=" S DVBDATA(396.17,DVBIEN_"","",4)=DVBDT"
^XMB(3.9,146036,2,2793,0)="""RTN"",""DVBSIGN"",17,0)"
^XMB(3.9,146036,2,2794,0)=" S DVBFLAG=$S(DVBCOSIGNER="""":""0"",1:1)"
^XMB(3.9,146036,2,2795,0)="""RTN"",""DVBSIGN"",18,0)"
^XMB(3.9,146036,2,2796,0)=" S DVBDATA(396.17,DVBIEN_"","",29)=DVBFLAG"
^XMB(3.9,146036,2,2797,0)="""RTN"",""DVBSIGN"",19,0)"
^XMB(3.9,146036,2,2798,0)=" ;If yes then set DUZ, flag, and Update status to ""U"" for Uncosigned"
^XMB(3.9,146036,2,2799,0)="""RTN"",""DVBSIGN"",20,0)"
^XMB(3.9,146036,2,2800,0)=" I DVBFLAG=1 D"
^XMB(3.9,146036,2,2801,0)="""RTN"",""DVBSIGN"",21,0)"
^XMB(3.9,146036,2,2802,0)=" . S DVBDATA(396.17,DVBIEN_"","",11)=""U"""
^XMB(3.9,146036,2,2803,0)="""RTN"",""DVBSIGN"",22,0)"
^XMB(3.9,146036,2,2804,0)=" . S DVBDATA(396.17,DVBIEN_"","",28)=DVBSIGNER"
^XMB(3.9,146036,2,2805,0)="""RTN"",""DVBSIGN"",23,0)"
^XMB(3.9,146036,2,2806,0)=" . S DVBDATA(396.17,DVBIEN_"","",30)=DVBCOSIGNER"
^XMB(3.9,146036,2,2807,0)="""RTN"",""DVBSIGN"",24,0)"
^XMB(3.9,146036,2,2808,0)=" . K DVBERR D FILE^DIE(,""DVBDATA"",""DVBERR"")"
^XMB(3.9,146036,2,2809,0)="""RTN"",""DVBSIGN"",25,0)"
^XMB(3.9,146036,2,2810,0)=" . I $D(DVBERR)>0 S DVBRTN=""-1^Details not Saved"""
^XMB(3.9,146036,2,2811,0)="""RTN"",""DVBSIGN"",26,0)"
^XMB(3.9,146036,2,2812,0)=" . I $D(DVBERR)=0 S DVBRTN=""2^Signed Ready for CoSignature"""
^XMB(3.9,146036,2,2813,0)="""RTN"",""DVBSIGN"",27,0)"
^XMB(3.9,146036,2,2814,0)=" . Q"
^XMB(3.9,146036,2,2815,0)="""RTN"",""DVBSIGN"",28,0)"
^XMB(3.9,146036,2,2816,0)=" ;If no then set DUZ and set Status to ""G"" for Signed"
^XMB(3.9,146036,2,2817,0)="""RTN"",""DVBSIGN"",29,0)"
^XMB(3.9,146036,2,2818,0)=" I DVBFLAG=0 D"
^XMB(3.9,146036,2,2819,0)="""RTN"",""DVBSIGN"",30,0)"
^XMB(3.9,146036,2,2820,0)=" . S DVBDATA(396.17,DVBIEN_"","",11)=""G"""
^XMB(3.9,146036,2,2821,0)="""RTN"",""DVBSIGN"",31,0)"
^XMB(3.9,146036,2,2822,0)=" . S DVBDATA(396.17,DVBIEN_"","",28)=DVBSIGNER"
^XMB(3.9,146036,2,2823,0)="""RTN"",""DVBSIGN"",32,0)"
^XMB(3.9,146036,2,2824,0)=" . S DVBDATA(396.17,DVBIEN_"","",30)="""""
^XMB(3.9,146036,2,2825,0)="""RTN"",""DVBSIGN"",33,0)"
^XMB(3.9,146036,2,2826,0)=" . K DVBERR D FILE^DIE(,""DVBDATA"",""DVBERR"")"
^XMB(3.9,146036,2,2827,0)="""RTN"",""DVBSIGN"",34,0)"
^XMB(3.9,146036,2,2828,0)=" . I $D(DVBERR)>0 S DVBRTN=""-1^Details not Saved"""
^XMB(3.9,146036,2,2829,0)="""RTN"",""DVBSIGN"",35,0)"
^XMB(3.9,146036,2,2830,0)=" . I $D(DVBERR)=0 S DVBRTN=""1^Signed Ready for Transmission"""
^XMB(3.9,146036,2,2831,0)="""RTN"",""DVBSIGN"",36,0)"
^XMB(3.9,146036,2,2832,0)=" . Q"
^XMB(3.9,146036,2,2833,0)="""RTN"",""DVBSIGN"",37,0)"
^XMB(3.9,146036,2,2834,0)=" Q"
^XMB(3.9,146036,2,2835,0)="""RTN"",""DVBSIGN"",38,0)"
^XMB(3.9,146036,2,2836,0)="ALERTCNT(DVBRTN) ;"
^XMB(3.9,146036,2,2837,0)="""RTN"",""DVBSIGN"",39,0)"
^XMB(3.9,146036,2,2838,0)=" ;;New RPC for Cosign Count CAPRI-11533 CP 7-26-24"
^XMB(3.9,146036,2,2839,0)="""RTN"",""DVBSIGN"",40,0)"
^XMB(3.9,146036,2,2840,0)=" ;;RPC: DVBA CAPRI UNCOSIGN COUNT "
^XMB(3.9,146036,2,2841,0)="""RTN"",""DVBSIGN"",41,0)"
^XMB(3.9,146036,2,2842,0)=" N DVBIEN,DVBSTAT,DVBCNT,DVBEMSFLG"
^XMB(3.9,146036,2,2843,0)="""RTN"",""DVBSIGN"",42,0)"
^XMB(3.9,146036,2,2844,0)=" S (DVBIEN,DVBSTAT)="""""
^XMB(3.9,146036,2,2845,0)="""RTN"",""DVBSIGN"",43,0)"
^XMB(3.9,146036,2,2846,0)=" S DVBCNT=0"
^XMB(3.9,146036,2,2847,0)="""RTN"",""DVBSIGN"",44,0)"
^XMB(3.9,146036,2,2848,0)=" ;I ($$PATCH^XPDUTL(""DVBA*2.7*256"")),($$GET^XPAR(""PKG"",""DVBAB CAPRI EMS TOGGLE"",1,""Q"")=2) S DVBEMSFLG=1 ;CAPRI-16719 PLE 6/27/2025"
^XMB(3.9,146036,2,2849,0)="""RTN"",""DVBSIGN"",45,0)"
^XMB(3.9,146036,2,2850,0)=" F  S DVBIEN=$O(^DVB(396.17,""H"",DUZ,DVBIEN)) Q:DVBIEN=""""  D"
^XMB(3.9,146036,2,2851,0)="""RTN"",""DVBSIGN"",46,0)"
^XMB(3.9,146036,2,2852,0)=" . S DVBSTAT=$$GET1^DIQ(396.17,DVBIEN,11,""I"")"
^XMB(3.9,146036,2,2853,0)="""RTN"",""DVBSIGN"",47,0)"
^XMB(3.9,146036,2,2854,0)=" . I DVBSTAT'=""U"" Q"
^XMB(3.9,146036,2,2855,0)="""RTN"",""DVBSIGN"",48,0)"
^XMB(3.9,146036,2,2856,0)=" . ;I DVBEMSFLG=1 Q ;CAPRI-16719 PLE 6/27/2025"
^XMB(3.9,146036,2,2857,0)="""RTN"",""DVBSIGN"",49,0)"
^XMB(3.9,146036,2,2858,0)=" . S DVBCNT=DVBCNT+1"
^XMB(3.9,146036,2,2859,0)="""RTN"",""DVBSIGN"",50,0)"
^XMB(3.9,146036,2,2860,0)=" S DVBRTN=DVBCNT"
^XMB(3.9,146036,2,2861,0)="""RTN"",""DVBSIGN"",51,0)"
^XMB(3.9,146036,2,2862,0)=" Q"
^XMB(3.9,146036,2,2863,0)="""RTN"",""DVBSIGN"",52,0)"
^XMB(3.9,146036,2,2864,0)=" ;"
^XMB(3.9,146036,2,2865,0)="""RTN"",""DVBSIGN"",53,0)"
^XMB(3.9,146036,2,2866,0)="UNCSINFO(DVBRTN) ;"
^XMB(3.9,146036,2,2867,0)="""RTN"",""DVBSIGN"",54,0)"
^XMB(3.9,146036,2,2868,0)=" ;New RPC code for CAPRI-11533.  JD - 7/11/24"
^XMB(3.9,146036,2,2869,0)="""RTN"",""DVBSIGN"",55,0)"
^XMB(3.9,146036,2,2870,0)=" ;RPC: DVBA CAPRI UNCOSIGNED INFO"
^XMB(3.9,146036,2,2871,0)="""RTN"",""DVBSIGN"",56,0)"
^XMB(3.9,146036,2,2872,0)=" ; "
^XMB(3.9,146036,2,2873,0)="""RTN"",""DVBSIGN"",57,0)"
^XMB(3.9,146036,2,2874,0)=" N DVBCNT,DVBCPFL,DVBCPTX,DVBDTUPE,DVBDTUPI,DVBIEN,DVBPTIE,DVBPTNM,DVBSTAT,DVBTIUDM,DVBTIUDN"
^XMB(3.9,146036,2,2875,0)="""RTN"",""DVBSIGN"",58,0)"
^XMB(3.9,146036,2,2876,0)=" S (DVBIEN,DVBSTAT)="""",DVBCNT=0"
^XMB(3.9,146036,2,2877,0)="""RTN"",""DVBSIGN"",59,0)"
^XMB(3.9,146036,2,2878,0)=" K ^TMP(""UNCOSIGNALERTINFO"",$J)"
^XMB(3.9,146036,2,2879,0)="""RTN"",""DVBSIGN"",60,0)"
^XMB(3.9,146036,2,2880,0)=" F  S DVBIEN=$O(^DVB(396.17,""H"",DUZ,DVBIEN)) Q:DVBIEN=""""  D"
^XMB(3.9,146036,2,2881,0)="""RTN"",""DVBSIGN"",61,0)"
^XMB(3.9,146036,2,2882,0)=" . S DVBSTAT=$$GET1^DIQ(396.17,DVBIEN,11,""I"")"
^XMB(3.9,146036,2,2883,0)="""RTN"",""DVBSIGN"",62,0)"
^XMB(3.9,146036,2,2884,0)=" . I DVBSTAT'=""U"" Q  ;Only the Review Status of Uncosigned is allowed"
^XMB(3.9,146036,2,2885,0)="""RTN"",""DVBSIGN"",63,0)"
^XMB(3.9,146036,2,2886,0)=" . S DVBPTIE=$$GET1^DIQ(396.17,DVBIEN,.01,""I"")  ;Patient IEN"
^XMB(3.9,146036,2,2887,0)="""RTN"",""DVBSIGN"",64,0)"
^XMB(3.9,146036,2,2888,0)=" . S DVBPTNM=$$GET1^DIQ(396.17,DVBIEN,.01,""E"")  ;Patient name"
^XMB(3.9,146036,2,2889,0)="""RTN"",""DVBSIGN"",65,0)"
^XMB(3.9,146036,2,2890,0)=" . S DVBDTUPE=$$GET1^DIQ(396.17,DVBIEN,4,""E"")   ;Date/time updated (External format)"
^XMB(3.9,146036,2,2891,0)="""RTN"",""DVBSIGN"",66,0)"
^XMB(3.9,146036,2,2892,0)=" . S DVBDTUPI=$$GET1^DIQ(396.17,DVBIEN,4,""I"")   ;Date/time updated (Fileman format)"
^XMB(3.9,146036,2,2893,0)="""RTN"",""DVBSIGN"",67,0)"
^XMB(3.9,146036,2,2894,0)=" . S DVBCPFL=$$GET1^DIQ(396.17,DVBIEN,25,""I"")   ;VHA internal DBQ referral(Y/N)"
^XMB(3.9,146036,2,2895,0)="""RTN"",""DVBSIGN"",68,0)"
^XMB(3.9,146036,2,2896,0)=" . S DVBTIUDN=$$GET1^DIQ(396.17,DVBIEN,7,""I"")   ;TIU document number"
^XMB(3.9,146036,2,2897,0)="""RTN"",""DVBSIGN"",69,0)"
^XMB(3.9,146036,2,2898,0)=" . S DVBTIUDM=$$GET1^DIQ(8925,DVBTIUDN,.01,""E"") ;TIU document name"
^XMB(3.9,146036,2,2899,0)="""RTN"",""DVBSIGN"",70,0)"
^XMB(3.9,146036,2,2900,0)=" . S DVBCPTX=$S(DVBCPFL=""N"":"""",1:""NON-"")"
^XMB(3.9,146036,2,2901,0)="""RTN"",""DVBSIGN"",71,0)"
^XMB(3.9,146036,2,2902,0)=" . S DVBCPTX=""UNCOSIGNED ""_DVBCPTX_DVBTIUDM_"" available for COSIGNATURE"""
^XMB(3.9,146036,2,2903,0)="""RTN"",""DVBSIGN"",72,0)"
^XMB(3.9,146036,2,2904,0)=" . S DVBCNT=DVBCNT+1"
^XMB(3.9,146036,2,2905,0)="""RTN"",""DVBSIGN"",73,0)"
^XMB(3.9,146036,2,2906,0)=" . S ^TMP(""UNCOSIGNALERTINFO"",$J,-DVBDTUPI,DVBCNT)=DVBPTIE_U_DVBPTNM_U_DVBDTUPE_U_DVBCPTX_U_DVBIEN_U_DVBTIUDN"
^XMB(3.9,146036,2,2907,0)="""RTN"",""DVBSIGN"",74,0)"
^XMB(3.9,146036,2,2908,0)=" I DVBCNT'>0 S DVBRTN=""-1^No data available"" Q"
^XMB(3.9,146036,2,2909,0)="""RTN"",""DVBSIGN"",75,0)"
^XMB(3.9,146036,2,2910,0)=" S DVBRTN=$NA(^TMP(""UNCOSIGNALERTINFO"",$J))"
^XMB(3.9,146036,2,2911,0)="""RTN"",""DVBSIGN"",76,0)"
^XMB(3.9,146036,2,2912,0)=" Q"
^XMB(3.9,146036,2,2913,0)="""RTN"",""DVBSIGN"",77,0)"
^XMB(3.9,146036,2,2914,0)="REVIEWSAVE(DVBRTN,DVBIEN,DVBTYP,DVBREVCMT) ;"
^XMB(3.9,146036,2,2915,0)="""RTN"",""DVBSIGN"",78,0)"
^XMB(3.9,146036,2,2916,0)=" ;New RPC for Review Updates CAPRI-12506 CP-8/13/24"
^XMB(3.9,146036,2,2917,0)="""RTN"",""DVBSIGN"",79,0)"
^XMB(3.9,146036,2,2918,0)=" ;DVBA CAPRI SAVE REVIEW DATA"
^XMB(3.9,146036,2,2919,0)="""RTN"",""DVBSIGN"",80,0)"
^XMB(3.9,146036,2,2920,0)=" ;CAPRI-16627 CP 4-22-25 Updating to remove possible blank author"
^XMB(3.9,146036,2,2921,0)="""RTN"",""DVBSIGN"",81,0)"
^XMB(3.9,146036,2,2922,0)=" N DVBDTTM,DVBREVSEQ,DVBAFDA,DVBDOCMAN,DVBERR,DVBNEXTSEQ"
^XMB(3.9,146036,2,2923,0)="""RTN"",""DVBSIGN"",82,0)"
^XMB(3.9,146036,2,2924,0)=" ;'P' FOR REVIEW PENDING;'S' FOR SENT BACK;'A' FOR AWAITING SIGNATURE;'T' for Trainee Details "
^XMB(3.9,146036,2,2925,0)="""RTN"",""DVBSIGN"",83,0)"
^XMB(3.9,146036,2,2926,0)=" ;"
^XMB(3.9,146036,2,2927,0)="""RTN"",""DVBSIGN"",84,0)"
^XMB(3.9,146036,2,2928,0)=" I DVBIEN="""" S DVBRTN=""-1^No Worksheet IEN sent"" Q"
^XMB(3.9,146036,2,2929,0)="""RTN"",""DVBSIGN"",85,0)"
^XMB(3.9,146036,2,2930,0)=" I $D(^DVB(396.17,DVBIEN))<10 S DVBRTN=""-1^Invalid Worksheet IEN"" Q"
^XMB(3.9,146036,2,2931,0)="""RTN"",""DVBSIGN"",86,0)"
^XMB(3.9,146036,2,2932,0)=" I DVBTYP="""" S DVBRTN=""-1^Missing Status"" Q"
^XMB(3.9,146036,2,2933,0)="""RTN"",""DVBSIGN"",87,0)"
^XMB(3.9,146036,2,2934,0)=" I ""TPSA""'[DVBTYP S DVBRTN=""-1^Invalid Status"" Q"
^XMB(3.9,146036,2,2935,0)="""RTN"",""DVBSIGN"",88,0)"
^XMB(3.9,146036,2,2936,0)=" I DVBTYP=""T"",$G(DVBREVCMT(1))'?1""TRAINEE^"".N1""^"".N S DVBRTN=""-1^Invalid Trainee Comments"" Q"
^XMB(3.9,146036,2,2937,0)="""RTN"",""DVBSIGN"",89,0)"
^XMB(3.9,146036,2,2938,0)=" I DVBTYP=""T"",$D(^VA(200,$P($G(DVBREVCMT(1)),""^"",2)))<10 S DVBRTN=""-1^Invalid Trainee DUZ"" Q"
^XMB(3.9,146036,2,2939,0)="""RTN"",""DVBSIGN"",90,0)"
^XMB(3.9,146036,2,2940,0)=" I DVBTYP=""A"",$G(DVBREVCMT(1))'?.N,$D(^VA(200,$G(DVBREVCMT(1))))<10 S DVBRTN=""-1^Invalid Signer DUZ"" Q"
^XMB(3.9,146036,2,2941,0)="""RTN"",""DVBSIGN"",91,0)"
^XMB(3.9,146036,2,2942,0)=" ;"
^XMB(3.9,146036,2,2943,0)="""RTN"",""DVBSIGN"",92,0)"
^XMB(3.9,146036,2,2944,0)=" S DVBDTTM=$$NOW^XLFDT"
^XMB(3.9,146036,2,2945,0)="""RTN"",""DVBSIGN"",93,0)"
^XMB(3.9,146036,2,2946,0)=" I DVBTYP=""P"" S DVBSIGNER=DUZ"
^XMB(3.9,146036,2,2947,0)="""RTN"",""DVBSIGN"",94,0)"
^XMB(3.9,146036,2,2948,0)=" I DVBTYP=""A"" S DVBDOCMAN=$G(DVBREVCMT(1))"
^XMB(3.9,146036,2,2949,0)="""RTN"",""DVBSIGN"",95,0)"
^XMB(3.9,146036,2,2950,0)=" I DVBTYP=""A"" S DVBREVCMT(1)=""Sending for Signature"""
^XMB(3.9,146036,2,2951,0)="""RTN"",""DVBSIGN"",96,0)"
^XMB(3.9,146036,2,2952,0)=" K DIC,DIE,DA,DR,DLAYGO,X,Y"
^XMB(3.9,146036,2,2953,0)="""RTN"",""DVBSIGN"",97,0)"
^XMB(3.9,146036,2,2954,0)=" ; CAPRI 16627 CP 3/10/25"
^XMB(3.9,146036,2,2955,0)="""RTN"",""DVBSIGN"",98,0)"
^XMB(3.9,146036,2,2956,0)=" S DVBREVSEQ=$P($G(^DVB(396.17,DVBIEN,6,0)),""^"",3)"
^XMB(3.9,146036,2,2957,0)="""RTN"",""DVBSIGN"",99,0)"
^XMB(3.9,146036,2,2958,0)=" S DA(1)=DVBIEN,DA=DVBREVSEQ+1,X=DVBDTTM"
^XMB(3.9,146036,2,2959,0)="""RTN"",""DVBSIGN"",100,0)"
^XMB(3.9,146036,2,2960,0)=" S (DLAYGO,DIC)=""^DVB(396.17,""_DA(1)_"",6,"",DIC(0)=""LZ"""
^XMB(3.9,146036,2,2961,0)="""RTN"",""DVBSIGN"",101,0)"
^XMB(3.9,146036,2,2962,0)=" S DIC(""DR"")="".01////""_DVBDTTM_"";1////""_DUZ"
^XMB(3.9,146036,2,2963,0)="""RTN"",""DVBSIGN"",102,0)"
^XMB(3.9,146036,2,2964,0)=" D FILE^DICN"
^XMB(3.9,146036,2,2965,0)="""RTN"",""DVBSIGN"",103,0)"
^XMB(3.9,146036,2,2966,0)=" I Y=-1 K DIC S DVBRTN=""-1^New version not saved"" Q"
^XMB(3.9,146036,2,2967,0)="""RTN"",""DVBSIGN"",104,0)"
^XMB(3.9,146036,2,2968,0)=" S DVBNEXTSEQ=+Y"
^XMB(3.9,146036,2,2969,0)="""RTN"",""DVBSIGN"",105,0)"
^XMB(3.9,146036,2,2970,0)=" I $G(DVBREVCMT(1))'="""" D WP^DIE(396.1714,DVBNEXTSEQ_"",""_DVBIEN_"","",4,""K"",""DVBREVCMT"",""DVBERR"")"
^XMB(3.9,146036,2,2971,0)="""RTN"",""DVBSIGN"",106,0)"
^XMB(3.9,146036,2,2972,0)=" I $D(DVBERR) S DVBRTN=""-1^Review Comments not saved"" Q"
^XMB(3.9,146036,2,2973,0)="""RTN"",""DVBSIGN"",107,0)"
^XMB(3.9,146036,2,2974,0)=" I '$D(DVBERR) S DVBRTN=1"
^XMB(3.9,146036,2,2975,0)="""RTN"",""DVBSIGN"",108,0)"
^XMB(3.9,146036,2,2976,0)=" I DVBTYP=""T"" S DVBRTN=""1^Trainee DUZ and DIV Saved"" Q"
^XMB(3.9,146036,2,2977,0)="""RTN"",""DVBSIGN"",109,0)"
^XMB(3.9,146036,2,2978,0)=" S DVBAFDA(396.17,DVBIEN_"","",4)=DVBDTTM"
^XMB(3.9,146036,2,2979,0)="""RTN"",""DVBSIGN"",110,0)"
^XMB(3.9,146036,2,2980,0)=" S DVBAFDA(396.17,DVBIEN_"","",11)=DVBTYP"
^XMB(3.9,146036,2,2981,0)="""RTN"",""DVBSIGN"",111,0)"
^XMB(3.9,146036,2,2982,0)=" S DVBAFDA(396.17,DVBIEN_"","",19)=""1"""
^XMB(3.9,146036,2,2983,0)="""RTN"",""DVBSIGN"",112,0)"
^XMB(3.9,146036,2,2984,0)=" I DVBTYP=""P"" S DVBAFDA(396.17,DVBIEN_"","",28)=DVBSIGNER,DVBAFDA(396.17,DVBIEN_"","",29)=0"
^XMB(3.9,146036,2,2985,0)="""RTN"",""DVBSIGN"",113,0)"
^XMB(3.9,146036,2,2986,0)=" ;CAPRI-16627 CP 4/22/15"
^XMB(3.9,146036,2,2987,0)="""RTN"",""DVBSIGN"",114,0)"
^XMB(3.9,146036,2,2988,0)=" I DVBTYP=""S"",$P($G(^DVB(396.17,DVBIEN,16)),U,1)'="""" S DVBAFDA(396.17,DVBIEN_"","",2)=$P($G(^DVB(396.17,DVBIEN,16)),U,1)"
^XMB(3.9,146036,2,2989,0)="""RTN"",""DVBSIGN"",115,0)"
^XMB(3.9,146036,2,2990,0)=" I DVBTYP=""A"" S DVBAFDA(396.17,DVBIEN_"","",2)=DVBDOCMAN"
^XMB(3.9,146036,2,2991,0)="""RTN"",""DVBSIGN"",116,0)"
^XMB(3.9,146036,2,2992,0)=" K DVBERR D FILE^DIE(,""DVBAFDA"",""DVBERR"")"
^XMB(3.9,146036,2,2993,0)="""RTN"",""DVBSIGN"",117,0)"
^XMB(3.9,146036,2,2994,0)=" I $D(DVBERR)>0 S DVBRTN=""-1^Worksheet not updated"""
^XMB(3.9,146036,2,2995,0)="""RTN"",""DVBSIGN"",118,0)"
^XMB(3.9,146036,2,2996,0)=" I $D(DVBERR)=0 S DVBRTN=""1^Review Details saved and Worksheet Updated"""
^XMB(3.9,146036,2,2997,0)="""RTN"",""DVBSIGN"",119,0)"
^XMB(3.9,146036,2,2998,0)=" Q"
^XMB(3.9,146036,2,2999,0)="""RTN"",""DVBSIGN"",120,0)"
^XMB(3.9,146036,2,3000,0)="DOCMAN(DVBRTN,DVBIEN) ;"
^XMB(3.9,146036,2,3001,0)="""RTN"",""DVBSIGN"",121,0)"
^XMB(3.9,146036,2,3002,0)=" ;Used B4 signature validation CAPRI-12506 CP-8/13/24"
^XMB(3.9,146036,2,3003,0)="""RTN"",""DVBSIGN"",122,0)"
^XMB(3.9,146036,2,3004,0)=" ;CAPRI 16627 CP 3/10/25"
^XMB(3.9,146036,2,3005,0)="""RTN"",""DVBSIGN"",123,0)"
