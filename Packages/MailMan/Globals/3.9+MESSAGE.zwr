^XMB(3.9,146047,2,2758,0)=" K ARRAY,^TMP(""EBSUMEUT2"",$J)"
^XMB(3.9,146047,2,2759,0)="""RTN"",""IBCNEUT2"",177,0)"
^XMB(3.9,146047,2,2760,0)=" ;"
^XMB(3.9,146047,2,2761,0)="""RTN"",""IBCNEUT2"",178,0)"
^XMB(3.9,146047,2,2762,0)=" I '$D(^IBCN(365,RIEN,2)) G XEBSUM  ; NO Benefits received"
^XMB(3.9,146047,2,2763,0)="""RTN"",""IBCNEUT2"",179,0)"
^XMB(3.9,146047,2,2764,0)=" ;"
^XMB(3.9,146047,2,2765,0)="""RTN"",""IBCNEUT2"",180,0)"
^XMB(3.9,146047,2,2766,0)=" S (IBSPDT,IBSUSCT,IBPEDT,IBELGINF)="""""
^XMB(3.9,146047,2,2767,0)="""RTN"",""IBCNEUT2"",181,0)"
^XMB(3.9,146047,2,2768,0)=" ; determine the default date if the HLDT is not there"
^XMB(3.9,146047,2,2769,0)="""RTN"",""IBCNEUT2"",182,0)"
^XMB(3.9,146047,2,2770,0)=" ;use the subscriber date plan date if it is a plan, or the Effective date, Unknown if still not found"
^XMB(3.9,146047,2,2771,0)="""RTN"",""IBCNEUT2"",183,0)"
^XMB(3.9,146047,2,2772,0)=" ;  this is to calculate the default eff date if it can't be determined by the EB loops from the response"
^XMB(3.9,146047,2,2773,0)="""RTN"",""IBCNEUT2"",184,0)"
^XMB(3.9,146047,2,2774,0)=" K IBCHK,IBBERR D GETS^DIQ(365,RIEN_"","",""7*"",""IEN"",""IBCHK"",""IBBERR"")"
^XMB(3.9,146047,2,2775,0)="""RTN"",""IBCNEUT2"",185,0)"
^XMB(3.9,146047,2,2776,0)=" I $D(IBCHK(365.07)) D  ; loop through for Subscribers collect the 'plan' and 'plan begin' dates"
^XMB(3.9,146047,2,2777,0)="""RTN"",""IBCNEUT2"",186,0)"
^XMB(3.9,146047,2,2778,0)=" . N DQUAL,DTYP,IBA,IBB,IBL,IBOK,IBP,IBPB,IBTDT,IBTDT1"
^XMB(3.9,146047,2,2779,0)="""RTN"",""IBCNEUT2"",187,0)"
^XMB(3.9,146047,2,2780,0)=" . K IBP,IBPB"
^XMB(3.9,146047,2,2781,0)="""RTN"",""IBCNEUT2"",188,0)"
^XMB(3.9,146047,2,2782,0)=" . S IBB="""",(IBOK,IBP,IBPB)=0"
^XMB(3.9,146047,2,2783,0)="""RTN"",""IBCNEUT2"",189,0)"
^XMB(3.9,146047,2,2784,0)=" . F  S IBB=$O(IBCHK(365.07,IBB)) Q:IBB=""""  D  Q:IBOK"
^XMB(3.9,146047,2,2785,0)="""RTN"",""IBCNEUT2"",190,0)"
^XMB(3.9,146047,2,2786,0)=" . . S DTYP=$G(IBCHK(365.07,IBB,.04,""E"")) Q:DTYP'[""C""  ; C is for Subscriber"
^XMB(3.9,146047,2,2787,0)="""RTN"",""IBCNEUT2"",191,0)"
^XMB(3.9,146047,2,2788,0)=" . . S DQUAL=$G(IBCHK(365.07,IBB,.03,""I"")) Q:'DQUAL  S IBA=$$X12^IBCNERP2(365.026,DQUAL)"
^XMB(3.9,146047,2,2789,0)="""RTN"",""IBCNEUT2"",192,0)"
^XMB(3.9,146047,2,2790,0)=" . . I IBA'=""Plan""&(IBA'=""Plan Begin"") Q  ; Must be Plan or Plan Begin"
^XMB(3.9,146047,2,2791,0)="""RTN"",""IBCNEUT2"",193,0)"
^XMB(3.9,146047,2,2792,0)=" . . S IBTDT=$G(IBCHK(365.07,IBB,.02,""I"")),IBTDT=$P(IBTDT,""-"",1),IBTDT=$TR(IBTDT,"" "","""")"
^XMB(3.9,146047,2,2793,0)="""RTN"",""IBCNEUT2"",194,0)"
^XMB(3.9,146047,2,2794,0)=" . . I IBTDT="""" Q  ; must have a date"
^XMB(3.9,146047,2,2795,0)="""RTN"",""IBCNEUT2"",195,0)"
^XMB(3.9,146047,2,2796,0)=" . . S IBTDT1=$$HL7TFM^XLFDT(IBTDT)"
^XMB(3.9,146047,2,2797,0)="""RTN"",""IBCNEUT2"",196,0)"
^XMB(3.9,146047,2,2798,0)=" . . I IBTDT1=""""!(IBTDT1=""-1"") Q  ;must be valid date"
^XMB(3.9,146047,2,2799,0)="""RTN"",""IBCNEUT2"",197,0)"
^XMB(3.9,146047,2,2800,0)=" . . I IBA=""Plan"" I IBSPDT="""" S IBSPDT=IBTDT1"
^XMB(3.9,146047,2,2801,0)="""RTN"",""IBCNEUT2"",198,0)"
^XMB(3.9,146047,2,2802,0)=" . . I IBA=""Plan Begin"" S IBSPDT=IBTDT1,IBOK=1"
^XMB(3.9,146047,2,2803,0)="""RTN"",""IBCNEUT2"",199,0)"
^XMB(3.9,146047,2,2804,0)=" ;"
^XMB(3.9,146047,2,2805,0)="""RTN"",""IBCNEUT2"",200,0)"
^XMB(3.9,146047,2,2806,0)=" I IBSPDT="""" S IBSPDT=$$GET1^DIQ(365,RIEN,""1.11"",""I"")  ; get Effective dt from top display as 2nd default (from IN1 segment)"
^XMB(3.9,146047,2,2807,0)="""RTN"",""IBCNEUT2"",201,0)"
^XMB(3.9,146047,2,2808,0)=" I IBSPDT="""" S IBSPDT=""Unknown""  ;  eff dt default to use for non medicare policies if not found in EB loops"
^XMB(3.9,146047,2,2809,0)="""RTN"",""IBCNEUT2"",202,0)"
^XMB(3.9,146047,2,2810,0)=" ;"
^XMB(3.9,146047,2,2811,0)="""RTN"",""IBCNEUT2"",203,0)"
^XMB(3.9,146047,2,2812,0)=" S IBEFFDT="""",IBEFFDT=$$GET1^DIQ(365,RIEN,""1.11"",""I"") S:'IBEFFDT IBEFFDT=""Unknown"""
^XMB(3.9,146047,2,2813,0)="""RTN"",""IBCNEUT2"",204,0)"
^XMB(3.9,146047,2,2814,0)=" ;"
^XMB(3.9,146047,2,2815,0)="""RTN"",""IBCNEUT2"",205,0)"
^XMB(3.9,146047,2,2816,0)=" S MWNRTYP=$$ISMCARE(RIEN) ; is the payer medicare"
^XMB(3.9,146047,2,2817,0)="""RTN"",""IBCNEUT2"",206,0)"
^XMB(3.9,146047,2,2818,0)=" ;"
^XMB(3.9,146047,2,2819,0)="""RTN"",""IBCNEUT2"",207,0)"
^XMB(3.9,146047,2,2820,0)=" S EBCNT=0 F  S EBCNT=$O(^IBCN(365,RIEN,2,EBCNT)) Q:'EBCNT  D"
^XMB(3.9,146047,2,2821,0)="""RTN"",""IBCNEUT2"",208,0)"
^XMB(3.9,146047,2,2822,0)=" . S IBVIENS=EBCNT_"",""_RIEN_"","""
^XMB(3.9,146047,2,2823,0)="""RTN"",""IBCNEUT2"",209,0)"
^XMB(3.9,146047,2,2824,0)=" . K EB,ERROR"
^XMB(3.9,146047,2,2825,0)="""RTN"",""IBCNEUT2"",210,0)"
^XMB(3.9,146047,2,2826,0)=" . D GETS^DIQ(365.02,IBVIENS,"".02;.03;.04;.05;.06;8*"",""IEN"",""EB"",""EBERR"")"
^XMB(3.9,146047,2,2827,0)="""RTN"",""IBCNEUT2"",211,0)"
^XMB(3.9,146047,2,2828,0)=" . ;"
^XMB(3.9,146047,2,2829,0)="""RTN"",""IBCNEUT2"",212,0)"
^XMB(3.9,146047,2,2830,0)=" . I (EBCNT=1),($G(EB(365.02,IBVIENS,.06,""E""))=""eIV Eligibility Determination"") D  Q  ; use EB loop 1 only to pull FSC's determination and nothing else"
^XMB(3.9,146047,2,2831,0)="""RTN"",""IBCNEUT2"",213,0)"
^XMB(3.9,146047,2,2832,0)=" . . S FSCSTAT=$G(EB(365.02,IBVIENS,.02,""E""))"
^XMB(3.9,146047,2,2833,0)="""RTN"",""IBCNEUT2"",214,0)"
^XMB(3.9,146047,2,2834,0)=" . . S FSCSTAT=$S((FSCSTAT'=1&(FSCSTAT'=6)):""Unknown"",1:FSCSTAT) ; this is what FSC said (Active, Inactive, Ambiguous)"
^XMB(3.9,146047,2,2835,0)="""RTN"",""IBCNEUT2"",215,0)"
^XMB(3.9,146047,2,2836,0)=" . . S IBELGINF=$S(FSCSTAT=1:""ACTIVE Coverage"",FSCSTAT=6:""INACTIVE Coverage"",1:""Unknown"")"
^XMB(3.9,146047,2,2837,0)="""RTN"",""IBCNEUT2"",216,0)"
^XMB(3.9,146047,2,2838,0)=" . ;"
^XMB(3.9,146047,2,2839,0)="""RTN"",""IBCNEUT2"",217,0)"
^XMB(3.9,146047,2,2840,0)=" . S INSTYP=$P($G(^IBE(365.014,+$G(EB(365.02,IBVIENS,.05,""I"")),0)),U,2)"
^XMB(3.9,146047,2,2841,0)="""RTN"",""IBCNEUT2"",218,0)"
^XMB(3.9,146047,2,2842,0)=" . ;"
^XMB(3.9,146047,2,2843,0)="""RTN"",""IBCNEUT2"",219,0)"
^XMB(3.9,146047,2,2844,0)=" . ; X12 271 ELIGIBILITY/BENEFIT file #365.011 - this tag only uses the following codes below:"
^XMB(3.9,146047,2,2845,0)="""RTN"",""IBCNEUT2"",220,0)"
^XMB(3.9,146047,2,2846,0)=" . ; 1=""Active coverage"""
^XMB(3.9,146047,2,2847,0)="""RTN"",""IBCNEUT2"",221,0)"
^XMB(3.9,146047,2,2848,0)=" . ; 2=""Active - Full Risk Capitation"""
^XMB(3.9,146047,2,2849,0)="""RTN"",""IBCNEUT2"",222,0)"
^XMB(3.9,146047,2,2850,0)=" . ; 3=""Active - Services Capitated"""
^XMB(3.9,146047,2,2851,0)="""RTN"",""IBCNEUT2"",223,0)"
^XMB(3.9,146047,2,2852,0)=" . ; 4=""Active - Services Capitated to Primary Care Physician"""
^XMB(3.9,146047,2,2853,0)="""RTN"",""IBCNEUT2"",224,0)"
^XMB(3.9,146047,2,2854,0)=" . ; 6=""Inactive"""
^XMB(3.9,146047,2,2855,0)="""RTN"",""IBCNEUT2"",225,0)"
^XMB(3.9,146047,2,2856,0)=" . ; R=""Other or Additional Payor"""
^XMB(3.9,146047,2,2857,0)="""RTN"",""IBCNEUT2"",226,0)"
^XMB(3.9,146047,2,2858,0)=" . ; U=""Contract Following Entity for Eligibility or Benefit Information"""
^XMB(3.9,146047,2,2859,0)="""RTN"",""IBCNEUT2"",227,0)"
^XMB(3.9,146047,2,2860,0)=" . S EXTELIG=$G(EB(365.02,IBVIENS,.02,""E""))"
^XMB(3.9,146047,2,2861,0)="""RTN"",""IBCNEUT2"",228,0)"
^XMB(3.9,146047,2,2862,0)=" . ;"
^XMB(3.9,146047,2,2863,0)="""RTN"",""IBCNEUT2"",229,0)"
^XMB(3.9,146047,2,2864,0)=" . ; Indicates potential Other Health Insurance (OHI) do OHI checks before quits"
^XMB(3.9,146047,2,2865,0)="""RTN"",""IBCNEUT2"",230,0)"
^XMB(3.9,146047,2,2866,0)=" . I (EXTELIG=2)!(EXTELIG=3)!(EXTELIG=4)!(EXTELIG=""R"")!(EXTELIG=""U"") S ARRAY(""OHI"")=1"
^XMB(3.9,146047,2,2867,0)="""RTN"",""IBCNEUT2"",231,0)"
^XMB(3.9,146047,2,2868,0)=" . ;"
^XMB(3.9,146047,2,2869,0)="""RTN"",""IBCNEUT2"",232,0)"
^XMB(3.9,146047,2,2870,0)=" . I INSTYP="""" Q  ; moved quit to after the OHI check"
^XMB(3.9,146047,2,2871,0)="""RTN"",""IBCNEUT2"",233,0)"
^XMB(3.9,146047,2,2872,0)=" . ;"
^XMB(3.9,146047,2,2873,0)="""RTN"",""IBCNEUT2"",234,0)"
^XMB(3.9,146047,2,2874,0)=" . I (EXTELIG'=1)&(EXTELIG'=6)&(EXTELIG'=2)&(EXTELIG'=3)&(EXTELIG'=4)&(EXTELIG'=""R"")&(EXTELIG'=""U"") Q"
^XMB(3.9,146047,2,2875,0)="""RTN"",""IBCNEUT2"",235,0)"
^XMB(3.9,146047,2,2876,0)=" . ;"
^XMB(3.9,146047,2,2877,0)="""RTN"",""IBCNEUT2"",236,0)"
^XMB(3.9,146047,2,2878,0)=" . S ELGBENINFO=$P($G(^IBE(365.011,+$G(EB(365.02,IBVIENS,.02,""I"")),0)),U,2)"
^XMB(3.9,146047,2,2879,0)="""RTN"",""IBCNEUT2"",237,0)"
^XMB(3.9,146047,2,2880,0)=" . I ELGBENINFO'=""Active Coverage""&(ELGBENINFO'=""Inactive"") Q"
^XMB(3.9,146047,2,2881,0)="""RTN"",""IBCNEUT2"",238,0)"
^XMB(3.9,146047,2,2882,0)=" . ;"
^XMB(3.9,146047,2,2883,0)="""RTN"",""IBCNEUT2"",239,0)"
^XMB(3.9,146047,2,2884,0)=" . S HLDT="""""
^XMB(3.9,146047,2,2885,0)="""RTN"",""IBCNEUT2"",240,0)"
^XMB(3.9,146047,2,2886,0)=" . S ZIEN=""0,""_IBVIENS,IBOK=0"
^XMB(3.9,146047,2,2887,0)="""RTN"",""IBCNEUT2"",241,0)"
^XMB(3.9,146047,2,2888,0)=" . F  S ZIEN=$O(EB(365.28,ZIEN)) Q:ZIEN=""""  D  Q:IBOK=1 "
^XMB(3.9,146047,2,2889,0)="""RTN"",""IBCNEUT2"",242,0)"
^XMB(3.9,146047,2,2890,0)=" . . S DTQUAL=$P($G(^IBE(365.026,+$G(EB(365.28,ZIEN,.03,""I"")),0)),U,2)"
^XMB(3.9,146047,2,2891,0)="""RTN"",""IBCNEUT2"",243,0)"
^XMB(3.9,146047,2,2892,0)=" . . I (MWNRTYP),(DTQUAL'=""Plan"") Q  ; Medicare policies are only looking for ""Plan"""
^XMB(3.9,146047,2,2893,0)="""RTN"",""IBCNEUT2"",244,0)"
^XMB(3.9,146047,2,2894,0)=" . . I ('MWNRTYP),((DTQUAL'=""Plan"")&(DTQUAL'=""Plan Begin"")) Q  ; Non Medicare policies look for ""Plan"" & ""Plan Begin"""
^XMB(3.9,146047,2,2895,0)="""RTN"",""IBCNEUT2"",245,0)"
^XMB(3.9,146047,2,2896,0)=" . . S XXDT=$$HL7TFM^XLFDT($G(EB(365.28,ZIEN,.02,""E"")))"
^XMB(3.9,146047,2,2897,0)="""RTN"",""IBCNEUT2"",246,0)"
^XMB(3.9,146047,2,2898,0)=" . . I MWNRTYP S HLDT=XXDT,IBOK=1 Q  ;Medicare will not have multiple plan dates in same EB loop"
^XMB(3.9,146047,2,2899,0)="""RTN"",""IBCNEUT2"",247,0)"
^XMB(3.9,146047,2,2900,0)=" . . I DTQUAL=""Plan"" I HLDT="""" S HLDT=XXDT"
^XMB(3.9,146047,2,2901,0)="""RTN"",""IBCNEUT2"",248,0)"
^XMB(3.9,146047,2,2902,0)=" . . I DTQUAL=""Plan Begin"" S HLDT=XXDT,IBOK=1"
^XMB(3.9,146047,2,2903,0)="""RTN"",""IBCNEUT2"",249,0)"
^XMB(3.9,146047,2,2904,0)=" . ;"
^XMB(3.9,146047,2,2905,0)="""RTN"",""IBCNEUT2"",250,0)"
^XMB(3.9,146047,2,2906,0)=" . I HLDT="""",ELGBENINFO'=""Inactive"" S ARRAY(""MISSING_EFFDT"")=1"
^XMB(3.9,146047,2,2907,0)="""RTN"",""IBCNEUT2"",251,0)"
^XMB(3.9,146047,2,2908,0)=" . ;"
^XMB(3.9,146047,2,2909,0)="""RTN"",""IBCNEUT2"",252,0)"
^XMB(3.9,146047,2,2910,0)=" . I HLDT=""""&('MWNRTYP) D  ; Non Medicare and no eff dt found in EB loop use default from above"
^XMB(3.9,146047,2,2911,0)="""RTN"",""IBCNEUT2"",253,0)"
^XMB(3.9,146047,2,2912,0)=" . . S HLDT=IBSPDT"
^XMB(3.9,146047,2,2913,0)="""RTN"",""IBCNEUT2"",254,0)"
^XMB(3.9,146047,2,2914,0)=" . ;  "
^XMB(3.9,146047,2,2915,0)="""RTN"",""IBCNEUT2"",255,0)"
^XMB(3.9,146047,2,2916,0)=" . S HLDNDT=$S('HLDT:IBEFFDT,1:HLDT)"
^XMB(3.9,146047,2,2917,0)="""RTN"",""IBCNEUT2"",256,0)"
^XMB(3.9,146047,2,2918,0)=" . ;"
^XMB(3.9,146047,2,2919,0)="""RTN"",""IBCNEUT2"",257,0)"
^XMB(3.9,146047,2,2920,0)=" . ;  TMP array used to avoid repeating duplicate data in summary section (payers repeat themselves)"
^XMB(3.9,146047,2,2921,0)="""RTN"",""IBCNEUT2"",258,0)"
^XMB(3.9,146047,2,2922,0)=" . I $D(^TMP(""EBSUMEUT2"",$J,$S(INSTYP="""":"" "",1:INSTYP),$S(ELGBENINFO="""":"" "",1:ELGBENINFO),HLDNDT)) Q"
^XMB(3.9,146047,2,2923,0)="""RTN"",""IBCNEUT2"",259,0)"
^XMB(3.9,146047,2,2924,0)=" . ;"
^XMB(3.9,146047,2,2925,0)="""RTN"",""IBCNEUT2"",260,0)"
^XMB(3.9,146047,2,2926,0)=" . S ARRAY(EBCNT,INSTYP)=DFN_U_INSTYP_U_HLDT_U_SOI_U_ELGBENINFO"
^XMB(3.9,146047,2,2927,0)="""RTN"",""IBCNEUT2"",261,0)"
^XMB(3.9,146047,2,2928,0)=" . ;"
^XMB(3.9,146047,2,2929,0)="""RTN"",""IBCNEUT2"",262,0)"
^XMB(3.9,146047,2,2930,0)=" . S ^TMP(""EBSUMEUT2"",$J,$S(INSTYP="""":"" "",1:INSTYP),$S(ELGBENINFO="""":"" "",1:ELGBENINFO),HLDNDT)="""""
^XMB(3.9,146047,2,2931,0)="""RTN"",""IBCNEUT2"",263,0)"
^XMB(3.9,146047,2,2932,0)=" ;"
^XMB(3.9,146047,2,2933,0)="""RTN"",""IBCNEUT2"",264,0)"
^XMB(3.9,146047,2,2934,0)=" ;"
^XMB(3.9,146047,2,2935,0)="""RTN"",""IBCNEUT2"",265,0)"
^XMB(3.9,146047,2,2936,0)=" I '$O(ARRAY(0)) D  ; if no ins type is found "
^XMB(3.9,146047,2,2937,0)="""RTN"",""IBCNEUT2"",266,0)"
^XMB(3.9,146047,2,2938,0)=" . I 'MWNRTYP S ARRAY(1,""Unknown"")=$G(DFN)_U_""Unknown""_U_$G(IBSPDT)_U_$G(SOI)_U_$G(IBELGINF) Q"
^XMB(3.9,146047,2,2939,0)="""RTN"",""IBCNEUT2"",267,0)"
^XMB(3.9,146047,2,2940,0)=" . ; Medicare only"
^XMB(3.9,146047,2,2941,0)="""RTN"",""IBCNEUT2"",268,0)"
^XMB(3.9,146047,2,2942,0)=" . S ARRAY(1,""Unknown"")=$G(DFN)_U_""Unknown""_U_""Unknown""_U_$G(SOI)_U_$G(IBELGINF)"
^XMB(3.9,146047,2,2943,0)="""RTN"",""IBCNEUT2"",269,0)"
^XMB(3.9,146047,2,2944,0)=" ;"
^XMB(3.9,146047,2,2945,0)="""RTN"",""IBCNEUT2"",270,0)"
^XMB(3.9,146047,2,2946,0)="XEBSUM ;"
^XMB(3.9,146047,2,2947,0)="""RTN"",""IBCNEUT2"",271,0)"
^XMB(3.9,146047,2,2948,0)=" ;"
^XMB(3.9,146047,2,2949,0)="""RTN"",""IBCNEUT2"",272,0)"
