^XMB(3.9,146018,2,1896,0)=" ;  so that FILE^DIE can check that all are valid before any are filed."
^XMB(3.9,146018,2,1897,0)="""RTN"",""VAFCPTAD"",291,0)"
^XMB(3.9,146018,2,1898,0)=" S FDA(20,NCIENS,1)=$P(NAME,U)"
