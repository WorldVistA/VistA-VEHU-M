^XMB(3.9,146053,2,593,0)="""RTN"",""PSO52API"",175,0)"
^XMB(3.9,146053,2,594,0)=" N LB F LB=0:0 S LB=$O(^PSRX(IEN,""L"",LB)) Q:'LB  S DA(52.032)=LB D LBP"
^XMB(3.9,146053,2,595,0)="""RTN"",""PSO52API"",176,0)"
^XMB(3.9,146053,2,596,0)=" K DA,DR,PST,DIC,DIQ,LB"
^XMB(3.9,146053,2,597,0)="""RTN"",""PSO52API"",177,0)"
^XMB(3.9,146053,2,598,0)=" Q"
^XMB(3.9,146053,2,599,0)="""RTN"",""PSO52API"",178,0)"
^XMB(3.9,146053,2,600,0)="LBP S ^TMP($J,LIST,DFN,IEN,""L"",0)=$G(^TMP($J,LIST,DFN,IEN,""L"",0))+1"
^XMB(3.9,146053,2,601,0)="""RTN"",""PSO52API"",179,0)"
^XMB(3.9,146053,2,602,0)=" K PST S DR(52.032)="".01;1;2;3;4"" S DIC=52,DA=IEN,DR=32 D DIQ"
^XMB(3.9,146053,2,603,0)="""RTN"",""PSO52API"",180,0)"
^XMB(3.9,146053,2,604,0)=" F DR=.01,1,2,3,4 D"
^XMB(3.9,146053,2,605,0)="""RTN"",""PSO52API"",181,0)"
^XMB(3.9,146053,2,606,0)=" .I DR=1 S ^TMP($J,LIST,DFN,IEN,""L"",DA(52.032),DR)=PST(52.032,DA(52.032),DR,""E"") Q"
^XMB(3.9,146053,2,607,0)="""RTN"",""PSO52API"",182,0)"
^XMB(3.9,146053,2,608,0)=" .I PST(52.032,DA(52.032),DR,""E"")'=PST(52.032,DA(52.032),DR,""I"") S ^TMP($J,LIST,DFN,IEN,""L"",DA(52.032),DR)=PST(52.032,DA(52.032),DR,""I"")_""^""_PST(52.032,DA(52.032),DR,""E"") Q"
^XMB(3.9,146053,2,609,0)="""RTN"",""PSO52API"",183,0)"
^XMB(3.9,146053,2,610,0)=" .S ^TMP($J,LIST,DFN,IEN,""L"",DA(52.032),DR)=PST(52.032,DA(52.032),DR,""I"")"
^XMB(3.9,146053,2,611,0)="""RTN"",""PSO52API"",184,0)"
^XMB(3.9,146053,2,612,0)=" K DA,DR,PST,DIC,DIQ"
^XMB(3.9,146053,2,613,0)="""RTN"",""PSO52API"",185,0)"
^XMB(3.9,146053,2,614,0)=" Q"
^XMB(3.9,146053,2,615,0)="""RTN"",""PSO52API"",186,0)"
^XMB(3.9,146053,2,616,0)="CPRS ;CPRS number"
^XMB(3.9,146053,2,617,0)="""RTN"",""PSO52API"",187,0)"
^XMB(3.9,146053,2,618,0)=" K PST S DIC=52,DA=IEN,DR=39.3 D DIQ"
^XMB(3.9,146053,2,619,0)="""RTN"",""PSO52API"",188,0)"
^XMB(3.9,146053,2,620,0)=" I $G(PST(52,DA,DR,""E""))']"""" S ^TMP($J,LIST,DFN,DA,DR)="""" Q"
^XMB(3.9,146053,2,621,0)="""RTN"",""PSO52API"",189,0)"
^XMB(3.9,146053,2,622,0)=" I PST(52,DA,DR,""E"")'=PST(52,DA,DR,""I"") S ^TMP($J,LIST,DFN,IEN,DR)=PST(52,DA,DR,""I"")_""^""_PST(52,DA,DR,""E"") Q"
^XMB(3.9,146053,2,623,0)="""RTN"",""PSO52API"",190,0)"
^XMB(3.9,146053,2,624,0)=" S ^TMP($J,LIST,DFN,IEN,DR)=PST(52,DA,DR,""I"")"
^XMB(3.9,146053,2,625,0)="""RTN"",""PSO52API"",191,0)"
^XMB(3.9,146053,2,626,0)=" K DA,DR,PST,DIC,DIQ"
^XMB(3.9,146053,2,627,0)="""RTN"",""PSO52API"",192,0)"
^XMB(3.9,146053,2,628,0)=" Q"
^XMB(3.9,146053,2,629,0)="""RTN"",""PSO52API"",193,0)"
^XMB(3.9,146053,2,630,0)="DATE ;date range"
^XMB(3.9,146053,2,631,0)="""RTN"",""PSO52API"",194,0)"
^XMB(3.9,146053,2,632,0)=" I $G(SDATE) S DTE=SDATE-1 D  Q"
^XMB(3.9,146053,2,633,0)="""RTN"",""PSO52API"",195,0)"
^XMB(3.9,146053,2,634,0)=" .I $G(EDATE) D  Q"
^XMB(3.9,146053,2,635,0)="""RTN"",""PSO52API"",196,0)"
^XMB(3.9,146053,2,636,0)=" ..F  S DTE=$O(^PS(55,DFN,""P"",""A"",DTE)) Q:'DTE!(DTE>EDATE)  F IEN=0:0 S IEN=$O(^PS(55,DFN,""P"",""A"",DTE,IEN)) Q:'IEN  D:$P($G(^PSRX(IEN,""STA"")),""^"")'=13 PROCESS"
^XMB(3.9,146053,2,637,0)="""RTN"",""PSO52API"",197,0)"
^XMB(3.9,146053,2,638,0)=" .F  S DTE=$O(^PS(55,DFN,""P"",""A"",DTE)) Q:'DTE  F IEN=0:0 S IEN=$O(^PS(55,DFN,""P"",""A"",DTE,IEN)) Q:'IEN  D:$P($G(^PSRX(IEN,""STA"")),""^"")'=13 PROCESS"
^XMB(3.9,146053,2,639,0)="""RTN"",""PSO52API"",198,0)"
^XMB(3.9,146053,2,640,0)=" I $G(EDATE),'$G(SDATE) S DTE=DT-1 D  Q"
^XMB(3.9,146053,2,641,0)="""RTN"",""PSO52API"",199,0)"
^XMB(3.9,146053,2,642,0)=" .F  S DTE=$O(^PS(55,DFN,""P"",""A"",DTE)) Q:'DTE!(DTE>EDATE)  F IEN=0:0 S IEN=$O(^PS(55,DFN,""P"",""A"",DTE,IEN)) Q:'IEN  D:$P($G(^PSRX(IEN,""STA"")),""^"")'=13 PROCESS"
^XMB(3.9,146053,2,643,0)="""RTN"",""PSO52API"",200,0)"
^XMB(3.9,146053,2,644,0)=" S DTE=DT-1 F  S DTE=$O(^PS(55,DFN,""P"",""A"",DTE)) Q:'DTE  F IEN=0:0 S IEN=$O(^PS(55,DFN,""P"",""A"",DTE,IEN)) Q:'IEN  D:$P($G(^PSRX(IEN,""STA"")),""^"")'=13 PROCESS"
^XMB(3.9,146053,2,645,0)="""RTN"",""PSO52API"",201,0)"
^XMB(3.9,146053,2,646,0)=" Q"
^XMB(3.9,146053,2,647,0)="""RTN"",""PSO52API"",202,0)"
^XMB(3.9,146053,2,648,0)="PROF(DFN,LIST,SDATE,EDATE) ;"
^XMB(3.9,146053,2,649,0)="""RTN"",""PSO52API"",203,0)"
^XMB(3.9,146053,2,650,0)=" D ^PSO52AP1"
^XMB(3.9,146053,2,651,0)="""RTN"",""PSO52API"",204,0)"
^XMB(3.9,146053,2,652,0)=" Q"
^XMB(3.9,146053,2,653,0)="""RTN"",""PSO52API"",205,0)"
^XMB(3.9,146053,2,654,0)="IND ;Indication"
^XMB(3.9,146053,2,655,0)="""RTN"",""PSO52API"",206,0)"
^XMB(3.9,146053,2,656,0)=" S:$P($G(^PSRX(IEN,""IND"")),U)]"""" ^TMP($J,LIST,DFN,IEN,""IND"")=$P($G(^PSRX(IEN,""IND"")),U,1,2)"
^XMB(3.9,146053,2,657,0)="""RTN"",""PSO52API"",207,0)"
^XMB(3.9,146053,2,658,0)=" Q"
^XMB(3.9,146053,2,659,0)="""RTN"",""PSO52API"",208,0)"
^XMB(3.9,146053,2,660,0)="DIQ ;process fields"
^XMB(3.9,146053,2,661,0)="""RTN"",""PSO52API"",209,0)"
^XMB(3.9,146053,2,662,0)=" S DIQ=""PST"",DIQ(0)=""IE"" D EN^DIQ1"
^XMB(3.9,146053,2,663,0)="""RTN"",""PSO52API"",210,0)"
^XMB(3.9,146053,2,664,0)=" Q"
^XMB(3.9,146053,2,665,0)="""RTN"",""PSOVEXR1"")"
^XMB(3.9,146053,2,666,0)="0^1^B31123618"
^XMB(3.9,146053,2,667,0)="""RTN"",""PSOVEXR1"",1,0)"
^XMB(3.9,146053,2,668,0)="PSOVEXR1 ;BIRM/KML - PHARMACY TELEPHONE REFILLS - CONTINUED ; 06/07/18 08:47am"
^XMB(3.9,146053,2,669,0)="""RTN"",""PSOVEXR1"",2,0)"
^XMB(3.9,146053,2,670,0)=" ;;7.0;OUTPATIENT PHARMACY;**653**;Dec 1997;Build 0"
^XMB(3.9,146053,2,671,0)="""RTN"",""PSOVEXR1"",3,0)"
^XMB(3.9,146053,2,672,0)=" ;"
^XMB(3.9,146053,2,673,0)="""RTN"",""PSOVEXR1"",4,0)"
^XMB(3.9,146053,2,674,0)="PSOBLD ; This will transfer entries from the vendor daily telephone refill requests global when the pharmacy audio refills option is accessed."
^XMB(3.9,146053,2,675,0)="""RTN"",""PSOVEXR1"",5,0)"
^XMB(3.9,146053,2,676,0)=" ;VEXHRX(19080,PSOSITE,""PSODFN-PSORXIEN"")=PSORDT_""^""_PSOSTAT_""^""_PSOP3_""^""_PSOP4_""^""_PSOORF_""^""_PSORSLT_""^""_PSOUSER_""^""_PSOPRF"
^XMB(3.9,146053,2,677,0)="""RTN"",""PSOVEXR1"",6,0)"
^XMB(3.9,146053,2,678,0)=" ;each time the option is accessed it will add new RXs to the class I ^PS(52.444 file."
^XMB(3.9,146053,2,679,0)="""RTN"",""PSOVEXR1"",7,0)"
^XMB(3.9,146053,2,680,0)=" ;below is a breakdown of the vendor ^VEXHRX(19080 global contents. "
^XMB(3.9,146053,2,681,0)="""RTN"",""PSOVEXR1"",8,0)"
^XMB(3.9,146053,2,682,0)=" ;PSOSITE= Outpatient site number of refill request i.e. 442 for cheyenne VAMC "
^XMB(3.9,146053,2,683,0)="""RTN"",""PSOVEXR1"",9,0)"
^XMB(3.9,146053,2,684,0)=" ;PSODFN=patient dfn from file #2"
^XMB(3.9,146053,2,685,0)="""RTN"",""PSOVEXR1"",10,0)"
^XMB(3.9,146053,2,686,0)=" ;PSORXIEN=the ien of the prescription file. Not the prescription #. the prescription number is actually piece one of the PSRX global "
^XMB(3.9,146053,2,687,0)="""RTN"",""PSOVEXR1"",11,0)"
^XMB(3.9,146053,2,688,0)=" ;PSORDT=the date processed needs to also be set back into vexhrx for clean up."
^XMB(3.9,146053,2,689,0)="""RTN"",""PSOVEXR1"",12,0)"
^XMB(3.9,146053,2,690,0)=" ;PSOSTAT=status of ""NOT FILLED"""
^XMB(3.9,146053,2,691,0)="""RTN"",""PSOVEXR1"",13,0)"
^XMB(3.9,146053,2,692,0)=" ;PSOP3=PIECE NOT USED"
^XMB(3.9,146053,2,693,0)="""RTN"",""PSOVEXR1"",14,0)"
^XMB(3.9,146053,2,694,0)=" ;PSOP4=PIECE NOT USED"
^XMB(3.9,146053,2,695,0)="""RTN"",""PSOVEXR1"",15,0)"
^XMB(3.9,146053,2,696,0)=" ;PSOORF=ORDER RENEW FLAG - SET OF CODES 'N' for NoN Renewable or 'U' unsigned orders allowed and 'I' Incomplete because Unsigned orders not allowed."
^XMB(3.9,146053,2,697,0)="""RTN"",""PSOVEXR1"",16,0)"
^XMB(3.9,146053,2,698,0)=" ;PSORSLT=RENEW PROCESSING RESULT - ORAREN SET OF CODES '0' is processing problem., '1' for OK, '2' for user stopped, '3' not from primary care provider. '5' provider on order terminated no one to send order to."
^XMB(3.9,146053,2,699,0)="""RTN"",""PSOVEXR1"",17,0)"
^XMB(3.9,146053,2,700,0)=" ;PSOUSER=IEN OF NEW PERSON file (#200). User that processed the order, i.e. Auto refills could be  USER,AUDIOCARE"
^XMB(3.9,146053,2,701,0)="""RTN"",""PSOVEXR1"",18,0)"
^XMB(3.9,146053,2,702,0)=" ;PSOPRF=PROVIDER RENEW FLAG - 'P' FOR restricts renewals to THE PATIENTS PRIMARY CARE PROVIDER; 'A' FOR ANY PROVIDER CAN RENEW;"
^XMB(3.9,146053,2,703,0)="""RTN"",""PSOVEXR1"",19,0)"
^XMB(3.9,146053,2,704,0)=" N PSOORF,PSODFN,PSODFNRX,PSOGET,PSOPRF,PSORDT,PSORSLT,PSOUSER,PSOSITE,PSOSITID,PSOXCNT,PSOXPTRN"
^XMB(3.9,146053,2,705,0)="""RTN"",""PSOVEXR1"",20,0)"
^XMB(3.9,146053,2,706,0)=" K FDA,PSOERR"
^XMB(3.9,146053,2,707,0)="""RTN"",""PSOVEXR1"",21,0)"
^XMB(3.9,146053,2,708,0)=" S (PSOORF,PSOPRF,PSORSLT,PSORDT,PSOSTAT,PSOUSER)="""""
^XMB(3.9,146053,2,709,0)="""RTN"",""PSOVEXR1"",22,0)"
^XMB(3.9,146053,2,710,0)=" K ^XTMP(""PSOVEXRX"",$J)"
^XMB(3.9,146053,2,711,0)="""RTN"",""PSOVEXR1"",23,0)"
^XMB(3.9,146053,2,712,0)=" L +^XTMP(""PSOVEXRX""):5 I '$T W !,""Process Telephone Refills is not available.  Please try again later."" S QUIT=1 Q"
^XMB(3.9,146053,2,713,0)="""RTN"",""PSOVEXR1"",24,0)"
^XMB(3.9,146053,2,714,0)=" M ^XTMP(""PSOVEXRX"",$J)=^VEXHRX(19080)   ; populate XTMP with AUDIOCARE vendor array data for further processing"
^XMB(3.9,146053,2,715,0)="""RTN"",""PSOVEXR1"",25,0)"
^XMB(3.9,146053,2,716,0)=" S PSOSITE=0 F  S PSOSITE=$O(^XTMP(""PSOVEXRX"",$J,PSOSITE)) Q:'PSOSITE  D"
^XMB(3.9,146053,2,717,0)="""RTN"",""PSOVEXR1"",26,0)"
^XMB(3.9,146053,2,718,0)=" . S PSODFNRX=0 F  S PSODFNRX=$O(^XTMP(""PSOVEXRX"",$J,PSOSITE,PSODFNRX)) Q:'PSODFNRX  D"
^XMB(3.9,146053,2,719,0)="""RTN"",""PSOVEXR1"",27,0)"
^XMB(3.9,146053,2,720,0)=" . . S PSODFN=$P(PSODFNRX,""-"",1)"
^XMB(3.9,146053,2,721,0)="""RTN"",""PSOVEXR1"",28,0)"
^XMB(3.9,146053,2,722,0)=" . . S PSORXIEN=$P(PSODFNRX,""-"",2)"
^XMB(3.9,146053,2,723,0)="""RTN"",""PSOVEXR1"",29,0)"
^XMB(3.9,146053,2,724,0)=" . . S PSOSITID=$P($G(^PSRX(PSORXIEN,2)),U,9)"
^XMB(3.9,146053,2,725,0)="""RTN"",""PSOVEXR1"",30,0)"
^XMB(3.9,146053,2,726,0)=" . . I PSORXIEN Q:$D(^PS(52.444,""B"",PSORXIEN))  ;This checks to see is a prescription ien is already recorded."
^XMB(3.9,146053,2,727,0)="""RTN"",""PSOVEXR1"",31,0)"
^XMB(3.9,146053,2,728,0)=" . . S PSOGET=$G(^XTMP(""PSOVEXRX"",$J,PSOSITE,PSODFNRX))"
^XMB(3.9,146053,2,729,0)="""RTN"",""PSOVEXR1"",32,0)"
^XMB(3.9,146053,2,730,0)=" . . S:$D(PSOGET) PSORDT=$P(PSOGET,U,1),PSOSTAT=$P(PSOGET,U,2),PSOORF=$P(PSOGET,U,5),PSORSLT=$P(PSOGET,U,6),PSOUSER=$P(PSOGET,U,7),PSOPRF=$P(PSOGET,U,8) Q:$G(PSORDT)"
^XMB(3.9,146053,2,731,0)="""RTN"",""PSOVEXR1"",33,0)"
^XMB(3.9,146053,2,732,0)=" . . ;QUIT ABOVE If a date is already in piece one of the vendor global means the order has been processed."
^XMB(3.9,146053,2,733,0)="""RTN"",""PSOVEXR1"",34,0)"
^XMB(3.9,146053,2,734,0)=" . . ;code below this line adds new RX information to the Class I file 52.444"
^XMB(3.9,146053,2,735,0)="""RTN"",""PSOVEXR1"",35,0)"
^XMB(3.9,146053,2,736,0)=" . . S FDA(1,52.444,""?+1,"",.01)=PSORXIEN"
^XMB(3.9,146053,2,737,0)="""RTN"",""PSOVEXR1"",36,0)"
^XMB(3.9,146053,2,738,0)=" . . S FDA(1,52.444,""?+1,"",1)=PSOSITID"
^XMB(3.9,146053,2,739,0)="""RTN"",""PSOVEXR1"",37,0)"
^XMB(3.9,146053,2,740,0)=" . . S FDA(1,52.444,""?+1,"",2)=PSODFN"
^XMB(3.9,146053,2,741,0)="""RTN"",""PSOVEXR1"",38,0)"
^XMB(3.9,146053,2,742,0)=" . . I $D(PSOSTAT) S FDA(1,52.444,""?+1,"",4)=PSOSTAT"
^XMB(3.9,146053,2,743,0)="""RTN"",""PSOVEXR1"",39,0)"
^XMB(3.9,146053,2,744,0)=" . . I $D(PSOORF) S FDA(1,52.444,""?+1,"",5)=PSOORF"
^XMB(3.9,146053,2,745,0)="""RTN"",""PSOVEXR1"",40,0)"
^XMB(3.9,146053,2,746,0)=" . . I $D(PSORSLT) S FDA(1,52.444,""?+1,"",6)=PSORSLT"
^XMB(3.9,146053,2,747,0)="""RTN"",""PSOVEXR1"",41,0)"
^XMB(3.9,146053,2,748,0)=" . . I $G(PSOUSER) S FDA(1,52.444,""?+1,"",7)=PSOUSER"
^XMB(3.9,146053,2,749,0)="""RTN"",""PSOVEXR1"",42,0)"
^XMB(3.9,146053,2,750,0)=" . . I $D(PSOPRF) S FDA(1,52.444,""?+1,"",8)=PSOPRF"
^XMB(3.9,146053,2,751,0)="""RTN"",""PSOVEXR1"",43,0)"
^XMB(3.9,146053,2,752,0)=" . . D UPDATE^DIE("""",""FDA(1)"",,""PSOERR"")"
^XMB(3.9,146053,2,753,0)="""RTN"",""PSOVEXR1"",44,0)"
^XMB(3.9,146053,2,754,0)=" . . W:$D(PSOERR) !,""Prescription Internal Record number ""_PSORXIEN_"" failed to UPDATE file 52.444"""
^XMB(3.9,146053,2,755,0)="""RTN"",""PSOVEXR1"",45,0)"
^XMB(3.9,146053,2,756,0)=" Q"
^XMB(3.9,146053,2,757,0)="""RTN"",""PSOVEXR1"",46,0)"
^XMB(3.9,146053,2,758,0)=" ;"
^XMB(3.9,146053,2,759,0)="""RTN"",""PSOVEXR1"",47,0)"
^XMB(3.9,146053,2,760,0)="CLEAN ;delete completed records from the new file 52.444."
^XMB(3.9,146053,2,761,0)="""RTN"",""PSOVEXR1"",48,0)"
^XMB(3.9,146053,2,762,0)=" ;scheduled to run daily"
^XMB(3.9,146053,2,763,0)="""RTN"",""PSOVEXR1"",49,0)"
^XMB(3.9,146053,2,764,0)=" N PSORDT,PSORXEN"
^XMB(3.9,146053,2,765,0)="""RTN"",""PSOVEXR1"",50,0)"
^XMB(3.9,146053,2,766,0)=" K ^XTMP(""PSOVEXRX"",$J)"
^XMB(3.9,146053,2,767,0)="""RTN"",""PSOVEXR1"",51,0)"
^XMB(3.9,146053,2,768,0)=" L +^XTMP(""PSOVEXRX""):5 I '$T Q"
^XMB(3.9,146053,2,769,0)="""RTN"",""PSOVEXR1"",52,0)"
^XMB(3.9,146053,2,770,0)=" M ^XTMP(""PSOVEXRX"",$J)=^VEXHRX(19080)   ; populate XTMP with AUDIOCARE vendor array data for further processing"
^XMB(3.9,146053,2,771,0)="""RTN"",""PSOVEXR1"",53,0)"
^XMB(3.9,146053,2,772,0)=" D SETVEN"
^XMB(3.9,146053,2,773,0)="""RTN"",""PSOVEXR1"",54,0)"
^XMB(3.9,146053,2,774,0)=" S PSORDT=0 F  S PSORDT=$O(^PS(52.444,""E"",PSORDT)) Q:'PSORDT  D"
^XMB(3.9,146053,2,775,0)="""RTN"",""PSOVEXR1"",55,0)"
^XMB(3.9,146053,2,776,0)=" . S PSORXEN=0 F  S PSORXEN=$O(^PS(52.444,""E"",PSORDT,PSORXEN)) Q:'PSORXEN  D"
^XMB(3.9,146053,2,777,0)="""RTN"",""PSOVEXR1"",56,0)"
^XMB(3.9,146053,2,778,0)=" . . S DIK=""^PS(52.444,"",DA=PSORXEN D ^DIK K DIK,DA"
^XMB(3.9,146053,2,779,0)="""RTN"",""PSOVEXR1"",57,0)"
^XMB(3.9,146053,2,780,0)=" K XMY N XMDUZ,XMSUB,XMTEXT,XMT"
^XMB(3.9,146053,2,781,0)="""RTN"",""PSOVEXR1"",58,0)"
^XMB(3.9,146053,2,782,0)=" S XMDUZ=""AUTO,RENEWAL"",XMY(DUZ)="""",XMY(""G.AUTORENEWAL"")="""",XMSUB=""Purge PHARMACY TELEPHONE REFILLS file (#52.444)."""
^XMB(3.9,146053,2,783,0)="""RTN"",""PSOVEXR1"",59,0)"
^XMB(3.9,146053,2,784,0)=" S XMT(1,0)=""Purge of processed entries in the """
^XMB(3.9,146053,2,785,0)="""RTN"",""PSOVEXR1"",60,0)"
^XMB(3.9,146053,2,786,0)=" S XMT(2,0)=""PHARMACY TELEPHONE REFILLS file (#52.444) completed."""
^XMB(3.9,146053,2,787,0)="""RTN"",""PSOVEXR1"",61,0)"
^XMB(3.9,146053,2,788,0)=" S XMTEXT=""XMT("""
^XMB(3.9,146053,2,789,0)="""RTN"",""PSOVEXR1"",62,0)"
^XMB(3.9,146053,2,790,0)=" D ^XMD"
^XMB(3.9,146053,2,791,0)="""RTN"",""PSOVEXR1"",63,0)"
^XMB(3.9,146053,2,792,0)=" Q"
^XMB(3.9,146053,2,793,0)="""RTN"",""PSOVEXR1"",64,0)"
^XMB(3.9,146053,2,794,0)=" ;"
^XMB(3.9,146053,2,795,0)="""RTN"",""PSOVEXR1"",65,0)"
^XMB(3.9,146053,2,796,0)="SETVEN ;adds fill date, status and processing result to vendor global to facilitate completion in their process."
^XMB(3.9,146053,2,797,0)="""RTN"",""PSOVEXR1"",66,0)"
^XMB(3.9,146053,2,798,0)=" N PSODATA,PSODFN,PSORDT,PSORSLT,PSORGET,PSORX,PSORXEN,PSORXIEN,PSOSITE,PSOSTAT"
^XMB(3.9,146053,2,799,0)="""RTN"",""PSOVEXR1"",67,0)"
^XMB(3.9,146053,2,800,0)=" S PSOSITE=$$GET1^DIQ(4,$P(^XMB(1,1,""XUS""),""^"",17),99,""I"") ;ICR 10090 and 10091 retrieve parent institution for the site"
^XMB(3.9,146053,2,801,0)="""RTN"",""PSOVEXR1"",68,0)"
^XMB(3.9,146053,2,802,0)=" S (PSOCNT,PSORDT)=0 F  S PSORDT=$O(^PS(52.444,""E"",PSORDT)) Q:'PSORDT  D"
^XMB(3.9,146053,2,803,0)="""RTN"",""PSOVEXR1"",69,0)"
^XMB(3.9,146053,2,804,0)=" . S PSORXEN=0 F  S PSORXEN=$O(^PS(52.444,""E"",PSORDT,PSORXEN)) Q:'PSORXEN  D"
^XMB(3.9,146053,2,805,0)="""RTN"",""PSOVEXR1"",70,0)"
^XMB(3.9,146053,2,806,0)=" . . S PSORGET=$G(^PS(52.444,PSORXEN,0))"
^XMB(3.9,146053,2,807,0)="""RTN"",""PSOVEXR1"",71,0)"
^XMB(3.9,146053,2,808,0)=" . . S PSORXIEN=$P(PSORGET,U,1)"
^XMB(3.9,146053,2,809,0)="""RTN"",""PSOVEXR1"",72,0)"
^XMB(3.9,146053,2,810,0)=" . . S PSOSTAT=$P(PSORGET,U,5),PSORSLT=$P(PSORGET,U,7)"
^XMB(3.9,146053,2,811,0)="""RTN"",""PSOVEXR1"",73,0)"
^XMB(3.9,146053,2,812,0)=" . . S IENS=PSORXIEN_"","""
^XMB(3.9,146053,2,813,0)="""RTN"",""PSOVEXR1"",74,0)"
^XMB(3.9,146053,2,814,0)=" . . D GETS^DIQ(52,IENS,"".01;2;6"","""",""PSORX"")"
^XMB(3.9,146053,2,815,0)="""RTN"",""PSOVEXR1"",75,0)"
^XMB(3.9,146053,2,816,0)=" . . S PSODFN=$P(PSORGET,U,3)"
^XMB(3.9,146053,2,817,0)="""RTN"",""PSOVEXR1"",76,0)"
^XMB(3.9,146053,2,818,0)=" . . S PSODATA=""""_PSODFN_""""_""-""_""""_PSORXIEN_"""""
^XMB(3.9,146053,2,819,0)="""RTN"",""PSOVEXR1"",77,0)"
^XMB(3.9,146053,2,820,0)=" . . Q:'$D(^XTMP(""PSOVEXRX"",$J,PSOSITE,PSODATA))"
^XMB(3.9,146053,2,821,0)="""RTN"",""PSOVEXR1"",78,0)"
^XMB(3.9,146053,2,822,0)=" . . Q:$P(^XTMP(""PSOVEXRX"",$J,PSOSITE,PSODATA),""^"")"
^XMB(3.9,146053,2,823,0)="""RTN"",""PSOVEXR1"",79,0)"
^XMB(3.9,146053,2,824,0)=" . . I $G(PRINT) W !,""RX #: ""_$P(PSORX(52,IENS,"".01""),U,1)_""  RX IEN: ""_IENS_"" was marked processed in the ^VEXHRX Global. """
^XMB(3.9,146053,2,825,0)="""RTN"",""PSOVEXR1"",80,0)"
^XMB(3.9,146053,2,826,0)=" . . S $P(^XTMP(""PSOVEXRX"",$J,PSOSITE,PSODATA),""^"")=PSORDT ;direct set required due to non fileman vendor global for Audiocare maintenance"
^XMB(3.9,146053,2,827,0)="""RTN"",""PSOVEXR1"",81,0)"
^XMB(3.9,146053,2,828,0)=" . . I $D(PSOSTAT) S $P(^XTMP(""PSOVEXRX"",$J,PSOSITE,PSODATA),""^"",2)=PSOSTAT ;direct set required due to non fileman vendor global Audiocare maintenance"
^XMB(3.9,146053,2,829,0)="""RTN"",""PSOVEXR1"",82,0)"
^XMB(3.9,146053,2,830,0)=" . . I $G(PSORSLT)'="""" S $P(^XTMP(""PSOVEXRX"",$J,PSOSITE,PSODATA),""^"",6)=PSORSLT ;direct set required due to non fileman vendor global Audiocare maintenance"
^XMB(3.9,146053,2,831,0)="""RTN"",""PSOVEXR1"",83,0)"
^XMB(3.9,146053,2,832,0)=" . . S PSOCNT=PSOCNT+1"
^XMB(3.9,146053,2,833,0)="""RTN"",""PSOVEXR1"",84,0)"
^XMB(3.9,146053,2,834,0)=" M ^VEXHRX(19080)=^XTMP(""PSOVEXRX"",$J)"
^XMB(3.9,146053,2,835,0)="""RTN"",""PSOVEXR1"",85,0)"
^XMB(3.9,146053,2,836,0)=" K ^XTMP(""PSOVEXRX"",$J)"
^XMB(3.9,146053,2,837,0)="""RTN"",""PSOVEXR1"",86,0)"
^XMB(3.9,146053,2,838,0)=" L -^XTMP(""PSOVEXRX"")"
^XMB(3.9,146053,2,839,0)="""RTN"",""PSOVEXR1"",87,0)"
^XMB(3.9,146053,2,840,0)=" Q"
^XMB(3.9,146053,2,841,0)="""RTN"",""PSOVEXR1"",88,0)"
^XMB(3.9,146053,2,842,0)=" ;"
^XMB(3.9,146053,2,843,0)="""RTN"",""PSOVEXR1"",89,0)"
^XMB(3.9,146053,2,844,0)="TILDECHK(PSORXIEN,PSORXEN) ;check for the tilde character (~) in the free text dosage field of the medications instructions"
^XMB(3.9,146053,2,845,0)="""RTN"",""PSOVEXR1"",90,0)"
^XMB(3.9,146053,2,846,0)=" ; PSORXIEN = input - ien of RX in PRESCRIPTION file (#52)"
^XMB(3.9,146053,2,847,0)="""RTN"",""PSOVEXR1"",91,0)"
^XMB(3.9,146053,2,848,0)=" ; PSORXEN  = input - ien of RX in PHARMACY TELEPHONE REFILLS file (#52.444)"
^XMB(3.9,146053,2,849,0)="""RTN"",""PSOVEXR1"",92,0)"
^XMB(3.9,146053,2,850,0)=" ; RSLT = return as output"
^XMB(3.9,146053,2,851,0)="""RTN"",""PSOVEXR1"",93,0)"
^XMB(3.9,146053,2,852,0)=" N TILDECHK,IENS,I,J,RSLT,CS,DRGIEN"
^XMB(3.9,146053,2,853,0)="""RTN"",""PSOVEXR1"",94,0)"
^XMB(3.9,146053,2,854,0)=" S IENS=PSORXIEN_"","""
^XMB(3.9,146053,2,855,0)="""RTN"",""PSOVEXR1"",95,0)"
^XMB(3.9,146053,2,856,0)=" D GETS^DIQ(52,IENS,""113*"","""",""TILDECHK"")"
^XMB(3.9,146053,2,857,0)="""RTN"",""PSOVEXR1"",96,0)"
^XMB(3.9,146053,2,858,0)=" S DRGIEN=+$P($G(^PSRX(PSORXIEN,0)),U,6)"
^XMB(3.9,146053,2,859,0)="""RTN"",""PSOVEXR1"",97,0)"
^XMB(3.9,146053,2,860,0)=" S CS=$$CSDRUG(DRGIEN)"
^XMB(3.9,146053,2,861,0)="""RTN"",""PSOVEXR1"",98,0)"
^XMB(3.9,146053,2,862,0)=" S RSLT=0"
^XMB(3.9,146053,2,863,0)="""RTN"",""PSOVEXR1"",99,0)"
^XMB(3.9,146053,2,864,0)=" S I=0 F  S I=$O(TILDECHK(52.0113,I)) Q:I=""""  S J=0 F  S J=$O(TILDECHK(52.0113,I,J)) Q:J=""""  I TILDECHK(52.0113,I,J)[""~"" S RSLT=1"
^XMB(3.9,146053,2,865,0)="""RTN"",""PSOVEXR1"",100,0)"
^XMB(3.9,146053,2,866,0)=" I RSLT D"
^XMB(3.9,146053,2,867,0)="""RTN"",""PSOVEXR1"",101,0)"
^XMB(3.9,146053,2,868,0)=" . S IENS=PSORXEN_"","""
^XMB(3.9,146053,2,869,0)="""RTN"",""PSOVEXR1"",102,0)"
^XMB(3.9,146053,2,870,0)=" . S FDA(52.444,IENS,3)=DT D FILE^DIE(,""FDA"",""PSOERR"") ; update the entry with the date processed"
^XMB(3.9,146053,2,871,0)="""RTN"",""PSOVEXR1"",103,0)"
^XMB(3.9,146053,2,872,0)=" S RSLT=RSLT_""^""_CS"
^XMB(3.9,146053,2,873,0)="""RTN"",""PSOVEXR1"",104,0)"
^XMB(3.9,146053,2,874,0)=" Q RSLT"
^XMB(3.9,146053,2,875,0)="""RTN"",""PSOVEXR1"",105,0)"
^XMB(3.9,146053,2,876,0)=" ;"
^XMB(3.9,146053,2,877,0)="""RTN"",""PSOVEXR1"",106,0)"
^XMB(3.9,146053,2,878,0)="CSDRUG(IEN) ;Controlled Substance drug?"
^XMB(3.9,146053,2,879,0)="""RTN"",""PSOVEXR1"",107,0)"
^XMB(3.9,146053,2,880,0)=" ; Input: IEN - DRUG file (#50) pointer "
^XMB(3.9,146053,2,881,0)="""RTN"",""PSOVEXR1"",108,0)"
^XMB(3.9,146053,2,882,0)=" ;Output: $$CS - 1:YES / 0:NO"
^XMB(3.9,146053,2,883,0)="""RTN"",""PSOVEXR1"",109,0)"
^XMB(3.9,146053,2,884,0)=" N DEA"
^XMB(3.9,146053,2,885,0)="""RTN"",""PSOVEXR1"",110,0)"
^XMB(3.9,146053,2,886,0)=" Q:'IEN 0"
^XMB(3.9,146053,2,887,0)="""RTN"",""PSOVEXR1"",111,0)"
^XMB(3.9,146053,2,888,0)=" S DEA=$P($G(^PSDRUG(IEN,0)),U,3)"
^XMB(3.9,146053,2,889,0)="""RTN"",""PSOVEXR1"",112,0)"
^XMB(3.9,146053,2,890,0)=" I (DEA[""2"")!(DEA[""3"")!(DEA[""4"")!(DEA[""5"") Q 1"
^XMB(3.9,146053,2,891,0)="""RTN"",""PSOVEXR1"",113,0)"
^XMB(3.9,146053,2,892,0)=" Q 0"
^XMB(3.9,146053,2,893,0)="""RTN"",""PSOVEXR1"",114,0)"
^XMB(3.9,146053,2,894,0)=" ;"
^XMB(3.9,146053,2,895,0)="""VER"")"
^XMB(3.9,146053,2,896,0)="8.0^22.2"
^XMB(3.9,146053,2,897,0)="$END KID PSO*7.0*832b"
