^XMB(3.9,146037,2,1305,0)="""RTN"",""RCDPESR1"",14,0)"
^XMB(3.9,146037,2,1306,0)=" ; RCTYPE = msg type, if known"
^XMB(3.9,146037,2,1307,0)="""RTN"",""RCDPESR1"",15,0)"
^XMB(3.9,146037,2,1308,0)=" N CT,XMDUZ,XMSUBJ,XMBODY,XMB,XMINSTR,XMTYPE,XMFULL,XMTO,RCXM,XMZ,XMERR,Z"
^XMB(3.9,146037,2,1309,0)="""RTN"",""RCDPESR1"",16,0)"
