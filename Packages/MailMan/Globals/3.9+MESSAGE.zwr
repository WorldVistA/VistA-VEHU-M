^XMB(3.9,146012,2,900,0)=" D FIND^DIC(52.48,"""",""@;.01;1.5;1.6;4.3;4.4;IX"","""",X,,""B"","""","""",""PRVLST"")"
^XMB(3.9,146012,2,901,0)="""RTN"",""PSOERRX0"",213,0)"
^XMB(3.9,146012,2,902,0)=" I '$D(PRVLST(""DILIST"",2)) W !,""No eRx Provider found"" K PRVLST G PRVFLTR"
