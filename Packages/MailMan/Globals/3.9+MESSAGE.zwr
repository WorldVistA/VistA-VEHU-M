^XMB(3.9,146084,2,3489,0)="""RTN"",""SDES2RECLLREQ2"",173,0)"
^XMB(3.9,146084,2,3490,0)="VALIDATESECPDT(ERRORS,SECPRNTDT) ;Validate Second Print Date"
^XMB(3.9,146084,2,3491,0)="""RTN"",""SDES2RECLLREQ2"",174,0)"
^XMB(3.9,146084,2,3492,0)=" S SECPRNTDT=$G(SECPRNTDT,"""")"
^XMB(3.9,146084,2,3493,0)="""RTN"",""SDES2RECLLREQ2"",175,0)"
^XMB(3.9,146084,2,3494,0)=" I SECPRNTDT'="""" S SECPRNTDT=$$ISOTFM^SDAMUTDT(SECPRNTDT)"
^XMB(3.9,146084,2,3495,0)="""RTN"",""SDES2RECLLREQ2"",176,0)"
^XMB(3.9,146084,2,3496,0)=" I SECPRNTDT=-1 S SECPRNTDT=""""  ;VSE-2396"
