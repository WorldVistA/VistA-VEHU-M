^XMB(3.9,146036,2,1129,0)="""KRN"",8994,4260,-1)"
^XMB(3.9,146036,2,1130,0)="0^5"
^XMB(3.9,146036,2,1131,0)="""KRN"",8994,4260,0)"
^XMB(3.9,146036,2,1132,0)="DVBA CAPRI PARAM INQ^PARAMS^DVBCPUSH^2^R^^^^1"
^XMB(3.9,146036,2,1133,0)="""KRN"",8994,4260,1,0)"
^XMB(3.9,146036,2,1134,0)="^8994.01^2^2^3250225^^^^"
^XMB(3.9,146036,2,1135,0)="""KRN"",8994,4260,1,1,0)"
^XMB(3.9,146036,2,1136,0)="This RPC will return all Parameters under the AMIE(DVBA) namespace."
^XMB(3.9,146036,2,1137,0)="""KRN"",8994,4260,1,2,0)"
^XMB(3.9,146036,2,1138,0)="Multiple instances are separated by vertical bars (""|"")."
^XMB(3.9,146036,2,1139,0)="""KRN"",8994,4260,3,0)"
^XMB(3.9,146036,2,1140,0)="^8994.03^3^3^3250225^^^"
^XMB(3.9,146036,2,1141,0)="""KRN"",8994,4260,3,1,0)"
^XMB(3.9,146036,2,1142,0)="For each parameter in the DVB namespace:"
^XMB(3.9,146036,2,1143,0)="""KRN"",8994,4260,3,2,0)"
^XMB(3.9,146036,2,1144,0)="Parameter definition IEN^parameter name^<instance 1 value>|<instance "
^XMB(3.9,146036,2,1145,0)="""KRN"",8994,4260,3,3,0)"
^XMB(3.9,146036,2,1146,0)="2 value>|<instance 3 value>..."
^XMB(3.9,146036,2,1147,0)="""KRN"",8994,4261,-1)"
^XMB(3.9,146036,2,1148,0)="0^6"
^XMB(3.9,146036,2,1149,0)="""KRN"",8994,4261,0)"
^XMB(3.9,146036,2,1150,0)="DVBA CAPRI PARAM UPDATE^PARAMED^DVBCPUSH^1^R^^^^1"
^XMB(3.9,146036,2,1151,0)="""KRN"",8994,4261,1,0)"
^XMB(3.9,146036,2,1152,0)="^8994.01^8^8^3250227^^"
^XMB(3.9,146036,2,1153,0)="""KRN"",8994,4261,1,1,0)"
^XMB(3.9,146036,2,1154,0)="This RPC allows CAPRI to update CAPRI Parameter values."
^XMB(3.9,146036,2,1155,0)="""KRN"",8994,4261,1,2,0)"
^XMB(3.9,146036,2,1156,0)="If the parameter has multiples, then the multiple instance values are "
^XMB(3.9,146036,2,1157,0)="""KRN"",8994,4261,1,3,0)"
^XMB(3.9,146036,2,1158,0)="sent in the 3rd input parameter (DVBVAL) separated by vertical bars (""|"")."
^XMB(3.9,146036,2,1159,0)="""KRN"",8994,4261,1,4,0)"
^XMB(3.9,146036,2,1160,0)="The RPC will delete all instances and replace them with the new values in "
^XMB(3.9,146036,2,1161,0)="""KRN"",8994,4261,1,5,0)"
^XMB(3.9,146036,2,1162,0)="DVBVAL.  If a single null value is sent, then all instances are deleted."
^XMB(3.9,146036,2,1163,0)="""KRN"",8994,4261,1,6,0)"
^XMB(3.9,146036,2,1164,0)="For word processing values, the bars ""|"" can be used in place of carriage "
^XMB(3.9,146036,2,1165,0)="""KRN"",8994,4261,1,7,0)"
^XMB(3.9,146036,2,1166,0)="returns. If the information is longer than 250 characters, the RPC will "
