^XMB(3.9,146020,2,936,0)=" Q MPIXML"
^XMB(3.9,146020,2,937,0)="""RTN"",""MPIFXMLP"",133,0)"
^XMB(3.9,146020,2,938,0)=" ;"
^XMB(3.9,146020,2,939,0)="""RTN"",""MPIFXMLP"",134,0)"
^XMB(3.9,146020,2,940,0)="IFADD(MPIVAR,MPIARR,MPIXML,MPIXMLN) ;check if there, if so add it to the XML"
^XMB(3.9,146020,2,941,0)="""RTN"",""MPIFXMLP"",135,0)"
^XMB(3.9,146020,2,942,0)=" ; MPIVAR is the MPIARR variable name"
^XMB(3.9,146020,2,943,0)="""RTN"",""MPIFXMLP"",136,0)"
^XMB(3.9,146020,2,944,0)=" ; MPIXMLN is the name of the XML to encase"
^XMB(3.9,146020,2,945,0)="""RTN"",""MPIFXMLP"",137,0)"
^XMB(3.9,146020,2,946,0)=" ; modifies MPIXML to add if it is there"
^XMB(3.9,146020,2,947,0)="""RTN"",""MPIFXMLP"",138,0)"
^XMB(3.9,146020,2,948,0)=" I $G(MPIARR(MPIVAR))'="""" D"
^XMB(3.9,146020,2,949,0)="""RTN"",""MPIFXMLP"",139,0)"
^XMB(3.9,146020,2,950,0)=" . S MPIXML=MPIXML_""<""_MPIXMLN_"">""_MPIARR(MPIVAR)_""</""_MPIXMLN_"">"""
^XMB(3.9,146020,2,951,0)="""RTN"",""MPIFXMLP"",140,0)"
^XMB(3.9,146020,2,952,0)=" Q"
^XMB(3.9,146020,2,953,0)="""RTN"",""MPIFXMLP"",141,0)"
^XMB(3.9,146020,2,954,0)=" ;"
^XMB(3.9,146020,2,955,0)="""RTN"",""MPIFXMLP"",142,0)"
^XMB(3.9,146020,2,956,0)="CONV(FIELD) ;check for &, ', > and <"
^XMB(3.9,146020,2,957,0)="""RTN"",""MPIFXMLP"",143,0)"
^XMB(3.9,146020,2,958,0)=" I FIELD[""&"" S FIELD=$P(FIELD,""&"")_""&amp;""_$P(FIELD,""&"",2)"
^XMB(3.9,146020,2,959,0)="""RTN"",""MPIFXMLP"",144,0)"
^XMB(3.9,146020,2,960,0)=" I FIELD[""'"" S FIELD=$P(FIELD,""'"")_""&apos;""_$P(FIELD,""'"",2)"
^XMB(3.9,146020,2,961,0)="""RTN"",""MPIFXMLP"",145,0)"
^XMB(3.9,146020,2,962,0)=" S:(FIELD[""<"") FIELD=$$CONVA(FIELD,""<"")"
^XMB(3.9,146020,2,963,0)="""RTN"",""MPIFXMLP"",146,0)"
^XMB(3.9,146020,2,964,0)=" S:(FIELD["">"") FIELD=$$CONVA(FIELD,"">"")"
^XMB(3.9,146020,2,965,0)="""RTN"",""MPIFXMLP"",147,0)"
^XMB(3.9,146020,2,966,0)=" Q FIELD"
^XMB(3.9,146020,2,967,0)="""RTN"",""MPIFXMLP"",148,0)"
^XMB(3.9,146020,2,968,0)=" ;"
^XMB(3.9,146020,2,969,0)="""RTN"",""MPIFXMLP"",149,0)"
^XMB(3.9,146020,2,970,0)="CONVA(FIELD,ENCHAR) ;handle <<pob city>>"
^XMB(3.9,146020,2,971,0)="""RTN"",""MPIFXMLP"",150,0)"
^XMB(3.9,146020,2,972,0)=" N I,X,VAL"
^XMB(3.9,146020,2,973,0)="""RTN"",""MPIFXMLP"",151,0)"
^XMB(3.9,146020,2,974,0)=" S VAL="""",I=$L(FIELD,ENCHAR) F X=1:1:I S VAL=VAL_$P(FIELD,ENCHAR,X)"
^XMB(3.9,146020,2,975,0)="""RTN"",""MPIFXMLP"",152,0)"
^XMB(3.9,146020,2,976,0)=" Q VAL"
^XMB(3.9,146020,2,977,0)="""RTN"",""MPIFXMLP"",153,0)"
^XMB(3.9,146020,2,978,0)=" ;"
^XMB(3.9,146020,2,979,0)="""RTN"",""MPIFXMLP"",154,0)"
^XMB(3.9,146020,2,980,0)="PARSE(MPIDATA,MPIXML) ; - parse the data"
^XMB(3.9,146020,2,981,0)="""RTN"",""MPIFXMLP"",155,0)"
^XMB(3.9,146020,2,982,0)=" ;"
^XMB(3.9,146020,2,983,0)="""RTN"",""MPIFXMLP"",156,0)"
^XMB(3.9,146020,2,984,0)=" ; EN^MXMLPRSE - #4149"
^XMB(3.9,146020,2,985,0)="""RTN"",""MPIFXMLP"",157,0)"
^XMB(3.9,146020,2,986,0)=" ;"
^XMB(3.9,146020,2,987,0)="""RTN"",""MPIFXMLP"",158,0)"
^XMB(3.9,146020,2,988,0)=" K ^TMP($J,""MPIFXMLP"")"
^XMB(3.9,146020,2,989,0)="""RTN"",""MPIFXMLP"",159,0)"
^XMB(3.9,146020,2,990,0)=" N MPICB,MPIUSE,MPIVAR,MPIPAT,MPIALIAS,MPILOC,MPIIDS,MPIIGNID"
^XMB(3.9,146020,2,991,0)="""RTN"",""MPIFXMLP"",160,0)"
^XMB(3.9,146020,2,992,0)=" S (MPIPAT,MPIIDS)=0"
^XMB(3.9,146020,2,993,0)="""RTN"",""MPIFXMLP"",161,0)"
^XMB(3.9,146020,2,994,0)=" S MPICB(""STARTELEMENT"")=""SE^MPIFXMLP"""
^XMB(3.9,146020,2,995,0)="""RTN"",""MPIFXMLP"",162,0)"
^XMB(3.9,146020,2,996,0)=" S MPICB(""CHARACTERS"")=""VALUE^MPIFXMLP"""
^XMB(3.9,146020,2,997,0)="""RTN"",""MPIFXMLP"",163,0)"
^XMB(3.9,146020,2,998,0)=" S ^TMP($J,""MPIFXMLP"",1)=MPIXML"
^XMB(3.9,146020,2,999,0)="""RTN"",""MPIFXMLP"",164,0)"
^XMB(3.9,146020,2,1000,0)=" D EN^MXMLPRSE($NA(^TMP($J,""MPIFXMLP"")),.MPICB)"
^XMB(3.9,146020,2,1001,0)="""RTN"",""MPIFXMLP"",165,0)"
