^XMB(3.9,146082,2,237,0)="""RTN"",""XPDIST"")"
^XMB(3.9,146082,2,238,0)="0^1^B18772831"
^XMB(3.9,146082,2,239,0)="""RTN"",""XPDIST"",1,0)"
^XMB(3.9,146082,2,240,0)="XPDIST ;SFISC/RSD - site tracking ;03/05/2008"
^XMB(3.9,146082,2,241,0)="""RTN"",""XPDIST"",2,0)"
^XMB(3.9,146082,2,242,0)=" ;;8.0;KERNEL;**66,108,185,233,350,393,486,539,547,672**;Jul 10, 1995;Build 0"
^XMB(3.9,146082,2,243,0)="""RTN"",""XPDIST"",3,0)"
^XMB(3.9,146082,2,244,0)=" ;Per VHA Directive 2004-038, this routine should not be modified."
^XMB(3.9,146082,2,245,0)="""RTN"",""XPDIST"",4,0)"
^XMB(3.9,146082,2,246,0)=" ;Returns """"=failed, XMZ=sent"
^XMB(3.9,146082,2,247,0)="""RTN"",""XPDIST"",5,0)"
^XMB(3.9,146082,2,248,0)=" ;D0=ien in file 9.7, XPY=national site tracking^address(optional)"
^XMB(3.9,146082,2,249,0)="""RTN"",""XPDIST"",6,0)"
^XMB(3.9,146082,2,250,0)="EN(D0,XPY) ;EF. send message"
^XMB(3.9,146082,2,251,0)="""RTN"",""XPDIST"",7,0)"
^XMB(3.9,146082,2,252,0)=" N %,DIFROM,XPD,XPD0,XPD1,XPD2,XPDV,XPZ,X,X1,Z,Y,XPD6,XPDTRACK"
^XMB(3.9,146082,2,253,0)="""RTN"",""XPDIST"",8,0)"
^XMB(3.9,146082,2,254,0)=" ;Get data needed"
^XMB(3.9,146082,2,255,0)="""RTN"",""XPDIST"",9,0)"
^XMB(3.9,146082,2,256,0)=" I '$D(^XPD(9.7,$G(D0),0)) D BMES^XPDUTL("" INSTALL file entry missing"") Q """""
^XMB(3.9,146082,2,257,0)="""RTN"",""XPDIST"",10,0)"
^XMB(3.9,146082,2,258,0)=" ;p350 -add node 6 for the Test# and Seq#. -REM"
^XMB(3.9,146082,2,259,0)="""RTN"",""XPDIST"",11,0)"
^XMB(3.9,146082,2,260,0)=" S XPD0=^XPD(9.7,D0,0),XPD1=$G(^(1)),XPD2=$G(^(2)),XPD6=$G(^(6))"
^XMB(3.9,146082,2,261,0)="""RTN"",""XPDIST"",12,0)"
^XMB(3.9,146082,2,262,0)=" I '$P(XPD0,U,2) D BMES^XPDUTL("" No link to PACKAGE file"") Q """""
^XMB(3.9,146082,2,263,0)="""RTN"",""XPDIST"",13,0)"
^XMB(3.9,146082,2,264,0)=" S XPD=$P($G(^DIC(9.4,+$P(XPD0,U,2),0)),U),XPDV=$$VER^XPDUTL($P(XPD0,U))"
^XMB(3.9,146082,2,265,0)="""RTN"",""XPDIST"",14,0)"
^XMB(3.9,146082,2,266,0)=" I XPD="""" D BMES^XPDUTL("" PACKAGE file entry missing"") Q """""
^XMB(3.9,146082,2,267,0)="""RTN"",""XPDIST"",15,0)"
^XMB(3.9,146082,2,268,0)=" ;XPZ(1)=start, XPZ(2)=completion date/time, XPZ(3)=run time"
^XMB(3.9,146082,2,269,0)="""RTN"",""XPDIST"",16,0)"
^XMB(3.9,146082,2,270,0)=" S XPZ(1)=$P(XPD1,U),XPZ(2)=$P(XPD1,U,3),XPZ(3)=$$FMDIFF^XLFDT(XPZ(2),XPZ(1),3),XPZ(1)=$$FMTE^XLFDT(XPZ(1)),XPZ(2)=$$FMTE^XLFDT(XPZ(2))"
^XMB(3.9,146082,2,271,0)="""RTN"",""XPDIST"",17,0)"
^XMB(3.9,146082,2,272,0)=" D LOCAL"
^XMB(3.9,146082,2,273,0)="""RTN"",""XPDIST"",18,0)"
^XMB(3.9,146082,2,274,0)=" S XPDTRACK=$$TRACK"
^XMB(3.9,146082,2,275,0)="""RTN"",""XPDIST"",19,0)"
^XMB(3.9,146082,2,276,0)=" D REMEDY ;p350 -REM"
^XMB(3.9,146082,2,277,0)="""RTN"",""XPDIST"",20,0)"
^XMB(3.9,146082,2,278,0)=" Q $$FORUM()"
^XMB(3.9,146082,2,279,0)="""RTN"",""XPDIST"",21,0)"
^XMB(3.9,146082,2,280,0)="LOCAL ;Send a message to local mail group"
^XMB(3.9,146082,2,281,0)="""RTN"",""XPDIST"",22,0)"
^XMB(3.9,146082,2,282,0)=" N XMY,XPDTEXT,XMTEXT,XMDUZ,XMSUB,XMZ,XMMG"
^XMB(3.9,146082,2,283,0)="""RTN"",""XPDIST"",23,0)"
^XMB(3.9,146082,2,284,0)=" K ^TMP($J)"
^XMB(3.9,146082,2,285,0)="""RTN"",""XPDIST"",24,0)"
^XMB(3.9,146082,2,286,0)=" S X=$$MAILGRP^XPDUTL(XPD) Q:X="""""
^XMB(3.9,146082,2,287,0)="""RTN"",""XPDIST"",25,0)"
^XMB(3.9,146082,2,288,0)=" S XMY(X)="""" D GETENV^%ZOSV"
^XMB(3.9,146082,2,289,0)="""RTN"",""XPDIST"",26,0)"
^XMB(3.9,146082,2,290,0)=" ;Message for users"
^XMB(3.9,146082,2,291,0)="""RTN"",""XPDIST"",27,0)"
^XMB(3.9,146082,2,292,0)=" S XPDTEXT(1,0)=""PACKAGE INSTALL"""
^XMB(3.9,146082,2,293,0)="""RTN"",""XPDIST"",28,0)"
^XMB(3.9,146082,2,294,0)=" S XPDTEXT(2,0)=""SITE: ""_$G(^XMB(""NETNAME""))"
^XMB(3.9,146082,2,295,0)="""RTN"",""XPDIST"",29,0)"
^XMB(3.9,146082,2,296,0)=" S XPDTEXT(3,0)=""PACKAGE: ""_XPD"
^XMB(3.9,146082,2,297,0)="""RTN"",""XPDIST"",30,0)"
^XMB(3.9,146082,2,298,0)=" S XPDTEXT(4,0)=""VERSION: ""_XPDV"
^XMB(3.9,146082,2,299,0)="""RTN"",""XPDIST"",31,0)"
^XMB(3.9,146082,2,300,0)=" S XPDTEXT(5,0)=""Start time: ""_XPZ(1)"
^XMB(3.9,146082,2,301,0)="""RTN"",""XPDIST"",32,0)"
