^XMB(3.9,146089,2,822,0)=" Q"
^XMB(3.9,146089,2,823,0)="""RTN"",""PSOORFI5"",103,0)"
^XMB(3.9,146089,2,824,0)=" ;"
^XMB(3.9,146089,2,825,0)="""RTN"",""PSOORFI5"",104,0)"
^XMB(3.9,146089,2,826,0)="R D R^PSOORFI2 ; Process ROUTINE priority"
^XMB(3.9,146089,2,827,0)="""RTN"",""PSOORFI5"",105,0)"
^XMB(3.9,146089,2,828,0)=" Q"
^XMB(3.9,146089,2,829,0)="""RTN"",""PSOORFI5"",106,0)"
^XMB(3.9,146089,2,830,0)=" ;"
^XMB(3.9,146089,2,831,0)="""RTN"",""PSOORFI5"",107,0)"
^XMB(3.9,146089,2,832,0)="LMDISP(ORD) ; Backdoor ListManager Display of Flag/Unflag Information"
^XMB(3.9,146089,2,833,0)="""RTN"",""PSOORFI5"",108,0)"
^XMB(3.9,146089,2,834,0)=" N FLAG"
^XMB(3.9,146089,2,835,0)="""RTN"",""PSOORFI5"",109,0)"
^XMB(3.9,146089,2,836,0)=" K FLAGLINE S ORD=+$G(ORD) I 'ORD Q"
^XMB(3.9,146089,2,837,0)="""RTN"",""PSOORFI5"",110,0)"
^XMB(3.9,146089,2,838,0)=" ;"
^XMB(3.9,146089,2,839,0)="""RTN"",""PSOORFI5"",111,0)"
^XMB(3.9,146089,2,840,0)=" I '$G(^PS(52.41,ORD,""FLG"")) Q"
^XMB(3.9,146089,2,841,0)="""RTN"",""PSOORFI5"",112,0)"
^XMB(3.9,146089,2,842,0)=" ; S X=IORVON_""Flagged""_IORVOFF"
^XMB(3.9,146089,2,843,0)="""RTN"",""PSOORFI5"",113,0)"
^XMB(3.9,146089,2,844,0)=" D GETS^DIQ(52.41,ORD,""33;34;35;36;37;38"",""IE"",""FLAG"")"
^XMB(3.9,146089,2,845,0)="""RTN"",""PSOORFI5"",114,0)"
^XMB(3.9,146089,2,846,0)=" S L1=""Flagged by ""_$E(FLAG(52.41,ORD_"","",34,""E""),1,30)_"" on ""_$$FMTE^XLFDT(FLAG(52.41,ORD_"","",33,""I""),2)_"": """
^XMB(3.9,146089,2,847,0)="""RTN"",""PSOORFI5"",115,0)"
^XMB(3.9,146089,2,848,0)=" S LEN=80-$L(L1),L1=L1_$E(FLAG(52.41,ORD_"","",35,""E""),1,LEN),L2=$E(FLAG(52.41,ORD_"","",35,""E""),LEN+1,999)"
^XMB(3.9,146089,2,849,0)="""RTN"",""PSOORFI5"",116,0)"
^XMB(3.9,146089,2,850,0)=" S IEN=IEN+1,^TMP(""PSOPO"",$J,IEN,0)=L1,FLAGLINE(IEN)=7"
^XMB(3.9,146089,2,851,0)="""RTN"",""PSOORFI5"",117,0)"
^XMB(3.9,146089,2,852,0)=" I L2'="""" S IEN=IEN+1,^TMP(""PSOPO"",$J,IEN,0)=L2"
^XMB(3.9,146089,2,853,0)="""RTN"",""PSOORFI5"",118,0)"
^XMB(3.9,146089,2,854,0)=" I FLAG(52.41,ORD_"","",36,""I"")'="""" D"
^XMB(3.9,146089,2,855,0)="""RTN"",""PSOORFI5"",119,0)"
^XMB(3.9,146089,2,856,0)=" . S L1=""Unflagged by ""_$E(FLAG(52.41,ORD_"","",37,""E""),1,30)_"" on ""_$$FMTE^XLFDT(FLAG(52.41,ORD_"","",36,""I""),2)_"": """
^XMB(3.9,146089,2,857,0)="""RTN"",""PSOORFI5"",120,0)"
^XMB(3.9,146089,2,858,0)=" . S LEN=80-$L(L1),L1=L1_$E(FLAG(52.41,ORD_"","",38,""E""),1,LEN),L2=$E(FLAG(52.41,ORD_"","",38,""E""),LEN+1,999)"
^XMB(3.9,146089,2,859,0)="""RTN"",""PSOORFI5"",121,0)"
^XMB(3.9,146089,2,860,0)=" . S IEN=IEN+1,^TMP(""PSOPO"",$J,IEN,0)=L1,FLAGLINE(IEN)=9"
^XMB(3.9,146089,2,861,0)="""RTN"",""PSOORFI5"",122,0)"
^XMB(3.9,146089,2,862,0)=" . I L2'="""" S IEN=IEN+1,^TMP(""PSOPO"",$J,IEN,0)=L2"
^XMB(3.9,146089,2,863,0)="""RTN"",""PSOORFI5"",123,0)"
^XMB(3.9,146089,2,864,0)=" S IEN=IEN+1,^TMP(""PSOPO"",$J,IEN,0)="" """
^XMB(3.9,146089,2,865,0)="""RTN"",""PSOORFI5"",124,0)"
^XMB(3.9,146089,2,866,0)=" Q"
^XMB(3.9,146089,2,867,0)="""RTN"",""PSOORFI5"",125,0)"
^XMB(3.9,146089,2,868,0)=" ;"
^XMB(3.9,146089,2,869,0)="""RTN"",""PSOORFI5"",126,0)"
^XMB(3.9,146089,2,870,0)="CS ; Digitally Signed CS - PSO*7*391"
^XMB(3.9,146089,2,871,0)="""RTN"",""PSOORFI5"",127,0)"
^XMB(3.9,146089,2,872,0)=" K DIR"
^XMB(3.9,146089,2,873,0)="""RTN"",""PSOORFI5"",128,0)"
^XMB(3.9,146089,2,874,0)=" N PSOCSRT,PSOPARKX,RESULTS,Y"
^XMB(3.9,146089,2,875,0)="""RTN"",""PSOORFI5"",129,0)"
^XMB(3.9,146089,2,876,0)=" S DIR(""A"")=""Route"",DIR(0)=""SBM^W:WINDOW;M:MAIL;B:BOTH;E:EXIT"",DIR(""B"")=""BOTH"""
^XMB(3.9,146089,2,877,0)="""RTN"",""PSOORFI5"",130,0)"
^XMB(3.9,146089,2,878,0)=" S RESULTS=""PSOPARKX"" D GETPARK^PSORPC01()"
^XMB(3.9,146089,2,879,0)="""RTN"",""PSOORFI5"",131,0)"
^XMB(3.9,146089,2,880,0)=" I $G(PSOPARKX(0))=""YES"" S DIR(0)=""SBM^W:WINDOW;M:MAIL;P:PARK;A:ALL;E:EXIT"",DIR(""B"")=""ALL"""
^XMB(3.9,146089,2,881,0)="""RTN"",""PSOORFI5"",132,0)"
^XMB(3.9,146089,2,882,0)=" D ^DIR"
^XMB(3.9,146089,2,883,0)="""RTN"",""PSOORFI5"",133,0)"
^XMB(3.9,146089,2,884,0)=" Q:$D(DIRUT)!(Y=""E"")"
^XMB(3.9,146089,2,885,0)="""RTN"",""PSOORFI5"",134,0)"
^XMB(3.9,146089,2,886,0)=" S PSOCSRT=$S(Y=""A"":1,Y=""B"":1,1:Y)"
^XMB(3.9,146089,2,887,0)="""RTN"",""PSOORFI5"",135,0)"
^XMB(3.9,146089,2,888,0)=" W !!,""Select a schedule(s)"""
^XMB(3.9,146089,2,889,0)="""RTN"",""PSOORFI5"",136,0)"
^XMB(3.9,146089,2,890,0)=" K DIR S PSOSORT=""DIGITALLY SIGNED"""
^XMB(3.9,146089,2,891,0)="""RTN"",""PSOORFI5"",137,0)"
^XMB(3.9,146089,2,892,0)=" S DIR(""A"")=""Select Schedule(s)"",DIR(0)=""S^1:SCHEDULE II;2:SCHEDULES III - V;3:SCHEDULES II - V;4:NON-CS+SCHEDULES III - V;5:NON-CS ONLY;E:EXIT"",DIR(""B"")=3"
^XMB(3.9,146089,2,893,0)="""RTN"",""PSOORFI5"",138,0)"
^XMB(3.9,146089,2,894,0)=" D ^DIR G:$D(DIRUT)!(Y=""E"") EX S PSOSORT=PSOSORT_""^""_Y,PSRT=Y"
^XMB(3.9,146089,2,895,0)="""RTN"",""PSOORFI5"",139,0)"
^XMB(3.9,146089,2,896,0)=" N SECSORT S SECSORT=$$DIR^PSOORFI6(""CS:CONTROLLED SUBSTANCES"",Y) Q:SECSORT=U"
^XMB(3.9,146089,2,897,0)="""RTN"",""PSOORFI5"",140,0)"
^XMB(3.9,146089,2,898,0)=" N PDEA,OR0 S LG=0,PATA=0 F  S LG=$O(^PS(52.41,""AD"",LG)) Q:'LG!($G(POERR(""QFLG"")))  F PSOD=0:0 S PSOD=$O(^PS(52.41,""AD"",LG,PSOPINST,PSOD)) Q:'PSOD!($G(POERR(""QFLG"")))  D"
^XMB(3.9,146089,2,899,0)="""RTN"",""PSOORFI5"",141,0)"
^XMB(3.9,146089,2,900,0)=" .Q:'$D(^PS(52.41,PSOD,0))"
^XMB(3.9,146089,2,901,0)="""RTN"",""PSOORFI5"",142,0)"
^XMB(3.9,146089,2,902,0)=" .S OR0=^PS(52.41,PSOD,0)"
^XMB(3.9,146089,2,903,0)="""RTN"",""PSOORFI5"",143,0)"
^XMB(3.9,146089,2,904,0)=" .;PSO*7*505 - still quit if the order is flagged, but now only look for digital signature if the selection does not ask for non contolled substances"
^XMB(3.9,146089,2,905,0)="""RTN"",""PSOORFI5"",144,0)"
^XMB(3.9,146089,2,906,0)=" .I $P(OR0,""^"",23),$P(SECSORT,""^"",1)'=""FL"" Q"
^XMB(3.9,146089,2,907,0)="""RTN"",""PSOORFI5"",145,0)"
^XMB(3.9,146089,2,908,0)=" .S PDEA=0 D PDEA Q:'PDEA!(PDEA'=PSRT)"
^XMB(3.9,146089,2,909,0)="""RTN"",""PSOORFI5"",146,0)"
^XMB(3.9,146089,2,910,0)=" .;PSO*7*505 moved digitally signed check after the DEA check (Disregards eRx Pending orders)"
^XMB(3.9,146089,2,911,0)="""RTN"",""PSOORFI5"",147,0)"
^XMB(3.9,146089,2,912,0)=" .I PSRT<4,'$$ERXIEN^PSOERXUT(PSOD_""P""),'$P(OR0,""^"",24) Q"
^XMB(3.9,146089,2,913,0)="""RTN"",""PSOORFI5"",148,0)"
^XMB(3.9,146089,2,914,0)=" .I 'PSOCSRT,PSOCSRT'=$P(OR0,""^"",17) Q"
^XMB(3.9,146089,2,915,0)="""RTN"",""PSOORFI5"",149,0)"
^XMB(3.9,146089,2,916,0)=" .Q:$G(PAT($P(OR0,""^"",2)))=$P(OR0,""^"",2)  S PAT=$P(OR0,""^"",2)"
^XMB(3.9,146089,2,917,0)="""RTN"",""PSOORFI5"",150,0)"
^XMB(3.9,146089,2,918,0)=" .I PAT'=PATA K PSORX(""DOSING OFF"") I $O(PSORX(""PSOL"",0))!($D(RXRS)) D LBL^PSOORFIN"
^XMB(3.9,146089,2,919,0)="""RTN"",""PSOORFI5"",151,0)"
^XMB(3.9,146089,2,920,0)=" .D LK I $G(POERR(""QFLG"")) K POERR(""QFLG"") S PSOLK=1,PAT(PAT)=PAT Q"
^XMB(3.9,146089,2,921,0)="""RTN"",""PSOORFI5"",152,0)"
^XMB(3.9,146089,2,922,0)=" .I $$CHK^PSODPT(PAT_""^""_$P($G(^DPT(PAT,0)),""^""),1,1)<0 S PSOLK=1,PAT(PAT)=PAT S X=PAT D ULP K PSOQFLG,PSOQQ Q"
^XMB(3.9,146089,2,923,0)="""RTN"",""PSOORFI5"",153,0)"
^XMB(3.9,146089,2,924,0)=" .S (PSODFN,Y)=PAT_""^""_$P($G(^DPT(PAT,0)),""^""),PATA=PAT"
^XMB(3.9,146089,2,925,0)="""RTN"",""PSOORFI5"",154,0)"
^XMB(3.9,146089,2,926,0)=" .I SECSORT'=0,'$$CHKFLTR^PSOORFI6(PSOD,SECSORT) Q"
^XMB(3.9,146089,2,927,0)="""RTN"",""PSOORFI5"",155,0)"
^XMB(3.9,146089,2,928,0)=" .D:'$G(MEDA) PROFILE^PSOORFI2 S Y=PSODFN I $G(MEDP) D SPL D OERR^PSORX1 S PSOFIN=1 D QU S X=PSOPTLOK D KLLP,ULP,KLL Q"
^XMB(3.9,146089,2,929,0)="""RTN"",""PSOORFI5"",156,0)"
^XMB(3.9,146089,2,930,0)=" .D SDFN D POST^PSOORFI1 I $G(PSOQFLG)!($G(PSOQUIT)) S:$G(PSOQUIT) POERR(""QFLG"")=1 S:$G(PSOQFLG) PAT(PAT)=PAT S X=PAT D ULP K PSOQFLG Q"
^XMB(3.9,146089,2,931,0)="""RTN"",""PSOORFI5"",157,0)"
^XMB(3.9,146089,2,932,0)=" .S PAT(PAT)=PAT"
^XMB(3.9,146089,2,933,0)="""RTN"",""PSOORFI5"",158,0)"
^XMB(3.9,146089,2,934,0)=" .F ORD=0:0 S ORD=$O(^PS(52.41,""AOR"",PAT,PSOPINST,ORD)) Q:'ORD!($G(POERR(""QFLG"")))!($G(PSOQQ))  D"
^XMB(3.9,146089,2,935,0)="""RTN"",""PSOORFI5"",159,0)"
^XMB(3.9,146089,2,936,0)=" ..Q:'$D(^PS(52.41,ORD,0))"
^XMB(3.9,146089,2,937,0)="""RTN"",""PSOORFI5"",160,0)"
^XMB(3.9,146089,2,938,0)=" ..S OR0=^PS(52.41,ORD,0)"
^XMB(3.9,146089,2,939,0)="""RTN"",""PSOORFI5"",161,0)"
^XMB(3.9,146089,2,940,0)=" ..;PSO*505 - Move the check for digitally signed, so non-cs substances will be shown if selected as sort criteria"
^XMB(3.9,146089,2,941,0)="""RTN"",""PSOORFI5"",162,0)"
^XMB(3.9,146089,2,942,0)=" ..I $P(OR0,U,23),$P(SECSORT,""^"",1)'=""FL"" Q"
^XMB(3.9,146089,2,943,0)="""RTN"",""PSOORFI5"",163,0)"
^XMB(3.9,146089,2,944,0)=" ..I SECSORT'=0,'$$CHKFLTR^PSOORFI6(ORD,SECSORT) Q"
^XMB(3.9,146089,2,945,0)="""RTN"",""PSOORFI5"",164,0)"
^XMB(3.9,146089,2,946,0)=" ..I 'PSOCSRT,PSOCSRT'=$P(OR0,""^"",17) Q"
^XMB(3.9,146089,2,947,0)="""RTN"",""PSOORFI5"",165,0)"
^XMB(3.9,146089,2,948,0)=" ..Q:$P(OR0,""^"",3)=""DC""!($P(OR0,""^"",3)=""DE"")"
^XMB(3.9,146089,2,949,0)="""RTN"",""PSOORFI5"",166,0)"
^XMB(3.9,146089,2,950,0)=" ..S PDEA=0 D PDEA Q:'PDEA!(PDEA'=PSRT)"
^XMB(3.9,146089,2,951,0)="""RTN"",""PSOORFI5"",167,0)"
^XMB(3.9,146089,2,952,0)=" ..I PSRT<4,'$$ERXIEN^PSOERXUT(ORD_""P""),'$P(OR0,""^"",24) Q"
^XMB(3.9,146089,2,953,0)="""RTN"",""PSOORFI5"",168,0)"
^XMB(3.9,146089,2,954,0)=" ..D PP,LK1,ORD^PSOORFIN"
^XMB(3.9,146089,2,955,0)="""RTN"",""PSOORFI5"",169,0)"
^XMB(3.9,146089,2,956,0)=" .S X=PAT D ULP K PSOQQ"
^XMB(3.9,146089,2,957,0)="""RTN"",""PSOORFI5"",170,0)"
^XMB(3.9,146089,2,958,0)=" I $O(PSORX(""PSOL"",0))!($D(RXRS)) D LBL^PSOORFIN"
^XMB(3.9,146089,2,959,0)="""RTN"",""PSOORFI5"",171,0)"
^XMB(3.9,146089,2,960,0)=" I $G(PSOQUIT) K PSOQUIT D EX G ^PSOORFIN"
^XMB(3.9,146089,2,961,0)="""RTN"",""PSOORFI5"",172,0)"
^XMB(3.9,146089,2,962,0)=" G EX"
^XMB(3.9,146089,2,963,0)="""RTN"",""PSOORFI5"",173,0)"
^XMB(3.9,146089,2,964,0)=" ;"
^XMB(3.9,146089,2,965,0)="""RTN"",""PSOORFI5"",174,0)"
^XMB(3.9,146089,2,966,0)="PDEA ;"
^XMB(3.9,146089,2,967,0)="""RTN"",""PSOORFI5"",175,0)"
^XMB(3.9,146089,2,968,0)=" I +$P(OR0,""^"",9) S PDEA=$P($G(^PSDRUG($P(OR0,""^"",9),0)),""^"",3),PDEA=$S(PDEA[2:1,PDEA[3!(PDEA[4)!(PDEA[5):2,1:0)"
^XMB(3.9,146089,2,969,0)="""RTN"",""PSOORFI5"",176,0)"
^XMB(3.9,146089,2,970,0)=" E  S PDEA=$$OIDEA^PSSUTLA1($P(OR0,""^"",8),""O"")"
^XMB(3.9,146089,2,971,0)="""RTN"",""PSOORFI5"",177,0)"
^XMB(3.9,146089,2,972,0)=" ; PSO*7*505 - adding checks for new sort criteria"
^XMB(3.9,146089,2,973,0)="""RTN"",""PSOORFI5"",178,0)"
^XMB(3.9,146089,2,974,0)=" ; PDEA=0 OR 2, covers non-cs and schedule 3-5"
^XMB(3.9,146089,2,975,0)="""RTN"",""PSOORFI5"",179,0)"
^XMB(3.9,146089,2,976,0)=" I (PDEA=0)!(PDEA=2),PSRT=4 S PDEA=4 Q"
^XMB(3.9,146089,2,977,0)="""RTN"",""PSOORFI5"",180,0)"
^XMB(3.9,146089,2,978,0)=" I PDEA=0,PSRT=5 S PDEA=5 Q"
^XMB(3.9,146089,2,979,0)="""RTN"",""PSOORFI5"",181,0)"
^XMB(3.9,146089,2,980,0)=" ; PSO*7*505 end"
^XMB(3.9,146089,2,981,0)="""RTN"",""PSOORFI5"",182,0)"
^XMB(3.9,146089,2,982,0)=" I PDEA,PSRT=3 S PDEA=3"
^XMB(3.9,146089,2,983,0)="""RTN"",""PSOORFI5"",183,0)"
^XMB(3.9,146089,2,984,0)=" Q"
^XMB(3.9,146089,2,985,0)="""RTN"",""PSOORFI5"",184,0)"
^XMB(3.9,146089,2,986,0)=" ;"
^XMB(3.9,146089,2,987,0)="""RTN"",""PSOORFI5"",185,0)"
^XMB(3.9,146089,2,988,0)="PRV(PROV,DRG,ORN) ;"
^XMB(3.9,146089,2,989,0)="""RTN"",""PSOORFI5"",186,0)"
^XMB(3.9,146089,2,990,0)=" N DETN,DEA,I,LBL,VADD,SPC"
^XMB(3.9,146089,2,991,0)="""RTN"",""PSOORFI5"",187,0)"
^XMB(3.9,146089,2,992,0)=" I PROV="""" Q"
^XMB(3.9,146089,2,993,0)="""RTN"",""PSOORFI5"",188,0)"
^XMB(3.9,146089,2,994,0)=" ;*545 - show DEA label only, get the stored DEA#"
^XMB(3.9,146089,2,995,0)="""RTN"",""PSOORFI5"",189,0)"
^XMB(3.9,146089,2,996,0)=" S:$L($G(PSORX(""RXDEA""))) DEA=PSORX(""RXDEA"")"
^XMB(3.9,146089,2,997,0)="""RTN"",""PSOORFI5"",190,0)"
^XMB(3.9,146089,2,998,0)=" ;If renew, try to get DEA from the renewal from CPRS rather than the original RX, provider may have changed"
^XMB(3.9,146089,2,999,0)="""RTN"",""PSOORFI5"",191,0)"
^XMB(3.9,146089,2,1000,0)=" I $G(PSOORRNW),$G(ORN) S DEA=$$RXDEA^PSOUTIL(,ORN)"
^XMB(3.9,146089,2,1001,0)="""RTN"",""PSOORFI5"",192,0)"
^XMB(3.9,146089,2,1002,0)=" I '$L($G(DEA)) S DEA=$S($G(PSONEW(""OIRXN"")):$$RXDEA^PSOUTIL(PSONEW(""OIRXN"")),$G(ORN):$$RXDEA^PSOUTIL(,ORN),1:$$DEA^XUSER(0,PROV)) S:DEA]"""" PSORX(""RXDEA"")=DEA"
^XMB(3.9,146089,2,1003,0)="""RTN"",""PSOORFI5"",193,0)"
^XMB(3.9,146089,2,1004,0)=" S:$L($G(PSORX(""DETX""))) DETN=PSORX(""DETX"")"
