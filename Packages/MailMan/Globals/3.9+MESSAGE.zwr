^XMB(3.9,146043,2,749,0)="""RTN"",""MDCLIO1"",254,0)"
^XMB(3.9,146043,2,750,0)="GETLOG ; Get list of date/time pairs with data"
^XMB(3.9,146043,2,751,0)="""RTN"",""MDCLIO1"",255,0)"
