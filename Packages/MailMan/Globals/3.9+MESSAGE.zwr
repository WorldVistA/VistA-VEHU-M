^XMB(3.9,146107,2,328,0)=" ;"
^XMB(3.9,146107,2,329,0)="""RTN"",""PSJORUT2"",45,0)"
^XMB(3.9,146107,2,330,0)="ENVOL2(PN,ARRAY) ;Only for Med Button IV orders."
^XMB(3.9,146107,2,331,0)="""RTN"",""PSJORUT2"",46,0)"
^XMB(3.9,146107,2,332,0)=" I (PN'[""A"")&(PN'[""B"") S ARRAY=""0"" Q"
^XMB(3.9,146107,2,333,0)="""RTN"",""PSJORUT2"",47,0)"
^XMB(3.9,146107,2,334,0)=" N X,XX,F,INACT"
^XMB(3.9,146107,2,335,0)="""RTN"",""PSJORUT2"",48,0)"
^XMB(3.9,146107,2,336,0)=" S X(1)=""ML"",X(2)=""LITER"",X(3)=""MCG"",X(4)=""MG"",X(5)=""GM"",X(6)=""UNITS"",X(7)=""IU"",X(8)=""MEQ"",X(9)=""MM"",X(10)=""MU"",X(11)=""THOUU"",X(12)=""MG-PE"",X(13)=""NANOGRAM"",X(14)=""MMOL"""
^XMB(3.9,146107,2,337,0)="""RTN"",""PSJORUT2"",49,0)"
^XMB(3.9,146107,2,338,0)=" I PN[""A"" N ADD S (ADD,X,XX)=0 F  S ADD=$O(^PS(52.6,""AOI"",+PN,ADD))  Q:ADD=""""  D"
^XMB(3.9,146107,2,339,0)="""RTN"",""PSJORUT2"",50,0)"
^XMB(3.9,146107,2,340,0)=" .S INACT=$G(^PS(52.6,ADD,""I"")) I INACT']""""!(INACT>DT) S XX=XX+1,ARRAY(ADD)=""^""_X($P($G(^PS(52.6,ADD,0)),U,3)) Q"
^XMB(3.9,146107,2,341,0)="""RTN"",""PSJORUT2"",51,0)"
^XMB(3.9,146107,2,342,0)=" I PN[""B"" N SOL S SOL=0,XX=0 F  S SOL=$O(^PS(52.7,""AOI"",+PN,SOL)) Q:SOL=""""  D"
^XMB(3.9,146107,2,343,0)="""RTN"",""PSJORUT2"",52,0)"
^XMB(3.9,146107,2,344,0)=" .S INACT=$G(^PS(52.7,SOL,""I"")) I INACT']""""!(INACT>DT) S XX=XX+1,ARRAY(SOL)=$P($G(^PS(52.7,SOL,0)),""^"",3)"
^XMB(3.9,146107,2,345,0)="""RTN"",""PSJORUT2"",53,0)"
