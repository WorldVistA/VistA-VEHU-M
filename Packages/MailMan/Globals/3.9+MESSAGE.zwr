^XMB(3.9,146087,2,3546,0)=" S I="""",CATHIT=0 F  S I=$O(^XTMP(""YTQASMT-SET-""_ASMT,1,""instruments"",I)) Q:'I  D"
^XMB(3.9,146087,2,3547,0)="""RTN"",""YTQRQAD4"",260,0)"
^XMB(3.9,146087,2,3548,0)=" .K DATA"
^XMB(3.9,146087,2,3549,0)="""RTN"",""YTQRQAD4"",261,0)"
^XMB(3.9,146087,2,3550,0)=" .M DATA=^XTMP(""YTQASMT-SET-""_ASMT,1,""instruments"",I)"
^XMB(3.9,146087,2,3551,0)="""RTN"",""YTQRQAD4"",262,0)"
^XMB(3.9,146087,2,3552,0)=" .S NAME=$G(DATA(""name""))"
^XMB(3.9,146087,2,3553,0)="""RTN"",""YTQRQAD4"",263,0)"
^XMB(3.9,146087,2,3554,0)=" .S TSTIEN=$G(DATA(""id""))"
