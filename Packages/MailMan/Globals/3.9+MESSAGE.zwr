^XMB(3.9,146035,2,246,0)=" ;"
^XMB(3.9,146035,2,247,0)="""RTN"",""PSOBBC"",4,0)"
^XMB(3.9,146035,2,248,0)=" ;External reference to ^IBE(350.1,""ANEW"" supported by DBIA 592"
^XMB(3.9,146035,2,249,0)="""RTN"",""PSOBBC"",5,0)"
^XMB(3.9,146035,2,250,0)=" ;External references CHPUS^IBACUS and TRI^IBACUS supported by DBIA 2030"
^XMB(3.9,146035,2,251,0)="""RTN"",""PSOBBC"",6,0)"
^XMB(3.9,146035,2,252,0)=" ;External references LK^ORX2 and ULK^ORX2 supported by DBIA 867"
^XMB(3.9,146035,2,253,0)="""RTN"",""PSOBBC"",7,0)"
