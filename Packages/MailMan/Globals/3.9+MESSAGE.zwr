^XMB(3.9,146098,2,980,0)=" N TIMEZONE,X,J,SDLOC,SDPROV,SDPRNM,SDTEL,SDTELEXT,SDTMP,SDHX,SDT0,DOW"
^XMB(3.9,146098,2,981,0)="""RTN"",""SDES2APTLETTER"",169,0)"
^XMB(3.9,146098,2,982,0)=" S TIMEZONE=$$TIMEZONEDATA^SDESUTIL($G(SDC)),TIMEZONE=$P($G(TIMEZONE),U)"
^XMB(3.9,146098,2,983,0)="""RTN"",""SDES2APTLETTER"",170,0)"
^XMB(3.9,146098,2,984,0)=" S:$D(SDX) X=SDX S SDHX=X D DW^%DTC S DOW=X,X=SDHX ;"
^XMB(3.9,146098,2,985,0)="""RTN"",""SDES2APTLETTER"",171,0)"
^XMB(3.9,146098,2,986,0)=" I $P(X,""."",2)=12!($P(X,""."",2)=24) S X=""12:00 ""_$S($P(X,""."",2)=12:""N"",1:""M"") ;"
^XMB(3.9,146098,2,987,0)="""RTN"",""SDES2APTLETTER"",172,0)"
^XMB(3.9,146098,2,988,0)=" E  X ^DD(""FUNC"",2,1) ;"
^XMB(3.9,146098,2,989,0)="""RTN"",""SDES2APTLETTER"",173,0)"
^XMB(3.9,146098,2,990,0)=" S SDT0=X,SDDAT=$P(""JAN^FEB^MAR^APR^MAY^JUN^JUL^AUG^SEP^OCT^NOV^DEC"",""^"",$E(SDHX,4,5))_"" ""_+$E(SDHX,6,7)_"", ""_(1700+$E(SDHX,1,3))"
^XMB(3.9,146098,2,991,0)="""RTN"",""SDES2APTLETTER"",174,0)"
^XMB(3.9,146098,2,992,0)=" I '$D(LEXPROC) D"
^XMB(3.9,146098,2,993,0)="""RTN"",""SDES2APTLETTER"",175,0)"
^XMB(3.9,146098,2,994,0)=" .S SDECI=SDECI+1,^TMP(""SDEC_COMP"",$J,""scheduledAppointments"",SDECI)=""     Date/Time: ""_DOW_""  ""_$J(SDDAT,12)_$S('$D(LEXPROC)&$D(SDC):$J(SDT0,9),1:"""")_"" ""_TIMEZONE"
^XMB(3.9,146098,2,995,0)="""RTN"",""SDES2APTLETTER"",176,0)"
^XMB(3.9,146098,2,996,0)=" I '$D(LEXPROC),$D(SDC) D"
^XMB(3.9,146098,2,997,0)="""RTN"",""SDES2APTLETTER"",177,0)"
^XMB(3.9,146098,2,998,0)=" .S SDECI=SDECI+1,^TMP(""SDEC_COMP"",$J,""scheduledAppointments"",SDECI)=""    ""_SDCL"
^XMB(3.9,146098,2,999,0)="""RTN"",""SDES2APTLETTER"",178,0)"
^XMB(3.9,146098,2,1000,0)=" ; get default provider if defined for a given clinic, print it on the"
^XMB(3.9,146098,2,1001,0)="""RTN"",""SDES2APTLETTER"",179,0)"
^XMB(3.9,146098,2,1002,0)=" ; letter only if we have a YES on file, same for clinic location"
^XMB(3.9,146098,2,1003,0)="""RTN"",""SDES2APTLETTER"",180,0)"
^XMB(3.9,146098,2,1004,0)=" ; skip printing the provider label if the field is empty in file #44"
^XMB(3.9,146098,2,1005,0)="""RTN"",""SDES2APTLETTER"",181,0)"
^XMB(3.9,146098,2,1006,0)=" S SDLOC=$$GET1^DIQ(44,+SDC,10,""I"") ; physical location of the clinic"
^XMB(3.9,146098,2,1007,0)="""RTN"",""SDES2APTLETTER"",182,0)"
^XMB(3.9,146098,2,1008,0)=" S SDTEL=$$GET1^DIQ(44,+SDC,99,""I"")        ; telephone number of clinic"
^XMB(3.9,146098,2,1009,0)="""RTN"",""SDES2APTLETTER"",183,0)"
^XMB(3.9,146098,2,1010,0)=" S SDTELEXT="""" I SDTEL]"""",$$GET1^DIQ(44,+SDC,99.1,""I"")]"""" D"
^XMB(3.9,146098,2,1011,0)="""RTN"",""SDES2APTLETTER"",184,0)"
^XMB(3.9,146098,2,1012,0)=" .S SDTELEXT=$$GET1^DIQ(44,+SDC,99.1,""I"")  ; telephone ext of clinic"
^XMB(3.9,146098,2,1013,0)="""RTN"",""SDES2APTLETTER"",185,0)"
^XMB(3.9,146098,2,1014,0)=" ; get default provider, if any"
^XMB(3.9,146098,2,1015,0)="""RTN"",""SDES2APTLETTER"",186,0)"
^XMB(3.9,146098,2,1016,0)=" F J=0:0 S J=$O(^SC(+SDC,""PR"",J)) Q:'J>0  D"
^XMB(3.9,146098,2,1017,0)="""RTN"",""SDES2APTLETTER"",187,0)"
^XMB(3.9,146098,2,1018,0)=" . I $$GET1^DIQ(44.1,J_"",""_+SDC_"","",.02,""I"")'=1 Q"
^XMB(3.9,146098,2,1019,0)="""RTN"",""SDES2APTLETTER"",188,0)"
^XMB(3.9,146098,2,1020,0)=" . S SDPROV=$$GET1^DIQ(44.1,J_"",""_+SDC_"","",.01,""I"")"
^XMB(3.9,146098,2,1021,0)="""RTN"",""SDES2APTLETTER"",189,0)"
^XMB(3.9,146098,2,1022,0)=" I $D(SDC),'$D(LEXPROC),$$GET1^DIQ(407.5,SDLET,5,""I"")=""Y"" D"
^XMB(3.9,146098,2,1023,0)="""RTN"",""SDES2APTLETTER"",190,0)"
^XMB(3.9,146098,2,1024,0)=" . I SDLOC]"""" S SDECI=SDECI+1 S ^TMP(""SDEC_COMP"",$J,""scheduledAppointments"",SDECI)=""     ""_""Location:  ""_SDLOC"
^XMB(3.9,146098,2,1025,0)="""RTN"",""SDES2APTLETTER"",191,0)"
^XMB(3.9,146098,2,1026,0)=" I $D(SDC),'$D(LEXPROC),SDTEL]"""" D"
^XMB(3.9,146098,2,1027,0)="""RTN"",""SDES2APTLETTER"",192,0)"
^XMB(3.9,146098,2,1028,0)=" . S SDTMP=""     Telephone:  ""_SDTEL"
^XMB(3.9,146098,2,1029,0)="""RTN"",""SDES2APTLETTER"",193,0)"
^XMB(3.9,146098,2,1030,0)=" . I SDTELEXT]"""" S SDTMP=SDTMP_""   Telephone Ext.:  ""_SDTELEXT"
^XMB(3.9,146098,2,1031,0)="""RTN"",""SDES2APTLETTER"",194,0)"
^XMB(3.9,146098,2,1032,0)=" . S SDECI=SDECI+1,^TMP(""SDEC_COMP"",$J,""scheduledAppointments"",SDECI)=SDTMP"
^XMB(3.9,146098,2,1033,0)="""RTN"",""SDES2APTLETTER"",195,0)"
^XMB(3.9,146098,2,1034,0)=" I $D(SDPROV) D"
^XMB(3.9,146098,2,1035,0)="""RTN"",""SDES2APTLETTER"",196,0)"
^XMB(3.9,146098,2,1036,0)=" . I $D(SDC),SDPROV>0 S SDPRNM=$P(^VA(200,SDPROV,0),U,1)"
^XMB(3.9,146098,2,1037,0)="""RTN"",""SDES2APTLETTER"",197,0)"
^XMB(3.9,146098,2,1038,0)=" . I $D(SDC),'$D(LEXPROC),$P($G(^VA(407.5,SDLET,3)),U,1)=""Y"" I SDPRNM]"""" S SDECI=SDECI+1,^TMP(""SDEC_COMP"",$J,""scheduledAppointments"",SDECI)=""     Provider:  ""_$G(SDPRNM)"
^XMB(3.9,146098,2,1039,0)="""RTN"",""SDES2APTLETTER"",198,0)"
^XMB(3.9,146098,2,1040,0)=" ; call handler for LAB, XRAY, and EKG tests"
^XMB(3.9,146098,2,1041,0)="""RTN"",""SDES2APTLETTER"",199,0)"
^XMB(3.9,146098,2,1042,0)=" I $D(LEXPROC) D TST(SDCL,DOW)"
^XMB(3.9,146098,2,1043,0)="""RTN"",""SDES2APTLETTER"",200,0)"
^XMB(3.9,146098,2,1044,0)=" Q"
^XMB(3.9,146098,2,1045,0)="""RTN"",""SDES2APTLETTER"",201,0)"
^XMB(3.9,146098,2,1046,0)="REST(DFN,SDC,SD,LT,SDLET,SDFORM) ;WRITE THE REMAINDER OF LETTER"
^XMB(3.9,146098,2,1047,0)="""RTN"",""SDES2APTLETTER"",202,0)"
^XMB(3.9,146098,2,1048,0)=" N FINSEC"
^XMB(3.9,146098,2,1049,0)="""RTN"",""SDES2APTLETTER"",203,0)"
^XMB(3.9,146098,2,1050,0)=" ;loop and display final section of Letter"
^XMB(3.9,146098,2,1051,0)="""RTN"",""SDES2APTLETTER"",204,0)"
^XMB(3.9,146098,2,1052,0)=" S FINSEC=0 F  S FINSEC=$O(^VA(407.5,SDLET,2,FINSEC)) Q:FINSEC'>0  D"
^XMB(3.9,146098,2,1053,0)="""RTN"",""SDES2APTLETTER"",205,0)"
^XMB(3.9,146098,2,1054,0)=" . S SDECI=SDECI+1,^TMP(""SDEC_COMP"",$J,""textClosing"",SDECI)=$$GET1^DIQ(407.53,FINSEC_"",""_SDLET_"","",.01,""E"")"
^XMB(3.9,146098,2,1055,0)="""RTN"",""SDES2APTLETTER"",206,0)"
^XMB(3.9,146098,2,1056,0)=" I SDFORM=1 D ADDR(DFN)"
^XMB(3.9,146098,2,1057,0)="""RTN"",""SDES2APTLETTER"",207,0)"
^XMB(3.9,146098,2,1058,0)=" Q"
^XMB(3.9,146098,2,1059,0)="""RTN"",""SDES2APTLETTER"",208,0)"
^XMB(3.9,146098,2,1060,0)="ADDR(DFN) ;"
^XMB(3.9,146098,2,1061,0)="""RTN"",""SDES2APTLETTER"",209,0)"
^XMB(3.9,146098,2,1062,0)=" K VAHOW"
^XMB(3.9,146098,2,1063,0)="""RTN"",""SDES2APTLETTER"",210,0)"
^XMB(3.9,146098,2,1064,0)=" N SDIENS,X,SDCCACT1,SDCCACT2,LL,VAPA,VACNTRY"
^XMB(3.9,146098,2,1065,0)="""RTN"",""SDES2APTLETTER"",211,0)"
^XMB(3.9,146098,2,1066,0)=" S SDECI=SDECI+1,^TMP(""SDEC_COMP"",$J,""addressPatient"",SDECI)=$$FILL(11,"" "")_$$FML^DGNFUNC(DFN)"
^XMB(3.9,146098,2,1067,0)="""RTN"",""SDES2APTLETTER"",212,0)"
^XMB(3.9,146098,2,1068,0)=" I $D(^DG(43,1,""BT"")),'$$GET1^DIQ(43,1,722,""I"") S VAPA(""P"")="""""
^XMB(3.9,146098,2,1069,0)="""RTN"",""SDES2APTLETTER"",213,0)"
^XMB(3.9,146098,2,1070,0)=" D ADD^VADPT"
^XMB(3.9,146098,2,1071,0)="""RTN"",""SDES2APTLETTER"",214,0)"
^XMB(3.9,146098,2,1072,0)=" ;CHANGE STATE TO ABBR."
^XMB(3.9,146098,2,1073,0)="""RTN"",""SDES2APTLETTER"",215,0)"
^XMB(3.9,146098,2,1074,0)=" I $D(VAPA(5)) S SDIENS=+VAPA(5)_"","",X=$$GET1^DIQ(5,SDIENS,1),$P(VAPA(5),U,2)=X"
^XMB(3.9,146098,2,1075,0)="""RTN"",""SDES2APTLETTER"",216,0)"
^XMB(3.9,146098,2,1076,0)=" I $D(VAPA(17)) S SDIENS=+VAPA(17)_"","",X=$$GET1^DIQ(5,SDIENS,1),$P(VAPA(17),U,2)=X"
^XMB(3.9,146098,2,1077,0)="""RTN"",""SDES2APTLETTER"",217,0)"
^XMB(3.9,146098,2,1078,0)=" S SDCCACT1=VAPA(12),SDCCACT2=$P($G(VAPA(22,2)),""^"",3)"
^XMB(3.9,146098,2,1079,0)="""RTN"",""SDES2APTLETTER"",218,0)"
^XMB(3.9,146098,2,1080,0)=" ;if confidential address is not active for scheduling/appointment letters, print to regular address"
^XMB(3.9,146098,2,1081,0)="""RTN"",""SDES2APTLETTER"",219,0)"
^XMB(3.9,146098,2,1082,0)=" I ($G(SDCCACT1)=0)!($G(SDCCACT2)'=""Y"") D"
^XMB(3.9,146098,2,1083,0)="""RTN"",""SDES2APTLETTER"",220,0)"
^XMB(3.9,146098,2,1084,0)=" . F LL=1:1:3 I VAPA(LL)]"""" S SDECI=SDECI+1,^TMP(""SDEC_COMP"",$J,""addressPatient"",SDECI)=$$FILL(11,"" "")_VAPA(LL)"
^XMB(3.9,146098,2,1085,0)="""RTN"",""SDES2APTLETTER"",221,0)"
^XMB(3.9,146098,2,1086,0)=" . ;if country is blank display as USA"
^XMB(3.9,146098,2,1087,0)="""RTN"",""SDES2APTLETTER"",222,0)"
^XMB(3.9,146098,2,1088,0)=" . I (VAPA(25)="""")!($P(VAPA(25),""^"",2)=""UNITED STATES"")  D  ;display city,state,zip"
^XMB(3.9,146098,2,1089,0)="""RTN"",""SDES2APTLETTER"",223,0)"
^XMB(3.9,146098,2,1090,0)=" .. S SDECI=SDECI+1,^TMP(""SDEC_COMP"",$J,""addressPatient"",SDECI)=$$FILL(11,"" "")_VAPA(4)_"" ""_$P(VAPA(5),U,2)_""  ""_$P(VAPA(11),U,2)"
^XMB(3.9,146098,2,1091,0)="""RTN"",""SDES2APTLETTER"",224,0)"
^XMB(3.9,146098,2,1092,0)=" . E  D  ;display postal code,city,province"
^XMB(3.9,146098,2,1093,0)="""RTN"",""SDES2APTLETTER"",225,0)"
^XMB(3.9,146098,2,1094,0)=" .. S SDECI=SDECI+1,^TMP(""SDEC_COMP"",$J,""addressPatient"",SDECI)=$$FILL(11,"" "")_VAPA(24)_"" ""_VAPA(4)_"" ""_VAPA(23)_$C(13,10)"
^XMB(3.9,146098,2,1095,0)="""RTN"",""SDES2APTLETTER"",226,0)"
^XMB(3.9,146098,2,1096,0)=" . I ($P(VAPA(25),""^"",2)'=""UNITED STATES"") S SDECI=SDECI+1,^TMP(""SDEC_COMP"",$J,""addressPatient"",SDECI)=$$FILL(11,"" "")_$P(VAPA(25),U,2) ;display country"
^XMB(3.9,146098,2,1097,0)="""RTN"",""SDES2APTLETTER"",227,0)"
^XMB(3.9,146098,2,1098,0)=" ;if confidential address is active for scheduling/appointment letters, print to confidential address"
^XMB(3.9,146098,2,1099,0)="""RTN"",""SDES2APTLETTER"",228,0)"
^XMB(3.9,146098,2,1100,0)=" I $G(SDCCACT1)=1,$G(SDCCACT2)=""Y"" D"
^XMB(3.9,146098,2,1101,0)="""RTN"",""SDES2APTLETTER"",229,0)"
^XMB(3.9,146098,2,1102,0)=" . F LL=13:1:15 I VAPA(LL)]"""" S SDECI=SDECI+1,^TMP(""SDEC_COMP"",$J,""addressPatient"",SDECI)=$$FILL(11,"" "")_VAPA(LL)"
^XMB(3.9,146098,2,1103,0)="""RTN"",""SDES2APTLETTER"",230,0)"
^XMB(3.9,146098,2,1104,0)=" . I (VAPA(28)="""")!($P(VAPA(28),""^"",2)=""UNITED STATES"") D"
^XMB(3.9,146098,2,1105,0)="""RTN"",""SDES2APTLETTER"",231,0)"
^XMB(3.9,146098,2,1106,0)=" .. S SDECI=SDECI+1,^TMP(""SDEC_COMP"",$J,""addressPatient"",SDECI)=$$FILL(11,"" "")_VAPA(16)_"" ""_$P(VAPA(17),U,2)_""  ""_$P(VAPA(18),U,2)"
^XMB(3.9,146098,2,1107,0)="""RTN"",""SDES2APTLETTER"",232,0)"
^XMB(3.9,146098,2,1108,0)=" . E  D"
^XMB(3.9,146098,2,1109,0)="""RTN"",""SDES2APTLETTER"",233,0)"
^XMB(3.9,146098,2,1110,0)=" .. S SDECI=SDECI+1,^TMP(""SDEC_COMP"",$J,""addressPatient"",SDECI)=$$FILL(11,"" "")_VAPA(27)_"" ""_VAPA(16)_"" ""_VAPA(26)"
^XMB(3.9,146098,2,1111,0)="""RTN"",""SDES2APTLETTER"",234,0)"
^XMB(3.9,146098,2,1112,0)=" . I ($P(VAPA(28),""^"",2)'=""UNITED STATES"") S SDECI=SDECI+1,^TMP(""SDEC_COMP"",$J,""addressPatient"",SDECI)=$$FILL(11,"" "")_$P(VAPA(28),U,2)"
^XMB(3.9,146098,2,1113,0)="""RTN"",""SDES2APTLETTER"",235,0)"
^XMB(3.9,146098,2,1114,0)=" D KVAR^VADPT"
^XMB(3.9,146098,2,1115,0)="""RTN"",""SDES2APTLETTER"",236,0)"
^XMB(3.9,146098,2,1116,0)=" Q"
^XMB(3.9,146098,2,1117,0)="""RTN"",""SDES2APTLETTER"",237,0)"
^XMB(3.9,146098,2,1118,0)=" ;"
^XMB(3.9,146098,2,1119,0)="""RTN"",""SDES2APTLETTER"",238,0)"
^XMB(3.9,146098,2,1120,0)="DTS(Y) ;"
^XMB(3.9,146098,2,1121,0)="""RTN"",""SDES2APTLETTER"",239,0)"
^XMB(3.9,146098,2,1122,0)=" Q:'Y """""
^XMB(3.9,146098,2,1123,0)="""RTN"",""SDES2APTLETTER"",240,0)"
