^XMB(3.9,146102,2,486,0)="^D MENU^XPDH"
^XMB(3.9,146102,2,487,0)="""QUES"",""XPO1"",""A"")"
^XMB(3.9,146102,2,488,0)="Want KIDS to Rebuild Menu Trees Upon Completion of Install"
^XMB(3.9,146102,2,489,0)="""QUES"",""XPO1"",""B"")"
