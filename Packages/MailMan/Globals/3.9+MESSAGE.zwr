^XMB(3.9,146087,2,3419,0)="""RTN"",""YTQRQAD4"",196,0)"
^XMB(3.9,146087,2,3420,0)=" ...Q:ADMINID=0"
^XMB(3.9,146087,2,3421,0)="""RTN"",""YTQRQAD4"",197,0)"
^XMB(3.9,146087,2,3422,0)=" ...S MHCMPLT(ADMINID)=$$GET1^DIQ(601.84,ADMINID_"","",8,""I"")"
^XMB(3.9,146087,2,3423,0)="""RTN"",""YTQRQAD4"",198,0)"
^XMB(3.9,146087,2,3424,0)=" ...S LSTDG=$G(MHADLST(ENTRY,ADMINID))"
^XMB(3.9,146087,2,3425,0)="""RTN"",""YTQRQAD4"",199,0)"
