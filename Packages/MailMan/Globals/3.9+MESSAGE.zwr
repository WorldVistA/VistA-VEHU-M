^XMB(3.9,146087,2,3427,0)="""RTN"",""YTQRQAD4"",200,0)"
^XMB(3.9,146087,2,3428,0)=" S HIT="""""
^XMB(3.9,146087,2,3429,0)="""RTN"",""YTQRQAD4"",201,0)"
^XMB(3.9,146087,2,3430,0)=" F  S ORDBY=$O(^XTMP(""YTQASMT-INDEX"",""AD"",DFN,ORDBY)) Q:'ORDBY  D"
^XMB(3.9,146087,2,3431,0)="""RTN"",""YTQRQAD4"",202,0)"
