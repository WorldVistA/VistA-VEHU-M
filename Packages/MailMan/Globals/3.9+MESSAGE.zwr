^XMB(3.9,146056,2,1515,0)="""RTN"",""VPREVNT"",131,0)"
^XMB(3.9,146056,2,1516,0)="GMRV(DFN,IEN,ERR) ; -- Vital Measurement file #120.5 AVPR index"
^XMB(3.9,146056,2,1517,0)="""RTN"",""VPREVNT"",132,0)"
^XMB(3.9,146056,2,1518,0)=" S DFN=+$G(DFN),IEN=+$G(IEN)"
^XMB(3.9,146056,2,1519,0)="""RTN"",""VPREVNT"",133,0)"
