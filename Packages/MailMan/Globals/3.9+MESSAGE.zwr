^XMB(3.9,146010,2,249,0)="""RTN"",""XUESSO1"")"
^XMB(3.9,146010,2,250,0)="0^1^B106736265"
^XMB(3.9,146010,2,251,0)="""RTN"",""XUESSO1"",1,0)"
^XMB(3.9,146010,2,252,0)="XUESSO1 ;SEA/LUKE - Single Sign-on Utilities ; Apr 08, 2022@13:58"
^XMB(3.9,146010,2,253,0)="""RTN"",""XUESSO1"",2,0)"
^XMB(3.9,146010,2,254,0)=" ;;8.0;KERNEL;**165,183,196,245,254,269,337,395,466,523,655,659,771,759**;Jul 10, 1995;Build 0"
^XMB(3.9,146010,2,255,0)="""RTN"",""XUESSO1"",3,0)"
^XMB(3.9,146010,2,256,0)=" ;Per VA Directive 6402, this routine should not be modified."
^XMB(3.9,146010,2,257,0)="""RTN"",""XUESSO1"",4,0)"
^XMB(3.9,146010,2,258,0)=" ;"
^XMB(3.9,146010,2,259,0)="""RTN"",""XUESSO1"",5,0)"
^XMB(3.9,146010,2,260,0)="GET(INDUZ) ;Gather identifying data from user's home site."
^XMB(3.9,146010,2,261,0)="""RTN"",""XUESSO1"",6,0)"
^XMB(3.9,146010,2,262,0)=" ;Called by SETVISIT^XUSBSE1 (Get visitor info for TOKEN)"
^XMB(3.9,146010,2,263,0)="""RTN"",""XUESSO1"",7,0)"
^XMB(3.9,146010,2,264,0)=" ;Called by SNDQRY^DGROHLS (Retrieve user info) and SETUP^XWB2HL7 (Get visitor info)"
^XMB(3.9,146010,2,265,0)="""RTN"",""XUESSO1"",8,0)"
^XMB(3.9,146010,2,266,0)=" ;Called by (unknown) (VSA/VistA.js)"
^XMB(3.9,146010,2,267,0)="""RTN"",""XUESSO1"",9,0)"
^XMB(3.9,146010,2,268,0)=" ;To visit a remote site, user must have: Name, Access/Verify Codes, SSN (no pseudo), Station Name, Site Number"
^XMB(3.9,146010,2,269,0)="""RTN"",""XUESSO1"",10,0)"
^XMB(3.9,146010,2,270,0)=" ;The following data is optional: Phone, SecID, Network Username"
^XMB(3.9,146010,2,271,0)="""RTN"",""XUESSO1"",11,0)"
^XMB(3.9,146010,2,272,0)=" N %,NAME,SITE,SSN,PHONE,X,N,NETWORK"
^XMB(3.9,146010,2,273,0)="""RTN"",""XUESSO1"",12,0)"
^XMB(3.9,146010,2,274,0)=" I '$D(DUZ) Q ""-1^Insufficient info to allow visiting:  No DUZ"""
^XMB(3.9,146010,2,275,0)="""RTN"",""XUESSO1"",13,0)"
^XMB(3.9,146010,2,276,0)=" I '$D(DUZ(2)) Q ""-1^Insufficient info to allow visiting:  Missing DUZ(2)"""
^XMB(3.9,146010,2,277,0)="""RTN"",""XUESSO1"",14,0)"
^XMB(3.9,146010,2,278,0)=" S N=$G(^VA(200,DUZ,0))"
^XMB(3.9,146010,2,279,0)="""RTN"",""XUESSO1"",15,0)"
^XMB(3.9,146010,2,280,0)=" I '$L(N) Q ""-1^Insufficient info to allow visiting:  Missing NPF Zero Node"""
^XMB(3.9,146010,2,281,0)="""RTN"",""XUESSO1"",16,0)"
^XMB(3.9,146010,2,282,0)=" S %=$P(N,U,3) I $L(%)<1 Q ""-1^Insufficient info to allow visiting:  No Access Code"""
^XMB(3.9,146010,2,283,0)="""RTN"",""XUESSO1"",17,0)"
^XMB(3.9,146010,2,284,0)=" S %=$P($G(^VA(200,DUZ,.1)),U,2) I $L(%)<1 Q ""-1^Insufficient info to allow visiting:  No Verify Code"""
^XMB(3.9,146010,2,285,0)="""RTN"",""XUESSO1"",18,0)"
^XMB(3.9,146010,2,286,0)=" S %=$P(N,U,11) I $L(%)>1,(DT>%) Q ""-1^Insufficient info to allow visiting:  Terminated User"""
^XMB(3.9,146010,2,287,0)="""RTN"",""XUESSO1"",19,0)"
^XMB(3.9,146010,2,288,0)=" I $P($$ACTIVE^XUSER(DUZ),U,1)'=1 Q ""-1^Insufficient info to allow visiting:  Not an active user"""
^XMB(3.9,146010,2,289,0)="""RTN"",""XUESSO1"",20,0)"
^XMB(3.9,146010,2,290,0)=" ;I $G(DUZ(""LOA""))<2 Q ""-1^Insufficient Level of Assurance to allow visiting:  User not authenticated"""
^XMB(3.9,146010,2,291,0)="""RTN"",""XUESSO1"",21,0)"
^XMB(3.9,146010,2,292,0)=" S NAME=$P(N,U)"
^XMB(3.9,146010,2,293,0)="""RTN"",""XUESSO1"",22,0)"
^XMB(3.9,146010,2,294,0)=" I '$L(NAME) Q ""-1^Insufficient info to allow visiting:  No User Name"""
^XMB(3.9,146010,2,295,0)="""RTN"",""XUESSO1"",23,0)"
^XMB(3.9,146010,2,296,0)=" ;"
^XMB(3.9,146010,2,297,0)="""RTN"",""XUESSO1"",24,0)"
^XMB(3.9,146010,2,298,0)=" S SITE=$$NS^XUAF4(DUZ(2)) ;Site is name^station#"
^XMB(3.9,146010,2,299,0)="""RTN"",""XUESSO1"",25,0)"
^XMB(3.9,146010,2,300,0)=" I $P(SITE,U,2)="""" Q ""-1^Insufficient info to allow visiting:  Missing Station Number"""
^XMB(3.9,146010,2,301,0)="""RTN"",""XUESSO1"",26,0)"
^XMB(3.9,146010,2,302,0)=" ;"
^XMB(3.9,146010,2,303,0)="""RTN"",""XUESSO1"",27,0)"
^XMB(3.9,146010,2,304,0)=" S SSN=$P($G(^VA(200,DUZ,1)),U,9)"
^XMB(3.9,146010,2,305,0)="""RTN"",""XUESSO1"",28,0)"
^XMB(3.9,146010,2,306,0)=" I $$SPECIAL($P(SITE,""^"",2)) S SSN=999999999 ;Manila RO doesn't need SSN"
^XMB(3.9,146010,2,307,0)="""RTN"",""XUESSO1"",29,0)"
^XMB(3.9,146010,2,308,0)=" I 'SSN Q ""-1^Insufficient info to allow visiting:  Missing SSN"""
^XMB(3.9,146010,2,309,0)="""RTN"",""XUESSO1"",30,0)"
^XMB(3.9,146010,2,310,0)=" I $E(SSN,10)=""P"" Q ""-1^Insufficient info to allow visiting:  User has a pseudo SSN"""
^XMB(3.9,146010,2,311,0)="""RTN"",""XUESSO1"",31,0)"
^XMB(3.9,146010,2,312,0)=" I '$$SSNCHECK(SSN) Q ""-1^Insufficient info to allow visiting:  User does not have a valid SSN"""
^XMB(3.9,146010,2,313,0)="""RTN"",""XUESSO1"",32,0)"
^XMB(3.9,146010,2,314,0)=" ;"
^XMB(3.9,146010,2,315,0)="""RTN"",""XUESSO1"",33,0)"
^XMB(3.9,146010,2,316,0)=" S PHONE=$$PH"
^XMB(3.9,146010,2,317,0)="""RTN"",""XUESSO1"",34,0)"
^XMB(3.9,146010,2,318,0)=" S X=SSN_U_NAME_U_SITE_U_DUZ"
^XMB(3.9,146010,2,319,0)="""RTN"",""XUESSO1"",35,0)"
^XMB(3.9,146010,2,320,0)=" I $L(PHONE)>2&($L(PHONE<20)) S X=X_U_PHONE"
^XMB(3.9,146010,2,321,0)="""RTN"",""XUESSO1"",36,0)"
^XMB(3.9,146010,2,322,0)=" S $P(X,U,7)=$P($G(^VA(200,DUZ,205.1)),U) ;p655 SecID"
^XMB(3.9,146010,2,323,0)="""RTN"",""XUESSO1"",37,0)"
^XMB(3.9,146010,2,324,0)=" S $P(X,U,8)=$P($G(^VA(200,DUZ,501)),U) ;p655 Network Username"
^XMB(3.9,146010,2,325,0)="""RTN"",""XUESSO1"",38,0)"
^XMB(3.9,146010,2,326,0)=" ;X=ssn^name^station name^station number^DUZ^phone^SecID^network username"
^XMB(3.9,146010,2,327,0)="""RTN"",""XUESSO1"",39,0)"
^XMB(3.9,146010,2,328,0)=" Q X"
^XMB(3.9,146010,2,329,0)="""RTN"",""XUESSO1"",40,0)"
^XMB(3.9,146010,2,330,0)=" ;"
^XMB(3.9,146010,2,331,0)="""RTN"",""XUESSO1"",41,0)"
^XMB(3.9,146010,2,332,0)="PH() ; Try for a phone number or pager"
^XMB(3.9,146010,2,333,0)="""RTN"",""XUESSO1"",42,0)"
^XMB(3.9,146010,2,334,0)=" N %,X"
^XMB(3.9,146010,2,335,0)="""RTN"",""XUESSO1"",43,0)"
^XMB(3.9,146010,2,336,0)=" S %="""""
^XMB(3.9,146010,2,337,0)="""RTN"",""XUESSO1"",44,0)"
^XMB(3.9,146010,2,338,0)=" S X=$G(^VA(200,DUZ,.13))"
^XMB(3.9,146010,2,339,0)="""RTN"",""XUESSO1"",45,0)"
^XMB(3.9,146010,2,340,0)=" I '$L(X) Q """""
^XMB(3.9,146010,2,341,0)="""RTN"",""XUESSO1"",46,0)"
^XMB(3.9,146010,2,342,0)=" S %=$P(X,U,5) I $L(%)>6 Q %  ;Commercial #"
^XMB(3.9,146010,2,343,0)="""RTN"",""XUESSO1"",47,0)"
^XMB(3.9,146010,2,344,0)=" S %=$P(X,U,2) I $L(%)>2 Q %  ;Office"
^XMB(3.9,146010,2,345,0)="""RTN"",""XUESSO1"",48,0)"
^XMB(3.9,146010,2,346,0)=" S %=$P(X,U,8) I $L(%)>6 Q %  ;Digital Pager"
^XMB(3.9,146010,2,347,0)="""RTN"",""XUESSO1"",49,0)"
^XMB(3.9,146010,2,348,0)=" S %=$P(X,U,7) I $L(%)>6 Q %  ;Pager"
^XMB(3.9,146010,2,349,0)="""RTN"",""XUESSO1"",50,0)"
^XMB(3.9,146010,2,350,0)=" S %=$P(X,U,3) I $L(%)>2 Q %  ;Phone #3"
^XMB(3.9,146010,2,351,0)="""RTN"",""XUESSO1"",51,0)"
^XMB(3.9,146010,2,352,0)=" S %=$P(X,U,4) I $L(%)>2 Q %  ;Phone #4"
^XMB(3.9,146010,2,353,0)="""RTN"",""XUESSO1"",52,0)"
^XMB(3.9,146010,2,354,0)=" S %=$P(X,U,1) I $L(%)>2 Q %  ;Home Phone"
^XMB(3.9,146010,2,355,0)="""RTN"",""XUESSO1"",53,0)"
^XMB(3.9,146010,2,356,0)=" Q """" ;Couldn't find one."
^XMB(3.9,146010,2,357,0)="""RTN"",""XUESSO1"",54,0)"
^XMB(3.9,146010,2,358,0)=" ;"
^XMB(3.9,146010,2,359,0)="""RTN"",""XUESSO1"",55,0)"
^XMB(3.9,146010,2,360,0)="SPECIAL(SN) ;INTRINSIC. Special Manila RO site"
^XMB(3.9,146010,2,361,0)="""RTN"",""XUESSO1"",56,0)"
^XMB(3.9,146010,2,362,0)=" ; Returns 1 if SN is ""358"""
^XMB(3.9,146010,2,363,0)="""RTN"",""XUESSO1"",57,0)"
^XMB(3.9,146010,2,364,0)=" Q 358=SN"
^XMB(3.9,146010,2,365,0)="""RTN"",""XUESSO1"",58,0)"
^XMB(3.9,146010,2,366,0)=" ;"
^XMB(3.9,146010,2,367,0)="""RTN"",""XUESSO1"",59,0)"
^XMB(3.9,146010,2,368,0)="PUT(DATIN) ;;Setup data from authenticating site GET() at receiving site"
^XMB(3.9,146010,2,369,0)="""RTN"",""XUESSO1"",60,0)"
^XMB(3.9,146010,2,370,0)=" ;Called by OLDCAPRI^XUSBSE1 (Old Capri) and SETUP^XUSBSE1 (BSE)"
^XMB(3.9,146010,2,371,0)="""RTN"",""XUESSO1"",61,0)"
^XMB(3.9,146010,2,372,0)=" ;Called by DIQ^DGROHLU (Sensitive Patient access) and REMOTE^XWB2HL7 (Visitor access via HL7)"
^XMB(3.9,146010,2,373,0)="""RTN"",""XUESSO1"",62,0)"
^XMB(3.9,146010,2,374,0)=" ;Called by (unknown) (VSA/VistA.js)"
^XMB(3.9,146010,2,375,0)="""RTN"",""XUESSO1"",63,0)"
^XMB(3.9,146010,2,376,0)=" ;Return: 0=fail, 1=OK"
^XMB(3.9,146010,2,377,0)="""RTN"",""XUESSO1"",64,0)"
^XMB(3.9,146010,2,378,0)=" N NAME,NETWORK,NEWDUZ,PHONE,RMTDUZ,SECID,SITE,SITENUM,SSN,TODAY,XSITEIEN,XT,XUMF"
^XMB(3.9,146010,2,379,0)="""RTN"",""XUESSO1"",65,0)"
^XMB(3.9,146010,2,380,0)=" I $G(DUZ(""LOA""))="""" S DUZ(""LOA"")=1"
^XMB(3.9,146010,2,381,0)="""RTN"",""XUESSO1"",66,0)"
^XMB(3.9,146010,2,382,0)=" ;I $G(DUZ(""LOA""))<2 Q 0  ;do not allow access if Level Of Assurance is low"
^XMB(3.9,146010,2,383,0)="""RTN"",""XUESSO1"",67,0)"
^XMB(3.9,146010,2,384,0)=" I $G(DUZ(""AUTHENTICATION""))="""" S DUZ(""AUTHENTICATION"")=""UNKNOWN"""
^XMB(3.9,146010,2,385,0)="""RTN"",""XUESSO1"",68,0)"
^XMB(3.9,146010,2,386,0)=" S U=""^"",TODAY=$$HTFM^XLFDT($H),DT=$P(TODAY,"".""),NEWDUZ=0"
^XMB(3.9,146010,2,387,0)="""RTN"",""XUESSO1"",69,0)"
^XMB(3.9,146010,2,388,0)=" K ^TMP(""DIERR"",$J)"
^XMB(3.9,146010,2,389,0)="""RTN"",""XUESSO1"",70,0)"
^XMB(3.9,146010,2,390,0)=" ;"
^XMB(3.9,146010,2,391,0)="""RTN"",""XUESSO1"",71,0)"
^XMB(3.9,146010,2,392,0)=" S SSN=$P(DATIN,U,1),NAME=$P(DATIN,U,2),SITE=$P(DATIN,U,3)"
^XMB(3.9,146010,2,393,0)="""RTN"",""XUESSO1"",72,0)"
^XMB(3.9,146010,2,394,0)=" S SITENUM=$P(DATIN,U,4),RMTDUZ=$P(DATIN,U,5),PHONE=$P(DATIN,U,6)"
^XMB(3.9,146010,2,395,0)="""RTN"",""XUESSO1"",73,0)"
^XMB(3.9,146010,2,396,0)=" S SECID=$P(DATIN,U,7) ;p655"
^XMB(3.9,146010,2,397,0)="""RTN"",""XUESSO1"",74,0)"
^XMB(3.9,146010,2,398,0)=" S NETWORK=$P(DATIN,U,8) ;p655"
^XMB(3.9,146010,2,399,0)="""RTN"",""XUESSO1"",75,0)"
^XMB(3.9,146010,2,400,0)=" ;Format checks"
^XMB(3.9,146010,2,401,0)="""RTN"",""XUESSO1"",76,0)"
^XMB(3.9,146010,2,402,0)=" I NAME'?1U.E1"",""1U.E Q 0"
^XMB(3.9,146010,2,403,0)="""RTN"",""XUESSO1"",77,0)"
^XMB(3.9,146010,2,404,0)=" I SSN'?9N Q 0"
^XMB(3.9,146010,2,405,0)="""RTN"",""XUESSO1"",78,0)"
^XMB(3.9,146010,2,406,0)=" I '$L(SITE)!('$L(SITENUM)) Q 0"
^XMB(3.9,146010,2,407,0)="""RTN"",""XUESSO1"",79,0)"
^XMB(3.9,146010,2,408,0)=" S XUMF=1 D CHK^DIE(4,99,,SITENUM,.XT) I XT=U Q 0 ;p533"
^XMB(3.9,146010,2,409,0)="""RTN"",""XUESSO1"",80,0)"
^XMB(3.9,146010,2,410,0)=" D CHK^DIE(200.06,1,,SITE,.XT) I XT=U Q 0 ;p533"
^XMB(3.9,146010,2,411,0)="""RTN"",""XUESSO1"",81,0)"
^XMB(3.9,146010,2,412,0)=" I RMTDUZ'>0 Q 0 ;p337"
^XMB(3.9,146010,2,413,0)="""RTN"",""XUESSO1"",82,0)"
^XMB(3.9,146010,2,414,0)=" ;Check if visitor is from a valid active site"
^XMB(3.9,146010,2,415,0)="""RTN"",""XUESSO1"",83,0)"
^XMB(3.9,146010,2,416,0)=" S XSITEIEN=$$IEN^XUAF4(SITENUM) I XSITEIEN="""" H 1 ;Q 0 ;Quit if authenticating VistA not in INSTITUTION file (#4)"
^XMB(3.9,146010,2,417,0)="""RTN"",""XUESSO1"",84,0)"
^XMB(3.9,146010,2,418,0)=" ;I '$$ACTIVE^XUAF4(XSITEIEN) Q 0 ;Quit if authenticating VistA is not an active VA site (spoofed)"
^XMB(3.9,146010,2,419,0)="""RTN"",""XUESSO1"",85,0)"
^XMB(3.9,146010,2,420,0)=" ;I $P($$NS^XUAF4(XSITEIEN),""^"",1)'=SITE Q 0 ;Quit if authenticating VistA name and station number mismatch (spoofed)"
^XMB(3.9,146010,2,421,0)="""RTN"",""XUESSO1"",86,0)"
^XMB(3.9,146010,2,422,0)=" ;Get a LOCK. Block if can't get."
^XMB(3.9,146010,2,423,0)="""RTN"",""XUESSO1"",87,0)"
^XMB(3.9,146010,2,424,0)=" L +^VA(200,""HL7""):10 Q:'$T 0"
^XMB(3.9,146010,2,425,0)="""RTN"",""XUESSO1"",88,0)"
^XMB(3.9,146010,2,426,0)=" S XT=$$TALL($G(DUZ,0)) L -^VA(200,""HL7"")"
^XMB(3.9,146010,2,427,0)="""RTN"",""XUESSO1"",89,0)"
^XMB(3.9,146010,2,428,0)=" I XT Q $$SET(NEWDUZ) ;Return 1 if OK."
^XMB(3.9,146010,2,429,0)="""RTN"",""XUESSO1"",90,0)"
^XMB(3.9,146010,2,430,0)=" Q 0"
^XMB(3.9,146010,2,431,0)="""RTN"",""XUESSO1"",91,0)"
^XMB(3.9,146010,2,432,0)=" ;"
^XMB(3.9,146010,2,433,0)="""RTN"",""XUESSO1"",92,0)"
^XMB(3.9,146010,2,434,0)="TALL(XUDUZ) ;INTRINSIC. Test for existing user or adds a new one"
^XMB(3.9,146010,2,435,0)="""RTN"",""XUESSO1"",93,0)"
^XMB(3.9,146010,2,436,0)=" ; p771 replace parameter DUZ with XUDUZ to not hide DUZ nodes being used in function"
^XMB(3.9,146010,2,437,0)="""RTN"",""XUESSO1"",94,0)"
^XMB(3.9,146010,2,438,0)=" ; ZEXCEPT: NAME,NEWDUZ,PHONE,RMTDUZ,SITE,SITENUM,SSN,XSSN,TODAY,SECID,NETWORK ;global variables within this routine"
^XMB(3.9,146010,2,439,0)="""RTN"",""XUESSO1"",95,0)"
^XMB(3.9,146010,2,440,0)=" ; ZEXCEPT: DIC ;turn off DIC(0) for ^XUA4A7 (work around)"
^XMB(3.9,146010,2,441,0)="""RTN"",""XUESSO1"",96,0)"
^XMB(3.9,146010,2,442,0)=" N FLAG,NEWREC,XUIAM,RETRY"
^XMB(3.9,146010,2,443,0)="""RTN"",""XUESSO1"",97,0)"
^XMB(3.9,146010,2,444,0)=" S FLAG=0,DUZ(0)=""@"" ;Make sure we can add the entry"
^XMB(3.9,146010,2,445,0)="""RTN"",""XUESSO1"",98,0)"
^XMB(3.9,146010,2,446,0)=" S XUIAM=1 ;Do not trigger IAM updates"
^XMB(3.9,146010,2,447,0)="""RTN"",""XUESSO1"",99,0)"
^XMB(3.9,146010,2,448,0)=" ;See if match SECID. Only use for lookup. Do not load SECID's."
^XMB(3.9,146010,2,449,0)="""RTN"",""XUESSO1"",100,0)"
^XMB(3.9,146010,2,450,0)=" S RETRY=1 ; p771 try MPI web service if not found"
^XMB(3.9,146010,2,451,0)="""RTN"",""XUESSO1"",101,0)"
^XMB(3.9,146010,2,452,0)="FIND    ;"
^XMB(3.9,146010,2,453,0)="""RTN"",""XUESSO1"",102,0)"
^XMB(3.9,146010,2,454,0)=" I $L(SECID) D"
^XMB(3.9,146010,2,455,0)="""RTN"",""XUESSO1"",103,0)"
^XMB(3.9,146010,2,456,0)=" . S NEWDUZ=+$$SECMATCH^XUESSO2(SECID) Q:NEWDUZ<1  ;p655"
^XMB(3.9,146010,2,457,0)="""RTN"",""XUESSO1"",104,0)"
^XMB(3.9,146010,2,458,0)=" . I '$D(^VA(200,NEWDUZ,8910,""B"",SITENUM)) D VISM"
^XMB(3.9,146010,2,459,0)="""RTN"",""XUESSO1"",105,0)"
^XMB(3.9,146010,2,460,0)=" . D ADDW,UPDT"
^XMB(3.9,146010,2,461,0)="""RTN"",""XUESSO1"",106,0)"
^XMB(3.9,146010,2,462,0)=" . S FLAG=1,DUZ(0)=$P($G(^VA(200,NEWDUZ,0)),U,4)"
^XMB(3.9,146010,2,463,0)="""RTN"",""XUESSO1"",107,0)"
^XMB(3.9,146010,2,464,0)=" . Q"
^XMB(3.9,146010,2,465,0)="""RTN"",""XUESSO1"",108,0)"
^XMB(3.9,146010,2,466,0)=" I FLAG Q 1 ;Quit here if we found a match on SECID"
^XMB(3.9,146010,2,467,0)="""RTN"",""XUESSO1"",109,0)"
^XMB(3.9,146010,2,468,0)=" ;See if the SSN is in the NPF cross reference"
^XMB(3.9,146010,2,469,0)="""RTN"",""XUESSO1"",110,0)"
^XMB(3.9,146010,2,470,0)=" I $D(^VA(200,""SSN"",SSN)),$$SSNCHECK(SSN),'$$SPECIAL(SITENUM) D"
^XMB(3.9,146010,2,471,0)="""RTN"",""XUESSO1"",111,0)"
^XMB(3.9,146010,2,472,0)=" . N XUEIEN,XUEAUSER"
^XMB(3.9,146010,2,473,0)="""RTN"",""XUESSO1"",112,0)"
^XMB(3.9,146010,2,474,0)=" . S XUEIEN=0,NEWDUZ=0"
^XMB(3.9,146010,2,475,0)="""RTN"",""XUESSO1"",113,0)"
^XMB(3.9,146010,2,476,0)=" . F  S XUEIEN=$O(^VA(200,""SSN"",SSN,XUEIEN)) Q:(XUEIEN="""")!(NEWDUZ>0)  D"
^XMB(3.9,146010,2,477,0)="""RTN"",""XUESSO1"",114,0)"
^XMB(3.9,146010,2,478,0)=" . . N XUENAME S XUENAME=$P($G(^VA(200,XUEIEN,0)),U)"
^XMB(3.9,146010,2,479,0)="""RTN"",""XUESSO1"",115,0)"
^XMB(3.9,146010,2,480,0)=" . . S NEWDUZ=XUEIEN"
^XMB(3.9,146010,2,481,0)="""RTN"",""XUESSO1"",116,0)"
^XMB(3.9,146010,2,482,0)=" . . ;Update name if names don't match, user has visited before, and user is not an active local user"
^XMB(3.9,146010,2,483,0)="""RTN"",""XUESSO1"",117,0)"
^XMB(3.9,146010,2,484,0)=" . . I (XUENAME'=NAME)&(XUEIEN=$O(^VA(200,""AVISIT"",SITENUM,RMTDUZ,0)))&(('$$ACTIVE^XUSER(XUEIEN))) D ADDN"
^XMB(3.9,146010,2,485,0)="""RTN"",""XUESSO1"",118,0)"
^XMB(3.9,146010,2,486,0)=" . Q:NEWDUZ'>0"
^XMB(3.9,146010,2,487,0)="""RTN"",""XUESSO1"",119,0)"
^XMB(3.9,146010,2,488,0)=" . I '$D(^VA(200,NEWDUZ,8910,""B"",SITENUM)) D VISM"
^XMB(3.9,146010,2,489,0)="""RTN"",""XUESSO1"",120,0)"
^XMB(3.9,146010,2,490,0)=" . D ADDW,ADDI,UPDT"
^XMB(3.9,146010,2,491,0)="""RTN"",""XUESSO1"",121,0)"
^XMB(3.9,146010,2,492,0)=" . S FLAG=1,DUZ(0)=$P($G(^VA(200,NEWDUZ,0)),U,4)"
^XMB(3.9,146010,2,493,0)="""RTN"",""XUESSO1"",122,0)"
^XMB(3.9,146010,2,494,0)=" . Q"
^XMB(3.9,146010,2,495,0)="""RTN"",""XUESSO1"",123,0)"
^XMB(3.9,146010,2,496,0)=" I FLAG Q 1 ;Quit here if we found a match for SSN"
^XMB(3.9,146010,2,497,0)="""RTN"",""XUESSO1"",124,0)"
^XMB(3.9,146010,2,498,0)=" ;See if in the AVISIT cross reference (Manila only)"
^XMB(3.9,146010,2,499,0)="""RTN"",""XUESSO1"",125,0)"
^XMB(3.9,146010,2,500,0)=" I $$SPECIAL(SITENUM) D"
^XMB(3.9,146010,2,501,0)="""RTN"",""XUESSO1"",126,0)"
^XMB(3.9,146010,2,502,0)=" . S NEWDUZ=$O(^VA(200,""AVISIT"",SITENUM,RMTDUZ,0))"
^XMB(3.9,146010,2,503,0)="""RTN"",""XUESSO1"",127,0)"
^XMB(3.9,146010,2,504,0)=" . Q:NEWDUZ'>0  ;User must have visited from Manila at least once to be found by this test"
^XMB(3.9,146010,2,505,0)="""RTN"",""XUESSO1"",128,0)"
^XMB(3.9,146010,2,506,0)=" . D ADDW,ADDI,UPDT S FLAG=1,DUZ(0)=$P($G(^VA(200,NEWDUZ,0)),U,4)"
^XMB(3.9,146010,2,507,0)="""RTN"",""XUESSO1"",129,0)"
^XMB(3.9,146010,2,508,0)=" . Q"
^XMB(3.9,146010,2,509,0)="""RTN"",""XUESSO1"",130,0)"
^XMB(3.9,146010,2,510,0)=" I FLAG Q 1 ;Quit here if we found a match for AVISIT"
^XMB(3.9,146010,2,511,0)="""RTN"",""XUESSO1"",131,0)"
^XMB(3.9,146010,2,512,0)=" ;Try for a NAME match in ""B"""
^XMB(3.9,146010,2,513,0)="""RTN"",""XUESSO1"",132,0)"
^XMB(3.9,146010,2,514,0)=" N XUEIEN,XUESSN"
^XMB(3.9,146010,2,515,0)="""RTN"",""XUESSO1"",133,0)"
^XMB(3.9,146010,2,516,0)=" S NAME=$$UP^XLFSTR(NAME)"
^XMB(3.9,146010,2,517,0)="""RTN"",""XUESSO1"",134,0)"
^XMB(3.9,146010,2,518,0)=" I $D(^VA(200,""B"",NAME)) D"
^XMB(3.9,146010,2,519,0)="""RTN"",""XUESSO1"",135,0)"
^XMB(3.9,146010,2,520,0)=" . S XUEIEN=0,NEWDUZ=0"
^XMB(3.9,146010,2,521,0)="""RTN"",""XUESSO1"",136,0)"
^XMB(3.9,146010,2,522,0)=" . F  S XUEIEN=$O(^VA(200,""B"",NAME,XUEIEN)) Q:(XUEIEN="""")!(NEWDUZ>0)  D"
^XMB(3.9,146010,2,523,0)="""RTN"",""XUESSO1"",137,0)"
^XMB(3.9,146010,2,524,0)=" . . S XUESSN=$P($G(^VA(200,XUEIEN,1)),U,9)"
^XMB(3.9,146010,2,525,0)="""RTN"",""XUESSO1"",138,0)"
^XMB(3.9,146010,2,526,0)=" . . I (XUESSN'=SSN)&($L(XUESSN)>8) Q  ;Do not use if name has a different SSN"
^XMB(3.9,146010,2,527,0)="""RTN"",""XUESSO1"",139,0)"
^XMB(3.9,146010,2,528,0)=" . . S NEWDUZ=XUEIEN"
^XMB(3.9,146010,2,529,0)="""RTN"",""XUESSO1"",140,0)"
^XMB(3.9,146010,2,530,0)=" . I NEWDUZ>0 D"
^XMB(3.9,146010,2,531,0)="""RTN"",""XUESSO1"",141,0)"
^XMB(3.9,146010,2,532,0)=" . . D ADDS"
^XMB(3.9,146010,2,533,0)="""RTN"",""XUESSO1"",142,0)"
^XMB(3.9,146010,2,534,0)=" . . I '$D(^VA(200,NEWDUZ,8910,""B"",SITENUM)) D VISM"
^XMB(3.9,146010,2,535,0)="""RTN"",""XUESSO1"",143,0)"
^XMB(3.9,146010,2,536,0)=" . . D ADDW,ADDI,UPDT"
^XMB(3.9,146010,2,537,0)="""RTN"",""XUESSO1"",144,0)"
^XMB(3.9,146010,2,538,0)=" . . S FLAG=1,DUZ(0)=$P($G(^VA(200,NEWDUZ,0)),U,4)"
^XMB(3.9,146010,2,539,0)="""RTN"",""XUESSO1"",145,0)"
^XMB(3.9,146010,2,540,0)=" . Q"
^XMB(3.9,146010,2,541,0)="""RTN"",""XUESSO1"",146,0)"
^XMB(3.9,146010,2,542,0)=" I FLAG Q 1 ;Quit here if we found an exact match for NAME (w/o SSN)"
^XMB(3.9,146010,2,543,0)="""RTN"",""XUESSO1"",147,0)"
^XMB(3.9,146010,2,544,0)=" ;"
^XMB(3.9,146010,2,545,0)="""RTN"",""XUESSO1"",148,0)"
^XMB(3.9,146010,2,546,0)=" ;I DUZ(""LOA"")=1 Q 0  ;Do not add user if Level Of Assurance is low"
^XMB(3.9,146010,2,547,0)="""RTN"",""XUESSO1"",149,0)"
^XMB(3.9,146010,2,548,0)=" ;I $G(DUZ(""REMAPP""))=""^MDWS"" Q 0  ;Do not add user if MDWS access"
^XMB(3.9,146010,2,549,0)="""RTN"",""XUESSO1"",150,0)"
^XMB(3.9,146010,2,550,0)=" I $G(DUZ(""REMAPP""))=""^MDWS"" H $E(DT,1,3)-315  ;Discourage deprecated MDWS access"
^XMB(3.9,146010,2,551,0)="""RTN"",""XUESSO1"",151,0)"
^XMB(3.9,146010,2,552,0)=" ; p771 end of FIND.  User not found, try MPI web service"
^XMB(3.9,146010,2,553,0)="""RTN"",""XUESSO1"",152,0)"
^XMB(3.9,146010,2,554,0)=" I RETRY S RETRY=0,SECID=$$MPISECID($G(NETWORK)) G:$G(SECID)]"""" FIND"
^XMB(3.9,146010,2,555,0)="""RTN"",""XUESSO1"",153,0)"
^XMB(3.9,146010,2,556,0)="ADD ;We didn't find anybody under SecID,SSN,VISITED FROM, or NAME so we add a new user"
^XMB(3.9,146010,2,557,0)="""RTN"",""XUESSO1"",154,0)"
^XMB(3.9,146010,2,558,0)=" ;code falls in from above"
^XMB(3.9,146010,2,559,0)="""RTN"",""XUESSO1"",155,0)"
^XMB(3.9,146010,2,560,0)=" ;p759 cep start"
^XMB(3.9,146010,2,561,0)="""RTN"",""XUESSO1"",156,0)"
^XMB(3.9,146010,2,562,0)=" N RAIEN"
^XMB(3.9,146010,2,563,0)="""RTN"",""XUESSO1"",157,0)"
^XMB(3.9,146010,2,564,0)=" S RAIEN=$P($G(DUZ(""REMAPP"")),U)"
^XMB(3.9,146010,2,565,0)="""RTN"",""XUESSO1"",158,0)"
^XMB(3.9,146010,2,566,0)=" I RAIEN,'$$CANADD^XUESSO2($G(DUZ(""REMAPP""))) D  Q 0  ;p759 CEP - set error and quit if RA is set AND ra is not allwed to add users"
^XMB(3.9,146010,2,567,0)="""RTN"",""XUESSO1"",159,0)"
^XMB(3.9,146010,2,568,0)=" .  S XWBSEC=""BSE LOGIN ERROR - ""_$P($G(^XWB(8994.5,RAIEN,0)),U)_"" remote application is not allowed to add new users."""
^XMB(3.9,146010,2,569,0)="""RTN"",""XUESSO1"",160,0)"
^XMB(3.9,146010,2,570,0)=" ;p759 end"
^XMB(3.9,146010,2,571,0)="""RTN"",""XUESSO1"",161,0)"
^XMB(3.9,146010,2,572,0)=" S DIC(0)="""" ;Turn off ^XUA4A7 (work around)"
^XMB(3.9,146010,2,573,0)="""RTN"",""XUESSO1"",162,0)"
^XMB(3.9,146010,2,574,0)=" ;Put the name in the .01 field first."
^XMB(3.9,146010,2,575,0)="""RTN"",""XUESSO1"",163,0)"
^XMB(3.9,146010,2,576,0)=" D ADDU ;ADDU will set NEWDUZ"
^XMB(3.9,146010,2,577,0)="""RTN"",""XUESSO1"",164,0)"
^XMB(3.9,146010,2,578,0)=" I NEWDUZ=0 Q 0  ;If NEWDUZ is still 0, the User add didn't work so exit."
^XMB(3.9,146010,2,579,0)="""RTN"",""XUESSO1"",165,0)"
^XMB(3.9,146010,2,580,0)=" D ADDS,ADDA ;(p337) Add SSN and ""VISITOR"" Alias."
^XMB(3.9,146010,2,581,0)="""RTN"",""XUESSO1"",166,0)"
^XMB(3.9,146010,2,582,0)=" D ADDW,ADDI ; Add NETWORK USERNAME and SSO attributes"
^XMB(3.9,146010,2,583,0)="""RTN"",""XUESSO1"",167,0)"
^XMB(3.9,146010,2,584,0)=" D VISM,UPDT ; Fill in the  VISITED FROM multiple"
^XMB(3.9,146010,2,585,0)="""RTN"",""XUESSO1"",168,0)"
^XMB(3.9,146010,2,586,0)=" I NEWDUZ=0 Q 0 ;Couldn't update user"
^XMB(3.9,146010,2,587,0)="""RTN"",""XUESSO1"",169,0)"
^XMB(3.9,146010,2,588,0)=" I $D(^TMP(""DIERR"",$J)) Q 0  ;FileMan Error"
^XMB(3.9,146010,2,589,0)="""RTN"",""XUESSO1"",170,0)"
^XMB(3.9,146010,2,590,0)=" I ($G(DUZ(""REMAPP""))'="""") D SETREMAP^XUESSO2(NEWDUZ,$P(DUZ(""REMAPP""),""^"")) ; p771"
