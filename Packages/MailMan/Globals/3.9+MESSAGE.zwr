^XMB(3.9,146047,2,932,0)=" I IBIP&(IBOP)&(IBPH)&(IBDN)&(IBMH)&(IBLT) D  Q:$D(IBERR)"
^XMB(3.9,146047,2,933,0)="""RTN"",""IBCNBCD2"",278,0)"
^XMB(3.9,146047,2,934,0)=" . ;"
^XMB(3.9,146047,2,935,0)="""RTN"",""IBCNBCD2"",279,0)"
^XMB(3.9,146047,2,936,0)=" . ; -- format the date"
^XMB(3.9,146047,2,937,0)="""RTN"",""IBCNBCD2"",280,0)"
^XMB(3.9,146047,2,938,0)=" . S IBDT=+IBDATE D DT^DILF(""E"",IBDT,.IBRET) S IBFDT=$G(IBRET(0))"
^XMB(3.9,146047,2,939,0)="""RTN"",""IBCNBCD2"",281,0)"
^XMB(3.9,146047,2,940,0)=" . ;"
^XMB(3.9,146047,2,941,0)="""RTN"",""IBCNBCD2"",282,0)"
^XMB(3.9,146047,2,942,0)=" . ; -- load the coverage limitation date array with formatted date"
^XMB(3.9,146047,2,943,0)="""RTN"",""IBCNBCD2"",283,0)"
^XMB(3.9,146047,2,944,0)=" . S IBIEN=$$ADDCV(IBGRPDA,IBIP,IBDATE,.IBERR) Q:$D(IBERR)  S @IBDTL@(99_IBDT,IBIEN)=IBFDT"
^XMB(3.9,146047,2,945,0)="""RTN"",""IBCNBCD2"",284,0)"
^XMB(3.9,146047,2,946,0)=" . S IBIEN=$$ADDCV(IBGRPDA,IBOP,IBDATE,.IBERR) Q:$D(IBERR)  S @IBDTL@(99_IBDT,IBIEN)=IBFDT"
^XMB(3.9,146047,2,947,0)="""RTN"",""IBCNBCD2"",285,0)"
^XMB(3.9,146047,2,948,0)=" . S IBIEN=$$ADDCV(IBGRPDA,IBPH,IBDATE,.IBERR) Q:$D(IBERR)  S @IBDTL@(99_IBDT,IBIEN)=IBFDT"
^XMB(3.9,146047,2,949,0)="""RTN"",""IBCNBCD2"",286,0)"
^XMB(3.9,146047,2,950,0)=" . S IBIEN=$$ADDCV(IBGRPDA,IBDN,IBDATE,.IBERR) Q:$D(IBERR)  S @IBDTL@(99_IBDT,IBIEN)=IBFDT"
^XMB(3.9,146047,2,951,0)="""RTN"",""IBCNBCD2"",287,0)"
^XMB(3.9,146047,2,952,0)=" . S IBIEN=$$ADDCV(IBGRPDA,IBMH,IBDATE,.IBERR) Q:$D(IBERR)  S @IBDTL@(99_IBDT,IBIEN)=IBFDT"
^XMB(3.9,146047,2,953,0)="""RTN"",""IBCNBCD2"",288,0)"
^XMB(3.9,146047,2,954,0)=" . S IBIEN=$$ADDCV(IBGRPDA,IBLT,IBDATE,.IBERR) Q:$D(IBERR)  S @IBDTL@(99_IBDT,IBIEN)=IBFDT"
^XMB(3.9,146047,2,955,0)="""RTN"",""IBCNBCD2"",289,0)"
^XMB(3.9,146047,2,956,0)=" Q"
^XMB(3.9,146047,2,957,0)="""RTN"",""IBCNBCD2"",290,0)"
^XMB(3.9,146047,2,958,0)=" ;"
^XMB(3.9,146047,2,959,0)="""RTN"",""IBCNBCD2"",291,0)"
^XMB(3.9,146047,2,960,0)="ADDCV(IBGRPDA,IBCAT,IBDATE,IBERR) ; Add new coverage limitation record"
^XMB(3.9,146047,2,961,0)="""RTN"",""IBCNBCD2"",292,0)"
^XMB(3.9,146047,2,962,0)=" N X,Y,DA,DIC,IBIEN,IBA,IBB,IBC"
^XMB(3.9,146047,2,963,0)="""RTN"",""IBCNBCD2"",293,0)"
^XMB(3.9,146047,2,964,0)=" S IBIEN=0,IBC=""COVERED"""
^XMB(3.9,146047,2,965,0)="""RTN"",""IBCNBCD2"",294,0)"
^XMB(3.9,146047,2,966,0)=" ;"
^XMB(3.9,146047,2,967,0)="""RTN"",""IBCNBCD2"",295,0)"
^XMB(3.9,146047,2,968,0)=" ; -- retrieve the plan limitation category"
^XMB(3.9,146047,2,969,0)="""RTN"",""IBCNBCD2"",296,0)"
^XMB(3.9,146047,2,970,0)=" S IBA=$$GET1^DIQ(355.31,IBCAT_"","",.01,""E"") I IBA']"""" S IBERR=1 W !,""Error #1...ADDCV-IBCNBCD2 Cannot retrieve PLAN LIMITATION CATEGORY!"" D PAUSE^VALM1 Q IBIEN"
^XMB(3.9,146047,2,971,0)="""RTN"",""IBCNBCD2"",297,0)"
^XMB(3.9,146047,2,972,0)=" S IBB=$P(IBDATE,U,2)"
^XMB(3.9,146047,2,973,0)="""RTN"",""IBCNBCD2"",298,0)"
^XMB(3.9,146047,2,974,0)=" ;"
^XMB(3.9,146047,2,975,0)="""RTN"",""IBCNBCD2"",299,0)"
^XMB(3.9,146047,2,976,0)=" ; -- update plan coverage limitation file"
^XMB(3.9,146047,2,977,0)="""RTN"",""IBCNBCD2"",300,0)"
^XMB(3.9,146047,2,978,0)=" S DIC=""^IBA(355.32,"",DIC(0)=""L"",X=IBGRPDA,DIC(""DR"")="".02///^S X=IBA;.03///^S X=IBB;.04///^S X=IBC"""
^XMB(3.9,146047,2,979,0)="""RTN"",""IBCNBCD2"",301,0)"
^XMB(3.9,146047,2,980,0)=" D FILE^DICN S IBIEN=+Y I IBIEN<0!(IBIEN=0) S IBERR=1 W !,""Error #2...ADDCV-IBCNBCD2 Cannot add New Record to the PLAN COVERAGE LIMITATIONS FILE!"" D PAUSE^VALM1"
^XMB(3.9,146047,2,981,0)="""RTN"",""IBCNBCD2"",302,0)"
^XMB(3.9,146047,2,982,0)=" Q IBIEN"
^XMB(3.9,146047,2,983,0)="""RTN"",""IBCNBCD2"",303,0)"
^XMB(3.9,146047,2,984,0)=" ;"
^XMB(3.9,146047,2,985,0)="""RTN"",""IBCNBCD2"",304,0)"
^XMB(3.9,146047,2,986,0)="CVDIF(IBSYS,IBGSAV,IBIEN) ; -- check for any edits made to coverage limitations"
^XMB(3.9,146047,2,987,0)="""RTN"",""IBCNBCD2"",305,0)"
^XMB(3.9,146047,2,988,0)=" N IBI,IBDIF"
