^XMB(3.9,146012,2,1140,0)="J2EP(DFN) ; Jump to eRx Patient (From Backdoor)"
^XMB(3.9,146012,2,1141,0)="""RTN"",""PSOERRX0"",333,0)"
^XMB(3.9,146012,2,1142,0)=" ;Input: DFN - Pointer to the PATIENT file (#2)"
