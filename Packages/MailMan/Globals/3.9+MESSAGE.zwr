^XMB(3.9,146055,2,307,0)="""RTN"",""PSOSUCH1"",33,0)"
^XMB(3.9,146055,2,308,0)=" W:'WARN !!,?10,$P($G(^DPT(DFN,0)),""^"")_"" DIED ""_SUSDOD_"" all prescriptions were discontinued"" W:'WARN !,?15,"" and deleted from the suspense file."" S WARN=1,DA=HOLD K HOLD,REA"
