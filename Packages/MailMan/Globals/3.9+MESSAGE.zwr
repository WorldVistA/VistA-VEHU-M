^XMB(3.9,146052,2,893,0)="""RTN"",""FBAAMST"",21,0)"
^XMB(3.9,146052,2,894,0)=" ;"
^XMB(3.9,146052,2,895,0)="""RTN"",""FBAAMST"",22,0)"
^XMB(3.9,146052,2,896,0)=" ; ask if summary or detail"
