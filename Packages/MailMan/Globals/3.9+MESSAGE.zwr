^XMB(3.9,146041,2,1498,0)=" ; Reference to DUZ^XUP is supported by IA #7487"
^XMB(3.9,146041,2,1499,0)="""RTN"",""SDES2CRTCLNAVAL2"",5,0)"
^XMB(3.9,146041,2,1500,0)=" ;"
^XMB(3.9,146041,2,1501,0)="""RTN"",""SDES2CRTCLNAVAL2"",6,0)"
