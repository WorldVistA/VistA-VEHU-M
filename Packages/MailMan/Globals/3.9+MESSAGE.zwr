^XMB(3.9,146084,2,1183,0)="""RTN"",""SDES2CRTCLNAVAL2"",17,0)"
^XMB(3.9,146084,2,1184,0)=" D CREATEAVAIL(.AVAILABILITY,.SDCONTEXT,.SLOTSTOCANCEL,CLINICIEN,CLINICSTARTHOUR,$$GET1^DIQ(44,CLINICIEN,1917,""I""),$$GET1^DIQ(44,CLINICIEN,1914,""I""),NUMBEROFENTRIES,.INPUTS,.INDEFINITEUNTIL,.RETURNAVAIL,.ERRORS)"
