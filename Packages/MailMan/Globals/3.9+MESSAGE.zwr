^XMB(3.9,146010,2,805,0)="""RTN"",""XUESSO1"",278,0)"
^XMB(3.9,146010,2,806,0)=" I ($G(NAME)="""")!($G(NEWDUZ)="""")!($G(SITE)="""")!($G(SITENUM)="""") Q 0"
^XMB(3.9,146010,2,807,0)="""RTN"",""XUESSO1"",279,0)"
^XMB(3.9,146010,2,808,0)=" I ($G(RMTDUZ)="""")!($G(PHONE)="""")!($G(TODAY)="""") Q 0"
^XMB(3.9,146010,2,809,0)="""RTN"",""XUESSO1"",280,0)"
^XMB(3.9,146010,2,810,0)=" S XMB=""XUVISIT"""
^XMB(3.9,146010,2,811,0)="""RTN"",""XUESSO1"",281,0)"
^XMB(3.9,146010,2,812,0)=" S XMB(1)=$$FMTE^XLFDT(TODAY)"
^XMB(3.9,146010,2,813,0)="""RTN"",""XUESSO1"",282,0)"
^XMB(3.9,146010,2,814,0)=" S XMB(2)=NAME,XMB(3)=NEWDUZ,XMB(4)=SITE"
^XMB(3.9,146010,2,815,0)="""RTN"",""XUESSO1"",283,0)"
^XMB(3.9,146010,2,816,0)=" S XMB(5)=SITENUM,XMB(6)=RMTDUZ,XMB(7)=PHONE"
^XMB(3.9,146010,2,817,0)="""RTN"",""XUESSO1"",284,0)"
^XMB(3.9,146010,2,818,0)=" I '$D(XTMUNIT) D ^XMB"
^XMB(3.9,146010,2,819,0)="""RTN"",""XUESSO1"",285,0)"
^XMB(3.9,146010,2,820,0)=" Q 1"
^XMB(3.9,146010,2,821,0)="""RTN"",""XUESSO1"",286,0)"
^XMB(3.9,146010,2,822,0)=" ;"
^XMB(3.9,146010,2,823,0)="""RTN"",""XUESSO1"",287,0)"
^XMB(3.9,146010,2,824,0)="SSNCHECK(SSN) ;INTRINSIC. Check for valid SSN"
^XMB(3.9,146010,2,825,0)="""RTN"",""XUESSO1"",288,0)"
^XMB(3.9,146010,2,826,0)=" ; Input: SSN in format ""nnnnnnnnn"" or ""nnn-nn-nnnn"""
^XMB(3.9,146010,2,827,0)="""RTN"",""XUESSO1"",289,0)"
^XMB(3.9,146010,2,828,0)=" ; Returns: 0 if SSN is invalid, 1 if success"
^XMB(3.9,146010,2,829,0)="""RTN"",""XUESSO1"",290,0)"
^XMB(3.9,146010,2,830,0)=" ; Valid SSN range 001-01-0001 to 899-99-9999 with exceptions (rule as of 2011)"
^XMB(3.9,146010,2,831,0)="""RTN"",""XUESSO1"",291,0)"
^XMB(3.9,146010,2,832,0)=" ; Valid Individual Taxpayer Identification Number range 900-01-0001 to 999-99-9999 with exceptions (rule as of 1966)"
^XMB(3.9,146010,2,833,0)="""RTN"",""XUESSO1"",292,0)"
^XMB(3.9,146010,2,834,0)=" N X"
^XMB(3.9,146010,2,835,0)="""RTN"",""XUESSO1"",293,0)"
^XMB(3.9,146010,2,836,0)=" I $$PROD^XUPROD()=0 Q 1  ;allow use of invalid SSNs in development accounts"
^XMB(3.9,146010,2,837,0)="""RTN"",""XUESSO1"",294,0)"
^XMB(3.9,146010,2,838,0)=" S X=$TR(SSN,""-"")"
^XMB(3.9,146010,2,839,0)="""RTN"",""XUESSO1"",295,0)"
^XMB(3.9,146010,2,840,0)=" I $L(X)'=9 Q 0"
^XMB(3.9,146010,2,841,0)="""RTN"",""XUESSO1"",296,0)"
^XMB(3.9,146010,2,842,0)=" I $E(X,1,3)'>0 Q 0   ;1st 3 digits cannot be 000"
^XMB(3.9,146010,2,843,0)="""RTN"",""XUESSO1"",297,0)"
^XMB(3.9,146010,2,844,0)=" I $E(X,4,5)'>0 Q 0   ;digits 4-5 cannot be 00"
^XMB(3.9,146010,2,845,0)="""RTN"",""XUESSO1"",298,0)"
^XMB(3.9,146010,2,846,0)=" I $E(X,6,9)'>0 Q 0   ;digits 6-9 cannot be 0000"
^XMB(3.9,146010,2,847,0)="""RTN"",""XUESSO1"",299,0)"
^XMB(3.9,146010,2,848,0)=" I $E(X,1,3)=666 Q 0  ;1st 3 digits cannot be 666"
^XMB(3.9,146010,2,849,0)="""RTN"",""XUESSO1"",300,0)"
^XMB(3.9,146010,2,850,0)=" I (X>987654319)&(X<987654330) Q 0  ;SSN range reserved for advertising"
^XMB(3.9,146010,2,851,0)="""RTN"",""XUESSO1"",301,0)"
^XMB(3.9,146010,2,852,0)=" I ($E(X,1,3)>899)&($E(X,4,5)=89) Q 0  ;digits 4-5 of ITIN cannot be 89"
^XMB(3.9,146010,2,853,0)="""RTN"",""XUESSO1"",302,0)"
^XMB(3.9,146010,2,854,0)=" I ($E(X,1,3)>899)&($E(X,4,5)=93) Q 0  ;digits 4-5 of ITIN cannot be 93"
^XMB(3.9,146010,2,855,0)="""RTN"",""XUESSO1"",303,0)"
^XMB(3.9,146010,2,856,0)=" Q 1"
^XMB(3.9,146010,2,857,0)="""RTN"",""XUESSO1"",304,0)"
^XMB(3.9,146010,2,858,0)=" ;"
^XMB(3.9,146010,2,859,0)="""RTN"",""XUESSO1"",305,0)"
^XMB(3.9,146010,2,860,0)="MPISECID(NETNAME) ; Return SECID from MPI"
^XMB(3.9,146010,2,861,0)="""RTN"",""XUESSO1"",306,0)"
^XMB(3.9,146010,2,862,0)=" ; Called from $$TALL"
^XMB(3.9,146010,2,863,0)="""RTN"",""XUESSO1"",307,0)"
^XMB(3.9,146010,2,864,0)=" N XMPI,XOUT"
^XMB(3.9,146010,2,865,0)="""RTN"",""XUESSO1"",308,0)"
^XMB(3.9,146010,2,866,0)=" S XMPI(""samacctnm"")=$G(NETNAME)"
^XMB(3.9,146010,2,867,0)="""RTN"",""XUESSO1"",309,0)"
^XMB(3.9,146010,2,868,0)=" D USER^XUIAMXML(.XOUT,.XMPI)"
^XMB(3.9,146010,2,869,0)="""RTN"",""XUESSO1"",310,0)"
^XMB(3.9,146010,2,870,0)=" Q $G(XOUT(""secId""))"
^XMB(3.9,146010,2,871,0)="""RTN"",""XUESSO1"",311,0)"
^XMB(3.9,146010,2,872,0)=" ;"
^XMB(3.9,146010,2,873,0)="""VER"")"
^XMB(3.9,146010,2,874,0)="8.0^22.2"
^XMB(3.9,146010,2,875,0)="$END KID XU*8.0*838b"
