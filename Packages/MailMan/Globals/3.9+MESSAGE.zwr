^XMB(3.9,146036,2,2600,0)=" S ELIG="""",INCMP=0"
^XMB(3.9,146036,2,2601,0)="""RTN"",""DVBCUTIL"",90,0)"
^XMB(3.9,146036,2,2602,0)=" W ?0,""Eligibility data:"" I $D(^DPT(DFN,.36)),$P(^(.36),U,1)]"""" S ELIG=$S($D(^DIC(8,+^(.36),0)):$P(^(0),U,6),1:"""")"
^XMB(3.9,146036,2,2603,0)="""RTN"",""DVBCUTIL"",91,0)"
^XMB(3.9,146036,2,2604,0)=" I ELIG]"""",$D(^DPT(DFN,.361)),^(.361)]"""" S ELIG=ELIG_"" (""_$S($P(^(.361),U,1)=""P"":""Pend ver"",$P(^(.361),U,1)=""R"":""Pend re-verif"",$P(^(.361),U,1)=""V"":""Verified"",1:""Not verified"")_"")"""
^XMB(3.9,146036,2,2605,0)="""RTN"",""DVBCUTIL"",92,0)"
^XMB(3.9,146036,2,2606,0)=" I $D(^DPT(DFN,.29)),$P(^(.29),U,1)]"""" S INCMP=1"
^XMB(3.9,146036,2,2607,0)="""RTN"",""DVBCUTIL"",93,0)"
^XMB(3.9,146036,2,2608,0)=" I $D(^DPT(DA,.293)),$P(^(.293),U,1)=1 S INCMP=1"
^XMB(3.9,146036,2,2609,0)="""RTN"",""DVBCUTIL"",94,0)"
