^XMB(3.9,146087,2,3563,0)="""RTN"",""YTQRQAD4"",268,0)"
^XMB(3.9,146087,2,3564,0)=" .S PROG=$$PROGRESS^YTQRQAD1(XADMIN,TSTIEN,ASMT)"
^XMB(3.9,146087,2,3565,0)="""RTN"",""YTQRQAD4"",269,0)"
^XMB(3.9,146087,2,3566,0)=" .I PROG="""" S PROG=0"
^XMB(3.9,146087,2,3567,0)="""RTN"",""YTQRQAD4"",270,0)"
