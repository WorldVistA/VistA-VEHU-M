^XMB(3.9,146015,2,310,0)=" ;"
^XMB(3.9,146015,2,311,0)="""RTN"",""PSODEM"",32,0)"
^XMB(3.9,146015,2,312,0)=" ; Display CrCl/BSA - show serum creatinine if CrCl can't be calculated"
^XMB(3.9,146015,2,313,0)="""RTN"",""PSODEM"",33,0)"
^XMB(3.9,146015,2,314,0)="CRCL S PSOBSA=$$BSA^PSSDSAPI(DFN),PSOBSA=$P(PSOBSA,""^"",3),PSOBSA=$S(PSOBSA'>0:""_______"",1:$J(PSOBSA,4,2))"
