^XMB(3.9,146047,2,2995,0)="""RTN"",""IBJPI"",12,0)"
^XMB(3.9,146047,2,2996,0)=" Q"
^XMB(3.9,146047,2,2997,0)="""RTN"",""IBJPI"",13,0)"
^XMB(3.9,146047,2,2998,0)=" ;"
^XMB(3.9,146047,2,2999,0)="""RTN"",""IBJPI"",14,0)"
^XMB(3.9,146047,2,3000,0)="HDR ; header "
^XMB(3.9,146047,2,3001,0)="""RTN"",""IBJPI"",15,0)"
^XMB(3.9,146047,2,3002,0)=" S VALMHDR(1)=""Only authorized persons may edit this data."""
^XMB(3.9,146047,2,3003,0)="""RTN"",""IBJPI"",16,0)"
