^XMB(3.9,146084,2,3477,0)="""RTN"",""SDES2RECLLREQ2"",167,0)"
^XMB(3.9,146084,2,3478,0)="VALIDATEDAPTDT(ERRORS,DTRMSENT) ;Validate Date Reminder Sent"
^XMB(3.9,146084,2,3479,0)="""RTN"",""SDES2RECLLREQ2"",168,0)"
^XMB(3.9,146084,2,3480,0)=" S DTRMSENT=$G(DTRMSENT,"""")"
^XMB(3.9,146084,2,3481,0)="""RTN"",""SDES2RECLLREQ2"",169,0)"
