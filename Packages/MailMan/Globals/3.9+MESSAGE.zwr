^XMB(3.9,146047,2,3641,0)="""^DD"",2,2.342,.03,1,1,0)"
^XMB(3.9,146047,2,3642,0)="^^TRIGGER^2.312^1.08"
^XMB(3.9,146047,2,3643,0)="""^DD"",2,2.342,.03,1,1,1)"
^XMB(3.9,146047,2,3644,0)="X ^DD(2.342,.03,1,1,1.3) I X S X=DIV S Y(1)=$S($D(^DPT(D0,.312,D1,1)):^(1),1:"""") S X=$P(Y(1),U,8),X=X S DIU=X K Y S X=DIV S X=$E($P(^DPT(DA(2),.312,DA(1),13,DA,1),U),1,80) X ^DD(2.342,.03,1,1,1.4)"
^XMB(3.9,146047,2,3645,0)="""^DD"",2,2.342,.03,1,1,1.3)"
^XMB(3.9,146047,2,3646,0)="K DIV S DIV=X,D0=DA(2),DIV(0)=D0,D1=DA(1),DIV(1)=D1,D2=DA S Y(0)=X S X=($P($G(^DPT(DA(2),.312,DA(1),1)),U,8)'=$E($P(^DPT(DA(2),.312,DA(1),13,DA,1),U),1,80))"
^XMB(3.9,146047,2,3647,0)="""^DD"",2,2.342,.03,1,1,1.4)"
^XMB(3.9,146047,2,3648,0)="S DIH=$G(^DPT(DIV(0),.312,DIV(1),1)),DIV=X S $P(^(1),U,8)=DIV,DIH=2.312,DIG=1.08 D ^DICR"
^XMB(3.9,146047,2,3649,0)="""^DD"",2,2.342,.03,1,1,2)"
^XMB(3.9,146047,2,3650,0)="K DIV S DIV=X,D0=DA(2),DIV(0)=D0,D1=DA(1),DIV(1)=D1,D2=DA S Y(0)=X S X=($P(^DPT(DA(2),.312,DA(1),13,DA,1),U)="""") I X S X=DIV S Y(1)=$S($D(^DPT(D0,.312,D1,1)):^(1),1:"""") S X=$P(Y(1),U,8),X=X S DIU=X K Y S X="""" X ^DD(2.342,.03,1,1,2.4)"
