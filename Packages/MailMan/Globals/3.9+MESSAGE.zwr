^XMB(3.9,146098,2,220,0)=" SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the"
^XMB(3.9,146098,2,221,0)="""KRN"",8994,4471,2,1,1,6,0)"
^XMB(3.9,146098,2,222,0)="                           calling application."
^XMB(3.9,146098,2,223,0)="""KRN"",8994,4471,2,1,1,7,0)"
^XMB(3.9,146098,2,224,0)=" SDCONTEXT(""PATIENT DFN"")= The name of the patient taking action on the"
