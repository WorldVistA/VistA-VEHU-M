^XMB(3.9,146037,2,2928,0)=" . ;W !,?4,$P(DATA,U,5),""     "",RCDBAL2"
^XMB(3.9,146037,2,2929,0)="""RTN"",""RCDPTAR1"",308,0)"
^XMB(3.9,146037,2,2930,0)=" . W !,?4,$P(DATA,U,5)         ; Remove unbalanced indicator at EFT level, PRCA*4.5*439"
^XMB(3.9,146037,2,2931,0)="""RTN"",""RCDPTAR1"",309,0)"
^XMB(3.9,146037,2,2932,0)=" . W !,?11,$P(DATA,U,6),""/"",$P(DATA,U,7)"
^XMB(3.9,146037,2,2933,0)="""RTN"",""RCDPTAR1"",310,0)"
^XMB(3.9,146037,2,2934,0)=" ;"
^XMB(3.9,146037,2,2935,0)="""RTN"",""RCDPTAR1"",311,0)"
^XMB(3.9,146037,2,2936,0)=" I 'RCEXCEL,RCPG D"
^XMB(3.9,146037,2,2937,0)="""RTN"",""RCDPTAR1"",312,0)"
^XMB(3.9,146037,2,2938,0)=" . W !!,""Total for Deposit #: "",RCDNUM,"" Deposit Date: "",$$FMTE^XLFDT(RCDDT,""5DZ"")"
^XMB(3.9,146037,2,2939,0)="""RTN"",""RCDPTAR1"",313,0)"
^XMB(3.9,146037,2,2940,0)=" . ; Add coding to account for out-of-balance deposits ; PRCA*4.5*439"
^XMB(3.9,146037,2,2941,0)="""RTN"",""RCDPTAR1"",314,0)"
^XMB(3.9,146037,2,2942,0)=" . I RCDBAL W ?51,$J(GTOT,13,2) Q"
^XMB(3.9,146037,2,2943,0)="""RTN"",""RCDPTAR1"",315,0)"
^XMB(3.9,146037,2,2944,0)=" . W ?55,$J($P(RCDBAL,U,3),13,2)"
^XMB(3.9,146037,2,2945,0)="""RTN"",""RCDPTAR1"",316,0)"
^XMB(3.9,146037,2,2946,0)=" I 'RCSCR W !,@IOF"
^XMB(3.9,146037,2,2947,0)="""RTN"",""RCDPTAR1"",317,0)"
^XMB(3.9,146037,2,2948,0)=" I $D(ZTQUEUED) S ZTREQ=""@"" Q"
^XMB(3.9,146037,2,2949,0)="""RTN"",""RCDPTAR1"",318,0)"
^XMB(3.9,146037,2,2950,0)=" D ^%ZISC"
^XMB(3.9,146037,2,2951,0)="""RTN"",""RCDPTAR1"",319,0)"
^XMB(3.9,146037,2,2952,0)=" ;"
^XMB(3.9,146037,2,2953,0)="""RTN"",""RCDPTAR1"",320,0)"
^XMB(3.9,146037,2,2954,0)=" I RCPG,RCSCR D PAUSE"
^XMB(3.9,146037,2,2955,0)="""RTN"",""RCDPTAR1"",321,0)"
^XMB(3.9,146037,2,2956,0)=" Q"
^XMB(3.9,146037,2,2957,0)="""RTN"",""RCDPTAR1"",322,0)"
^XMB(3.9,146037,2,2958,0)=" ;"
^XMB(3.9,146037,2,2959,0)="""RTN"",""RCDPTAR1"",323,0)"
^XMB(3.9,146037,2,2960,0)=" ; PRCA*4.5*380 - Added deposit number & deposit date"
^XMB(3.9,146037,2,2961,0)="""RTN"",""RCDPTAR1"",324,0)"
^XMB(3.9,146037,2,2962,0)="HEADER(RCNOW,RCPG,RCHR,RCDT1,RCDT2,RCEXCEL,RCDNUM,RCDDT,RCDBAL) ; Display the report header"
^XMB(3.9,146037,2,2963,0)="""RTN"",""RCDPTAR1"",325,0)"
^XMB(3.9,146037,2,2964,0)=" ; Input:   RCNOW   - External Run Date/Time"
^XMB(3.9,146037,2,2965,0)="""RTN"",""RCDPTAR1"",326,0)"
^XMB(3.9,146037,2,2966,0)=" ;          RCPG    - Current page number"
^XMB(3.9,146037,2,2967,0)="""RTN"",""RCDPTAR1"",327,0)"
^XMB(3.9,146037,2,2968,0)=" ;          RCHR    - Dashed line"
^XMB(3.9,146037,2,2969,0)="""RTN"",""RCDPTAR1"",328,0)"
^XMB(3.9,146037,2,2970,0)=" ;          RCDT1   - Start Date or null if new summary report"
^XMB(3.9,146037,2,2971,0)="""RTN"",""RCDPTAR1"",329,0)"
^XMB(3.9,146037,2,2972,0)=" ;          RCDT2   - End Date or null if new summary report"
^XMB(3.9,146037,2,2973,0)="""RTN"",""RCDPTAR1"",330,0)"
^XMB(3.9,146037,2,2974,0)=" ;          RCEXCEL - 1 - Excel output, 0 otherwise"
^XMB(3.9,146037,2,2975,0)="""RTN"",""RCDPTAR1"",331,0)"
^XMB(3.9,146037,2,2976,0)=" ;          RCDNUM  - Deposit Number or null if original summary report"
^XMB(3.9,146037,2,2977,0)="""RTN"",""RCDPTAR1"",332,0)"
^XMB(3.9,146037,2,2978,0)=" ;          RCDDT   - Internal Deposit Date or null if original summary report"
^XMB(3.9,146037,2,2979,0)="""RTN"",""RCDPTAR1"",333,0)"
^XMB(3.9,146037,2,2980,0)=" ;          RCDBAL  - Piece 1: 1 if deposit is in balance, 0 otherwise   ; Add parameter PRCA*4.5*439"
^XMB(3.9,146037,2,2981,0)="""RTN"",""RCDPTAR1"",334,0)"
^XMB(3.9,146037,2,2982,0)=" ;                    Piece 2: Total of EFTs on the deposit"
^XMB(3.9,146037,2,2983,0)="""RTN"",""RCDPTAR1"",335,0)"
^XMB(3.9,146037,2,2984,0)=" ;                    Piece 3: Deposit Total"
^XMB(3.9,146037,2,2985,0)="""RTN"",""RCDPTAR1"",336,0)"
^XMB(3.9,146037,2,2986,0)=" ;"
^XMB(3.9,146037,2,2987,0)="""RTN"",""RCDPTAR1"",337,0)"
^XMB(3.9,146037,2,2988,0)=" ; Output:  RCPG    - Updated page number"
^XMB(3.9,146037,2,2989,0)="""RTN"",""RCDPTAR1"",338,0)"
^XMB(3.9,146037,2,2990,0)=" ;"
^XMB(3.9,146037,2,2991,0)="""RTN"",""RCDPTAR1"",339,0)"
^XMB(3.9,146037,2,2992,0)=" W @IOF"
^XMB(3.9,146037,2,2993,0)="""RTN"",""RCDPTAR1"",340,0)"
^XMB(3.9,146037,2,2994,0)=" ;"
^XMB(3.9,146037,2,2995,0)="""RTN"",""RCDPTAR1"",341,0)"
^XMB(3.9,146037,2,2996,0)=" I '$L($G(RCDBAL)) S RCDBAL=1  ; If called from code that doesn't use RCDBAL, set RCDBAL to 1 to default to a balanced deposit. PRCA*4.5*439"
^XMB(3.9,146037,2,2997,0)="""RTN"",""RCDPTAR1"",342,0)"
^XMB(3.9,146037,2,2998,0)=" ;"
^XMB(3.9,146037,2,2999,0)="""RTN"",""RCDPTAR1"",343,0)"
^XMB(3.9,146037,2,3000,0)=" ; If Excel, print column headers separated with up-arrows and quit"
^XMB(3.9,146037,2,3001,0)="""RTN"",""RCDPTAR1"",344,0)"
^XMB(3.9,146037,2,3002,0)=" I $G(RCEXCEL) D  Q"
^XMB(3.9,146037,2,3003,0)="""RTN"",""RCDPTAR1"",345,0)"
^XMB(3.9,146037,2,3004,0)=" . ; PRCA*4.5*380 - New header for Dep. Num/Date report"
^XMB(3.9,146037,2,3005,0)="""RTN"",""RCDPTAR1"",346,0)"
^XMB(3.9,146037,2,3006,0)=" . ; PRCA*4.5*439 - Add UNBALANCED to Excel header"
^XMB(3.9,146037,2,3007,0)="""RTN"",""RCDPTAR1"",347,0)"
^XMB(3.9,146037,2,3008,0)=" . I RCDT1'="""" D"
^XMB(3.9,146037,2,3009,0)="""RTN"",""RCDPTAR1"",348,0)"
^XMB(3.9,146037,2,3010,0)=" . . W !,""EFT#^UNBALANCED^DATE RECEIVED^DEPOSIT#^EFT TOTAL AMT^DATE MATCHED^DATE POSTED^TRACE #^PAYER NAME^PAYER ID"""
^XMB(3.9,146037,2,3011,0)="""RTN"",""RCDPTAR1"",349,0)"
^XMB(3.9,146037,2,3012,0)=" . E  D"
^XMB(3.9,146037,2,3013,0)="""RTN"",""RCDPTAR1"",350,0)"
^XMB(3.9,146037,2,3014,0)=" . . W !,""EFT#^UNBALANCED^DEPOSIT#^DEPOSIT DATE^DATE RECEIVED^EFT TOTAL AMT^TRACE #^PAYER NAME^PAYER ID"""
^XMB(3.9,146037,2,3015,0)="""RTN"",""RCDPTAR1"",351,0)"
^XMB(3.9,146037,2,3016,0)=" . S RCPG=1"
^XMB(3.9,146037,2,3017,0)="""RTN"",""RCDPTAR1"",352,0)"
^XMB(3.9,146037,2,3018,0)=" ;"
^XMB(3.9,146037,2,3019,0)="""RTN"",""RCDPTAR1"",353,0)"
^XMB(3.9,146037,2,3020,0)=" ; Non-Excel Header"
^XMB(3.9,146037,2,3021,0)="""RTN"",""RCDPTAR1"",354,0)"
^XMB(3.9,146037,2,3022,0)=" N LINE"
^XMB(3.9,146037,2,3023,0)="""RTN"",""RCDPTAR1"",355,0)"
^XMB(3.9,146037,2,3024,0)=" S RCPG=RCPG+1"
^XMB(3.9,146037,2,3025,0)="""RTN"",""RCDPTAR1"",356,0)"
^XMB(3.9,146037,2,3026,0)=" S LINE=""EFT TRANSACTION AUDIT REPORT - SUMMARY     Page: ""_RCPG"
^XMB(3.9,146037,2,3027,0)="""RTN"",""RCDPTAR1"",357,0)"
^XMB(3.9,146037,2,3028,0)=" W !?(IOM-$L(LINE)\2),LINE"
^XMB(3.9,146037,2,3029,0)="""RTN"",""RCDPTAR1"",358,0)"
^XMB(3.9,146037,2,3030,0)=" S LINE=""RUN DATE: ""_RCNOW"
^XMB(3.9,146037,2,3031,0)="""RTN"",""RCDPTAR1"",359,0)"
^XMB(3.9,146037,2,3032,0)=" W !?(IOM-$L(LINE)\2),LINE"
^XMB(3.9,146037,2,3033,0)="""RTN"",""RCDPTAR1"",360,0)"
^XMB(3.9,146037,2,3034,0)=" ; PRCA*4.5*380 - New header for Dep. Num/Date report"
^XMB(3.9,146037,2,3035,0)="""RTN"",""RCDPTAR1"",361,0)"
^XMB(3.9,146037,2,3036,0)=" I RCDT1'="""" D  Q"
^XMB(3.9,146037,2,3037,0)="""RTN"",""RCDPTAR1"",362,0)"
^XMB(3.9,146037,2,3038,0)=" . S LINE=""DATE RANGE: ""_$$DATE^RCDPRU(RCDT1,""2D"")_"" - ""_$$DATE^RCDPRU(RCDT2,""2D"")_"" (DATE DEPOSIT ADDED)"""
^XMB(3.9,146037,2,3039,0)="""RTN"",""RCDPTAR1"",363,0)"
^XMB(3.9,146037,2,3040,0)=" . W !?(IOM-$L(LINE)\2),LINE"
^XMB(3.9,146037,2,3041,0)="""RTN"",""RCDPTAR1"",364,0)"
^XMB(3.9,146037,2,3042,0)=" . W !!,""EFT#"",?13,""DATE RECVD"",?25,""DEPOSIT#"",?37,""EFT TOTAL AMT"",?54,""DATE MATCHED"",?69,""DATE POSTED"""
^XMB(3.9,146037,2,3043,0)="""RTN"",""RCDPTAR1"",365,0)"
^XMB(3.9,146037,2,3044,0)=" . W !,?4,""TRACE #"",!,?11,""PAYER NAME/ID"""
^XMB(3.9,146037,2,3045,0)="""RTN"",""RCDPTAR1"",366,0)"
^XMB(3.9,146037,2,3046,0)=" . W !,RCHR"
^XMB(3.9,146037,2,3047,0)="""RTN"",""RCDPTAR1"",367,0)"
^XMB(3.9,146037,2,3048,0)=" ;"
^XMB(3.9,146037,2,3049,0)="""RTN"",""RCDPTAR1"",368,0)"
^XMB(3.9,146037,2,3050,0)=" S LINE=""DEPOSIT #: ""_RCDNUM_""  Deposit Date ""_$$DATE^RCDPRU(RCDDT,""2D"")_$S('RCDBAL:"" **UNBALANCED**"",1:"""")  ;Unbalance indicator PRCA*4.5*439"
^XMB(3.9,146037,2,3051,0)="""RTN"",""RCDPTAR1"",369,0)"
^XMB(3.9,146037,2,3052,0)=" I RCDNUM'="""" D"
^XMB(3.9,146037,2,3053,0)="""RTN"",""RCDPTAR1"",370,0)"
^XMB(3.9,146037,2,3054,0)=" . W !?(IOM-$L(LINE)\2),LINE"
^XMB(3.9,146037,2,3055,0)="""RTN"",""RCDPTAR1"",371,0)"
^XMB(3.9,146037,2,3056,0)=" . W !!,""EFT#"",?13,""DEPOSIT#"",?26,""DEPOSIT DATE"",?40,""DATE RECEIVED"",?55,""EFT TOTAL AMT"""
^XMB(3.9,146037,2,3057,0)="""RTN"",""RCDPTAR1"",372,0)"
^XMB(3.9,146037,2,3058,0)=" . W !,?4,""TRACE #"",!,?11,""PAYER NAME/ID"""
^XMB(3.9,146037,2,3059,0)="""RTN"",""RCDPTAR1"",373,0)"
^XMB(3.9,146037,2,3060,0)=" . W !,RCHR"
^XMB(3.9,146037,2,3061,0)="""RTN"",""RCDPTAR1"",374,0)"
^XMB(3.9,146037,2,3062,0)=" ; end PRCA*4.5*380 changes"
^XMB(3.9,146037,2,3063,0)="""RTN"",""RCDPTAR1"",375,0)"
^XMB(3.9,146037,2,3064,0)=" Q"
^XMB(3.9,146037,2,3065,0)="""RTN"",""RCDPTAR1"",376,0)"
^XMB(3.9,146037,2,3066,0)=" ;"
^XMB(3.9,146037,2,3067,0)="""RTN"",""RCDPTAR1"",377,0)"
^XMB(3.9,146037,2,3068,0)="EXMSG ;"
^XMB(3.9,146037,2,3069,0)="""RTN"",""RCDPTAR1"",378,0)"
^XMB(3.9,146037,2,3070,0)=" ;Displays the message about capturing to an Excel file format"
^XMB(3.9,146037,2,3071,0)="""RTN"",""RCDPTAR1"",379,0)"
^XMB(3.9,146037,2,3072,0)=" ;"
^XMB(3.9,146037,2,3073,0)="""RTN"",""RCDPTAR1"",380,0)"
^XMB(3.9,146037,2,3074,0)=" W !!?5,""To capture as an Excel format, it is recommended that you queue this"""
^XMB(3.9,146037,2,3075,0)="""RTN"",""RCDPTAR1"",381,0)"
^XMB(3.9,146037,2,3076,0)=" W !?5,""report to a spool device with margins of 256 and page length of 99999"""
^XMB(3.9,146037,2,3077,0)="""RTN"",""RCDPTAR1"",382,0)"
^XMB(3.9,146037,2,3078,0)=" W !?5,""(e.g. spoolname;256;99999). This should help avoid wrapping problems."""
^XMB(3.9,146037,2,3079,0)="""RTN"",""RCDPTAR1"",383,0)"
^XMB(3.9,146037,2,3080,0)=" W !!?5,""Another method would be to set up your terminal to capture the detail"""
^XMB(3.9,146037,2,3081,0)="""RTN"",""RCDPTAR1"",384,0)"
^XMB(3.9,146037,2,3082,0)=" W !?5,""report data. On some terminals, this can be done by clicking on the"""
^XMB(3.9,146037,2,3083,0)="""RTN"",""RCDPTAR1"",385,0)"
^XMB(3.9,146037,2,3084,0)=" W !?5,""'Tools' menu above, then click on 'Capture Incoming Data' to save to"""
^XMB(3.9,146037,2,3085,0)="""RTN"",""RCDPTAR1"",386,0)"
^XMB(3.9,146037,2,3086,0)=" W !?5,""Desktop.  To avoid undesired wrapping of the data saved to the file,"""
^XMB(3.9,146037,2,3087,0)="""RTN"",""RCDPTAR1"",387,0)"
^XMB(3.9,146037,2,3088,0)=" W !?5,""please enter '0;256;99999' at the 'DEVICE:' prompt."",!"
^XMB(3.9,146037,2,3089,0)="""RTN"",""RCDPTAR1"",388,0)"
^XMB(3.9,146037,2,3090,0)=" Q"
^XMB(3.9,146037,2,3091,0)="""RTN"",""RCDPTAR1"",389,0)"
^XMB(3.9,146037,2,3092,0)=" ;"
^XMB(3.9,146037,2,3093,0)="""RTN"",""RCDPTAR1"",390,0)"
^XMB(3.9,146037,2,3094,0)="PAUSE() ; Display press return to continue message"
^XMB(3.9,146037,2,3095,0)="""RTN"",""RCDPTAR1"",391,0)"
^XMB(3.9,146037,2,3096,0)=" N DIR,X,Y,DTOUT,DUOUT,DIROUT,DIRUT"
^XMB(3.9,146037,2,3097,0)="""RTN"",""RCDPTAR1"",392,0)"
^XMB(3.9,146037,2,3098,0)=" S DIR(0)=""E"""
^XMB(3.9,146037,2,3099,0)="""RTN"",""RCDPTAR1"",393,0)"
^XMB(3.9,146037,2,3100,0)=" D ^DIR"
^XMB(3.9,146037,2,3101,0)="""RTN"",""RCDPTAR1"",394,0)"
^XMB(3.9,146037,2,3102,0)=" Q Y"
^XMB(3.9,146037,2,3103,0)="""RTN"",""RCDPTAR1"",395,0)"
^XMB(3.9,146037,2,3104,0)=" ;"
^XMB(3.9,146037,2,3105,0)="""RTN"",""RCDPTAR1"",396,0)"
^XMB(3.9,146037,2,3106,0)=" ; PRCA*4.5*380 - Add deposit number/date to header"
^XMB(3.9,146037,2,3107,0)="""RTN"",""RCDPTAR1"",397,0)"
^XMB(3.9,146037,2,3108,0)="CHKP(RCNOW,RCPG,RCHR,RCDT1,RCDT2,RCEXCEL,RCSCR,LINES,RCDNUM,RCDDT) ; Check if we need to do a page break"
^XMB(3.9,146037,2,3109,0)="""RTN"",""RCDPTAR1"",398,0)"
^XMB(3.9,146037,2,3110,0)=" ; Input:   RCNOW   - Run date/time"
^XMB(3.9,146037,2,3111,0)="""RTN"",""RCDPTAR1"",399,0)"
^XMB(3.9,146037,2,3112,0)=" ;          RCPG    - Current Page Number"
^XMB(3.9,146037,2,3113,0)="""RTN"",""RCDPTAR1"",400,0)"
^XMB(3.9,146037,2,3114,0)=" ;          RCHR    - Dashed line"
^XMB(3.9,146037,2,3115,0)="""RTN"",""RCDPTAR1"",401,0)"
^XMB(3.9,146037,2,3116,0)=" ;          RCDT1   - Start Date or null if new summary report"
^XMB(3.9,146037,2,3117,0)="""RTN"",""RCDPTAR1"",402,0)"
^XMB(3.9,146037,2,3118,0)=" ;          RCDT2   - End Date or null if new summary report"
^XMB(3.9,146037,2,3119,0)="""RTN"",""RCDPTAR1"",403,0)"
^XMB(3.9,146037,2,3120,0)=" ;          RCEXCEL - 1 if output to Excel, 0 otherwise"
^XMB(3.9,146037,2,3121,0)="""RTN"",""RCDPTAR1"",404,0)"
^XMB(3.9,146037,2,3122,0)=" ;          RSCR    - 1 output to screen, otherwise output to paper"
^XMB(3.9,146037,2,3123,0)="""RTN"",""RCDPTAR1"",405,0)"
^XMB(3.9,146037,2,3124,0)=" ;          LINES   - Current # of lines on the page"
^XMB(3.9,146037,2,3125,0)="""RTN"",""RCDPTAR1"",406,0)"
^XMB(3.9,146037,2,3126,0)=" ;          RCDNUM  - Deposit Number or null if original summary report"
^XMB(3.9,146037,2,3127,0)="""RTN"",""RCDPTAR1"",407,0)"
^XMB(3.9,146037,2,3128,0)=" ;          RCDDT   - Deposit Date or null if original summary report"
^XMB(3.9,146037,2,3129,0)="""RTN"",""RCDPTAR1"",408,0)"
^XMB(3.9,146037,2,3130,0)=" ; Output:  RCPG    - New Page Number or 0 if user quit display"
^XMB(3.9,146037,2,3131,0)="""RTN"",""RCDPTAR1"",409,0)"
^XMB(3.9,146037,2,3132,0)=" ;"
^XMB(3.9,146037,2,3133,0)="""RTN"",""RCDPTAR1"",410,0)"
^XMB(3.9,146037,2,3134,0)=" I $Y'>(IOSL-LINES) Q"
^XMB(3.9,146037,2,3135,0)="""RTN"",""RCDPTAR1"",411,0)"
^XMB(3.9,146037,2,3136,0)=" I RCSCR,'$$PAUSE S RCPG=0 Q"
^XMB(3.9,146037,2,3137,0)="""RTN"",""RCDPTAR1"",412,0)"
^XMB(3.9,146037,2,3138,0)=" D HEADER(RCNOW,.RCPG,RCHR,RCDT1,RCDT2,RCEXCEL,RCDNUM,RCDDT)"
^XMB(3.9,146037,2,3139,0)="""RTN"",""RCDPTAR1"",413,0)"
^XMB(3.9,146037,2,3140,0)=" Q"
^XMB(3.9,146037,2,3141,0)="""RTN"",""RCDPTAR1"",414,0)"
^XMB(3.9,146037,2,3142,0)=" ;"
^XMB(3.9,146037,2,3143,0)="""RTN"",""RCDPTAR1"",415,0)"
^XMB(3.9,146037,2,3144,0)="EFT(EFTIEN) ; Format EFT output - EFT.SEQ - PRCA*4.5*326"
^XMB(3.9,146037,2,3145,0)="""RTN"",""RCDPTAR1"",416,0)"
^XMB(3.9,146037,2,3146,0)=" ; Input:   EFTIEN  - Internal EFT number"
^XMB(3.9,146037,2,3147,0)="""RTN"",""RCDPTAR1"",417,0)"
^XMB(3.9,146037,2,3148,0)=" ; Returns: EFT.Sequence #"
^XMB(3.9,146037,2,3149,0)="""RTN"",""RCDPTAR1"",418,0)"
^XMB(3.9,146037,2,3150,0)=" Q $$GET1^DIQ(344.31,EFTIEN_"","",.01,""E"")"
^XMB(3.9,146037,2,3151,0)="""RTN"",""RCDPTAR1"",419,0)"
^XMB(3.9,146037,2,3152,0)=" ;"
^XMB(3.9,146037,2,3153,0)="""RTN"",""RCDPTAR1"",420,0)"
^XMB(3.9,146037,2,3154,0)="DEPEFTS(RCDNUM,RCDDT,RCEFTCNT) ; List EFTs for a given deposit number and date. Added for PRCA*4.5*439"
^XMB(3.9,146037,2,3155,0)="""RTN"",""RCDPTAR1"",421,0)"
^XMB(3.9,146037,2,3156,0)=" ; Input - RCDNUM - Deposit #"
^XMB(3.9,146037,2,3157,0)="""RTN"",""RCDPTAR1"",422,0)"
^XMB(3.9,146037,2,3158,0)=" ;         RCDDT  - Deposit Date"
^XMB(3.9,146037,2,3159,0)="""RTN"",""RCDPTAR1"",423,0)"
^XMB(3.9,146037,2,3160,0)=" ; Output - Return value LIST(Y) containing data of selected EFT"
^XMB(3.9,146037,2,3161,0)="""RTN"",""RCDPTAR1"",424,0)"
^XMB(3.9,146037,2,3162,0)=" ;          RCEFTCNT - Count of EFTs passed by reference"
^XMB(3.9,146037,2,3163,0)="""RTN"",""RCDPTAR1"",425,0)"
^XMB(3.9,146037,2,3164,0)=" ;"
^XMB(3.9,146037,2,3165,0)="""RTN"",""RCDPTAR1"",426,0)"
^XMB(3.9,146037,2,3166,0)=" N EFTIEN,CNT,DATA,J,LIST,RCBAL,RCDBAL,RCDBAL1,RCDIEN,Y"
^XMB(3.9,146037,2,3167,0)="""RTN"",""RCDPTAR1"",427,0)"
^XMB(3.9,146037,2,3168,0)=" ;"
^XMB(3.9,146037,2,3169,0)="""RTN"",""RCDPTAR1"",428,0)"
^XMB(3.9,146037,2,3170,0)=" S (CNT,RCDIEN,RCDBAL)=0"
^XMB(3.9,146037,2,3171,0)="""RTN"",""RCDPTAR1"",429,0)"
^XMB(3.9,146037,2,3172,0)=" F  D  Q:RCDIEN="""""
^XMB(3.9,146037,2,3173,0)="""RTN"",""RCDPTAR1"",430,0)"
^XMB(3.9,146037,2,3174,0)=" . S RCDIEN=$O(^RCY(344.3,""ADEP2"",RCDNUM,RCDDT,RCDIEN))"
^XMB(3.9,146037,2,3175,0)="""RTN"",""RCDPTAR1"",431,0)"
^XMB(3.9,146037,2,3176,0)=" . I RCDIEN="""" Q"
^XMB(3.9,146037,2,3177,0)="""RTN"",""RCDPTAR1"",432,0)"
^XMB(3.9,146037,2,3178,0)=" . S RCDBAL1=$$DEPBAL^RCDPTAR2(RCDIEN)"
^XMB(3.9,146037,2,3179,0)="""RTN"",""RCDPTAR1"",433,0)"
^XMB(3.9,146037,2,3180,0)=" . F J=2:1:3 S $P(RCDBAL,U,J)=$P(RCDBAL1,U,J)+$P(RCDBAL,U,J)"
^XMB(3.9,146037,2,3181,0)="""RTN"",""RCDPTAR1"",434,0)"
^XMB(3.9,146037,2,3182,0)=" . S EFTIEN="""""
^XMB(3.9,146037,2,3183,0)="""RTN"",""RCDPTAR1"",435,0)"
^XMB(3.9,146037,2,3184,0)=" . F  D  Q:'EFTIEN"
^XMB(3.9,146037,2,3185,0)="""RTN"",""RCDPTAR1"",436,0)"
^XMB(3.9,146037,2,3186,0)=" . . S EFTIEN=$O(^RCY(344.31,""B"",RCDIEN,EFTIEN))"
^XMB(3.9,146037,2,3187,0)="""RTN"",""RCDPTAR1"",437,0)"
^XMB(3.9,146037,2,3188,0)=" . . Q:'EFTIEN"
^XMB(3.9,146037,2,3189,0)="""RTN"",""RCDPTAR1"",438,0)"
^XMB(3.9,146037,2,3190,0)=" . . S DATA=$$EFTDATA^RCDPTAR(EFTIEN) I DATA]"""" S CNT=CNT+1,LIST(CNT)=DATA"
^XMB(3.9,146037,2,3191,0)="""RTN"",""RCDPTAR1"",439,0)"
^XMB(3.9,146037,2,3192,0)=" ;"
^XMB(3.9,146037,2,3193,0)="""RTN"",""RCDPTAR1"",440,0)"
^XMB(3.9,146037,2,3194,0)=" S RCEFTCNT=CNT"
^XMB(3.9,146037,2,3195,0)="""RTN"",""RCDPTAR1"",441,0)"
^XMB(3.9,146037,2,3196,0)=" I CNT=0 W !!,""No EFT detail for this selection"" D PAUSE Q """""
^XMB(3.9,146037,2,3197,0)="""RTN"",""RCDPTAR1"",442,0)"
^XMB(3.9,146037,2,3198,0)=" ;"
^XMB(3.9,146037,2,3199,0)="""RTN"",""RCDPTAR1"",443,0)"
^XMB(3.9,146037,2,3200,0)=" ; If only one EFT, select it and quit"
^XMB(3.9,146037,2,3201,0)="""RTN"",""RCDPTAR1"",444,0)"
^XMB(3.9,146037,2,3202,0)=" I CNT=1 S Y=1 G EFT1"
^XMB(3.9,146037,2,3203,0)="""RTN"",""RCDPTAR1"",445,0)"
^XMB(3.9,146037,2,3204,0)=" ;"
^XMB(3.9,146037,2,3205,0)="""RTN"",""RCDPTAR1"",446,0)"
^XMB(3.9,146037,2,3206,0)=" ; Display list of EFTs. Manual display and reading so we can put data on two lines. PRCA*4.5*439"
^XMB(3.9,146037,2,3207,0)="""RTN"",""RCDPTAR1"",447,0)"
^XMB(3.9,146037,2,3208,0)=" N ROW,TRANS,X"
^XMB(3.9,146037,2,3209,0)="""RTN"",""RCDPTAR1"",448,0)"
^XMB(3.9,146037,2,3210,0)=" W !!,""Deposit #: ""_$J($$GET1^DIQ(344.3,LOCKIEN_"","",.06),10)_""   """
^XMB(3.9,146037,2,3211,0)="""RTN"",""RCDPTAR1"",449,0)"
^XMB(3.9,146037,2,3212,0)=" W ""Deposit Date: ""_$$DATE^RCDPRU(RCDDT,""2DZ"")"
^XMB(3.9,146037,2,3213,0)="""RTN"",""RCDPTAR1"",450,0)"
^XMB(3.9,146037,2,3214,0)=" W $J($P(RCDBAL,U,3),19,2)   ; Deposit Total"
^XMB(3.9,146037,2,3215,0)="""RTN"",""RCDPTAR1"",451,0)"
^XMB(3.9,146037,2,3216,0)=" ;I '($P(RCDBAL,U,2)=$P(RCDBAL,U,3)) W "" **UNBALANCED**""   ; Remove unbalanced indicator at EFT level"
^XMB(3.9,146037,2,3217,0)="""RTN"",""RCDPTAR1"",452,0)"
^XMB(3.9,146037,2,3218,0)=" N LCNT,QUIT  ; PRCA*4.5*439"
^XMB(3.9,146037,2,3219,0)="""RTN"",""RCDPTAR1"",453,0)"
^XMB(3.9,146037,2,3220,0)=" S LCNT=0,QUIT=0,Y=-1"
^XMB(3.9,146037,2,3221,0)="""RTN"",""RCDPTAR1"",454,0)"
^XMB(3.9,146037,2,3222,0)=" F ROW=1:1:CNT D  Q:QUIT"
^XMB(3.9,146037,2,3223,0)="""RTN"",""RCDPTAR1"",455,0)"
^XMB(3.9,146037,2,3224,0)=" . S DATA=LIST(ROW),EFTIEN=$P(DATA,U,3)"
^XMB(3.9,146037,2,3225,0)="""RTN"",""RCDPTAR1"",456,0)"
^XMB(3.9,146037,2,3226,0)=" . D DISPLAY^RCDPTAR(ROW,EFTIEN)"
^XMB(3.9,146037,2,3227,0)="""RTN"",""RCDPTAR1"",457,0)"
^XMB(3.9,146037,2,3228,0)=" . ;I ROW#5=0!(ROW=CNT) D  I Y>0!(Y=-1) S QUIT=1 Q  ;"
^XMB(3.9,146037,2,3229,0)="""RTN"",""RCDPTAR1"",458,0)"
^XMB(3.9,146037,2,3230,0)=" S Y=$$READ^RCDPTAR(1,ROW,CNT)"
^XMB(3.9,146037,2,3231,0)="""RTN"",""RCDPTAR1"",459,0)"
^XMB(3.9,146037,2,3232,0)=" I Y'>0 Q 0"
^XMB(3.9,146037,2,3233,0)="""RTN"",""RCDPTAR1"",460,0)"
^XMB(3.9,146037,2,3234,0)=" ;"
^XMB(3.9,146037,2,3235,0)="""RTN"",""RCDPTAR1"",461,0)"
^XMB(3.9,146037,2,3236,0)="EFT1 ;"
^XMB(3.9,146037,2,3237,0)="""RTN"",""RCDPTAR1"",462,0)"
^XMB(3.9,146037,2,3238,0)=" Q LIST(Y)"
^XMB(3.9,146037,2,3239,0)="""RTN"",""RCDPTAR2"")"
^XMB(3.9,146037,2,3240,0)="0^8^B23382112"
^XMB(3.9,146037,2,3241,0)="""RTN"",""RCDPTAR2"",1,0)"
^XMB(3.9,146037,2,3242,0)="RCDPTAR2 ;AITC/CJE - EFT TRANSACTION AUDIT REPORT (Continued) ;08/14/23"
^XMB(3.9,146037,2,3243,0)="""RTN"",""RCDPTAR2"",2,0)"
^XMB(3.9,146037,2,3244,0)=" ;;4.5;Accounts Receivable;**424,439,446**;Mar 20, 1995;Build 0"
^XMB(3.9,146037,2,3245,0)="""RTN"",""RCDPTAR2"",3,0)"
^XMB(3.9,146037,2,3246,0)=" ;;Per VA Directive 6402, this routine should not be modified."
^XMB(3.9,146037,2,3247,0)="""RTN"",""RCDPTAR2"",4,0)"
^XMB(3.9,146037,2,3248,0)=" ;"
^XMB(3.9,146037,2,3249,0)="""RTN"",""RCDPTAR2"",5,0)"
^XMB(3.9,146037,2,3250,0)=" Q"
^XMB(3.9,146037,2,3251,0)="""RTN"",""RCDPTAR2"",6,0)"
^XMB(3.9,146037,2,3252,0)=" ; PRCA*4.5*424 - Moved subroutine RC from ^RCDPTAR and added FMS doc ID search"
^XMB(3.9,146037,2,3253,0)="""RTN"",""RCDPTAR2"",7,0)"
^XMB(3.9,146037,2,3254,0)="RC(RCDATA) ; Lookup by Receipt Number"
^XMB(3.9,146037,2,3255,0)="""RTN"",""RCDPTAR2"",8,0)"
^XMB(3.9,146037,2,3256,0)=" ; Input:   RCDATA  - null on entry"
^XMB(3.9,146037,2,3257,0)="""RTN"",""RCDPTAR2"",9,0)"
^XMB(3.9,146037,2,3258,0)=" ;          RCDET - Environmental variable assumed to be set to ""R"" - Reciept or ""F"" - FMS Document"
^XMB(3.9,146037,2,3259,0)="""RTN"",""RCDPTAR2"",10,0)"
^XMB(3.9,146037,2,3260,0)=" ; Output:  RCDATA  - passed by refence - see subroutine EFTDATA for delimited list of fields"
^XMB(3.9,146037,2,3261,0)="""RTN"",""RCDPTAR2"",11,0)"
^XMB(3.9,146037,2,3262,0)=" ;"
^XMB(3.9,146037,2,3263,0)="""RTN"",""RCDPTAR2"",12,0)"
^XMB(3.9,146037,2,3264,0)=" N D,DIC,DTOUT,DUOUT,EFTIEN,ERAIEN,RCDTN,RCED,RCIEN,STOP,X,Y"
^XMB(3.9,146037,2,3265,0)="""RTN"",""RCDPTAR2"",13,0)"
^XMB(3.9,146037,2,3266,0)=" S STOP=0"
^XMB(3.9,146037,2,3267,0)="""RTN"",""RCDPTAR2"",14,0)"
^XMB(3.9,146037,2,3268,0)="RC2 ;"
^XMB(3.9,146037,2,3269,0)="""RTN"",""RCDPTAR2"",15,0)"
^XMB(3.9,146037,2,3270,0)=" W !"
^XMB(3.9,146037,2,3271,0)="""RTN"",""RCDPTAR2"",16,0)"
^XMB(3.9,146037,2,3272,0)=" S DIC=""^RCY(344,"""
^XMB(3.9,146037,2,3273,0)="""RTN"",""RCDPTAR2"",17,0)"
^XMB(3.9,146037,2,3274,0)=" S DIC(0)=$S(RCDET=""F"":""QEAn"",1:""QEAMn"")"
^XMB(3.9,146037,2,3275,0)="""RTN"",""RCDPTAR2"",18,0)"
^XMB(3.9,146037,2,3276,0)=" S DIC(""A"")=$S(RCDET=""F"":""Select FMS DOCUMENT NUMBER: "",1:""Select RECEIPT: "")"
^XMB(3.9,146037,2,3277,0)="""RTN"",""RCDPTAR2"",19,0)"
^XMB(3.9,146037,2,3278,0)=" S DIC(""W"")=""D DICW^RCDPUREC"""
^XMB(3.9,146037,2,3279,0)="""RTN"",""RCDPTAR2"",20,0)"
^XMB(3.9,146037,2,3280,0)=" S DIC(""S"")=""I $$EDILBEV^RCDPEU($P($G(^(0)),U,4))"""
^XMB(3.9,146037,2,3281,0)="""RTN"",""RCDPTAR2"",21,0)"
^XMB(3.9,146037,2,3282,0)=" I RCDET=""R"" D ^DIC"
^XMB(3.9,146037,2,3283,0)="""RTN"",""RCDPTAR2"",22,0)"
^XMB(3.9,146037,2,3284,0)=" I RCDET=""F"" S D=""ADOC"" D IX^DIC"
^XMB(3.9,146037,2,3285,0)="""RTN"",""RCDPTAR2"",23,0)"
^XMB(3.9,146037,2,3286,0)=" I $D(DTOUT)!$D(DUOUT)!(Y=-1) S RCDATA=-1 Q"
^XMB(3.9,146037,2,3287,0)="""RTN"",""RCDPTAR2"",24,0)"
^XMB(3.9,146037,2,3288,0)=" ;"
^XMB(3.9,146037,2,3289,0)="""RTN"",""RCDPTAR2"",25,0)"
^XMB(3.9,146037,2,3290,0)=" ; Check if there is a pointer to the AR Deposit"
^XMB(3.9,146037,2,3291,0)="""RTN"",""RCDPTAR2"",26,0)"
^XMB(3.9,146037,2,3292,0)=" S RCDATA="""""
^XMB(3.9,146037,2,3293,0)="""RTN"",""RCDPTAR2"",27,0)"
^XMB(3.9,146037,2,3294,0)=" S RCIEN=$P($G(^RCY(344,+Y,0)),U,6)"
^XMB(3.9,146037,2,3295,0)="""RTN"",""RCDPTAR2"",28,0)"
^XMB(3.9,146037,2,3296,0)=" ;"
^XMB(3.9,146037,2,3297,0)="""RTN"",""RCDPTAR2"",29,0)"
^XMB(3.9,146037,2,3298,0)=" ; If there is, then get the EFT via AR Deposit and EDI LockBox files"
^XMB(3.9,146037,2,3299,0)="""RTN"",""RCDPTAR2"",30,0)"
^XMB(3.9,146037,2,3300,0)=" I RCIEN D"
^XMB(3.9,146037,2,3301,0)="""RTN"",""RCDPTAR2"",31,0)"
^XMB(3.9,146037,2,3302,0)=" . ; Get Ticket Number"
^XMB(3.9,146037,2,3303,0)="""RTN"",""RCDPTAR2"",32,0)"
^XMB(3.9,146037,2,3304,0)=" . S RCDTN=$P($G(^RCY(344.1,RCIEN,0)),U,1)"
^XMB(3.9,146037,2,3305,0)="""RTN"",""RCDPTAR2"",33,0)"
^XMB(3.9,146037,2,3306,0)=" . I RCDTN="""" Q"
^XMB(3.9,146037,2,3307,0)="""RTN"",""RCDPTAR2"",34,0)"
^XMB(3.9,146037,2,3308,0)=" . ;"
^XMB(3.9,146037,2,3309,0)="""RTN"",""RCDPTAR2"",35,0)"
^XMB(3.9,146037,2,3310,0)=" . ; Get EDI Lockbox Deposit File"
^XMB(3.9,146037,2,3311,0)="""RTN"",""RCDPTAR2"",36,0)"
^XMB(3.9,146037,2,3312,0)=" . S RCED=$O(^RCY(344.3,""C"",RCDTN,""""))"
^XMB(3.9,146037,2,3313,0)="""RTN"",""RCDPTAR2"",37,0)"
^XMB(3.9,146037,2,3314,0)=" . I RCED="""" Q"
^XMB(3.9,146037,2,3315,0)="""RTN"",""RCDPTAR2"",38,0)"
^XMB(3.9,146037,2,3316,0)=" . S RCDATA=$$EFT^RCDPTAR(RCED)"
^XMB(3.9,146037,2,3317,0)="""RTN"",""RCDPTAR2"",39,0)"
^XMB(3.9,146037,2,3318,0)=" ;"
^XMB(3.9,146037,2,3319,0)="""RTN"",""RCDPTAR2"",40,0)"
^XMB(3.9,146037,2,3320,0)=" ; If this AR Deposit record is not found, check if it is a receipt on the ERA"
^XMB(3.9,146037,2,3321,0)="""RTN"",""RCDPTAR2"",41,0)"
^XMB(3.9,146037,2,3322,0)=" I 'RCIEN D"
^XMB(3.9,146037,2,3323,0)="""RTN"",""RCDPTAR2"",42,0)"
^XMB(3.9,146037,2,3324,0)=" . S ERAIEN=$O(^RCY(344.4,""H"",+Y,""""))"
^XMB(3.9,146037,2,3325,0)="""RTN"",""RCDPTAR2"",43,0)"
^XMB(3.9,146037,2,3326,0)=" . I 'ERAIEN S ERAIEN=$O(^RCY(344.4,""ARCT"",+Y,""""))"
^XMB(3.9,146037,2,3327,0)="""RTN"",""RCDPTAR2"",44,0)"
^XMB(3.9,146037,2,3328,0)=" . I 'ERAIEN Q"
^XMB(3.9,146037,2,3329,0)="""RTN"",""RCDPTAR2"",45,0)"
^XMB(3.9,146037,2,3330,0)=" . S EFTIEN=$O(^RCY(344.31,""AERA"",ERAIEN,""""))"
^XMB(3.9,146037,2,3331,0)="""RTN"",""RCDPTAR2"",46,0)"
^XMB(3.9,146037,2,3332,0)=" . I EFTIEN S RCDATA=$$EFTDATA^RCDPTAR(EFTIEN)"
^XMB(3.9,146037,2,3333,0)="""RTN"",""RCDPTAR2"",47,0)"
^XMB(3.9,146037,2,3334,0)=" ;"
^XMB(3.9,146037,2,3335,0)="""RTN"",""RCDPTAR2"",48,0)"
^XMB(3.9,146037,2,3336,0)=" I RCDATA="""" D  G RC2"
^XMB(3.9,146037,2,3337,0)="""RTN"",""RCDPTAR2"",49,0)"
^XMB(3.9,146037,2,3338,0)=" . W !!,""EFT NOT FOUND - please check Receipt"""
^XMB(3.9,146037,2,3339,0)="""RTN"",""RCDPTAR2"",50,0)"
^XMB(3.9,146037,2,3340,0)=" . D PAUSE^RCDPTAR"
^XMB(3.9,146037,2,3341,0)="""RTN"",""RCDPTAR2"",51,0)"
^XMB(3.9,146037,2,3342,0)=" ;"
^XMB(3.9,146037,2,3343,0)="""RTN"",""RCDPTAR2"",52,0)"
^XMB(3.9,146037,2,3344,0)=" Q:RCDATA=-1"
^XMB(3.9,146037,2,3345,0)="""RTN"",""RCDPTAR2"",53,0)"
^XMB(3.9,146037,2,3346,0)=" Q:RCDATA=""""                                    ; No EFTs found"
^XMB(3.9,146037,2,3347,0)="""RTN"",""RCDPTAR2"",54,0)"
^XMB(3.9,146037,2,3348,0)=" D SHOWONE^RCDPTAR(.STOP)                       ; Display output"
^XMB(3.9,146037,2,3349,0)="""RTN"",""RCDPTAR2"",55,0)"
^XMB(3.9,146037,2,3350,0)=" Q:STOP"
^XMB(3.9,146037,2,3351,0)="""RTN"",""RCDPTAR2"",56,0)"
^XMB(3.9,146037,2,3352,0)=" G RC2"
^XMB(3.9,146037,2,3353,0)="""RTN"",""RCDPTAR2"",57,0)"
^XMB(3.9,146037,2,3354,0)=" Q"
^XMB(3.9,146037,2,3355,0)="""RTN"",""RCDPTAR2"",58,0)"
^XMB(3.9,146037,2,3356,0)=" ;"
^XMB(3.9,146037,2,3357,0)="""RTN"",""RCDPTAR2"",59,0)"
^XMB(3.9,146037,2,3358,0)="DEPBAL(RCDIEN) ;Is the deposit total in balance with EFT amounts ; New subroutine PRCA*4.5*439"
^XMB(3.9,146037,2,3359,0)="""RTN"",""RCDPTAR2"",60,0)"
^XMB(3.9,146037,2,3360,0)=" ;"
^XMB(3.9,146037,2,3361,0)="""RTN"",""RCDPTAR2"",61,0)"
^XMB(3.9,146037,2,3362,0)=" ; If modified, also check DEPBAL^RCDPEDA4"
^XMB(3.9,146037,2,3363,0)="""RTN"",""RCDPTAR2"",62,0)"
^XMB(3.9,146037,2,3364,0)=" ; Input:   RCDIEN  - IEN for EDI LOCKBOX DEPOSIT, #344.3"
^XMB(3.9,146037,2,3365,0)="""RTN"",""RCDPTAR2"",63,0)"
^XMB(3.9,146037,2,3366,0)=" ;"
^XMB(3.9,146037,2,3367,0)="""RTN"",""RCDPTAR2"",64,0)"
^XMB(3.9,146037,2,3368,0)=" ; Output:  RCBALS, returned via function call"
^XMB(3.9,146037,2,3369,0)="""RTN"",""RCDPTAR2"",65,0)"
^XMB(3.9,146037,2,3370,0)=" ;          Piece 1 - 1 if in balance, 0 if out of balance"
^XMB(3.9,146037,2,3371,0)="""RTN"",""RCDPTAR2"",66,0)"
^XMB(3.9,146037,2,3372,0)=" ;          Piece 2 - null (no longer needed PRCA*4.5*446) Total of EFTs on the deposit"
^XMB(3.9,146037,2,3373,0)="""RTN"",""RCDPTAR2"",67,0)"
^XMB(3.9,146037,2,3374,0)=" ;          Piece 3 - Deposit Total"
^XMB(3.9,146037,2,3375,0)="""RTN"",""RCDPTAR2"",68,0)"
^XMB(3.9,146037,2,3376,0)=" ;"
^XMB(3.9,146037,2,3377,0)="""RTN"",""RCDPTAR2"",69,0)"
^XMB(3.9,146037,2,3378,0)=" ; PRCA*4.5*446, Modify sub-routine to use unbalanced flag in 344.3"
^XMB(3.9,146037,2,3379,0)="""RTN"",""RCDPTAR2"",70,0)"
^XMB(3.9,146037,2,3380,0)=" ;"
^XMB(3.9,146037,2,3381,0)="""RTN"",""RCDPTAR2"",71,0)"
^XMB(3.9,146037,2,3382,0)=" N DTOT,DEPDATA,EFTDATA,RCBALS"
^XMB(3.9,146037,2,3383,0)="""RTN"",""RCDPTAR2"",72,0)"
^XMB(3.9,146037,2,3384,0)=" S RCBALS=""0^^0"""
^XMB(3.9,146037,2,3385,0)="""RTN"",""RCDPTAR2"",73,0)"
^XMB(3.9,146037,2,3386,0)=" ;"
^XMB(3.9,146037,2,3387,0)="""RTN"",""RCDPTAR2"",74,0)"
^XMB(3.9,146037,2,3388,0)=" Q:'$G(RCDIEN) RCBALS                                           ; Error condition, IEN is missing or incorrect"
^XMB(3.9,146037,2,3389,0)="""RTN"",""RCDPTAR2"",75,0)"
^XMB(3.9,146037,2,3390,0)=" ;"
^XMB(3.9,146037,2,3391,0)="""RTN"",""RCDPTAR2"",76,0)"
^XMB(3.9,146037,2,3392,0)=" S DEPDATA=$G(^RCY(344.3,RCDIEN,0)) Q:'$L($G(DEPDATA)) RCBALS   ; Quit if zero node does not exist or has bad data"
^XMB(3.9,146037,2,3393,0)="""RTN"",""RCDPTAR2"",77,0)"
^XMB(3.9,146037,2,3394,0)=" S DTOT=$P(DEPDATA,U,8)                                         ; Get total deposit amount"
^XMB(3.9,146037,2,3395,0)="""RTN"",""RCDPTAR2"",78,0)"
^XMB(3.9,146037,2,3396,0)=" ;"
^XMB(3.9,146037,2,3397,0)="""RTN"",""RCDPTAR2"",79,0)"
^XMB(3.9,146037,2,3398,0)=" S $P(RCBALS,U,3)=DTOT"
^XMB(3.9,146037,2,3399,0)="""RTN"",""RCDPTAR2"",80,0)"
^XMB(3.9,146037,2,3400,0)=" S $P(RCBALS,U,1)='$$GET1^DIQ(344.3,RCDIEN_"","",.15,""I"")         ; Equal to 1 if inbalance, 0 otherwise"
^XMB(3.9,146037,2,3401,0)="""RTN"",""RCDPTAR2"",81,0)"
^XMB(3.9,146037,2,3402,0)=" ;"
^XMB(3.9,146037,2,3403,0)="""RTN"",""RCDPTAR2"",82,0)"
^XMB(3.9,146037,2,3404,0)=" Q RCBALS"
^XMB(3.9,146037,2,3405,0)="""RTN"",""RCDPTAR2"",83,0)"
^XMB(3.9,146037,2,3406,0)=" ;"
^XMB(3.9,146037,2,3407,0)="""RTN"",""RCDPTAR2"",84,0)"
^XMB(3.9,146037,2,3408,0)=" ;Moved ASKSUM2 from RCDPTAR to RCDPTAR2 because of space, PRCA*4.5*439"
^XMB(3.9,146037,2,3409,0)="""RTN"",""RCDPTAR2"",85,0)"
^XMB(3.9,146037,2,3410,0)="ASKSUM2() ; Ask the user if they want to display the summary report by Deposit Date"
^XMB(3.9,146037,2,3411,0)="""RTN"",""RCDPTAR2"",86,0)"
^XMB(3.9,146037,2,3412,0)=" ; or by Deposit Number"
^XMB(3.9,146037,2,3413,0)="""RTN"",""RCDPTAR2"",87,0)"
^XMB(3.9,146037,2,3414,0)=" ; Input:   None"
^XMB(3.9,146037,2,3415,0)="""RTN"",""RCDPTAR2"",88,0)"
^XMB(3.9,146037,2,3416,0)=" ; Returns: -1 - User quit or timed out"
^XMB(3.9,146037,2,3417,0)="""RTN"",""RCDPTAR2"",89,0)"
^XMB(3.9,146037,2,3418,0)=" ;           1 - Display Summary report by Deposit Date"
^XMB(3.9,146037,2,3419,0)="""RTN"",""RCDPTAR2"",90,0)"
^XMB(3.9,146037,2,3420,0)=" ;           2 - Display Summary report by Deposit Number"
^XMB(3.9,146037,2,3421,0)="""RTN"",""RCDPTAR2"",91,0)"
^XMB(3.9,146037,2,3422,0)=" N DIR,DIRUT,DIROUT,DTOUT,DUOUT,X,Y"
^XMB(3.9,146037,2,3423,0)="""RTN"",""RCDPTAR2"",92,0)"
^XMB(3.9,146037,2,3424,0)=" S DIR(0)=""SOA^EFTS:EFTS by Date;DATE:Deposit Number"""
^XMB(3.9,146037,2,3425,0)="""RTN"",""RCDPTAR2"",93,0)"
^XMB(3.9,146037,2,3426,0)=" S DIR(""A"")=""(E)FTs by Date or (D)eposit? """
^XMB(3.9,146037,2,3427,0)="""RTN"",""RCDPTAR2"",94,0)"
^XMB(3.9,146037,2,3428,0)=" S DIR(""B"")=""DEPOSIT"""
^XMB(3.9,146037,2,3429,0)="""RTN"",""RCDPTAR2"",95,0)"
^XMB(3.9,146037,2,3430,0)=" D ^DIR"
^XMB(3.9,146037,2,3431,0)="""RTN"",""RCDPTAR2"",96,0)"
^XMB(3.9,146037,2,3432,0)=" I $D(DTOUT)!$D(DUOUT) Q -1"
^XMB(3.9,146037,2,3433,0)="""RTN"",""RCDPTAR2"",97,0)"
^XMB(3.9,146037,2,3434,0)=" I $E(Y,1)=""E"" Q 1"
^XMB(3.9,146037,2,3435,0)="""RTN"",""RCDPTAR2"",98,0)"
^XMB(3.9,146037,2,3436,0)=" Q 2"
^XMB(3.9,146037,2,3437,0)="""RTN"",""RCDPTAR2"",99,0)"
^XMB(3.9,146037,2,3438,0)=" ;"
^XMB(3.9,146037,2,3439,0)="""RTN"",""RCDPTAR2"",100,0)"
^XMB(3.9,146037,2,3440,0)="  ;Moved HEADER from RCDPTAR to RCDPTAR2 because of space, PRCA*4.5*439"
^XMB(3.9,146037,2,3441,0)="""RTN"",""RCDPTAR2"",101,0)"
^XMB(3.9,146037,2,3442,0)="HEADER(RCNOW,RCPG,RCHR,RCDATA,RCDBAL) ; Print Header Section"
^XMB(3.9,146037,2,3443,0)="""RTN"",""RCDPTAR2"",102,0)"
^XMB(3.9,146037,2,3444,0)=" ; Input: RCNOW - DATE/TIME in external format"
^XMB(3.9,146037,2,3445,0)="""RTN"",""RCDPTAR2"",103,0)"
^XMB(3.9,146037,2,3446,0)=" ;        RCPG - Current page number"
^XMB(3.9,146037,2,3447,0)="""RTN"",""RCDPTAR2"",104,0)"
^XMB(3.9,146037,2,3448,0)=" ;        RCHR - Line of ""-"" to margin width"
^XMB(3.9,146037,2,3449,0)="""RTN"",""RCDPTAR2"",105,0)"
^XMB(3.9,146037,2,3450,0)=" ;        RCDATA - See subroutine EFTDA about for delimited list of fields"
^XMB(3.9,146037,2,3451,0)="""RTN"",""RCDPTAR2"",106,0)"
^XMB(3.9,146037,2,3452,0)=" ;        RCDBAL  - Piece 1: 1 if deposit is in balance, 0 otherwise   ; Add parameter PRCA*4.5*439"
^XMB(3.9,146037,2,3453,0)="""RTN"",""RCDPTAR2"",107,0)"
^XMB(3.9,146037,2,3454,0)=" ;                  Piece 2: Total of EFTs on the deposit"
^XMB(3.9,146037,2,3455,0)="""RTN"",""RCDPTAR2"",108,0)"
^XMB(3.9,146037,2,3456,0)=" ;                  Piece 3: Deposit Total"
^XMB(3.9,146037,2,3457,0)="""RTN"",""RCDPTAR2"",109,0)"
^XMB(3.9,146037,2,3458,0)=" ; Output: Write statements"
^XMB(3.9,146037,2,3459,0)="""RTN"",""RCDPTAR2"",110,0)"
^XMB(3.9,146037,2,3460,0)=" ;"
^XMB(3.9,146037,2,3461,0)="""RTN"",""RCDPTAR2"",111,0)"
^XMB(3.9,146037,2,3462,0)=" I '$L($G(RCDBAL)) S RCDBAL=1   ; if RCDBAL was not passed, set to 1 to indicate deposit is in balance  PRCA*4.5*439"
^XMB(3.9,146037,2,3463,0)="""RTN"",""RCDPTAR2"",112,0)"
^XMB(3.9,146037,2,3464,0)=" N EFTDATA,LINE"
^XMB(3.9,146037,2,3465,0)="""RTN"",""RCDPTAR2"",113,0)"
^XMB(3.9,146037,2,3466,0)=" S EFTDATA=$G(^RCY(344.31,+$P(RCDATA,U,3),0))"
^XMB(3.9,146037,2,3467,0)="""RTN"",""RCDPTAR2"",114,0)"
^XMB(3.9,146037,2,3468,0)=" ;"
^XMB(3.9,146037,2,3469,0)="""RTN"",""RCDPTAR2"",115,0)"
^XMB(3.9,146037,2,3470,0)=" W @IOF"
^XMB(3.9,146037,2,3471,0)="""RTN"",""RCDPTAR2"",116,0)"
^XMB(3.9,146037,2,3472,0)=" S RCPG=RCPG+1"
^XMB(3.9,146037,2,3473,0)="""RTN"",""RCDPTAR2"",117,0)"
^XMB(3.9,146037,2,3474,0)=" W ""EFT TRANSACTION AUDIT REPORT"""
^XMB(3.9,146037,2,3475,0)="""RTN"",""RCDPTAR2"",118,0)"
^XMB(3.9,146037,2,3476,0)=" S LINE=RCNOW_""   PAGE: ""_RCPG_"" """
^XMB(3.9,146037,2,3477,0)="""RTN"",""RCDPTAR2"",119,0)"
^XMB(3.9,146037,2,3478,0)=" W ?(IOM-$L(LINE)),LINE"
^XMB(3.9,146037,2,3479,0)="""RTN"",""RCDPTAR2"",120,0)"
^XMB(3.9,146037,2,3480,0)=" ; Added EFT line identifier nnn.nn - PRCA*4.5*326"
^XMB(3.9,146037,2,3481,0)="""RTN"",""RCDPTAR2"",121,0)"
^XMB(3.9,146037,2,3482,0)=" W !,""EFT#: "",$$AGED^RCDPTAR(+$P(RCDATA,U,3)),$$GET1^DIQ(344.31,$P(RCDATA,U,3)_"","",.01,""E""),?19,""DEPOSIT#: "",$P($G(^RCY(344.3,+$P(RCDATA,U,2),0)),U,6)"
^XMB(3.9,146037,2,3483,0)="""RTN"",""RCDPTAR2"",122,0)"
^XMB(3.9,146037,2,3484,0)=" I 'RCDBAL W ""  *UNBAL*"",?51,""EFT TOTAL AMT: ""_$S($P(EFTDATA,U,16)=""D"":""-"",1:"""")_$P(EFTDATA,U,7)  ; If Out of Balance Deposit PRCA*4.5*439"
^XMB(3.9,146037,2,3485,0)="""RTN"",""RCDPTAR2"",123,0)"
^XMB(3.9,146037,2,3486,0)=" I RCDBAL W ?42,""EFT TOTAL AMT: ""_$S($P(EFTDATA,U,16)=""D"":""-"",1:"""")_$P(EFTDATA,U,7)   ; If not Out of Balance Deposit PRCA*4.5*439"
^XMB(3.9,146037,2,3487,0)="""RTN"",""RCDPTAR2"",124,0)"
^XMB(3.9,146037,2,3488,0)=" W !,""EFT TRACE#: "",$P(EFTDATA,U,4)"
^XMB(3.9,146037,2,3489,0)="""RTN"",""RCDPTAR2"",125,0)"
^XMB(3.9,146037,2,3490,0)=" W !,""DATE RECEIVED: "",$$DATE^RCDPRU($P(EFTDATA,U,12)),?26,""PAYER/ID: ""_$P(EFTDATA,U,2)_""/""_$P(EFTDATA,U,3)"
^XMB(3.9,146037,2,3491,0)="""RTN"",""RCDPTAR2"",126,0)"
^XMB(3.9,146037,2,3492,0)=" ;"
^XMB(3.9,146037,2,3493,0)="""RTN"",""RCDPTAR2"",127,0)"
^XMB(3.9,146037,2,3494,0)=" W !,""DATE"",?10,""ACTION/DETAILS"",?51,""STATUS"""
^XMB(3.9,146037,2,3495,0)="""RTN"",""RCDPTAR2"",128,0)"
^XMB(3.9,146037,2,3496,0)=" W !,RCHR"
^XMB(3.9,146037,2,3497,0)="""RTN"",""RCDPTAR2"",129,0)"
^XMB(3.9,146037,2,3498,0)=" Q"
^XMB(3.9,146037,2,3499,0)="""RTN"",""RCDPTAR2"",130,0)"
^XMB(3.9,146037,2,3500,0)=" ;"
^XMB(3.9,146037,2,3501,0)="""RTN"",""RCDPTAR2"",131,0)"
^XMB(3.9,146037,2,3502,0)="MDATE(STATUS,EFTIEN) ; Finds the Match Date from the Match History Global for the EFT"
^XMB(3.9,146037,2,3503,0)="""RTN"",""RCDPTAR2"",132,0)"
^XMB(3.9,146037,2,3504,0)=" ; Input:   STATUS  - Internal value from the EFT MATCH STATUS field"
^XMB(3.9,146037,2,3505,0)="""RTN"",""RCDPTAR2"",133,0)"
^XMB(3.9,146037,2,3506,0)=" ;          EFTIEN  - EDI THIRD PARTY EFT DETAIL (#344.31) IEN"
^XMB(3.9,146037,2,3507,0)="""RTN"",""RCDPTAR2"",134,0)"
^XMB(3.9,146037,2,3508,0)=" ; Returns: Match Date from the MATCH STATUS HISTORY (#344.314) multiple"
^XMB(3.9,146037,2,3509,0)="""RTN"",""RCDPTAR2"",135,0)"
^XMB(3.9,146037,2,3510,0)=" ;"
^XMB(3.9,146037,2,3511,0)="""RTN"",""RCDPTAR2"",136,0)"
^XMB(3.9,146037,2,3512,0)=" ; Validate Parameters.  If STATUS is equal to UNMATCHED, quit with """" (no match date)"
^XMB(3.9,146037,2,3513,0)="""RTN"",""RCDPTAR2"",137,0)"
^XMB(3.9,146037,2,3514,0)=" I $G(STATUS)=0 Q """""
^XMB(3.9,146037,2,3515,0)="""RTN"",""RCDPTAR2"",138,0)"
^XMB(3.9,146037,2,3516,0)=" I $G(EFTIEN)="""" Q """""
^XMB(3.9,146037,2,3517,0)="""RTN"",""RCDPTAR2"",139,0)"
^XMB(3.9,146037,2,3518,0)=" ;"
^XMB(3.9,146037,2,3519,0)="""RTN"",""RCDPTAR2"",140,0)"
^XMB(3.9,146037,2,3520,0)=" N MIEN,RCDATA,IENS"
^XMB(3.9,146037,2,3521,0)="""RTN"",""RCDPTAR2"",141,0)"
^XMB(3.9,146037,2,3522,0)=" ;"
^XMB(3.9,146037,2,3523,0)="""RTN"",""RCDPTAR2"",142,0)"
^XMB(3.9,146037,2,3524,0)=" ; Get last record from the Match status history global.  If no history, then quit with """" (no match date)"
^XMB(3.9,146037,2,3525,0)="""RTN"",""RCDPTAR2"",143,0)"
^XMB(3.9,146037,2,3526,0)=" S MIEN=$O(^RCY(344.31,EFTIEN,4,999999),-1)"
^XMB(3.9,146037,2,3527,0)="""RTN"",""RCDPTAR2"",144,0)"
^XMB(3.9,146037,2,3528,0)=" I 'MIEN Q ""<No History>"""
^XMB(3.9,146037,2,3529,0)="""RTN"",""RCDPTAR2"",145,0)"
^XMB(3.9,146037,2,3530,0)=" ;"
^XMB(3.9,146037,2,3531,0)="""RTN"",""RCDPTAR2"",146,0)"
^XMB(3.9,146037,2,3532,0)=" ; Get data from match history"
^XMB(3.9,146037,2,3533,0)="""RTN"",""RCDPTAR2"",147,0)"
^XMB(3.9,146037,2,3534,0)=" S IENS=MIEN_"",""_EFTIEN_"","""
^XMB(3.9,146037,2,3535,0)="""RTN"",""RCDPTAR2"",148,0)"
^XMB(3.9,146037,2,3536,0)=" D GETS^DIQ(344.314,IENS,"".01;.02"",""I"",""RCDATA"")"
^XMB(3.9,146037,2,3537,0)="""RTN"",""RCDPTAR2"",149,0)"
^XMB(3.9,146037,2,3538,0)=" ;"
^XMB(3.9,146037,2,3539,0)="""RTN"",""RCDPTAR2"",150,0)"
^XMB(3.9,146037,2,3540,0)=" ; If the most recent record is UNMATCHED, then it is does not match the EFT status so return """" (no match date)"
^XMB(3.9,146037,2,3541,0)="""RTN"",""RCDPTAR2"",151,0)"
^XMB(3.9,146037,2,3542,0)=" I RCDATA(344.314,IENS,.01,""I"")=0 Q """""
^XMB(3.9,146037,2,3543,0)="""RTN"",""RCDPTAR2"",152,0)"
^XMB(3.9,146037,2,3544,0)=" Q RCDATA(344.314,IENS,.02,""I"")"
^XMB(3.9,146037,2,3545,0)="""RTN"",""RCDPTAR2"",153,0)"
^XMB(3.9,146037,2,3546,0)=" ;"
^XMB(3.9,146037,2,3547,0)="""RTN"",""RCTASFH"")"
^XMB(3.9,146037,2,3548,0)="1^1"
^XMB(3.9,146037,2,3549,0)="""RTN"",""RCTASFH1"")"
^XMB(3.9,146037,2,3550,0)="1^2"
^XMB(3.9,146037,2,3551,0)="""VER"")"
