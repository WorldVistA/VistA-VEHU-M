^XMB(3.9,146106,2,2991,0)="""RTN"",""SDES2DELCLNREADT"",21,0)"
^XMB(3.9,146106,2,2992,0)=" ; SDPARAM(""CLINIC IEN"")=CLINIC IEN     IEN of the clinic in file 44 - Hospital location"
^XMB(3.9,146106,2,2993,0)="""RTN"",""SDES2DELCLNREADT"",22,0)"
^XMB(3.9,146106,2,2994,0)=" ;"
^XMB(3.9,146106,2,2995,0)="""RTN"",""SDES2DELCLNREADT"",23,0)"
^XMB(3.9,146106,2,2996,0)=" ;RETURN PARMETER:"
^XMB(3.9,146106,2,2997,0)="""RTN"",""SDES2DELCLNREADT"",24,0)"
^XMB(3.9,146106,2,2998,0)=" ; Status"
^XMB(3.9,146106,2,2999,0)="""RTN"",""SDES2DELCLNREADT"",25,0)"
^XMB(3.9,146106,2,3000,0)=" ;"
^XMB(3.9,146106,2,3001,0)="""RTN"",""SDES2DELCLNREADT"",26,0)"
^XMB(3.9,146106,2,3002,0)=" N ERRORS,RESULTS"
^XMB(3.9,146106,2,3003,0)="""RTN"",""SDES2DELCLNREADT"",27,0)"
^XMB(3.9,146106,2,3004,0)=" ; Newing these variables that leak from down stream calls"
^XMB(3.9,146106,2,3005,0)="""RTN"",""SDES2DELCLNREADT"",28,0)"
^XMB(3.9,146106,2,3006,0)=" N CLIN,IEN,PROVDUZ,SDECI"
^XMB(3.9,146106,2,3007,0)="""RTN"",""SDES2DELCLNREADT"",29,0)"
^XMB(3.9,146106,2,3008,0)=" ; validate context array"
^XMB(3.9,146106,2,3009,0)="""RTN"",""SDES2DELCLNREADT"",30,0)"
^XMB(3.9,146106,2,3010,0)=" D VALCONTEXT^SDES2VALCONTEXT(.ERRORS,.SDCONTEXT)"
^XMB(3.9,146106,2,3011,0)="""RTN"",""SDES2DELCLNREADT"",31,0)"
^XMB(3.9,146106,2,3012,0)=" I $D(ERRORS) S ERRORS(""Clinic"",1)=""""  D BUILDJSON^SDES2JSON(.SDRETURN,.ERRORS) Q"
^XMB(3.9,146106,2,3013,0)="""RTN"",""SDES2DELCLNREADT"",32,0)"
^XMB(3.9,146106,2,3014,0)=" ; visitor pattern"
^XMB(3.9,146106,2,3015,0)="""RTN"",""SDES2DELCLNREADT"",33,0)"
^XMB(3.9,146106,2,3016,0)=" I $G(SDCONTEXT(""USER DUZ""))'="""" N DUZ D DUZ^XUP(SDCONTEXT(""USER DUZ""))"
^XMB(3.9,146106,2,3017,0)="""RTN"",""SDES2DELCLNREADT"",34,0)"
^XMB(3.9,146106,2,3018,0)=" D VALCLINIEN^SDES2VAL44(.ERRORS,$G(SDPARAM(""CLINIC IEN"")),1)"
^XMB(3.9,146106,2,3019,0)="""RTN"",""SDES2DELCLNREADT"",35,0)"
^XMB(3.9,146106,2,3020,0)=" I $D(ERRORS) S ERRORS(""Clinic"",1)=""""  D BUILDJSON^SDES2JSON(.SDRETURN,.ERRORS) Q"
^XMB(3.9,146106,2,3021,0)="""RTN"",""SDES2DELCLNREADT"",36,0)"
