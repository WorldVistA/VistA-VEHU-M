^XMB(3.9,146052,2,2173,0)="""RTN"",""FBSHRAD"",34,0)"
^XMB(3.9,146052,2,2174,0)=" ; ask if remarks should be printed"
^XMB(3.9,146052,2,2175,0)="""RTN"",""FBSHRAD"",35,0)"
^XMB(3.9,146052,2,2176,0)=" S DIR(0)=""Y"",DIR(""A"")=""Print authorization remarks"",DIR(""B"")=""NO"""
^XMB(3.9,146052,2,2177,0)="""RTN"",""FBSHRAD"",36,0)"
^XMB(3.9,146052,2,2178,0)=" D ^DIR K DIR G:$D(DIRUT) EXIT"
^XMB(3.9,146052,2,2179,0)="""RTN"",""FBSHRAD"",37,0)"
^XMB(3.9,146052,2,2180,0)=" S FBAR=Y"
^XMB(3.9,146052,2,2181,0)="""RTN"",""FBSHRAD"",38,0)"
^XMB(3.9,146052,2,2182,0)=" ;"
^XMB(3.9,146052,2,2183,0)="""RTN"",""FBSHRAD"",39,0)"
^XMB(3.9,146052,2,2184,0)=" ; ask device"
^XMB(3.9,146052,2,2185,0)="""RTN"",""FBSHRAD"",40,0)"
^XMB(3.9,146052,2,2186,0)=" S %ZIS=""QM"" D ^%ZIS G:POP EXIT"
^XMB(3.9,146052,2,2187,0)="""RTN"",""FBSHRAD"",41,0)"
^XMB(3.9,146052,2,2188,0)=" I $D(IO(""Q"")) D  G EXIT"
^XMB(3.9,146052,2,2189,0)="""RTN"",""FBSHRAD"",42,0)"
^XMB(3.9,146052,2,2190,0)=" . S ZTRTN=""QEN^FBSHRAD"",ZTDESC=""Active Authorizations Report"""
^XMB(3.9,146052,2,2191,0)="""RTN"",""FBSHRAD"",43,0)"
^XMB(3.9,146052,2,2192,0)=" . F FBX=""FBPROG"",""FBPOV*"",""FBDT*"",""FBAR"" S ZTSAVE(FBX)="""""
^XMB(3.9,146052,2,2193,0)="""RTN"",""FBSHRAD"",44,0)"
^XMB(3.9,146052,2,2194,0)=" . D ^%ZTLOAD,HOME^%ZIS K ZTSK"
^XMB(3.9,146052,2,2195,0)="""RTN"",""FBSHRAD"",45,0)"
^XMB(3.9,146052,2,2196,0)=" ;"
^XMB(3.9,146052,2,2197,0)="""RTN"",""FBSHRAD"",46,0)"
^XMB(3.9,146052,2,2198,0)="QEN ; queued entry"
^XMB(3.9,146052,2,2199,0)="""RTN"",""FBSHRAD"",47,0)"
^XMB(3.9,146052,2,2200,0)=" U IO"
^XMB(3.9,146052,2,2201,0)="""RTN"",""FBSHRAD"",48,0)"
^XMB(3.9,146052,2,2202,0)=" ;"
^XMB(3.9,146052,2,2203,0)="""RTN"",""FBSHRAD"",49,0)"
^XMB(3.9,146052,2,2204,0)="GATHER ; collect and sort data"
^XMB(3.9,146052,2,2205,0)="""RTN"",""FBSHRAD"",50,0)"
^XMB(3.9,146052,2,2206,0)=" K ^TMP($J)"
^XMB(3.9,146052,2,2207,0)="""RTN"",""FBSHRAD"",51,0)"
^XMB(3.9,146052,2,2208,0)=" ; loop thru Fee Basis Patients"
^XMB(3.9,146052,2,2209,0)="""RTN"",""FBSHRAD"",52,0)"
^XMB(3.9,146052,2,2210,0)=" S FBDFN=0 F  S FBDFN=$O(^FBAAA(FBDFN)) Q:'FBDFN  D"
^XMB(3.9,146052,2,2211,0)="""RTN"",""FBSHRAD"",53,0)"
^XMB(3.9,146052,2,2212,0)=" . S FBPNAME=$$GET1^DIQ(161,FBDFN,.01)"
^XMB(3.9,146052,2,2213,0)="""RTN"",""FBSHRAD"",54,0)"
^XMB(3.9,146052,2,2214,0)=" . S:FBPNAME="""" FBPNAME=""UNKNOWN"""
^XMB(3.9,146052,2,2215,0)="""RTN"",""FBSHRAD"",55,0)"
^XMB(3.9,146052,2,2216,0)=" . ; loop thru authorizations"
^XMB(3.9,146052,2,2217,0)="""RTN"",""FBSHRAD"",56,0)"
^XMB(3.9,146052,2,2218,0)=" . S FBAU=0 F  S FBAU=$O(^FBAAA(FBDFN,1,FBAU)) Q:'FBAU  D"
^XMB(3.9,146052,2,2219,0)="""RTN"",""FBSHRAD"",57,0)"
^XMB(3.9,146052,2,2220,0)=" . . S FBA=$G(^FBAAA(FBDFN,1,FBAU,0))"
^XMB(3.9,146052,2,2221,0)="""RTN"",""FBSHRAD"",58,0)"
^XMB(3.9,146052,2,2222,0)=" . . Q:$P(FBA,U,3)'=FBPROG  ; not program"
^XMB(3.9,146052,2,2223,0)="""RTN"",""FBSHRAD"",59,0)"
^XMB(3.9,146052,2,2224,0)=" . . Q:$P($G(^FBAAA(FBDFN,1,FBAU,""ADEL"")),U)  ; austin deleted"
^XMB(3.9,146052,2,2225,0)="""RTN"",""FBSHRAD"",60,0)"
^XMB(3.9,146052,2,2226,0)=" . . Q:$P(FBA,U,7)=""""  ; blank purpose of visit"
^XMB(3.9,146052,2,2227,0)="""RTN"",""FBSHRAD"",61,0)"
^XMB(3.9,146052,2,2228,0)=" . . I 'FBPOV Q:'$D(FBPOV($P(FBA,U,7)))  ; not selected POV"
^XMB(3.9,146052,2,2229,0)="""RTN"",""FBSHRAD"",62,0)"
^XMB(3.9,146052,2,2230,0)=" . . ; ensure authorization is not outside the period of interest"
^XMB(3.9,146052,2,2231,0)="""RTN"",""FBSHRAD"",63,0)"
^XMB(3.9,146052,2,2232,0)=" . . Q:$P(FBA,U)>FBDT2  ; auth from date after specified rpt end"
^XMB(3.9,146052,2,2233,0)="""RTN"",""FBSHRAD"",64,0)"
^XMB(3.9,146052,2,2234,0)=" . . Q:$P(FBA,U,2)<FBDT1  ; auth to date before specified rpt begin"
^XMB(3.9,146052,2,2235,0)="""RTN"",""FBSHRAD"",65,0)"
^XMB(3.9,146052,2,2236,0)=" . . ; passed all criteria"
^XMB(3.9,146052,2,2237,0)="""RTN"",""FBSHRAD"",66,0)"
^XMB(3.9,146052,2,2238,0)=" . . S FBVN=$S($P(FBA,U,4):$P($G(^FBAAV($P(FBA,U,4),0)),U),1:"""")"
^XMB(3.9,146052,2,2239,0)="""RTN"",""FBSHRAD"",67,0)"
^XMB(3.9,146052,2,2240,0)=" . . I FBVN="""" S FBVN=""not specified"""
^XMB(3.9,146052,2,2241,0)="""RTN"",""FBSHRAD"",68,0)"
^XMB(3.9,146052,2,2242,0)=" . . ; sort by purpose of visit,vendor,name^dfn,auth from date^auth ien"
^XMB(3.9,146052,2,2243,0)="""RTN"",""FBSHRAD"",69,0)"
^XMB(3.9,146052,2,2244,0)=" . . S ^TMP($J,$P(FBA,U,7),FBVN,FBPNAME_U_FBDFN,$P(FBA,U)_U_FBAU)=FBA"
^XMB(3.9,146052,2,2245,0)="""RTN"",""FBSHRAD"",70,0)"
^XMB(3.9,146052,2,2246,0)=" ;"
^XMB(3.9,146052,2,2247,0)="""RTN"",""FBSHRAD"",71,0)"
^XMB(3.9,146052,2,2248,0)="PRINT ; report data"
^XMB(3.9,146052,2,2249,0)="""RTN"",""FBSHRAD"",72,0)"
^XMB(3.9,146052,2,2250,0)=" S (FBQUIT,FBPG)=0 D NOW^%DTC S Y=% D DD^%DT S FBDTR=Y"
^XMB(3.9,146052,2,2251,0)="""RTN"",""FBSHRAD"",73,0)"
^XMB(3.9,146052,2,2252,0)=" K FBDL S FBDL="""",$P(FBDL,""-"",IOM)="""""
^XMB(3.9,146052,2,2253,0)="""RTN"",""FBSHRAD"",74,0)"
^XMB(3.9,146052,2,2254,0)=" ;"
^XMB(3.9,146052,2,2255,0)="""RTN"",""FBSHRAD"",75,0)"
^XMB(3.9,146052,2,2256,0)=" ; build page header text for selection criteria"
^XMB(3.9,146052,2,2257,0)="""RTN"",""FBSHRAD"",76,0)"
^XMB(3.9,146052,2,2258,0)=" K FBHDT"
^XMB(3.9,146052,2,2259,0)="""RTN"",""FBSHRAD"",77,0)"
^XMB(3.9,146052,2,2260,0)=" S FBHDT(1)=""  FROM ""_$$FMTE^XLFDT(FBDT1)_"" TO ""_$$FMTE^XLFDT(FBDT2)"
^XMB(3.9,146052,2,2261,0)="""RTN"",""FBSHRAD"",78,0)"
^XMB(3.9,146052,2,2262,0)=" S FBHDT(1)=FBHDT(1)_""  FOR THE ""_$$GET1^DIQ(161.8,FBPROG,.01)_"" PROGRAM"""
^XMB(3.9,146052,2,2263,0)="""RTN"",""FBSHRAD"",79,0)"
^XMB(3.9,146052,2,2264,0)=" S FBHDT(2)=""  FOR ""_$S(FBPOV:""ALL "",1:"""")_""PURPOSE OF VISIT(S)"""
^XMB(3.9,146052,2,2265,0)="""RTN"",""FBSHRAD"",80,0)"
^XMB(3.9,146052,2,2266,0)=" I 'FBPOV D"
^XMB(3.9,146052,2,2267,0)="""RTN"",""FBSHRAD"",81,0)"
^XMB(3.9,146052,2,2268,0)=" . S FBL=2,FBHDT(FBL)=FBHDT(FBL)_"": """
^XMB(3.9,146052,2,2269,0)="""RTN"",""FBSHRAD"",82,0)"
^XMB(3.9,146052,2,2270,0)=" . S (FBC,FBI)=0 F  S FBI=$O(FBPOV(FBI)) Q:'FBI  D"
^XMB(3.9,146052,2,2271,0)="""RTN"",""FBSHRAD"",83,0)"
^XMB(3.9,146052,2,2272,0)=" . . I $L(FBHDT(FBL))+2+$L(FBPOV(FBI))>75 D"
^XMB(3.9,146052,2,2273,0)="""RTN"",""FBSHRAD"",84,0)"
^XMB(3.9,146052,2,2274,0)=" . . . I FBC S FBHDT(FBL)=FBHDT(FBL)_"","""
^XMB(3.9,146052,2,2275,0)="""RTN"",""FBSHRAD"",85,0)"
^XMB(3.9,146052,2,2276,0)=" . . . S FBL=FBL+1"
^XMB(3.9,146052,2,2277,0)="""RTN"",""FBSHRAD"",86,0)"
^XMB(3.9,146052,2,2278,0)=" . . . S FBC=0,FBHDT(FBL)=""    """
^XMB(3.9,146052,2,2279,0)="""RTN"",""FBSHRAD"",87,0)"
^XMB(3.9,146052,2,2280,0)=" . . S FBHDT(FBL)=FBHDT(FBL)_$S(FBC:"", "",1:"""")_FBPOV(FBI)"
^XMB(3.9,146052,2,2281,0)="""RTN"",""FBSHRAD"",88,0)"
^XMB(3.9,146052,2,2282,0)=" . . S FBC=FBC+1 ; count of POVs on current line (FBL)"
^XMB(3.9,146052,2,2283,0)="""RTN"",""FBSHRAD"",89,0)"
^XMB(3.9,146052,2,2284,0)=" ;"
^XMB(3.9,146052,2,2285,0)="""RTN"",""FBSHRAD"",90,0)"
^XMB(3.9,146052,2,2286,0)=" ; determine if DAYS column should be displayed (true/false)"
^XMB(3.9,146052,2,2287,0)="""RTN"",""FBSHRAD"",91,0)"
^XMB(3.9,146052,2,2288,0)=" S FBDD=$$GET1^DIQ(161.8,FBPROG,.01)=""STATE HOME"""
^XMB(3.9,146052,2,2289,0)="""RTN"",""FBSHRAD"",92,0)"
^XMB(3.9,146052,2,2290,0)=" ;"
^XMB(3.9,146052,2,2291,0)="""RTN"",""FBSHRAD"",93,0)"
^XMB(3.9,146052,2,2292,0)=" D HD"
^XMB(3.9,146052,2,2293,0)="""RTN"",""FBSHRAD"",94,0)"
^XMB(3.9,146052,2,2294,0)=" I '$D(^TMP($J)) W !,""No active authorizations found during period."""
^XMB(3.9,146052,2,2295,0)="""RTN"",""FBSHRAD"",95,0)"
^XMB(3.9,146052,2,2296,0)=" S FBC(""TOT"")=0 ; initialize count of authorizations on report"
^XMB(3.9,146052,2,2297,0)="""RTN"",""FBSHRAD"",96,0)"
^XMB(3.9,146052,2,2298,0)=" ; loop thru purpose of visit"
^XMB(3.9,146052,2,2299,0)="""RTN"",""FBSHRAD"",97,0)"
^XMB(3.9,146052,2,2300,0)=" S FBPOV=0 F  S FBPOV=$O(^TMP($J,FBPOV)) Q:'FBPOV  D  Q:FBQUIT"
^XMB(3.9,146052,2,2301,0)="""RTN"",""FBSHRAD"",98,0)"
^XMB(3.9,146052,2,2302,0)=" . S FBPOV(""E"")=$$GET1^DIQ(161.82,FBPOV,.01)"
^XMB(3.9,146052,2,2303,0)="""RTN"",""FBSHRAD"",99,0)"
^XMB(3.9,146052,2,2304,0)=" . I $Y+9>IOSL D HD Q:FBQUIT"
^XMB(3.9,146052,2,2305,0)="""RTN"",""FBSHRAD"",100,0)"
^XMB(3.9,146052,2,2306,0)=" . W !!,""POV: "",FBPOV(""E"")"
^XMB(3.9,146052,2,2307,0)="""RTN"",""FBSHRAD"",101,0)"
^XMB(3.9,146052,2,2308,0)=" . S FBC(""POV"")=0 ; initialize count of authorizations for POV"
^XMB(3.9,146052,2,2309,0)="""RTN"",""FBSHRAD"",102,0)"
^XMB(3.9,146052,2,2310,0)=" . S:FBDD FBD(""POV"")=0 ; initialize count of days for POV"
^XMB(3.9,146052,2,2311,0)="""RTN"",""FBSHRAD"",103,0)"
^XMB(3.9,146052,2,2312,0)=" . ; loop thru vendors"
^XMB(3.9,146052,2,2313,0)="""RTN"",""FBSHRAD"",104,0)"
^XMB(3.9,146052,2,2314,0)=" . S FBVN="""" F  S FBVN=$O(^TMP($J,FBPOV,FBVN)) Q:FBVN=""""  D  Q:FBQUIT"
^XMB(3.9,146052,2,2315,0)="""RTN"",""FBSHRAD"",105,0)"
^XMB(3.9,146052,2,2316,0)=" . . I $Y+7>IOSL D HD Q:FBQUIT  D HDPOV"
^XMB(3.9,146052,2,2317,0)="""RTN"",""FBSHRAD"",106,0)"
^XMB(3.9,146052,2,2318,0)=" . . W !!,""  Vendor: "",FBVN,!"
^XMB(3.9,146052,2,2319,0)="""RTN"",""FBSHRAD"",107,0)"
^XMB(3.9,146052,2,2320,0)=" . . S FBC(""VEN"")=0 ; initialize count of auth for vendor (in POV)"
^XMB(3.9,146052,2,2321,0)="""RTN"",""FBSHRAD"",108,0)"
^XMB(3.9,146052,2,2322,0)=" . . S:FBDD FBD(""VEN"")=0 ; initialize count of days for vendor (in POV)"
^XMB(3.9,146052,2,2323,0)="""RTN"",""FBSHRAD"",109,0)"
^XMB(3.9,146052,2,2324,0)=" . . ; loop thru veterans"
^XMB(3.9,146052,2,2325,0)="""RTN"",""FBSHRAD"",110,0)"
^XMB(3.9,146052,2,2326,0)=" . . S FBPAT="""""
^XMB(3.9,146052,2,2327,0)="""RTN"",""FBSHRAD"",111,0)"
^XMB(3.9,146052,2,2328,0)=" . . F  S FBPAT=$O(^TMP($J,FBPOV,FBVN,FBPAT)) Q:FBPAT=""""  D  Q:FBQUIT"
^XMB(3.9,146052,2,2329,0)="""RTN"",""FBSHRAD"",112,0)"
^XMB(3.9,146052,2,2330,0)=" . . . S FBPNAME=$P(FBPAT,U)"
^XMB(3.9,146052,2,2331,0)="""RTN"",""FBSHRAD"",113,0)"
^XMB(3.9,146052,2,2332,0)=" . . . S FBDFN=$P(FBPAT,U,2)"
^XMB(3.9,146052,2,2333,0)="""RTN"",""FBSHRAD"",114,0)"
^XMB(3.9,146052,2,2334,0)=" . . . S DFN=FBDFN D DEM^VADPT ; obtain patient demographics"
^XMB(3.9,146052,2,2335,0)="""RTN"",""FBSHRAD"",115,0)"
^XMB(3.9,146052,2,2336,0)=" . . . ; loop thru authorizations"
^XMB(3.9,146052,2,2337,0)="""RTN"",""FBSHRAD"",116,0)"
^XMB(3.9,146052,2,2338,0)=" . . . S FBAUT="""""
^XMB(3.9,146052,2,2339,0)="""RTN"",""FBSHRAD"",117,0)"
^XMB(3.9,146052,2,2340,0)=" . . . F  S FBAUT=$O(^TMP($J,FBPOV,FBVN,FBPAT,FBAUT)) Q:FBAUT=""""  D  Q:FBQUIT"
^XMB(3.9,146052,2,2341,0)="""RTN"",""FBSHRAD"",118,0)"
^XMB(3.9,146052,2,2342,0)=" . . . . S FBDTF=$P(FBAUT,U)"
^XMB(3.9,146052,2,2343,0)="""RTN"",""FBSHRAD"",119,0)"
^XMB(3.9,146052,2,2344,0)=" . . . . S FBAU=$P(FBAUT,U,2)"
^XMB(3.9,146052,2,2345,0)="""RTN"",""FBSHRAD"",120,0)"
^XMB(3.9,146052,2,2346,0)=" . . . . S FBA=^TMP($J,FBPOV,FBVN,FBPAT,FBAUT)"
^XMB(3.9,146052,2,2347,0)="""RTN"",""FBSHRAD"",121,0)"
^XMB(3.9,146052,2,2348,0)=" . . . . S:FBDD FBDAYS=$$DOC^FBSHUTL($P(FBA,U),$P(FBA,U,2),FBDT1,FBDT2)"
^XMB(3.9,146052,2,2349,0)="""RTN"",""FBSHRAD"",122,0)"
^XMB(3.9,146052,2,2350,0)=" . . . . S FBC(""VEN"")=FBC(""VEN"")+1"
^XMB(3.9,146052,2,2351,0)="""RTN"",""FBSHRAD"",123,0)"
^XMB(3.9,146052,2,2352,0)=" . . . . S:FBDD FBD(""VEN"")=FBD(""VEN"")+FBDAYS"
^XMB(3.9,146052,2,2353,0)="""RTN"",""FBSHRAD"",124,0)"
^XMB(3.9,146052,2,2354,0)=" . . . . I $Y+5>IOSL D HD Q:FBQUIT  D HDPOV,HDVEN"
^XMB(3.9,146052,2,2355,0)="""RTN"",""FBSHRAD"",125,0)"
^XMB(3.9,146052,2,2356,0)=" . . . . W !,?4,FBPNAME,?35,$P(VADM(2),U,2)"
^XMB(3.9,146052,2,2357,0)="""RTN"",""FBSHRAD"",126,0)"
^XMB(3.9,146052,2,2358,0)=" . . . . W:FBDD ?48,$J(FBDAYS,3)"
^XMB(3.9,146052,2,2359,0)="""RTN"",""FBSHRAD"",127,0)"
^XMB(3.9,146052,2,2360,0)=" . . . . W ?53,$$FMTE^XLFDT($P(FBA,U)),?67,$$FMTE^XLFDT($P(FBA,U,2))"
^XMB(3.9,146052,2,2361,0)="""RTN"",""FBSHRAD"",128,0)"
^XMB(3.9,146052,2,2362,0)=" . . . . W !,?6,""DOB: "",$P(VADM(3),U,2)"
^XMB(3.9,146052,2,2363,0)="""RTN"",""FBSHRAD"",129,0)"
^XMB(3.9,146052,2,2364,0)=" . . . . I +VADM(6) W ?25,""*** Patient Died on "",$P(VADM(6),U,2)"
^XMB(3.9,146052,2,2365,0)="""RTN"",""FBSHRAD"",130,0)"
^XMB(3.9,146052,2,2366,0)=" . . . . ; print remarks (optional)"
^XMB(3.9,146052,2,2367,0)="""RTN"",""FBSHRAD"",131,0)"
^XMB(3.9,146052,2,2368,0)=" . . . . I $G(FBAR),$O(^FBAAA(FBDFN,1,FBAU,2,0)) D"
^XMB(3.9,146052,2,2369,0)="""RTN"",""FBSHRAD"",132,0)"
^XMB(3.9,146052,2,2370,0)=" . . . . . N DIWL,DIWR,DIWF,FBRR"
^XMB(3.9,146052,2,2371,0)="""RTN"",""FBSHRAD"",133,0)"
^XMB(3.9,146052,2,2372,0)=" . . . . . K ^UTILITY($J,""W"") S DIWL=7,DIWR=(IOM-5),DIWF=""W"""
^XMB(3.9,146052,2,2373,0)="""RTN"",""FBSHRAD"",134,0)"
^XMB(3.9,146052,2,2374,0)=" . . . . . S X=""REMARKS: "",FBRR=0"
