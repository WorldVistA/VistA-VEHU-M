^XMB(3.9,146039,2,3234,0)="SDES2UNDOCHKOUT ;ALB/ANU/TJB,MCB,MCB,AGW,JDJ - VISTA SCHEDULING RPCS - SDES2 UNDO CHECKOUT ;MAY 22,2026"
