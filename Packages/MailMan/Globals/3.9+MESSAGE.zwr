^XMB(3.9,146036,2,2106,0)=" ..;CAPRI-23078 10/20/25 CGP Correcting XML IEN"
^XMB(3.9,146036,2,2107,0)="""RTN"",""DVBCTXML"",31,0)"
^XMB(3.9,146036,2,2108,0)=" ..S DVBEXIEN="""" F  S DVBEXIEN=$O(^DVB(396.17,DVBIEN,14,""B"",DVBEXIEN)) Q:DVBEXIEN=""""  D"
^XMB(3.9,146036,2,2109,0)="""RTN"",""DVBCTXML"",32,0)"
^XMB(3.9,146036,2,2110,0)=" ...S DVBCT="""" S DVBCT=$O(^DVB(396.17,DVBIEN,14,""B"",DVBEXIEN,DVBCT)) Q:DVBCT="""""
