^XMB(3.9,146090,2,731,0)="""RTN"",""PSOSPML4"",246,0)"
^XMB(3.9,146090,2,732,0)=" ;"
^XMB(3.9,146090,2,733,0)="""RTN"",""PSOSPML4"",247,0)"
