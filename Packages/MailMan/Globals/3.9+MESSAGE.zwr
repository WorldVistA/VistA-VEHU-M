^XMB(3.9,146047,2,3130,0)=" ;"
^XMB(3.9,146047,2,3131,0)="""RTN"",""IBJPI"",80,0)"
^XMB(3.9,146047,2,3132,0)=" ;IB*771/TAZ - Completely restructured the section"
