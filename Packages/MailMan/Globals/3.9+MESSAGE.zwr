^XMB(3.9,146056,2,2541,0)="""RTN"",""VPRSDAP"",130,0)"
^XMB(3.9,146056,2,2542,0)="SIG(IEN) ; -- return Sig, append VPRPI if needed"
^XMB(3.9,146056,2,2543,0)="""RTN"",""VPRSDAP"",131,0)"
^XMB(3.9,146056,2,2544,0)=" N Y S Y=$$WP^VPRSDAOR(+$G(IEN),""SIG"")"
^XMB(3.9,146056,2,2545,0)="""RTN"",""VPRSDAP"",132,0)"
^XMB(3.9,146056,2,2546,0)=" I $L(Y),$L($G(VPRPI)),Y'[VPRPI D  ;append PI?"
^XMB(3.9,146056,2,2547,0)="""RTN"",""VPRSDAP"",133,0)"
^XMB(3.9,146056,2,2548,0)=" . N SIG,PI S SIG=$$UP^XLFSTR(Y)"
^XMB(3.9,146056,2,2549,0)="""RTN"",""VPRSDAP"",134,0)"
^XMB(3.9,146056,2,2550,0)=" . S PI=$$UP^XLFSTR(VPRPI),PI=$$TRIM^XLFSTR(PI) Q:SIG[PI"
^XMB(3.9,146056,2,2551,0)="""RTN"",""VPRSDAP"",135,0)"
^XMB(3.9,146056,2,2552,0)=" . S Y=SIG_$S($E(Y,$L(Y))="" "":"""",1:"" "")_PI"
