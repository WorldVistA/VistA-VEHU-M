^XMB(3.9,146087,2,500,0)=" S YSIEN=YSIEN_"","""
^XMB(3.9,146087,2,501,0)="""RTN"",""YTQAPI1"",78,0)"
^XMB(3.9,146087,2,502,0)=" S YSF=$G(YS(""FIELD"")) S X=$$VFIELD^DILFD(YSFILEN,YSF) I X=0 S YSDATA(1)=""[ERROR]"",YSDATA(2)=""BAD FIELD #"" Q  ;-->out"
^XMB(3.9,146087,2,503,0)="""RTN"",""YTQAPI1"",79,0)"
^XMB(3.9,146087,2,504,0)=" S N=0 F  S N=$O(YS(N)) Q:N'>0  D"
^XMB(3.9,146087,2,505,0)="""RTN"",""YTQAPI1"",80,0)"
^XMB(3.9,146087,2,506,0)=" . S ^TMP(""YSMHI"",$J,N)=$G(YS(N))"
^XMB(3.9,146087,2,507,0)="""RTN"",""YTQAPI1"",81,0)"
^XMB(3.9,146087,2,508,0)=" D WP^DIE(YSFILEN,YSIEN,YSF,,""^TMP(""""YSMHI"""",$J)"",""YSERR"")"
^XMB(3.9,146087,2,509,0)="""RTN"",""YTQAPI1"",82,0)"
^XMB(3.9,146087,2,510,0)=" I $D(YSERR) S YSDATA(1)=""[ERROR]"",YSDATA(2)=""very BAD Update Error"" Q  ;-->out"
^XMB(3.9,146087,2,511,0)="""RTN"",""YTQAPI1"",83,0)"
