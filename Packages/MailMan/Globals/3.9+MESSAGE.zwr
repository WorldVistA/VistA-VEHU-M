^XMB(3.9,146018,2,770,0)=" . I DGFLD=""ASKREQID"" N DPTIDS M DPTIDS=DGFLDS D ASKREQID(.DGNAME,.DPTIDS) M:'$D(DUOUT) DGFLDS=DPTIDS Q"
^XMB(3.9,146018,2,771,0)="""RTN"",""DPTLK7"",262,0)"
^XMB(3.9,146018,2,772,0)=" . S DIR(0)=""2,""_DGFLD_$S(DGFLD=.03:"""",DGFLD=.02:"""",1:""O"")"
