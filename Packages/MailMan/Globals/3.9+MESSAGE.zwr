^XMB(3.9,146110,2,22,0)="    (CMOP H0527)             HEPATITIS B VACCINE (RECOMBINANT) 2MCG/ML INJ"
^XMB(3.9,146110,2,23,0)="    STRENGTH: 20UNITS: MCG/ML"
^XMB(3.9,146110,2,24,0)="    POSSIBLE DOSES"
^XMB(3.9,146110,2,25,0)="    DISP UNITS/DOSE     DOSE    PACKAGE   BCMA UNITS/DOSE"
^XMB(3.9,146110,2,26,0)="       1                  20      I       "
^XMB(3.9,146110,2,27,0)="       2                  40      I       "
^XMB(3.9,146110,2,28,0)=" "
^XMB(3.9,146110,2,29,0)="The following investigational entries in your DRUG file (#50) have been "
^XMB(3.9,146110,2,30,0)="unmatched from the National Drug File (NDF).  The VA Product name and CMOP ID"
^XMB(3.9,146110,2,31,0)="corresponding to the unmatched local drug file name are listed on the"
^XMB(3.9,146110,2,32,0)="indented line beneath each entry.  An Inactivation Date may be listed for"
^XMB(3.9,146110,2,33,0)="entries when this reason applies.  Until you rematch these entries to NDF,"
^XMB(3.9,146110,2,34,0)="they will not transmit to CMOP and drug-drug interaction checks will not"
^XMB(3.9,146110,2,35,0)="check for these products.  It is critical that you rematch these products"
^XMB(3.9,146110,2,36,0)="immediately.  You may also need to match a new orderable item.  Any possible"
^XMB(3.9,146110,2,37,0)="dosages and local possible dosages for these unmatched products have been"
^XMB(3.9,146110,2,38,0)="deleted. Therefore, the dosages for each unmatched product should be reviewed"
^XMB(3.9,146110,2,39,0)="after the rematch or recreated if the product can not be rematched to a VA"
^XMB(3.9,146110,2,40,0)="Product through the NDF matching process.  "
^XMB(3.9,146110,2,41,0)=" "
