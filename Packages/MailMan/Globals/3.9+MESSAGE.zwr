^XMB(3.9,146056,2,695,0)="""KRN"",1.5,42,19,0)"
^XMB(3.9,146056,2,696,0)="^^5^5^3230906^"
^XMB(3.9,146056,2,697,0)="""KRN"",1.5,42,19,1,0)"
^XMB(3.9,146056,2,698,0)="This entity supports VPR VITAL MEASUREMENT. It expects a pointer to the"
^XMB(3.9,146056,2,699,0)="""KRN"",1.5,42,19,2,0)"
^XMB(3.9,146056,2,700,0)="GMRV VITAL TYPE (#120.51) file and returns a coded element. If a"
