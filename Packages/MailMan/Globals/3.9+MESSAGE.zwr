^XMB(3.9,146056,2,2262,0)=" Q"
^XMB(3.9,146056,2,2263,0)="""RTN"",""VPRSDAHX"",58,0)"
^XMB(3.9,146056,2,2264,0)=" ;"
^XMB(3.9,146056,2,2265,0)="""RTN"",""VPRSDAHX"",59,0)"
^XMB(3.9,146056,2,2266,0)="WVPL1(IEN) ; -- set up pregnancy API array (IEN will be DFN)"
^XMB(3.9,146056,2,2267,0)="""RTN"",""VPRSDAHX"",60,0)"
^XMB(3.9,146056,2,2268,0)=" ; Returns VPRPREG array to entity"
