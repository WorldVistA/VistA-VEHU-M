^XMB(3.9,146087,2,737,0)="""RTN"",""YTQRCDB"",49,0)"
^XMB(3.9,146087,2,738,0)=" . S YSTSC3=$G(SCORES(I,""tscore3""))"
^XMB(3.9,146087,2,739,0)="""RTN"",""YTQRCDB"",50,0)"
^XMB(3.9,146087,2,740,0)=" . I YSRAW'="""",(+YSRAW'=YSRAW) S YSRAW=""""""""_YSRAW_""""""""  ;String result"
^XMB(3.9,146087,2,741,0)="""RTN"",""YTQRCDB"",51,0)"
^XMB(3.9,146087,2,742,0)=" . I YSRAW="""" S YSRAW=""null"""
^XMB(3.9,146087,2,743,0)="""RTN"",""YTQRCDB"",52,0)"
^XMB(3.9,146087,2,744,0)=" . I YSTSC'="""",(+YSTSC'=YSTSC) S YSTSC=""""""""_YSTSC_""""""""  ;String result"
^XMB(3.9,146087,2,745,0)="""RTN"",""YTQRCDB"",53,0)"
^XMB(3.9,146087,2,746,0)=" . I YSTSC="""",$D(SCORES(I,""tscore"")) S YSTSC=""null""  ;Must exist but be null, otherwise don't send tscore at all"
