^XMB(3.9,146037,2,2290,0)=" ; D = 1 if dollar amt"
^XMB(3.9,146037,2,2291,0)="""RTN"",""RCDPESR9"",210,0)"
^XMB(3.9,146037,2,2292,0)=" N Z"
^XMB(3.9,146037,2,2293,0)="""RTN"",""RCDPESR9"",211,0)"
^XMB(3.9,146037,2,2294,0)=" I X[""."" S Z=$P(X,"".""),X=+Z_"".""_$P(X,""."",2)"
^XMB(3.9,146037,2,2295,0)="""RTN"",""RCDPESR9"",212,0)"
^XMB(3.9,146037,2,2296,0)=" I X'[""."" D"
^XMB(3.9,146037,2,2297,0)="""RTN"",""RCDPESR9"",213,0)"
^XMB(3.9,146037,2,2298,0)=" . I $G(D) S X=+$E(X,1,$L(X)-2)_"".""_$E(X,$L(X)-1,$L(X))"
^XMB(3.9,146037,2,2299,0)="""RTN"",""RCDPESR9"",214,0)"
^XMB(3.9,146037,2,2300,0)=" . S X=$S('$G(D):+X,1:$J(X,"""",2))"
^XMB(3.9,146037,2,2301,0)="""RTN"",""RCDPESR9"",215,0)"
^XMB(3.9,146037,2,2302,0)=" Q $S(X:X,$G(NULL):"""",1:X)"
^XMB(3.9,146037,2,2303,0)="""RTN"",""RCDPESR9"",216,0)"
^XMB(3.9,146037,2,2304,0)=" ;"
^XMB(3.9,146037,2,2305,0)="""RTN"",""RCDPESR9"",217,0)"
^XMB(3.9,146037,2,2306,0)="YN(X) ; Returns YES for X=""Y"" and NO for X=""N"""
