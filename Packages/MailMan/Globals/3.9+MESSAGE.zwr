^XMB(3.9,146011,2,247,0)="""RTN"",""PSOCMOPA"")"
^XMB(3.9,146011,2,248,0)="0^3^B22326197"
^XMB(3.9,146011,2,249,0)="""RTN"",""PSOCMOPA"",1,0)"
^XMB(3.9,146011,2,250,0)="PSOCMOPA ;BIR/HTW-Utility for Hold/Can/Park ;Feb 07, 2019@06:29:42"
^XMB(3.9,146011,2,251,0)="""RTN"",""PSOCMOPA"",2,0)"
^XMB(3.9,146011,2,252,0)=" ;;7.0;OUTPATIENT PHARMACY;**61,76,443,508,441,768**;DEC 1997;Build 0"
^XMB(3.9,146011,2,253,0)="""RTN"",""PSOCMOPA"",3,0)"
^XMB(3.9,146011,2,254,0)=" ;External Referrence to file # 550.2 granted by DBIA 2231"
^XMB(3.9,146011,2,255,0)="""RTN"",""PSOCMOPA"",4,0)"
^XMB(3.9,146011,2,256,0)=" ;Required input:  DA - internal entry # -  ^PSRX"
^XMB(3.9,146011,2,257,0)="""RTN"",""PSOCMOPA"",5,0)"
^XMB(3.9,146011,2,258,0)=" ;Returns:"
^XMB(3.9,146011,2,259,0)="""RTN"",""PSOCMOPA"",6,0)"
^XMB(3.9,146011,2,260,0)=" ;CMOP(""L"")=LAST FILL... if it is orig Rx =0"
^XMB(3.9,146011,2,261,0)="""RTN"",""PSOCMOPA"",7,0)"
^XMB(3.9,146011,2,262,0)=" ;CMOP(FILL #)=CMOP status from 52...Trans/0,DISP/1,RETRAN/2,NOT DISP/3"
^XMB(3.9,146011,2,263,0)="""RTN"",""PSOCMOPA"",8,0)"
^XMB(3.9,146011,2,264,0)=" ;If suspended CMOP(""S"")=CMOP suspense status Q,L,X,P,R"
^XMB(3.9,146011,2,265,0)="""RTN"",""PSOCMOPA"",9,0)"
^XMB(3.9,146011,2,266,0)=" ;PSOCMOP=STATUS_^_TRAN DATE_^_LAST FILL"
^XMB(3.9,146011,2,267,0)="""RTN"",""PSOCMOPA"",10,0)"
^XMB(3.9,146011,2,268,0)=" ;All returned variables can be killed by K CMOP,PSOCMOP"
^XMB(3.9,146011,2,269,0)="""RTN"",""PSOCMOPA"",11,0)"
^XMB(3.9,146011,2,270,0)=" ;"
^XMB(3.9,146011,2,271,0)="""RTN"",""PSOCMOPA"",12,0)"
^XMB(3.9,146011,2,272,0)=" N X,XN,BATCH,TDT,BIEN"
^XMB(3.9,146011,2,273,0)="""RTN"",""PSOCMOPA"",13,0)"
^XMB(3.9,146011,2,274,0)=" K PSOCMOP"
^XMB(3.9,146011,2,275,0)="""RTN"",""PSOCMOPA"",14,0)"
^XMB(3.9,146011,2,276,0)=" S (CMOP(""L""),X)=0  F  S X=$O(^PSRX(DA,1,X)) Q:'X  S CMOP(""L"")=X"
^XMB(3.9,146011,2,277,0)="""RTN"",""PSOCMOPA"",15,0)"
^XMB(3.9,146011,2,278,0)=" ;PSO*7*768 QUIT IF THE FILL IS NOT CMOP"
^XMB(3.9,146011,2,279,0)="""RTN"",""PSOCMOPA"",16,0)"
^XMB(3.9,146011,2,280,0)=" I CMOP(""L"")>0,$P(^PSRX(DA,1,CMOP(""L""),0),U,2)'=""M"" Q"
^XMB(3.9,146011,2,281,0)="""RTN"",""PSOCMOPA"",17,0)"
^XMB(3.9,146011,2,282,0)=" I $O(^PSRX(DA,4,0)) F X=0:0 S X=$O(^PSRX(DA,4,X)) Q:'X  D"
^XMB(3.9,146011,2,283,0)="""RTN"",""PSOCMOPA"",18,0)"
^XMB(3.9,146011,2,284,0)=" .S XN=$G(^PSRX(DA,4,X,0)),BATCH=$P($G(XN),""^"") Q:$G(BATCH)']"""""
^XMB(3.9,146011,2,285,0)="""RTN"",""PSOCMOPA"",19,0)"
^XMB(3.9,146011,2,286,0)=" .S BIEN=$O(^PSX(550.2,""B"",BATCH,"""")) Q:$G(BIEN)']""""  S TDT=$P(^PSX(550.2,BIEN,0),""^"",6)"
^XMB(3.9,146011,2,287,0)="""RTN"",""PSOCMOPA"",20,0)"
^XMB(3.9,146011,2,288,0)=" .S CMOP($P($G(XN),""^"",3))=$P($G(XN),""^"",4),PSOCMOP=$P($G(XN),""^"",4)_""^""_$G(TDT)_""^""_CMOP(""L"")"
^XMB(3.9,146011,2,289,0)="""RTN"",""PSOCMOPA"",21,0)"
^XMB(3.9,146011,2,290,0)=" S X=$O(^PS(52.5,""B"",DA,0)) I X]"""" S CMOP(""S"")=$P($G(^PS(52.5,X,0)),""^"",7),CMOP(""52.5"")=X"
^XMB(3.9,146011,2,291,0)="""RTN"",""PSOCMOPA"",22,0)"
^XMB(3.9,146011,2,292,0)=" K X,XN,BATCH,TDT,BIEN"
^XMB(3.9,146011,2,293,0)="""RTN"",""PSOCMOPA"",23,0)"
^XMB(3.9,146011,2,294,0)=" Q"
^XMB(3.9,146011,2,295,0)="""RTN"",""PSOCMOPA"",24,0)"
^XMB(3.9,146011,2,296,0)="UNHOLD N FDT S FDT=PSORX(""FILL DATE""),XFROM=""UNHOLD"" G EN1"
^XMB(3.9,146011,2,297,0)="""RTN"",""PSOCMOPA"",25,0)"
^XMB(3.9,146011,2,298,0)="UNPARK N FDT S FDT=PSORX(""FILL DATE""),XFROM=""UNPARK"" G EN1   ;441 PAPI"
^XMB(3.9,146011,2,299,0)="""RTN"",""PSOCMOPA"",26,0)"
^XMB(3.9,146011,2,300,0)="REINS S XFROM=""REINSTATE"""
^XMB(3.9,146011,2,301,0)="""RTN"",""PSOCMOPA"",27,0)"
^XMB(3.9,146011,2,302,0)="EN1 D SUS1^PSOCMOP I '$G(XFLAG) G KILL"
^XMB(3.9,146011,2,303,0)="""RTN"",""PSOCMOPA"",28,0)"
^XMB(3.9,146011,2,304,0)=" D PSOCMOPA"
^XMB(3.9,146011,2,305,0)="""RTN"",""PSOCMOPA"",29,0)"
^XMB(3.9,146011,2,306,0)=" I $G(REL)]""""!($G(CMOP(CMOP(""L"")))=0)!($G(CMOP(CMOP(""L"")))=2) D  G KILL"
^XMB(3.9,146011,2,307,0)="""RTN"",""PSOCMOPA"",30,0)"
^XMB(3.9,146011,2,308,0)=" .I XFROM=""REINSTATE"" W !!,RX_"" REINSTATED -- "",! Q"
^XMB(3.9,146011,2,309,0)="""RTN"",""PSOCMOPA"",31,0)"
^XMB(3.9,146011,2,310,0)=" .I XFROM=""UNHOLD"" W !!,$P(^PSRX(DA,0),""^"")_"" Removed from Hold Status"",!!"
^XMB(3.9,146011,2,311,0)="""RTN"",""PSOCMOPA"",32,0)"
^XMB(3.9,146011,2,312,0)=" .I XFROM=""UNPARK"" W !!,$P(^PSRX(DA,0),""^"")_"" Removed from Park Status"",!!  ;441 PAPI"
^XMB(3.9,146011,2,313,0)="""RTN"",""PSOCMOPA"",33,0)"
^XMB(3.9,146011,2,314,0)=" I $G(CMOP(CMOP(""L"")))']"""" D S^PSOCMOP G KILL"
^XMB(3.9,146011,2,315,0)="""RTN"",""PSOCMOPA"",34,0)"
^XMB(3.9,146011,2,316,0)=" I $G(CMOP(CMOP(""L"")))=3,(FDT>DT) D S^PSOCMOP G KILL"
^XMB(3.9,146011,2,317,0)="""RTN"",""PSOCMOPA"",35,0)"
^XMB(3.9,146011,2,318,0)="KILL D D1^PSOCMOP"
^XMB(3.9,146011,2,319,0)="""RTN"",""PSOCMOPA"",36,0)"
^XMB(3.9,146011,2,320,0)=" K CMOP,DIR,X,DIRUT,DUOUT,Y,DTOUT,XFROM"
^XMB(3.9,146011,2,321,0)="""RTN"",""PSOCMOPA"",37,0)"
^XMB(3.9,146011,2,322,0)=" Q"
^XMB(3.9,146011,2,323,0)="""RTN"",""PSOCMOPA"",38,0)"
^XMB(3.9,146011,2,324,0)=" ;"
^XMB(3.9,146011,2,325,0)="""RTN"",""PSOCMOPA"",39,0)"
^XMB(3.9,146011,2,326,0)="QS W !! S DIR(""A"")=""LABEL: QUEUE""_$S($P(PSOPAR,""^"",24):""/SUSPEND"",1:"""")_"" or '^' to bypass """
^XMB(3.9,146011,2,327,0)="""RTN"",""PSOCMOPA"",40,0)"
^XMB(3.9,146011,2,328,0)=" S DIR(""?"",1)=""Enter 'Q' to queue labels for printing"" S:$P(PSOPAR,""^"",24) DIR(""?"",2)=""Enter 'S' to suspend labels for printing at a later date"""
^XMB(3.9,146011,2,329,0)="""RTN"",""PSOCMOPA"",41,0)"
^XMB(3.9,146011,2,330,0)=" S DIR(0)=""SA^Q:QUEUE""_$S($P(PSOPAR,""^"",24):"";S:SUSPENSE"",1:""""),DIR(""B"")=""Q"" D ^DIR K DIR"
^XMB(3.9,146011,2,331,0)="""RTN"",""PSOCMOPA"",42,0)"
^XMB(3.9,146011,2,332,0)=" I $D(DUOUT)!$D(DIRUT) G KILL"
^XMB(3.9,146011,2,333,0)="""RTN"",""PSOCMOPA"",43,0)"
^XMB(3.9,146011,2,334,0)=" I $G(Y)=""S"" D S^PSOCMOP K CMOP Q"
^XMB(3.9,146011,2,335,0)="""RTN"",""PSOCMOPA"",44,0)"
^XMB(3.9,146011,2,336,0)=" I $G(Y)=""Q"" D D1^PSOCMOP K CMOP I $G(PSOLAP)]"""",($G(PSOLAP)'=ION) S PPL=DA,RXLTOP=1 D QLBL^PSORXL Q"
^XMB(3.9,146011,2,337,0)="""RTN"",""PSOCMOPA"",45,0)"
^XMB(3.9,146011,2,338,0)=" I $G(Y)=""Q"" S PPL=DA,RXLTOP=1 D Q1^PSORXL"
^XMB(3.9,146011,2,339,0)="""RTN"",""PSOCMOPA"",46,0)"
^XMB(3.9,146011,2,340,0)=" Q"
^XMB(3.9,146011,2,341,0)="""RTN"",""PSOCMOPA"",47,0)"
^XMB(3.9,146011,2,342,0)="HLD N PSOFROM S PSOFROM=""HOLD"""
^XMB(3.9,146011,2,343,0)="""RTN"",""PSOCMOPA"",48,0)"
^XMB(3.9,146011,2,344,0)="EN ;  Called from PSORXDL,HLD+4^PSOHLD, PSOCAN, PSOPRK"
^XMB(3.9,146011,2,345,0)="""RTN"",""PSOCMOPA"",49,0)"
^XMB(3.9,146011,2,346,0)=" ; if in suspense and ""loading"" no delete"
^XMB(3.9,146011,2,347,0)="""RTN"",""PSOCMOPA"",50,0)"
^XMB(3.9,146011,2,348,0)=" Q:'$G(DA)  D PSOCMOPA"
^XMB(3.9,146011,2,349,0)="""RTN"",""PSOCMOPA"",51,0)"
^XMB(3.9,146011,2,350,0)=" I $G(CMOP(""S""))=""L"" D MSG K CMOP Q"
^XMB(3.9,146011,2,351,0)="""RTN"",""PSOCMOPA"",52,0)"
^XMB(3.9,146011,2,352,0)=" ; PSO*7*508 - quit before the DIR call if this is an eRx"
^XMB(3.9,146011,2,353,0)="""RTN"",""PSOCMOPA"",53,0)"
^XMB(3.9,146011,2,354,0)=" I $G(PSOFROM)=""HOLD"",($G(CMOP(CMOP(""L"")))=0!($G(CMOP(CMOP(""L"")))=2)) D MSG D MSG Q:$G(ERXDCIEN)  K DIR S DIR(0)=""E"",DIR(""A"")=""Press Return to Continue"" D ^DIR K DIR ;*443"
^XMB(3.9,146011,2,355,0)="""RTN"",""PSOCMOPA"",54,0)"
^XMB(3.9,146011,2,356,0)=" I $G(PSOFROM)=""DELETE"",($G(CMOP(CMOP(""L"")))=0!($G(CMOP(CMOP(""L"")))=2)) D MSG"
^XMB(3.9,146011,2,357,0)="""RTN"",""PSOCMOPA"",55,0)"
^XMB(3.9,146011,2,358,0)=" K CMOP"
^XMB(3.9,146011,2,359,0)="""RTN"",""PSOCMOPA"",56,0)"
^XMB(3.9,146011,2,360,0)=" Q"
^XMB(3.9,146011,2,361,0)="""RTN"",""PSOCMOPA"",57,0)"
^XMB(3.9,146011,2,362,0)="MSG I $G(ERXDCIEN) S XFLAG=1 Q"
^XMB(3.9,146011,2,363,0)="""RTN"",""PSOCMOPA"",58,0)"
^XMB(3.9,146011,2,364,0)=" ;441 PAPI"
^XMB(3.9,146011,2,365,0)="""RTN"",""PSOCMOPA"",59,0)"
^XMB(3.9,146011,2,366,0)=" W !!,""A CMOP Rx cannot be""_$S($G(PSOFROM)=""HOLD"":"" placed on HOLD"",$G(PSOFROM)=""CANCEL"":"" DISCONTINUED"",$G(PSOFROM)=""PARK"":"" PARKED"",1:"" DELETED"")"
^XMB(3.9,146011,2,367,0)="""RTN"",""PSOCMOPA"",60,0)"
^XMB(3.9,146011,2,368,0)=" W $S($G(PSOFROM)=""DELETE"":"" while in"",1:"" during"")"
^XMB(3.9,146011,2,369,0)="""RTN"",""PSOCMOPA"",61,0)"
^XMB(3.9,146011,2,370,0)=" W $S($G(PSOFROM)=""DELETE"":"" transmission status!"",1:"" transmission! "")_""  Try later."",!!"
^XMB(3.9,146011,2,371,0)="""RTN"",""PSOCMOPA"",62,0)"
^XMB(3.9,146011,2,372,0)=" S XFLAG=1"
^XMB(3.9,146011,2,373,0)="""RTN"",""PSOCMOPA"",63,0)"
^XMB(3.9,146011,2,374,0)=" Q"
^XMB(3.9,146011,2,375,0)="""RTN"",""PSOCMOPA"",64,0)"
^XMB(3.9,146011,2,376,0)="CMOP ;"
^XMB(3.9,146011,2,377,0)="""RTN"",""PSOCMOPA"",65,0)"
