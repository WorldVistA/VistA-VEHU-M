^XMB(3.9,146087,2,3478,0)=" ..I APPSRC=""mhaweb"",(IHIT=0),(HASINST>0) D SETASGN(ASMT) Q  ;If an MHA Assignment, always show"
^XMB(3.9,146087,2,3479,0)="""RTN"",""YTQRQAD4"",226,0)"
^XMB(3.9,146087,2,3480,0)=" ..I IHIT=1 S HIT=1 D SETASGN(ASMT)"
^XMB(3.9,146087,2,3481,0)="""RTN"",""YTQRQAD4"",227,0)"
^XMB(3.9,146087,2,3482,0)=" ; Handle any remaining incomplete MH ADMINISTRATIONS"
^XMB(3.9,146087,2,3483,0)="""RTN"",""YTQRQAD4"",228,0)"
^XMB(3.9,146087,2,3484,0)=" I $D(INCMPL) S IADM="""" F  S IADM=$O(INCMPL(IADM)) Q:IADM=""""  D"
