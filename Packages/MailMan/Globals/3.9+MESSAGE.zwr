^XMB(3.9,146012,2,1648,0)=" S SORT=MSGDT_ERXIEN_"" """
^XMB(3.9,146012,2,1649,0)="""RTN"",""PSOERRX1"",233,0)"
^XMB(3.9,146012,2,1650,0)=" I FIELD=""PA"" S SORT=PATNAME_"" ""_ERXIEN"
^XMB(3.9,146012,2,1651,0)="""RTN"",""PSOERRX1"",234,0)"
^XMB(3.9,146012,2,1652,0)=" I FIELD=""DOB"" S SORT=DOB_"" ""_ERXIEN"
^XMB(3.9,146012,2,1653,0)="""RTN"",""PSOERRX1"",235,0)"
^XMB(3.9,146012,2,1654,0)=" I FIELD=""DR"" S SORT=$$UP^XLFSTR(EDRUG)_"" ""_ERXIEN"
^XMB(3.9,146012,2,1655,0)="""RTN"",""PSOERRX1"",236,0)"
^XMB(3.9,146012,2,1656,0)=" I FIELD=""PR"" S SORT=PROVIDER_"" ""_ERXIEN"
^XMB(3.9,146012,2,1657,0)="""RTN"",""PSOERRX1"",237,0)"
^XMB(3.9,146012,2,1658,0)=" I FIELD=""RE"" S SORT=MSGDT_"" ""_ERXIEN"
^XMB(3.9,146012,2,1659,0)="""RTN"",""PSOERRX1"",238,0)"
^XMB(3.9,146012,2,1660,0)=" I FIELD=""STA"" S SORT=ERXSTAT_"" ""_ERXIEN"
^XMB(3.9,146012,2,1661,0)="""RTN"",""PSOERRX1"",239,0)"
^XMB(3.9,146012,2,1662,0)=" S ^TMP(""PSOERRXS"",$J,CSGROUP,SORT)=Z"
^XMB(3.9,146012,2,1663,0)="""RTN"",""PSOERRX1"",240,0)"
