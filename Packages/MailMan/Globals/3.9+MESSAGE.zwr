^XMB(3.9,146087,2,3670,0)=" I $D(YSERR) S STAT=0 Q STAT"
^XMB(3.9,146087,2,3671,0)="""RTN"",""YTQRQAD4"",322,0)"
^XMB(3.9,146087,2,3672,0)=" I $G(YSARR(601.84,YSIENS,2,""E""))'=$G(YSNAM) S STAT=0"
^XMB(3.9,146087,2,3673,0)="""RTN"",""YTQRQAD4"",323,0)"
^XMB(3.9,146087,2,3674,0)=" I $G(YSARR(601.84,YSIENS,1,""I""))'=YSDFN S STAT=0"
^XMB(3.9,146087,2,3675,0)="""RTN"",""YTQRQAD4"",324,0)"
^XMB(3.9,146087,2,3676,0)=" Q STAT"
^XMB(3.9,146087,2,3677,0)="""RTN"",""YTQRQAD4"",325,0)"
^XMB(3.9,146087,2,3678,0)=" ;"
^XMB(3.9,146087,2,3679,0)="""RTN"",""YTQRQAD4"",326,0)"
^XMB(3.9,146087,2,3680,0)="ASMTIDA(DFN,LSTINST) ; get admins by DFN/TSTIEN"
^XMB(3.9,146087,2,3681,0)="""RTN"",""YTQRQAD4"",327,0)"
^XMB(3.9,146087,2,3682,0)=" ; Find last complete admin"
^XMB(3.9,146087,2,3683,0)="""RTN"",""YTQRQAD4"",328,0)"
^XMB(3.9,146087,2,3684,0)=" N ADMINDT,ADMINID,CMPL,PAT,NM"
^XMB(3.9,146087,2,3685,0)="""RTN"",""YTQRQAD4"",329,0)"
^XMB(3.9,146087,2,3686,0)=" K ARRAY"
^XMB(3.9,146087,2,3687,0)="""RTN"",""YTQRQAD4"",330,0)"
^XMB(3.9,146087,2,3688,0)=" S NM="""",N=0"
^XMB(3.9,146087,2,3689,0)="""RTN"",""YTQRQAD4"",331,0)"
^XMB(3.9,146087,2,3690,0)=" I DFN'?1N.NP S YSDATA(1)=""[ERROR]"",YSDATA(2)=""bad DFN"" Q"
^XMB(3.9,146087,2,3691,0)="""RTN"",""YTQRQAD4"",332,0)"
^XMB(3.9,146087,2,3692,0)=" I '$D(^DPT(DFN,0)) S YSDATA(1)=""[ERROR]"",YSDATA(2)=""no pt"" Q"
^XMB(3.9,146087,2,3693,0)="""RTN"",""YTQRQAD4"",333,0)"
^XMB(3.9,146087,2,3694,0)=" F  S NM=$O(^YTT(601.84,""C"",DFN,NM))  Q:'NM  D"
^XMB(3.9,146087,2,3695,0)="""RTN"",""YTQRQAD4"",334,0)"
^XMB(3.9,146087,2,3696,0)=" .S G=$G(^YTT(601.84,NM,0))"
^XMB(3.9,146087,2,3697,0)="""RTN"",""YTQRQAD4"",335,0)"
^XMB(3.9,146087,2,3698,0)=" .I G="""" S YSDATA(1)=""[ERROR]"",YSDATA(2)=YSIENS_"" bad ien in 84"""
^XMB(3.9,146087,2,3699,0)="""RTN"",""YTQRQAD4"",336,0)"
^XMB(3.9,146087,2,3700,0)=" .S PAT=$P(G,U,2) Q:PAT'=DFN"
^XMB(3.9,146087,2,3701,0)="""RTN"",""YTQRQAD4"",337,0)"
^XMB(3.9,146087,2,3702,0)=" .S TST=$P(G,U,3)"
^XMB(3.9,146087,2,3703,0)="""RTN"",""YTQRQAD4"",338,0)"
^XMB(3.9,146087,2,3704,0)=" .S CMPL=$P(G,U,9) I CMPL=""Y"" D "
^XMB(3.9,146087,2,3705,0)="""RTN"",""YTQRQAD4"",339,0)"
^XMB(3.9,146087,2,3706,0)=" ..S NAME=$P($G(^YTT(601.71,TST,0)),U,1)"
^XMB(3.9,146087,2,3707,0)="""RTN"",""YTQRQAD4"",340,0)"
^XMB(3.9,146087,2,3708,0)=" ..S STAFF=$P($G(^YTT(601.71,TST,9)),U,4) S:STAFF="""" STAFF=""N"""
^XMB(3.9,146087,2,3709,0)="""RTN"",""YTQRQAD4"",341,0)"
^XMB(3.9,146087,2,3710,0)=" ..S STAFF=$S(STAFF=""Y"":""true"",1:""false"")"
^XMB(3.9,146087,2,3711,0)="""RTN"",""YTQRQAD4"",342,0)"
^XMB(3.9,146087,2,3712,0)=" ..S ADMINID=$P(G,U,1),ADMINDT=$P(G,U,4)"
^XMB(3.9,146087,2,3713,0)="""RTN"",""YTQRQAD4"",343,0)"
^XMB(3.9,146087,2,3714,0)=" ..S LSTINST(TST,ADMINDT,ADMINID)=STAFF"
