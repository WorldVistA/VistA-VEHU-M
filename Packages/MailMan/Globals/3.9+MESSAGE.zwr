^XMB(3.9,146047,2,1903,0)="""RTN"",""IBCNEHLM"",124,0)"
^XMB(3.9,146047,2,1904,0)=" ; Set the NTE segment"
^XMB(3.9,146047,2,1905,0)="""RTN"",""IBCNEHLM"",125,0)"
^XMB(3.9,146047,2,1906,0)=" ;IB*2.0*664/DW- Added logic to separate the Medicare auto updates (MCAUTO)"
