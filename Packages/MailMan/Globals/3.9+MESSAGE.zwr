^XMB(3.9,146055,2,298,0)=" S SUSDOD=$P(VADM(6),""^"",2)"
^XMB(3.9,146055,2,299,0)="""RTN"",""PSOSUCH1"",29,0)"
^XMB(3.9,146055,2,300,0)=" F RXREC=0:0 S RXREC=$O(^PS(52.5,""AC"",DFN,RXREC)) Q:'RXREC  F SRXREC=0:0 S SRXREC=$O(^PS(52.5,""AC"",DFN,RXREC,SRXREC)) Q:'SRXREC  S RECORD=$P($G(^PS(52.5,SRXREC,0)),""^"") D:RECORD DEAD"
^XMB(3.9,146055,2,301,0)="""RTN"",""PSOSUCH1"",30,0)"
^XMB(3.9,146055,2,302,0)=" Q"
^XMB(3.9,146055,2,303,0)="""RTN"",""PSOSUCH1"",31,0)"
^XMB(3.9,146055,2,304,0)=" ;"
