^XMB(3.9,146043,2,242,0)="0^1^B224898714"
^XMB(3.9,146043,2,243,0)="""RTN"",""MDCLIO1"",1,0)"
^XMB(3.9,146043,2,244,0)="MDCLIO1 ;HINES OIFO/DP - CliO backend driver (Continuation);02 Sep 2005"
^XMB(3.9,146043,2,245,0)="""RTN"",""MDCLIO1"",2,0)"
^XMB(3.9,146043,2,246,0)=" ;;1.0;CLINICAL PROCEDURES;**16**;Apr 01, 2004;Build 0"
^XMB(3.9,146043,2,247,0)="""RTN"",""MDCLIO1"",3,0)"
^XMB(3.9,146043,2,248,0)=" ;Per VHA Directive 2004-038, this routine should not be modified."
^XMB(3.9,146043,2,249,0)="""RTN"",""MDCLIO1"",4,0)"
^XMB(3.9,146043,2,250,0)=" ;"
^XMB(3.9,146043,2,251,0)="""RTN"",""MDCLIO1"",5,0)"
^XMB(3.9,146043,2,252,0)=" ; This routine uses the following IAs:"
^XMB(3.9,146043,2,253,0)="""RTN"",""MDCLIO1"",6,0)"
^XMB(3.9,146043,2,254,0)=" ;  # 3027       - NOTICE^DGSEC4                Registration                   (supported)"
^XMB(3.9,146043,2,255,0)="""RTN"",""MDCLIO1"",7,0)"
^XMB(3.9,146043,2,256,0)=" ;  # 5407       - GETDCOS^ORWTPN               OE/RR                          (controlled subscription)"
^XMB(3.9,146043,2,257,0)="""RTN"",""MDCLIO1"",8,0)"
^XMB(3.9,146043,2,258,0)=" ;  # 3568       - LNGCP^TIUCP                  TIU                            (controlled subscription)"
^XMB(3.9,146043,2,259,0)="""RTN"",""MDCLIO1"",9,0)"
^XMB(3.9,146043,2,260,0)=" ;  # 3535       - TIUSRVP calls                TIU                            (controlled subscription)"
^XMB(3.9,146043,2,261,0)="""RTN"",""MDCLIO1"",10,0)"
^XMB(3.9,146043,2,262,0)=" ;  # 1800       - REQCOS^TIUSRVA               TIU                            (controlled subscription)"
^XMB(3.9,146043,2,263,0)="""RTN"",""MDCLIO1"",11,0)"
^XMB(3.9,146043,2,264,0)=" ;  # 2876       - LONGLIST^TIUSRVD             TIU                            (controlled subscription)"
^XMB(3.9,146043,2,265,0)="""RTN"",""MDCLIO1"",12,0)"
^XMB(3.9,146043,2,266,0)=" ;  # 2263       - XPAR calls                   Toolkit                        (supported)"
^XMB(3.9,146043,2,267,0)="""RTN"",""MDCLIO1"",13,0)"
^XMB(3.9,146043,2,268,0)=" ;  #10045       - HASH^XUSHSHP                 Kernel                         (supported)"
^XMB(3.9,146043,2,269,0)="""RTN"",""MDCLIO1"",14,0)"
^XMB(3.9,146043,2,270,0)=" ;  # 2240       - ENCRYP^XUSRB1                Kernel                         (supported)"
^XMB(3.9,146043,2,271,0)="""RTN"",""MDCLIO1"",15,0)"
^XMB(3.9,146043,2,272,0)=" ;  # 2241       - DECRYP^XUSRB1                Kernel                         (supported)"
^XMB(3.9,146043,2,273,0)="""RTN"",""MDCLIO1"",16,0)"
^XMB(3.9,146043,2,274,0)=" ;  # 4866       - access ^GMRD(120.51,""AVUID""  Vitals                         (private)"
^XMB(3.9,146043,2,275,0)="""RTN"",""MDCLIO1"",17,0)"
^XMB(3.9,146043,2,276,0)=" ;  # 4114       - access ^PXRMINDX(120.5       Clinical Reminders             (controlled subscription)"
^XMB(3.9,146043,2,277,0)="""RTN"",""MDCLIO1"",18,0)"
^XMB(3.9,146043,2,278,0)=" ;  #10040       - access ^SC(                  Scheduling                     (supported)"
^XMB(3.9,146043,2,279,0)="""RTN"",""MDCLIO1"",19,0)"
^XMB(3.9,146043,2,280,0)=" ;"
^XMB(3.9,146043,2,281,0)="""RTN"",""MDCLIO1"",20,0)"
^XMB(3.9,146043,2,282,0)="GETPT ; Does an old style lookup on file 2 so that we don't have to use a PK"
^XMB(3.9,146043,2,283,0)="""RTN"",""MDCLIO1"",21,0)"
^XMB(3.9,146043,2,284,0)=" D FIND^DIC(2,,.01,""KMP"",P2(0),""*"")"
^XMB(3.9,146043,2,285,0)="""RTN"",""MDCLIO1"",22,0)"
^XMB(3.9,146043,2,286,0)=" F X=0:0 S X=$O(^TMP(""DILIST"",$J,X)) Q:'X  S @MDROOT@(+^(X,0))="""""
^XMB(3.9,146043,2,287,0)="""RTN"",""MDCLIO1"",23,0)"
^XMB(3.9,146043,2,288,0)=" Q"
^XMB(3.9,146043,2,289,0)="""RTN"",""MDCLIO1"",24,0)"
^XMB(3.9,146043,2,290,0)="GETESIG ; Returns record with boolean of proper E-Sig entered"
^XMB(3.9,146043,2,291,0)="""RTN"",""MDCLIO1"",25,0)"
^XMB(3.9,146043,2,292,0)=" D NEWDOC^MDCLIO(""RESULTS"",""ESIG-VALIDATION"")"
^XMB(3.9,146043,2,293,0)="""RTN"",""MDCLIO1"",26,0)"
^XMB(3.9,146043,2,294,0)=" D XMLHDR^MDCLIO(""RECORD"")"
^XMB(3.9,146043,2,295,0)="""RTN"",""MDCLIO1"",27,0)"
^XMB(3.9,146043,2,296,0)=" D XMLDATA^MDCLIO(""EXTERNAL"",P2(0))"
^XMB(3.9,146043,2,297,0)="""RTN"",""MDCLIO1"",28,0)"
^XMB(3.9,146043,2,298,0)=" S X=$G(P2(0)) D HASH^XUSHSHP S MDX=X"
^XMB(3.9,146043,2,299,0)="""RTN"",""MDCLIO1"",29,0)"
^XMB(3.9,146043,2,300,0)=" D XMLDATA^MDCLIO(""INTERNAL"",MDX)"
^XMB(3.9,146043,2,301,0)="""RTN"",""MDCLIO1"",30,0)"
^XMB(3.9,146043,2,302,0)=" D XMLDATA^MDCLIO(""VALID"",MDX=$$GET1^DIQ(200,DUZ_"","",20.4,""I""))"
^XMB(3.9,146043,2,303,0)="""RTN"",""MDCLIO1"",31,0)"
^XMB(3.9,146043,2,304,0)=" D XMLFTR^MDCLIO(""RECORD"")"
^XMB(3.9,146043,2,305,0)="""RTN"",""MDCLIO1"",32,0)"
^XMB(3.9,146043,2,306,0)=" D ENDDOC^MDCLIO(""RESULTS"")"
^XMB(3.9,146043,2,307,0)="""RTN"",""MDCLIO1"",33,0)"
^XMB(3.9,146043,2,308,0)=" Q"
^XMB(3.9,146043,2,309,0)="""RTN"",""MDCLIO1"",34,0)"
