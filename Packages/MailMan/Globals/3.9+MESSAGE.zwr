^XMB(3.9,146037,2,452,0)=" ;"
^XMB(3.9,146037,2,453,0)="""RTN"",""RCDPEM"",67,0)"
^XMB(3.9,146037,2,454,0)=" ;Update payer table for new payers - PRCA*4.5*298"
^XMB(3.9,146037,2,455,0)="""RTN"",""RCDPEM"",68,0)"
