^XMB(3.9,146036,2,2148,0)="FAILXML(DVBXML,DVBIEN,DVBCT) ;"
^XMB(3.9,146036,2,2149,0)="""RTN"",""DVBCTXML"",52,0)"
^XMB(3.9,146036,2,2150,0)=" ;RPC: DVBA CAPRI GET DBQ XML"
^XMB(3.9,146036,2,2151,0)="""RTN"",""DVBCTXML"",53,0)"
^XMB(3.9,146036,2,2152,0)=" N DVBABCNT,DVBFXML,DVNCT,DVBFXML,DVBABIEN K ^TMP(""DVBAXML"",$J)"
