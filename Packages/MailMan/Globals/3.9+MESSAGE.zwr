^XMB(3.9,146084,2,2455,0)="""RTN"",""SDES2GETREGS"",192,0)"
^XMB(3.9,146084,2,2456,0)=" Q"
^XMB(3.9,146084,2,2457,0)="""RTN"",""SDES2GETREGS"",193,0)"
^XMB(3.9,146084,2,2458,0)=" ;"
^XMB(3.9,146084,2,2459,0)="""RTN"",""SDES2GETREGS"",194,0)"
^XMB(3.9,146084,2,2460,0)="SIM(DFN)  ;get similar patient data"
^XMB(3.9,146084,2,2461,0)="""RTN"",""SDES2GETREGS"",195,0)"
^XMB(3.9,146084,2,2462,0)=" N MI,MSG,NOD,PATS,RET,SIM"
^XMB(3.9,146084,2,2463,0)="""RTN"",""SDES2GETREGS"",196,0)"
^XMB(3.9,146084,2,2464,0)=" S (MSG,PATS,SIM)="""""
^XMB(3.9,146084,2,2465,0)="""RTN"",""SDES2GETREGS"",197,0)"
^XMB(3.9,146084,2,2466,0)=" D GUIBS5A^DPTLK6(.RET,DFN)"
^XMB(3.9,146084,2,2467,0)="""RTN"",""SDES2GETREGS"",198,0)"
^XMB(3.9,146084,2,2468,0)=" S MI=1 F  S MI=$O(RET(MI)) Q:MI=""""  D"
^XMB(3.9,146084,2,2469,0)="""RTN"",""SDES2GETREGS"",199,0)"
^XMB(3.9,146084,2,2470,0)=" .S NOD=RET(MI)"
^XMB(3.9,146084,2,2471,0)="""RTN"",""SDES2GETREGS"",200,0)"
^XMB(3.9,146084,2,2472,0)=" .I $P(NOD,U,1)=0 S MSG=MSG_$S(MSG'="""":"" "",1:"""")_$P(NOD,U,2)"
^XMB(3.9,146084,2,2473,0)="""RTN"",""SDES2GETREGS"",201,0)"
^XMB(3.9,146084,2,2474,0)=" .I $P(NOD,U,1)=1 S PATS=PATS_$S(PATS'="""":"";;"",1:"""")_$TR($P(NOD,U,2,4),U,""~"")_""~""_$E($P(NOD,U,5),6,$L($P(NOD,U,5))) S:(MSG'="""")&($E(MSG,$L(MSG))'=""."") MSG=MSG_""."""
^XMB(3.9,146084,2,2475,0)="""RTN"",""SDES2GETREGS"",202,0)"
^XMB(3.9,146084,2,2476,0)=" S SIM=MSG_""|""_PATS"
^XMB(3.9,146084,2,2477,0)="""RTN"",""SDES2GETREGS"",203,0)"
^XMB(3.9,146084,2,2478,0)=" Q SIM"
^XMB(3.9,146084,2,2479,0)="""RTN"",""SDES2GETREGS"",204,0)"
^XMB(3.9,146084,2,2480,0)=" ;"
^XMB(3.9,146084,2,2481,0)="""RTN"",""SDES2GETREGS"",205,0)"
^XMB(3.9,146084,2,2482,0)="ASSIGNADDR(RET,DFN) ;assign values to be used to build output"
^XMB(3.9,146084,2,2483,0)="""RTN"",""SDES2GETREGS"",206,0)"
^XMB(3.9,146084,2,2484,0)=" N SDD,SDI,SDM,Z0"
^XMB(3.9,146084,2,2485,0)="""RTN"",""SDES2GETREGS"",207,0)"
^XMB(3.9,146084,2,2486,0)=" N PCE,PCOUNTY,PTCOUNTY,PSTATE"
^XMB(3.9,146084,2,2487,0)="""RTN"",""SDES2GETREGS"",208,0)"
^XMB(3.9,146084,2,2488,0)=" Q:'+$G(DFN)"
^XMB(3.9,146084,2,2489,0)="""RTN"",""SDES2GETREGS"",209,0)"
^XMB(3.9,146084,2,2490,0)=" Q:'$D(^DPT(DFN,0))"
^XMB(3.9,146084,2,2491,0)="""RTN"",""SDES2GETREGS"",210,0)"
^XMB(3.9,146084,2,2492,0)=" ;"
^XMB(3.9,146084,2,2493,0)="""RTN"",""SDES2GETREGS"",211,0)"
^XMB(3.9,146084,2,2494,0)=" ;collect demographics"
^XMB(3.9,146084,2,2495,0)="""RTN"",""SDES2GETREGS"",212,0)"
^XMB(3.9,146084,2,2496,0)=" K RET"
^XMB(3.9,146084,2,2497,0)="""RTN"",""SDES2GETREGS"",213,0)"
^XMB(3.9,146084,2,2498,0)=" S (PCOUNTY,PTCOUNTY,RET(""PCOUNTY""),RET(""PTCOUNTY""))="""""
^XMB(3.9,146084,2,2499,0)="""RTN"",""SDES2GETREGS"",214,0)"
^XMB(3.9,146084,2,2500,0)=" ;"
^XMB(3.9,146084,2,2501,0)="""RTN"",""SDES2GETREGS"",215,0)"
^XMB(3.9,146084,2,2502,0)=" ;get addresses"
^XMB(3.9,146084,2,2503,0)="""RTN"",""SDES2GETREGS"",216,0)"
^XMB(3.9,146084,2,2504,0)=" K SDD,SDM D GETS^DIQ(2,DFN_"","","".111:.135;.211:.2207"",""IE"",""SDD"",""SDM"")"
