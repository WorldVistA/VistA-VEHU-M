^XMB(3.9,146056,2,2530,0)=" I $$GET1^DIQ(52,RX,""6:213"",""I"") S Y="">"""
^XMB(3.9,146056,2,2531,0)="""RTN"",""VPRSDAP"",125,0)"
^XMB(3.9,146056,2,2532,0)=" N X S X=""PSXOPUTL"" X ^%ZOSF(""TEST"") K X I $T D"
^XMB(3.9,146056,2,2533,0)="""RTN"",""VPRSDAP"",126,0)"
^XMB(3.9,146056,2,2534,0)=" . N DA,PSXZ S DA=RX D ^PSXOPUTL"
^XMB(3.9,146056,2,2535,0)="""RTN"",""VPRSDAP"",127,0)"
^XMB(3.9,146056,2,2536,0)=" . S X=$G(PSXZ(PSXZ(""L""))) I X=0!(X=2) S Y=""T"""
