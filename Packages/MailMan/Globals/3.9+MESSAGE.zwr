^XMB(3.9,146047,2,1061,0)="""RTN"",""IBCNBCD2"",342,0)"
^XMB(3.9,146047,2,1062,0)=" ;"
^XMB(3.9,146047,2,1063,0)="""RTN"",""IBCNBCD2"",343,0)"
^XMB(3.9,146047,2,1064,0)="ASKADD(IBTXT,IBDATE) ; Prompt to ask user to add new coverage CATEGORY"
