^XMB(3.9,146012,2,1235,0)="""RTN"",""PSOERRX1"",26,0)"
^XMB(3.9,146012,2,1236,0)=" . I $G(DRGFLTR)'="""" S FILTER=FILTER_""|ERX DRUG NAME('""_DRGFLTR_""')"""
^XMB(3.9,146012,2,1237,0)="""RTN"",""PSOERRX1"",27,0)"
