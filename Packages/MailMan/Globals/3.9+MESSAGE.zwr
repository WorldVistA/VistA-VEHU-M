^XMB(3.9,146087,2,1476,0)=" ... D BLDHDR^YTQRCDB4(.HDR,ADMIN,79)"
^XMB(3.9,146087,2,1477,0)="""RTN"",""YTQRCDB3"",43,0)"
^XMB(3.9,146087,2,1478,0)=" ... S J=0 F  S J=$O(HDR(J)) Q:J=""""  D"
^XMB(3.9,146087,2,1479,0)="""RTN"",""YTQRCDB3"",44,0)"
^XMB(3.9,146087,2,1480,0)=" .... S NCNT=NCNT+1,RESULTS(""text"",""\"",NCNT)=HDR(J)"
^XMB(3.9,146087,2,1481,0)="""RTN"",""YTQRCDB3"",45,0)"
^XMB(3.9,146087,2,1482,0)=" .. S J=0 F  S J=$O(DATA(""notes"",I,""text"",J)) Q:J=""""  D"
^XMB(3.9,146087,2,1483,0)="""RTN"",""YTQRCDB3"",46,0)"
^XMB(3.9,146087,2,1484,0)=" ... S NCNT=NCNT+1,RESULTS(""text"",""\"",NCNT)=DATA(""notes"",I,""text"",J)"
^XMB(3.9,146087,2,1485,0)="""RTN"",""YTQRCDB3"",47,0)"
^XMB(3.9,146087,2,1486,0)=" . I $G(RESULTS(""text""))=""null"" Q"
^XMB(3.9,146087,2,1487,0)="""RTN"",""YTQRCDB3"",48,0)"
^XMB(3.9,146087,2,1488,0)=" . ;Now text is normalized in RESULTS whether sent in or generated through VistA."
^XMB(3.9,146087,2,1489,0)="""RTN"",""YTQRCDB3"",49,0)"
^XMB(3.9,146087,2,1490,0)=" . I CNT'=0 D"
^XMB(3.9,146087,2,1491,0)="""RTN"",""YTQRCDB3"",50,0)"
^XMB(3.9,146087,2,1492,0)=" .. S CNT=CNT+1,$P(TXTARR(CNT),""_"",75)="""" ;Add Note Divider"
^XMB(3.9,146087,2,1493,0)="""RTN"",""YTQRCDB3"",51,0)"
^XMB(3.9,146087,2,1494,0)=" . S J=0 F  S J=$O(RESULTS(""text"",""\"",J)) Q:J=""""  D  ;RESULTS format back into sequential TXTARR array"
^XMB(3.9,146087,2,1495,0)="""RTN"",""YTQRCDB3"",52,0)"
^XMB(3.9,146087,2,1496,0)=" .. S CNT=CNT+1,TXTARR(CNT)=RESULTS(""text"",""\"",J)"
^XMB(3.9,146087,2,1497,0)="""RTN"",""YTQRCDB3"",53,0)"
^XMB(3.9,146087,2,1498,0)=" ;At this point all Cloud generated and VistA generated PNOTE text in TXTARR"
^XMB(3.9,146087,2,1499,0)="""RTN"",""YTQRCDB3"",54,0)"
^XMB(3.9,146087,2,1500,0)=" M TXT=TXTARR"
^XMB(3.9,146087,2,1501,0)="""RTN"",""YTQRCDB3"",55,0)"
^XMB(3.9,146087,2,1502,0)=" Q"
^XMB(3.9,146087,2,1503,0)="""RTN"",""YTQRCDB3"",56,0)"
^XMB(3.9,146087,2,1504,0)="GETNOTE(ADMIN,COSIGNER,RESULTS) ; build note object based on ARGS(""adminId"")"
^XMB(3.9,146087,2,1505,0)="""RTN"",""YTQRCDB3"",57,0)"
^XMB(3.9,146087,2,1506,0)=" I '$D(^YTT(601.84,ADMIN,0)) D SETERROR^YTQRUTL(404,""Admin not found: ""_ADMIN) QUIT"
^XMB(3.9,146087,2,1507,0)="""RTN"",""YTQRCDB3"",58,0)"
^XMB(3.9,146087,2,1508,0)=" N CONSULT S CONSULT=$P(^YTT(601.84,ADMIN,0),U,15)"
^XMB(3.9,146087,2,1509,0)="""RTN"",""YTQRCDB3"",59,0)"
^XMB(3.9,146087,2,1510,0)=" S RESULTS(""adminId"")=ADMIN"
^XMB(3.9,146087,2,1511,0)="""RTN"",""YTQRCDB3"",60,0)"
^XMB(3.9,146087,2,1512,0)=" S RESULTS(""consultId"")=$S(+CONSULT:CONSULT,1:""null"")"
^XMB(3.9,146087,2,1513,0)="""RTN"",""YTQRCDB3"",61,0)"
^XMB(3.9,146087,2,1514,0)=" S RESULTS(""allowNote"")=$$ALWNOTE^YTQRQAD3(ADMIN)"
^XMB(3.9,146087,2,1515,0)="""RTN"",""YTQRCDB3"",62,0)"
^XMB(3.9,146087,2,1516,0)=" S RESULTS(""requireCosigner"")=$$REQCSGN^YTQRQAD3(ADMIN)"
^XMB(3.9,146087,2,1517,0)="""RTN"",""YTQRCDB3"",63,0)"
^XMB(3.9,146087,2,1518,0)=" S RESULTS(""cosigner"")=$S(COSIGNER'="""":COSIGNER,1:""null"")"
^XMB(3.9,146087,2,1519,0)="""RTN"",""YTQRCDB3"",64,0)"
^XMB(3.9,146087,2,1520,0)=" I RESULTS(""allowNote"")=""true"" D REPORT1^YTQRQAD3(ADMIN,.RESULTS,""NOTE"") I 1  ;ADMIN=Administration IEN, RESULTS array for report, NOTE=PROGRESS NOTE"
^XMB(3.9,146087,2,1521,0)="""RTN"",""YTQRCDB3"",65,0)"
^XMB(3.9,146087,2,1522,0)=" E  S RESULTS(""text"")=""null"""
^XMB(3.9,146087,2,1523,0)="""RTN"",""YTQRCDB3"",66,0)"
^XMB(3.9,146087,2,1524,0)=" D SPLTADM^YTQRCAT(ADMIN) ; separate out the admins if CAT"
^XMB(3.9,146087,2,1525,0)="""RTN"",""YTQRCDB3"",67,0)"
^XMB(3.9,146087,2,1526,0)=" Q"
^XMB(3.9,146087,2,1527,0)="""RTN"",""YTQRCDB3"",68,0)"
^XMB(3.9,146087,2,1528,0)="SETNOTE(ARGS,DATA) ; save note in DATA(""text"") using ARGS(""adminId"")"
^XMB(3.9,146087,2,1529,0)="""RTN"",""YTQRCDB3"",69,0)"
^XMB(3.9,146087,2,1530,0)=" ;Expects DATA to be in the format returned from BLDRPT^YTQRRPT"
^XMB(3.9,146087,2,1531,0)="""RTN"",""YTQRCDB3"",70,0)"
^XMB(3.9,146087,2,1532,0)=" ;All instrument progress notes should be in DATA(""text""), even for multiple instrument assignments"
^XMB(3.9,146087,2,1533,0)="""RTN"",""YTQRCDB3"",71,0)"
^XMB(3.9,146087,2,1534,0)=" N YS,YSDATA,ADMIN,CONSULT,WRP,ASGN,LSTASGN,PNOT,AGPROG"
^XMB(3.9,146087,2,1535,0)="""RTN"",""YTQRCDB3"",72,0)"
^XMB(3.9,146087,2,1536,0)=" S ADMIN=$G(DATA(""adminId""))"
^XMB(3.9,146087,2,1537,0)="""RTN"",""YTQRCDB3"",73,0)"
^XMB(3.9,146087,2,1538,0)=" S ASGN=$G(DATA(""assignmentId""))"
^XMB(3.9,146087,2,1539,0)="""RTN"",""YTQRCDB3"",74,0)"
^XMB(3.9,146087,2,1540,0)=" I ADMIN="""" D SETERROR^YTQRUTL(404,""Admin not sent: ""_ADMIN) QUIT """""
^XMB(3.9,146087,2,1541,0)="""RTN"",""YTQRCDB3"",75,0)"
^XMB(3.9,146087,2,1542,0)=" I '$D(^YTT(601.84,ADMIN,0)) D SETERROR^YTQRUTL(404,""Admin not found: ""_ADMIN) QUIT """""
^XMB(3.9,146087,2,1543,0)="""RTN"",""YTQRCDB3"",76,0)"
^XMB(3.9,146087,2,1544,0)=" S CONSULT=$P(^YTT(601.84,ADMIN,0),U,15)"
^XMB(3.9,146087,2,1545,0)="""RTN"",""YTQRCDB3"",77,0)"
^XMB(3.9,146087,2,1546,0)=" S PNOT=0"
^XMB(3.9,146087,2,1547,0)="""RTN"",""YTQRCDB3"",78,0)"
^XMB(3.9,146087,2,1548,0)=" I '$D(^YTT(601.84,ADMIN,0)) D SETERROR^YTQRUTL(404,""Admin not found: ""_ADMIN) QUIT """""
^XMB(3.9,146087,2,1549,0)="""RTN"",""YTQRCDB3"",79,0)"
^XMB(3.9,146087,2,1550,0)=" D TXT2LN(.DATA,.YS) ; parse by CRLF and set YS(#) to note text"
^XMB(3.9,146087,2,1551,0)="""RTN"",""YTQRCDB3"",80,0)"
^XMB(3.9,146087,2,1552,0)=" D WRAP(.YS,79)  ;reformat lines to 79 max chars"
^XMB(3.9,146087,2,1553,0)="""RTN"",""YTQRCDB3"",81,0)"
^XMB(3.9,146087,2,1554,0)=" S YS(""AD"")=ADMIN"
^XMB(3.9,146087,2,1555,0)="""RTN"",""YTQRCDB3"",82,0)"
^XMB(3.9,146087,2,1556,0)=" I $G(DATA(""cosigner""))]"""" S YS(""COSIGNER"")=DATA(""cosigner"")"
^XMB(3.9,146087,2,1557,0)="""RTN"",""YTQRCDB3"",83,0)"
^XMB(3.9,146087,2,1558,0)=" I CONSULT S YS(""CON"")=CONSULT D CCREATE^YTQCONS(.YSDATA,.YS) I 1"
^XMB(3.9,146087,2,1559,0)="""RTN"",""YTQRCDB3"",84,0)"
^XMB(3.9,146087,2,1560,0)=" E  D PCREATE^YTQTIU(.YSDATA,.YS)"
^XMB(3.9,146087,2,1561,0)="""RTN"",""YTQRCDB3"",85,0)"
^XMB(3.9,146087,2,1562,0)=" I YSDATA(1)'=""[DATA]"" D SETERROR^YTQRUTL(500,""Note not saved"") Q """""
^XMB(3.9,146087,2,1563,0)="""RTN"",""YTQRCDB3"",86,0)"
^XMB(3.9,146087,2,1564,0)=" N ADMCNT,YSADD,ADMLST"
^XMB(3.9,146087,2,1565,0)="""RTN"",""YTQRCDB3"",87,0)"
^XMB(3.9,146087,2,1566,0)=" S ADMCNT=0 F  S ADMCNT=$O(DATA(""adminList"",ADMCNT)) Q:ADMCNT=""""  D"
^XMB(3.9,146087,2,1567,0)="""RTN"",""YTQRCDB3"",88,0)"
^XMB(3.9,146087,2,1568,0)=" . S YSADD=DATA(""adminList"",ADMCNT) Q:+YSADD=0  ;safety "
^XMB(3.9,146087,2,1569,0)="""RTN"",""YTQRCDB3"",89,0)"
^XMB(3.9,146087,2,1570,0)=" . I $$ALWNOTE^YTQRQAD3(YSADD)=""true"" S $P(^YTT(601.84,YSADD,0),U,18)=1  ;PROGRESS NOTE GENERATED"
^XMB(3.9,146087,2,1571,0)="""RTN"",""YTQRCDB3"",90,0)"
^XMB(3.9,146087,2,1572,0)=" Q ""/api/mha/cdb/instrument/note/""_$G(YSDATA(2))"
^XMB(3.9,146087,2,1573,0)="""RTN"",""YTQRCDB3"",91,0)"
^XMB(3.9,146087,2,1574,0)=" ;"
^XMB(3.9,146087,2,1575,0)="""RTN"",""YTQRCDB3"",92,0)"
^XMB(3.9,146087,2,1576,0)="TXT2LN(SRC,DEST) ; Move CRLF delimited text from .SRC into WP lines in .DEST"
^XMB(3.9,146087,2,1577,0)="""RTN"",""YTQRCDB3"",93,0)"
^XMB(3.9,146087,2,1578,0)=" N IDEST,CRLF,REMAIN"
^XMB(3.9,146087,2,1579,0)="""RTN"",""YTQRCDB3"",94,0)"
^XMB(3.9,146087,2,1580,0)=" S IDEST=0,CRLF=$C(10)"
^XMB(3.9,146087,2,1581,0)="""RTN"",""YTQRCDB3"",95,0)"
^XMB(3.9,146087,2,1582,0)=" S REMAIN=$$PARSLN(SRC(""text""))"
^XMB(3.9,146087,2,1583,0)="""RTN"",""YTQRCDB3"",96,0)"
^XMB(3.9,146087,2,1584,0)=" I '$D(SRC(""text"",""\"",1)),$L(REMAIN) D  QUIT  ; done since no continue nodes"
^XMB(3.9,146087,2,1585,0)="""RTN"",""YTQRCDB3"",97,0)"
^XMB(3.9,146087,2,1586,0)=" . S IDEST=IDEST+1,DEST(IDEST)=REMAIN"
^XMB(3.9,146087,2,1587,0)="""RTN"",""YTQRCDB3"",98,0)"
^XMB(3.9,146087,2,1588,0)=" N J                                          ; handle continue nodes"
^XMB(3.9,146087,2,1589,0)="""RTN"",""YTQRCDB3"",99,0)"
^XMB(3.9,146087,2,1590,0)=" S J=0 F  S J=$O(SRC(""text"",""\"",J)) Q:'J  D"
^XMB(3.9,146087,2,1591,0)="""RTN"",""YTQRCDB3"",100,0)"
^XMB(3.9,146087,2,1592,0)=" . S REMAIN=$$PARSLN(REMAIN_SRC(""text"",""\"",J))"
^XMB(3.9,146087,2,1593,0)="""RTN"",""YTQRCDB3"",101,0)"
^XMB(3.9,146087,2,1594,0)=" I $L(REMAIN) S IDEST=IDEST+1,DEST(IDEST)=REMAIN"
^XMB(3.9,146087,2,1595,0)="""RTN"",""YTQRCDB3"",102,0)"
^XMB(3.9,146087,2,1596,0)=" Q"
^XMB(3.9,146087,2,1597,0)="""RTN"",""YTQRCDB3"",103,0)"
^XMB(3.9,146087,2,1598,0)="PARSLN(TXT) ; Return remainder after parsing text into lines"
^XMB(3.9,146087,2,1599,0)="""RTN"",""YTQRCDB3"",104,0)"
^XMB(3.9,146087,2,1600,0)=" ; expects: CRLF, DEST, IDEST"
^XMB(3.9,146087,2,1601,0)="""RTN"",""YTQRCDB3"",105,0)"
^XMB(3.9,146087,2,1602,0)=" N X S X=TXT"
^XMB(3.9,146087,2,1603,0)="""RTN"",""YTQRCDB3"",106,0)"
^XMB(3.9,146087,2,1604,0)=" I '$L(X) Q """""
^XMB(3.9,146087,2,1605,0)="""RTN"",""YTQRCDB3"",107,0)"
^XMB(3.9,146087,2,1606,0)=" ; Break lines by CRLF. Depending on source line delim could be $c(13) or $c(13,10). CRLF=$c(10) so $TR $c(13) in case it is embedded"
^XMB(3.9,146087,2,1607,0)="""RTN"",""YTQRCDB3"",108,0)"
^XMB(3.9,146087,2,1608,0)=" F  S IDEST=IDEST+1,DEST(IDEST)=$P(X,CRLF),X=$P(X,CRLF,2,99999),DEST(IDEST)=$TR(DEST(IDEST),$C(13)) Q:X'[CRLF"
^XMB(3.9,146087,2,1609,0)="""RTN"",""YTQRCDB3"",109,0)"
^XMB(3.9,146087,2,1610,0)=" Q $TR(X,$C(13))"
^XMB(3.9,146087,2,1611,0)="""RTN"",""YTQRCDB3"",110,0)"
^XMB(3.9,146087,2,1612,0)="WRAP(OUT,MAX) ; Wrap text by space piece word MAX char width"
^XMB(3.9,146087,2,1613,0)="""RTN"",""YTQRCDB3"",111,0)"
^XMB(3.9,146087,2,1614,0)=" N TMP,STR,II,JJ,PCE,CNT"
^XMB(3.9,146087,2,1615,0)="""RTN"",""YTQRCDB3"",112,0)"
^XMB(3.9,146087,2,1616,0)=" I +$G(MAX)=0 S MAX=79"
^XMB(3.9,146087,2,1617,0)="""RTN"",""YTQRCDB3"",113,0)"
^XMB(3.9,146087,2,1618,0)=" M TMP=OUT Q:'$D(TMP)"
^XMB(3.9,146087,2,1619,0)="""RTN"",""YTQRCDB3"",114,0)"
^XMB(3.9,146087,2,1620,0)=" K OUT"
^XMB(3.9,146087,2,1621,0)="""RTN"",""YTQRCDB3"",115,0)"
^XMB(3.9,146087,2,1622,0)=" S (CNT,II)=0 F  S II=$O(TMP(II)) Q:II=""""  D"
^XMB(3.9,146087,2,1623,0)="""RTN"",""YTQRCDB3"",116,0)"
^XMB(3.9,146087,2,1624,0)=" . S STR="""" F JJ=1:1:$L(TMP(II),"" "") D"
^XMB(3.9,146087,2,1625,0)="""RTN"",""YTQRCDB3"",117,0)"
^XMB(3.9,146087,2,1626,0)=" .. S PCE=$P(TMP(II),"" "",JJ)"
^XMB(3.9,146087,2,1627,0)="""RTN"",""YTQRCDB3"",118,0)"
^XMB(3.9,146087,2,1628,0)=" .. I $L(STR_PCE_"" "")>MAX D  Q"
^XMB(3.9,146087,2,1629,0)="""RTN"",""YTQRCDB3"",119,0)"
^XMB(3.9,146087,2,1630,0)=" ... S CNT=CNT+1,OUT(CNT)=$E(STR,1,$L(STR)-1),STR=PCE_"" """
^XMB(3.9,146087,2,1631,0)="""RTN"",""YTQRCDB3"",120,0)"
^XMB(3.9,146087,2,1632,0)=" .. S STR=STR_PCE_"" """
^XMB(3.9,146087,2,1633,0)="""RTN"",""YTQRCDB3"",121,0)"
^XMB(3.9,146087,2,1634,0)=" . I STR]"""" S CNT=CNT+1,OUT(CNT)=$E(STR,1,$L(STR)-1)"
^XMB(3.9,146087,2,1635,0)="""RTN"",""YTQRCDB3"",122,0)"
^XMB(3.9,146087,2,1636,0)=" Q"
^XMB(3.9,146087,2,1637,0)="""RTN"",""YTQRCDB3"",123,0)"
^XMB(3.9,146087,2,1638,0)=" ;"
^XMB(3.9,146087,2,1639,0)="""RTN"",""YTQREST"")"
^XMB(3.9,146087,2,1640,0)="0^5^B54533191"
^XMB(3.9,146087,2,1641,0)="""RTN"",""YTQREST"",1,0)"
^XMB(3.9,146087,2,1642,0)="YTQREST ;SLC/KCM - RESTful API front controller ; 1/25/2017"
