^XMB(3.9,146036,2,2621,0)="""RTN"",""DVBCUTIL"",100,0)"
^XMB(3.9,146036,2,2622,0)=" Q"
^XMB(3.9,146036,2,2623,0)="""RTN"",""DVBCUTIL"",101,0)"
^XMB(3.9,146036,2,2624,0)=" ;"
^XMB(3.9,146036,2,2625,0)="""RTN"",""DVBCUTIL"",102,0)"
^XMB(3.9,146036,2,2626,0)="SSNOUT ;  ** Set SSN in the Format '*********** (Z6789) **"
^XMB(3.9,146036,2,2627,0)="""RTN"",""DVBCUTIL"",103,0)"
^XMB(3.9,146036,2,2628,0)=" D SSNSHRT"
^XMB(3.9,146036,2,2629,0)="""RTN"",""DVBCUTIL"",104,0)"
