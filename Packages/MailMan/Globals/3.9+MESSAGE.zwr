^XMB(3.9,146035,2,291,0)="""RTN"",""PSOBBC"",26,0)"
^XMB(3.9,146035,2,292,0)=" I '$G(PSOINST) D"
^XMB(3.9,146035,2,293,0)="""RTN"",""PSOBBC"",27,0)"
^XMB(3.9,146035,2,294,0)=" .K DIC,DR,DIQ S DA=$P($$SITE^VASITE(),""^"") I DA D"
