^XMB(3.9,146037,2,2814,0)=" . D CHKP(RCNOW,.RCPG,RCHR,RCDT1,RCDT2,RCEXCEL,RCSCR,LINES,"""","""") ; PRCA*4.5*380 - Added dep. number & date to header call"
