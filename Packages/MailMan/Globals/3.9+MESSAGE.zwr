^XMB(3.9,146017,2,1406,0)=" ...I $$GET1^DIQ(44.003,SUBIEN_"",""_APPTDATETIME_"",""_CLINICIEN_"","",310)=""CANCELLED"" Q"
^XMB(3.9,146017,2,1407,0)="""RTN"",""SDES2CANCLNAVAIL"",141,0)"
^XMB(3.9,146017,2,1408,0)=" ...I $$GET1^DIQ(44.003,SUBIEN_"",""_APPTDATETIME_"",""_CLINICIEN_"","",303,""I"") D ERRLOG^SDESJSON(.ERRORS,247)"
^XMB(3.9,146017,2,1409,0)="""RTN"",""SDES2CANCLNAVAIL"",142,0)"
^XMB(3.9,146017,2,1410,0)=" .;"
^XMB(3.9,146017,2,1411,0)="""RTN"",""SDES2CANCLNAVAIL"",143,0)"
^XMB(3.9,146017,2,1412,0)=" .I FLAG=""P"",$D(^SC(CLINICIEN,""ST"",$P(SCHEDULEDATE,"".""),""CAN"")) D"
^XMB(3.9,146017,2,1413,0)="""RTN"",""SDES2CANCLNAVAIL"",144,0)"
^XMB(3.9,146017,2,1414,0)=" ..S CANCELDATETIME=$P(STARTDATETIME,""."")"
^XMB(3.9,146017,2,1415,0)="""RTN"",""SDES2CANCLNAVAIL"",145,0)"
^XMB(3.9,146017,2,1416,0)=" ..F  S CANCELDATETIME=$O(^SC(CLINICIEN,""SDCAN"",CANCELDATETIME)) Q:'CANCELDATETIME!($P(CANCELDATETIME,""."")>$P(STARTDATETIME,"".""))!($D(ERRORS))  D"
^XMB(3.9,146017,2,1417,0)="""RTN"",""SDES2CANCLNAVAIL"",146,0)"
^XMB(3.9,146017,2,1418,0)=" ...S CANCELSTART=$$GET1^DIQ(44.05,CANCELDATETIME_"",""_CLINICIEN_"","",.01,""I"")"
^XMB(3.9,146017,2,1419,0)="""RTN"",""SDES2CANCLNAVAIL"",147,0)"
^XMB(3.9,146017,2,1420,0)=" ...S CANCELEND=$P(CANCELSTART,""."")_"".""_$P($$GET1^DIQ(44.05,CANCELDATETIME_"",""_CLINICIEN_"","",1,""I""),""."",1)*1"
^XMB(3.9,146017,2,1421,0)="""RTN"",""SDES2CANCLNAVAIL"",148,0)"
^XMB(3.9,146017,2,1422,0)=" ...I STARTDATETIME>=CANCELEND!(ENDDATETIME<=CANCELSTART)!(CANCELSTART>=ENDDATETIME)!(CANCELEND<=STARTDATETIME) Q"
^XMB(3.9,146017,2,1423,0)="""RTN"",""SDES2CANCLNAVAIL"",149,0)"
^XMB(3.9,146017,2,1424,0)=" ...D ERRLOG^SDESJSON(.ERRORS,250)"
