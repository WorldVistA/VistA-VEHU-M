^XMB(3.9,146037,2,2285,0)="""RTN"",""RCDPESR9"",207,0)"
^XMB(3.9,146037,2,2286,0)="ZERO(X,D,NULL) ; Returns numeric value of X without leading 0's"
^XMB(3.9,146037,2,2287,0)="""RTN"",""RCDPESR9"",208,0)"
^XMB(3.9,146037,2,2288,0)=" ; or null if no value wanted for 0 amount"
