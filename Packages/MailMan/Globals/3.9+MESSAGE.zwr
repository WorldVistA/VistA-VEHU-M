^XMB(3.9,146101,2,698,0)=" ....S PSSPHDT(""PSSCUSTD"")=$G(^TMP(""PSSPGXBS"",$J,PSSPH1,PSSPH7,""A"",""customIssueDate""))"
^XMB(3.9,146101,2,699,0)="""RTN"",""PSSPGXPR"",21,0)"
^XMB(3.9,146101,2,700,0)=" ....S PSSPHDT(""PSSDIFD"")=$G(^TMP(""PSSPGXBS"",$J,PSSPH1,PSSPH7,""A"",""difIssueDate""))"
^XMB(3.9,146101,2,701,0)="""RTN"",""PSSPGXPR"",22,0)"
^XMB(3.9,146101,2,702,0)=" ...I $G(^TMP(""PSSPGXBS"",$J,PSSPH1,PSSPH2,""C"",PSSPH7))=""drugCheck"" D"
^XMB(3.9,146101,2,703,0)="""RTN"",""PSSPGXPR"",23,0)"
