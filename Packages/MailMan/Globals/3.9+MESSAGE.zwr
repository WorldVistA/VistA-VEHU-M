^XMB(3.9,146036,2,2452,0)=" W ! S TSTDT=$P(^(0),U,2),RO=$P(^(0),U,3),STAT=$P(^(0),U,18),RONAME=$S($D(^DIC(4,+RO,0)):$P(^(0),U,1),1:""Unknown RO"") D DICW1"
