^XMB(3.9,146043,2,779,0)="""RTN"",""MDCLIO1"",269,0)"
^XMB(3.9,146043,2,780,0)=" .F Y=0:0 S Y=$O(^MDC(704.117,""AS"",MDSTAT,MDPT,MDFR,Y)) Q:'Y  S @MDROOT@(Y)="""""
