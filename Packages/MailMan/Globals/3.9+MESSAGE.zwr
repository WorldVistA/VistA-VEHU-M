^XMB(3.9,146015,2,316,0)=" S RSLT=$$CRCL^PSOORUT2(DFN)"
^XMB(3.9,146015,2,317,0)="""RTN"",""PSODEM"",35,0)"
^XMB(3.9,146015,2,318,0)=" ; RSLT -- DATE^CRCL^Serum Creatinine -- Ex.  11/25/11^68.7^1.1"
^XMB(3.9,146015,2,319,0)="""RTN"",""PSODEM"",36,0)"
^XMB(3.9,146015,2,320,0)=" ; Display format of CrCL and Creatinine results updated - PSO*7.0*556"
^XMB(3.9,146015,2,321,0)="""RTN"",""PSODEM"",37,0)"
^XMB(3.9,146015,2,322,0)=" I ($P($G(RSLT),""^"",2)[""Not Found"")&($P($G(RSLT),""^"",3)<.01) S ZDSPL=""  CrCL: ""_$P(RSLT,""^"",2)_"" (CREAT: Not Found)"""
^XMB(3.9,146015,2,323,0)="""RTN"",""PSODEM"",38,0)"
^XMB(3.9,146015,2,324,0)=" I ($P($G(RSLT),""^"",2)[""Not Found"")&($P($G(RSLT),""^"",3)>=.01) S ZDSPL=""  CrCL: ""_$P(RSLT,""^"",2)_""  (CREAT: ""_$P($G(RSLT),""^"",3)_""mg/dL ""_$P($G(RSLT),""^"")_"")"""
^XMB(3.9,146015,2,325,0)="""RTN"",""PSODEM"",39,0)"
^XMB(3.9,146015,2,326,0)=" I ($P($G(RSLT),""^"",2)'[""Not Found"")&($P($G(RSLT),""^"",3)<.01) S ZDSPL=""  CrCL: ""_$P(RSLT,""^"",2)_"" (CREAT: Not Found)"""
