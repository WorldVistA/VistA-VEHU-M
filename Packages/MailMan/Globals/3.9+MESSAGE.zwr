^XMB(3.9,146087,2,3409,0)="""RTN"",""YTQRQAD4"",191,0)"
^XMB(3.9,146087,2,3410,0)=" ..S NOD=""YTQASMT-SET-""_ASMT"
^XMB(3.9,146087,2,3411,0)="""RTN"",""YTQRQAD4"",192,0)"
^XMB(3.9,146087,2,3412,0)=" ..S ENTRY=$G(^XTMP(NOD,1,""entryMode""))"
^XMB(3.9,146087,2,3413,0)="""RTN"",""YTQRQAD4"",193,0)"
^XMB(3.9,146087,2,3414,0)=" ..S DTGIVE=$G(^XTMP(NOD,1,""date""))"
