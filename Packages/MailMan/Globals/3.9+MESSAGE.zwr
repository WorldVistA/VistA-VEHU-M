^XMB(3.9,146052,2,2557,0)="""RTN"",""FBUCMEA"",33,0)"
^XMB(3.9,146052,2,2558,0)=" . . . . W ?69,$E($$GET1^DIQ(162.7,FBDA_"","",24),1,10)"
^XMB(3.9,146052,2,2559,0)="""RTN"",""FBUCMEA"",34,0)"
^XMB(3.9,146052,2,2560,0)=" . . . . D KVAR^VADPT"
^XMB(3.9,146052,2,2561,0)="""RTN"",""FBUCMEA"",35,0)"
^XMB(3.9,146052,2,2562,0)=" . I 'FBOUT,$E(IOST,1,2)=""C-"" S DIR(0)=""E"" D ^DIR K DIR I 'Y S FBOUT=1 Q"
^XMB(3.9,146052,2,2563,0)="""RTN"",""FBUCMEA"",36,0)"
^XMB(3.9,146052,2,2564,0)=" ;"
^XMB(3.9,146052,2,2565,0)="""RTN"",""FBUCMEA"",37,0)"
^XMB(3.9,146052,2,2566,0)=" ; clean up"
^XMB(3.9,146052,2,2567,0)="""RTN"",""FBUCMEA"",38,0)"
^XMB(3.9,146052,2,2568,0)=" K ^TMP(""FBEX"",$J)"
^XMB(3.9,146052,2,2569,0)="""RTN"",""FBUCMEA"",39,0)"
^XMB(3.9,146052,2,2570,0)=" Q"
