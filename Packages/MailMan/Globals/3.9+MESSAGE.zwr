^XMB(3.9,146056,2,2175,0)="""RTN"",""VPRSDAHX"",14,0)"
^XMB(3.9,146056,2,2176,0)=" ; Queries called from GET^DDE, returns DLIST(#)=ien"
^XMB(3.9,146056,2,2177,0)="""RTN"",""VPRSDAHX"",15,0)"
^XMB(3.9,146056,2,2178,0)=" ; Expects context variables DFN, DSTRT, DSTOP, DMAX"
^XMB(3.9,146056,2,2179,0)="""RTN"",""VPRSDAHX"",16,0)"
^XMB(3.9,146056,2,2180,0)=" ;"
^XMB(3.9,146056,2,2181,0)="""RTN"",""VPRSDAHX"",17,0)"
^XMB(3.9,146056,2,2182,0)="HFM ; -- get V Health Factors, for Family History"
^XMB(3.9,146056,2,2183,0)="""RTN"",""VPRSDAHX"",18,0)"
^XMB(3.9,146056,2,2184,0)=" N ITEM,DATE,DA,X,VPRN S VPRN=0"
^XMB(3.9,146056,2,2185,0)="""RTN"",""VPRSDAHX"",19,0)"
^XMB(3.9,146056,2,2186,0)=" S ITEM=0 F  S ITEM=$O(^PXRMINDX(9000010.23,""PI"",+$G(DFN),ITEM)) Q:ITEM<1  D  Q:VPRN'<DMAX"
^XMB(3.9,146056,2,2187,0)="""RTN"",""VPRSDAHX"",20,0)"
^XMB(3.9,146056,2,2188,0)=" . S X=$P($G(^AUTTHF(+ITEM,0)),U) I X'[""FAMILY HISTORY"",X'[""FAMILY HX"" Q"
^XMB(3.9,146056,2,2189,0)="""RTN"",""VPRSDAHX"",21,0)"
^XMB(3.9,146056,2,2190,0)=" . S DATE=DSTRT F  S DATE=$O(^PXRMINDX(9000010.23,""PI"",+$G(DFN),ITEM,DATE)) Q:DATE<1!(DATE>DSTOP)  D  Q:VPRN'<DMAX"
^XMB(3.9,146056,2,2191,0)="""RTN"",""VPRSDAHX"",22,0)"
^XMB(3.9,146056,2,2192,0)=" .. S DA=0 F  S DA=$O(^PXRMINDX(9000010.23,""PI"",+$G(DFN),ITEM,DATE,DA)) Q:DA<1  S VPRN=VPRN+1,DLIST(VPRN)=DA_U_ITEM Q:VPRN'<DMAX"
^XMB(3.9,146056,2,2193,0)="""RTN"",""VPRSDAHX"",23,0)"
^XMB(3.9,146056,2,2194,0)=" Q"
^XMB(3.9,146056,2,2195,0)="""RTN"",""VPRSDAHX"",24,0)"
^XMB(3.9,146056,2,2196,0)=" ;"
^XMB(3.9,146056,2,2197,0)="""RTN"",""VPRSDAHX"",25,0)"
^XMB(3.9,146056,2,2198,0)="HFS ; -- get V Health Factors, for Social History"
^XMB(3.9,146056,2,2199,0)="""RTN"",""VPRSDAHX"",26,0)"
^XMB(3.9,146056,2,2200,0)=" N ITEM,DATE,DA,VPRN S VPRN=0"
^XMB(3.9,146056,2,2201,0)="""RTN"",""VPRSDAHX"",27,0)"
^XMB(3.9,146056,2,2202,0)=" S ITEM=0 F  S ITEM=$O(^PXRMINDX(9000010.23,""PI"",+$G(DFN),ITEM)) Q:ITEM<1  I $$SOCHIST(ITEM) D  Q:VPRN'<DMAX"
^XMB(3.9,146056,2,2203,0)="""RTN"",""VPRSDAHX"",28,0)"
^XMB(3.9,146056,2,2204,0)=" . S DATE=DSTRT F  S DATE=$O(^PXRMINDX(9000010.23,""PI"",+$G(DFN),ITEM,DATE)) Q:DATE<1!(DATE>DSTOP)  D  Q:VPRN'<DMAX"
^XMB(3.9,146056,2,2205,0)="""RTN"",""VPRSDAHX"",29,0)"
^XMB(3.9,146056,2,2206,0)=" .. S DA=0 F  S DA=$O(^PXRMINDX(9000010.23,""PI"",+$G(DFN),ITEM,DATE,DA)) Q:DA<1  S VPRN=VPRN+1,DLIST(VPRN)=DA_U_ITEM Q:VPRN'<DMAX"
^XMB(3.9,146056,2,2207,0)="""RTN"",""VPRSDAHX"",30,0)"
^XMB(3.9,146056,2,2208,0)=" Q"
^XMB(3.9,146056,2,2209,0)="""RTN"",""VPRSDAHX"",31,0)"
^XMB(3.9,146056,2,2210,0)="SOCHIST(IEN) ; -- find social history factors"
^XMB(3.9,146056,2,2211,0)="""RTN"",""VPRSDAHX"",32,0)"
^XMB(3.9,146056,2,2212,0)=" N X S X=$P($G(^AUTTHF(+IEN,0)),U)"
^XMB(3.9,146056,2,2213,0)="""RTN"",""VPRSDAHX"",33,0)"
^XMB(3.9,146056,2,2214,0)=" I (X[""TOBACCO"")!(X[""SMOK"") Q 1"
^XMB(3.9,146056,2,2215,0)="""RTN"",""VPRSDAHX"",34,0)"
^XMB(3.9,146056,2,2216,0)=" ;I (X[""LIVES"")!(X[""LIVING"") Q 1"
^XMB(3.9,146056,2,2217,0)="""RTN"",""VPRSDAHX"",35,0)"
^XMB(3.9,146056,2,2218,0)=" ;I (X[""RELIGIO"")!(X[""SPIRIT"") Q 1"
^XMB(3.9,146056,2,2219,0)="""RTN"",""VPRSDAHX"",36,0)"
