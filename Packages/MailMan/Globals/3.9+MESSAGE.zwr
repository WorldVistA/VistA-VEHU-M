^XMB(3.9,146037,2,2554,0)=" . S:WHICH=1 ZTRTN=""RUN^RCDPTAR1(RCDT1,RCDT2,RCEXCEL)"""
^XMB(3.9,146037,2,2555,0)="""RTN"",""RCDPTAR1"",121,0)"
^XMB(3.9,146037,2,2556,0)=" . S:WHICH=2 ZTRTN=""RUN2^RCDPTAR1(RCDNUM,RCDDT,RCEXCEL)"""
^XMB(3.9,146037,2,2557,0)="""RTN"",""RCDPTAR1"",122,0)"
^XMB(3.9,146037,2,2558,0)=" . S ZTIO=ION"
^XMB(3.9,146037,2,2559,0)="""RTN"",""RCDPTAR1"",123,0)"
^XMB(3.9,146037,2,2560,0)=" . S ZTSAVE(""*"")="""""
^XMB(3.9,146037,2,2561,0)="""RTN"",""RCDPTAR1"",124,0)"
^XMB(3.9,146037,2,2562,0)=" . S ZTDESC=""EFT TRANSACTION SUMMARY REPORT"""
^XMB(3.9,146037,2,2563,0)="""RTN"",""RCDPTAR1"",125,0)"
^XMB(3.9,146037,2,2564,0)=" . D ^%ZTLOAD"
