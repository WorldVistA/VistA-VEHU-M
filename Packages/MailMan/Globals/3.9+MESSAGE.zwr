^XMB(3.9,146099,2,3199,0)="""RTN"",""SDES2RECLLREQ"",15,0)"
^XMB(3.9,146099,2,3200,0)=" ; SDES2 CREATE RECALL REQUEST:"
^XMB(3.9,146099,2,3201,0)="""RTN"",""SDES2RECLLREQ"",16,0)"
^XMB(3.9,146099,2,3202,0)=" ; SDINPUT(""DFN"") = POINTER TO PATIENT (#2) FILE (required)"
^XMB(3.9,146099,2,3203,0)="""RTN"",""SDES2RECLLREQ"",17,0)"
^XMB(3.9,146099,2,3204,0)=" ; SDINPUT(""ACCESSION NUMBER"") = ACCESSION # (FREE TEXT)"
^XMB(3.9,146099,2,3205,0)="""RTN"",""SDES2RECLLREQ"",18,0)"
^XMB(3.9,146099,2,3206,0)=" ; SDINPUT(""COMMENT"""") = COMMENT (FREE TEXT)"
^XMB(3.9,146099,2,3207,0)="""RTN"",""SDES2RECLLREQ"",19,0)"
^XMB(3.9,146099,2,3208,0)=" ; SDINPUT(""FASTING"") = Labs: FASTING ; NON-FASTING ; @ - None (required)"
^XMB(3.9,146099,2,3209,0)="""RTN"",""SDES2RECLLREQ"",20,0)"
^XMB(3.9,146099,2,3210,0)=" ; SDINPUT(APPOINTMENT TYPE"") = (required) ; Name of the RECALL REMINDERS APPT TYPE (#403.51) FILE"
^XMB(3.9,146099,2,3211,0)="""RTN"",""SDES2RECLLREQ"",21,0)"
^XMB(3.9,146099,2,3212,0)=" ; SDINPUT(""RECALL PROVIDER IEN"") = RECALL PROVIDER - POINTER TO RECALL REMINDERS PROVIDERS (#403.54) FILE (required)"
^XMB(3.9,146099,2,3213,0)="""RTN"",""SDES2RECLLREQ"",22,0)"
^XMB(3.9,146099,2,3214,0)=" ; SDINPUT(""CLINIC IEN"") = CLINIC POINTER TO HOSPITAL LOCATION (#44) FILE (required)"
^XMB(3.9,146099,2,3215,0)="""RTN"",""SDES2RECLLREQ"",23,0)"
^XMB(3.9,146099,2,3216,0)=" ; SDINPUT(""APPOINTMENT LENGTH"") = LENGTH OF APPOINTMENT NUMERIC BETWEEN 10 AND 240."
^XMB(3.9,146099,2,3217,0)="""RTN"",""SDES2RECLLREQ"",24,0)"
^XMB(3.9,146099,2,3218,0)=" ; SDINPUT(""RECALL DATE"") = Recall date in ISO8601 date format (no time). e.g., CCYY-MM-DD (required)"
^XMB(3.9,146099,2,3219,0)="""RTN"",""SDES2RECLLREQ"",25,0)"
