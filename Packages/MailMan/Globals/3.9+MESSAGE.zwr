^XMB(3.9,146009,2,337,0)="""RTN"",""XUIAMNPB"",36,0)"
^XMB(3.9,146009,2,338,0)=" .S XUIAM(""samAccountName"")=XUARR(200,XUDUZ_"","",501.1,""I"") ;network username"
^XMB(3.9,146009,2,339,0)="""RTN"",""XUIAMNPB"",37,0)"
^XMB(3.9,146009,2,340,0)=" .;"
^XMB(3.9,146009,2,341,0)="""RTN"",""XUIAMNPB"",38,0)"
^XMB(3.9,146009,2,342,0)=" .S XUIAM(""secId"")=XUARR(200,XUDUZ_"","",205.1,""I"") ;security id"
^XMB(3.9,146009,2,343,0)="""RTN"",""XUIAMNPB"",39,0)"
