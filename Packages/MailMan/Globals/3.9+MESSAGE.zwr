^XMB(3.9,146052,2,1333,0)="""RTN"",""FBAAPH"",4,0)"
^XMB(3.9,146052,2,1334,0)=" D DT^DICRW"
^XMB(3.9,146052,2,1335,0)="""RTN"",""FBAAPH"",5,0)"
^XMB(3.9,146052,2,1336,0)="RD K FBAANQ,FB,FBTRX W !! S FBAAOUT=0,DIC=""^FBAAC("",DIC(0)=""AEQMNZ"",DIC(""A"")=""Select Fee Patient: "" D ^DIC K DIC(""A"") G Q:X=""^""!(X=""""),RD:Y<0 S DFN=+Y,FBNAME=Y(0,0)"
^XMB(3.9,146052,2,1337,0)="""RTN"",""FBAAPH"",6,0)"
