^XMB(3.9,146020,2,337,0)="""RTN"",""MPIFVER"",47,0)"
^XMB(3.9,146020,2,338,0)=" Q DFN"
^XMB(3.9,146020,2,339,0)="""RTN"",""MPIFVER"",48,0)"
^XMB(3.9,146020,2,340,0)="DISPLAY ;"
^XMB(3.9,146020,2,341,0)="""RTN"",""MPIFVER"",49,0)"
^XMB(3.9,146020,2,342,0)=" N CNT1,NAME,FNAME,MNAME,SCORE,SSN,DOB,ICN,SEX,LNAME,M,XMPIVER,EFLG,ECNT,DOD,DODFLG"
^XMB(3.9,146020,2,343,0)="""RTN"",""MPIFVER"",50,0)"
^XMB(3.9,146020,2,344,0)=" S CNT1=0,EFLG=0,DODFLG=0"
^XMB(3.9,146020,2,345,0)="""RTN"",""MPIFVER"",51,0)"
^XMB(3.9,146020,2,346,0)=" F  S CNT1=$O(RESULTS(CNT1)) Q:+CNT1=0  D"
^XMB(3.9,146020,2,347,0)="""RTN"",""MPIFVER"",52,0)"
^XMB(3.9,146020,2,348,0)=" . N DOD"
^XMB(3.9,146020,2,349,0)="""RTN"",""MPIFVER"",53,0)"
^XMB(3.9,146020,2,350,0)=" . S FNAME=$G(RESULTS(CNT1,""FirstName"")),SSN=$G(RESULTS(CNT1,""SSN""))"
^XMB(3.9,146020,2,351,0)="""RTN"",""MPIFVER"",54,0)"
^XMB(3.9,146020,2,352,0)=" . S DOB=$G(RESULTS(CNT1,""DOB"")),ICN=$G(RESULTS(CNT1,""ICN""))"
^XMB(3.9,146020,2,353,0)="""RTN"",""MPIFVER"",55,0)"
^XMB(3.9,146020,2,354,0)=" . ; Story 722746 (elz) need dod if there is one and set flag"
^XMB(3.9,146020,2,355,0)="""RTN"",""MPIFVER"",56,0)"
^XMB(3.9,146020,2,356,0)=" . I $D(RESULTS(CNT1,""DOD"")) S DOD=RESULTS(CNT1,""DOD""),DODFLG=1"
^XMB(3.9,146020,2,357,0)="""RTN"",""MPIFVER"",57,0)"
^XMB(3.9,146020,2,358,0)=" . S SEX=$G(RESULTS(CNT1,""Gender"")),LNAME=$G(RESULTS(CNT1,""Surname""))"
^XMB(3.9,146020,2,359,0)="""RTN"",""MPIFVER"",58,0)"
^XMB(3.9,146020,2,360,0)=" . S MNAME=$G(RESULTS(CNT1,""MiddleName""))"
^XMB(3.9,146020,2,361,0)="""RTN"",""MPIFVER"",59,0)"
^XMB(3.9,146020,2,362,0)=" . S SCORE=+$G(RESULTS(CNT1,""Score"")),NAME=LNAME_"",""_FNAME_"" ""_MNAME"
^XMB(3.9,146020,2,363,0)="""RTN"",""MPIFVER"",60,0)"
^XMB(3.9,146020,2,364,0)=" . I ICN="""",($D(RESULTS(CNT1,""IDS""))) D"
^XMB(3.9,146020,2,365,0)="""RTN"",""MPIFVER"",61,0)"
^XMB(3.9,146020,2,366,0)=" .. S EFLG=1,ECNT=0 F  S ECNT=$O(RESULTS(CNT1,""IDS"",ECNT)) Q:+ECNT=0  D"
^XMB(3.9,146020,2,367,0)="""RTN"",""MPIFVER"",62,0)"
^XMB(3.9,146020,2,368,0)=" ... I $G(RESULTS(CNT1,""IDS"",ECNT,""SOURCE""))=""200DOD"" S ICN=$G(RESULTS(CNT1,""IDS"",ECNT,""ID""))  ;Get EDIPI instead of ICN if from DoD"
^XMB(3.9,146020,2,369,0)="""RTN"",""MPIFVER"",63,0)"
^XMB(3.9,146020,2,370,0)=" . S M=$S(SCORE>=ALTRSHLD:""E"",1:""P"")"
^XMB(3.9,146020,2,371,0)="""RTN"",""MPIFVER"",64,0)"
^XMB(3.9,146020,2,372,0)=" . ;Rearranging array for sectional view display"
^XMB(3.9,146020,2,373,0)="""RTN"",""MPIFVER"",65,0)"
^XMB(3.9,146020,2,374,0)=" . ;Story 722746 (elz) add ""*"" to ICN for display if deceased"
^XMB(3.9,146020,2,375,0)="""RTN"",""MPIFVER"",66,0)"
^XMB(3.9,146020,2,376,0)=" . S XMPIVER(""MPIVER"",M,SCORE,CNT1)=NAME_""^""_SSN_""^""_DOB_""^""_SEX_""^""_$S($D(DOD):""*"",1:"""")_ICN"
^XMB(3.9,146020,2,377,0)="""RTN"",""MPIFVER"",67,0)"
^XMB(3.9,146020,2,378,0)="DISP2 ;"
^XMB(3.9,146020,2,379,0)="""RTN"",""MPIFVER"",68,0)"
^XMB(3.9,146020,2,380,0)=" N DIR,DA,DR,Y,X,DATA,ENOUGH,COUNT,I,SCORE,CNTR"
^XMB(3.9,146020,2,381,0)="""RTN"",""MPIFVER"",69,0)"
^XMB(3.9,146020,2,382,0)=" S COUNT=0"
^XMB(3.9,146020,2,383,0)="""RTN"",""MPIFVER"",70,0)"
^XMB(3.9,146020,2,384,0)=" W @IOF"
^XMB(3.9,146020,2,385,0)="""RTN"",""MPIFVER"",71,0)"
^XMB(3.9,146020,2,386,0)=" F I=""E"",""P"" D"
^XMB(3.9,146020,2,387,0)="""RTN"",""MPIFVER"",72,0)"
^XMB(3.9,146020,2,388,0)=" . I $D(XMPIVER(""MPIVER"",I)) D HDR($S(I=""E"":"""",I=""P"":"" POTENTIAL"",1:""""))"
^XMB(3.9,146020,2,389,0)="""RTN"",""MPIFVER"",73,0)"
^XMB(3.9,146020,2,390,0)=" . S SCORE=9999999 F  S SCORE=$O(XMPIVER(""MPIVER"",I,SCORE),-1) Q:SCORE=""""  D"
^XMB(3.9,146020,2,391,0)="""RTN"",""MPIFVER"",74,0)"
^XMB(3.9,146020,2,392,0)=" .. S CNTR=0 F  S CNTR=$O(XMPIVER(""MPIVER"",I,SCORE,CNTR)) Q:CNTR=""""  D"
^XMB(3.9,146020,2,393,0)="""RTN"",""MPIFVER"",75,0)"
^XMB(3.9,146020,2,394,0)=" ... S COUNT=COUNT+1"
^XMB(3.9,146020,2,395,0)="""RTN"",""MPIFVER"",76,0)"
^XMB(3.9,146020,2,396,0)=" ... S XMPIVER(""MPIVER"",I,SCORE,CNTR,COUNT)="""""
^XMB(3.9,146020,2,397,0)="""RTN"",""MPIFVER"",77,0)"
^XMB(3.9,146020,2,398,0)=" ... S DATA=$G(XMPIVER(""MPIVER"",I,SCORE,CNTR))"
^XMB(3.9,146020,2,399,0)="""RTN"",""MPIFVER"",78,0)"
^XMB(3.9,146020,2,400,0)=" ... D HDR1"
^XMB(3.9,146020,2,401,0)="""RTN"",""MPIFVER"",79,0)"
^XMB(3.9,146020,2,402,0)=" ... ; Story 722746 (elz) increase space to allow for * for dod patients"
^XMB(3.9,146020,2,403,0)="""RTN"",""MPIFVER"",80,0)"
^XMB(3.9,146020,2,404,0)=" ... W !,COUNT_"") "",?3,$P(DATA,""^"",5),?22,$P(DATA,""^""),?53,$P(DATA,""^"",2),?64,$$FMTE^XLFDT($P(DATA,""^"",3),2),?76,$P(DATA,""^"",4)"
^XMB(3.9,146020,2,405,0)="""RTN"",""MPIFVER"",81,0)"
^XMB(3.9,146020,2,406,0)=" ; Story 722746 (elz) if any are deceased, display message"
^XMB(3.9,146020,2,407,0)="""RTN"",""MPIFVER"",82,0)"
^XMB(3.9,146020,2,408,0)=" I DODFLG W !!,""*Candidate list includes a deceased patient"""
^XMB(3.9,146020,2,409,0)="""RTN"",""MPIFVER"",83,0)"
^XMB(3.9,146020,2,410,0)=" S XMPIVER(""COUNT"")=$G(COUNT)"
