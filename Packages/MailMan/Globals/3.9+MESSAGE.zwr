^XMB(3.9,146087,2,1659,0)="""RTN"",""YTQREST"",10,0)"
^XMB(3.9,146087,2,1660,0)=" ;"
^XMB(3.9,146087,2,1661,0)="""RTN"",""YTQREST"",11,0)"
^XMB(3.9,146087,2,1662,0)="QADMIN(HTTPRSP,HTTPREQ) ; questionnaire administration resources"
