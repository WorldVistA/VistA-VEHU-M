^XMB(3.9,146047,2,1885,0)="""RTN"",""IBCNEHLM"",115,0)"
^XMB(3.9,146047,2,1886,0)=" S ^TMP(""HLS"",$J,2)=VMFE_HLFS_""CE"""
^XMB(3.9,146047,2,1887,0)="""RTN"",""IBCNEHLM"",116,0)"
^XMB(3.9,146047,2,1888,0)=" ;"
^XMB(3.9,146047,2,1889,0)="""RTN"",""IBCNEHLM"",117,0)"
^XMB(3.9,146047,2,1890,0)=" ; Set the ZRR segment"
^XMB(3.9,146047,2,1891,0)="""RTN"",""IBCNEHLM"",118,0)"
^XMB(3.9,146047,2,1892,0)=" ;IB*549 Added line to send null values for removed fields so msg layout remains unchanged"
^XMB(3.9,146047,2,1893,0)="""RTN"",""IBCNEHLM"",119,0)"
^XMB(3.9,146047,2,1894,0)=" S (CNTCPH,CNTCEM,CNTCNM)="""""
^XMB(3.9,146047,2,1895,0)="""RTN"",""IBCNEHLM"",120,0)"
^XMB(3.9,146047,2,1896,0)=" S VZRR=""ZRR""_HLFS_""1""_HLFS_TAXID_HLFS_HLFS_$$HLNAME^HLFNC(CNTCNM,$E(HLECH))_""^C""_HLFS"
^XMB(3.9,146047,2,1897,0)="""RTN"",""IBCNEHLM"",121,0)"
^XMB(3.9,146047,2,1898,0)=" S VZRR=VZRR_CNTCPH_$E(HLECH)_$E(HLECH)_$E(HLECH)_CNTCEM_HLFS_FRSH_HLFS_IHLP_HLFS_IHLT_$E(HLECH)_IHLS_HLFS_INACT_HLFS_IVER"
^XMB(3.9,146047,2,1899,0)="""RTN"",""IBCNEHLM"",122,0)"
