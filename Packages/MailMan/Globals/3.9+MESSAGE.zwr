^XMB(3.9,146011,2,890,0)="PARK(PSODA) ;park function ; Called from PSOPRK and edit for Outpatient and from PSORPC01 for Park from CPRS"
^XMB(3.9,146011,2,891,0)="""RTN"",""PSOPRKA"",10,0)"
^XMB(3.9,146011,2,892,0)=" S (DA,PSDA)=PSODA"
^XMB(3.9,146011,2,893,0)="""RTN"",""PSOPRKA"",11,0)"
^XMB(3.9,146011,2,894,0)=" N RXF,NEXTPOSS,BPMW,PRKMW,PSOOLDFILLDT"
^XMB(3.9,146011,2,895,0)="""RTN"",""PSOPRKA"",12,0)"
^XMB(3.9,146011,2,896,0)=" I $P($G(^PSRX(DA,""STA"")),""^"")'=0,$P($G(^PSRX(DA,""STA"")),""^"")'=5 Q  ; can't park unless active"
^XMB(3.9,146011,2,897,0)="""RTN"",""PSOPRKA"",13,0)"
^XMB(3.9,146011,2,898,0)=" S RSDT=$S($P(^PSRX(DA,2),""^"",13):$P(^PSRX(DA,3),""^""),1:""@""),(PSUS,ACT,RXF,RFN,I)=0 F  S I=$O(^PSRX(DA,1,I)) Q:'I  D"
^XMB(3.9,146011,2,899,0)="""RTN"",""PSOPRKA"",14,0)"
^XMB(3.9,146011,2,900,0)=" .S RXF=I,RFN=RFN+1 S:RFN=1 RSDT=$S('$P(^PSRX(DA,1,I,0),""^"",18):$P(^PSRX(DA,2),""^"",2),1:$P(^PSRX(DA,1,I,0),""^""))"
^XMB(3.9,146011,2,901,0)="""RTN"",""PSOPRKA"",15,0)"
^XMB(3.9,146011,2,902,0)=" .I RFN>1,'$P(^PSRX(DA,1,I,0),""^"",18) S RSDT=$P(^PSRX(DA,1,RXF-1,0),""^"") Q"
^XMB(3.9,146011,2,903,0)="""RTN"",""PSOPRKA"",16,0)"
^XMB(3.9,146011,2,904,0)=" .S:RFN>1 RSDT=$P(^PSRX(DA,1,RXF,0),""^"")"
^XMB(3.9,146011,2,905,0)="""RTN"",""PSOPRKA"",17,0)"
^XMB(3.9,146011,2,906,0)=" ; FILL DATE (FLD 22),2;13=RELEASED STATUS (FLD 100),LAST DISPENSED DT (FLD 101)"
^XMB(3.9,146011,2,907,0)="""RTN"",""PSOPRKA"",18,0)"
^XMB(3.9,146011,2,908,0)=" S PSOOLDFILLDT=$S(RXF:$P(^PSRX(DA,1,RXF,0),U,1),1:$P(^PSRX(DA,2),U,2))"
^XMB(3.9,146011,2,909,0)="""RTN"",""PSOPRKA"",19,0)"
^XMB(3.9,146011,2,910,0)=" S NEXTPOSS=$P(^PSRX(DA,3),""^"",2)"
^XMB(3.9,146011,2,911,0)="""RTN"",""PSOPRKA"",20,0)"
^XMB(3.9,146011,2,912,0)=" S BPMW=$S('RXF&$G(PSOTOPK)&($P($G(PSORXED(""RX0"")),U,11)'=""""):$P(PSORXED(""RX0""),U,11),'RXF:$P(^PSRX(DA,0),U,11),RXF:$P(^PSRX(DA,1,RXF,0),U,2),1:"""")"
^XMB(3.9,146011,2,913,0)="""RTN"",""PSOPRKA"",21,0)"
^XMB(3.9,146011,2,914,0)=" I 'RXF,'$P(^PSRX(DA,2),""^"",13) S NEXTPOSS=$P(^PSRX(DA,2),""^"",2) ; SET NEXT POSSIBLE TO FILL DATE THAT IS BEING BLANKED OUT WHEN PARKED"
^XMB(3.9,146011,2,915,0)="""RTN"",""PSOPRKA"",22,0)"
^XMB(3.9,146011,2,916,0)=" S DIE=""^PSRX("",DR=$S('RXF&($$CHKPRKORIG(DA)):""22///@;"",1:"""")_""100///0;101///""_RSDT_"";102///""_NEXTPOSS D ^DIE Q:$D(Y)"
^XMB(3.9,146011,2,917,0)="""RTN"",""PSOPRKA"",23,0)"
^XMB(3.9,146011,2,918,0)=" S ^PSRX(DA,""PARK"")=1,^PSRX(""APARK"",1,DA)="""",$P(^PSRX(DA,""STA""),""^"")=0"
^XMB(3.9,146011,2,919,0)="""RTN"",""PSOPRKA"",24,0)"
^XMB(3.9,146011,2,920,0)=" D:$D(PSORX(""PSOL"")) RMP(DA)"
