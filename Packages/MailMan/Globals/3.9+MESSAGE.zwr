^XMB(3.9,146017,2,2341,0)="""RTN"",""SDES2GETCLINAVL"",12,0)"
^XMB(3.9,146017,2,2342,0)=" ; SDINPUT(""CREDIT AMIS"",CREDIT AMIS CODE)=""""  - can have multiple credit amis codes"
^XMB(3.9,146017,2,2343,0)="""RTN"",""SDES2GETCLINAVL"",13,0)"
