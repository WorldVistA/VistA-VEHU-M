^XMB(3.9,146013,2,305,0)="""QUES"",""XPZ2"",""M"")"
^XMB(3.9,146013,2,306,0)="D XPZ2^XPDIQ"
^XMB(3.9,146013,2,307,0)="""RTN"")"
^XMB(3.9,146013,2,308,0)=18
^XMB(3.9,146013,2,309,0)="""RTN"",""ORKPS"")"
^XMB(3.9,146013,2,310,0)="0^2^B104632974"
^XMB(3.9,146013,2,311,0)="""RTN"",""ORKPS"",1,0)"
^XMB(3.9,146013,2,312,0)="ORKPS ; slc/CLA - Order checking support procedures for medications ;12/29/17  11:58"
^XMB(3.9,146013,2,313,0)="""RTN"",""ORKPS"",2,0)"
^XMB(3.9,146013,2,314,0)=" ;;3.0;ORDER ENTRY/RESULTS REPORTING;**6,32,74,94,123,141,190,232,316,272,346,345,382,469**;Dec 17, 1997;Build 0"
^XMB(3.9,146013,2,315,0)="""RTN"",""ORKPS"",3,0)"
^XMB(3.9,146013,2,316,0)=" Q"
^XMB(3.9,146013,2,317,0)="""RTN"",""ORKPS"",4,0)"
^XMB(3.9,146013,2,318,0)="CHECK(YY,DFN,MED,OI,ORKDG,OROIL,ORSUPPLY,ORIVTYPE,ORIVRAN,ORDODSG) ; return drug order checks"
^XMB(3.9,146013,2,319,0)="""RTN"",""ORKPS"",5,0)"
^XMB(3.9,146013,2,320,0)=" ;YY:    returned array of data"
^XMB(3.9,146013,2,321,0)="""RTN"",""ORKPS"",6,0)"
^XMB(3.9,146013,2,322,0)=" ;DFN:   patient id"
^XMB(3.9,146013,2,323,0)="""RTN"",""ORKPS"",7,0)"
^XMB(3.9,146013,2,324,0)=" ;MED:   drug ien [file #50] ^ generic name [file #50]"
^XMB(3.9,146013,2,325,0)="""RTN"",""ORKPS"",8,0)"
^XMB(3.9,146013,2,326,0)=" ;OI:    orderable item ien [file #101.43]"
^XMB(3.9,146013,2,327,0)="""RTN"",""ORKPS"",9,0)"
^XMB(3.9,146013,2,328,0)=" ;ORKDG: display group (should be PSI, PSIV, PSO or PSH)"
^XMB(3.9,146013,2,329,0)="""RTN"",""ORKPS"",10,0)"
^XMB(3.9,146013,2,330,0)=" ;OROIL: list of items ordered"
^XMB(3.9,146013,2,331,0)="""RTN"",""ORKPS"",11,0)"
^XMB(3.9,146013,2,332,0)=" ;ORSUPPLY: pharmacy orderable item ien [file #50.7] if it resolves to one or more supply items"
^XMB(3.9,146013,2,333,0)="""RTN"",""ORKPS"",12,0)"
^XMB(3.9,146013,2,334,0)=" ;          0 if the pharmacy orderable item does not resolve to any supply items"
^XMB(3.9,146013,2,335,0)="""RTN"",""ORKPS"",13,0)"
^XMB(3.9,146013,2,336,0)=" ;ORIVTYPE: the MED type as sent from Infusion Order Dialog"
^XMB(3.9,146013,2,337,0)="""RTN"",""ORKPS"",14,0)"
^XMB(3.9,146013,2,338,0)=" ;          A for additive"
^XMB(3.9,146013,2,339,0)="""RTN"",""ORKPS"",15,0)"
^XMB(3.9,146013,2,340,0)=" ;          B for base"
^XMB(3.9,146013,2,341,0)="""RTN"",""ORKPS"",16,0)"
^XMB(3.9,146013,2,342,0)=" ;ORIVRAN: FLAG THAT DENOTES IF ALL COMPONENTS OF INFUSION ORDER HAVE ALREADY BEEN PROCESSED"
^XMB(3.9,146013,2,343,0)="""RTN"",""ORKPS"",17,0)"
^XMB(3.9,146013,2,344,0)=" ;         1 FOR ALREADY PROCESSED"
^XMB(3.9,146013,2,345,0)="""RTN"",""ORKPS"",18,0)"
^XMB(3.9,146013,2,346,0)=" ;         EMPTY STRING FOR NOT YET PROCESSED"
^XMB(3.9,146013,2,347,0)="""RTN"",""ORKPS"",19,0)"
^XMB(3.9,146013,2,348,0)=" ;ORDODSG: FLAG THAT DENOTES IF DOSAGE CHECKS SHOULD BE PERFORMED"
^XMB(3.9,146013,2,349,0)="""RTN"",""ORKPS"",20,0)"
^XMB(3.9,146013,2,350,0)=" ;         1 FOR PERFORM DOSAGE CHECKS"
^XMB(3.9,146013,2,351,0)="""RTN"",""ORKPS"",21,0)"
^XMB(3.9,146013,2,352,0)=" ;         0 FOR DO NOT PERFORM DOSAGE CHECKS"
^XMB(3.9,146013,2,353,0)="""RTN"",""ORKPS"",22,0)"
^XMB(3.9,146013,2,354,0)=" ; returned info: varies for ^TMP($J x-ref - refer to listings below"
^XMB(3.9,146013,2,355,0)="""RTN"",""ORKPS"",23,0)"
^XMB(3.9,146013,2,356,0)=" N OR2CRITN,OR2CRITF,OR2CRITD,OR2SIGN,OR2SIGF,OR2SIGD,OR2DUPN,OR2DUPF,OR2DUPD,OR2DUPCN,OR2DUPCF,OR2DUPCD"
^XMB(3.9,146013,2,357,0)="""RTN"",""ORKPS"",24,0)"
^XMB(3.9,146013,2,358,0)=" N ORPHDG,ORKSOIA,ORDOCHKS"
^XMB(3.9,146013,2,359,0)="""RTN"",""ORKPS"",25,0)"
^XMB(3.9,146013,2,360,0)=" D PARAMS^ORKCHK6(""CRITICAL DRUG INTERACTION"",.OR2CRITN,.OR2CRITF,.OR2CRITD)"
^XMB(3.9,146013,2,361,0)="""RTN"",""ORKPS"",26,0)"
^XMB(3.9,146013,2,362,0)=" D PARAMS^ORKCHK6(""SIGNIFICANT DRUG INTERACTION"",.OR2SIGN,.OR2SIGF,.OR2SIGD)"
^XMB(3.9,146013,2,363,0)="""RTN"",""ORKPS"",27,0)"
^XMB(3.9,146013,2,364,0)=" D PARAMS^ORKCHK6(""DUPLICATE DRUG THERAPY"",.OR2DUPCN,.OR2DUPCF,.OR2DUPCD)"
^XMB(3.9,146013,2,365,0)="""RTN"",""ORKPS"",28,0)"
^XMB(3.9,146013,2,366,0)=" N ORDFN,ORKA,ORPTY,ORPHOI,OROILI,ORKAI S ORDFN=DFN"
^XMB(3.9,146013,2,367,0)="""RTN"",""ORKPS"",29,0)"
^XMB(3.9,146013,2,368,0)=" S ORPHOI=+$P($G(^ORD(101.43,+OI,0)),U,2)"
^XMB(3.9,146013,2,369,0)="""RTN"",""ORKPS"",30,0)"
^XMB(3.9,146013,2,370,0)=" S ORPTY=$S($G(ORKDG)=""PSI"":""I;"",$G(ORKDG)=""PSIV"":""I;"",$G(ORKDG)=""PSO"":""O;"",$G(ORKDG)=""PSH"":""O;"",1:""O;"")"
^XMB(3.9,146013,2,371,0)="""RTN"",""ORKPS"",31,0)"
^XMB(3.9,146013,2,372,0)=" S ORPHDG=$S(ORKDG=""PSI"":""U"",ORKDG=""PSIV"":""I"",ORKDG=""PSO"":""O"",ORKDG=""PSH"":""N"",1:"""")"
^XMB(3.9,146013,2,373,0)="""RTN"",""ORKPS"",32,0)"
^XMB(3.9,146013,2,374,0)=" I $G(ORIVTYPE)'=""A"" D  Q:'ORDOCHKS  ; Don't do checks if pharmacy does not want us to"
^XMB(3.9,146013,2,375,0)="""RTN"",""ORKPS"",33,0)"
^XMB(3.9,146013,2,376,0)=" .S ORDOCHKS=$$PRE^PSSDSAPK(ORPHOI,ORPHDG)"
^XMB(3.9,146013,2,377,0)="""RTN"",""ORKPS"",34,0)"
^XMB(3.9,146013,2,378,0)=" .S:'ORDODSG ORDODSG=ORDOCHKS"
^XMB(3.9,146013,2,379,0)="""RTN"",""ORKPS"",35,0)"
^XMB(3.9,146013,2,380,0)=" S:$G(ORIVTYPE)=""A"" ORDODSG=1"
^XMB(3.9,146013,2,381,0)="""RTN"",""ORKPS"",36,0)"
^XMB(3.9,146013,2,382,0)=" I +MED,('ORIVRAN) S ORKA(1)=MED_U_$$GETPSNM(+MED),ORKAI=1"
^XMB(3.9,146013,2,383,0)="""RTN"",""ORKPS"",37,0)"
^XMB(3.9,146013,2,384,0)=" ;ADD ALL COMPONENTS OF IV ORDER SO WE ONLY HAVE TO DO A SINGLE PRE CALL"
^XMB(3.9,146013,2,385,0)="""RTN"",""ORKPS"",38,0)"
^XMB(3.9,146013,2,386,0)=" I ORKDG=""PSIV"",('ORIVRAN) D"
^XMB(3.9,146013,2,387,0)="""RTN"",""ORKPS"",39,0)"
^XMB(3.9,146013,2,388,0)=" .S ORIVRAN=1,OROILI=0 F  S OROILI=$O(OROIL(OROILI)) Q:'OROILI  D"
^XMB(3.9,146013,2,389,0)="""RTN"",""ORKPS"",40,0)"
^XMB(3.9,146013,2,390,0)=" ..N OR2OI,OR2PSOI,OR2PHDG"
^XMB(3.9,146013,2,391,0)="""RTN"",""ORKPS"",41,0)"
^XMB(3.9,146013,2,392,0)=" ..I 'OROIL(OROILI) Q"
^XMB(3.9,146013,2,393,0)="""RTN"",""ORKPS"",42,0)"
^XMB(3.9,146013,2,394,0)=" ..I +OROIL(OROILI)=OI Q"
^XMB(3.9,146013,2,395,0)="""RTN"",""ORKPS"",43,0)"
^XMB(3.9,146013,2,396,0)=" ..S OR2OI=+OROIL(OROILI)"
^XMB(3.9,146013,2,397,0)="""RTN"",""ORKPS"",44,0)"
^XMB(3.9,146013,2,398,0)=" ..S OR2PSOI=+$P($G(^ORD(101.43,+OR2OI,0)),U,2)"
^XMB(3.9,146013,2,399,0)="""RTN"",""ORKPS"",45,0)"
^XMB(3.9,146013,2,400,0)=" ..S OR2PHDG=$P(OROIL(OROILI),U,2)"
^XMB(3.9,146013,2,401,0)="""RTN"",""ORKPS"",46,0)"
^XMB(3.9,146013,2,402,0)=" ..S OR2PHDG=$S(OR2PHDG=""PSI"":""U"",OR2PHDG=""PSIV"":""I"",OR2PHDG=""PSO"":""O"",OR2PHDG=""PSH"":""N"",1:"""")"
^XMB(3.9,146013,2,403,0)="""RTN"",""ORKPS"",47,0)"
^XMB(3.9,146013,2,404,0)=" ..Q:OR2PHDG'=""I"""
^XMB(3.9,146013,2,405,0)="""RTN"",""ORKPS"",48,0)"
^XMB(3.9,146013,2,406,0)=" ..I $P($P(OROIL(OROILI),U,3),"";"")=""B"",$$PRE^PSSDSAPK(OR2PSOI,OR2PHDG)=0 Q"
^XMB(3.9,146013,2,407,0)="""RTN"",""ORKPS"",49,0)"
^XMB(3.9,146013,2,408,0)=" ..I $P($P(OROIL(OROILI),U,3),"";"")=""B"",$P($P(OROIL(OROILI),U,3),"";"",2)="""",$G(ORREN)=1 D"
^XMB(3.9,146013,2,409,0)="""RTN"",""ORKPS"",50,0)"
^XMB(3.9,146013,2,410,0)=" ...N ORVOLID,ORVOLVAL S ORVOLVAL="""",ORVOLID=$O(^OR(100,+$G(ORIFN),4.5,""ID"",""VOLUME"",""""))"
^XMB(3.9,146013,2,411,0)="""RTN"",""ORKPS"",51,0)"
^XMB(3.9,146013,2,412,0)=" ...I ORVOLID>0 S ORVOLVAL=$G(^OR(100,+$G(ORIFN),4.5,ORVOLID,1))"
^XMB(3.9,146013,2,413,0)="""RTN"",""ORKPS"",52,0)"
^XMB(3.9,146013,2,414,0)=" ...S OROIL(OROILI)=OROIL(OROILI)_ORVOLVAL"
^XMB(3.9,146013,2,415,0)="""RTN"",""ORKPS"",53,0)"
^XMB(3.9,146013,2,416,0)=" ..N ORUSID"
^XMB(3.9,146013,2,417,0)="""RTN"",""ORKPS"",54,0)"
^XMB(3.9,146013,2,418,0)=" ..S ORUSID=$$USID^ORWDXC(OROIL(OROILI))"
^XMB(3.9,146013,2,419,0)="""RTN"",""ORKPS"",55,0)"
^XMB(3.9,146013,2,420,0)=" ..S ORKAI=ORKAI+1,ORKA(ORKAI)=$P(ORUSID,U,4)_U_$$GETPSNM($P(ORUSID,U,4))"
^XMB(3.9,146013,2,421,0)="""RTN"",""ORKPS"",56,0)"
^XMB(3.9,146013,2,422,0)=" D:$D(ORKA) CPRS^PSODDPR4(ORDFN,""OROCOUT""_ORPTY,.ORKA,ORPTY_+$G(^OR(100,+$G(ORIFN),4)))"
^XMB(3.9,146013,2,423,0)="""RTN"",""ORKPS"",57,0)"
^XMB(3.9,146013,2,424,0)=" I +ORSUPPLY D"
^XMB(3.9,146013,2,425,0)="""RTN"",""ORKPS"",58,0)"
^XMB(3.9,146013,2,426,0)=" .S ORKSOIA(+ORSUPPLY)=$G(ORIFN)"
^XMB(3.9,146013,2,427,0)="""RTN"",""ORKPS"",59,0)"
^XMB(3.9,146013,2,428,0)=" .D CPRS^PSODDPR8(ORDFN,""OROCOUT""_ORPTY,.ORKSOIA,ORPHDG_"";""_+$G(^OR(100,+$G(ORNUM),4)),$S($D(ORKA):1,1:""""))"
^XMB(3.9,146013,2,429,0)="""RTN"",""ORKPS"",60,0)"
^XMB(3.9,146013,2,430,0)=" I $D(ORKA)!($D(ORKSOIA))!(ORIVRAN) D"
^XMB(3.9,146013,2,431,0)="""RTN"",""ORKPS"",61,0)"
^XMB(3.9,146013,2,432,0)=" .S:OR2CRITF_OR2SIGF_OR2DUPCF[""E"" ^TMP($J,""ORENHCHK"")=1"
^XMB(3.9,146013,2,433,0)="""RTN"",""ORKPS"",62,0)"
^XMB(3.9,146013,2,434,0)=" .D PROCESS^ORKPS1(OI,ORDFN,ORKDG,+ORSUPPLY_U_+MED,""OROCOUT""_ORPTY)"
^XMB(3.9,146013,2,435,0)="""RTN"",""ORKPS"",63,0)"
^XMB(3.9,146013,2,436,0)=" Q"
^XMB(3.9,146013,2,437,0)="""RTN"",""ORKPS"",64,0)"
^XMB(3.9,146013,2,438,0)="CHKSESS(YY,DFN,MED,OI,ORKPDATA,ORKDG,ORSUPPLY,ORIVTYPE) ; return drug order checks for session"
^XMB(3.9,146013,2,439,0)="""RTN"",""ORKPS"",65,0)"
^XMB(3.9,146013,2,440,0)=" ;ORSUPPLY: pharmacy orderable item ien [file #50.7] if it resolves to one or more supply items"
^XMB(3.9,146013,2,441,0)="""RTN"",""ORKPS"",66,0)"
^XMB(3.9,146013,2,442,0)=" ;          0 if the pharmacy orderable item does not resolve to any supply items"
^XMB(3.9,146013,2,443,0)="""RTN"",""ORKPS"",67,0)"
^XMB(3.9,146013,2,444,0)=" ;ORIVTYPE: the MED type as sent from Infusion Order Dialog"
^XMB(3.9,146013,2,445,0)="""RTN"",""ORKPS"",68,0)"
^XMB(3.9,146013,2,446,0)=" ;          A for additive"
^XMB(3.9,146013,2,447,0)="""RTN"",""ORKPS"",69,0)"
^XMB(3.9,146013,2,448,0)=" ;          B for base"
^XMB(3.9,146013,2,449,0)="""RTN"",""ORKPS"",70,0)"
^XMB(3.9,146013,2,450,0)=" N ORKDGI,ORKDRUG,ORKDRUGA,ORKORN,HOR,SEQ,CNT,CNTX,ORKOI,ORPHOI"
^XMB(3.9,146013,2,451,0)="""RTN"",""ORKPS"",71,0)"
^XMB(3.9,146013,2,452,0)=" N ORKFLG,ORSESS,ORPSPKG,ORPSA,ORSNUM,ORNUM,DUPX,DUPORN,ORPTY"
^XMB(3.9,146013,2,453,0)="""RTN"",""ORKPS"",72,0)"
^XMB(3.9,146013,2,454,0)=" N ORKSOIA,ORRET,ORDFN,ORPHDG S ORDFN=DFN"
^XMB(3.9,146013,2,455,0)="""RTN"",""ORKPS"",73,0)"
^XMB(3.9,146013,2,456,0)=" S ORPTY=$S($G(ORKDG)=""PSI"":""I;"",$G(ORKDG)=""PSIV"":""I;"",$G(ORKDG)=""PSO"":""O;"",$G(ORKDG)=""PSH"":""O;"",1:""O;"")"
^XMB(3.9,146013,2,457,0)="""RTN"",""ORKPS"",74,0)"
^XMB(3.9,146013,2,458,0)=" S ORPHDG=$S(ORKDG=""PSI"":""U"",ORKDG=""PSIV"":""I"",ORKDG=""PSO"":""O"",ORKDG=""PSH"":""N"",1:"""")"
^XMB(3.9,146013,2,459,0)="""RTN"",""ORKPS"",75,0)"
^XMB(3.9,146013,2,460,0)=" I '$D(^TMP($J,""OROCOUT""_ORPTY)) D"
^XMB(3.9,146013,2,461,0)="""RTN"",""ORKPS"",76,0)"
^XMB(3.9,146013,2,462,0)=" .S ORKFLG=0"
^XMB(3.9,146013,2,463,0)="""RTN"",""ORKPS"",77,0)"
^XMB(3.9,146013,2,464,0)=" .S ORNUM=$P(ORKA,""|"",5)"
^XMB(3.9,146013,2,465,0)="""RTN"",""ORKPS"",78,0)"
^XMB(3.9,146013,2,466,0)=" .S ORPHOI=+$P($G(^ORD(101.43,+OI,0)),U,2)"
^XMB(3.9,146013,2,467,0)="""RTN"",""ORKPS"",79,0)"
^XMB(3.9,146013,2,468,0)=" .I $G(ORIVTYPE)'=""A"",'$$PRE^PSSDSAPK(ORPHOI,ORPHDG) Q  ; Don't do checks if pharmacy does not want us to"
^XMB(3.9,146013,2,469,0)="""RTN"",""ORKPS"",80,0)"
^XMB(3.9,146013,2,470,0)=" .;get unsigned medication orders:"
^XMB(3.9,146013,2,471,0)="""RTN"",""ORKPS"",81,0)"
^XMB(3.9,146013,2,472,0)=" .S HOR=0,SEQ=0"
^XMB(3.9,146013,2,473,0)="""RTN"",""ORKPS"",82,0)"
^XMB(3.9,146013,2,474,0)=" .S HOR=$O(^TMP(""ORR"",$J,HOR))"
^XMB(3.9,146013,2,475,0)="""RTN"",""ORKPS"",83,0)"
^XMB(3.9,146013,2,476,0)=" .I +$G(HOR)>0 D"
^XMB(3.9,146013,2,477,0)="""RTN"",""ORKPS"",84,0)"
^XMB(3.9,146013,2,478,0)=" ..F  S SEQ=$O(^TMP(""ORR"",$J,HOR,SEQ)) Q:+SEQ<1  D"
^XMB(3.9,146013,2,479,0)="""RTN"",""ORKPS"",85,0)"
^XMB(3.9,146013,2,480,0)=" ...S ORKORN=+$P(^TMP(""ORR"",$J,HOR,SEQ),U),DUPORN=0"
^XMB(3.9,146013,2,481,0)="""RTN"",""ORKPS"",86,0)"
^XMB(3.9,146013,2,482,0)=" ...Q:+$G(ORKORN)<1"
^XMB(3.9,146013,2,483,0)="""RTN"",""ORKPS"",87,0)"
^XMB(3.9,146013,2,484,0)=" ...Q:+ORKORN=+ORNUM"
^XMB(3.9,146013,2,485,0)="""RTN"",""ORKPS"",88,0)"
^XMB(3.9,146013,2,486,0)=" ...Q:$P(^OR(100,+ORKORN,8,$P(^OR(100,+ORKORN,8,0),U,3),0),U,2)=""DC"""
^XMB(3.9,146013,2,487,0)="""RTN"",""ORKPS"",89,0)"
^XMB(3.9,146013,2,488,0)=" ...Q:$P(^ORD(100.01,$P(^OR(100,+ORKORN,3),U,3),0),U)=""DISCONTINUED"""
^XMB(3.9,146013,2,489,0)="""RTN"",""ORKPS"",90,0)"
^XMB(3.9,146013,2,490,0)=" ...S ORKDRUG=$$VALUE^ORCSAVE2(+ORKORN,""DRUG"") ;get disp drug for order"
^XMB(3.9,146013,2,491,0)="""RTN"",""ORKPS"",91,0)"
^XMB(3.9,146013,2,492,0)=" ...S ORPSPKG=$$DGRX^ORQOR2(+ORKORN)"
^XMB(3.9,146013,2,493,0)="""RTN"",""ORKPS"",92,0)"
^XMB(3.9,146013,2,494,0)=" ...S:ORPSPKG=""CLINIC INFUSIONS"" ORPSPKG=""IV MEDICATIONS"" ; OR*3*430"
^XMB(3.9,146013,2,495,0)="""RTN"",""ORKPS"",93,0)"
^XMB(3.9,146013,2,496,0)=" ...S ORPSPKG=$S(ORPSPKG=""UNIT DOSE MEDICATIONS"":""PSI"",ORPSPKG=""OUTPATIENT MEDICATIONS"":""PSO"",ORPSPKG=""IV MEDICATIONS"":""PSIV"",ORPSPKG=""NON-VA MEDICATIONS"":""PSH"",1:"""")"
^XMB(3.9,146013,2,497,0)="""RTN"",""ORKPS"",94,0)"
^XMB(3.9,146013,2,498,0)=" ...S DUPX="""" F  S DUPX=$O(ORKDRUGA(DUPX)) Q:'DUPX!(DUPORN=1)  D"
^XMB(3.9,146013,2,499,0)="""RTN"",""ORKPS"",95,0)"
^XMB(3.9,146013,2,500,0)=" ....S:ORKORN=ORKDRUGA(DUPX) DUPORN=1"
^XMB(3.9,146013,2,501,0)="""RTN"",""ORKPS"",96,0)"
^XMB(3.9,146013,2,502,0)=" ...Q:DUPORN=1  ;quit if already processed drug order"
^XMB(3.9,146013,2,503,0)="""RTN"",""ORKPS"",97,0)"
^XMB(3.9,146013,2,504,0)=" ...I +$G(ORKDRUG)<1,$L(ORPSPKG)>0 D"
^XMB(3.9,146013,2,505,0)="""RTN"",""ORKPS"",98,0)"
^XMB(3.9,146013,2,506,0)=" ....N OROI S OROI=$$OI^ORX8(+ORKORN)"
^XMB(3.9,146013,2,507,0)="""RTN"",""ORKPS"",99,0)"
^XMB(3.9,146013,2,508,0)=" ....S ORRET=$$OI2DD(+OROI,$S($G(ORKDG)=""PSI"":""I"",$G(ORKDG)=""PSIV"":""I"",$G(ORKDG)=""PSO"":""O"",$G(ORKDG)=""PSH"":""O"",1:""O""),1)"
^XMB(3.9,146013,2,509,0)="""RTN"",""ORKPS"",100,0)"
^XMB(3.9,146013,2,510,0)=" ....I +$P(ORRET,"";"",4) S ORKSOIA(+$P(ORRET,"";"",4))=ORKORN"
^XMB(3.9,146013,2,511,0)="""RTN"",""ORKPS"",101,0)"
^XMB(3.9,146013,2,512,0)=" ....I +ORRET S ORKDRUG=+ORRET"
^XMB(3.9,146013,2,513,0)="""RTN"",""ORKPS"",102,0)"
^XMB(3.9,146013,2,514,0)=" ...;only process vs. unsigned med order if disp drug is assoc w/order:"
^XMB(3.9,146013,2,515,0)="""RTN"",""ORKPS"",103,0)"
^XMB(3.9,146013,2,516,0)=" ...Q:+$G(ORKDRUG)<1"
^XMB(3.9,146013,2,517,0)="""RTN"",""ORKPS"",104,0)"
^XMB(3.9,146013,2,518,0)=" ...I ORPSPKG=""PSIV"" D"
^XMB(3.9,146013,2,519,0)="""RTN"",""ORKPS"",105,0)"
^XMB(3.9,146013,2,520,0)=" ....;loop through each OI in the IV order"
^XMB(3.9,146013,2,521,0)="""RTN"",""ORKPS"",106,0)"
^XMB(3.9,146013,2,522,0)=" ....N OR2I"
^XMB(3.9,146013,2,523,0)="""RTN"",""ORKPS"",107,0)"
^XMB(3.9,146013,2,524,0)=" ....S OR2I=0 F  S OR2I=$O(^OR(100,+ORKORN,4.5,""ID"",""ORDERABLE"",OR2I)) Q:'OR2I  D"
^XMB(3.9,146013,2,525,0)="""RTN"",""ORKPS"",108,0)"
^XMB(3.9,146013,2,526,0)=" .....N OR2OI,OR2DRUG"
^XMB(3.9,146013,2,527,0)="""RTN"",""ORKPS"",109,0)"
^XMB(3.9,146013,2,528,0)=" .....S OR2OI=$G(^OR(100,+ORKORN,4.5,OR2I,1))"
^XMB(3.9,146013,2,529,0)="""RTN"",""ORKPS"",110,0)"
^XMB(3.9,146013,2,530,0)=" .....Q:'OR2OI"
^XMB(3.9,146013,2,531,0)="""RTN"",""ORKPS"",111,0)"
^XMB(3.9,146013,2,532,0)=" .....;get the drug for each OI"
^XMB(3.9,146013,2,533,0)="""RTN"",""ORKPS"",112,0)"
^XMB(3.9,146013,2,534,0)=" .....S OR2DRUG=$$OI2DD(+OR2OI,""I"",1)"
^XMB(3.9,146013,2,535,0)="""RTN"",""ORKPS"",113,0)"
^XMB(3.9,146013,2,536,0)=" .....;check if drug should be add it and add it if so"
^XMB(3.9,146013,2,537,0)="""RTN"",""ORKPS"",114,0)"
^XMB(3.9,146013,2,538,0)=" .....I $$IVADD(OR2DRUG,OR2OI) S ORKDRUGA(+OR2DRUG_"";""_ORPSPKG_"";""_ORKORN)=ORKORN_U_$$GETPSNM(+OR2DRUG)"
^XMB(3.9,146013,2,539,0)="""RTN"",""ORKPS"",115,0)"
^XMB(3.9,146013,2,540,0)=" ...I ORPSPKG'=""PSIV"" S ORKDRUGA(+ORKDRUG_"";""_ORPSPKG_"";""_ORKORN)=ORKORN_U_$$GETPSNM(+ORKDRUG)"
^XMB(3.9,146013,2,541,0)="""RTN"",""ORKPS"",116,0)"
^XMB(3.9,146013,2,542,0)=" ...; OR*3*469 - Load all components (solution and additive) of IV for order checking"
^XMB(3.9,146013,2,543,0)="""RTN"",""ORKPS"",117,0)"
^XMB(3.9,146013,2,544,0)=" ... I ORPSPKG=""PSIV"" D"
^XMB(3.9,146013,2,545,0)="""RTN"",""ORKPS"",118,0)"
^XMB(3.9,146013,2,546,0)=" .... N ORX,ORRET S ORX=0 F  S ORX=+$O(^OR(100,ORKORN,4.5,""ID"",""ORDERABLE"",ORX)) Q:'ORX   D"
^XMB(3.9,146013,2,547,0)="""RTN"",""ORKPS"",119,0)"
^XMB(3.9,146013,2,548,0)=" ..... S ORRET=$$OI2DD(+$G(^OR(100,ORKORN,4.5,ORX,1)),""I"",1) Q:'ORRET"
^XMB(3.9,146013,2,549,0)="""RTN"",""ORKPS"",120,0)"
^XMB(3.9,146013,2,550,0)=" ..... I +$P(ORRET,"";"",4) S ORKSOIA(+$P(ORRET,"";"",4))=ORKORN"
^XMB(3.9,146013,2,551,0)="""RTN"",""ORKPS"",121,0)"
^XMB(3.9,146013,2,552,0)=" ..... I '$D(ORKDRUGA(+ORRET_"";PSIV;""_ORKORN)) S ORKDRUGA(+ORRET_"";PSIV;""_ORKORN)=ORKORN_U_$$GETPSNM(+ORRET)"
^XMB(3.9,146013,2,553,0)="""RTN"",""ORKPS"",122,0)"
^XMB(3.9,146013,2,554,0)=" .... Q  ; end of OR*3*469 change"
^XMB(3.9,146013,2,555,0)="""RTN"",""ORKPS"",123,0)"
^XMB(3.9,146013,2,556,0)=" .N ORPROSP,CNT"
^XMB(3.9,146013,2,557,0)="""RTN"",""ORKPS"",124,0)"
^XMB(3.9,146013,2,558,0)=" .S CNT=1"
^XMB(3.9,146013,2,559,0)="""RTN"",""ORKPS"",125,0)"
^XMB(3.9,146013,2,560,0)=" .S:+MED ORPROSP(CNT)=MED_U_$$GETPSNM(+MED)_U_+$G(ORNUM),CNT=CNT+1"
^XMB(3.9,146013,2,561,0)="""RTN"",""ORKPS"",126,0)"
^XMB(3.9,146013,2,562,0)=" .N I S I="""" F  S I=$O(ORKDRUGA(I)) Q:'I  S ORPROSP(CNT)=+I_U_$P(ORKDRUGA(I),U,2)_U_U_$P(ORKDRUGA(I),U,1),CNT=CNT+1"
^XMB(3.9,146013,2,563,0)="""RTN"",""ORKPS"",127,0)"
^XMB(3.9,146013,2,564,0)=" .D SHRNKPR"
^XMB(3.9,146013,2,565,0)="""RTN"",""ORKPS"",128,0)"
^XMB(3.9,146013,2,566,0)=" .D CPRS^PSODDPR4(DFN,""OROCOUT""_ORPTY,.ORPROSP,ORPTY_+$G(^OR(100,+$G(ORNUM),4)))"
^XMB(3.9,146013,2,567,0)="""RTN"",""ORKPS"",129,0)"
^XMB(3.9,146013,2,568,0)=" .I +ORSUPPLY D"
^XMB(3.9,146013,2,569,0)="""RTN"",""ORKPS"",130,0)"
^XMB(3.9,146013,2,570,0)=" ..S ORKSOIA(+ORSUPPLY)=$G(ORNUM)"
^XMB(3.9,146013,2,571,0)="""RTN"",""ORKPS"",131,0)"
^XMB(3.9,146013,2,572,0)=" ..D:$D(ORKSOIA)>9 CPRS^PSODDPR8(DFN,""OROCOUT""_ORPTY,.ORKSOIA,ORPHDG_"";""_+$G(^OR(100,+$G(ORNUM),4)),1)"
^XMB(3.9,146013,2,573,0)="""RTN"",""ORKPS"",132,0)"
^XMB(3.9,146013,2,574,0)=" D PROCESS^ORKPS1(OI,ORDFN,ORKDG,+ORSUPPLY_U_+MED,""OROCOUT""_ORPTY)"
^XMB(3.9,146013,2,575,0)="""RTN"",""ORKPS"",133,0)"
^XMB(3.9,146013,2,576,0)=" Q"
^XMB(3.9,146013,2,577,0)="""RTN"",""ORKPS"",134,0)"
^XMB(3.9,146013,2,578,0)="IVADD(ORDRUG,OROI) ;RETURN YES OR NO IF SHOULD ADD THE IV ITEM"
^XMB(3.9,146013,2,579,0)="""RTN"",""ORKPS"",135,0)"
^XMB(3.9,146013,2,580,0)=" N ORRET"
^XMB(3.9,146013,2,581,0)="""RTN"",""ORKPS"",136,0)"
^XMB(3.9,146013,2,582,0)=" ;default is yes to add it, will always be 1 for an additive"
^XMB(3.9,146013,2,583,0)="""RTN"",""ORKPS"",137,0)"
^XMB(3.9,146013,2,584,0)=" S ORRET=1"
^XMB(3.9,146013,2,585,0)="""RTN"",""ORKPS"",138,0)"
^XMB(3.9,146013,2,586,0)=" ;check if drug is a base"
^XMB(3.9,146013,2,587,0)="""RTN"",""ORKPS"",139,0)"
^XMB(3.9,146013,2,588,0)=" K ^TMP($J,""ORBASECHECK"")"
^XMB(3.9,146013,2,589,0)="""RTN"",""ORKPS"",140,0)"
^XMB(3.9,146013,2,590,0)=" D DRGIEN^PSS52P7(ORDRUG,,""ORBASECHECK"")"
^XMB(3.9,146013,2,591,0)="""RTN"",""ORKPS"",141,0)"
^XMB(3.9,146013,2,592,0)=" I $P($G(^TMP($J,""ORBASECHECK"",0),0),U)>0 D  ;GOT A BASE HERE"
^XMB(3.9,146013,2,593,0)="""RTN"",""ORKPS"",142,0)"
^XMB(3.9,146013,2,594,0)=" .;if drug is a base, check if pharmacy says we can add it or not"
^XMB(3.9,146013,2,595,0)="""RTN"",""ORKPS"",143,0)"
^XMB(3.9,146013,2,596,0)=" .N ORPHOI"
^XMB(3.9,146013,2,597,0)="""RTN"",""ORKPS"",144,0)"
^XMB(3.9,146013,2,598,0)=" .S ORPHOI=+$P($G(^ORD(101.43,+OROI,0)),U,2)"
^XMB(3.9,146013,2,599,0)="""RTN"",""ORKPS"",145,0)"
^XMB(3.9,146013,2,600,0)=" .S ORRET=$$PRE^PSSDSAPK(ORPHOI,""I"")"
^XMB(3.9,146013,2,601,0)="""RTN"",""ORKPS"",146,0)"
^XMB(3.9,146013,2,602,0)=" K ^TMP($J,""ORBASECHECK"")"
^XMB(3.9,146013,2,603,0)="""RTN"",""ORKPS"",147,0)"
^XMB(3.9,146013,2,604,0)=" Q ORRET"
^XMB(3.9,146013,2,605,0)="""RTN"",""ORKPS"",148,0)"
^XMB(3.9,146013,2,606,0)="SHRNKPR ;REMOVE DUPLICATS FROM PROSPECTIVE LIST"
^XMB(3.9,146013,2,607,0)="""RTN"",""ORKPS"",149,0)"
^XMB(3.9,146013,2,608,0)=" Q:'$D(ORPROSP)"
^XMB(3.9,146013,2,609,0)="""RTN"",""ORKPS"",150,0)"
^XMB(3.9,146013,2,610,0)=" N ORX,ORI S ORI=0 F  S ORI=$O(ORPROSP(ORI)) Q:'ORI  S ORX=ORPROSP(ORI) D"
^XMB(3.9,146013,2,611,0)="""RTN"",""ORKPS"",151,0)"
^XMB(3.9,146013,2,612,0)=" .N ORJ S ORJ=ORI F  S ORJ=$O(ORPROSP(ORJ)) Q:'ORJ  I ORX=ORPROSP(ORJ) K ORPROSP(ORJ)"
^XMB(3.9,146013,2,613,0)="""RTN"",""ORKPS"",152,0)"
^XMB(3.9,146013,2,614,0)=" Q"
^XMB(3.9,146013,2,615,0)="""RTN"",""ORKPS"",153,0)"
^XMB(3.9,146013,2,616,0)="GETPSNM(ORIEN) ;GET THE FILE 50 .01 FIELD FROM A FILE 50 IEN"
^XMB(3.9,146013,2,617,0)="""RTN"",""ORKPS"",154,0)"
^XMB(3.9,146013,2,618,0)=" N RET K ^TMP($J,""ORRETNM"")"
^XMB(3.9,146013,2,619,0)="""RTN"",""ORKPS"",155,0)"
^XMB(3.9,146013,2,620,0)=" D NDF^PSS50(ORIEN,,,,,""ORRETNM"") S RET=$G(^TMP($J,""ORRETNM"",ORIEN,.01))"
^XMB(3.9,146013,2,621,0)="""RTN"",""ORKPS"",156,0)"
^XMB(3.9,146013,2,622,0)=" K ^TMP($J,""ORRETNM"")"
^XMB(3.9,146013,2,623,0)="""RTN"",""ORKPS"",157,0)"
^XMB(3.9,146013,2,624,0)=" Q RET"
^XMB(3.9,146013,2,625,0)="""RTN"",""ORKPS"",158,0)"
^XMB(3.9,146013,2,626,0)="TAKEMED(ORKDFN,ORKMED) ;extrinsic function returns med orderable item if any"
^XMB(3.9,146013,2,627,0)="""RTN"",""ORKPS"",159,0)"
^XMB(3.9,146013,2,628,0)=" ;active med patient is taking contains any piece of ORKMED"
^XMB(3.9,146013,2,629,0)="""RTN"",""ORKPS"",160,0)"
^XMB(3.9,146013,2,630,0)=" ;ORKDFN   patient DFN"
^XMB(3.9,146013,2,631,0)="""RTN"",""ORKPS"",161,0)"
^XMB(3.9,146013,2,632,0)=" ;ORKMED   meds to check vs. active med list in format MED1^MED2^MED3..."
^XMB(3.9,146013,2,633,0)="""RTN"",""ORKPS"",162,0)"
^XMB(3.9,146013,2,634,0)=" Q:'$L($G(ORKDFN)) ""0^Patient not identified."""
^XMB(3.9,146013,2,635,0)="""RTN"",""ORKPS"",163,0)"
^XMB(3.9,146013,2,636,0)=" Q:'$L($G(ORKMED)) ""0^Medication not identified."""
^XMB(3.9,146013,2,637,0)="""RTN"",""ORKPS"",164,0)"
^XMB(3.9,146013,2,638,0)=" N ORKARX,ORKY,ORI,ORJ,ORCNT,ORKMEDP,ORKRSLT"
^XMB(3.9,146013,2,639,0)="""RTN"",""ORKPS"",165,0)"
^XMB(3.9,146013,2,640,0)=" D LIST^ORQQPS(.ORKY,ORKDFN,"""","""")"
^XMB(3.9,146013,2,641,0)="""RTN"",""ORKPS"",166,0)"
^XMB(3.9,146013,2,642,0)=" Q:$P(ORKY(1),U)="""" ""0^No active meds found."""
^XMB(3.9,146013,2,643,0)="""RTN"",""ORKPS"",167,0)"
^XMB(3.9,146013,2,644,0)=" S ORKRSLT=""0^No matching meds found."""
^XMB(3.9,146013,2,645,0)="""RTN"",""ORKPS"",168,0)"
^XMB(3.9,146013,2,646,0)=" S ORCNT=$L(ORKMED,U)"
^XMB(3.9,146013,2,647,0)="""RTN"",""ORKPS"",169,0)"
^XMB(3.9,146013,2,648,0)=" S ORI=0 F  S ORI=$O(ORKY(ORI)) Q:ORI<1  D"
^XMB(3.9,146013,2,649,0)="""RTN"",""ORKPS"",170,0)"
^XMB(3.9,146013,2,650,0)=" .S ORKARX=$P(ORKY(ORI),U,2)"
^XMB(3.9,146013,2,651,0)="""RTN"",""ORKPS"",171,0)"
^XMB(3.9,146013,2,652,0)=" .F ORJ=1:1:ORCNT S ORKMEDP=$P(ORKMED,U,ORJ) D"
^XMB(3.9,146013,2,653,0)="""RTN"",""ORKPS"",172,0)"
^XMB(3.9,146013,2,654,0)=" ..I $L(ORKMEDP),($$UP^XLFSTR(ORKARX)[ORKMEDP) S ORKRSLT=""1^""_ORKARX ;DJE/VM *316 use uppercase in comparison"
^XMB(3.9,146013,2,655,0)="""RTN"",""ORKPS"",173,0)"
^XMB(3.9,146013,2,656,0)=" Q ORKRSLT"
^XMB(3.9,146013,2,657,0)="""RTN"",""ORKPS"",174,0)"
^XMB(3.9,146013,2,658,0)="POLYRX(DFN) ;extrins funct rtns 1 if patient exceeds polypharmacy, 0 if not"
^XMB(3.9,146013,2,659,0)="""RTN"",""ORKPS"",175,0)"
^XMB(3.9,146013,2,660,0)=" N ORSLT,ORENT,ORLOC,ORPAR,ORMEDS"
^XMB(3.9,146013,2,661,0)="""RTN"",""ORKPS"",176,0)"
^XMB(3.9,146013,2,662,0)=" S ORSLT=0"
^XMB(3.9,146013,2,663,0)="""RTN"",""ORKPS"",177,0)"
^XMB(3.9,146013,2,664,0)=" Q:'$L(DFN) ORSLT"
^XMB(3.9,146013,2,665,0)="""RTN"",""ORKPS"",178,0)"
^XMB(3.9,146013,2,666,0)=" S VA200="""" D OERR^VADPT"
^XMB(3.9,146013,2,667,0)="""RTN"",""ORKPS"",179,0)"
^XMB(3.9,146013,2,668,0)=" S ORLOC=+$G(^DIC(42,+VAIN(4),44))"
^XMB(3.9,146013,2,669,0)="""RTN"",""ORKPS"",180,0)"
^XMB(3.9,146013,2,670,0)=" K VA200,VAIN"
^XMB(3.9,146013,2,671,0)="""RTN"",""ORKPS"",181,0)"
^XMB(3.9,146013,2,672,0)=" S ORENT=+$G(ORLOC)_"";SC(^DIV^SYS^PKG"""
^XMB(3.9,146013,2,673,0)="""RTN"",""ORKPS"",182,0)"
^XMB(3.9,146013,2,674,0)=" S ORPAR=$$GET^XPAR(ORENT,""ORK POLYPHARMACY"",1,""I"")"
^XMB(3.9,146013,2,675,0)="""RTN"",""ORKPS"",183,0)"
^XMB(3.9,146013,2,676,0)=" S ORMEDS=$$NUMRX(DFN)"
^XMB(3.9,146013,2,677,0)="""RTN"",""ORKPS"",184,0)"
^XMB(3.9,146013,2,678,0)=" I $G(ORMEDS)>$G(ORPAR) S ORSLT=1"
^XMB(3.9,146013,2,679,0)="""RTN"",""ORKPS"",185,0)"
^XMB(3.9,146013,2,680,0)=" Q ORSLT"
^XMB(3.9,146013,2,681,0)="""RTN"",""ORKPS"",186,0)"
^XMB(3.9,146013,2,682,0)="GLCREAT(DFN) ;extrinsic function returns patient's (DFN) most recent serum"
^XMB(3.9,146013,2,683,0)="""RTN"",""ORKPS"",187,0)"
^XMB(3.9,146013,2,684,0)=" ; creatinine within # of days from parameter ORK GLUCOPHAGE CREATININE"
^XMB(3.9,146013,2,685,0)="""RTN"",""ORKPS"",188,0)"
^XMB(3.9,146013,2,686,0)=" ; results format: test id^result units flag ref range collect d/t^result"
^XMB(3.9,146013,2,687,0)="""RTN"",""ORKPS"",189,0)"
^XMB(3.9,146013,2,688,0)=" ; used by order check GLUCOPHAGE-LAB RESULTS"
^XMB(3.9,146013,2,689,0)="""RTN"",""ORKPS"",190,0)"
^XMB(3.9,146013,2,690,0)=" N ORLOC,ORPAR,ORDAYS"
^XMB(3.9,146013,2,691,0)="""RTN"",""ORKPS"",191,0)"
^XMB(3.9,146013,2,692,0)=" N BDT,CDT,ORY,ORX,ORZ,TEST,ORI,ORJ,CREARSLT,LABFILE,SPECFILE,SPECIMEN,VAIN,VADM,RSLTS"
^XMB(3.9,146013,2,693,0)="""RTN"",""ORKPS"",192,0)"
^XMB(3.9,146013,2,694,0)=" Q:'$L(DFN) ""0^"""
^XMB(3.9,146013,2,695,0)="""RTN"",""ORKPS"",193,0)"
^XMB(3.9,146013,2,696,0)=" S ORDAYS=$$GCDAYS(DFN)"
^XMB(3.9,146013,2,697,0)="""RTN"",""ORKPS"",194,0)"
^XMB(3.9,146013,2,698,0)=" Q:'$L(ORDAYS) ""0^"""
^XMB(3.9,146013,2,699,0)="""RTN"",""ORKPS"",195,0)"
^XMB(3.9,146013,2,700,0)=" D NOW^%DTC"
^XMB(3.9,146013,2,701,0)="""RTN"",""ORKPS"",196,0)"
^XMB(3.9,146013,2,702,0)=" S BDT=$$FMADD^XLFDT(%,""-""_ORDAYS,"""","""","""")"
^XMB(3.9,146013,2,703,0)="""RTN"",""ORKPS"",197,0)"
^XMB(3.9,146013,2,704,0)=" K %"
^XMB(3.9,146013,2,705,0)="""RTN"",""ORKPS"",198,0)"
^XMB(3.9,146013,2,706,0)=" Q:'$L($G(BDT)) ""0^"""
^XMB(3.9,146013,2,707,0)="""RTN"",""ORKPS"",199,0)"
^XMB(3.9,146013,2,708,0)=" S LABFILE=$$TERMLKUP^ORB31(.ORY,""SERUM CREATININE"")"
^XMB(3.9,146013,2,709,0)="""RTN"",""ORKPS"",200,0)"
^XMB(3.9,146013,2,710,0)=" Q:'$D(ORY) ""0^"" ;no link between SERUM CREATININE and local lab test"
^XMB(3.9,146013,2,711,0)="""RTN"",""ORKPS"",201,0)"
^XMB(3.9,146013,2,712,0)=" Q:$G(LABFILE)'=60 ""0^"""
^XMB(3.9,146013,2,713,0)="""RTN"",""ORKPS"",202,0)"
^XMB(3.9,146013,2,714,0)=" S SPECFILE=$$TERMLKUP^ORB31(.ORX,""SERUM SPECIMEN"")"
^XMB(3.9,146013,2,715,0)="""RTN"",""ORKPS"",203,0)"
^XMB(3.9,146013,2,716,0)=" Q:'$D(ORX) ""0^"" ;no link between SERUM SPECIMEN and local specimen"
^XMB(3.9,146013,2,717,0)="""RTN"",""ORKPS"",204,0)"
^XMB(3.9,146013,2,718,0)=" Q:$G(SPECFILE)'=61 ""0^"""
^XMB(3.9,146013,2,719,0)="""RTN"",""ORKPS"",205,0)"
^XMB(3.9,146013,2,720,0)=" F ORI=1:1:ORY D"
^XMB(3.9,146013,2,721,0)="""RTN"",""ORKPS"",206,0)"
^XMB(3.9,146013,2,722,0)=" .S TEST=$P(ORY(ORI),U)"
^XMB(3.9,146013,2,723,0)="""RTN"",""ORKPS"",207,0)"
^XMB(3.9,146013,2,724,0)=" .Q:+$G(TEST)<1"
^XMB(3.9,146013,2,725,0)="""RTN"",""ORKPS"",208,0)"
^XMB(3.9,146013,2,726,0)=" .F ORJ=1:1:ORX D"
^XMB(3.9,146013,2,727,0)="""RTN"",""ORKPS"",209,0)"
^XMB(3.9,146013,2,728,0)=" ..S SPECIMEN=$P(ORX(ORJ),U)"
^XMB(3.9,146013,2,729,0)="""RTN"",""ORKPS"",210,0)"
^XMB(3.9,146013,2,730,0)=" ..Q:+$G(SPECIMEN)<1"
^XMB(3.9,146013,2,731,0)="""RTN"",""ORKPS"",211,0)"
^XMB(3.9,146013,2,732,0)=" ..S ORZ=$$LOCL^ORQQLR1(DFN,TEST,SPECIMEN)"
^XMB(3.9,146013,2,733,0)="""RTN"",""ORKPS"",212,0)"
^XMB(3.9,146013,2,734,0)=" ..Q:'$L($G(ORZ))"
^XMB(3.9,146013,2,735,0)="""RTN"",""ORKPS"",213,0)"
^XMB(3.9,146013,2,736,0)=" ..S CDT=$P(ORZ,U,7)"
^XMB(3.9,146013,2,737,0)="""RTN"",""ORKPS"",214,0)"
^XMB(3.9,146013,2,738,0)=" ..I CDT'<BDT S RSLTS(CDT)=ORZ,CREARSLT=1  ;*SMT Use RSLTS as array."
^XMB(3.9,146013,2,739,0)="""RTN"",""ORKPS"",215,0)"
^XMB(3.9,146013,2,740,0)=" Q:+$G(CREARSLT)<1 ""0^"""
^XMB(3.9,146013,2,741,0)="""RTN"",""ORKPS"",216,0)"
^XMB(3.9,146013,2,742,0)=" S CDT=$O(RSLTS(0)),ORZ=RSLTS(CDT)  ;*SMT"
^XMB(3.9,146013,2,743,0)="""RTN"",""ORKPS"",217,0)"
^XMB(3.9,146013,2,744,0)=" Q $P(ORZ,U)_U_$P(ORZ,U,3)_"" ""_$P(ORZ,U,4)_"" ""_$P(ORZ,U,5)_"" (""_$P(ORZ,U,6)_"")  ""_$$FMTE^XLFDT(CDT,""2P"")_U_$P(ORZ,U,3)"
^XMB(3.9,146013,2,745,0)="""RTN"",""ORKPS"",218,0)"
^XMB(3.9,146013,2,746,0)="GCDAYS(DFN) ;extrinsic function to return number of days to look for"
^XMB(3.9,146013,2,747,0)="""RTN"",""ORKPS"",219,0)"
^XMB(3.9,146013,2,748,0)=" ; glucophage serum creatinine result"
^XMB(3.9,146013,2,749,0)="""RTN"",""ORKPS"",220,0)"
^XMB(3.9,146013,2,750,0)=" Q:'$L(DFN) """""
^XMB(3.9,146013,2,751,0)="""RTN"",""ORKPS"",221,0)"
^XMB(3.9,146013,2,752,0)=" N ORLOC,ORENT,ORDAYS"
^XMB(3.9,146013,2,753,0)="""RTN"",""ORKPS"",222,0)"
^XMB(3.9,146013,2,754,0)=" ;get patient's location flag (INPATIENT ONLY - outpt locations cannot be"
^XMB(3.9,146013,2,755,0)="""RTN"",""ORKPS"",223,0)"
^XMB(3.9,146013,2,756,0)=" ;reliably determined, and many simultaneous outpt locations can occur):"
^XMB(3.9,146013,2,757,0)="""RTN"",""ORKPS"",224,0)"
^XMB(3.9,146013,2,758,0)=" S VA200="""" D OERR^VADPT"
^XMB(3.9,146013,2,759,0)="""RTN"",""ORKPS"",225,0)"
^XMB(3.9,146013,2,760,0)=" S ORLOC=+$G(^DIC(42,+VAIN(4),44))"
^XMB(3.9,146013,2,761,0)="""RTN"",""ORKPS"",226,0)"
^XMB(3.9,146013,2,762,0)=" K VA200,VAIN"
^XMB(3.9,146013,2,763,0)="""RTN"",""ORKPS"",227,0)"
^XMB(3.9,146013,2,764,0)=" S ORENT=+$G(ORLOC)_"";SC(^DIV^SYS^PKG"""
^XMB(3.9,146013,2,765,0)="""RTN"",""ORKPS"",228,0)"
^XMB(3.9,146013,2,766,0)=" S ORDAYS=$$GET^XPAR(ORENT,""ORK GLUCOPHAGE CREATININE"",1,""I"")"
^XMB(3.9,146013,2,767,0)="""RTN"",""ORKPS"",229,0)"
^XMB(3.9,146013,2,768,0)=" Q:$L(ORDAYS) ORDAYS"
^XMB(3.9,146013,2,769,0)="""RTN"",""ORKPS"",230,0)"
^XMB(3.9,146013,2,770,0)=" Q """""
^XMB(3.9,146013,2,771,0)="""RTN"",""ORKPS"",231,0)"
^XMB(3.9,146013,2,772,0)="SUPPLY(OI) ;extrinsic function returns 1 (true) if the orderable item is"
^XMB(3.9,146013,2,773,0)="""RTN"",""ORKPS"",232,0)"
^XMB(3.9,146013,2,774,0)=" ; a supply"
^XMB(3.9,146013,2,775,0)="""RTN"",""ORKPS"",233,0)"
^XMB(3.9,146013,2,776,0)=" Q:+$G(OI)<1 """""
^XMB(3.9,146013,2,777,0)="""RTN"",""ORKPS"",234,0)"
^XMB(3.9,146013,2,778,0)=" N OITEXT"
^XMB(3.9,146013,2,779,0)="""RTN"",""ORKPS"",235,0)"
^XMB(3.9,146013,2,780,0)=" S OITEXT=$G(^ORD(101.43,OI,0))"
^XMB(3.9,146013,2,781,0)="""RTN"",""ORKPS"",236,0)"
^XMB(3.9,146013,2,782,0)=" Q:'$L(OITEXT) """""
^XMB(3.9,146013,2,783,0)="""RTN"",""ORKPS"",237,0)"
^XMB(3.9,146013,2,784,0)=" S OITEXT=$P(OITEXT,U)"
^XMB(3.9,146013,2,785,0)="""RTN"",""ORKPS"",238,0)"
^XMB(3.9,146013,2,786,0)=" Q:$D(^ORD(101.43,""S.SPLY"",OITEXT)) 1"
^XMB(3.9,146013,2,787,0)="""RTN"",""ORKPS"",239,0)"
^XMB(3.9,146013,2,788,0)=" Q """""
^XMB(3.9,146013,2,789,0)="""RTN"",""ORKPS"",240,0)"
^XMB(3.9,146013,2,790,0)="NUMRX(DFN) ;extrinsic funct returns number of active meds patient is taking"
^XMB(3.9,146013,2,791,0)="""RTN"",""ORKPS"",241,0)"
^XMB(3.9,146013,2,792,0)=" N NUMRX,ORPTYPE,ORX,ORY,ORS,ORNUM,ORPRENEW,VADMVT"
^XMB(3.9,146013,2,793,0)="""RTN"",""ORKPS"",242,0)"
^XMB(3.9,146013,2,794,0)=" S NUMRX=0"
^XMB(3.9,146013,2,795,0)="""RTN"",""ORKPS"",243,0)"
^XMB(3.9,146013,2,796,0)=" Q:+$G(DFN)<1 NUMRX"
^XMB(3.9,146013,2,797,0)="""RTN"",""ORKPS"",244,0)"
^XMB(3.9,146013,2,798,0)=" ;check to determine if inpatient or outpatient:"
^XMB(3.9,146013,2,799,0)="""RTN"",""ORKPS"",245,0)"
^XMB(3.9,146013,2,800,0)=" D ADM^VADPT2"
^XMB(3.9,146013,2,801,0)="""RTN"",""ORKPS"",246,0)"
^XMB(3.9,146013,2,802,0)=" S ORPTYPE=$S(+$G(VADMVT)>0:""I"",1:""O"")"
^XMB(3.9,146013,2,803,0)="""RTN"",""ORKPS"",247,0)"
^XMB(3.9,146013,2,804,0)=" K ^TMP(""PS"",$J)"
^XMB(3.9,146013,2,805,0)="""RTN"",""ORKPS"",248,0)"
^XMB(3.9,146013,2,806,0)=" D OCL^PSOORRL(DFN,"""","""")  ;if no date range, returns active meds for pt"
^XMB(3.9,146013,2,807,0)="""RTN"",""ORKPS"",249,0)"
^XMB(3.9,146013,2,808,0)=" N X"
^XMB(3.9,146013,2,809,0)="""RTN"",""ORKPS"",250,0)"
^XMB(3.9,146013,2,810,0)=" S X=0"
^XMB(3.9,146013,2,811,0)="""RTN"",""ORKPS"",251,0)"
^XMB(3.9,146013,2,812,0)=" F  S X=$O(^TMP(""PS"",$J,X)) Q:X<1  D"
^XMB(3.9,146013,2,813,0)="""RTN"",""ORKPS"",252,0)"
^XMB(3.9,146013,2,814,0)=" .S ORX=$G(^TMP(""PS"",$J,X,0))"
^XMB(3.9,146013,2,815,0)="""RTN"",""ORKPS"",253,0)"
^XMB(3.9,146013,2,816,0)=" .S ORY=$P(ORX,U)"
^XMB(3.9,146013,2,817,0)="""RTN"",""ORKPS"",254,0)"
^XMB(3.9,146013,2,818,0)=" .S ORNUM=$P(ORX,U,8) ;order entry order number"
^XMB(3.9,146013,2,819,0)="""RTN"",""ORKPS"",255,0)"
^XMB(3.9,146013,2,820,0)=" .S ORS=$P(ORX,U,9) ;medication status from pharmacy"
^XMB(3.9,146013,2,821,0)="""RTN"",""ORKPS"",256,0)"
^XMB(3.9,146013,2,822,0)=" .S ORPRENEW=$P(ORX,U,14)  ;pending renewal flag (1: pending renewal)"
^XMB(3.9,146013,2,823,0)="""RTN"",""ORKPS"",257,0)"
^XMB(3.9,146013,2,824,0)=" .Q:+ORX<1"
^XMB(3.9,146013,2,825,0)="""RTN"",""ORKPS"",258,0)"
^XMB(3.9,146013,2,826,0)=" .Q:$P(ORY,"";"",2)'=ORPTYPE  ;quit if med is not pt type (inpt/outpt)"
^XMB(3.9,146013,2,827,0)="""RTN"",""ORKPS"",259,0)"
^XMB(3.9,146013,2,828,0)=" .;quit if status is a non-active type:"
^XMB(3.9,146013,2,829,0)="""RTN"",""ORKPS"",260,0)"
^XMB(3.9,146013,2,830,0)=" .Q:$G(ORS)=""EXPIRED"""
^XMB(3.9,146013,2,831,0)="""RTN"",""ORKPS"",261,0)"
^XMB(3.9,146013,2,832,0)=" .Q:$G(ORS)[""DISCONTINUE"""
^XMB(3.9,146013,2,833,0)="""RTN"",""ORKPS"",262,0)"
^XMB(3.9,146013,2,834,0)=" .Q:$G(ORS)=""DELETED"""
^XMB(3.9,146013,2,835,0)="""RTN"",""ORKPS"",263,0)"
^XMB(3.9,146013,2,836,0)=" .Q:+$G(ORPRENEW)>0"
^XMB(3.9,146013,2,837,0)="""RTN"",""ORKPS"",264,0)"
^XMB(3.9,146013,2,838,0)=" .Q:$$SUPPLY($$OI^ORQOR2(ORNUM))=1  ;quit if a supply"
^XMB(3.9,146013,2,839,0)="""RTN"",""ORKPS"",265,0)"
^XMB(3.9,146013,2,840,0)=" .S NUMRX=NUMRX+1"
^XMB(3.9,146013,2,841,0)="""RTN"",""ORKPS"",266,0)"
^XMB(3.9,146013,2,842,0)=" K ^TMP(""PS"",$J)"
^XMB(3.9,146013,2,843,0)="""RTN"",""ORKPS"",267,0)"
^XMB(3.9,146013,2,844,0)=" Q NUMRX"
^XMB(3.9,146013,2,845,0)="""RTN"",""ORKPS"",268,0)"
^XMB(3.9,146013,2,846,0)="OI2DD(OROI,ORPSPKG,ORCHKTYP)       ;rtn dispense drugs for a PS OI"
^XMB(3.9,146013,2,847,0)="""RTN"",""ORKPS"",269,0)"
^XMB(3.9,146013,2,848,0)=" ;ORCHKTYP: TYPE OF ORDER CHECK SYSTEM IS PERFORMING"
^XMB(3.9,146013,2,849,0)="""RTN"",""ORKPS"",270,0)"
^XMB(3.9,146013,2,850,0)=" ;          1 FOR ENHANCED ORDER CHECKS"
^XMB(3.9,146013,2,851,0)="""RTN"",""ORKPS"",271,0)"
^XMB(3.9,146013,2,852,0)=" ;          2 FOR DOSAGE ORDER CHECK"
^XMB(3.9,146013,2,853,0)="""RTN"",""ORKPS"",272,0)"
^XMB(3.9,146013,2,854,0)=" N PSOI,ORRET"
^XMB(3.9,146013,2,855,0)="""RTN"",""ORKPS"",273,0)"
^XMB(3.9,146013,2,856,0)=" Q:'$D(^ORD(101.43,OROI,0)) """""
^XMB(3.9,146013,2,857,0)="""RTN"",""ORKPS"",274,0)"
^XMB(3.9,146013,2,858,0)=" S PSOI=+$P(^ORD(101.43,OROI,0),U,2)"
^XMB(3.9,146013,2,859,0)="""RTN"",""ORKPS"",275,0)"
^XMB(3.9,146013,2,860,0)=" Q:PSOI<1 """""
^XMB(3.9,146013,2,861,0)="""RTN"",""ORKPS"",276,0)"
^XMB(3.9,146013,2,862,0)=" S:ORPSPKG=""H"" ORPSPKG=""X""  ;if non-va med need to pass api ""X"""
^XMB(3.9,146013,2,863,0)="""RTN"",""ORKPS"",277,0)"
^XMB(3.9,146013,2,864,0)=" S ORRET=$$DRG^PSSDSAPM(PSOI,ORPSPKG,ORCHKTYP)"
^XMB(3.9,146013,2,865,0)="""RTN"",""ORKPS"",278,0)"
^XMB(3.9,146013,2,866,0)=" I ORCHKTYP=1,(+$P(ORRET,"";"",4)) S $P(ORRET,"";"",4)=PSOI"
^XMB(3.9,146013,2,867,0)="""RTN"",""ORKPS"",279,0)"
^XMB(3.9,146013,2,868,0)=" Q ORRET"
^XMB(3.9,146013,2,869,0)="""RTN"",""ORQQLR1"")"
^XMB(3.9,146013,2,870,0)="0^1^B16256943"
^XMB(3.9,146013,2,871,0)="""RTN"",""ORQQLR1"",1,0)"
^XMB(3.9,146013,2,872,0)="ORQQLR1 ; slc/CLA - Extrinsic functions and procedures which return patient lab results ; 7/10/17 5:45pm"
^XMB(3.9,146013,2,873,0)="""RTN"",""ORQQLR1"",2,0)"
^XMB(3.9,146013,2,874,0)=" ;;3.0;ORDER ENTRY/RESULTS REPORTING;**6,51,74,143,414**;Dec 17, 1997;Build 0"
^XMB(3.9,146013,2,875,0)="""RTN"",""ORQQLR1"",3,0)"
^XMB(3.9,146013,2,876,0)=" ;Per VA Directive 6402, this routine should not be modified."
^XMB(3.9,146013,2,877,0)="""RTN"",""ORQQLR1"",4,0)"
^XMB(3.9,146013,2,878,0)=" ;"
^XMB(3.9,146013,2,879,0)="""RTN"",""ORQQLR1"",5,0)"
^XMB(3.9,146013,2,880,0)=" ;DBIA reference section"
^XMB(3.9,146013,2,881,0)="""RTN"",""ORQQLR1"",6,0)"
^XMB(3.9,146013,2,882,0)=" ;2387  ^LAB(60"
^XMB(3.9,146013,2,883,0)="""RTN"",""ORQQLR1"",7,0)"
^XMB(3.9,146013,2,884,0)=" ;2503  RR^LR7OR1"
^XMB(3.9,146013,2,885,0)="""RTN"",""ORQQLR1"",8,0)"
^XMB(3.9,146013,2,886,0)=" ;10103 FMTE^XLFDT"
^XMB(3.9,146013,2,887,0)="""RTN"",""ORQQLR1"",9,0)"
^XMB(3.9,146013,2,888,0)=" ;"
^XMB(3.9,146013,2,889,0)="""RTN"",""ORQQLR1"",10,0)"
^XMB(3.9,146013,2,890,0)="OETOLAB(ORNUM) ;extrinsic funct to get a lab order number from an oe/rr number"
^XMB(3.9,146013,2,891,0)="""RTN"",""ORQQLR1"",11,0)"
^XMB(3.9,146013,2,892,0)=" N LRNUM"
^XMB(3.9,146013,2,893,0)="""RTN"",""ORQQLR1"",12,0)"
^XMB(3.9,146013,2,894,0)=" S LRNUM=$G(^OR(100,ORNUM,4))"
^XMB(3.9,146013,2,895,0)="""RTN"",""ORQQLR1"",13,0)"
^XMB(3.9,146013,2,896,0)=" Q +LRNUM"
^XMB(3.9,146013,2,897,0)="""RTN"",""ORQQLR1"",14,0)"
^XMB(3.9,146013,2,898,0)=" ;"
^XMB(3.9,146013,2,899,0)="""RTN"",""ORQQLR1"",15,0)"
^XMB(3.9,146013,2,900,0)="PRINTNAM(LRIEN) ;extrinsic function to return the print name for an entry in the Lab file [#60]"
^XMB(3.9,146013,2,901,0)="""RTN"",""ORQQLR1"",16,0)"
^XMB(3.9,146013,2,902,0)=" Q:+$G(LRIEN)<1 """""
^XMB(3.9,146013,2,903,0)="""RTN"",""ORQQLR1"",17,0)"
^XMB(3.9,146013,2,904,0)=" N NODE,NAME"
^XMB(3.9,146013,2,905,0)="""RTN"",""ORQQLR1"",18,0)"
^XMB(3.9,146013,2,906,0)=" S NODE=$G(^LAB(60,LRIEN,.1))"
^XMB(3.9,146013,2,907,0)="""RTN"",""ORQQLR1"",19,0)"
^XMB(3.9,146013,2,908,0)=" Q:'$L(NODE) """""
^XMB(3.9,146013,2,909,0)="""RTN"",""ORQQLR1"",20,0)"
^XMB(3.9,146013,2,910,0)=" S NAME=$P(NODE,U)"
^XMB(3.9,146013,2,911,0)="""RTN"",""ORQQLR1"",21,0)"
^XMB(3.9,146013,2,912,0)=" Q NAME"
^XMB(3.9,146013,2,913,0)="""RTN"",""ORQQLR1"",22,0)"
^XMB(3.9,146013,2,914,0)=" ;"
^XMB(3.9,146013,2,915,0)="""RTN"",""ORQQLR1"",23,0)"
^XMB(3.9,146013,2,916,0)="OIRES(PT,OILR,SPEC) ;extrinsic function to return pt's most recent lab results for a lab orderable item in the format:"
^XMB(3.9,146013,2,917,0)="""RTN"",""ORQQLR1"",24,0)"
^XMB(3.9,146013,2,918,0)=" ; test id^abbrev test name^result^units^flag^collection d/t"
^XMB(3.9,146013,2,919,0)="""RTN"",""ORQQLR1"",25,0)"
^XMB(3.9,146013,2,920,0)=" N RSLT,ORZ"
^XMB(3.9,146013,2,921,0)="""RTN"",""ORQQLR1"",26,0)"
^XMB(3.9,146013,2,922,0)=" S ORZ="""""
^XMB(3.9,146013,2,923,0)="""RTN"",""ORQQLR1"",27,0)"
^XMB(3.9,146013,2,924,0)=" S RSLT=$$GETDATA^OCXCACHE(.ORZ,""$$OIRESC^ORQQLR1(""_PT_"",""_OILR_"",""_SPEC_"")"",PT,)"
^XMB(3.9,146013,2,925,0)="""RTN"",""ORQQLR1"",28,0)"
^XMB(3.9,146013,2,926,0)=" Q ORZ"
^XMB(3.9,146013,2,927,0)="""RTN"",""ORQQLR1"",29,0)"
^XMB(3.9,146013,2,928,0)=" ;"
^XMB(3.9,146013,2,929,0)="""RTN"",""ORQQLR1"",30,0)"
^XMB(3.9,146013,2,930,0)="OIRESC(PT,OILR,SPEC) ;extrinsic function to return pt's most recent lab results for a lab orderable item in the format:"
^XMB(3.9,146013,2,931,0)="""RTN"",""ORQQLR1"",31,0)"
^XMB(3.9,146013,2,932,0)=" ; test id^abbrev test name^result^units^flag^collection d/t"
^XMB(3.9,146013,2,933,0)="""RTN"",""ORQQLR1"",32,0)"
^XMB(3.9,146013,2,934,0)=" N ORY,ORX,ORN,ORLR,SUB,INVDT,SEQ,ORDG,RESULT"
^XMB(3.9,146013,2,935,0)="""RTN"",""ORQQLR1"",33,0)"
