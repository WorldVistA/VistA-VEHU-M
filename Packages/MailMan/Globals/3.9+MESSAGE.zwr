^XMB(3.9,146084,2,2112,0)=" ; JSON formatted output"
^XMB(3.9,146084,2,2113,0)="""RTN"",""SDES2GETREGS"",21,0)"
^XMB(3.9,146084,2,2114,0)=" N RETURN,SDINFO,SDDFN,SDPATARR,SDDEMO,PRACE,PRACEN,PETH,PETHN,SDMHP,SDPCP,GAF,GAFR,SDZIP,SDDOD,ERRORS"
^XMB(3.9,146084,2,2115,0)="""RTN"",""SDES2GETREGS"",22,0)"
^XMB(3.9,146084,2,2116,0)=" D VALCONTEXT^SDES2VALCONTEXT(.ERRORS,.SDCONTEXT)"
^XMB(3.9,146084,2,2117,0)="""RTN"",""SDES2GETREGS"",23,0)"
^XMB(3.9,146084,2,2118,0)=" I $D(ERRORS) S RETURN(""Patient"")="""" M RETURN=ERRORS D BUILDJSON^SDES2JSON(.JSON,.RETURN) Q"
^XMB(3.9,146084,2,2119,0)="""RTN"",""SDES2GETREGS"",24,0)"
^XMB(3.9,146084,2,2120,0)=" I $G(SDCONTEXT(""USER DUZ""))'="""" N DUZ D DUZ^XUP(SDCONTEXT(""USER DUZ""))"
^XMB(3.9,146084,2,2121,0)="""RTN"",""SDES2GETREGS"",25,0)"
^XMB(3.9,146084,2,2122,0)=" D VALIDATE(.ERRORS,.SDPARAM)"
^XMB(3.9,146084,2,2123,0)="""RTN"",""SDES2GETREGS"",26,0)"
