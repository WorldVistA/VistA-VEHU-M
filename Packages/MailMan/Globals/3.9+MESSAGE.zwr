^XMB(3.9,146089,2,1936,0)=" K DRET,SIG,^TMP(""PSORXDC"",$J) Q:'$D(^PS(52.41,ORD,0))"
^XMB(3.9,146089,2,1937,0)="""RTN"",""PSOORFIN"",186,0)"
