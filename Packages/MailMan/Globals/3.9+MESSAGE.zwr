^XMB(3.9,146052,2,671,0)="""RTN"",""FBAAAUDR"",56,0)"
^XMB(3.9,146052,2,672,0)=" I 'FBQUIT D"
^XMB(3.9,146052,2,673,0)="""RTN"",""FBAAAUDR"",57,0)"
^XMB(3.9,146052,2,674,0)=" . W !,""Historical Audit Data (since patch FB*3.5*151): """
^XMB(3.9,146052,2,675,0)="""RTN"",""FBAAAUDR"",58,0)"
^XMB(3.9,146052,2,676,0)=" . W:'$O(^FBAAA(DA(1),1,DA,""LOG2"",0)) !,""  No historical audit data on file."""
^XMB(3.9,146052,2,677,0)="""RTN"",""FBAAAUDR"",59,0)"
^XMB(3.9,146052,2,678,0)=" . S DIC=""^FBAAA(""_DFN_"",1,"",DA(1)=DFN,DA=FTP,DR=""LOG2"""
^XMB(3.9,146052,2,679,0)="""RTN"",""FBAAAUDR"",60,0)"
