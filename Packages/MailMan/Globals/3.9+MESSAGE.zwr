^XMB(3.9,146018,2,759,0)="""RTN"",""DPTLK7"",256,0)"
^XMB(3.9,146018,2,760,0)=" ;DG*5.3*1111 removed the PLACE OF BIRTH [CITY] (#.092) and PLACE OF BIRTH [STATE] (#.093) of PATIENT (#2) file"
^XMB(3.9,146018,2,761,0)="""RTN"",""DPTLK7"",257,0)"
^XMB(3.9,146018,2,762,0)=" ;F DGFLD=.03,.02,""ASKREQID"",.2403,.092,.093,994,.131 D  Q:$D(DTOUT)!($D(DUOUT))"
