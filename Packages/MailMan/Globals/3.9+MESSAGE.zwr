^XMB(3.9,146017,2,1126,0)="0^8^B77287650"
^XMB(3.9,146017,2,1127,0)="""RTN"",""SDES2CANCLNAVAIL"",1,0)"
^XMB(3.9,146017,2,1128,0)="SDES2CANCLNAVAIL ;ALB/BLB,BLB,TJB,BLB,JAS,BLB,BWF,BLB,MCB,AGW,AGW - SDES2 CANCEL CLINIC AVAILABILITY ; DEC 15, 2025"
^XMB(3.9,146017,2,1129,0)="""RTN"",""SDES2CANCLNAVAIL"",2,0)"
^XMB(3.9,146017,2,1130,0)=" ;;5.3;Scheduling;**869,873,875,880,886,893,898,902,914,922,909**;Aug 13, 1993;Build 0"
^XMB(3.9,146017,2,1131,0)="""RTN"",""SDES2CANCLNAVAIL"",3,0)"
^XMB(3.9,146017,2,1132,0)=" ;;Per VHA Directive 6402, this routine should not be modified"
^XMB(3.9,146017,2,1133,0)="""RTN"",""SDES2CANCLNAVAIL"",4,0)"
^XMB(3.9,146017,2,1134,0)=" ; Reference to DUZ^XUP is supported by IA #7487"
^XMB(3.9,146017,2,1135,0)="""RTN"",""SDES2CANCLNAVAIL"",5,0)"
^XMB(3.9,146017,2,1136,0)=" ;"
^XMB(3.9,146017,2,1137,0)="""RTN"",""SDES2CANCLNAVAIL"",6,0)"
^XMB(3.9,146017,2,1138,0)=" Q"
^XMB(3.9,146017,2,1139,0)="""RTN"",""SDES2CANCLNAVAIL"",7,0)"
^XMB(3.9,146017,2,1140,0)=" ;"
^XMB(3.9,146017,2,1141,0)="""RTN"",""SDES2CANCLNAVAIL"",8,0)"
^XMB(3.9,146017,2,1142,0)="CANCEL(JSON,SDCONTEXT,CANCEL) ;"
^XMB(3.9,146017,2,1143,0)="""RTN"",""SDES2CANCLNAVAIL"",9,0)"
^XMB(3.9,146017,2,1144,0)=" N ERRORS,RETURN"
^XMB(3.9,146017,2,1145,0)="""RTN"",""SDES2CANCLNAVAIL"",10,0)"
^XMB(3.9,146017,2,1146,0)=" ;"
^XMB(3.9,146017,2,1147,0)="""RTN"",""SDES2CANCLNAVAIL"",11,0)"
^XMB(3.9,146017,2,1148,0)=" D VALCONTEXT^SDES2VALCONTEXT(.ERRORS,.SDCONTEXT)"
^XMB(3.9,146017,2,1149,0)="""RTN"",""SDES2CANCLNAVAIL"",12,0)"
^XMB(3.9,146017,2,1150,0)=" I $D(ERRORS) S ERRORS(""CancelClinicAvailability"",1)="""" D BUILDJSON^SDES2JSON(.JSON,.ERRORS) Q"
^XMB(3.9,146017,2,1151,0)="""RTN"",""SDES2CANCLNAVAIL"",13,0)"
^XMB(3.9,146017,2,1152,0)=" I $G(SDCONTEXT(""USER DUZ""))'="""" N DUZ D DUZ^XUP(SDCONTEXT(""USER DUZ""))"
^XMB(3.9,146017,2,1153,0)="""RTN"",""SDES2CANCLNAVAIL"",14,0)"
^XMB(3.9,146017,2,1154,0)=" S CANCEL(""REMARKS"")=$$CLEANCMMTS^SDES2APPTUTIL($G(CANCEL(""REMARKS"")))"
^XMB(3.9,146017,2,1155,0)="""RTN"",""SDES2CANCLNAVAIL"",15,0)"
^XMB(3.9,146017,2,1156,0)=" D VALIDATE(.ERRORS,.SDCONTEXT,.CANCEL,$G(CANCEL(""CLINIC IEN"")),$G(CANCEL(""FULL PARTIAL FLAG"")),$G(CANCEL(""REMARKS"")))"
^XMB(3.9,146017,2,1157,0)="""RTN"",""SDES2CANCLNAVAIL"",16,0)"
^XMB(3.9,146017,2,1158,0)=" I $D(ERRORS) S ERRORS(""CancelClinicAvailability"",1)="""" D BUILDJSON^SDES2JSON(.JSON,.ERRORS) Q"
^XMB(3.9,146017,2,1159,0)="""RTN"",""SDES2CANCLNAVAIL"",17,0)"
^XMB(3.9,146017,2,1160,0)=" ;"
^XMB(3.9,146017,2,1161,0)="""RTN"",""SDES2CANCLNAVAIL"",18,0)"
^XMB(3.9,146017,2,1162,0)=" D CANCELAPPTS(CANCEL(""CLINIC IEN""),CANCEL(""START DATE TIME""),CANCEL(""END DATE TIME""),CANCEL(""FULL PARTIAL FLAG""),$G(CANCEL(""REMARKS"")),.SDCONTEXT,.RETURN)"
^XMB(3.9,146017,2,1163,0)="""RTN"",""SDES2CANCLNAVAIL"",19,0)"
^XMB(3.9,146017,2,1164,0)=" D CANCELAVAIL(CANCEL(""CLINIC IEN""),CANCEL(""START DATE TIME""),CANCEL(""END DATE TIME""),CANCEL(""FULL PARTIAL FLAG""),$G(CANCEL(""REMARKS"")))"
