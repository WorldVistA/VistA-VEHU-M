^XMB(3.9,146101,2,366,0)=" ;Input - ICN = Integration Control Number associated with patient"
^XMB(3.9,146101,2,367,0)="""RTN"",""PSSHDPG1"",62,0)"
^XMB(3.9,146101,2,368,0)=" ;        PSSX = passed in by reference; name of variable to hold the request string"
^XMB(3.9,146101,2,369,0)="""RTN"",""PSSHDPG1"",63,0)"
^XMB(3.9,146101,2,370,0)=" ;        PSSDTM - date/time passed in ccyy-mm-ddThh:mm:ssZ format "
^XMB(3.9,146101,2,371,0)="""RTN"",""PSSHDPG1"",64,0)"
^XMB(3.9,146101,2,372,0)=" ; Output - PSSX = request string in XML format to be sent to HDR for patient genomic results"
^XMB(3.9,146101,2,373,0)="""RTN"",""PSSHDPG1"",65,0)"
^XMB(3.9,146101,2,374,0)=" K PSSX"
^XMB(3.9,146101,2,375,0)="""RTN"",""PSSHDPG1"",66,0)"
^XMB(3.9,146101,2,376,0)=" S PSSX=""/readClinicalData1?&templateId=MedOrderCheckRead&filterRequest=<?xml version=""""1.0"""" encoding=""""UTF-8""""?>"""
^XMB(3.9,146101,2,377,0)="""RTN"",""PSSHDPG1"",67,0)"
^XMB(3.9,146101,2,378,0)=" S PSSX=PSSX_""<filter:filter xmlns:filter=""""Filter"""" xmlns:xsi=""""http://www.w3.org/2001/XMLSchema-instance"""" vhimVersion=""""Vhim_4_00"""">"""
^XMB(3.9,146101,2,379,0)="""RTN"",""PSSHDPG1"",68,0)"
^XMB(3.9,146101,2,380,0)=" S PSSX=PSSX_""<filterId>MOCHA_READ_FILTER</filterId><clientName>HDR-14142</clientName><payloadType>xml</payloadType><clientRequestInitiationTime>""_PSSDTM_""</clientRequestInitiationTime>"""
^XMB(3.9,146101,2,381,0)="""RTN"",""PSSHDPG1"",69,0)"
^XMB(3.9,146101,2,382,0)=" S PSSX=PSSX_""<patients><NationalId>""_ICN_""</NationalId></patients><entryPointFilter queryName=""""ID1""""><domainEntryPoint>Pharmacogenetic</domainEntryPoint><queryTimeoutSeconds>10000</queryTimeoutSeconds>"""
^XMB(3.9,146101,2,383,0)="""RTN"",""PSSHDPG1"",70,0)"
^XMB(3.9,146101,2,384,0)=" S PSSX=PSSX_""  </entryPointFilter> </filter:filter>&filterId=MOCHA_READ_FILTER&requestId=""_$P($$SITE^VASITE,U,3)_""MOCHA PGx""_$$NOW^XLFDT_"";""_$H"
^XMB(3.9,146101,2,385,0)="""RTN"",""PSSHDPG1"",71,0)"
^XMB(3.9,146101,2,386,0)=" Q"
^XMB(3.9,146101,2,387,0)="""RTN"",""PSSHDPG1"",72,0)"
^XMB(3.9,146101,2,388,0)=" ;"
^XMB(3.9,146101,2,389,0)="""RTN"",""PSSHDPG1"",73,0)"
^XMB(3.9,146101,2,390,0)="SENDREQUEST(PSSROBJ,PSSX,PSSERR) ; post MED_ORDER_CHECK request to HDR web service to return patient genetic test results"
^XMB(3.9,146101,2,391,0)="""RTN"",""PSSHDPG1"",74,0)"
^XMB(3.9,146101,2,392,0)=" ; Input -  PSSROBJ = rest service request object (passed in by reference)"
^XMB(3.9,146101,2,393,0)="""RTN"",""PSSHDPG1"",75,0)"
^XMB(3.9,146101,2,394,0)=" ;          PSSX = request string to HDR "
^XMB(3.9,146101,2,395,0)="""RTN"",""PSSHDPG1"",76,0)"
^XMB(3.9,146101,2,396,0)=" ; Output - PSSRET = returned (XML) string as a result of HDR processing of the request"
^XMB(3.9,146101,2,397,0)="""RTN"",""PSSHDPG1"",77,0)"
^XMB(3.9,146101,2,398,0)=" ;        - PSSERR = error object (passed in by reference)"
^XMB(3.9,146101,2,399,0)="""RTN"",""PSSHDPG1"",78,0)"
^XMB(3.9,146101,2,400,0)=" N $ETRAP,PSSRET"
^XMB(3.9,146101,2,401,0)="""RTN"",""PSSHDPG1"",79,0)"
^XMB(3.9,146101,2,402,0)="  ; Set error trap"
^XMB(3.9,146101,2,403,0)="""RTN"",""PSSHDPG1"",80,0)"
^XMB(3.9,146101,2,404,0)=" S $ETRAP=""DO ERROR^PSSHDPG1"""
^XMB(3.9,146101,2,405,0)="""RTN"",""PSSHDPG1"",81,0)"
^XMB(3.9,146101,2,406,0)=" S PSSROBJ=$$GETREST^XOBWLIB(""PSS PGX-HDR SERVICE"",""PSS PGX-HDR SERVER"") ;Return REST Service Request Object using the HWSC supported API."
^XMB(3.9,146101,2,407,0)="""RTN"",""PSSHDPG1"",82,0)"
^XMB(3.9,146101,2,408,0)=" I $D(^TMP($J,""PSSHDPG1"",""EXCEPTION""))>0 S PSSRET=""-1^""_^TMP($J,""PSSHDPG1"",""EXCEPTION"") G SENDREQUESTX"
^XMB(3.9,146101,2,409,0)="""RTN"",""PSSHDPG1"",83,0)"
^XMB(3.9,146101,2,410,0)=" S PSSRET=$$GET^XOBWLIB(PSSROBJ,PSSX,.PSSERR,1)  ;Make HTTP GET Call and Force Error if Problem Encountered"
^XMB(3.9,146101,2,411,0)="""RTN"",""PSSHDPG1"",84,0)"
^XMB(3.9,146101,2,412,0)=" I $D(^TMP($J,""PSSHDPG1"",""EXCEPTION""))>0 S PSSRET=""-1^""_^TMP($J,""PSSHDPG1"",""EXCEPTION"")"
^XMB(3.9,146101,2,413,0)="""RTN"",""PSSHDPG1"",85,0)"
^XMB(3.9,146101,2,414,0)="SENDREQUESTX ;"
^XMB(3.9,146101,2,415,0)="""RTN"",""PSSHDPG1"",86,0)"
^XMB(3.9,146101,2,416,0)=" Q PSSRET"
^XMB(3.9,146101,2,417,0)="""RTN"",""PSSHDPG1"",87,0)"
^XMB(3.9,146101,2,418,0)=" ;"
^XMB(3.9,146101,2,419,0)="""RTN"",""PSSHDPG1"",88,0)"
^XMB(3.9,146101,2,420,0)="SETARRAY(PSSGENES) ; ;move from temp global into LOCAL array"
^XMB(3.9,146101,2,421,0)="""RTN"",""PSSHDPG1"",89,0)"
^XMB(3.9,146101,2,422,0)=" ;PSSGENES - Patient lab result from HDR"
^XMB(3.9,146101,2,423,0)="""RTN"",""PSSHDPG1"",90,0)"
^XMB(3.9,146101,2,424,0)=" ; PSSGENES(GENE,CNT,""ACTIVITY_SCORE"")"
^XMB(3.9,146101,2,425,0)="""RTN"",""PSSHDPG1"",91,0)"
^XMB(3.9,146101,2,426,0)=" ; PSSGENES(GENE,CNT,""GENOTYPE"")"
^XMB(3.9,146101,2,427,0)="""RTN"",""PSSHDPG1"",92,0)"
^XMB(3.9,146101,2,428,0)=" ; PSSGENES(GENE,CNT,""NPP_SharePointURL"")"
^XMB(3.9,146101,2,429,0)="""RTN"",""PSSHDPG1"",93,0)"
^XMB(3.9,146101,2,430,0)=" ; PSSGENES(GENE,CNT,""PHENOTYPE"")"
^XMB(3.9,146101,2,431,0)="""RTN"",""PSSHDPG1"",94,0)"
^XMB(3.9,146101,2,432,0)=" ; PSSGENES(GENE,CNT,""RESULT_DATE"")"
^XMB(3.9,146101,2,433,0)="""RTN"",""PSSHDPG1"",95,0)"
^XMB(3.9,146101,2,434,0)=" ;PSSXZY - format uses to check for GENE and PHENOTYPE FDB maaping"
^XMB(3.9,146101,2,435,0)="""RTN"",""PSSHDPG1"",96,0)"
^XMB(3.9,146101,2,436,0)=" ; PSSXYZ(CNT,LABEL) where labels are ""GENE"", ""ACTIVITY_SCORE"", GENOTYPE, PHENOTYPE, RESULT_DATA, NPP_SharePointURL,FULL_ICN, PSSXSID."
^XMB(3.9,146101,2,437,0)="""RTN"",""PSSHDPG1"",97,0)"
^XMB(3.9,146101,2,438,0)=" N INDX,PSSGENE,PSSPHEN,PSSFDBG,PSSFDBP,PSSCNT,PSSXZY,PSSGMAP,PSSPMAP,PSSFDBG,PSSFDBP,PSSMAP"
^XMB(3.9,146101,2,439,0)="""RTN"",""PSSHDPG1"",98,0)"
^XMB(3.9,146101,2,440,0)=" S INDX=-1,PSSCNT=0"
^XMB(3.9,146101,2,441,0)="""RTN"",""PSSHDPG1"",99,0)"
^XMB(3.9,146101,2,442,0)=" F  S INDX=$O(^TMP($J,""PSSHDPG1"",""ClinicalData"",0,""patient"",0,""medOrderCheckRead"",0,""pgxDatas"",0,""pgxData"",INDX)) Q:INDX']""""  D"
^XMB(3.9,146101,2,443,0)="""RTN"",""PSSHDPG1"",100,0)"
^XMB(3.9,146101,2,444,0)=" . S PSSCNT=PSSCNT+1"
^XMB(3.9,146101,2,445,0)="""RTN"",""PSSHDPG1"",101,0)"
^XMB(3.9,146101,2,446,0)=" . S PSSXZY(PSSCNT,""GENE"")=$G(^TMP($J,""PSSHDPG1"",""ClinicalData"",0,""patient"",0,""medOrderCheckRead"",0,""pgxDatas"",0,""pgxData"",INDX,""gene"",0))"
^XMB(3.9,146101,2,447,0)="""RTN"",""PSSHDPG1"",102,0)"
^XMB(3.9,146101,2,448,0)=" . S PSSXZY(PSSCNT,""ACTIVITY_SCORE"")=$G(^TMP($J,""PSSHDPG1"",""ClinicalData"",0,""patient"",0,""medOrderCheckRead"",0,""pgxDatas"",0,""pgxData"",INDX,""vinciActivityScore"",0))"
^XMB(3.9,146101,2,449,0)="""RTN"",""PSSHDPG1"",103,0)"
^XMB(3.9,146101,2,450,0)=" . S PSSXZY(PSSCNT,""GENOTYPE"")=$G(^TMP($J,""PSSHDPG1"",""ClinicalData"",0,""patient"",0,""medOrderCheckRead"",0,""pgxDatas"",0,""pgxData"",INDX,""vinciGenotype"",0))"
^XMB(3.9,146101,2,451,0)="""RTN"",""PSSHDPG1"",104,0)"
^XMB(3.9,146101,2,452,0)=" . S PSSXZY(PSSCNT,""PHENOTYPE"")=$G(^TMP($J,""PSSHDPG1"",""ClinicalData"",0,""patient"",0,""medOrderCheckRead"",0,""pgxDatas"",0,""pgxData"",INDX,""vinciPhenotype"",0))"
^XMB(3.9,146101,2,453,0)="""RTN"",""PSSHDPG1"",105,0)"
^XMB(3.9,146101,2,454,0)=" . S PSSXZY(PSSCNT,""RESULT_DATE"")=$G(^TMP($J,""PSSHDPG1"",""ClinicalData"",0,""patient"",0,""medOrderCheckRead"",0,""pgxDatas"",0,""pgxData"",INDX,""resultDate"",0))"
^XMB(3.9,146101,2,455,0)="""RTN"",""PSSHDPG1"",106,0)"
^XMB(3.9,146101,2,456,0)=" . S PSSXZY(PSSCNT,""NPP_SharePointURL"")=$P($G(^TMP($J,""PSSHDPG1"",""ClinicalData"",0,""patient"",0,""medOrderCheckRead"",0,""nppSharepointURL"",0,""url"",0)),""? "",2)"
^XMB(3.9,146101,2,457,0)="""RTN"",""PSSHDPG1"",107,0)"
^XMB(3.9,146101,2,458,0)=" . S PSSXZY(PSSCNT,""FULL_ICN"")=$G(^TMP($J,""PSSHDPG1"",""ClinicalData"",0,""patient"",0,""medOrderCheckRead"",0,""pgxDatas"",0,""pgxData"",INDX,""patientFullICN"",0))"
^XMB(3.9,146101,2,459,0)="""RTN"",""PSSHDPG1"",108,0)"
^XMB(3.9,146101,2,460,0)=" . S PSSXZY(PSSCNT,""PGXSID"")=$G(^TMP($J,""PSSHDPG1"",""ClinicalData"",0,""patient"",0,""medOrderCheckRead"",0,""pgxDatas"",0,""pgxData"",INDX,""pgxSID"",0))"
^XMB(3.9,146101,2,461,0)="""RTN"",""PSSHDPG1"",109,0)"
^XMB(3.9,146101,2,462,0)=" K PSSPERR"
^XMB(3.9,146101,2,463,0)="""RTN"",""PSSHDPG1"",110,0)"
^XMB(3.9,146101,2,464,0)=" I '$G(PSSOPTFG) D DATA^PSSPGXUT(.PSSXZY,.PSSMAP)"
^XMB(3.9,146101,2,465,0)="""RTN"",""PSSHDPG1"",111,0)"
^XMB(3.9,146101,2,466,0)=" F PSSCNT=0:0 S PSSCNT=$O(PSSXZY(PSSCNT)) Q:'PSSCNT  D"
^XMB(3.9,146101,2,467,0)="""RTN"",""PSSHDPG1"",112,0)"
^XMB(3.9,146101,2,468,0)=" . S PSSGMAP=$G(PSSMAP(PSSCNT,""GENE"")),PSSFDBG=$P(PSSGMAP,U,2)"
^XMB(3.9,146101,2,469,0)="""RTN"",""PSSHDPG1"",113,0)"
^XMB(3.9,146101,2,470,0)=" . S PSSPMAP=$G(PSSMAP(PSSCNT,""PHENOTYPE"")),PSSFDBP=$P(PSSPMAP,U,2) I +$P(PSSPMAP,U,3),PSSFDBG'="""" S PSSPERR(PSSFDBG)=PSSFDBP"
^XMB(3.9,146101,2,471,0)="""RTN"",""PSSHDPG1"",114,0)"
^XMB(3.9,146101,2,472,0)=" . Q:PSSFDBG=""NULL"""
^XMB(3.9,146101,2,473,0)="""RTN"",""PSSHDPG1"",115,0)"
^XMB(3.9,146101,2,474,0)=" . S PSSGENES(PSSFDBG,PSSCNT,""ACTIVITY_SCORE"")=PSSXZY(PSSCNT,""ACTIVITY_SCORE"")"
^XMB(3.9,146101,2,475,0)="""RTN"",""PSSHDPG1"",116,0)"
^XMB(3.9,146101,2,476,0)=" . S PSSGENES(PSSFDBG,PSSCNT,""GENOTYPE"")=PSSXZY(PSSCNT,""GENOTYPE"")"
^XMB(3.9,146101,2,477,0)="""RTN"",""PSSHDPG1"",117,0)"
^XMB(3.9,146101,2,478,0)=" . S PSSGENES(PSSFDBG,PSSCNT,""PHENOTYPE"")=$S($D(PSSMAP(PSSCNT,""NOFDB"")):"""",PSSFDBP'=""NULL"":PSSFDBP,1:"""")"
^XMB(3.9,146101,2,479,0)="""RTN"",""PSSHDPG1"",118,0)"
^XMB(3.9,146101,2,480,0)=" . S PSSGENES(PSSFDBG,PSSCNT,""RESULT_DATE"")=PSSXZY(PSSCNT,""RESULT_DATE"")"
^XMB(3.9,146101,2,481,0)="""RTN"",""PSSHDPG1"",119,0)"
^XMB(3.9,146101,2,482,0)=" . S PSSGENES(PSSFDBG,PSSCNT,""NPP_SharePointURL"")=PSSXZY(PSSCNT,""NPP_SharePointURL"")"
^XMB(3.9,146101,2,483,0)="""RTN"",""PSSHDPG1"",120,0)"
^XMB(3.9,146101,2,484,0)=" Q"
^XMB(3.9,146101,2,485,0)="""RTN"",""PSSHDPG1"",121,0)"
^XMB(3.9,146101,2,486,0)="  ;"
^XMB(3.9,146101,2,487,0)="""RTN"",""PSSHDPG1"",122,0)"
^XMB(3.9,146101,2,488,0)="PARSE(STREAM) ;parse out xml into temp global  (copied from PARSE^ORRDI1)"
^XMB(3.9,146101,2,489,0)="""RTN"",""PSSHDPG1"",123,0)"
^XMB(3.9,146101,2,490,0)=" N %XML,GL,BREAK,X"
^XMB(3.9,146101,2,491,0)="""RTN"",""PSSHDPG1"",124,0)"
^XMB(3.9,146101,2,492,0)=" S GL=$NA(^TMP($J,""PSSHDPG1""))"
^XMB(3.9,146101,2,493,0)="""RTN"",""PSSHDPG1"",125,0)"
^XMB(3.9,146101,2,494,0)=" K @GL"
^XMB(3.9,146101,2,495,0)="""RTN"",""PSSHDPG1"",126,0)"
^XMB(3.9,146101,2,496,0)=" N STATUS,READER,XOBERR,S"
^XMB(3.9,146101,2,497,0)="""RTN"",""PSSHDPG1"",127,0)"
^XMB(3.9,146101,2,498,0)=" S STATUS=##class(%XML.TextReader).ParseStream(STREAM,.READER,,,,,1)"
^XMB(3.9,146101,2,499,0)="""RTN"",""PSSHDPG1"",128,0)"
^XMB(3.9,146101,2,500,0)=" I $$STATCHK^XOBWLIB(STATUS,.XOBERR,1) D"
^XMB(3.9,146101,2,501,0)="""RTN"",""PSSHDPG1"",129,0)"
^XMB(3.9,146101,2,502,0)=" .S BREAK=0 F  Q:BREAK!READER.EOF!'READER.Read()  D"
^XMB(3.9,146101,2,503,0)="""RTN"",""PSSHDPG1"",130,0)"
^XMB(3.9,146101,2,504,0)=" ..I READER.NodeType=""element"" D SPUSH(.S,READER.LocalName)"
^XMB(3.9,146101,2,505,0)="""RTN"",""PSSHDPG1"",131,0)"
^XMB(3.9,146101,2,506,0)=" ..I READER.NodeType=""endelement"" D SPOP(.S,.X)"
^XMB(3.9,146101,2,507,0)="""RTN"",""PSSHDPG1"",132,0)"
^XMB(3.9,146101,2,508,0)=" ..I READER.NodeType=""chars"" D SPUT(.S,READER.Value)"
^XMB(3.9,146101,2,509,0)="""RTN"",""PSSHDPG1"",133,0)"
^XMB(3.9,146101,2,510,0)=" Q"
^XMB(3.9,146101,2,511,0)="""RTN"",""PSSHDPG1"",134,0)"
^XMB(3.9,146101,2,512,0)=" ;"
^XMB(3.9,146101,2,513,0)="""RTN"",""PSSHDPG1"",135,0)"
^XMB(3.9,146101,2,514,0)="SPUSH(S,X) ;places X on the stack S and returns the current level of the stack  (copied from PARSE^ORRDI1)"
^XMB(3.9,146101,2,515,0)="""RTN"",""PSSHDPG1"",136,0)"
^XMB(3.9,146101,2,516,0)=" N I S I=$O(S(""""),-1)+1,S(I)=X"
^XMB(3.9,146101,2,517,0)="""RTN"",""PSSHDPG1"",137,0)"
^XMB(3.9,146101,2,518,0)=" Q I"
^XMB(3.9,146101,2,519,0)="""RTN"",""PSSHDPG1"",138,0)"
^XMB(3.9,146101,2,520,0)=" ;"
^XMB(3.9,146101,2,521,0)="""RTN"",""PSSHDPG1"",139,0)"
^XMB(3.9,146101,2,522,0)="SPOP(S,X) ;removes the top item from the stack S and put it into the variable X and returns the level that X was at  (copied from PARSE^ORRDI1)"
^XMB(3.9,146101,2,523,0)="""RTN"",""PSSHDPG1"",140,0)"
^XMB(3.9,146101,2,524,0)=" N I S I=$O(S(""""),-1)"
^XMB(3.9,146101,2,525,0)="""RTN"",""PSSHDPG1"",141,0)"
^XMB(3.9,146101,2,526,0)=" I I S X=S(I) K S(I)"
^XMB(3.9,146101,2,527,0)="""RTN"",""PSSHDPG1"",142,0)"
^XMB(3.9,146101,2,528,0)=" N J S J=$O(S(I),-1) I J S S(J,X)=$G(S(J,X))+1"
^XMB(3.9,146101,2,529,0)="""RTN"",""PSSHDPG1"",143,0)"
^XMB(3.9,146101,2,530,0)=" Q I"
^XMB(3.9,146101,2,531,0)="""RTN"",""PSSHDPG1"",144,0)"
^XMB(3.9,146101,2,532,0)=" ;"
^XMB(3.9,146101,2,533,0)="""RTN"",""PSSHDPG1"",145,0)"
^XMB(3.9,146101,2,534,0)="SPEEK(S,X) ;same as SPOP except the top item is not removed  (copied from PARSE^ORRDI1)"
^XMB(3.9,146101,2,535,0)="""RTN"",""PSSHDPG1"",146,0)"
^XMB(3.9,146101,2,536,0)=" N I S I=$O(S(""""),-1)"
^XMB(3.9,146101,2,537,0)="""RTN"",""PSSHDPG1"",147,0)"
^XMB(3.9,146101,2,538,0)=" I I S X=S(I)"
^XMB(3.9,146101,2,539,0)="""RTN"",""PSSHDPG1"",148,0)"
^XMB(3.9,146101,2,540,0)=" Q I"
^XMB(3.9,146101,2,541,0)="""RTN"",""PSSHDPG1"",149,0)"
^XMB(3.9,146101,2,542,0)=" ;"
^XMB(3.9,146101,2,543,0)="""RTN"",""PSSHDPG1"",150,0)"
^XMB(3.9,146101,2,544,0)="SPUT(S,X) ;implementation specific, uses the stack to form a global node  (copied from PARSE^ORRDI1)"
^XMB(3.9,146101,2,545,0)="""RTN"",""PSSHDPG1"",151,0)"
^XMB(3.9,146101,2,546,0)=" N I,STR"
^XMB(3.9,146101,2,547,0)="""RTN"",""PSSHDPG1"",152,0)"
^XMB(3.9,146101,2,548,0)=" S STR=$P(GL,"")"")"
^XMB(3.9,146101,2,549,0)="""RTN"",""PSSHDPG1"",153,0)"
^XMB(3.9,146101,2,550,0)=" S I=0 F  S I=$O(S(I)) Q:'I  D"
^XMB(3.9,146101,2,551,0)="""RTN"",""PSSHDPG1"",154,0)"
^XMB(3.9,146101,2,552,0)=" .S STR=STR_"",""_""""""""_S(I)_""""""""_"","""
^XMB(3.9,146101,2,553,0)="""RTN"",""PSSHDPG1"",155,0)"
^XMB(3.9,146101,2,554,0)=" .N NUM S NUM=0"
^XMB(3.9,146101,2,555,0)="""RTN"",""PSSHDPG1"",156,0)"
^XMB(3.9,146101,2,556,0)=" .I $D(S(I-1,S(I))) S NUM=+$G(S(I-1,S(I)))"
^XMB(3.9,146101,2,557,0)="""RTN"",""PSSHDPG1"",157,0)"
^XMB(3.9,146101,2,558,0)=" .S STR=STR_NUM"
^XMB(3.9,146101,2,559,0)="""RTN"",""PSSHDPG1"",158,0)"
^XMB(3.9,146101,2,560,0)=" S STR=STR_"")"""
^XMB(3.9,146101,2,561,0)="""RTN"",""PSSHDPG1"",159,0)"
^XMB(3.9,146101,2,562,0)=" I $D(@STR) S @STR=@STR_X"
^XMB(3.9,146101,2,563,0)="""RTN"",""PSSHDPG1"",160,0)"
^XMB(3.9,146101,2,564,0)=" I '$D(@STR) S @STR=X"
^XMB(3.9,146101,2,565,0)="""RTN"",""PSSHDPG1"",161,0)"
^XMB(3.9,146101,2,566,0)=" Q STR"
^XMB(3.9,146101,2,567,0)="""RTN"",""PSSHDPG1"",162,0)"
^XMB(3.9,146101,2,568,0)=" ;"
^XMB(3.9,146101,2,569,0)="""RTN"",""PSSHDPG1"",163,0)"
^XMB(3.9,146101,2,570,0)="REMOVEOFFSET(TIME) ;"
^XMB(3.9,146101,2,571,0)="""RTN"",""PSSHDPG1"",164,0)"
^XMB(3.9,146101,2,572,0)=" S TIME=$P(TIME,""-"")"
^XMB(3.9,146101,2,573,0)="""RTN"",""PSSHDPG1"",165,0)"
^XMB(3.9,146101,2,574,0)=" S TIME=$P(TIME,""+"")"
^XMB(3.9,146101,2,575,0)="""RTN"",""PSSHDPG1"",166,0)"
^XMB(3.9,146101,2,576,0)=" S TIME=$P(TIME,""Z"")"
^XMB(3.9,146101,2,577,0)="""RTN"",""PSSHDPG1"",167,0)"
^XMB(3.9,146101,2,578,0)=" Q TIME"
^XMB(3.9,146101,2,579,0)="""RTN"",""PSSHDPG1"",168,0)"
^XMB(3.9,146101,2,580,0)=" ;"
^XMB(3.9,146101,2,581,0)="""RTN"",""PSSHDPG1"",169,0)"
^XMB(3.9,146101,2,582,0)="ERROR  ;"
^XMB(3.9,146101,2,583,0)="""RTN"",""PSSHDPG1"",170,0)"
^XMB(3.9,146101,2,584,0)=" ; @DESC Handles error during request to HDR via webservice."
^XMB(3.9,146101,2,585,0)="""RTN"",""PSSHDPG1"",171,0)"
^XMB(3.9,146101,2,586,0)=" ;"
^XMB(3.9,146101,2,587,0)="""RTN"",""PSSHDPG1"",172,0)"
^XMB(3.9,146101,2,588,0)=" ; Depends on GLOBAL variable PSSERR to be set in previous call."
^XMB(3.9,146101,2,589,0)="""RTN"",""PSSHDPG1"",173,0)"
^XMB(3.9,146101,2,590,0)=" ;"
^XMB(3.9,146101,2,591,0)="""RTN"",""PSSHDPG1"",174,0)"
^XMB(3.9,146101,2,592,0)=" ; @RETURNS Nothing. Value store in global."
^XMB(3.9,146101,2,593,0)="""RTN"",""PSSHDPG1"",175,0)"
^XMB(3.9,146101,2,594,0)=" ;"
^XMB(3.9,146101,2,595,0)="""RTN"",""PSSHDPG1"",176,0)"
^XMB(3.9,146101,2,596,0)=" N ERRARRAY"
^XMB(3.9,146101,2,597,0)="""RTN"",""PSSHDPG1"",177,0)"
^XMB(3.9,146101,2,598,0)=" ;"
^XMB(3.9,146101,2,599,0)="""RTN"",""PSSHDPG1"",178,0)"
^XMB(3.9,146101,2,600,0)=" ; Get error object from Error Object Factory"
^XMB(3.9,146101,2,601,0)="""RTN"",""PSSHDPG1"",179,0)"
^XMB(3.9,146101,2,602,0)=" I $G(PSSERR)="""" S PSSERR=$$EOFAC^XOBWLIB()"
^XMB(3.9,146101,2,603,0)="""RTN"",""PSSHDPG1"",180,0)"
^XMB(3.9,146101,2,604,0)=" ; Store the error object in the error array"
^XMB(3.9,146101,2,605,0)="""RTN"",""PSSHDPG1"",181,0)"
^XMB(3.9,146101,2,606,0)=" D ERR2ARR^XOBWLIB(PSSERR,.ERRARRAY)"
^XMB(3.9,146101,2,607,0)="""RTN"",""PSSHDPG1"",182,0)"
^XMB(3.9,146101,2,608,0)=" ;"
^XMB(3.9,146101,2,609,0)="""RTN"",""PSSHDPG1"",183,0)"
^XMB(3.9,146101,2,610,0)=" ; Parse out the error text and store in global"
^XMB(3.9,146101,2,611,0)="""RTN"",""PSSHDPG1"",184,0)"
^XMB(3.9,146101,2,612,0)=" S ^TMP($J,""PSSHDPG1"",""EXCEPTION"")=$$GETTEXT(.ERRARRAY)"
^XMB(3.9,146101,2,613,0)="""RTN"",""PSSHDPG1"",185,0)"
^XMB(3.9,146101,2,614,0)=" ; Set ecode to empty to return to calling function"
^XMB(3.9,146101,2,615,0)="""RTN"",""PSSHDPG1"",186,0)"
^XMB(3.9,146101,2,616,0)=" SET $ECODE="""""
^XMB(3.9,146101,2,617,0)="""RTN"",""PSSHDPG1"",187,0)"
^XMB(3.9,146101,2,618,0)=" ;"
^XMB(3.9,146101,2,619,0)="""RTN"",""PSSHDPG1"",188,0)"
^XMB(3.9,146101,2,620,0)=" Q"
^XMB(3.9,146101,2,621,0)="""RTN"",""PSSHDPG1"",189,0)"
^XMB(3.9,146101,2,622,0)=" ;"
^XMB(3.9,146101,2,623,0)="""RTN"",""PSSHDPG1"",190,0)"
^XMB(3.9,146101,2,624,0)="GETTEXT(ERRARRAY) ;"
^XMB(3.9,146101,2,625,0)="""RTN"",""PSSHDPG1"",191,0)"
^XMB(3.9,146101,2,626,0)=" ; @DESC Gets the error text from the array"
^XMB(3.9,146101,2,627,0)="""RTN"",""PSSHDPG1"",192,0)"
^XMB(3.9,146101,2,628,0)=" ;"
^XMB(3.9,146101,2,629,0)="""RTN"",""PSSHDPG1"",193,0)"
^XMB(3.9,146101,2,630,0)=" ; @ERRARRAY Error array stores error in format defined by web service product."
^XMB(3.9,146101,2,631,0)="""RTN"",""PSSHDPG1"",194,0)"
^XMB(3.9,146101,2,632,0)=" ;"
^XMB(3.9,146101,2,633,0)="""RTN"",""PSSHDPG1"",195,0)"
^XMB(3.9,146101,2,634,0)=" ; @RETURNS Error info as a single string"
^XMB(3.9,146101,2,635,0)="""RTN"",""PSSHDPG1"",196,0)"
^XMB(3.9,146101,2,636,0)=" ;"
^XMB(3.9,146101,2,637,0)="""RTN"",""PSSHDPG1"",197,0)"
^XMB(3.9,146101,2,638,0)=" N PSS"
^XMB(3.9,146101,2,639,0)="""RTN"",""PSSHDPG1"",198,0)"
^XMB(3.9,146101,2,640,0)=" ;"
^XMB(3.9,146101,2,641,0)="""RTN"",""PSSHDPG1"",199,0)"
^XMB(3.9,146101,2,642,0)=" ; Loop through the text subscript of error array and concatenate"
^XMB(3.9,146101,2,643,0)="""RTN"",""PSSHDPG1"",200,0)"
^XMB(3.9,146101,2,644,0)=" S PSS(""errorText"")="""""
^XMB(3.9,146101,2,645,0)="""RTN"",""PSSHDPG1"",201,0)"
^XMB(3.9,146101,2,646,0)=" S PSS(""I"")="""""
^XMB(3.9,146101,2,647,0)="""RTN"",""PSSHDPG1"",202,0)"
^XMB(3.9,146101,2,648,0)=" F  S PSS(""I"")=$O(ERRARRAY(""text"",PSS(""I""))) Q:PSS(""I"")=""""  D"
^XMB(3.9,146101,2,649,0)="""RTN"",""PSSHDPG1"",203,0)"
^XMB(3.9,146101,2,650,0)=" . S PSS(""errorText"")=PSS(""errorText"")_ERRARRAY(""text"",PSS(""I""))"
^XMB(3.9,146101,2,651,0)="""RTN"",""PSSHDPG1"",204,0)"
^XMB(3.9,146101,2,652,0)=" ;"
^XMB(3.9,146101,2,653,0)="""RTN"",""PSSHDPG1"",205,0)"
^XMB(3.9,146101,2,654,0)=" Q PSS(""errorText"")"
^XMB(3.9,146101,2,655,0)="""RTN"",""PSSHDPG1"",206,0)"
^XMB(3.9,146101,2,656,0)=" ;;"
^XMB(3.9,146101,2,657,0)="""RTN"",""PSSPGXPR"")"
^XMB(3.9,146101,2,658,0)="0^1^B153686641"
^XMB(3.9,146101,2,659,0)="""RTN"",""PSSPGXPR"",1,0)"
^XMB(3.9,146101,2,660,0)="PSSPGXPR ;BIR/RTR - PHARMACOGENOMICS PRODUCTION ORDER CHECK ;09/20/07"
^XMB(3.9,146101,2,661,0)="""RTN"",""PSSPGXPR"",2,0)"
^XMB(3.9,146101,2,662,0)=" ;;1.0;PHARMACY DATA MANAGEMENT;**262,268**;9/30/97;Build 0"
^XMB(3.9,146101,2,663,0)="""RTN"",""PSSPGXPR"",3,0)"
^XMB(3.9,146101,2,664,0)=" ;"
^XMB(3.9,146101,2,665,0)="""RTN"",""PSSPGXPR"",4,0)"
^XMB(3.9,146101,2,666,0)="CHECK ;Process PGX results for Pharmacy"
^XMB(3.9,146101,2,667,0)="""RTN"",""PSSPGXPR"",5,0)"
^XMB(3.9,146101,2,668,0)=" N PSSPHAR,PSSPHDT"
^XMB(3.9,146101,2,669,0)="""RTN"",""PSSPGXPR"",6,0)"
^XMB(3.9,146101,2,670,0)=" D ERR^PSSPGXUT"
^XMB(3.9,146101,2,671,0)="""RTN"",""PSSPGXPR"",7,0)"
^XMB(3.9,146101,2,672,0)=" D GETD"
^XMB(3.9,146101,2,673,0)="""RTN"",""PSSPGXPR"",8,0)"
^XMB(3.9,146101,2,674,0)=" I $G(PSSPGXOR) D SETOR^PSSPGXOR Q"
^XMB(3.9,146101,2,675,0)="""RTN"",""PSSPGXPR"",9,0)"
^XMB(3.9,146101,2,676,0)=" D SETPGX"
^XMB(3.9,146101,2,677,0)="""RTN"",""PSSPGXPR"",10,0)"
^XMB(3.9,146101,2,678,0)=" Q"
^XMB(3.9,146101,2,679,0)="""RTN"",""PSSPGXPR"",11,0)"
^XMB(3.9,146101,2,680,0)="GETD ;"
^XMB(3.9,146101,2,681,0)="""RTN"",""PSSPGXPR"",12,0)"
^XMB(3.9,146101,2,682,0)=" N PSSPH1,PSSPH2,PSSPH3,PSSPH4,PSSPH5,PSSPH6,PSSHP7,PSSPH9,PSSCAT,PSSCAT1,PSSCAT2,PSSPHQ,PSSPGX1,PSSPGX2,PSSPGX3,PSSPHQTT,PSSSUB1,PSSDNAME,PSSOURCE,PSSREFDO,PSSREFTP,PSSXLOOP,PSSTMPVL,PSSREFAR,PSSCIT1,PSSCIT2,PSSCIT3,PSSCITCR,PSSGCTR,PSSGCTRV"
^XMB(3.9,146101,2,683,0)="""RTN"",""PSSPGXPR"",13,0)"
^XMB(3.9,146101,2,684,0)=" N PSSPH7"
^XMB(3.9,146101,2,685,0)="""RTN"",""PSSPGXPR"",14,0)"
^XMB(3.9,146101,2,686,0)=" S (PSSPGX1,PSSPGX2,PSSPGX3,PSSCITCR)=0 K PSSPHDT,PSSPHAR"
^XMB(3.9,146101,2,687,0)="""RTN"",""PSSPGXPR"",15,0)"
^XMB(3.9,146101,2,688,0)=" S PSSPH1="""" F  S PSSPH1=$O(^TMP(""PSSPGXBS"",$J,PSSPH1)) Q:PSSPH1=""""  D"
^XMB(3.9,146101,2,689,0)="""RTN"",""PSSPGXPR"",16,0)"
^XMB(3.9,146101,2,690,0)=" .S PSSPH2="""" F  S PSSPH2=$O(^TMP(""PSSPGXBS"",$J,PSSPH1,PSSPH2)) Q:PSSPH2=""""  D"
^XMB(3.9,146101,2,691,0)="""RTN"",""PSSPGXPR"",17,0)"
^XMB(3.9,146101,2,692,0)=" ..S PSSPH7="""" F  S PSSPH7=$O(^TMP(""PSSPGXBS"",$J,PSSPH1,PSSPH2,""C"",PSSPH7)) Q:PSSPH7=""""  D"
^XMB(3.9,146101,2,693,0)="""RTN"",""PSSPGXPR"",18,0)"
^XMB(3.9,146101,2,694,0)=" ...I $G(^TMP(""PSSPGXBS"",$J,PSSPH1,PSSPH2,""C"",PSSPH7))=""PEPSVersion"" D"
^XMB(3.9,146101,2,695,0)="""RTN"",""PSSPGXPR"",19,0)"
