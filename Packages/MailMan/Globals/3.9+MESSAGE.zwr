^XMB(3.9,146057,2,187,0)="""QUES"",""XPI1"",0)"
^XMB(3.9,146057,2,188,0)="YO"
^XMB(3.9,146057,2,189,0)="""QUES"",""XPI1"",""??"")"
^XMB(3.9,146057,2,190,0)="^D INHIBIT^XPDH"
^XMB(3.9,146057,2,191,0)="""QUES"",""XPI1"",""A"")"
^XMB(3.9,146057,2,192,0)="Want KIDS to INHIBIT LOGONs during the install"
^XMB(3.9,146057,2,193,0)="""QUES"",""XPI1"",""B"")"
