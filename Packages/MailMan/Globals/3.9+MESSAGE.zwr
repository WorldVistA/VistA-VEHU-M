^XMB(3.9,146052,2,1986,0)=" I '$D(FBVOID) S DR=""16///^S X=VP;17////^S X=DUZ""_$S($D(FBVR):"";16.5////^S X=FBVR"",1:"";16.5R;S FBVR=X"")"
