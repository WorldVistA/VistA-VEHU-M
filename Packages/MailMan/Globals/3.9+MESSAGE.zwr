^XMB(3.9,146036,2,3010,0)=" S DVBRTN=""-1^No Update"""
^XMB(3.9,146036,2,3011,0)="""RTN"",""DVBSIGN"",126,0)"
^XMB(3.9,146036,2,3012,0)=" I DVBIEN="""" S DVBRTN=""-1^No Worksheet IEN sent"" Q"
^XMB(3.9,146036,2,3013,0)="""RTN"",""DVBSIGN"",127,0)"
^XMB(3.9,146036,2,3014,0)=" I $D(^DVB(396.17,DVBIEN))<10 S DVBRTN=""-1^Invalid Worksheet IEN"" Q"
