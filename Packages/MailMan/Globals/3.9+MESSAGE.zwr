^XMB(3.9,146101,2,1095,0)="""RTN"",""PSSPGXPR"",219,0)"
^XMB(3.9,146101,2,1096,0)=" .I $D(PSSCITX3(PSSCITX2)) Q"
^XMB(3.9,146101,2,1097,0)="""RTN"",""PSSPGXPR"",220,0)"
^XMB(3.9,146101,2,1098,0)=" .S PSSCITX3(PSSCITX2)="""""
^XMB(3.9,146101,2,1099,0)="""RTN"",""PSSPGXPR"",221,0)"
^XMB(3.9,146101,2,1100,0)=" .I $G(PSSPGXOR) S ^TMP($J,""PSSXWARN"",PSSACT,PSSXL,""AI"",PSSAIC)=PSSCITX4 D INCA Q"
^XMB(3.9,146101,2,1101,0)="""RTN"",""PSSPGXPR"",222,0)"
^XMB(3.9,146101,2,1102,0)=" .S PSSRCEVL=$G(PSSPHAR(PSSSUB1,PSSXL,""CITPRT"",PSSCITX1))"
