^XMB(3.9,146091,2,467,0)="""RTN"",""MAGQBUT4"",109,0)"
^XMB(3.9,146091,2,468,0)=" S X=""ERR^MAGQBTM"",@^%ZOSF(""TRAP"")"
^XMB(3.9,146091,2,469,0)="""RTN"",""MAGQBUT4"",110,0)"
^XMB(3.9,146091,2,470,0)=" K X"
^XMB(3.9,146091,2,471,0)="""RTN"",""MAGQBUT4"",111,0)"
^XMB(3.9,146091,2,472,0)=" S TMP=$$DIRHASH^MAGFILEB(FNAME,FLOC)"
