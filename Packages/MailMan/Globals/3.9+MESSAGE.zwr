^XMB(3.9,146020,2,1087,0)="""RTN"",""MPIFXMLP"",208,0)"
^XMB(3.9,146020,2,1088,0)=" I MPIN=""IDENTIFIER"" D  Q"
^XMB(3.9,146020,2,1089,0)="""RTN"",""MPIFXMLP"",209,0)"
^XMB(3.9,146020,2,1090,0)=" . K MPIIGNID"
^XMB(3.9,146020,2,1091,0)="""RTN"",""MPIFXMLP"",210,0)"
^XMB(3.9,146020,2,1092,0)=" . I MPIA(""type"")=""SS"",MPIA(""subtype"")=""ALIAS"" S MPIUSE=""ALIASSSN"" Q"
^XMB(3.9,146020,2,1093,0)="""RTN"",""MPIFXMLP"",211,0)"
