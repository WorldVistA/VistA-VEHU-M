^XMB(3.9,146098,2,1348,0)=" ; validate request is not already dispositioned"
^XMB(3.9,146098,2,1349,0)="""RTN"",""SDES2ARCLOSE"",68,0)"
^XMB(3.9,146098,2,1350,0)=" ;lab removing until ISS is ready I $$GET1^DIQ(409.85,ARIEN,21,""I"")'="""" D ERRLOG^SDESJSON(.SDERRORS,52,""Request is already dispositioned :""_$$GET1^DIQ(409.85,ARIEN,21,""E"")_""."")"
^XMB(3.9,146098,2,1351,0)="""RTN"",""SDES2ARCLOSE"",69,0)"
^XMB(3.9,146098,2,1352,0)=" Q:$D(SDERRORS) 0"
^XMB(3.9,146098,2,1353,0)="""RTN"",""SDES2ARCLOSE"",70,0)"
^XMB(3.9,146098,2,1354,0)=" Q ARIEN_""^""_DISP_""^""_DISPDT_""^""_PCMT"
^XMB(3.9,146098,2,1355,0)="""RTN"",""SDES2ARCLOSE"",71,0)"
^XMB(3.9,146098,2,1356,0)=" ;"
^XMB(3.9,146098,2,1357,0)="""RTN"",""SDES2ARCLOSE"",72,0)"
^XMB(3.9,146098,2,1358,0)="DISP(SDRETURN,ARIEN,DISP,DISPDT,PCMT,AUDITID,SDERRORS) ;Disposition an appt req"
^XMB(3.9,146098,2,1359,0)="""RTN"",""SDES2ARCLOSE"",73,0)"
^XMB(3.9,146098,2,1360,0)=" N ARFDA,ARRET,ARMSG,X,MI,%DT,SDERR,PARENTIEN,SDHL7IN,Y"
^XMB(3.9,146098,2,1361,0)="""RTN"",""SDES2ARCLOSE"",74,0)"
^XMB(3.9,146098,2,1362,0)=" S SDERR=0"
^XMB(3.9,146098,2,1363,0)="""RTN"",""SDES2ARCLOSE"",75,0)"
^XMB(3.9,146098,2,1364,0)=" S ARFDA=$NA(ARFDA(409.85,ARIEN_"",""))"
^XMB(3.9,146098,2,1365,0)="""RTN"",""SDES2ARCLOSE"",76,0)"
^XMB(3.9,146098,2,1366,0)=" S @ARFDA@(19)=DISPDT"
^XMB(3.9,146098,2,1367,0)="""RTN"",""SDES2ARCLOSE"",77,0)"
^XMB(3.9,146098,2,1368,0)=" S @ARFDA@(20)=DUZ"
^XMB(3.9,146098,2,1369,0)="""RTN"",""SDES2ARCLOSE"",78,0)"
^XMB(3.9,146098,2,1370,0)=" S @ARFDA@(21)=DISP"
^XMB(3.9,146098,2,1371,0)="""RTN"",""SDES2ARCLOSE"",79,0)"
^XMB(3.9,146098,2,1372,0)=" S @ARFDA@(23)=""C"""
^XMB(3.9,146098,2,1373,0)="""RTN"",""SDES2ARCLOSE"",80,0)"
^XMB(3.9,146098,2,1374,0)=" S @ARFDA@(100)=AUDITID"
^XMB(3.9,146098,2,1375,0)="""RTN"",""SDES2ARCLOSE"",81,0)"
^XMB(3.9,146098,2,1376,0)=" D UPDATE^DIE("""",""ARFDA"",""ARRET"",""ARMSG"")"
^XMB(3.9,146098,2,1377,0)="""RTN"",""SDES2ARCLOSE"",82,0)"
^XMB(3.9,146098,2,1378,0)=" I '$D(ARMSG) D"
^XMB(3.9,146098,2,1379,0)="""RTN"",""SDES2ARCLOSE"",83,0)"
^XMB(3.9,146098,2,1380,0)=" .S SDRETURN(""ApptReqDisposition"",""FilingSuccess"")=1"
^XMB(3.9,146098,2,1381,0)="""RTN"",""SDES2ARCLOSE"",84,0)"
^XMB(3.9,146098,2,1382,0)=" I $D(ARMSG(""DIERR"")) D"
^XMB(3.9,146098,2,1383,0)="""RTN"",""SDES2ARCLOSE"",85,0)"
^XMB(3.9,146098,2,1384,0)=" .S SDERR=1"
^XMB(3.9,146098,2,1385,0)="""RTN"",""SDES2ARCLOSE"",86,0)"
^XMB(3.9,146098,2,1386,0)=" .F MI=1:1:$G(ARMSG(""DIERR"")) D ERRLOG^SDESJSON(.SDERRORS,47,$G(ARMSG(""DIERR"",MI,""TEXT"",1)))"
^XMB(3.9,146098,2,1387,0)="""RTN"",""SDES2ARCLOSE"",87,0)"
^XMB(3.9,146098,2,1388,0)=" I '$G(SDERR)&($$GET1^DIQ(409.85,ARIEN,41,""I"")=1) D"
^XMB(3.9,146098,2,1389,0)="""RTN"",""SDES2ARCLOSE"",88,0)"
^XMB(3.9,146098,2,1390,0)=" . S PARENTIEN=$$GET1^DIQ(409.85,ARIEN,43.8,""I"")"
^XMB(3.9,146098,2,1391,0)="""RTN"",""SDES2ARCLOSE"",89,0)"
^XMB(3.9,146098,2,1392,0)=" . I PARENTIEN D"
^XMB(3.9,146098,2,1393,0)="""RTN"",""SDES2ARCLOSE"",90,0)"
^XMB(3.9,146098,2,1394,0)=" . . D REMOVEMRTCINFO^SDES2MRTCUTIL(PARENTIEN,ARIEN,.SDERRORS)"
^XMB(3.9,146098,2,1395,0)="""RTN"",""SDES2ARCLOSE"",91,0)"
^XMB(3.9,146098,2,1396,0)=" . . D UPDATEPARENT^SDES2MRTCUTIL(PARENTIEN,DISP,DISPDT,AUDITID,.SDERRORS)"
^XMB(3.9,146098,2,1397,0)="""RTN"",""SDES2ARCLOSE"",92,0)"
^XMB(3.9,146098,2,1398,0)=" I '$G(SDERR) D EDITPCMT(ARIEN,PCMT)"
^XMB(3.9,146098,2,1399,0)="""RTN"",""SDES2ARCLOSE"",93,0)"
^XMB(3.9,146098,2,1400,0)=" ;"
^XMB(3.9,146098,2,1401,0)="""RTN"",""SDES2ARCLOSE"",94,0)"
^XMB(3.9,146098,2,1402,0)=" ;SEND HL7 TO CPRS IF RTC REQUEST"
^XMB(3.9,146098,2,1403,0)="""RTN"",""SDES2ARCLOSE"",95,0)"
^XMB(3.9,146098,2,1404,0)=" ;"
^XMB(3.9,146098,2,1405,0)="""RTN"",""SDES2ARCLOSE"",96,0)"
^XMB(3.9,146098,2,1406,0)=" I '$G(SDERR),$P(^SDEC(409.85,ARIEN,0),U,5)=""RTC"" D"
^XMB(3.9,146098,2,1407,0)="""RTN"",""SDES2ARCLOSE"",97,0)"
^XMB(3.9,146098,2,1408,0)=" .I DISP=3!(DISP=9) D ARDISP^SDECHL7(ARIEN,"""")"
^XMB(3.9,146098,2,1409,0)="""RTN"",""SDES2ARCLOSE"",98,0)"
^XMB(3.9,146098,2,1410,0)=" .I DISP'=3&(DISP'=9) D ARDISP^SDECHL7(ARIEN,1)"
^XMB(3.9,146098,2,1411,0)="""RTN"",""SDES2ARCLOSE"",99,0)"
^XMB(3.9,146098,2,1412,0)=" .I $D(^TMP($J,""REJECT"",ARIEN)) D"
^XMB(3.9,146098,2,1413,0)="""RTN"",""SDES2ARCLOSE"",100,0)"
^XMB(3.9,146098,2,1414,0)=" ..S SDERR=1,X=$G(^TMP(SDHL7IN(""ORDER IEN"")))"
^XMB(3.9,146098,2,1415,0)="""RTN"",""SDES2ARCLOSE"",101,0)"
^XMB(3.9,146098,2,1416,0)=" ..D ERRLOG^SDESJSON(.SDRETURN,47,X)"
^XMB(3.9,146098,2,1417,0)="""RTN"",""SDES2ARCLOSE"",102,0)"
^XMB(3.9,146098,2,1418,0)=" Q"
^XMB(3.9,146098,2,1419,0)="""RTN"",""SDES2ARCLOSE"",103,0)"
^XMB(3.9,146098,2,1420,0)=" ;"
^XMB(3.9,146098,2,1421,0)="""RTN"",""SDES2ARCLOSE"",104,0)"
^XMB(3.9,146098,2,1422,0)="EDITPCMT(ARIEN,COMMENTSFLD60) ; update word processing PATIENT COMMENTS (409.855,60)"
^XMB(3.9,146098,2,1423,0)="""RTN"",""SDES2ARCLOSE"",105,0)"
^XMB(3.9,146098,2,1424,0)=" ; ARIEN - (required) IEN to entry in 409.85"
