^XMB(3.9,146100,2,239,0)="""RTN"",""RGADTP2"")"
^XMB(3.9,146100,2,240,0)="0^1^B87694121"
^XMB(3.9,146100,2,241,0)="""RTN"",""RGADTP2"",1,0)"
^XMB(3.9,146100,2,242,0)="RGADTP2 ;BIR/DLR-ADT PROCESSOR TO RETRIGGER A08 or A04 MESSAGES WITH AL/AL (COMMIT/APPLICATION) ACKNOWLEDGEMENTS - CONTINUED ;8/17/21  15:36"
^XMB(3.9,146100,2,243,0)="""RTN"",""RGADTP2"",2,0)"
^XMB(3.9,146100,2,244,0)=" ;;1.0;CLINICAL INFO RESOURCE NETWORK;**27,20,45,44,47,48,49,52,54,58,59,64,66,67,71,72,76**;30 Apr 99;Build 0"
^XMB(3.9,146100,2,245,0)="""RTN"",""RGADTP2"",3,0)"
^XMB(3.9,146100,2,246,0)="DBIA ;"
^XMB(3.9,146100,2,247,0)="""RTN"",""RGADTP2"",4,0)"
^XMB(3.9,146100,2,248,0)=" ;Reference to $$ADD^VAFCEHU1 supported by IA #2753"
^XMB(3.9,146100,2,249,0)="""RTN"",""RGADTP2"",5,0)"
^XMB(3.9,146100,2,250,0)=" ;Reference to EDIT^VAFCPTED supported by IA #2784"
^XMB(3.9,146100,2,251,0)="""RTN"",""RGADTP2"",6,0)"
^XMB(3.9,146100,2,252,0)=" ;Reference to ^DPT(DFN,.105) supported by IA #10035"
^XMB(3.9,146100,2,253,0)="""RTN"",""RGADTP2"",7,0)"
^XMB(3.9,146100,2,254,0)=" Q"
^XMB(3.9,146100,2,255,0)="""RTN"",""RGADTP2"",8,0)"
^XMB(3.9,146100,2,256,0)="PROCIN(ARRAY,RGLOCAL,RGER,DFN,HL) ;"
^XMB(3.9,146100,2,257,0)="""RTN"",""RGADTP2"",9,0)"
^XMB(3.9,146100,2,258,0)=" N RGRSDFN,OTHSITE,NODE,ICN,CMORIEN,CMOR,SENSTVTY,RMTDOD,LOCDOD,VAFCA,VAFCA08,HERE,BOGUS,ARAY,REP"
^XMB(3.9,146100,2,259,0)="""RTN"",""RGADTP2"",10,0)"
^XMB(3.9,146100,2,260,0)=" S REP=$E(HL(""ECH""),2)"
^XMB(3.9,146100,2,261,0)="""RTN"",""RGADTP2"",11,0)"
^XMB(3.9,146100,2,262,0)=" S HERE=$P($$SITE^VASITE,""^"",3)"
^XMB(3.9,146100,2,263,0)="""RTN"",""RGADTP2"",12,0)"
^XMB(3.9,146100,2,264,0)=" ;if sending site is your site quit"
^XMB(3.9,146100,2,265,0)="""RTN"",""RGADTP2"",13,0)"
^XMB(3.9,146100,2,266,0)=" Q:$G(ARRAY(""MPISSITE""))=$G(HERE)"
^XMB(3.9,146100,2,267,0)="""RTN"",""RGADTP2"",14,0)"
^XMB(3.9,146100,2,268,0)=" S ARRAY(.097)=$P($$NOW^XLFDT,""."")"
^XMB(3.9,146100,2,269,0)="""RTN"",""RGADTP2"",15,0)"
^XMB(3.9,146100,2,270,0)=" I $G(ARRAY(""ICN""))'="""" D"
^XMB(3.9,146100,2,271,0)="""RTN"",""RGADTP2"",16,0)"
^XMB(3.9,146100,2,272,0)=" .S RGRSDFN=$$GETDFN^MPIF001(+ARRAY(""ICN"")) I +RGRSDFN<1 S RGER=RGRSDFN_"" ICN#""_$G(ARRAY(""ICN"")) Q  ;quit and return error msg"
^XMB(3.9,146100,2,273,0)="""RTN"",""RGADTP2"",17,0)"
^XMB(3.9,146100,2,274,0)=" .S OTHSITE=ARRAY(""SENDING SITE"") ;**40 REMOVED THE PLUS TO KEEP SUFFIX ON STATION# & CHANGED THE SITE TO BE SENDING SITE INSTEAD OF AUTHORITATIVE SOURCE"
^XMB(3.9,146100,2,275,0)="""RTN"",""RGADTP2"",18,0)"
^XMB(3.9,146100,2,276,0)=" I $G(RGRSDFN)="""" S RGRSDFN=$G(DFN)"
^XMB(3.9,146100,2,277,0)="""RTN"",""RGADTP2"",19,0)"
^XMB(3.9,146100,2,278,0)=" I $G(RGRSDFN)="""" S RGER=""-1^DFN not defined"""
^XMB(3.9,146100,2,279,0)="""RTN"",""RGADTP2"",20,0)"
^XMB(3.9,146100,2,280,0)=" I $G(RGER) Q"
^XMB(3.9,146100,2,281,0)="""RTN"",""RGADTP2"",21,0)"
^XMB(3.9,146100,2,282,0)=" I $G(OTHSITE)="""" S OTHSITE="""""
^XMB(3.9,146100,2,283,0)="""RTN"",""RGADTP2"",22,0)"
^XMB(3.9,146100,2,284,0)=" S NODE=$$MPINODE^MPIFAPI(RGRSDFN)"
^XMB(3.9,146100,2,285,0)="""RTN"",""RGADTP2"",23,0)"
^XMB(3.9,146100,2,286,0)=" S ICN=$P(NODE,""^"")"
^XMB(3.9,146100,2,287,0)="""RTN"",""RGADTP2"",24,0)"
^XMB(3.9,146100,2,288,0)=" S CMORIEN=$P(NODE,""^"",3)"
^XMB(3.9,146100,2,289,0)="""RTN"",""RGADTP2"",25,0)"
^XMB(3.9,146100,2,290,0)=" ;"
^XMB(3.9,146100,2,291,0)="""RTN"",""RGADTP2"",26,0)"
^XMB(3.9,146100,2,292,0)=" ;**58,MPIC_2416: If there is no CMOR for the patient, set CMOR to """"."
^XMB(3.9,146100,2,293,0)="""RTN"",""RGADTP2"",27,0)"
^XMB(3.9,146100,2,294,0)=" ;  Prevents SUBSCRIPT error that occurs if """" is passed to $$NS^XUAF4."
^XMB(3.9,146100,2,295,0)="""RTN"",""RGADTP2"",28,0)"
^XMB(3.9,146100,2,296,0)=" S CMOR=$S(CMORIEN:$P($$NS^XUAF4(CMORIEN),""^"",2),1:"""")"
^XMB(3.9,146100,2,297,0)="""RTN"",""RGADTP2"",29,0)"
^XMB(3.9,146100,2,298,0)=" ;"
^XMB(3.9,146100,2,299,0)="""RTN"",""RGADTP2"",30,0)"
^XMB(3.9,146100,2,300,0)=" ;If patient is Sensitive at other site but not here send bulletin"
^XMB(3.9,146100,2,301,0)="""RTN"",""RGADTP2"",31,0)"
^XMB(3.9,146100,2,302,0)=" I $G(ARRAY(""SENSITIVITY""))'="""" S SENSTVTY=$G(ARRAY(""SENSITIVITY"")) D"
^XMB(3.9,146100,2,303,0)="""RTN"",""RGADTP2"",32,0)"
^XMB(3.9,146100,2,304,0)=" .N NAME S NAME=ARRAY(""NAME"")"
^XMB(3.9,146100,2,305,0)="""RTN"",""RGADTP2"",33,0)"
^XMB(3.9,146100,2,306,0)=" .I '$$SENSTIVE^RGRSENS(RGRSDFN),SENSTVTY D"
^XMB(3.9,146100,2,307,0)="""RTN"",""RGADTP2"",34,0)"
^XMB(3.9,146100,2,308,0)=" ..S ARAY(""SSN"")=ARRAY(""SSN""),ARAY(""SENDING SITE"")=ARRAY(""SENDING SITE"")"
^XMB(3.9,146100,2,309,0)="""RTN"",""RGADTP2"",35,0)"
^XMB(3.9,146100,2,310,0)=" ..S ARAY(""SENSITIVITY USER"")=ARRAY(""SENSITIVITY USER""),ARAY(""SENSITIVITY DATE"")=ARRAY(""SENSITIVITY DATE"")"
^XMB(3.9,146100,2,311,0)="""RTN"",""RGADTP2"",36,0)"
^XMB(3.9,146100,2,312,0)=" ..D SENSTIVE^RGRSBUL1(RGRSDFN,""ARAY"",NAME)"
^XMB(3.9,146100,2,313,0)="""RTN"",""RGADTP2"",37,0)"
^XMB(3.9,146100,2,314,0)=" ;"
^XMB(3.9,146100,2,315,0)="""RTN"",""RGADTP2"",38,0)"
^XMB(3.9,146100,2,316,0)=" ;MPIC_772 - **52; Commented out Remote Date of Death Indicated section."
^XMB(3.9,146100,2,317,0)="""RTN"",""RGADTP2"",39,0)"
^XMB(3.9,146100,2,318,0)=" ;If patient has DATE OF DEATH (DOD) at remote site send bulletin"
^XMB(3.9,146100,2,319,0)="""RTN"",""RGADTP2"",40,0)"
^XMB(3.9,146100,2,320,0)=" ;Ignore time if present with date."
^XMB(3.9,146100,2,321,0)="""RTN"",""RGADTP2"",41,0)"
^XMB(3.9,146100,2,322,0)=" ;S RMTDOD=$G(ARRAY(""MPIDOD"")),RMTDOD=$P(RMTDOD,""."")"
^XMB(3.9,146100,2,323,0)="""RTN"",""RGADTP2"",42,0)"
^XMB(3.9,146100,2,324,0)=" ;S DFN=RGRSDFN D DEM^VADPT"
^XMB(3.9,146100,2,325,0)="""RTN"",""RGADTP2"",43,0)"
^XMB(3.9,146100,2,326,0)=" ;S LOCDOD=$P($P(VADM(6),""^""),""."")"
^XMB(3.9,146100,2,327,0)="""RTN"",""RGADTP2"",44,0)"
^XMB(3.9,146100,2,328,0)=" ;If there is a remote DOD but no local DOD  OR if remote DOD is different from local DOD, send bulletin"
^XMB(3.9,146100,2,329,0)="""RTN"",""RGADTP2"",45,0)"
^XMB(3.9,146100,2,330,0)=" ;I RMTDOD D"
^XMB(3.9,146100,2,331,0)="""RTN"",""RGADTP2"",46,0)"
^XMB(3.9,146100,2,332,0)=" ;.N NAME S NAME=ARRAY(""NAME""),ARAY(""SSN"")=ARRAY(""SSN""),ARAY(""SENDING SITE"")=ARRAY(""SENDING SITE"")"
^XMB(3.9,146100,2,333,0)="""RTN"",""RGADTP2"",47,0)"
^XMB(3.9,146100,2,334,0)=" ;.D RMTDOD^RGRSBUL1(RGRSDFN,""ARAY"",NAME,RMTDOD,LOCDOD)"
^XMB(3.9,146100,2,335,0)="""RTN"",""RGADTP2"",48,0)"
^XMB(3.9,146100,2,336,0)=" ;K VADM"
^XMB(3.9,146100,2,337,0)="""RTN"",""RGADTP2"",49,0)"
^XMB(3.9,146100,2,338,0)=" ;"
^XMB(3.9,146100,2,339,0)="""RTN"",""RGADTP2"",50,0)"
^XMB(3.9,146100,2,340,0)="NOTLOC I 'RGLOCAL D"
^XMB(3.9,146100,2,341,0)="""RTN"",""RGADTP2"",51,0)"
^XMB(3.9,146100,2,342,0)=" .;**45 if sending site is NOT the CMOR and NOT the MPI - log update into PDR if differences exist"
^XMB(3.9,146100,2,343,0)="""RTN"",""RGADTP2"",52,0)"
^XMB(3.9,146100,2,344,0)=" .;**49 stop logging entries into PDR"
^XMB(3.9,146100,2,345,0)="""RTN"",""RGADTP2"",53,0)"
^XMB(3.9,146100,2,346,0)=" .;I (OTHSITE)'=(CMOR)&(OTHSITE'=""200M"") D  Q"
^XMB(3.9,146100,2,347,0)="""RTN"",""RGADTP2"",54,0)"
^XMB(3.9,146100,2,348,0)=" .;.S VAFCA=$P($$NOW^XLFDT,""."")_""^""_$$NOW^XLFDT_""^""_$G(ARRAY(""SENDING SITE""))_""^""_RGRSDFN"
^XMB(3.9,146100,2,349,0)="""RTN"",""RGADTP2"",55,0)"
^XMB(3.9,146100,2,350,0)=" .;.S ARRAY(.01)=$$FREE^RGRSPARS(ARRAY(""NAME"")),ARRAY(.03)=$$FREE^RGRSPARS($G(ARRAY(""MPIDOB"")))"
^XMB(3.9,146100,2,351,0)="""RTN"",""RGADTP2"",56,0)"
^XMB(3.9,146100,2,352,0)=" .;.S ARRAY(.09)=$$FREE^RGRSPARS($G(ARRAY(""SSN""))),ARRAY(.02)=$$SEX^RGRSPARS($G(ARRAY(""SEX"")))"
^XMB(3.9,146100,2,353,0)="""RTN"",""RGADTP2"",57,0)"
^XMB(3.9,146100,2,354,0)=" .;.S ARRAY(.2403)=$$FREE^RGRSPARS($G(ARRAY(""MMN""))),ARRAY(991.01)=$P($G(ARRAY(""ICN"")),""V"")"
^XMB(3.9,146100,2,355,0)="""RTN"",""RGADTP2"",58,0)"
^XMB(3.9,146100,2,356,0)=" .;.N ARAY M ARAY(2)=ARRAY"
^XMB(3.9,146100,2,357,0)="""RTN"",""RGADTP2"",59,0)"
^XMB(3.9,146100,2,358,0)=" .;.S VAFCA08=1 ;S BOGUS=$$ADD^VAFCEHU1(VAFCA,""ARAY"") ;used by ^DD's to stop add to adt/hl7 pivot (#391.71) file "
^XMB(3.9,146100,2,359,0)="""RTN"",""RGADTP2"",60,0)"
^XMB(3.9,146100,2,360,0)=" .;"
^XMB(3.9,146100,2,361,0)="""RTN"",""RGADTP2"",61,0)"
^XMB(3.9,146100,2,362,0)=" .;**45 if sending site is the CMOR OR MPI - synchronize data"
^XMB(3.9,146100,2,363,0)="""RTN"",""RGADTP2"",62,0)"
^XMB(3.9,146100,2,364,0)=" .I (OTHSITE)=(CMOR)!(OTHSITE=""200M"") D"
^XMB(3.9,146100,2,365,0)="""RTN"",""RGADTP2"",63,0)"
^XMB(3.9,146100,2,366,0)=" ..I HL(""ETN"")=""A31"",$G(RGRSDFN)>0 K ^XTMP(""MPIF OLD RECORDS"",RGRSDFN) ;**59,MVI_914: Delete the old record designation"
^XMB(3.9,146100,2,367,0)="""RTN"",""RGADTP2"",64,0)"
^XMB(3.9,146100,2,368,0)=" ..;**66 - Story 349269 (ckn) - Moved below two lines here from below"
^XMB(3.9,146100,2,369,0)="""RTN"",""RGADTP2"",65,0)"
^XMB(3.9,146100,2,370,0)=" ..;to check the differences in field values before checking Inpatient"
^XMB(3.9,146100,2,371,0)="""RTN"",""RGADTP2"",66,0)"
^XMB(3.9,146100,2,372,0)=" ..;status and outstanding edit in the ADT/HL7 PIVOT file"
^XMB(3.9,146100,2,373,0)="""RTN"",""RGADTP2"",67,0)"
^XMB(3.9,146100,2,374,0)=" ..N DR,ARAY2,INPFLG"
^XMB(3.9,146100,2,375,0)="""RTN"",""RGADTP2"",68,0)"
^XMB(3.9,146100,2,376,0)=" ..S RGER="""",INPFLG=0"
^XMB(3.9,146100,2,377,0)="""RTN"",""RGADTP2"",69,0)"
^XMB(3.9,146100,2,378,0)=" ..D DIFF^RGADTP3(.ARRAY,RGRSDFN,.DR,.ARAY) ;check for differences ;**59, MVI_881 4th parameter to be 'ARAY'"
^XMB(3.9,146100,2,379,0)="""RTN"",""RGADTP2"",70,0)"
^XMB(3.9,146100,2,380,0)=" ..;"
^XMB(3.9,146100,2,381,0)="""RTN"",""RGADTP2"",71,0)"
^XMB(3.9,146100,2,382,0)=" ..;**RG*1.0*64/Story 220139 (cml): check for inpatient status, stop update if"
^XMB(3.9,146100,2,383,0)="""RTN"",""RGADTP2"",72,0)"
^XMB(3.9,146100,2,384,0)=" ..;patient is currently an inpatient, could cause confusion with treatment if"
^XMB(3.9,146100,2,385,0)="""RTN"",""RGADTP2"",73,0)"
^XMB(3.9,146100,2,386,0)=" ..;wristband doesn't match VistA"
^XMB(3.9,146100,2,387,0)="""RTN"",""RGADTP2"",74,0)"
^XMB(3.9,146100,2,388,0)=" ..;**RG*1.0*66 - Story 349269 (ckn) - Inpatient Edits pending request shall"
^XMB(3.9,146100,2,389,0)="""RTN"",""RGADTP2"",75,0)"
^XMB(3.9,146100,2,390,0)=" ..;only be logged in TK if ID traits-Name, DOB, Gender, SSN or Date of Death"
^XMB(3.9,146100,2,391,0)="""RTN"",""RGADTP2"",76,0)"
^XMB(3.9,146100,2,392,0)=" ..;is changed. Also, it should not log unless MBI is getting set to ""Yes""."
^XMB(3.9,146100,2,393,0)="""RTN"",""RGADTP2"",77,0)"
^XMB(3.9,146100,2,394,0)=" ..;By setting RGER the App Ack will contain ""is currently an Inpatient,"" and"
^XMB(3.9,146100,2,395,0)="""RTN"",""RGADTP2"",78,0)"
^XMB(3.9,146100,2,396,0)=" ..;the MPI will see that and log a #6230 request type to TK."
^XMB(3.9,146100,2,397,0)="""RTN"",""RGADTP2"",79,0)"
^XMB(3.9,146100,2,398,0)=" ..I $G(^DPT(RGRSDFN,.105)) D  ;patient is an inpatient"
^XMB(3.9,146100,2,399,0)="""RTN"",""RGADTP2"",80,0)"
^XMB(3.9,146100,2,400,0)=" ...I DR="""" Q  ;No edit  **72 (cmc) story 1104673 changed name from .01 to 1.01 \/ from patch 71 change to name"
^XMB(3.9,146100,2,401,0)="""RTN"",""RGADTP2"",81,0)"
^XMB(3.9,146100,2,402,0)=" ...N I F I=""1.01"","".02"","".03"","".09"","".351"" I ("";""_DR)[("";""_I_"";"") S INPFLG=1 Q"
^XMB(3.9,146100,2,403,0)="""RTN"",""RGADTP2"",82,0)"
^XMB(3.9,146100,2,404,0)=" ...I (("";""_DR)[("";""_994_"";"")),($G(ARRAY(""MBI""))=""Y"") S INPFLG=1 Q"
^XMB(3.9,146100,2,405,0)="""RTN"",""RGADTP2"",83,0)"
^XMB(3.9,146100,2,406,0)=" ..I INPFLG S RGER=""-1^DFN ""_RGRSDFN_"":  is currently an Inpatient, MPI update not processed."" I +RGER<0 Q"
^XMB(3.9,146100,2,407,0)="""RTN"",""RGADTP2"",84,0)"
^XMB(3.9,146100,2,408,0)=" ..;"
^XMB(3.9,146100,2,409,0)="""RTN"",""RGADTP2"",85,0)"
^XMB(3.9,146100,2,410,0)=" ..;**44 is there an outstanding edit in the ADT/HL7 PIVOT file for this patient for an identity element"
^XMB(3.9,146100,2,411,0)="""RTN"",""RGADTP2"",86,0)"
^XMB(3.9,146100,2,412,0)=" ..S RGER=$$CHKPVT^RGADTP3(.ARRAY) I +RGER<0 Q"
^XMB(3.9,146100,2,413,0)="""RTN"",""RGADTP2"",87,0)"
^XMB(3.9,146100,2,414,0)=" ..;"
^XMB(3.9,146100,2,415,0)="""RTN"",""RGADTP2"",88,0)"
^XMB(3.9,146100,2,416,0)=" ..S RGER="""" ;**67, Story 445418 (jfw) Set RGER to """" if 0 returned so that error can be returned in AA."
^XMB(3.9,146100,2,417,0)="""RTN"",""RGADTP2"",89,0)"
^XMB(3.9,146100,2,418,0)=" ..I DR'="""" D"
^XMB(3.9,146100,2,419,0)="""RTN"",""RGADTP2"",90,0)"
^XMB(3.9,146100,2,420,0)=" ...S VAFCA08=1 ;used by ^DD's to stop add to adt/hl7 pivot (#391.71) file"
^XMB(3.9,146100,2,421,0)="""RTN"",""RGADTP2"",91,0)"
^XMB(3.9,146100,2,422,0)=" ...S ARAY(2,.01)=ARRAY(""NAME"")"
^XMB(3.9,146100,2,423,0)="""RTN"",""RGADTP2"",92,0)"
^XMB(3.9,146100,2,424,0)=" ...S ARAY(2,.03)=$G(ARRAY(""MPIDOB""))"
^XMB(3.9,146100,2,425,0)="""RTN"",""RGADTP2"",93,0)"
^XMB(3.9,146100,2,426,0)=" ...I ARRAY(""SSN"")'="""" S ARAY(2,.09)=$G(ARRAY(""SSN"")) ;**45 only set SSN to update if it isn't null"
^XMB(3.9,146100,2,427,0)="""RTN"",""RGADTP2"",94,0)"
^XMB(3.9,146100,2,428,0)=" ...S ARAY(2,.02)=$G(ARRAY(""SEX""))"
^XMB(3.9,146100,2,429,0)="""RTN"",""RGADTP2"",95,0)"
^XMB(3.9,146100,2,430,0)=" ...S ARAY(2,.2403)=$G(ARRAY(""MMN""))"
^XMB(3.9,146100,2,431,0)="""RTN"",""RGADTP2"",96,0)"
^XMB(3.9,146100,2,432,0)=" ...S ARAY(2,994)=$G(ARRAY(""MBI""))"
^XMB(3.9,146100,2,433,0)="""RTN"",""RGADTP2"",97,0)"
^XMB(3.9,146100,2,434,0)=" ...I $D(ARRAY(""ALIAS"")) M ARAY(2,1)=ARRAY(""ALIAS"") ;**48 add alias to mix"
^XMB(3.9,146100,2,435,0)="""RTN"",""RGADTP2"",98,0)"
^XMB(3.9,146100,2,436,0)=" ...I $D(ARRAY(""SexOr"")) M ARAY(2,.025)=ARRAY(""SexOr"") ;**76, VAMPI-11114 (dri)"
^XMB(3.9,146100,2,437,0)="""RTN"",""RGADTP2"",99,0)"
^XMB(3.9,146100,2,438,0)=" ...I $D(ARRAY(""Pronoun"")) M ARAY(2,.2406)=ARRAY(""Pronoun"") ;**76, VAMPI-11118 (dri)"
^XMB(3.9,146100,2,439,0)="""RTN"",""RGADTP2"",100,0)"
^XMB(3.9,146100,2,440,0)=" ...D EDIT^VAFCPTED(RGRSDFN,""ARAY(2)"",DR) ;file differences into patient file"
^XMB(3.9,146100,2,441,0)="""RTN"",""RGADTP2"",101,0)"
^XMB(3.9,146100,2,442,0)=" ...;"
^XMB(3.9,146100,2,443,0)="""RTN"",""RGADTP2"",102,0)"
^XMB(3.9,146100,2,444,0)=" ...;check to see if edits were successful, if not set RGER=""why it failed"""
^XMB(3.9,146100,2,445,0)="""RTN"",""RGADTP2"",103,0)"
^XMB(3.9,146100,2,446,0)=" ...N NAME,SSN,PDOB,SEX,MMN,OLDNAME,OLDHLNAM,OLDMMN,OLDHLMMN,HLNAME,HLMMN,MBI"
^XMB(3.9,146100,2,447,0)="""RTN"",""RGADTP2"",104,0)"
^XMB(3.9,146100,2,448,0)=" ...S NAME=$$GET1^DIQ(2,+RGRSDFN_"","",.01,""I"")"
^XMB(3.9,146100,2,449,0)="""RTN"",""RGADTP2"",105,0)"
^XMB(3.9,146100,2,450,0)=" ...S PDOB=$$GET1^DIQ(2,+RGRSDFN_"","",.03,""I"")"
^XMB(3.9,146100,2,451,0)="""RTN"",""RGADTP2"",106,0)"
^XMB(3.9,146100,2,452,0)=" ...S SSN=$$GET1^DIQ(2,+RGRSDFN_"","",.09,""I"")"
^XMB(3.9,146100,2,453,0)="""RTN"",""RGADTP2"",107,0)"
^XMB(3.9,146100,2,454,0)=" ...S SEX=$$GET1^DIQ(2,+RGRSDFN_"","",.02,""I"")"
^XMB(3.9,146100,2,455,0)="""RTN"",""RGADTP2"",108,0)"
^XMB(3.9,146100,2,456,0)=" ...S MMN=$$GET1^DIQ(2,+RGRSDFN_"","",.2403,""I"")"
^XMB(3.9,146100,2,457,0)="""RTN"",""RGADTP2"",109,0)"
^XMB(3.9,146100,2,458,0)=" ...S MBI=$$GET1^DIQ(2,+RGRSDFN_"","",994,""I"")"
^XMB(3.9,146100,2,459,0)="""RTN"",""RGADTP2"",110,0)"
^XMB(3.9,146100,2,460,0)=" ...;"
^XMB(3.9,146100,2,461,0)="""RTN"",""RGADTP2"",111,0)"
^XMB(3.9,146100,2,462,0)=" ...I PDOB'=$G(ARRAY(""MPIDOB"")) S RGER=$S($G(RGER)'="""":$G(RGER)_REP,1:""-1^"")_""DOB field failure"""
^XMB(3.9,146100,2,463,0)="""RTN"",""RGADTP2"",112,0)"
^XMB(3.9,146100,2,464,0)=" ...I SEX'=$G(ARRAY(""SEX"")) S RGER=$S($G(RGER)'="""":$G(RGER)_REP,1:""-1^"")_""SEX field failure"""
^XMB(3.9,146100,2,465,0)="""RTN"",""RGADTP2"",113,0)"
^XMB(3.9,146100,2,466,0)=" ...I MBI'=$G(ARRAY(""MBI"")) D"
^XMB(3.9,146100,2,467,0)="""RTN"",""RGADTP2"",114,0)"
^XMB(3.9,146100,2,468,0)=" ....I MBI=""""&($G(ARRAY(""MBI""))=""@"") Q"
^XMB(3.9,146100,2,469,0)="""RTN"",""RGADTP2"",115,0)"
^XMB(3.9,146100,2,470,0)=" ....S RGER=$S($G(RGER)'="""":$G(RGER)_REP,1:""-1^"")_""MULTIPLE BIRTH INDICATOR field failure"""
^XMB(3.9,146100,2,471,0)="""RTN"",""RGADTP2"",116,0)"
^XMB(3.9,146100,2,472,0)=" ...D STDNAME^XLFNAME(.MMN,""F"",.OLDMMN) S HLMMN=ARRAY(""MMN"") D STDNAME^XLFNAME(.HLMMN,""F"",.OLDHLMMN) I MMN'=$G(HLMMN) S RGER=$S($G(RGER)'="""":$G(RGER)_REP,1:""-1^"")_""MOTHER'S MAIDEN NAME field failure"""
^XMB(3.9,146100,2,473,0)="""RTN"",""RGADTP2"",117,0)"
^XMB(3.9,146100,2,474,0)=" ...;"
^XMB(3.9,146100,2,475,0)="""RTN"",""RGADTP2"",118,0)"
^XMB(3.9,146100,2,476,0)=" ...;**71,Story 841921 (mko): Use this STDNAME method of checking that the name was updated only if the new Name Components flag is not set"
^XMB(3.9,146100,2,477,0)="""RTN"",""RGADTP2"",119,0)"
^XMB(3.9,146100,2,478,0)=" ...I '$$GETFLAG^MPIFNAMC D"
^XMB(3.9,146100,2,479,0)="""RTN"",""RGADTP2"",120,0)"
^XMB(3.9,146100,2,480,0)=" ....D STDNAME^XLFNAME(.NAME,""F"",.OLDNAME) S HLNAME=ARRAY(""NAME"") D STDNAME^XLFNAME(.HLNAME,""F"",.OLDHLNAM)"
^XMB(3.9,146100,2,481,0)="""RTN"",""RGADTP2"",121,0)"
^XMB(3.9,146100,2,482,0)=" ....I NAME'=$G(HLNAME) S RGER=$S($G(RGER)'="""":$G(RGER)_REP,1:""-1^"")_""Name field failure"""
^XMB(3.9,146100,2,483,0)="""RTN"",""RGADTP2"",122,0)"
^XMB(3.9,146100,2,484,0)=" ...;"
^XMB(3.9,146100,2,485,0)="""RTN"",""RGADTP2"",123,0)"
^XMB(3.9,146100,2,486,0)=" ...I SSN'=$G(ARRAY(""SSN"")),$G(ARRAY(""SSN""))'="""",$G(ARRAY(""SSN""))'=""@"" D  ;**54 mpic_1556 added array(""ssn"")'=""@"""
^XMB(3.9,146100,2,487,0)="""RTN"",""RGADTP2"",124,0)"
^XMB(3.9,146100,2,488,0)=" ....I $G(ARRAY(""SSN""))=""P"",SSN[""P"" Q  ;**47 need to create a pseudo ssn and did create one"
^XMB(3.9,146100,2,489,0)="""RTN"",""RGADTP2"",125,0)"
^XMB(3.9,146100,2,490,0)=" ....S RGER=$S($G(RGER)'="""":$G(RGER)_REP,1:""-1^"")_""SSN field failure"" ;**45 only check if SSN is sent isn't null"
^XMB(3.9,146100,2,491,0)="""RTN"",""RGADTP2"",126,0)"
^XMB(3.9,146100,2,492,0)=" ...;"
^XMB(3.9,146100,2,493,0)="""RTN"",""RGADTP2"",127,0)"
^XMB(3.9,146100,2,494,0)=" ...;**48 only set ssn verification status and pseudo ssn reason if ssn update successful"
^XMB(3.9,146100,2,495,0)="""RTN"",""RGADTP2"",128,0)"
^XMB(3.9,146100,2,496,0)=" ...I SSN[""P"" D  ;either ssn just became a pseudo or it was already a pseudo and the update to a real ssn failed"
^XMB(3.9,146100,2,497,0)="""RTN"",""RGADTP2"",129,0)"
^XMB(3.9,146100,2,498,0)=" ....N SSNV S SSNV=$$GET1^DIQ(2,+RGRSDFN_"","",.0907,""I"") I SSNV'="""" K ARAY2 S ARAY2(2,.0907)=""@"",DR="".0907;"" D EDIT^VAFCPTED(RGRSDFN,""ARAY2(2)"",DR) ;if pseudo ssn then always delete local ssn verification status"
^XMB(3.9,146100,2,499,0)="""RTN"",""RGADTP2"",130,0)"
^XMB(3.9,146100,2,500,0)=" ....S SSNV=$$GET1^DIQ(2,+RGRSDFN_"","",.0907,""I"") I SSNV'="""" S RGER=$S($G(RGER)'="""":$G(RGER)_REP,1:""-1^"")_""SSN VERIFICATION field failure"" ;if delete doesn't occur log failure"
^XMB(3.9,146100,2,501,0)="""RTN"",""RGADTP2"",131,0)"
^XMB(3.9,146100,2,502,0)=" ....;"
^XMB(3.9,146100,2,503,0)="""RTN"",""RGADTP2"",132,0)"
^XMB(3.9,146100,2,504,0)=" ....I $S(ARRAY(""SSN"")="""":1,ARRAY(""SSN"")=""@"":1,ARRAY(""SSN"")=""P"":1,1:0) D  ;if local pseudo ssn reason different from the incoming then update"
^XMB(3.9,146100,2,505,0)="""RTN"",""RGADTP2"",133,0)"
^XMB(3.9,146100,2,506,0)=" .....N PSNR S PSNR=$$GET1^DIQ(2,+RGRSDFN_"","",.0906,""I"")"
^XMB(3.9,146100,2,507,0)="""RTN"",""RGADTP2"",134,0)"
^XMB(3.9,146100,2,508,0)=" .....I PSNR=""""&(ARRAY(.0906)=""@"") Q"
^XMB(3.9,146100,2,509,0)="""RTN"",""RGADTP2"",135,0)"
^XMB(3.9,146100,2,510,0)=" .....I PSNR=ARRAY(.0906) Q"
^XMB(3.9,146100,2,511,0)="""RTN"",""RGADTP2"",136,0)"
^XMB(3.9,146100,2,512,0)=" .....K ARAY2 S ARAY2(2,.0906)=$G(ARRAY(.0906)),DR="".0906;"" D EDIT^VAFCPTED(RGRSDFN,""ARAY2(2)"",DR)"
^XMB(3.9,146100,2,513,0)="""RTN"",""RGADTP2"",137,0)"
^XMB(3.9,146100,2,514,0)=" .....S PSNR=$$GET1^DIQ(2,+RGRSDFN_"","",.0906,""I"")"
^XMB(3.9,146100,2,515,0)="""RTN"",""RGADTP2"",138,0)"
^XMB(3.9,146100,2,516,0)=" .....I PSNR=""""&(ARAY2(2,.0906)=""@"") Q"
^XMB(3.9,146100,2,517,0)="""RTN"",""RGADTP2"",139,0)"
^XMB(3.9,146100,2,518,0)=" .....I PSNR'=ARAY2(2,.0906) S RGER=$S($G(RGER)'="""":$G(RGER)_REP,1:""-1^"")_""Pseudo SSN Reason field failure"""
^XMB(3.9,146100,2,519,0)="""RTN"",""RGADTP2"",140,0)"
^XMB(3.9,146100,2,520,0)=" ...;"
^XMB(3.9,146100,2,521,0)="""RTN"",""RGADTP2"",141,0)"
^XMB(3.9,146100,2,522,0)=" ...I SSN=$G(ARRAY(""SSN"")) D  ;we've got a real ssn, real ssn update would only fail if a duplicate ssn already at site, then no updating would occur"
^XMB(3.9,146100,2,523,0)="""RTN"",""RGADTP2"",142,0)"
^XMB(3.9,146100,2,524,0)=" ....N PSNR S PSNR=$$GET1^DIQ(2,+RGRSDFN_"","",.0906,""I"") I PSNR'="""" K ARAY2 S ARAY2(2,.0906)=""@"",DR="".0906;"" D EDIT^VAFCPTED(RGRSDFN,""ARAY2(2)"",DR) ;if real ssn delete local pseudo ssn reason"
^XMB(3.9,146100,2,525,0)="""RTN"",""RGADTP2"",143,0)"
^XMB(3.9,146100,2,526,0)=" ....S PSNR=$$GET1^DIQ(2,+RGRSDFN_"","",.0906,""I"") I PSNR'="""" S RGER=$S($G(RGER)'="""":$G(RGER)_REP,1:""-1^"")_""Pseudo SSN Reason field failure"" ;if delete doesn't occur log failure"
^XMB(3.9,146100,2,527,0)="""RTN"",""RGADTP2"",144,0)"
^XMB(3.9,146100,2,528,0)=" ....;"
^XMB(3.9,146100,2,529,0)="""RTN"",""RGADTP2"",145,0)"
^XMB(3.9,146100,2,530,0)=" ....N SSNV S SSNV=$$GET1^DIQ(2,+RGRSDFN_"","",.0907,""I"") ;update ssnv if different from local"
^XMB(3.9,146100,2,531,0)="""RTN"",""RGADTP2"",146,0)"
^XMB(3.9,146100,2,532,0)=" ....I SSNV=""""&(ARRAY(.0907)=""@"") Q"
^XMB(3.9,146100,2,533,0)="""RTN"",""RGADTP2"",147,0)"
^XMB(3.9,146100,2,534,0)=" ....I SSNV=ARRAY(.0907) Q"
^XMB(3.9,146100,2,535,0)="""RTN"",""RGADTP2"",148,0)"
^XMB(3.9,146100,2,536,0)=" ....K ARAY2 S ARAY2(2,.0907)=$G(ARRAY(.0907)),DR="".0907;"" D EDIT^VAFCPTED(RGRSDFN,""ARAY2(2)"",DR)"
^XMB(3.9,146100,2,537,0)="""RTN"",""RGADTP2"",149,0)"
^XMB(3.9,146100,2,538,0)=" ....S SSNV=$$GET1^DIQ(2,+RGRSDFN_"","",.0907,""I"")"
^XMB(3.9,146100,2,539,0)="""RTN"",""RGADTP2"",150,0)"
^XMB(3.9,146100,2,540,0)=" ....I SSNV=""""&(ARAY2(2,.0907)=""@"") Q"
