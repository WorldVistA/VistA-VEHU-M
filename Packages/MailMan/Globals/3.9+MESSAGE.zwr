^XMB(3.9,146035,2,405,0)="""RTN"",""PSOBBC"",83,0)"
^XMB(3.9,146035,2,406,0)=" S DIR(""A"")=""Allow early refills ? """
^XMB(3.9,146035,2,407,0)="""RTN"",""PSOBBC"",84,0)"
