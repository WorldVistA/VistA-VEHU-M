^XMB(3.9,146052,2,1991,0)="""RTN"",""FBCHVP"",60,0)"
^XMB(3.9,146052,2,1992,0)="CONF ;Print void/cancel void confirmation."
^XMB(3.9,146052,2,1993,0)="""RTN"",""FBCHVP"",61,0)"
^XMB(3.9,146052,2,1994,0)=" W !,?10,$S($D(FBVOID):""Cancel Voided"",1:""Void""),"" payment for "",$$NAME^FBCHREQ2(DFN),!,*7,""You must adjust control point accordingly through IFCAP!"""
^XMB(3.9,146052,2,1995,0)="""RTN"",""FBCHVP"",62,0)"
^XMB(3.9,146052,2,1996,0)=" Q"
^XMB(3.9,146052,2,1997,0)="""RTN"",""FBPHON"")"
^XMB(3.9,146052,2,1998,0)="0^10^B19592256"
^XMB(3.9,146052,2,1999,0)="""RTN"",""FBPHON"",1,0)"
^XMB(3.9,146052,2,2000,0)="FBPHON ;AISC/CMR-LIST PAYMENTS ;5/13/1999"
^XMB(3.9,146052,2,2001,0)="""RTN"",""FBPHON"",2,0)"
^XMB(3.9,146052,2,2002,0)=" ;;3.5;FEE BASIS;**4,69**;JAN 30, 1995;Build 0"
^XMB(3.9,146052,2,2003,0)="""RTN"",""FBPHON"",3,0)"
^XMB(3.9,146052,2,2004,0)=" ;;Per VHA Directive 10-93-142, this routine should not be modified."
^XMB(3.9,146052,2,2005,0)="""RTN"",""FBPHON"",4,0)"
^XMB(3.9,146052,2,2006,0)=" S DIR(0)=""P^161.2:EMZ"" D ^DIR K DIR Q:$D(DIRUT)  S FBV=+Y"
^XMB(3.9,146052,2,2007,0)="""RTN"",""FBPHON"",5,0)"
^XMB(3.9,146052,2,2008,0)=" S DIR(0)=""P^161:EMZ"",DIR(""A"")=""Payments for veteran"" D ^DIR K DIR I $D(DIRUT) G FBPHON"
^XMB(3.9,146052,2,2009,0)="""RTN"",""FBPHON"",6,0)"
^XMB(3.9,146052,2,2010,0)=" S DFN=+Y"
^XMB(3.9,146052,2,2011,0)="""RTN"",""FBPHON"",7,0)"
^XMB(3.9,146052,2,2012,0)=" Q"
^XMB(3.9,146052,2,2013,0)="""RTN"",""FBPHON"",8,0)"
^XMB(3.9,146052,2,2014,0)="START S U=""^"""
^XMB(3.9,146052,2,2015,0)="""RTN"",""FBPHON"",9,0)"
^XMB(3.9,146052,2,2016,0)=" K ^TMP($J,""FBPHON""),^TMP(""FBPHON"",$J),^TMP(""FBPHIDX"",$J)"
^XMB(3.9,146052,2,2017,0)="""RTN"",""FBPHON"",10,0)"
^XMB(3.9,146052,2,2018,0)=" I '$G(DFN)!('$G(FBV)) S VALMQUIT="""" Q"
^XMB(3.9,146052,2,2019,0)="""RTN"",""FBPHON"",11,0)"
^XMB(3.9,146052,2,2020,0)=" D GATHER^FBPHON1(DFN,FBV)"
^XMB(3.9,146052,2,2021,0)="""RTN"",""FBPHON"",12,0)"
^XMB(3.9,146052,2,2022,0)=" I '$D(^TMP($J,""FBPHON"")),'$G(FBCP) W !!,*7,""There are no payments to this vendor for this patient."" S DIR(0)=""E"" D ^DIR S VALMQUIT=1 G END ;FBCP set only if changing pt"
^XMB(3.9,146052,2,2023,0)="""RTN"",""FBPHON"",13,0)"
^XMB(3.9,146052,2,2024,0)="OUTPUT ;"
^XMB(3.9,146052,2,2025,0)="""RTN"",""FBPHON"",14,0)"
^XMB(3.9,146052,2,2026,0)=" S (FBLINE,FBENTRY)=0,FBAADT="""" F  S FBAADT=$O(^TMP($J,""FBPHON"",FBAADT)) Q:'FBAADT  S FBI=0 F  S FBI=$O(^TMP($J,""FBPHON"",FBAADT,FBI)) Q:'FBI  S FBX=^(FBI) D"
^XMB(3.9,146052,2,2027,0)="""RTN"",""FBPHON"",15,0)"
^XMB(3.9,146052,2,2028,0)=" .S FBBDT=$P($P(FBX,U,2),""-""),FBEDT=$P($P(FBX,U,2),""-"",2)"
^XMB(3.9,146052,2,2029,0)="""RTN"",""FBPHON"",16,0)"
^XMB(3.9,146052,2,2030,0)=" .S FB1=$P(FBX,U,9) D FBCKI^FBAACCB1(FB1):$P(FBX,U)[""C"",FBCKP^FBAACCB1(+FB1,$P(FB1,"","",2)):$P(FBX,U)=""PHAR"",FBCKO^FBAACCB2(+FB1,$P(FB1,"","",2),$P(FB1,"","",3),$P(FB1,"","",4)):$P(FBX,U)=""OPT"""
^XMB(3.9,146052,2,2031,0)="""RTN"",""FBPHON"",17,0)"
^XMB(3.9,146052,2,2032,0)=" .S FBLINE=FBLINE+1,FBENTRY=FBENTRY+1,FBFL=$P(FBX,U,10),FBFL=FBFL_$S($G(FBCAN)]"""":""+"",1:"""")"
^XMB(3.9,146052,2,2033,0)="""RTN"",""FBPHON"",18,0)"
^XMB(3.9,146052,2,2034,0)=" .S FBTEXT=$S($L(FBENTRY)=1:"" ""_FBENTRY,1:FBENTRY)_FBFL,FBTEXT=$$SETSTR^VALM1($$DATE(FBBDT)_$S($G(FBEDT):"" - ""_$$DATE(FBEDT),1:""""),FBTEXT,6,19)"
^XMB(3.9,146052,2,2035,0)="""RTN"",""FBPHON"",19,0)"
^XMB(3.9,146052,2,2036,0)=" .S FBTEXT=$$SETSTR^VALM1($S($P(FBX,U)=""OPT"":""CPT: "",$P(FBX,U)=""PHAR"":""RX # "",1:""""),FBTEXT,25,5),FBTEXT=$$SETSTR^VALM1($P(FBX,U,3),FBTEXT,30,8)"
^XMB(3.9,146052,2,2037,0)="""RTN"",""FBPHON"",20,0)"
^XMB(3.9,146052,2,2038,0)=" .I $P($P(FBX,U,3),"","",2)]"""" S FBTEXT=$$SETSTR^VALM1(""&"",FBTEXT,38,1)"
^XMB(3.9,146052,2,2039,0)="""RTN"",""FBPHON"",21,0)"
^XMB(3.9,146052,2,2040,0)=" .S FBTEXT=$$SETSTR^VALM1($J($FN($P(FBX,U,4),"","",2),10),FBTEXT,40,10),FBTEXT=$$SETSTR^VALM1($J($FN($P(FBX,U,5),"","",2),10),FBTEXT,51,10),FBTEXT=$$SETSTR^VALM1($P(FBX,U,6),FBTEXT,62,6)"
^XMB(3.9,146052,2,2041,0)="""RTN"",""FBPHON"",22,0)"
^XMB(3.9,146052,2,2042,0)=" .S FBTEXT=$$SETSTR^VALM1($J($P(FBX,U,7),7)_""  ""_$S($G(^FBAA(161.7,+$P(FBX,U,8),0)):$J(+^(0),5),1:""""),FBTEXT,66,15)"
^XMB(3.9,146052,2,2043,0)="""RTN"",""FBPHON"",23,0)"
^XMB(3.9,146052,2,2044,0)=" .S ^TMP(""FBPHON"",$J,FBLINE,0)=FBTEXT K FBTEXT"
^XMB(3.9,146052,2,2045,0)="""RTN"",""FBPHON"",24,0)"
^XMB(3.9,146052,2,2046,0)=" .D IDX S ^TMP(""FBPHIDX"",$J,FBENTRY)=FBX_""^""_$G(FBCK)"
^XMB(3.9,146052,2,2047,0)="""RTN"",""FBPHON"",25,0)"
^XMB(3.9,146052,2,2048,0)=" .S A2=$P(FBX,U,5) D PMNT"
^XMB(3.9,146052,2,2049,0)="""RTN"",""FBPHON"",26,0)"
^XMB(3.9,146052,2,2050,0)=" .K FBBDT,FBEDT,FB1,FBX,A2,^TMP($J,""FBPHON"",FBAADT,FBI)"
^XMB(3.9,146052,2,2051,0)="""RTN"",""FBPHON"",27,0)"
^XMB(3.9,146052,2,2052,0)=" S VALMCNT=FBLINE,VALMBG=1"
^XMB(3.9,146052,2,2053,0)="""RTN"",""FBPHON"",28,0)"
^XMB(3.9,146052,2,2054,0)="END ;"
^XMB(3.9,146052,2,2055,0)="""RTN"",""FBPHON"",29,0)"
^XMB(3.9,146052,2,2056,0)=" K FBAAOUT,FBX,FBBDT,FBEDT,FBI,FBAADT,FBFL,FBLINE,FBENTRY,^TMP($J,""FBPHON"")"
^XMB(3.9,146052,2,2057,0)="""RTN"",""FBPHON"",30,0)"
^XMB(3.9,146052,2,2058,0)=" Q"
^XMB(3.9,146052,2,2059,0)="""RTN"",""FBPHON"",31,0)"
^XMB(3.9,146052,2,2060,0)="HDR S VALMHDR(1)=""VENDOR: ""_$$VNAME^FBNHEXP(FBV),VALMHDR(1)=$$SETSTR^VALM1(""Patient Name: ""_$$NAME^FBCHREQ2(DFN),VALMHDR(1),40,40)"
^XMB(3.9,146052,2,2061,0)="""RTN"",""FBPHON"",32,0)"
^XMB(3.9,146052,2,2062,0)=" S VALMHDR(2)=""    ID: ""_$$VID^FBNHEXP(FBV),VALMHDR(2)=$$SETSTR^VALM1(""SSN: ""_$$SSN^FBAAUTL(DFN),VALMHDR(2),49,31)"
^XMB(3.9,146052,2,2063,0)="""RTN"",""FBPHON"",33,0)"
^XMB(3.9,146052,2,2064,0)=" S VALMHDR(3)=""'*' Reimb. to Patient  '+' Cancel Activity  '#' Voided Payment  '&' Addnl Codes"""
^XMB(3.9,146052,2,2065,0)="""RTN"",""FBPHON"",34,0)"
^XMB(3.9,146052,2,2066,0)=" Q"
^XMB(3.9,146052,2,2067,0)="""RTN"",""FBPHON"",35,0)"
^XMB(3.9,146052,2,2068,0)="DATE(J) ;external date format"
^XMB(3.9,146052,2,2069,0)="""RTN"",""FBPHON"",36,0)"
^XMB(3.9,146052,2,2070,0)=" Q $S('$D(J):"""",1:$E(J,4,5)_""/""_$E(J,6,7)_""/""_$E(J,2,3))"
^XMB(3.9,146052,2,2071,0)="""RTN"",""FBPHON"",37,0)"
^XMB(3.9,146052,2,2072,0)=" ;"
^XMB(3.9,146052,2,2073,0)="""RTN"",""FBPHON"",38,0)"
^XMB(3.9,146052,2,2074,0)="PMNT ;sets ^TMP with payment information if it exists"
^XMB(3.9,146052,2,2075,0)="""RTN"",""FBPHON"",39,0)"
^XMB(3.9,146052,2,2076,0)=" I $G(FBCK)]"""" S FBLINE=FBLINE+1,^TMP(""FBPHON"",$J,FBLINE,0)=""      >>>Check # ""_FBCK I $G(FBCKDT) S ^(0)=^(0)_""  Date Paid:  ""_$$DATX^FBAAUTL(FBCKDT)_$S(FBCKINT>0:""  Interest: ""_$FN(FBCKINT,"","",2),1:"""")_""<<<"" D IDX D"
^XMB(3.9,146052,2,2077,0)="""RTN"",""FBPHON"",40,0)"
^XMB(3.9,146052,2,2078,0)=" .I FBDIS-FBCKINT'=+A2 S FBLINE=FBLINE+1,^TMP(""FBPHON"",$J,FBLINE,0)=""      >>>Amount paid altered to $ ""_$FN((FBDIS-FBCKINT),"","",2)_"" on the Fee Payment Voucher document.<<<"" D IDX"
^XMB(3.9,146052,2,2079,0)="""RTN"",""FBPHON"",41,0)"
^XMB(3.9,146052,2,2080,0)=" I $G(FBCANDT)>0 S FBLINE=FBLINE+1,^TMP(""FBPHON"",$J,FBLINE,0)=""      >>>Check cancelled on: ""_$$DATX^FBAAUTL(FBCANDT)_""   Reason:  ""_$P($G(^FB(162.95,+FBCANR,0)),""^"")_""<<<"" D IDX D"
^XMB(3.9,146052,2,2081,0)="""RTN"",""FBPHON"",42,0)"
^XMB(3.9,146052,2,2082,0)=" .S FBLINE=FBLINE+1,^TMP(""FBPHON"",$J,FBLINE,0)=$$SETSTR^VALM1($S(FBCAN=""R"":""Check WILL be replaced."",FBCAN=""C"":""Check WILL be re-issued."",FBCAN=""X"":""Check WILL NOT be replaced."",1:""""),"""",10,70) D IDX"
^XMB(3.9,146052,2,2083,0)="""RTN"",""FBPHON"",43,0)"
^XMB(3.9,146052,2,2084,0)=" K FBCAN,FBCK,FBCKDT,FBCANDT,FBCANR,FBCKINT,FBDIS,FBCKIN"
^XMB(3.9,146052,2,2085,0)="""RTN"",""FBPHON"",44,0)"
^XMB(3.9,146052,2,2086,0)=" Q"
^XMB(3.9,146052,2,2087,0)="""RTN"",""FBPHON"",45,0)"
^XMB(3.9,146052,2,2088,0)="IDX ;sets IDX node"
^XMB(3.9,146052,2,2089,0)="""RTN"",""FBPHON"",46,0)"
^XMB(3.9,146052,2,2090,0)=" S ^TMP(""FBPHON"",$J,""IDX"",FBLINE,FBENTRY)="""""
^XMB(3.9,146052,2,2091,0)="""RTN"",""FBPHON"",47,0)"
