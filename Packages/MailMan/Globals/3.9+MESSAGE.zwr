^XMB(3.9,146089,2,1177,0)="""RTN"",""PSOORFI6"",78,0)"
^XMB(3.9,146089,2,1178,0)=" S DIR(""?"")=""'^' - Quit (no action taken)"" D ^DIR K DIR Q"
^XMB(3.9,146089,2,1179,0)="""RTN"",""PSOORFI6"",79,0)"
^XMB(3.9,146089,2,1180,0)=" ; INPUT"
^XMB(3.9,146089,2,1181,0)="""RTN"",""PSOORFI6"",80,0)"
^XMB(3.9,146089,2,1182,0)=" ; FS - the first sort type that was done before calling into the secondary sort."
^XMB(3.9,146089,2,1183,0)="""RTN"",""PSOORFI6"",81,0)"
^XMB(3.9,146089,2,1184,0)=" ;    - EX: PA:PATIENT, RT:ROUTE, PR:PRIORITY .."
^XMB(3.9,146089,2,1185,0)="""RTN"",""PSOORFI6"",82,0)"
^XMB(3.9,146089,2,1186,0)=" ; FSVAL - the value associated with the first sort."
^XMB(3.9,146089,2,1187,0)="""RTN"",""PSOORFI6"",83,0)"
^XMB(3.9,146089,2,1188,0)="DIR(FSORT,FSVAL) ;"
^XMB(3.9,146089,2,1189,0)="""RTN"",""PSOORFI6"",84,0)"
^XMB(3.9,146089,2,1190,0)=" N DIR,Y,RLINE,STAG,SVAL,RES,FILSTR,DONE,FILTER,FIRST,JCNT,J"
^XMB(3.9,146089,2,1191,0)="""RTN"",""PSOORFI6"",85,0)"
^XMB(3.9,146089,2,1192,0)=" K DIR"
^XMB(3.9,146089,2,1193,0)="""RTN"",""PSOORFI6"",86,0)"
^XMB(3.9,146089,2,1194,0)=" S DIR(0)=""Y"",DIR(""B"")=""N"""
^XMB(3.9,146089,2,1195,0)="""RTN"",""PSOORFI6"",87,0)"
^XMB(3.9,146089,2,1196,0)=" S DIR(""A"")=""Would you like to select a secondary filter"""
^XMB(3.9,146089,2,1197,0)="""RTN"",""PSOORFI6"",88,0)"
^XMB(3.9,146089,2,1198,0)=" D ^DIR K DIR I 'Y K Y Q 0"
^XMB(3.9,146089,2,1199,0)="""RTN"",""PSOORFI6"",89,0)"
^XMB(3.9,146089,2,1200,0)=" I $G(FSORT)']"""" S FILSTR=""PA:PATIENT;RT:ROUTE;PR:PRIORITY;CL:CLINIC;FL:FLAGGED;CS:CONTROLLED SUBSTANCES;SU:SUPPLY;C:CONTINUE W/PRIMARY;E:EXIT"""
^XMB(3.9,146089,2,1201,0)="""RTN"",""PSOORFI6"",90,0)"
^XMB(3.9,146089,2,1202,0)=" I '$L($G(FILSTR)) D"
^XMB(3.9,146089,2,1203,0)="""RTN"",""PSOORFI6"",91,0)"
^XMB(3.9,146089,2,1204,0)=" .S (DONE,JCNT)=0"
^XMB(3.9,146089,2,1205,0)="""RTN"",""PSOORFI6"",92,0)"
^XMB(3.9,146089,2,1206,0)=" .F J=1:1 D  Q:DONE"
^XMB(3.9,146089,2,1207,0)="""RTN"",""PSOORFI6"",93,0)"
^XMB(3.9,146089,2,1208,0)=" ..S FILTER=$T(SCRIT+J) I FILTER="" Q"" S DONE=1 Q"
^XMB(3.9,146089,2,1209,0)="""RTN"",""PSOORFI6"",94,0)"
^XMB(3.9,146089,2,1210,0)=" ..S FILTER=$P(FILTER,"";;"",2)"
^XMB(3.9,146089,2,1211,0)="""RTN"",""PSOORFI6"",95,0)"
^XMB(3.9,146089,2,1212,0)=" ..I $D(FSORT),FILTER=FSORT Q"
^XMB(3.9,146089,2,1213,0)="""RTN"",""PSOORFI6"",96,0)"
^XMB(3.9,146089,2,1214,0)=" ..I $D(FSORT),FSORT=""SU:SUPPLY"",FILTER=""CS:CONTROLLED SUBSTANCES"" Q"
^XMB(3.9,146089,2,1215,0)="""RTN"",""PSOORFI6"",97,0)"
^XMB(3.9,146089,2,1216,0)=" ..I $D(FSORT),FSORT=""CS:CONTROLLED SUBSTANCES"",FILTER=""SU:SUPPLY"" Q"
^XMB(3.9,146089,2,1217,0)="""RTN"",""PSOORFI6"",98,0)"
^XMB(3.9,146089,2,1218,0)=" ..; set up default for DIR(""B""), in our case we will use the first item in the list that is not equal"
^XMB(3.9,146089,2,1219,0)="""RTN"",""PSOORFI6"",99,0)"
^XMB(3.9,146089,2,1220,0)=" ..; to the first sort that occured"
^XMB(3.9,146089,2,1221,0)="""RTN"",""PSOORFI6"",100,0)"
^XMB(3.9,146089,2,1222,0)=" ..S JCNT=JCNT+1 I JCNT=1 S FIRST=FILTER"
^XMB(3.9,146089,2,1223,0)="""RTN"",""PSOORFI6"",101,0)"
^XMB(3.9,146089,2,1224,0)=" ..I '$L($G(FILSTR)) S FILSTR=FILTER Q"
^XMB(3.9,146089,2,1225,0)="""RTN"",""PSOORFI6"",102,0)"
^XMB(3.9,146089,2,1226,0)=" ..S FILSTR=$G(FILSTR)_"";""_FILTER"
^XMB(3.9,146089,2,1227,0)="""RTN"",""PSOORFI6"",103,0)"
^XMB(3.9,146089,2,1228,0)=" I $G(FIRST)']"""" S FIRST=""PA:PATIENT"""
^XMB(3.9,146089,2,1229,0)="""RTN"",""PSOORFI6"",104,0)"
^XMB(3.9,146089,2,1230,0)=" S DIR(""?"")=""^D ST^PSOORFI1(""_""""""""_$P(FSORT,"":"")_""""""""_"")"",DIR(""A"")=""Select another filter"",DIR(""B"")=$P($G(FIRST),"":"",2)"
^XMB(3.9,146089,2,1231,0)="""RTN"",""PSOORFI6"",105,0)"
^XMB(3.9,146089,2,1232,0)=" S DIR(0)=""SMB""_U_FILSTR"
^XMB(3.9,146089,2,1233,0)="""RTN"",""PSOORFI6"",106,0)"
^XMB(3.9,146089,2,1234,0)=" D ^DIR K DIR"
^XMB(3.9,146089,2,1235,0)="""RTN"",""PSOORFI6"",107,0)"
^XMB(3.9,146089,2,1236,0)=" I $D(DIRUT)!(Y=""E"") Q U"
^XMB(3.9,146089,2,1237,0)="""RTN"",""PSOORFI6"",108,0)"
^XMB(3.9,146089,2,1238,0)=" I Y=""C"" Q 0"
^XMB(3.9,146089,2,1239,0)="""RTN"",""PSOORFI6"",109,0)"
^XMB(3.9,146089,2,1240,0)=" S RES=Y"
^XMB(3.9,146089,2,1241,0)="""RTN"",""PSOORFI6"",110,0)"
^XMB(3.9,146089,2,1242,0)=" S RLINE=$S(RES=""PA"":""PAT"",RES=""RT"":""RTE"",RES=""PR"":""PRI"",RES=""CL"":""CLIN"",RES=""FL"":""FLG"",RES=""CS"":""CS"",RES=""SU"":""SUPPLY"",1:"""")"
^XMB(3.9,146089,2,1243,0)="""RTN"",""PSOORFI6"",111,0)"
^XMB(3.9,146089,2,1244,0)=" I RLINE']"""" Q 0"
^XMB(3.9,146089,2,1245,0)="""RTN"",""PSOORFI6"",112,0)"
^XMB(3.9,146089,2,1246,0)=" S STAG=RLINE"
^XMB(3.9,146089,2,1247,0)="""RTN"",""PSOORFI6"",113,0)"
^XMB(3.9,146089,2,1248,0)=" S SVAL=$$@STAG"
^XMB(3.9,146089,2,1249,0)="""RTN"",""PSOORFI6"",114,0)"
^XMB(3.9,146089,2,1250,0)=" I SVAL=U Q U"
^XMB(3.9,146089,2,1251,0)="""RTN"",""PSOORFI6"",115,0)"
^XMB(3.9,146089,2,1252,0)=" I SVAL=""""!(SVAL=0) Q 0"
^XMB(3.9,146089,2,1253,0)="""RTN"",""PSOORFI6"",116,0)"
^XMB(3.9,146089,2,1254,0)=" ; consider a message indicating that the secondary sort may cause delays/hang time before display"
^XMB(3.9,146089,2,1255,0)="""RTN"",""PSOORFI6"",117,0)"
^XMB(3.9,146089,2,1256,0)=" Q RES_U_SVAL"
^XMB(3.9,146089,2,1257,0)="""RTN"",""PSOORFI6"",118,0)"
^XMB(3.9,146089,2,1258,0)="PAT() ;"
^XMB(3.9,146089,2,1259,0)="""RTN"",""PSOORFI6"",119,0)"
^XMB(3.9,146089,2,1260,0)=" N DIR,Y,PSOSORT,DIC,SEL"
^XMB(3.9,146089,2,1261,0)="""RTN"",""PSOORFI6"",120,0)"
^XMB(3.9,146089,2,1262,0)=" S PSOSORT=""PATIENT"""
^XMB(3.9,146089,2,1263,0)="""RTN"",""PSOORFI6"",121,0)"
^XMB(3.9,146089,2,1264,0)=" S DIR(""?"")=""^D PT^PSOORFI1"",DIR(""A"")=""All Patients or Single Patient"",DIR(0)=""SBM^A:ALL;S:SINGLE;E:EXIT"",DIR(""B"")=""SINGLE"""
^XMB(3.9,146089,2,1265,0)="""RTN"",""PSOORFI6"",122,0)"
^XMB(3.9,146089,2,1266,0)=" D ^DIR K DIR"
^XMB(3.9,146089,2,1267,0)="""RTN"",""PSOORFI6"",123,0)"
^XMB(3.9,146089,2,1268,0)=" S SEL=Y"
^XMB(3.9,146089,2,1269,0)="""RTN"",""PSOORFI6"",124,0)"
^XMB(3.9,146089,2,1270,0)=" I $D(DIRUT)!(SEL=""E"") Q U"
^XMB(3.9,146089,2,1271,0)="""RTN"",""PSOORFI6"",125,0)"
^XMB(3.9,146089,2,1272,0)="PRMT I SEL=""S"" D  Q PSOSORT"
^XMB(3.9,146089,2,1273,0)="""RTN"",""PSOORFI6"",126,0)"
^XMB(3.9,146089,2,1274,0)=" .S PSOSORT=PSOSORT_U_""SINGLE"""
^XMB(3.9,146089,2,1275,0)="""RTN"",""PSOORFI6"",127,0)"
^XMB(3.9,146089,2,1276,0)=" .S DIR(0)=""FO^2:30"",DIR(""A"")=""Select Patient"",DIR(""?"")=""^D HELP^PSOORFI2"" D ^DIR I $E(X)=""?"" S PSOSORT=0 Q"
^XMB(3.9,146089,2,1277,0)="""RTN"",""PSOORFI6"",128,0)"
^XMB(3.9,146089,2,1278,0)=" .I $D(DIRUT) S PSOSORT=0 Q"
^XMB(3.9,146089,2,1279,0)="""RTN"",""PSOORFI6"",129,0)"
^XMB(3.9,146089,2,1280,0)=" .S DIC(0)=""EQM"",DIC=2,DIC(""S"")=""I $D(^PS(52.41,""""AOR"""",+Y,PSOPINST))"""
^XMB(3.9,146089,2,1281,0)="""RTN"",""PSOORFI6"",130,0)"
^XMB(3.9,146089,2,1282,0)=" .D ^DIC K DIC"
^XMB(3.9,146089,2,1283,0)="""RTN"",""PSOORFI6"",131,0)"
^XMB(3.9,146089,2,1284,0)=" .I ""^""[X S PSOSORT=0 Q"
^XMB(3.9,146089,2,1285,0)="""RTN"",""PSOORFI6"",132,0)"
^XMB(3.9,146089,2,1286,0)=" .S (PSODFN,PAT)=+Y,PSOFINY=Y"
^XMB(3.9,146089,2,1287,0)="""RTN"",""PSOORFI6"",133,0)"
^XMB(3.9,146089,2,1288,0)=" .I $P(Y,U)<1 G PRMT"
^XMB(3.9,146089,2,1289,0)="""RTN"",""PSOORFI6"",134,0)"
^XMB(3.9,146089,2,1290,0)=" .I $P(Y,U) S PSOSORT=PSOSORT_U_$P(Y,U),(PSODFN,PAT)=+Y,PSOFINY=Y"
^XMB(3.9,146089,2,1291,0)="""RTN"",""PSOORFI6"",135,0)"
^XMB(3.9,146089,2,1292,0)=" I SEL=""A"" S PSOSORT=PSOSORT_U_""ALL"""
^XMB(3.9,146089,2,1293,0)="""RTN"",""PSOORFI6"",136,0)"
^XMB(3.9,146089,2,1294,0)=" Q PSOSORT"
^XMB(3.9,146089,2,1295,0)="""RTN"",""PSOORFI6"",137,0)"
^XMB(3.9,146089,2,1296,0)="RTE() ;"
^XMB(3.9,146089,2,1297,0)="""RTN"",""PSOORFI6"",138,0)"
^XMB(3.9,146089,2,1298,0)=" N DIR,Y,PSOSORT,RESULTS,PSOPARKX"
^XMB(3.9,146089,2,1299,0)="""RTN"",""PSOORFI6"",139,0)"
^XMB(3.9,146089,2,1300,0)=" K DIR S PSOSORT=""ROUTE"""
^XMB(3.9,146089,2,1301,0)="""RTN"",""PSOORFI6"",140,0)"
^XMB(3.9,146089,2,1302,0)=" S DIR(""?"")=""^D RT^PSOORFI1"",DIR(""A"")=""Route"",DIR(0)=""SBM^W:WINDOW;M:MAIL;C:CLINIC;E:EXIT"",DIR(""B"")=""WINDOW"""
^XMB(3.9,146089,2,1303,0)="""RTN"",""PSOORFI6"",141,0)"
^XMB(3.9,146089,2,1304,0)=" S RESULTS=""PSOPARKX"" D GETPARK^PSORPC01()"
^XMB(3.9,146089,2,1305,0)="""RTN"",""PSOORFI6"",142,0)"
^XMB(3.9,146089,2,1306,0)=" I $G(PSOPARKX(0))=""YES"" S DIR(0)=""SBM^W:WINDOW;M:MAIL;P:PARK;C:CLINIC;E:EXIT"""
^XMB(3.9,146089,2,1307,0)="""RTN"",""PSOORFI6"",143,0)"
^XMB(3.9,146089,2,1308,0)=" D ^DIR K DIR"
^XMB(3.9,146089,2,1309,0)="""RTN"",""PSOORFI6"",144,0)"
^XMB(3.9,146089,2,1310,0)=" I $D(DIRUT)!(Y=""E"") Q U"
^XMB(3.9,146089,2,1311,0)="""RTN"",""PSOORFI6"",145,0)"
^XMB(3.9,146089,2,1312,0)=" S PSOSORT=PSOSORT_""^""_Y"
^XMB(3.9,146089,2,1313,0)="""RTN"",""PSOORFI6"",146,0)"
^XMB(3.9,146089,2,1314,0)=" Q PSOSORT"
^XMB(3.9,146089,2,1315,0)="""RTN"",""PSOORFI6"",147,0)"
^XMB(3.9,146089,2,1316,0)="PRI() ;"
^XMB(3.9,146089,2,1317,0)="""RTN"",""PSOORFI6"",148,0)"
^XMB(3.9,146089,2,1318,0)=" N DIR,Y,PSOSORT"
^XMB(3.9,146089,2,1319,0)="""RTN"",""PSOORFI6"",149,0)"
^XMB(3.9,146089,2,1320,0)=" K DIR S PSOSORT=""PRIORITY"""
^XMB(3.9,146089,2,1321,0)="""RTN"",""PSOORFI6"",150,0)"
^XMB(3.9,146089,2,1322,0)=" S DIR(""A"")=""Select Priority"",DIR(0)=""SBM^S:STAT;E:EMERGENCY;R:ROUTINE"",DIR(""B"")=""ROUTINE"""
^XMB(3.9,146089,2,1323,0)="""RTN"",""PSOORFI6"",151,0)"
^XMB(3.9,146089,2,1324,0)=" D ^DIR K DIR"
^XMB(3.9,146089,2,1325,0)="""RTN"",""PSOORFI6"",152,0)"
^XMB(3.9,146089,2,1326,0)=" I $D(DIRUT) Q U"
^XMB(3.9,146089,2,1327,0)="""RTN"",""PSOORFI6"",153,0)"
^XMB(3.9,146089,2,1328,0)=" S PSOSORT=PSOSORT_""^""_Y"
^XMB(3.9,146089,2,1329,0)="""RTN"",""PSOORFI6"",154,0)"
^XMB(3.9,146089,2,1330,0)=" Q PSOSORT"
^XMB(3.9,146089,2,1331,0)="""RTN"",""PSOORFI6"",155,0)"
^XMB(3.9,146089,2,1332,0)="CLIN() ;"
^XMB(3.9,146089,2,1333,0)="""RTN"",""PSOORFI6"",156,0)"
^XMB(3.9,146089,2,1334,0)=" K ^TMP($J,""PSOCL""),^TMP($J,""PSOCLX""),PSOCLIN,PSOCLINF,PSOXINST"
^XMB(3.9,146089,2,1335,0)="""RTN"",""PSOORFI6"",157,0)"
^XMB(3.9,146089,2,1336,0)=" N PSOCFLAG,PSONPTRX,PSOINPTR,PSCLP,PSOCLINS,PSOSTC,PSOLGD,PSODIEN,PSOCTMP"
^XMB(3.9,146089,2,1337,0)="""RTN"",""PSOORFI6"",158,0)"
^XMB(3.9,146089,2,1338,0)=" K DIR S DIR(0)=""SMB^C:CLINIC;S:SORT GROUP;E:EXIT"",DIR(""A"")=""Select By"",DIR(""B"")=""Clinic"",DIR(""?"",1)=""Enter 'C' to process orders for one individual Clinic,"""
^XMB(3.9,146089,2,1339,0)="""RTN"",""PSOORFI6"",159,0)"
^XMB(3.9,146089,2,1340,0)=" S DIR(""?"",2)=""      'S' to process orders for all Clinics associated with a Sort Group,"",DIR(""?"",3)=""      '^' or 'E' to exit"" S DIR(""?"")="" """
^XMB(3.9,146089,2,1341,0)="""RTN"",""PSOORFI6"",160,0)"
^XMB(3.9,146089,2,1342,0)=" W ! D ^DIR K DIR I $D(DTOUT)!($D(DUOUT))!(Y=""E"") W ! Q U"
^XMB(3.9,146089,2,1343,0)="""RTN"",""PSOORFI6"",161,0)"
^XMB(3.9,146089,2,1344,0)=" I Y=""S"" D SORT I $O(^TMP($J,""PSOCL"",0)) Q 1"
^XMB(3.9,146089,2,1345,0)="""RTN"",""PSOORFI6"",162,0)"
^XMB(3.9,146089,2,1346,0)="CLIN2 W ! K DIC S DIC=""^SC("",DIC(0)=""QEAMZ"",DIC(""A"")=""Select CLINIC: "" D ^DIC K DIC I Y<1!($D(DTOUT))!($D(DUOUT)) Q 0"
^XMB(3.9,146089,2,1347,0)="""RTN"",""PSOORFI6"",163,0)"
^XMB(3.9,146089,2,1348,0)=" S PSOCLIN=+Y,PSOCLINF=1 D CHECK^PSOORFI3 I $G(PSOCFLAG) D INSTNM^PSOORFI2 W !!,""You are signed in under the ""_$G(PSODINST)_"" CPRS Ordering"",!,""Institution, which does not match the Institution for this Clinic!"",! K PSODINST G CLIN2"
^XMB(3.9,146089,2,1349,0)="""RTN"",""PSOORFI6"",164,0)"
^XMB(3.9,146089,2,1350,0)=" S ^TMP($J,""PSOCL"",PSOCLIN)=PSOCLIN K PSOCLIN Q 1"
^XMB(3.9,146089,2,1351,0)="""RTN"",""PSOORFI6"",165,0)"
^XMB(3.9,146089,2,1352,0)="SORT W ! K DIC S DIC=""^PS(59.8,"",DIC(0)=""QEAMZ"",DIC(""A"")=""Select CLINIC SORT GROUP: "" D ^DIC K DIC I Y<1!($D(DTOUT))!($D(DUOUT)) Q 0"
^XMB(3.9,146089,2,1353,0)="""RTN"",""PSOORFI6"",166,0)"
^XMB(3.9,146089,2,1354,0)=" S PSOCLINS=+Y"
^XMB(3.9,146089,2,1355,0)="""RTN"",""PSOORFI6"",167,0)"
^XMB(3.9,146089,2,1356,0)=" K ^TMP($J,""PSOCL""),^TMP($J,""PSOCLX"") F PSCLP=0:0 S PSCLP=$O(^PS(59.8,PSOCLINS,1,PSCLP)) Q:'PSCLP  S PSOSTC=+$P($G(^PS(59.8,PSOCLINS,1,PSCLP,0)),""^"") S:$G(PSOSTC)&($D(^SC(PSOSTC,0))) ^TMP($J,""PSOCL"",PSOSTC)=PSOSTC"
^XMB(3.9,146089,2,1357,0)="""RTN"",""PSOORFI6"",168,0)"
^XMB(3.9,146089,2,1358,0)=" I '$O(^TMP($J,""PSOCL"",0)) W !!,""There are no Clinics associated with this Sort Group!"",! K ^TMP($J,""PSOCL"") G SORT"
^XMB(3.9,146089,2,1359,0)="""RTN"",""PSOORFI6"",169,0)"
^XMB(3.9,146089,2,1360,0)=" F PSCLP=0:0 S PSCLP=$O(^TMP($J,""PSOCL"",PSCLP)) Q:'PSCLP  S PSOCLIN=PSCLP D CHECK^PSOORFI3 I $G(PSOCFLAG) S ^TMP($J,""PSOCLX"",PSCLP)=PSCLP K ^TMP($J,""PSOCL"",PSCLP)"
^XMB(3.9,146089,2,1361,0)="""RTN"",""PSOORFI6"",170,0)"
^XMB(3.9,146089,2,1362,0)=" I $O(^TMP($J,""PSOCLX"",0)) H 1 W @IOF W !,""Orders for these Clinics in the Sort Group will not be displayed for Finishing"",!,""because the CPRS Ordering Institution does not match the Institution that is"",!,""associated with the Clinic:"",! D"
^XMB(3.9,146089,2,1363,0)="""RTN"",""PSOORFI6"",171,0)"
^XMB(3.9,146089,2,1364,0)=" .F PSCLP=0:0 S PSCLP=$O(^TMP($J,""PSOCLX"",PSCLP)) Q:'PSCLP  D:($Y+4)>IOSL  W !,$P($G(^SC(PSCLP,0)),""^"")"
^XMB(3.9,146089,2,1365,0)="""RTN"",""PSOORFI6"",172,0)"
^XMB(3.9,146089,2,1366,0)=" ..W ! K DIR S DIR(0)=""E"",DIR(""A"")=""Press RETURN to continue"" D ^DIR K DIR W @IOF"
^XMB(3.9,146089,2,1367,0)="""RTN"",""PSOORFI6"",173,0)"
^XMB(3.9,146089,2,1368,0)=" I $O(^TMP($J,""PSOCLX"",0)) D EOP^PSOORFI3 Q 1"
^XMB(3.9,146089,2,1369,0)="""RTN"",""PSOORFI6"",174,0)"
^XMB(3.9,146089,2,1370,0)=" K ^TMP($J,""PSOCLX"") I '$O(^TMP($J,""PSOCL"",0)) W !!,""There are no Clinics that have a matching Institution!"",! D EOP^PSOORFI3 G SORT"
^XMB(3.9,146089,2,1371,0)="""RTN"",""PSOORFI6"",175,0)"
^XMB(3.9,146089,2,1372,0)=" Q"
^XMB(3.9,146089,2,1373,0)="""RTN"",""PSOORFI6"",176,0)"
^XMB(3.9,146089,2,1374,0)="FLG() ;"
^XMB(3.9,146089,2,1375,0)="""RTN"",""PSOORFI6"",177,0)"
^XMB(3.9,146089,2,1376,0)=" Q ""FLAGGED^FLAGGED"""
^XMB(3.9,146089,2,1377,0)="""RTN"",""PSOORFI6"",178,0)"
^XMB(3.9,146089,2,1378,0)="CS() ;"
^XMB(3.9,146089,2,1379,0)="""RTN"",""PSOORFI6"",179,0)"
^XMB(3.9,146089,2,1380,0)=" N DIR,PSOCSRT,PSOPARKX,PSOSORT,RESULTS,Y"
^XMB(3.9,146089,2,1381,0)="""RTN"",""PSOORFI6"",180,0)"
^XMB(3.9,146089,2,1382,0)=" K DIR S DIR(""A"")=""Route"",DIR(0)=""SBM^W:WINDOW;M:MAIL;B:BOTH;E:EXIT"",DIR(""B"")=""BOTH"""
^XMB(3.9,146089,2,1383,0)="""RTN"",""PSOORFI6"",181,0)"
^XMB(3.9,146089,2,1384,0)=" S RESULTS=""PSOPARKX"" D GETPARK^PSORPC01()"
^XMB(3.9,146089,2,1385,0)="""RTN"",""PSOORFI6"",182,0)"
^XMB(3.9,146089,2,1386,0)=" I $G(PSOPARKX(0))=""YES"" S DIR(0)=""SBM^W:WINDOW;M:MAIL;P:PARK;A:ALL;E:EXIT"",DIR(""B"")=""ALL"""
^XMB(3.9,146089,2,1387,0)="""RTN"",""PSOORFI6"",183,0)"
^XMB(3.9,146089,2,1388,0)=" D ^DIR"
^XMB(3.9,146089,2,1389,0)="""RTN"",""PSOORFI6"",184,0)"
^XMB(3.9,146089,2,1390,0)=" Q:$D(DIRUT)!(Y=""E"") U"
^XMB(3.9,146089,2,1391,0)="""RTN"",""PSOORFI6"",185,0)"
^XMB(3.9,146089,2,1392,0)=" S PSOCSRT=$S(Y=""A"":1,Y=""B"":1,1:Y)"
^XMB(3.9,146089,2,1393,0)="""RTN"",""PSOORFI6"",186,0)"
^XMB(3.9,146089,2,1394,0)=" W !!,""Select a schedule(s)"""
^XMB(3.9,146089,2,1395,0)="""RTN"",""PSOORFI6"",187,0)"
^XMB(3.9,146089,2,1396,0)=" K DIR S PSOSORT=""DIGITALLY SIGNED"""
^XMB(3.9,146089,2,1397,0)="""RTN"",""PSOORFI6"",188,0)"
^XMB(3.9,146089,2,1398,0)=" S DIR(""A"")=""Select Schedule(s)"",DIR(0)=""S^1:SCHEDULE II;2:SCHEDULES III - V;3:SCHEDULES II - V;4:NON-CS+SCHEDULES III - V;5:NON-CS ONLY;E:EXIT"",DIR(""B"")=3"
^XMB(3.9,146089,2,1399,0)="""RTN"",""PSOORFI6"",189,0)"
^XMB(3.9,146089,2,1400,0)=" D ^DIR K DIR"
^XMB(3.9,146089,2,1401,0)="""RTN"",""PSOORFI6"",190,0)"
^XMB(3.9,146089,2,1402,0)=" I $D(DIRUT)!(Y=""E"") Q U"
^XMB(3.9,146089,2,1403,0)="""RTN"",""PSOORFI6"",191,0)"
^XMB(3.9,146089,2,1404,0)=" S PSOSORT=PSOSORT_""^""_Y_U_PSOCSRT"
^XMB(3.9,146089,2,1405,0)="""RTN"",""PSOORFI6"",192,0)"
^XMB(3.9,146089,2,1406,0)=" Q PSOSORT"
^XMB(3.9,146089,2,1407,0)="""RTN"",""PSOORFI6"",193,0)"
^XMB(3.9,146089,2,1408,0)="SUPPLY() ;"
^XMB(3.9,146089,2,1409,0)="""RTN"",""PSOORFI6"",194,0)"
^XMB(3.9,146089,2,1410,0)=" Q ""SUPPLY^SUPPLY"""
^XMB(3.9,146089,2,1411,0)="""RTN"",""PSOORFI6"",195,0)"
^XMB(3.9,146089,2,1412,0)=" ; INPUT"
^XMB(3.9,146089,2,1413,0)="""RTN"",""PSOORFI6"",196,0)"
^XMB(3.9,146089,2,1414,0)=" ;  IEN - IEN of the entry in 52.41 (PENDING OUTPATIENT ORDERS)"
^XMB(3.9,146089,2,1415,0)="""RTN"",""PSOORFI6"",197,0)"
^XMB(3.9,146089,2,1416,0)=" ;  FLTR - filter criteria as returned from $$DIR"
^XMB(3.9,146089,2,1417,0)="""RTN"",""PSOORFI6"",198,0)"
^XMB(3.9,146089,2,1418,0)="CHKFLTR(IEN,FLTR,CNT) ; CHECK THE SECONDARY FILTER FOR PENDING ORDERS"
^XMB(3.9,146089,2,1419,0)="""RTN"",""PSOORFI6"",199,0)"
^XMB(3.9,146089,2,1420,0)=" N FLTRTYP,FLTRVAL,RES,DRG,CLIN,OR0"
^XMB(3.9,146089,2,1421,0)="""RTN"",""PSOORFI6"",200,0)"
^XMB(3.9,146089,2,1422,0)=" ; everytime we have a result of 0 increment the counter"
^XMB(3.9,146089,2,1423,0)="""RTN"",""PSOORFI6"",201,0)"
^XMB(3.9,146089,2,1424,0)=" ; everytime we have a result of 1, reset the counter"
^XMB(3.9,146089,2,1425,0)="""RTN"",""PSOORFI6"",202,0)"
^XMB(3.9,146089,2,1426,0)=" ; when counter reaches 100, display a '.' on the screen and reset the counter"
^XMB(3.9,146089,2,1427,0)="""RTN"",""PSOORFI6"",203,0)"
^XMB(3.9,146089,2,1428,0)=" ;S GL=$NA(^TMP($J,""ROUTINE"",""CNT""))"
^XMB(3.9,146089,2,1429,0)="""RTN"",""PSOORFI6"",204,0)"
^XMB(3.9,146089,2,1430,0)=" I '$G(IEN) Q 0"
^XMB(3.9,146089,2,1431,0)="""RTN"",""PSOORFI6"",205,0)"
^XMB(3.9,146089,2,1432,0)=" S FLTRTYP=$P(FLTR,U) I FLTRTYP="""" Q 1"
^XMB(3.9,146089,2,1433,0)="""RTN"",""PSOORFI6"",206,0)"
^XMB(3.9,146089,2,1434,0)=" S FLTRVAL=$P(FLTR,U,3)"
^XMB(3.9,146089,2,1435,0)="""RTN"",""PSOORFI6"",207,0)"
^XMB(3.9,146089,2,1436,0)=" ; always return 1 for all patients"
^XMB(3.9,146089,2,1437,0)="""RTN"",""PSOORFI6"",208,0)"
^XMB(3.9,146089,2,1438,0)=" I FLTRTYP=""PA"",FLTRVAL=""ALL"" Q 1"
^XMB(3.9,146089,2,1439,0)="""RTN"",""PSOORFI6"",209,0)"
^XMB(3.9,146089,2,1440,0)=" ; route filter"
^XMB(3.9,146089,2,1441,0)="""RTN"",""PSOORFI6"",210,0)"
^XMB(3.9,146089,2,1442,0)=" I FLTRTYP=""RT"" D  Q RES"
^XMB(3.9,146089,2,1443,0)="""RTN"",""PSOORFI6"",211,0)"
^XMB(3.9,146089,2,1444,0)=" .I $$GET1^DIQ(52.41,IEN,19,""I"")'=FLTRVAL S RES=0 Q"
^XMB(3.9,146089,2,1445,0)="""RTN"",""PSOORFI6"",212,0)"
^XMB(3.9,146089,2,1446,0)=" .S RES=1"
^XMB(3.9,146089,2,1447,0)="""RTN"",""PSOORFI6"",213,0)"
^XMB(3.9,146089,2,1448,0)=" ; single patient"
^XMB(3.9,146089,2,1449,0)="""RTN"",""PSOORFI6"",214,0)"
^XMB(3.9,146089,2,1450,0)=" I FLTRTYP=""PA"" D  Q RES"
^XMB(3.9,146089,2,1451,0)="""RTN"",""PSOORFI6"",215,0)"
^XMB(3.9,146089,2,1452,0)=" .; for a single patient selection, the IEN is piece 4. also, if there is no filter value, how could we filter? just return 1?"
^XMB(3.9,146089,2,1453,0)="""RTN"",""PSOORFI6"",216,0)"
^XMB(3.9,146089,2,1454,0)=" .S FLTRVAL=$P(FLTR,U,4) I 'FLTRVAL S RES=1 Q"
^XMB(3.9,146089,2,1455,0)="""RTN"",""PSOORFI6"",217,0)"
^XMB(3.9,146089,2,1456,0)=" .I $$GET1^DIQ(52.41,IEN,1,""I"")'=FLTRVAL S RES=0 Q"
^XMB(3.9,146089,2,1457,0)="""RTN"",""PSOORFI6"",218,0)"
^XMB(3.9,146089,2,1458,0)=" .S RES=1"
^XMB(3.9,146089,2,1459,0)="""RTN"",""PSOORFI6"",219,0)"
^XMB(3.9,146089,2,1460,0)=" ; clinic filter"
^XMB(3.9,146089,2,1461,0)="""RTN"",""PSOORFI6"",220,0)"
^XMB(3.9,146089,2,1462,0)=" I FLTRTYP=""CL"" D  Q RES"
^XMB(3.9,146089,2,1463,0)="""RTN"",""PSOORFI6"",221,0)"
^XMB(3.9,146089,2,1464,0)=" .I $P(FLTR,U,2)'=1 S RES=1 Q"
^XMB(3.9,146089,2,1465,0)="""RTN"",""PSOORFI6"",222,0)"
^XMB(3.9,146089,2,1466,0)=" .I '$O(^TMP($J,""PSOCL"",0)) S RES=1 Q"
^XMB(3.9,146089,2,1467,0)="""RTN"",""PSOORFI6"",223,0)"
^XMB(3.9,146089,2,1468,0)=" .S CLIN=$$GET1^DIQ(52.41,IEN,1.1,""I"") I 'CLIN S RES=0 Q"
^XMB(3.9,146089,2,1469,0)="""RTN"",""PSOORFI6"",224,0)"
^XMB(3.9,146089,2,1470,0)=" .I '$D(^TMP($J,""PSOCL"",CLIN)) S RES=0 Q"
^XMB(3.9,146089,2,1471,0)="""RTN"",""PSOORFI6"",225,0)"
^XMB(3.9,146089,2,1472,0)=" .S RES=1"
^XMB(3.9,146089,2,1473,0)="""RTN"",""PSOORFI6"",226,0)"
^XMB(3.9,146089,2,1474,0)=" ; supply items filter"
^XMB(3.9,146089,2,1475,0)="""RTN"",""PSOORFI6"",227,0)"
^XMB(3.9,146089,2,1476,0)=" I FLTRTYP=""FL"" D  Q RES"
^XMB(3.9,146089,2,1477,0)="""RTN"",""PSOORFI6"",228,0)"
^XMB(3.9,146089,2,1478,0)=" .I '$D(^PS(52.41,IEN,0))!('$P($G(^PS(52.41,IEN,0)),""^"",23)) S RES=0 Q"
^XMB(3.9,146089,2,1479,0)="""RTN"",""PSOORFI6"",229,0)"
^XMB(3.9,146089,2,1480,0)=" .S RES=1"
^XMB(3.9,146089,2,1481,0)="""RTN"",""PSOORFI6"",230,0)"
^XMB(3.9,146089,2,1482,0)=" ; priority"
^XMB(3.9,146089,2,1483,0)="""RTN"",""PSOORFI6"",231,0)"
^XMB(3.9,146089,2,1484,0)=" I FLTRTYP=""PR"" D  Q RES"
^XMB(3.9,146089,2,1485,0)="""RTN"",""PSOORFI6"",232,0)"
^XMB(3.9,146089,2,1486,0)=" .I $$GET1^DIQ(52.41,IEN,25,""I"")'=FLTRVAL S RES=0 Q"
^XMB(3.9,146089,2,1487,0)="""RTN"",""PSOORFI6"",233,0)"
^XMB(3.9,146089,2,1488,0)=" .S RES=1"
^XMB(3.9,146089,2,1489,0)="""RTN"",""PSOORFI6"",234,0)"
^XMB(3.9,146089,2,1490,0)=" ; supply filter"
^XMB(3.9,146089,2,1491,0)="""RTN"",""PSOORFI6"",235,0)"
^XMB(3.9,146089,2,1492,0)=" I FLTRTYP=""SU"" D  Q RES"
^XMB(3.9,146089,2,1493,0)="""RTN"",""PSOORFI6"",236,0)"
^XMB(3.9,146089,2,1494,0)=" .S RES=$$ISSUPPLY(IEN)"
^XMB(3.9,146089,2,1495,0)="""RTN"",""PSOORFI6"",237,0)"
^XMB(3.9,146089,2,1496,0)=" ; controlled substances"
^XMB(3.9,146089,2,1497,0)="""RTN"",""PSOORFI6"",238,0)"
^XMB(3.9,146089,2,1498,0)=" S FLTRVAL=$P(FLTR,U,3)"
^XMB(3.9,146089,2,1499,0)="""RTN"",""PSOORFI6"",239,0)"
^XMB(3.9,146089,2,1500,0)=" I FLTRTYP=""CS"" D  Q RES"
^XMB(3.9,146089,2,1501,0)="""RTN"",""PSOORFI6"",240,0)"
^XMB(3.9,146089,2,1502,0)=" .S PDEA=0,OR0=$G(^PS(52.41,IEN,0)),PSRT=FLTRVAL"
^XMB(3.9,146089,2,1503,0)="""RTN"",""PSOORFI6"",241,0)"
^XMB(3.9,146089,2,1504,0)=" .D PDEA^PSOORFI5 I 'PDEA!(PDEA'=PSRT) S RES=0 Q"
^XMB(3.9,146089,2,1505,0)="""RTN"",""PSOORFI6"",242,0)"
^XMB(3.9,146089,2,1506,0)=" .S RES=1"
^XMB(3.9,146089,2,1507,0)="""RTN"",""PSOORFI6"",243,0)"
^XMB(3.9,146089,2,1508,0)=" Q"
^XMB(3.9,146089,2,1509,0)="""RTN"",""PSOORFI6"",244,0)"
^XMB(3.9,146089,2,1510,0)="ISSUPPLY(IEN) ;"
