^XMB(3.9,146037,2,2782,0)=" ; Initialize Report Date, Page Number and Sting of underscores"
^XMB(3.9,146037,2,2783,0)="""RTN"",""RCDPTAR1"",235,0)"
^XMB(3.9,146037,2,2784,0)=" S RCSCR=$S($E($G(IOST),1,2)=""C-"":1,1:0)"
