^XMB(3.9,146043,2,753,0)="""RTN"",""MDCLIO1"",256,0)"
^XMB(3.9,146043,2,754,0)=" S MDFR=$$FMDT^MDCLIO(P2(1))-.0000001"
^XMB(3.9,146043,2,755,0)="""RTN"",""MDCLIO1"",257,0)"
^XMB(3.9,146043,2,756,0)=" S MDTO=$$FMDT^MDCLIO(P2(2))"
^XMB(3.9,146043,2,757,0)="""RTN"",""MDCLIO1"",258,0)"
^XMB(3.9,146043,2,758,0)=" S MDSTAT="""""
^XMB(3.9,146043,2,759,0)="""RTN"",""MDCLIO1"",259,0)"
^XMB(3.9,146043,2,760,0)=" F  S MDSTAT=$O(^MDC(704.117,""AS"",MDSTAT))  Q:MDSTAT=""""  D"
^XMB(3.9,146043,2,761,0)="""RTN"",""MDCLIO1"",260,0)"
^XMB(3.9,146043,2,762,0)=" .S MDDT=MDFR"
