^XMB(3.9,146087,2,3433,0)="""RTN"",""YTQRQAD4"",203,0)"
^XMB(3.9,146087,2,3434,0)=" ..Q:'$D(^XTMP(""YTQASMT-SET-""_ASMT))"
^XMB(3.9,146087,2,3435,0)="""RTN"",""YTQRQAD4"",204,0)"
^XMB(3.9,146087,2,3436,0)=" ..S NOD=""YTQASMT-SET-""_ASMT"
^XMB(3.9,146087,2,3437,0)="""RTN"",""YTQRQAD4"",205,0)"
^XMB(3.9,146087,2,3438,0)=" ..S ENTRY=$G(^XTMP(NOD,1,""entryMode""))"
^XMB(3.9,146087,2,3439,0)="""RTN"",""YTQRQAD4"",206,0)"
^XMB(3.9,146087,2,3440,0)=" ..S APPSRC=$G(^XTMP(NOD,1,""appSrc""))"
^XMB(3.9,146087,2,3441,0)="""RTN"",""YTQRQAD4"",207,0)"
^XMB(3.9,146087,2,3442,0)=" ..I ENTRY=""patient"" D  Q"
^XMB(3.9,146087,2,3443,0)="""RTN"",""YTQRQAD4"",208,0)"
^XMB(3.9,146087,2,3444,0)=" ... S (IHIT,I)=0 F  S I=$O(^XTMP(NOD,1,""instruments"",I)) Q:+I=0  D"
^XMB(3.9,146087,2,3445,0)="""RTN"",""YTQRQAD4"",209,0)"
^XMB(3.9,146087,2,3446,0)=" .... S ADMINID=+$G(^XTMP(NOD,1,""instruments"",I,""adminId"")) Q:$D(PATLST(ADMINID))!(ADMINID=0)"
^XMB(3.9,146087,2,3447,0)="""RTN"",""YTQRQAD4"",210,0)"
