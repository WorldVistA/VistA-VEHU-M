^XMB(3.9,146107,2,351,0)="""RTN"",""PSJORUT2"",56,0)"
^XMB(3.9,146107,2,352,0)=" ;"
^XMB(3.9,146107,2,353,0)="""RTN"",""PSJORUT2"",57,0)"
^XMB(3.9,146107,2,354,0)="SENVOL(PN,PSJ) ;Return array listing volume (base only) and volume units for the specified additive or solution."
^XMB(3.9,146107,2,355,0)="""RTN"",""PSJORUT2"",58,0)"
^XMB(3.9,146107,2,356,0)=" ;Input:  PN - IEN_B (Base) or A (Additive)"
^XMB(3.9,146107,2,357,0)="""RTN"",""PSJORUT2"",59,0)"
^XMB(3.9,146107,2,358,0)=" ;Output: ARRAY(IEN,A:additive or B:Base)=volume^volume units"
^XMB(3.9,146107,2,359,0)="""RTN"",""PSJORUT2"",60,0)"
^XMB(3.9,146107,2,360,0)=" ;        If no volume or units found PSJ=0; If found PSJ=1."
^XMB(3.9,146107,2,361,0)="""RTN"",""PSJORUT2"",61,0)"
^XMB(3.9,146107,2,362,0)=" ;"
^XMB(3.9,146107,2,363,0)="""RTN"",""PSJORUT2"",62,0)"
^XMB(3.9,146107,2,364,0)=" N X S PSJ=1"
^XMB(3.9,146107,2,365,0)="""RTN"",""PSJORUT2"",63,0)"
^XMB(3.9,146107,2,366,0)=" S X(1)=""ML"",X(2)=""LITER"",X(3)=""MCG"",X(4)=""MG"",X(5)=""GM"",X(6)=""UNITS"",X(7)=""IU"",X(8)=""MEQ"",X(9)=""MM"",X(10)=""MU"",X(11)=""THOUU"",X(12)=""MG-PE"",X(13)=""NANOGRAM"",X(14)=""MMOL"""
^XMB(3.9,146107,2,367,0)="""RTN"",""PSJORUT2"",64,0)"
^XMB(3.9,146107,2,368,0)=" I PN'[""A"",PN'[""B"" S PSJ=0 Q"
^XMB(3.9,146107,2,369,0)="""RTN"",""PSJORUT2"",65,0)"
^XMB(3.9,146107,2,370,0)=" S PSJ=PSJ+1"
^XMB(3.9,146107,2,371,0)="""RTN"",""PSJORUT2"",66,0)"
^XMB(3.9,146107,2,372,0)=" I PN[""A"" S PSJ(+PN,""A"")=U_X(+$P($G(^PS(52.6,+PN,0)),U,3)) Q"
^XMB(3.9,146107,2,373,0)="""RTN"",""PSJORUT2"",67,0)"
^XMB(3.9,146107,2,374,0)=" I PN[""B"" S PSJ(+PN,""B"")=+$P($G(^PS(52.7,+PN,0)),U,3)_U_X(1) Q"
