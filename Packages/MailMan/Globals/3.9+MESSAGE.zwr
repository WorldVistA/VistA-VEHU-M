^XMB(3.9,146098,2,1752,0)=" I '$D(LETTERS) S LETTERS(""Letters"",1)="""""
^XMB(3.9,146098,2,1753,0)="""RTN"",""SDESAPPTLETTERS"",64,0)"
^XMB(3.9,146098,2,1754,0)=" I $D(ERRORS) M LETTERS=ERRORS"
^XMB(3.9,146098,2,1755,0)="""RTN"",""SDESAPPTLETTERS"",65,0)"
^XMB(3.9,146098,2,1756,0)=" D BUILDJSON^SDESBUILDJSON(.SDRES,.LETTERS)"
^XMB(3.9,146098,2,1757,0)="""RTN"",""SDESAPPTLETTERS"",66,0)"
^XMB(3.9,146098,2,1758,0)=" Q"
^XMB(3.9,146098,2,1759,0)="""RTN"",""SDESAPPTLETTERS"",67,0)"
^XMB(3.9,146098,2,1760,0)=" ; validate appointment list"
^XMB(3.9,146098,2,1761,0)="""RTN"",""SDESAPPTLETTERS"",68,0)"
^XMB(3.9,146098,2,1762,0)="VALAPPTS(ERRORS,LIST) ;"
^XMB(3.9,146098,2,1763,0)="""RTN"",""SDESAPPTLETTERS"",69,0)"
^XMB(3.9,146098,2,1764,0)=" N APPT"
^XMB(3.9,146098,2,1765,0)="""RTN"",""SDESAPPTLETTERS"",70,0)"
^XMB(3.9,146098,2,1766,0)=" I '$O(LIST(0)) D ERRLOG^SDESJSON(.ERRORS,254)"
^XMB(3.9,146098,2,1767,0)="""RTN"",""SDESAPPTLETTERS"",71,0)"
^XMB(3.9,146098,2,1768,0)=" S APPT=0 F  S APPT=$O(LIST(APPT)) Q:'APPT  D"
^XMB(3.9,146098,2,1769,0)="""RTN"",""SDESAPPTLETTERS"",72,0)"
^XMB(3.9,146098,2,1770,0)=" .I '$D(^SDEC(409.84,APPT)) D ERRLOG^SDESJSON(.ERRORS,52,""Invalid appointment ID ""_APPT)"
^XMB(3.9,146098,2,1771,0)="""RTN"",""SDESAPPTLETTERS"",73,0)"
^XMB(3.9,146098,2,1772,0)=" Q"
^XMB(3.9,146098,2,1773,0)="""RTN"",""SDESAPPTLETTERS"",74,0)"
^XMB(3.9,146098,2,1774,0)="VALAPPT(ERRORS,APPTIEN) ;"
^XMB(3.9,146098,2,1775,0)="""RTN"",""SDESAPPTLETTERS"",75,0)"
^XMB(3.9,146098,2,1776,0)=" I '$L(APPTIEN) D ERRLOG^SDESJSON(.ERRORS,14) Q"
^XMB(3.9,146098,2,1777,0)="""RTN"",""SDESAPPTLETTERS"",76,0)"
^XMB(3.9,146098,2,1778,0)=" I '$D(^SDEC(409.84,APPTIEN)) D ERRLOG^SDESJSON(.ERRORS,15)"
^XMB(3.9,146098,2,1779,0)="""RTN"",""SDESAPPTLETTERS"",77,0)"
^XMB(3.9,146098,2,1780,0)=" Q"
^XMB(3.9,146098,2,1781,0)="""RTN"",""SDESAPPTLETTERS"",78,0)"
^XMB(3.9,146098,2,1782,0)=" ; validate letter type"
^XMB(3.9,146098,2,1783,0)="""RTN"",""SDESAPPTLETTERS"",79,0)"
^XMB(3.9,146098,2,1784,0)="VALLETTYPE(ERRORS,LTYPE) ;"
^XMB(3.9,146098,2,1785,0)="""RTN"",""SDESAPPTLETTERS"",80,0)"
^XMB(3.9,146098,2,1786,0)=" N LIEN,RESOURCE,CLIN"
^XMB(3.9,146098,2,1787,0)="""RTN"",""SDESAPPTLETTERS"",81,0)"
^XMB(3.9,146098,2,1788,0)=" I '$L(LTYPE) D ERRLOG^SDESJSON(.ERRORS,228) Q """" ; missing letter type"
^XMB(3.9,146098,2,1789,0)="""RTN"",""SDESAPPTLETTERS"",82,0)"
^XMB(3.9,146098,2,1790,0)=" I '$D(^VA(407.6,""B"",LTYPE)) D ERRLOG^SDESJSON(.ERRORS,226) Q """"  ;Invalid letter type."
^XMB(3.9,146098,2,1791,0)="""RTN"",""SDESAPPTLETTERS"",83,0)"
^XMB(3.9,146098,2,1792,0)=" ;S LIEN=$$FIND1^DIC(407.6,,""B"",LTYPE)"
^XMB(3.9,146098,2,1793,0)="""RTN"",""SDESAPPTLETTERS"",84,0)"
^XMB(3.9,146098,2,1794,0)=" S LIEN="""",LIEN=$O(^VA(407.6,""B"",LTYPE,LIEN))"
^XMB(3.9,146098,2,1795,0)="""RTN"",""SDESAPPTLETTERS"",85,0)"
^XMB(3.9,146098,2,1796,0)=" Q LIEN"
^XMB(3.9,146098,2,1797,0)="""RTN"",""SDESAPPTLETTERS"",86,0)"
^XMB(3.9,146098,2,1798,0)="VALIDATEEAS(ERRORS,SDEAS) ;"
^XMB(3.9,146098,2,1799,0)="""RTN"",""SDESAPPTLETTERS"",87,0)"
^XMB(3.9,146098,2,1800,0)=" I $L(SDEAS) S SDEAS=$$EASVALIDATE^SDESUTIL($G(SDEAS))"
^XMB(3.9,146098,2,1801,0)="""RTN"",""SDESAPPTLETTERS"",88,0)"
^XMB(3.9,146098,2,1802,0)=" I $P($G(SDEAS),U)=-1 D ERRLOG^SDESJSON(.ERRORS,142)"
^XMB(3.9,146098,2,1803,0)="""RTN"",""SDESAPPTLETTERS"",89,0)"
^XMB(3.9,146098,2,1804,0)=" Q"
^XMB(3.9,146098,2,1805,0)="""RTN"",""SDESAPPTLETTERS"",90,0)"
^XMB(3.9,146098,2,1806,0)=" ; print single appointment letter"
^XMB(3.9,146098,2,1807,0)="""RTN"",""SDESAPPTLETTERS"",91,0)"
^XMB(3.9,146098,2,1808,0)="APPTLETTER(SDECY,SDECAPID,LT)  ;Print Appointment Letter"
^XMB(3.9,146098,2,1809,0)="""RTN"",""SDESAPPTLETTERS"",92,0)"
^XMB(3.9,146098,2,1810,0)=" ;APPTLETR(SDECY,SDECAPID,LT)  external parameter tag is in SDEC"
^XMB(3.9,146098,2,1811,0)="""RTN"",""SDESAPPTLETTERS"",93,0)"
^XMB(3.9,146098,2,1812,0)=" ; SDECAPPT = Pointer to appointment in SDEC APPOINTMENT file 409.84"
^XMB(3.9,146098,2,1813,0)="""RTN"",""SDESAPPTLETTERS"",94,0)"
^XMB(3.9,146098,2,1814,0)=" ; LT       = Letter type - ""N""=No Show; ""P""=Pre-Appointment; ""A""=Cancelled by Patient; ""C""=Cancelled by Clinic"
^XMB(3.9,146098,2,1815,0)="""RTN"",""SDESAPPTLETTERS"",95,0)"
^XMB(3.9,146098,2,1816,0)=" ;"
^XMB(3.9,146098,2,1817,0)="""RTN"",""SDESAPPTLETTERS"",96,0)"
^XMB(3.9,146098,2,1818,0)=" N SDECI,DFN,RES,CLINICIEN,SDLET,SDT,X1,X2,Y,TIMEZONE"
^XMB(3.9,146098,2,1819,0)="""RTN"",""SDESAPPTLETTERS"",97,0)"
^XMB(3.9,146098,2,1820,0)=" N SDIV,SDFORM,SDNAM,SDECDATA,SCLETFLD,ERRTXT"
^XMB(3.9,146098,2,1821,0)="""RTN"",""SDESAPPTLETTERS"",98,0)"
^XMB(3.9,146098,2,1822,0)=" S SDECI=0"
^XMB(3.9,146098,2,1823,0)="""RTN"",""SDESAPPTLETTERS"",99,0)"
^XMB(3.9,146098,2,1824,0)=" K ^TMP(""SDEC"",$J)"
^XMB(3.9,146098,2,1825,0)="""RTN"",""SDESAPPTLETTERS"",100,0)"
^XMB(3.9,146098,2,1826,0)=" S SDECY=""^TMP(""""SDEC"""",""_$J_"")"""
^XMB(3.9,146098,2,1827,0)="""RTN"",""SDESAPPTLETTERS"",101,0)"
^XMB(3.9,146098,2,1828,0)=" S ^TMP(""SDEC"",$J,0)=""T00080ERRORID""_$C(30)"
^XMB(3.9,146098,2,1829,0)="""RTN"",""SDESAPPTLETTERS"",102,0)"
^XMB(3.9,146098,2,1830,0)=" D GETS^DIQ(409.84,SDECAPID_"","","".01;.05;.07"",""I"",""SDECDATA"")"
^XMB(3.9,146098,2,1831,0)="""RTN"",""SDESAPPTLETTERS"",103,0)"
^XMB(3.9,146098,2,1832,0)=" S SDT=$G(SDECDATA(409.84,SDECAPID_"","",.01,""I""))"
^XMB(3.9,146098,2,1833,0)="""RTN"",""SDESAPPTLETTERS"",104,0)"
^XMB(3.9,146098,2,1834,0)=" S DFN=$G(SDECDATA(409.84,SDECAPID_"","",.05,""I""))"
^XMB(3.9,146098,2,1835,0)="""RTN"",""SDESAPPTLETTERS"",105,0)"
^XMB(3.9,146098,2,1836,0)=" S RES=$G(SDECDATA(409.84,SDECAPID_"","",.07,""I""))"
^XMB(3.9,146098,2,1837,0)="""RTN"",""SDESAPPTLETTERS"",106,0)"
^XMB(3.9,146098,2,1838,0)=" ; future consideration - it seems the letter should still print if there is no clinic.. may need to activate the following line"
^XMB(3.9,146098,2,1839,0)="""RTN"",""SDESAPPTLETTERS"",107,0)"
^XMB(3.9,146098,2,1840,0)=" ; I 'RES D ERRLOG^SDESJSON(.ERRORS,52,""No resource defined for this appointment."") Q"
^XMB(3.9,146098,2,1841,0)="""RTN"",""SDESAPPTLETTERS"",108,0)"
^XMB(3.9,146098,2,1842,0)=" S CLINICIEN=$$GET1^DIQ(409.831,RES,.04,""I"")"
^XMB(3.9,146098,2,1843,0)="""RTN"",""SDESAPPTLETTERS"",109,0)"
^XMB(3.9,146098,2,1844,0)=" S SCLETFLD=$S(LT=""N"":2508,LT=""P"":2509,LT=""C"":2510,LT=""A"":2511,1:2509)"
^XMB(3.9,146098,2,1845,0)="""RTN"",""SDESAPPTLETTERS"",110,0)"
^XMB(3.9,146098,2,1846,0)=" S SDLET=$$GET1^DIQ(44,CLINICIEN,SCLETFLD,""I"")"
^XMB(3.9,146098,2,1847,0)="""RTN"",""SDESAPPTLETTERS"",111,0)"
^XMB(3.9,146098,2,1848,0)=" I SDLET="""" D  Q"
^XMB(3.9,146098,2,1849,0)="""RTN"",""SDESAPPTLETTERS"",112,0)"
^XMB(3.9,146098,2,1850,0)=" .S ERRTXT=$S(LT=""N"":""No-Show"",LT=""P"":""Pre-Appointment"",LT=""C"":""Clinic Cancellation"",1:""Patient Cancellation"")_"" Letter not defined for Clinic ""_$$GET1^DIQ(44,CLINICIEN,.01,""E"")"
^XMB(3.9,146098,2,1851,0)="""RTN"",""SDESAPPTLETTERS"",113,0)"
^XMB(3.9,146098,2,1852,0)=" .S SDECI=SDECI+1,^TMP(""SDEC"",$J,SDECI)=ERRTXT"
^XMB(3.9,146098,2,1853,0)="""RTN"",""SDESAPPTLETTERS"",114,0)"
^XMB(3.9,146098,2,1854,0)=" S SDIV=$$GET1^DIQ(44,CLINICIEN,3.5,""I"")"
^XMB(3.9,146098,2,1855,0)="""RTN"",""SDESAPPTLETTERS"",115,0)"
^XMB(3.9,146098,2,1856,0)=" S SDIV=$S(SDIV:SDIV,1:$O(^DG(40.8,0)))"
^XMB(3.9,146098,2,1857,0)="""RTN"",""SDESAPPTLETTERS"",116,0)"
^XMB(3.9,146098,2,1858,0)=" ; address location on letters 1 - bottom, 0 - top"
^XMB(3.9,146098,2,1859,0)="""RTN"",""SDESAPPTLETTERS"",117,0)"
^XMB(3.9,146098,2,1860,0)=" S SDFORM=$$GET1^DIQ(40.8,SDIV,30.01,""I"")"
^XMB(3.9,146098,2,1861,0)="""RTN"",""SDESAPPTLETTERS"",118,0)"
^XMB(3.9,146098,2,1862,0)=" ; data header"
^XMB(3.9,146098,2,1863,0)="""RTN"",""SDESAPPTLETTERS"",119,0)"
^XMB(3.9,146098,2,1864,0)=" S ^TMP(""SDEC"",$J,0)=""T00080TEXT""_$C(30)"
^XMB(3.9,146098,2,1865,0)="""RTN"",""SDESAPPTLETTERS"",120,0)"
^XMB(3.9,146098,2,1866,0)=" D PRT(DFN,CLINICIEN,SDT,LT,SDLET,SDFORM)"
^XMB(3.9,146098,2,1867,0)="""RTN"",""SDESAPPTLETTERS"",121,0)"
^XMB(3.9,146098,2,1868,0)=" D WRAPP(DFN,CLINICIEN,SDT,LT,SDLET)"
^XMB(3.9,146098,2,1869,0)="""RTN"",""SDESAPPTLETTERS"",122,0)"
^XMB(3.9,146098,2,1870,0)=" D REST(DFN,CLINICIEN,SDT,LT,SDLET,SDFORM)"
^XMB(3.9,146098,2,1871,0)="""RTN"",""SDESAPPTLETTERS"",123,0)"
^XMB(3.9,146098,2,1872,0)=" S SDECI=SDECI+1 S SDECI=SDECI+1 S ^TMP(""SDEC"",$J,SDECI)="""""
^XMB(3.9,146098,2,1873,0)="""RTN"",""SDESAPPTLETTERS"",124,0)"
^XMB(3.9,146098,2,1874,0)=" Q"
^XMB(3.9,146098,2,1875,0)="""RTN"",""SDESAPPTLETTERS"",125,0)"
^XMB(3.9,146098,2,1876,0)=" ;"
^XMB(3.9,146098,2,1877,0)="""RTN"",""SDESAPPTLETTERS"",126,0)"
^XMB(3.9,146098,2,1878,0)=" ;"
^XMB(3.9,146098,2,1879,0)="""RTN"",""SDESAPPTLETTERS"",127,0)"
^XMB(3.9,146098,2,1880,0)="PRT(DFN,SDC,SD,LT,SDLET,SDFORM) ;"
^XMB(3.9,146098,2,1881,0)="""RTN"",""SDESAPPTLETTERS"",128,0)"
^XMB(3.9,146098,2,1882,0)=" ;  DFN - pointer to PATIENT file 2"
^XMB(3.9,146098,2,1883,0)="""RTN"",""SDESAPPTLETTERS"",129,0)"
^XMB(3.9,146098,2,1884,0)=" ;  SDC - pointer to HOSPITAL LOCATION file 44"
^XMB(3.9,146098,2,1885,0)="""RTN"",""SDESAPPTLETTERS"",130,0)"
^XMB(3.9,146098,2,1886,0)=" ;  SD  - appointment time in FM format"
^XMB(3.9,146098,2,1887,0)="""RTN"",""SDESAPPTLETTERS"",131,0)"
^XMB(3.9,146098,2,1888,0)=" ;  LT  - Letter type - ""N""=No Show; ""P""=Pre-Appointment; ""A""=Cancelled by Patient; ""C""=Cancelled by Clinic"
^XMB(3.9,146098,2,1889,0)="""RTN"",""SDESAPPTLETTERS"",132,0)"
^XMB(3.9,146098,2,1890,0)=" ;  SDLET - pointer to LETTER file 407.5"
^XMB(3.9,146098,2,1891,0)="""RTN"",""SDESAPPTLETTERS"",133,0)"
^XMB(3.9,146098,2,1892,0)=" ;  SDFORM - address location on letters (1 - bottom, 0 - top)"
^XMB(3.9,146098,2,1893,0)="""RTN"",""SDESAPPTLETTERS"",134,0)"
^XMB(3.9,146098,2,1894,0)=" ;WRITE GREETING AND OPENING TEXT OF LETTER"
^XMB(3.9,146098,2,1895,0)="""RTN"",""SDESAPPTLETTERS"",135,0)"
^XMB(3.9,146098,2,1896,0)=" N DPTNAME,INITSEC,X,Y"
^XMB(3.9,146098,2,1897,0)="""RTN"",""SDESAPPTLETTERS"",136,0)"
^XMB(3.9,146098,2,1898,0)=" Q:DFN="""""
^XMB(3.9,146098,2,1899,0)="""RTN"",""SDESAPPTLETTERS"",137,0)"
^XMB(3.9,146098,2,1900,0)=" Q:LT="""""
^XMB(3.9,146098,2,1901,0)="""RTN"",""SDESAPPTLETTERS"",138,0)"
^XMB(3.9,146098,2,1902,0)=" S SDFORM=$G(SDFORM)"
^XMB(3.9,146098,2,1903,0)="""RTN"",""SDESAPPTLETTERS"",139,0)"
^XMB(3.9,146098,2,1904,0)=" S Y=DT"
^XMB(3.9,146098,2,1905,0)="""RTN"",""SDESAPPTLETTERS"",140,0)"
^XMB(3.9,146098,2,1906,0)=" S Y=$TR($$FMTE^XLFDT(Y,""5DF""),"" "",""0"")"
^XMB(3.9,146098,2,1907,0)="""RTN"",""SDESAPPTLETTERS"",141,0)"
^XMB(3.9,146098,2,1908,0)=" S SDECI=SDECI+1 S ^TMP(""SDEC"",$J,SDECI)=$$FILL(64,"" "")_Y"
^XMB(3.9,146098,2,1909,0)="""RTN"",""SDESAPPTLETTERS"",142,0)"
^XMB(3.9,146098,2,1910,0)=" S SDECI=SDECI+1 S ^TMP(""SDEC"",$J,SDECI)=$$FILL(64,"" "")_$$LAST4(DFN)"
^XMB(3.9,146098,2,1911,0)="""RTN"",""SDESAPPTLETTERS"",143,0)"
^XMB(3.9,146098,2,1912,0)=" I 'SDFORM D"
^XMB(3.9,146098,2,1913,0)="""RTN"",""SDESAPPTLETTERS"",144,0)"
^XMB(3.9,146098,2,1914,0)=" .F I=1:1:4 S SDECI=SDECI+1 S ^TMP(""SDEC"",$J,SDECI)="""""
^XMB(3.9,146098,2,1915,0)="""RTN"",""SDESAPPTLETTERS"",145,0)"
^XMB(3.9,146098,2,1916,0)=" .D ADDR(DFN)"
^XMB(3.9,146098,2,1917,0)="""RTN"",""SDESAPPTLETTERS"",146,0)"
^XMB(3.9,146098,2,1918,0)=" .F I=1:1:4 S SDECI=SDECI+1 S ^TMP(""SDEC"",$J,SDECI)="""""
^XMB(3.9,146098,2,1919,0)="""RTN"",""SDESAPPTLETTERS"",147,0)"
^XMB(3.9,146098,2,1920,0)=" ;"
^XMB(3.9,146098,2,1921,0)="""RTN"",""SDESAPPTLETTERS"",148,0)"
^XMB(3.9,146098,2,1922,0)=" S DPTNAME(""FILE"")=2,DPTNAME(""FIELD"")="".01"",DPTNAME(""IENS"")=(+DFN)_"","""
^XMB(3.9,146098,2,1923,0)="""RTN"",""SDESAPPTLETTERS"",149,0)"
^XMB(3.9,146098,2,1924,0)=" S X=$$NAMEFMT^XLFNAME(.DPTNAME,""G"",""M"")"
^XMB(3.9,146098,2,1925,0)="""RTN"",""SDESAPPTLETTERS"",150,0)"
^XMB(3.9,146098,2,1926,0)=" S SDECI=SDECI+1 S ^TMP(""SDEC"",$J,SDECI)=""Dear ""_X_"","" ;VSE-693;LEG 5/12/21"
^XMB(3.9,146098,2,1927,0)="""RTN"",""SDESAPPTLETTERS"",151,0)"
