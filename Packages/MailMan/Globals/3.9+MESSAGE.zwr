^XMB(3.9,146054,2,486,0)=" . . S FOUND=0"
^XMB(3.9,146054,2,487,0)="""RTN"",""XQARPRT2"",123,0)"
^XMB(3.9,146054,2,488,0)=" . . I (XQATYPE=""DVB"")!(XQATYPE=""OR,"") I $P(ZERO,U,4)=XQADFN S FOUND=1"
^XMB(3.9,146054,2,489,0)="""RTN"",""XQARPRT2"",124,0)"
^XMB(3.9,146054,2,490,0)=" . . I (XQATYPE=""GMA""),$P(ONE,U)[XQANAME S FOUND=1"
^XMB(3.9,146054,2,491,0)="""RTN"",""XQARPRT2"",125,0)"
^XMB(3.9,146054,2,492,0)=" . . I (XQATYPE=""TIU""),$P(ONE,U)[$E(XQANAME,1,9),$P(ONE,U)[XQA1U4NP S FOUND=1"
^XMB(3.9,146054,2,493,0)="""RTN"",""XQARPRT2"",126,0)"
^XMB(3.9,146054,2,494,0)=" . . I FOUND D PRNTATRK(XQAIEN)"
^XMB(3.9,146054,2,495,0)="""RTN"",""XQARPRT2"",127,0)"
^XMB(3.9,146054,2,496,0)=" . . Q"
^XMB(3.9,146054,2,497,0)="""RTN"",""XQARPRT2"",128,0)"
^XMB(3.9,146054,2,498,0)=" . Q"
^XMB(3.9,146054,2,499,0)="""RTN"",""XQARPRT2"",129,0)"
^XMB(3.9,146054,2,500,0)=" D HEADER(HEADERID,0)"
^XMB(3.9,146054,2,501,0)="""RTN"",""XQARPRT2"",130,0)"
^XMB(3.9,146054,2,502,0)=" Q"
^XMB(3.9,146054,2,503,0)="""RTN"",""XQARPRT2"",131,0)"
^XMB(3.9,146054,2,504,0)=" ;"
^XMB(3.9,146054,2,505,0)="""RTN"",""XQARPRT2"",132,0)"
^XMB(3.9,146054,2,506,0)="CHEKSCAN(XQADFN) ; Output a list of dates when OR, and DVB alerts are found"
^XMB(3.9,146054,2,507,0)="""RTN"",""XQARPRT2"",133,0)"
^XMB(3.9,146054,2,508,0)=" N DIR,OLDEST,X,Y,XQASDATE,XX,CNT,COL,BASECNT,I"
^XMB(3.9,146054,2,509,0)="""RTN"",""XQARPRT2"",134,0)"
^XMB(3.9,146054,2,510,0)=" W !!! S DIR(0)=""Y"",DIR(""A"")=""Do you want to scan for a list of dates that have at least some alerts for this patient"",DIR(""A"",1)=""The quick scan method used here will not pick up some alerts,"""
^XMB(3.9,146054,2,511,0)="""RTN"",""XQARPRT2"",135,0)"
^XMB(3.9,146054,2,512,0)=" S DIR(""A"",2)=""but should give an indication of when alerts might be found."",DIR(""A"",3)="""""
^XMB(3.9,146054,2,513,0)="""RTN"",""XQARPRT2"",136,0)"
^XMB(3.9,146054,2,514,0)=" D ^DIR K DIR Q:$D(DIRUT)  I Y D"
^XMB(3.9,146054,2,515,0)="""RTN"",""XQARPRT2"",137,0)"
^XMB(3.9,146054,2,516,0)=" . K ^TMP(""XQARPRT2"",$J)"
^XMB(3.9,146054,2,517,0)="""RTN"",""XQARPRT2"",138,0)"
^XMB(3.9,146054,2,518,0)=" . N OLDEST S OLDEST=$$FMTE^XLFDT($$OLDEST(),""5DZ"")"
^XMB(3.9,146054,2,519,0)="""RTN"",""XQARPRT2"",139,0)"
^XMB(3.9,146054,2,520,0)=" . S DIR(0)=""SO^;1:1 Week ago;2:1 month ago;3:3 months ago;4:6 months ago;5:1 year ago;6:As far back as possible"",DIR(""A"")=""Select a period for starting"",DIR(""A"",1)=""The oldest entry in your Alert Tracking file is from ""_OLDEST,DIR(""A"",2)="""""
^XMB(3.9,146054,2,521,0)="""RTN"",""XQARPRT2"",140,0)"
^XMB(3.9,146054,2,522,0)=" . D ^DIR K DIR Q:Y'>0"
^XMB(3.9,146054,2,523,0)="""RTN"",""XQARPRT2"",141,0)"
^XMB(3.9,146054,2,524,0)=" . S X=$S(Y=1:""1W"",Y=2:""1M"",Y=3:""3M"",Y=4:""6M"",Y=5:""12M"",1:""1000M""),X=""T-""_X D ^%DT S XQASDATE=Y"
^XMB(3.9,146054,2,525,0)="""RTN"",""XQARPRT2"",142,0)"
^XMB(3.9,146054,2,526,0)=" . F I=0:0 S I=$O(^XTV(8992.1,""C"",XQADFN,I)) Q:I'>0  S ZERO=$P(^XTV(8992.1,I,0),U,2) I ZERO'<XQASDATE S ^TMP(""XQARPRT2"",$J,(ZERO\1))=$G(^TMP(""XQARPRT2"",$J,(ZERO\1)))+1"
^XMB(3.9,146054,2,527,0)="""RTN"",""XQARPRT2"",143,0)"
^XMB(3.9,146054,2,528,0)=" . ; Output date and number found in vertical columns, with (if lots of dates) three columns per screen"
^XMB(3.9,146054,2,529,0)="""RTN"",""XQARPRT2"",144,0)"
^XMB(3.9,146054,2,530,0)=" . I $D(^TMP(""XQARPRT2"",$J)) W !,""Dates and number of alerts found in () [may not be all of them]"""
^XMB(3.9,146054,2,531,0)="""RTN"",""XQARPRT2"",145,0)"
^XMB(3.9,146054,2,532,0)=" . ; S CNT=0,COL=1,BASECNT=0 F I=0:0 S I=$O(^TMP(""XQARPRT2"",$J,I)) Q:I'>0  S CNT=CNT+1,XX(CNT)=$G(XX(CNT))_$$FMTE^XLFDT(I,""5DZ"")_""  (""_^(I)_"")""_""     "" I (CNT-BASECNT)>(IOSL-4) S COL=COL+1 S:'(COL#3) BASECNT=CNT S CNT=BASECNT"
^XMB(3.9,146054,2,533,0)="""RTN"",""XQARPRT2"",146,0)"
^XMB(3.9,146054,2,534,0)=" . S CNT=2 F I=0:0 S I=$O(^TMP(""XQARPRT2"",$J,I)) Q:I'>0  S CNT=CNT+1,XX(CNT\3)=$G(XX(CNT\3))_$$FMTE^XLFDT(I,""5DZ"")_""  (""_^(I)_"")""_""     """
^XMB(3.9,146054,2,535,0)="""RTN"",""XQARPRT2"",147,0)"
^XMB(3.9,146054,2,536,0)=" . F I=0:0 S I=$O(XX(I)) Q:I'>0  W !,XX(I)"
^XMB(3.9,146054,2,537,0)="""RTN"",""XQARPRT2"",148,0)"
^XMB(3.9,146054,2,538,0)=" . Q"
^XMB(3.9,146054,2,539,0)="""RTN"",""XQARPRT2"",149,0)"
^XMB(3.9,146054,2,540,0)=" Q"
^XMB(3.9,146054,2,541,0)="""RTN"",""XQARPRT2"",150,0)"
^XMB(3.9,146054,2,542,0)=" ;"
^XMB(3.9,146054,2,543,0)="""RTN"",""XQARPRT2"",151,0)"
^XMB(3.9,146054,2,544,0)="VIEWTRAK ; OPT.  View an entry in the Alert Tracking file in Captioned mode"
^XMB(3.9,146054,2,545,0)="""RTN"",""XQARPRT2"",152,0)"
^XMB(3.9,146054,2,546,0)=" D VIEWTRAK^XQARPRT1"
^XMB(3.9,146054,2,547,0)="""RTN"",""XQARPRT2"",153,0)"
^XMB(3.9,146054,2,548,0)=" Q"
^XMB(3.9,146054,2,549,0)="""RTN"",""XQARPRT2"",154,0)"
^XMB(3.9,146054,2,550,0)=" ;"
^XMB(3.9,146054,2,551,0)="""RTN"",""XQARPRT2"",155,0)"
^XMB(3.9,146054,2,552,0)="OLDEST() ; Returns date of oldest entry in alert tracking file"
^XMB(3.9,146054,2,553,0)="""RTN"",""XQARPRT2"",156,0)"
^XMB(3.9,146054,2,554,0)=" Q $$OLDEST^XQARPRT1()"
