^XMB(3.9,146052,2,681,0)="""RTN"",""FBAAAUDR"",61,0)"
^XMB(3.9,146052,2,682,0)=" . I $E(IOST,1,2)=""C-"" S DIR(0)=""E"" D ^DIR K DIR I 'Y S FBQUIT=1"
^XMB(3.9,146052,2,683,0)="""RTN"",""FBAAAUDR"",62,0)"
