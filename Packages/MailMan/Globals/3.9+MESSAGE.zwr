^XMB(3.9,146087,2,3559,0)="""RTN"",""YTQRQAD4"",266,0)"
^XMB(3.9,146087,2,3560,0)=" .I XADMIN,'$D(^YTT(601.84,XADMIN)) D RMVTEST^YTQRQAD1(ASMT,NAME) Q"
^XMB(3.9,146087,2,3561,0)="""RTN"",""YTQRQAD4"",267,0)"
