^XMB(3.9,146087,2,610,0)=" ;"
^XMB(3.9,146087,2,611,0)="""RTN"",""YTQAPI1"",133,0)"
^XMB(3.9,146087,2,612,0)=" N YTFDA,YTIEN,YTERR,DIERR"
^XMB(3.9,146087,2,613,0)="""RTN"",""YTQAPI1"",134,0)"
