^XMB(3.9,146017,2,1381,0)="""RTN"",""SDES2CANCLNAVAIL"",128,0)"
^XMB(3.9,146017,2,1382,0)=" N SCHEDULEDATE,CANCELDATETIME,CANCELSTART,CANCELEND,SUBIEN,APPTDATETIME,DATEINC"
^XMB(3.9,146017,2,1383,0)="""RTN"",""SDES2CANCLNAVAIL"",129,0)"
^XMB(3.9,146017,2,1384,0)=" ;"
^XMB(3.9,146017,2,1385,0)="""RTN"",""SDES2CANCLNAVAIL"",130,0)"
^XMB(3.9,146017,2,1386,0)=" I FLAG=""P"",$P(STARTDATETIME,""."")'=$P(ENDDATETIME,""."") D ERRLOG^SDESJSON(.ERRORS,576) Q"
^XMB(3.9,146017,2,1387,0)="""RTN"",""SDES2CANCLNAVAIL"",131,0)"
^XMB(3.9,146017,2,1388,0)=" F DATEINC=0:1 S SCHEDULEDATE=$$FMADD^XLFDT($P(STARTDATETIME,"".""),DATEINC)  Q:'SCHEDULEDATE!(SCHEDULEDATE>$P(ENDDATETIME,"".""))!($D(ERRORS))  D"
^XMB(3.9,146017,2,1389,0)="""RTN"",""SDES2CANCLNAVAIL"",132,0)"
^XMB(3.9,146017,2,1390,0)=" .I $$INACTIVE^SDESUTIL(CLINICIEN,SCHEDULEDATE) D ERRLOG^SDESJSON(.ERRORS,525) Q"
^XMB(3.9,146017,2,1391,0)="""RTN"",""SDES2CANCLNAVAIL"",133,0)"
^XMB(3.9,146017,2,1392,0)=" .I $$GET1^DIQ(44.005,SCHEDULEDATE_"",""_CLINICIEN_"","",1,""I"")[""CANCELLED"" D ERRLOG^SDESJSON(.ERRORS,248) Q"
^XMB(3.9,146017,2,1393,0)="""RTN"",""SDES2CANCLNAVAIL"",134,0)"
^XMB(3.9,146017,2,1394,0)=" .I $$GET1^DIQ(44.005,SCHEDULEDATE_"",""_CLINICIEN_"","",1,""I"")'[""["" D ERRLOG^SDESJSON(.ERRORS,249) Q"
^XMB(3.9,146017,2,1395,0)="""RTN"",""SDES2CANCLNAVAIL"",135,0)"
