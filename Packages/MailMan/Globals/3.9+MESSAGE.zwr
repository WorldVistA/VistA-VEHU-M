^XMB(3.9,146087,2,466,0)=" I $D(YSERR) D  QUIT"
^XMB(3.9,146087,2,467,0)="""RTN"",""YTQAPI1"",61,0)"
^XMB(3.9,146087,2,468,0)=" . D ERR(.YSDATA,""Update Error"",YSERRLOG)"
^XMB(3.9,146087,2,469,0)="""RTN"",""YTQAPI1"",62,0)"
^XMB(3.9,146087,2,470,0)=" S YSDATA(1)=""[DATA]"",YSDATA(2)=""Update ok^""_$G(YSNN(1))_U_$G(YSNN(1,0))"
^XMB(3.9,146087,2,471,0)="""RTN"",""YTQAPI1"",63,0)"
^XMB(3.9,146087,2,472,0)=" ; publish add/edit admin event"
^XMB(3.9,146087,2,473,0)="""RTN"",""YTQAPI1"",64,0)"
