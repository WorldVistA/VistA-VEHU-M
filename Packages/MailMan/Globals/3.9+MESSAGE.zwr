^XMB(3.9,146052,2,1276,0)=" I ""^F^M^U^""[(U_FBI_U) F I=""PATIENT"",""VISIT"",""AMTPAID"" S FBT(I,""T"")=FBT(I,""T"")+FBT(I,FBI)"
