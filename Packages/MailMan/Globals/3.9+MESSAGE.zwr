^XMB(3.9,146103,2,195,0)="""QUES"",""XPI1"",""M"")"
^XMB(3.9,146103,2,196,0)="D XPI1^XPDIQ"
^XMB(3.9,146103,2,197,0)="""QUES"",""XPM1"",0)"
^XMB(3.9,146103,2,198,0)="PO^VA(200,:EM"
^XMB(3.9,146103,2,199,0)="""QUES"",""XPM1"",""??"")"
