^XMB(3.9,146084,2,2452,0)=" S SDDOD=$$FMTISO^SDAMUTDT($G(SDPATARR(2,SDFN,.351,""I""))),SDDOD=$E(SDDOD,1,10)"
^XMB(3.9,146084,2,2453,0)="""RTN"",""SDES2GETREGS"",191,0)"
