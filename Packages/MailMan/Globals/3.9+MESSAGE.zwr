^XMB(3.9,146018,2,876,0)=" I $G(DGF(.121))]"""" D"
^XMB(3.9,146018,2,877,0)="""RTN"",""DPTLK7"",315,0)"
^XMB(3.9,146018,2,878,0)=" . S:$G(DGF(.1151))]"""" DGR(""ResAddL1"")=DGF(.1151)"
^XMB(3.9,146018,2,879,0)="""RTN"",""DPTLK7"",316,0)"
^XMB(3.9,146018,2,880,0)=" . S:$G(DGF(.1156))]"""" DGR(""ResAddZip4"")=DGF(.1156)"
^XMB(3.9,146018,2,881,0)="""RTN"",""DPTLK7"",317,0)"
^XMB(3.9,146018,2,882,0)=" . S:$G(DGF(.1152))]"""" DGR(""ResAddL2"")=DGF(.1152)"
^XMB(3.9,146018,2,883,0)="""RTN"",""DPTLK7"",318,0)"
^XMB(3.9,146018,2,884,0)=" . S:$G(DGF(.1153))]"""" DGR(""ResAddL3"")=DGF(.1153)"
^XMB(3.9,146018,2,885,0)="""RTN"",""DPTLK7"",319,0)"
^XMB(3.9,146018,2,886,0)=" . S:$G(DGF(.1154))]"""" DGR(""CITY"")=DGF(.1154)"
^XMB(3.9,146018,2,887,0)="""RTN"",""DPTLK7"",320,0)"
^XMB(3.9,146018,2,888,0)=" . S:$P($G(DGF(.1155)),""^"",2) DGR(""ResAddState"")=$P($G(^DIC(5,$P(DGF(.1155),""^"",2),0)),""^"",2)"
^XMB(3.9,146018,2,889,0)="""RTN"",""DPTLK7"",321,0)"
^XMB(3.9,146018,2,890,0)=" . S:$G(DGF(.11571))]"""" DGR(""ResAddProvince"")=DGF(.11571)"
^XMB(3.9,146018,2,891,0)="""RTN"",""DPTLK7"",322,0)"
^XMB(3.9,146018,2,892,0)=" . S:$G(DGF(.11572))]"""" DGR(""ResAddPCode"")=DGF(.11572)"
^XMB(3.9,146018,2,893,0)="""RTN"",""DPTLK7"",323,0)"
^XMB(3.9,146018,2,894,0)=" . S:$P($G(DGF(.11573)),""^"")]"""" DGR(""ResAddCountry"")=$P(DGF(.11573),""^"")"
^XMB(3.9,146018,2,895,0)="""RTN"",""DPTLK7"",324,0)"
^XMB(3.9,146018,2,896,0)=" Q"
^XMB(3.9,146018,2,897,0)="""RTN"",""DPTLK7"",325,0)"
^XMB(3.9,146018,2,898,0)=" ;"
^XMB(3.9,146018,2,899,0)="""RTN"",""DPTLK7"",326,0)"
^XMB(3.9,146018,2,900,0)="ADD(DGF,DG20NAME) ; - stuff in patient"
^XMB(3.9,146018,2,901,0)="""RTN"",""DPTLK7"",327,0)"
^XMB(3.9,146018,2,902,0)=" ; Pass in the fields to set in the DGF array."
^XMB(3.9,146018,2,903,0)="""RTN"",""DPTLK7"",328,0)"
^XMB(3.9,146018,2,904,0)=" ; Alaso Name components in DG20NAME array.  Returns new DFN"
^XMB(3.9,146018,2,905,0)="""RTN"",""DPTLK7"",329,0)"
^XMB(3.9,146018,2,906,0)=" N X,Y,SAVY,FDA,IEN,DATA,DO,DIC,DA,X,DLAYGO,REQ,VAFCNO,DGY,DPTX"
^XMB(3.9,146018,2,907,0)="""RTN"",""DPTLK7"",330,0)"
^XMB(3.9,146018,2,908,0)=" I $E($G(DGF(.09)),1,9)'?9N S DGF(.09)=$$PSEUDO(DGF(.01),$G(DGF(.03)))"
^XMB(3.9,146018,2,909,0)="""RTN"",""DPTLK7"",331,0)"
^XMB(3.9,146018,2,910,0)=" ; check for SSN already exist"
^XMB(3.9,146018,2,911,0)="""RTN"",""DPTLK7"",332,0)"
^XMB(3.9,146018,2,912,0)=" S DGY=$O(^DPT(""SSN"",DGF(.09),0)) I DGY>0,$D(^DPT(DGY,0)) W *7,""  SSN Already used by patient '"",$P(^(0),""^""),""'."" Q 0"
^XMB(3.9,146018,2,913,0)="""RTN"",""DPTLK7"",333,0)"
^XMB(3.9,146018,2,914,0)=" ;"
^XMB(3.9,146018,2,915,0)="""RTN"",""DPTLK7"",334,0)"
^XMB(3.9,146018,2,916,0)=" S DIC(""DR"")="""",REQ=""^.02^.03^.09^"""
^XMB(3.9,146018,2,917,0)="""RTN"",""DPTLK7"",335,0)"
^XMB(3.9,146018,2,918,0)=" S DGF=.01 F  S DGF=$O(DGF(DGF)) Q:'DGF  D"
^XMB(3.9,146018,2,919,0)="""RTN"",""DPTLK7"",336,0)"
^XMB(3.9,146018,2,920,0)=" . ; if the data has a second piece, then that's internal value to use"
^XMB(3.9,146018,2,921,0)="""RTN"",""DPTLK7"",337,0)"
^XMB(3.9,146018,2,922,0)=" . S DATA=$S($P(DGF(DGF),""^"",2):$P(DGF(DGF),""^"",2),1:DGF(DGF))"
^XMB(3.9,146018,2,923,0)="""RTN"",""DPTLK7"",338,0)"
^XMB(3.9,146018,2,924,0)=" . I DATA]""""!(REQ[(""^""_DGF_""^"")) S DIC(""DR"")=DIC(""DR"")_DGF_$S(DATA]"""":""////""_DATA,1:"""")_"";"""
^XMB(3.9,146018,2,925,0)="""RTN"",""DPTLK7"",339,0)"
^XMB(3.9,146018,2,926,0)=" ;**1000,Story 1171329 (mko): Don't default TYPE, VETERAN, or SERVICE CONNECTED"
^XMB(3.9,146018,2,927,0)="""RTN"",""DPTLK7"",340,0)"
^XMB(3.9,146018,2,928,0)=" ;  These values were obtained earlier in the FLDS subroutine above"
^XMB(3.9,146018,2,929,0)="""RTN"",""DPTLK7"",341,0)"
^XMB(3.9,146018,2,930,0)=" ; patient type"
^XMB(3.9,146018,2,931,0)="""RTN"",""DPTLK7"",342,0)"
^XMB(3.9,146018,2,932,0)=" ;S DIC(""DR"")=DIC(""DR"")_""391///""_$O(^DG(391,""B"",""NSC VETERAN"",0))_"";"""
^XMB(3.9,146018,2,933,0)="""RTN"",""DPTLK7"",343,0)"
^XMB(3.9,146018,2,934,0)=" ; veteran"
^XMB(3.9,146018,2,935,0)="""RTN"",""DPTLK7"",344,0)"
^XMB(3.9,146018,2,936,0)=" ;S DIC(""DR"")=DIC(""DR"")_""1901///Y;"""
^XMB(3.9,146018,2,937,0)="""RTN"",""DPTLK7"",345,0)"
^XMB(3.9,146018,2,938,0)=" ; SC"
^XMB(3.9,146018,2,939,0)="""RTN"",""DPTLK7"",346,0)"
^XMB(3.9,146018,2,940,0)=" ;S DIC(""DR"")=DIC(""DR"")_"".301///N;"""
^XMB(3.9,146018,2,941,0)="""RTN"",""DPTLK7"",347,0)"
^XMB(3.9,146018,2,942,0)=" ; date added"
^XMB(3.9,146018,2,943,0)="""RTN"",""DPTLK7"",348,0)"
^XMB(3.9,146018,2,944,0)=" S DIC(""DR"")=DIC(""DR"")_"".097////""_DT"
^XMB(3.9,146018,2,945,0)="""RTN"",""DPTLK7"",349,0)"
^XMB(3.9,146018,2,946,0)=" ; who added"
^XMB(3.9,146018,2,947,0)="""RTN"",""DPTLK7"",350,0)"
^XMB(3.9,146018,2,948,0)=" S:$G(DUZ) DIC(""DR"")=DIC(""DR"")_"";.096////""_DUZ"
^XMB(3.9,146018,2,949,0)="""RTN"",""DPTLK7"",351,0)"
^XMB(3.9,146018,2,950,0)=" ;"
^XMB(3.9,146018,2,951,0)="""RTN"",""DPTLK7"",352,0)"
^XMB(3.9,146018,2,952,0)=" S X=DGF(.01),DIC=""^DPT("",DIC(0)=""L"",DLAYGO=2,VAFCNO=1"
^XMB(3.9,146018,2,953,0)="""RTN"",""DPTLK7"",353,0)"
^XMB(3.9,146018,2,954,0)=" D FILE^DICN"
^XMB(3.9,146018,2,955,0)="""RTN"",""DPTLK7"",354,0)"
^XMB(3.9,146018,2,956,0)=" S SAVY=+Y"
^XMB(3.9,146018,2,957,0)="""RTN"",""DPTLK7"",355,0)"
^XMB(3.9,146018,2,958,0)=" ;**1024"
^XMB(3.9,146018,2,959,0)="""RTN"",""DPTLK7"",356,0)"
^XMB(3.9,146018,2,960,0)=" S DGNEWP=$P(Y,U,3) ; TO ENSURE WE HAVE 3RD PIECE OF Y WHEN WE COME OUT OF ADD OF NEW PATIENT"
^XMB(3.9,146018,2,961,0)="""RTN"",""DPTLK7"",357,0)"
^XMB(3.9,146018,2,962,0)=" ;"
^XMB(3.9,146018,2,963,0)="""RTN"",""DPTLK7"",358,0)"
^XMB(3.9,146018,2,964,0)=" ; alias"
^XMB(3.9,146018,2,965,0)="""RTN"",""DPTLK7"",359,0)"
^XMB(3.9,146018,2,966,0)=" S X=0 F  S X=$O(DGF(""ALIAS"",X)) Q:'X  D"
^XMB(3.9,146018,2,967,0)="""RTN"",""DPTLK7"",360,0)"
^XMB(3.9,146018,2,968,0)=" . S DGF=0 F  S DGF=$O(DGF(""ALIAS"",X,DGF)) Q:'DGF  D"
^XMB(3.9,146018,2,969,0)="""RTN"",""DPTLK7"",361,0)"
^XMB(3.9,146018,2,970,0)=" .. S FDA(2.01,""+""_X_"",""_SAVY_"","",.01)=DGF(""ALIAS"",X,.01)"
^XMB(3.9,146018,2,971,0)="""RTN"",""DPTLK7"",362,0)"
^XMB(3.9,146018,2,972,0)=" .. S:DGF(""ALIAS"",X,1)]"""" FDA(2.01,""+""_X_"",""_SAVY_"","",1)=DGF(""ALIAS"",X,1)"
^XMB(3.9,146018,2,973,0)="""RTN"",""DPTLK7"",363,0)"
^XMB(3.9,146018,2,974,0)=" ;"
^XMB(3.9,146018,2,975,0)="""RTN"",""DPTLK7"",364,0)"
^XMB(3.9,146018,2,976,0)=" I $D(FDA) D"
^XMB(3.9,146018,2,977,0)="""RTN"",""DPTLK7"",365,0)"
^XMB(3.9,146018,2,978,0)=" . N DG20NAME"
^XMB(3.9,146018,2,979,0)="""RTN"",""DPTLK7"",366,0)"
^XMB(3.9,146018,2,980,0)=" . D UPDATE^DIE("""",""FDA"")"
^XMB(3.9,146018,2,981,0)="""RTN"",""DPTLK7"",367,0)"
^XMB(3.9,146018,2,982,0)=" ;"
^XMB(3.9,146018,2,983,0)="""RTN"",""DPTLK7"",368,0)"
^XMB(3.9,146018,2,984,0)=" ; send bulletin new patient added to system"
^XMB(3.9,146018,2,985,0)="""RTN"",""DPTLK7"",369,0)"
^XMB(3.9,146018,2,986,0)=" I SAVY>0 D BULL(SAVY)"
^XMB(3.9,146018,2,987,0)="""RTN"",""DPTLK7"",370,0)"
^XMB(3.9,146018,2,988,0)=" ;"
^XMB(3.9,146018,2,989,0)="""RTN"",""DPTLK7"",371,0)"
^XMB(3.9,146018,2,990,0)=" Q SAVY"
^XMB(3.9,146018,2,991,0)="""RTN"",""DPTLK7"",372,0)"
^XMB(3.9,146018,2,992,0)=" ;"
^XMB(3.9,146018,2,993,0)="""RTN"",""DPTLK7"",373,0)"
^XMB(3.9,146018,2,994,0)="ADDREQ(DGFLDS) ; - determine if enough address data entered"
^XMB(3.9,146018,2,995,0)="""RTN"",""DPTLK7"",374,0)"
^XMB(3.9,146018,2,996,0)=" ; returns OK to proceed (1) or not (0)"
^XMB(3.9,146018,2,997,0)="""RTN"",""DPTLK7"",375,0)"
^XMB(3.9,146018,2,998,0)=" N DGOK,FIELD"
^XMB(3.9,146018,2,999,0)="""RTN"",""DPTLK7"",376,0)"
^XMB(3.9,146018,2,1000,0)=" S DGOK=1"
^XMB(3.9,146018,2,1001,0)="""RTN"",""DPTLK7"",377,0)"
^XMB(3.9,146018,2,1002,0)=" ; is US or foreign"
^XMB(3.9,146018,2,1003,0)="""RTN"",""DPTLK7"",378,0)"
^XMB(3.9,146018,2,1004,0)=" ;**1139 VAMPI-26417 (jfw) - Convert to new RESIDENTIAL address fields"
^XMB(3.9,146018,2,1005,0)="""RTN"",""DPTLK7"",379,0)"
^XMB(3.9,146018,2,1006,0)=" I $$FOR^DGADDUTL($P(DGFLDS(.11573),""^"")) D"
^XMB(3.9,146018,2,1007,0)="""RTN"",""DPTLK7"",380,0)"
^XMB(3.9,146018,2,1008,0)=" . F FIELD=.1151,.1154,.11571,.11572 S:$G(DGFLDS(FIELD))']"""" DGOK=0"
^XMB(3.9,146018,2,1009,0)="""RTN"",""DPTLK7"",381,0)"
^XMB(3.9,146018,2,1010,0)=" E  F FIELD=.1151,.1156,.1154,.1155 S:$G(DGFLDS(FIELD))']"""" DGOK=0"
^XMB(3.9,146018,2,1011,0)="""RTN"",""DPTLK7"",382,0)"
^XMB(3.9,146018,2,1012,0)=" I $L($G(DGFLDS(.131))) S DGOK=1"
^XMB(3.9,146018,2,1013,0)="""RTN"",""DPTLK7"",383,0)"
^XMB(3.9,146018,2,1014,0)=" Q DGOK"
^XMB(3.9,146018,2,1015,0)="""RTN"",""DPTLK7"",384,0)"
^XMB(3.9,146018,2,1016,0)=" ;"
^XMB(3.9,146018,2,1017,0)="""RTN"",""DPTLK7"",385,0)"
^XMB(3.9,146018,2,1018,0)="PSEUDO(NAM,DOB) ; - return pseudo ssn"
^XMB(3.9,146018,2,1019,0)="""RTN"",""DPTLK7"",386,0)"
^XMB(3.9,146018,2,1020,0)=" N L1,L2,L3,Z"
^XMB(3.9,146018,2,1021,0)="""RTN"",""DPTLK7"",387,0)"
^XMB(3.9,146018,2,1022,0)=" S NAM=$G(DGF(.01)),DOB=$G(DGF(.03))"
^XMB(3.9,146018,2,1023,0)="""RTN"",""DPTLK7"",388,0)"
^XMB(3.9,146018,2,1024,0)=" I DOB="""" S DOB=2000000"
^XMB(3.9,146018,2,1025,0)="""RTN"",""DPTLK7"",389,0)"
^XMB(3.9,146018,2,1026,0)=" S L1=$E($P(NAM,"" "",2),1),L3=$E(NAM,1),NAM=$P(NAM,"","",2),L2=$E(NAM,1)"
^XMB(3.9,146018,2,1027,0)="""RTN"",""DPTLK7"",390,0)"
^XMB(3.9,146018,2,1028,0)=" S Z=L1 D CON^DGRPDD1 S L1=Z,Z=L2 D CON^DGRPDD1"
^XMB(3.9,146018,2,1029,0)="""RTN"",""DPTLK7"",391,0)"
^XMB(3.9,146018,2,1030,0)=" S L2=Z,Z=L3 D CON^DGRPDD1 S L3=Z"
^XMB(3.9,146018,2,1031,0)="""RTN"",""DPTLK7"",392,0)"
^XMB(3.9,146018,2,1032,0)=" Q L2_L1_L3_$E(DOB,4,7)_$E(DOB,2,3)_""P"""
^XMB(3.9,146018,2,1033,0)="""RTN"",""DPTLK7"",393,0)"
^XMB(3.9,146018,2,1034,0)=" ;"
^XMB(3.9,146018,2,1035,0)="""RTN"",""DPTLK7"",394,0)"
^XMB(3.9,146018,2,1036,0)="BULL(SAVY) ; - send bulletin that new patient added"
^XMB(3.9,146018,2,1037,0)="""RTN"",""DPTLK7"",395,0)"
^XMB(3.9,146018,2,1038,0)=" N DGTEXT,DGNAM,DGSSN,DGDOB,DGB,DGZ"
^XMB(3.9,146018,2,1039,0)="""RTN"",""DPTLK7"",396,0)"
^XMB(3.9,146018,2,1040,0)=" S DGB=2"
^XMB(3.9,146018,2,1041,0)="""RTN"",""DPTLK7"",397,0)"
^XMB(3.9,146018,2,1042,0)=" S DGZ=$G(^DPT(SAVY,0))"
^XMB(3.9,146018,2,1043,0)="""RTN"",""DPTLK7"",398,0)"
^XMB(3.9,146018,2,1044,0)=" S DGNAM=$P(DGZ,""^""),DGSSN=$P(DGZ,""^"",9),DGDOB=$P(DGZ,""^"",3)"
^XMB(3.9,146018,2,1045,0)="""RTN"",""DPTLK7"",399,0)"
^XMB(3.9,146018,2,1046,0)=" S DGSSN=$E(DGSSN,1,3)_""-""_$E(DGSSN,4,5)_""-""_$E(DGSSN,6,10)"
^XMB(3.9,146018,2,1047,0)="""RTN"",""DPTLK7"",400,0)"
^XMB(3.9,146018,2,1048,0)=" S DGDOB=$$FMTE^XLFDT(DGDOB)"
^XMB(3.9,146018,2,1049,0)="""RTN"",""DPTLK7"",401,0)"
^XMB(3.9,146018,2,1050,0)=" S XMSUB=""NEW PATIENT ADDED TO SYSTEM"""
^XMB(3.9,146018,2,1051,0)="""RTN"",""DPTLK7"",402,0)"
^XMB(3.9,146018,2,1052,0)=" S DGTEXT(1,0)=""NAME:  ""_DGNAM"
^XMB(3.9,146018,2,1053,0)="""RTN"",""DPTLK7"",403,0)"
^XMB(3.9,146018,2,1054,0)=" S DGTEXT(2,0)=""SSN :  ""_DGSSN"
^XMB(3.9,146018,2,1055,0)="""RTN"",""DPTLK7"",404,0)"
^XMB(3.9,146018,2,1056,0)=" S DGTEXT(3,0)=""DOB :  ""_DGDOB"
^XMB(3.9,146018,2,1057,0)="""RTN"",""DPTLK7"",405,0)"
^XMB(3.9,146018,2,1058,0)=" D ^DGBUL"
^XMB(3.9,146018,2,1059,0)="""RTN"",""DPTLK7"",406,0)"
^XMB(3.9,146018,2,1060,0)=" Q"
^XMB(3.9,146018,2,1061,0)="""RTN"",""DPTLK7A"")"
^XMB(3.9,146018,2,1062,0)="0^3^B27254042"
^XMB(3.9,146018,2,1063,0)="""RTN"",""DPTLK7A"",1,0)"
^XMB(3.9,146018,2,1064,0)="DPTLK7A ;OAK/MKO-MAS PATIENT LOOKUP ENTERPRISE SEARCH (cont) ;13 May 2020  1:13 PM"
^XMB(3.9,146018,2,1065,0)="""RTN"",""DPTLK7A"",2,0)"
^XMB(3.9,146018,2,1066,0)=" ;;5.3;Registration;**1024,1139**;Aug 13, 1993;Build 0"
^XMB(3.9,146018,2,1067,0)="""RTN"",""DPTLK7A"",3,0)"
^XMB(3.9,146018,2,1068,0)=" ;**1024,Story 1258907 (mko): Routine created with subroutines ADDTF and CHKSRCID"
^XMB(3.9,146018,2,1069,0)="""RTN"",""DPTLK7A"",4,0)"
^XMB(3.9,146018,2,1070,0)=" Q"
^XMB(3.9,146018,2,1071,0)="""RTN"",""DPTLK7A"",5,0)"
^XMB(3.9,146018,2,1072,0)=" ;"
^XMB(3.9,146018,2,1073,0)="""RTN"",""DPTLK7A"",6,0)"
^XMB(3.9,146018,2,1074,0)="ADDTF(DFN,IDS) ;Add the Treating Facility returned from the Enterprise Search"
^XMB(3.9,146018,2,1075,0)="""RTN"",""DPTLK7A"",7,0)"
^XMB(3.9,146018,2,1076,0)=" ;In: DFN = DFN of patient"
^XMB(3.9,146018,2,1077,0)="""RTN"",""DPTLK7A"",8,0)"
^XMB(3.9,146018,2,1078,0)=" ;    IDS(seq#,""ID"")=Source ID"
^XMB(3.9,146018,2,1079,0)="""RTN"",""DPTLK7A"",9,0)"
^XMB(3.9,146018,2,1080,0)=" ;    IDS(seq#,""IDTYPE"")=Source ID Type (e.g., ""PI"")"
