^XMB(3.9,146011,2,478,0)=" K PSOPLCK D PSOL^PSSLOCK(DA) I '$G(PSOMSG) S VALMSG=$S($P($G(PSOMSG),""^"",2)'="""":$P($G(PSOMSG),""^"",2),1:""Another person is editing this order.""),VALMBCK="""" K PSOMSG D ULP Q"
