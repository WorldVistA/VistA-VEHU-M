^XMB(3.9,146106,2,2886,0)=" ; Appointment already exists for patient at this date and time"
^XMB(3.9,146106,2,2887,0)="""RTN"",""SDES2CREATEAPPT2"",267,0)"
^XMB(3.9,146106,2,2888,0)=" I '$G(BLOCKANDMOVE) D"
