^XMB(3.9,146018,2,1634,0)=" I $G(PARAM(""ResAddPCode""))'="""" S VAL=$G(PARAM(""ResAddPCode"")) D CHK^DIE(2,.1172,,VAL,.RESULT) I RESULT=""^"" S PARAM(""ResAddPCode"")="""""
^XMB(3.9,146018,2,1635,0)="""RTN"",""VAFCPTAD"",160,0)"
^XMB(3.9,146018,2,1636,0)=" I $G(PARAM(""ResAddPCode""))'="""" S VAFCPC=VAL,FLG=1"
^XMB(3.9,146018,2,1637,0)="""RTN"",""VAFCPTAD"",161,0)"
^XMB(3.9,146018,2,1638,0)=" ;**1050,VAMPI-9503 (mko): Remove initial I $G(PARAM(""ResAddProvince""))'="""" test -- don't require a valid Province be sent for Country to be checked"
^XMB(3.9,146018,2,1639,0)="""RTN"",""VAFCPTAD"",162,0)"
^XMB(3.9,146018,2,1640,0)=" I $G(PARAM(""ResAddCountry""))'="""" D"
^XMB(3.9,146018,2,1641,0)="""RTN"",""VAFCPTAD"",163,0)"
^XMB(3.9,146018,2,1642,0)=" .;convert Country Abbreviation into Country DESCRIPTION"
^XMB(3.9,146018,2,1643,0)="""RTN"",""VAFCPTAD"",164,0)"
^XMB(3.9,146018,2,1644,0)=" .S CNTY=$O(^HL(779.004,""B"",$G(PARAM(""ResAddCountry"")),""""))"
^XMB(3.9,146018,2,1645,0)="""RTN"",""VAFCPTAD"",165,0)"
^XMB(3.9,146018,2,1646,0)=" .I CNTY="""" S PARAM(""ResAddCountry"")="""""
^XMB(3.9,146018,2,1647,0)="""RTN"",""VAFCPTAD"",166,0)"
^XMB(3.9,146018,2,1648,0)=" .I CNTY'="""" S VAL=PARAM(""ResAddCountry"") D CHK^DIE(2,.1173,,VAL,.RESULT) I RESULT=""^"" S PARAM(""ResAddCountry"")="""""
^XMB(3.9,146018,2,1649,0)="""RTN"",""VAFCPTAD"",167,0)"
^XMB(3.9,146018,2,1650,0)=" I $G(PARAM(""ResAddCountry""))'="""" S VAFCPCT=PARAM(""ResAddCountry""),FLG=1"
^XMB(3.9,146018,2,1651,0)="""RTN"",""VAFCPTAD"",168,0)"
^XMB(3.9,146018,2,1652,0)=" ;"
^XMB(3.9,146018,2,1653,0)="""RTN"",""VAFCPTAD"",169,0)"
^XMB(3.9,146018,2,1654,0)=" I FLG=0 S RETURN(1)=""-1^Required information is missing; please check input and try again."" G END"
^XMB(3.9,146018,2,1655,0)="""RTN"",""VAFCPTAD"",170,0)"
^XMB(3.9,146018,2,1656,0)=" ;Else ok to file entry"
^XMB(3.9,146018,2,1657,0)="""RTN"",""VAFCPTAD"",171,0)"
^XMB(3.9,146018,2,1658,0)="FILE ;Call FILE^DICN to add new entry to PATIENT (#2) file"
^XMB(3.9,146018,2,1659,0)="""RTN"",""VAFCPTAD"",172,0)"
^XMB(3.9,146018,2,1660,0)=" N DA,DIC,DR,FULLICN K DD,DO,VAFCRSLT"
^XMB(3.9,146018,2,1661,0)="""RTN"",""VAFCPTAD"",173,0)"
^XMB(3.9,146018,2,1662,0)=" S DIC=""^DPT("",DIC(0)=""FLZ"",DLAYGO=2,X=VAFCNAM"
^XMB(3.9,146018,2,1663,0)="""RTN"",""VAFCPTAD"",174,0)"
^XMB(3.9,146018,2,1664,0)=" ;**876 MVI_2788 (ckn) - Remove four slash use for field 1901"
^XMB(3.9,146018,2,1665,0)="""RTN"",""VAFCPTAD"",175,0)"
^XMB(3.9,146018,2,1666,0)=" ;**944 Story #557843 (cml) add code to update FULL ICN (#991.1), WHO ENTERED PATIENT (#.096), and DATE ENTERED INTO FILE (#.097) fields"
^XMB(3.9,146018,2,1667,0)="""RTN"",""VAFCPTAD"",176,0)"
^XMB(3.9,146018,2,1668,0)=" S FULLICN=VAFCICN_""V""_VAFCSUM"
^XMB(3.9,146018,2,1669,0)="""RTN"",""VAFCPTAD"",177,0)"
^XMB(3.9,146018,2,1670,0)=" S DIC(""DR"")="".09///""_VAFCSSN_"";.03///""_VAFCDOB_"";.02///""_VAFCSX_"";391///""_VAFCTYP_"";1901///""_VAFCVET_"";.301///""_VAFCSRV_"";991.01///""_VAFCICN_"";991.02///""_VAFCSUM_"";991.1///""_FULLICN"
^XMB(3.9,146018,2,1671,0)="""RTN"",""VAFCPTAD"",178,0)"
^XMB(3.9,146018,2,1672,0)=" I VAFCSSN=""P"" S DIC(""DR"")=DIC(""DR"")_"";.0906///""_VAFCRSN"
^XMB(3.9,146018,2,1673,0)="""RTN"",""VAFCPTAD"",179,0)"
^XMB(3.9,146018,2,1674,0)=" ;"
^XMB(3.9,146018,2,1675,0)="""RTN"",""VAFCPTAD"",180,0)"
^XMB(3.9,146018,2,1676,0)=" ;**1050,VAMPI-9503 (mko): Separate single FILE^DICN call into one FILE^DICN call to add the record with required fields"
^XMB(3.9,146018,2,1677,0)="""RTN"",""VAFCPTAD"",181,0)"
^XMB(3.9,146018,2,1678,0)=" ;  and a subsequent FILE^DIE call to update the optional fields"
^XMB(3.9,146018,2,1679,0)="""RTN"",""VAFCPTAD"",182,0)"
^XMB(3.9,146018,2,1680,0)=" L +^DPT(0):10"
^XMB(3.9,146018,2,1681,0)="""RTN"",""VAFCPTAD"",183,0)"
^XMB(3.9,146018,2,1682,0)=" D FILE^DICN K DA,DIC,DD,DLAYGO,DO,DR"
^XMB(3.9,146018,2,1683,0)="""RTN"",""VAFCPTAD"",184,0)"
^XMB(3.9,146018,2,1684,0)=" L -^DPT(0)"
^XMB(3.9,146018,2,1685,0)="""RTN"",""VAFCPTAD"",185,0)"
^XMB(3.9,146018,2,1686,0)=" ;If record creation/update fails, return a -1^error text"
^XMB(3.9,146018,2,1687,0)="""RTN"",""VAFCPTAD"",186,0)"
^XMB(3.9,146018,2,1688,0)=" I $P(Y,U,3)'=1 S RETURN(1)=""-1^""_""Attempt to add patient ""_VAFCNAM_"" to the PATIENT (#2) file at station number ""_$P($$SITE^VASITE,""^"",3)_"" failed."" G END"
^XMB(3.9,146018,2,1689,0)="""RTN"",""VAFCPTAD"",187,0)"
^XMB(3.9,146018,2,1690,0)=" S VAFCDFN=+Y"
^XMB(3.9,146018,2,1691,0)="""RTN"",""VAFCPTAD"",188,0)"
^XMB(3.9,146018,2,1692,0)=" ;"
^XMB(3.9,146018,2,1693,0)="""RTN"",""VAFCPTAD"",189,0)"
^XMB(3.9,146018,2,1694,0)=" ;**1050,VAMPI-9503 (mko): After record is created, call FILE^DIE to update the record"
^XMB(3.9,146018,2,1695,0)="""RTN"",""VAFCPTAD"",190,0)"
^XMB(3.9,146018,2,1696,0)=" D"
^XMB(3.9,146018,2,1697,0)="""RTN"",""VAFCPTAD"",191,0)"
^XMB(3.9,146018,2,1698,0)=" .N DIERR,DIMSG,DIHELP,FDA,IENS,MSG"
^XMB(3.9,146018,2,1699,0)="""RTN"",""VAFCPTAD"",192,0)"
^XMB(3.9,146018,2,1700,0)=" .S IENS=VAFCDFN_"","""
^XMB(3.9,146018,2,1701,0)="""RTN"",""VAFCPTAD"",193,0)"
^XMB(3.9,146018,2,1702,0)=" .S:$G(VAFCPOBC)]"""" FDA(2,IENS,.092)=VAFCPOBC ;POB CITY"
^XMB(3.9,146018,2,1703,0)="""RTN"",""VAFCPTAD"",194,0)"
^XMB(3.9,146018,2,1704,0)=" .S:$G(VAFCPOBS)]"""" FDA(2,IENS,.093)=VAFCPOBS ;POB STATE"
^XMB(3.9,146018,2,1705,0)="""RTN"",""VAFCPTAD"",195,0)"
^XMB(3.9,146018,2,1706,0)=" .S:$G(VAFCMMN)]"""" FDA(2,IENS,.2403)=VAFCMMN ;MMN"
^XMB(3.9,146018,2,1707,0)="""RTN"",""VAFCPTAD"",196,0)"
^XMB(3.9,146018,2,1708,0)=" .;**876 - MVI_2788 (ckn)"
^XMB(3.9,146018,2,1709,0)="""RTN"",""VAFCPTAD"",197,0)"
^XMB(3.9,146018,2,1710,0)=" .S:$G(VAFCMBI)]"""" FDA(2,IENS,994)=VAFCMBI ;MBI"
^XMB(3.9,146018,2,1711,0)="""RTN"",""VAFCPTAD"",198,0)"
^XMB(3.9,146018,2,1712,0)=" .;**1033 ADDING ADDRESS FIELDS"
^XMB(3.9,146018,2,1713,0)="""RTN"",""VAFCPTAD"",199,0)"
^XMB(3.9,146018,2,1714,0)=" .S:$G(VAFCAL1)]"""" FDA(2,IENS,.111)=VAFCAL1 ;STREET LINE 1"
^XMB(3.9,146018,2,1715,0)="""RTN"",""VAFCPTAD"",200,0)"
^XMB(3.9,146018,2,1716,0)=" .S:$G(VAFCAL2)]"""" FDA(2,IENS,.112)=VAFCAL2 ;STREET LINE 2"
^XMB(3.9,146018,2,1717,0)="""RTN"",""VAFCPTAD"",201,0)"
^XMB(3.9,146018,2,1718,0)=" .S:$G(VAFCAL3)]"""" FDA(2,IENS,.113)=VAFCAL3 ;STREET LINE 3"
^XMB(3.9,146018,2,1719,0)="""RTN"",""VAFCPTAD"",202,0)"
^XMB(3.9,146018,2,1720,0)=" .S:$G(VAFCACY)]"""" FDA(2,IENS,.114)=VAFCACY ;CITY"
^XMB(3.9,146018,2,1721,0)="""RTN"",""VAFCPTAD"",203,0)"
^XMB(3.9,146018,2,1722,0)=" .S:$G(VAFCAST)]"""" FDA(2,IENS,.115)=VAFCAST ;STATE"
^XMB(3.9,146018,2,1723,0)="""RTN"",""VAFCPTAD"",204,0)"
^XMB(3.9,146018,2,1724,0)=" .S:$G(VAFCAZ)]"""" FDA(2,IENS,.1112)=VAFCAZ ;ZIP"
^XMB(3.9,146018,2,1725,0)="""RTN"",""VAFCPTAD"",205,0)"
^XMB(3.9,146018,2,1726,0)=" .S:$G(VAFCPN)]"""" FDA(2,IENS,.131)=VAFCPN ;PHONE NUMBER"
^XMB(3.9,146018,2,1727,0)="""RTN"",""VAFCPTAD"",206,0)"
^XMB(3.9,146018,2,1728,0)=" .S:$G(VAFCPR)]"""" FDA(2,IENS,.1171)=VAFCPR ;PROVINCE"
^XMB(3.9,146018,2,1729,0)="""RTN"",""VAFCPTAD"",207,0)"
^XMB(3.9,146018,2,1730,0)=" .S:$G(VAFCPC)]"""" FDA(2,IENS,.1172)=VAFCPC ;POSTAL CODE"
^XMB(3.9,146018,2,1731,0)="""RTN"",""VAFCPTAD"",208,0)"
^XMB(3.9,146018,2,1732,0)=" .S:$G(VAFCPCT)]"""" FDA(2,IENS,.1173)=VAFCPCT ;COUNTRY"
^XMB(3.9,146018,2,1733,0)="""RTN"",""VAFCPTAD"",209,0)"
^XMB(3.9,146018,2,1734,0)=" .Q:'$D(FDA)"
^XMB(3.9,146018,2,1735,0)="""RTN"",""VAFCPTAD"",210,0)"
^XMB(3.9,146018,2,1736,0)=" .L +^DPT(VAFCDFN):10 E  Q"
^XMB(3.9,146018,2,1737,0)="""RTN"",""VAFCPTAD"",211,0)"
^XMB(3.9,146018,2,1738,0)=" .D FILE^DIE(""E"",""FDA"",""MSG"") L -^DPT(VAFCDFN)"
^XMB(3.9,146018,2,1739,0)="""RTN"",""VAFCPTAD"",212,0)"
^XMB(3.9,146018,2,1740,0)=" ;"
^XMB(3.9,146018,2,1741,0)="""RTN"",""VAFCPTAD"",213,0)"
^XMB(3.9,146018,2,1742,0)=" ;**1042,VAMPI-8199 (mko): File County (determined from Zip); Need to use 4-slash stuff because IT is interative"
^XMB(3.9,146018,2,1743,0)="""RTN"",""VAFCPTAD"",214,0)"
^XMB(3.9,146018,2,1744,0)=" ;  when county name matches more than one entry (e.g., BALTIMORE and BALTIMORE (CITY)"
^XMB(3.9,146018,2,1745,0)="""RTN"",""VAFCPTAD"",215,0)"
^XMB(3.9,146018,2,1746,0)=" ;**1050,VAMPI-9503 (mko): Use FILE^DIE to file county instead of FILE^DICN"
^XMB(3.9,146018,2,1747,0)="""RTN"",""VAFCPTAD"",216,0)"
^XMB(3.9,146018,2,1748,0)=" D:$G(VAFCACTY)]"""""
^XMB(3.9,146018,2,1749,0)="""RTN"",""VAFCPTAD"",217,0)"
^XMB(3.9,146018,2,1750,0)=" .N DIERR,DIMSG,DIHELP,FDA,MSG"
^XMB(3.9,146018,2,1751,0)="""RTN"",""VAFCPTAD"",218,0)"
^XMB(3.9,146018,2,1752,0)=" .S FDA(2,VAFCDFN_"","",.117)=VAFCACTY ;COUNTY"
^XMB(3.9,146018,2,1753,0)="""RTN"",""VAFCPTAD"",219,0)"
^XMB(3.9,146018,2,1754,0)=" .L +^DPT(VAFCDFN):10 E  Q"
^XMB(3.9,146018,2,1755,0)="""RTN"",""VAFCPTAD"",220,0)"
^XMB(3.9,146018,2,1756,0)=" .D FILE^DIE("""",""FDA"",""MSG"") L -^DPT(VAFCDFN)"
^XMB(3.9,146018,2,1757,0)="""RTN"",""VAFCPTAD"",221,0)"
^XMB(3.9,146018,2,1758,0)=" ;"
^XMB(3.9,146018,2,1759,0)="""RTN"",""VAFCPTAD"",222,0)"
^XMB(3.9,146018,2,1760,0)=" ;**1050,VAMPI-9503 (mko): If NC flag is set, file the name components"
^XMB(3.9,146018,2,1761,0)="""RTN"",""VAFCPTAD"",223,0)"
^XMB(3.9,146018,2,1762,0)=" K UPDNC I $$GETFLAG^VAFCPTED S UPDNC=$$UPDNC(VAFCDFN,$G(PARAM(""LONGNAME""),$G(PARAM(""NAME""))))"
^XMB(3.9,146018,2,1763,0)="""RTN"",""VAFCPTAD"",224,0)"
^XMB(3.9,146018,2,1764,0)=" ;"
^XMB(3.9,146018,2,1765,0)="""RTN"",""VAFCPTAD"",225,0)"
^XMB(3.9,146018,2,1766,0)=" ;**1033 VAMPI-12 (jfw) - Interfacility Consult (IFC) support"
^XMB(3.9,146018,2,1767,0)="""RTN"",""VAFCPTAD"",226,0)"
^XMB(3.9,146018,2,1768,0)=" ;      Trigger enrollment/eligibility HL7 messaging to further update patient info"
^XMB(3.9,146018,2,1769,0)="""RTN"",""VAFCPTAD"",227,0)"
^XMB(3.9,146018,2,1770,0)=" S:($G(PARAM(""ENROLLMENT""))=1) VAFCRSLT=$$QRY^DGENQRY(VAFCDFN)"
^XMB(3.9,146018,2,1771,0)="""RTN"",""VAFCPTAD"",228,0)"
^XMB(3.9,146018,2,1772,0)=" ; file Who and When if not already done"
^XMB(3.9,146018,2,1773,0)="""RTN"",""VAFCPTAD"",229,0)"
^XMB(3.9,146018,2,1774,0)=" N DGZ,FDA"
^XMB(3.9,146018,2,1775,0)="""RTN"",""VAFCPTAD"",230,0)"
^XMB(3.9,146018,2,1776,0)=" S DGZ=$G(^DPT(VAFCDFN,0))"
^XMB(3.9,146018,2,1777,0)="""RTN"",""VAFCPTAD"",231,0)"
^XMB(3.9,146018,2,1778,0)=" S:'$P(DGZ,""^"",15) FDA(2,VAFCDFN_"","",.096)=DUZ"
^XMB(3.9,146018,2,1779,0)="""RTN"",""VAFCPTAD"",232,0)"
^XMB(3.9,146018,2,1780,0)=" S:'$P(DGZ,""^"",16) FDA(2,VAFCDFN_"","",.097)=DT"
^XMB(3.9,146018,2,1781,0)="""RTN"",""VAFCPTAD"",233,0)"
^XMB(3.9,146018,2,1782,0)=" D:$D(FDA) FILE^DIE("""",""FDA"")"
^XMB(3.9,146018,2,1783,0)="""RTN"",""VAFCPTAD"",234,0)"
^XMB(3.9,146018,2,1784,0)=" ;"
^XMB(3.9,146018,2,1785,0)="""RTN"",""VAFCPTAD"",235,0)"
^XMB(3.9,146018,2,1786,0)=" ;File ALIAS multiple"
^XMB(3.9,146018,2,1787,0)="""RTN"",""VAFCPTAD"",236,0)"
^XMB(3.9,146018,2,1788,0)=" I $D(PARAM(""ALIAS"")) D ALIAS  ;If ALIAS data is passed, call ALIAS module"
^XMB(3.9,146018,2,1789,0)="""RTN"",""VAFCPTAD"",237,0)"
^XMB(3.9,146018,2,1790,0)=" I $G(ALSERR)="""" S RETURN(1)=""1^""_VAFCDFN  ;No errors for ALIAS, return DFN"
^XMB(3.9,146018,2,1791,0)="""RTN"",""VAFCPTAD"",238,0)"
^XMB(3.9,146018,2,1792,0)=" I $G(ALSERR)'="""" S RETURN(1)=ALSERR"
^XMB(3.9,146018,2,1793,0)="""RTN"",""VAFCPTAD"",239,0)"
^XMB(3.9,146018,2,1794,0)=" ;"
^XMB(3.9,146018,2,1795,0)="""RTN"",""VAFCPTAD"",240,0)"
^XMB(3.9,146018,2,1796,0)=" ;**1050,VAMPI-9503 (mko): If the components of the name were filed, return 4th piece equal to 1"
^XMB(3.9,146018,2,1797,0)="""RTN"",""VAFCPTAD"",241,0)"
^XMB(3.9,146018,2,1798,0)=" S:$G(UPDNC) $P(RETURN(1),U,4)=1"
^XMB(3.9,146018,2,1799,0)="""RTN"",""VAFCPTAD"",242,0)"
^XMB(3.9,146018,2,1800,0)=" ;"
^XMB(3.9,146018,2,1801,0)="""RTN"",""VAFCPTAD"",243,0)"
^XMB(3.9,146018,2,1802,0)="END ;**1050,VAMPI-9503 (mko): Record return value and quit"
^XMB(3.9,146018,2,1803,0)="""RTN"",""VAFCPTAD"",244,0)"
^XMB(3.9,146018,2,1804,0)=" D RETURN(VAFCSEQ,.RETURN)"
^XMB(3.9,146018,2,1805,0)="""RTN"",""VAFCPTAD"",245,0)"
^XMB(3.9,146018,2,1806,0)=" Q"
^XMB(3.9,146018,2,1807,0)="""RTN"",""VAFCPTAD"",246,0)"
^XMB(3.9,146018,2,1808,0)=" ;"
^XMB(3.9,146018,2,1809,0)="""RTN"",""VAFCPTAD"",247,0)"
^XMB(3.9,146018,2,1810,0)="ALIAS ;Optional - Add ALIAS and ALIAS SSN data for entry"
^XMB(3.9,146018,2,1811,0)="""RTN"",""VAFCPTAD"",248,0)"
^XMB(3.9,146018,2,1812,0)=" ;Only occurs for a NEW record; there is no previous ALIAS data"
^XMB(3.9,146018,2,1813,0)="""RTN"",""VAFCPTAD"",249,0)"
^XMB(3.9,146018,2,1814,0)=" I '$D(PARAM(""ALIAS"")) Q"
^XMB(3.9,146018,2,1815,0)="""RTN"",""VAFCPTAD"",250,0)"
^XMB(3.9,146018,2,1816,0)=" ;ALIAS input comes in as: LAST^FIRST^MIDDLE^SUFFIX^SSN"
^XMB(3.9,146018,2,1817,0)="""RTN"",""VAFCPTAD"",251,0)"
^XMB(3.9,146018,2,1818,0)=" N AFN,ALN,AMN,ASFX,ASSN,ERR,FDA,I,LOC,NUM"
^XMB(3.9,146018,2,1819,0)="""RTN"",""VAFCPTAD"",252,0)"
^XMB(3.9,146018,2,1820,0)=" S (I,NUM)=0 F  S NUM=$O(PARAM(""ALIAS"",NUM)) Q:'NUM  D"
^XMB(3.9,146018,2,1821,0)="""RTN"",""VAFCPTAD"",253,0)"
^XMB(3.9,146018,2,1822,0)=" .S ALN=$P($G(PARAM(""ALIAS"",NUM)),""^"") Q:ALN=""""  ;Last name minimal input"
^XMB(3.9,146018,2,1823,0)="""RTN"",""VAFCPTAD"",254,0)"
^XMB(3.9,146018,2,1824,0)=" .S AFN=$P($G(PARAM(""ALIAS"",NUM)),""^"",2),AMN=$P($G(PARAM(""ALIAS"",NUM)),""^"",3)"
^XMB(3.9,146018,2,1825,0)="""RTN"",""VAFCPTAD"",255,0)"
^XMB(3.9,146018,2,1826,0)=" .S ASFX=$P($G(PARAM(""ALIAS"",NUM)),""^"",4),ASSN=$P($G(PARAM(""ALIAS"",NUM)),""^"",5)"
^XMB(3.9,146018,2,1827,0)="""RTN"",""VAFCPTAD"",256,0)"
^XMB(3.9,146018,2,1828,0)=" .;Change format for VistA input: LAST,FIRST MIDDLE SUFFIX^SSN"
^XMB(3.9,146018,2,1829,0)="""RTN"",""VAFCPTAD"",257,0)"
^XMB(3.9,146018,2,1830,0)=" .S LOC(NUM)=ALN_"","""
^XMB(3.9,146018,2,1831,0)="""RTN"",""VAFCPTAD"",258,0)"
^XMB(3.9,146018,2,1832,0)=" .I AFN'="""" S LOC(NUM)=LOC(NUM)_AFN"
^XMB(3.9,146018,2,1833,0)="""RTN"",""VAFCPTAD"",259,0)"
^XMB(3.9,146018,2,1834,0)=" .I AMN'="""" S LOC(NUM)=LOC(NUM)_"" ""_AMN"
^XMB(3.9,146018,2,1835,0)="""RTN"",""VAFCPTAD"",260,0)"
^XMB(3.9,146018,2,1836,0)=" .I ASFX'="""" S LOC(NUM)=LOC(NUM)_"" ""_ASFX"
^XMB(3.9,146018,2,1837,0)="""RTN"",""VAFCPTAD"",261,0)"
^XMB(3.9,146018,2,1838,0)=" .S LOC(NUM)=LOC(NUM)_""^"""
^XMB(3.9,146018,2,1839,0)="""RTN"",""VAFCPTAD"",262,0)"
^XMB(3.9,146018,2,1840,0)=" .I ASSN'="""" S LOC(NUM)=LOC(NUM)_ASSN"
^XMB(3.9,146018,2,1841,0)="""RTN"",""VAFCPTAD"",263,0)"
^XMB(3.9,146018,2,1842,0)=" .;Set FDA nodes"
^XMB(3.9,146018,2,1843,0)="""RTN"",""VAFCPTAD"",264,0)"
^XMB(3.9,146018,2,1844,0)=" .S I=I+1 ;Unique sequence number for add to ALIAS SUB-FILE (#2.01"
^XMB(3.9,146018,2,1845,0)="""RTN"",""VAFCPTAD"",265,0)"
^XMB(3.9,146018,2,1846,0)=" .S FDA(2.01,""+""_I_"",""_VAFCDFN_"","",.01)=$P(LOC(NUM),""^"") ; (#.01) ALIAS (name)"
^XMB(3.9,146018,2,1847,0)="""RTN"",""VAFCPTAD"",266,0)"
^XMB(3.9,146018,2,1848,0)=" .I ASSN'="""" S FDA(2.01,""+""_I_"",""_VAFCDFN_"","",1)=$P(LOC(NUM),""^"",2) ; (#1) ALIAS SSN"
^XMB(3.9,146018,2,1849,0)="""RTN"",""VAFCPTAD"",267,0)"
^XMB(3.9,146018,2,1850,0)=" ;Update ALIAS multiple with new entries"
^XMB(3.9,146018,2,1851,0)="""RTN"",""VAFCPTAD"",268,0)"
^XMB(3.9,146018,2,1852,0)=" I $D(FDA) D  ;We have ALIAS data to add"
^XMB(3.9,146018,2,1853,0)="""RTN"",""VAFCPTAD"",269,0)"
^XMB(3.9,146018,2,1854,0)=" .S ALSERR="""""
^XMB(3.9,146018,2,1855,0)="""RTN"",""VAFCPTAD"",270,0)"
^XMB(3.9,146018,2,1856,0)=" .L +^DPT(VAFCDFN):10 D UPDATE^DIE(""E"",""FDA"",,""ERR"") L -^DPT(VAFCDFN)"
^XMB(3.9,146018,2,1857,0)="""RTN"",""VAFCPTAD"",271,0)"
^XMB(3.9,146018,2,1858,0)=" .I $D(ERR(""DIERR"")) S ALSERR=""1^""_VAFCDFN_""^Patient ""_PARAM(""NAME"")_"" was successfully added at ""_$P($$SITE^VASITE,""^"",3)_"".  However, the ALIAS data failed to update. Error message: ""_$G(ERR(""DIERR"",""1"",""TEXT"",1)) Q"
^XMB(3.9,146018,2,1859,0)="""RTN"",""VAFCPTAD"",272,0)"
^XMB(3.9,146018,2,1860,0)=" Q"
