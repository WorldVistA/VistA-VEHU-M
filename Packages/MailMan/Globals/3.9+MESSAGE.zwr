^XMB(3.9,146043,2,816,0)=" Q"
^XMB(3.9,146043,2,817,0)="""RTN"",""MDCLIO1"",288,0)"
^XMB(3.9,146043,2,818,0)="GETQUAL ; Returns qualifiers of type P2(1) for term P2(0)"
^XMB(3.9,146043,2,819,0)="""RTN"",""MDCLIO1"",289,0)"
^XMB(3.9,146043,2,820,0)=" ; Set Y to the IEN of the Term"
^XMB(3.9,146043,2,821,0)="""RTN"",""MDCLIO1"",290,0)"
^XMB(3.9,146043,2,822,0)=" S X=$$FIND1^DIC(704.101,"""",""KX"",P2(0))"
^XMB(3.9,146043,2,823,0)="""RTN"",""MDCLIO1"",291,0)"
^XMB(3.9,146043,2,824,0)=" S MDROOT=$NA(^TMP(""MDCLIO"",$J)) K @MDROOT"
^XMB(3.9,146043,2,825,0)="""RTN"",""MDCLIO1"",292,0)"
^XMB(3.9,146043,2,826,0)=" S MDGBL=$NA(^MDC(704.103,""PK"",X))"
^XMB(3.9,146043,2,827,0)="""RTN"",""MDCLIO1"",293,0)"
^XMB(3.9,146043,2,828,0)=" F  S MDGBL=$Q(@MDGBL) Q:MDGBL=""""  Q:$QS(MDGBL,3)'=X  D"
^XMB(3.9,146043,2,829,0)="""RTN"",""MDCLIO1"",294,0)"
^XMB(3.9,146043,2,830,0)=" .I $P(^MDC(704.101,$QS(MDGBL,5),0),U,5)=P2(1) D"
^XMB(3.9,146043,2,831,0)="""RTN"",""MDCLIO1"",295,0)"
^XMB(3.9,146043,2,832,0)=" ..S @MDROOT@($QS(MDGBL,4),$QS(MDGBL,6))="""""
^XMB(3.9,146043,2,833,0)="""RTN"",""MDCLIO1"",296,0)"
^XMB(3.9,146043,2,834,0)=" Q"
^XMB(3.9,146043,2,835,0)="""RTN"",""MDCLIO1"",297,0)"
^XMB(3.9,146043,2,836,0)="PROCIEN(Y) ; Converts CP DEFINITION (procedure) name to IEN"
^XMB(3.9,146043,2,837,0)="""RTN"",""MDCLIO1"",298,0)"
^XMB(3.9,146043,2,838,0)=" Q $$FIND1^DIC(702.01,,""KXP"",Y)"
^XMB(3.9,146043,2,839,0)="""RTN"",""MDCLIO1"",299,0)"
^XMB(3.9,146043,2,840,0)="INSTIEN(Y) ; Converts CP INSTRUMENT name to IEN"
^XMB(3.9,146043,2,841,0)="""RTN"",""MDCLIO1"",300,0)"
^XMB(3.9,146043,2,842,0)=" Q $$FIND1^DIC(702.09,,""KXP"",Y)"
^XMB(3.9,146043,2,843,0)="""RTN"",""MDCLIO1"",301,0)"
^XMB(3.9,146043,2,844,0)="GETINST ; Gathers instruments for a procedure"
^XMB(3.9,146043,2,845,0)="""RTN"",""MDCLIO1"",302,0)"
^XMB(3.9,146043,2,846,0)=" S X=$$PROCIEN(P2(0))"
^XMB(3.9,146043,2,847,0)="""RTN"",""MDCLIO1"",303,0)"
^XMB(3.9,146043,2,848,0)=" F Y=0:0 S Y=$O(^MDS(702.01,+X,.1,""B"",Y)) Q:'Y  S @MDROOT@(Y)="""""
^XMB(3.9,146043,2,849,0)="""RTN"",""MDCLIO1"",304,0)"
^XMB(3.9,146043,2,850,0)=" Q"
^XMB(3.9,146043,2,851,0)="""RTN"",""MDCLIO1"",305,0)"
^XMB(3.9,146043,2,852,0)="ADDINST ; Adds an instrument definition to a procedure"
^XMB(3.9,146043,2,853,0)="""RTN"",""MDCLIO1"",306,0)"
^XMB(3.9,146043,2,854,0)=" ; This is a legacy multiple in file 702.01 so it has to be done in an odd way"
^XMB(3.9,146043,2,855,0)="""RTN"",""MDCLIO1"",307,0)"
^XMB(3.9,146043,2,856,0)=" N MDPROC,MDINST"
^XMB(3.9,146043,2,857,0)="""RTN"",""MDCLIO1"",308,0)"
^XMB(3.9,146043,2,858,0)=" S MDPROC=$$PROCIEN(P2(0))"
^XMB(3.9,146043,2,859,0)="""RTN"",""MDCLIO1"",309,0)"
^XMB(3.9,146043,2,860,0)=" S MDINST=$$INSTIEN(P2(1))"
^XMB(3.9,146043,2,861,0)="""RTN"",""MDCLIO1"",310,0)"
^XMB(3.9,146043,2,862,0)=" I '+MDPROC S @RESULTS@(0)=""-1^Unable to find procedure ""_P2(0)"
^XMB(3.9,146043,2,863,0)="""RTN"",""MDCLIO1"",311,0)"
^XMB(3.9,146043,2,864,0)=" I '+MDINST S @RESULTS@(0)=""-1^Unable to find instrument ""_P2(1)"
^XMB(3.9,146043,2,865,0)="""RTN"",""MDCLIO1"",312,0)"
^XMB(3.9,146043,2,866,0)=" S MDFDA(702.011,""+1,""_MDPROC_"","",.01)=MDINST"
^XMB(3.9,146043,2,867,0)="""RTN"",""MDCLIO1"",313,0)"
^XMB(3.9,146043,2,868,0)=" D UPDATE^DIE("""",""MDFDA"")"
^XMB(3.9,146043,2,869,0)="""RTN"",""MDCLIO1"",314,0)"
^XMB(3.9,146043,2,870,0)=" S @RESULTS@(0)=""1^Instrument added."""
^XMB(3.9,146043,2,871,0)="""RTN"",""MDCLIO1"",315,0)"
^XMB(3.9,146043,2,872,0)=" Q"
^XMB(3.9,146043,2,873,0)="""RTN"",""MDCLIO1"",316,0)"
^XMB(3.9,146043,2,874,0)="DELINST ; Deletes all instruments from a procedure definition"
^XMB(3.9,146043,2,875,0)="""RTN"",""MDCLIO1"",317,0)"
^XMB(3.9,146043,2,876,0)=" ; This is a legacy multiple in file 702.01 so it has to be done in an odd way"
^XMB(3.9,146043,2,877,0)="""RTN"",""MDCLIO1"",318,0)"
^XMB(3.9,146043,2,878,0)=" N MDPROC"
^XMB(3.9,146043,2,879,0)="""RTN"",""MDCLIO1"",319,0)"
^XMB(3.9,146043,2,880,0)=" S MDPROC=$$PROCIEN(P2(0))"
^XMB(3.9,146043,2,881,0)="""RTN"",""MDCLIO1"",320,0)"
^XMB(3.9,146043,2,882,0)=" F X=0:0 S X=$O(^MDS(702.01,MDPROC,.1,X)) Q:'X  S MDFDA(702.011,X_"",""_MDPROC_"","",.01)=""@"""
^XMB(3.9,146043,2,883,0)="""RTN"",""MDCLIO1"",321,0)"
^XMB(3.9,146043,2,884,0)=" D FILE^DIE("""",""MDFDA"")"
^XMB(3.9,146043,2,885,0)="""RTN"",""MDCLIO1"",322,0)"
^XMB(3.9,146043,2,886,0)=" S @RESULTS@(0)=""1^Instrument list cleared."""
^XMB(3.9,146043,2,887,0)="""RTN"",""MDCLIO1"",323,0)"
^XMB(3.9,146043,2,888,0)=" Q"
^XMB(3.9,146043,2,889,0)="""RTN"",""MDCLIO1"",324,0)"
^XMB(3.9,146043,2,890,0)="GETVER ; Get Version Information"
^XMB(3.9,146043,2,891,0)="""RTN"",""MDCLIO1"",325,0)"
^XMB(3.9,146043,2,892,0)=" D NEWDOC^MDCLIO(""RESULTS"",""VERSION INFORMATION"")"
^XMB(3.9,146043,2,893,0)="""RTN"",""MDCLIO1"",326,0)"
^XMB(3.9,146043,2,894,0)=" I $G(P2(0))="""" D GETLST^XPAR(.MDRET,""SYS"",""MD VERSION INFORMATION"",""Q"")"
^XMB(3.9,146043,2,895,0)="""RTN"",""MDCLIO1"",327,0)"
^XMB(3.9,146043,2,896,0)=" I $G(P2(0))]"""" S MDRET(1)=P2(0)_""^""_$$GET^XPAR(""SYS"",""MD VERSION INFORMATION"",P2(0),""Q"")"
^XMB(3.9,146043,2,897,0)="""RTN"",""MDCLIO1"",328,0)"
^XMB(3.9,146043,2,898,0)=" ; Switch the lines below once we are really checking versions"
^XMB(3.9,146043,2,899,0)="""RTN"",""MDCLIO1"",329,0)"
^XMB(3.9,146043,2,900,0)=" ;F MDRET=0:0 S MDRET=$O(MDRET(MDRET)) Q:'MDRET  D:$P(MDRET(MDRET),""^"",2)]"""""
^XMB(3.9,146043,2,901,0)="""RTN"",""MDCLIO1"",330,0)"
^XMB(3.9,146043,2,902,0)=" F MDRET=0:0 S MDRET=$O(MDRET(MDRET)) Q:'MDRET  D"
^XMB(3.9,146043,2,903,0)="""RTN"",""MDCLIO1"",331,0)"
^XMB(3.9,146043,2,904,0)=" .D XMLHDR^MDCLIO(""RECORD"")"
^XMB(3.9,146043,2,905,0)="""RTN"",""MDCLIO1"",332,0)"
^XMB(3.9,146043,2,906,0)=" .S MDVER=$P(MDRET(MDRET),""^"",1)"
^XMB(3.9,146043,2,907,0)="""RTN"",""MDCLIO1"",333,0)"
^XMB(3.9,146043,2,908,0)=" .D XMLDATA^MDCLIO(""VERSION"",MDVER)"
^XMB(3.9,146043,2,909,0)="""RTN"",""MDCLIO1"",334,0)"
^XMB(3.9,146043,2,910,0)=" .S MDVER=$P(MDRET(MDRET),""^"",2)"
^XMB(3.9,146043,2,911,0)="""RTN"",""MDCLIO1"",335,0)"
^XMB(3.9,146043,2,912,0)=" .; Switch the lines below once we are really checking versions"
^XMB(3.9,146043,2,913,0)="""RTN"",""MDCLIO1"",336,0)"
^XMB(3.9,146043,2,914,0)=" .;D XMLDATA^MDCLIO(""COMPATIBLE"",+MDVER)"
^XMB(3.9,146043,2,915,0)="""RTN"",""MDCLIO1"",337,0)"
^XMB(3.9,146043,2,916,0)=" .D XMLDATA^MDCLIO(""COMPATIBLE"",1)"
^XMB(3.9,146043,2,917,0)="""RTN"",""MDCLIO1"",338,0)"
^XMB(3.9,146043,2,918,0)=" .D XMLDATA^MDCLIO(""CRC32"",$P(MDVER,"";"",2))"
