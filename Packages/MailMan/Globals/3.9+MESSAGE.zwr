^XMB(3.9,146012,2,1258,0)=" Q"
^XMB(3.9,146012,2,1259,0)="""RTN"",""PSOERRX1"",38,0)"
^XMB(3.9,146012,2,1260,0)=" ;"
^XMB(3.9,146012,2,1261,0)="""RTN"",""PSOERRX1"",39,0)"
