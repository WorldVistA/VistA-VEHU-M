^XMB(3.9,146089,2,1523,0)="""RTN"",""PSOORFI6"",251,0)"
^XMB(3.9,146089,2,1524,0)=" I $G(DEAHLDG)[""S""!($G(ORSUP)=1) S RES=1"
^XMB(3.9,146089,2,1525,0)="""RTN"",""PSOORFI6"",252,0)"
^XMB(3.9,146089,2,1526,0)=" Q RES"
^XMB(3.9,146089,2,1527,0)="""RTN"",""PSOORFI6"",253,0)"
^XMB(3.9,146089,2,1528,0)=" ; replace PDEA^PSOORFI5 with updated version"
^XMB(3.9,146089,2,1529,0)="""RTN"",""PSOORFI6"",254,0)"
^XMB(3.9,146089,2,1530,0)="PDEA ;"
^XMB(3.9,146089,2,1531,0)="""RTN"",""PSOORFI6"",255,0)"
^XMB(3.9,146089,2,1532,0)=" I +$P(OR0,""^"",9) S PDEA=$P($G(^PSDRUG($P(OR0,""^"",9),0)),""^"",3),PDEA=$S(PDEA[2:1,PDEA[3!(PDEA[4)!(PDEA[5):2,1:0)"
