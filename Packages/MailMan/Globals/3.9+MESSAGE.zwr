^XMB(3.9,146021,2,824,0)=" I +$G(ADJBW)<1 D"
^XMB(3.9,146021,2,825,0)="""RTN"",""PSJLMHED"",150,0)"
^XMB(3.9,146021,2,826,0)=" .S ADJBW=ABW"
^XMB(3.9,146021,2,827,0)="""RTN"",""PSJLMHED"",151,0)"
^XMB(3.9,146021,2,828,0)=" S CRCL=(((140-ZAGE)*ADJBW)/(SCRV*72))"
^XMB(3.9,146021,2,829,0)="""RTN"",""PSJLMHED"",152,0)"
^XMB(3.9,146021,2,830,0)=" S:SEX=""M"" RSLT=SCRD_U_$J(CRCL,1,1)"
