^XMB(3.9,146089,2,1898,0)=" I $G(PSOJUMP) S MEDP=1"
^XMB(3.9,146089,2,1899,0)="""RTN"",""PSOORFIN"",167,0)"
^XMB(3.9,146089,2,1900,0)=" E  D:'$G(MEDA) PROFILE^PSOORFI2"
^XMB(3.9,146089,2,1901,0)="""RTN"",""PSOORFIN"",168,0)"
^XMB(3.9,146089,2,1902,0)=" S Y=PSOFINY"
^XMB(3.9,146089,2,1903,0)="""RTN"",""PSOORFIN"",169,0)"
^XMB(3.9,146089,2,1904,0)=" I $G(MEDP) D SPL D OERR^PSORX1 D LBL S PSOFIN=1,X=PSOPTLOK D KLLP,ULP,KLL G SPAT"
^XMB(3.9,146089,2,1905,0)="""RTN"",""PSOORFIN"",170,0)"
^XMB(3.9,146089,2,1906,0)=" D PP,SDFN,POST^PSOORFI1 D:$G(PSOQFLG)  G:$G(PSOQFLG) EX I $G(PSOQUIT) S:$G(PSOQUIT) POERR(""QFLG"")=1 S X=PAT D ULP G SPAT"
