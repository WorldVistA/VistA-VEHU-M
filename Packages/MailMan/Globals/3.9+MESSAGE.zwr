^XMB(3.9,146087,2,706,0)=" D SCALEG^YTQAPI3(.YSDATA,.YS)  ;Check if there are any scales for this instrument"
^XMB(3.9,146087,2,707,0)="""RTN"",""YTQRCDB"",34,0)"
^XMB(3.9,146087,2,708,0)=" I '$D(^TMP($J,""YSG"",2)) D  Q ""/api/mha/cdb/instrument/admin/scores/NOSCORE"""
