^XMB(3.9,146098,2,2513,0)="""RTN"",""SDLT"",140,0)"
^XMB(3.9,146098,2,2514,0)=" ; This API is checked to determine if the ""ENABLE BLANK LINE?"" (#1.1)"
^XMB(3.9,146098,2,2515,0)="""RTN"",""SDLT"",141,0)"
^XMB(3.9,146098,2,2516,0)=" ; field in the SCHEDULING PARAMETERS (404.91) file is set to ""YES"""
^XMB(3.9,146098,2,2517,0)="""RTN"",""SDLT"",142,0)"
^XMB(3.9,146098,2,2518,0)=" ; (internal value 1)."
^XMB(3.9,146098,2,2519,0)="""RTN"",""SDLT"",143,0)"
^XMB(3.9,146098,2,2520,0)=" ; Added with patch SD*5.3*705"
^XMB(3.9,146098,2,2521,0)="""RTN"",""SDLT"",144,0)"
^XMB(3.9,146098,2,2522,0)=" N DIQ,DIC,DA,DR"
^XMB(3.9,146098,2,2523,0)="""RTN"",""SDLT"",145,0)"
^XMB(3.9,146098,2,2524,0)=" S DIQ(0)=""I"",DIC=404.91,DA=1,DR=""1.1"""
^XMB(3.9,146098,2,2525,0)="""RTN"",""SDLT"",146,0)"
^XMB(3.9,146098,2,2526,0)=" Q +$$GET1^DIQ(DIC,DA_"","",DR,""I"")"
^XMB(3.9,146098,2,2527,0)="""RTN"",""SDRRISRU"")"
^XMB(3.9,146098,2,2528,0)="0^6^B23449413"
^XMB(3.9,146098,2,2529,0)="""RTN"",""SDRRISRU"",1,0)"
^XMB(3.9,146098,2,2530,0)="SDRRISRU ;ALB/MAH,BWF,JAS,JHC - Recall Reminder Utilities ;JAN 07, 2026"
^XMB(3.9,146098,2,2531,0)="""RTN"",""SDRRISRU"",2,0)"
^XMB(3.9,146098,2,2532,0)=" ;;5.3;Scheduling;**536,627,648,799,818,866,895,909**;Aug 13, 1993;Build 0"
^XMB(3.9,146098,2,2533,0)="""RTN"",""SDRRISRU"",3,0)"
^XMB(3.9,146098,2,2534,0)=" ;;Per VHA Directive 6402, this routine should not be modified"
^XMB(3.9,146098,2,2535,0)="""RTN"",""SDRRISRU"",4,0)"
^XMB(3.9,146098,2,2536,0)=" ;"
^XMB(3.9,146098,2,2537,0)="""RTN"",""SDRRISRU"",5,0)"
^XMB(3.9,146098,2,2538,0)=" ; Reference to DUZ^XUP is supported by IA #7487"
^XMB(3.9,146098,2,2539,0)="""RTN"",""SDRRISRU"",6,0)"
^XMB(3.9,146098,2,2540,0)=" ;"
^XMB(3.9,146098,2,2541,0)="""RTN"",""SDRRISRU"",7,0)"
^XMB(3.9,146098,2,2542,0)="OPENSLOT(SDRRIEN,SDRRST,SDRRND) ; Function returns the number of open (available)"
^XMB(3.9,146098,2,2543,0)="""RTN"",""SDRRISRU"",8,0)"
^XMB(3.9,146098,2,2544,0)=" ; slots at the clinic during the time period."
^XMB(3.9,146098,2,2545,0)="""RTN"",""SDRRISRU"",9,0)"
^XMB(3.9,146098,2,2546,0)=" ; SDRRIEN - IEN of clinic in file #44"
^XMB(3.9,146098,2,2547,0)="""RTN"",""SDRRISRU"",10,0)"
^XMB(3.9,146098,2,2548,0)=" ; SDRRST  - (optional) start checking on this date (default=today)"
^XMB(3.9,146098,2,2549,0)="""RTN"",""SDRRISRU"",11,0)"
^XMB(3.9,146098,2,2550,0)=" ; SDRRND  - (optional) end of time period (default=last day of month)"
^XMB(3.9,146098,2,2551,0)="""RTN"",""SDRRISRU"",12,0)"
^XMB(3.9,146098,2,2552,0)=" N SDRRNOAV,SDRRTOT,SDRRHOL,SDRRT,SDRRTPT,SDRRTPDT,SDRRDT,SDRRDA"
^XMB(3.9,146098,2,2553,0)="""RTN"",""SDRRISRU"",13,0)"
^XMB(3.9,146098,2,2554,0)=" N SDRRFTR,CK,CLIN1,DA,DFN"
^XMB(3.9,146098,2,2555,0)="""RTN"",""SDRRISRU"",14,0)"
^XMB(3.9,146098,2,2556,0)=" I '$D(SDRRST) S SDRRST=DT"
^XMB(3.9,146098,2,2557,0)="""RTN"",""SDRRISRU"",15,0)"
^XMB(3.9,146098,2,2558,0)=" I '$D(SDRRND) D  ; end of month"
^XMB(3.9,146098,2,2559,0)="""RTN"",""SDRRISRU"",16,0)"
^XMB(3.9,146098,2,2560,0)=" . S SDRRND=$E($$SCH^XLFDT(""1M(L)"",SDRRST),1,7)"
^XMB(3.9,146098,2,2561,0)="""RTN"",""SDRRISRU"",17,0)"
^XMB(3.9,146098,2,2562,0)=" . S SDRRND=$$FMADD^XLFDT(SDRRND,1)"
^XMB(3.9,146098,2,2563,0)="""RTN"",""SDRRISRU"",18,0)"
^XMB(3.9,146098,2,2564,0)=" . Q:$E(SDRRST,1,5)=$E(SDRRND,1,5)"
^XMB(3.9,146098,2,2565,0)="""RTN"",""SDRRISRU"",19,0)"
^XMB(3.9,146098,2,2566,0)=" . S SDRRND=$$FMADD^XLFDT($E(SDRRND,1,5)_""01"",-1)"
^XMB(3.9,146098,2,2567,0)="""RTN"",""SDRRISRU"",20,0)"
^XMB(3.9,146098,2,2568,0)=" S SDRRST=$$FMADD^XLFDT(SDRRST,-1)"
^XMB(3.9,146098,2,2569,0)="""RTN"",""SDRRISRU"",21,0)"
^XMB(3.9,146098,2,2570,0)=" S SDRRNOAV=0"
^XMB(3.9,146098,2,2571,0)="""RTN"",""SDRRISRU"",22,0)"
^XMB(3.9,146098,2,2572,0)=" I '$O(^SC(SDRRIEN,""OST"",SDRRST)),'$O(^SC(SDRRIEN,""ST"",SDRRST,0)) D"
^XMB(3.9,146098,2,2573,0)="""RTN"",""SDRRISRU"",23,0)"
^XMB(3.9,146098,2,2574,0)=" . N SDRRI,SDRRDOW"
^XMB(3.9,146098,2,2575,0)="""RTN"",""SDRRISRU"",24,0)"
^XMB(3.9,146098,2,2576,0)=" . F SDRRI=0:1:6 S SDRRDOW=$O(^SC(SDRRIEN,""T""_SDRRI,SDRRST)) Q:SDRRDOW  S:SDRRDOW SDRRNOAV=1"
^XMB(3.9,146098,2,2577,0)="""RTN"",""SDRRISRU"",25,0)"
^XMB(3.9,146098,2,2578,0)=" I SDRRNOAV Q 0  ; No future dates available"
^XMB(3.9,146098,2,2579,0)="""RTN"",""SDRRISRU"",26,0)"
^XMB(3.9,146098,2,2580,0)=" I '$D(SDRRYEAR) N SDRRYEAR D YEAR"
^XMB(3.9,146098,2,2581,0)="""RTN"",""SDRRISRU"",27,0)"
^XMB(3.9,146098,2,2582,0)=" S SDRRHOL=($P($G(^SC(SDRRIEN,""SL"")),U,8)=""Y"")"
^XMB(3.9,146098,2,2583,0)="""RTN"",""SDRRISRU"",28,0)"
^XMB(3.9,146098,2,2584,0)=" S SDRRTOT=0,SDRRDT=SDRRST"
^XMB(3.9,146098,2,2585,0)="""RTN"",""SDRRISRU"",29,0)"
^XMB(3.9,146098,2,2586,0)=" F  S SDRRDT=$O(SDRRYEAR(SDRRDT)) Q:SDRRDT>SDRRND!'SDRRDT  D"
^XMB(3.9,146098,2,2587,0)="""RTN"",""SDRRISRU"",30,0)"
^XMB(3.9,146098,2,2588,0)=" . I 'SDRRHOL,$P(SDRRYEAR(SDRRDT),U,2) Q"
^XMB(3.9,146098,2,2589,0)="""RTN"",""SDRRISRU"",31,0)"
^XMB(3.9,146098,2,2590,0)=" . S SDRRTPDT=$G(^SC(SDRRIEN,""ST"",SDRRDT,1)) ; Pattern"
^XMB(3.9,146098,2,2591,0)="""RTN"",""SDRRISRU"",32,0)"
^XMB(3.9,146098,2,2592,0)=" . I SDRRTPDT="""" D  Q:SDRRTPDT="""""
^XMB(3.9,146098,2,2593,0)="""RTN"",""SDRRISRU"",33,0)"
^XMB(3.9,146098,2,2594,0)=" . . S SDRRT=""T""_+SDRRYEAR(SDRRDT)"
^XMB(3.9,146098,2,2595,0)="""RTN"",""SDRRISRU"",34,0)"
^XMB(3.9,146098,2,2596,0)=" . . S SDRRTPT=$O(^SC(SDRRIEN,SDRRT,SDRRDT)) Q:SDRRTPT="""""
^XMB(3.9,146098,2,2597,0)="""RTN"",""SDRRISRU"",35,0)"
^XMB(3.9,146098,2,2598,0)=" . . S SDRRTPDT=$G(^SC(SDRRIEN,SDRRT,SDRRTPT,1))"
^XMB(3.9,146098,2,2599,0)="""RTN"",""SDRRISRU"",36,0)"
^XMB(3.9,146098,2,2600,0)=" . S SDRRTOT=SDRRTOT+$$AVAIL(SDRRTPDT)"
^XMB(3.9,146098,2,2601,0)="""RTN"",""SDRRISRU"",37,0)"
^XMB(3.9,146098,2,2602,0)=" Q SDRRTOT"
^XMB(3.9,146098,2,2603,0)="""RTN"",""SDRRISRU"",38,0)"
^XMB(3.9,146098,2,2604,0)="AVAIL(SDRRPAT) ; Given pattern, returns number of available slots."
^XMB(3.9,146098,2,2605,0)="""RTN"",""SDRRISRU"",39,0)"
^XMB(3.9,146098,2,2606,0)=" ; Check the pattern for available slots"
^XMB(3.9,146098,2,2607,0)="""RTN"",""SDRRISRU"",40,0)"
^XMB(3.9,146098,2,2608,0)=" ; 0-9 and j-z = available slots where j=10, k=11...z=26"
^XMB(3.9,146098,2,2609,0)="""RTN"",""SDRRISRU"",41,0)"
^XMB(3.9,146098,2,2610,0)=" ; $A(1)=49 $A(9)=57 $A(""j"")=106 $A(""z"")=122"
^XMB(3.9,146098,2,2611,0)="""RTN"",""SDRRISRU"",42,0)"
^XMB(3.9,146098,2,2612,0)=" N SDRRCNT,SDRRCHAR,I"
^XMB(3.9,146098,2,2613,0)="""RTN"",""SDRRISRU"",43,0)"
^XMB(3.9,146098,2,2614,0)=" S SDRRCNT=0"
^XMB(3.9,146098,2,2615,0)="""RTN"",""SDRRISRU"",44,0)"
^XMB(3.9,146098,2,2616,0)=" S SDRRPAT=$TR($E(SDRRPAT,6,$L(SDRRPAT)),""|[] "","""")"
^XMB(3.9,146098,2,2617,0)="""RTN"",""SDRRISRU"",45,0)"
^XMB(3.9,146098,2,2618,0)=" F I=1:1:$L(SDRRPAT) S SDRRCHAR=$A(SDRRPAT,I) D"
^XMB(3.9,146098,2,2619,0)="""RTN"",""SDRRISRU"",46,0)"
^XMB(3.9,146098,2,2620,0)=" . I SDRRCHAR>48,SDRRCHAR<58 S SDRRCNT=SDRRCNT+$C(SDRRCHAR) Q"
^XMB(3.9,146098,2,2621,0)="""RTN"",""SDRRISRU"",47,0)"
^XMB(3.9,146098,2,2622,0)=" . I SDRRCHAR>105,SDRRCHAR<123 S SDRRCNT=SDRRCNT+SDRRCHAR-96"
^XMB(3.9,146098,2,2623,0)="""RTN"",""SDRRISRU"",48,0)"
^XMB(3.9,146098,2,2624,0)=" Q SDRRCNT"
^XMB(3.9,146098,2,2625,0)="""RTN"",""SDRRISRU"",49,0)"
^XMB(3.9,146098,2,2626,0)="YEAR ; Set-up 1 year dates"
^XMB(3.9,146098,2,2627,0)="""RTN"",""SDRRISRU"",50,0)"
^XMB(3.9,146098,2,2628,0)=" ; This array is used for available appointments"
^XMB(3.9,146098,2,2629,0)="""RTN"",""SDRRISRU"",51,0)"
^XMB(3.9,146098,2,2630,0)=" N SDRRI,SDRRDT"
^XMB(3.9,146098,2,2631,0)="""RTN"",""SDRRISRU"",52,0)"
^XMB(3.9,146098,2,2632,0)=" S SDRRDT=SDRRST"
^XMB(3.9,146098,2,2633,0)="""RTN"",""SDRRISRU"",53,0)"
^XMB(3.9,146098,2,2634,0)=" F SDRRI=1:1:365 D  Q:SDRRDT=SDRRND"
^XMB(3.9,146098,2,2635,0)="""RTN"",""SDRRISRU"",54,0)"
^XMB(3.9,146098,2,2636,0)=" . S SDRRDT=$$FMADD^XLFDT(SDRRDT,1)"
^XMB(3.9,146098,2,2637,0)="""RTN"",""SDRRISRU"",55,0)"
^XMB(3.9,146098,2,2638,0)=" . S SDRRYEAR(SDRRDT)=$$DOW^XLFDT(SDRRDT,1)"
^XMB(3.9,146098,2,2639,0)="""RTN"",""SDRRISRU"",56,0)"
^XMB(3.9,146098,2,2640,0)=" . I $D(^HOLIDAY(SDRRDT)) S $P(SDRRYEAR(SDRRDT),U,2)=1"
^XMB(3.9,146098,2,2641,0)="""RTN"",""SDRRISRU"",57,0)"
^XMB(3.9,146098,2,2642,0)=" Q"
^XMB(3.9,146098,2,2643,0)="""RTN"",""SDRRISRU"",58,0)"
^XMB(3.9,146098,2,2644,0)="DELETE ; This entry point is invoked by the new style xref A66201 on the .01 field of file 403.5"
^XMB(3.9,146098,2,2645,0)="""RTN"",""SDRRISRU"",59,0)"
^XMB(3.9,146098,2,2646,0)=" I $D(SDRRDA),$D(APPT),$D(CLIN1) D  Q"
^XMB(3.9,146098,2,2647,0)="""RTN"",""SDRRISRU"",60,0)"
^XMB(3.9,146098,2,2648,0)=" .D DELAPPT(SDRRDA,APPT,CLIN1)"
^XMB(3.9,146098,2,2649,0)="""RTN"",""SDRRISRU"",61,0)"
^XMB(3.9,146098,2,2650,0)=" D DELUSER(DA)"
^XMB(3.9,146098,2,2651,0)="""RTN"",""SDRRISRU"",62,0)"
^XMB(3.9,146098,2,2652,0)=" Q"
^XMB(3.9,146098,2,2653,0)="""RTN"",""SDRRISRU"",63,0)"
^XMB(3.9,146098,2,2654,0)="DELAPPT(SDRRIEN,APPT,CLIN1) ; Record deleted from Recall List because of appointment."
^XMB(3.9,146098,2,2655,0)="""RTN"",""SDRRISRU"",64,0)"
^XMB(3.9,146098,2,2656,0)=" N SDRRFDA"
^XMB(3.9,146098,2,2657,0)="""RTN"",""SDRRISRU"",65,0)"
^XMB(3.9,146098,2,2658,0)=" S SDRRFDA(403.56,""+1,"",101)=APPT ; appt date"
