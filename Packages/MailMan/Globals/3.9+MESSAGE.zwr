^XMB(3.9,146091,2,403,0)="""RTN"",""MAGQBUT4"",77,0)"
^XMB(3.9,146091,2,404,0)=" K X"
^XMB(3.9,146091,2,405,0)="""RTN"",""MAGQBUT4"",78,0)"
^XMB(3.9,146091,2,406,0)=" D FIELDLST^DID(RESULTS)"
^XMB(3.9,146091,2,407,0)="""RTN"",""MAGQBUT4"",79,0)"
