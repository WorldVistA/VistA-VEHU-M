^XMB(3.9,146009,2,957,0)="""RTN"",""XUMVINPB"",140,0)"
^XMB(3.9,146009,2,958,0)=" K XURET"
^XMB(3.9,146009,2,959,0)="""RTN"",""XUMVINPB"",141,0)"
^XMB(3.9,146009,2,960,0)=" N I,CNT,FILE,FLD,FLDS,FLDNM,LINETAG,RETURN,SFILE,SFLD,XUGBL,DFLD,DFLDS,DFLDNM"
^XMB(3.9,146009,2,961,0)="""RTN"",""XUMVINPB"",142,0)"
