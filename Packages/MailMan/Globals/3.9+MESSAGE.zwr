^XMB(3.9,146037,2,2734,0)=" . . S EFTDATA=$G(^RCY(344.31,EFTIEN,0))"
^XMB(3.9,146037,2,2735,0)="""RTN"",""RCDPTAR1"",211,0)"
^XMB(3.9,146037,2,2736,0)=" . . S $P(^TMP(""RCDPTAR1"",$J,EFTIEN),""^"",1)=RCDNUM    ; Deposit #"
^XMB(3.9,146037,2,2737,0)="""RTN"",""RCDPTAR1"",212,0)"
^XMB(3.9,146037,2,2738,0)=" . . S XX=$$DATE^RCDPRU(RCDDT,""2ZD"")"
^XMB(3.9,146037,2,2739,0)="""RTN"",""RCDPTAR1"",213,0)"
^XMB(3.9,146037,2,2740,0)=" . . S $P(^TMP(""RCDPTAR1"",$J,EFTIEN),""^"",2)=XX        ; Deposit Date"
^XMB(3.9,146037,2,2741,0)="""RTN"",""RCDPTAR1"",214,0)"
^XMB(3.9,146037,2,2742,0)=" . . S XX=$$DATE^RCDPRU($P(EFTDATA,""^"",13),""2ZD"")"
^XMB(3.9,146037,2,2743,0)="""RTN"",""RCDPTAR1"",215,0)"
^XMB(3.9,146037,2,2744,0)=" . . S $P(^TMP(""RCDPTAR1"",$J,EFTIEN),""^"",3)=XX        ; Date Received"
^XMB(3.9,146037,2,2745,0)="""RTN"",""RCDPTAR1"",216,0)"
^XMB(3.9,146037,2,2746,0)=" . . S XX=$S($P(EFTDATA,U,16)=""D"":""-"",1:"""")_$P(EFTDATA,""^"",7),GTOT=GTOT+XX"
^XMB(3.9,146037,2,2747,0)="""RTN"",""RCDPTAR1"",217,0)"
^XMB(3.9,146037,2,2748,0)=" . . S $P(^TMP(""RCDPTAR1"",$J,EFTIEN),""^"",4)=XX        ; EFT Amount of Payment"
^XMB(3.9,146037,2,2749,0)="""RTN"",""RCDPTAR1"",218,0)"
^XMB(3.9,146037,2,2750,0)=" . . S XX=$P(EFTDATA,""^"",4)"
^XMB(3.9,146037,2,2751,0)="""RTN"",""RCDPTAR1"",219,0)"
^XMB(3.9,146037,2,2752,0)=" . . S $P(^TMP(""RCDPTAR1"",$J,EFTIEN),""^"",5)=XX        ; Trace #"
^XMB(3.9,146037,2,2753,0)="""RTN"",""RCDPTAR1"",220,0)"
^XMB(3.9,146037,2,2754,0)=" . . S XX=$P(EFTDATA,""^"",2)"
^XMB(3.9,146037,2,2755,0)="""RTN"",""RCDPTAR1"",221,0)"
^XMB(3.9,146037,2,2756,0)=" . . S $P(^TMP(""RCDPTAR1"",$J,EFTIEN),""^"",6)=XX        ; Payer Name"
^XMB(3.9,146037,2,2757,0)="""RTN"",""RCDPTAR1"",222,0)"
^XMB(3.9,146037,2,2758,0)=" . . S XX=$P(EFTDATA,""^"",3)"
^XMB(3.9,146037,2,2759,0)="""RTN"",""RCDPTAR1"",223,0)"
^XMB(3.9,146037,2,2760,0)=" . . S $P(^TMP(""RCDPTAR1"",$J,EFTIEN),""^"",7)=XX        ; Payer ID"
