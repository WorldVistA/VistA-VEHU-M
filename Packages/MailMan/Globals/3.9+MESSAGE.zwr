^XMB(3.9,146082,2,208,0)="^D MENU^XPDH"
^XMB(3.9,146082,2,209,0)="""QUES"",""XPO1"",""A"")"
^XMB(3.9,146082,2,210,0)="Want KIDS to Rebuild Menu Trees Upon Completion of Install"
^XMB(3.9,146082,2,211,0)="""QUES"",""XPO1"",""B"")"
^XMB(3.9,146082,2,212,0)="NO"
^XMB(3.9,146082,2,213,0)="""QUES"",""XPO1"",""M"")"
^XMB(3.9,146082,2,214,0)="D XPO1^XPDIQ"
^XMB(3.9,146082,2,215,0)="""QUES"",""XPZ1"",0)"
^XMB(3.9,146082,2,216,0)="Y"
^XMB(3.9,146082,2,217,0)="""QUES"",""XPZ1"",""??"")"
^XMB(3.9,146082,2,218,0)="^D OPT^XPDH"
^XMB(3.9,146082,2,219,0)="""QUES"",""XPZ1"",""A"")"
^XMB(3.9,146082,2,220,0)="Want to DISABLE Scheduled Options, Menu Options, and Protocols"
^XMB(3.9,146082,2,221,0)="""QUES"",""XPZ1"",""B"")"
^XMB(3.9,146082,2,222,0)="NO"
^XMB(3.9,146082,2,223,0)="""QUES"",""XPZ1"",""M"")"
