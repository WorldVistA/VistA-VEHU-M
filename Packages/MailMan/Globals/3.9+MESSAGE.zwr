^XMB(3.9,146101,2,244,0)="0^2^B63742056"
^XMB(3.9,146101,2,245,0)="""RTN"",""PSSHDPG1"",1,0)"
^XMB(3.9,146101,2,246,0)="PSSHDPG1 ;BIRM/KML -  APIs SUPPORTING REQUEST AND RETRIEVAL OF PGx DATA FROM HDR ;9/28/23"
^XMB(3.9,146101,2,247,0)="""RTN"",""PSSHDPG1"",2,0)"
^XMB(3.9,146101,2,248,0)=" ;;1.0;PHARMACY DATA MANAGEMENT;**262**;9/30/97;Build 0"
^XMB(3.9,146101,2,249,0)="""RTN"",""PSSHDPG1"",3,0)"
^XMB(3.9,146101,2,250,0)=" ;"
^XMB(3.9,146101,2,251,0)="""RTN"",""PSSHDPG1"",4,0)"
^XMB(3.9,146101,2,252,0)=" ; Reference to $$GETREST^XOBWLIB supported by DBIA# 5421"
^XMB(3.9,146101,2,253,0)="""RTN"",""PSSHDPG1"",5,0)"
^XMB(3.9,146101,2,254,0)=" ; Reference to $$GET^XOBWLIB supported by DBIA# 5421"
^XMB(3.9,146101,2,255,0)="""RTN"",""PSSHDPG1"",6,0)"
^XMB(3.9,146101,2,256,0)=" ;"
^XMB(3.9,146101,2,257,0)="""RTN"",""PSSHDPG1"",7,0)"
^XMB(3.9,146101,2,258,0)="GETPGXRESULTS(PSSDFN,PSSGENES) ; get PGx (genetic test interpretation results from HDR)"
^XMB(3.9,146101,2,259,0)="""RTN"",""PSSHDPG1"",8,0)"
^XMB(3.9,146101,2,260,0)=" ; INPUT  - PSSDFN   = IEN of PATIENT file (#2) (the DFN)"
^XMB(3.9,146101,2,261,0)="""RTN"",""PSSHDPG1"",9,0)"
^XMB(3.9,146101,2,262,0)=" ; OUTPUT - PSSGENES = local array of drug, phenotype, genotype, activity score returned from the HDR"
^XMB(3.9,146101,2,263,0)="""RTN"",""PSSHDPG1"",10,0)"
^XMB(3.9,146101,2,264,0)=" ;                   Passed in by reference"
^XMB(3.9,146101,2,265,0)="""RTN"",""PSSHDPG1"",11,0)"
^XMB(3.9,146101,2,266,0)=" ;          RETURN   = 1^SUCCESSFUL"
^XMB(3.9,146101,2,267,0)="""RTN"",""PSSHDPG1"",12,0)"
^XMB(3.9,146101,2,268,0)=" ;                    -1^_errorMessage"
^XMB(3.9,146101,2,269,0)="""RTN"",""PSSHDPG1"",13,0)"
^XMB(3.9,146101,2,270,0)=" ;                               "
^XMB(3.9,146101,2,271,0)="""RTN"",""PSSHDPG1"",14,0)"
^XMB(3.9,146101,2,272,0)=" N PSSICN,PSSREQST,PSSINPUTVALUES,PSSXMLJSON,OUTCOME,PSSERR,PSSRESTOBJ,PSSDTTM,RETURN"
^XMB(3.9,146101,2,273,0)="""RTN"",""PSSHDPG1"",15,0)"
^XMB(3.9,146101,2,274,0)=" K PSSGENES"
^XMB(3.9,146101,2,275,0)="""RTN"",""PSSHDPG1"",16,0)"
^XMB(3.9,146101,2,276,0)=" K ^TMP($J,""PSSHDPG1"")"
^XMB(3.9,146101,2,277,0)="""RTN"",""PSSHDPG1"",17,0)"
^XMB(3.9,146101,2,278,0)=" S (RETURN,OUTCOME)=0"
^XMB(3.9,146101,2,279,0)="""RTN"",""PSSHDPG1"",18,0)"
^XMB(3.9,146101,2,280,0)=" S PSSICN=$$GETICN(PSSDFN)"
^XMB(3.9,146101,2,281,0)="""RTN"",""PSSHDPG1"",19,0)"
^XMB(3.9,146101,2,282,0)=" I +PSSICN<0 S RETURN=PSSICN G GETPGXEXIT"
^XMB(3.9,146101,2,283,0)="""RTN"",""PSSHDPG1"",20,0)"
^XMB(3.9,146101,2,284,0)=" S PSSDTTM=$$BLDDATETM($$NOW^XLFDT)"
^XMB(3.9,146101,2,285,0)="""RTN"",""PSSHDPG1"",21,0)"
^XMB(3.9,146101,2,286,0)=" D BLDREQSTRING(PSSICN,.PSSREQST,PSSDTTM)"
^XMB(3.9,146101,2,287,0)="""RTN"",""PSSHDPG1"",22,0)"
^XMB(3.9,146101,2,288,0)=" S OUTCOME=$$SENDREQUEST(.PSSRESTOBJ,.PSSREQST,.PSSERR)"
^XMB(3.9,146101,2,289,0)="""RTN"",""PSSHDPG1"",23,0)"
^XMB(3.9,146101,2,290,0)=" I +OUTCOME<0!($G(PSSERR)) S RETURN=""-1^""_OUTCOME G GETPGXEXIT"
^XMB(3.9,146101,2,291,0)="""RTN"",""PSSHDPG1"",24,0)"
^XMB(3.9,146101,2,292,0)=" S RETURN=""1^Successful"""
^XMB(3.9,146101,2,293,0)="""RTN"",""PSSHDPG1"",25,0)"
^XMB(3.9,146101,2,294,0)=" D PARSE(PSSRESTOBJ.HttpResponse.Data)"
^XMB(3.9,146101,2,295,0)="""RTN"",""PSSHDPG1"",26,0)"
^XMB(3.9,146101,2,296,0)=" D SETARRAY(.PSSGENES)"
^XMB(3.9,146101,2,297,0)="""RTN"",""PSSHDPG1"",27,0)"
^XMB(3.9,146101,2,298,0)="GETPGXEXIT ;"
^XMB(3.9,146101,2,299,0)="""RTN"",""PSSHDPG1"",28,0)"
^XMB(3.9,146101,2,300,0)=" K ^TMP($J,""PSSHDPG1"")"
^XMB(3.9,146101,2,301,0)="""RTN"",""PSSHDPG1"",29,0)"
^XMB(3.9,146101,2,302,0)=" Q RETURN"
^XMB(3.9,146101,2,303,0)="""RTN"",""PSSHDPG1"",30,0)"
^XMB(3.9,146101,2,304,0)=" ;"
^XMB(3.9,146101,2,305,0)="""RTN"",""PSSHDPG1"",31,0)"
^XMB(3.9,146101,2,306,0)="GETICN(X) ;GET ICN"
^XMB(3.9,146101,2,307,0)="""RTN"",""PSSHDPG1"",32,0)"
^XMB(3.9,146101,2,308,0)=" ; INPUT = X (DFN)"
^XMB(3.9,146101,2,309,0)="""RTN"",""PSSHDPG1"",33,0)"
^XMB(3.9,146101,2,310,0)=" ; OUTPUT = X1 (ICN associated with patient DFN)"
^XMB(3.9,146101,2,311,0)="""RTN"",""PSSHDPG1"",34,0)"
^XMB(3.9,146101,2,312,0)=" N X1"
^XMB(3.9,146101,2,313,0)="""RTN"",""PSSHDPG1"",35,0)"
^XMB(3.9,146101,2,314,0)=" I +X=0 S X1=""-1^INVALID DFN"" G GETICNX"
^XMB(3.9,146101,2,315,0)="""RTN"",""PSSHDPG1"",36,0)"
^XMB(3.9,146101,2,316,0)=" S X1=$$GETICN^MPIF001(X)"
^XMB(3.9,146101,2,317,0)="""RTN"",""PSSHDPG1"",37,0)"
^XMB(3.9,146101,2,318,0)="GETICNX ;"
^XMB(3.9,146101,2,319,0)="""RTN"",""PSSHDPG1"",38,0)"
^XMB(3.9,146101,2,320,0)=" Q X1"
^XMB(3.9,146101,2,321,0)="""RTN"",""PSSHDPG1"",39,0)"
^XMB(3.9,146101,2,322,0)=" ;"
^XMB(3.9,146101,2,323,0)="""RTN"",""PSSHDPG1"",40,0)"
^XMB(3.9,146101,2,324,0)="BLDDATETM(PSSFMDT) ; format Fileman date/time to CCYY-MM-DD_""T""_HH:MM:SS_""Z"""
^XMB(3.9,146101,2,325,0)="""RTN"",""PSSHDPG1"",41,0)"
^XMB(3.9,146101,2,326,0)=" ; format Fileman date/time to CCYY-MM-DD_""T""_HH:MM:SS_""Z"""
^XMB(3.9,146101,2,327,0)="""RTN"",""PSSHDPG1"",42,0)"
^XMB(3.9,146101,2,328,0)=" N PSSDTM,PSSDTM,PSSTIME,PSSGMT,OFFSET,HH,MM"
^XMB(3.9,146101,2,329,0)="""RTN"",""PSSHDPG1"",43,0)"
^XMB(3.9,146101,2,330,0)=" I '$D(PSSFMDT)!('$G(PSSFMDT)) S PSSFMDT=$$NOW^XLFDT"
^XMB(3.9,146101,2,331,0)="""RTN"",""PSSHDPG1"",44,0)"
^XMB(3.9,146101,2,332,0)=" S PSSDTM=$$FMTHL7^XLFDT(PSSFMDT)"
^XMB(3.9,146101,2,333,0)="""RTN"",""PSSHDPG1"",45,0)"
^XMB(3.9,146101,2,334,0)=" I PSSDTM<0 S PSSDTM=""00000000"""
^XMB(3.9,146101,2,335,0)="""RTN"",""PSSHDPG1"",46,0)"
^XMB(3.9,146101,2,336,0)=" S PSSGMT=$E(PSSDTM,1,4)_""-""_$E(PSSDTM,5,6)_""-""_$E(PSSDTM,7,8)"
^XMB(3.9,146101,2,337,0)="""RTN"",""PSSHDPG1"",47,0)"
^XMB(3.9,146101,2,338,0)=" ;extract and convert fm time to ISO 8601 external format"
^XMB(3.9,146101,2,339,0)="""RTN"",""PSSHDPG1"",48,0)"
^XMB(3.9,146101,2,340,0)=" S PSSTIME=$E(+PSSDTM,9,99)"
^XMB(3.9,146101,2,341,0)="""RTN"",""PSSHDPG1"",49,0)"
^XMB(3.9,146101,2,342,0)=" S PSSTIME=$$REMOVEOFFSET^PSSHDPG1(PSSTIME)"
^XMB(3.9,146101,2,343,0)="""RTN"",""PSSHDPG1"",50,0)"
^XMB(3.9,146101,2,344,0)=" I PSSTIME']"""" S PSSTIME=""000000""  ; MED_ORDER_CHECK request needs to have TIME along with DATE"
^XMB(3.9,146101,2,345,0)="""RTN"",""PSSHDPG1"",51,0)"
^XMB(3.9,146101,2,346,0)=" I $L(PSSTIME)<6 D  ; MED_ORDER_CHECK request requires seconds in TIME"
^XMB(3.9,146101,2,347,0)="""RTN"",""PSSHDPG1"",52,0)"
^XMB(3.9,146101,2,348,0)=" . I $E(PSSTIME,4)']"""" S PSSTIME=$E(PSSTIME,1,3)_""000"" Q"
^XMB(3.9,146101,2,349,0)="""RTN"",""PSSHDPG1"",53,0)"
^XMB(3.9,146101,2,350,0)=" . I $E(PSSTIME,5)']"""" S PSSTIME=$E(PSSTIME,1,4)_""00"" Q"
^XMB(3.9,146101,2,351,0)="""RTN"",""PSSHDPG1"",54,0)"
^XMB(3.9,146101,2,352,0)=" . I $E(PSSTIME,6)']"""" S PSSTIME=$E(PSSTIME,1,5)_0"
^XMB(3.9,146101,2,353,0)="""RTN"",""PSSHDPG1"",55,0)"
^XMB(3.9,146101,2,354,0)=" ;append hour:min:sec"
^XMB(3.9,146101,2,355,0)="""RTN"",""PSSHDPG1"",56,0)"
^XMB(3.9,146101,2,356,0)=" S PSSGMT=PSSGMT_""T""_$E(PSSTIME,1,2)_"":""_$E(PSSTIME,3,4)_"":""_$E(PSSTIME,5,6)"
^XMB(3.9,146101,2,357,0)="""RTN"",""PSSHDPG1"",57,0)"
^XMB(3.9,146101,2,358,0)=" Q PSSGMT_""Z"""
^XMB(3.9,146101,2,359,0)="""RTN"",""PSSHDPG1"",58,0)"
^XMB(3.9,146101,2,360,0)=" ;"
^XMB(3.9,146101,2,361,0)="""RTN"",""PSSHDPG1"",59,0)"
^XMB(3.9,146101,2,362,0)="BLDREQSTRING(ICN,PSSX,PSSDTM) ;"
