^XMB(3.9,146102,2,493,0)="""QUES"",""XPZ1"",0)"
^XMB(3.9,146102,2,494,0)="Y"
^XMB(3.9,146102,2,495,0)="""QUES"",""XPZ1"",""??"")"
^XMB(3.9,146102,2,496,0)="^D OPT^XPDH"
^XMB(3.9,146102,2,497,0)="""QUES"",""XPZ1"",""A"")"
^XMB(3.9,146102,2,498,0)="Want to DISABLE Scheduled Options, Menu Options, and Protocols"
^XMB(3.9,146102,2,499,0)="""QUES"",""XPZ1"",""B"")"
^XMB(3.9,146102,2,500,0)="NO"
^XMB(3.9,146102,2,501,0)="""QUES"",""XPZ1"",""M"")"
^XMB(3.9,146102,2,502,0)="D XPZ1^XPDIQ"
^XMB(3.9,146102,2,503,0)="""QUES"",""XPZ2"",0)"
^XMB(3.9,146102,2,504,0)="Y"
^XMB(3.9,146102,2,505,0)="""QUES"",""XPZ2"",""??"")"
^XMB(3.9,146102,2,506,0)="^D RTN^XPDH"
^XMB(3.9,146102,2,507,0)="""QUES"",""XPZ2"",""A"")"
^XMB(3.9,146102,2,508,0)="Want to MOVE routines to other CPUs"
^XMB(3.9,146102,2,509,0)="""QUES"",""XPZ2"",""B"")"
^XMB(3.9,146102,2,510,0)="NO"
^XMB(3.9,146102,2,511,0)="""QUES"",""XPZ2"",""M"")"
^XMB(3.9,146102,2,512,0)="D XPZ2^XPDIQ"
^XMB(3.9,146102,2,513,0)="""RTN"")"
^XMB(3.9,146102,2,514,0)=1
^XMB(3.9,146102,2,515,0)="""RTN"",""HLCSIN"")"
^XMB(3.9,146102,2,516,0)="0^1^B41606757"
^XMB(3.9,146102,2,517,0)="""RTN"",""HLCSIN"",1,0)"
^XMB(3.9,146102,2,518,0)="HLCSIN ;ALB/JRP - INCOMING FILER;01-MAY-95 ;03/07/2011"
^XMB(3.9,146102,2,519,0)="""RTN"",""HLCSIN"",2,0)"
^XMB(3.9,146102,2,520,0)=" ;;1.6;HEALTH LEVEL SEVEN;**2,30,14,19,62,109,115,122,140,145,153,175**;Oct 13, 1995;Build 0"
^XMB(3.9,146102,2,521,0)="""RTN"",""HLCSIN"",3,0)"
^XMB(3.9,146102,2,522,0)=" ;Per VHA Directive 6402, this routine should not be modified."
^XMB(3.9,146102,2,523,0)="""RTN"",""HLCSIN"",4,0)"
^XMB(3.9,146102,2,524,0)=" ;Supported ICR# 10063, for $$PSET^%ZTLOAD API to make task persistent "
^XMB(3.9,146102,2,525,0)="""RTN"",""HLCSIN"",5,0)"
^XMB(3.9,146102,2,526,0)="STARTIN ;Main entry point for incoming background filer"
^XMB(3.9,146102,2,527,0)="""RTN"",""HLCSIN"",6,0)"
^XMB(3.9,146102,2,528,0)=" ;Create/find entry denoting this filer in the INCOMING FILER TASK"
^XMB(3.9,146102,2,529,0)="""RTN"",""HLCSIN"",7,0)"
^XMB(3.9,146102,2,530,0)=" ; NUMBER multiple (field #20) of the HL COMMUNICATION SERVER PARAMETER"
^XMB(3.9,146102,2,531,0)="""RTN"",""HLCSIN"",8,0)"
^XMB(3.9,146102,2,532,0)=" ; file (#869.3)"
^XMB(3.9,146102,2,533,0)="""RTN"",""HLCSIN"",9,0)"
^XMB(3.9,146102,2,534,0)=" N HLFLG,HLEXIT,HLPTRFLR"
^XMB(3.9,146102,2,535,0)="""RTN"",""HLCSIN"",10,0)"
^XMB(3.9,146102,2,536,0)=" ;"
^XMB(3.9,146102,2,537,0)="""RTN"",""HLCSIN"",11,0)"
^XMB(3.9,146102,2,538,0)=" ; patch HL*1.6*122"
^XMB(3.9,146102,2,539,0)="""RTN"",""HLCSIN"",12,0)"
^XMB(3.9,146102,2,540,0)=" ;; N HLDUZ,DUZ  ; patch HL*1.6*122 TEST v2: DUZ code removed"
^XMB(3.9,146102,2,541,0)="""RTN"",""HLCSIN"",13,0)"
^XMB(3.9,146102,2,542,0)=" N HLDUZ"
^XMB(3.9,146102,2,543,0)="""RTN"",""HLCSIN"",14,0)"
^XMB(3.9,146102,2,544,0)=" S HLDUZ=+$G(DUZ)"
^XMB(3.9,146102,2,545,0)="""RTN"",""HLCSIN"",15,0)"
^XMB(3.9,146102,2,546,0)=" ;"
^XMB(3.9,146102,2,547,0)="""RTN"",""HLCSIN"",16,0)"
^XMB(3.9,146102,2,548,0)=" ;;patch HL*1.6*175 adds the $$PSET^%ZTLOAD api to set filers to persistent"
^XMB(3.9,146102,2,549,0)="""RTN"",""HLCSIN"",17,0)"
^XMB(3.9,146102,2,550,0)=" N HLPERS"
^XMB(3.9,146102,2,551,0)="""RTN"",""HLCSIN"",18,0)"
^XMB(3.9,146102,2,552,0)=" I $G(ZTQUEUED) D"
^XMB(3.9,146102,2,553,0)="""RTN"",""HLCSIN"",19,0)"
^XMB(3.9,146102,2,554,0)=" .S HLPERS=$$PSET^%ZTLOAD(ZTQUEUED)"
^XMB(3.9,146102,2,555,0)="""RTN"",""HLCSIN"",20,0)"
^XMB(3.9,146102,2,556,0)=" ;"
^XMB(3.9,146102,2,557,0)="""RTN"",""HLCSIN"",21,0)"
^XMB(3.9,146102,2,558,0)=" S HLPTRFLR=+$$CRTFLR^HLCSUTL1(ZTSK,""IN"")"
^XMB(3.9,146102,2,559,0)="""RTN"",""HLCSIN"",22,0)"
^XMB(3.9,146102,2,560,0)=" ;Loop through Logical Links and check for incoming messages"
^XMB(3.9,146102,2,561,0)="""RTN"",""HLCSIN"",23,0)"
^XMB(3.9,146102,2,562,0)=" S HLEXIT=0"
^XMB(3.9,146102,2,563,0)="""RTN"",""HLCSIN"",24,0)"
^XMB(3.9,146102,2,564,0)=" ; patch HL*1.6*122 TEST v2: DUZ code removed"
^XMB(3.9,146102,2,565,0)="""RTN"",""HLCSIN"",25,0)"
^XMB(3.9,146102,2,566,0)=" ; patch HL*1.6*122, set DUZ for application proxy user"
^XMB(3.9,146102,2,567,0)="""RTN"",""HLCSIN"",26,0)"
^XMB(3.9,146102,2,568,0)=" ;; D PROXY^HLCSTCP4"
^XMB(3.9,146102,2,569,0)="""RTN"",""HLCSIN"",27,0)"
^XMB(3.9,146102,2,570,0)=" S HLPTRFLR(""$J"")=$J"
^XMB(3.9,146102,2,571,0)="""RTN"",""HLCSIN"",28,0)"
^XMB(3.9,146102,2,572,0)=" F  D  Q:HLEXIT"
^XMB(3.9,146102,2,573,0)="""RTN"",""HLCSIN"",29,0)"
^XMB(3.9,146102,2,574,0)=" . S HLFLG=0"
^XMB(3.9,146102,2,575,0)="""RTN"",""HLCSIN"",30,0)"
^XMB(3.9,146102,2,576,0)=" . D DEFACK(.HLPTRFLR,.HLFLG,.HLEXIT) Q:HLEXIT"
^XMB(3.9,146102,2,577,0)="""RTN"",""HLCSIN"",31,0)"
^XMB(3.9,146102,2,578,0)=" . D ACKNOW(.HLPTRFLR,.HLFLG,.HLEXIT) Q:HLEXIT"
^XMB(3.9,146102,2,579,0)="""RTN"",""HLCSIN"",32,0)"
^XMB(3.9,146102,2,580,0)=" . Q:HLFLG"
^XMB(3.9,146102,2,581,0)="""RTN"",""HLCSIN"",33,0)"
^XMB(3.9,146102,2,582,0)=" . I $$HDIFF^XLFDT($H,$G(HLPTRFLR(""LASTDEL"")),2)>3600 D  Q"
^XMB(3.9,146102,2,583,0)="""RTN"",""HLCSIN"",34,0)"
^XMB(3.9,146102,2,584,0)=" . . S HLPTRFLR(""LASTDEL"")=$H    ; maintain queue sizes"
^XMB(3.9,146102,2,585,0)="""RTN"",""HLCSIN"",35,0)"
^XMB(3.9,146102,2,586,0)=" . . D DELQUE(.HLPTRFLR,.HLEXIT) ; no more than once an hour."
^XMB(3.9,146102,2,587,0)="""RTN"",""HLCSIN"",36,0)"
^XMB(3.9,146102,2,588,0)=" . ; patch HL*1.6*122"
^XMB(3.9,146102,2,589,0)="""RTN"",""HLCSIN"",37,0)"
^XMB(3.9,146102,2,590,0)=" . ; H 5"
^XMB(3.9,146102,2,591,0)="""RTN"",""HLCSIN"",38,0)"
^XMB(3.9,146102,2,592,0)=" . H 1"
^XMB(3.9,146102,2,593,0)="""RTN"",""HLCSIN"",39,0)"
^XMB(3.9,146102,2,594,0)=" . D CHKUPD(.HLPTRFLR,.HLEXIT) Q:HLEXIT"
^XMB(3.9,146102,2,595,0)="""RTN"",""HLCSIN"",40,0)"
^XMB(3.9,146102,2,596,0)=" S ZTSTOP=1 ;Asked to stop"
^XMB(3.9,146102,2,597,0)="""RTN"",""HLCSIN"",41,0)"
^XMB(3.9,146102,2,598,0)=" D DELFLR^HLCSUTL1(HLPTRFLR,""IN"") ;Delete entry denoting this filer"
^XMB(3.9,146102,2,599,0)="""RTN"",""HLCSIN"",42,0)"
^XMB(3.9,146102,2,600,0)=" S ZTREQ=""@"""
^XMB(3.9,146102,2,601,0)="""RTN"",""HLCSIN"",43,0)"
^XMB(3.9,146102,2,602,0)=" Q"
^XMB(3.9,146102,2,603,0)="""RTN"",""HLCSIN"",44,0)"
^XMB(3.9,146102,2,604,0)="DEFACK(HLPTRFLR,HLFLG,HLEXIT) ; Process TCP links with a deferred response"
^XMB(3.9,146102,2,605,0)="""RTN"",""HLCSIN"",45,0)"
^XMB(3.9,146102,2,606,0)=" N HLXX,HLD0,HLPCT"
^XMB(3.9,146102,2,607,0)="""RTN"",""HLCSIN"",46,0)"
^XMB(3.9,146102,2,608,0)=" S HLXX=0"
^XMB(3.9,146102,2,609,0)="""RTN"",""HLCSIN"",47,0)"
^XMB(3.9,146102,2,610,0)=" F  S HLXX=$O(^HLMA(""AC"",""I"",HLXX)) Q:'HLXX  D  Q:HLEXIT"
^XMB(3.9,146102,2,611,0)="""RTN"",""HLCSIN"",48,0)"
^XMB(3.9,146102,2,612,0)=" . ; HL*1.6*122, check the in-queue stop flag"
^XMB(3.9,146102,2,613,0)="""RTN"",""HLCSIN"",49,0)"
^XMB(3.9,146102,2,614,0)=" . Q:$P($G(^HLCS(870,HLXX,0)),""^"",9)"
^XMB(3.9,146102,2,615,0)="""RTN"",""HLCSIN"",50,0)"
^XMB(3.9,146102,2,616,0)=" . D CHKUPD(.HLPTRFLR,.HLEXIT) Q:HLEXIT"
^XMB(3.9,146102,2,617,0)="""RTN"",""HLCSIN"",51,0)"
^XMB(3.9,146102,2,618,0)=" . ; patch HL*1.6*109: Does another filer have this?"
^XMB(3.9,146102,2,619,0)="""RTN"",""HLCSIN"",52,0)"
^XMB(3.9,146102,2,620,0)=" . ; L +^HLMA(""AC"",""I"",HLXX):0 Q:'$T"
^XMB(3.9,146102,2,621,0)="""RTN"",""HLCSIN"",53,0)"
^XMB(3.9,146102,2,622,0)=" . ; patch HL*1.6*140 - change the lock node, it conflicts with"
^XMB(3.9,146102,2,623,0)="""RTN"",""HLCSIN"",54,0)"
^XMB(3.9,146102,2,624,0)=" . ; lock defined in routine, HLCSREP."
^XMB(3.9,146102,2,625,0)="""RTN"",""HLCSIN"",55,0)"
^XMB(3.9,146102,2,626,0)=" . ; L +^HLMA(""AC"",""I"",HLXX):2 Q:'$T  ; patch HL*1.6*122"
^XMB(3.9,146102,2,627,0)="""RTN"",""HLCSIN"",56,0)"
^XMB(3.9,146102,2,628,0)=" . L +^HLMA(""IN-FILER"",""AC"",""I"",HLXX):0 Q:'$T  ; patch HL*1.6*122"
^XMB(3.9,146102,2,629,0)="""RTN"",""HLCSIN"",57,0)"
^XMB(3.9,146102,2,630,0)=" . S HLD0=0,HLFLG=1"
^XMB(3.9,146102,2,631,0)="""RTN"",""HLCSIN"",58,0)"
^XMB(3.9,146102,2,632,0)=" . ; HL*1.6*109 changes in for loop below, and post-quit code placed"
^XMB(3.9,146102,2,633,0)="""RTN"",""HLCSIN"",59,0)"
^XMB(3.9,146102,2,634,0)=" . ; on following lines."
^XMB(3.9,146102,2,635,0)="""RTN"",""HLCSIN"",60,0)"
^XMB(3.9,146102,2,636,0)=" . S HLPCT=0 ; Counter whether filer should stop every 100th entry."
^XMB(3.9,146102,2,637,0)="""RTN"",""HLCSIN"",61,0)"
^XMB(3.9,146102,2,638,0)=" .;**109 - insure queue last processed at least 2 seconds ago"
^XMB(3.9,146102,2,639,0)="""RTN"",""HLCSIN"",62,0)"
^XMB(3.9,146102,2,640,0)=" . ; patch HL*1.6*140"
^XMB(3.9,146102,2,641,0)="""RTN"",""HLCSIN"",63,0)"
^XMB(3.9,146102,2,642,0)=" . ; I ($$HDIFF^XLFDT($H,$G(^XTMP(""HL7-AC"",""I"",HLXX)),2)<2) L -^HLMA(""AC"",""I"",HLXX) Q"
^XMB(3.9,146102,2,643,0)="""RTN"",""HLCSIN"",64,0)"
^XMB(3.9,146102,2,644,0)=" . I ($$HDIFF^XLFDT($H,$G(^XTMP(""HL7-AC"",""I"",HLXX)),2)<2) L -^HLMA(""IN-FILER"",""AC"",""I"",HLXX) Q"
^XMB(3.9,146102,2,645,0)="""RTN"",""HLCSIN"",65,0)"
^XMB(3.9,146102,2,646,0)=" . F  S HLD0=$O(^HLMA(""AC"",""I"",HLXX,HLD0)) Q:'HLD0!(HLEXIT)  D"
^XMB(3.9,146102,2,647,0)="""RTN"",""HLCSIN"",66,0)"
^XMB(3.9,146102,2,648,0)=" .. ; patch HL*1.6*122 start"
^XMB(3.9,146102,2,649,0)="""RTN"",""HLCSIN"",67,0)"
^XMB(3.9,146102,2,650,0)=" .. ; patch HL*1.6*122 TEST v2: DUZ code removed"
^XMB(3.9,146102,2,651,0)="""RTN"",""HLCSIN"",68,0)"
^XMB(3.9,146102,2,652,0)=" .. ; DUZ comparison/reset for application proxy user"
^XMB(3.9,146102,2,653,0)="""RTN"",""HLCSIN"",69,0)"
^XMB(3.9,146102,2,654,0)=" .. ;; D HLDUZ^HLCSTCP4"
^XMB(3.9,146102,2,655,0)="""RTN"",""HLCSIN"",70,0)"
^XMB(3.9,146102,2,656,0)=" .. D HLDUZ2^HLCSTCP4"
^XMB(3.9,146102,2,657,0)="""RTN"",""HLCSIN"",71,0)"
^XMB(3.9,146102,2,658,0)=" .. ; protect HLDUZ"
^XMB(3.9,146102,2,659,0)="""RTN"",""HLCSIN"",72,0)"
^XMB(3.9,146102,2,660,0)=" .. N HLDUZ"
^XMB(3.9,146102,2,661,0)="""RTN"",""HLCSIN"",73,0)"
^XMB(3.9,146102,2,662,0)=" .. S HLPCT=HLPCT+1"
^XMB(3.9,146102,2,663,0)="""RTN"",""HLCSIN"",74,0)"
^XMB(3.9,146102,2,664,0)=" .. I '(HLPCT#100) D CHKUPD(.HLPTRFLR,.HLEXIT) Q:HLEXIT"
^XMB(3.9,146102,2,665,0)="""RTN"",""HLCSIN"",75,0)"
^XMB(3.9,146102,2,666,0)=" .. ; L +^HLMA(HLD0):0 Q:'$T"
^XMB(3.9,146102,2,667,0)="""RTN"",""HLCSIN"",76,0)"
^XMB(3.9,146102,2,668,0)=" .. F  L +^HLMA(HLD0):30 Q:$T  H 1"
^XMB(3.9,146102,2,669,0)="""RTN"",""HLCSIN"",77,0)"
^XMB(3.9,146102,2,670,0)=" .. I '$$CHECKAC(""I"",HLXX,HLD0) L -^HLMA(HLD0) Q  ;-> Quit if not a valid AC xref"
^XMB(3.9,146102,2,671,0)="""RTN"",""HLCSIN"",78,0)"
^XMB(3.9,146102,2,672,0)=" .. D DEFACK^HLTP3(HLXX,HLD0)"
^XMB(3.9,146102,2,673,0)="""RTN"",""HLCSIN"",79,0)"
^XMB(3.9,146102,2,674,0)=" .. D DEQUE^HLCSREP(HLXX,""I"",HLD0)"
^XMB(3.9,146102,2,675,0)="""RTN"",""HLCSIN"",80,0)"
^XMB(3.9,146102,2,676,0)=" .. L -^HLMA(HLD0)"
^XMB(3.9,146102,2,677,0)="""RTN"",""HLCSIN"",81,0)"
^XMB(3.9,146102,2,678,0)=" .. ; patch HL*1.6*145"
