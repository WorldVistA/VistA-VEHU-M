^XMB(3.9,146087,2,3521,0)="""RTN"",""YTQRQAD4"",247,0)"
^XMB(3.9,146087,2,3522,0)=" . S NWA=$$NEWASMT^YTQRQAD1(.ARGS,.DATA),NWA=$P(NWA,""/"",$L(NWA,""/""))"
^XMB(3.9,146087,2,3523,0)="""RTN"",""YTQRQAD4"",248,0)"
^XMB(3.9,146087,2,3524,0)=" . I +NWA D SETASGN(NWA) S HIT=1"
^XMB(3.9,146087,2,3525,0)="""RTN"",""YTQRQAD4"",249,0)"
^XMB(3.9,146087,2,3526,0)=" S STR=^TMP(""YTQ-JSON"",$J,CNT,0) I $E(STR,$L(STR))="","" S STR=$E(STR,1,$L(STR)-1),^TMP(""YTQ-JSON"",$J,CNT,0)=STR  ;Remove last trailing "","""
