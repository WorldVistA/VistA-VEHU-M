^XMB(3.9,146052,2,2421,0)="""RTN"",""FBSHRAD"",158,0)"
^XMB(3.9,146052,2,2422,0)=" I 'FBQUIT,$E(IOST,1,2)=""C-"" S DIR(0)=""E"" D ^DIR K DIR"
^XMB(3.9,146052,2,2423,0)="""RTN"",""FBSHRAD"",159,0)"
^XMB(3.9,146052,2,2424,0)=" D ^%ZISC"
^XMB(3.9,146052,2,2425,0)="""RTN"",""FBSHRAD"",160,0)"
^XMB(3.9,146052,2,2426,0)=" ;"
