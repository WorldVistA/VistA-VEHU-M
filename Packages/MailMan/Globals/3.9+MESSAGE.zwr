^XMB(3.9,146089,2,1954,0)=" I $O(^PS(52.41,ORD,2,0)) S PHI=^PS(52.41,ORD,2,0),T=0 F  S T=$O(^PS(52.41,ORD,2,T)) Q:'T  S PHI(T)=^PS(52.41,ORD,2,T,0)"
^XMB(3.9,146089,2,1955,0)="""RTN"",""PSOORFIN"",195,0)"
^XMB(3.9,146089,2,1956,0)=" I $P($G(^PS(52.41,ORD,""EXT"")),""^"")'="""" K PHI I $O(^PS(52.41,ORD,""SIG"",0)) S PHI=$G(^PS(52.41,ORD,""SIG"",0)),T=0 F  S T=$O(^PS(52.41,ORD,""SIG"",T)) Q:'T  S PHI(T)=$G(^PS(52.41,ORD,""SIG"",T,0))"
^XMB(3.9,146089,2,1957,0)="""RTN"",""PSOORFIN"",196,0)"
^XMB(3.9,146089,2,1958,0)=" I $O(^PS(52.41,ORD,3,0)) S PRC=^PS(52.41,ORD,3,0),T=0 F  S T=$O(^PS(52.41,ORD,3,T)) Q:'T  S PRC(T)=^PS(52.41,ORD,3,T,0)"
