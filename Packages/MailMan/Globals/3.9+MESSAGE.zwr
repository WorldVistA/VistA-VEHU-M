^XMB(3.9,146090,2,762,0)=" I $$RXRLDT^PSOBPSUT(RXIEN,FILLNUM),$$UP^XLFSTR($E(X))=""V"",'PSOSECK D  Q"
^XMB(3.9,146090,2,763,0)="""RTN"",""PSOSPML4"",262,0)"
