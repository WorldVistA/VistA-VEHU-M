^XMB(3.9,146037,2,2276,0)="FDT(X) ; returns MM/DD/YYYY or MM/DD/YY from YYYYMMDD or YYMMDD in X"
^XMB(3.9,146037,2,2277,0)="""RTN"",""RCDPESR9"",203,0)"
^XMB(3.9,146037,2,2278,0)=" I $L(X)=8,X?8N S X=$E(X,5,6)_""/""_$E(X,7,8)_""/""_$E(X,1,4)"
^XMB(3.9,146037,2,2279,0)="""RTN"",""RCDPESR9"",204,0)"
^XMB(3.9,146037,2,2280,0)=" I $L(X)=6,X?6N S X=$E(X,3,4)_""/""_$E(X,5,6)_""/""_$E(X,1,2)"
^XMB(3.9,146037,2,2281,0)="""RTN"",""RCDPESR9"",205,0)"
