^XMB(3.9,146055,2,281,0)="""RTN"",""PSOSUCH1"",20,0)"
^XMB(3.9,146055,2,282,0)=" S CNT=CNT+1"
^XMB(3.9,146055,2,283,0)="""RTN"",""PSOSUCH1"",21,0)"
^XMB(3.9,146055,2,284,0)=" S ^PSRX(RXREC,""A"",0)=""^52.3DA^""_CNT_""^""_CNT"
^XMB(3.9,146055,2,285,0)="""RTN"",""PSOSUCH1"",22,0)"
^XMB(3.9,146055,2,286,0)=" S ^PSRX(RXREC,""A"",CNT,0)=%_""^""_$S(DEAD:""C"",1:""S"")_""^""_PSODUZ_""^""_$S($G(PSOSUSPA):6,1:RFCNT)_""^""_COM"
^XMB(3.9,146055,2,287,0)="""RTN"",""PSOSUCH1"",23,0)"
^XMB(3.9,146055,2,288,0)=" K PSOSUSPA"
^XMB(3.9,146055,2,289,0)="""RTN"",""PSOSUCH1"",24,0)"
^XMB(3.9,146055,2,290,0)=" Q"
