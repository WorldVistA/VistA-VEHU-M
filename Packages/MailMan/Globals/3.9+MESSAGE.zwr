^XMB(3.9,146087,2,513,0)="""RTN"",""YTQAPI1"",84,0)"
^XMB(3.9,146087,2,514,0)=" Q"
^XMB(3.9,146087,2,515,0)="""RTN"",""YTQAPI1"",85,0)"
^XMB(3.9,146087,2,516,0)="GETANS(YSDATA,YS) ;get an answer"
^XMB(3.9,146087,2,517,0)="""RTN"",""YTQAPI1"",86,0)"
^XMB(3.9,146087,2,518,0)=" ;entry point for YTQ GETANS rpc"
^XMB(3.9,146087,2,519,0)="""RTN"",""YTQAPI1"",87,0)"
^XMB(3.9,146087,2,520,0)=" ;AD = ADMINISTRATION #"
^XMB(3.9,146087,2,521,0)="""RTN"",""YTQAPI1"",88,0)"
^XMB(3.9,146087,2,522,0)=" ;QN= QUESTION #"
^XMB(3.9,146087,2,523,0)="""RTN"",""YTQAPI1"",89,0)"
^XMB(3.9,146087,2,524,0)=" N G,G1,N,YSAD,YSQN"
^XMB(3.9,146087,2,525,0)="""RTN"",""YTQAPI1"",90,0)"
^XMB(3.9,146087,2,526,0)=" S YSAD=$G(YS(""AD""))"
^XMB(3.9,146087,2,527,0)="""RTN"",""YTQAPI1"",91,0)"
^XMB(3.9,146087,2,528,0)=" S YSQN=$G(YS(""QN""))"
^XMB(3.9,146087,2,529,0)="""RTN"",""YTQAPI1"",92,0)"
^XMB(3.9,146087,2,530,0)=" I YSAD'?1N.N S YSDATA(1)=""[ERROR]"",YSDATA(2)=""bad ad num"" Q  ;-->out"
^XMB(3.9,146087,2,531,0)="""RTN"",""YTQAPI1"",93,0)"
^XMB(3.9,146087,2,532,0)=" I YSQN'?1N.N S YSDATA(1)=""[ERROR]"",YSDATA(2)=""bad quest num"" Q  ;-->out"
^XMB(3.9,146087,2,533,0)="""RTN"",""YTQAPI1"",94,0)"
^XMB(3.9,146087,2,534,0)=" I '$D(^YTT(601.85,""AC"",YSAD,YSQN)) S YSDATA(1)=""[ERROR]"",YSDATA(2)=""no such reference"" Q  ;-->out"
^XMB(3.9,146087,2,535,0)="""RTN"",""YTQAPI1"",95,0)"
^XMB(3.9,146087,2,536,0)=" S YSDATA(1)=""[DATA]"""
^XMB(3.9,146087,2,537,0)="""RTN"",""YTQAPI1"",96,0)"
^XMB(3.9,146087,2,538,0)=" S G=0,N=1"
^XMB(3.9,146087,2,539,0)="""RTN"",""YTQAPI1"",97,0)"
^XMB(3.9,146087,2,540,0)=" S G=$O(^YTT(601.85,""AC"",YSAD,YSQN,G)) Q:G'>0  S G1=0 D"
^XMB(3.9,146087,2,541,0)="""RTN"",""YTQAPI1"",98,0)"
^XMB(3.9,146087,2,542,0)=" . S:$P(^YTT(601.85,G,0),U,4)?1N.N N=N+1,YSDATA(N)=$P(^YTT(601.85,G,0),U,4) ;ASF 3/10/04 ***"
^XMB(3.9,146087,2,543,0)="""RTN"",""YTQAPI1"",99,0)"
^XMB(3.9,146087,2,544,0)=" . F  S G1=$O(^YTT(601.85,G,1,G1)) Q:G1'>0  S N=N+1,YSDATA(N)=$G(^YTT(601.85,G,1,G1,0))"
^XMB(3.9,146087,2,545,0)="""RTN"",""YTQAPI1"",100,0)"
^XMB(3.9,146087,2,546,0)=" Q"
^XMB(3.9,146087,2,547,0)="""RTN"",""YTQAPI1"",101,0)"
^XMB(3.9,146087,2,548,0)="CAPIE(YSDATA,YS) ;entry point for YTQ CAPIE rpc"
^XMB(3.9,146087,2,549,0)="""RTN"",""YTQAPI1"",102,0)"
^XMB(3.9,146087,2,550,0)=" N N,N1,N2,YSFIELDS,YSFILEN,YSIENS,X"
^XMB(3.9,146087,2,551,0)="""RTN"",""YTQAPI1"",103,0)"
^XMB(3.9,146087,2,552,0)=" K ^TMP(""YS"",$J)"
^XMB(3.9,146087,2,553,0)="""RTN"",""YTQAPI1"",104,0)"
^XMB(3.9,146087,2,554,0)=" K ^TMP(""YSDATA"",$J) S YSDATA=$NA(^TMP(""YSDATA"",$J))"
^XMB(3.9,146087,2,555,0)="""RTN"",""YTQAPI1"",105,0)"
^XMB(3.9,146087,2,556,0)=" S ^TMP(""YSDATA"",$J,1)=""[ERROR]"""
^XMB(3.9,146087,2,557,0)="""RTN"",""YTQAPI1"",106,0)"
^XMB(3.9,146087,2,558,0)=" S YSFILEN=$G(YS(""FILEN""),0) I $$VFILE^DILFD(YSFILEN)<1 S ^TMP(""YSDATA"",$J,2)=""BAD FILE N"" Q  ;--->out"
^XMB(3.9,146087,2,559,0)="""RTN"",""YTQAPI1"",107,0)"
^XMB(3.9,146087,2,560,0)=" S YSFIELDS=$G(YS(""FIELDS""),"""")"
^XMB(3.9,146087,2,561,0)="""RTN"",""YTQAPI1"",108,0)"
^XMB(3.9,146087,2,562,0)=" S:YSFIELDS=""*"" YSFIELDS=""**"""
^XMB(3.9,146087,2,563,0)="""RTN"",""YTQAPI1"",109,0)"
^XMB(3.9,146087,2,564,0)=" I YSFIELDS=""**""&(YSFILEN=604) S YSFIELDS="".03:200"""
^XMB(3.9,146087,2,565,0)="""RTN"",""YTQAPI1"",110,0)"
^XMB(3.9,146087,2,566,0)=" I YSFIELDS?1N.N S N=$$VFIELD^DILFD(YSFILEN,YSFIELDS) I N<1 S ^TMP(""YSDATA"",$J,2)=""BAD field"" Q  ;--> out"
^XMB(3.9,146087,2,567,0)="""RTN"",""YTQAPI1"",111,0)"
^XMB(3.9,146087,2,568,0)=" S YSIENS=$G(YS(""IENS"")) I YSIENS'?1N.N S ^TMP(""YSDATA"",$J,2)=""BAD IENS"" Q  ;-->out"
^XMB(3.9,146087,2,569,0)="""RTN"",""YTQAPI1"",112,0)"
^XMB(3.9,146087,2,570,0)=" S YSIENS=YSIENS_"","""
^XMB(3.9,146087,2,571,0)="""RTN"",""YTQAPI1"",113,0)"
^XMB(3.9,146087,2,572,0)=" D GETS^DIQ(YSFILEN,YSIENS,YSFIELDS,""IE"",""^TMP(""""YS"""",$J"")"
^XMB(3.9,146087,2,573,0)="""RTN"",""YTQAPI1"",114,0)"
^XMB(3.9,146087,2,574,0)=" S N=1,^TMP(""YSDATA"",$J,1)=""[DATA]"""
^XMB(3.9,146087,2,575,0)="""RTN"",""YTQAPI1"",115,0)"
^XMB(3.9,146087,2,576,0)=" S N1=0 F  S N1=$O(^TMP(""YS"",$J,YSFILEN,YSIENS,N1)) Q:N1'>0  D"
^XMB(3.9,146087,2,577,0)="""RTN"",""YTQAPI1"",116,0)"
^XMB(3.9,146087,2,578,0)=" . S N2=0 F  S N2=$O(^TMP(""YS"",$J,YSFILEN,YSIENS,N1,N2)) Q:N2'>0  S N=N+1,^TMP(""YSDATA"",$J,N)=N1_"";""_N2_U_$$GET1^DID(YSFILEN,N1,"""",""LABEL"")_U_^TMP(""YS"",$J,YSFILEN,YSIENS,N1,N2)"
^XMB(3.9,146087,2,579,0)="""RTN"",""YTQAPI1"",117,0)"
^XMB(3.9,146087,2,580,0)=" . I ^TMP(""YS"",$J,YSFILEN,YSIENS,N1,""I"")'?1""^TMP("".E S N=N+1,^TMP(""YSDATA"",$J,N)=N1_U_$$GET1^DID(YSFILEN,N1,"""",""LABEL"")_U_$G(^TMP(""YS"",$J,YSFILEN,YSIENS,N1,""I""))"
^XMB(3.9,146087,2,581,0)="""RTN"",""YTQAPI1"",118,0)"
^XMB(3.9,146087,2,582,0)=" . S:(^TMP(""YS"",$J,YSFILEN,YSIENS,N1,""E"")'=^TMP(""YS"",$J,YSFILEN,YSIENS,N1,""I"")) ^TMP(""YSDATA"",$J,N)=^TMP(""YSDATA"",$J,N)_U_^TMP(""YS"",$J,YSFILEN,YSIENS,N1,""E"")"
^XMB(3.9,146087,2,583,0)="""RTN"",""YTQAPI1"",119,0)"
^XMB(3.9,146087,2,584,0)=" K ^TMP(""YS"",$J)"
^XMB(3.9,146087,2,585,0)="""RTN"",""YTQAPI1"",120,0)"
^XMB(3.9,146087,2,586,0)=" Q"
