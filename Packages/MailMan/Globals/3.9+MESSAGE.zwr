^XMB(3.9,146107,2,489,0)="""RTN"",""PSJORUT2"",125,0)"
^XMB(3.9,146107,2,490,0)="DDRUG ;*** Set PSJ(DDRUG NAME) arrays."
^XMB(3.9,146107,2,491,0)="""RTN"",""PSJORUT2"",126,0)"
^XMB(3.9,146107,2,492,0)=" Q:'DDRUG  S DDRUG0=$G(^PSDRUG(+DDRUG,0)),DDRUGND=$G(^PSDRUG(+DDRUG,""ND""))"
^XMB(3.9,146107,2,493,0)="""RTN"",""PSJORUT2"",127,0)"
^XMB(3.9,146107,2,494,0)=" S PSJINX=+$G(PSJINX)+1 ;* ^PSOORDRG calls this entry point."
^XMB(3.9,146107,2,495,0)="""RTN"",""PSJORUT2"",128,0)"
^XMB(3.9,146107,2,496,0)=" I $D(DDRUG)=11,DDRUG["";"" D  Q   ; if called from ^PSOORDRG"
^XMB(3.9,146107,2,497,0)="""RTN"",""PSJORUT2"",129,0)"
^XMB(3.9,146107,2,498,0)=" .N IPOROP S IPOROP=$P(DDRUG,"";"",2)"
^XMB(3.9,146107,2,499,0)="""RTN"",""PSJORUT2"",130,0)"
^XMB(3.9,146107,2,500,0)=" .S IPOROP=$S(IPOROP=""PSO"":"";O"",IPOROP=""PSH"":""N;O"",1:"";I"")"
^XMB(3.9,146107,2,501,0)="""RTN"",""PSJORUT2"",131,0)"
^XMB(3.9,146107,2,502,0)=" .S ^TMP($J,""ORDERS"",PSJINX)=$P(DDRUG0,U,2)_U_$P(DDRUGND,U)_""A""_$P(DDRUGND,U,3)_U_$P(DDRUG0,U)_U_$S($G(DDRUG(DDRUG)):DDRUG(DDRUG),1:$G(PSJORIEN))_U_$G(COD)_IPOROP"
^XMB(3.9,146107,2,503,0)="""RTN"",""PSJORUT2"",132,0)"
^XMB(3.9,146107,2,504,0)=" S ^TMP($J,""ORDERS"",PSJINX)=$P(DDRUG0,U,2)_U_$P(DDRUGND,U)_""A""_$P(DDRUGND,U,3)_U_$P(DDRUG0,U)_U_$G(PSJORIEN)_U_$G(COD)_"";I"""
