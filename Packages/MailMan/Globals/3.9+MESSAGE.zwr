^XMB(3.9,146043,2,522,0)=" D XMLHDR^MDCLIO(""HL7_TEXT"")"
^XMB(3.9,146043,2,523,0)="""RTN"",""MDCLIO1"",141,0)"
^XMB(3.9,146043,2,524,0)=" D:IEN>0"
^XMB(3.9,146043,2,525,0)="""RTN"",""MDCLIO1"",142,0)"
^XMB(3.9,146043,2,526,0)=" .D GETMSG^MDCPHL7B(.MDRET,IEN)"
^XMB(3.9,146043,2,527,0)="""RTN"",""MDCLIO1"",143,0)"
^XMB(3.9,146043,2,528,0)=" .S X=MDRET F  S X=$Q(@X) Q:$E(X,1,$L(MDRET)-1)'=$E(MDRET,1,$L(MDRET)-1)  D"
^XMB(3.9,146043,2,529,0)="""RTN"",""MDCLIO1"",144,0)"
^XMB(3.9,146043,2,530,0)=" ..D XMLADD^MDCLIO($$XMLSAFE^MDCLIO(@X))"
^XMB(3.9,146043,2,531,0)="""RTN"",""MDCLIO1"",145,0)"
^XMB(3.9,146043,2,532,0)=" D XMLFTR^MDCLIO(""HL7_TEXT"")"
^XMB(3.9,146043,2,533,0)="""RTN"",""MDCLIO1"",146,0)"
^XMB(3.9,146043,2,534,0)=" Q"
^XMB(3.9,146043,2,535,0)="""RTN"",""MDCLIO1"",147,0)"
^XMB(3.9,146043,2,536,0)="SETACL ; Sets the ACL for an Item"
^XMB(3.9,146043,2,537,0)="""RTN"",""MDCLIO1"",148,0)"
^XMB(3.9,146043,2,538,0)=" D SETACL^MDCLIO"
^XMB(3.9,146043,2,539,0)="""RTN"",""MDCLIO1"",149,0)"
^XMB(3.9,146043,2,540,0)=" Q"
^XMB(3.9,146043,2,541,0)="""RTN"",""MDCLIO1"",150,0)"
^XMB(3.9,146043,2,542,0)=" ;"
^XMB(3.9,146043,2,543,0)="""RTN"",""MDCLIO1"",151,0)"
^XMB(3.9,146043,2,544,0)="DELACL ; Removes and item from ACL"
^XMB(3.9,146043,2,545,0)="""RTN"",""MDCLIO1"",152,0)"
^XMB(3.9,146043,2,546,0)=" D DELACL^MDCLIO"
^XMB(3.9,146043,2,547,0)="""RTN"",""MDCLIO1"",153,0)"
^XMB(3.9,146043,2,548,0)=" Q"
^XMB(3.9,146043,2,549,0)="""RTN"",""MDCLIO1"",154,0)"
^XMB(3.9,146043,2,550,0)=" ;"
^XMB(3.9,146043,2,551,0)="""RTN"",""MDCLIO1"",155,0)"
^XMB(3.9,146043,2,552,0)="SUBMIT ; Submits an HL7 message back to the queue"
^XMB(3.9,146043,2,553,0)="""RTN"",""MDCLIO1"",156,0)"
^XMB(3.9,146043,2,554,0)=" N MDMSG,MDSTAT"
^XMB(3.9,146043,2,555,0)="""RTN"",""MDCLIO1"",157,0)"
^XMB(3.9,146043,2,556,0)=" S MDMSG=$$FIND1^DIC(704.002,,""KX"",P2(0))"
^XMB(3.9,146043,2,557,0)="""RTN"",""MDCLIO1"",158,0)"
^XMB(3.9,146043,2,558,0)=" I MDMSG<1 S @RESULTS@(0)=""-1^NO SUCH MESSAGE"" Q"
^XMB(3.9,146043,2,559,0)="""RTN"",""MDCLIO1"",159,0)"
^XMB(3.9,146043,2,560,0)=" S MDSTAT=$G(P2(1),3) ; Default to error if you didn't get a status"
^XMB(3.9,146043,2,561,0)="""RTN"",""MDCLIO1"",160,0)"
^XMB(3.9,146043,2,562,0)=" D UPDATERP^MDCPHL7B(.MDRET,MDMSG,MDSTAT)"
^XMB(3.9,146043,2,563,0)="""RTN"",""MDCLIO1"",161,0)"
^XMB(3.9,146043,2,564,0)=" S @RESULTS@(0)=""1^Submitted"""
^XMB(3.9,146043,2,565,0)="""RTN"",""MDCLIO1"",162,0)"
^XMB(3.9,146043,2,566,0)=" Q"
^XMB(3.9,146043,2,567,0)="""RTN"",""MDCLIO1"",163,0)"
^XMB(3.9,146043,2,568,0)="QRYDATE(MDRET,MDSTRT,MDSTOP) ; Get list of all observations by DATE/TIME"
^XMB(3.9,146043,2,569,0)="""RTN"",""MDCLIO1"",164,0)"
^XMB(3.9,146043,2,570,0)=" K @MDRET"
^XMB(3.9,146043,2,571,0)="""RTN"",""MDCLIO1"",165,0)"
^XMB(3.9,146043,2,572,0)=" F X=MDSTRT-.0000001:0 S X=$O(^MDC(704.117,""ADT"",X)) Q:'X!(X>MDSTOP)  D"
^XMB(3.9,146043,2,573,0)="""RTN"",""MDCLIO1"",166,0)"
^XMB(3.9,146043,2,574,0)=" .F Y=0:0 S Y=$O(^MDC(704.117,""ADT"",X,Y)) Q:'Y  D"
^XMB(3.9,146043,2,575,0)="""RTN"",""MDCLIO1"",167,0)"
^XMB(3.9,146043,2,576,0)=" ..Q:$P(^MDC(704.117,Y,0),U,9)'=1"
^XMB(3.9,146043,2,577,0)="""RTN"",""MDCLIO1"",168,0)"
^XMB(3.9,146043,2,578,0)=" ..S @MDRET@($O(@MDRET@(""""),-1)+1)=$P(^MDC(704.117,Y,0),U)"
^XMB(3.9,146043,2,579,0)="""RTN"",""MDCLIO1"",169,0)"
^XMB(3.9,146043,2,580,0)=" S @MDRET@(0)=+$O(@MDRET@(""""),-1)"
^XMB(3.9,146043,2,581,0)="""RTN"",""MDCLIO1"",170,0)"
^XMB(3.9,146043,2,582,0)=" Q"
^XMB(3.9,146043,2,583,0)="""RTN"",""MDCLIO1"",171,0)"
^XMB(3.9,146043,2,584,0)="QRYLST(MDRET,MDDFN,MDITEM,MDSTRT,MDSTOP) ; Get list of observations by VUID or TERM NAME"
^XMB(3.9,146043,2,585,0)="""RTN"",""MDCLIO1"",172,0)"
^XMB(3.9,146043,2,586,0)=" N MDTERM"
^XMB(3.9,146043,2,587,0)="""RTN"",""MDCLIO1"",173,0)"
^XMB(3.9,146043,2,588,0)=" K @MDRET"
^XMB(3.9,146043,2,589,0)="""RTN"",""MDCLIO1"",174,0)"
^XMB(3.9,146043,2,590,0)=" S MDSTRT=$G(MDSTRT,DT\1) ; Default today @00:00"
^XMB(3.9,146043,2,591,0)="""RTN"",""MDCLIO1"",175,0)"
^XMB(3.9,146043,2,592,0)=" S MDSTOP=$G(MDSTOP,DT\1+.24) ; Default today @24:00"
^XMB(3.9,146043,2,593,0)="""RTN"",""MDCLIO1"",176,0)"
^XMB(3.9,146043,2,594,0)=" S MDTERM=$$FIND1^DIC(704.101,"""",""PKMX"",MDITEM,""C^VUID"",""I $P(^(0),U,5)=1"")"
^XMB(3.9,146043,2,595,0)="""RTN"",""MDCLIO1"",177,0)"
^XMB(3.9,146043,2,596,0)=" I MDTERM<1 S @MDRET@(0)=""-1^Cannot find term '""_MDITEM_""'"" Q"
^XMB(3.9,146043,2,597,0)="""RTN"",""MDCLIO1"",178,0)"
^XMB(3.9,146043,2,598,0)=" F X=MDSTRT-.0000001:0 S X=$O(^MDC(704.117,""PT"",MDDFN,X)) Q:'X!(X>MDSTOP)  D"
^XMB(3.9,146043,2,599,0)="""RTN"",""MDCLIO1"",179,0)"
^XMB(3.9,146043,2,600,0)=" .F Y=0:0 S Y=$O(^MDC(704.117,""PT"",MDDFN,X,Y)) Q:'Y  D"
^XMB(3.9,146043,2,601,0)="""RTN"",""MDCLIO1"",180,0)"
^XMB(3.9,146043,2,602,0)=" ..Q:$P(^MDC(704.117,Y,0),U,9)'=1"
^XMB(3.9,146043,2,603,0)="""RTN"",""MDCLIO1"",181,0)"
^XMB(3.9,146043,2,604,0)=" ..Q:$P(^MDC(704.117,Y,0),U,7)'=MDTERM"
^XMB(3.9,146043,2,605,0)="""RTN"",""MDCLIO1"",182,0)"
^XMB(3.9,146043,2,606,0)=" ..S @MDRET@($O(@MDRET@(""""),-1)+1)=$P(^MDC(704.117,Y,0),U)"
^XMB(3.9,146043,2,607,0)="""RTN"",""MDCLIO1"",183,0)"
^XMB(3.9,146043,2,608,0)=" S @MDRET@(0)=+$O(@MDRET@(""""),-1)"
^XMB(3.9,146043,2,609,0)="""RTN"",""MDCLIO1"",184,0)"
^XMB(3.9,146043,2,610,0)=" Q"
^XMB(3.9,146043,2,611,0)="""RTN"",""MDCLIO1"",185,0)"
^XMB(3.9,146043,2,612,0)=" ;"
^XMB(3.9,146043,2,613,0)="""RTN"",""MDCLIO1"",186,0)"
^XMB(3.9,146043,2,614,0)="QRYOBS(MDRET,MDID) ; Return a single observation"
^XMB(3.9,146043,2,615,0)="""RTN"",""MDCLIO1"",187,0)"
^XMB(3.9,146043,2,616,0)=" N MDTMP"
^XMB(3.9,146043,2,617,0)="""RTN"",""MDCLIO1"",188,0)"
^XMB(3.9,146043,2,618,0)=" K @MDRET"
^XMB(3.9,146043,2,619,0)="""RTN"",""MDCLIO1"",189,0)"
^XMB(3.9,146043,2,620,0)=" S MDIEN=$$FIND1^DIC(704.117,"""",""PKX"",MDID,""PK"")"
^XMB(3.9,146043,2,621,0)="""RTN"",""MDCLIO1"",190,0)"
^XMB(3.9,146043,2,622,0)=" I MDIEN<1 S @MDRET@(0)=""-1^No such observation '""_MDID_""'"" Q"
^XMB(3.9,146043,2,623,0)="""RTN"",""MDCLIO1"",191,0)"
^XMB(3.9,146043,2,624,0)=" D GETS^DIQ(704.117,MDIEN_"","",""*"",""EIR"",""MDTMP"")"
^XMB(3.9,146043,2,625,0)="""RTN"",""MDCLIO1"",192,0)"
^XMB(3.9,146043,2,626,0)=" M @MDRET=MDTMP(704.117,MDIEN_"","") K MDTMP"
^XMB(3.9,146043,2,627,0)="""RTN"",""MDCLIO1"",193,0)"
^XMB(3.9,146043,2,628,0)=" S @MDRET@(""TERM_ID"",""I"")=$$GET1^DIQ(704.117,MDIEN_"","","".07:99.99"")"
^XMB(3.9,146043,2,629,0)="""RTN"",""MDCLIO1"",194,0)"
^XMB(3.9,146043,2,630,0)=" S @MDRET@(""TERM_ID"",""E"")=$$GET1^DIQ(704.117,MDIEN_"","","".07:.02"")"
^XMB(3.9,146043,2,631,0)="""RTN"",""MDCLIO1"",195,0)"
^XMB(3.9,146043,2,632,0)=" D:$$GET1^DIQ(704.117,MDIEN_"","","".07:.06"",""I"")=3  ; Coded data values"
^XMB(3.9,146043,2,633,0)="""RTN"",""MDCLIO1"",196,0)"
^XMB(3.9,146043,2,634,0)=" .S MDTMP=$$FIND1^DIC(704.101,"""",""PKX"",@MDRET@(""SVALUE"",""I""),""PK"")"
^XMB(3.9,146043,2,635,0)="""RTN"",""MDCLIO1"",197,0)"
^XMB(3.9,146043,2,636,0)=" .S @MDRET@(""SVALUE"",""E"")=$$GET1^DIQ(704.101,MDTMP_"","",.02)"
^XMB(3.9,146043,2,637,0)="""RTN"",""MDCLIO1"",198,0)"
^XMB(3.9,146043,2,638,0)=" D QRYQUAL(MDRET,MDIEN)"
^XMB(3.9,146043,2,639,0)="""RTN"",""MDCLIO1"",199,0)"
^XMB(3.9,146043,2,640,0)=" D QRYCTX($NA(@MDRET@(""CONTEXT"")),MDID)"
^XMB(3.9,146043,2,641,0)="""RTN"",""MDCLIO1"",200,0)"
^XMB(3.9,146043,2,642,0)=" Q"
^XMB(3.9,146043,2,643,0)="""RTN"",""MDCLIO1"",201,0)"
^XMB(3.9,146043,2,644,0)=" ;"
^XMB(3.9,146043,2,645,0)="""RTN"",""MDCLIO1"",202,0)"
^XMB(3.9,146043,2,646,0)="QRYQUAL(MDRET,MDIEN) ; Returns the qualifiers for obs in MDIEN"
^XMB(3.9,146043,2,647,0)="""RTN"",""MDCLIO1"",203,0)"
^XMB(3.9,146043,2,648,0)=" N MDQUAL"
^XMB(3.9,146043,2,649,0)="""RTN"",""MDCLIO1"",204,0)"
^XMB(3.9,146043,2,650,0)=" F Y=0:0 S Y=$O(^MDC(704.118,""PK"",MDIEN,Y)) Q:'Y  D"
^XMB(3.9,146043,2,651,0)="""RTN"",""MDCLIO1"",205,0)"
^XMB(3.9,146043,2,652,0)=" .S MDQUAL=$$GET1^DIQ(704.101,Y_"","","".05:.02"")"
^XMB(3.9,146043,2,653,0)="""RTN"",""MDCLIO1"",206,0)"
^XMB(3.9,146043,2,654,0)=" .S @MDRET@(MDQUAL,""I"")=$$GET1^DIQ(704.101,Y_"","",""99.99"")"
^XMB(3.9,146043,2,655,0)="""RTN"",""MDCLIO1"",207,0)"
^XMB(3.9,146043,2,656,0)=" .S @MDRET@(MDQUAL,""E"")=$$GET1^DIQ(704.101,Y_"","","".02"")"
^XMB(3.9,146043,2,657,0)="""RTN"",""MDCLIO1"",208,0)"
^XMB(3.9,146043,2,658,0)=" Q"
^XMB(3.9,146043,2,659,0)="""RTN"",""MDCLIO1"",209,0)"
^XMB(3.9,146043,2,660,0)=" ;"
^XMB(3.9,146043,2,661,0)="""RTN"",""MDCLIO1"",210,0)"
^XMB(3.9,146043,2,662,0)="QRYCTX(MDRET,MDID) ; We need a terminology based context observation relationship here"
^XMB(3.9,146043,2,663,0)="""RTN"",""MDCLIO1"",211,0)"
^XMB(3.9,146043,2,664,0)=" N MDIEN,MDCTX,MDDT,MDFROM,MDTO,MDDFN,MDTERM,MDCNT,MDXID"
^XMB(3.9,146043,2,665,0)="""RTN"",""MDCLIO1"",212,0)"
^XMB(3.9,146043,2,666,0)=" S MDIEN=+$$FIND1^DIC(704.117,"""",""PKX"",MDID,""PK"") Q:MDIEN<1"
^XMB(3.9,146043,2,667,0)="""RTN"",""MDCLIO1"",213,0)"
^XMB(3.9,146043,2,668,0)=" S MDCTX=$$GET1^DIQ(704.117,MDIEN_"","",.07) ; GET THE PRIMARY TERM (GUID)"
^XMB(3.9,146043,2,669,0)="""RTN"",""MDCLIO1"",214,0)"
^XMB(3.9,146043,2,670,0)=" ; FILTER OUT EVERYTHING BUT SpO2 for now"
^XMB(3.9,146043,2,671,0)="""RTN"",""MDCLIO1"",215,0)"
^XMB(3.9,146043,2,672,0)=" Q:MDCTX'=""{5F84DD55-3CCF-094C-2536-B51EB7FAD999}"""
^XMB(3.9,146043,2,673,0)="""RTN"",""MDCLIO1"",216,0)"
^XMB(3.9,146043,2,674,0)=" S MDDFN=+$$GET1^DIQ(704.117,MDIEN_"","",.08,""I"") ; GET THE PATIENT"
^XMB(3.9,146043,2,675,0)="""RTN"",""MDCLIO1"",217,0)"
^XMB(3.9,146043,2,676,0)=" S MDDT=+$$GET1^DIQ(704.117,MDIEN_"","",.05,""I"") ; GET THE OBS DATE"
^XMB(3.9,146043,2,677,0)="""RTN"",""MDCLIO1"",218,0)"
^XMB(3.9,146043,2,678,0)=" S MDFROM=$$FMADD^XLFDT(MDDT,0,0,0,-30) ; PREVIOUS 30 SECONDS"
^XMB(3.9,146043,2,679,0)="""RTN"",""MDCLIO1"",219,0)"
^XMB(3.9,146043,2,680,0)=" S MDTO=$$FMADD^XLFDT(MDDT,0,0,0,30) ; NEXT 30 SECONDS"
^XMB(3.9,146043,2,681,0)="""RTN"",""MDCLIO1"",220,0)"
^XMB(3.9,146043,2,682,0)=" ; Now we find the context observations"
^XMB(3.9,146043,2,683,0)="""RTN"",""MDCLIO1"",221,0)"
^XMB(3.9,146043,2,684,0)=" F MDDT=MDFROM:0 S MDDT=$O(^MDC(704.117,""PT"",MDDFN,MDDT)) Q:'MDDT!(MDDT>MDTO)  D"
^XMB(3.9,146043,2,685,0)="""RTN"",""MDCLIO1"",222,0)"
^XMB(3.9,146043,2,686,0)=" .F MDOBS=0:0 S MDOBS=$O(^MDC(704.117,""PT"",MDDFN,MDDT,MDOBS)) Q:'MDOBS  D"
^XMB(3.9,146043,2,687,0)="""RTN"",""MDCLIO1"",223,0)"
^XMB(3.9,146043,2,688,0)=" ..Q:$$GET1^DIQ(704.117,MDOBS_"","",.09,""I"")'=1  ; Verfied Only"
^XMB(3.9,146043,2,689,0)="""RTN"",""MDCLIO1"",224,0)"
^XMB(3.9,146043,2,690,0)=" ..S MDXID=$$GET1^DIQ(704.117,MDOBS_"","",.01)"
^XMB(3.9,146043,2,691,0)="""RTN"",""MDCLIO1"",225,0)"
^XMB(3.9,146043,2,692,0)=" ..Q:MDXID=MDID  ; You should ignore yourself in this loop"
^XMB(3.9,146043,2,693,0)="""RTN"",""MDCLIO1"",226,0)"
^XMB(3.9,146043,2,694,0)=" ..S MDTERM=$$GET1^DIQ(704.117,MDOBS_"","","".07"")"
^XMB(3.9,146043,2,695,0)="""RTN"",""MDCLIO1"",227,0)"
^XMB(3.9,146043,2,696,0)=" ..; INSERT FILTER CODE FOR O2 Flowrate and Concentration here - In the future we will find all context terms for an observation in terminology"
^XMB(3.9,146043,2,697,0)="""RTN"",""MDCLIO1"",228,0)"
^XMB(3.9,146043,2,698,0)=" ..Q:(MDTERM'=""{56F82CAC-3564-46CE-A520-1025020DADE9}"")&(MDTERM'=""{3BB314E8-9BBB-480E-B34E-B56EDE43BAC4}"")"
^XMB(3.9,146043,2,699,0)="""RTN"",""MDCLIO1"",229,0)"
^XMB(3.9,146043,2,700,0)=" ..S MDCNT=$O(@MDRET@(""""),-1)+1,@MDRET@(0)=MDCNT"
^XMB(3.9,146043,2,701,0)="""RTN"",""MDCLIO1"",230,0)"
^XMB(3.9,146043,2,702,0)=" ..S @MDRET@(MDCNT,""OBS_ID"",""I"")=MDXID"
^XMB(3.9,146043,2,703,0)="""RTN"",""MDCLIO1"",231,0)"
^XMB(3.9,146043,2,704,0)=" ..S @MDRET@(MDCNT,""OBS_ID"",""E"")=MDXID"
^XMB(3.9,146043,2,705,0)="""RTN"",""MDCLIO1"",232,0)"
^XMB(3.9,146043,2,706,0)=" ..S @MDRET@(MDCNT,""TERM_ID"",""I"")=$$GET1^DIQ(704.117,MDOBS_"","","".07:99.99"")"
^XMB(3.9,146043,2,707,0)="""RTN"",""MDCLIO1"",233,0)"
^XMB(3.9,146043,2,708,0)=" ..S @MDRET@(MDCNT,""TERM_ID"",""E"")=$$GET1^DIQ(704.117,MDOBS_"","","".07:.02"")"
^XMB(3.9,146043,2,709,0)="""RTN"",""MDCLIO1"",234,0)"
^XMB(3.9,146043,2,710,0)=" ..S @MDRET@(MDCNT,""SVALUE"",""I"")=$$GET1^DIQ(704.117,MDOBS_"","","".1"",""I"")"
^XMB(3.9,146043,2,711,0)="""RTN"",""MDCLIO1"",235,0)"
^XMB(3.9,146043,2,712,0)=" ..S @MDRET@(MDCNT,""SVALUE"",""E"")=$$GET1^DIQ(704.117,MDOBS_"","","".1"",""E"")"
^XMB(3.9,146043,2,713,0)="""RTN"",""MDCLIO1"",236,0)"
^XMB(3.9,146043,2,714,0)=" ..D QRYQUAL($NA(@MDRET@(MDCNT)),MDOBS)"
^XMB(3.9,146043,2,715,0)="""RTN"",""MDCLIO1"",237,0)"
^XMB(3.9,146043,2,716,0)=" Q"
^XMB(3.9,146043,2,717,0)="""RTN"",""MDCLIO1"",238,0)"
^XMB(3.9,146043,2,718,0)="GETOBS(MDPAR) ; Get list of observations by date"
^XMB(3.9,146043,2,719,0)="""RTN"",""MDCLIO1"",239,0)"
