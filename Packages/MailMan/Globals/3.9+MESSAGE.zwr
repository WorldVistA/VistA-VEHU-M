^XMB(3.9,146017,2,1397,0)="""RTN"",""SDES2CANCLNAVAIL"",136,0)"
^XMB(3.9,146017,2,1398,0)=" .S APPTDATETIME=STARTDATETIME-.0001"
^XMB(3.9,146017,2,1399,0)="""RTN"",""SDES2CANCLNAVAIL"",137,0)"
^XMB(3.9,146017,2,1400,0)=" .F  S APPTDATETIME=$O(^SC(CLINICIEN,""S"",APPTDATETIME)) Q:'APPTDATETIME!(APPTDATETIME>=ENDDATETIME)!($D(ERRORS))  D"
