^XMB(3.9,146009,2,616,0)=" Q:$G(XUDUZ)'>0 0 Q:$G(SECID)="""" 0"
^XMB(3.9,146009,2,617,0)="""RTN"",""XUIAMNPB"",176,0)"
^XMB(3.9,146009,2,618,0)=" S (FND,IEN)=0 F  S IEN=$O(^VA(200,""ASECID"",$E(SECID,1,30),IEN)) Q:IEN'>0  I IEN'=XUDUZ S FND=1 Q"
^XMB(3.9,146009,2,619,0)="""RTN"",""XUIAMNPB"",177,0)"
^XMB(3.9,146009,2,620,0)=" Q FND"
^XMB(3.9,146009,2,621,0)="""RTN"",""XUIAMNPB"",178,0)"
^XMB(3.9,146009,2,622,0)=" ;"
^XMB(3.9,146009,2,623,0)="""RTN"",""XUIAMNPB"",179,0)"
^XMB(3.9,146009,2,624,0)="XMITFLG(XUMIEN) ;update transmission flag"
^XMB(3.9,146009,2,625,0)="""RTN"",""XUIAMNPB"",180,0)"
^XMB(3.9,146009,2,626,0)=" N XUFDA"
^XMB(3.9,146009,2,627,0)="""RTN"",""XUIAMNPB"",181,0)"
^XMB(3.9,146009,2,628,0)=" S XUFDA(8933.1,XUMIEN_"","",.03)=0 ;requires transmission = no"
^XMB(3.9,146009,2,629,0)="""RTN"",""XUIAMNPB"",182,0)"
^XMB(3.9,146009,2,630,0)=" S XUFDA(8933.1,XUMIEN_"","",.04)=$$NOW^XLFDT ;last transmitted date/time = now"
^XMB(3.9,146009,2,631,0)="""RTN"",""XUIAMNPB"",183,0)"
^XMB(3.9,146009,2,632,0)=" L +^XTV(8933.1,XUMIEN):10 I '$T Q"
^XMB(3.9,146009,2,633,0)="""RTN"",""XUIAMNPB"",184,0)"
^XMB(3.9,146009,2,634,0)=" D FILE^DIE("""",""XUFDA"")"
^XMB(3.9,146009,2,635,0)="""RTN"",""XUIAMNPB"",185,0)"
^XMB(3.9,146009,2,636,0)=" L -^XTV(8933.1,XUMIEN)"
^XMB(3.9,146009,2,637,0)="""RTN"",""XUIAMNPB"",186,0)"
^XMB(3.9,146009,2,638,0)=" Q"
^XMB(3.9,146009,2,639,0)="""RTN"",""XUIAMNPB"",187,0)"
^XMB(3.9,146009,2,640,0)=" ;"
^XMB(3.9,146009,2,641,0)="""RTN"",""XUIAMNPB"",188,0)"
^XMB(3.9,146009,2,642,0)="EN2 ;entry point for new person field monitor purge background job"
^XMB(3.9,146009,2,643,0)="""RTN"",""XUIAMNPB"",189,0)"
^XMB(3.9,146009,2,644,0)=" ;**663 - STORY 1203257 (dri) Background job to purge New Person Field Monitor file"
^XMB(3.9,146009,2,645,0)="""RTN"",""XUIAMNPB"",190,0)"
^XMB(3.9,146009,2,646,0)=" ; **799 VAMPI-22625          Option Name: XUS IAM NPFM PURGE"
^XMB(3.9,146009,2,647,0)="""RTN"",""XUIAMNPB"",191,0)"
^XMB(3.9,146009,2,648,0)=" ;"
^XMB(3.9,146009,2,649,0)="""RTN"",""XUIAMNPB"",192,0)"
^XMB(3.9,146009,2,650,0)=" ;attempt lock to insure only one process running"
^XMB(3.9,146009,2,651,0)="""RTN"",""XUIAMNPB"",193,0)"
^XMB(3.9,146009,2,652,0)=" L +^XTV(8933.1,""XUS IAM NPFM PURGE""):1 I '$T Q"
^XMB(3.9,146009,2,653,0)="""RTN"",""XUIAMNPB"",194,0)"
^XMB(3.9,146009,2,654,0)=" N DA,DIK,X1,X2,X,XUDAT,XUDOMIEN,XUMIEN,XUPRGDAY,XURETDAT,XUSER"
^XMB(3.9,146009,2,655,0)="""RTN"",""XUIAMNPB"",195,0)"
^XMB(3.9,146009,2,656,0)=" S XUDOMIEN=$O(^XTV(8989.3,0)) I 'XUDOMIEN Q  ;domain"
^XMB(3.9,146009,2,657,0)="""RTN"",""XUIAMNPB"",196,0)"
^XMB(3.9,146009,2,658,0)=" S XUPRGDAY=$$GET1^DIQ(8989.3,XUDOMIEN_"","",875,""I"") ;new person field monitor purge - days of transmitted data to retain."
^XMB(3.9,146009,2,659,0)="""RTN"",""XUIAMNPB"",197,0)"
^XMB(3.9,146009,2,660,0)=" I 'XUPRGDAY S XUPRGDAY=365 ;default if not defined"
^XMB(3.9,146009,2,661,0)="""RTN"",""XUIAMNPB"",198,0)"
^XMB(3.9,146009,2,662,0)=" S X1=DT,X2=-XUPRGDAY D C^%DTC S XURETDAT=X ;retain date"
^XMB(3.9,146009,2,663,0)="""RTN"",""XUIAMNPB"",199,0)"
^XMB(3.9,146009,2,664,0)=" S XUDAT=0 F  S XUDAT=$O(^XTV(8933.1,""B"",XUDAT)) Q:'XUDAT!(XUDAT>XURETDAT)  D"
^XMB(3.9,146009,2,665,0)="""RTN"",""XUIAMNPB"",200,0)"
^XMB(3.9,146009,2,666,0)=" .S XUMIEN=0 F  S XUMIEN=$O(^XTV(8933.1,""B"",XUDAT,XUMIEN)) Q:'XUMIEN  S XUSER=+$P($G(^XTV(8933.1,XUMIEN,0)),""^"",2) I '$D(^XTV(8933.1,""ACXMIT"",XUSER,XUMIEN)) D  ;if not pending transmission then"
^XMB(3.9,146009,2,667,0)="""RTN"",""XUIAMNPB"",201,0)"
^XMB(3.9,146009,2,668,0)=" ..S DA=XUMIEN,DIK=""^XTV(8933.1,"" D ^DIK ;delete"
^XMB(3.9,146009,2,669,0)="""RTN"",""XUIAMNPB"",202,0)"
^XMB(3.9,146009,2,670,0)=" L -^XTV(8933.1,""XUS IAM NPFM PURGE"")"
^XMB(3.9,146009,2,671,0)="""RTN"",""XUIAMNPB"",203,0)"
^XMB(3.9,146009,2,672,0)=" Q"
^XMB(3.9,146009,2,673,0)="""RTN"",""XUIAMNPB"",204,0)"
^XMB(3.9,146009,2,674,0)=" ;"
^XMB(3.9,146009,2,675,0)="""RTN"",""XUIAMRPC"")"
^XMB(3.9,146009,2,676,0)="1^3"
^XMB(3.9,146009,2,677,0)="""RTN"",""XUMVINPB"")"
^XMB(3.9,146009,2,678,0)="0^1^B149133444"
^XMB(3.9,146009,2,679,0)="""RTN"",""XUMVINPB"",1,0)"
^XMB(3.9,146009,2,680,0)="XUMVINPB ;MVI/DRI - Master Veteran Index New Person Bulk Pull RPC ;7/29/20  13:59"
