^XMB(3.9,146056,2,1328,0)=" ;"
^XMB(3.9,146056,2,1329,0)="""RTN"",""VPREVNT"",38,0)"
^XMB(3.9,146056,2,1330,0)="DG ; -- DG FIELD MONITOR protocol listener"
^XMB(3.9,146056,2,1331,0)="""RTN"",""VPREVNT"",39,0)"
^XMB(3.9,146056,2,1332,0)=" ;   [expects variables DGDA, DGFIELD, DGFILE]"
^XMB(3.9,146056,2,1333,0)="""RTN"",""VPREVNT"",40,0)"
^XMB(3.9,146056,2,1334,0)=" N VPRFN S VPRFN=$G(DGFILE)"
^XMB(3.9,146056,2,1335,0)="""RTN"",""VPREVNT"",41,0)"
^XMB(3.9,146056,2,1336,0)=" I ""^2^2.01^2.02^2.06^38.1^""'[(U_VPRFN_U) Q"
^XMB(3.9,146056,2,1337,0)="""RTN"",""VPREVNT"",42,0)"
^XMB(3.9,146056,2,1338,0)=" N DFN S DFN=+$G(DGDA)"
^XMB(3.9,146056,2,1339,0)="""RTN"",""VPREVNT"",43,0)"
^XMB(3.9,146056,2,1340,0)=" ; collect individual fields into single tasked update if possible"
^XMB(3.9,146056,2,1341,0)="""RTN"",""VPREVNT"",44,0)"
^XMB(3.9,146056,2,1342,0)=" D QUE^VPRHS(DFN) Q  ;skip fld check"
^XMB(3.9,146056,2,1343,0)="""RTN"",""VPREVNT"",45,0)"
^XMB(3.9,146056,2,1344,0)=" I VPRFN=2 D:$$FLD(+$G(DGFIELD)) QUE^VPRHS(DFN) Q"
^XMB(3.9,146056,2,1345,0)="""RTN"",""VPREVNT"",46,0)"
^XMB(3.9,146056,2,1346,0)=" D POST^VPRHS(DFN,""Patient"",DFN_"";2"")"
^XMB(3.9,146056,2,1347,0)="""RTN"",""VPREVNT"",47,0)"
^XMB(3.9,146056,2,1348,0)=" Q"
^XMB(3.9,146056,2,1349,0)="""RTN"",""VPREVNT"",48,0)"
^XMB(3.9,146056,2,1350,0)=" ;"
^XMB(3.9,146056,2,1351,0)="""RTN"",""VPREVNT"",49,0)"
^XMB(3.9,146056,2,1352,0)="FLD(X) ; -- Return 1 or 0, if X is a field tracked by VPR"
^XMB(3.9,146056,2,1353,0)="""RTN"",""VPREVNT"",50,0)"
^XMB(3.9,146056,2,1354,0)=" ;    via DG FIELD MONITOR"
^XMB(3.9,146056,2,1355,0)="""RTN"",""VPREVNT"",51,0)"
^XMB(3.9,146056,2,1356,0)=" S X=U_+$G(X)_U"
^XMB(3.9,146056,2,1357,0)="""RTN"",""VPREVNT"",52,0)"
^XMB(3.9,146056,2,1358,0)=" I ""^.01^.02^.03^.05^.07^.08^.09^.092^.093^.351^""[X Q 1     ;demographic"
^XMB(3.9,146056,2,1359,0)="""RTN"",""VPREVNT"",53,0)"
^XMB(3.9,146056,2,1360,0)=" I ""^.111^.1112^.112^.113^.114^.115^.131^.132^.134^""[X Q 1  ;addr/phone"
^XMB(3.9,146056,2,1361,0)="""RTN"",""VPREVNT"",54,0)"
^XMB(3.9,146056,2,1362,0)=" I ""^.211^.212^.213^.214^.216^.217^.218^.219^.21011^""[X Q 1 ;NOK"
^XMB(3.9,146056,2,1363,0)="""RTN"",""VPREVNT"",55,0)"
^XMB(3.9,146056,2,1364,0)=" I ""^.331^.332^.333^.334^.335^.336^.337^.338^.339^""[X Q 1   ;ECON"
^XMB(3.9,146056,2,1365,0)="""RTN"",""VPREVNT"",56,0)"
^XMB(3.9,146056,2,1366,0)=" I ""^.301^.302^.32102^.32103^.3215^.32201^.5295^""[X Q 1     ;serv conn"
^XMB(3.9,146056,2,1367,0)="""RTN"",""VPREVNT"",57,0)"
^XMB(3.9,146056,2,1368,0)=" I ""^.14^.323^.361^1901^""[X Q 1"
^XMB(3.9,146056,2,1369,0)="""RTN"",""VPREVNT"",58,0)"
^XMB(3.9,146056,2,1370,0)=" Q 0"
^XMB(3.9,146056,2,1371,0)="""RTN"",""VPREVNT"",59,0)"
^XMB(3.9,146056,2,1372,0)=" ;"
^XMB(3.9,146056,2,1373,0)="""RTN"",""VPREVNT"",60,0)"
^XMB(3.9,146056,2,1374,0)="NEWINPT() ; -- is DFN newly admitted?"
^XMB(3.9,146056,2,1375,0)="""RTN"",""VPREVNT"",61,0)"
^XMB(3.9,146056,2,1376,0)=" N Y S Y=0"
^XMB(3.9,146056,2,1377,0)="""RTN"",""VPREVNT"",62,0)"
^XMB(3.9,146056,2,1378,0)=" I DGPMT=1,DGPMA,'DGPMP,+$G(^DPT(DFN,.105))=DGPMDA S Y=1 ;new admission"
^XMB(3.9,146056,2,1379,0)="""RTN"",""VPREVNT"",63,0)"
