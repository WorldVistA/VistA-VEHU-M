^XMB(3.9,146098,2,2006,0)=" .S SDECI=SDECI+1 S ^TMP(""SDEC"",$J,SDECI)=""     Date/Time: ""_DOW_""  ""_$J(SDDAT,12)_$S('$D(LEXPROC)&$D(SDC):$J(SDT0,9),1:"""")_"" ""_TIMEZONE"
