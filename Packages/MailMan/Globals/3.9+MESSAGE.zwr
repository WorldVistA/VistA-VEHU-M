^XMB(3.9,146052,2,2491,0)="""RTN"",""FBUCMEA"")"
^XMB(3.9,146052,2,2492,0)="0^17^B4999762"
^XMB(3.9,146052,2,2493,0)="""RTN"",""FBUCMEA"",1,0)"
^XMB(3.9,146052,2,2494,0)="FBUCMEA ;WOIFO/SAB-UNAUTHORIZED CLAIM MAIN MENU ENTRY ACTION ;12/17/2001"
^XMB(3.9,146052,2,2495,0)="""RTN"",""FBUCMEA"",2,0)"
^XMB(3.9,146052,2,2496,0)=" ;;3.5;FEE BASIS;**38**;JAN 30, 1995;Build 0"
^XMB(3.9,146052,2,2497,0)="""RTN"",""FBUCMEA"",3,0)"
^XMB(3.9,146052,2,2498,0)=" ;;Per VHA Directive 10-93-142, this routine should not be modified."
^XMB(3.9,146052,2,2499,0)="""RTN"",""FBUCMEA"",4,0)"
^XMB(3.9,146052,2,2500,0)=" N DFN,DIR,FBDA,FBDT,FBEXP,FBFR,FBO,FBOUT,FBPG,FBTO,FBVET,FBX,FBY"
^XMB(3.9,146052,2,2501,0)="""RTN"",""FBUCMEA"",5,0)"
^XMB(3.9,146052,2,2502,0)=" ;"
^XMB(3.9,146052,2,2503,0)="""RTN"",""FBUCMEA"",6,0)"
^XMB(3.9,146052,2,2504,0)=" ; gather data"
^XMB(3.9,146052,2,2505,0)="""RTN"",""FBUCMEA"",7,0)"
^XMB(3.9,146052,2,2506,0)=" N VADM,X,Y"
^XMB(3.9,146052,2,2507,0)="""RTN"",""FBUCMEA"",8,0)"
^XMB(3.9,146052,2,2508,0)=" K ^TMP(""FBEX"",$J)"
^XMB(3.9,146052,2,2509,0)="""RTN"",""FBUCMEA"",9,0)"
^XMB(3.9,146052,2,2510,0)=" S FBTO=$$FMADD^XLFDT(DT,6)"
^XMB(3.9,146052,2,2511,0)="""RTN"",""FBUCMEA"",10,0)"
^XMB(3.9,146052,2,2512,0)=" F FBO=10,55 D"
^XMB(3.9,146052,2,2513,0)="""RTN"",""FBUCMEA"",11,0)"
^XMB(3.9,146052,2,2514,0)=" . S FBDT=-(FBTO+.1)"
^XMB(3.9,146052,2,2515,0)="""RTN"",""FBUCMEA"",12,0)"
^XMB(3.9,146052,2,2516,0)=" . F  S FBDT=$O(^FB583(""AES"",FBO,FBDT)) Q:FBDT']""""  D"
^XMB(3.9,146052,2,2517,0)="""RTN"",""FBUCMEA"",13,0)"
^XMB(3.9,146052,2,2518,0)=" . . S FBDA=0 F  S FBDA=$O(^FB583(""AES"",FBO,FBDT,FBDA)) Q:'FBDA  D"
^XMB(3.9,146052,2,2519,0)="""RTN"",""FBUCMEA"",14,0)"
^XMB(3.9,146052,2,2520,0)=" . . . S FBY=$G(^FB583(FBDA,0))"
^XMB(3.9,146052,2,2521,0)="""RTN"",""FBUCMEA"",15,0)"
^XMB(3.9,146052,2,2522,0)=" . . . S FBEXP=$P(FBY,U,26)"
^XMB(3.9,146052,2,2523,0)="""RTN"",""FBUCMEA"",16,0)"
^XMB(3.9,146052,2,2524,0)=" . . . S FBVET=$$VET^FBUCUTL($P(FBY,U,4))"
^XMB(3.9,146052,2,2525,0)="""RTN"",""FBUCMEA"",17,0)"
^XMB(3.9,146052,2,2526,0)=" . . . S ^TMP(""FBEX"",$J,FBEXP,FBVET_"";""_$P(FBY,U,4),FBDA)="""""
^XMB(3.9,146052,2,2527,0)="""RTN"",""FBUCMEA"",18,0)"
^XMB(3.9,146052,2,2528,0)=" ;"
^XMB(3.9,146052,2,2529,0)="""RTN"",""FBUCMEA"",19,0)"
^XMB(3.9,146052,2,2530,0)=" ; display resutls"
^XMB(3.9,146052,2,2531,0)="""RTN"",""FBUCMEA"",20,0)"
^XMB(3.9,146052,2,2532,0)=" I $D(^TMP(""FBEX"",$J)) D"
^XMB(3.9,146052,2,2533,0)="""RTN"",""FBUCMEA"",21,0)"
^XMB(3.9,146052,2,2534,0)=" . S FBPG=0,FBOUT=0 D HD"
^XMB(3.9,146052,2,2535,0)="""RTN"",""FBUCMEA"",22,0)"
^XMB(3.9,146052,2,2536,0)=" . S FBEXP="""" F  S FBEXP=$O(^TMP(""FBEX"",$J,FBEXP)) Q:FBEXP=""""  D  Q:FBOUT"
^XMB(3.9,146052,2,2537,0)="""RTN"",""FBUCMEA"",23,0)"
^XMB(3.9,146052,2,2538,0)=" . . S FBX="""" F  S FBX=$O(^TMP(""FBEX"",$J,FBEXP,FBX)) Q:FBX=""""  D  Q:FBOUT"
^XMB(3.9,146052,2,2539,0)="""RTN"",""FBUCMEA"",24,0)"
^XMB(3.9,146052,2,2540,0)=" . . . S FBDA=0"
^XMB(3.9,146052,2,2541,0)="""RTN"",""FBUCMEA"",25,0)"
^XMB(3.9,146052,2,2542,0)=" . . . F  S FBDA=$O(^TMP(""FBEX"",$J,FBEXP,FBX,FBDA)) Q:'FBDA  D  Q:FBOUT"
^XMB(3.9,146052,2,2543,0)="""RTN"",""FBUCMEA"",26,0)"
^XMB(3.9,146052,2,2544,0)=" . . . . S FBY=$G(^FB583(FBDA,0))"
^XMB(3.9,146052,2,2545,0)="""RTN"",""FBUCMEA"",27,0)"
^XMB(3.9,146052,2,2546,0)=" . . . . S DFN=$P(FBY,U,4)"
^XMB(3.9,146052,2,2547,0)="""RTN"",""FBUCMEA"",28,0)"
^XMB(3.9,146052,2,2548,0)=" . . . . D DEM^VADPT"
^XMB(3.9,146052,2,2549,0)="""RTN"",""FBUCMEA"",29,0)"
^XMB(3.9,146052,2,2550,0)=" . . . . I $Y+6>IOSL D HD Q:FBOUT"
^XMB(3.9,146052,2,2551,0)="""RTN"",""FBUCMEA"",30,0)"
^XMB(3.9,146052,2,2552,0)=" . . . . W !,$E($P(FBX,"";""),1,20),?22,$P(VADM(2),U,2)"
^XMB(3.9,146052,2,2553,0)="""RTN"",""FBUCMEA"",31,0)"
^XMB(3.9,146052,2,2554,0)=" . . . . W ?36,$E($$VEN^FBUCUTL($P(FBY,U,3)),1,20)"
^XMB(3.9,146052,2,2555,0)="""RTN"",""FBUCMEA"",32,0)"
