^XMB(3.9,146041,2,2675,0)="""RTN"",""SDES2PROVSEARCH"",18,0)"
^XMB(3.9,146041,2,2676,0)=" ; SDCONTEXT(""PATIENT DFN"") = The DFN/IEN of the target patient from the calling application."
^XMB(3.9,146041,2,2677,0)="""RTN"",""SDES2PROVSEARCH"",19,0)"
^XMB(3.9,146041,2,2678,0)=" ; SDCONTEXT(""PATIENT ICN"") = The ICN of the target patient from the calling application."
^XMB(3.9,146041,2,2679,0)="""RTN"",""SDES2PROVSEARCH"",20,0)"
^XMB(3.9,146041,2,2680,0)=" ; SDCONTEXT(""USER DUZ"") = The DUZ of the user taking action in the calling application."
^XMB(3.9,146041,2,2681,0)="""RTN"",""SDES2PROVSEARCH"",21,0)"
^XMB(3.9,146041,2,2682,0)=" ; SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the calling application."
^XMB(3.9,146041,2,2683,0)="""RTN"",""SDES2PROVSEARCH"",22,0)"
^XMB(3.9,146041,2,2684,0)=" ;"
^XMB(3.9,146041,2,2685,0)="""RTN"",""SDES2PROVSEARCH"",23,0)"
^XMB(3.9,146041,2,2686,0)=" ; SDINPUT(""SEARCHSTRING"") = The string to be used to search for active providers."
^XMB(3.9,146041,2,2687,0)="""RTN"",""SDES2PROVSEARCH"",24,0)"
^XMB(3.9,146041,2,2688,0)=" ;"
^XMB(3.9,146041,2,2689,0)="""RTN"",""SDES2PROVSEARCH"",25,0)"
^XMB(3.9,146041,2,2690,0)=" ; OUTPUT - SDRETURN"
^XMB(3.9,146041,2,2691,0)="""RTN"",""SDES2PROVSEARCH"",26,0)"
^XMB(3.9,146041,2,2692,0)=" ;   List of a providers' details from the NEW PERSON (#200) file that meets the search criteria."
^XMB(3.9,146041,2,2693,0)="""RTN"",""SDES2PROVSEARCH"",27,0)"
^XMB(3.9,146041,2,2694,0)=" ;"
^XMB(3.9,146041,2,2695,0)="""RTN"",""SDES2PROVSEARCH"",28,0)"
^XMB(3.9,146041,2,2696,0)=" N USERLIST,SDERRORS,SDRETURN,SEARCHSTRING,PROVIDERETURN,PROVIDERLIST"
^XMB(3.9,146041,2,2697,0)="""RTN"",""SDES2PROVSEARCH"",29,0)"
^XMB(3.9,146041,2,2698,0)=" ;"
^XMB(3.9,146041,2,2699,0)="""RTN"",""SDES2PROVSEARCH"",30,0)"
^XMB(3.9,146041,2,2700,0)=" ; Validate SDCONTEXT"
^XMB(3.9,146041,2,2701,0)="""RTN"",""SDES2PROVSEARCH"",31,0)"
^XMB(3.9,146041,2,2702,0)=" D VALCONTEXT^SDES2VALCONTEXT(.SDERRORS,.SDCONTEXT)"
^XMB(3.9,146041,2,2703,0)="""RTN"",""SDES2PROVSEARCH"",32,0)"
^XMB(3.9,146041,2,2704,0)=" I $D(SDERRORS) M SDRETURN=SDERRORS S SDRETURN(""Provider"",1)="""" D BUILDJSON^SDES2JSON(.JSONRETURN,.SDRETURN) Q"
^XMB(3.9,146041,2,2705,0)="""RTN"",""SDES2PROVSEARCH"",33,0)"
^XMB(3.9,146041,2,2706,0)=" I $G(SDCONTEXT(""USER DUZ""))'="""" N DUZ D DUZ^XUP(SDCONTEXT(""USER DUZ""))"
^XMB(3.9,146041,2,2707,0)="""RTN"",""SDES2PROVSEARCH"",34,0)"
^XMB(3.9,146041,2,2708,0)=" ;"
^XMB(3.9,146041,2,2709,0)="""RTN"",""SDES2PROVSEARCH"",35,0)"
^XMB(3.9,146041,2,2710,0)=" ; Validate SDINPUT"
^XMB(3.9,146041,2,2711,0)="""RTN"",""SDES2PROVSEARCH"",36,0)"
^XMB(3.9,146041,2,2712,0)=" S SEARCHSTRING=$G(SDINPUT(""SEARCHSTRING""))"
^XMB(3.9,146041,2,2713,0)="""RTN"",""SDES2PROVSEARCH"",37,0)"
^XMB(3.9,146041,2,2714,0)=" S SEARCHSTRING=$TR(SEARCHSTRING,$C(13)_$C(10)_$C(9),"""")"
^XMB(3.9,146041,2,2715,0)="""RTN"",""SDES2PROVSEARCH"",38,0)"
^XMB(3.9,146041,2,2716,0)=" D VALIDATEINPUT(.SDERRORS,SEARCHSTRING)"
^XMB(3.9,146041,2,2717,0)="""RTN"",""SDES2PROVSEARCH"",39,0)"
^XMB(3.9,146041,2,2718,0)=" I $D(SDERRORS) M SDRETURN=SDERRORS S SDRETURN(""Provider"",1)="""" D BUILDJSON^SDES2JSON(.JSONRETURN,.SDRETURN) Q"
^XMB(3.9,146041,2,2719,0)="""RTN"",""SDES2PROVSEARCH"",40,0)"
^XMB(3.9,146041,2,2720,0)=" ;"
^XMB(3.9,146041,2,2721,0)="""RTN"",""SDES2PROVSEARCH"",41,0)"
^XMB(3.9,146041,2,2722,0)=" ; Find list of matching users"
^XMB(3.9,146041,2,2723,0)="""RTN"",""SDES2PROVSEARCH"",42,0)"
^XMB(3.9,146041,2,2724,0)=" D GETUSERLIST(.USERLIST,SEARCHSTRING)"
^XMB(3.9,146041,2,2725,0)="""RTN"",""SDES2PROVSEARCH"",43,0)"
^XMB(3.9,146041,2,2726,0)=" ;"
^XMB(3.9,146041,2,2727,0)="""RTN"",""SDES2PROVSEARCH"",44,0)"
^XMB(3.9,146041,2,2728,0)=" ; Filter out non-providers and inactive users"
^XMB(3.9,146041,2,2729,0)="""RTN"",""SDES2PROVSEARCH"",45,0)"
^XMB(3.9,146041,2,2730,0)=" D BLDPROVIDERLIST(.PROVIDERLIST,.USERLIST)"
^XMB(3.9,146041,2,2731,0)="""RTN"",""SDES2PROVSEARCH"",46,0)"
^XMB(3.9,146041,2,2732,0)=" ;"
^XMB(3.9,146041,2,2733,0)="""RTN"",""SDES2PROVSEARCH"",47,0)"
^XMB(3.9,146041,2,2734,0)=" ; Prepare return array"
^XMB(3.9,146041,2,2735,0)="""RTN"",""SDES2PROVSEARCH"",48,0)"
^XMB(3.9,146041,2,2736,0)=" D BUILDRETURN(.PROVIDERETURN,.PROVIDERLIST)"
^XMB(3.9,146041,2,2737,0)="""RTN"",""SDES2PROVSEARCH"",49,0)"
^XMB(3.9,146041,2,2738,0)=" D BUILDJSON^SDES2JSON(.JSONRETURN,.PROVIDERETURN)"
^XMB(3.9,146041,2,2739,0)="""RTN"",""SDES2PROVSEARCH"",50,0)"
^XMB(3.9,146041,2,2740,0)=" Q"
^XMB(3.9,146041,2,2741,0)="""RTN"",""SDES2PROVSEARCH"",51,0)"
^XMB(3.9,146041,2,2742,0)=" ;"
^XMB(3.9,146041,2,2743,0)="""RTN"",""SDES2PROVSEARCH"",52,0)"
^XMB(3.9,146041,2,2744,0)="VALIDATEINPUT(ERRORLIST,SEARCHSTRING) ; validate incoming parameters"
^XMB(3.9,146041,2,2745,0)="""RTN"",""SDES2PROVSEARCH"",53,0)"
^XMB(3.9,146041,2,2746,0)=" ; input - ERRORLIST = passed in by reference, represents the errors that could be generated when validating the searchstring"
^XMB(3.9,146041,2,2747,0)="""RTN"",""SDES2PROVSEARCH"",54,0)"
^XMB(3.9,146041,2,2748,0)=" ;         SEARCHSTRING = represents the name or partial name of the provider"
^XMB(3.9,146041,2,2749,0)="""RTN"",""SDES2PROVSEARCH"",55,0)"
^XMB(3.9,146041,2,2750,0)=" I ($L(SEARCHSTRING)<3)!($L(SEARCHSTRING)>35) D ERRLOG^SDES2JSON(.ERRORLIST,230)"
^XMB(3.9,146041,2,2751,0)="""RTN"",""SDES2PROVSEARCH"",56,0)"
^XMB(3.9,146041,2,2752,0)=" Q"
^XMB(3.9,146041,2,2753,0)="""RTN"",""SDES2PROVSEARCH"",57,0)"
^XMB(3.9,146041,2,2754,0)=" ;"
^XMB(3.9,146041,2,2755,0)="""RTN"",""SDES2PROVSEARCH"",58,0)"
^XMB(3.9,146041,2,2756,0)="GETUSERLIST(USERLIST,SEARCHSTRING) ; pull matching providers using the first input parameter passed in by the RPC"
^XMB(3.9,146041,2,2757,0)="""RTN"",""SDES2PROVSEARCH"",59,0)"
^XMB(3.9,146041,2,2758,0)=" ; Input - SEARCHSTRING = string that represents the name of the person"
^XMB(3.9,146041,2,2759,0)="""RTN"",""SDES2PROVSEARCH"",60,0)"
^XMB(3.9,146041,2,2760,0)=" ;         USERLIST = passed in by reference; represents the array that will be returned as output"
^XMB(3.9,146041,2,2761,0)="""RTN"",""SDES2PROVSEARCH"",61,0)"
^XMB(3.9,146041,2,2762,0)=" ; Output - USERLIST = list of USER names and internal entry numbers from NEW PERSON file (200)"
^XMB(3.9,146041,2,2763,0)="""RTN"",""SDES2PROVSEARCH"",62,0)"
^XMB(3.9,146041,2,2764,0)=" N C,RESULTS,SUBIEN,USERDUZ"
^XMB(3.9,146041,2,2765,0)="""RTN"",""SDES2PROVSEARCH"",63,0)"
^XMB(3.9,146041,2,2766,0)=" K USERLIST"
^XMB(3.9,146041,2,2767,0)="""RTN"",""SDES2PROVSEARCH"",64,0)"
^XMB(3.9,146041,2,2768,0)=" S SUBIEN=0"
^XMB(3.9,146041,2,2769,0)="""RTN"",""SDES2PROVSEARCH"",65,0)"
^XMB(3.9,146041,2,2770,0)=" D FIND^DIC(200,,""@;.01"",,SEARCHSTRING,,,,,""RESULTS"")"
^XMB(3.9,146041,2,2771,0)="""RTN"",""SDES2PROVSEARCH"",66,0)"
^XMB(3.9,146041,2,2772,0)=" F  S SUBIEN=$O(RESULTS(""DILIST"",2,SUBIEN)) Q:SUBIEN=""""  D"
^XMB(3.9,146041,2,2773,0)="""RTN"",""SDES2PROVSEARCH"",67,0)"
^XMB(3.9,146041,2,2774,0)=" . S USERDUZ=RESULTS(""DILIST"",2,SUBIEN)"
^XMB(3.9,146041,2,2775,0)="""RTN"",""SDES2PROVSEARCH"",68,0)"
^XMB(3.9,146041,2,2776,0)=" . S USERLIST(USERDUZ)=RESULTS(""DILIST"",""ID"",SUBIEN,.01)"
^XMB(3.9,146041,2,2777,0)="""RTN"",""SDES2PROVSEARCH"",69,0)"
^XMB(3.9,146041,2,2778,0)=" Q"
^XMB(3.9,146041,2,2779,0)="""RTN"",""SDES2PROVSEARCH"",70,0)"
^XMB(3.9,146041,2,2780,0)=" ;"
^XMB(3.9,146041,2,2781,0)="""RTN"",""SDES2PROVSEARCH"",71,0)"
^XMB(3.9,146041,2,2782,0)="BLDPROVIDERLIST(PROVIDERLIST,USERLIST) ;"
^XMB(3.9,146041,2,2783,0)="""RTN"",""SDES2PROVSEARCH"",72,0)"
^XMB(3.9,146041,2,2784,0)=" ; input - USERLIST = list of USER names and internal entry numbers from NEW PERSON file (200)"
^XMB(3.9,146041,2,2785,0)="""RTN"",""SDES2PROVSEARCH"",73,0)"
^XMB(3.9,146041,2,2786,0)=" ;         PROVIDERLIST = passed by reference, represents the screened list of actual providers that are active"
^XMB(3.9,146041,2,2787,0)="""RTN"",""SDES2PROVSEARCH"",74,0)"
^XMB(3.9,146041,2,2788,0)=" ; output - PROVIDERLIST = array of active providers"
^XMB(3.9,146041,2,2789,0)="""RTN"",""SDES2PROVSEARCH"",75,0)"
^XMB(3.9,146041,2,2790,0)=" N USERDUZ"
^XMB(3.9,146041,2,2791,0)="""RTN"",""SDES2PROVSEARCH"",76,0)"
^XMB(3.9,146041,2,2792,0)=" S USERDUZ=0"
^XMB(3.9,146041,2,2793,0)="""RTN"",""SDES2PROVSEARCH"",77,0)"
^XMB(3.9,146041,2,2794,0)=" F  S USERDUZ=$O(USERLIST(USERDUZ)) Q:'USERDUZ  D"
^XMB(3.9,146041,2,2795,0)="""RTN"",""SDES2PROVSEARCH"",78,0)"
^XMB(3.9,146041,2,2796,0)=" . I '$$ACTIVPRV^PXAPI(USERDUZ,DT)!('$$ACTIVE^XUSER(USERDUZ)) Q"
^XMB(3.9,146041,2,2797,0)="""RTN"",""SDES2PROVSEARCH"",79,0)"
^XMB(3.9,146041,2,2798,0)=" . S PROVIDERLIST(USERDUZ)="""""
^XMB(3.9,146041,2,2799,0)="""RTN"",""SDES2PROVSEARCH"",80,0)"
^XMB(3.9,146041,2,2800,0)=" Q"
^XMB(3.9,146041,2,2801,0)="""RTN"",""SDES2PROVSEARCH"",81,0)"
^XMB(3.9,146041,2,2802,0)=" ;"
^XMB(3.9,146041,2,2803,0)="""RTN"",""SDES2PROVSEARCH"",82,0)"
^XMB(3.9,146041,2,2804,0)="BUILDRETURN(PROVIDERETURN,PROVIDERLIST) ;Build return array with provider data"
^XMB(3.9,146041,2,2805,0)="""RTN"",""SDES2PROVSEARCH"",83,0)"
^XMB(3.9,146041,2,2806,0)=" ; input - PROVIDERLIST = array of active providers"
^XMB(3.9,146041,2,2807,0)="""RTN"",""SDES2PROVSEARCH"",84,0)"
^XMB(3.9,146041,2,2808,0)=" ;         PROVIDERETURN = passed by reference, represents the array of providers and associated data that will be returned to the client"
^XMB(3.9,146041,2,2809,0)="""RTN"",""SDES2PROVSEARCH"",85,0)"
^XMB(3.9,146041,2,2810,0)=" ; output - PROVIDERETURN = provider array and their associated data to be sent back to the client"
^XMB(3.9,146041,2,2811,0)="""RTN"",""SDES2PROVSEARCH"",86,0)"
^XMB(3.9,146041,2,2812,0)=" ;"
^XMB(3.9,146041,2,2813,0)="""RTN"",""SDES2PROVSEARCH"",87,0)"
^XMB(3.9,146041,2,2814,0)=" N PROVIDERDATA,IEN,IENS,INFO,RECORDNUMBER"
^XMB(3.9,146041,2,2815,0)="""RTN"",""SDES2PROVSEARCH"",88,0)"
^XMB(3.9,146041,2,2816,0)=" S (RECORDNUMBER,IEN)=0"
^XMB(3.9,146041,2,2817,0)="""RTN"",""SDES2PROVSEARCH"",89,0)"
^XMB(3.9,146041,2,2818,0)=" F  S IEN=$O(PROVIDERLIST(IEN)) Q:'IEN  D GETS^DIQ(200,IEN_"","","".01;.131:.138;.151;8;53.5;205.1"",""IE"",""INFO"") D"
^XMB(3.9,146041,2,2819,0)="""RTN"",""SDES2PROVSEARCH"",90,0)"
^XMB(3.9,146041,2,2820,0)=" . S RECORDNUMBER=RECORDNUMBER+1"
^XMB(3.9,146041,2,2821,0)="""RTN"",""SDES2PROVSEARCH"",91,0)"
^XMB(3.9,146041,2,2822,0)=" . S PROVIDERETURN(""Provider"",RECORDNUMBER,""IEN"")=IEN"
^XMB(3.9,146041,2,2823,0)="""RTN"",""SDES2PROVSEARCH"",92,0)"
^XMB(3.9,146041,2,2824,0)=" . S PROVIDERETURN(""Provider"",RECORDNUMBER,""Name"")=INFO(200,IEN_"","",.01,""E"")"
^XMB(3.9,146041,2,2825,0)="""RTN"",""SDES2PROVSEARCH"",93,0)"
^XMB(3.9,146041,2,2826,0)=" . S PROVIDERETURN(""Provider"",RECORDNUMBER,""Homephone"")=INFO(200,IEN_"","",.131,""E"")"
^XMB(3.9,146041,2,2827,0)="""RTN"",""SDES2PROVSEARCH"",94,0)"
^XMB(3.9,146041,2,2828,0)=" . S PROVIDERETURN(""Provider"",RECORDNUMBER,""Officephone"")=INFO(200,IEN_"","",.132,""E"")"
^XMB(3.9,146041,2,2829,0)="""RTN"",""SDES2PROVSEARCH"",95,0)"
^XMB(3.9,146041,2,2830,0)=" . S PROVIDERETURN(""Provider"",RECORDNUMBER,""Phone3"")=INFO(200,IEN_"","",.133,""E"")"
^XMB(3.9,146041,2,2831,0)="""RTN"",""SDES2PROVSEARCH"",96,0)"
^XMB(3.9,146041,2,2832,0)=" . S PROVIDERETURN(""Provider"",RECORDNUMBER,""Phone4"")=INFO(200,IEN_"","",.134,""E"")"
^XMB(3.9,146041,2,2833,0)="""RTN"",""SDES2PROVSEARCH"",97,0)"
^XMB(3.9,146041,2,2834,0)=" . S PROVIDERETURN(""Provider"",RECORDNUMBER,""CommercialPhone"")=INFO(200,IEN_"","",.135,""E"")"
^XMB(3.9,146041,2,2835,0)="""RTN"",""SDES2PROVSEARCH"",98,0)"
^XMB(3.9,146041,2,2836,0)=" . S PROVIDERETURN(""Provider"",RECORDNUMBER,""Fax"")=INFO(200,IEN_"","",.136,""E"")"
^XMB(3.9,146041,2,2837,0)="""RTN"",""SDES2PROVSEARCH"",99,0)"
^XMB(3.9,146041,2,2838,0)=" . S PROVIDERETURN(""Provider"",RECORDNUMBER,""VoicePager"")=INFO(200,IEN_"","",.137,""E"")"
^XMB(3.9,146041,2,2839,0)="""RTN"",""SDES2PROVSEARCH"",100,0)"
^XMB(3.9,146041,2,2840,0)=" . S PROVIDERETURN(""Provider"",RECORDNUMBER,""DigitalPager"")=INFO(200,IEN_"","",.138,""E"")"
^XMB(3.9,146041,2,2841,0)="""RTN"",""SDES2PROVSEARCH"",101,0)"
^XMB(3.9,146041,2,2842,0)=" . S PROVIDERETURN(""Provider"",RECORDNUMBER,""Email"")=INFO(200,IEN_"","",.151,""E"")"
^XMB(3.9,146041,2,2843,0)="""RTN"",""SDES2PROVSEARCH"",102,0)"
^XMB(3.9,146041,2,2844,0)=" . S PROVIDERETURN(""Provider"",RECORDNUMBER,""Title"")=INFO(200,IEN_"","",8,""E"")"
^XMB(3.9,146041,2,2845,0)="""RTN"",""SDES2PROVSEARCH"",103,0)"
^XMB(3.9,146041,2,2846,0)=" . S PROVIDERETURN(""Provider"",RECORDNUMBER,""ProviderClass"")=INFO(200,IEN_"","",53.5,""E"")"
^XMB(3.9,146041,2,2847,0)="""RTN"",""SDES2PROVSEARCH"",104,0)"
^XMB(3.9,146041,2,2848,0)=" . S PROVIDERETURN(""Provider"",RECORDNUMBER,""ProviderSecID"")=INFO(200,IEN_"","",205.1,""E"")"
^XMB(3.9,146041,2,2849,0)="""RTN"",""SDES2PROVSEARCH"",105,0)"
^XMB(3.9,146041,2,2850,0)=" . S PROVIDERETURN(""Provider"",RECORDNUMBER,""PersonClass"",1)="""""
^XMB(3.9,146041,2,2851,0)="""RTN"",""SDES2PROVSEARCH"",106,0)"
^XMB(3.9,146041,2,2852,0)=" . S PROVIDERETURN(""Provider"",RECORDNUMBER,""UserClass"",1)="""""
^XMB(3.9,146041,2,2853,0)="""RTN"",""SDES2PROVSEARCH"",107,0)"
^XMB(3.9,146041,2,2854,0)=" . S IENS=0 F  S IENS=$O(^VA(200,IEN,""USC1"",IENS)) Q:'IENS  D"
^XMB(3.9,146041,2,2855,0)="""RTN"",""SDES2PROVSEARCH"",108,0)"
^XMB(3.9,146041,2,2856,0)=" . . S PROVIDERETURN(""Provider"",RECORDNUMBER,""PersonClass"",IENS)=$$GET1^DIQ(200.05,IENS_"",""_IEN_"","",.01)"
^XMB(3.9,146041,2,2857,0)="""RTN"",""SDES2PROVSEARCH"",109,0)"
^XMB(3.9,146041,2,2858,0)=" . S IENS=0 F  S IENS=$O(^VA(200,IEN,""USC3"",IENS)) Q:'IENS  D"
^XMB(3.9,146041,2,2859,0)="""RTN"",""SDES2PROVSEARCH"",110,0)"
^XMB(3.9,146041,2,2860,0)=" . . S PROVIDERETURN(""Provider"",RECORDNUMBER,""UserClass"",IENS)=$$GET1^DIQ(200.07,IENS_"",""_IEN_"","",.01)"
^XMB(3.9,146041,2,2861,0)="""RTN"",""SDES2PROVSEARCH"",111,0)"
^XMB(3.9,146041,2,2862,0)=" I '$D(PROVIDERETURN(""Provider"")) S PROVIDERETURN(""Provider"",1)="""""
^XMB(3.9,146041,2,2863,0)="""RTN"",""SDES2PROVSEARCH"",112,0)"
^XMB(3.9,146041,2,2864,0)=" Q"
^XMB(3.9,146041,2,2865,0)="""RTN"",""SDES2PROVSEARCH"",113,0)"
^XMB(3.9,146041,2,2866,0)=" ;"
^XMB(3.9,146041,2,2867,0)="""RTN"",""SDES2UTILAREQTMP"")"
^XMB(3.9,146041,2,2868,0)="1^5"
^XMB(3.9,146041,2,2869,0)="""RTN"",""SDES2VALCONTEXT"")"
^XMB(3.9,146041,2,2870,0)="0^3^B4162162"
^XMB(3.9,146041,2,2871,0)="""RTN"",""SDES2VALCONTEXT"",1,0)"
^XMB(3.9,146041,2,2872,0)="SDES2VALCONTEXT ;ALB/MGD,LAB,LAB - ACHERON CONTEXT VALIDATION UTILITIES ;DEC 2,2024"
^XMB(3.9,146041,2,2873,0)="""RTN"",""SDES2VALCONTEXT"",2,0)"
^XMB(3.9,146041,2,2874,0)=" ;;5.3;Scheduling;**853,860,895**;Aug 13, 1993;Build 0"
^XMB(3.9,146041,2,2875,0)="""RTN"",""SDES2VALCONTEXT"",3,0)"
^XMB(3.9,146041,2,2876,0)=" ;;Per VHA Directive 6402, this routine should not be modified"
^XMB(3.9,146041,2,2877,0)="""RTN"",""SDES2VALCONTEXT"",4,0)"
^XMB(3.9,146041,2,2878,0)=" ;"
^XMB(3.9,146041,2,2879,0)="""RTN"",""SDES2VALCONTEXT"",5,0)"
^XMB(3.9,146041,2,2880,0)=" Q"
^XMB(3.9,146041,2,2881,0)="""RTN"",""SDES2VALCONTEXT"",6,0)"
^XMB(3.9,146041,2,2882,0)=" ;"
^XMB(3.9,146041,2,2883,0)="""RTN"",""SDES2VALCONTEXT"",7,0)"
^XMB(3.9,146041,2,2884,0)="VALCONTEXT(SDERRORS,SDCONTEXT) ; Validate SDCONTEXT Array"
^XMB(3.9,146041,2,2885,0)="""RTN"",""SDES2VALCONTEXT"",8,0)"
^XMB(3.9,146041,2,2886,0)=" ; Required Input Variables"
^XMB(3.9,146041,2,2887,0)="""RTN"",""SDES2VALCONTEXT"",9,0)"
^XMB(3.9,146041,2,2888,0)=" D VALACHERONID(.SDERRORS,$G(SDCONTEXT(""ACHERON AUDIT ID"")))"
^XMB(3.9,146041,2,2889,0)="""RTN"",""SDES2VALCONTEXT"",10,0)"
^XMB(3.9,146041,2,2890,0)=" ; Optional Input Variables"
^XMB(3.9,146041,2,2891,0)="""RTN"",""SDES2VALCONTEXT"",11,0)"
^XMB(3.9,146041,2,2892,0)=" I $G(SDCONTEXT(""PATIENT DFN""))'="""" D VALPATDFN^SDES2VAL2(.SDERRORS,SDCONTEXT(""PATIENT DFN""))"
^XMB(3.9,146041,2,2893,0)="""RTN"",""SDES2VALCONTEXT"",12,0)"
^XMB(3.9,146041,2,2894,0)=" I $G(SDCONTEXT(""PATIENT ICN""))'="""" D VALPATICN^SDES2VAL2(.SDERRORS,SDCONTEXT(""PATIENT ICN""))"
^XMB(3.9,146041,2,2895,0)="""RTN"",""SDES2VALCONTEXT"",13,0)"
^XMB(3.9,146041,2,2896,0)=" I $G(SDCONTEXT(""USER DUZ""))'="""" D VALUSERDUZ^SDES2VAL200(.SDERRORS,SDCONTEXT(""USER DUZ""))"
^XMB(3.9,146041,2,2897,0)="""RTN"",""SDES2VALCONTEXT"",14,0)"
^XMB(3.9,146041,2,2898,0)=" I $G(SDCONTEXT(""USER SECID""))'="""" D VALSECID(.SDERRORS,SDCONTEXT(""USER SECID""),$G(SDCONTEXT(""USER DUZ"")))"
^XMB(3.9,146041,2,2899,0)="""RTN"",""SDES2VALCONTEXT"",15,0)"
^XMB(3.9,146041,2,2900,0)=" I '$D(SDERRORS) D"
^XMB(3.9,146041,2,2901,0)="""RTN"",""SDES2VALCONTEXT"",16,0)"
^XMB(3.9,146041,2,2902,0)=" . D DFNICNMATCH(.SDERRORS,$G(SDCONTEXT(""PATIENT DFN"")),$G(SDCONTEXT(""PATIENT ICN"")))"
^XMB(3.9,146041,2,2903,0)="""RTN"",""SDES2VALCONTEXT"",17,0)"
^XMB(3.9,146041,2,2904,0)=" Q"
^XMB(3.9,146041,2,2905,0)="""RTN"",""SDES2VALCONTEXT"",18,0)"
^XMB(3.9,146041,2,2906,0)=" ;"
^XMB(3.9,146041,2,2907,0)="""RTN"",""SDES2VALCONTEXT"",19,0)"
^XMB(3.9,146041,2,2908,0)="VALACHERONID(SDERRORS,SDACHERONID) ; Validate Acheron EAS ID"
^XMB(3.9,146041,2,2909,0)="""RTN"",""SDES2VALCONTEXT"",20,0)"
^XMB(3.9,146041,2,2910,0)=" I SDACHERONID="""" D ERRLOG^SDES2JSON(.SDERRORS,474) Q"
^XMB(3.9,146041,2,2911,0)="""RTN"",""SDES2VALCONTEXT"",21,0)"
^XMB(3.9,146041,2,2912,0)=" I $$VALACHERONID^SDES2UTIL(SDACHERONID)=-1 D ERRLOG^SDES2JSON(.SDERRORS,475)"
^XMB(3.9,146041,2,2913,0)="""RTN"",""SDES2VALCONTEXT"",22,0)"
^XMB(3.9,146041,2,2914,0)=" Q"
^XMB(3.9,146041,2,2915,0)="""RTN"",""SDES2VALCONTEXT"",23,0)"
^XMB(3.9,146041,2,2916,0)=" ;"
^XMB(3.9,146041,2,2917,0)="""RTN"",""SDES2VALCONTEXT"",24,0)"
^XMB(3.9,146041,2,2918,0)="DFNICNMATCH(SDERRORS,PATDFN,PATICN) ;verify that sent in values are same for patient"
^XMB(3.9,146041,2,2919,0)="""RTN"",""SDES2VALCONTEXT"",25,0)"
^XMB(3.9,146041,2,2920,0)=" I (PATDFN'="""")&(PATICN'="""") D"
^XMB(3.9,146041,2,2921,0)="""RTN"",""SDES2VALCONTEXT"",26,0)"
^XMB(3.9,146041,2,2922,0)=" . I $O(^DPT(""AICN"",PATICN,""""))'=PATDFN D ERRLOG^SDES2JSON(.SDERRORS,516)"
^XMB(3.9,146041,2,2923,0)="""RTN"",""SDES2VALCONTEXT"",27,0)"
^XMB(3.9,146041,2,2924,0)=" Q"
^XMB(3.9,146041,2,2925,0)="""RTN"",""SDES2VALCONTEXT"",28,0)"
^XMB(3.9,146041,2,2926,0)=" ;"
^XMB(3.9,146041,2,2927,0)="""RTN"",""SDES2VALCONTEXT"",29,0)"
^XMB(3.9,146041,2,2928,0)="VALSECID(SDERRORS,SDSECID,SDUSERDUZ) ;"
^XMB(3.9,146041,2,2929,0)="""RTN"",""SDES2VALCONTEXT"",30,0)"
^XMB(3.9,146041,2,2930,0)=" I SDSECID="""" Q"
^XMB(3.9,146041,2,2931,0)="""RTN"",""SDES2VALCONTEXT"",31,0)"
^XMB(3.9,146041,2,2932,0)=" I $L(SDSECID)<3!$L(SDSECID)>40 D ERRLOG^SDES2JSON(.SDERRORS,156) Q"
^XMB(3.9,146041,2,2933,0)="""RTN"",""SDES2VALCONTEXT"",32,0)"
^XMB(3.9,146041,2,2934,0)=" I $$GET1^DIQ(200,SDUSERDUZ,205.1,""I"")'=SDSECID D ERRLOG^SDES2JSON(.SDERRORS,156)"
^XMB(3.9,146041,2,2935,0)="""RTN"",""SDES2VALCONTEXT"",33,0)"
^XMB(3.9,146041,2,2936,0)=" Q"
^XMB(3.9,146041,2,2937,0)="""VER"")"
^XMB(3.9,146041,2,2938,0)="8.0^22.2"
^XMB(3.9,146041,2,2939,0)="$END KID SD*5.3*951b"
