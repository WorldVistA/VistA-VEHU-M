^XMB(3.9,146087,2,617,0)="""RTN"",""YTQAPI1"",136,0)"
^XMB(3.9,146087,2,618,0)=" S IEN="""" I '$D(DIERR),YTIEN(1) S IEN=YTIEN(1)"
