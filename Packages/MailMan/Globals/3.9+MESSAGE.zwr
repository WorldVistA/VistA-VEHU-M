^XMB(3.9,146090,2,758,0)="VRECMSG(X,RXIEN,FILLNUM,PSOSECK) ; Inform user if VOID selected without PSO SPMP ADMIN key"
^XMB(3.9,146090,2,759,0)="""RTN"",""PSOSPML4"",260,0)"
^XMB(3.9,146090,2,760,0)=" Q:$D(DTOUT)  Q:(X=""^"")!(X=""?"")"
