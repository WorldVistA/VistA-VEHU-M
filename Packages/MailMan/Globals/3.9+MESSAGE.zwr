^XMB(3.9,146057,2,440,0)=" . ; patch HL*1.6*157"
^XMB(3.9,146057,2,441,0)="""RTN"",""HLCS2"",101,0)"
^XMB(3.9,146057,2,442,0)=" . ; I $P(HLPARM4,U,3)=""M"" Q:^%ZOSF(""OS"")'[""OpenM""  Q:$$OS^%ZOSV[""VMS"""
^XMB(3.9,146057,2,443,0)="""RTN"",""HLCS2"",102,0)"
^XMB(3.9,146057,2,444,0)=" . I $P(HLPARM4,U,3)=""M"" Q:^%ZOSF(""OS"")'[""OpenM""  Q:($$OS^%ZOSV[""VMS"")!($$OS^%ZOSV[""UNIX"")"
