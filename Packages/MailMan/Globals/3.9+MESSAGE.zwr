^XMB(3.9,146087,2,3576,0)=" .S XSTR=XSTR_"", """"progress"""": """"""_PROG_"""""",""""expDt"""":""""""_$P($$FMTE^XLFDT($P(EXPDT,""."")),"":"",1,2)_""""""},"""
