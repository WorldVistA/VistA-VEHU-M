^XMB(3.9,146018,2,246,0)=3
^XMB(3.9,146018,2,247,0)="""RTN"",""DPTLK7"")"
^XMB(3.9,146018,2,248,0)="0^2^B169214305"
^XMB(3.9,146018,2,249,0)="""RTN"",""DPTLK7"",1,0)"
^XMB(3.9,146018,2,250,0)="DPTLK7 ;OAK/ELZ,ARF - MAS PATIENT LOOKUP ENTERPRISE SEARCH ;15 May 2020  2:31 PM"
^XMB(3.9,146018,2,251,0)="""RTN"",""DPTLK7"",2,0)"
^XMB(3.9,146018,2,252,0)=" ;;5.3;Registration;**915,919,926,967,981,1000,1024,1111,1139**;Aug 13, 1993;Build 0"
^XMB(3.9,146018,2,253,0)="""RTN"",""DPTLK7"",3,0)"
^XMB(3.9,146018,2,254,0)=" ;"
^XMB(3.9,146018,2,255,0)="""RTN"",""DPTLK7"",4,0)"
^XMB(3.9,146018,2,256,0)="SEARCH(DGX,DGXOLD) ; do a search, pass in what the user entered"
^XMB(3.9,146018,2,257,0)="""RTN"",""DPTLK7"",5,0)"
^XMB(3.9,146018,2,258,0)=" ; DGX is what the user originally entered, name is assumed unless it"
^XMB(3.9,146018,2,259,0)="""RTN"",""DPTLK7"",6,0)"
^XMB(3.9,146018,2,260,0)=" ; is exactly 9 digits, DON'T pass by reference it may change"
^XMB(3.9,146018,2,261,0)="""RTN"",""DPTLK7"",7,0)"
^XMB(3.9,146018,2,262,0)=" ; Return:  DFN (new or found locally), 0 if nothing found/added"
^XMB(3.9,146018,2,263,0)="""RTN"",""DPTLK7"",8,0)"
^XMB(3.9,146018,2,264,0)=" ;"
^XMB(3.9,146018,2,265,0)="""RTN"",""DPTLK7"",9,0)"
^XMB(3.9,146018,2,266,0)=" N DG20NAME,DGMPI,DGFLDS,DGOUT,%,%Y,DGMPIR,DGDFN,DGMPIICN,DGSAVE"
^XMB(3.9,146018,2,267,0)="""RTN"",""DPTLK7"",10,0)"
^XMB(3.9,146018,2,268,0)=" N DGKEYREQ,X,DA,DO,DIC,DGADDREQ,DGMCID"
^XMB(3.9,146018,2,269,0)="""RTN"",""DPTLK7"",11,0)"
^XMB(3.9,146018,2,270,0)=" Q:$G(DGSEARCH) 0"
^XMB(3.9,146018,2,271,0)="""RTN"",""DPTLK7"",12,0)"
^XMB(3.9,146018,2,272,0)=" S (DGKEYREQ,DGOUT,DGADDREQ)=0,DGSEARCH=1,DGSAVE=DGX"
^XMB(3.9,146018,2,273,0)="""RTN"",""DPTLK7"",13,0)"
^XMB(3.9,146018,2,274,0)=" Q:$T(PATIENT^MPIFXMLP)="""" 0"
^XMB(3.9,146018,2,275,0)="""RTN"",""DPTLK7"",14,0)"
^XMB(3.9,146018,2,276,0)=" ;"
^XMB(3.9,146018,2,277,0)="""RTN"",""DPTLK7"",15,0)"
^XMB(3.9,146018,2,278,0)="YN ;Enterprise Search?"
^XMB(3.9,146018,2,279,0)="""RTN"",""DPTLK7"",16,0)"
^XMB(3.9,146018,2,280,0)=" W !,""Do you want to do an Enterprise Search"""
^XMB(3.9,146018,2,281,0)="""RTN"",""DPTLK7"",17,0)"
^XMB(3.9,146018,2,282,0)=" D YN^DICN I %=0 W !,""You must enter Yes or No."" G YN"
^XMB(3.9,146018,2,283,0)="""RTN"",""DPTLK7"",18,0)"
^XMB(3.9,146018,2,284,0)=" Q:%'=1 0"
^XMB(3.9,146018,2,285,0)="""RTN"",""DPTLK7"",19,0)"
^XMB(3.9,146018,2,286,0)=" ;"
^XMB(3.9,146018,2,287,0)="""RTN"",""DPTLK7"",20,0)"
^XMB(3.9,146018,2,288,0)=" I $G(DGXOLD)]"""" S DGX=DGXOLD"
^XMB(3.9,146018,2,289,0)="""RTN"",""DPTLK7"",21,0)"
^XMB(3.9,146018,2,290,0)=" ; if yes then ask questions"
^XMB(3.9,146018,2,291,0)="""RTN"",""DPTLK7"",22,0)"
^XMB(3.9,146018,2,292,0)=" ; if 9 digits entered assume ssn, need to save"
^XMB(3.9,146018,2,293,0)="""RTN"",""DPTLK7"",23,0)"
^XMB(3.9,146018,2,294,0)="PROMPT I DGX?9N S DGFLDS(.09)=DGX,DGX="""""
^XMB(3.9,146018,2,295,0)="""RTN"",""DPTLK7"",24,0)"
^XMB(3.9,146018,2,296,0)=" ; if name in """" need to remove"
^XMB(3.9,146018,2,297,0)="""RTN"",""DPTLK7"",25,0)"
^XMB(3.9,146018,2,298,0)=" I $E(DGX,1)="""""""" S DGX=$E(DGX,2,99)"
^XMB(3.9,146018,2,299,0)="""RTN"",""DPTLK7"",26,0)"
^XMB(3.9,146018,2,300,0)=" I $E(DGX,$L(DGX))="""""""" S DGX=$E(DGX,1,$L(DGX)-1)"
^XMB(3.9,146018,2,301,0)="""RTN"",""DPTLK7"",27,0)"
^XMB(3.9,146018,2,302,0)=" D NAME(.DGX,.DG20NAME,.DGOUT) Q:DGOUT 0"
^XMB(3.9,146018,2,303,0)="""RTN"",""DPTLK7"",28,0)"
^XMB(3.9,146018,2,304,0)=" D FLDS(.DGFLDS,DG20NAME,.DGOUT) Q:DGOUT 0"
^XMB(3.9,146018,2,305,0)="""RTN"",""DPTLK7"",29,0)"
^XMB(3.9,146018,2,306,0)=" I $G(DGFLDS(.09))'?9N S DGADDREQ=1"
^XMB(3.9,146018,2,307,0)="""RTN"",""DPTLK7"",30,0)"
^XMB(3.9,146018,2,308,0)=" D:DGADDREQ ADDRESS(.DGFLDS,.DGOUT) Q:DGOUT 0"
^XMB(3.9,146018,2,309,0)="""RTN"",""DPTLK7"",31,0)"
^XMB(3.9,146018,2,310,0)=" I DGADDREQ,'$$ADDREQ(.DGFLDS) D  G PROMPT"
^XMB(3.9,146018,2,311,0)="""RTN"",""DPTLK7"",32,0)"
^XMB(3.9,146018,2,312,0)=" . W !,""You must enter an actual SSN, a COMPLETE Address or Phone to search."",!"
^XMB(3.9,146018,2,313,0)="""RTN"",""DPTLK7"",33,0)"
^XMB(3.9,146018,2,314,0)=" . K DGX,DG20NAME,DGFLDS,DGMPI,DGMPIR"
^XMB(3.9,146018,2,315,0)="""RTN"",""DPTLK7"",34,0)"
^XMB(3.9,146018,2,316,0)=" . S DGX=DGSAVE"
^XMB(3.9,146018,2,317,0)="""RTN"",""DPTLK7"",35,0)"
^XMB(3.9,146018,2,318,0)=" ;"
^XMB(3.9,146018,2,319,0)="""RTN"",""DPTLK7"",36,0)"
^XMB(3.9,146018,2,320,0)=" ; call MPI to get data"
^XMB(3.9,146018,2,321,0)="""RTN"",""DPTLK7"",37,0)"
^XMB(3.9,146018,2,322,0)=" W !!,""Searching the MVI..."""
^XMB(3.9,146018,2,323,0)="""RTN"",""DPTLK7"",38,0)"
^XMB(3.9,146018,2,324,0)=" D FORMAT(.DGMPI,.DG20NAME,.DGFLDS)"
^XMB(3.9,146018,2,325,0)="""RTN"",""DPTLK7"",39,0)"
^XMB(3.9,146018,2,326,0)=" D PATIENT^MPIFXMLP(.DGMPIR,.DGMPI)"
^XMB(3.9,146018,2,327,0)="""RTN"",""DPTLK7"",40,0)"
^XMB(3.9,146018,2,328,0)=" S DGMCID=$G(DGMPIR(""mcid""))"
^XMB(3.9,146018,2,329,0)="""RTN"",""DPTLK7"",41,0)"
^XMB(3.9,146018,2,330,0)=" ;"
^XMB(3.9,146018,2,331,0)="""RTN"",""DPTLK7"",42,0)"
^XMB(3.9,146018,2,332,0)=" ; too many matches found, they need to get the numbers down, re-prompt"
^XMB(3.9,146018,2,333,0)="""RTN"",""DPTLK7"",43,0)"
^XMB(3.9,146018,2,334,0)=" I $G(DGMPIR(""count""))>10!($G(DGMPIR(""Result""))=""QE"") D  G PROMPT"
^XMB(3.9,146018,2,335,0)="""RTN"",""DPTLK7"",44,0)"
^XMB(3.9,146018,2,336,0)=" . W !,$S(DGMPIR(""count"")>10:DGMPIR(""count""),1:""Too many""),"" records found, you need to provide more specific criteria."",!"
^XMB(3.9,146018,2,337,0)="""RTN"",""DPTLK7"",45,0)"
^XMB(3.9,146018,2,338,0)=" . K DGX,DG20NAME,DGFLDS,DGMPI,DGMPIR"
^XMB(3.9,146018,2,339,0)="""RTN"",""DPTLK7"",46,0)"
^XMB(3.9,146018,2,340,0)=" . S DGX=DGSAVE"
^XMB(3.9,146018,2,341,0)="""RTN"",""DPTLK7"",47,0)"
^XMB(3.9,146018,2,342,0)=" ;"
^XMB(3.9,146018,2,343,0)="""RTN"",""DPTLK7"",48,0)"
^XMB(3.9,146018,2,344,0)=" ; no matches found on the MPI offer to add"
^XMB(3.9,146018,2,345,0)="""RTN"",""DPTLK7"",49,0)"
^XMB(3.9,146018,2,346,0)=" I '$G(DGMPIR(""count"")) W !,""No records found on the MVI."",! D  Q DGDFN"
^XMB(3.9,146018,2,347,0)="""RTN"",""DPTLK7"",50,0)"
^XMB(3.9,146018,2,348,0)=" . S DPTX=$G(DGFLDS(.01)) D ASKADD^DPTLK2 I DPTDFN'>0 S DGDFN=0 Q"
^XMB(3.9,146018,2,349,0)="""RTN"",""DPTLK7"",51,0)"
^XMB(3.9,146018,2,350,0)=" . S DGDFN=$$ADD(.DGFLDS,.DG20NAME) Q:'DGDFN"
^XMB(3.9,146018,2,351,0)="""RTN"",""DPTLK7"",52,0)"
^XMB(3.9,146018,2,352,0)=" . ;"
^XMB(3.9,146018,2,353,0)="""RTN"",""DPTLK7"",53,0)"
^XMB(3.9,146018,2,354,0)=" . ; setup DGMPIR since there was nothing"
^XMB(3.9,146018,2,355,0)="""RTN"",""DPTLK7"",54,0)"
^XMB(3.9,146018,2,356,0)=" . M DGMPIR(1)=DGMPI"
^XMB(3.9,146018,2,357,0)="""RTN"",""DPTLK7"",55,0)"
^XMB(3.9,146018,2,358,0)=" . S DGMPIR(+$O(DGMPIR(0)),""DFN"")=DGDFN"
^XMB(3.9,146018,2,359,0)="""RTN"",""DPTLK7"",56,0)"
^XMB(3.9,146018,2,360,0)=" . ;"
^XMB(3.9,146018,2,361,0)="""RTN"",""DPTLK7"",57,0)"
^XMB(3.9,146018,2,362,0)=" . S DGMPIR(""mcid"")=DGMCID"
^XMB(3.9,146018,2,363,0)="""RTN"",""DPTLK7"",58,0)"
^XMB(3.9,146018,2,364,0)=" .;**981 - Story 841885 (ckn)"
^XMB(3.9,146018,2,365,0)="""RTN"",""DPTLK7"",59,0)"
^XMB(3.9,146018,2,366,0)=" . S DGMPIR(""SelIdentifier"")="""""
^XMB(3.9,146018,2,367,0)="""RTN"",""DPTLK7"",60,0)"
^XMB(3.9,146018,2,368,0)=" . D MPIADD(.DGMPIR)"
^XMB(3.9,146018,2,369,0)="""RTN"",""DPTLK7"",61,0)"
^XMB(3.9,146018,2,370,0)=" ;"
^XMB(3.9,146018,2,371,0)="""RTN"",""DPTLK7"",62,0)"
^XMB(3.9,146018,2,372,0)=" ; do I have some records that are in autolink threshold? - key required"
^XMB(3.9,146018,2,373,0)="""RTN"",""DPTLK7"",63,0)"
^XMB(3.9,146018,2,374,0)=" S X=0 F  S X=$O(DGMPIR(X)) Q:'X  I $G(DGMPIR(X,""Score""))'<$G(DGMPIR(""matchThreshold"")) S DGKEYREQ=1"
^XMB(3.9,146018,2,375,0)="""RTN"",""DPTLK7"",64,0)"
^XMB(3.9,146018,2,376,0)=" ;"
^XMB(3.9,146018,2,377,0)="""RTN"",""DPTLK7"",65,0)"
^XMB(3.9,146018,2,378,0)=" ; preset list to select patients"
^XMB(3.9,146018,2,379,0)="""RTN"",""DPTLK7"",66,0)"
^XMB(3.9,146018,2,380,0)=" S DGDFN=$$ENP^MPIFVER(.DGMPIR,$G(DGMPIR(""matchThreshold"")),$G(DGMPIR(""dupeThreshold"")))"
^XMB(3.9,146018,2,381,0)="""RTN"",""DPTLK7"",67,0)"
^XMB(3.9,146018,2,382,0)=" ;"
^XMB(3.9,146018,2,383,0)="""RTN"",""DPTLK7"",68,0)"
^XMB(3.9,146018,2,384,0)=" ; found and selected local patient"
^XMB(3.9,146018,2,385,0)="""RTN"",""DPTLK7"",69,0)"
^XMB(3.9,146018,2,386,0)=" I DGDFN>0 Q DGDFN"
^XMB(3.9,146018,2,387,0)="""RTN"",""DPTLK7"",70,0)"
^XMB(3.9,146018,2,388,0)=" I DGDFN=-1 S DPTX="""" Q 0"
^XMB(3.9,146018,2,389,0)="""RTN"",""DPTLK7"",71,0)"
^XMB(3.9,146018,2,390,0)=" ;"
^XMB(3.9,146018,2,391,0)="""RTN"",""DPTLK7"",72,0)"
^XMB(3.9,146018,2,392,0)=" ; need to add new patient based on return from selection"
^XMB(3.9,146018,2,393,0)="""RTN"",""DPTLK7"",73,0)"
^XMB(3.9,146018,2,394,0)=" I $D(DGMPIR)>1 K DG20NAME D FORMATR^DPTLK7A(.DGFLDS,.DGMPIR,.DG20NAME) S DGDFN=$$ADD(.DGFLDS,.DG20NAME) D:DGDFN  G QUIT"
^XMB(3.9,146018,2,395,0)="""RTN"",""DPTLK7"",74,0)"
^XMB(3.9,146018,2,396,0)=" . ;"
^XMB(3.9,146018,2,397,0)="""RTN"",""DPTLK7"",75,0)"
^XMB(3.9,146018,2,398,0)=" . S DGMPIR(+$O(DGMPIR(0)),""DFN"")=DGDFN"
^XMB(3.9,146018,2,399,0)="""RTN"",""DPTLK7"",76,0)"
^XMB(3.9,146018,2,400,0)=" . ;"
^XMB(3.9,146018,2,401,0)="""RTN"",""DPTLK7"",77,0)"
^XMB(3.9,146018,2,402,0)=" . S DGMPIR(""mcid"")=DGMCID"
^XMB(3.9,146018,2,403,0)="""RTN"",""DPTLK7"",78,0)"
^XMB(3.9,146018,2,404,0)=" .;**981 - Story 841885 (ckn)"
^XMB(3.9,146018,2,405,0)="""RTN"",""DPTLK7"",79,0)"
^XMB(3.9,146018,2,406,0)=" . I $G(DGMPIR(1,""ICN""))'="""" S DGMPIR(""SelIdentifier"")=DGMPIR(1,""ICN"")_""^NI^200M^USVHA"""
^XMB(3.9,146018,2,407,0)="""RTN"",""DPTLK7"",80,0)"
^XMB(3.9,146018,2,408,0)=" . ;**1024,Story 1258907 (mko): The TFs are now also returned in ""IDS""; Look for the DoD record, but only if ICN is not set"
^XMB(3.9,146018,2,409,0)="""RTN"",""DPTLK7"",81,0)"
^XMB(3.9,146018,2,410,0)=" . ;I $G(DGMPIR(1,""IDS"",1,""ID""))'="""" S DGMPIR(""SelIdentifier"")=DGMPIR(1,""IDS"",1,""ID"")_""^NI^200DOD^USDOD"""
^XMB(3.9,146018,2,411,0)="""RTN"",""DPTLK7"",82,0)"
^XMB(3.9,146018,2,412,0)=" . E  N I S I="""" F  S I=$O(DGMPIR(1,""IDS"",I)) Q:I=""""  I $G(DGMPIR(1,""IDS"",I,""ID""))]"""",$G(DGMPIR(1,""IDS"",I,""ISSUER""))=""USDOD"",$G(DGMPIR(1,""IDS"",I,""SOURCE""))=""200DOD"" S DGMPIR(""SelIdentifier"")=DGMPIR(1,""IDS"",I,""ID"")_""^NI^200DOD^USDOD"" Q"
^XMB(3.9,146018,2,413,0)="""RTN"",""DPTLK7"",83,0)"
^XMB(3.9,146018,2,414,0)=" . D MPIADD(.DGMPIR)"
^XMB(3.9,146018,2,415,0)="""RTN"",""DPTLK7"",84,0)"
^XMB(3.9,146018,2,416,0)=" . W !"
^XMB(3.9,146018,2,417,0)="""RTN"",""DPTLK7"",85,0)"
^XMB(3.9,146018,2,418,0)=" . ;"
^XMB(3.9,146018,2,419,0)="""RTN"",""DPTLK7"",86,0)"
^XMB(3.9,146018,2,420,0)=" . ; if known to ESR, send Z11 and monitor for return data"
^XMB(3.9,146018,2,421,0)="""RTN"",""DPTLK7"",87,0)"
^XMB(3.9,146018,2,422,0)=" . I $G(DGMPIR(1,""Z11"")) D"
^XMB(3.9,146018,2,423,0)="""RTN"",""DPTLK7"",88,0)"
^XMB(3.9,146018,2,424,0)=" .. W !,""Adding site correlation to MVI """
^XMB(3.9,146018,2,425,0)="""RTN"",""DPTLK7"",89,0)"
^XMB(3.9,146018,2,426,0)=" .. N DGTIME,DGQRY,DGDONE,DGQSTAT"
^XMB(3.9,146018,2,427,0)="""RTN"",""DPTLK7"",90,0)"
^XMB(3.9,146018,2,428,0)=" .. S (DGQSTAT,DGDONE)=0"
^XMB(3.9,146018,2,429,0)="""RTN"",""DPTLK7"",91,0)"
^XMB(3.9,146018,2,430,0)=" .. F DGTIME=1:1:60 D"
^XMB(3.9,146018,2,431,0)="""RTN"",""DPTLK7"",92,0)"
^XMB(3.9,146018,2,432,0)=" ... I $D(^XTMP(""DPTLK7 A24 IN-PROCESS"",DGDFN)) W ""."" H 1 Q"
^XMB(3.9,146018,2,433,0)="""RTN"",""DPTLK7"",93,0)"
^XMB(3.9,146018,2,434,0)=" ... ;"
^XMB(3.9,146018,2,435,0)="""RTN"",""DPTLK7"",94,0)"
^XMB(3.9,146018,2,436,0)=" ... ; not sending, maybe already sent or it is turned off"
^XMB(3.9,146018,2,437,0)="""RTN"",""DPTLK7"",95,0)"
^XMB(3.9,146018,2,438,0)=" ... I 'DGDONE  S DGDONE=1 D  W ""."" H 1 Q"
^XMB(3.9,146018,2,439,0)="""RTN"",""DPTLK7"",96,0)"
^XMB(3.9,146018,2,440,0)=" .... I $$QRY^DGENQRY(DGDFN) W !,""Enrollment/Eligibility Query processing """
^XMB(3.9,146018,2,441,0)="""RTN"",""DPTLK7"",97,0)"
^XMB(3.9,146018,2,442,0)=" ... ;"
^XMB(3.9,146018,2,443,0)="""RTN"",""DPTLK7"",98,0)"
^XMB(3.9,146018,2,444,0)=" ... ; check for status until it is returned, end with set to 60 seconds"
^XMB(3.9,146018,2,445,0)="""RTN"",""DPTLK7"",99,0)"
^XMB(3.9,146018,2,446,0)=" ... S DGQRY=$$GET^DGENQRY($$FINDLAST^DGENQRY($G(DGDFN)),.DGQRY) I $G(DGQRY(""STATUS""))>2 S DGTIME=60,DGQSTAT=1 Q"
^XMB(3.9,146018,2,447,0)="""RTN"",""DPTLK7"",100,0)"
^XMB(3.9,146018,2,448,0)=" ... W ""."" H 1"
^XMB(3.9,146018,2,449,0)="""RTN"",""DPTLK7"",101,0)"
^XMB(3.9,146018,2,450,0)=" .. I 'DGQSTAT D"
^XMB(3.9,146018,2,451,0)="""RTN"",""DPTLK7"",102,0)"
^XMB(3.9,146018,2,452,0)=" ... W !,""Query to ES timed out, proceeding with registration."""
^XMB(3.9,146018,2,453,0)="""RTN"",""DPTLK7"",103,0)"
^XMB(3.9,146018,2,454,0)=" ... W !,""The data will be uploaded when received."""
^XMB(3.9,146018,2,455,0)="""RTN"",""DPTLK7"",104,0)"
^XMB(3.9,146018,2,456,0)=" .. W !!"
^XMB(3.9,146018,2,457,0)="""RTN"",""DPTLK7"",105,0)"
^XMB(3.9,146018,2,458,0)=" ;"
^XMB(3.9,146018,2,459,0)="""RTN"",""DPTLK7"",106,0)"
^XMB(3.9,146018,2,460,0)=" ; no one selected but may still need to add based on traits entered"
^XMB(3.9,146018,2,461,0)="""RTN"",""DPTLK7"",107,0)"
^XMB(3.9,146018,2,462,0)=" I DGKEYREQ,'$D(^XUSEC(""DG MVI ADD PT"",DUZ)) D"
^XMB(3.9,146018,2,463,0)="""RTN"",""DPTLK7"",108,0)"
^XMB(3.9,146018,2,464,0)=" . W !,""The search returned one or more patients above the Auto-Link threshold,"""
^XMB(3.9,146018,2,465,0)="""RTN"",""DPTLK7"",109,0)"
^XMB(3.9,146018,2,466,0)=" . W !,""none of them selected. Security key required to add without selection."""
^XMB(3.9,146018,2,467,0)="""RTN"",""DPTLK7"",110,0)"
^XMB(3.9,146018,2,468,0)=" E  D"
^XMB(3.9,146018,2,469,0)="""RTN"",""DPTLK7"",111,0)"
^XMB(3.9,146018,2,470,0)=" . N DPTDFN,DPTX,Y,%,%Y,DGMPIR"
^XMB(3.9,146018,2,471,0)="""RTN"",""DPTLK7"",112,0)"
^XMB(3.9,146018,2,472,0)=" . M DGMPIR(1)=DGMPI"
^XMB(3.9,146018,2,473,0)="""RTN"",""DPTLK7"",113,0)"
^XMB(3.9,146018,2,474,0)=" . S DPTX=$G(DGFLDS(.01)) D ASKADD^DPTLK2 I DPTDFN'>0 S DGDFN=0 Q"
^XMB(3.9,146018,2,475,0)="""RTN"",""DPTLK7"",114,0)"
^XMB(3.9,146018,2,476,0)=" . S DGDFN=$$ADD(.DGFLDS,.DG20NAME) Q:'DGDFN"
^XMB(3.9,146018,2,477,0)="""RTN"",""DPTLK7"",115,0)"
^XMB(3.9,146018,2,478,0)=" . S DGMPIR(+$O(DGMPIR(0)),""DFN"")=DGDFN"
^XMB(3.9,146018,2,479,0)="""RTN"",""DPTLK7"",116,0)"
^XMB(3.9,146018,2,480,0)=" . S DGMPIR(""AddType"")=$S(DGKEYREQ:""Explicit"",1:""Implicit"")"
^XMB(3.9,146018,2,481,0)="""RTN"",""DPTLK7"",117,0)"
^XMB(3.9,146018,2,482,0)=" . S DGMPIR(""mcid"")=DGMCID"
^XMB(3.9,146018,2,483,0)="""RTN"",""DPTLK7"",118,0)"
^XMB(3.9,146018,2,484,0)=" .;**981 - Story 841885 (ckn)"
^XMB(3.9,146018,2,485,0)="""RTN"",""DPTLK7"",119,0)"
^XMB(3.9,146018,2,486,0)=" . S DGMPIR(""SelIdentifier"")="""""
^XMB(3.9,146018,2,487,0)="""RTN"",""DPTLK7"",120,0)"
^XMB(3.9,146018,2,488,0)=" . D MPIADD(.DGMPIR)"
^XMB(3.9,146018,2,489,0)="""RTN"",""DPTLK7"",121,0)"
^XMB(3.9,146018,2,490,0)=" ;"
^XMB(3.9,146018,2,491,0)="""RTN"",""DPTLK7"",122,0)"
^XMB(3.9,146018,2,492,0)="QUIT Q $S(DGDFN:DGDFN,1:0)"
^XMB(3.9,146018,2,493,0)="""RTN"",""DPTLK7"",123,0)"
^XMB(3.9,146018,2,494,0)=" ;"
^XMB(3.9,146018,2,495,0)="""RTN"",""DPTLK7"",124,0)"
^XMB(3.9,146018,2,496,0)="MPIADD(DGMPIR) ; - call to add patient to the MPI and store ICN locally"
^XMB(3.9,146018,2,497,0)="""RTN"",""DPTLK7"",125,0)"
^XMB(3.9,146018,2,498,0)=" ; - web service call for adding and getting new ICN"
^XMB(3.9,146018,2,499,0)="""RTN"",""DPTLK7"",126,0)"
^XMB(3.9,146018,2,500,0)=" ;**1024,Story 1258907 (mko): Add a flag to indicate a new ICN needs to be added."
^XMB(3.9,146018,2,501,0)="""RTN"",""DPTLK7"",127,0)"
^XMB(3.9,146018,2,502,0)=" N DGNEWICN"
^XMB(3.9,146018,2,503,0)="""RTN"",""DPTLK7"",128,0)"
^XMB(3.9,146018,2,504,0)=" I '$G(DGMPIR(+$O(DGMPIR(0)),""ICN"")) D"
^XMB(3.9,146018,2,505,0)="""RTN"",""DPTLK7"",129,0)"
^XMB(3.9,146018,2,506,0)=" . S DGNEWICN=1"
^XMB(3.9,146018,2,507,0)="""RTN"",""DPTLK7"",130,0)"
^XMB(3.9,146018,2,508,0)=" . W !,""Adding patient to the MVI..."""
^XMB(3.9,146018,2,509,0)="""RTN"",""DPTLK7"",131,0)"
^XMB(3.9,146018,2,510,0)=" . N DGMPIICN"
^XMB(3.9,146018,2,511,0)="""RTN"",""DPTLK7"",132,0)"
^XMB(3.9,146018,2,512,0)=" . I '$D(DGMPIR(""AddType"")) S DGMPIR(""AddType"")=""Implicit"""
^XMB(3.9,146018,2,513,0)="""RTN"",""DPTLK7"",133,0)"
^XMB(3.9,146018,2,514,0)=" . D GETICN^MPIFXMLI(.DGMPIICN,.DGMPIR)"
^XMB(3.9,146018,2,515,0)="""RTN"",""DPTLK7"",134,0)"
^XMB(3.9,146018,2,516,0)=" . I $G(DGMPIICN(""ICN""))>0 S DGMPIR(+$O(DGMPIR(0)),""ICN"")=DGMPIICN(""ICN"")"
^XMB(3.9,146018,2,517,0)="""RTN"",""DPTLK7"",135,0)"
^XMB(3.9,146018,2,518,0)=" . E  D  Q"
^XMB(3.9,146018,2,519,0)="""RTN"",""DPTLK7"",136,0)"
^XMB(3.9,146018,2,520,0)=" .. W !,""Unable to add to MVI!"",!,$G(DGMPIICN(""ERRTXT"")),!"
^XMB(3.9,146018,2,521,0)="""RTN"",""DPTLK7"",137,0)"
^XMB(3.9,146018,2,522,0)=" .. S ^XTMP(""MPIF EXPLICIT QUEUE"",0)=$$FMADD^XLFDT(DT,60)_""^""_DT_""^MPIF EXPLICIT QUEUE"""
^XMB(3.9,146018,2,523,0)="""RTN"",""DPTLK7"",138,0)"
^XMB(3.9,146018,2,524,0)=" .. S ^XTMP(""MPIF EXPLICIT QUEUE"",DGDFN)=DT_""^""_DGMPIR(""AddType"")_""^""_$G(DGMPIR(+$O(DGMPIR(0)),""mcid""))_""^""_$G(DGMPIICN(""ERRTXT""))"
^XMB(3.9,146018,2,525,0)="""RTN"",""DPTLK7"",139,0)"
^XMB(3.9,146018,2,526,0)=" .. S X=$$ICNLC^MPIF001(DGDFN)"
^XMB(3.9,146018,2,527,0)="""RTN"",""DPTLK7"",140,0)"
^XMB(3.9,146018,2,528,0)=" ;"
^XMB(3.9,146018,2,529,0)="""RTN"",""DPTLK7"",141,0)"
^XMB(3.9,146018,2,530,0)=" ; - need to have MPI do MPI fields"
^XMB(3.9,146018,2,531,0)="""RTN"",""DPTLK7"",142,0)"
^XMB(3.9,146018,2,532,0)=" S ^XTMP(""DPTLK7 A24 IN-PROCESS"",0)=$$FMADD^XLFDT(DT,10)_""^""_DT_""^TRACK PROCESSING OF A24 MESSAGES"""
^XMB(3.9,146018,2,533,0)="""RTN"",""DPTLK7"",143,0)"
^XMB(3.9,146018,2,534,0)=" S ^XTMP(""DPTLK7 A24 IN-PROCESS"",DGDFN)=DT"
^XMB(3.9,146018,2,535,0)="""RTN"",""DPTLK7"",144,0)"
^XMB(3.9,146018,2,536,0)=" I $G(DGMPIR(+$O(DGMPIR(0)),""ICN"")) D VIC40^MPIFAPI(DGDFN,DGMPIR(+$O(DGMPIR(0)),""ICN""))"
^XMB(3.9,146018,2,537,0)="""RTN"",""DPTLK7"",145,0)"
^XMB(3.9,146018,2,538,0)=" ;"
^XMB(3.9,146018,2,539,0)="""RTN"",""DPTLK7"",146,0)"
^XMB(3.9,146018,2,540,0)=" ;**1024,Story 1258907 (mko): Add the TFs returned from the Enterprise Search in case MFN-MF0 hasn't been received and processed by this point"
^XMB(3.9,146018,2,541,0)="""RTN"",""DPTLK7"",147,0)"
^XMB(3.9,146018,2,542,0)=" D:'$G(DGNEWICN)"
^XMB(3.9,146018,2,543,0)="""RTN"",""DPTLK7"",148,0)"
^XMB(3.9,146018,2,544,0)=" . N DGTFARR"
^XMB(3.9,146018,2,545,0)="""RTN"",""DPTLK7"",149,0)"
^XMB(3.9,146018,2,546,0)=" . M DGTFARR=DGMPIR(+$O(DGMPIR(0)),""IDS"")"
^XMB(3.9,146018,2,547,0)="""RTN"",""DPTLK7"",150,0)"
^XMB(3.9,146018,2,548,0)=" . D ADDTF^DPTLK7A(DGDFN,.DGTFARR)"
^XMB(3.9,146018,2,549,0)="""RTN"",""DPTLK7"",151,0)"
^XMB(3.9,146018,2,550,0)=" Q"
^XMB(3.9,146018,2,551,0)="""RTN"",""DPTLK7"",152,0)"
^XMB(3.9,146018,2,552,0)=" ;"
^XMB(3.9,146018,2,553,0)="""RTN"",""DPTLK7"",153,0)"
^XMB(3.9,146018,2,554,0)="NAME(DGX,DG20NAME,DGOUT) ;- ask for name components"
^XMB(3.9,146018,2,555,0)="""RTN"",""DPTLK7"",154,0)"
^XMB(3.9,146018,2,556,0)=" N DGC,DGCL,DGCOM,DGCX,DGI,DGY,DIR,X,DGCOMP"
^XMB(3.9,146018,2,557,0)="""RTN"",""DPTLK7"",155,0)"
^XMB(3.9,146018,2,558,0)="START S DGOUT=0"
^XMB(3.9,146018,2,559,0)="""RTN"",""DPTLK7"",156,0)"
^XMB(3.9,146018,2,560,0)=" S DGCOM=""FAMILY^GIVEN^MIDDLE^PREFIX^SUFFIX^DEGREE"""
^XMB(3.9,146018,2,561,0)="""RTN"",""DPTLK7"",157,0)"
^XMB(3.9,146018,2,562,0)=" S DGCX="" (LAST) NAME^ (FIRST) NAME^ NAME"""
^XMB(3.9,146018,2,563,0)="""RTN"",""DPTLK7"",158,0)"
^XMB(3.9,146018,2,564,0)=" S DGCL=""1:35^1:25^1:25^1:10^1:10^1:10"""
^XMB(3.9,146018,2,565,0)="""RTN"",""DPTLK7"",159,0)"
^XMB(3.9,146018,2,566,0)=" I $G(DGX)'?9N S DGX=$G(DGX) D STDNAME^XLFNAME(.DGX,""C"")"
^XMB(3.9,146018,2,567,0)="""RTN"",""DPTLK7"",160,0)"
^XMB(3.9,146018,2,568,0)=" S DGX(""SUFFIX"")=$$CLEANC^XLFNAME(DGX(""SUFFIX""))"
^XMB(3.9,146018,2,569,0)="""RTN"",""DPTLK7"",161,0)"
^XMB(3.9,146018,2,570,0)=" M DG20NAME=DGX"
^XMB(3.9,146018,2,571,0)="""RTN"",""DPTLK7"",162,0)"
^XMB(3.9,146018,2,572,0)=" S DIR(""PRE"")=""D:X'=""""@"""" NCEVAL^DPTNAME1(DGCOMP,.X)"""
^XMB(3.9,146018,2,573,0)="""RTN"",""DPTLK7"",163,0)"
^XMB(3.9,146018,2,574,0)=" W !,""Patient name components--"""
^XMB(3.9,146018,2,575,0)="""RTN"",""DPTLK7"",164,0)"
^XMB(3.9,146018,2,576,0)=" ;DG*5.3*1111 removed PREFIX (#4) and DEGREE (#6) of the NAME COMPONENTS (#20) file"
^XMB(3.9,146018,2,577,0)="""RTN"",""DPTLK7"",165,0)"
^XMB(3.9,146018,2,578,0)=" ;F DGI=1:1:6 S DGC($P(DGCOM,U,DGI),DGI)="""""
^XMB(3.9,146018,2,579,0)="""RTN"",""DPTLK7"",166,0)"
^XMB(3.9,146018,2,580,0)=" F DGI=1:1:3,5 S DGC($P(DGCOM,U,DGI),DGI)="""""
^XMB(3.9,146018,2,581,0)="""RTN"",""DPTLK7"",167,0)"
^XMB(3.9,146018,2,582,0)=" ;DG*5.3*1111 removed PREFIX (#4) and DEGREE (#6) of the NAME COMPONENTS (#20) file"
^XMB(3.9,146018,2,583,0)="""RTN"",""DPTLK7"",168,0)"
^XMB(3.9,146018,2,584,0)=" ;F DGI=1:1:6 Q:DGOUT  D"
^XMB(3.9,146018,2,585,0)="""RTN"",""DPTLK7"",169,0)"
^XMB(3.9,146018,2,586,0)=" F DGI=1:1:3,5 Q:DGOUT  D"
^XMB(3.9,146018,2,587,0)="""RTN"",""DPTLK7"",170,0)"
^XMB(3.9,146018,2,588,0)="AGAIN .S DGCOMP=$P(DGCOM,U,DGI)"
^XMB(3.9,146018,2,589,0)="""RTN"",""DPTLK7"",171,0)"
^XMB(3.9,146018,2,590,0)=" . S DIR(""A"")=DGCOMP_$P(DGCX,U,DGI)"
^XMB(3.9,146018,2,591,0)="""RTN"",""DPTLK7"",172,0)"
^XMB(3.9,146018,2,592,0)=" . S DIR(0)=$S(DGI=1:""F^""_$P(DGCL,U,DGI),1:""FO^""_$P(DGCL,U,DGI))"
^XMB(3.9,146018,2,593,0)="""RTN"",""DPTLK7"",173,0)"
^XMB(3.9,146018,2,594,0)=" . S DIR(""PRE"")=""D NCEVAL^DPTNAME1(DGCOMP,.X)"""
^XMB(3.9,146018,2,595,0)="""RTN"",""DPTLK7"",174,0)"
^XMB(3.9,146018,2,596,0)=" . S DIR(""B"")=$S($D(DG20NAME(DGCOMP)):DG20NAME(DGCOMP),1:$G(DGX(DGCOMP)))"
^XMB(3.9,146018,2,597,0)="""RTN"",""DPTLK7"",175,0)"
^XMB(3.9,146018,2,598,0)=" . K:'$L(DIR(""B"")) DIR(""B"")"
^XMB(3.9,146018,2,599,0)="""RTN"",""DPTLK7"",176,0)"
^XMB(3.9,146018,2,600,0)="ASK . D ^DIR I $D(DTOUT)!(X=U) S DGOUT=1 Q"
^XMB(3.9,146018,2,601,0)="""RTN"",""DPTLK7"",177,0)"
^XMB(3.9,146018,2,602,0)=" . I $A(X)=94 D JUMP^DPTNAME1(.DGI) G AGAIN"
^XMB(3.9,146018,2,603,0)="""RTN"",""DPTLK7"",178,0)"
^XMB(3.9,146018,2,604,0)=" . I X=""@"",DGI=1 W !,$C(7),""Family name cannot be deleted!"" G ASK"
^XMB(3.9,146018,2,605,0)="""RTN"",""DPTLK7"",179,0)"
^XMB(3.9,146018,2,606,0)=" . I X=""@"" S DG20NAME(DGCOMP)="""" Q"
^XMB(3.9,146018,2,607,0)="""RTN"",""DPTLK7"",180,0)"
^XMB(3.9,146018,2,608,0)=" . Q:'$L(X)"
^XMB(3.9,146018,2,609,0)="""RTN"",""DPTLK7"",181,0)"
^XMB(3.9,146018,2,610,0)=" . S DG20NAME=X"
^XMB(3.9,146018,2,611,0)="""RTN"",""DPTLK7"",182,0)"
^XMB(3.9,146018,2,612,0)=" . I DGCOMP=""SUFFIX"" S DG20NAME=$$CLEANC^XLFNAME(DG20NAME)"
^XMB(3.9,146018,2,613,0)="""RTN"",""DPTLK7"",183,0)"
^XMB(3.9,146018,2,614,0)=" . S DG20NAME=$$FORMAT^XLFNAME7(DG20NAME,1,35,,3,,1,1)"
^XMB(3.9,146018,2,615,0)="""RTN"",""DPTLK7"",184,0)"
^XMB(3.9,146018,2,616,0)=" . I '$L(DG20NAME) W ""  ??"",$C(7) G ASK"
^XMB(3.9,146018,2,617,0)="""RTN"",""DPTLK7"",185,0)"
^XMB(3.9,146018,2,618,0)=" . W:DG20NAME'=X ""   ("",DG20NAME,"")"" S DG20NAME(DGCOMP)=DG20NAME"
^XMB(3.9,146018,2,619,0)="""RTN"",""DPTLK7"",186,0)"
^XMB(3.9,146018,2,620,0)=" Q:DGOUT """""
^XMB(3.9,146018,2,621,0)="""RTN"",""DPTLK7"",187,0)"
^XMB(3.9,146018,2,622,0)=" ; Reconstruct name"
^XMB(3.9,146018,2,623,0)="""RTN"",""DPTLK7"",188,0)"
^XMB(3.9,146018,2,624,0)=" S DG20NAME=$$NAMEFMT^XLFNAME(.DG20NAME,""F"",""CFL30"")"
^XMB(3.9,146018,2,625,0)="""RTN"",""DPTLK7"",189,0)"
^XMB(3.9,146018,2,626,0)=" ; Format the .01 value"
^XMB(3.9,146018,2,627,0)="""RTN"",""DPTLK7"",190,0)"
^XMB(3.9,146018,2,628,0)=" M DGY=DG20NAME"
^XMB(3.9,146018,2,629,0)="""RTN"",""DPTLK7"",191,0)"
^XMB(3.9,146018,2,630,0)=" S DG20NAME=$$FORMAT^XLFNAME7(.DGY,3,30,,2)"
^XMB(3.9,146018,2,631,0)="""RTN"",""DPTLK7"",192,0)"
^XMB(3.9,146018,2,632,0)=" ; Check the length"
^XMB(3.9,146018,2,633,0)="""RTN"",""DPTLK7"",193,0)"
^XMB(3.9,146018,2,634,0)=" I $L(DG20NAME)<3 D  G START"
^XMB(3.9,146018,2,635,0)="""RTN"",""DPTLK7"",194,0)"
^XMB(3.9,146018,2,636,0)=" . W !,""Invalid values to use, full name must be at least 3 characters!"",$C(7)"
^XMB(3.9,146018,2,637,0)="""RTN"",""DPTLK7"",195,0)"
^XMB(3.9,146018,2,638,0)=" . K DG20NAME,DGX,DGCOMP"
^XMB(3.9,146018,2,639,0)="""RTN"",""DPTLK7"",196,0)"
^XMB(3.9,146018,2,640,0)=" Q"
^XMB(3.9,146018,2,641,0)="""RTN"",""DPTLK7"",197,0)"
^XMB(3.9,146018,2,642,0)=" ;"
^XMB(3.9,146018,2,643,0)="""RTN"",""DPTLK7"",198,0)"
^XMB(3.9,146018,2,644,0)=" ;**1139 VAMPI-26417 (jfw) - Convert to new RESIDENTIAL address fields"
^XMB(3.9,146018,2,645,0)="""RTN"",""DPTLK7"",199,0)"
^XMB(3.9,146018,2,646,0)="ADDRESS(DGFLDS,DGOUT) ;- prompt for address"
^XMB(3.9,146018,2,647,0)="""RTN"",""DPTLK7"",200,0)"
^XMB(3.9,146018,2,648,0)=" N DGRET,DGVAL"
^XMB(3.9,146018,2,649,0)="""RTN"",""DPTLK7"",201,0)"
^XMB(3.9,146018,2,650,0)=" ; OLD  |  NEW"
^XMB(3.9,146018,2,651,0)="""RTN"",""DPTLK7"",202,0)"
^XMB(3.9,146018,2,652,0)=" ;.111  | .1151 RESIDENTIAL ADDRESS [LINE 1] (both, free text)"
^XMB(3.9,146018,2,653,0)="""RTN"",""DPTLK7"",203,0)"
^XMB(3.9,146018,2,654,0)=" ;.112  | .1152 RESIDENTIAL ADDRESS [LINE 2] (both, free text)"
^XMB(3.9,146018,2,655,0)="""RTN"",""DPTLK7"",204,0)"
^XMB(3.9,146018,2,656,0)=" ;.113  | .1153 RESIDENTIAL ADDRESS [LINE 3] (both, free text)"
^XMB(3.9,146018,2,657,0)="""RTN"",""DPTLK7"",205,0)"
^XMB(3.9,146018,2,658,0)=" ;.114  | .1154 RESIDENTIAL CITY (both, free text)"
^XMB(3.9,146018,2,659,0)="""RTN"",""DPTLK7"",206,0)"
^XMB(3.9,146018,2,660,0)=" ;.115  | .1155 RESIDENTIAL STATE (external^internal)"
^XMB(3.9,146018,2,661,0)="""RTN"",""DPTLK7"",207,0)"
^XMB(3.9,146018,2,662,0)=" ;.117  | .1157 RESIDENTIAL COUNTY (external^internal^code)"
^XMB(3.9,146018,2,663,0)="""RTN"",""DPTLK7"",208,0)"
^XMB(3.9,146018,2,664,0)=" ;.1171 | .11571 RESIDENTIAL PROVINCE (both, free text)"
^XMB(3.9,146018,2,665,0)="""RTN"",""DPTLK7"",209,0)"
^XMB(3.9,146018,2,666,0)=" ;.1172 | .11572 RESIDENTIAL POSTAL CODE (both, free text)"
^XMB(3.9,146018,2,667,0)="""RTN"",""DPTLK7"",210,0)"
