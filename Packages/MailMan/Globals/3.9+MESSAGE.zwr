^XMB(3.9,146052,2,2097,0)="""RTN"",""FBPHON"",50,0)"
^XMB(3.9,146052,2,2098,0)=" Q"
^XMB(3.9,146052,2,2099,0)="""RTN"",""FBPHON"",51,0)"
^XMB(3.9,146052,2,2100,0)="HLP ;help text"
^XMB(3.9,146052,2,2101,0)="""RTN"",""FBPHON"",52,0)"
^XMB(3.9,146052,2,2102,0)=" S X=""?"" D DISP^XQORM1 W !!"
^XMB(3.9,146052,2,2103,0)="""RTN"",""FBPHON"",53,0)"
^XMB(3.9,146052,2,2104,0)=" Q"
^XMB(3.9,146052,2,2105,0)="""RTN"",""FBSHRAD"")"
^XMB(3.9,146052,2,2106,0)="0^9^B52116664"
^XMB(3.9,146052,2,2107,0)="""RTN"",""FBSHRAD"",1,0)"
^XMB(3.9,146052,2,2108,0)="FBSHRAD ;WCIOFO/SAB-REPORT ACTIVE AUTHORIZATIONS FOR DATE ;2/9/1999"
^XMB(3.9,146052,2,2109,0)="""RTN"",""FBSHRAD"",2,0)"
^XMB(3.9,146052,2,2110,0)=" ;;3.5;FEE BASIS;**13**;JAN 30, 1995;Build 0"
^XMB(3.9,146052,2,2111,0)="""RTN"",""FBSHRAD"",3,0)"
^XMB(3.9,146052,2,2112,0)=" ;"
^XMB(3.9,146052,2,2113,0)="""RTN"",""FBSHRAD"",4,0)"
^XMB(3.9,146052,2,2114,0)=" ; ask program"
^XMB(3.9,146052,2,2115,0)="""RTN"",""FBSHRAD"",5,0)"
^XMB(3.9,146052,2,2116,0)=" S DIC=""^FBAA(161.8,"",DIC(0)=""AQEM"",DIC(""B"")=""STATE HOME"""
^XMB(3.9,146052,2,2117,0)="""RTN"",""FBSHRAD"",6,0)"
^XMB(3.9,146052,2,2118,0)=" D ^DIC K DIC I Y'>0 G EXIT"
^XMB(3.9,146052,2,2119,0)="""RTN"",""FBSHRAD"",7,0)"
^XMB(3.9,146052,2,2120,0)=" S FBPROG=+Y"
^XMB(3.9,146052,2,2121,0)="""RTN"",""FBSHRAD"",8,0)"
^XMB(3.9,146052,2,2122,0)=" ;"
^XMB(3.9,146052,2,2123,0)="""RTN"",""FBSHRAD"",9,0)"
^XMB(3.9,146052,2,2124,0)=" ; ask purpose of visit(s)"
^XMB(3.9,146052,2,2125,0)="""RTN"",""FBSHRAD"",10,0)"
^XMB(3.9,146052,2,2126,0)=" S DIR(0)=""Y"",DIR(""A"")=""For ALL Purpose of Visits? Y/N"",DIR(""B"")=""YES"""
^XMB(3.9,146052,2,2127,0)="""RTN"",""FBSHRAD"",11,0)"
^XMB(3.9,146052,2,2128,0)=" D ^DIR K DIR G:$D(DIRUT) EXIT"
^XMB(3.9,146052,2,2129,0)="""RTN"",""FBSHRAD"",12,0)"
^XMB(3.9,146052,2,2130,0)=" S FBPOV=Y"
^XMB(3.9,146052,2,2131,0)="""RTN"",""FBSHRAD"",13,0)"
^XMB(3.9,146052,2,2132,0)=" I 'FBPOV D  G:'$D(FBPOV) EXIT S FBPOV=0"
^XMB(3.9,146052,2,2133,0)="""RTN"",""FBSHRAD"",14,0)"
^XMB(3.9,146052,2,2134,0)=" . K FBPOV"
^XMB(3.9,146052,2,2135,0)="""RTN"",""FBSHRAD"",15,0)"
^XMB(3.9,146052,2,2136,0)=" . W !,""Select one or more Purpose of Visits"""
^XMB(3.9,146052,2,2137,0)="""RTN"",""FBSHRAD"",16,0)"
^XMB(3.9,146052,2,2138,0)=" . S DIC=""^FBAA(161.82,"",DIC(0)=""AQEM"",DIC(""S"")=""I $P(^(0),U,2)=FBPROG"""
^XMB(3.9,146052,2,2139,0)="""RTN"",""FBSHRAD"",17,0)"
^XMB(3.9,146052,2,2140,0)=" . F  D  Q:Y'>0"
^XMB(3.9,146052,2,2141,0)="""RTN"",""FBSHRAD"",18,0)"
^XMB(3.9,146052,2,2142,0)=" . . D ^DIC I Y>0 S FBPOV(+Y)=$P(Y,U,2)"
^XMB(3.9,146052,2,2143,0)="""RTN"",""FBSHRAD"",19,0)"
^XMB(3.9,146052,2,2144,0)=" . K DIC"
^XMB(3.9,146052,2,2145,0)="""RTN"",""FBSHRAD"",20,0)"
^XMB(3.9,146052,2,2146,0)=" ;"
^XMB(3.9,146052,2,2147,0)="""RTN"",""FBSHRAD"",21,0)"
^XMB(3.9,146052,2,2148,0)=" ; ask dates"
^XMB(3.9,146052,2,2149,0)="""RTN"",""FBSHRAD"",22,0)"
^XMB(3.9,146052,2,2150,0)=" S DIR(0)=""D^::EX"",DIR(""A"")=""From Date"""
^XMB(3.9,146052,2,2151,0)="""RTN"",""FBSHRAD"",23,0)"
^XMB(3.9,146052,2,2152,0)=" ;   default from date is first day of previous month"
^XMB(3.9,146052,2,2153,0)="""RTN"",""FBSHRAD"",24,0)"
^XMB(3.9,146052,2,2154,0)=" S DIR(""B"")=$$FMTE^XLFDT($E($$FMADD^XLFDT($E(DT,1,5)_""01"",-1),1,5)_""01"")"
^XMB(3.9,146052,2,2155,0)="""RTN"",""FBSHRAD"",25,0)"
^XMB(3.9,146052,2,2156,0)=" D ^DIR K DIR G:$D(DIRUT) EXIT"
^XMB(3.9,146052,2,2157,0)="""RTN"",""FBSHRAD"",26,0)"
^XMB(3.9,146052,2,2158,0)=" S FBDT1=Y"
^XMB(3.9,146052,2,2159,0)="""RTN"",""FBSHRAD"",27,0)"
^XMB(3.9,146052,2,2160,0)=" S DIR(0)=""DA^""_FBDT1_""::EX"",DIR(""A"")=""To Date: """
^XMB(3.9,146052,2,2161,0)="""RTN"",""FBSHRAD"",28,0)"
^XMB(3.9,146052,2,2162,0)=" ;   default to date is last day of specified month"
^XMB(3.9,146052,2,2163,0)="""RTN"",""FBSHRAD"",29,0)"
^XMB(3.9,146052,2,2164,0)=" S X=FBDT1 D DAYS^FBAAUTL1"
^XMB(3.9,146052,2,2165,0)="""RTN"",""FBSHRAD"",30,0)"
^XMB(3.9,146052,2,2166,0)=" S DIR(""B"")=$$FMTE^XLFDT($E(FBDT1,1,5)_X)"
^XMB(3.9,146052,2,2167,0)="""RTN"",""FBSHRAD"",31,0)"
