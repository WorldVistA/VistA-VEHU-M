^XMB(3.9,146106,2,536,0)=" Q"
^XMB(3.9,146106,2,537,0)="""RTN"",""SDES2APPTUTIL"",6,0)"
^XMB(3.9,146106,2,538,0)=" ;"
^XMB(3.9,146106,2,539,0)="""RTN"",""SDES2APPTUTIL"",7,0)"
^XMB(3.9,146106,2,540,0)="APPTREQ(SDCONTEXT,APPOINTMENT,APPTIEN,APPTMSG) ; called only on create of appointment"
^XMB(3.9,146106,2,541,0)="""RTN"",""SDES2APPTUTIL"",8,0)"
^XMB(3.9,146106,2,542,0)=" N STARTDATETIME,CLINICIEN,REQUESTIEN,REQUESTTYPE"
^XMB(3.9,146106,2,543,0)="""RTN"",""SDES2APPTUTIL"",9,0)"
^XMB(3.9,146106,2,544,0)=" S REQUESTIEN=$P($G(APPOINTMENT(""REQUEST TYPE"")),""|"",2)"
^XMB(3.9,146106,2,545,0)="""RTN"",""SDES2APPTUTIL"",10,0)"
^XMB(3.9,146106,2,546,0)=" S REQUESTTYPE=$P($G(APPOINTMENT(""REQUEST TYPE"")),""|"")"
^XMB(3.9,146106,2,547,0)="""RTN"",""SDES2APPTUTIL"",11,0)"
^XMB(3.9,146106,2,548,0)=" ;"
^XMB(3.9,146106,2,549,0)="""RTN"",""SDES2APPTUTIL"",12,0)"
^XMB(3.9,146106,2,550,0)=" S STARTDATETIME=$G(APPOINTMENT(""START DATE TIME"")),CLINICIEN=$G(APPOINTMENT(""CLINIC IEN""))"
^XMB(3.9,146106,2,551,0)="""RTN"",""SDES2APPTUTIL"",13,0)"
^XMB(3.9,146106,2,552,0)=" D ADDPIDHISTORY^SDESCREATEAPPREQ($P($G(APPOINTMENT(""REQUEST TYPE"")),""|"",2),$G(APPOINTMENT(""PATIENT INDICATED DATE"")))"
