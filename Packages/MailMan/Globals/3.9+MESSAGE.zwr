^XMB(3.9,146056,2,2161,0)="""RTN"",""VPRSDAHX"",7,0)"
^XMB(3.9,146056,2,2162,0)=" ; ^AUPNVSIT                     2028"
^XMB(3.9,146056,2,2163,0)="""RTN"",""VPRSDAHX"",8,0)"
^XMB(3.9,146056,2,2164,0)=" ; ^AUTTHF                       4295"
^XMB(3.9,146056,2,2165,0)="""RTN"",""VPRSDAHX"",9,0)"
^XMB(3.9,146056,2,2166,0)=" ; ^PXRMINDX                     4290"
^XMB(3.9,146056,2,2167,0)="""RTN"",""VPRSDAHX"",10,0)"
^XMB(3.9,146056,2,2168,0)=" ; PXPXRM                        4250"
^XMB(3.9,146056,2,2169,0)="""RTN"",""VPRSDAHX"",11,0)"
^XMB(3.9,146056,2,2170,0)=" ; WVRPCVPR, ^TMP(""WVPREGST""     7199"
^XMB(3.9,146056,2,2171,0)="""RTN"",""VPRSDAHX"",12,0)"
