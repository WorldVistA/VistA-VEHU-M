^XMB(3.9,146087,2,966,0)=" S YS(""FILEN"")=601.84"
^XMB(3.9,146087,2,967,0)="""RTN"",""YTQRCDB"",164,0)"
^XMB(3.9,146087,2,968,0)=" I ADMIN S YS(""IEN"")=ADMIN I 1"
^XMB(3.9,146087,2,969,0)="""RTN"",""YTQRCDB"",165,0)"
^XMB(3.9,146087,2,970,0)=" E  S YS(1)="".01^NEW^1"""
