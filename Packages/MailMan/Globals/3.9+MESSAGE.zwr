^XMB(3.9,146018,2,743,0)="""RTN"",""DPTLK7"",248,0)"
^XMB(3.9,146018,2,744,0)=" ; prompt for EDIPI value before the FM fields"
^XMB(3.9,146018,2,745,0)="""RTN"",""DPTLK7"",249,0)"
^XMB(3.9,146018,2,746,0)=" ;S DIR(0)=""FO^10^K:X'?10N X"""
^XMB(3.9,146018,2,747,0)="""RTN"",""DPTLK7"",250,0)"
^XMB(3.9,146018,2,748,0)=" ;S DIR(""A"")=""EDIPI"""
^XMB(3.9,146018,2,749,0)="""RTN"",""DPTLK7"",251,0)"
^XMB(3.9,146018,2,750,0)=" ;S DIR(""?"")=""Answer with the individual's EDIPI, must be 10 numbers."""
