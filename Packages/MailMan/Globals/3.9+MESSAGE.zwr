^XMB(3.9,146087,2,640,0)="0^15^B106443894"
^XMB(3.9,146087,2,641,0)="""RTN"",""YTQRCDB"",1,0)"
^XMB(3.9,146087,2,642,0)="YTQRCDB ;BAL/KTL - MHA CLOUD DATABASE ADMIN RPC CALLS; 1/25/2017"
^XMB(3.9,146087,2,643,0)="""RTN"",""YTQRCDB"",2,0)"
