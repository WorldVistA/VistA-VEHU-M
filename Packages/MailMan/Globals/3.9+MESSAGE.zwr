^XMB(3.9,146103,2,219,0)="""QUES"",""XPZ1"",""??"")"
^XMB(3.9,146103,2,220,0)="^D OPT^XPDH"
^XMB(3.9,146103,2,221,0)="""QUES"",""XPZ1"",""A"")"
^XMB(3.9,146103,2,222,0)="Want to DISABLE Scheduled Options, Menu Options, and Protocols"
^XMB(3.9,146103,2,223,0)="""QUES"",""XPZ1"",""B"")"
^XMB(3.9,146103,2,224,0)="NO"
^XMB(3.9,146103,2,225,0)="""QUES"",""XPZ1"",""M"")"
^XMB(3.9,146103,2,226,0)="D XPZ1^XPDIQ"
^XMB(3.9,146103,2,227,0)="""QUES"",""XPZ2"",0)"
^XMB(3.9,146103,2,228,0)="Y"
^XMB(3.9,146103,2,229,0)="""QUES"",""XPZ2"",""??"")"
^XMB(3.9,146103,2,230,0)="^D RTN^XPDH"
^XMB(3.9,146103,2,231,0)="""QUES"",""XPZ2"",""A"")"
^XMB(3.9,146103,2,232,0)="Want to MOVE routines to other CPUs"
^XMB(3.9,146103,2,233,0)="""QUES"",""XPZ2"",""B"")"
^XMB(3.9,146103,2,234,0)="NO"
^XMB(3.9,146103,2,235,0)="""QUES"",""XPZ2"",""M"")"
^XMB(3.9,146103,2,236,0)="D XPZ2^XPDIQ"
^XMB(3.9,146103,2,237,0)="""RTN"")"
^XMB(3.9,146103,2,238,0)=1
^XMB(3.9,146103,2,239,0)="""RTN"",""XOBVSYSI"")"
^XMB(3.9,146103,2,240,0)="0^1^B53927220"
^XMB(3.9,146103,2,241,0)="""RTN"",""XOBVSYSI"",1,0)"
^XMB(3.9,146103,2,242,0)="XOBVSYSI ;; ld,mjk/alb - VistaLink Interface Implementation ; 07/27/2002  13:00"
^XMB(3.9,146103,2,243,0)="""RTN"",""XOBVSYSI"",2,0)"
^XMB(3.9,146103,2,244,0)=" ;;1.6;VistALink;;May 08, 2009;Build 0"
^XMB(3.9,146103,2,245,0)="""RTN"",""XOBVSYSI"",3,0)"
^XMB(3.9,146103,2,246,0)=" ;Per VHA directive 2004-038, this routine should not be modified."
^XMB(3.9,146103,2,247,0)="""RTN"",""XOBVSYSI"",4,0)"
^XMB(3.9,146103,2,248,0)="CALLBACK(CB) ; -- init callbacks implementation"
^XMB(3.9,146103,2,249,0)="""RTN"",""XOBVSYSI"",5,0)"
^XMB(3.9,146103,2,250,0)=" SET CB(""STARTELEMENT"")=""ELEST^XOBVSYSI"""
^XMB(3.9,146103,2,251,0)="""RTN"",""XOBVSYSI"",6,0)"
^XMB(3.9,146103,2,252,0)=" QUIT"
^XMB(3.9,146103,2,253,0)="""RTN"",""XOBVSYSI"",7,0)"
^XMB(3.9,146103,2,254,0)=" ;"
^XMB(3.9,146103,2,255,0)="""RTN"",""XOBVSYSI"",8,0)"
^XMB(3.9,146103,2,256,0)=" ; ------------------------------------------------------------------------"
^XMB(3.9,146103,2,257,0)="""RTN"",""XOBVSYSI"",9,0)"
^XMB(3.9,146103,2,258,0)=" ;             RPC Server: Request Message XML SAX Parser Callbacks         "
^XMB(3.9,146103,2,259,0)="""RTN"",""XOBVSYSI"",10,0)"
^XMB(3.9,146103,2,260,0)=" ; ------------------------------------------------------------------------"
^XMB(3.9,146103,2,261,0)="""RTN"",""XOBVSYSI"",11,0)"
^XMB(3.9,146103,2,262,0)="ELEST(ELE,ATR) ; -- element start event handler"
^XMB(3.9,146103,2,263,0)="""RTN"",""XOBVSYSI"",12,0)"
^XMB(3.9,146103,2,264,0)=" IF ELE=""VistaLink"" DO  QUIT"
^XMB(3.9,146103,2,265,0)="""RTN"",""XOBVSYSI"",13,0)"
^XMB(3.9,146103,2,266,0)=" . SET XOBDATA(""MODE"")=$GET(ATR(""mode""),""single call"")"
^XMB(3.9,146103,2,267,0)="""RTN"",""XOBVSYSI"",14,0)"
^XMB(3.9,146103,2,268,0)=" ;"
^XMB(3.9,146103,2,269,0)="""RTN"",""XOBVSYSI"",15,0)"
^XMB(3.9,146103,2,270,0)=" IF ELE=""Request"" DO  QUIT"
^XMB(3.9,146103,2,271,0)="""RTN"",""XOBVSYSI"",16,0)"
^XMB(3.9,146103,2,272,0)=" . SET XOBDATA(""XOB SYSTEM"",""TYPE"")=$GET(ATR(""type""),""unknown"")"
^XMB(3.9,146103,2,273,0)="""RTN"",""XOBVSYSI"",17,0)"
^XMB(3.9,146103,2,274,0)=" . SET XOBDATA(""XOB SYSTEM"",""ENV"")=$$LOW^XLFSTR($GET(ATR(""environment""),""j2se""))"
^XMB(3.9,146103,2,275,0)="""RTN"",""XOBVSYSI"",18,0)"
^XMB(3.9,146103,2,276,0)=" ;"
^XMB(3.9,146103,2,277,0)="""RTN"",""XOBVSYSI"",19,0)"
^XMB(3.9,146103,2,278,0)=" QUIT"
^XMB(3.9,146103,2,279,0)="""RTN"",""XOBVSYSI"",20,0)"
^XMB(3.9,146103,2,280,0)=" ;"
^XMB(3.9,146103,2,281,0)="""RTN"",""XOBVSYSI"",21,0)"
^XMB(3.9,146103,2,282,0)="READER(XOBUF,XOBDATA) ; -- proprietary format reader implementation"
^XMB(3.9,146103,2,283,0)="""RTN"",""XOBVSYSI"",22,0)"
^XMB(3.9,146103,2,284,0)=" QUIT"
^XMB(3.9,146103,2,285,0)="""RTN"",""XOBVSYSI"",23,0)"
^XMB(3.9,146103,2,286,0)=" ;"
^XMB(3.9,146103,2,287,0)="""RTN"",""XOBVSYSI"",24,0)"
^XMB(3.9,146103,2,288,0)="REQHDLR(XOBDATA) ; -- request handler implementation"
^XMB(3.9,146103,2,289,0)="""RTN"",""XOBVSYSI"",25,0)"
^XMB(3.9,146103,2,290,0)=" NEW TYPE"
^XMB(3.9,146103,2,291,0)="""RTN"",""XOBVSYSI"",26,0)"
^XMB(3.9,146103,2,292,0)=" SET TYPE=$GET(XOBDATA(""XOB SYSTEM"",""TYPE""),""unknown"")"
^XMB(3.9,146103,2,293,0)="""RTN"",""XOBVSYSI"",27,0)"
^XMB(3.9,146103,2,294,0)=" ;"
^XMB(3.9,146103,2,295,0)="""RTN"",""XOBVSYSI"",28,0)"
^XMB(3.9,146103,2,296,0)=" ; -- initialize socket partition request"
^XMB(3.9,146103,2,297,0)="""RTN"",""XOBVSYSI"",29,0)"
^XMB(3.9,146103,2,298,0)=" IF TYPE=""initializeSocket"" DO INIT(.TYPE) GOTO REQHDLRQ"
^XMB(3.9,146103,2,299,0)="""RTN"",""XOBVSYSI"",30,0)"
^XMB(3.9,146103,2,300,0)=" ;"
^XMB(3.9,146103,2,301,0)="""RTN"",""XOBVSYSI"",31,0)"
^XMB(3.9,146103,2,302,0)=" ; -- set stop flag to close socket request"
^XMB(3.9,146103,2,303,0)="""RTN"",""XOBVSYSI"",32,0)"
^XMB(3.9,146103,2,304,0)=" IF TYPE=""closeSocket"" DO CLOSE(.TYPE) GOTO REQHDLRQ"
^XMB(3.9,146103,2,305,0)="""RTN"",""XOBVSYSI"",33,0)"
^XMB(3.9,146103,2,306,0)=" ;"
^XMB(3.9,146103,2,307,0)="""RTN"",""XOBVSYSI"",34,0)"
^XMB(3.9,146103,2,308,0)=" ; -- cleanup partition request "
^XMB(3.9,146103,2,309,0)="""RTN"",""XOBVSYSI"",35,0)"
^XMB(3.9,146103,2,310,0)=" IF TYPE=""cleanupPartition"" DO CLEANUP(.TYPE) GOTO REQHDLRQ"
^XMB(3.9,146103,2,311,0)="""RTN"",""XOBVSYSI"",36,0)"
^XMB(3.9,146103,2,312,0)=" ;"
^XMB(3.9,146103,2,313,0)="""RTN"",""XOBVSYSI"",37,0)"
^XMB(3.9,146103,2,314,0)=" ; --  heartbeat request "
^XMB(3.9,146103,2,315,0)="""RTN"",""XOBVSYSI"",38,0)"
^XMB(3.9,146103,2,316,0)=" IF TYPE=""heartbeat"" DO HB(.TYPE) GOTO REQHDLRQ"
^XMB(3.9,146103,2,317,0)="""RTN"",""XOBVSYSI"",39,0)"
^XMB(3.9,146103,2,318,0)=" ;"
^XMB(3.9,146103,2,319,0)="""RTN"",""XOBVSYSI"",40,0)"
^XMB(3.9,146103,2,320,0)=" ; --  system info request "
^XMB(3.9,146103,2,321,0)="""RTN"",""XOBVSYSI"",41,0)"
^XMB(3.9,146103,2,322,0)=" IF TYPE=""systemInfo"" DO SYSINFO(.TYPE) GOTO REQHDLRQ"
^XMB(3.9,146103,2,323,0)="""RTN"",""XOBVSYSI"",42,0)"
^XMB(3.9,146103,2,324,0)=" ;"
^XMB(3.9,146103,2,325,0)="""RTN"",""XOBVSYSI"",43,0)"
^XMB(3.9,146103,2,326,0)=" ; -- failure if processing get here"
^XMB(3.9,146103,2,327,0)="""RTN"",""XOBVSYSI"",44,0)"
^XMB(3.9,146103,2,328,0)=" DO RESPONSE(.TYPE,""failure"")"
^XMB(3.9,146103,2,329,0)="""RTN"",""XOBVSYSI"",45,0)"
^XMB(3.9,146103,2,330,0)=" ;"
^XMB(3.9,146103,2,331,0)="""RTN"",""XOBVSYSI"",46,0)"
^XMB(3.9,146103,2,332,0)="REQHDLRQ ;"
^XMB(3.9,146103,2,333,0)="""RTN"",""XOBVSYSI"",47,0)"
^XMB(3.9,146103,2,334,0)=" QUIT"
^XMB(3.9,146103,2,335,0)="""RTN"",""XOBVSYSI"",48,0)"
^XMB(3.9,146103,2,336,0)=" ;"
^XMB(3.9,146103,2,337,0)="""RTN"",""XOBVSYSI"",49,0)"
^XMB(3.9,146103,2,338,0)="ENV ; -- set env variable"
^XMB(3.9,146103,2,339,0)="""RTN"",""XOBVSYSI"",50,0)"
^XMB(3.9,146103,2,340,0)=" SET XOBSYS(""ENV"")=$GET(XOBDATA(""XOB SYSTEM"",""ENV""))"
^XMB(3.9,146103,2,341,0)="""RTN"",""XOBVSYSI"",51,0)"
^XMB(3.9,146103,2,342,0)=" QUIT"
^XMB(3.9,146103,2,343,0)="""RTN"",""XOBVSYSI"",52,0)"
^XMB(3.9,146103,2,344,0)=" ;"
^XMB(3.9,146103,2,345,0)="""RTN"",""XOBVSYSI"",53,0)"
^XMB(3.9,146103,2,346,0)="PSTANUM ; -- set primary station number"
^XMB(3.9,146103,2,347,0)="""RTN"",""XOBVSYSI"",54,0)"
^XMB(3.9,146103,2,348,0)=" SET XOBSYS(""PRIMARY STATION#"")=$$TRUNCCH($$STA^XUAF4($$KSP^XUPARAM(""INST"")))"
^XMB(3.9,146103,2,349,0)="""RTN"",""XOBVSYSI"",55,0)"
^XMB(3.9,146103,2,350,0)=" ; note: AAC 200M is truncated to 200"
^XMB(3.9,146103,2,351,0)="""RTN"",""XOBVSYSI"",56,0)"
^XMB(3.9,146103,2,352,0)=" QUIT"
^XMB(3.9,146103,2,353,0)="""RTN"",""XOBVSYSI"",57,0)"
^XMB(3.9,146103,2,354,0)=" ;"
^XMB(3.9,146103,2,355,0)="""RTN"",""XOBVSYSI"",58,0)"
^XMB(3.9,146103,2,356,0)="INIT(TYPE) ; -- handle initialize request"
^XMB(3.9,146103,2,357,0)="""RTN"",""XOBVSYSI"",59,0)"
^XMB(3.9,146103,2,358,0)=" KILL XOBSYS"
^XMB(3.9,146103,2,359,0)="""RTN"",""XOBVSYSI"",60,0)"
^XMB(3.9,146103,2,360,0)=" DO ENV"
^XMB(3.9,146103,2,361,0)="""RTN"",""XOBVSYSI"",61,0)"
^XMB(3.9,146103,2,362,0)=" DO PSTANUM"
^XMB(3.9,146103,2,363,0)="""RTN"",""XOBVSYSI"",62,0)"
^XMB(3.9,146103,2,364,0)=" ;"
^XMB(3.9,146103,2,365,0)="""RTN"",""XOBVSYSI"",63,0)"
^XMB(3.9,146103,2,366,0)=" IF ""^j2se^j2ee^.net^""[(U_XOBSYS(""ENV"")_U) DO"
^XMB(3.9,146103,2,367,0)="""RTN"",""XOBVSYSI"",64,0)"
^XMB(3.9,146103,2,368,0)=" . DO RESPONSE(.TYPE,""success"",$$RATE()_$$JOB()_$$RASTO())"
^XMB(3.9,146103,2,369,0)="""RTN"",""XOBVSYSI"",65,0)"
^XMB(3.9,146103,2,370,0)=" ELSE  DO"
^XMB(3.9,146103,2,371,0)="""RTN"",""XOBVSYSI"",66,0)"
^XMB(3.9,146103,2,372,0)=" . DO RESPONSE(.TYPE,""failure"")"
^XMB(3.9,146103,2,373,0)="""RTN"",""XOBVSYSI"",67,0)"
^XMB(3.9,146103,2,374,0)=" QUIT"
^XMB(3.9,146103,2,375,0)="""RTN"",""XOBVSYSI"",68,0)"
^XMB(3.9,146103,2,376,0)=" ;"
^XMB(3.9,146103,2,377,0)="""RTN"",""XOBVSYSI"",69,0)"
^XMB(3.9,146103,2,378,0)="CLOSE(TYPE) ; -- handle close socket request"
^XMB(3.9,146103,2,379,0)="""RTN"",""XOBVSYSI"",70,0)"
^XMB(3.9,146103,2,380,0)=" SET XOBSTOP=1"
^XMB(3.9,146103,2,381,0)="""RTN"",""XOBVSYSI"",71,0)"
^XMB(3.9,146103,2,382,0)=" DO RESPONSE(.TYPE,""success"")"
^XMB(3.9,146103,2,383,0)="""RTN"",""XOBVSYSI"",72,0)"
^XMB(3.9,146103,2,384,0)=" QUIT"
^XMB(3.9,146103,2,385,0)="""RTN"",""XOBVSYSI"",73,0)"
^XMB(3.9,146103,2,386,0)=" ;"
^XMB(3.9,146103,2,387,0)="""RTN"",""XOBVSYSI"",74,0)"
^XMB(3.9,146103,2,388,0)="CLEANUP(TYPE) ; -- handle cleanup partition request"
^XMB(3.9,146103,2,389,0)="""RTN"",""XOBVSYSI"",75,0)"
^XMB(3.9,146103,2,390,0)=" ; -- unlock any pending locks"
^XMB(3.9,146103,2,391,0)="""RTN"",""XOBVSYSI"",76,0)"
^XMB(3.9,146103,2,392,0)=" LOCK"
^XMB(3.9,146103,2,393,0)="""RTN"",""XOBVSYSI"",77,0)"
^XMB(3.9,146103,2,394,0)=" ;"
^XMB(3.9,146103,2,395,0)="""RTN"",""XOBVSYSI"",78,0)"
^XMB(3.9,146103,2,396,0)=" ; -- clean ^TMP, ^UTILITY, ^XUTL"
^XMB(3.9,146103,2,397,0)="""RTN"",""XOBVSYSI"",79,0)"
^XMB(3.9,146103,2,398,0)=" DO XUTL^XUSCLEAN"
^XMB(3.9,146103,2,399,0)="""RTN"",""XOBVSYSI"",80,0)"
^XMB(3.9,146103,2,400,0)=" ;"
^XMB(3.9,146103,2,401,0)="""RTN"",""XOBVSYSI"",81,0)"
^XMB(3.9,146103,2,402,0)=" ; -- restore DUZ to connector user"
^XMB(3.9,146103,2,403,0)="""RTN"",""XOBVSYSI"",82,0)"
^XMB(3.9,146103,2,404,0)=" KILL DUZ"
^XMB(3.9,146103,2,405,0)="""RTN"",""XOBVSYSI"",83,0)"
^XMB(3.9,146103,2,406,0)=" MERGE DUZ=XOBSYS(""DUZ"")"
^XMB(3.9,146103,2,407,0)="""RTN"",""XOBVSYSI"",84,0)"
^XMB(3.9,146103,2,408,0)=" ;"
^XMB(3.9,146103,2,409,0)="""RTN"",""XOBVSYSI"",85,0)"
^XMB(3.9,146103,2,410,0)=" ; -- clean symbol table"
^XMB(3.9,146103,2,411,0)="""RTN"",""XOBVSYSI"",86,0)"
^XMB(3.9,146103,2,412,0)=" DO KILL^XOBVLL"
^XMB(3.9,146103,2,413,0)="""RTN"",""XOBVSYSI"",87,0)"
^XMB(3.9,146103,2,414,0)=" ;"
^XMB(3.9,146103,2,415,0)="""RTN"",""XOBVSYSI"",88,0)"
^XMB(3.9,146103,2,416,0)=" DO RESPONSE(.TYPE,""success"")"
^XMB(3.9,146103,2,417,0)="""RTN"",""XOBVSYSI"",89,0)"
^XMB(3.9,146103,2,418,0)=" QUIT"
^XMB(3.9,146103,2,419,0)="""RTN"",""XOBVSYSI"",90,0)"
^XMB(3.9,146103,2,420,0)=" ;"
^XMB(3.9,146103,2,421,0)="""RTN"",""XOBVSYSI"",91,0)"
^XMB(3.9,146103,2,422,0)="DUZSV(DUZ) ; -- save initial DUZ info for session"
^XMB(3.9,146103,2,423,0)="""RTN"",""XOBVSYSI"",92,0)"
^XMB(3.9,146103,2,424,0)=" IF $GET(XOBSYS(""ENV""))=""j2ee"" DO"
^XMB(3.9,146103,2,425,0)="""RTN"",""XOBVSYSI"",93,0)"
^XMB(3.9,146103,2,426,0)=" . KILL XOBSYS(""DUZ"")"
^XMB(3.9,146103,2,427,0)="""RTN"",""XOBVSYSI"",94,0)"
^XMB(3.9,146103,2,428,0)=" . MERGE XOBSYS(""DUZ"")=DUZ"
^XMB(3.9,146103,2,429,0)="""RTN"",""XOBVSYSI"",95,0)"
^XMB(3.9,146103,2,430,0)=" QUIT"
^XMB(3.9,146103,2,431,0)="""RTN"",""XOBVSYSI"",96,0)"
^XMB(3.9,146103,2,432,0)=" ;"
^XMB(3.9,146103,2,433,0)="""RTN"",""XOBVSYSI"",97,0)"
^XMB(3.9,146103,2,434,0)="HB(TYPE) ; -- handle heartbeat request"
^XMB(3.9,146103,2,435,0)="""RTN"",""XOBVSYSI"",98,0)"
^XMB(3.9,146103,2,436,0)=" DO ENV"
^XMB(3.9,146103,2,437,0)="""RTN"",""XOBVSYSI"",99,0)"
^XMB(3.9,146103,2,438,0)=" DO RESPONSE(.TYPE,""success"",$$RATE())"
^XMB(3.9,146103,2,439,0)="""RTN"",""XOBVSYSI"",100,0)"
^XMB(3.9,146103,2,440,0)=" QUIT"
^XMB(3.9,146103,2,441,0)="""RTN"",""XOBVSYSI"",101,0)"
^XMB(3.9,146103,2,442,0)=" ;"
^XMB(3.9,146103,2,443,0)="""RTN"",""XOBVSYSI"",102,0)"
^XMB(3.9,146103,2,444,0)="RATE() ; -- set up rate attribute for response"
^XMB(3.9,146103,2,445,0)="""RTN"",""XOBVSYSI"",103,0)"
^XMB(3.9,146103,2,446,0)=" NEW XOBRATE"
^XMB(3.9,146103,2,447,0)="""RTN"",""XOBVSYSI"",104,0)"
^XMB(3.9,146103,2,448,0)=" ; -- get J2EE timeout value for app serv environment"
^XMB(3.9,146103,2,449,0)="""RTN"",""XOBVSYSI"",105,0)"
^XMB(3.9,146103,2,450,0)=" IF $GET(XOBSYS(""ENV""))=""j2ee"" DO"
^XMB(3.9,146103,2,451,0)="""RTN"",""XOBVSYSI"",106,0)"
^XMB(3.9,146103,2,452,0)=" . SET XOBRATE=$$GETASTO^XOBVLIB()"
^XMB(3.9,146103,2,453,0)="""RTN"",""XOBVSYSI"",107,0)"
^XMB(3.9,146103,2,454,0)=" ELSE  DO"
^XMB(3.9,146103,2,455,0)="""RTN"",""XOBVSYSI"",108,0)"
^XMB(3.9,146103,2,456,0)=" . SET XOBRATE=$$GETRATE^XOBVLIB()"
^XMB(3.9,146103,2,457,0)="""RTN"",""XOBVSYSI"",109,0)"
^XMB(3.9,146103,2,458,0)=" QUIT "" rate=""""""_XOBRATE_"""""""""
^XMB(3.9,146103,2,459,0)="""RTN"",""XOBVSYSI"",110,0)"
^XMB(3.9,146103,2,460,0)=" ;"
^XMB(3.9,146103,2,461,0)="""RTN"",""XOBVSYSI"",111,0)"
^XMB(3.9,146103,2,462,0)="JOB() ; -- set up $JOB attribute for response"
^XMB(3.9,146103,2,463,0)="""RTN"",""XOBVSYSI"",112,0)"
^XMB(3.9,146103,2,464,0)=" QUIT "" mJob=""""""_$JOB_"""""""""
^XMB(3.9,146103,2,465,0)="""RTN"",""XOBVSYSI"",113,0)"
^XMB(3.9,146103,2,466,0)=" ;"
^XMB(3.9,146103,2,467,0)="""RTN"",""XOBVSYSI"",114,0)"
^XMB(3.9,146103,2,468,0)="RASTO() ; -- set up ReAuthenticated Session TimeOut"
^XMB(3.9,146103,2,469,0)="""RTN"",""XOBVSYSI"",115,0)"
^XMB(3.9,146103,2,470,0)=" QUIT "" reAuthSessionTimeout=""""""_$$GETRASTO^XOBVLIB()_"""""""""
^XMB(3.9,146103,2,471,0)="""RTN"",""XOBVSYSI"",116,0)"
^XMB(3.9,146103,2,472,0)=" ;"
^XMB(3.9,146103,2,473,0)="""RTN"",""XOBVSYSI"",117,0)"
^XMB(3.9,146103,2,474,0)="RESPONSE(TYPE,STATUS,ATTRS) ; -- build xml response"
^XMB(3.9,146103,2,475,0)="""RTN"",""XOBVSYSI"",118,0)"
^XMB(3.9,146103,2,476,0)=" ; -- initialize"
^XMB(3.9,146103,2,477,0)="""RTN"",""XOBVSYSI"",119,0)"
^XMB(3.9,146103,2,478,0)=" DO PRE^XOBVSKT"
^XMB(3.9,146103,2,479,0)="""RTN"",""XOBVSYSI"",120,0)"
^XMB(3.9,146103,2,480,0)=" DO WRITE^XOBVSKT($$VLHDR^XOBVLIB(4))"
^XMB(3.9,146103,2,481,0)="""RTN"",""XOBVSYSI"",121,0)"
^XMB(3.9,146103,2,482,0)=" DO WRITE^XOBVSKT(""<Response type=""""""_$GET(TYPE)_"""""" status=""""""_$GET(STATUS)_""""""""_$GET(ATTRS,"""")_"" />"")"
^XMB(3.9,146103,2,483,0)="""RTN"",""XOBVSYSI"",122,0)"
^XMB(3.9,146103,2,484,0)=" DO WRITE^XOBVSKT($$ENVFTR^XOBVLIB())"
^XMB(3.9,146103,2,485,0)="""RTN"",""XOBVSYSI"",123,0)"
^XMB(3.9,146103,2,486,0)=" ; -- send eot and flush buffer"
^XMB(3.9,146103,2,487,0)="""RTN"",""XOBVSYSI"",124,0)"
^XMB(3.9,146103,2,488,0)=" DO POST^XOBVSKT"
^XMB(3.9,146103,2,489,0)="""RTN"",""XOBVSYSI"",125,0)"
^XMB(3.9,146103,2,490,0)=" QUIT"
^XMB(3.9,146103,2,491,0)="""RTN"",""XOBVSYSI"",126,0)"
^XMB(3.9,146103,2,492,0)=" ;"
^XMB(3.9,146103,2,493,0)="""RTN"",""XOBVSYSI"",127,0)"
^XMB(3.9,146103,2,494,0)="SYSINFO(TYPE) ; -- build system info response"
^XMB(3.9,146103,2,495,0)="""RTN"",""XOBVSYSI"",128,0)"
^XMB(3.9,146103,2,496,0)=" NEW XOBINFO,XOBELE,XOBDEFLT,XOBINTRO,XOBI"
^XMB(3.9,146103,2,497,0)="""RTN"",""XOBVSYSI"",129,0)"
^XMB(3.9,146103,2,498,0)=" ;"
^XMB(3.9,146103,2,499,0)="""RTN"",""XOBVSYSI"",130,0)"
^XMB(3.9,146103,2,500,0)=" ; -- set up default value"
^XMB(3.9,146103,2,501,0)="""RTN"",""XOBVSYSI"",131,0)"
^XMB(3.9,146103,2,502,0)=" SET XOBDEFLT=""unknown"""
^XMB(3.9,146103,2,503,0)="""RTN"",""XOBVSYSI"",132,0)"
^XMB(3.9,146103,2,504,0)=" ;"
^XMB(3.9,146103,2,505,0)="""RTN"",""XOBVSYSI"",133,0)"
^XMB(3.9,146103,2,506,0)=" ; -- get system info array"
^XMB(3.9,146103,2,507,0)="""RTN"",""XOBVSYSI"",134,0)"
^XMB(3.9,146103,2,508,0)=" DO GETSINFO(.XOBINFO)"
^XMB(3.9,146103,2,509,0)="""RTN"",""XOBVSYSI"",135,0)"
^XMB(3.9,146103,2,510,0)=" ;"
^XMB(3.9,146103,2,511,0)="""RTN"",""XOBVSYSI"",136,0)"
^XMB(3.9,146103,2,512,0)=" ; -- build <SystemInfo> element"
^XMB(3.9,146103,2,513,0)="""RTN"",""XOBVSYSI"",137,0)"
^XMB(3.9,146103,2,514,0)=" SET XOBELE=""<SystemInfo"""
^XMB(3.9,146103,2,515,0)="""RTN"",""XOBVSYSI"",138,0)"
^XMB(3.9,146103,2,516,0)=" SET XOBELE=XOBELE_"" vistalinkVersion=""""""_$GET(XOBINFO(""version""),XOBDEFLT)_"""""""""
^XMB(3.9,146103,2,517,0)="""RTN"",""XOBVSYSI"",139,0)"
^XMB(3.9,146103,2,518,0)=" SET XOBELE=XOBELE_"" vistalinkBuild=""""""_$GET(XOBINFO(""build""),XOBDEFLT)_"""""""""
^XMB(3.9,146103,2,519,0)="""RTN"",""XOBVSYSI"",140,0)"
^XMB(3.9,146103,2,520,0)=" SET XOBELE=XOBELE_"" appServerTimeout=""""""_$GET(XOBINFO(""appServerTimeout""),XOBDEFLT)_"""""""""
^XMB(3.9,146103,2,521,0)="""RTN"",""XOBVSYSI"",141,0)"
^XMB(3.9,146103,2,522,0)=" SET XOBELE=XOBELE_"" reAuthSessionTimeout=""""""_$GET(XOBINFO(""reAuthSessionTimeout""),XOBDEFLT)_"""""""""
^XMB(3.9,146103,2,523,0)="""RTN"",""XOBVSYSI"",142,0)"
^XMB(3.9,146103,2,524,0)=" SET XOBELE=XOBELE_"" uci=""""""_$GET(XOBINFO(""uci""),XOBDEFLT)_"""""""""
^XMB(3.9,146103,2,525,0)="""RTN"",""XOBVSYSI"",143,0)"
^XMB(3.9,146103,2,526,0)=" SET XOBELE=XOBELE_"" vol=""""""_$GET(XOBINFO(""vol""),XOBDEFLT)_"""""""""
^XMB(3.9,146103,2,527,0)="""RTN"",""XOBVSYSI"",144,0)"
^XMB(3.9,146103,2,528,0)=" SET XOBELE=XOBELE_"" boxVolume=""""""_$GET(XOBINFO(""boxVolume""),XOBDEFLT)_"""""""""
^XMB(3.9,146103,2,529,0)="""RTN"",""XOBVSYSI"",145,0)"
^XMB(3.9,146103,2,530,0)=" SET XOBELE=XOBELE_"" mVersion=""""""_$GET(XOBINFO(""mVersion""),XOBDEFLT)_"""""""""
^XMB(3.9,146103,2,531,0)="""RTN"",""XOBVSYSI"",146,0)"
^XMB(3.9,146103,2,532,0)=" SET XOBELE=XOBELE_"" operatingSystem=""""""_$GET(XOBINFO(""operatingSystem""),XOBDEFLT)_"""""""""
^XMB(3.9,146103,2,533,0)="""RTN"",""XOBVSYSI"",147,0)"
^XMB(3.9,146103,2,534,0)=" SET XOBELE=XOBELE_"" domainName=""""""_$GET(XOBINFO(""domainName""),XOBDEFLT)_"""""""""
^XMB(3.9,146103,2,535,0)="""RTN"",""XOBVSYSI"",148,0)"
^XMB(3.9,146103,2,536,0)=" SET XOBELE=XOBELE_"" vistaProduction=""""""_$GET(XOBINFO(""vistaProduction""),XOBDEFLT)_"""""""""
^XMB(3.9,146103,2,537,0)="""RTN"",""XOBVSYSI"",149,0)"
^XMB(3.9,146103,2,538,0)=" SET XOBELE=XOBELE_"" defaultInstitution=""""""_$GET(XOBINFO(""defaultInstitution""),XOBDEFLT)_"""""""""
^XMB(3.9,146103,2,539,0)="""RTN"",""XOBVSYSI"",150,0)"
^XMB(3.9,146103,2,540,0)=" SET XOBELE=XOBELE_"" cpName=""""""_$GET(XOBINFO(""cpName""),XOBDEFLT)_"""""""""
^XMB(3.9,146103,2,541,0)="""RTN"",""XOBVSYSI"",151,0)"
^XMB(3.9,146103,2,542,0)=" SET XOBELE=XOBELE_"" />"""
^XMB(3.9,146103,2,543,0)="""RTN"",""XOBVSYSI"",152,0)"
^XMB(3.9,146103,2,544,0)=" ;"
^XMB(3.9,146103,2,545,0)="""RTN"",""XOBVSYSI"",153,0)"
^XMB(3.9,146103,2,546,0)=" SET XOBINTRO=$GET(XOBINFO(""introductoryText""))"
^XMB(3.9,146103,2,547,0)="""RTN"",""XOBVSYSI"",154,0)"
^XMB(3.9,146103,2,548,0)=" ;"
^XMB(3.9,146103,2,549,0)="""RTN"",""XOBVSYSI"",155,0)"
^XMB(3.9,146103,2,550,0)=" ; -- build and send complete message"
^XMB(3.9,146103,2,551,0)="""RTN"",""XOBVSYSI"",156,0)"
^XMB(3.9,146103,2,552,0)=" DO PRE^XOBVSKT"
^XMB(3.9,146103,2,553,0)="""RTN"",""XOBVSYSI"",157,0)"
^XMB(3.9,146103,2,554,0)=" DO WRITE^XOBVSKT($$VLHDR^XOBVLIB(4))"
^XMB(3.9,146103,2,555,0)="""RTN"",""XOBVSYSI"",158,0)"
^XMB(3.9,146103,2,556,0)=" DO WRITE^XOBVSKT(""<Response type=""""""_$GET(TYPE)_"""""" status=""""success"""" >"")"
^XMB(3.9,146103,2,557,0)="""RTN"",""XOBVSYSI"",159,0)"
^XMB(3.9,146103,2,558,0)=" DO WRITE^XOBVSKT(XOBELE)"
^XMB(3.9,146103,2,559,0)="""RTN"",""XOBVSYSI"",160,0)"
^XMB(3.9,146103,2,560,0)=" FOR XOBI=1:1  QUIT:'$DATA(XOBINFO(""introductoryText"",XOBI))  DO"
^XMB(3.9,146103,2,561,0)="""RTN"",""XOBVSYSI"",161,0)"
^XMB(3.9,146103,2,562,0)=" . DO WRITE^XOBVSKT(XOBINFO(""introductoryText"",XOBI))"
^XMB(3.9,146103,2,563,0)="""RTN"",""XOBVSYSI"",162,0)"
^XMB(3.9,146103,2,564,0)=" DO WRITE^XOBVSKT(""</Response>"")"
^XMB(3.9,146103,2,565,0)="""RTN"",""XOBVSYSI"",163,0)"
^XMB(3.9,146103,2,566,0)=" DO WRITE^XOBVSKT($$ENVFTR^XOBVLIB())"
^XMB(3.9,146103,2,567,0)="""RTN"",""XOBVSYSI"",164,0)"
^XMB(3.9,146103,2,568,0)=" DO POST^XOBVSKT"
^XMB(3.9,146103,2,569,0)="""RTN"",""XOBVSYSI"",165,0)"
^XMB(3.9,146103,2,570,0)=" ;"
^XMB(3.9,146103,2,571,0)="""RTN"",""XOBVSYSI"",166,0)"
^XMB(3.9,146103,2,572,0)=" QUIT"
^XMB(3.9,146103,2,573,0)="""RTN"",""XOBVSYSI"",167,0)"
^XMB(3.9,146103,2,574,0)=" ;"
^XMB(3.9,146103,2,575,0)="""RTN"",""XOBVSYSI"",168,0)"
^XMB(3.9,146103,2,576,0)="GETSINFO(XOBINFO) ; -- gather system info into array"
^XMB(3.9,146103,2,577,0)="""RTN"",""XOBVSYSI"",169,0)"
^XMB(3.9,146103,2,578,0)=" NEW X,Y"
^XMB(3.9,146103,2,579,0)="""RTN"",""XOBVSYSI"",170,0)"
^XMB(3.9,146103,2,580,0)=" ;"
^XMB(3.9,146103,2,581,0)="""RTN"",""XOBVSYSI"",171,0)"
^XMB(3.9,146103,2,582,0)=" ; -- get version"
^XMB(3.9,146103,2,583,0)="""RTN"",""XOBVSYSI"",172,0)"
^XMB(3.9,146103,2,584,0)=" SET XOBINFO(""version"")=$PIECE($TEXT(XOBVSYSI+1),"";"",3)"
^XMB(3.9,146103,2,585,0)="""RTN"",""XOBVSYSI"",173,0)"
^XMB(3.9,146103,2,586,0)=" ;"
^XMB(3.9,146103,2,587,0)="""RTN"",""XOBVSYSI"",174,0)"
^XMB(3.9,146103,2,588,0)=" ; -- get build number"
^XMB(3.9,146103,2,589,0)="""RTN"",""XOBVSYSI"",175,0)"
^XMB(3.9,146103,2,590,0)=" SET XOBINFO(""build"")=$PIECE($TEXT(XOBVSYSI+1),"";"",7)"
^XMB(3.9,146103,2,591,0)="""RTN"",""XOBVSYSI"",176,0)"
^XMB(3.9,146103,2,592,0)=" ;"
^XMB(3.9,146103,2,593,0)="""RTN"",""XOBVSYSI"",177,0)"
^XMB(3.9,146103,2,594,0)=" ; -- get application server connection timeout"
^XMB(3.9,146103,2,595,0)="""RTN"",""XOBVSYSI"",178,0)"
^XMB(3.9,146103,2,596,0)=" SET XOBINFO(""appServerTimeout"")=$$GETASTO^XOBVLIB()"
^XMB(3.9,146103,2,597,0)="""RTN"",""XOBVSYSI"",179,0)"
^XMB(3.9,146103,2,598,0)=" ;"
^XMB(3.9,146103,2,599,0)="""RTN"",""XOBVSYSI"",180,0)"
^XMB(3.9,146103,2,600,0)=" ; -- get reauthentication session timeout"
^XMB(3.9,146103,2,601,0)="""RTN"",""XOBVSYSI"",181,0)"
^XMB(3.9,146103,2,602,0)=" SET XOBINFO(""reAuthSessionTimeout"")=$$GETRASTO^XOBVLIB()"
^XMB(3.9,146103,2,603,0)="""RTN"",""XOBVSYSI"",182,0)"
^XMB(3.9,146103,2,604,0)=" ;"
^XMB(3.9,146103,2,605,0)="""RTN"",""XOBVSYSI"",183,0)"
^XMB(3.9,146103,2,606,0)=" ; -- get basic M environment information"
^XMB(3.9,146103,2,607,0)="""RTN"",""XOBVSYSI"",184,0)"
^XMB(3.9,146103,2,608,0)=" SET Y="""""
^XMB(3.9,146103,2,609,0)="""RTN"",""XOBVSYSI"",185,0)"
^XMB(3.9,146103,2,610,0)=" DO GETENV^%ZOSV"
^XMB(3.9,146103,2,611,0)="""RTN"",""XOBVSYSI"",186,0)"
^XMB(3.9,146103,2,612,0)=" ;"
^XMB(3.9,146103,2,613,0)="""RTN"",""XOBVSYSI"",187,0)"
^XMB(3.9,146103,2,614,0)=" ; -- get uci"
^XMB(3.9,146103,2,615,0)="""RTN"",""XOBVSYSI"",188,0)"
^XMB(3.9,146103,2,616,0)=" SET XOBINFO(""uci"")=$PIECE(Y,U,1)"
^XMB(3.9,146103,2,617,0)="""RTN"",""XOBVSYSI"",189,0)"
^XMB(3.9,146103,2,618,0)=" ;"
^XMB(3.9,146103,2,619,0)="""RTN"",""XOBVSYSI"",190,0)"
^XMB(3.9,146103,2,620,0)=" ; -- get vol"
^XMB(3.9,146103,2,621,0)="""RTN"",""XOBVSYSI"",191,0)"
^XMB(3.9,146103,2,622,0)=" SET XOBINFO(""vol"")=$PIECE(Y,U,2)"
^XMB(3.9,146103,2,623,0)="""RTN"",""XOBVSYSI"",192,0)"
^XMB(3.9,146103,2,624,0)=" ;"
^XMB(3.9,146103,2,625,0)="""RTN"",""XOBVSYSI"",193,0)"
^XMB(3.9,146103,2,626,0)=" ; -- get box volume"
^XMB(3.9,146103,2,627,0)="""RTN"",""XOBVSYSI"",194,0)"
^XMB(3.9,146103,2,628,0)=" SET XOBINFO(""boxVolume"")=$PIECE(Y,U,4)"
^XMB(3.9,146103,2,629,0)="""RTN"",""XOBVSYSI"",195,0)"
^XMB(3.9,146103,2,630,0)=" ;"
^XMB(3.9,146103,2,631,0)="""RTN"",""XOBVSYSI"",196,0)"
^XMB(3.9,146103,2,632,0)=" ; -- get M version (full name)"
^XMB(3.9,146103,2,633,0)="""RTN"",""XOBVSYSI"",197,0)"
^XMB(3.9,146103,2,634,0)=" SET XOBINFO(""mVersion"")=$$SYMENC^MXMLUTL($$VERSION^%ZOSV(1))"
^XMB(3.9,146103,2,635,0)="""RTN"",""XOBVSYSI"",198,0)"
^XMB(3.9,146103,2,636,0)=" ;"
^XMB(3.9,146103,2,637,0)="""RTN"",""XOBVSYSI"",199,0)"
^XMB(3.9,146103,2,638,0)=" ; -- get operating system"
^XMB(3.9,146103,2,639,0)="""RTN"",""XOBVSYSI"",200,0)"
^XMB(3.9,146103,2,640,0)=" SET XOBINFO(""operatingSystem"")=$$SYMENC^MXMLUTL($$SYSOS^XOBVLIB(XOBOS))"
^XMB(3.9,146103,2,641,0)="""RTN"",""XOBVSYSI"",201,0)"
^XMB(3.9,146103,2,642,0)=" ;"
^XMB(3.9,146103,2,643,0)="""RTN"",""XOBVSYSI"",202,0)"
^XMB(3.9,146103,2,644,0)=" ; -- get domain name"
^XMB(3.9,146103,2,645,0)="""RTN"",""XOBVSYSI"",203,0)"
^XMB(3.9,146103,2,646,0)=" SET XOBINFO(""domainName"")=$$SYMENC^MXMLUTL($$KSP^XUPARAM(""WHERE""))"
^XMB(3.9,146103,2,647,0)="""RTN"",""XOBVSYSI"",204,0)"
^XMB(3.9,146103,2,648,0)=" ;"
^XMB(3.9,146103,2,649,0)="""RTN"",""XOBVSYSI"",205,0)"
^XMB(3.9,146103,2,650,0)=" ; -- production or test"
^XMB(3.9,146103,2,651,0)="""RTN"",""XOBVSYSI"",206,0)"
^XMB(3.9,146103,2,652,0)=" SET XOBINFO(""vistaProduction"")=$S($$PROD^XUPROD(0):""true"",1:""false"")"
^XMB(3.9,146103,2,653,0)="""RTN"",""XOBVSYSI"",207,0)"
^XMB(3.9,146103,2,654,0)=" ;"
^XMB(3.9,146103,2,655,0)="""RTN"",""XOBVSYSI"",208,0)"
^XMB(3.9,146103,2,656,0)=" ; -- default institution"
^XMB(3.9,146103,2,657,0)="""RTN"",""XOBVSYSI"",209,0)"
^XMB(3.9,146103,2,658,0)=" SET XOBINFO(""defaultInstitution"")=$$SYMENC^MXMLUTL($$STA^XUAF4($$KSP^XUPARAM(""INST""))_""/""_$$NAME^XUAF4($$KSP^XUPARAM(""INST"")))"
^XMB(3.9,146103,2,659,0)="""RTN"",""XOBVSYSI"",210,0)"
^XMB(3.9,146103,2,660,0)=" ;"
^XMB(3.9,146103,2,661,0)="""RTN"",""XOBVSYSI"",211,0)"
^XMB(3.9,146103,2,662,0)=" ; -- get intro text"
^XMB(3.9,146103,2,663,0)="""RTN"",""XOBVSYSI"",212,0)"
^XMB(3.9,146103,2,664,0)=" D GETINTRO^XOBSCAV2(""XOBINFO(""""introductoryText"""")"",1)"
^XMB(3.9,146103,2,665,0)="""RTN"",""XOBVSYSI"",213,0)"
^XMB(3.9,146103,2,666,0)=" ;"
^XMB(3.9,146103,2,667,0)="""RTN"",""XOBVSYSI"",214,0)"
^XMB(3.9,146103,2,668,0)=" ; -- get c/p username"
^XMB(3.9,146103,2,669,0)="""RTN"",""XOBVSYSI"",215,0)"
^XMB(3.9,146103,2,670,0)=" SET XOBINFO(""cpName"")=$$NAME^XUSER(DUZ)"
^XMB(3.9,146103,2,671,0)="""RTN"",""XOBVSYSI"",216,0)"
^XMB(3.9,146103,2,672,0)=" ;"
^XMB(3.9,146103,2,673,0)="""RTN"",""XOBVSYSI"",217,0)"
^XMB(3.9,146103,2,674,0)=" QUIT"
^XMB(3.9,146103,2,675,0)="""RTN"",""XOBVSYSI"",218,0)"
^XMB(3.9,146103,2,676,0)=" ;"
^XMB(3.9,146103,2,677,0)="""RTN"",""XOBVSYSI"",219,0)"
^XMB(3.9,146103,2,678,0)="RPC(XOBY) ;"
^XMB(3.9,146103,2,679,0)="""RTN"",""XOBVSYSI"",220,0)"
^XMB(3.9,146103,2,680,0)=" NEW XOBX,XOBLINE,XOBARR"
^XMB(3.9,146103,2,681,0)="""RTN"",""XOBVSYSI"",221,0)"
^XMB(3.9,146103,2,682,0)=" D GETSINFO(.XOBARR)"
^XMB(3.9,146103,2,683,0)="""RTN"",""XOBVSYSI"",222,0)"
^XMB(3.9,146103,2,684,0)=" SET XOBLINE=0"
^XMB(3.9,146103,2,685,0)="""RTN"",""XOBVSYSI"",223,0)"
^XMB(3.9,146103,2,686,0)=" S XOBX="""" F  S XOBX=$O(XOBARR(XOBX)) Q:XOBX']""""  D"
^XMB(3.9,146103,2,687,0)="""RTN"",""XOBVSYSI"",224,0)"
^XMB(3.9,146103,2,688,0)=" . SET XOBLINE=XOBLINE+1"
^XMB(3.9,146103,2,689,0)="""RTN"",""XOBVSYSI"",225,0)"
^XMB(3.9,146103,2,690,0)=" . SET XOBY(XOBLINE)=XOBX_""~""_XOBARR(XOBX)"
^XMB(3.9,146103,2,691,0)="""RTN"",""XOBVSYSI"",226,0)"
^XMB(3.9,146103,2,692,0)=" QUIT"
^XMB(3.9,146103,2,693,0)="""RTN"",""XOBVSYSI"",227,0)"
^XMB(3.9,146103,2,694,0)=" ;"
^XMB(3.9,146103,2,695,0)="""RTN"",""XOBVSYSI"",228,0)"
^XMB(3.9,146103,2,696,0)="TRUNCCH(XOBSTR) ; truncate before first non-numeric char"
^XMB(3.9,146103,2,697,0)="""RTN"",""XOBVSYSI"",229,0)"
^XMB(3.9,146103,2,698,0)=" NEW XOBI,XOBSTOP,XOBSTR1"
^XMB(3.9,146103,2,699,0)="""RTN"",""XOBVSYSI"",230,0)"
^XMB(3.9,146103,2,700,0)=" SET XOBSTOP=0,XOBSTR1="""""
^XMB(3.9,146103,2,701,0)="""RTN"",""XOBVSYSI"",231,0)"
^XMB(3.9,146103,2,702,0)=" FOR XOBI=1:1:$L(XOBSTR) QUIT:XOBSTOP  DO"
^XMB(3.9,146103,2,703,0)="""RTN"",""XOBVSYSI"",232,0)"
^XMB(3.9,146103,2,704,0)=" . IF ""0123456789""'[$E(XOBSTR,XOBI) SET XOBSTOP=1 QUIT"
^XMB(3.9,146103,2,705,0)="""RTN"",""XOBVSYSI"",233,0)"
^XMB(3.9,146103,2,706,0)=" . SET XOBSTR1=XOBSTR1_$E(XOBSTR,XOBI)"
^XMB(3.9,146103,2,707,0)="""RTN"",""XOBVSYSI"",234,0)"
^XMB(3.9,146103,2,708,0)=" QUIT XOBSTR1"
^XMB(3.9,146103,2,709,0)="""VER"")"
^XMB(3.9,146103,2,710,0)="8.0^22.2"
^XMB(3.9,146103,2,711,0)="$END KID XOBV*1.6*9b"
