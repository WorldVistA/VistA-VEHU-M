^XMB(3.9,146036,2,3098,0)=" .. I DUZ'=$$GET1^DIQ(396.17,DVBIEN,2,""I"") Q  ;Document Manager"
^XMB(3.9,146036,2,3099,0)="""RTN"",""DVBSIGN"",170,0)"
^XMB(3.9,146036,2,3100,0)=" .. I DVBSTAT=""A"" S DVBCNTA=DVBCNTA+1"
^XMB(3.9,146036,2,3101,0)="""RTN"",""DVBSIGN"",171,0)"
^XMB(3.9,146036,2,3102,0)=" .. I DVBSTAT=""D"" S DVBCNTD=DVBCNTD+1"
^XMB(3.9,146036,2,3103,0)="""RTN"",""DVBSIGN"",172,0)"
^XMB(3.9,146036,2,3104,0)=" .. I DVBSTAT=""O"" S DVBCNTO=DVBCNTO+1"
^XMB(3.9,146036,2,3105,0)="""RTN"",""DVBSIGN"",173,0)"
^XMB(3.9,146036,2,3106,0)=" .. I DVBSTAT=""S"" S DVBCNTS=DVBCNTS+1"
