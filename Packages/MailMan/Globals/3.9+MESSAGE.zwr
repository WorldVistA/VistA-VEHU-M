^XMB(3.9,146047,2,2688,0)="EBSUMMARY(DFN,RIEN,SOI,ARRAY) ; Added IB*806"
^XMB(3.9,146047,2,2689,0)="""RTN"",""IBCNEUT2"",142,0)"
