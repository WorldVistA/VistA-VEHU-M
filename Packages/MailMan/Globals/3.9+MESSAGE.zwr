^XMB(3.9,146018,2,1862,0)=" ;"
^XMB(3.9,146018,2,1863,0)="""RTN"",""VAFCPTAD"",274,0)"
^XMB(3.9,146018,2,1864,0)="UPDNC(VAFCDFN,NAME) ;Update name components; Return 1 if updated"
^XMB(3.9,146018,2,1865,0)="""RTN"",""VAFCPTAD"",275,0)"
^XMB(3.9,146018,2,1866,0)=" ;**1050,VAMPI-9503 (mko): New subroutine"
