^XMB(3.9,146036,2,3034,0)="TRAINSIG(DVBRTN,DVBIEN) ;"
^XMB(3.9,146036,2,3035,0)="""RTN"",""DVBSIGN"",138,0)"
^XMB(3.9,146036,2,3036,0)=" ;Send the DUZ and DIV for the Trainee CAPRI-12506 CP-8/13/24"
^XMB(3.9,146036,2,3037,0)="""RTN"",""DVBSIGN"",139,0)"
^XMB(3.9,146036,2,3038,0)=" ;DVBA CAPRI TRAINEE SIGNATURE"
^XMB(3.9,146036,2,3039,0)="""RTN"",""DVBSIGN"",140,0)"
^XMB(3.9,146036,2,3040,0)=" N DVBDATA,DVBMULT"
^XMB(3.9,146036,2,3041,0)="""RTN"",""DVBSIGN"",141,0)"
^XMB(3.9,146036,2,3042,0)=" S DVBRTN="""""
^XMB(3.9,146036,2,3043,0)="""RTN"",""DVBSIGN"",142,0)"
^XMB(3.9,146036,2,3044,0)=" I DVBIEN="""" S DVBRTN=""-1^No Worksheet IEN sent"" Q"
^XMB(3.9,146036,2,3045,0)="""RTN"",""DVBSIGN"",143,0)"
^XMB(3.9,146036,2,3046,0)=" I $D(^DVB(396.17,DVBIEN))<10 S DVBRTN=""-1^Invalid Worksheet IEN"" Q"
^XMB(3.9,146036,2,3047,0)="""RTN"",""DVBSIGN"",144,0)"
^XMB(3.9,146036,2,3048,0)=" I $D(^DVB(396.17,DVBIEN,6))<10 S DVBRTN=""-1^No Review Data Saved"""
^XMB(3.9,146036,2,3049,0)="""RTN"",""DVBSIGN"",145,0)"
^XMB(3.9,146036,2,3050,0)=" S DVBMULT="""""
^XMB(3.9,146036,2,3051,0)="""RTN"",""DVBSIGN"",146,0)"
^XMB(3.9,146036,2,3052,0)=" F  S DVBMULT=$O(^DVB(396.17,DVBIEN,6,DVBMULT)) Q:DVBMULT=""""  Q:DVBRTN'=""""  D"
^XMB(3.9,146036,2,3053,0)="""RTN"",""DVBSIGN"",147,0)"
^XMB(3.9,146036,2,3054,0)=" . S DVBDATA=$G(^DVB(396.17,DVBIEN,6,DVBMULT,1,1,0))"
^XMB(3.9,146036,2,3055,0)="""RTN"",""DVBSIGN"",148,0)"
^XMB(3.9,146036,2,3056,0)=" . I $P(DVBDATA,U,1)=""TRAINEE"" S DVBRTN=$P(DVBDATA,U,2,3) Q"
^XMB(3.9,146036,2,3057,0)="""RTN"",""DVBSIGN"",149,0)"
^XMB(3.9,146036,2,3058,0)=" I DVBRTN="""" S DVBRTN=""-1^No details found"" Q"
^XMB(3.9,146036,2,3059,0)="""RTN"",""DVBSIGN"",150,0)"
^XMB(3.9,146036,2,3060,0)=" Q"
^XMB(3.9,146036,2,3061,0)="""RTN"",""DVBSIGN"",151,0)"
^XMB(3.9,146036,2,3062,0)=" ;"
^XMB(3.9,146036,2,3063,0)="""RTN"",""DVBSIGN"",152,0)"
^XMB(3.9,146036,2,3064,0)="STATCNT(DVBRTN) ;"
^XMB(3.9,146036,2,3065,0)="""RTN"",""DVBSIGN"",153,0)"
^XMB(3.9,146036,2,3066,0)=" ;New RPC code for CAPRI-12825.  JD - 8/14/24"
^XMB(3.9,146036,2,3067,0)="""RTN"",""DVBSIGN"",154,0)"
^XMB(3.9,146036,2,3068,0)=" ;RPC: DVBA CAPRI STATUS COUNT"
^XMB(3.9,146036,2,3069,0)="""RTN"",""DVBSIGN"",155,0)"
^XMB(3.9,146036,2,3070,0)=" ;Added statuses D=Draft/Not Ready and O=Outdated Template.  JD - 8/21/24"
^XMB(3.9,146036,2,3071,0)="""RTN"",""DVBSIGN"",156,0)"
^XMB(3.9,146036,2,3072,0)=" ;"
^XMB(3.9,146036,2,3073,0)="""RTN"",""DVBSIGN"",157,0)"
^XMB(3.9,146036,2,3074,0)=" ;Returns the count for the following worksheet review statuses:"
^XMB(3.9,146036,2,3075,0)="""RTN"",""DVBSIGN"",158,0)"
^XMB(3.9,146036,2,3076,0)=" ;A=Awaiting Signature, D=Draft/Not ready, O=Outdated Template, P=Review Pending, S=Sent Back"
^XMB(3.9,146036,2,3077,0)="""RTN"",""DVBSIGN"",159,0)"
^XMB(3.9,146036,2,3078,0)=" ;"
^XMB(3.9,146036,2,3079,0)="""RTN"",""DVBSIGN"",160,0)"
^XMB(3.9,146036,2,3080,0)=" N DVBCNTA,DVBCNTD,DVBCNTO,DVBCNTP,DVBCNTS,DVBIEN,DVBP,DVBSTAT"
^XMB(3.9,146036,2,3081,0)="""RTN"",""DVBSIGN"",161,0)"
^XMB(3.9,146036,2,3082,0)=" S (DVBSTAT,DVBRTN)="""""
^XMB(3.9,146036,2,3083,0)="""RTN"",""DVBSIGN"",162,0)"
^XMB(3.9,146036,2,3084,0)=" S (DVBCNTA,DVBCNTD,DVBCNTO,DVBCNTP,DVBCNTS)=0"
^XMB(3.9,146036,2,3085,0)="""RTN"",""DVBSIGN"",163,0)"
^XMB(3.9,146036,2,3086,0)=" F  S DVBSTAT=$O(^DVB(396.17,""RS"",DVBSTAT)) Q:DVBSTAT=""""  D"
^XMB(3.9,146036,2,3087,0)="""RTN"",""DVBSIGN"",164,0)"
^XMB(3.9,146036,2,3088,0)=" . I ""ADOPS""'[DVBSTAT Q"
^XMB(3.9,146036,2,3089,0)="""RTN"",""DVBSIGN"",165,0)"
^XMB(3.9,146036,2,3090,0)=" . S DVBIEN="""""
^XMB(3.9,146036,2,3091,0)="""RTN"",""DVBSIGN"",166,0)"
^XMB(3.9,146036,2,3092,0)=" . F  S DVBIEN=$O(^DVB(396.17,""RS"",DVBSTAT,DVBIEN)) Q:DVBIEN=""""  D"
^XMB(3.9,146036,2,3093,0)="""RTN"",""DVBSIGN"",167,0)"
^XMB(3.9,146036,2,3094,0)=" .. S DVBP="""" D PASCALCHK^DVBCTPDF(.DVBP,DVBIEN) I DVBP=""P"" Q  ;CMT worksheets only!"
^XMB(3.9,146036,2,3095,0)="""RTN"",""DVBSIGN"",168,0)"
^XMB(3.9,146036,2,3096,0)=" .. I DVBSTAT=""P"" S DVBCNTP=DVBCNTP+1"
