^XMB(3.9,146012,2,905,0)="""RTN"",""PSOERRX0"",215,0)"
^XMB(3.9,146012,2,906,0)=" W !!,""#"",?4,""ERX PROVIDER NAME"",?35,""NPI"",?48,""CITY"",?68,""STATE"""
^XMB(3.9,146012,2,907,0)="""RTN"",""PSOERRX0"",216,0)"
^XMB(3.9,146012,2,908,0)=" S (QUIT,CNT)=0,$P(XX,""-"",80)="""" W !,XX K DIRUT,DTOUT"
