^XMB(3.9,146087,2,3717,0)="""RTN"",""YTQRQAD4"",345,0)"
^XMB(3.9,146087,2,3718,0)=" ;"
^XMB(3.9,146087,2,3719,0)="""RTN"",""YTQRQAD4"",346,0)"
^XMB(3.9,146087,2,3720,0)="UPDTSRFL ;"
^XMB(3.9,146087,2,3721,0)="""RTN"",""YTQRQAD4"",347,0)"
^XMB(3.9,146087,2,3722,0)=" ;   Set index for 601.84 MH ADMINISTRATIONS"
^XMB(3.9,146087,2,3723,0)="""RTN"",""YTQRQAD4"",348,0)"
^XMB(3.9,146087,2,3724,0)=" ;      X(1)=Patient X(2)=Instrument X(3)=Date Given"
^XMB(3.9,146087,2,3725,0)="""RTN"",""YTQRQAD4"",349,0)"
^XMB(3.9,146087,2,3726,0)=" ;      ^PXRMINDX(601.84,""IP"",X(2),X(1),X(3),DA)="""""
^XMB(3.9,146087,2,3727,0)="""RTN"",""YTQRQAD4"",350,0)"
^XMB(3.9,146087,2,3728,0)=" ;      ^PXRMINDX(601.84,""PI"",X(1),X(2),X(3),DA)="""""
^XMB(3.9,146087,2,3729,0)="""RTN"",""YTQRQAD4"",351,0)"
^XMB(3.9,146087,2,3730,0)=" N INSTIEN,TEMP,SRCALL"
^XMB(3.9,146087,2,3731,0)="""RTN"",""YTQRQAD4"",352,0)"
^XMB(3.9,146087,2,3732,0)=" S INSTIEN="""""
^XMB(3.9,146087,2,3733,0)="""RTN"",""YTQRQAD4"",353,0)"
^XMB(3.9,146087,2,3734,0)=" F  S INSTIEN=$O(^PXRMINDX(601.84,""PI"",DFN,INSTIEN)) Q:INSTIEN=""""  D  ;Get list of instr IENs"
^XMB(3.9,146087,2,3735,0)="""RTN"",""YTQRQAD4"",354,0)"
^XMB(3.9,146087,2,3736,0)=" . S TEMP=$G(^YTT(601.71,INSTIEN,9))"
^XMB(3.9,146087,2,3737,0)="""RTN"",""YTQRQAD4"",355,0)"
