^XMB(3.9,146047,2,834,0)=" F IBFLD=.01:0 S IBFLD=$O(@IBDATA@(IBPL,IBFLD)) Q:IBFLD'>0  S @IBFDA@(355.32,IBIEN_"","",IBFLD)=$G(@IBDATA@(IBPL,IBFLD,""E""))"
