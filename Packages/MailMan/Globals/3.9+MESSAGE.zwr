^XMB(3.9,146055,2,249,0)="""RTN"",""PSOSUCH1"",4,0)"
^XMB(3.9,146055,2,250,0)="LISTSUS S X=""?"",DIC(""S"")=""I $D(^PSRX(+$P(^PS(52.5,+Y,0),""""^""""),0)),$P($G(^(""""STA"""")),""""^"""")<11,$P($G(^PS(52.5,+Y,""""P"""")),""""^"""")=0"",DIC=""^PS(52.5,"",DIC(0)=""ZQ"" D ^DIC K DIC W ! Q:Y<0!($D(DTOUT))  Q"
