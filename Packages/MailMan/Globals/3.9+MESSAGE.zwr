^XMB(3.9,146089,2,1918,0)=" .;PSO*7*505 - END"
^XMB(3.9,146089,2,1919,0)="""RTN"",""PSOORFIN"",177,0)"
^XMB(3.9,146089,2,1920,0)=" .D:$P(^PS(52.41,ORD,0),""^"",3)'=""DC""&($P(^(0),""^"",3)'=""DE"")&($P(^(0),""^"",3)'=""HD"") LK1,ORD"
^XMB(3.9,146089,2,1921,0)="""RTN"",""PSOORFIN"",178,0)"
