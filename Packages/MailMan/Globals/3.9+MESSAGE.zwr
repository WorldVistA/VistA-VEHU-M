^XMB(3.9,146106,2,2916,0)=" I $$ORDERCHECKLOCK^SDES2APPTUTIL(.ERRORS,$G(APPOINTMENT(""REQUEST TYPE"")),$G(APPOINTMENT(""DFN"")))"
^XMB(3.9,146106,2,2917,0)="""RTN"",""SDES2CREATEAPPT2"",282,0)"
^XMB(3.9,146106,2,2918,0)=" I $$INACTIVE^SDESUTIL($G(APPOINTMENT(""CLINIC IEN""))) D ERRLOG^SDESJSON(.ERRORS,19)"
^XMB(3.9,146106,2,2919,0)="""RTN"",""SDES2CREATEAPPT2"",283,0)"
^XMB(3.9,146106,2,2920,0)=" I $$APPTIN44EXISTS^SDES2APPTUTIL($G(APPOINTMENT(""DFN"")),$G(APPOINTMENT(""CLINIC IEN"")),$G(APPOINTMENT(""START DATE TIME""))) D ERRLOG^SDESJSON(.ERRORS,175)"
