^XMB(3.9,146020,2,1012,0)=" ; just to protect the process"
^XMB(3.9,146020,2,1013,0)="""RTN"",""MPIFXMLP"",171,0)"
^XMB(3.9,146020,2,1014,0)=" S MPIN=$G(MPIN)"
^XMB(3.9,146020,2,1015,0)="""RTN"",""MPIFXMLP"",172,0)"
^XMB(3.9,146020,2,1016,0)=" S MPIA(""type"")=$G(MPIA(""type""))"
^XMB(3.9,146020,2,1017,0)="""RTN"",""MPIFXMLP"",173,0)"
^XMB(3.9,146020,2,1018,0)=" S MPIA(""subtype"")=$G(MPIA(""subtype""))"
