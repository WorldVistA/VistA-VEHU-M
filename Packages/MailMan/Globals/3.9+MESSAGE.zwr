^XMB(3.9,146036,2,3379,0)="""RTN"",""DVBUTIL"",134,0)"
^XMB(3.9,146036,2,3380,0)=" Q"
^XMB(3.9,146036,2,3381,0)="""RTN"",""DVBUTIL"",135,0)"
^XMB(3.9,146036,2,3382,0)="WKSHBYEXAM(DVBRETURN,DVBEXAM) ;"
^XMB(3.9,146036,2,3383,0)="""RTN"",""DVBUTIL"",136,0)"
^XMB(3.9,146036,2,3384,0)=" ;New RPC to pull Worksheet IEN from Exam IEN CAPRI-13257 CP 9-11-24"
