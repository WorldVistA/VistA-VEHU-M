^XMB(3.9,146036,2,3173,0)="""RTN"",""DVBUTIL"",31,0)"
^XMB(3.9,146036,2,3174,0)=" . . D ^DIE"
^XMB(3.9,146036,2,3175,0)="""RTN"",""DVBUTIL"",32,0)"
