^XMB(3.9,146012,2,1674,0)="VPRVFLTR ; - VistA Provider Filter"
^XMB(3.9,146012,2,1675,0)="""RTN"",""PSOERRX1"",246,0)"
^XMB(3.9,146012,2,1676,0)=" N DIR,PRV,XX,RANGE,COMSEG,I,J,VPRV,EPRV,DIRUT,DIROUT,QUIT"
^XMB(3.9,146012,2,1677,0)="""RTN"",""PSOERRX1"",247,0)"
^XMB(3.9,146012,2,1678,0)="REP1 ; - Repeat VistA Provider Prompt"
^XMB(3.9,146012,2,1679,0)="""RTN"",""PSOERRX1"",248,0)"
^XMB(3.9,146012,2,1680,0)=" S DIR(0)=""F^3:30"",DIR(""A"")=""VISTA PROVIDER NAME"""
^XMB(3.9,146012,2,1681,0)="""RTN"",""PSOERRX1"",249,0)"
^XMB(3.9,146012,2,1682,0)=" W ! D ^DIR I $D(DIRUT)!$D(DIROUT) Q"
^XMB(3.9,146012,2,1683,0)="""RTN"",""PSOERRX1"",250,0)"
^XMB(3.9,146012,2,1684,0)=" I $$CHKPRV2^PSOERX1A(Y)"
^XMB(3.9,146012,2,1685,0)="""RTN"",""PSOERRX1"",251,0)"
^XMB(3.9,146012,2,1686,0)=" D FIND^DIC(200,"""",""@;.01;.114;.115;53.2;IX"","""",X,,""B"",""I $$CHKPRV2^PSOERX1A(Y)"","""",""PRVLST"")"
^XMB(3.9,146012,2,1687,0)="""RTN"",""PSOERRX1"",252,0)"
^XMB(3.9,146012,2,1688,0)=" I '$D(PRVLST(""DILIST"",2)) W !,""No VistA Provider found"",$C(7) K PRVLST G REP1"
^XMB(3.9,146012,2,1689,0)="""RTN"",""PSOERRX1"",253,0)"
^XMB(3.9,146012,2,1690,0)=" ;"
^XMB(3.9,146012,2,1691,0)="""RTN"",""PSOERRX1"",254,0)"
^XMB(3.9,146012,2,1692,0)=" D PRVLHDR"
^XMB(3.9,146012,2,1693,0)="""RTN"",""PSOERRX1"",255,0)"
^XMB(3.9,146012,2,1694,0)=" S (QUIT,CNT)=0 K DIRUT,DTOUT"
^XMB(3.9,146012,2,1695,0)="""RTN"",""PSOERRX1"",256,0)"
^XMB(3.9,146012,2,1696,0)=" S PRV="""" F  S PRV=$O(PRVLST(""DILIST"",""ID"",PRV)) Q:'PRV  D  I QUIT Q"
^XMB(3.9,146012,2,1697,0)="""RTN"",""PSOERRX1"",257,0)"
^XMB(3.9,146012,2,1698,0)=" . W !,PRV,""."",?4,$E(PRVLST(""DILIST"",""ID"",PRV,.01),1,30),?35,PRVLST(""DILIST"",""ID"",PRV,53.2)"
^XMB(3.9,146012,2,1699,0)="""RTN"",""PSOERRX1"",258,0)"
^XMB(3.9,146012,2,1700,0)=" . I PRVLST(""DILIST"",""ID"",PRV,.114)'="""" D"
^XMB(3.9,146012,2,1701,0)="""RTN"",""PSOERRX1"",259,0)"
^XMB(3.9,146012,2,1702,0)=" . . W ?47,$E(PRVLST(""DILIST"",""ID"",PRV,.114),1,20),""-"",$$STATEABB^PSOERUT(200,PRVLST(""DILIST"",2,PRV))"
^XMB(3.9,146012,2,1703,0)="""RTN"",""PSOERRX1"",260,0)"
^XMB(3.9,146012,2,1704,0)=" . W ?71,$$FMTE^XLFDT($$LASTREDT^PSOERUT(""AVPRV"",PRVLST(""DILIST"",2,PRV)),""2Z"")"
^XMB(3.9,146012,2,1705,0)="""RTN"",""PSOERRX1"",261,0)"
^XMB(3.9,146012,2,1706,0)=" . S CNT=CNT+1"
^XMB(3.9,146012,2,1707,0)="""RTN"",""PSOERRX1"",262,0)"
^XMB(3.9,146012,2,1708,0)=" . I CNT>18,$O(PRVLST(""DILIST"",""ID"",PRV)),$Y>(IOSL-4) D"
^XMB(3.9,146012,2,1709,0)="""RTN"",""PSOERRX1"",263,0)"
^XMB(3.9,146012,2,1710,0)=" . . K DIR S DIR(0)=""E"" D ^DIR I $D(DIRUT)!$D(DIROUT) S QUIT=1 Q"
^XMB(3.9,146012,2,1711,0)="""RTN"",""PSOERRX1"",264,0)"
^XMB(3.9,146012,2,1712,0)=" . . W @IOF D PRVLHDR"
^XMB(3.9,146012,2,1713,0)="""RTN"",""PSOERRX1"",265,0)"
^XMB(3.9,146012,2,1714,0)=" ;"
^XMB(3.9,146012,2,1715,0)="""RTN"",""PSOERRX1"",266,0)"
^XMB(3.9,146012,2,1716,0)=" K DIR S DIR(""A"")=""SELECT (1-""_+$G(PRVLST(""DILIST"",0))_""): """
^XMB(3.9,146012,2,1717,0)="""RTN"",""PSOERRX1"",267,0)"
^XMB(3.9,146012,2,1718,0)=" S DIR(0)=""LA^1:""_+$G(PRVLST(""DILIST"",0)) W ! D ^DIR I $D(DIRUT)!$D(DIROUT) G REP1"
^XMB(3.9,146012,2,1719,0)="""RTN"",""PSOERRX1"",268,0)"
^XMB(3.9,146012,2,1720,0)=" S RANGE=X"
^XMB(3.9,146012,2,1721,0)="""RTN"",""PSOERRX1"",269,0)"
^XMB(3.9,146012,2,1722,0)=" ;"
^XMB(3.9,146012,2,1723,0)="""RTN"",""PSOERRX1"",270,0)"
^XMB(3.9,146012,2,1724,0)=" K VPRVFLTR,PRVFLTR"
^XMB(3.9,146012,2,1725,0)="""RTN"",""PSOERRX1"",271,0)"
^XMB(3.9,146012,2,1726,0)=" F I=1:1:$L(RANGE,"","") D"
^XMB(3.9,146012,2,1727,0)="""RTN"",""PSOERRX1"",272,0)"
^XMB(3.9,146012,2,1728,0)=" . S COMSEG=$P(RANGE,"","",I)"
^XMB(3.9,146012,2,1729,0)="""RTN"",""PSOERRX1"",273,0)"
^XMB(3.9,146012,2,1730,0)=" . F J=+COMSEG:1:$S(COMSEG[""-"":$P(COMSEG,""-"",2),1:+COMSEG) D"
^XMB(3.9,146012,2,1731,0)="""RTN"",""PSOERRX1"",274,0)"
^XMB(3.9,146012,2,1732,0)=" . . S VPRV=+$G(PRVLST(""DILIST"",2,J)) I 'VPRV Q"
^XMB(3.9,146012,2,1733,0)="""RTN"",""PSOERRX1"",275,0)"
^XMB(3.9,146012,2,1734,0)=" . . S VPRVFLTR(VPRV)="""""
^XMB(3.9,146012,2,1735,0)="""RTN"",""PSOERRX1"",276,0)"
^XMB(3.9,146012,2,1736,0)=" . . S EPRV=0 F  S EPRV=$O(^PS(52.49,""AVPRV"",VPRV,EPRV)) Q:'EPRV  D"
^XMB(3.9,146012,2,1737,0)="""RTN"",""PSOERRX1"",277,0)"
^XMB(3.9,146012,2,1738,0)=" . . . S PRVFLTR(EPRV)="""""
^XMB(3.9,146012,2,1739,0)="""RTN"",""PSOERRX1"",278,0)"
^XMB(3.9,146012,2,1740,0)=" ;"
^XMB(3.9,146012,2,1741,0)="""RTN"",""PSOERRX1"",279,0)"
^XMB(3.9,146012,2,1742,0)=" I '$D(PRVFLTR) W !!,""There are no eRx Providers associated with the VistA Provider(s) selected."",$C(7) K VPRVFLTR G REP1"
^XMB(3.9,146012,2,1743,0)="""RTN"",""PSOERRX1"",280,0)"
^XMB(3.9,146012,2,1744,0)=" Q"
^XMB(3.9,146012,2,1745,0)="""RTN"",""PSOERRX1"",281,0)"
^XMB(3.9,146012,2,1746,0)=" ;"
^XMB(3.9,146012,2,1747,0)="""RTN"",""PSOERRX1"",282,0)"
^XMB(3.9,146012,2,1748,0)="PRVLHDR ; - Prints the Provider List Header"
^XMB(3.9,146012,2,1749,0)="""RTN"",""PSOERRX1"",283,0)"
^XMB(3.9,146012,2,1750,0)=" N XX W !?73,""LAST"",!,""#"",?4,""VISTA PROVIDER NAME"",?35,""DEA"",?47,""CITY"",?71,""REC.DATE"""
^XMB(3.9,146012,2,1751,0)="""RTN"",""PSOERRX1"",284,0)"
^XMB(3.9,146012,2,1752,0)=" S $P(XX,""-"",80)="""" W !,XX"
^XMB(3.9,146012,2,1753,0)="""RTN"",""PSOERRX1"",285,0)"
^XMB(3.9,146012,2,1754,0)=" Q"
^XMB(3.9,146012,2,1755,0)="""RTN"",""PSOERRX1"",286,0)"
^XMB(3.9,146012,2,1756,0)=" ;"
^XMB(3.9,146012,2,1757,0)="""RTN"",""PSOERRX1"",287,0)"
^XMB(3.9,146012,2,1758,0)="VDRGFLTR ;VistA Drug Filter"
^XMB(3.9,146012,2,1759,0)="""RTN"",""PSOERRX1"",288,0)"
^XMB(3.9,146012,2,1760,0)=" ;- input vars for ^DIC call"
^XMB(3.9,146012,2,1761,0)="""RTN"",""PSOERRX1"",289,0)"
^XMB(3.9,146012,2,1762,0)=" N DIC,DTOUT,DUOUT,X,Y,DRGFLTR"
^XMB(3.9,146012,2,1763,0)="""RTN"",""PSOERRX1"",290,0)"
^XMB(3.9,146012,2,1764,0)="REPDRG ;Repeat VistA Drug Prompt"
^XMB(3.9,146012,2,1765,0)="""RTN"",""PSOERRX1"",291,0)"
^XMB(3.9,146012,2,1766,0)=" I $G(VDRGFLTR) S DIC(""B"")=$$GET1^DIQ(50,VDRGFLTR,.01)"
^XMB(3.9,146012,2,1767,0)="""RTN"",""PSOERRX1"",292,0)"
^XMB(3.9,146012,2,1768,0)=" W !"
^XMB(3.9,146012,2,1769,0)="""RTN"",""PSOERRX1"",293,0)"
^XMB(3.9,146012,2,1770,0)=" S DIC=50,DIC(0)=""AEMQZV"",DIC(""A"")=""VISTA DRUG: """
^XMB(3.9,146012,2,1771,0)="""RTN"",""PSOERRX1"",294,0)"
^XMB(3.9,146012,2,1772,0)=" S DIC(""?PARAM"",50,""INDEX"")=""B"""
^XMB(3.9,146012,2,1773,0)="""RTN"",""PSOERRX1"",295,0)"
^XMB(3.9,146012,2,1774,0)=" ;- lookup VISTA DRUG"
^XMB(3.9,146012,2,1775,0)="""RTN"",""PSOERRX1"",296,0)"
^XMB(3.9,146012,2,1776,0)=" D ^DIC K DIC"
^XMB(3.9,146012,2,1777,0)="""RTN"",""PSOERRX1"",297,0)"
^XMB(3.9,146012,2,1778,0)=" ;- result of lookup"
^XMB(3.9,146012,2,1779,0)="""RTN"",""PSOERRX1"",298,0)"
^XMB(3.9,146012,2,1780,0)=" I +$G(Y)<1 Q  ;user either press enter or ^"
^XMB(3.9,146012,2,1781,0)="""RTN"",""PSOERRX1"",299,0)"
^XMB(3.9,146012,2,1782,0)=" ;- if success, check if the selected drug exist in the ^PS(52.49,""AVDRG"" cross reference"
^XMB(3.9,146012,2,1783,0)="""RTN"",""PSOERRX1"",300,0)"
^XMB(3.9,146012,2,1784,0)=" I (+$G(Y)>0),$D(^PS(52.49,""AVDRG"",+$G(Y))) D"
^XMB(3.9,146012,2,1785,0)="""RTN"",""PSOERRX1"",301,0)"
^XMB(3.9,146012,2,1786,0)=" . S VDRGFLTR=+$G(Y)"
^XMB(3.9,146012,2,1787,0)="""RTN"",""PSOERRX1"",302,0)"
^XMB(3.9,146012,2,1788,0)=" E  W !!,IOINHI,""There are no eRx Drug(s) matched to this VistA Drug."",IOINORM,$C(7) K VDRGFLTR G REPDRG"
^XMB(3.9,146012,2,1789,0)="""RTN"",""PSOERRX1"",303,0)"
^XMB(3.9,146012,2,1790,0)=" Q"
^XMB(3.9,146012,2,1791,0)="""RTN"",""PSOERRX1"",304,0)"
^XMB(3.9,146012,2,1792,0)=" ;"
^XMB(3.9,146012,2,1793,0)="""RTN"",""PSOERRX1"",305,0)"
^XMB(3.9,146012,2,1794,0)="CHKSTSLST(ERXIEN,STSFLTR) ;Check erx order status"
^XMB(3.9,146012,2,1795,0)="""RTN"",""PSOERRX1"",306,0)"
^XMB(3.9,146012,2,1796,0)=" ;Input : ERXIEN  - Pointer to ERX HOLDING QUEUE file (#52.49)"
^XMB(3.9,146012,2,1797,0)="""RTN"",""PSOERRX1"",307,0)"
^XMB(3.9,146012,2,1798,0)=" ;        STSFLTR - Filter By eRx Status is set (Pointer to ERX HOLDING QUEUE file (#52.45))"
^XMB(3.9,146012,2,1799,0)="""RTN"",""PSOERRX1"",308,0)"
^XMB(3.9,146012,2,1800,0)=" ;Output: Return 1 if found. otherwise, 0"
^XMB(3.9,146012,2,1801,0)="""RTN"",""PSOERRX1"",309,0)"
^XMB(3.9,146012,2,1802,0)=" Q:+$G(ERXIEN)<1"
^XMB(3.9,146012,2,1803,0)="""RTN"",""PSOERRX1"",310,0)"
^XMB(3.9,146012,2,1804,0)=" N STSDTME,STSIEN,RSNIEN,FOUND,CNTR,ERXNODE1"
^XMB(3.9,146012,2,1805,0)="""RTN"",""PSOERRX1"",311,0)"
^XMB(3.9,146012,2,1806,0)=" S (FOUND,CNTR)=0"
^XMB(3.9,146012,2,1807,0)="""RTN"",""PSOERRX1"",312,0)"
^XMB(3.9,146012,2,1808,0)=" S ERXNODE1=$G(^PS(52.49,ERXIEN,1))"
^XMB(3.9,146012,2,1809,0)="""RTN"",""PSOERRX1"",313,0)"
^XMB(3.9,146012,2,1810,0)=" S STSDTME="""" F  S STSDTME=$O(^PS(52.49,ERXIEN,19,""B"",STSDTME),-1) Q:STSDTME=""""!(CNTR=2)  D  Q:FOUND"
^XMB(3.9,146012,2,1811,0)="""RTN"",""PSOERRX1"",314,0)"
^XMB(3.9,146012,2,1812,0)=" . S STSIEN="""" F  S STSIEN=$O(^PS(52.49,ERXIEN,19,""B"",STSDTME,STSIEN),-1) Q:STSIEN=""""!(CNTR=2)  D  Q:FOUND"
^XMB(3.9,146012,2,1813,0)="""RTN"",""PSOERRX1"",315,0)"
^XMB(3.9,146012,2,1814,0)=" . . S CNTR=CNTR+1"
^XMB(3.9,146012,2,1815,0)="""RTN"",""PSOERRX1"",316,0)"
^XMB(3.9,146012,2,1816,0)=" . . S RSNIEN=$P($G(^PS(52.49,ERXIEN,19,STSIEN,0)),""^"",2)"
^XMB(3.9,146012,2,1817,0)="""RTN"",""PSOERRX1"",317,0)"
^XMB(3.9,146012,2,1818,0)=" . . I $G(STSFLTR)=+ERXNODE1,$D(STSRMARY(RSNIEN)) S FOUND=1"
^XMB(3.9,146012,2,1819,0)="""RTN"",""PSOERRX1"",318,0)"
^XMB(3.9,146012,2,1820,0)=" Q FOUND"
^XMB(3.9,146012,2,1821,0)="""VER"")"
^XMB(3.9,146012,2,1822,0)="8.0^22.2"
^XMB(3.9,146012,2,1823,0)="$END KID PSO*7.0*817b"
