^XMB(3.9,146047,2,392,0)=" ;"
^XMB(3.9,146047,2,393,0)="""RTN"",""IBCNBCD2"",8,0)"
^XMB(3.9,146047,2,394,0)="COVLIM(IBBUFDA,IBGRPDA,IBCSAV,IBQ,IBERR) ; Coverage Limitations entry point. - Called from routine ACCOV^IBCNBAA"
^XMB(3.9,146047,2,395,0)="""RTN"",""IBCNBCD2"",9,0)"
