^XMB(3.9,146009,2,1167,0)="""RTN"",""XUMVINPB"",245,0)"
^XMB(3.9,146009,2,1168,0)="ACTIVE(RETURN,XUDUZ) ;person is not disuser'd, not terminated, has primary menu option"
^XMB(3.9,146009,2,1169,0)="""RTN"",""XUMVINPB"",246,0)"
^XMB(3.9,146009,2,1170,0)=" N FILE,FLDS,XUARR"
