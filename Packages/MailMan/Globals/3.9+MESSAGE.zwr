^XMB(3.9,146036,2,3232,0)=" . . S DVBBAD=$P(DVBINV,"","",DVBI2)"
^XMB(3.9,146036,2,3233,0)="""RTN"",""DVBUTIL"",61,0)"
^XMB(3.9,146036,2,3234,0)=" . . S DVBGOOD=$P(DVBRCHAR,"","",DVBCNT)"
^XMB(3.9,146036,2,3235,0)="""RTN"",""DVBUTIL"",62,0)"
^XMB(3.9,146036,2,3236,0)=" . . S DVBRETURN(DVBSEQ)=DVBBAD_U_DVBGOOD"
