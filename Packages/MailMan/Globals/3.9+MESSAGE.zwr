^XMB(3.9,146056,2,1789,0)="""RTN"",""VPRHSX1"",1,0)"
^XMB(3.9,146056,2,1790,0)="VPRHSX1 ;SLC/MKB -- HS Mgt Options cont ;09/18/18 4:36pm"
