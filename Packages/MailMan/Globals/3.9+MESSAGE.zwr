^XMB(3.9,146096,2,330,0)=" K MAGRY"
^XMB(3.9,146096,2,331,0)="""RTN"",""MAGVAQ01"",41,0)"
^XMB(3.9,146096,2,332,0)=" ; Add the record"
^XMB(3.9,146096,2,333,0)="""RTN"",""MAGVAQ01"",42,0)"
^XMB(3.9,146096,2,334,0)=" D ADDRCD^MAGVAF01(.MAGRY,2006.927,.MAGPARAM,.MAGWP)"
