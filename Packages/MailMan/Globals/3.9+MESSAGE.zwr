^XMB(3.9,146087,2,975,0)="""RTN"",""YTQRCDB"",168,0)"
^XMB(3.9,146087,2,976,0)=" S YS(4)=""3^""_DATA(""dateGiven"")"
^XMB(3.9,146087,2,977,0)="""RTN"",""YTQRCDB"",169,0)"
^XMB(3.9,146087,2,978,0)=" S YS(5)=""4^NOW"""
^XMB(3.9,146087,2,979,0)="""RTN"",""YTQRCDB"",170,0)"
^XMB(3.9,146087,2,980,0)=" S YS(6)=""5^`""_DATA(""orderedById"")"
^XMB(3.9,146087,2,981,0)="""RTN"",""YTQRCDB"",171,0)"
^XMB(3.9,146087,2,982,0)=" S YS(7)=""6^`""_DATA(""administeredById"")"
^XMB(3.9,146087,2,983,0)="""RTN"",""YTQRCDB"",172,0)"
^XMB(3.9,146087,2,984,0)=" S YS(8)=""7^N"""
^XMB(3.9,146087,2,985,0)="""RTN"",""YTQRCDB"",173,0)"
^XMB(3.9,146087,2,986,0)=" S YS(9)=""8^""_DATA(""complete"")"
^XMB(3.9,146087,2,987,0)="""RTN"",""YTQRCDB"",174,0)"
^XMB(3.9,146087,2,988,0)=" S YS(10)=""9^""_DATA(""numAns"")"
^XMB(3.9,146087,2,989,0)="""RTN"",""YTQRCDB"",175,0)"
^XMB(3.9,146087,2,990,0)=" S YS(11)=""13^`""_DATA(""locationId"")"
^XMB(3.9,146087,2,991,0)="""RTN"",""YTQRCDB"",176,0)"
^XMB(3.9,146087,2,992,0)=" I '$L($G(DATA(""source""))) S DATA(""source"")=""web"""
^XMB(3.9,146087,2,993,0)="""RTN"",""YTQRCDB"",177,0)"
^XMB(3.9,146087,2,994,0)=" S YS(12)=""15^""_DATA(""source"")"
^XMB(3.9,146087,2,995,0)="""RTN"",""YTQRCDB"",178,0)"
^XMB(3.9,146087,2,996,0)=" I +$G(DATA(""consultId""))'=0 S YS(13)=""17^""_DATA(""consultId"")"
^XMB(3.9,146087,2,997,0)="""RTN"",""YTQRCDB"",179,0)"
^XMB(3.9,146087,2,998,0)=" D ADMSAVE^YTQAPI1(.YSDATA,.YS)"
^XMB(3.9,146087,2,999,0)="""RTN"",""YTQRCDB"",180,0)"
^XMB(3.9,146087,2,1000,0)=" I YSDATA(1)'=""[DATA]"" D SETERROR^YTQRUTL(500,""Unable to create admin"") Q 0"
^XMB(3.9,146087,2,1001,0)="""RTN"",""YTQRCDB"",181,0)"
^XMB(3.9,146087,2,1002,0)=" I 'ADMIN Q $P(YSDATA(2),U,2)  ; create new admin, ien found in 2nd piece"
^XMB(3.9,146087,2,1003,0)="""RTN"",""YTQRCDB"",182,0)"
^XMB(3.9,146087,2,1004,0)=" Q ADMIN                       ; otherwise we're updating existing admin"
^XMB(3.9,146087,2,1005,0)="""RTN"",""YTQRCDB"",183,0)"
^XMB(3.9,146087,2,1006,0)=" ;"
^XMB(3.9,146087,2,1007,0)="""RTN"",""YTQRCDB"",184,0)"
^XMB(3.9,146087,2,1008,0)="FILANS(ADMIN,DATA) ; File Answers for an ADMIN"
^XMB(3.9,146087,2,1009,0)="""RTN"",""YTQRCDB"",185,0)"
^XMB(3.9,146087,2,1010,0)=" ; Requires:  ADMIN = IEN of MH ADMINISTRATION"
^XMB(3.9,146087,2,1011,0)="""RTN"",""YTQRCDB"",186,0)"
^XMB(3.9,146087,2,1012,0)=" ;            DATA(""answers"",i,""id""/""value"")"
^XMB(3.9,146087,2,1013,0)="""RTN"",""YTQRCDB"",187,0)"
^XMB(3.9,146087,2,1014,0)=" N ARSL"
^XMB(3.9,146087,2,1015,0)="""RTN"",""YTQRCDB"",188,0)"
^XMB(3.9,146087,2,1016,0)=" I +$G(ADMIN)=0 D SETERROR^YTQRUTL(404,""Missing ADMIN ID"") Q 0"
^XMB(3.9,146087,2,1017,0)="""RTN"",""YTQRCDB"",189,0)"
^XMB(3.9,146087,2,1018,0)=" I '$D(^YTT(601.84,ADMIN)) D SETERROR^YTQRUTL(404,""Invalid ADMIN ID"") Q -1"
^XMB(3.9,146087,2,1019,0)="""RTN"",""YTQRCDB"",190,0)"
^XMB(3.9,146087,2,1020,0)=" I '$D(DATA(""answers"")) D SETERROR^YTQRUTL(404,""Missing Answers"") Q -2"
^XMB(3.9,146087,2,1021,0)="""RTN"",""YTQRCDB"",191,0)"
^XMB(3.9,146087,2,1022,0)=" S ARSL=$$QASAVE(ADMIN,.DATA)"
^XMB(3.9,146087,2,1023,0)="""RTN"",""YTQRCDB"",192,0)"
^XMB(3.9,146087,2,1024,0)=" Q ARSL"
^XMB(3.9,146087,2,1025,0)="""RTN"",""YTQRCDB"",193,0)"
^XMB(3.9,146087,2,1026,0)=" ;"
^XMB(3.9,146087,2,1027,0)="""RTN"",""YTQRCDB"",194,0)"
^XMB(3.9,146087,2,1028,0)="QASAVE(ADMIN,DATA) ; save questions and answers in DATA"
^XMB(3.9,146087,2,1029,0)="""RTN"",""YTQRCDB"",195,0)"
^XMB(3.9,146087,2,1030,0)=" ; loop through DATA to create ANS array, then YSDATA array"
^XMB(3.9,146087,2,1031,0)="""RTN"",""YTQRCDB"",196,0)"
^XMB(3.9,146087,2,1032,0)=" ; ANS(#)=questionId^choiceId    <-- radio group question"
^XMB(3.9,146087,2,1033,0)="""RTN"",""YTQRCDB"",197,0)"
^XMB(3.9,146087,2,1034,0)=" ; ANS(#,#)=wp value             <-- all others"
^XMB(3.9,146087,2,1035,0)="""RTN"",""YTQRCDB"",198,0)"
^XMB(3.9,146087,2,1036,0)=" ; Return:    1 = Success"
^XMB(3.9,146087,2,1037,0)="""RTN"",""YTQRCDB"",199,0)"
^XMB(3.9,146087,2,1038,0)=" ;            0 = Failure"
^XMB(3.9,146087,2,1039,0)="""RTN"",""YTQRCDB"",200,0)"
^XMB(3.9,146087,2,1040,0)=" N I,QNUM,QANS,QID,VAL,ANS,RT1"
^XMB(3.9,146087,2,1041,0)="""RTN"",""YTQRCDB"",201,0)"
^XMB(3.9,146087,2,1042,0)=" S QNUM=0,QANS=0"
^XMB(3.9,146087,2,1043,0)="""RTN"",""YTQRCDB"",202,0)"
^XMB(3.9,146087,2,1044,0)=" S I=0 F  S I=$O(DATA(""answers"",I)) Q:'I  D"
^XMB(3.9,146087,2,1045,0)="""RTN"",""YTQRCDB"",203,0)"
^XMB(3.9,146087,2,1046,0)=" . S QID=DATA(""answers"",I,""id"")"
^XMB(3.9,146087,2,1047,0)="""RTN"",""YTQRCDB"",204,0)"
^XMB(3.9,146087,2,1048,0)=" . S VAL=DATA(""answers"",I,""value"")"
^XMB(3.9,146087,2,1049,0)="""RTN"",""YTQRCDB"",205,0)"
^XMB(3.9,146087,2,1050,0)=" . QUIT:$E(QID)'=""q""   ; skip intros, sections"
^XMB(3.9,146087,2,1051,0)="""RTN"",""YTQRCDB"",206,0)"
^XMB(3.9,146087,2,1052,0)=" . S QNUM=QNUM+1       ; QNUM is sequence w/o intros"
^XMB(3.9,146087,2,1053,0)="""RTN"",""YTQRCDB"",207,0)"
^XMB(3.9,146087,2,1054,0)=" . S QID=$E(QID,2,999) ; remove the ""q"""
^XMB(3.9,146087,2,1055,0)="""RTN"",""YTQRCDB"",208,0)"
^XMB(3.9,146087,2,1056,0)=" . I VAL=""null"" S ANS(QNUM)=QID_U_""NOT ASKED"" QUIT"
^XMB(3.9,146087,2,1057,0)="""RTN"",""YTQRCDB"",209,0)"
^XMB(3.9,146087,2,1058,0)=" . ; QANS is number answered, don't include skipped (1155 or 1157)"
^XMB(3.9,146087,2,1059,0)="""RTN"",""YTQRCDB"",210,0)"
^XMB(3.9,146087,2,1060,0)=" . I '((VAL=""c1155"")!(VAL=""c1157"")) S QANS=QANS+1"
^XMB(3.9,146087,2,1061,0)="""RTN"",""YTQRCDB"",211,0)"
^XMB(3.9,146087,2,1062,0)=" . S RT1=0             ; response type 1 is choice question"
^XMB(3.9,146087,2,1063,0)="""RTN"",""YTQRCDB"",212,0)"
^XMB(3.9,146087,2,1064,0)=" . I VAL=""c1155""!(VAL=""c1156"")!(VAL=""c1157"") S RT1=1"
^XMB(3.9,146087,2,1065,0)="""RTN"",""YTQRCDB"",213,0)"
^XMB(3.9,146087,2,1066,0)=" . I $P($G(^YTT(601.72,QID,2)),U,2)=1 S RT1=1"
^XMB(3.9,146087,2,1067,0)="""RTN"",""YTQRCDB"",214,0)"
^XMB(3.9,146087,2,1068,0)=" . I RT1 S ANS(QNUM)=QID_U_$E(VAL,2,999) QUIT"
^XMB(3.9,146087,2,1069,0)="""RTN"",""YTQRCDB"",215,0)"
^XMB(3.9,146087,2,1070,0)=" . S ANS(QNUM)=QID D TXT2ANS(I,QNUM) ; handle longer WP values"
^XMB(3.9,146087,2,1071,0)="""RTN"",""YTQRCDB"",216,0)"
^XMB(3.9,146087,2,1072,0)=" K DATA(""answers"") ; now in ANS array (which may be large)"
^XMB(3.9,146087,2,1073,0)="""RTN"",""YTQRCDB"",217,0)"
^XMB(3.9,146087,2,1074,0)=" ; save the answers"
^XMB(3.9,146087,2,1075,0)="""RTN"",""YTQRCDB"",218,0)"
^XMB(3.9,146087,2,1076,0)=" N YSDATA"
^XMB(3.9,146087,2,1077,0)="""RTN"",""YTQRCDB"",219,0)"
^XMB(3.9,146087,2,1078,0)=" S ANS(""AD"")=ADMIN"
^XMB(3.9,146087,2,1079,0)="""RTN"",""YTQRCDB"",220,0)"
^XMB(3.9,146087,2,1080,0)=" D SAVEALL^YTQAPI17(.YSDATA,.ANS)"
^XMB(3.9,146087,2,1081,0)="""RTN"",""YTQRCDB"",221,0)"
^XMB(3.9,146087,2,1082,0)=" I YSDATA(1)'=""[DATA]"" D SETERROR^YTQRUTL(500,""Answers not saved"") Q 0"
^XMB(3.9,146087,2,1083,0)="""RTN"",""YTQRCDB"",222,0)"
^XMB(3.9,146087,2,1084,0)=" Q 1"
^XMB(3.9,146087,2,1085,0)="""RTN"",""YTQRCDB"",223,0)"
^XMB(3.9,146087,2,1086,0)="TXT2ANS(IDX,QNUM) ; Convert web to ANS format for DATA(IDX)"
^XMB(3.9,146087,2,1087,0)="""RTN"",""YTQRCDB"",224,0)"
^XMB(3.9,146087,2,1088,0)=" ; expects DATA,ANS"
^XMB(3.9,146087,2,1089,0)="""RTN"",""YTQRCDB"",225,0)"
^XMB(3.9,146087,2,1090,0)=" N LEN,LN,NODE,J"
^XMB(3.9,146087,2,1091,0)="""RTN"",""YTQRCDB"",226,0)"
^XMB(3.9,146087,2,1092,0)=" S LEN=240,LN=0"
^XMB(3.9,146087,2,1093,0)="""RTN"",""YTQRCDB"",227,0)"
^XMB(3.9,146087,2,1094,0)=" S NODE=DATA(""answers"",IDX,""value"")"
^XMB(3.9,146087,2,1095,0)="""RTN"",""YTQRCDB"",228,0)"
^XMB(3.9,146087,2,1096,0)=" D ADDSEGS(NODE)"
^XMB(3.9,146087,2,1097,0)="""RTN"",""YTQRCDB"",229,0)"
^XMB(3.9,146087,2,1098,0)=" I $D(DATA(""answers"",IDX,""value"",""\"")) D"
^XMB(3.9,146087,2,1099,0)="""RTN"",""YTQRCDB"",230,0)"
^XMB(3.9,146087,2,1100,0)=" . F J=1:1 Q:'$D(DATA(""answers"",IDX,""value"",""\"",J))  D"
^XMB(3.9,146087,2,1101,0)="""RTN"",""YTQRCDB"",231,0)"
^XMB(3.9,146087,2,1102,0)=" . . S NODE=DATA(""answers"",IDX,""value"",""\"",J)"
^XMB(3.9,146087,2,1103,0)="""RTN"",""YTQRCDB"",232,0)"
^XMB(3.9,146087,2,1104,0)=" . . D ADDSEGS(NODE)"
^XMB(3.9,146087,2,1105,0)="""RTN"",""YTQRCDB"",233,0)"
^XMB(3.9,146087,2,1106,0)=" Q"
^XMB(3.9,146087,2,1107,0)="""RTN"",""YTQRCDB"",234,0)"
^XMB(3.9,146087,2,1108,0)="ADDSEGS(NODE) ; split text in node into LEN segments with ""|"" for newlines"
^XMB(3.9,146087,2,1109,0)="""RTN"",""YTQRCDB"",235,0)"
^XMB(3.9,146087,2,1110,0)=" ; expects DATA,ANS,LEN,LN"
^XMB(3.9,146087,2,1111,0)="""RTN"",""YTQRCDB"",236,0)"
^XMB(3.9,146087,2,1112,0)=" N I,X,END,FIRST,LAST"
^XMB(3.9,146087,2,1113,0)="""RTN"",""YTQRCDB"",237,0)"
^XMB(3.9,146087,2,1114,0)=" S END=$L(NODE),LAST=0 F I=0:1 D  Q:LAST>END   ; iterate thru each segment"
^XMB(3.9,146087,2,1115,0)="""RTN"",""YTQRCDB"",238,0)"
^XMB(3.9,146087,2,1116,0)=" . S FIRST=(I*LEN)+1,LAST=(I*LEN)+LEN,LN=LN+1  ; set first&last char positions"
^XMB(3.9,146087,2,1117,0)="""RTN"",""YTQRCDB"",239,0)"
^XMB(3.9,146087,2,1118,0)=" . S X=$TR($E(NODE,FIRST,LAST),$C(10),""|"")     ; set segment, chg newline to |"
^XMB(3.9,146087,2,1119,0)="""RTN"",""YTQRCDB"",240,0)"
^XMB(3.9,146087,2,1120,0)=" . S ANS(QNUM,LN)=X"
^XMB(3.9,146087,2,1121,0)="""RTN"",""YTQRCDB"",241,0)"
^XMB(3.9,146087,2,1122,0)=" Q"
^XMB(3.9,146087,2,1123,0)="""RTN"",""YTQRCDB"",242,0)"
^XMB(3.9,146087,2,1124,0)=" ;"
^XMB(3.9,146087,2,1125,0)="""RTN"",""YTQRCDB"",243,0)"
^XMB(3.9,146087,2,1126,0)="SCOREIT(DATA,SCORES) ; Score instrument based on incoming answers."
^XMB(3.9,146087,2,1127,0)="""RTN"",""YTQRCDB"",244,0)"
^XMB(3.9,146087,2,1128,0)=" ; Expects DATA(""test"")=TEST NAME"
^XMB(3.9,146087,2,1129,0)="""RTN"",""YTQRCDB"",245,0)"
^XMB(3.9,146087,2,1130,0)=" ; Expects answers in the DATA(""answers"",i,""id""/""value"") array"
^XMB(3.9,146087,2,1131,0)="""RTN"",""YTQRCDB"",246,0)"
^XMB(3.9,146087,2,1132,0)=" N TEST,ANSWERS,YSLG"
^XMB(3.9,146087,2,1133,0)="""RTN"",""YTQRCDB"",247,0)"
^XMB(3.9,146087,2,1134,0)=" I '$D(N) N N S N=0  ;Initialize for reports if needed."
^XMB(3.9,146087,2,1135,0)="""RTN"",""YTQRCDB"",248,0)"
^XMB(3.9,146087,2,1136,0)=" S TEST=$G(DATA(""name"")) I TEST="""" D SETERROR^YTQRUTL(404,""Missing Test"") Q"
^XMB(3.9,146087,2,1137,0)="""RTN"",""YTQRCDB"",249,0)"
^XMB(3.9,146087,2,1138,0)=" S DATA(""instrumentId"")=$O(^YTT(601.71,""B"",TEST,0))"
^XMB(3.9,146087,2,1139,0)="""RTN"",""YTQRCDB"",250,0)"
^XMB(3.9,146087,2,1140,0)=" I DATA(""instrumentId"")="""" S DATA(""instrumentId"")=$O(^YTT(601.71,""B"",$TR(TEST,""_"","" ""),0))"
^XMB(3.9,146087,2,1141,0)="""RTN"",""YTQRCDB"",251,0)"
^XMB(3.9,146087,2,1142,0)=" I DATA(""instrumentId"")="""" D SETERROR^YTQRUTL(404,""Test not found"") Q"
^XMB(3.9,146087,2,1143,0)="""RTN"",""YTQRCDB"",252,0)"
^XMB(3.9,146087,2,1144,0)=" I '$D(DATA(""answers"")) D SETERROR^YTQRUTL(404,""Missing Answers"") Q"
^XMB(3.9,146087,2,1145,0)="""RTN"",""YTQRCDB"",253,0)"
^XMB(3.9,146087,2,1146,0)=" S YSLG=$$GET1^DIQ(601.71,DATA(""instrumentId"")_"","",23)"
^XMB(3.9,146087,2,1147,0)="""RTN"",""YTQRCDB"",254,0)"
^XMB(3.9,146087,2,1148,0)=" I YSLG=""Yes"" D LGSCORE(.DATA,.SCORES) Q  ;-->out Score legacy answers in 601.85"
^XMB(3.9,146087,2,1149,0)="""RTN"",""YTQRCDB"",255,0)"
^XMB(3.9,146087,2,1150,0)=" M ANSWERS=DATA(""answers"")"
^XMB(3.9,146087,2,1151,0)="""RTN"",""YTQRCDB"",256,0)"
^XMB(3.9,146087,2,1152,0)=" D CALC^YTSCOREX(TEST,.ANSWERS,.SCORES)"
^XMB(3.9,146087,2,1153,0)="""RTN"",""YTQRCDB"",257,0)"
^XMB(3.9,146087,2,1154,0)=" Q"
^XMB(3.9,146087,2,1155,0)="""RTN"",""YTQRCDB"",258,0)"
^XMB(3.9,146087,2,1156,0)="LGSCORE(DATA,SCORES) ;"
^XMB(3.9,146087,2,1157,0)="""RTN"",""YTQRCDB"",259,0)"
^XMB(3.9,146087,2,1158,0)=" ; "
^XMB(3.9,146087,2,1159,0)="""RTN"",""YTQRCDB"",260,0)"
^XMB(3.9,146087,2,1160,0)=" N TESTNM,ADFN,AUSER,ANSWERS"
^XMB(3.9,146087,2,1161,0)="""RTN"",""YTQRCDB"",261,0)"
^XMB(3.9,146087,2,1162,0)=" I '$D(DATA(""patientId"")) D SETERROR^YTQRUTL(404,""Missing patient id"") Q"
^XMB(3.9,146087,2,1163,0)="""RTN"",""YTQRCDB"",262,0)"
^XMB(3.9,146087,2,1164,0)=" S TESTNM=$G(DATA(""name""))"
^XMB(3.9,146087,2,1165,0)="""RTN"",""YTQRCDB"",263,0)"
^XMB(3.9,146087,2,1166,0)=" S ADFN=DATA(""patientId"")"
^XMB(3.9,146087,2,1167,0)="""RTN"",""YTQRCDB"",264,0)"
^XMB(3.9,146087,2,1168,0)=" S AUSER=$G(DATA(""orderedById"")) S:'AUSER AUSER=DUZ"
^XMB(3.9,146087,2,1169,0)="""RTN"",""YTQRCDB"",265,0)"
^XMB(3.9,146087,2,1170,0)=" M ANSWERS=DATA(""answers"")"
^XMB(3.9,146087,2,1171,0)="""RTN"",""YTQRCDB"",266,0)"
^XMB(3.9,146087,2,1172,0)=" D LEGACY^YTSCOREX(TESTNM,ADFN,AUSER,.ANSWERS,.SCORES)"
^XMB(3.9,146087,2,1173,0)="""RTN"",""YTQRCDB"",267,0)"
^XMB(3.9,146087,2,1174,0)=" Q"
^XMB(3.9,146087,2,1175,0)="""RTN"",""YTQRCDB2"")"
^XMB(3.9,146087,2,1176,0)="0^1^B23260673"
^XMB(3.9,146087,2,1177,0)="""RTN"",""YTQRCDB2"",1,0)"
^XMB(3.9,146087,2,1178,0)="YTQRCDB2 ;BAL/KTL - MHA CLOUD DATABASE RPC CALLS; 1/25/2017"
^XMB(3.9,146087,2,1179,0)="""RTN"",""YTQRCDB2"",2,0)"
^XMB(3.9,146087,2,1180,0)=" ;;5.01;MENTAL HEALTH;**239,250,236**;Dec 30, 1994;Build 0"
^XMB(3.9,146087,2,1181,0)="""RTN"",""YTQRCDB2"",3,0)"
^XMB(3.9,146087,2,1182,0)=" ;"
^XMB(3.9,146087,2,1183,0)="""RTN"",""YTQRCDB2"",4,0)"
^XMB(3.9,146087,2,1184,0)=" ;"
^XMB(3.9,146087,2,1185,0)="""RTN"",""YTQRCDB2"",5,0)"
^XMB(3.9,146087,2,1186,0)=" ;Reference to VADPT APIs supported by ICR #10061"
^XMB(3.9,146087,2,1187,0)="""RTN"",""YTQRCDB2"",6,0)"
^XMB(3.9,146087,2,1188,0)=" ;Reference to $$KSP^XUPARAM supported by ICR #2541"
^XMB(3.9,146087,2,1189,0)="""RTN"",""YTQRCDB2"",7,0)"
^XMB(3.9,146087,2,1190,0)=" ;Reference to DIUTC supported by ICR #6445"
^XMB(3.9,146087,2,1191,0)="""RTN"",""YTQRCDB2"",8,0)"
^XMB(3.9,146087,2,1192,0)=" ;Reference to PXRMINDX in ICR #4290"
^XMB(3.9,146087,2,1193,0)="""RTN"",""YTQRCDB2"",9,0)"
^XMB(3.9,146087,2,1194,0)=" ;"
^XMB(3.9,146087,2,1195,0)="""RTN"",""YTQRCDB2"",10,0)"
^XMB(3.9,146087,2,1196,0)=" Q"
^XMB(3.9,146087,2,1197,0)="""RTN"",""YTQRCDB2"",11,0)"
^XMB(3.9,146087,2,1198,0)="PID2(ARGS,RESULTS) ;Get additional patient demographics"
^XMB(3.9,146087,2,1199,0)="""RTN"",""YTQRCDB2"",12,0)"
^XMB(3.9,146087,2,1200,0)=" N DFN,VA,VADM,YSNM,YSDOB,YSAGE,YSSSN,YSSEX,YSSX,YSSIG"
^XMB(3.9,146087,2,1201,0)="""RTN"",""YTQRCDB2"",13,0)"
^XMB(3.9,146087,2,1202,0)=" S DFN=$G(ARGS(""dfn""))"
^XMB(3.9,146087,2,1203,0)="""RTN"",""YTQRCDB2"",14,0)"
^XMB(3.9,146087,2,1204,0)=" I +DFN=0 D SETERROR^YTQRUTL(404,""Bad patient identifier"") QUIT"
^XMB(3.9,146087,2,1205,0)="""RTN"",""YTQRCDB2"",15,0)"
^XMB(3.9,146087,2,1206,0)=" I '$D(^DPT(DFN,0)) D SETERROR^YTQRUTL(404,""Not Found: ""_DFN) QUIT"
^XMB(3.9,146087,2,1207,0)="""RTN"",""YTQRCDB2"",16,0)"
^XMB(3.9,146087,2,1208,0)=" D DEM^VADPT,PID^VADPT"
^XMB(3.9,146087,2,1209,0)="""RTN"",""YTQRCDB2"",17,0)"
^XMB(3.9,146087,2,1210,0)=" S YSNM=VADM(1)"
^XMB(3.9,146087,2,1211,0)="""RTN"",""YTQRCDB2"",18,0)"
^XMB(3.9,146087,2,1212,0)=" S YSDOB=$P(VADM(3),U,2)"
^XMB(3.9,146087,2,1213,0)="""RTN"",""YTQRCDB2"",19,0)"
^XMB(3.9,146087,2,1214,0)=" S YSAGE=VADM(4)"
^XMB(3.9,146087,2,1215,0)="""RTN"",""YTQRCDB2"",20,0)"
^XMB(3.9,146087,2,1216,0)=" S YSSSN=""xxx-xx-""_VA(""BID"")"
^XMB(3.9,146087,2,1217,0)="""RTN"",""YTQRCDB2"",21,0)"
^XMB(3.9,146087,2,1218,0)=" S YSSEX=$P(VADM(5),U,1)"
^XMB(3.9,146087,2,1219,0)="""RTN"",""YTQRCDB2"",22,0)"
^XMB(3.9,146087,2,1220,0)=" S YSSX=YSSEX"
^XMB(3.9,146087,2,1221,0)="""RTN"",""YTQRCDB2"",23,0)"
^XMB(3.9,146087,2,1222,0)=" S YSSIG=$P($G(VADM(14,5)),U,2)"
^XMB(3.9,146087,2,1223,0)="""RTN"",""YTQRCDB2"",24,0)"
^XMB(3.9,146087,2,1224,0)=" S RESULTS(""dob"")=YSDOB"
^XMB(3.9,146087,2,1225,0)="""RTN"",""YTQRCDB2"",25,0)"
^XMB(3.9,146087,2,1226,0)=" S RESULTS(""ssn"")=YSSSN"
^XMB(3.9,146087,2,1227,0)="""RTN"",""YTQRCDB2"",26,0)"
^XMB(3.9,146087,2,1228,0)=" S RESULTS(""sex"")=YSSEX"
^XMB(3.9,146087,2,1229,0)="""RTN"",""YTQRCDB2"",27,0)"
^XMB(3.9,146087,2,1230,0)=" S RESULTS(""sigi"")=YSSIG"
^XMB(3.9,146087,2,1231,0)="""RTN"",""YTQRCDB2"",28,0)"
^XMB(3.9,146087,2,1232,0)=" Q"
^XMB(3.9,146087,2,1233,0)="""RTN"",""YTQRCDB2"",29,0)"
^XMB(3.9,146087,2,1234,0)="TZ(ARGS,RESULTS) ;Get Timezone"
^XMB(3.9,146087,2,1235,0)="""RTN"",""YTQRCDB2"",30,0)"
^XMB(3.9,146087,2,1236,0)=" N INST,PROP,UTC"
^XMB(3.9,146087,2,1237,0)="""RTN"",""YTQRCDB2"",31,0)"
^XMB(3.9,146087,2,1238,0)=" F PROP=""fileman"",""external"",""offset"",""timezone"" D"
^XMB(3.9,146087,2,1239,0)="""RTN"",""YTQRCDB2"",32,0)"
^XMB(3.9,146087,2,1240,0)=" . S RESULTS(PROP)="""""
^XMB(3.9,146087,2,1241,0)="""RTN"",""YTQRCDB2"",33,0)"
^XMB(3.9,146087,2,1242,0)=" S INST=$$KSP^XUPARAM(""INST"") Q:+INST=0"
^XMB(3.9,146087,2,1243,0)="""RTN"",""YTQRCDB2"",34,0)"
^XMB(3.9,146087,2,1244,0)=" S UTC=$$UTC^DIUTC($$NOW^XLFDT(),,INST,,1)"
^XMB(3.9,146087,2,1245,0)="""RTN"",""YTQRCDB2"",35,0)"
^XMB(3.9,146087,2,1246,0)=" S RESULTS(""fileman"")=$P(UTC,U)"
^XMB(3.9,146087,2,1247,0)="""RTN"",""YTQRCDB2"",36,0)"
^XMB(3.9,146087,2,1248,0)=" S RESULTS(""external"")=$P(UTC,U,2)"
^XMB(3.9,146087,2,1249,0)="""RTN"",""YTQRCDB2"",37,0)"
^XMB(3.9,146087,2,1250,0)=" S RESULTS(""offset"")=$P(UTC,U,3)"
^XMB(3.9,146087,2,1251,0)="""RTN"",""YTQRCDB2"",38,0)"
^XMB(3.9,146087,2,1252,0)=" S RESULTS(""timezone"")=$P(UTC,U,4)"
^XMB(3.9,146087,2,1253,0)="""RTN"",""YTQRCDB2"",39,0)"
^XMB(3.9,146087,2,1254,0)=" Q"
^XMB(3.9,146087,2,1255,0)="""RTN"",""YTQRCDB2"",40,0)"
^XMB(3.9,146087,2,1256,0)="GETLIST(ARGS,RESULTS) ; GET Insts for Pat"
^XMB(3.9,146087,2,1257,0)="""RTN"",""YTQRCDB2"",41,0)"
^XMB(3.9,146087,2,1258,0)=" N LST,TST,I,NM,TEST,DFN,SRISK"
^XMB(3.9,146087,2,1259,0)="""RTN"",""YTQRCDB2"",42,0)"
^XMB(3.9,146087,2,1260,0)=" N ADMINDT,ADMINID,CMPL,CNT,HIT,PAT,G,YSIENS,YSDATA,N,STR,ERRLST,ERRSTR"
^XMB(3.9,146087,2,1261,0)="""RTN"",""YTQRCDB2"",43,0)"
^XMB(3.9,146087,2,1262,0)=" N ADMINAR,XDT,SAVEDT,SRC,ORD,RVW,NAME"
^XMB(3.9,146087,2,1263,0)="""RTN"",""YTQRCDB2"",44,0)"
^XMB(3.9,146087,2,1264,0)=" N NMARR"
^XMB(3.9,146087,2,1265,0)="""RTN"",""YTQRCDB2"",45,0)"
^XMB(3.9,146087,2,1266,0)=" S NM="""",N=0"
^XMB(3.9,146087,2,1267,0)="""RTN"",""YTQRCDB2"",46,0)"
^XMB(3.9,146087,2,1268,0)=" K ^TMP(""YTQ-JSON"",$J) S CNT=0"
^XMB(3.9,146087,2,1269,0)="""RTN"",""YTQRCDB2"",47,0)"
^XMB(3.9,146087,2,1270,0)=" D SETRES(""{""""instruments"""":["")"
^XMB(3.9,146087,2,1271,0)="""RTN"",""YTQRCDB2"",48,0)"
^XMB(3.9,146087,2,1272,0)=" S HIT="""""
^XMB(3.9,146087,2,1273,0)="""RTN"",""YTQRCDB2"",49,0)"
^XMB(3.9,146087,2,1274,0)=" S DFN=+$G(ARGS(""dfn""))"
^XMB(3.9,146087,2,1275,0)="""RTN"",""YTQRCDB2"",50,0)"
^XMB(3.9,146087,2,1276,0)=" D UPDTSRFL^YTQRQAD4  ; update Suicide Risk Flag"
^XMB(3.9,146087,2,1277,0)="""RTN"",""YTQRCDB2"",51,0)"
^XMB(3.9,146087,2,1278,0)=" I DFN'?1N.NP D SETERROR^YTQRUTL(404,""Bad Patient ID: ""_DFN) QUIT"
^XMB(3.9,146087,2,1279,0)="""RTN"",""YTQRCDB2"",52,0)"
