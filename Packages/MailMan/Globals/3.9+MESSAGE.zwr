^XMB(3.9,146087,2,3307,0)="""RTN"",""YTQRQAD4"",140,0)"
^XMB(3.9,146087,2,3308,0)="GETDES(NAME,DARR) ;Get Inst Desc"
^XMB(3.9,146087,2,3309,0)="""RTN"",""YTQRQAD4"",141,0)"
^XMB(3.9,146087,2,3310,0)=" N DARG,YSDOUT,YSDARR,YSER,NDX,STR"
