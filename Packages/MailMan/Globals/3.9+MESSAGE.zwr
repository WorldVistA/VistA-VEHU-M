^XMB(3.9,146084,2,940,0)=" ;S SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number. Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XMB(3.9,146084,2,941,0)="""RTN"",""SDES2ADDDELCGI"",15,0)"
