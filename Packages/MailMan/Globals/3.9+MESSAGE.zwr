^XMB(3.9,146054,2,239,0)="""RTN"")"
^XMB(3.9,146054,2,240,0)=1
^XMB(3.9,146054,2,241,0)="""RTN"",""XQARPRT2"")"
^XMB(3.9,146054,2,242,0)="0^1^B80045754"
^XMB(3.9,146054,2,243,0)="""RTN"",""XQARPRT2"",1,0)"
^XMB(3.9,146054,2,244,0)="XQARPRT2 ;DCN/BUF,JLI/OAK-OIFO - LOOKUP PROVIDER ALERTS ;4/9/07  10:16"
^XMB(3.9,146054,2,245,0)="""RTN"",""XQARPRT2"",2,0)"
^XMB(3.9,146054,2,246,0)=" ;;8.0;KERNEL;**316,443,690**;Jul 10, 1995;Build 0"
^XMB(3.9,146054,2,247,0)="""RTN"",""XQARPRT2"",3,0)"
^XMB(3.9,146054,2,248,0)=" ;Per VHA VA Directive 6402, this routine should not be modified"
^XMB(3.9,146054,2,249,0)="""RTN"",""XQARPRT2"",4,0)"
^XMB(3.9,146054,2,250,0)=" ;  Based on the original routine AEKALERT"
^XMB(3.9,146054,2,251,0)="""RTN"",""XQARPRT2"",5,0)"
^XMB(3.9,146054,2,252,0)=" Q"
^XMB(3.9,146054,2,253,0)="""RTN"",""XQARPRT2"",6,0)"
^XMB(3.9,146054,2,254,0)="EN ; OPT - interactive lists alerts from start date for a single user based on contents of alert tracking file"
^XMB(3.9,146054,2,255,0)="""RTN"",""XQARPRT2"",7,0)"
^XMB(3.9,146054,2,256,0)=" N DIR,XQADOC S DIR(0)=""PO^200:EMZ"" D ^DIR K DIR Q:$D(DIRUT)  Q:Y'>0  S XQADOC=+Y"
^XMB(3.9,146054,2,257,0)="""RTN"",""XQARPRT2"",8,0)"
^XMB(3.9,146054,2,258,0)="EN1 ;"
^XMB(3.9,146054,2,259,0)="""RTN"",""XQARPRT2"",9,0)"
^XMB(3.9,146054,2,260,0)=" N XQASDATE,XQAWORDS,XQADISP,%ZIS,ZTRTN,ZTDESC,ZTSAVE,POP,XQAU1N4"
^XMB(3.9,146054,2,261,0)="""RTN"",""XQARPRT2"",10,0)"
^XMB(3.9,146054,2,262,0)=" D DATES Q:Y'>0"
^XMB(3.9,146054,2,263,0)="""RTN"",""XQARPRT2"",11,0)"
^XMB(3.9,146054,2,264,0)=" D WORDS() Q:$D(DIRUT)  K Y"
^XMB(3.9,146054,2,265,0)="""RTN"",""XQARPRT2"",12,0)"
^XMB(3.9,146054,2,266,0)=" S %ZIS=""MQ"" D ^%ZIS Q:POP  I $D(IO(""Q"")) K IO(""Q"") S ZTRTN=""DQ1^XQARPRT2"",ZTDESC=""List of User Alerts"",ZTSAVE(""*"")="""" D ^%ZTLOAD W:$G(ZTSK)>0 !,""Task number is "",ZTSK K ZTSK Q"
^XMB(3.9,146054,2,267,0)="""RTN"",""XQARPRT2"",13,0)"
^XMB(3.9,146054,2,268,0)="DQ1 ;"
^XMB(3.9,146054,2,269,0)="""RTN"",""XQARPRT2"",14,0)"
^XMB(3.9,146054,2,270,0)=" N XQANWID,XQAIEN,XQADATE,XQANODE0,XQACTR,HEADERID,XQATOT"
^XMB(3.9,146054,2,271,0)="""RTN"",""XQARPRT2"",15,0)"
^XMB(3.9,146054,2,272,0)=" S HEADERID=""User ""_$$GET1^DIQ(200,XQADOC_"","",.01)_"" (DFN=""_XQADOC_"")"""
^XMB(3.9,146054,2,273,0)="""RTN"",""XQARPRT2"",16,0)"
^XMB(3.9,146054,2,274,0)=" U IO"
^XMB(3.9,146054,2,275,0)="""RTN"",""XQARPRT2"",17,0)"
^XMB(3.9,146054,2,276,0)=" D HEADER(HEADERID,1)"
^XMB(3.9,146054,2,277,0)="""RTN"",""XQARPRT2"",18,0)"
^XMB(3.9,146054,2,278,0)=" S XQAIEN=$O(^XTV(8992.1,""D"",XQASDATE-.0000001))"
^XMB(3.9,146054,2,279,0)="""RTN"",""XQARPRT2"",19,0)"
^XMB(3.9,146054,2,280,0)=" I XQAIEN>0 S XQAIEN=$O(^(XQAIEN,0))-0.0001 ; find starting point instead of having to work up through x-ref, XU*8*690 - Subtract .0001 from 1st XQAIEN"
^XMB(3.9,146054,2,281,0)="""RTN"",""XQARPRT2"",20,0)"
^XMB(3.9,146054,2,282,0)=" I XQAIEN>0 F  S XQAIEN=$O(^XTV(8992.1,""R"",XQADOC,XQAIEN)) Q:XQAIEN'>0  D  Q:$D(DIRUT)!(XQADATE>XQAEDATE)"
^XMB(3.9,146054,2,283,0)="""RTN"",""XQARPRT2"",21,0)"
^XMB(3.9,146054,2,284,0)=" . S XQANODE0=$G(^XTV(8992.1,XQAIEN,0)),XQADATE=$P(XQANODE0,""^"",2) Q:(XQADATE<XQASDATE)!(XQADATE>XQAEDATE)"
^XMB(3.9,146054,2,285,0)="""RTN"",""XQARPRT2"",22,0)"
^XMB(3.9,146054,2,286,0)=" . D PRNTATRK(XQAIEN)"
^XMB(3.9,146054,2,287,0)="""RTN"",""XQARPRT2"",23,0)"
^XMB(3.9,146054,2,288,0)=" D HEADER(HEADERID,0)"
^XMB(3.9,146054,2,289,0)="""RTN"",""XQARPRT2"",24,0)"
^XMB(3.9,146054,2,290,0)=" I '$D(ZTQUEUED) U IO(0) S DIR(0)=""E"" D ^DIR K DIR W ! U IO ; XU*8*690 - Pause at end of report to user terminal"
^XMB(3.9,146054,2,291,0)="""RTN"",""XQARPRT2"",25,0)"
^XMB(3.9,146054,2,292,0)=" D ^%ZISC"
^XMB(3.9,146054,2,293,0)="""RTN"",""XQARPRT2"",26,0)"
^XMB(3.9,146054,2,294,0)=" K XQADATE,XQACTR,DATA,DIR,DIRUT,XQADOC,XQAIEN,XQANODE0,XQASDATE,Y"
^XMB(3.9,146054,2,295,0)="""RTN"",""XQARPRT2"",27,0)"
^XMB(3.9,146054,2,296,0)=" Q"
^XMB(3.9,146054,2,297,0)="""RTN"",""XQARPRT2"",28,0)"
^XMB(3.9,146054,2,298,0)=" ;"
^XMB(3.9,146054,2,299,0)="""RTN"",""XQARPRT2"",29,0)"
^XMB(3.9,146054,2,300,0)="WORDS(TYPE) ; Allow user to select alerts containing only certain words"
^XMB(3.9,146054,2,301,0)="""RTN"",""XQARPRT2"",30,0)"
^XMB(3.9,146054,2,302,0)=" S DIR(0)=""Y"",DIR(""A"")=""Do you want to ""_$S($G(TYPE)'="""":""count"",1:""list"")_"" only alerts containing specific words or phrase(s)"""
^XMB(3.9,146054,2,303,0)="""RTN"",""XQARPRT2"",31,0)"
^XMB(3.9,146054,2,304,0)=" S DIR(""?"",1)=""You can enter one or more words or phrases which you want to be used to"""
^XMB(3.9,146054,2,305,0)="""RTN"",""XQARPRT2"",32,0)"
^XMB(3.9,146054,2,306,0)=" S DIR(""?"",2)=""select the alerts to be listed.  If you enter NO, all for the selected"""
^XMB(3.9,146054,2,307,0)="""RTN"",""XQARPRT2"",33,0)"
^XMB(3.9,146054,2,308,0)=" S DIR(""?"",3)=""individual in the selected time period will be selected.  If you enter"""
^XMB(3.9,146054,2,309,0)="""RTN"",""XQARPRT2"",34,0)"
^XMB(3.9,146054,2,310,0)=" S DIR(""?"",4)=""YES, you will be prompted to enter a word or phrase.  You will be prompted"""
^XMB(3.9,146054,2,311,0)="""RTN"",""XQARPRT2"",35,0)"
^XMB(3.9,146054,2,312,0)=" S DIR(""?"",5)=""again, and you may enter as many word or phrase entries as you want."""
^XMB(3.9,146054,2,313,0)="""RTN"",""XQARPRT2"",36,0)"
^XMB(3.9,146054,2,314,0)=" S DIR(""?"",6)=""Comparisons will NOT be case specific."""
^XMB(3.9,146054,2,315,0)="""RTN"",""XQARPRT2"",37,0)"
^XMB(3.9,146054,2,316,0)=" S DIR(""?"",7)="""""
^XMB(3.9,146054,2,317,0)="""RTN"",""XQARPRT2"",38,0)"
^XMB(3.9,146054,2,318,0)=" S DIR(""?"",8)=""HOWEVER ALL WORDS OR PHRASES ENTERED MUST BE IN THE MESSAGE FOR AN ALERT"""
^XMB(3.9,146054,2,319,0)="""RTN"",""XQARPRT2"",39,0)"
^XMB(3.9,146054,2,320,0)=" S DIR(""?"")=""TO BE SELECTED."""
^XMB(3.9,146054,2,321,0)="""RTN"",""XQARPRT2"",40,0)"
^XMB(3.9,146054,2,322,0)=" D ^DIR K DIR Q:Y'>0"
^XMB(3.9,146054,2,323,0)="""RTN"",""XQARPRT2"",41,0)"
^XMB(3.9,146054,2,324,0)=" ;"
^XMB(3.9,146054,2,325,0)="""RTN"",""XQARPRT2"",42,0)"
^XMB(3.9,146054,2,326,0)=" F J=1:1 W:J>1 !?7,""--- OR ---"",!,""Enter another set of words or phrases that should"",!,""be matched independently of the previous entr""_$S(J>2:""ies"",1:""y"") D  Q:'$D(XQAWORDS(J))"
^XMB(3.9,146054,2,327,0)="""RTN"",""XQARPRT2"",43,0)"
^XMB(3.9,146054,2,328,0)=" . W !?10,""ALL words or phrases connected by -AND- must appear in the"",!?10,""message for an alert to be selected"""
^XMB(3.9,146054,2,329,0)="""RTN"",""XQARPRT2"",44,0)"
^XMB(3.9,146054,2,330,0)=" . S DIR(""?"",1)=""Enter a word, at least three characters long, or phrase, without regard to"""
^XMB(3.9,146054,2,331,0)="""RTN"",""XQARPRT2"",45,0)"
^XMB(3.9,146054,2,332,0)=" . S DIR(""?"",2)=""case, that you want to be required for selection of alerts to be listed."""
^XMB(3.9,146054,2,333,0)="""RTN"",""XQARPRT2"",46,0)"
^XMB(3.9,146054,2,334,0)=" . S DIR(""?"",3)=""If more than one word or phrase are specified, ALL of them must be in alerts"""
^XMB(3.9,146054,2,335,0)="""RTN"",""XQARPRT2"",47,0)"
^XMB(3.9,146054,2,336,0)=" . S DIR(""?"")=""which will be listed."""
^XMB(3.9,146054,2,337,0)="""RTN"",""XQARPRT2"",48,0)"
^XMB(3.9,146054,2,338,0)=" . F I=1:1 S DIR(0)=""FO^3:"",DIR(""A"")=""Enter ""_$S(I=1:""a"",1:""another"")_"" word or phrase"" W:I>1 !?10,""-AND-"" D ^DIR Q:(Y="""")!(Y[""^"")  S XQAWORDS(J,I)=$$UP^XLFSTR(Y)"
^XMB(3.9,146054,2,339,0)="""RTN"",""XQARPRT2"",49,0)"
^XMB(3.9,146054,2,340,0)=" . K DIR,DIRUT"
^XMB(3.9,146054,2,341,0)="""RTN"",""XQARPRT2"",50,0)"
^XMB(3.9,146054,2,342,0)=" . Q"
^XMB(3.9,146054,2,343,0)="""RTN"",""XQARPRT2"",51,0)"
^XMB(3.9,146054,2,344,0)=" ;"
^XMB(3.9,146054,2,345,0)="""RTN"",""XQARPRT2"",52,0)"
^XMB(3.9,146054,2,346,0)=" I $D(XQAWORDS)>1,$G(TYPE)="""" D"
^XMB(3.9,146054,2,347,0)="""RTN"",""XQARPRT2"",53,0)"
^XMB(3.9,146054,2,348,0)=" . S DIR(0)=""SO^1:Both Action and Info Only;2:Action Alerts;3:Info Only Alerts"",DIR(""?"",1)=""Select whether alerts listed should be alerts involving actions (2), info"",DIR(""?"")=""only or text only alerts (3), or both (1)."""
^XMB(3.9,146054,2,349,0)="""RTN"",""XQARPRT2"",54,0)"
^XMB(3.9,146054,2,350,0)=" . S DIR(""A"")=""Select Alert Type(s) desired"",DIR(""B"")=1 D ^DIR K DIR S:Y'>0 Y=1 K DIRUT S XQADISP=+Y"
^XMB(3.9,146054,2,351,0)="""RTN"",""XQARPRT2"",55,0)"
^XMB(3.9,146054,2,352,0)=" . Q"
^XMB(3.9,146054,2,353,0)="""RTN"",""XQARPRT2"",56,0)"
^XMB(3.9,146054,2,354,0)=" Q"
^XMB(3.9,146054,2,355,0)="""RTN"",""XQARPRT2"",57,0)"
^XMB(3.9,146054,2,356,0)=" ;"
^XMB(3.9,146054,2,357,0)="""RTN"",""XQARPRT2"",58,0)"
^XMB(3.9,146054,2,358,0)="USER ;USER ENTRY POINT"
^XMB(3.9,146054,2,359,0)="""RTN"",""XQARPRT2"",59,0)"
^XMB(3.9,146054,2,360,0)=" N DIR,XQADOC S XQADOC=DUZ"
^XMB(3.9,146054,2,361,0)="""RTN"",""XQARPRT2"",60,0)"
^XMB(3.9,146054,2,362,0)=" G EN1"
^XMB(3.9,146054,2,363,0)="""RTN"",""XQARPRT2"",61,0)"
^XMB(3.9,146054,2,364,0)=" ;"
^XMB(3.9,146054,2,365,0)="""RTN"",""XQARPRT2"",62,0)"
^XMB(3.9,146054,2,366,0)="DATES ;"
^XMB(3.9,146054,2,367,0)="""RTN"",""XQARPRT2"",63,0)"
^XMB(3.9,146054,2,368,0)=" S DIR(0)=""DO^::EX"",DIR(""B"")=""TODAY"",DIR(""A"")=""START DATE"" D ^DIR K DIR Q:Y'>0  S XQASDATE=+Y"
^XMB(3.9,146054,2,369,0)="""RTN"",""XQARPRT2"",64,0)"
^XMB(3.9,146054,2,370,0)=" I XQASDATE<$$OLDEST() W !?10,""The earliest date in the alert tracking file is "",$$FMTE^XLFDT($$OLDEST(),""D"") S XQASDATE=$$OLDEST()"
^XMB(3.9,146054,2,371,0)="""RTN"",""XQARPRT2"",65,0)"
^XMB(3.9,146054,2,372,0)=" I $D(XQA1U4N) W !,""*** WARNING ***: Do not specify too many days - each entry in the Alert Tracking"",!,""file must be checked for the date range specified."",! S DIR(""B"")=$$FMTE^XLFDT(XQASDATE)"
^XMB(3.9,146054,2,373,0)="""RTN"",""XQARPRT2"",66,0)"
^XMB(3.9,146054,2,374,0)=" S DIR(0)=""DO^""_XQASDATE_"":DT:EX"",DIR(""A"")=""END DATE"" D ^DIR K DIR Q:$D(DIRUT)  I Y>0 S XQAEDATE=Y+.24 ; Add ""EX"" to require eXact data and Echo input, XU*8*690"
^XMB(3.9,146054,2,375,0)="""RTN"",""XQARPRT2"",67,0)"
^XMB(3.9,146054,2,376,0)=" Q"
^XMB(3.9,146054,2,377,0)="""RTN"",""XQARPRT2"",68,0)"
^XMB(3.9,146054,2,378,0)=" ;"
^XMB(3.9,146054,2,379,0)="""RTN"",""XQARPRT2"",69,0)"
^XMB(3.9,146054,2,380,0)="PRNTATRK(IEN) ; Print data for an entry from the alert tracking file"
^XMB(3.9,146054,2,381,0)="""RTN"",""XQARPRT2"",70,0)"
^XMB(3.9,146054,2,382,0)=" N XQANODE0,XQADATE,Y,XQANEN,XQAMSG,XQAOPT,XQAROU,XQAMSGUC"
^XMB(3.9,146054,2,383,0)="""RTN"",""XQARPRT2"",71,0)"
^XMB(3.9,146054,2,384,0)=" S XQANODE0=$G(^XTV(8992.1,IEN,0)),XQADATE=$P(XQANODE0,""^"",2)"
^XMB(3.9,146054,2,385,0)="""RTN"",""XQARPRT2"",72,0)"
^XMB(3.9,146054,2,386,0)=" S XQAMSG=$G(^XTV(8992.1,IEN,1)),XQAOPT=$P(XQAMSG,U,2),XQAROU=$P(XQAMSG,U,3,4),XQAMSG=$P(XQAMSG,U)"
^XMB(3.9,146054,2,387,0)="""RTN"",""XQARPRT2"",73,0)"
^XMB(3.9,146054,2,388,0)=" S XQAOPT=$S(XQAOPT>0:"" [OPT]"",1:"""") S XQAROU=$S((XQAROU'="""")&(XQAROU'=""^""):"" [ROU]"",1:"""") S XQAOPT=$S(XQAOPT'="""":XQAOPT,XQAROU'="""":XQAROU,1:""      "")"
^XMB(3.9,146054,2,389,0)="""RTN"",""XQARPRT2"",74,0)"
^XMB(3.9,146054,2,390,0)=" I $D(XQAWORDS)>1 S XQAMSGUC=$$UP^XLFSTR(XQAMSG) D  Q:XQAMSGUC="""""
^XMB(3.9,146054,2,391,0)="""RTN"",""XQARPRT2"",75,0)"
^XMB(3.9,146054,2,392,0)=" . N XQAMSG1,J,I S XQAMSG1=XQAMSGUC F J=0:0 S J=$O(XQAWORDS(J)) Q:J'>0  S XQAMSGUC=XQAMSG1 D  Q:XQAMSGUC'="""""
^XMB(3.9,146054,2,393,0)="""RTN"",""XQARPRT2"",76,0)"
^XMB(3.9,146054,2,394,0)=" . . F I=0:0 S I=$O(XQAWORDS(J,I)) Q:I'>0  I XQAMSGUC'[XQAWORDS(J,I) S XQAMSGUC="""" Q"
^XMB(3.9,146054,2,395,0)="""RTN"",""XQARPRT2"",77,0)"
^XMB(3.9,146054,2,396,0)=" . . I XQAMSGUC'="""",XQADISP'=1 D"
^XMB(3.9,146054,2,397,0)="""RTN"",""XQARPRT2"",78,0)"
^XMB(3.9,146054,2,398,0)=" . . . I XQADISP=2,XQAOPT="""",XQAROU="""" S XQAMSGUC="""""
^XMB(3.9,146054,2,399,0)="""RTN"",""XQARPRT2"",79,0)"
^XMB(3.9,146054,2,400,0)=" . . . I XQADISP=3,(XQAOPT'="""")!(XQAROU'="""") S XQAMSGUC="""""
^XMB(3.9,146054,2,401,0)="""RTN"",""XQARPRT2"",80,0)"
^XMB(3.9,146054,2,402,0)=" . . . Q"
^XMB(3.9,146054,2,403,0)="""RTN"",""XQARPRT2"",81,0)"
^XMB(3.9,146054,2,404,0)=" . . Q"
^XMB(3.9,146054,2,405,0)="""RTN"",""XQARPRT2"",82,0)"
^XMB(3.9,146054,2,406,0)=" . Q"
^XMB(3.9,146054,2,407,0)="""RTN"",""XQARPRT2"",83,0)"
^XMB(3.9,146054,2,408,0)=" S XQANEN=$$FMTE^XLFDT(XQADATE,""5Z"")_XQAOPT_"" ien=""_IEN"
^XMB(3.9,146054,2,409,0)="""RTN"",""XQARPRT2"",84,0)"
^XMB(3.9,146054,2,410,0)=" W !,$E(XQAMSG,1,IOM-1) W !?35,XQANEN S XQATOT=XQATOT+1"
^XMB(3.9,146054,2,411,0)="""RTN"",""XQARPRT2"",85,0)"
^XMB(3.9,146054,2,412,0)=" S XQACTR=XQACTR+2 I XQACTR>(IOSL-4) D  Q:$D(DIRUT)  S XQACTR=0"
^XMB(3.9,146054,2,413,0)="""RTN"",""XQARPRT2"",86,0)"
^XMB(3.9,146054,2,414,0)=" . I $D(ZTQUEUED) W @IOF"
^XMB(3.9,146054,2,415,0)="""RTN"",""XQARPRT2"",87,0)"
^XMB(3.9,146054,2,416,0)=" . E  U IO(0) S DIR(0)=""E"" D ^DIR K DIR W !"
^XMB(3.9,146054,2,417,0)="""RTN"",""XQARPRT2"",88,0)"
