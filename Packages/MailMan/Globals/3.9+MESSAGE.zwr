^XMB(3.9,146087,2,722,0)=" . S ^TMP(""YTQ-JSON"",$J,1,0)=""ERROR"",YTQRRSLT=$NA(^TMP(""YTQ-JSON"",$J))"
^XMB(3.9,146087,2,723,0)="""RTN"",""YTQRCDB"",42,0)"
^XMB(3.9,146087,2,724,0)=" S CNT=1,^TMP(""YTQ-JSON"",$J,CNT,0)=""{""""results"""":["""
^XMB(3.9,146087,2,725,0)="""RTN"",""YTQRCDB"",43,0)"
^XMB(3.9,146087,2,726,0)=" S I=0 F  S I=$O(SCORES(I)) Q:I=""""  D"
