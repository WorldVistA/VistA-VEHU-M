^XMB(3.9,146009,2,374,0)=" .;INCLUDING MORE FIELDS NOW PRIMARY MENU WILL BE USED TO DETERMINE IF VISITOR ACCOUNT, OTHER FIELDS ARE FOR FUTURE USE"
^XMB(3.9,146009,2,375,0)="""RTN"",""XUIAMNPB"",55,0)"
