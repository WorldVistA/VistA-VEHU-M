^XMB(3.9,146056,2,809,0)="""RTN"",""VPR1P37"",1,0)"
^XMB(3.9,146056,2,810,0)="VPR1P37 ;SLC/CMF -- Patch 37 postinit ;9/23/2025  12:07"
^XMB(3.9,146056,2,811,0)="""RTN"",""VPR1P37"",2,0)"
^XMB(3.9,146056,2,812,0)=" ;;1.0;VIRTUAL PATIENT RECORD;**37**;Sep 01, 2011;Build 0"
^XMB(3.9,146056,2,813,0)="""RTN"",""VPR1P37"",3,0)"
^XMB(3.9,146056,2,814,0)=" ;;Per VHA Directive 6402, this routine should not be modified."
^XMB(3.9,146056,2,815,0)="""RTN"",""VPR1P37"",4,0)"
^XMB(3.9,146056,2,816,0)=" ;"
^XMB(3.9,146056,2,817,0)="""RTN"",""VPR1P37"",5,0)"
^XMB(3.9,146056,2,818,0)=" ; External References          DBIA#"
^XMB(3.9,146056,2,819,0)="""RTN"",""VPR1P37"",6,0)"
^XMB(3.9,146056,2,820,0)=" ; -------------------          -----"
^XMB(3.9,146056,2,821,0)="""RTN"",""VPR1P37"",7,0)"
^XMB(3.9,146056,2,822,0)=" ; ""AVPR"" X-REF of File #123    7610"
^XMB(3.9,146056,2,823,0)="""RTN"",""VPR1P37"",8,0)"
^XMB(3.9,146056,2,824,0)=" ;"
^XMB(3.9,146056,2,825,0)="""RTN"",""VPR1P37"",9,0)"
^XMB(3.9,146056,2,826,0)="ENV ;Main entry point for Environment check point."
^XMB(3.9,146056,2,827,0)="""RTN"",""VPR1P37"",10,0)"
^XMB(3.9,146056,2,828,0)=" ;"
^XMB(3.9,146056,2,829,0)="""RTN"",""VPR1P37"",11,0)"
^XMB(3.9,146056,2,830,0)=" S XPDABORT="""""
^XMB(3.9,146056,2,831,0)="""RTN"",""VPR1P37"",12,0)"
^XMB(3.9,146056,2,832,0)=" D PROGCHK(.XPDABORT) ;checks programmer variables"
^XMB(3.9,146056,2,833,0)="""RTN"",""VPR1P37"",13,0)"
^XMB(3.9,146056,2,834,0)=" I XPDABORT="""" K XPDABORT"
^XMB(3.9,146056,2,835,0)="""RTN"",""VPR1P37"",14,0)"
^XMB(3.9,146056,2,836,0)=" Q"
^XMB(3.9,146056,2,837,0)="""RTN"",""VPR1P37"",15,0)"
^XMB(3.9,146056,2,838,0)=" ;"
^XMB(3.9,146056,2,839,0)="""RTN"",""VPR1P37"",16,0)"
^XMB(3.9,146056,2,840,0)=" ;"
^XMB(3.9,146056,2,841,0)="""RTN"",""VPR1P37"",17,0)"
^XMB(3.9,146056,2,842,0)="PROGCHK(XPDABORT) ;checks for necessary programmer variables"
^XMB(3.9,146056,2,843,0)="""RTN"",""VPR1P37"",18,0)"
^XMB(3.9,146056,2,844,0)=" ;"
^XMB(3.9,146056,2,845,0)="""RTN"",""VPR1P37"",19,0)"
^XMB(3.9,146056,2,846,0)=" I '$G(DUZ)!($G(DUZ(0))'=""@"")!('$G(DT))!($G(U)'=""^"") D"
^XMB(3.9,146056,2,847,0)="""RTN"",""VPR1P37"",20,0)"
^XMB(3.9,146056,2,848,0)=" .D BMES^XPDUTL(""*****"")"
^XMB(3.9,146056,2,849,0)="""RTN"",""VPR1P37"",21,0)"
^XMB(3.9,146056,2,850,0)=" .D MES^XPDUTL(""Your programming variables are not set up properly."")"
^XMB(3.9,146056,2,851,0)="""RTN"",""VPR1P37"",22,0)"
^XMB(3.9,146056,2,852,0)=" .D MES^XPDUTL(""Installation aborted."")"
