^XMB(3.9,146088,2,811,0)="""RTN"",""PSOERPC3"",43,0)"
^XMB(3.9,146088,2,812,0)=" . . ;"
^XMB(3.9,146088,2,813,0)="""RTN"",""PSOERPC3"",44,0)"
^XMB(3.9,146088,2,814,0)=" . . I EXTRCODE=""U""!(EXTRCODE=""T"")!(EXTRCODE=""D""&("",DA,DD,HD,LD,MS,TD,AR,DI,DR,ID,UD,PS,SX,TP,""[("",""_$$GET1^DIQ(52.45,CODE,.01)_"",""))) D"
^XMB(3.9,146088,2,815,0)="""RTN"",""PSOERPC3"",45,0)"
^XMB(3.9,146088,2,816,0)=" . . . S LINE=LINE+1,DIR(""L"",LINE)=""   ""_$S(EXTRCODE=""D"":""     "",1:"""")_$$GET1^DIQ(52.45,CODE,.01)_"" - ""_$$GET1^DIQ(52.45,CODE,.02)"
^XMB(3.9,146088,2,817,0)="""RTN"",""PSOERPC3"",46,0)"
^XMB(3.9,146088,2,818,0)=" . . S HLP=HLP+1,DIR(""?"",HLP)=""   ""_$S(EXTRCODE=""D"":""     "",1:"""")_$$GET1^DIQ(52.45,CODE,.01)_"" - ""_$$GET1^DIQ(52.45,CODE,.02)"
^XMB(3.9,146088,2,819,0)="""RTN"",""PSOERPC3"",47,0)"
^XMB(3.9,146088,2,820,0)=" . . ;"
^XMB(3.9,146088,2,821,0)="""RTN"",""PSOERPC3"",48,0)"
^XMB(3.9,146088,2,822,0)=" . . I EXTRCODE=""S""&("",PRN,UDD,COD,MSD,RIJ,VEF,VLQ,VPQ,AUT,""[("",""_$$GET1^DIQ(52.45,CODE,.01)_"","")) D  ;script clarification subcodes"
^XMB(3.9,146088,2,823,0)="""RTN"",""PSOERPC3"",49,0)"
^XMB(3.9,146088,2,824,0)=" . . . S LINE=LINE+1,DIR(""L"",LINE)=""   ""_$S(EXTRCODE=""S"":""     "",1:"""")_$$GET1^DIQ(52.45,CODE,.01)_"" - ""_$$GET1^DIQ(52.45,CODE,.02)"
^XMB(3.9,146088,2,825,0)="""RTN"",""PSOERPC3"",50,0)"
^XMB(3.9,146088,2,826,0)=" . . ;"
^XMB(3.9,146088,2,827,0)="""RTN"",""PSOERPC3"",51,0)"
^XMB(3.9,146088,2,828,0)=" . I EXTRCODE=""D"" S LINE=LINE+1,DIR(""L"",LINE)="" """
^XMB(3.9,146088,2,829,0)="""RTN"",""PSOERPC3"",52,0)"
^XMB(3.9,146088,2,830,0)=" . S DIR(""A"")=""CHANGE REQUEST SUB-CODE"" I $G(REASCODE) S DIR(""B"")=$$GET1^DIQ(52.45,REASCODE,.01)"
^XMB(3.9,146088,2,831,0)="""RTN"",""PSOERPC3"",53,0)"
^XMB(3.9,146088,2,832,0)=" . D ^DIR I $D(DIRUT)!$D(DIROUT) S PSOQUIT=1 Q"
^XMB(3.9,146088,2,833,0)="""RTN"",""PSOERPC3"",54,0)"
^XMB(3.9,146088,2,834,0)=" . I $G(REASCODE)'=+$G(INDEX(Y)) K REATXT"
^XMB(3.9,146088,2,835,0)="""RTN"",""PSOERPC3"",55,0)"
^XMB(3.9,146088,2,836,0)=" . S REASCODE=+$G(INDEX(Y)),EXTSCODE=$$GET1^DIQ(52.45,REASCODE,.01)"
^XMB(3.9,146088,2,837,0)="""RTN"",""PSOERPC3"",56,0)"
^XMB(3.9,146088,2,838,0)=" . W ! I '$D(REATXT) D"
^XMB(3.9,146088,2,839,0)="""RTN"",""PSOERPC3"",57,0)"
^XMB(3.9,146088,2,840,0)=" . . ;check if the division set a specific change request reason in field 21. Otherwise, display the default text in field 20."
^XMB(3.9,146088,2,841,0)="""RTN"",""PSOERPC3"",58,0)"
^XMB(3.9,146088,2,842,0)=" . . I $$CHKDIVRSN(REASCODE,.REATXT) Q"
^XMB(3.9,146088,2,843,0)="""RTN"",""PSOERPC3"",59,0)"
^XMB(3.9,146088,2,844,0)=" . . S X=$$GET1^DIQ(52.45,REASCODE,20,,""REATXT"")"
^XMB(3.9,146088,2,845,0)="""RTN"",""PSOERPC3"",60,0)"
^XMB(3.9,146088,2,846,0)=" ;"
^XMB(3.9,146088,2,847,0)="""RTN"",""PSOERPC3"",61,0)"
^XMB(3.9,146088,2,848,0)=" K ^TMP(""PSOERPC3"",$J)"
^XMB(3.9,146088,2,849,0)="""RTN"",""PSOERPC3"",62,0)"
^XMB(3.9,146088,2,850,0)=" F I=1:1 Q:'$D(REATXT(I))  S ^TMP(""PSOERPC3"",$J,I,0)=REATXT(I)"
^XMB(3.9,146088,2,851,0)="""RTN"",""PSOERPC3"",63,0)"
^XMB(3.9,146088,2,852,0)=" S (PSOQUIT,TMPCHNGE)=0"
^XMB(3.9,146088,2,853,0)="""RTN"",""PSOERPC3"",64,0)"
^XMB(3.9,146088,2,854,0)=" F I=1:1 S FINISH=1 D  I FINISH!PSOQUIT Q"
^XMB(3.9,146088,2,855,0)="""RTN"",""PSOERPC3"",65,0)"
^XMB(3.9,146088,2,856,0)=" . S NPLEN=0,DIC=""^TMP(""""PSOERPC3""""""_"",$J,"""
^XMB(3.9,146088,2,857,0)="""RTN"",""PSOERPC3"",66,0)"
^XMB(3.9,146088,2,858,0)=" . S DWLW=80,DWPK=1,DIWETXT=""You are about to edit ""_$$GET1^DIQ(52.45,REACODE_"","","".02"",""E"")_"" """
^XMB(3.9,146088,2,859,0)="""RTN"",""PSOERPC3"",67,0)"
^XMB(3.9,146088,2,860,0)=" . I EXTRCODE'=""U"" S DIWETXT=DIWETXT_$$GET1^DIQ(52.45,REASCODE_"","","".02"",""E"")"
^XMB(3.9,146088,2,861,0)="""RTN"",""PSOERPC3"",68,0)"
^XMB(3.9,146088,2,862,0)=" . S DIWETXT=DIWETXT_"" Template:"""
^XMB(3.9,146088,2,863,0)="""RTN"",""PSOERPC3"",69,0)"
^XMB(3.9,146088,2,864,0)=" . S DIWESUB=""DEFAULT NOTE TO PROVIDER"" W !,DIWESUB,"":"""
^XMB(3.9,146088,2,865,0)="""RTN"",""PSOERPC3"",70,0)"
^XMB(3.9,146088,2,866,0)=" . D EN^DIWE I $G(DUOUT) S PSOQUIT=1 Q"
^XMB(3.9,146088,2,867,0)="""RTN"",""PSOERPC3"",71,0)"
^XMB(3.9,146088,2,868,0)=" . F I=1:1 Q:'$D(^TMP(""PSOERPC3"",$J,I))  D  I 'FINISH Q"
^XMB(3.9,146088,2,869,0)="""RTN"",""PSOERPC3"",72,0)"
^XMB(3.9,146088,2,870,0)=" . . S X=^TMP(""PSOERPC3"",$J,I,0)"
^XMB(3.9,146088,2,871,0)="""RTN"",""PSOERPC3"",73,0)"
^XMB(3.9,146088,2,872,0)=" . . S NPLEN=NPLEN+$L(X) I NPLEN>(261-$O(^TMP(""PSOERPC3"",$J,99),-1)) W !!,$G(IOINHI),""The maximum length for this note is 260 characters."",$G(IOINORM),$C(7) S FINISH=0 D PAUSE^PSOSPMU1 Q"
^XMB(3.9,146088,2,873,0)="""RTN"",""PSOERPC3"",74,0)"
^XMB(3.9,146088,2,874,0)=" . . I $D(REATXT(I)),X'=REATXT(I) S TMPCHNGE=1"
^XMB(3.9,146088,2,875,0)="""RTN"",""PSOERPC3"",75,0)"
^XMB(3.9,146088,2,876,0)=" . . I $D(^TMP(""PSOERPC3"",$J,I)),'$D(REATXT(I)) S TMPCHNGE=1"
^XMB(3.9,146088,2,877,0)="""RTN"",""PSOERPC3"",76,0)"
^XMB(3.9,146088,2,878,0)=" ;"
^XMB(3.9,146088,2,879,0)="""RTN"",""PSOERPC3"",77,0)"
^XMB(3.9,146088,2,880,0)=" I +TMPCHNGE<1 W !!,$G(IOINHI),""Nothings change. No Action Taken."",$G(IOINORM),$C(7) D PAUSE^PSOSPMU1 G REF^PSOERPC0"
^XMB(3.9,146088,2,881,0)="""RTN"",""PSOERPC3"",78,0)"
^XMB(3.9,146088,2,882,0)=" I PSOQUIT G REF^PSOERPC0"
^XMB(3.9,146088,2,883,0)="""RTN"",""PSOERPC3"",79,0)"
^XMB(3.9,146088,2,884,0)=" K REASTXT F I=1:1 Q:'$D(^TMP(""PSOERPC3"",$J,I))  S REASTXT(I,0)=$G(^TMP(""PSOERPC3"",$J,I,0))"
^XMB(3.9,146088,2,885,0)="""RTN"",""PSOERPC3"",80,0)"
^XMB(3.9,146088,2,886,0)=" K FDARSNTXT"
^XMB(3.9,146088,2,887,0)="""RTN"",""PSOERPC3"",81,0)"
^XMB(3.9,146088,2,888,0)=" I +TMPCHNGE>0 D  ;"
^XMB(3.9,146088,2,889,0)="""RTN"",""PSOERPC3"",82,0)"
^XMB(3.9,146088,2,890,0)=" . I $G(IENS)="""" S IENS=""+1,""_$S(("" D U S ""'[("" ""_EXTRCODE_"" "")):REACODE,1:REASCODE)_"","""
^XMB(3.9,146088,2,891,0)="""RTN"",""PSOERPC3"",83,0)"
^XMB(3.9,146088,2,892,0)=" . S FDARSNTXT(52.4521,IENS,.01)=$G(PSOSITE)"
^XMB(3.9,146088,2,893,0)="""RTN"",""PSOERPC3"",84,0)"
^XMB(3.9,146088,2,894,0)=" . S FDARSNTXT(52.4521,IENS,1)=""REASTXT"""
^XMB(3.9,146088,2,895,0)="""RTN"",""PSOERPC3"",85,0)"
^XMB(3.9,146088,2,896,0)=" E  S FDARSNTXT(52.45,REASCODE_"","",20)=""REASTXT"""
^XMB(3.9,146088,2,897,0)="""RTN"",""PSOERPC3"",86,0)"
^XMB(3.9,146088,2,898,0)=" K DIERR D UPDATE^DIE("""",""FDARSNTXT"",,""DIERR"")"
^XMB(3.9,146088,2,899,0)="""RTN"",""PSOERPC3"",87,0)"
^XMB(3.9,146088,2,900,0)=" I $D(DIERR) W !!,$G(IOINHI),""Error while updating the data: ""_$G(DIERR(""DIERR"",1,""TEXT"",1)),$G(IOINORM),$C(7) D PAUSE^PSOSPMU1"
^XMB(3.9,146088,2,901,0)="""RTN"",""PSOERPC3"",88,0)"
^XMB(3.9,146088,2,902,0)=" E  W !!,$G(IOINHI),""Update successful for ""_$$GET1^DIQ(59,PSOSITE,.01),"" division."",$G(IOINORM),$C(7) D PAUSE^PSOSPMU1"
^XMB(3.9,146088,2,903,0)="""RTN"",""PSOERPC3"",89,0)"
^XMB(3.9,146088,2,904,0)=" K ^TMP(""PSOERPC3"",$J)"
^XMB(3.9,146088,2,905,0)="""RTN"",""PSOERPC3"",90,0)"
^XMB(3.9,146088,2,906,0)=" G REF^PSOERPC0"
^XMB(3.9,146088,2,907,0)="""RTN"",""PSOERPC3"",91,0)"
^XMB(3.9,146088,2,908,0)=" Q"
^XMB(3.9,146088,2,909,0)="""RTN"",""PSOERPC3"",92,0)"
^XMB(3.9,146088,2,910,0)=" ;"
^XMB(3.9,146088,2,911,0)="""RTN"",""PSOERPC3"",93,0)"
^XMB(3.9,146088,2,912,0)="CHKDIVRSN(RSNIEN,DIVREATXT) ;check if the division set a specific change request reason in field 21. Otherwise, display the default text in field 20."
^XMB(3.9,146088,2,913,0)="""RTN"",""PSOERPC3"",94,0)"
^XMB(3.9,146088,2,914,0)=" ;Input  : RSNIEN - Pointer to ERX SERVICE REASON CODES file (#52.45)"
^XMB(3.9,146088,2,915,0)="""RTN"",""PSOERPC3"",95,0)"
^XMB(3.9,146088,2,916,0)=" ;Outputs: CHKDIVRSN - Return 1 if the division set a specific change request reason in field 21. Otherwise,0"
^XMB(3.9,146088,2,917,0)="""RTN"",""PSOERPC3"",96,0)"
^XMB(3.9,146088,2,918,0)=" ;         DIVREATXT - Array Containing Division Specific Reason Text"
^XMB(3.9,146088,2,919,0)="""RTN"",""PSOERPC3"",97,0)"
^XMB(3.9,146088,2,920,0)=" N IENS,X"
^XMB(3.9,146088,2,921,0)="""RTN"",""PSOERPC3"",98,0)"
^XMB(3.9,146088,2,922,0)=" Q:'$G(RSNIEN)!'$G(PSOSITE)"
^XMB(3.9,146088,2,923,0)="""RTN"",""PSOERPC3"",99,0)"
^XMB(3.9,146088,2,924,0)=" I $D(^PS(52.45,RSNIEN,21,""B"",PSOSITE)) D"
^XMB(3.9,146088,2,925,0)="""RTN"",""PSOERPC3"",100,0)"
^XMB(3.9,146088,2,926,0)=" . S IENS=$O(^PS(52.45,RSNIEN,21,""B"",PSOSITE,""""),-1)_"",""_RSNIEN_"","" ;get the last entry change"
^XMB(3.9,146088,2,927,0)="""RTN"",""PSOERPC3"",101,0)"
^XMB(3.9,146088,2,928,0)=" . I $G(IENS) S X=$$GET1^DIQ(52.4521,IENS,1,,""DIVREATXT"")"
^XMB(3.9,146088,2,929,0)="""RTN"",""PSOERPC3"",102,0)"
^XMB(3.9,146088,2,930,0)=" Q $S($D(DIVREATXT):1,1:0)"
^XMB(3.9,146088,2,931,0)="""VER"")"
