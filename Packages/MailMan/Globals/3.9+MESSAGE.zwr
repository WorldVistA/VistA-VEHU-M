^XMB(3.9,146098,2,1213,0)="""RTN"",""SDES2ARCLOSE"")"
^XMB(3.9,146098,2,1214,0)="0^1^B16649988"
^XMB(3.9,146098,2,1215,0)="""RTN"",""SDES2ARCLOSE"",1,0)"
^XMB(3.9,146098,2,1216,0)="SDES2ARCLOSE  ;ALB/ANU,BLB,LAB,TJB,LAB - SDES2 DISPOSITION APPT REQ; MAR 19,2026"
^XMB(3.9,146098,2,1217,0)="""RTN"",""SDES2ARCLOSE"",2,0)"
^XMB(3.9,146098,2,1218,0)=" ;;5.3;Scheduling;**866,873,875,909,929,940**;Aug 13, 1993;Build 0"
^XMB(3.9,146098,2,1219,0)="""RTN"",""SDES2ARCLOSE"",3,0)"
^XMB(3.9,146098,2,1220,0)=" ;;Per VHA Directive 6402, this routine should not be modified"
^XMB(3.9,146098,2,1221,0)="""RTN"",""SDES2ARCLOSE"",4,0)"
^XMB(3.9,146098,2,1222,0)=" ;"
^XMB(3.9,146098,2,1223,0)="""RTN"",""SDES2ARCLOSE"",5,0)"
^XMB(3.9,146098,2,1224,0)=" ; Reference to DUZ^XUP is supported by IA #7487"
^XMB(3.9,146098,2,1225,0)="""RTN"",""SDES2ARCLOSE"",6,0)"
^XMB(3.9,146098,2,1226,0)=" ;"
^XMB(3.9,146098,2,1227,0)="""RTN"",""SDES2ARCLOSE"",7,0)"
^XMB(3.9,146098,2,1228,0)=" Q"
^XMB(3.9,146098,2,1229,0)="""RTN"",""SDES2ARCLOSE"",8,0)"
^XMB(3.9,146098,2,1230,0)=" ; INPUT"
^XMB(3.9,146098,2,1231,0)="""RTN"",""SDES2ARCLOSE"",9,0)"
^XMB(3.9,146098,2,1232,0)=" ;"
^XMB(3.9,146098,2,1233,0)="""RTN"",""SDES2ARCLOSE"",10,0)"
^XMB(3.9,146098,2,1234,0)=" ; SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number. Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XMB(3.9,146098,2,1235,0)="""RTN"",""SDES2ARCLOSE"",11,0)"
^XMB(3.9,146098,2,1236,0)=" ; SDCONTEXT(""USER DUZ"") = The DUZ of the user taking action in the calling application."
^XMB(3.9,146098,2,1237,0)="""RTN"",""SDES2ARCLOSE"",12,0)"
^XMB(3.9,146098,2,1238,0)=" ; SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the calling application."
^XMB(3.9,146098,2,1239,0)="""RTN"",""SDES2ARCLOSE"",13,0)"
^XMB(3.9,146098,2,1240,0)=" ; SDCONTEXT(""PATIENT DFN"") = The DFN/IEN of the target patient from the calling application."
^XMB(3.9,146098,2,1241,0)="""RTN"",""SDES2ARCLOSE"",14,0)"
^XMB(3.9,146098,2,1242,0)=" ; SDCONTEXT(""PATIENT ICN"") = The ICN of the target patient from the calling application."
^XMB(3.9,146098,2,1243,0)="""RTN"",""SDES2ARCLOSE"",15,0)"
^XMB(3.9,146098,2,1244,0)=" ; SDINPUT(""REQUEST ID"") = IEN, Pointer to SDEC APPT REQUEST file."
^XMB(3.9,146098,2,1245,0)="""RTN"",""SDES2ARCLOSE"",16,0)"
^XMB(3.9,146098,2,1246,0)=" ; SDINPUT(""DISP"") = Disposition."
^XMB(3.9,146098,2,1247,0)="""RTN"",""SDES2ARCLOSE"",17,0)"
^XMB(3.9,146098,2,1248,0)=" ; SDINPUT(""DISPDT"") = Date Dispositioned in external form (e.g.,CCYY-MM-DD)"
^XMB(3.9,146098,2,1249,0)="""RTN"",""SDES2ARCLOSE"",18,0)"
^XMB(3.9,146098,2,1250,0)=" ; SDINPUT(""PCMT"") = (optional) patient-entered comments from VAOS"
^XMB(3.9,146098,2,1251,0)="""RTN"",""SDES2ARCLOSE"",19,0)"
^XMB(3.9,146098,2,1252,0)=" ;"
^XMB(3.9,146098,2,1253,0)="""RTN"",""SDES2ARCLOSE"",20,0)"
^XMB(3.9,146098,2,1254,0)="DISPOSITION(JSON,SDCONTEXT,SDINPUT) ; Disposition an Appointment Request"
^XMB(3.9,146098,2,1255,0)="""RTN"",""SDES2ARCLOSE"",21,0)"
^XMB(3.9,146098,2,1256,0)=" N SDERRORS,SDRETURN,ARIEN,DISP,DISPDT,PCMT,PARAMETERS"
^XMB(3.9,146098,2,1257,0)="""RTN"",""SDES2ARCLOSE"",22,0)"
^XMB(3.9,146098,2,1258,0)=" ;"
^XMB(3.9,146098,2,1259,0)="""RTN"",""SDES2ARCLOSE"",23,0)"
^XMB(3.9,146098,2,1260,0)=" ; Validate SDCONTEXT"
^XMB(3.9,146098,2,1261,0)="""RTN"",""SDES2ARCLOSE"",24,0)"
^XMB(3.9,146098,2,1262,0)=" ;"
^XMB(3.9,146098,2,1263,0)="""RTN"",""SDES2ARCLOSE"",25,0)"
^XMB(3.9,146098,2,1264,0)=" D VALCONTEXT^SDES2VALCONTEXT(.SDERRORS,.SDCONTEXT)"
^XMB(3.9,146098,2,1265,0)="""RTN"",""SDES2ARCLOSE"",26,0)"
^XMB(3.9,146098,2,1266,0)=" I $D(SDERRORS) S SDERRORS(""ApptReqDisposition"",1)="""" D BUILDJSON^SDES2JSON(.JSON,.SDERRORS) Q"
^XMB(3.9,146098,2,1267,0)="""RTN"",""SDES2ARCLOSE"",27,0)"
^XMB(3.9,146098,2,1268,0)=" I $G(SDCONTEXT(""USER DUZ""))'="""" N DUZ D DUZ^XUP(SDCONTEXT(""USER DUZ""))"
^XMB(3.9,146098,2,1269,0)="""RTN"",""SDES2ARCLOSE"",28,0)"
^XMB(3.9,146098,2,1270,0)=" ; Validate PARAMS"
^XMB(3.9,146098,2,1271,0)="""RTN"",""SDES2ARCLOSE"",29,0)"
^XMB(3.9,146098,2,1272,0)=" S PARAMETERS=$$VALPARAMS(.SDINPUT,.SDERRORS)"
^XMB(3.9,146098,2,1273,0)="""RTN"",""SDES2ARCLOSE"",30,0)"
^XMB(3.9,146098,2,1274,0)=" I $D(SDERRORS) S SDERRORS(""ApptReqDisposition"",1)="""" D BUILDJSON^SDES2JSON(.JSON,.SDERRORS) Q"
^XMB(3.9,146098,2,1275,0)="""RTN"",""SDES2ARCLOSE"",31,0)"
^XMB(3.9,146098,2,1276,0)=" ;"
^XMB(3.9,146098,2,1277,0)="""RTN"",""SDES2ARCLOSE"",32,0)"
^XMB(3.9,146098,2,1278,0)=" S ARIEN=$P(PARAMETERS,""^""),DISP=$P(PARAMETERS,""^"",2),DISPDT=$P(PARAMETERS,""^"",3),PCMT=$P(PARAMETERS,""^"",4)"
^XMB(3.9,146098,2,1279,0)="""RTN"",""SDES2ARCLOSE"",33,0)"
^XMB(3.9,146098,2,1280,0)=" D DISP(.SDRETURN,ARIEN,DISP,DISPDT,PCMT,SDCONTEXT(""ACHERON AUDIT ID""),.SDERRORS)"
^XMB(3.9,146098,2,1281,0)="""RTN"",""SDES2ARCLOSE"",34,0)"
^XMB(3.9,146098,2,1282,0)=" ;"
^XMB(3.9,146098,2,1283,0)="""RTN"",""SDES2ARCLOSE"",35,0)"
^XMB(3.9,146098,2,1284,0)=" I $D(SDERRORS) S SDERRORS(""ApptReqDisposition"",1)="""" D BUILDJSON^SDES2JSON(.JSON,.SDERRORS) Q"
^XMB(3.9,146098,2,1285,0)="""RTN"",""SDES2ARCLOSE"",36,0)"
^XMB(3.9,146098,2,1286,0)=" ;"
^XMB(3.9,146098,2,1287,0)="""RTN"",""SDES2ARCLOSE"",37,0)"
^XMB(3.9,146098,2,1288,0)=" I '$D(SDRETURN) S SDRETURN(""ApptReqDisposition"",1)="""""
^XMB(3.9,146098,2,1289,0)="""RTN"",""SDES2ARCLOSE"",38,0)"
^XMB(3.9,146098,2,1290,0)=" D BUILDJSON^SDES2JSON(.JSON,.SDRETURN)"
^XMB(3.9,146098,2,1291,0)="""RTN"",""SDES2ARCLOSE"",39,0)"
^XMB(3.9,146098,2,1292,0)=" Q"
^XMB(3.9,146098,2,1293,0)="""RTN"",""SDES2ARCLOSE"",40,0)"
^XMB(3.9,146098,2,1294,0)=" ;"
^XMB(3.9,146098,2,1295,0)="""RTN"",""SDES2ARCLOSE"",41,0)"
^XMB(3.9,146098,2,1296,0)="VALPARAMS(PARAMS,SDERRORS) ; Validate"
^XMB(3.9,146098,2,1297,0)="""RTN"",""SDES2ARCLOSE"",42,0)"
^XMB(3.9,146098,2,1298,0)=" N ARIEN,DISP,DISPDT,PCMT"
^XMB(3.9,146098,2,1299,0)="""RTN"",""SDES2ARCLOSE"",43,0)"
^XMB(3.9,146098,2,1300,0)=" ;"
^XMB(3.9,146098,2,1301,0)="""RTN"",""SDES2ARCLOSE"",44,0)"
^XMB(3.9,146098,2,1302,0)=" ; Validate Request ID"
^XMB(3.9,146098,2,1303,0)="""RTN"",""SDES2ARCLOSE"",45,0)"
^XMB(3.9,146098,2,1304,0)=" S ARIEN=$G(PARAMS(""REQUEST ID""))"
^XMB(3.9,146098,2,1305,0)="""RTN"",""SDES2ARCLOSE"",46,0)"
^XMB(3.9,146098,2,1306,0)=" I $G(ARIEN)="""" D ERRLOG^SDESJSON(.SDERRORS,3)"
^XMB(3.9,146098,2,1307,0)="""RTN"",""SDES2ARCLOSE"",47,0)"
^XMB(3.9,146098,2,1308,0)=" I $G(ARIEN)'="""",'$D(^SDEC(409.85,ARIEN)) D ERRLOG^SDESJSON(.SDERRORS,4)"
^XMB(3.9,146098,2,1309,0)="""RTN"",""SDES2ARCLOSE"",48,0)"
^XMB(3.9,146098,2,1310,0)=" ;"
^XMB(3.9,146098,2,1311,0)="""RTN"",""SDES2ARCLOSE"",49,0)"
^XMB(3.9,146098,2,1312,0)=" ; Validate Disposition"
^XMB(3.9,146098,2,1313,0)="""RTN"",""SDES2ARCLOSE"",50,0)"
^XMB(3.9,146098,2,1314,0)=" S DISP=$G(PARAMS(""DISP""))"
^XMB(3.9,146098,2,1315,0)="""RTN"",""SDES2ARCLOSE"",51,0)"
^XMB(3.9,146098,2,1316,0)=" I $G(DISP)="""" D ERRLOG^SDESJSON(.SDERRORS,42)"
^XMB(3.9,146098,2,1317,0)="""RTN"",""SDES2ARCLOSE"",52,0)"
^XMB(3.9,146098,2,1318,0)=" Q:$D(SDERRORS) """""
^XMB(3.9,146098,2,1319,0)="""RTN"",""SDES2ARCLOSE"",53,0)"
^XMB(3.9,146098,2,1320,0)=" ; Re-mapped the Dispositions to their corresponding pointer value"
^XMB(3.9,146098,2,1321,0)="""RTN"",""SDES2ARCLOSE"",54,0)"
^XMB(3.9,146098,2,1322,0)=" S:(+DISP=0) DISP=$O(^SDEC(409.853,""B"",DISP,""""))"
^XMB(3.9,146098,2,1323,0)="""RTN"",""SDES2ARCLOSE"",55,0)"
^XMB(3.9,146098,2,1324,0)=" D:$$GET1^DIQ(409.853,DISP,.01)="""" ERRLOG^SDESJSON(.SDERRORS,43)"
^XMB(3.9,146098,2,1325,0)="""RTN"",""SDES2ARCLOSE"",56,0)"
^XMB(3.9,146098,2,1326,0)=" ;"
^XMB(3.9,146098,2,1327,0)="""RTN"",""SDES2ARCLOSE"",57,0)"
^XMB(3.9,146098,2,1328,0)=" ; Validate DATE DISPOSITIONED"
^XMB(3.9,146098,2,1329,0)="""RTN"",""SDES2ARCLOSE"",58,0)"
^XMB(3.9,146098,2,1330,0)=" S DISPDT=$G(PARAMS(""DISPDT""))"
^XMB(3.9,146098,2,1331,0)="""RTN"",""SDES2ARCLOSE"",59,0)"
^XMB(3.9,146098,2,1332,0)=" I $G(DISPDT)'="""" S DISPDT=$$ISOTFM^SDAMUTDT(DISPDT) D"
^XMB(3.9,146098,2,1333,0)="""RTN"",""SDES2ARCLOSE"",60,0)"
^XMB(3.9,146098,2,1334,0)=" .I DISPDT=-1 D ERRLOG^SDESJSON(.SDERRORS,55)"
^XMB(3.9,146098,2,1335,0)="""RTN"",""SDES2ARCLOSE"",61,0)"
^XMB(3.9,146098,2,1336,0)=" I $G(DISPDT)="""" D ERRLOG^SDESJSON(.SDERRORS,56)"
^XMB(3.9,146098,2,1337,0)="""RTN"",""SDES2ARCLOSE"",62,0)"
^XMB(3.9,146098,2,1338,0)=" ;"
^XMB(3.9,146098,2,1339,0)="""RTN"",""SDES2ARCLOSE"",63,0)"
^XMB(3.9,146098,2,1340,0)=" ; validate Patient-Entered comments"
^XMB(3.9,146098,2,1341,0)="""RTN"",""SDES2ARCLOSE"",64,0)"
^XMB(3.9,146098,2,1342,0)=" S PCMT=$G(PARAMS(""PCMT""))"
^XMB(3.9,146098,2,1343,0)="""RTN"",""SDES2ARCLOSE"",65,0)"
