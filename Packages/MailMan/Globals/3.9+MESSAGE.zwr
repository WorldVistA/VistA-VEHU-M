^XMB(3.9,146054,2,455,0)="""RTN"",""XQARPRT2"",107,0)"
^XMB(3.9,146054,2,456,0)=" Q"
^XMB(3.9,146054,2,457,0)="""RTN"",""XQARPRT2"",108,0)"
^XMB(3.9,146054,2,458,0)="DTPT ; OPT - GIVEN DATE AND PATIENT, TAKE A LOOK AT ALL USING 'D' X-REF"
^XMB(3.9,146054,2,459,0)="""RTN"",""XQARPRT2"",109,0)"
^XMB(3.9,146054,2,460,0)=" ; for one day and for 1 patient list data in alert tracking file related to patient"
^XMB(3.9,146054,2,461,0)="""RTN"",""XQARPRT2"",110,0)"
^XMB(3.9,146054,2,462,0)=" N DIR,XQANAME,XQADFN,XQA1U4N,XQASDATE,XQAEDATE,XQA1U4NP,XQAWORDS"
^XMB(3.9,146054,2,463,0)="""RTN"",""XQARPRT2"",111,0)"
^XMB(3.9,146054,2,464,0)=" S DIR(0)=""PO^2:EMZ"" D ^DIR Q:Y'>0  S XQANAME=$P(Y,""^"",2),XQADFN=+Y,XQA1U4N=$$GET1^DIQ(2,XQADFN_"","",.0905),XQA1U4NP=""(""_XQA1U4N_"")"""
^XMB(3.9,146054,2,465,0)="""RTN"",""XQARPRT2"",112,0)"
^XMB(3.9,146054,2,466,0)=" D CHEKSCAN(XQADFN) Q:$D(DIRUT)"
^XMB(3.9,146054,2,467,0)="""RTN"",""XQARPRT2"",113,0)"
^XMB(3.9,146054,2,468,0)=" D DATES Q:Y'>0"
^XMB(3.9,146054,2,469,0)="""RTN"",""XQARPRT2"",114,0)"
^XMB(3.9,146054,2,470,0)=" D WORDS() K Y Q:$D(DIRUT)"
^XMB(3.9,146054,2,471,0)="""RTN"",""XQARPRT2"",115,0)"
^XMB(3.9,146054,2,472,0)=" S %ZIS=""MQ"" D ^%ZIS Q:POP  I $D(IO(""Q"")) K IO(""Q"") S ZTRTN=""DTPTDQ^XQARPRT2"",ZTDESC=""List of Patient Alerts"",ZTSAVE(""*"")="""" D ^%ZTLOAD W:$G(ZTSK)>0 !,""Task number is "",ZTSK K ZTSK Q"
^XMB(3.9,146054,2,473,0)="""RTN"",""XQARPRT2"",116,0)"
^XMB(3.9,146054,2,474,0)="DTPTDQ ;"
^XMB(3.9,146054,2,475,0)="""RTN"",""XQARPRT2"",117,0)"
^XMB(3.9,146054,2,476,0)=" N XQANWID,FOUND,ONE,ZERO,XQACTR,XQAIEN,XQATYPE,XQADATE,HEADERID,XQATOT"
^XMB(3.9,146054,2,477,0)="""RTN"",""XQARPRT2"",118,0)"
^XMB(3.9,146054,2,478,0)=" S HEADERID=""Patient ""_$$GET1^DIQ(2,XQADFN_"","",.01)_"" (""_$$GET1^DIQ(2,XQADFN_"","",.0905)_"")"""
^XMB(3.9,146054,2,479,0)="""RTN"",""XQARPRT2"",119,0)"
^XMB(3.9,146054,2,480,0)=" D HEADER(HEADERID,1)"
^XMB(3.9,146054,2,481,0)="""RTN"",""XQARPRT2"",120,0)"
^XMB(3.9,146054,2,482,0)=" S XQADATE=XQASDATE-0.0000001 F  S XQADATE=$O(^XTV(8992.1,""D"",XQADATE)) Q:(XQADATE'>0)!(XQADATE>XQAEDATE)  D  Q:$D(DIRUT)"
^XMB(3.9,146054,2,483,0)="""RTN"",""XQARPRT2"",121,0)"
