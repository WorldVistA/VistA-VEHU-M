^XMB(3.9,146098,2,2468,0)="BADADD ;Print patients with a Bad Address Indicator"
^XMB(3.9,146098,2,2469,0)="""RTN"",""SDLT"",118,0)"
^XMB(3.9,146098,2,2470,0)=" I '$D(^TMP($J,""BADADD"")) Q"
^XMB(3.9,146098,2,2471,0)="""RTN"",""SDLT"",119,0)"
^XMB(3.9,146098,2,2472,0)=" N SDHDR,SDHDR1"
^XMB(3.9,146098,2,2473,0)="""RTN"",""SDLT"",120,0)"
^XMB(3.9,146098,2,2474,0)=" W @IOF,$TR($J("""",IOM),"" "",""*"")"
^XMB(3.9,146098,2,2475,0)="""RTN"",""SDLT"",121,0)"
^XMB(3.9,146098,2,2476,0)=" S SDHDR=""BAD ADDRESS INDICATOR LIST"" W !,?(IOM-$L(SDHDR)/2),SDHDR,!"
^XMB(3.9,146098,2,2477,0)="""RTN"",""SDLT"",122,0)"
^XMB(3.9,146098,2,2478,0)=" S SDHDR1=""** THE LETTER FOR THESE PATIENT(S) DID NOT PRINT DUE TO A BAD ADDRESS INDICATOR."""
^XMB(3.9,146098,2,2479,0)="""RTN"",""SDLT"",123,0)"
^XMB(3.9,146098,2,2480,0)=" W !,""Last 4"",!,""of SSN"",?10,""Patient Name"",!"
^XMB(3.9,146098,2,2481,0)="""RTN"",""SDLT"",124,0)"
^XMB(3.9,146098,2,2482,0)=" W $TR($J("""",IOM),"" "",""*"")"
^XMB(3.9,146098,2,2483,0)="""RTN"",""SDLT"",125,0)"
^XMB(3.9,146098,2,2484,0)=" N SDNAM,SDDFN"
^XMB(3.9,146098,2,2485,0)="""RTN"",""SDLT"",126,0)"
