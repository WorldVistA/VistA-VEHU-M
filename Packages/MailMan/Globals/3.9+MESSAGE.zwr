^XMB(3.9,146101,2,1085,0)="""RTN"",""PSSPGXPR"",214,0)"
^XMB(3.9,146101,2,1086,0)=" S ^TMP($J,""PSSXWARN"",PSSACT,PSSXL,""AI"",PSSAIC)=""CITATIONS:"" D INCA"
^XMB(3.9,146101,2,1087,0)="""RTN"",""PSSPGXPR"",215,0)"
^XMB(3.9,146101,2,1088,0)=" ;pass in 0 for paramater 3 for no indentation, AND 79 FOR PARAM 2"
^XMB(3.9,146101,2,1089,0)="""RTN"",""PSSPGXPR"",216,0)"
^XMB(3.9,146101,2,1090,0)=" S PSSCITX1="""" F  S PSSCITX1=$O(PSSPHAR(PSSSUB1,PSSXL,""CITPRT"",PSSCITX1)) Q:PSSCITX1=""""  D"
^XMB(3.9,146101,2,1091,0)="""RTN"",""PSSPGXPR"",217,0)"
^XMB(3.9,146101,2,1092,0)=" .S PSSCITX4=$G(PSSPHAR(PSSSUB1,PSSXL,""CITPRT"",PSSCITX1))"
^XMB(3.9,146101,2,1093,0)="""RTN"",""PSSPGXPR"",218,0)"
