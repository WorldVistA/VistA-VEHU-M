^XMB(3.9,146091,2,506,0)=" . . . S PV(LCNT)=VERS_""P""_$P(TAR(""DILIST"",""ID"",L,"".01""),""^"",1)"
^XMB(3.9,146091,2,507,0)="""RTN"",""MAGQBUT4"",129,0)"
^XMB(3.9,146091,2,508,0)=" . . . S X=$P($P(TAR(""DILIST"",""ID"",L,"".02""),""^"",1),""@"",1)"
^XMB(3.9,146091,2,509,0)="""RTN"",""MAGQBUT4"",130,0)"
