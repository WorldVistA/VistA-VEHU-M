^XMB(3.9,146056,2,2641,0)="""RTN"",""VPRSDAP"",180,0)"
^XMB(3.9,146056,2,2642,0)=" ;"
^XMB(3.9,146056,2,2643,0)="""RTN"",""VPRSDAP"",181,0)"
^XMB(3.9,146056,2,2644,0)="DOSES(IEN) ; -- build DLIST(n)=instance of Dose Instructions"
^XMB(3.9,146056,2,2645,0)="""RTN"",""VPRSDAP"",182,0)"
^XMB(3.9,146056,2,2646,0)=" N DA,I S IEN=+$G(IEN)"
^XMB(3.9,146056,2,2647,0)="""RTN"",""VPRSDAP"",183,0)"
^XMB(3.9,146056,2,2648,0)=" S DA=0 F  S DA=$O(^OR(100,IEN,4.5,""ID"",""INSTR"",DA)) Q:DA<1  D"
^XMB(3.9,146056,2,2649,0)="""RTN"",""VPRSDAP"",184,0)"
^XMB(3.9,146056,2,2650,0)=" . S I=+$P($G(^OR(100,IEN,4.5,DA,0)),U,3)"
^XMB(3.9,146056,2,2651,0)="""RTN"",""VPRSDAP"",185,0)"
^XMB(3.9,146056,2,2652,0)=" . S:I DLIST(I)=I"
^XMB(3.9,146056,2,2653,0)="""RTN"",""VPRSDAP"",186,0)"
^XMB(3.9,146056,2,2654,0)=" ; look for NVA w/schedule (dose not required)"
^XMB(3.9,146056,2,2655,0)="""RTN"",""VPRSDAP"",187,0)"
^XMB(3.9,146056,2,2656,0)=" I '$O(DLIST(0)),$G(PSTYPE)=""N"",$O(^OR(100,IEN,4.5,""ID"",""SCHEDULE"",0)) S DLIST(1)=1"
^XMB(3.9,146056,2,2657,0)="""RTN"",""VPRSDAP"",188,0)"
^XMB(3.9,146056,2,2658,0)=" Q"
^XMB(3.9,146056,2,2659,0)="""RTN"",""VPRSDAP"",189,0)"
^XMB(3.9,146056,2,2660,0)=" ;"
^XMB(3.9,146056,2,2661,0)="""RTN"",""VPRSDAP"",190,0)"
^XMB(3.9,146056,2,2662,0)="BCMA(IEN,MAX) ; -- get list of most recent administrations for order"
^XMB(3.9,146056,2,2663,0)="""RTN"",""VPRSDAP"",191,0)"
^XMB(3.9,146056,2,2664,0)=" N ORPK,ADT,DA,CNT,STS"
^XMB(3.9,146056,2,2665,0)="""RTN"",""VPRSDAP"",192,0)"
^XMB(3.9,146056,2,2666,0)=" S IEN=+$G(IEN),CNT=0,ADT=9999999,MAX=$G(MAX,10)"
^XMB(3.9,146056,2,2667,0)="""RTN"",""VPRSDAP"",193,0)"
^XMB(3.9,146056,2,2668,0)=" I $G(DFN)<1 S DFN=+$P($G(^OR(100,IEN,0)),U,2) Q:'DFN"
^XMB(3.9,146056,2,2669,0)="""RTN"",""VPRSDAP"",194,0)"
^XMB(3.9,146056,2,2670,0)=" S ORPK=$G(^OR(100,IEN,4)) Q:ORPK="""""
^XMB(3.9,146056,2,2671,0)="""RTN"",""VPRSDAP"",195,0)"
^XMB(3.9,146056,2,2672,0)=" F  S ADT=$O(^PSB(53.79,""AORDX"",DFN,ORPK,ADT),-1) Q:ADT<1  D  Q:CNT'<MAX"
^XMB(3.9,146056,2,2673,0)="""RTN"",""VPRSDAP"",196,0)"
^XMB(3.9,146056,2,2674,0)=" . S DA=0 F  S DA=+$O(^PSB(53.79,""AORDX"",DFN,ORPK,ADT,DA)) Q:DA<1  D"
^XMB(3.9,146056,2,2675,0)="""RTN"",""VPRSDAP"",197,0)"
^XMB(3.9,146056,2,2676,0)=" .. ;I $P($G(^PSB(53.79,DA,0)),U,9)=""RM"" Q  ;REMOVED"
^XMB(3.9,146056,2,2677,0)="""RTN"",""VPRSDAP"",198,0)"
^XMB(3.9,146056,2,2678,0)=" .. S CNT=CNT+1,DLIST(CNT)=DA"
^XMB(3.9,146056,2,2679,0)="""RTN"",""VPRSDAP"",199,0)"
^XMB(3.9,146056,2,2680,0)=" Q"
^XMB(3.9,146056,2,2681,0)="""RTN"",""VPRSDAP"",200,0)"
^XMB(3.9,146056,2,2682,0)=" ;"
^XMB(3.9,146056,2,2683,0)="""RTN"",""VPRSDAP"",201,0)"
^XMB(3.9,146056,2,2684,0)="PSB ; -- VPR PSB EVENTS protocol listener (BCMA)"
^XMB(3.9,146056,2,2685,0)="""RTN"",""VPRSDAP"",202,0)"
^XMB(3.9,146056,2,2686,0)=" N IEN,DFN,ORPK,ORIFN"
^XMB(3.9,146056,2,2687,0)="""RTN"",""VPRSDAP"",203,0)"
^XMB(3.9,146056,2,2688,0)=" S IEN=$S($P($G(PSBIEN),"","",2)'="""":+$P(PSBIEN,"","",2),$G(PSBIEN)=""+1"":+$G(PSBIEN(1)),1:+$G(PSBIEN))"
^XMB(3.9,146056,2,2689,0)="""RTN"",""VPRSDAP"",204,0)"
^XMB(3.9,146056,2,2690,0)=" S DFN=+$G(^PSB(53.79,IEN,0)),ORPK=$P($G(^(.1)),U)"
^XMB(3.9,146056,2,2691,0)="""RTN"",""VPRSDAP"",205,0)"
^XMB(3.9,146056,2,2692,0)=" Q:DFN<1  Q:ORPK<1"
^XMB(3.9,146056,2,2693,0)="""RTN"",""VPRSDAP"",206,0)"
^XMB(3.9,146056,2,2694,0)=" S ORIFN=$$PLACER^PSSUTLA1(DFN,ORPK)"
^XMB(3.9,146056,2,2695,0)="""RTN"",""VPRSDAP"",207,0)"
^XMB(3.9,146056,2,2696,0)=" D:ORIFN POST^VPRHS(DFN,""Medication"",+ORIFN_"";100"")"
^XMB(3.9,146056,2,2697,0)="""RTN"",""VPRSDAP"",208,0)"
^XMB(3.9,146056,2,2698,0)=" Q"
^XMB(3.9,146056,2,2699,0)="""RTN"",""VPRSDAP"",209,0)"
^XMB(3.9,146056,2,2700,0)=" ;"
^XMB(3.9,146056,2,2701,0)="""RTN"",""VPRSDAP"",210,0)"
^XMB(3.9,146056,2,2702,0)="ADMSTS(DA) ; -- return the code^name of administration status"
^XMB(3.9,146056,2,2703,0)="""RTN"",""VPRSDAP"",211,0)"
^XMB(3.9,146056,2,2704,0)=" N X,Y,Z,Z0 S DA=+$G(DA)"
^XMB(3.9,146056,2,2705,0)="""RTN"",""VPRSDAP"",212,0)"
^XMB(3.9,146056,2,2706,0)=" S Y=$P($G(PSB0),U,9),X="""" I Y=""N"" D"
^XMB(3.9,146056,2,2707,0)="""RTN"",""VPRSDAP"",213,0)"
^XMB(3.9,146056,2,2708,0)=" . S Z="""" F  S Z=$O(^PSB(53.79,DA,.9,Z),-1) Q:'Z  S Z0=$G(^(Z,0)) D  Q:$L(X)"
^XMB(3.9,146056,2,2709,0)="""RTN"",""VPRSDAP"",214,0)"
^XMB(3.9,146056,2,2710,0)=" .. S X=$P(Z0,U,4) Q:X="""""
^XMB(3.9,146056,2,2711,0)="""RTN"",""VPRSDAP"",215,0)"
^XMB(3.9,146056,2,2712,0)=" .. S Y=$S(X=""REMOVED"":""RM"",1:$E(X))"
^XMB(3.9,146056,2,2713,0)="""RTN"",""VPRSDAP"",216,0)"
^XMB(3.9,146056,2,2714,0)=" I X="""" S X=$$EXTERNAL^DILFD(53.79,.09,,Y)"
^XMB(3.9,146056,2,2715,0)="""RTN"",""VPRSDAP"",217,0)"
^XMB(3.9,146056,2,2716,0)=" S:$L(X) Y=Y_U_X"
^XMB(3.9,146056,2,2717,0)="""RTN"",""VPRSDAP"",218,0)"
^XMB(3.9,146056,2,2718,0)=" Q Y"
^XMB(3.9,146056,2,2719,0)="""RTN"",""VPRSDAP"",219,0)"
^XMB(3.9,146056,2,2720,0)=" ;"
^XMB(3.9,146056,2,2721,0)="""RTN"",""VPRSDAP"",220,0)"
^XMB(3.9,146056,2,2722,0)="IV() ; -- Return 1 or 0, if order is for IV/infusion"
^XMB(3.9,146056,2,2723,0)="""RTN"",""VPRSDAP"",221,0)"
^XMB(3.9,146056,2,2724,0)=" I ORPK[""V"" Q 1"
^XMB(3.9,146056,2,2725,0)="""RTN"",""VPRSDAP"",222,0)"
^XMB(3.9,146056,2,2726,0)=" N X0,X S X0=$G(^OR(100,ORIFN,0))"
^XMB(3.9,146056,2,2727,0)="""RTN"",""VPRSDAP"",223,0)"
^XMB(3.9,146056,2,2728,0)=" I +$P(X0,U,5)=130 Q 1"
^XMB(3.9,146056,2,2729,0)="""RTN"",""VPRSDAP"",224,0)"
^XMB(3.9,146056,2,2730,0)=" S X=$P($G(^ORD(100.98,+$P(X0,U,11),0)),U,3)"
^XMB(3.9,146056,2,2731,0)="""RTN"",""VPRSDAP"",225,0)"
^XMB(3.9,146056,2,2732,0)=" I X?1""IV"".E Q 1"
^XMB(3.9,146056,2,2733,0)="""RTN"",""VPRSDAP"",226,0)"
^XMB(3.9,146056,2,2734,0)=" I X=""CI RX"" Q 1"
^XMB(3.9,146056,2,2735,0)="""RTN"",""VPRSDAP"",227,0)"
^XMB(3.9,146056,2,2736,0)=" ;I $G(^TMP(""PS"",$J,""A"",0))!$G(^TMP(""PS"",$J,""B"",0)) Q 1"
^XMB(3.9,146056,2,2737,0)="""RTN"",""VPRSDAP"",228,0)"
^XMB(3.9,146056,2,2738,0)=" Q 0"
^XMB(3.9,146056,2,2739,0)="""RTN"",""VPRSDAP"",229,0)"
^XMB(3.9,146056,2,2740,0)=" ;"
^XMB(3.9,146056,2,2741,0)="""RTN"",""VPRSDAP"",230,0)"
^XMB(3.9,146056,2,2742,0)="IVMEDS(IEN) ; -- build DLIST(#)=ien^amount^type[^bottle] for components"
^XMB(3.9,146056,2,2743,0)="""RTN"",""VPRSDAP"",231,0)"
^XMB(3.9,146056,2,2744,0)=" N CNT,GBL,I,Y,ND"
^XMB(3.9,146056,2,2745,0)="""RTN"",""VPRSDAP"",232,0)"
^XMB(3.9,146056,2,2746,0)=" S ORPK=$G(ORPK),CNT=0"
^XMB(3.9,146056,2,2747,0)="""RTN"",""VPRSDAP"",233,0)"
^XMB(3.9,146056,2,2748,0)=" S GBL=$S(ORPK[""P"":""^PS(53.1,"",ORPK[""U"":""^PS(55,DFN,5,"",1:""^PS(55,DFN,""""IV"""","")"
^XMB(3.9,146056,2,2749,0)="""RTN"",""VPRSDAP"",234,0)"
^XMB(3.9,146056,2,2750,0)=" F I=0:0 S I=$O(@(GBL_+ORPK_"",""""SOL"""",""_I_"")"")) Q:'I  D"
^XMB(3.9,146056,2,2751,0)="""RTN"",""VPRSDAP"",235,0)"
^XMB(3.9,146056,2,2752,0)=" . S ND=$G(@(GBL_+ORPK_"",""""SOL"""",""_I_"",0)""))"
^XMB(3.9,146056,2,2753,0)="""RTN"",""VPRSDAP"",236,0)"
^XMB(3.9,146056,2,2754,0)=" . S CNT=CNT+1,DLIST(CNT)=+ND_U_$P(ND,U,2)_""^B"""
^XMB(3.9,146056,2,2755,0)="""RTN"",""VPRSDAP"",237,0)"
^XMB(3.9,146056,2,2756,0)=" F I=0:0 S I=$O(@(GBL_+ORPK_"",""""AD"""",""_I_"")"")) Q:'I  D"
^XMB(3.9,146056,2,2757,0)="""RTN"",""VPRSDAP"",238,0)"
^XMB(3.9,146056,2,2758,0)=" . S ND=$G(@(GBL_+ORPK_"",""""AD"""",""_I_"",0)"")),Y=+ND_U_$P(ND,U,2)_""^A"""
^XMB(3.9,146056,2,2759,0)="""RTN"",""VPRSDAP"",239,0)"
^XMB(3.9,146056,2,2760,0)=" . S:$L($P(ND,U,3)) Y=Y_U_$P(ND,U,3)"
^XMB(3.9,146056,2,2761,0)="""RTN"",""VPRSDAP"",240,0)"
^XMB(3.9,146056,2,2762,0)=" . S CNT=CNT+1,DLIST(CNT)=Y"
^XMB(3.9,146056,2,2763,0)="""RTN"",""VPRSDAP"",241,0)"
^XMB(3.9,146056,2,2764,0)=" Q "
^XMB(3.9,146056,2,2765,0)="""RTN"",""VPRSDAP"",242,0)"
^XMB(3.9,146056,2,2766,0)=" ;"
^XMB(3.9,146056,2,2767,0)="""RTN"",""VPRSDAP"",243,0)"
^XMB(3.9,146056,2,2768,0)="IV1(X) ; -- get VA Drug Product info for IV component X (from DLIST)"
^XMB(3.9,146056,2,2769,0)="""RTN"",""VPRSDAP"",244,0)"
^XMB(3.9,146056,2,2770,0)=" ; Returns VPRPSIV = ien^name^amt^type^bottle#"
^XMB(3.9,146056,2,2771,0)="""RTN"",""VPRSDAP"",245,0)"
^XMB(3.9,146056,2,2772,0)=" N IEN,TYPE,NAME,DRUG"
^XMB(3.9,146056,2,2773,0)="""RTN"",""VPRSDAP"",246,0)"
^XMB(3.9,146056,2,2774,0)=" S VPRPSIV=$G(X) ;ien^amt^type[^bottle#] from IVMEDS"
^XMB(3.9,146056,2,2775,0)="""RTN"",""VPRSDAP"",247,0)"
^XMB(3.9,146056,2,2776,0)=" S IEN=+VPRPSIV,TYPE=$P(VPRPSIV,U,3)"
^XMB(3.9,146056,2,2777,0)="""RTN"",""VPRSDAP"",248,0)"
^XMB(3.9,146056,2,2778,0)=" D:TYPE=""B"" ZERO^PSS52P7(IEN,"""","""",""VPRPSIV"")"
^XMB(3.9,146056,2,2779,0)="""RTN"",""VPRSDAP"",249,0)"
^XMB(3.9,146056,2,2780,0)=" D:TYPE=""A"" ZERO^PSS52P6(IEN,"""","""",""VPRPSIV"")"
^XMB(3.9,146056,2,2781,0)="""RTN"",""VPRSDAP"",250,0)"
^XMB(3.9,146056,2,2782,0)=" S NAME=$G(^TMP($J,""VPRPSIV"",IEN,.01)),DRUG=+$G(^(1))"
^XMB(3.9,146056,2,2783,0)="""RTN"",""VPRSDAP"",251,0)"
^XMB(3.9,146056,2,2784,0)=" S VPRPSIV=IEN_U_NAME_U_$P(VPRPSIV,U,2,99)"
^XMB(3.9,146056,2,2785,0)="""RTN"",""VPRSDAP"",252,0)"
^XMB(3.9,146056,2,2786,0)=" S X=+$G(DRUG) D:DRUG NDF^VPRSDAP(DRUG) ;#50 ien"
^XMB(3.9,146056,2,2787,0)="""RTN"",""VPRSDAP"",253,0)"
^XMB(3.9,146056,2,2788,0)=" I 'DRUG D  ;return IV file instead"
^XMB(3.9,146056,2,2789,0)="""RTN"",""VPRSDAP"",254,0)"
^XMB(3.9,146056,2,2790,0)=" . S DATA=IEN_U_NAME_U_$S(TYPE=""A"":""VA52.6"",TYPE=""B"":""VA52.7"",1:""VA"")"
^XMB(3.9,146056,2,2791,0)="""RTN"",""VPRSDAP"",255,0)"
^XMB(3.9,146056,2,2792,0)=" . S VPRVAP=$NA(^TMP(""VPRX"",$J,""NDF"",0))"
^XMB(3.9,146056,2,2793,0)="""RTN"",""VPRSDAP"",256,0)"
^XMB(3.9,146056,2,2794,0)=" K ^TMP($J,""VPRPSIV"")"
^XMB(3.9,146056,2,2795,0)="""RTN"",""VPRSDAP"",257,0)"
^XMB(3.9,146056,2,2796,0)=" Q"
^XMB(3.9,146056,2,2797,0)="""RTN"",""VPRSDAP"",258,0)"
^XMB(3.9,146056,2,2798,0)=" ;"
^XMB(3.9,146056,2,2799,0)="""RTN"",""VPRSDAP"",259,0)"
^XMB(3.9,146056,2,2800,0)="IVRATE(IEN) ; -- return IV Rate, or DDEOUT if invalid"
^XMB(3.9,146056,2,2801,0)="""RTN"",""VPRSDAP"",260,0)"
^XMB(3.9,146056,2,2802,0)=" ; also VPRATE = numeric amount, if ## ml/hr"
^XMB(3.9,146056,2,2803,0)="""RTN"",""VPRSDAP"",261,0)"
^XMB(3.9,146056,2,2804,0)=" I $G(PSTYPE)'=""V"" S DDEOUT=1 Q """""
^XMB(3.9,146056,2,2805,0)="""RTN"",""VPRSDAP"",262,0)"
^XMB(3.9,146056,2,2806,0)=" N X S IEN=+$G(IEN)"
^XMB(3.9,146056,2,2807,0)="""RTN"",""VPRSDAP"",263,0)"
^XMB(3.9,146056,2,2808,0)=" S X=$$VALUE^ORX8(IEN,""RATE"")"
^XMB(3.9,146056,2,2809,0)="""RTN"",""VPRSDAP"",264,0)"
^XMB(3.9,146056,2,2810,0)=" I X?1.N1"" ml/hr"".E S VPRATE=+X Q +X"
^XMB(3.9,146056,2,2811,0)="""RTN"",""VPRSDAP"",265,0)"
^XMB(3.9,146056,2,2812,0)=" S DDEOUT=1"
^XMB(3.9,146056,2,2813,0)="""RTN"",""VPRSDAP"",266,0)"
^XMB(3.9,146056,2,2814,0)=" Q """""
^XMB(3.9,146056,2,2815,0)="""RTN"",""VPRSDAP"",267,0)"
^XMB(3.9,146056,2,2816,0)=" ;"
^XMB(3.9,146056,2,2817,0)="""RTN"",""VPRSDAP"",268,0)"
^XMB(3.9,146056,2,2818,0)="IVTYPE(IEN) ; -- return IV Type, or DDEOUT if invalid"
^XMB(3.9,146056,2,2819,0)="""RTN"",""VPRSDAP"",269,0)"
^XMB(3.9,146056,2,2820,0)=" I $G(PSTYPE)'=""V"" S DDEOUT=1 Q """""
^XMB(3.9,146056,2,2821,0)="""RTN"",""VPRSDAP"",270,0)"
^XMB(3.9,146056,2,2822,0)=" N X,Y,ORPK,FN,FLD,IENS"
^XMB(3.9,146056,2,2823,0)="""RTN"",""VPRSDAP"",271,0)"
^XMB(3.9,146056,2,2824,0)=" S IEN=+$G(IEN),Y="""",ORPK=$G(^OR(100,IEN,4))"
^XMB(3.9,146056,2,2825,0)="""RTN"",""VPRSDAP"",272,0)"
^XMB(3.9,146056,2,2826,0)=" I ORPK[""P"" S FN=53.1,FLD=53,IENS=+ORPK"
^XMB(3.9,146056,2,2827,0)="""RTN"",""VPRSDAP"",273,0)"
^XMB(3.9,146056,2,2828,0)=" E  S FN=55.01,FLD=.04,IENS=+ORPK_"",""_DFN"
^XMB(3.9,146056,2,2829,0)="""RTN"",""VPRSDAP"",274,0)"
^XMB(3.9,146056,2,2830,0)=" S Y=$$GET1^DIQ(FN,IENS_"","",FLD)"
^XMB(3.9,146056,2,2831,0)="""RTN"",""VPRSDAP"",275,0)"
^XMB(3.9,146056,2,2832,0)=" Q Y"
