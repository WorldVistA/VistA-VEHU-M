^XMB(3.9,146091,2,247,0)="""RTN"",""MAGIP355"")"
^XMB(3.9,146091,2,248,0)="1^1"
^XMB(3.9,146091,2,249,0)="""RTN"",""MAGQBUT4"")"
^XMB(3.9,146091,2,250,0)="0^2^B97927680"
^XMB(3.9,146091,2,251,0)="""RTN"",""MAGQBUT4"",1,0)"
^XMB(3.9,146091,2,252,0)="MAGQBUT4 ;WOIFO/RMP,DAC,JSJ - BP Utilities ; Jun 16, 2022@14:42:24"
^XMB(3.9,146091,2,253,0)="""RTN"",""MAGQBUT4"",2,0)"
^XMB(3.9,146091,2,254,0)=" ;;3.0;IMAGING;**7,8,48,20,81,39,121,135,196,198,214,222,235,238,243,248,325,293,331,347**;Mar 19, 2002;Build 0"
^XMB(3.9,146091,2,255,0)="""RTN"",""MAGQBUT4"",3,0)"
^XMB(3.9,146091,2,256,0)=" ;; Per VA Directive 6402, this routine should not be modified."
^XMB(3.9,146091,2,257,0)="""RTN"",""MAGQBUT4"",4,0)"
^XMB(3.9,146091,2,258,0)=" ;; +---------------------------------------------------------------+"
^XMB(3.9,146091,2,259,0)="""RTN"",""MAGQBUT4"",5,0)"
^XMB(3.9,146091,2,260,0)=" ;; | Property of the US Government.                                |"
^XMB(3.9,146091,2,261,0)="""RTN"",""MAGQBUT4"",6,0)"
^XMB(3.9,146091,2,262,0)=" ;; | No permission to copy or redistribute this software is given. |"
^XMB(3.9,146091,2,263,0)="""RTN"",""MAGQBUT4"",7,0)"
^XMB(3.9,146091,2,264,0)=" ;; | Use of unreleased versions of this software requires the user |"
^XMB(3.9,146091,2,265,0)="""RTN"",""MAGQBUT4"",8,0)"
^XMB(3.9,146091,2,266,0)=" ;; | to execute a written test agreement with the VistA Imaging    |"
^XMB(3.9,146091,2,267,0)="""RTN"",""MAGQBUT4"",9,0)"
^XMB(3.9,146091,2,268,0)=" ;; | Development Office of the Department of Veterans Affairs,     |"
^XMB(3.9,146091,2,269,0)="""RTN"",""MAGQBUT4"",10,0)"
^XMB(3.9,146091,2,270,0)=" ;; | telephone (301) 734-0100.                                     |"
^XMB(3.9,146091,2,271,0)="""RTN"",""MAGQBUT4"",11,0)"
^XMB(3.9,146091,2,272,0)=" ;; | The Food and Drug Administration classifies this software as  |"
^XMB(3.9,146091,2,273,0)="""RTN"",""MAGQBUT4"",12,0)"
^XMB(3.9,146091,2,274,0)=" ;; | a medical device.  As such, it may not be changed in any way. |"
^XMB(3.9,146091,2,275,0)="""RTN"",""MAGQBUT4"",13,0)"
^XMB(3.9,146091,2,276,0)=" ;; | Modifications to this software may result in an adulterated   |"
^XMB(3.9,146091,2,277,0)="""RTN"",""MAGQBUT4"",14,0)"
^XMB(3.9,146091,2,278,0)=" ;; | medical device under 21CFR820, the use of which is considered |"
^XMB(3.9,146091,2,279,0)="""RTN"",""MAGQBUT4"",15,0)"
^XMB(3.9,146091,2,280,0)=" ;; | to be a violation of US Federal Statutes.                     |"
^XMB(3.9,146091,2,281,0)="""RTN"",""MAGQBUT4"",16,0)"
^XMB(3.9,146091,2,282,0)=" ;; +---------------------------------------------------------------+"
^XMB(3.9,146091,2,283,0)="""RTN"",""MAGQBUT4"",17,0)"
^XMB(3.9,146091,2,284,0)=" ;;"
^XMB(3.9,146091,2,285,0)="""RTN"",""MAGQBUT4"",18,0)"
^XMB(3.9,146091,2,286,0)=" ;"
^XMB(3.9,146091,2,287,0)="""RTN"",""MAGQBUT4"",19,0)"
^XMB(3.9,146091,2,288,0)=" Q"
^XMB(3.9,146091,2,289,0)="""RTN"",""MAGQBUT4"",20,0)"
^XMB(3.9,146091,2,290,0)="VOKR(RESULT,VER) ; RPC for VOK [MAGQ VOK]"
^XMB(3.9,146091,2,291,0)="""RTN"",""MAGQBUT4"",21,0)"
^XMB(3.9,146091,2,292,0)=" ; P196 changed the way version checking works.  "
^XMB(3.9,146091,2,293,0)="""RTN"",""MAGQBUT4"",22,0)"
^XMB(3.9,146091,2,294,0)=" ;  we now allow older versions of the BP to run. "
^XMB(3.9,146091,2,295,0)="""RTN"",""MAGQBUT4"",23,0)"
^XMB(3.9,146091,2,296,0)=" N CLPATCH,SVRPATCH"
^XMB(3.9,146091,2,297,0)="""RTN"",""MAGQBUT4"",24,0)"
^XMB(3.9,146091,2,298,0)=" ;   get client Patch number"
^XMB(3.9,146091,2,299,0)="""RTN"",""MAGQBUT4"",25,0)"
^XMB(3.9,146091,2,300,0)=" S CLPATCH=$$TRIM($P(VER,""P"",2))"
^XMB(3.9,146091,2,301,0)="""RTN"",""MAGQBUT4"",26,0)"
^XMB(3.9,146091,2,302,0)=" ; These are allowable Clients."
^XMB(3.9,146091,2,303,0)="""RTN"",""MAGQBUT4"",27,0)"
^XMB(3.9,146091,2,304,0)=" S SVRPATCH="",293,331,347"" ; P293,P331,P347 drop P325 continue last 3"
^XMB(3.9,146091,2,305,0)="""RTN"",""MAGQBUT4"",28,0)"
^XMB(3.9,146091,2,306,0)=" ; if client patch is allowed Result = 1^..."
^XMB(3.9,146091,2,307,0)="""RTN"",""MAGQBUT4"",29,0)"
^XMB(3.9,146091,2,308,0)=" I SVRPATCH[CLPATCH S RESULT=""1^3.0P331"""
^XMB(3.9,146091,2,309,0)="""RTN"",""MAGQBUT4"",30,0)"
^XMB(3.9,146091,2,310,0)=" E  S RESULT=""0^3.0P331"""
^XMB(3.9,146091,2,311,0)="""RTN"",""MAGQBUT4"",31,0)"
^XMB(3.9,146091,2,312,0)=" Q"
^XMB(3.9,146091,2,313,0)="""RTN"",""MAGQBUT4"",32,0)"
^XMB(3.9,146091,2,314,0)="OLD ;"
^XMB(3.9,146091,2,315,0)="""RTN"",""MAGQBUT4"",33,0)"
^XMB(3.9,146091,2,316,0)=" S VER=""3.0P""_($$TRIM($P(VER,""P"",2)))"
^XMB(3.9,146091,2,317,0)="""RTN"",""MAGQBUT4"",34,0)"
