^XMB(3.9,146017,2,2336,0)=" ; SDCONTEXT - STANDARD SDCONTEXT ARRAY"
^XMB(3.9,146017,2,2337,0)="""RTN"",""SDES2GETCLINAVL"",10,0)"
^XMB(3.9,146017,2,2338,0)=" ;"
^XMB(3.9,146017,2,2339,0)="""RTN"",""SDES2GETCLINAVL"",11,0)"
