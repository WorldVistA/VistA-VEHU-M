^XMB(3.9,146012,2,1114,0)=" Q"
^XMB(3.9,146012,2,1115,0)="""RTN"",""PSOERRX0"",320,0)"
^XMB(3.9,146012,2,1116,0)=" ;"
^XMB(3.9,146012,2,1117,0)="""RTN"",""PSOERRX0"",321,0)"
^XMB(3.9,146012,2,1118,0)="REF ;Screen Refresh"
^XMB(3.9,146012,2,1119,0)="""RTN"",""PSOERRX0"",322,0)"
^XMB(3.9,146012,2,1120,0)=" W ?52,""Please wait..."" D INIT,HDR S VALMBCK=""R"""
