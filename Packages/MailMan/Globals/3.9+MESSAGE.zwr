^XMB(3.9,146012,2,887,0)="""RTN"",""PSOERRX0"",206,0)"
^XMB(3.9,146012,2,888,0)=" Q"
^XMB(3.9,146012,2,889,0)="""RTN"",""PSOERRX0"",207,0)"
^XMB(3.9,146012,2,890,0)=" ;"
^XMB(3.9,146012,2,891,0)="""RTN"",""PSOERRX0"",208,0)"
^XMB(3.9,146012,2,892,0)="PRVFLTR ; - eRx Provider Filter"
^XMB(3.9,146012,2,893,0)="""RTN"",""PSOERRX0"",209,0)"
^XMB(3.9,146012,2,894,0)=" N DIR,PRV,XX,PRVLST,RANGE,COMSEG,I,J,DIRUT,DIROUT,QUIT"
^XMB(3.9,146012,2,895,0)="""RTN"",""PSOERRX0"",210,0)"
^XMB(3.9,146012,2,896,0)=" S DIR(0)=""F^3:30"",DIR(""A"")=""ERX PROVIDER NAME"""
^XMB(3.9,146012,2,897,0)="""RTN"",""PSOERRX0"",211,0)"
^XMB(3.9,146012,2,898,0)=" W ! D ^DIR I $D(DIRUT)!$D(DIROUT) Q"
