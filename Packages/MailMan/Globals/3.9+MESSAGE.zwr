^XMB(3.9,146012,2,1626,0)=" S DOB=$P(EPTNODE1,""^"",4)"
^XMB(3.9,146012,2,1627,0)="""RTN"",""PSOERRX1"",222,0)"
^XMB(3.9,146012,2,1628,0)=" S PROVIDER=+$G(^PS(52.49,ERXIEN,2)),PROVIDER=$P($G(^PS(52.48,PROVIDER,0)),""^"")"
^XMB(3.9,146012,2,1629,0)="""RTN"",""PSOERRX1"",223,0)"
^XMB(3.9,146012,2,1630,0)=" I PROVIDER="""" S PROVIDER=$$GET1^DIQ(52.48,+$$GETPROV^PSOERXU5(ERXIEN),.01) S:PROVIDER="""" PROVIDER=""N/A"""
^XMB(3.9,146012,2,1631,0)="""RTN"",""PSOERRX1"",224,0)"
^XMB(3.9,146012,2,1632,0)=" S CSGROUP=$S('PSOCSGRP:""ALL"",CSERX:""CS"",1:""NON-CS"")"
^XMB(3.9,146012,2,1633,0)="""RTN"",""PSOERRX1"",225,0)"
^XMB(3.9,146012,2,1634,0)=" I MTYPE=""CR"",(ERXSTAT=""CRE"") Q"
^XMB(3.9,146012,2,1635,0)="""RTN"",""PSOERRX1"",226,0)"
^XMB(3.9,146012,2,1636,0)=" S SKIP=0"
^XMB(3.9,146012,2,1637,0)="""RTN"",""PSOERRX1"",227,0)"
^XMB(3.9,146012,2,1638,0)=" I $D(RXREQARY),MTYPE=""CR"",$G(MSTPFLTR)=MTYPE D  Q:SKIP"
^XMB(3.9,146012,2,1639,0)="""RTN"",""PSOERRX1"",228,0)"
^XMB(3.9,146012,2,1640,0)=" . I $G(CHGMESRI)="""" S SKIP=1 Q"
^XMB(3.9,146012,2,1641,0)="""RTN"",""PSOERRX1"",229,0)"
^XMB(3.9,146012,2,1642,0)=" . I '$D(RXREQARY(CHGMESRI)) S SKIP=1"
^XMB(3.9,146012,2,1643,0)="""RTN"",""PSOERRX1"",230,0)"
^XMB(3.9,146012,2,1644,0)=" S Z="""",$P(Z,""^"")=PATNAME,$P(Z,""^"",2)=$$FMTE^XLFDT(DOB,""2Z""),$P(Z,""^"",3)=EDRUG,$P(Z,""^"",4)=PROVIDER"
^XMB(3.9,146012,2,1645,0)="""RTN"",""PSOERRX1"",231,0)"
