^XMB(3.9,146018,2,717,0)="""RTN"",""DPTLK7"",235,0)"
^XMB(3.9,146018,2,718,0)=" W !,""Patient identifiers--"""
^XMB(3.9,146018,2,719,0)="""RTN"",""DPTLK7"",236,0)"
