^XMB(3.9,146035,2,363,0)="""RTN"",""PSOBBC"",62,0)"
^XMB(3.9,146035,2,364,0)=" S DIR(0)=""YA"""
^XMB(3.9,146035,2,365,0)="""RTN"",""PSOBBC"",63,0)"
^XMB(3.9,146035,2,366,0)=" S DIR(""A"")=""Allow refills for Inpatient ? """
