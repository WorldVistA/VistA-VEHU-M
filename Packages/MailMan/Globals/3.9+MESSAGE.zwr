^XMB(3.9,146051,2,239,0)="""RTN"",""FBNHPC"")"
^XMB(3.9,146051,2,240,0)="0^1^B16674019"
^XMB(3.9,146051,2,241,0)="""RTN"",""FBNHPC"",1,0)"
^XMB(3.9,146051,2,242,0)="FBNHPC ;AISC/GRR-POST COMMITMENTS TO 1358 ;1DEC00"
^XMB(3.9,146051,2,243,0)="""RTN"",""FBNHPC"",2,0)"
^XMB(3.9,146051,2,244,0)=" ;;3.5;FEE BASIS;**25,153,162,194**;JAN 30, 1995;Build 0"
^XMB(3.9,146051,2,245,0)="""RTN"",""FBNHPC"",3,0)"
^XMB(3.9,146051,2,246,0)=" ;;Per VA Directive 6402, this routine should not be modified."
^XMB(3.9,146051,2,247,0)="""RTN"",""FBNHPC"",4,0)"
^XMB(3.9,146051,2,248,0)=" ;"
^XMB(3.9,146051,2,249,0)="""RTN"",""FBNHPC"",5,0)"
^XMB(3.9,146051,2,250,0)=" ;FB*3.5*153 Save requested site internal to insure obligation found in file"
^XMB(3.9,146051,2,251,0)="""RTN"",""FBNHPC"",6,0)"
^XMB(3.9,146051,2,252,0)=" ;           FB7078 for time period selected is from the same station selected"
^XMB(3.9,146051,2,253,0)="""RTN"",""FBNHPC"",7,0)"
^XMB(3.9,146051,2,254,0)=" ;           during option process.  This is true for both monthly activity"
^XMB(3.9,146051,2,255,0)="""RTN"",""FBNHPC"",8,0)"
^XMB(3.9,146051,2,256,0)=" ;           as well as carry over activity and Insufficient Authorization "
^XMB(3.9,146051,2,257,0)="""RTN"",""FBNHPC"",9,0)"
^XMB(3.9,146051,2,258,0)=" ;           Rate data on file"
^XMB(3.9,146051,2,259,0)="""RTN"",""FBNHPC"",10,0)"
^XMB(3.9,146051,2,260,0)=" ;"
^XMB(3.9,146051,2,261,0)="""RTN"",""FBNHPC"",11,0)"
^XMB(3.9,146051,2,262,0)=" ;FB*3.5*162 Modify task process to include PRC(""site"")"
^XMB(3.9,146051,2,263,0)="""RTN"",""FBNHPC"",12,0)"
^XMB(3.9,146051,2,264,0)=" ;"
^XMB(3.9,146051,2,265,0)="""RTN"",""FBNHPC"",13,0)"
^XMB(3.9,146051,2,266,0)=" S PRCS(""TYPE"")=""FB"",(FBNHCC,FBTOT)=0,PRCS(""A"")=""Select Obligation Number: "" K PRCS(""X"") D EN1^PRCS58 G:Y<0 Q S FBOBN=$P(Y,""^"",2),FBSTA=PRC(""SST"")   ;FB*3.5*153"
^XMB(3.9,146051,2,267,0)="""RTN"",""FBNHPC"",14,0)"
^XMB(3.9,146051,2,268,0)=" ;entry point for estimate report FBNHCC=1,(FBSEQ,FBOBN)="""""
^XMB(3.9,146051,2,269,0)="""RTN"",""FBNHPC"",15,0)"
^XMB(3.9,146051,2,270,0)="EN1 I FBNHCC D STA^PRCSUT Q:'$D(PRC(""SITE""))  S FBSTA=PRC(""SST"")     ;FB*3.5*153"
^XMB(3.9,146051,2,271,0)="""RTN"",""FBNHPC"",16,0)"
^XMB(3.9,146051,2,272,0)=" S FBTOT=0,%DT=$S(FBNHCC:""AEPMX"",1:""AEPMX""),%DT(""A"")=$S(FBNHCC:""Calculate "",1:""Post "")_""Commitments for which Month/Year: "" D ^%DT G:X=""^""!(X="""") Q S FBPAYDT=$E(+Y,1,5)_""00"",FBMM=$E(+Y,4,5),FBYY=$E(+Y,2,3),X=+Y D DAYS^FBAAUTL1 S FBDAYS=X"
^XMB(3.9,146051,2,273,0)="""RTN"",""FBNHPC"",17,0)"
^XMB(3.9,146051,2,274,0)=" S VAR=""FBOBN^FBPAYDT^FBMM^FBYY^FBDAYS^FBNHCC^FBSTA^PRC(""""SITE"""")"",VAL=FBOBN_""^""_FBPAYDT_""^""_FBMM_""^""_FBYY_""^""_FBDAYS_""^""_FBNHCC,PGM=""START^FBNHPC"" D ZIS^FBAAUTL G:FBPOP END   ;FB*3.5*162"
^XMB(3.9,146051,2,275,0)="""RTN"",""FBNHPC"",18,0)"
^XMB(3.9,146051,2,276,0)=" ;"
^XMB(3.9,146051,2,277,0)="""RTN"",""FBNHPC"",19,0)"
^XMB(3.9,146051,2,278,0)="START K ^TMP($J,""FBNHPC"") S (FBPAYEDT,FBENDDT)=$E(FBPAYDT,1,5)_FBDAYS,Q="""",$P(Q,""="",80)=""="",(FBTOT,FBTOTAL,FBOUT)=0 U IO W:$E(IOST,1,2)[""C-"" @IOF D HED^FBNHPC1"
^XMB(3.9,146051,2,279,0)="""RTN"",""FBNHPC"",20,0)"
^XMB(3.9,146051,2,280,0)=" N FBCNT S FBCNT=0"
^XMB(3.9,146051,2,281,0)="""RTN"",""FBNHPC"",21,0)"
^XMB(3.9,146051,2,282,0)=" S FBIFN=0,^XTMP(""FBPOST"",0)=$$CDTC^FBUCUTL(DT,1)_""^""_DT"
^XMB(3.9,146051,2,283,0)="""RTN"",""FBNHPC"",22,0)"
^XMB(3.9,146051,2,284,0)=" F FBDD=FBPAYDT:0 S FBDD=$O(^FB7078(""AD"",7,FBDD)) Q:FBDD'>0!(FBOUT)  D"
^XMB(3.9,146051,2,285,0)="""RTN"",""FBNHPC"",23,0)"
^XMB(3.9,146051,2,286,0)=" .F  S FBIFN=$O(^FB7078(""AD"",7,FBDD,FBIFN)) Q:'FBIFN!(FBOUT)  I $D(^FB7078(FBIFN,0)) S FBZ=^(0) I $P(FBZ,U,9)'=""DC"" S (FBHIFN,FB7078)=FBIFN,FBABD=$P(FBZ,""^"",4),IFN=+$P(FBZ,""^"",2),DFN=+$P(FBZ,""^"",3) D"
^XMB(3.9,146051,2,287,0)="""RTN"",""FBNHPC"",24,0)"
^XMB(3.9,146051,2,288,0)=" ..D L(FBIFN,1) I $G(FBLERR) S FBNAME=$$NAME^FBCHREQ2(DFN),FBSSN=$$SSN^FBAAUTL(DFN),Y=""Another user is editing 7078."" D ERR K FBLERR,Y W ! Q"
^XMB(3.9,146051,2,289,0)="""RTN"",""FBNHPC"",25,0)"
^XMB(3.9,146051,2,290,0)=" ..I '$D(^XTMP(""FBPOST"",FBIFN)) D CHECK^FBNHPC1,L(FBIFN,2)"
^XMB(3.9,146051,2,291,0)="""RTN"",""FBNHPC"",26,0)"
^XMB(3.9,146051,2,292,0)=" G END:FBOUT"
^XMB(3.9,146051,2,293,0)="""RTN"",""FBNHPC"",27,0)"
^XMB(3.9,146051,2,294,0)=" D PRT^FBNHPC1"
^XMB(3.9,146051,2,295,0)="""RTN"",""FBNHPC"",28,0)"
^XMB(3.9,146051,2,296,0)=" I $$WRT() W !!?10,""No funds currently need to be posted."",! G END"
^XMB(3.9,146051,2,297,0)="""RTN"",""FBNHPC"",29,0)"
^XMB(3.9,146051,2,298,0)="Q W !!,?10,""Total "",$S(FBNHCC:""Estimated: "",1:""Posted: ""),$J(FBTOT,10,2),?50,""Total Days: "",$S($D(FBTOTAL):FBTOTAL,1:0),!"
^XMB(3.9,146051,2,299,0)="""RTN"",""FBNHPC"",30,0)"
^XMB(3.9,146051,2,300,0)=" ;"
^XMB(3.9,146051,2,301,0)="""RTN"",""FBNHPC"",31,0)"
^XMB(3.9,146051,2,302,0)="END K FBMM,FBYY,FBDEFP,FBABD,FBPAYDT,FBDAYS,FBIFN,Z1,Z2,FBVCAR,FBCD,FBSEQ,FBOBN,FBNAME,FBSSN,FBPOSDT,FBNHCC,FBTOTAL,FBPAYEDT,FB7078,FBAABDT,FBX1,FBOUT,DFN,FBVEN,FBENDFLG,FBLERR"
^XMB(3.9,146051,2,303,0)="""RTN"",""FBNHPC"",32,0)"
^XMB(3.9,146051,2,304,0)=" K %,%DT,DIC,FBDD,FBERR,FBTOT,IFN,PGM,Q,VAL,VAR,Z,FBEDT,FBENDDT,FBHIFN,FBRIFN,FBTDT,FBTRDYS,FBZ,FB,I,PRCS,Y,PRC,PRCSCPAN,X,X1,^TMP($J,""FBNHPC"")"
^XMB(3.9,146051,2,305,0)="""RTN"",""FBNHPC"",33,0)"
^XMB(3.9,146051,2,306,0)=" K FBSTA,FBOBIEN,FBOBNO,PRC23,FBPOP,FBCNT,FBHIN,FBMM"
^XMB(3.9,146051,2,307,0)="""RTN"",""FBNHPC"",34,0)"
^XMB(3.9,146051,2,308,0)=" K ^XTMP(""FBPOST"") D CLOSE^FBAAUTL Q"
^XMB(3.9,146051,2,309,0)="""RTN"",""FBNHPC"",35,0)"
^XMB(3.9,146051,2,310,0)=" ;"
^XMB(3.9,146051,2,311,0)="""RTN"",""FBNHPC"",36,0)"
^XMB(3.9,146051,2,312,0)="WRT() ;determine if write to output"
^XMB(3.9,146051,2,313,0)="""RTN"",""FBNHPC"",37,0)"
^XMB(3.9,146051,2,314,0)=" ;return 1 if nothing to post"
^XMB(3.9,146051,2,315,0)="""RTN"",""FBNHPC"",38,0)"
^XMB(3.9,146051,2,316,0)=" Q $S('$G(FBTOT):1,'$G(FBTOTAL):1,1:0)"
^XMB(3.9,146051,2,317,0)="""RTN"",""FBNHPC"",39,0)"
^XMB(3.9,146051,2,318,0)=" ;"
^XMB(3.9,146051,2,319,0)="""RTN"",""FBNHPC"",40,0)"
^XMB(3.9,146051,2,320,0)="ERR I $G(FBSSNRF)="""" W !!,*7,""Unable to Post the following transaction because of the following:"",!,Y,!?7,FBNAME,?40,FBSSN I '$G(FBLERR) W ?60,""$""_$FN(FBDEFP,"","",2)"
^XMB(3.9,146051,2,321,0)="""RTN"",""FBNHPC"",41,0)"
^XMB(3.9,146051,2,322,0)=" I $G(FBSSNRF)=1 W !!,*7,""Unable to Post the following transaction because of the following:"",!,Y,!?7,FBNAME,?40,$$SSNL4^FBAAUTL(FBSSN) I '$G(FBLERR) W ?60,""$""_$FN(FBDEFP,"","",2)"
^XMB(3.9,146051,2,323,0)="""RTN"",""FBNHPC"",42,0)"
^XMB(3.9,146051,2,324,0)=" Q"
^XMB(3.9,146051,2,325,0)="""RTN"",""FBNHPC"",43,0)"
^XMB(3.9,146051,2,326,0)=" ;"
^XMB(3.9,146051,2,327,0)="""RTN"",""FBNHPC"",44,0)"
^XMB(3.9,146051,2,328,0)="L(FBDA,FBL) ;lock/unlock 7078"
^XMB(3.9,146051,2,329,0)="""RTN"",""FBNHPC"",45,0)"
^XMB(3.9,146051,2,330,0)=" ;INPUT:  FBDA = ien (fbifn) of 7078 file"
^XMB(3.9,146051,2,331,0)="""RTN"",""FBNHPC"",46,0)"
^XMB(3.9,146051,2,332,0)=" ;        FBL = lock code:  1 to lock, 2 to unlock"
^XMB(3.9,146051,2,333,0)="""RTN"",""FBNHPC"",47,0)"
^XMB(3.9,146051,2,334,0)=" ;OUTPUT:  no output variables; fb7078 entry will be locked or unlocked"
^XMB(3.9,146051,2,335,0)="""RTN"",""FBNHPC"",48,0)"
^XMB(3.9,146051,2,336,0)=" N FBLCTR S FBLCTR=0"
^XMB(3.9,146051,2,337,0)="""RTN"",""FBNHPC"",49,0)"
^XMB(3.9,146051,2,338,0)="L1 I $S('+$G(FBDA):1,'+$G(FBL):1,1:0) Q"
^XMB(3.9,146051,2,339,0)="""RTN"",""FBNHPC"",50,0)"
^XMB(3.9,146051,2,340,0)=" I FBL=1 L +^FB7078(FBDA):2 I '$T S FBLCTR=FBLCTR+1 G:FBLCTR<5 L1 S FBLERR=1 Q"
^XMB(3.9,146051,2,341,0)="""RTN"",""FBNHPC"",51,0)"
^XMB(3.9,146051,2,342,0)=" I FBL=2 K ^XTMP(""FBPOST"",FBDA) L -^FB7078(FBDA)"
^XMB(3.9,146051,2,343,0)="""RTN"",""FBNHPC"",52,0)"
^XMB(3.9,146051,2,344,0)=" Q"
^XMB(3.9,146051,2,345,0)="""VER"")"
