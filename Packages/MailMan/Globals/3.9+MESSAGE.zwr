^XMB(3.9,146098,2,2313,0)="""RTN"",""SDLT"",40,0)"
^XMB(3.9,146098,2,2314,0)=" S SDX1=$S($D(SDX):SDX,1:X) S:$D(SDS) S=SDS F B=3,4,5 I $P(S,""^"",B)]"""" S SDCL=$S(B=3:""LAB"",B=4:""XRAY"",1:""EKG""),SDX=$P(S,""^"",B) D FORM"
^XMB(3.9,146098,2,2315,0)="""RTN"",""SDLT"",41,0)"
^XMB(3.9,146098,2,2316,0)=" S (SDX,X)=SDX1 Q"
^XMB(3.9,146098,2,2317,0)="""RTN"",""SDLT"",42,0)"
^XMB(3.9,146098,2,2318,0)=" ; SD*5.3*622 - add more detail for appointment and format it"
^XMB(3.9,146098,2,2319,0)="""RTN"",""SDLT"",43,0)"
^XMB(3.9,146098,2,2320,0)="FORM S:$D(SDX) X=SDX S SDHX=X D DW^%DTC S DOW=X,X=SDHX X ^DD(""FUNC"",2,1) S SDT0=X,SDDAT=$P(""JAN^FEB^MAR^APR^MAY^JUN^JUL^AUG^SEP^OCT^NOV^DEC"",""^"",$E(SDHX,4,5))_"" ""_+$E(SDHX,6,7)_"", ""_(1700+$E(SDHX,1,3))"
^XMB(3.9,146098,2,2321,0)="""RTN"",""SDLT"",44,0)"
^XMB(3.9,146098,2,2322,0)=" ; Add blank line between appointments in letters - Done with patch SD*5.3*705"
^XMB(3.9,146098,2,2323,0)="""RTN"",""SDLT"",45,0)"
^XMB(3.9,146098,2,2324,0)=" I $$ADLIN,'$D(B) W !"
^XMB(3.9,146098,2,2325,0)="""RTN"",""SDLT"",46,0)"
^XMB(3.9,146098,2,2326,0)=" W:'$D(B) !?5,""Date/Time: "",?17,DOW,?$L(DOW)+19,$J(SDDAT,12)"
^XMB(3.9,146098,2,2327,0)="""RTN"",""SDLT"",47,0)"
^XMB(3.9,146098,2,2328,0)=" I '$D(B),$D(SDC) W ?22,$J(SDT0,9),"" "",$G(TIMEZONE),!?5,SDCL"
^XMB(3.9,146098,2,2329,0)="""RTN"",""SDLT"",48,0)"
^XMB(3.9,146098,2,2330,0)=" ; get default provider if defined for a given clinic, print it on the"
^XMB(3.9,146098,2,2331,0)="""RTN"",""SDLT"",49,0)"
^XMB(3.9,146098,2,2332,0)=" ; letter only if we have a YES on file, same for clinic location"
^XMB(3.9,146098,2,2333,0)="""RTN"",""SDLT"",50,0)"
^XMB(3.9,146098,2,2334,0)=" ; skip printing the provider label if the field is empty in file #44"
^XMB(3.9,146098,2,2335,0)="""RTN"",""SDLT"",51,0)"
^XMB(3.9,146098,2,2336,0)=" N J,SDLOC,SDPROV,SDPRNM,SDTEL,SDTELEXT"
^XMB(3.9,146098,2,2337,0)="""RTN"",""SDLT"",52,0)"
^XMB(3.9,146098,2,2338,0)=" S SDLOC=$P($G(^SC(+SDC,0)),""^"",11) ; physical location of the clinic"
^XMB(3.9,146098,2,2339,0)="""RTN"",""SDLT"",53,0)"
^XMB(3.9,146098,2,2340,0)=" S SDTEL=$G(^SC(+SDC,99))        ; telephone number of clinic"
^XMB(3.9,146098,2,2341,0)="""RTN"",""SDLT"",54,0)"
^XMB(3.9,146098,2,2342,0)=" S SDTELEXT="""" I SDTEL]"""",$G(^SC(+SDC,99.1))]"""" D"
^XMB(3.9,146098,2,2343,0)="""RTN"",""SDLT"",55,0)"
^XMB(3.9,146098,2,2344,0)=" .S SDTELEXT=^SC(+SDC,99.1)  ; telephone ext of clinic"
^XMB(3.9,146098,2,2345,0)="""RTN"",""SDLT"",56,0)"
^XMB(3.9,146098,2,2346,0)=" ; get default provider, if any"
^XMB(3.9,146098,2,2347,0)="""RTN"",""SDLT"",57,0)"
^XMB(3.9,146098,2,2348,0)=" F J=0:0 S J=$O(^SC(+SDC,""PR"",J)) Q:'J>0  I $P($G(^SC(+SDC,""PR"",J,0)),U,2)=1 S SDPROV=+$P(^SC(+SDC,""PR"",J,0),U,1)"
^XMB(3.9,146098,2,2349,0)="""RTN"",""SDLT"",58,0)"
^XMB(3.9,146098,2,2350,0)=" I $D(SDC),'$D(B),$P($G(^VA(407.5,SDLET,3)),U,2)=""Y"" D"
^XMB(3.9,146098,2,2351,0)="""RTN"",""SDLT"",59,0)"
^XMB(3.9,146098,2,2352,0)=" .W:SDLOC]"""" !?6,""Location:  ""_SDLOC"
^XMB(3.9,146098,2,2353,0)="""RTN"",""SDLT"",60,0)"
^XMB(3.9,146098,2,2354,0)=" I $D(SDC),'$D(B),SDTEL]"""" D"
^XMB(3.9,146098,2,2355,0)="""RTN"",""SDLT"",61,0)"
^XMB(3.9,146098,2,2356,0)=" .W !?5,""Telephone:  "",$P(SDTEL,U)"
^XMB(3.9,146098,2,2357,0)="""RTN"",""SDLT"",62,0)"
^XMB(3.9,146098,2,2358,0)=" .W:SDTELEXT]"""" ""   Telephone Ext.:  "",SDTELEXT"
^XMB(3.9,146098,2,2359,0)="""RTN"",""SDLT"",63,0)"
^XMB(3.9,146098,2,2360,0)=" I $D(SDPROV) D"
^XMB(3.9,146098,2,2361,0)="""RTN"",""SDLT"",64,0)"
^XMB(3.9,146098,2,2362,0)=" .I $D(SDC),SDPROV>0 S SDPRNM=$P(^VA(200,SDPROV,0),U,1)"
^XMB(3.9,146098,2,2363,0)="""RTN"",""SDLT"",65,0)"
^XMB(3.9,146098,2,2364,0)=" .I $D(SDC),'$D(B),$P($G(^VA(407.5,SDLET,3)),U,1)=""Y"" W:SDPRNM]"""" !?6,""Provider:  ""_$G(SDPRNM)"
^XMB(3.9,146098,2,2365,0)="""RTN"",""SDLT"",66,0)"
^XMB(3.9,146098,2,2366,0)=" ; call handler for LAB, XRAY, and EKG tests"
^XMB(3.9,146098,2,2367,0)="""RTN"",""SDLT"",67,0)"
^XMB(3.9,146098,2,2368,0)=" I $D(B) D TST"
^XMB(3.9,146098,2,2369,0)="""RTN"",""SDLT"",68,0)"
^XMB(3.9,146098,2,2370,0)=" I $D(SDLT)&($Y>(IOSL-8)) W @IOF"
^XMB(3.9,146098,2,2371,0)="""RTN"",""SDLT"",69,0)"
^XMB(3.9,146098,2,2372,0)=" ; SD*5.3*622 end changes"
^XMB(3.9,146098,2,2373,0)="""RTN"",""SDLT"",70,0)"
^XMB(3.9,146098,2,2374,0)=" Q"
^XMB(3.9,146098,2,2375,0)="""RTN"",""SDLT"",71,0)"
^XMB(3.9,146098,2,2376,0)="REST ;WRITE THE REMAINDER OF LETTER"
^XMB(3.9,146098,2,2377,0)="""RTN"",""SDLT"",72,0)"
^XMB(3.9,146098,2,2378,0)=" N Z5,I,X"
^XMB(3.9,146098,2,2379,0)="""RTN"",""SDLT"",73,0)"
^XMB(3.9,146098,2,2380,0)=" I SDLET W !?12 K ^UTILITY($J,""W""),DIWL,DIWR,DIWF S DIWL=1,DIWF=""C80WN"" F Z5=0:0 S Z5=$O(^VA(407.5,SDLET,2,Z5)) Q:Z5'>0  S X=^(Z5,0) D ^DIWP"
^XMB(3.9,146098,2,2381,0)="""RTN"",""SDLT"",74,0)"
^XMB(3.9,146098,2,2382,0)=" D ^DIWW K ^UTILITY($J,""W"") Q:'SDFORM"
^XMB(3.9,146098,2,2383,0)="""RTN"",""SDLT"",75,0)"
^XMB(3.9,146098,2,2384,0)=" F I=$Y:1:IOSL-12 W !"
^XMB(3.9,146098,2,2385,0)="""RTN"",""SDLT"",76,0)"
^XMB(3.9,146098,2,2386,0)=" D ADDR Q"
^XMB(3.9,146098,2,2387,0)="""RTN"",""SDLT"",77,0)"
^XMB(3.9,146098,2,2388,0)="ADDR K VAHOW S DFN=+A W !?12,$$FML^DGNFUNC(DFN)"
^XMB(3.9,146098,2,2389,0)="""RTN"",""SDLT"",78,0)"
^XMB(3.9,146098,2,2390,0)=" I $D(^DG(43,1,""BT"")),'$P(^(""BT""),""^"",3) S VAPA(""P"")="""""
^XMB(3.9,146098,2,2391,0)="""RTN"",""SDLT"",79,0)"
^XMB(3.9,146098,2,2392,0)=" S X1=DT,X2=5 D C^%DTC I '$D(VAPA(""P"")) S (VATEST(""ADD"",9),VATEST(""ADD"",10))=X"
^XMB(3.9,146098,2,2393,0)="""RTN"",""SDLT"",80,0)"
^XMB(3.9,146098,2,2394,0)=" D ADD^VADPT D"
^XMB(3.9,146098,2,2395,0)="""RTN"",""SDLT"",81,0)"
^XMB(3.9,146098,2,2396,0)=" .;CHANGE STATE TO ABBR."
^XMB(3.9,146098,2,2397,0)="""RTN"",""SDLT"",82,0)"
^XMB(3.9,146098,2,2398,0)=" .N SDIENS,X"
^XMB(3.9,146098,2,2399,0)="""RTN"",""SDLT"",83,0)"
^XMB(3.9,146098,2,2400,0)=" .I $D(VAPA(5)) S SDIENS=+VAPA(5)_"","",X=$$GET1^DIQ(5,SDIENS,1),$P(VAPA(5),U,2)=X"
^XMB(3.9,146098,2,2401,0)="""RTN"",""SDLT"",84,0)"
^XMB(3.9,146098,2,2402,0)=" .I $D(VAPA(17)) S SDIENS=+VAPA(17)_"","",X=$$GET1^DIQ(5,SDIENS,1),$P(VAPA(17),U,2)=X"
^XMB(3.9,146098,2,2403,0)="""RTN"",""SDLT"",85,0)"
^XMB(3.9,146098,2,2404,0)=" .K SDIENS Q"
^XMB(3.9,146098,2,2405,0)="""RTN"",""SDLT"",86,0)"
^XMB(3.9,146098,2,2406,0)=" N SDCCACT1,SDCCACT2,LL"
^XMB(3.9,146098,2,2407,0)="""RTN"",""SDLT"",87,0)"
