^XMB(3.9,146082,2,417,0)="""RTN"",""XPDIST"",90,0)"
^XMB(3.9,146082,2,418,0)=" S XMDUZ=$S($P(XPD0,U,11):+$P(XPD0,U,11),1:.5),XMTEXT=""XPDTEXT("",XMSUB=$P(XPD0,U)_"" INSTALLATION"""
^XMB(3.9,146082,2,419,0)="""RTN"",""XPDIST"",91,0)"
^XMB(3.9,146082,2,420,0)=" D ^XMD"
^XMB(3.9,146082,2,421,0)="""RTN"",""XPDIST"",92,0)"
^XMB(3.9,146082,2,422,0)=" Q ""#""_$G(XMZ)"
^XMB(3.9,146082,2,423,0)="""RTN"",""XPDIST"",93,0)"
^XMB(3.9,146082,2,424,0)=" ;"
^XMB(3.9,146082,2,425,0)="""RTN"",""XPDIST"",94,0)"
^XMB(3.9,146082,2,426,0)="CHKS(XPDPH,XPDTEXT) ;Get Checksum from Forum for patch XPDPH, XPDTEXT is passed by reference"
^XMB(3.9,146082,2,427,0)="""RTN"",""XPDIST"",95,0)"
^XMB(3.9,146082,2,428,0)=" ;returns XPDTEXT(routine name)= before checksum"
^XMB(3.9,146082,2,429,0)="""RTN"",""XPDIST"",96,0)"
^XMB(3.9,146082,2,430,0)=" ;need to create parameter to store url - future"
^XMB(3.9,146082,2,431,0)="""RTN"",""XPDIST"",97,0)"
^XMB(3.9,146082,2,432,0)=" Q"
^XMB(3.9,146082,2,433,0)="""RTN"",""XPDIST"",98,0)"
^XMB(3.9,146082,2,434,0)=" K ^TMP($J,""XPDTHC"")"
^XMB(3.9,146082,2,435,0)="""RTN"",""XPDIST"",99,0)"
^XMB(3.9,146082,2,436,0)=" Q:$G(XPDPH)="""""
^XMB(3.9,146082,2,437,0)="""RTN"",""XPDIST"",100,0)"
^XMB(3.9,146082,2,438,0)=" N XPDCHK,XPDHDR,XPDURL,I,X,Y"
^XMB(3.9,146082,2,439,0)="""RTN"",""XPDIST"",101,0)"
^XMB(3.9,146082,2,440,0)=" S XPDURL=""http://127.0.0.1:82/cgi/PCHCSUM?PCH=""_XPDPH,XPDCHK=0"
^XMB(3.9,146082,2,441,0)="""RTN"",""XPDIST"",102,0)"
^XMB(3.9,146082,2,442,0)=" S X=$$GETURL^XTHC10(XPDURL,,$NA(^TMP($J,""XPDTHC"")),.XPDHDR)"
^XMB(3.9,146082,2,443,0)="""RTN"",""XPDIST"",103,0)"
^XMB(3.9,146082,2,444,0)=" I X>0 D"
^XMB(3.9,146082,2,445,0)="""RTN"",""XPDIST"",104,0)"
^XMB(3.9,146082,2,446,0)=" . S I="""""
^XMB(3.9,146082,2,447,0)="""RTN"",""XPDIST"",105,0)"
^XMB(3.9,146082,2,448,0)=" . F  S I=$O(^TMP($J,""XPDTHC"",I)) Q:I=""""  S X=$G(^(I)) D:$E(X,1,4)=""<li>"""
^XMB(3.9,146082,2,449,0)="""RTN"",""XPDIST"",106,0)"
^XMB(3.9,146082,2,450,0)=" .. S Y=$P($P(X,""</li>""),U,4),X=$P($P(X,""<li>"",2),U),XPDTEXT(X)=Y,XPDCHK=XPDCHK+1"
^XMB(3.9,146082,2,451,0)="""RTN"",""XPDIST"",107,0)"
^XMB(3.9,146082,2,452,0)=" . Q"
^XMB(3.9,146082,2,453,0)="""RTN"",""XPDIST"",108,0)"
^XMB(3.9,146082,2,454,0)=" S XPDTEXT=XPDCHK"
^XMB(3.9,146082,2,455,0)="""RTN"",""XPDIST"",109,0)"
^XMB(3.9,146082,2,456,0)=" K ^TMP($J,""XPDTHC"")"
^XMB(3.9,146082,2,457,0)="""RTN"",""XPDIST"",110,0)"
^XMB(3.9,146082,2,458,0)=" Q"
^XMB(3.9,146082,2,459,0)="""VER"")"
