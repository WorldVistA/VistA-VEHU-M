^XMB(3.9,146055,2,320,0)="CHANGE(RXREC,SUB) ; File update for Suspense Date change"
^XMB(3.9,146055,2,321,0)="""RTN"",""PSOSUCH1"",40,0)"
^XMB(3.9,146055,2,322,0)=" I $P($G(^PS(52.5,SFN,0)),""^"",5) S PSOSUSPA=1,HDSFN=SFN S SRXPAR=+$P(^(0),""^"",5),OLD=+$P($G(^PSRX(RXREC,""P"",SRXPAR,0)),""^""),DA(1)=RXREC,DA=SRXPAR,DIE=""^PSRX(""_DA(1)_"",""""P"""","",DR="".01////""_INDT D ^DIE G FIN"
