^XMB(3.9,146020,2,1120,0)=" I MPIN=""SOURCE"",'$G(MPIIGNID) S MPIVAR="",""""IDS"""",""_MPIIDS_"",""""SOURCE"""")"" Q"
^XMB(3.9,146020,2,1121,0)="""RTN"",""MPIFXMLP"",225,0)"
^XMB(3.9,146020,2,1122,0)=" ;**74,Story 1258907 (mko): Store the ISSUER and STATUS in the ""IDS"" array"
