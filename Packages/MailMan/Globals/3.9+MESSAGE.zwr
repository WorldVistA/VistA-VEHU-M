^XMB(3.9,146047,2,1012,0)=" S DIE=""^IBA(355.32,"",DIE(""NO^"")=""BACKOUTOK"""
^XMB(3.9,146047,2,1013,0)="""RTN"",""IBCNBCD2"",318,0)"
