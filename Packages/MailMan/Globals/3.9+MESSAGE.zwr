^XMB(3.9,146009,2,537,0)="""RTN"",""XUIAMNPB"",136,0)"
^XMB(3.9,146009,2,538,0)=" L -^XTV(8933.1,""XUS IAM NPFM BATCH UPDATE"")"
^XMB(3.9,146009,2,539,0)="""RTN"",""XUIAMNPB"",137,0)"
^XMB(3.9,146009,2,540,0)=" Q"
^XMB(3.9,146009,2,541,0)="""RTN"",""XUIAMNPB"",138,0)"
^XMB(3.9,146009,2,542,0)=" ;"
^XMB(3.9,146009,2,543,0)="""RTN"",""XUIAMNPB"",139,0)"
^XMB(3.9,146009,2,544,0)="ESC(NAME) ;"
^XMB(3.9,146009,2,545,0)="""RTN"",""XUIAMNPB"",140,0)"
^XMB(3.9,146009,2,546,0)=" ;escape & and < to be handled correctly in the spml"
^XMB(3.9,146009,2,547,0)="""RTN"",""XUIAMNPB"",141,0)"
^XMB(3.9,146009,2,548,0)=" I NAME[""&"" S NAME=$$STRGREP(NAME,""&"",""\\amp;"")"
^XMB(3.9,146009,2,549,0)="""RTN"",""XUIAMNPB"",142,0)"
^XMB(3.9,146009,2,550,0)=" I NAME[""<"" S NAME=$$STRGREP(NAME,""<"",""&lt;"")"
^XMB(3.9,146009,2,551,0)="""RTN"",""XUIAMNPB"",143,0)"
^XMB(3.9,146009,2,552,0)=" I NAME[""\\amp;"" S NAME=$$STRGREP(NAME,""\\amp;"",""&amp;"")"
^XMB(3.9,146009,2,553,0)="""RTN"",""XUIAMNPB"",144,0)"
^XMB(3.9,146009,2,554,0)=" Q NAME"
^XMB(3.9,146009,2,555,0)="""RTN"",""XUIAMNPB"",145,0)"
^XMB(3.9,146009,2,556,0)=" ;"
^XMB(3.9,146009,2,557,0)="""RTN"",""XUIAMNPB"",146,0)"
^XMB(3.9,146009,2,558,0)="STRGREP(T,F,W) ;api to replace to string with from string"
^XMB(3.9,146009,2,559,0)="""RTN"",""XUIAMNPB"",147,0)"
^XMB(3.9,146009,2,560,0)=" N I F  Q:T'[F  S T=$P(T,F)_W_$P(T,F,2,999)"
^XMB(3.9,146009,2,561,0)="""RTN"",""XUIAMNPB"",148,0)"
^XMB(3.9,146009,2,562,0)=" Q T"
^XMB(3.9,146009,2,563,0)="""RTN"",""XUIAMNPB"",149,0)"
^XMB(3.9,146009,2,564,0)=" ;"
^XMB(3.9,146009,2,565,0)="""RTN"",""XUIAMNPB"",150,0)"
^XMB(3.9,146009,2,566,0)="UPDNP(XUDUZ,XURET,XUIAM) ;update 205 node and related fields of new person file"
^XMB(3.9,146009,2,567,0)="""RTN"",""XUIAMNPB"",151,0)"
^XMB(3.9,146009,2,568,0)=" ;deletes and updating of other fields will be a future enhancement"
^XMB(3.9,146009,2,569,0)="""RTN"",""XUIAMNPB"",152,0)"
^XMB(3.9,146009,2,570,0)=" ;make sure difference isn't just case by comparing lowercase to lowercase"
^XMB(3.9,146009,2,571,0)="""RTN"",""XUIAMNPB"",153,0)"
^XMB(3.9,146009,2,572,0)=" I '$G(XUDUZ) Q"
^XMB(3.9,146009,2,573,0)="""RTN"",""XUIAMNPB"",154,0)"
^XMB(3.9,146009,2,574,0)=" N XUFDA"
^XMB(3.9,146009,2,575,0)="""RTN"",""XUIAMNPB"",155,0)"
^XMB(3.9,146009,2,576,0)=" ;**799,VAMPI-22625 (mko): Quit if the SECID returned matches the SECID of another record"
^XMB(3.9,146009,2,577,0)="""RTN"",""XUIAMNPB"",156,0)"
^XMB(3.9,146009,2,578,0)=" I $G(XURET(""secId""))'="""" Q:$$SECIDFND(XURET(""secId""),XUDUZ)  I ($$LOW^XLFSTR(XURET(""secId""))'=$$LOW^XLFSTR(XUIAM(""secId""))) S XUFDA(200,XUDUZ_"","",205.1)=XURET(""secId"")"
^XMB(3.9,146009,2,579,0)="""RTN"",""XUIAMNPB"",157,0)"
^XMB(3.9,146009,2,580,0)=" I $G(XURET(""subjectOrg""))'="""",($$LOW^XLFSTR(XURET(""subjectOrg""))'=$$LOW^XLFSTR(XUIAM(""subjectOrg""))) S XUFDA(200,XUDUZ_"","",205.2)=XURET(""subjectOrg"")"
^XMB(3.9,146009,2,581,0)="""RTN"",""XUIAMNPB"",158,0)"
^XMB(3.9,146009,2,582,0)=" I $G(XURET(""orgId""))'="""",($$LOW^XLFSTR(XURET(""orgId""))'=$$LOW^XLFSTR(XUIAM(""orgId""))) S XUFDA(200,XUDUZ_"","",205.3)=XURET(""orgId"")"
^XMB(3.9,146009,2,583,0)="""RTN"",""XUIAMNPB"",159,0)"
^XMB(3.9,146009,2,584,0)=" ;I $G(XURET(""uid""))'="""",(XURET(""uid"")'=XUIAM(""uid"")) S XUFDA(200,XUDUZ_"","",205.4)=XURET(""uid"") ;psim is not currently returning uid"
^XMB(3.9,146009,2,585,0)="""RTN"",""XUIAMNPB"",160,0)"
^XMB(3.9,146009,2,586,0)=" I $G(XURET(""secId""))'="""",(XURET(""secId"")'=XUIAM(""uid"")) S XUFDA(200,XUDUZ_"","",205.4)=XURET(""secId"") ;per danny, uid should be converted to secid"
^XMB(3.9,146009,2,587,0)="""RTN"",""XUIAMNPB"",161,0)"
^XMB(3.9,146009,2,588,0)=" I $G(XURET(""adUPN""))'="""",($$LOW^XLFSTR(XURET(""adUPN""))'=$$LOW^XLFSTR(XUIAM(""adUPN""))) S XUFDA(200,XUDUZ_"","",205.5)=XURET(""adUPN"")"
