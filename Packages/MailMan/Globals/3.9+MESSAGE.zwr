^XMB(3.9,146047,2,2351,0)="""RTN"",""IBCNERTC"",185,0)"
^XMB(3.9,146047,2,2352,0)=" . S IBTDT=$$NOW^XLFDT  ; set the file date/time for each insurance company"
^XMB(3.9,146047,2,2353,0)="""RTN"",""IBCNERTC"",186,0)"
^XMB(3.9,146047,2,2354,0)=" . ;"
^XMB(3.9,146047,2,2355,0)="""RTN"",""IBCNERTC"",187,0)"
^XMB(3.9,146047,2,2356,0)=" . ; now we have the data in IBRETURN"
^XMB(3.9,146047,2,2357,0)="""RTN"",""IBCNERTC"",188,0)"
^XMB(3.9,146047,2,2358,0)=" . ; structure is ^TMP(""IBCNERTCA"",$J,Ins IEN,Plan IEN, PT DFN, PT (2.312) insurance IEN)"
^XMB(3.9,146047,2,2359,0)="""RTN"",""IBCNERTC"",189,0)"
^XMB(3.9,146047,2,2360,0)=" . ; IBINIEN is already set"
^XMB(3.9,146047,2,2361,0)="""RTN"",""IBCNERTC"",190,0)"
^XMB(3.9,146047,2,2362,0)=" . K IBA"
^XMB(3.9,146047,2,2363,0)="""RTN"",""IBCNERTC"",191,0)"
^XMB(3.9,146047,2,2364,0)=" . ; IBRETURN=""^TMP(""""IBCNERTCA"""",""_$J_"")"""
^XMB(3.9,146047,2,2365,0)="""RTN"",""IBCNERTC"",192,0)"
^XMB(3.9,146047,2,2366,0)=" . S IBPLAN=0 F  S IBPLAN=$O(^TMP(""IBCNERTCA"",$J,IBINIEN,IBPLAN)) Q:'IBPLAN  D"
^XMB(3.9,146047,2,2367,0)="""RTN"",""IBCNERTC"",193,0)"
^XMB(3.9,146047,2,2368,0)=" .. S IBPTDFN=0 F  S IBPTDFN=$O(^TMP(""IBCNERTCA"",$J,IBINIEN,IBPLAN,IBPTDFN)) Q:'IBPTDFN  D"
^XMB(3.9,146047,2,2369,0)="""RTN"",""IBCNERTC"",194,0)"
^XMB(3.9,146047,2,2370,0)=" ... S IBPTINIE=0 F  S IBPTINIE=$O(^TMP(""IBCNERTCA"",$J,IBINIEN,IBPLAN,IBPTDFN,IBPTINIE)) Q:'IBPTINIE  D"
^XMB(3.9,146047,2,2371,0)="""RTN"",""IBCNERTC"",195,0)"
^XMB(3.9,146047,2,2372,0)=" ... . ;"
^XMB(3.9,146047,2,2373,0)="""RTN"",""IBCNERTC"",196,0)"
^XMB(3.9,146047,2,2374,0)=" ... . S IBA=$G(^TMP(""IBCNERTCA"",$J,IBINIEN,IBPLAN,IBPTDFN,IBPTINIE)),IBPTRINS=IBPTINIE_"",""_IBPTDFN_"","""
^XMB(3.9,146047,2,2375,0)="""RTN"",""IBCNERTC"",197,0)"
^XMB(3.9,146047,2,2376,0)=" ... . ; verify"
^XMB(3.9,146047,2,2377,0)="""RTN"",""IBCNERTC"",198,0)"
^XMB(3.9,146047,2,2378,0)=" ... . S IBD=$$GET1^DIQ(2.312,IBPTRINS,""1.03"",""I"")  ; last verified date"
^XMB(3.9,146047,2,2379,0)="""RTN"",""IBCNERTC"",199,0)"
^XMB(3.9,146047,2,2380,0)=" ... . ;"
^XMB(3.9,146047,2,2381,0)="""RTN"",""IBCNERTC"",200,0)"
^XMB(3.9,146047,2,2382,0)=" ... . I +IBFRSHDY&($P(IBD,""."",1)'=""""&($$FMDIFF^XLFDT(DT,$P(IBD,""."",1),1)<IBFRSHDY)) Q  ; the verify dt difference is less than fresh days"
^XMB(3.9,146047,2,2383,0)="""RTN"",""IBCNERTC"",201,0)"
^XMB(3.9,146047,2,2384,0)=" ... . ;"
^XMB(3.9,146047,2,2385,0)="""RTN"",""IBCNERTC"",202,0)"
^XMB(3.9,146047,2,2386,0)=" ... . K FDA S IBTDT=$$NOW^XLFDT"
^XMB(3.9,146047,2,2387,0)="""RTN"",""IBCNERTC"",203,0)"
^XMB(3.9,146047,2,2388,0)=" ... . S FDA(2.312,IBPTRINS,1.03)=IBTDT"
^XMB(3.9,146047,2,2389,0)="""RTN"",""IBCNERTC"",204,0)"
^XMB(3.9,146047,2,2390,0)=" ... . S FDA(2.312,IBPTRINS,1.04)=IBBINSEL  ; proxy user IB,AUTOINS FILEUPDATE"
^XMB(3.9,146047,2,2391,0)="""RTN"",""IBCNERTC"",205,0)"
^XMB(3.9,146047,2,2392,0)=" ... . S FDA(2.312,IBPTRINS,1.05)=IBTDT"
^XMB(3.9,146047,2,2393,0)="""RTN"",""IBCNERTC"",206,0)"
^XMB(3.9,146047,2,2394,0)=" ... . S FDA(2.312,IBPTRINS,1.06)=IBBINSEL  ; proxy user IB,AUTOINS FILEUPDATE"
^XMB(3.9,146047,2,2395,0)="""RTN"",""IBCNERTC"",207,0)"
^XMB(3.9,146047,2,2396,0)=" ... . D FILE^DIE("""",""FDA"")"
^XMB(3.9,146047,2,2397,0)="""RTN"",""IBCNERTC"",208,0)"
^XMB(3.9,146047,2,2398,0)=" ... . K FDA"
^XMB(3.9,146047,2,2399,0)="""RTN"",""IBCNERTC"",209,0)"
^XMB(3.9,146047,2,2400,0)=" ;"
^XMB(3.9,146047,2,2401,0)="""RTN"",""IBCNERTC"",210,0)"
^XMB(3.9,146047,2,2402,0)=" Q"
^XMB(3.9,146047,2,2403,0)="""RTN"",""IBCNERTC"",211,0)"
^XMB(3.9,146047,2,2404,0)=" ;"
^XMB(3.9,146047,2,2405,0)="""RTN"",""IBCNEUT2"")"
^XMB(3.9,146047,2,2406,0)="0^7^B116626139"
^XMB(3.9,146047,2,2407,0)="""RTN"",""IBCNEUT2"",1,0)"
^XMB(3.9,146047,2,2408,0)="IBCNEUT2 ;DAOU/DAC - eIV MISC. UTILITIES ;06-JUN-2002"
^XMB(3.9,146047,2,2409,0)="""RTN"",""IBCNEUT2"",2,0)"
^XMB(3.9,146047,2,2410,0)=" ;;2.0;INTEGRATED BILLING;**184,416,435,713,737,806,822**;21-MAR-94;Build 0"
^XMB(3.9,146047,2,2411,0)="""RTN"",""IBCNEUT2"",3,0)"
^XMB(3.9,146047,2,2412,0)=" ;;Per VA Directive 6402, this routine should not be modified."
^XMB(3.9,146047,2,2413,0)="""RTN"",""IBCNEUT2"",4,0)"
^XMB(3.9,146047,2,2414,0)=" ;"
^XMB(3.9,146047,2,2415,0)="""RTN"",""IBCNEUT2"",5,0)"
^XMB(3.9,146047,2,2416,0)=" ; Reference to ^XLFDT  in ICR #10103"
^XMB(3.9,146047,2,2417,0)="""RTN"",""IBCNEUT2"",6,0)"
^XMB(3.9,146047,2,2418,0)=" ;"
^XMB(3.9,146047,2,2419,0)="""RTN"",""IBCNEUT2"",7,0)"
^XMB(3.9,146047,2,2420,0)=" ; Can't be called from the top"
^XMB(3.9,146047,2,2421,0)="""RTN"",""IBCNEUT2"",8,0)"
^XMB(3.9,146047,2,2422,0)=" Q"
^XMB(3.9,146047,2,2423,0)="""RTN"",""IBCNEUT2"",9,0)"
^XMB(3.9,146047,2,2424,0)=" ;"
^XMB(3.9,146047,2,2425,0)="""RTN"",""IBCNEUT2"",10,0)"
^XMB(3.9,146047,2,2426,0)="SAVETQ(IEN,TDT) ;  Update service date in TQ record"
^XMB(3.9,146047,2,2427,0)="""RTN"",""IBCNEUT2"",11,0)"
^XMB(3.9,146047,2,2428,0)=" ;"
^XMB(3.9,146047,2,2429,0)="""RTN"",""IBCNEUT2"",12,0)"
^XMB(3.9,146047,2,2430,0)=" N DIE,DA,DR,D,D0,DI,DIC,DQ,X"
^XMB(3.9,146047,2,2431,0)="""RTN"",""IBCNEUT2"",13,0)"
^XMB(3.9,146047,2,2432,0)=" S DIE=""^IBCN(365.1,"",DA=IEN,DR="".12////""_TDT"
^XMB(3.9,146047,2,2433,0)="""RTN"",""IBCNEUT2"",14,0)"
^XMB(3.9,146047,2,2434,0)=" D ^DIE"
^XMB(3.9,146047,2,2435,0)="""RTN"",""IBCNEUT2"",15,0)"
^XMB(3.9,146047,2,2436,0)=" Q"
^XMB(3.9,146047,2,2437,0)="""RTN"",""IBCNEUT2"",16,0)"
^XMB(3.9,146047,2,2438,0)=" ;"
^XMB(3.9,146047,2,2439,0)="""RTN"",""IBCNEUT2"",17,0)"
^XMB(3.9,146047,2,2440,0)=" ;"
^XMB(3.9,146047,2,2441,0)="""RTN"",""IBCNEUT2"",18,0)"
^XMB(3.9,146047,2,2442,0)="SST(IEN,STAT) ;  Set the Transmission Queue Status"
^XMB(3.9,146047,2,2443,0)="""RTN"",""IBCNEUT2"",19,0)"
^XMB(3.9,146047,2,2444,0)=" ;  Input parameters"
^XMB(3.9,146047,2,2445,0)="""RTN"",""IBCNEUT2"",20,0)"
^XMB(3.9,146047,2,2446,0)=" ;    IEN = Internal entry number for the record"
^XMB(3.9,146047,2,2447,0)="""RTN"",""IBCNEUT2"",21,0)"
^XMB(3.9,146047,2,2448,0)=" ;    STAT= Status IEN"
^XMB(3.9,146047,2,2449,0)="""RTN"",""IBCNEUT2"",22,0)"
^XMB(3.9,146047,2,2450,0)=" ;"
^XMB(3.9,146047,2,2451,0)="""RTN"",""IBCNEUT2"",23,0)"
^XMB(3.9,146047,2,2452,0)=" NEW DIE,DA,DR,D,D0,DI,DIC,DQ,X"
^XMB(3.9,146047,2,2453,0)="""RTN"",""IBCNEUT2"",24,0)"
^XMB(3.9,146047,2,2454,0)=" ;"
^XMB(3.9,146047,2,2455,0)="""RTN"",""IBCNEUT2"",25,0)"
^XMB(3.9,146047,2,2456,0)=" I IEN="""" Q"
^XMB(3.9,146047,2,2457,0)="""RTN"",""IBCNEUT2"",26,0)"
^XMB(3.9,146047,2,2458,0)=" ;"
^XMB(3.9,146047,2,2459,0)="""RTN"",""IBCNEUT2"",27,0)"
^XMB(3.9,146047,2,2460,0)=" S DIE=""^IBCN(365.1,"",DA=IEN,DR="".04////^S X=STAT;.15////^S X=$$NOW^XLFDT()"""
^XMB(3.9,146047,2,2461,0)="""RTN"",""IBCNEUT2"",28,0)"
^XMB(3.9,146047,2,2462,0)=" D ^DIE"
^XMB(3.9,146047,2,2463,0)="""RTN"",""IBCNEUT2"",29,0)"
^XMB(3.9,146047,2,2464,0)=" Q"
^XMB(3.9,146047,2,2465,0)="""RTN"",""IBCNEUT2"",30,0)"
^XMB(3.9,146047,2,2466,0)=" ;"
^XMB(3.9,146047,2,2467,0)="""RTN"",""IBCNEUT2"",31,0)"
^XMB(3.9,146047,2,2468,0)="RSP(IEN,STAT) ;  Set the Response File Status"
^XMB(3.9,146047,2,2469,0)="""RTN"",""IBCNEUT2"",32,0)"
^XMB(3.9,146047,2,2470,0)=" ;  Input parameters"
^XMB(3.9,146047,2,2471,0)="""RTN"",""IBCNEUT2"",33,0)"
^XMB(3.9,146047,2,2472,0)=" ;    IEN = Internal entry number for the record"
^XMB(3.9,146047,2,2473,0)="""RTN"",""IBCNEUT2"",34,0)"
^XMB(3.9,146047,2,2474,0)=" ;    STAT= Status IEN"
^XMB(3.9,146047,2,2475,0)="""RTN"",""IBCNEUT2"",35,0)"
^XMB(3.9,146047,2,2476,0)=" ;"
^XMB(3.9,146047,2,2477,0)="""RTN"",""IBCNEUT2"",36,0)"
^XMB(3.9,146047,2,2478,0)=" NEW DIE,DA,DR,D,D0,DI,DIC,DQ,X"
^XMB(3.9,146047,2,2479,0)="""RTN"",""IBCNEUT2"",37,0)"
^XMB(3.9,146047,2,2480,0)=" S DIE=""^IBCN(365,"",DA=IEN,DR="".06////^S X=STAT"""
^XMB(3.9,146047,2,2481,0)="""RTN"",""IBCNEUT2"",38,0)"
^XMB(3.9,146047,2,2482,0)=" D ^DIE"
^XMB(3.9,146047,2,2483,0)="""RTN"",""IBCNEUT2"",39,0)"
^XMB(3.9,146047,2,2484,0)=" Q"
^XMB(3.9,146047,2,2485,0)="""RTN"",""IBCNEUT2"",40,0)"
^XMB(3.9,146047,2,2486,0)=" ;"
^XMB(3.9,146047,2,2487,0)="""RTN"",""IBCNEUT2"",41,0)"
^XMB(3.9,146047,2,2488,0)="BUFF(BUFF,BNG) ;  Set error symbol into Buffer File"
^XMB(3.9,146047,2,2489,0)="""RTN"",""IBCNEUT2"",42,0)"
^XMB(3.9,146047,2,2490,0)=" ;  Input Parameter"
^XMB(3.9,146047,2,2491,0)="""RTN"",""IBCNEUT2"",43,0)"
^XMB(3.9,146047,2,2492,0)=" ;    BUFF = Buffer internal entry number"
^XMB(3.9,146047,2,2493,0)="""RTN"",""IBCNEUT2"",44,0)"
^XMB(3.9,146047,2,2494,0)=" ;    BNG = Buffer Symbol IEN"
^XMB(3.9,146047,2,2495,0)="""RTN"",""IBCNEUT2"",45,0)"
^XMB(3.9,146047,2,2496,0)=" I 'BUFF!'BNG Q"
^XMB(3.9,146047,2,2497,0)="""RTN"",""IBCNEUT2"",46,0)"
^XMB(3.9,146047,2,2498,0)=" ;IB*822/CKB - no longer valid -I +$P($G(^IBA(355.33,BUFF,0)),U,17) Q    ; .12 field not for ePharmacy IB*2*435"
^XMB(3.9,146047,2,2499,0)="""RTN"",""IBCNEUT2"",47,0)"
^XMB(3.9,146047,2,2500,0)=" NEW DIE,DA,DR,D,D0,DI,DIC,DQ,X,DISYS"
^XMB(3.9,146047,2,2501,0)="""RTN"",""IBCNEUT2"",48,0)"
^XMB(3.9,146047,2,2502,0)=" S DIE=""^IBA(355.33,"",DA=BUFF,DR="".12////^S X=BNG"""
^XMB(3.9,146047,2,2503,0)="""RTN"",""IBCNEUT2"",49,0)"
^XMB(3.9,146047,2,2504,0)=" D ^DIE"
^XMB(3.9,146047,2,2505,0)="""RTN"",""IBCNEUT2"",50,0)"
^XMB(3.9,146047,2,2506,0)=" Q"
^XMB(3.9,146047,2,2507,0)="""RTN"",""IBCNEUT2"",51,0)"
^XMB(3.9,146047,2,2508,0)=" ;"
^XMB(3.9,146047,2,2509,0)="""RTN"",""IBCNEUT2"",52,0)"
^XMB(3.9,146047,2,2510,0)="BADMSG(EXT,QUERY) ; Checks to see if the msg is allowed"
^XMB(3.9,146047,2,2511,0)="""RTN"",""IBCNEUT2"",53,0)"
^XMB(3.9,146047,2,2512,0)=" ; IB*713 Introduced this tag, checks for foreign characters as defined"
^XMB(3.9,146047,2,2513,0)="""RTN"",""IBCNEUT2"",54,0)"
^XMB(3.9,146047,2,2514,0)=" ;        in FOREIGN^IBCNINSU. If foreign characters are encountered, some "
^XMB(3.9,146047,2,2515,0)="""RTN"",""IBCNEUT2"",55,0)"
^XMB(3.9,146047,2,2516,0)=" ;        times the msg can't be created/sent via HL7. Other times, if you"
^XMB(3.9,146047,2,2517,0)="""RTN"",""IBCNEUT2"",56,0)"
^XMB(3.9,146047,2,2518,0)=" ;        clear out the field with the foreign character you can still send"
^XMB(3.9,146047,2,2519,0)="""RTN"",""IBCNEUT2"",57,0)"
^XMB(3.9,146047,2,2520,0)=" ;        the message.  (Watch for the STOP variable.)"
^XMB(3.9,146047,2,2521,0)="""RTN"",""IBCNEUT2"",58,0)"
^XMB(3.9,146047,2,2522,0)=" ;        This could be expanded in the future to check other scenarios that"
^XMB(3.9,146047,2,2523,0)="""RTN"",""IBCNEUT2"",59,0)"
^XMB(3.9,146047,2,2524,0)=" ;        should stop the transmissions."
^XMB(3.9,146047,2,2525,0)="""RTN"",""IBCNEUT2"",60,0)"
^XMB(3.9,146047,2,2526,0)=" ;"
^XMB(3.9,146047,2,2527,0)="""RTN"",""IBCNEUT2"",61,0)"
^XMB(3.9,146047,2,2528,0)=" ;INPUT:"
^XMB(3.9,146047,2,2529,0)="""RTN"",""IBCNEUT2"",62,0)"
^XMB(3.9,146047,2,2530,0)=" ;  EXT = WHICH EXTRACT (#365.1,.1)"
^XMB(3.9,146047,2,2531,0)="""RTN"",""IBCNEUT2"",63,0)"
^XMB(3.9,146047,2,2532,0)=" ;  QUERY = QUERY FLAG(#365.1,.11)"
^XMB(3.9,146047,2,2533,0)="""RTN"",""IBCNEUT2"",64,0)"
^XMB(3.9,146047,2,2534,0)=" ;  PID, IN1, HLFS, HLECH - existing global variables"
^XMB(3.9,146047,2,2535,0)="""RTN"",""IBCNEUT2"",65,0)"
^XMB(3.9,146047,2,2536,0)=" ;  GT1 global variable that may or may not exist"
^XMB(3.9,146047,2,2537,0)="""RTN"",""IBCNEUT2"",66,0)"
^XMB(3.9,146047,2,2538,0)=" ;"
^XMB(3.9,146047,2,2539,0)="""RTN"",""IBCNEUT2"",67,0)"
^XMB(3.9,146047,2,2540,0)=" ;OUTPUT: 0 - Continue with creating and sending HL7 msg"
^XMB(3.9,146047,2,2541,0)="""RTN"",""IBCNEUT2"",68,0)"
^XMB(3.9,146047,2,2542,0)=" ;        1 - Do not send this TQ entry out as a HL7 msg"
^XMB(3.9,146047,2,2543,0)="""RTN"",""IBCNEUT2"",69,0)"
^XMB(3.9,146047,2,2544,0)=" ;            * NOTE: If Abort, this function sets the"
^XMB(3.9,146047,2,2545,0)="""RTN"",""IBCNEUT2"",70,0)"
^XMB(3.9,146047,2,2546,0)=" ;              TRANSMISSION QUEUE (#365.1,.04) to ""Cancelled"""
^XMB(3.9,146047,2,2547,0)="""RTN"",""IBCNEUT2"",71,0)"
^XMB(3.9,146047,2,2548,0)=" ;"
^XMB(3.9,146047,2,2549,0)="""RTN"",""IBCNEUT2"",72,0)"
^XMB(3.9,146047,2,2550,0)=" N FLD,HCT,SEG,STOP,TMP"
^XMB(3.9,146047,2,2551,0)="""RTN"",""IBCNEUT2"",73,0)"
^XMB(3.9,146047,2,2552,0)=" S HCT="""",STOP=0"
^XMB(3.9,146047,2,2553,0)="""RTN"",""IBCNEUT2"",74,0)"
^XMB(3.9,146047,2,2554,0)=" F  S HCT=$O(^TMP(""HLS"",$J,HCT)) Q:'HCT  S SEG=$P(^(HCT),HLFS,1),TMP(SEG)=HCT"
^XMB(3.9,146047,2,2555,0)="""RTN"",""IBCNEUT2"",75,0)"
^XMB(3.9,146047,2,2556,0)=" ;"
^XMB(3.9,146047,2,2557,0)="""RTN"",""IBCNEUT2"",76,0)"
^XMB(3.9,146047,2,2558,0)=" ; Regular 270 Messages"
^XMB(3.9,146047,2,2559,0)="""RTN"",""IBCNEUT2"",77,0)"
^XMB(3.9,146047,2,2560,0)=" I (EXT=1)!(EXT=2)!(EXT=5)!(EXT=6) D  G BADMSGX"
^XMB(3.9,146047,2,2561,0)="""RTN"",""IBCNEUT2"",78,0)"
