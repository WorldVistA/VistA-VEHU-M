^XMB(3.9,146087,2,3529,0)="""RTN"",""YTQRQAD4"",251,0)"
^XMB(3.9,146087,2,3530,0)=" S RESULTS=$NA(^TMP(""YTQ-JSON"",$J))"
^XMB(3.9,146087,2,3531,0)="""RTN"",""YTQRQAD4"",252,0)"
