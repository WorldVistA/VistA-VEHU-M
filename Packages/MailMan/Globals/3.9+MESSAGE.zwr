^XMB(3.9,146037,2,307,0)="""QUES"",""XPZ2"",0)"
^XMB(3.9,146037,2,308,0)="Y"
^XMB(3.9,146037,2,309,0)="""QUES"",""XPZ2"",""??"")"
^XMB(3.9,146037,2,310,0)="^D RTN^XPDH"
^XMB(3.9,146037,2,311,0)="""QUES"",""XPZ2"",""A"")"
^XMB(3.9,146037,2,312,0)="Want to MOVE routines to other CPUs"
