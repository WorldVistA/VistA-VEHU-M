^XMB(3.9,146098,2,1479,0)="""RTN"",""SDES2DISPRECALL"",20,0)"
^XMB(3.9,146098,2,1480,0)=" ; INPUT FORMAT"
^XMB(3.9,146098,2,1481,0)="""RTN"",""SDES2DISPRECALL"",21,0)"
^XMB(3.9,146098,2,1482,0)=" ;"
^XMB(3.9,146098,2,1483,0)="""RTN"",""SDES2DISPRECALL"",22,0)"
^XMB(3.9,146098,2,1484,0)=" ;S SDINPUT(""RECALL IEN"")=RECALL IEN                           REQUIRED"
^XMB(3.9,146098,2,1485,0)="""RTN"",""SDES2DISPRECALL"",23,0)"
^XMB(3.9,146098,2,1486,0)=" ;S SDINPUT(""DELETE REASON"")=DELETE REASON From 403.56, 203    OPTIONAL"
^XMB(3.9,146098,2,1487,0)="""RTN"",""SDES2DISPRECALL"",24,0)"
^XMB(3.9,146098,2,1488,0)=" ;      Can be the number or name"
^XMB(3.9,146098,2,1489,0)="""RTN"",""SDES2DISPRECALL"",25,0)"
^XMB(3.9,146098,2,1490,0)=" ;      '1' FOR FAILURE TO RESPOND"
^XMB(3.9,146098,2,1491,0)="""RTN"",""SDES2DISPRECALL"",26,0)"
^XMB(3.9,146098,2,1492,0)=" ;      '2' FOR MOVED"
^XMB(3.9,146098,2,1493,0)="""RTN"",""SDES2DISPRECALL"",27,0)"
^XMB(3.9,146098,2,1494,0)=" ;      '3' FOR DECEASED"
^XMB(3.9,146098,2,1495,0)="""RTN"",""SDES2DISPRECALL"",28,0)"
^XMB(3.9,146098,2,1496,0)=" ;      '4' FOR DOESN'T WANT VA SERVICES"
^XMB(3.9,146098,2,1497,0)="""RTN"",""SDES2DISPRECALL"",29,0)"
^XMB(3.9,146098,2,1498,0)=" ;      '5' FOR RECEIVED CARE AT ANOTHER VA"
^XMB(3.9,146098,2,1499,0)="""RTN"",""SDES2DISPRECALL"",30,0)"
^XMB(3.9,146098,2,1500,0)=" ;      '6' FOR OTHER"
^XMB(3.9,146098,2,1501,0)="""RTN"",""SDES2DISPRECALL"",31,0)"
^XMB(3.9,146098,2,1502,0)=" ;      '7' FOR APPT SCHEDULED"
^XMB(3.9,146098,2,1503,0)="""RTN"",""SDES2DISPRECALL"",32,0)"
^XMB(3.9,146098,2,1504,0)=" ;      '8' FOR VET SELF-CANCEL"
^XMB(3.9,146098,2,1505,0)="""RTN"",""SDES2DISPRECALL"",33,0)"
^XMB(3.9,146098,2,1506,0)=" ;"
^XMB(3.9,146098,2,1507,0)="""RTN"",""SDES2DISPRECALL"",34,0)"
^XMB(3.9,146098,2,1508,0)=" ;S SDINPUT(""COMMENT"")=FREE TEXT (1-80)                        OPTIONAL"
^XMB(3.9,146098,2,1509,0)="""RTN"",""SDES2DISPRECALL"",35,0)"
^XMB(3.9,146098,2,1510,0)=" ;"
^XMB(3.9,146098,2,1511,0)="""RTN"",""SDES2DISPRECALL"",36,0)"
^XMB(3.9,146098,2,1512,0)="DISPRECALL(JSONRETURN,SDCONTEXT,SDINPUT) ; add a disposition and delete an entry from the RECALL REMINDERS file (403.5)"
^XMB(3.9,146098,2,1513,0)="""RTN"",""SDES2DISPRECALL"",37,0)"
^XMB(3.9,146098,2,1514,0)=" N ERRORS,FILEDATA,PROVIDER,RECALLRETURN"
^XMB(3.9,146098,2,1515,0)="""RTN"",""SDES2DISPRECALL"",38,0)"
^XMB(3.9,146098,2,1516,0)=" ; validate context"
^XMB(3.9,146098,2,1517,0)="""RTN"",""SDES2DISPRECALL"",39,0)"
^XMB(3.9,146098,2,1518,0)=" D VALCONTEXT^SDES2VALCONTEXT(.ERRORS,.SDCONTEXT)"
^XMB(3.9,146098,2,1519,0)="""RTN"",""SDES2DISPRECALL"",40,0)"
^XMB(3.9,146098,2,1520,0)=" I $D(ERRORS) S ERRORS(""PtCSchReqDisposition"",1)="""" D BUILDJSON^SDES2JSON(.JSONRETURN,.ERRORS) Q"
^XMB(3.9,146098,2,1521,0)="""RTN"",""SDES2DISPRECALL"",41,0)"
^XMB(3.9,146098,2,1522,0)=" I $G(SDCONTEXT(""USER DUZ""))'="""" N DUZ D DUZ^XUP(SDCONTEXT(""USER DUZ""))"
^XMB(3.9,146098,2,1523,0)="""RTN"",""SDES2DISPRECALL"",42,0)"
^XMB(3.9,146098,2,1524,0)=" M FILEDATA=SDINPUT"
^XMB(3.9,146098,2,1525,0)="""RTN"",""SDES2DISPRECALL"",43,0)"
^XMB(3.9,146098,2,1526,0)=" ; validate SDINPUT"
^XMB(3.9,146098,2,1527,0)="""RTN"",""SDES2DISPRECALL"",44,0)"
^XMB(3.9,146098,2,1528,0)=" D VALIDATE(.ERRORS,.SDINPUT,.FILEDATA)"
^XMB(3.9,146098,2,1529,0)="""RTN"",""SDES2DISPRECALL"",45,0)"
^XMB(3.9,146098,2,1530,0)=" I $D(ERRORS) S ERRORS(""PtCSchReqDisposition"",1)="""" D BUILDJSON^SDES2JSON(.JSONRETURN,.ERRORS) Q"
^XMB(3.9,146098,2,1531,0)="""RTN"",""SDES2DISPRECALL"",46,0)"
^XMB(3.9,146098,2,1532,0)=" ; edit the comment and eas fields in 403.5"
^XMB(3.9,146098,2,1533,0)="""RTN"",""SDES2DISPRECALL"",47,0)"
^XMB(3.9,146098,2,1534,0)=" D EDIT(.FILEDATA,$G(SDCONTEXT(""ACHERON AUDIT ID"")))"
^XMB(3.9,146098,2,1535,0)="""RTN"",""SDES2DISPRECALL"",48,0)"
^XMB(3.9,146098,2,1536,0)=" S PROVIDER=$$GET1^DIQ(403.5,$G(SDINPUT(""RECALL IEN"")),4,""I"")"
^XMB(3.9,146098,2,1537,0)="""RTN"",""SDES2DISPRECALL"",49,0)"
^XMB(3.9,146098,2,1538,0)=" ; delete 403.5 entry"
^XMB(3.9,146098,2,1539,0)="""RTN"",""SDES2DISPRECALL"",50,0)"
^XMB(3.9,146098,2,1540,0)=" D DELETE(.ERRORS,.FILEDATA)"
^XMB(3.9,146098,2,1541,0)="""RTN"",""SDES2DISPRECALL"",51,0)"
^XMB(3.9,146098,2,1542,0)=" I $D(ERRORS) S ERRORS(""PtCSchReqDisposition"",1)="""" D BUILDJSON^SDES2JSON(.JSONRETURN,.ERRORS) Q"
^XMB(3.9,146098,2,1543,0)="""RTN"",""SDES2DISPRECALL"",52,0)"
^XMB(3.9,146098,2,1544,0)=" S RECALLRETURN(""PtCSchReqDisposition"",""IEN"")=$G(SDINPUT(""RECALL IEN""))"
^XMB(3.9,146098,2,1545,0)="""RTN"",""SDES2DISPRECALL"",53,0)"
