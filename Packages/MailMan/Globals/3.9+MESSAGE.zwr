^XMB(3.9,146018,2,1270,0)=" .. S DG20NAME=$$NAMEFMT^XLFNAME(.DG20NAME,""F"",""CFL30"")"
^XMB(3.9,146018,2,1271,0)="""RTN"",""DPTLK7A"",105,0)"
^XMB(3.9,146018,2,1272,0)=" .. ;Format the .01 value"
^XMB(3.9,146018,2,1273,0)="""RTN"",""DPTLK7A"",106,0)"
^XMB(3.9,146018,2,1274,0)=" .. M DGY=DG20NAME"
^XMB(3.9,146018,2,1275,0)="""RTN"",""DPTLK7A"",107,0)"
^XMB(3.9,146018,2,1276,0)=" .. S DGF(""ALIAS"",DGZ,.01)=$$FORMAT^XLFNAME7(.DGY,3,30,,2)"
^XMB(3.9,146018,2,1277,0)="""RTN"",""DPTLK7A"",108,0)"
^XMB(3.9,146018,2,1278,0)=" . I $G(DGM(DGX,""ALIAS"",DGZ,""SSN""))]"""" S DGF(""ALIAS"",DGZ,1)=DGM(DGX,""ALIAS"",DGZ,""SSN"")"
^XMB(3.9,146018,2,1279,0)="""RTN"",""DPTLK7A"",109,0)"
^XMB(3.9,146018,2,1280,0)=" S:$G(DGM(DGX,""ICN""))]"""" DGF(""ICN"")=DGM(DGX,""ICN"")"
^XMB(3.9,146018,2,1281,0)="""RTN"",""DPTLK7A"",110,0)"
^XMB(3.9,146018,2,1282,0)=" ;"
^XMB(3.9,146018,2,1283,0)="""RTN"",""DPTLK7A"",111,0)"
^XMB(3.9,146018,2,1284,0)=" ; - Story 338378 (elz) handle pseudo SSN"
^XMB(3.9,146018,2,1285,0)="""RTN"",""DPTLK7A"",112,0)"
^XMB(3.9,146018,2,1286,0)=" I $G(DGF(.09))'?9N S DGF(.09)=$$PSEUDO^DPTLK7($G(DGF(.01)),$G(DGF(.03)))"
^XMB(3.9,146018,2,1287,0)="""RTN"",""DPTLK7A"",113,0)"
^XMB(3.9,146018,2,1288,0)=" E  K DGF(.0906) ; remove pseudo reason if we have a ssn"
^XMB(3.9,146018,2,1289,0)="""RTN"",""DPTLK7A"",114,0)"
^XMB(3.9,146018,2,1290,0)=" ;"
^XMB(3.9,146018,2,1291,0)="""RTN"",""DPTLK7A"",115,0)"
^XMB(3.9,146018,2,1292,0)=" Q"
^XMB(3.9,146018,2,1293,0)="""RTN"",""DPTLK7A"",116,0)"
^XMB(3.9,146018,2,1294,0)=" ;"
^XMB(3.9,146018,2,1295,0)="""RTN"",""DPTLK7A"",117,0)"
^XMB(3.9,146018,2,1296,0)=" ;**1139 VAMPI-26417 (jfw) - Pulled logic from FORMATR to be reuseable"
^XMB(3.9,146018,2,1297,0)="""RTN"",""DPTLK7A"",118,0)"
^XMB(3.9,146018,2,1298,0)=" ;Input: DGVAL - Zip+4 or Residential Zip+4"
^XMB(3.9,146018,2,1299,0)="""RTN"",""DPTLK7A"",119,0)"
^XMB(3.9,146018,2,1300,0)=" ;Output: Code that identifies the County for the Zip+4"
^XMB(3.9,146018,2,1301,0)="""RTN"",""DPTLK7A"",120,0)"
^XMB(3.9,146018,2,1302,0)="GETCNTY(DGVAL) ;"
^XMB(3.9,146018,2,1303,0)="""RTN"",""DPTLK7A"",121,0)"
^XMB(3.9,146018,2,1304,0)=" N DGX,DGCNTY S DGCNTY="""""
^XMB(3.9,146018,2,1305,0)="""RTN"",""DPTLK7A"",122,0)"
^XMB(3.9,146018,2,1306,0)=" D POSTAL^XIPUTIL(DGVAL,.DGX)"
^XMB(3.9,146018,2,1307,0)="""RTN"",""DPTLK7A"",123,0)"
^XMB(3.9,146018,2,1308,0)=" I $G(DGX(""FIPS CODE""))]"""",$G(DGX(""STATE POINTER"")) D"
^XMB(3.9,146018,2,1309,0)="""RTN"",""DPTLK7A"",124,0)"
^XMB(3.9,146018,2,1310,0)=" .S DGCNTY=$$FIND1^DIC(5.01,"",""_DGX(""STATE POINTER"")_"","",""MOXQ"",$E($G(DGX(""FIPS CODE"")),3,5),""C"")"
^XMB(3.9,146018,2,1311,0)="""RTN"",""DPTLK7A"",125,0)"
^XMB(3.9,146018,2,1312,0)=" Q DGCNTY"
^XMB(3.9,146018,2,1313,0)="""RTN"",""DPTLK7A"",126,0)"
^XMB(3.9,146018,2,1314,0)=" ;"
^XMB(3.9,146018,2,1315,0)="""RTN"",""VAFCPTAD"")"
^XMB(3.9,146018,2,1316,0)="0^1^B165654987"
^XMB(3.9,146018,2,1317,0)="""RTN"",""VAFCPTAD"",1,0)"
^XMB(3.9,146018,2,1318,0)="VAFCPTAD ;ISA/RJS,ZOLTAN - Add an entry to the PATIENT (#2) file; 26-Apr-2023 4:26 PM"
^XMB(3.9,146018,2,1319,0)="""RTN"",""VAFCPTAD"",2,0)"
^XMB(3.9,146018,2,1320,0)=" ;;5.3;Registration;**149,800,876,944,950,955,1033,1042,1050,1099,1131**;Aug 13, 1993;Build 0"
^XMB(3.9,146018,2,1321,0)="""RTN"",""VAFCPTAD"",3,0)"
^XMB(3.9,146018,2,1322,0)=" ;"
^XMB(3.9,146018,2,1323,0)="""RTN"",""VAFCPTAD"",4,0)"
^XMB(3.9,146018,2,1324,0)="ADD(RETURN,PARAM) ;Entry point for VAFC VOA ADD PATIENT remote procedure"
^XMB(3.9,146018,2,1325,0)="""RTN"",""VAFCPTAD"",5,0)"
^XMB(3.9,146018,2,1326,0)=" ;Input  PARAM array = List of data to be used for the creation of a VistA PATIENT (#2) record at the Preferred Facility."
^XMB(3.9,146018,2,1327,0)="""RTN"",""VAFCPTAD"",6,0)"
^XMB(3.9,146018,2,1328,0)=" ;Required elements include:"
^XMB(3.9,146018,2,1329,0)="""RTN"",""VAFCPTAD"",7,0)"
^XMB(3.9,146018,2,1330,0)=" ;  PARAM(""PRFCLTY"")=PREFERRED FACILITY"
^XMB(3.9,146018,2,1331,0)="""RTN"",""VAFCPTAD"",8,0)"
^XMB(3.9,146018,2,1332,0)=" ;  PARAM(""NAME"")=NAME (last name minimal; recommend full name), 30 chars max"
^XMB(3.9,146018,2,1333,0)="""RTN"",""VAFCPTAD"",9,0)"
^XMB(3.9,146018,2,1334,0)=" ;  PARAM(""GENDER"")=SEX                    PARAM(""DOB"")=DATE OF BIRTH"
^XMB(3.9,146018,2,1335,0)="""RTN"",""VAFCPTAD"",10,0)"
^XMB(3.9,146018,2,1336,0)=" ;  PARAM(""SSN"")=SOCIAL SECURITY NUMBER OR NULL IF NONE and want a psuedo SSN created"
^XMB(3.9,146018,2,1337,0)="""RTN"",""VAFCPTAD"",11,0)"
^XMB(3.9,146018,2,1338,0)=" ;  PARAM(""SRVCNCTD"")=SERVICE CONNECTED?   PARAM(""TYPE"")=Patient TYPE"
^XMB(3.9,146018,2,1339,0)="""RTN"",""VAFCPTAD"",12,0)"
^XMB(3.9,146018,2,1340,0)=" ;  PARAM(""VET"")=VETERAN (Y/N)?            PARAM(""FULLICN"")=INTEGRATION CONTROL NUMBER with CHECKSUM"
^XMB(3.9,146018,2,1341,0)="""RTN"",""VAFCPTAD"",13,0)"
^XMB(3.9,146018,2,1342,0)=" ;Optional elements include:"
^XMB(3.9,146018,2,1343,0)="""RTN"",""VAFCPTAD"",14,0)"
^XMB(3.9,146018,2,1344,0)=" ;  PARAM(""LONGNAME"")=NAME (set if full name is greater than 30 chars) ;**1050,VAMPI-9503 (mko): New input, allows setting Name Components to long name"
^XMB(3.9,146018,2,1345,0)="""RTN"",""VAFCPTAD"",15,0)"
^XMB(3.9,146018,2,1346,0)=" ;  PARAM(""POBCTY"")=PLACE OF BIRTH [CITY]  PARAM(""POBST"")=PLACE OF BIRTH [STATE]"
^XMB(3.9,146018,2,1347,0)="""RTN"",""VAFCPTAD"",16,0)"
^XMB(3.9,146018,2,1348,0)=" ;  PARAM(""MMN"")=MOTHER'S MAIDEN NAME      PARAM(""MBI"")=MULTIPLE BIRTH INDICATOR"
^XMB(3.9,146018,2,1349,0)="""RTN"",""VAFCPTAD"",17,0)"
^XMB(3.9,146018,2,1350,0)=" ;  PARAM(""ALIAS"",#)=ALIAS NAME(last^first^middle^suffix)^ALIAS SSN"
^XMB(3.9,146018,2,1351,0)="""RTN"",""VAFCPTAD"",18,0)"
^XMB(3.9,146018,2,1352,0)=" ; **1033 enrollment, address and phone"
^XMB(3.9,146018,2,1353,0)="""RTN"",""VAFCPTAD"",19,0)"
^XMB(3.9,146018,2,1354,0)=" ;  PARAM(""ENROLLMENT"")=1 if would like the ES messaging triggered"
^XMB(3.9,146018,2,1355,0)="""RTN"",""VAFCPTAD"",20,0)"
^XMB(3.9,146018,2,1356,0)=" ;  PARAM(""ResAddL1"")=Resident Street Address line 1     ;PARAM(""ResAddL2"")=Resident Street Address line 2"
^XMB(3.9,146018,2,1357,0)="""RTN"",""VAFCPTAD"",21,0)"
^XMB(3.9,146018,2,1358,0)=" ;  PARAM(""ResAddL3"")=Resident Street Address line 3     ;PARAM(""ResAddCity"")=Resident City"
^XMB(3.9,146018,2,1359,0)="""RTN"",""VAFCPTAD"",22,0)"
^XMB(3.9,146018,2,1360,0)=" ;  PARAM(""ResAddState"")=Resident State                  ;PARAM(""ResAddZIP"")=Resident Zip"
^XMB(3.9,146018,2,1361,0)="""RTN"",""VAFCPTAD"",23,0)"
^XMB(3.9,146018,2,1362,0)=" ;  PARAM(""ResPhone"")=Home Phone Number                  ;PARAM(""ResAddCountry"")=COUNTRY FOR FORIEGN ADDRESS"
^XMB(3.9,146018,2,1363,0)="""RTN"",""VAFCPTAD"",24,0)"
^XMB(3.9,146018,2,1364,0)=" ;  PARAM(""ResAddPCode"")=POSTAL CODE FOR FORIEGN ADDRESS ;PARAM(""ResAddProvince"")=PROVINCE FOR FORIEGN ADDRESS"
^XMB(3.9,146018,2,1365,0)="""RTN"",""VAFCPTAD"",25,0)"
^XMB(3.9,146018,2,1366,0)=" ;Output:"
^XMB(3.9,146018,2,1367,0)="""RTN"",""VAFCPTAD"",26,0)"
^XMB(3.9,146018,2,1368,0)=" ;  On Failure:  -1^error text - record add failed"
^XMB(3.9,146018,2,1369,0)="""RTN"",""VAFCPTAD"",27,0)"
^XMB(3.9,146018,2,1370,0)=" ;  On Success:   1^DFN of new PATIENT (#2) record"
^XMB(3.9,146018,2,1371,0)="""RTN"",""VAFCPTAD"",28,0)"
^XMB(3.9,146018,2,1372,0)=" ;"
^XMB(3.9,146018,2,1373,0)="""RTN"",""VAFCPTAD"",29,0)"
^XMB(3.9,146018,2,1374,0)="EN1 ;Check value of all required fields"
^XMB(3.9,146018,2,1375,0)="""RTN"",""VAFCPTAD"",30,0)"
^XMB(3.9,146018,2,1376,0)=" K RETURN D NOW^%DTC"
^XMB(3.9,146018,2,1377,0)="""RTN"",""VAFCPTAD"",31,0)"
^XMB(3.9,146018,2,1378,0)=" N ALSERR,DIERR,DPTIDS,DPTX,ERROR,FLG,FDA,FN,LN,MN,RESULT,RGRSICN,SFX,VAL,VAFCA08,X,Y,UPDNC,VAFCDFN,VAFCDOB,VAFCICN,VAFCMMN,VAFCNAM,VAFCPF,VAFCPOBC,VAFCPOBS"
^XMB(3.9,146018,2,1379,0)="""RTN"",""VAFCPTAD"",32,0)"
^XMB(3.9,146018,2,1380,0)=" N VAFCRSN,VAFCSRV,VAFCSSN,VAFCSUM,VAFCSX,VAFCTYP,VAFCVET,VAFCMBI,VAFCPN,VAFCPR,VAFCPC,VAFCPCT,VAFCAL1,VAFCAL2,VAFCAL3,VAFCACY,VAFCAST,VAFCAZ,VAFCACTY,CNTY"
^XMB(3.9,146018,2,1381,0)="""RTN"",""VAFCPTAD"",33,0)"
^XMB(3.9,146018,2,1382,0)=" N VAFCSEQ S VAFCSEQ=$$RECORD(.PARAM)"
^XMB(3.9,146018,2,1383,0)="""RTN"",""VAFCPTAD"",34,0)"
^XMB(3.9,146018,2,1384,0)=" S (RGRSICN,VAFCA08)=1 S FLG=0 ;allow update to ICN; prevent triggering of messages"
^XMB(3.9,146018,2,1385,0)="""RTN"",""VAFCPTAD"",35,0)"
^XMB(3.9,146018,2,1386,0)=" ;PREFERRED FACILITY"
^XMB(3.9,146018,2,1387,0)="""RTN"",""VAFCPTAD"",36,0)"
^XMB(3.9,146018,2,1388,0)=" I $G(PARAM(""PRFCLTY""))="""" S RETURN(1)=""-1^PREFERRED FACILITY is a required field."" G END"
^XMB(3.9,146018,2,1389,0)="""RTN"",""VAFCPTAD"",37,0)"
^XMB(3.9,146018,2,1390,0)=" ;**955 (cmc) Story 699475 don't require perferred facility to be this site if this is station 200"
^XMB(3.9,146018,2,1391,0)="""RTN"",""VAFCPTAD"",38,0)"
^XMB(3.9,146018,2,1392,0)=" ;**1131 (cmc) VAMPI-26434 allow 741MM to be a perferred facility"
^XMB(3.9,146018,2,1393,0)="""RTN"",""VAFCPTAD"",39,0)"
^XMB(3.9,146018,2,1394,0)=" I $P($$SITE^VASITE(),""^"",3)'=200&(PARAM(""PRFCLTY"")'=""741MM"") I $G(PARAM(""PRFCLTY""))'=$P($$SITE^VASITE(),""^"",3) S RETURN(1)=""-1^PREFERRED FACILITY is not the station to which the RPC was sent."" G END"
^XMB(3.9,146018,2,1395,0)="""RTN"",""VAFCPTAD"",40,0)"
^XMB(3.9,146018,2,1396,0)=" I $G(PARAM(""PRFCLTY""))'=""""&(PARAM(""PRFCLTY"")'=""741MM"") S VAL=$G(PARAM(""PRFCLTY"")) D CHK^DIE(2,27.02,,VAL,.RESULT) I RESULT=""^"" S RETURN(1)=""-1^""_^TMP(""DIERR"",$J,1,""TEXT"",1) G END"
^XMB(3.9,146018,2,1397,0)="""RTN"",""VAFCPTAD"",41,0)"
^XMB(3.9,146018,2,1398,0)=" I $G(PARAM(""PRFCLTY""))'="""" S VAL=$G(PARAM(""PRFCLTY""))"
^XMB(3.9,146018,2,1399,0)="""RTN"",""VAFCPTAD"",42,0)"
^XMB(3.9,146018,2,1400,0)=" S VAFCPF=VAL,FLG=1"
^XMB(3.9,146018,2,1401,0)="""RTN"",""VAFCPTAD"",43,0)"
^XMB(3.9,146018,2,1402,0)=" ;"
^XMB(3.9,146018,2,1403,0)="""RTN"",""VAFCPTAD"",44,0)"
^XMB(3.9,146018,2,1404,0)=" ;INTEGRATION CONTROL NUMBER and ICN CHECKSUM"
^XMB(3.9,146018,2,1405,0)="""RTN"",""VAFCPTAD"",45,0)"
^XMB(3.9,146018,2,1406,0)=" I $G(PARAM(""FULLICN""))=""""!($G(PARAM(""FULLICN""))'[""V"") S RETURN(1)=""-1^Full INTEGRATION CONTROL NUMBER with ICN CHECKSUM is required."" G END"
^XMB(3.9,146018,2,1407,0)="""RTN"",""VAFCPTAD"",46,0)"
^XMB(3.9,146018,2,1408,0)=" I $G(PARAM(""FULLICN""))'="""" S PARAM(""ICN"")=$P(PARAM(""FULLICN""),""V""),PARAM(""CHKSUM"")=$P(PARAM(""FULLICN""),""V"",2)"
^XMB(3.9,146018,2,1409,0)="""RTN"",""VAFCPTAD"",47,0)"
^XMB(3.9,146018,2,1410,0)=" I $G(PARAM(""ICN""))'="""" S VAL=$G(PARAM(""ICN"")) D CHK^DIE(2,991.01,,VAL,.RESULT) I RESULT=""^"" S RETURN(1)=""-1^""_^TMP(""DIERR"",$J,1,""TEXT"",1) G END"
^XMB(3.9,146018,2,1411,0)="""RTN"",""VAFCPTAD"",48,0)"
^XMB(3.9,146018,2,1412,0)=" S VAFCICN=VAL,FLG=1"
^XMB(3.9,146018,2,1413,0)="""RTN"",""VAFCPTAD"",49,0)"
^XMB(3.9,146018,2,1414,0)=" I $G(PARAM(""CHKSUM""))'="""" S VAL=$G(PARAM(""CHKSUM"")) D CHK^DIE(2,991.02,,VAL,.RESULT) I RESULT=""^"" S RETURN(1)=""-1^""_^TMP(""DIERR"",$J,1,""TEXT"",1) G END"
^XMB(3.9,146018,2,1415,0)="""RTN"",""VAFCPTAD"",50,0)"
^XMB(3.9,146018,2,1416,0)=" S VAFCSUM=VAL,FLG=1"
^XMB(3.9,146018,2,1417,0)="""RTN"",""VAFCPTAD"",51,0)"
^XMB(3.9,146018,2,1418,0)=" ;Has patient already been created at this facility?  If so get DFN and quit."
^XMB(3.9,146018,2,1419,0)="""RTN"",""VAFCPTAD"",52,0)"
^XMB(3.9,146018,2,1420,0)=" S VAFCDFN=+$O(^DPT(""AICN"",PARAM(""ICN""),0))"
^XMB(3.9,146018,2,1421,0)="""RTN"",""VAFCPTAD"",53,0)"
^XMB(3.9,146018,2,1422,0)=" I VAFCDFN D  G:$D(RETURN(1)) END"
^XMB(3.9,146018,2,1423,0)="""RTN"",""VAFCPTAD"",54,0)"
^XMB(3.9,146018,2,1424,0)=" .;**1050,VAMPI-9503 (mko): Make sure the 0 node of the patient exists before quitting with the DFN."
^XMB(3.9,146018,2,1425,0)="""RTN"",""VAFCPTAD"",55,0)"
^XMB(3.9,146018,2,1426,0)=" .;  If not, kill the erroneous ""AICN"" index entry and continue"
^XMB(3.9,146018,2,1427,0)="""RTN"",""VAFCPTAD"",56,0)"
^XMB(3.9,146018,2,1428,0)=" .I $D(^DPT(VAFCDFN,0))[0 K ^DPT(""AICN"",PARAM(""ICN""),VAFCDFN),VAFCDFN Q"
^XMB(3.9,146018,2,1429,0)="""RTN"",""VAFCPTAD"",57,0)"
^XMB(3.9,146018,2,1430,0)=" .S RETURN(1)=""1^""_$O(^DPT(""AICN"",PARAM(""ICN""),0))_$S($$GETFLAG^VAFCPTED:""^^1"",1:"""")"
^XMB(3.9,146018,2,1431,0)="""RTN"",""VAFCPTAD"",58,0)"
^XMB(3.9,146018,2,1432,0)=" ;"
^XMB(3.9,146018,2,1433,0)="""RTN"",""VAFCPTAD"",59,0)"
^XMB(3.9,146018,2,1434,0)=" ;NAME INPUT AS:LAST^FIRST^MIDDLE^SUFFIX; MUST BE FORMATTED FOR VISTA INPUT"
^XMB(3.9,146018,2,1435,0)="""RTN"",""VAFCPTAD"",60,0)"
^XMB(3.9,146018,2,1436,0)=" ;**1099,VAMPI-19828 (mko): Build VistA name in VAFCNAM instead of PARAM(""NAME"")"
^XMB(3.9,146018,2,1437,0)="""RTN"",""VAFCPTAD"",61,0)"
^XMB(3.9,146018,2,1438,0)=" I $G(PARAM(""NAME""))="""" S RETURN(1)=""-1^Patient NAME is a required field."" G END"
^XMB(3.9,146018,2,1439,0)="""RTN"",""VAFCPTAD"",62,0)"
^XMB(3.9,146018,2,1440,0)=" S LN=$P($G(PARAM(""NAME"")),""^""),FN=$P($G(PARAM(""NAME"")),""^"",2),MN=$P($G(PARAM(""NAME"")),""^"",3),SFX=$P($G(PARAM(""NAME"")),""^"",4)"
^XMB(3.9,146018,2,1441,0)="""RTN"",""VAFCPTAD"",63,0)"
^XMB(3.9,146018,2,1442,0)=" S VAFCNAM=LN_"","""
^XMB(3.9,146018,2,1443,0)="""RTN"",""VAFCPTAD"",64,0)"
^XMB(3.9,146018,2,1444,0)=" S:FN'="""" VAFCNAM=VAFCNAM_FN"
^XMB(3.9,146018,2,1445,0)="""RTN"",""VAFCPTAD"",65,0)"
^XMB(3.9,146018,2,1446,0)=" S:MN'="""" VAFCNAM=VAFCNAM_"" ""_MN"
^XMB(3.9,146018,2,1447,0)="""RTN"",""VAFCPTAD"",66,0)"
^XMB(3.9,146018,2,1448,0)=" S:SFX'="""" VAFCNAM=VAFCNAM_"" ""_SFX"
^XMB(3.9,146018,2,1449,0)="""RTN"",""VAFCPTAD"",67,0)"
^XMB(3.9,146018,2,1450,0)=" D CHK^DIE(2,.01,,VAFCNAM,.RESULT) I RESULT=""^"" S RETURN(1)=""-1^""_^TMP(""DIERR"",$J,1,""TEXT"",1) G END"
^XMB(3.9,146018,2,1451,0)="""RTN"",""VAFCPTAD"",68,0)"
^XMB(3.9,146018,2,1452,0)=" S FLG=1,DPTX=VAFCNAM ;variable used by SSN input transform"
