^XMB(3.9,146056,2,1083,0)="""RTN"",""VPR1P37"",138,0)"
^XMB(3.9,146056,2,1084,0)=" Q"
^XMB(3.9,146056,2,1085,0)="""RTN"",""VPR1P37"",139,0)"
^XMB(3.9,146056,2,1086,0)=" ;"
^XMB(3.9,146056,2,1087,0)="""RTN"",""VPR1P37"",140,0)"
^XMB(3.9,146056,2,1088,0)="REF ; -- Referrals via #123 where an action taken has been 'added comment'"
^XMB(3.9,146056,2,1089,0)="""RTN"",""VPR1P37"",141,0)"
^XMB(3.9,146056,2,1090,0)=" N DA,ACT,OK,AC,X0,X"
^XMB(3.9,146056,2,1091,0)="""RTN"",""VPR1P37"",142,0)"
^XMB(3.9,146056,2,1092,0)=" S AC=$O(^GMR(123.1,""B"",""ADDED COMMENT"",0)) Q:AC<1"
^XMB(3.9,146056,2,1093,0)="""RTN"",""VPR1P37"",143,0)"
^XMB(3.9,146056,2,1094,0)=" S DA=0 F  S DA=$O(^GMR(123,""F"",DFN,DA)) Q:DA<1  D"
^XMB(3.9,146056,2,1095,0)="""RTN"",""VPR1P37"",144,0)"
^XMB(3.9,146056,2,1096,0)=" . S X0=$G(^GMR(123,DA,0)),X=$P(X0,U,7) S:'X X=+X0 Q:X<VPRBDT!(X>VPREDT)"
^XMB(3.9,146056,2,1097,0)="""RTN"",""VPR1P37"",145,0)"
^XMB(3.9,146056,2,1098,0)=" . ;I $L($G(^GMR(123,DA,75))) D POST(""Referral"",DA_"";123"") Q  ;DST id"
^XMB(3.9,146056,2,1099,0)="""RTN"",""VPR1P37"",146,0)"
^XMB(3.9,146056,2,1100,0)=" . S (ACT,OK)=0"
^XMB(3.9,146056,2,1101,0)="""RTN"",""VPR1P37"",147,0)"
^XMB(3.9,146056,2,1102,0)=" . F  S ACT=$O(^GMR(123,DA,40,ACT)) Q:ACT<1  I $P(^(ACT,0),U,2)=AC S OK=1 Q"
^XMB(3.9,146056,2,1103,0)="""RTN"",""VPR1P37"",148,0)"
^XMB(3.9,146056,2,1104,0)=" . D:OK POST(""Referral"",DA_"";123"")"
^XMB(3.9,146056,2,1105,0)="""RTN"",""VPR1P37"",149,0)"
^XMB(3.9,146056,2,1106,0)=" Q"
^XMB(3.9,146056,2,1107,0)="""RTN"",""VPR1P37"",150,0)"
^XMB(3.9,146056,2,1108,0)=" ;"
^XMB(3.9,146056,2,1109,0)="""RTN"",""VPR1P37"",151,0)"
^XMB(3.9,146056,2,1110,0)="SOC  ; -- Add Social History ExternalId; need all records so use entity query "
^XMB(3.9,146056,2,1111,0)="""RTN"",""VPR1P37"",152,0)"
^XMB(3.9,146056,2,1112,0)=" ; Need to add WV query too.  "
^XMB(3.9,146056,2,1113,0)="""RTN"",""VPR1P37"",153,0)"
^XMB(3.9,146056,2,1114,0)=" N DA,DSTRT,DSTOP,DMAX,DLIST,VPRNUM"
^XMB(3.9,146056,2,1115,0)="""RTN"",""VPR1P37"",154,0)"
^XMB(3.9,146056,2,1116,0)=" S DSTRT=VPRBDT,DSTOP=VPREDT,DMAX=9999,VPRNUM=0"
^XMB(3.9,146056,2,1117,0)="""RTN"",""VPR1P37"",155,0)"
^XMB(3.9,146056,2,1118,0)=" D HFS^VPRSDAHX  ; entity query"
^XMB(3.9,146056,2,1119,0)="""RTN"",""VPR1P37"",156,0)"
^XMB(3.9,146056,2,1120,0)=" Q:'$D(DLIST)"
^XMB(3.9,146056,2,1121,0)="""RTN"",""VPR1P37"",157,0)"
^XMB(3.9,146056,2,1122,0)=" S VPRNUM=0 F  S VPRNUM=$O(DLIST(VPRNUM)) Q:+VPRNUM<1  D"
^XMB(3.9,146056,2,1123,0)="""RTN"",""VPR1P37"",158,0)"
^XMB(3.9,146056,2,1124,0)=" .S DA=DLIST(VPRNUM)"
^XMB(3.9,146056,2,1125,0)="""RTN"",""VPR1P37"",159,0)"
^XMB(3.9,146056,2,1126,0)=" .D POST(""SocialHistory"",DA_"";9000010.23"")"
^XMB(3.9,146056,2,1127,0)="""RTN"",""VPR1P37"",160,0)"
^XMB(3.9,146056,2,1128,0)=" .Q"
^XMB(3.9,146056,2,1129,0)="""RTN"",""VPR1P37"",161,0)"
^XMB(3.9,146056,2,1130,0)=" Q"
^XMB(3.9,146056,2,1131,0)="""RTN"",""VPR1P37"",162,0)"
^XMB(3.9,146056,2,1132,0)=" ;"
^XMB(3.9,146056,2,1133,0)="""RTN"",""VPR1P37"",163,0)"
^XMB(3.9,146056,2,1134,0)="INS ; -- Member Enrollment via #2.312 without expiration date"
^XMB(3.9,146056,2,1135,0)="""RTN"",""VPR1P37"",164,0)"
^XMB(3.9,146056,2,1136,0)=" N IEN,X0,EXDT"
^XMB(3.9,146056,2,1137,0)="""RTN"",""VPR1P37"",165,0)"
^XMB(3.9,146056,2,1138,0)=" S IEN=0 F  S IEN=$O(^DPT(DFN,.312,IEN)) Q:IEN<1  S X0=$G(^(IEN,0)) D"
^XMB(3.9,146056,2,1139,0)="""RTN"",""VPR1P37"",166,0)"
^XMB(3.9,146056,2,1140,0)=" . S EXDT=$P(X0,U,4) I EXDT,EXDT<3190401 Q  ;never sent to SDA"
^XMB(3.9,146056,2,1141,0)="""RTN"",""VPR1P37"",167,0)"
^XMB(3.9,146056,2,1142,0)=" . I EXDT="""" D POST(""MemberEnrollment"",IEN_"",""_DFN_"";2.312"")"
^XMB(3.9,146056,2,1143,0)="""RTN"",""VPR1P37"",168,0)"
^XMB(3.9,146056,2,1144,0)=" Q"
^XMB(3.9,146056,2,1145,0)="""RTN"",""VPR1P37"",169,0)"
^XMB(3.9,146056,2,1146,0)=" ;"
^XMB(3.9,146056,2,1147,0)="""RTN"",""VPR1P37"",170,0)"
^XMB(3.9,146056,2,1148,0)="POSTINIT ;Main entry point for Post-init items."
^XMB(3.9,146056,2,1149,0)="""RTN"",""VPR1P37"",171,0)"
^XMB(3.9,146056,2,1150,0)=" ; Queue off predictor to run after 10:00pm"
^XMB(3.9,146056,2,1151,0)="""RTN"",""VPR1P37"",172,0)"
^XMB(3.9,146056,2,1152,0)=" D BMES^XPDUTL("" Queuing CTP predictor to run after 10:00pm."")"
^XMB(3.9,146056,2,1153,0)="""RTN"",""VPR1P37"",173,0)"
^XMB(3.9,146056,2,1154,0)=" N DAY,DONE,QQ,TIME,ZTIO,ZTSK,ZTRTN,ZTDESC,ZTSAVE,ZTDTH,Y"
^XMB(3.9,146056,2,1155,0)="""RTN"",""VPR1P37"",174,0)"
^XMB(3.9,146056,2,1156,0)=" S ZTIO="""",ZTRTN=""PREDICTOR^VPR1P37"""
^XMB(3.9,146056,2,1157,0)="""RTN"",""VPR1P37"",175,0)"
^XMB(3.9,146056,2,1158,0)=" ;schedule job after 10:00pm"
^XMB(3.9,146056,2,1159,0)="""RTN"",""VPR1P37"",176,0)"
^XMB(3.9,146056,2,1160,0)=" K SCH S QQ=$$NOW^XLFDT,DAY=$P(QQ,"".""),TIME=$P(QQ,""."",2)"
^XMB(3.9,146056,2,1161,0)="""RTN"",""VPR1P37"",177,0)"
^XMB(3.9,146056,2,1162,0)=" I TIME<""215900"" S SCH=DAY_"".2205"""
^XMB(3.9,146056,2,1163,0)="""RTN"",""VPR1P37"",178,0)"
^XMB(3.9,146056,2,1164,0)=" I TIME>""220000"" S SCH=$$NOW^XLFDT"
^XMB(3.9,146056,2,1165,0)="""RTN"",""VPR1P37"",179,0)"
^XMB(3.9,146056,2,1166,0)=" S ZTDTH=SCH"
^XMB(3.9,146056,2,1167,0)="""RTN"",""VPR1P37"",180,0)"
^XMB(3.9,146056,2,1168,0)=" S ZTDESC=""VPR*1*37 post-install of CTP predictor."""
^XMB(3.9,146056,2,1169,0)="""RTN"",""VPR1P37"",181,0)"
^XMB(3.9,146056,2,1170,0)=" D ^%ZTLOAD"
^XMB(3.9,146056,2,1171,0)="""RTN"",""VPR1P37"",182,0)"
^XMB(3.9,146056,2,1172,0)=" I '$G(ZTSK) D MES^XPDUTL(""   **** Queuing CTP predictor failed!!!"") Q"
^XMB(3.9,146056,2,1173,0)="""RTN"",""VPR1P37"",183,0)"
^XMB(3.9,146056,2,1174,0)=" D MES^XPDUTL(""   Job number #""_ZTSK_"" was queued."")"
^XMB(3.9,146056,2,1175,0)="""RTN"",""VPR1P37"",184,0)"
^XMB(3.9,146056,2,1176,0)=" Q"
^XMB(3.9,146056,2,1177,0)="""RTN"",""VPR1P37"",185,0)"
^XMB(3.9,146056,2,1178,0)=" ;"
^XMB(3.9,146056,2,1179,0)="""RTN"",""VPR1P37"",186,0)"
^XMB(3.9,146056,2,1180,0)="PREDICTOR ;-- capture CTP predictor as Post Init on patch install (optional)"
^XMB(3.9,146056,2,1181,0)="""RTN"",""VPR1P37"",187,0)"
^XMB(3.9,146056,2,1182,0)=" N VPRPRED"
^XMB(3.9,146056,2,1183,0)="""RTN"",""VPR1P37"",188,0)"
^XMB(3.9,146056,2,1184,0)=" D EN(,,""OBS,MED,REF,INS,SOC"",""CNT"",,.VPRPRED)"
^XMB(3.9,146056,2,1185,0)="""RTN"",""VPR1P37"",189,0)"
^XMB(3.9,146056,2,1186,0)=" ;"
^XMB(3.9,146056,2,1187,0)="""RTN"",""VPR1P37"",190,0)"
^XMB(3.9,146056,2,1188,0)="MSG ; add post message and send to VPR developers in Outlook"
^XMB(3.9,146056,2,1189,0)="""RTN"",""VPR1P37"",191,0)"
^XMB(3.9,146056,2,1190,0)=" N VPRN,LINE,VPRSITE"
^XMB(3.9,146056,2,1191,0)="""RTN"",""VPR1P37"",192,0)"
^XMB(3.9,146056,2,1192,0)=" S VPRSITE=$$SITE^VASITE"
^XMB(3.9,146056,2,1193,0)="""RTN"",""VPR1P37"",193,0)"
^XMB(3.9,146056,2,1194,0)=" I $D(@VPRPRED@(""Tot"")) S VPRN=@VPRPRED@(""Tot"")"
^XMB(3.9,146056,2,1195,0)="""RTN"",""VPR1P37"",194,0)"
^XMB(3.9,146056,2,1196,0)=" ;I 'VPRN Q"
^XMB(3.9,146056,2,1197,0)="""RTN"",""VPR1P37"",195,0)"
^XMB(3.9,146056,2,1198,0)=" S LINE=1"
^XMB(3.9,146056,2,1199,0)="""RTN"",""VPR1P37"",196,0)"
^XMB(3.9,146056,2,1200,0)=" S VPRMSG(LINE,0)=""There's been a VPR*1*37 PREDICTOR run at site: ""_+(VPRSITE)_""."" S LINE=LINE+1"
^XMB(3.9,146056,2,1201,0)="""RTN"",""VPR1P37"",197,0)"
^XMB(3.9,146056,2,1202,0)=" S VPRMSG(LINE,0)="" "",LINE=LINE+1"
^XMB(3.9,146056,2,1203,0)="""RTN"",""VPR1P37"",198,0)"
^XMB(3.9,146056,2,1204,0)=" S VPRMSG(LINE,0)=""Total results returned: ""_$P(VPRN,U),LINE=LINE+1"
^XMB(3.9,146056,2,1205,0)="""RTN"",""VPR1P37"",199,0)"
^XMB(3.9,146056,2,1206,0)=" S VPRMSG(LINE,0)=""               #updates: ""_$P(VPRN,U,2),LINE=LINE+1"
^XMB(3.9,146056,2,1207,0)="""RTN"",""VPR1P37"",200,0)"
^XMB(3.9,146056,2,1208,0)=" S VPRMSG(LINE,0)=""               #deletes: ""_$P(VPRN,U,3),LINE=LINE+1"
^XMB(3.9,146056,2,1209,0)="""RTN"",""VPR1P37"",201,0)"
^XMB(3.9,146056,2,1210,0)=" D:$D(@VPRPRED@(""Tot"",""OBS""))"
^XMB(3.9,146056,2,1211,0)="""RTN"",""VPR1P37"",202,0)"
^XMB(3.9,146056,2,1212,0)=" . S VPRMSG(LINE,0)=""            #OBS Domain: ""_@VPRPRED@(""Tot"",""OBS""),LINE=LINE+1"
^XMB(3.9,146056,2,1213,0)="""RTN"",""VPR1P37"",203,0)"
^XMB(3.9,146056,2,1214,0)=" D:$D(@VPRPRED@(""Tot"",""MED""))"
^XMB(3.9,146056,2,1215,0)="""RTN"",""VPR1P37"",204,0)"
^XMB(3.9,146056,2,1216,0)=" . S VPRMSG(LINE,0)=""            #MED Domain: ""_@VPRPRED@(""Tot"",""MED""),LINE=LINE+1"
^XMB(3.9,146056,2,1217,0)="""RTN"",""VPR1P37"",205,0)"
^XMB(3.9,146056,2,1218,0)=" D:$D(@VPRPRED@(""Tot"",""REF""))"
^XMB(3.9,146056,2,1219,0)="""RTN"",""VPR1P37"",206,0)"
^XMB(3.9,146056,2,1220,0)=" . S VPRMSG(LINE,0)=""            #REF Domain: ""_@VPRPRED@(""Tot"",""REF""),LINE=LINE+1"
^XMB(3.9,146056,2,1221,0)="""RTN"",""VPR1P37"",207,0)"
^XMB(3.9,146056,2,1222,0)=" D:$D(@VPRPRED@(""Tot"",""INS""))"
^XMB(3.9,146056,2,1223,0)="""RTN"",""VPR1P37"",208,0)"
^XMB(3.9,146056,2,1224,0)=" . S VPRMSG(LINE,0)=""            #INS Domain: ""_@VPRPRED@(""Tot"",""INS""),LINE=LINE+1"
^XMB(3.9,146056,2,1225,0)="""RTN"",""VPR1P37"",209,0)"
^XMB(3.9,146056,2,1226,0)=" D:$D(@VPRPRED@(""Tot"",""SOC""))"
^XMB(3.9,146056,2,1227,0)="""RTN"",""VPR1P37"",210,0)"
^XMB(3.9,146056,2,1228,0)=" . S VPRMSG(LINE,0)=""            #SOC Domain: ""_@VPRPRED@(""Tot"",""SOC""),LINE=LINE+1"
^XMB(3.9,146056,2,1229,0)="""RTN"",""VPR1P37"",211,0)"
^XMB(3.9,146056,2,1230,0)=" S VPRMSG(LINE,0)="" "" S LINE=LINE+1"
^XMB(3.9,146056,2,1231,0)="""RTN"",""VPR1P37"",212,0)"
^XMB(3.9,146056,2,1232,0)=" N XMSUB,XMDUZ,XMY,XMTEXT,XMDUN"
^XMB(3.9,146056,2,1233,0)="""RTN"",""VPR1P37"",213,0)"
^XMB(3.9,146056,2,1234,0)=" S XMSUB=""VPR*1*37 >> PREDICTOR TASK COMPLETED AT SITE: #""_+(VPRSITE)"
