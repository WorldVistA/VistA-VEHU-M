^XMB(3.9,146009,2,353,0)="""RTN"",""XUIAMNPB"",44,0)"
^XMB(3.9,146009,2,354,0)=" .S XUIAM(""disabled"")=$E(XUARR(200,XUDUZ_"","",7,""E""),1) ;disuser"
^XMB(3.9,146009,2,355,0)="""RTN"",""XUIAMNPB"",45,0)"
^XMB(3.9,146009,2,356,0)=" .S XUIAM(""termDate"")=$$FMTHL7^XLFDT(XUARR(200,XUDUZ_"","",9.2,""I"")) ;termination date"
^XMB(3.9,146009,2,357,0)="""RTN"",""XUIAMNPB"",46,0)"
^XMB(3.9,146009,2,358,0)=" .S XUIAM(""lastAccess"")=$$FMTHL7^XLFDT(XUARR(200,XUDUZ_"","",202,""I"")) ;last sign-on date/time"
^XMB(3.9,146009,2,359,0)="""RTN"",""XUIAMNPB"",47,0)"
^XMB(3.9,146009,2,360,0)=" .S XUIAM(""primaryMenuInfor"")=$$ESC(XUARR(200,XUDUZ_"","",201,""E"")) ;primary menu"
^XMB(3.9,146009,2,361,0)="""RTN"",""XUIAMNPB"",48,0)"
^XMB(3.9,146009,2,362,0)=" .;"
^XMB(3.9,146009,2,363,0)="""RTN"",""XUIAMNPB"",49,0)"
^XMB(3.9,146009,2,364,0)=" .S XUIAM(""vistaid"")=XUDUZ_""^PN^""_$P($$SITE^VASITE(),""^"",3)_""^USDVA"" ;user being modified"
^XMB(3.9,146009,2,365,0)="""RTN"",""XUIAMNPB"",50,0)"
^XMB(3.9,146009,2,366,0)=" .;"
^XMB(3.9,146009,2,367,0)="""RTN"",""XUIAMNPB"",51,0)"
^XMB(3.9,146009,2,368,0)=" .S XUIAM(""WHO"")=XUWHO_""^PN^""_$P($$SITE^VASITE(),""^"",3)_""^USDVA"" ;last edited by"
^XMB(3.9,146009,2,369,0)="""RTN"",""XUIAMNPB"",52,0)"
^XMB(3.9,146009,2,370,0)=" .S XUIAM(""REQTYPE"")=""MODIFY"" ;passing 'add' or 'modify' to ^xuiamxml"
