^XMB(3.9,146021,2,758,0)=" S RSLT=""0^<Not Found>"""
^XMB(3.9,146021,2,759,0)="""RTN"",""PSJLMHED"",117,0)"
^XMB(3.9,146021,2,760,0)=" S PSCR=""^^^^^^0"""
^XMB(3.9,146021,2,761,0)="""RTN"",""PSJLMHED"",118,0)"
^XMB(3.9,146021,2,762,0)=" S PSCXTL="""" Q:'$$TERMLKUP^ORB31(.PSCXTL,""SERUM CREATININE"") RSLT"
^XMB(3.9,146021,2,763,0)="""RTN"",""PSJLMHED"",119,0)"
^XMB(3.9,146021,2,764,0)=" S PSCXTLS="""" Q:'$$TERMLKUP^ORB31(.PSCXTLS,""SERUM SPECIMEN"") RSLT"
^XMB(3.9,146021,2,765,0)="""RTN"",""PSJLMHED"",120,0)"
^XMB(3.9,146021,2,766,0)=" S SCR="""",OCXT=0 F  S OCXT=$O(PSCXTL(OCXT)) Q:'OCXT  D"
^XMB(3.9,146021,2,767,0)="""RTN"",""PSJLMHED"",121,0)"
^XMB(3.9,146021,2,768,0)=" .S OCXTS=0 F  S OCXTS=$O(PSCXTLS(OCXTS)) Q:'OCXTS  D"
^XMB(3.9,146021,2,769,0)="""RTN"",""PSJLMHED"",122,0)"
^XMB(3.9,146021,2,770,0)=" ..S SCR=$$LOCL^ORQQLR1(DFN,$P(PSCXTL(OCXT),U),$P(PSCXTLS(OCXTS),U))"
^XMB(3.9,146021,2,771,0)="""RTN"",""PSJLMHED"",123,0)"
^XMB(3.9,146021,2,772,0)=" ..I $P(SCR,U,7)>$P(PSCR,U,7) S PSCR=SCR"
^XMB(3.9,146021,2,773,0)="""RTN"",""PSJLMHED"",124,0)"
^XMB(3.9,146021,2,774,0)=" S SCR=PSCR,SCRV=$P(SCR,U,3) Q:+$G(SCRV)<.01 RSLT"
^XMB(3.9,146021,2,775,0)="""RTN"",""PSJLMHED"",125,0)"
^XMB(3.9,146021,2,776,0)=" S SCRD=$P(SCR,U,7) Q:'$L(SCRD) RSLT"
^XMB(3.9,146021,2,777,0)="""RTN"",""PSJLMHED"",126,0)"
^XMB(3.9,146021,2,778,0)=" S RSLT=SCRD_""^<Not Found>^""_$P($G(SCR),""^"",3)"
^XMB(3.9,146021,2,779,0)="""RTN"",""PSJLMHED"",127,0)"
^XMB(3.9,146021,2,780,0)=" S X1=$P(RSLT,""^""),X2=$$FMTE^XLFDT(X1,""2M""),$P(RSLT,""^"")=$P(X2,""@"") K X1,X2"
^XMB(3.9,146021,2,781,0)="""RTN"",""PSJLMHED"",128,0)"
^XMB(3.9,146021,2,782,0)=" D VITAL^ORQQVI(""WEIGHT"",""WT"",DFN,.PSRW,0,"""",$$NOW^XLFDT)"
^XMB(3.9,146021,2,783,0)="""RTN"",""PSJLMHED"",129,0)"
^XMB(3.9,146021,2,784,0)=" Q:'$D(PSRW) RSLT"
^XMB(3.9,146021,2,785,0)="""RTN"",""PSJLMHED"",130,0)"
^XMB(3.9,146021,2,786,0)=" S ABW=$P(PSRW(1),U,3) Q:+$G(ABW)<1 RSLT"
^XMB(3.9,146021,2,787,0)="""RTN"",""PSJLMHED"",131,0)"
^XMB(3.9,146021,2,788,0)=" S ABW=ABW/2.20462262  ;ABW (actual body weight) in kg; changed 2.2 to 2.20462262 per CQ 10637 ; PSO 402"
^XMB(3.9,146021,2,789,0)="""RTN"",""PSJLMHED"",132,0)"
^XMB(3.9,146021,2,790,0)=" D VITAL^ORQQVI(""HEIGHT"",""HT"",DFN,.PSRH,0,"""",$$NOW^XLFDT)"
^XMB(3.9,146021,2,791,0)="""RTN"",""PSJLMHED"",133,0)"
^XMB(3.9,146021,2,792,0)=" Q:'$D(PSRH) RSLT"
^XMB(3.9,146021,2,793,0)="""RTN"",""PSJLMHED"",134,0)"
^XMB(3.9,146021,2,794,0)=" S ZHT=$P(PSRH(1),U,3) Q:+$G(ZHT)<1 RSLT"
^XMB(3.9,146021,2,795,0)="""RTN"",""PSJLMHED"",135,0)"
^XMB(3.9,146021,2,796,0)=" N VADM D DEM^VADPT S ZAGE=$G(VADM(4)) Q:'$L(ZAGE) RSLT"
^XMB(3.9,146021,2,797,0)="""RTN"",""PSJLMHED"",136,0)"
^XMB(3.9,146021,2,798,0)=" ;S ZAGE=$$AGE^ORQPTQ4(DFN) Q:'ZAGE RSLT"
^XMB(3.9,146021,2,799,0)="""RTN"",""PSJLMHED"",137,0)"
^XMB(3.9,146021,2,800,0)=" S SEX=$P($G(VADM(5)),""^"") Q:'$L(SEX) RSLT"
^XMB(3.9,146021,2,801,0)="""RTN"",""PSJLMHED"",138,0)"
^XMB(3.9,146021,2,802,0)=" ;S SEX=$P($$SEX^ORQPTQ4(DFN),U,1) Q:'$L(SEX) RSLT"
^XMB(3.9,146021,2,803,0)="""RTN"",""PSJLMHED"",139,0)"
^XMB(3.9,146021,2,804,0)=" I '$G(ABW)!($G(ZHT)<1)!'$G(ZAGE)!'$D(SEX) Q RSLT"
^XMB(3.9,146021,2,805,0)="""RTN"",""PSJLMHED"",140,0)"
^XMB(3.9,146021,2,806,0)=" S SCRD=$P(SCR,U,7) Q:'$L(SCRD) RSLT"
^XMB(3.9,146021,2,807,0)="""RTN"",""PSJLMHED"",141,0)"
^XMB(3.9,146021,2,808,0)=" S HTGT60=$S(ZHT>60:(ZHT-60)*2.3,1:0)  ;if ht > 60 inches"
^XMB(3.9,146021,2,809,0)="""RTN"",""PSJLMHED"",142,0)"
^XMB(3.9,146021,2,810,0)=" I HTGT60>0 D"
^XMB(3.9,146021,2,811,0)="""RTN"",""PSJLMHED"",143,0)"
^XMB(3.9,146021,2,812,0)=" .S IBW=$S(SEX=""M"":50+HTGT60,1:45.5+HTGT60)  ;Ideal Body Weight"
^XMB(3.9,146021,2,813,0)="""RTN"",""PSJLMHED"",144,0)"
^XMB(3.9,146021,2,814,0)=" .S BWRATIO=(ABW/IBW)  ;body weight ratio"
