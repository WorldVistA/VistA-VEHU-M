^XMB(3.9,146011,2,702,0)=" I STA,STA'>4!(STA>11) D  D ULP G D1"
^XMB(3.9,146011,2,703,0)="""RTN"",""PSOHLD"",127,0)"
^XMB(3.9,146011,2,704,0)=" .S VALMSG=""Rx: ""_$P(Y(0),""^"")_"" is currently in a status of ""_ST,VALMBCK=""R"" K ST,Y Q"
^XMB(3.9,146011,2,705,0)="""RTN"",""PSOHLD"",128,0)"
^XMB(3.9,146011,2,706,0)=" D FULL^VALM1 D NOOR I $D(DIRUT) D ULP G D1"
^XMB(3.9,146011,2,707,0)="""RTN"",""PSOHLD"",129,0)"
^XMB(3.9,146011,2,708,0)=" D HLD^PSOCMOPA I $G(XFLAG) K XFLAG D ULP G D1"
