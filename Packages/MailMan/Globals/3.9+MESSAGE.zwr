^XMB(3.9,146020,2,244,0)="0^1^B91571550"
^XMB(3.9,146020,2,245,0)="""RTN"",""MPIFVER"",1,0)"
^XMB(3.9,146020,2,246,0)="MPIFVER ;ALB/CKN,VISTA ENTERPRISE REGISTRATION ; 7/26/17 2:18pm"
^XMB(3.9,146020,2,247,0)="""RTN"",""MPIFVER"",2,0)"
^XMB(3.9,146020,2,248,0)=" ;;1.0;MASTER PATIENT INDEX VISTA;**61,62,65,66,67,79**;30 Apr 99;Build 0"
^XMB(3.9,146020,2,249,0)="""RTN"",""MPIFVER"",3,0)"
^XMB(3.9,146020,2,250,0)=" Q"
^XMB(3.9,146020,2,251,0)="""RTN"",""MPIFVER"",4,0)"
^XMB(3.9,146020,2,252,0)="ENP(RESULTS,ALTRSHLD,TKTRSHLD) ;"
^XMB(3.9,146020,2,253,0)="""RTN"",""MPIFVER"",5,0)"
^XMB(3.9,146020,2,254,0)=" N XCNT,XCNTR,DFN,TMPRESLT"
^XMB(3.9,146020,2,255,0)="""RTN"",""MPIFVER"",6,0)"
^XMB(3.9,146020,2,256,0)=" S XCNT="""",XCNTR="""",DFN="""""
^XMB(3.9,146020,2,257,0)="""RTN"",""MPIFVER"",7,0)"
^XMB(3.9,146020,2,258,0)=" D DISPLAY"
^XMB(3.9,146020,2,259,0)="""RTN"",""MPIFVER"",8,0)"
^XMB(3.9,146020,2,260,0)=" I XCNTR'="""" D"
^XMB(3.9,146020,2,261,0)="""RTN"",""MPIFVER"",9,0)"
^XMB(3.9,146020,2,262,0)=" . M TMPRESLT(1)=RESULTS(XCNTR)"
^XMB(3.9,146020,2,263,0)="""RTN"",""MPIFVER"",10,0)"
^XMB(3.9,146020,2,264,0)=" . K RESULTS M RESULTS=TMPRESLT"
^XMB(3.9,146020,2,265,0)="""RTN"",""MPIFVER"",11,0)"
^XMB(3.9,146020,2,266,0)=" S DFN=$$BR(XCNTR)"
^XMB(3.9,146020,2,267,0)="""RTN"",""MPIFVER"",12,0)"
^XMB(3.9,146020,2,268,0)=" Q DFN"
^XMB(3.9,146020,2,269,0)="""RTN"",""MPIFVER"",13,0)"
^XMB(3.9,146020,2,270,0)="BR(XCNTR) ;Business rules"
^XMB(3.9,146020,2,271,0)="""RTN"",""MPIFVER"",14,0)"
^XMB(3.9,146020,2,272,0)=" N ICN,SSN,MPIIDS"
^XMB(3.9,146020,2,273,0)="""RTN"",""MPIFVER"",15,0)"
^XMB(3.9,146020,2,274,0)=" ;If no record is selected by user, return empty RESULTS and no DFN"
^XMB(3.9,146020,2,275,0)="""RTN"",""MPIFVER"",16,0)"
^XMB(3.9,146020,2,276,0)=" I XCNTR="""" K RESULTS  Q """""
^XMB(3.9,146020,2,277,0)="""RTN"",""MPIFVER"",17,0)"
^XMB(3.9,146020,2,278,0)=" ;"
^XMB(3.9,146020,2,279,0)="""RTN"",""MPIFVER"",18,0)"
^XMB(3.9,146020,2,280,0)=" S ICN=$G(RESULTS(1,""ICN"")),SSN=$G(RESULTS(1,""SSN""))"
^XMB(3.9,146020,2,281,0)="""RTN"",""MPIFVER"",19,0)"
^XMB(3.9,146020,2,282,0)=" ;If user select record with NO ICN value, return no DFN and single"
^XMB(3.9,146020,2,283,0)="""RTN"",""MPIFVER"",20,0)"
^XMB(3.9,146020,2,284,0)=" ;record in RESULTS"
^XMB(3.9,146020,2,285,0)="""RTN"",""MPIFVER"",21,0)"
^XMB(3.9,146020,2,286,0)=" I ICN="""" Q DFN"
^XMB(3.9,146020,2,287,0)="""RTN"",""MPIFVER"",22,0)"
^XMB(3.9,146020,2,288,0)=" ;If user select record with ICN value, check PATIENT file for"
^XMB(3.9,146020,2,289,0)="""RTN"",""MPIFVER"",23,0)"
^XMB(3.9,146020,2,290,0)=" ;ICN. If it exist, return DFN. If it does not exist, check for"
^XMB(3.9,146020,2,291,0)="""RTN"",""MPIFVER"",24,0)"
^XMB(3.9,146020,2,292,0)=" ;SSN. If SSN exist, Notify user and return empty DFN and RESULTS to"
^XMB(3.9,146020,2,293,0)="""RTN"",""MPIFVER"",25,0)"
^XMB(3.9,146020,2,294,0)=" ;go back to select patient prompt."
^XMB(3.9,146020,2,295,0)="""RTN"",""MPIFVER"",26,0)"
^XMB(3.9,146020,2,296,0)=" I $D(^DPT(""AICN"",+ICN)) D  Q DFN"
^XMB(3.9,146020,2,297,0)="""RTN"",""MPIFVER"",27,0)"
^XMB(3.9,146020,2,298,0)=" . S DFN=$O(^DPT(""AICN"",+ICN,""""))"
^XMB(3.9,146020,2,299,0)="""RTN"",""MPIFVER"",28,0)"
^XMB(3.9,146020,2,300,0)=" . K RESULTS"
^XMB(3.9,146020,2,301,0)="""RTN"",""MPIFVER"",29,0)"
^XMB(3.9,146020,2,302,0)=" I SSN'="""",($D(^DPT(""SSN"",SSN))) D  Q DFN"
^XMB(3.9,146020,2,303,0)="""RTN"",""MPIFVER"",30,0)"
^XMB(3.9,146020,2,304,0)=" . N IEN,NAME"
^XMB(3.9,146020,2,305,0)="""RTN"",""MPIFVER"",31,0)"
^XMB(3.9,146020,2,306,0)=" . S IEN=$O(^DPT(""SSN"",SSN,"""")),NAME=$P($G(^DPT(IEN,0)),""^""),DFN=-1"
^XMB(3.9,146020,2,307,0)="""RTN"",""MPIFVER"",32,0)"
^XMB(3.9,146020,2,308,0)=" . W !,""SSN in selected record already exist in PATIENT file..."""
^XMB(3.9,146020,2,309,0)="""RTN"",""MPIFVER"",33,0)"
^XMB(3.9,146020,2,310,0)=" . K RESULTS"
^XMB(3.9,146020,2,311,0)="""RTN"",""MPIFVER"",34,0)"
^XMB(3.9,146020,2,312,0)=" ;If existing patient not found in VistA,"
^XMB(3.9,146020,2,313,0)="""RTN"",""MPIFVER"",35,0)"
^XMB(3.9,146020,2,314,0)=" ;Call Enterprise Get Corresponding IDs, confirm MVI doesn't know"
^XMB(3.9,146020,2,315,0)="""RTN"",""MPIFVER"",36,0)"
^XMB(3.9,146020,2,316,0)=" ;this site already (active record) - if the site is already known"
^XMB(3.9,146020,2,317,0)="""RTN"",""MPIFVER"",37,0)"
^XMB(3.9,146020,2,318,0)=" ;need use that DFN."
^XMB(3.9,146020,2,319,0)="""RTN"",""MPIFVER"",38,0)"
^XMB(3.9,146020,2,320,0)=" D GETIDS^MPIFXMLG(.MPIIDS,RESULTS(1,""ICN""))"
^XMB(3.9,146020,2,321,0)="""RTN"",""MPIFVER"",39,0)"
^XMB(3.9,146020,2,322,0)=" N ID,CN,STNUM,QFLG"
^XMB(3.9,146020,2,323,0)="""RTN"",""MPIFVER"",40,0)"
^XMB(3.9,146020,2,324,0)=" S STNUM=$P($$SITE^VASITE(),""^"",3),QFLG=0"
^XMB(3.9,146020,2,325,0)="""RTN"",""MPIFVER"",41,0)"
^XMB(3.9,146020,2,326,0)=" S CN=0 F  S CN=$O(MPIIDS(CN)) Q:+CN=0!(QFLG)  D"
^XMB(3.9,146020,2,327,0)="""RTN"",""MPIFVER"",42,0)"
^XMB(3.9,146020,2,328,0)=" . I $G(MPIIDS(CN,""IDType""))=""PI"",($G(MPIIDS(CN,""Source""))=STNUM) D  Q"
^XMB(3.9,146020,2,329,0)="""RTN"",""MPIFVER"",43,0)"
^XMB(3.9,146020,2,330,0)=" .. S DFN=$G(MPIIDS(CN,""ID"")),QFLG=1"
^XMB(3.9,146020,2,331,0)="""RTN"",""MPIFVER"",44,0)"
^XMB(3.9,146020,2,332,0)=" .. K RESULTS"
^XMB(3.9,146020,2,333,0)="""RTN"",""MPIFVER"",45,0)"
^XMB(3.9,146020,2,334,0)=" .;If 200ESR is one of the site, set a flag to trigger Z11 query."
^XMB(3.9,146020,2,335,0)="""RTN"",""MPIFVER"",46,0)"
