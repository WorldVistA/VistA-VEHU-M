^XMB(3.9,146012,2,1239,0)="""RTN"",""PSOERRX1"",28,0)"
^XMB(3.9,146012,2,1240,0)=" . I $G(STSFLTR) S FILTER=FILTER_""|STATUS(""_$S($G(STSFLTR1)'="""":STSFLTR1,1:$$GET1^DIQ(52.45,STSFLTR,.01))_"")"""
^XMB(3.9,146012,2,1241,0)="""RTN"",""PSOERRX1"",29,0)"
^XMB(3.9,146012,2,1242,0)=" . I $G(MSTPFLTR)'="""" S FILTER=FILTER_""|TYPE(""_$S($G(MSTPFLTR1)'="""":MSTPFLTR1,1:$G(MTARR(MSTPFLTR)))_"")"""
