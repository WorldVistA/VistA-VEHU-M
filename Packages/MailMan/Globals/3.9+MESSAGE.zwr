^XMB(3.9,146089,2,2107,0)="""RTN"",""PSOPTPST"",28,0)"
^XMB(3.9,146089,2,2108,0)=" .S ACOM=""Date of Death ""_PSOPTPST(2,PSODFN,.351)_""."",ZTRTN=""CAN^PSOCAN3"",ZTDESC=""Outpatient Pharmacy Autocancel Due to Death of Patient"",ZTSAVE(""ACOM"")="""",ZTSAVE(""PSODFN"")="""",ZTSAVE(""PSODEATH"")="""""
