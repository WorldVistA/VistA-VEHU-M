^XMB(3.9,146036,2,3265,0)="""RTN"",""DVBUTIL"",77,0)"
^XMB(3.9,146036,2,3266,0)=" I DVBDUZ="""" S DVBRETURN=""-1^No User DUZ was provided"" Q"
^XMB(3.9,146036,2,3267,0)="""RTN"",""DVBUTIL"",78,0)"
^XMB(3.9,146036,2,3268,0)=" I DVBDVI="""" S DVBRETURN=""-1^No division IEN was provided"" Q"
^XMB(3.9,146036,2,3269,0)="""RTN"",""DVBUTIL"",79,0)"
^XMB(3.9,146036,2,3270,0)=" S DVBEXNM=$$NAME^XUSER(DVBDUZ)  ;Standard name (first MI last) of DVBDUZ"
^XMB(3.9,146036,2,3271,0)="""RTN"",""DVBUTIL"",80,0)"
^XMB(3.9,146036,2,3272,0)=" I DVBEXNM="""" S DVBRETURN=""-1^User with DUZ=""_DVBDUZ_"" does not exist"" Q"
^XMB(3.9,146036,2,3273,0)="""RTN"",""DVBUTIL"",81,0)"
^XMB(3.9,146036,2,3274,0)=" S DVBDVNM=$$GET1^DIQ(4,DVBDVI,"".01"",""E"")   ;Division name"
^XMB(3.9,146036,2,3275,0)="""RTN"",""DVBUTIL"",82,0)"
^XMB(3.9,146036,2,3276,0)=" I DVBDVNM="""" S DVBRETURN=""-1^Division with IEN=""_DVBDVI_"" does not exist"" Q"
^XMB(3.9,146036,2,3277,0)="""RTN"",""DVBUTIL"",83,0)"
^XMB(3.9,146036,2,3278,0)=" S DVBDVNM=$$GET1^DIQ(4,DVBDVI,"".01"",""E"")   ;Division name"
^XMB(3.9,146036,2,3279,0)="""RTN"",""DVBUTIL"",84,0)"
^XMB(3.9,146036,2,3280,0)=" S DVBDVAD1=$$GET1^DIQ(4,DVBDVI,""1.01"",""E"") ;Division address 1"
^XMB(3.9,146036,2,3281,0)="""RTN"",""DVBUTIL"",85,0)"
^XMB(3.9,146036,2,3282,0)=" S DVBDVAD2=$$GET1^DIQ(4,DVBDVI,""1.02"",""E"") ;Division address 2"
^XMB(3.9,146036,2,3283,0)="""RTN"",""DVBUTIL"",86,0)"
^XMB(3.9,146036,2,3284,0)=" S DVBDVCT=$$GET1^DIQ(4,DVBDVI,""1.03"",""E"")  ;Division city"
^XMB(3.9,146036,2,3285,0)="""RTN"",""DVBUTIL"",87,0)"
^XMB(3.9,146036,2,3286,0)=" S DVBA=$$GET1^DIQ(4,DVBDVI,"".02"",""I"")      ;Division state IEN"
^XMB(3.9,146036,2,3287,0)="""RTN"",""DVBUTIL"",88,0)"
^XMB(3.9,146036,2,3288,0)=" S DVBDVSTA=$$GET1^DIQ(5,DVBA,""1"",""E"")      ;Division state abbreviation"
^XMB(3.9,146036,2,3289,0)="""RTN"",""DVBUTIL"",89,0)"
