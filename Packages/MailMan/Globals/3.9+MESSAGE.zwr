^XMB(3.9,146018,2,1880,0)=" D GETS^DIQ(20,NCIENS,""1;2;3;5"","""",""CURR"",""MSG"") Q:$G(DIERR) 0"
^XMB(3.9,146018,2,1881,0)="""RTN"",""VAFCPTAD"",283,0)"
^XMB(3.9,146018,2,1882,0)=" ;"
^XMB(3.9,146018,2,1883,0)="""RTN"",""VAFCPTAD"",284,0)"
^XMB(3.9,146018,2,1884,0)=" ;**1099,VAMPI-19828 (mko): Quit 0 if there are no differences"
^XMB(3.9,146018,2,1885,0)="""RTN"",""VAFCPTAD"",285,0)"
^XMB(3.9,146018,2,1886,0)=" S CURR(""NAME"")=CURR(20,NCIENS,1)_U_CURR(20,NCIENS,2)_U_CURR(20,NCIENS,3)_U_CURR(20,NCIENS,5)_U"
^XMB(3.9,146018,2,1887,0)="""RTN"",""VAFCPTAD"",286,0)"
