^XMB(3.9,146012,2,494,0)=" ;Division selection"
^XMB(3.9,146012,2,495,0)="""RTN"",""PSOERRX0"",10,0)"
^XMB(3.9,146012,2,496,0)=" I '$G(PSOSITE) D ^PSOLSET I '$D(PSOPAR) W $C(7),!!,""Pharmacy Division Must be Selected!"",! G EXIT"
^XMB(3.9,146012,2,497,0)="""RTN"",""PSOERRX0"",11,0)"
^XMB(3.9,146012,2,498,0)=" I '$G(PSNPINST) S PSNPINST=$$GET1^DIQ(59,PSOSITE,101,""I"")"
^XMB(3.9,146012,2,499,0)="""RTN"",""PSOERRX0"",12,0)"
^XMB(3.9,146012,2,500,0)=" ;"
^XMB(3.9,146012,2,501,0)="""RTN"",""PSOERRX0"",13,0)"
^XMB(3.9,146012,2,502,0)=" S MTARR(""RR"")=""RXRENEWALREQUEST"",MTARR(""RE"")=""RXRENEWALRESPONSE"",MTARR(""N"")=""NEWRX(ALL)"",MTARR(""CR"")=""RXCHANGEREQUEST"""
^XMB(3.9,146012,2,503,0)="""RTN"",""PSOERRX0"",14,0)"
^XMB(3.9,146012,2,504,0)=" S MTARR(""RXF"")=""RXFILL"",MTARR(""IE"")=""INBOUND ERROR"",MTARR(""OE"")=""OUTBOUND ERROR"",MTARR(""CA"")=""CANCELRX"",MTARR(""CN"")=""CANCELRXRESPONSE"""
^XMB(3.9,146012,2,505,0)="""RTN"",""PSOERRX0"",15,0)"
^XMB(3.9,146012,2,506,0)=" S MTARR(""CX"")=""RXCHANGERESPONSE"",MTARR(""N"")=""NEWRX"""
^XMB(3.9,146012,2,507,0)="""RTN"",""PSOERRX0"",16,0)"
^XMB(3.9,146012,2,508,0)=" ; Loading User's preferences"
^XMB(3.9,146012,2,509,0)="""RTN"",""PSOERRX0"",17,0)"
^XMB(3.9,146012,2,510,0)=" D LOAD^PSOERPR1"
^XMB(3.9,146012,2,511,0)="""RTN"",""PSOERRX0"",18,0)"
^XMB(3.9,146012,2,512,0)=" W !,""Please wait..."""
^XMB(3.9,146012,2,513,0)="""RTN"",""PSOERRX0"",19,0)"
^XMB(3.9,146012,2,514,0)=" D EN^VALM(""PSO ERX ALL RXS QUEUE"")"
^XMB(3.9,146012,2,515,0)="""RTN"",""PSOERRX0"",20,0)"
^XMB(3.9,146012,2,516,0)=" ;"
^XMB(3.9,146012,2,517,0)="""RTN"",""PSOERRX0"",21,0)"
^XMB(3.9,146012,2,518,0)=" G EXIT"
^XMB(3.9,146012,2,519,0)="""RTN"",""PSOERRX0"",22,0)"
^XMB(3.9,146012,2,520,0)=" ;"
^XMB(3.9,146012,2,521,0)="""RTN"",""PSOERRX0"",23,0)"
^XMB(3.9,146012,2,522,0)="LMHDR ; ListMan Header Code"
^XMB(3.9,146012,2,523,0)="""RTN"",""PSOERRX0"",24,0)"
^XMB(3.9,146012,2,524,0)=" D SHOW^VALM,HDR^PSOERRX0"
^XMB(3.9,146012,2,525,0)="""RTN"",""PSOERRX0"",25,0)"
^XMB(3.9,146012,2,526,0)=" I $G(MBMSITE) S XQORM(""B"")=""Next Screen"""
^XMB(3.9,146012,2,527,0)="""RTN"",""PSOERRX0"",26,0)"
^XMB(3.9,146012,2,528,0)=" S XQORM(""#"")=$O(^ORD(101,""B"",""PSO ERX ALL RXS SELECT"",""""))_""^1:""_VALMCNT"
^XMB(3.9,146012,2,529,0)="""RTN"",""PSOERRX0"",27,0)"
^XMB(3.9,146012,2,530,0)=" S XQORM(""??"")=""D HELP^VALM2,HDR^PSOERRX0"""
^XMB(3.9,146012,2,531,0)="""RTN"",""PSOERRX0"",28,0)"
^XMB(3.9,146012,2,532,0)=" Q"
^XMB(3.9,146012,2,533,0)="""RTN"",""PSOERRX0"",29,0)"
^XMB(3.9,146012,2,534,0)=" ;"
^XMB(3.9,146012,2,535,0)="""RTN"",""PSOERRX0"",30,0)"
^XMB(3.9,146012,2,536,0)="HDR      ; - Builds the Header section"
^XMB(3.9,146012,2,537,0)="""RTN"",""PSOERRX0"",31,0)"
^XMB(3.9,146012,2,538,0)=" D HDR^PSOERRX1"
^XMB(3.9,146012,2,539,0)="""RTN"",""PSOERRX0"",32,0)"
^XMB(3.9,146012,2,540,0)=" Q"
^XMB(3.9,146012,2,541,0)="""RTN"",""PSOERRX0"",33,0)"
^XMB(3.9,146012,2,542,0)=" ;"
^XMB(3.9,146012,2,543,0)="""RTN"",""PSOERRX0"",34,0)"
^XMB(3.9,146012,2,544,0)="INIT ;Populates the Body section for ListMan"
^XMB(3.9,146012,2,545,0)="""RTN"",""PSOERRX0"",35,0)"
^XMB(3.9,146012,2,546,0)=" N LOCKPATS,PAT"
^XMB(3.9,146012,2,547,0)="""RTN"",""PSOERRX0"",36,0)"
^XMB(3.9,146012,2,548,0)=" K ^TMP(""PSOERRX0"",$J),^TMP(""PSOERRXS"",$J)"
^XMB(3.9,146012,2,549,0)="""RTN"",""PSOERRX0"",37,0)"
^XMB(3.9,146012,2,550,0)=" S PAT=0 F  S PAT=$O(^XTMP(""PSOERXLOCK"",PAT)) Q:'PAT  S LOCKPATS(PAT)=+$G(^XTMP(""PSOERXLOCK"",PAT))"
^XMB(3.9,146012,2,551,0)="""RTN"",""PSOERRX0"",38,0)"
^XMB(3.9,146012,2,552,0)=" D SETSORT^PSOERRX1(PSOSRTBY),SETLINE"
^XMB(3.9,146012,2,553,0)="""RTN"",""PSOERRX0"",39,0)"
^XMB(3.9,146012,2,554,0)=" S:$G(VALMSG)="""" VALMSG=""Select the entry # to view or ?? for more actions"""
^XMB(3.9,146012,2,555,0)="""RTN"",""PSOERRX0"",40,0)"
^XMB(3.9,146012,2,556,0)=" Q"
^XMB(3.9,146012,2,557,0)="""RTN"",""PSOERRX0"",41,0)"
^XMB(3.9,146012,2,558,0)=" ;"
^XMB(3.9,146012,2,559,0)="""RTN"",""PSOERRX0"",42,0)"
^XMB(3.9,146012,2,560,0)="SETLINE ;Sets the line to be displayed in ListMan"
^XMB(3.9,146012,2,561,0)="""RTN"",""PSOERRX0"",43,0)"
^XMB(3.9,146012,2,562,0)=" N SORT,TYPE,STS,SUB,SEQ,LINE,Z,Z1,TOTAL,I,X,X1,ORDCNT,LBL,LN,GROUP,QTYL,ORNUM1,ERXIEN1,HIGHLN,SORTORD"
^XMB(3.9,146012,2,563,0)="""RTN"",""PSOERRX0"",44,0)"
^XMB(3.9,146012,2,564,0)=" N X,POS"
^XMB(3.9,146012,2,565,0)="""RTN"",""PSOERRX0"",45,0)"
^XMB(3.9,146012,2,566,0)=" K ^TMP(""PSOERRX0"",$J)"
^XMB(3.9,146012,2,567,0)="""RTN"",""PSOERRX0"",46,0)"
^XMB(3.9,146012,2,568,0)=" I '$D(^TMP(""PSOERRXS"",$J)) D  Q"
^XMB(3.9,146012,2,569,0)="""RTN"",""PSOERRX0"",47,0)"
^XMB(3.9,146012,2,570,0)=" . F I=1:1:6 S ^TMP(""PSOERRX0"",$J,I,0)="""""
^XMB(3.9,146012,2,571,0)="""RTN"",""PSOERRX0"",48,0)"
^XMB(3.9,146012,2,572,0)=" . S ^TMP(""PSOERRX0"",$J,7,0)=""                    No prescriptions found."""
^XMB(3.9,146012,2,573,0)="""RTN"",""PSOERRX0"",49,0)"
^XMB(3.9,146012,2,574,0)=" . S VALMCNT=1"
^XMB(3.9,146012,2,575,0)="""RTN"",""PSOERRX0"",50,0)"
^XMB(3.9,146012,2,576,0)=" ;"
^XMB(3.9,146012,2,577,0)="""RTN"",""PSOERRX0"",51,0)"
^XMB(3.9,146012,2,578,0)=" ;Resetting list to NORMAL video attributes"
^XMB(3.9,146012,2,579,0)="""RTN"",""PSOERRX0"",52,0)"
^XMB(3.9,146012,2,580,0)=" D RESET^PSOERUT0() K GRPLN"
^XMB(3.9,146012,2,581,0)="""RTN"",""PSOERRX0"",53,0)"
^XMB(3.9,146012,2,582,0)=" ;"
^XMB(3.9,146012,2,583,0)="""RTN"",""PSOERRX0"",54,0)"
^XMB(3.9,146012,2,584,0)=" ;Building the list (line by line)"
^XMB(3.9,146012,2,585,0)="""RTN"",""PSOERRX0"",55,0)"
^XMB(3.9,146012,2,586,0)=" S (GROUP,SORT)="""",(SEQ,LINE)=0,SORTORD=$S(PSORDER=""A"":1,1:-1)"
^XMB(3.9,146012,2,587,0)="""RTN"",""PSOERRX0"",56,0)"
^XMB(3.9,146012,2,588,0)=" F  S GROUP=$O(^TMP(""PSOERRXS"",$J,GROUP)) Q:GROUP=""""  D"
^XMB(3.9,146012,2,589,0)="""RTN"",""PSOERRX0"",57,0)"
^XMB(3.9,146012,2,590,0)=" . I GROUP'=""ALL"" D"
^XMB(3.9,146012,2,591,0)="""RTN"",""PSOERRX0"",58,0)"
^XMB(3.9,146012,2,592,0)=" . . N LBL,POS,X"
^XMB(3.9,146012,2,593,0)="""RTN"",""PSOERRX0"",59,0)"
^XMB(3.9,146012,2,594,0)=" . . S LBL=$S(GROUP=""NON-CS"":""NON-"",1:"""")_""CONTROLLED SUBSTANCE Rx's"""
^XMB(3.9,146012,2,595,0)="""RTN"",""PSOERRX0"",60,0)"
^XMB(3.9,146012,2,596,0)=" . . S POS=41-($L(LBL)\2) S X="""",$P(X,"" "",81)="""",$E(X,POS,POS-1+$L(LBL))=LBL"
^XMB(3.9,146012,2,597,0)="""RTN"",""PSOERRX0"",61,0)"
^XMB(3.9,146012,2,598,0)=" . . S LINE=LINE+1,^TMP(""PSOERRX0"",$J,LINE,0)=X,GRPLN(LINE)=LBL"
^XMB(3.9,146012,2,599,0)="""RTN"",""PSOERRX0"",62,0)"
^XMB(3.9,146012,2,600,0)=" . F  S SORT=$O(^TMP(""PSOERRXS"",$J,GROUP,SORT),SORTORD) Q:SORT=""""  D"
^XMB(3.9,146012,2,601,0)="""RTN"",""PSOERRX0"",63,0)"
^XMB(3.9,146012,2,602,0)=" . . S Z=$G(^TMP(""PSOERRXS"",$J,GROUP,SORT)),SEQ=SEQ+1"
^XMB(3.9,146012,2,603,0)="""RTN"",""PSOERRX0"",64,0)"
^XMB(3.9,146012,2,604,0)=" . . S Z1=$G(^TMP(""PSOERRXS"",$J,GROUP,SORT,""ERXIEN"")),ERXIEN=+Z1"
^XMB(3.9,146012,2,605,0)="""RTN"",""PSOERRX0"",65,0)"
^XMB(3.9,146012,2,606,0)=" . . S X1=SEQ_$S(+$G(^PS(52.49,ERXIEN,95)):""]"",1:""."")"
^XMB(3.9,146012,2,607,0)="""RTN"",""PSOERRX0"",66,0)"
^XMB(3.9,146012,2,608,0)=" . . S $E(X1,$S(SEQ>999:6,1:5))=$E($P(Z,""^"",1),1,$S(SEQ>999:19,1:20)),$E(X1,26)=$P(Z,""^"",2)"
^XMB(3.9,146012,2,609,0)="""RTN"",""PSOERRX0"",67,0)"
^XMB(3.9,146012,2,610,0)=" . . I '$G(PSODETDP) S $E(X1,35)=$E($P(Z,""^"",3),1,21)"
^XMB(3.9,146012,2,611,0)="""RTN"",""PSOERRX0"",68,0)"
^XMB(3.9,146012,2,612,0)=" . . I $G(MBMSITE),$E($P(Z,""^"",5),1,3)=""REM"" S $P(Z,""^"",5)=""R""_$E($P(Z,""^"",5),4,9)"
^XMB(3.9,146012,2,613,0)="""RTN"",""PSOERRX0"",69,0)"
^XMB(3.9,146012,2,614,0)=" . . S $E(X1,57)=$E($P(Z,""^"",4),1,11),$E(X1,69)=$E($P(Z,""^"",5),1,3),$E(X1,73)=$P(Z,""^"",6)"
^XMB(3.9,146012,2,615,0)="""RTN"",""PSOERRX0"",70,0)"
^XMB(3.9,146012,2,616,0)=" . . S LINE=LINE+1,^TMP(""PSOERRX0"",$J,LINE,0)=X1,^TMP(""PSOERRX0"",$J,SEQ,""ERXIEN"")=ERXIEN"
^XMB(3.9,146012,2,617,0)="""RTN"",""PSOERRX0"",71,0)"
^XMB(3.9,146012,2,618,0)=" . . I $P(Z1,""^"",2) S HIGHLN(LINE)=1"
^XMB(3.9,146012,2,619,0)="""RTN"",""PSOERRX0"",72,0)"
^XMB(3.9,146012,2,620,0)=" . . I $G(PSODETDP) D SETDET^PSOERPT0(ERXIEN,.LINE,""PSOERRX0"")"
^XMB(3.9,146012,2,621,0)="""RTN"",""PSOERRX0"",73,0)"
^XMB(3.9,146012,2,622,0)=" ;"
^XMB(3.9,146012,2,623,0)="""RTN"",""PSOERRX0"",74,0)"
^XMB(3.9,146012,2,624,0)=" ;Saving NORMAL video attributes to be reset later"
^XMB(3.9,146012,2,625,0)="""RTN"",""PSOERRX0"",75,0)"
^XMB(3.9,146012,2,626,0)=" I LINE>$G(LASTLINE) D"
^XMB(3.9,146012,2,627,0)="""RTN"",""PSOERRX0"",76,0)"
^XMB(3.9,146012,2,628,0)=" . F I=($G(LASTLINE)+1):1:LINE D SAVE^VALM10(I)"
^XMB(3.9,146012,2,629,0)="""RTN"",""PSOERRX0"",77,0)"
^XMB(3.9,146012,2,630,0)=" . S LASTLINE=LINE"
^XMB(3.9,146012,2,631,0)="""RTN"",""PSOERRX0"",78,0)"
^XMB(3.9,146012,2,632,0)=" D VIDEO^PSOERPT1()"
^XMB(3.9,146012,2,633,0)="""RTN"",""PSOERRX0"",79,0)"
^XMB(3.9,146012,2,634,0)=" S VALMCNT=+$G(LINE) D RV^PSOPMP1"
^XMB(3.9,146012,2,635,0)="""RTN"",""PSOERRX0"",80,0)"
^XMB(3.9,146012,2,636,0)=" Q"
^XMB(3.9,146012,2,637,0)="""RTN"",""PSOERRX0"",81,0)"
^XMB(3.9,146012,2,638,0)=" ;"
^XMB(3.9,146012,2,639,0)="""RTN"",""PSOERRX0"",82,0)"
^XMB(3.9,146012,2,640,0)="FLTRMT(MSGTYPE) ; Filter By Message Type Action"
^XMB(3.9,146012,2,641,0)="""RTN"",""PSOERRX0"",83,0)"
^XMB(3.9,146012,2,642,0)=" S MSTPFLTR=MSGTYPE"
^XMB(3.9,146012,2,643,0)="""RTN"",""PSOERRX0"",84,0)"
^XMB(3.9,146012,2,644,0)=" D REF S VALMBCK=""R"",VALMBG=1"
^XMB(3.9,146012,2,645,0)="""RTN"",""PSOERRX0"",85,0)"
^XMB(3.9,146012,2,646,0)=" Q"
^XMB(3.9,146012,2,647,0)="""RTN"",""PSOERRX0"",86,0)"
^XMB(3.9,146012,2,648,0)=" ;"
^XMB(3.9,146012,2,649,0)="""RTN"",""PSOERRX0"",87,0)"
^XMB(3.9,146012,2,650,0)="CS ;Group/Un-group Controlled Substances"
^XMB(3.9,146012,2,651,0)="""RTN"",""PSOERRX0"",88,0)"
^XMB(3.9,146012,2,652,0)=" S PSOCSGRP=$S($G(PSOCSGRP):0,1:1) D REF"
^XMB(3.9,146012,2,653,0)="""RTN"",""PSOERRX0"",89,0)"
^XMB(3.9,146012,2,654,0)=" Q"
^XMB(3.9,146012,2,655,0)="""RTN"",""PSOERRX0"",90,0)"
^XMB(3.9,146012,2,656,0)=" ;"
^XMB(3.9,146012,2,657,0)="""RTN"",""PSOERRX0"",91,0)"
^XMB(3.9,146012,2,658,0)="DET ;Display/Remove DET"
^XMB(3.9,146012,2,659,0)="""RTN"",""PSOERRX0"",92,0)"
^XMB(3.9,146012,2,660,0)=" S PSODETDP=$S($G(PSODETDP):0,1:1),LINE=0 D REF"
^XMB(3.9,146012,2,661,0)="""RTN"",""PSOERRX0"",93,0)"
^XMB(3.9,146012,2,662,0)=" I 'PSODETDP S VALMBG=VALMBG\2"
^XMB(3.9,146012,2,663,0)="""RTN"",""PSOERRX0"",94,0)"
^XMB(3.9,146012,2,664,0)=" I PSODETDP S VALMBG=VALMBG*2-1"
^XMB(3.9,146012,2,665,0)="""RTN"",""PSOERRX0"",95,0)"
^XMB(3.9,146012,2,666,0)=" S:VALMBG>(VALMCNT-10) VALMBG=VALMCNT-10 S:VALMBG<1 VALMBG=1"
^XMB(3.9,146012,2,667,0)="""RTN"",""PSOERRX0"",96,0)"
^XMB(3.9,146012,2,668,0)=" Q"
^XMB(3.9,146012,2,669,0)="""RTN"",""PSOERRX0"",97,0)"
^XMB(3.9,146012,2,670,0)=" ;"
^XMB(3.9,146012,2,671,0)="""RTN"",""PSOERRX0"",98,0)"
^XMB(3.9,146012,2,672,0)="CV ;Change View"
^XMB(3.9,146012,2,673,0)="""RTN"",""PSOERRX0"",99,0)"
^XMB(3.9,146012,2,674,0)=" D EN^PSOERPR1 I $G(PSORFRSH) D REF S VALMBG=1"
^XMB(3.9,146012,2,675,0)="""RTN"",""PSOERRX0"",100,0)"
^XMB(3.9,146012,2,676,0)=" S VALMBCK=""R"""
^XMB(3.9,146012,2,677,0)="""RTN"",""PSOERRX0"",101,0)"
^XMB(3.9,146012,2,678,0)=" Q"
^XMB(3.9,146012,2,679,0)="""RTN"",""PSOERRX0"",102,0)"
^XMB(3.9,146012,2,680,0)=" ;"
^XMB(3.9,146012,2,681,0)="""RTN"",""PSOERRX0"",103,0)"
^XMB(3.9,146012,2,682,0)="SORT(FIELD) ;Sort entries by FIELD"
^XMB(3.9,146012,2,683,0)="""RTN"",""PSOERRX0"",104,0)"
^XMB(3.9,146012,2,684,0)=" I PSOSRTBY=FIELD S PSORDER=$S(PSORDER=""A"":""D"",1:""A"")"
^XMB(3.9,146012,2,685,0)="""RTN"",""PSOERRX0"",105,0)"
^XMB(3.9,146012,2,686,0)=" E  S PSOSRTBY=FIELD,PSORDER=""A"""
^XMB(3.9,146012,2,687,0)="""RTN"",""PSOERRX0"",106,0)"
^XMB(3.9,146012,2,688,0)=" D REF"
^XMB(3.9,146012,2,689,0)="""RTN"",""PSOERRX0"",107,0)"
^XMB(3.9,146012,2,690,0)=" Q"
^XMB(3.9,146012,2,691,0)="""RTN"",""PSOERRX0"",108,0)"
^XMB(3.9,146012,2,692,0)=" ;"
^XMB(3.9,146012,2,693,0)="""RTN"",""PSOERRX0"",109,0)"
^XMB(3.9,146012,2,694,0)="LBD ;Change Look Back Days Parameter Action"
^XMB(3.9,146012,2,695,0)="""RTN"",""PSOERRX0"",110,0)"
^XMB(3.9,146012,2,696,0)=" D FULL^VALM1 S VALMBCK=""R"""
^XMB(3.9,146012,2,697,0)="""RTN"",""PSOERRX0"",111,0)"
^XMB(3.9,146012,2,698,0)=" W ! K DIR,DIRUT,DIROUT,SAVEX,DA"
^XMB(3.9,146012,2,699,0)="""RTN"",""PSOERRX0"",112,0)"
^XMB(3.9,146012,2,700,0)=" S DIR(0)=""52.353,1"",DIR(""B"")=PSOLKBKD"
^XMB(3.9,146012,2,701,0)="""RTN"",""PSOERRX0"",113,0)"
^XMB(3.9,146012,2,702,0)=" D ^DIR I $D(DIRUT)!$D(DIROUT) Q"
^XMB(3.9,146012,2,703,0)="""RTN"",""PSOERRX0"",114,0)"
^XMB(3.9,146012,2,704,0)=" S PSOLKBKD=Y,RESETLBD=0 D REF S VALMBG=1"
^XMB(3.9,146012,2,705,0)="""RTN"",""PSOERRX0"",115,0)"
^XMB(3.9,146012,2,706,0)=" Q"
^XMB(3.9,146012,2,707,0)="""RTN"",""PSOERRX0"",116,0)"
^XMB(3.9,146012,2,708,0)=" ;"
^XMB(3.9,146012,2,709,0)="""RTN"",""PSOERRX0"",117,0)"
^XMB(3.9,146012,2,710,0)="PC ;Patient Centri View Switch"
^XMB(3.9,146012,2,711,0)="""RTN"",""PSOERRX0"",118,0)"
^XMB(3.9,146012,2,712,0)=" D EN^PSOERPC0 S VALMBCK=""Q"""
^XMB(3.9,146012,2,713,0)="""RTN"",""PSOERRX0"",119,0)"
^XMB(3.9,146012,2,714,0)=" Q"
^XMB(3.9,146012,2,715,0)="""RTN"",""PSOERRX0"",120,0)"
^XMB(3.9,146012,2,716,0)=" ;"
^XMB(3.9,146012,2,717,0)="""RTN"",""PSOERRX0"",121,0)"
^XMB(3.9,146012,2,718,0)="SEL ;Process selection of one entry"
^XMB(3.9,146012,2,719,0)="""RTN"",""PSOERRX0"",122,0)"
^XMB(3.9,146012,2,720,0)=" N PSOSEL,ERXIEN,ERXPTIEN"
^XMB(3.9,146012,2,721,0)="""RTN"",""PSOERRX0"",123,0)"
^XMB(3.9,146012,2,722,0)=" S VALMBCK=""R"""
^XMB(3.9,146012,2,723,0)="""RTN"",""PSOERRX0"",124,0)"
^XMB(3.9,146012,2,724,0)=" S PSOSEL=+$P(XQORNOD(0),""="",2) I 'PSOSEL S VALMSG=""Invalid selection!"" Q"
^XMB(3.9,146012,2,725,0)="""RTN"",""PSOERRX0"",125,0)"
^XMB(3.9,146012,2,726,0)=" S ERXIEN=$G(^TMP(""PSOERRX0"",$J,PSOSEL,""ERXIEN"")) I 'ERXIEN S VALMSG=""Invalid selection!"" Q"
^XMB(3.9,146012,2,727,0)="""RTN"",""PSOERRX0"",126,0)"
^XMB(3.9,146012,2,728,0)=" S ERXPTIEN=$$GETPAT^PSOERXU5(ERXIEN)"
^XMB(3.9,146012,2,729,0)="""RTN"",""PSOERRX0"",127,0)"
^XMB(3.9,146012,2,730,0)=" ; - Locking the eRx Patient"
^XMB(3.9,146012,2,731,0)="""RTN"",""PSOERRX0"",128,0)"
^XMB(3.9,146012,2,732,0)=" I ERXPTIEN,'$$LOCK^PSOERPC1(ERXPTIEN) Q"
^XMB(3.9,146012,2,733,0)="""RTN"",""PSOERRX0"",129,0)"
^XMB(3.9,146012,2,734,0)=" ; - Entering the eRx Record"
^XMB(3.9,146012,2,735,0)="""RTN"",""PSOERRX0"",130,0)"
^XMB(3.9,146012,2,736,0)=" D EN^PSOERX1(ERXIEN) K ERXIEN"
^XMB(3.9,146012,2,737,0)="""RTN"",""PSOERRX0"",131,0)"
^XMB(3.9,146012,2,738,0)=" ; - Unlocking the eRx Patient"
^XMB(3.9,146012,2,739,0)="""RTN"",""PSOERRX0"",132,0)"
^XMB(3.9,146012,2,740,0)=" I ERXPTIEN D UL^PSOERX1A(ERXPTIEN)"
^XMB(3.9,146012,2,741,0)="""RTN"",""PSOERRX0"",133,0)"
^XMB(3.9,146012,2,742,0)=" I $G(PSORFRSH) D REF"
^XMB(3.9,146012,2,743,0)="""RTN"",""PSOERRX0"",134,0)"
^XMB(3.9,146012,2,744,0)=" Q"
^XMB(3.9,146012,2,745,0)="""RTN"",""PSOERRX0"",135,0)"
^XMB(3.9,146012,2,746,0)=" ;"
^XMB(3.9,146012,2,747,0)="""RTN"",""PSOERRX0"",136,0)"
^XMB(3.9,146012,2,748,0)="SQ ; - Search Queue Entry Point"
^XMB(3.9,146012,2,749,0)="""RTN"",""PSOERRX0"",137,0)"
^XMB(3.9,146012,2,750,0)=" D FULL^VALM1 S VALMBCK=""R"""
^XMB(3.9,146012,2,751,0)="""RTN"",""PSOERRX0"",138,0)"
^XMB(3.9,146012,2,752,0)=" N DIR,DUOUT,DIRUT,Y,X,CHANGE,ERXLOCK,ERXPTIEN,PSOFPICK"
^XMB(3.9,146012,2,753,0)="""RTN"",""PSOERRX0"",139,0)"
^XMB(3.9,146012,2,754,0)=" S CHANGE=0"
^XMB(3.9,146012,2,755,0)="""RTN"",""PSOERRX0"",140,0)"
^XMB(3.9,146012,2,756,0)="REP ; Re-Entry Point"
^XMB(3.9,146012,2,757,0)="""RTN"",""PSOERRX0"",141,0)"
^XMB(3.9,146012,2,758,0)=" K DIR S DIR(""?"",1)=""Choose one or multiple filter criteria(s) to sort the current list."""
^XMB(3.9,146012,2,759,0)="""RTN"",""PSOERRX0"",142,0)"
^XMB(3.9,146012,2,760,0)=" S DIR(""?"",2)=""To remove an existing filter type ^#, where '#' is the filter number below."""
^XMB(3.9,146012,2,761,0)="""RTN"",""PSOERRX0"",143,0)"
^XMB(3.9,146012,2,762,0)=" S DIR(""?"")="" """
^XMB(3.9,146012,2,763,0)="""RTN"",""PSOERRX0"",144,0)"
^XMB(3.9,146012,2,764,0)=" S DIR(""A"")=""SEARCH BY"""
^XMB(3.9,146012,2,765,0)="""RTN"",""PSOERRX0"",145,0)"
^XMB(3.9,146012,2,766,0)=" S DIR(0)=""SO^1:ERX PATIENT"" I $D(PATFLTR) S DIR(0)=DIR(0)_"" ""_IOINHI_""(""_$$EPATFLST^PSOERUT(44)_"")""_IOINORM"
^XMB(3.9,146012,2,767,0)="""RTN"",""PSOERRX0"",146,0)"
^XMB(3.9,146012,2,768,0)=" S DIR(0)=DIR(0)_"";2:ERX DATE OF BIRTH"" I $G(DOBFLTR) S DIR(0)=DIR(0)_"" ""_IOINHI_""(""_$$FMTE^XLFDT(DOBFLTR,""2Z"")_"")""_IOINORM"
^XMB(3.9,146012,2,769,0)="""RTN"",""PSOERRX0"",147,0)"
^XMB(3.9,146012,2,770,0)=" S DIR(0)=DIR(0)_"";3:RECEIVED DATE RANGE"" I $G(REDTFLTR) S DIR(0)=DIR(0)_IOINHI_"" (""_$$FMTE^XLFDT(+REDTFLTR,""2Z"")_"" TO ""_$$FMTE^XLFDT($P(REDTFLTR,""^"",2),""2Z"")_"")""_IOINORM"
^XMB(3.9,146012,2,771,0)="""RTN"",""PSOERRX0"",148,0)"
^XMB(3.9,146012,2,772,0)=" S DIR(0)=DIR(0)_"";4:ERX PROVIDER"" I $D(PRVFLTR) S DIR(0)=DIR(0)_"" ""_IOINHI_""(""_$$EPRVFLST^PSOERUT(44)_"")""_IOINORM"
^XMB(3.9,146012,2,773,0)="""RTN"",""PSOERRX0"",149,0)"
^XMB(3.9,146012,2,774,0)=" S DIR(0)=DIR(0)_"";5:ERX STATUS"" I $G(STSFLTR) S DIR(0)=DIR(0)_"" ""_IOINHI_""(""_$S($G(STSFLTR1)'="""":STSFLTR1,1:$$GET1^DIQ(52.45,+STSFLTR,.01))_"")""_IOINORM"
^XMB(3.9,146012,2,775,0)="""RTN"",""PSOERRX0"",150,0)"
^XMB(3.9,146012,2,776,0)=" S DIR(0)=DIR(0)_"";6:ERX DRUG NAME"" I $G(DRGFLTR)'="""" S DIR(0)=DIR(0)_"" ""_IOINHI_""('""_DRGFLTR_""')""_IOINORM"
^XMB(3.9,146012,2,777,0)="""RTN"",""PSOERRX0"",151,0)"
^XMB(3.9,146012,2,778,0)=" S DIR(0)=DIR(0)_"";7:MESSAGE TYPE"" I $G(MSTPFLTR)'="""" S DIR(0)=DIR(0)_"" ""_IOINHI_""(""_$S($G(MSTPFLTR1)'="""":MSTPFLTR1,1:MTARR(MSTPFLTR))_"")""_IOINORM"
^XMB(3.9,146012,2,779,0)="""RTN"",""PSOERRX0"",152,0)"
^XMB(3.9,146012,2,780,0)=" S DIR(0)=DIR(0)_"";8:ERX REFERENCE NUMBER"""
^XMB(3.9,146012,2,781,0)="""RTN"",""PSOERRX0"",153,0)"
^XMB(3.9,146012,2,782,0)=" S DIR(0)=DIR(0)_"";9:VISTA RX #"""
^XMB(3.9,146012,2,783,0)="""RTN"",""PSOERRX0"",154,0)"
^XMB(3.9,146012,2,784,0)=" S DIR(0)=DIR(0)_"";10:VISTA PATIENT"" I $D(VPATFLTR) S DIR(0)=DIR(0)_"" ""_IOINHI_""(""_$$VPATFLST^PSOERUT(44)_"")""_IOINORM"
^XMB(3.9,146012,2,785,0)="""RTN"",""PSOERRX0"",155,0)"
^XMB(3.9,146012,2,786,0)=" S DIR(0)=DIR(0)_"";11:VISTA PROVIDER"" I $D(VPRVFLTR) S DIR(0)=DIR(0)_"" ""_IOINHI_""(""_$$VPRVFLST^PSOERUT(44)_"")""_IOINORM"
^XMB(3.9,146012,2,787,0)="""RTN"",""PSOERRX0"",156,0)"
^XMB(3.9,146012,2,788,0)=" S DIR(0)=DIR(0)_"";12:MATCH STATUS"" I $G(MATFLTR) S DIR(0)=DIR(0)_"" ""_IOINHI_""(""_$$MATCHLBL^PSOERPC2(MATFLTR)_"")""_IOINORM"
^XMB(3.9,146012,2,789,0)="""RTN"",""PSOERRX0"",157,0)"
^XMB(3.9,146012,2,790,0)=" S DIR(0)=DIR(0)_"";13:VISTA DRUG"" I $G(VDRGFLTR) S DIR(0)=DIR(0)_"" ""_IOINHI_""(""_$E($$GET1^DIQ(50,VDRGFLTR,.01),1,44)_"")""_IOINORM"
^XMB(3.9,146012,2,791,0)="""RTN"",""PSOERRX0"",158,0)"
^XMB(3.9,146012,2,792,0)=" D ^DIR"
^XMB(3.9,146012,2,793,0)="""RTN"",""PSOERRX0"",159,0)"
^XMB(3.9,146012,2,794,0)=" I X'=""^"",X?1""^"".N D  G REP"
^XMB(3.9,146012,2,795,0)="""RTN"",""PSOERRX0"",160,0)"
^XMB(3.9,146012,2,796,0)=" . K:X=""^1"" PATFLTR,VPATFLTR K:X=""^2"" DOBFLTR K:X=""^3"" REDTFLTR K:X=""^4"" PRVFLTR,VPRVFLTR K:X=""^5"" STSFLTR,STSFLTR1"
^XMB(3.9,146012,2,797,0)="""RTN"",""PSOERRX0"",161,0)"
^XMB(3.9,146012,2,798,0)=" . K:X=""^6"" DRGFLTR K:X=""^7"" MSTPFLTR,MSTPFLTR1 K:X=""^10"" PATFLTR,VPATFLTR K:X=""^11"" PRVFLTR,VPRVFLTR K:X=""^12"" MATFLTR K:X=""^13"" VDRGFLTR"
^XMB(3.9,146012,2,799,0)="""RTN"",""PSOERRX0"",162,0)"
^XMB(3.9,146012,2,800,0)=" . S CHANGE=1"
^XMB(3.9,146012,2,801,0)="""RTN"",""PSOERRX0"",163,0)"
^XMB(3.9,146012,2,802,0)=" I X=""""!$D(DUOUT)!($D(DIRUT)) D:CHANGE REF S:CHANGE VALMBG=1 Q"
^XMB(3.9,146012,2,803,0)="""RTN"",""PSOERRX0"",164,0)"
^XMB(3.9,146012,2,804,0)=" S PSOFPICK=+$G(Y)"
^XMB(3.9,146012,2,805,0)="""RTN"",""PSOERRX0"",165,0)"
^XMB(3.9,146012,2,806,0)=" I PSOFPICK=1 D EPATFLTR^PSOERPC0 S PSOALLST=1,CHANGE=1 G REP"
^XMB(3.9,146012,2,807,0)="""RTN"",""PSOERRX0"",166,0)"
^XMB(3.9,146012,2,808,0)=" I PSOFPICK=2 D DOBFLTR^PSOERPC0 S PSOALLST=1,CHANGE=1 G REP"
^XMB(3.9,146012,2,809,0)="""RTN"",""PSOERRX0"",167,0)"
^XMB(3.9,146012,2,810,0)=" I PSOFPICK=3 D REDTFLTR S CHANGE=1 G REP"
^XMB(3.9,146012,2,811,0)="""RTN"",""PSOERRX0"",168,0)"
^XMB(3.9,146012,2,812,0)=" I PSOFPICK=4 D PRVFLTR S PSOALLST=1,CHANGE=1 G REP"
^XMB(3.9,146012,2,813,0)="""RTN"",""PSOERRX0"",169,0)"
^XMB(3.9,146012,2,814,0)=" I PSOFPICK=5 D STSFLTR S CHANGE=1 G REP"
^XMB(3.9,146012,2,815,0)="""RTN"",""PSOERRX0"",170,0)"
^XMB(3.9,146012,2,816,0)=" I PSOFPICK=6 D DRGFLTR S PSOALLST=1,CHANGE=1 G REP"
^XMB(3.9,146012,2,817,0)="""RTN"",""PSOERRX0"",171,0)"
^XMB(3.9,146012,2,818,0)=" I PSOFPICK=7 D MSTPFLTR S CHANGE=1 G REP"
^XMB(3.9,146012,2,819,0)="""RTN"",""PSOERRX0"",172,0)"
^XMB(3.9,146012,2,820,0)=" I PSOFPICK=8 D ERXFLTR^PSOERPC0 G:'$G(ERXFLTR) REP D  I '$G(CHANGE) Q"
^XMB(3.9,146012,2,821,0)="""RTN"",""PSOERRX0"",173,0)"
^XMB(3.9,146012,2,822,0)=" . ; - Entering the eRx Record"
^XMB(3.9,146012,2,823,0)="""RTN"",""PSOERRX0"",174,0)"
^XMB(3.9,146012,2,824,0)=" . D EN^PSOERX1(ERXFLTR)"
^XMB(3.9,146012,2,825,0)="""RTN"",""PSOERRX0"",175,0)"
^XMB(3.9,146012,2,826,0)=" . ; - Unlocking the eRx Patient"
^XMB(3.9,146012,2,827,0)="""RTN"",""PSOERRX0"",176,0)"
^XMB(3.9,146012,2,828,0)=" . S ERXPTIEN=$$GET1^DIQ(52.49,ERXFLTR,.04,""I"") Q:'ERXPTIEN"
^XMB(3.9,146012,2,829,0)="""RTN"",""PSOERRX0"",177,0)"
^XMB(3.9,146012,2,830,0)=" . D UL^PSOERX1A(ERXPTIEN)"
^XMB(3.9,146012,2,831,0)="""RTN"",""PSOERRX0"",178,0)"
^XMB(3.9,146012,2,832,0)=" . S CHANGE=1"
^XMB(3.9,146012,2,833,0)="""RTN"",""PSOERRX0"",179,0)"
^XMB(3.9,146012,2,834,0)=" I PSOFPICK=9 D RXFLTR^PSOERPC0 G:'$G(ERXFLTR) REP D  I '$G(CHANGE) Q"
^XMB(3.9,146012,2,835,0)="""RTN"",""PSOERRX0"",180,0)"
^XMB(3.9,146012,2,836,0)=" . ; - Entering the eRx Record"
^XMB(3.9,146012,2,837,0)="""RTN"",""PSOERRX0"",181,0)"
^XMB(3.9,146012,2,838,0)=" . D EN^PSOERX1(ERXFLTR)"
^XMB(3.9,146012,2,839,0)="""RTN"",""PSOERRX0"",182,0)"
^XMB(3.9,146012,2,840,0)=" . ; - Unlocking the eRx Patient"
^XMB(3.9,146012,2,841,0)="""RTN"",""PSOERRX0"",183,0)"
^XMB(3.9,146012,2,842,0)=" . S ERXPTIEN=$$GET1^DIQ(52.49,ERXFLTR,.04,""I"") Q:'ERXPTIEN"
^XMB(3.9,146012,2,843,0)="""RTN"",""PSOERRX0"",184,0)"
^XMB(3.9,146012,2,844,0)=" . D UL^PSOERX1A(ERXPTIEN)"
^XMB(3.9,146012,2,845,0)="""RTN"",""PSOERRX0"",185,0)"
^XMB(3.9,146012,2,846,0)=" . S CHANGE=1"
^XMB(3.9,146012,2,847,0)="""RTN"",""PSOERRX0"",186,0)"
^XMB(3.9,146012,2,848,0)=" I PSOFPICK=10 D VPATFLTR^PSOERPC0 S PSOALLST=1,CHANGE=1 G REP"
^XMB(3.9,146012,2,849,0)="""RTN"",""PSOERRX0"",187,0)"
^XMB(3.9,146012,2,850,0)=" I PSOFPICK=11 D VPRVFLTR^PSOERRX1 S PSOALLST=1,CHANGE=1 G REP"
^XMB(3.9,146012,2,851,0)="""RTN"",""PSOERRX0"",188,0)"
^XMB(3.9,146012,2,852,0)=" I PSOFPICK=12 D MATFLTR^PSOERPC0 S CHANGE=1 G REP"
^XMB(3.9,146012,2,853,0)="""RTN"",""PSOERRX0"",189,0)"
^XMB(3.9,146012,2,854,0)=" I PSOFPICK=13 D VDRGFLTR^PSOERRX1 S PSOALLST=1,CHANGE=1 G REP"
^XMB(3.9,146012,2,855,0)="""RTN"",""PSOERRX0"",190,0)"
^XMB(3.9,146012,2,856,0)=" D REF S VALMBG=1"
^XMB(3.9,146012,2,857,0)="""RTN"",""PSOERRX0"",191,0)"
^XMB(3.9,146012,2,858,0)=" Q "
^XMB(3.9,146012,2,859,0)="""RTN"",""PSOERRX0"",192,0)"
^XMB(3.9,146012,2,860,0)=" ;"
^XMB(3.9,146012,2,861,0)="""RTN"",""PSOERRX0"",193,0)"
^XMB(3.9,146012,2,862,0)="REDTFLTR ; - Received Date Range Filter"
^XMB(3.9,146012,2,863,0)="""RTN"",""PSOERRX0"",194,0)"
^XMB(3.9,146012,2,864,0)=" N %DT,PSOFROM,PSOTO,Y,DTOUT,DIROUT"
^XMB(3.9,146012,2,865,0)="""RTN"",""PSOERRX0"",195,0)"
^XMB(3.9,146012,2,866,0)=" S %DT(0)=-DT,%DT=""AEP"",%DT(""A"")=""BEGIN DATE: """
^XMB(3.9,146012,2,867,0)="""RTN"",""PSOERRX0"",196,0)"
^XMB(3.9,146012,2,868,0)=" S %DT(""B"")=""T-45"" I $P($G(REDTFLTR),""^"") S %DT(""B"")=$$FMTE^XLFDT($P($G(REDTFLTR),""^""),""5Z"")"
^XMB(3.9,146012,2,869,0)="""RTN"",""PSOERRX0"",197,0)"
^XMB(3.9,146012,2,870,0)=" W ! D ^%DT I Y<0!($D(DTOUT)) Q"
^XMB(3.9,146012,2,871,0)="""RTN"",""PSOERRX0"",198,0)"
^XMB(3.9,146012,2,872,0)=" S PSOFROM=Y\1"
^XMB(3.9,146012,2,873,0)="""RTN"",""PSOERRX0"",199,0)"
^XMB(3.9,146012,2,874,0)=" ;"
^XMB(3.9,146012,2,875,0)="""RTN"",""PSOERRX0"",200,0)"
^XMB(3.9,146012,2,876,0)=" K %DT S %DT(0)=PSOFROM\1,%DT=""AEP"",%DT(""A"")=""END DATE: """
^XMB(3.9,146012,2,877,0)="""RTN"",""PSOERRX0"",201,0)"
^XMB(3.9,146012,2,878,0)=" S %DT(""B"")=""TODAY"" I $P($G(REDTFLTR),""^"",2) S %DT(""B"")=$$FMTE^XLFDT($P($G(REDTFLTR),""^"",2),""5Z"")"
^XMB(3.9,146012,2,879,0)="""RTN"",""PSOERRX0"",202,0)"
^XMB(3.9,146012,2,880,0)=" W ! D ^%DT I Y<0!($D(DTOUT)) Q"
^XMB(3.9,146012,2,881,0)="""RTN"",""PSOERRX0"",203,0)"
^XMB(3.9,146012,2,882,0)=" S PSOTO=Y\1"
^XMB(3.9,146012,2,883,0)="""RTN"",""PSOERRX0"",204,0)"
^XMB(3.9,146012,2,884,0)=" ;"
