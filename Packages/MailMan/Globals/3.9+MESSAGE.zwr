^XMB(3.9,146098,2,877,0)="""RTN"",""SDES2APTLETTER"",117,0)"
^XMB(3.9,146098,2,878,0)=" ;"
^XMB(3.9,146098,2,879,0)="""RTN"",""SDES2APTLETTER"",118,0)"
^XMB(3.9,146098,2,880,0)=" ;"
^XMB(3.9,146098,2,881,0)="""RTN"",""SDES2APTLETTER"",119,0)"
^XMB(3.9,146098,2,882,0)="PRT(DFN,SDC,SD,LT,SDLET,SDFORM) ;"
^XMB(3.9,146098,2,883,0)="""RTN"",""SDES2APTLETTER"",120,0)"
^XMB(3.9,146098,2,884,0)=" ;  DFN - pointer to PATIENT file 2"
^XMB(3.9,146098,2,885,0)="""RTN"",""SDES2APTLETTER"",121,0)"
^XMB(3.9,146098,2,886,0)=" ;  SDC - pointer to HOSPITAL LOCATION file 44"
^XMB(3.9,146098,2,887,0)="""RTN"",""SDES2APTLETTER"",122,0)"
^XMB(3.9,146098,2,888,0)=" ;  SD  - appointment time in FM format"
^XMB(3.9,146098,2,889,0)="""RTN"",""SDES2APTLETTER"",123,0)"
^XMB(3.9,146098,2,890,0)=" ;  LT  - Letter type - ""N""=No Show; ""P""=Pre-Appointment; ""A""=Cancelled by Patient; ""C""=Cancelled by Clinic"
^XMB(3.9,146098,2,891,0)="""RTN"",""SDES2APTLETTER"",124,0)"
^XMB(3.9,146098,2,892,0)=" ;  SDLET - pointer to LETTER file 407.5"
^XMB(3.9,146098,2,893,0)="""RTN"",""SDES2APTLETTER"",125,0)"
^XMB(3.9,146098,2,894,0)=" ;  SDFORM - address location on letters (1 - bottom, 0 - top)"
^XMB(3.9,146098,2,895,0)="""RTN"",""SDES2APTLETTER"",126,0)"
^XMB(3.9,146098,2,896,0)=" ;WRITE GREETING AND OPENING TEXT OF LETTER"
^XMB(3.9,146098,2,897,0)="""RTN"",""SDES2APTLETTER"",127,0)"
^XMB(3.9,146098,2,898,0)=" N DPTNAME,INITSEC,X,Y"
^XMB(3.9,146098,2,899,0)="""RTN"",""SDES2APTLETTER"",128,0)"
^XMB(3.9,146098,2,900,0)=" Q:DFN="""""
^XMB(3.9,146098,2,901,0)="""RTN"",""SDES2APTLETTER"",129,0)"
^XMB(3.9,146098,2,902,0)=" Q:LT="""""
^XMB(3.9,146098,2,903,0)="""RTN"",""SDES2APTLETTER"",130,0)"
^XMB(3.9,146098,2,904,0)=" S SDFORM=$G(SDFORM)"
^XMB(3.9,146098,2,905,0)="""RTN"",""SDES2APTLETTER"",131,0)"
^XMB(3.9,146098,2,906,0)=" S Y=DT"
^XMB(3.9,146098,2,907,0)="""RTN"",""SDES2APTLETTER"",132,0)"
^XMB(3.9,146098,2,908,0)=" S Y=$TR($$FMTE^XLFDT(Y,""5DF""),"" "",""0"")"
^XMB(3.9,146098,2,909,0)="""RTN"",""SDES2APTLETTER"",133,0)"
^XMB(3.9,146098,2,910,0)=" S SDECI=SDECI+1 S ^TMP(""SDEC_COMP"",$J,""topSection"",SDECI)=$$FILL(64,"" "")_Y"
^XMB(3.9,146098,2,911,0)="""RTN"",""SDES2APTLETTER"",134,0)"
^XMB(3.9,146098,2,912,0)=" S SDECI=SDECI+1 S ^TMP(""SDEC_COMP"",$J,""topSection"",SDECI)=$$FILL(64,"" "")_$$LILAST4(DFN)"
^XMB(3.9,146098,2,913,0)="""RTN"",""SDES2APTLETTER"",135,0)"
^XMB(3.9,146098,2,914,0)=" I 'SDFORM D ADDR(DFN)"
^XMB(3.9,146098,2,915,0)="""RTN"",""SDES2APTLETTER"",136,0)"
^XMB(3.9,146098,2,916,0)=" ;"
^XMB(3.9,146098,2,917,0)="""RTN"",""SDES2APTLETTER"",137,0)"
^XMB(3.9,146098,2,918,0)=" S DPTNAME(""FILE"")=2,DPTNAME(""FIELD"")="".01"",DPTNAME(""IENS"")=(+DFN)_"","""
^XMB(3.9,146098,2,919,0)="""RTN"",""SDES2APTLETTER"",138,0)"
^XMB(3.9,146098,2,920,0)=" S X=$$NAMEFMT^XLFNAME(.DPTNAME,""G"",""M"")"
^XMB(3.9,146098,2,921,0)="""RTN"",""SDES2APTLETTER"",139,0)"
^XMB(3.9,146098,2,922,0)=" S SDECI=SDECI+1 S ^TMP(""SDEC_COMP"",$J,""salutation"",SDECI)=""Dear ""_X_"","" ;VSE-693;LEG 5/12/21"
^XMB(3.9,146098,2,923,0)="""RTN"",""SDES2APTLETTER"",140,0)"
^XMB(3.9,146098,2,924,0)=" ;loop and display initial section of Letter"
^XMB(3.9,146098,2,925,0)="""RTN"",""SDES2APTLETTER"",141,0)"
^XMB(3.9,146098,2,926,0)=" S INITSEC=0 F  S INITSEC=$O(^VA(407.5,SDLET,1,INITSEC)) Q:INITSEC'>0  D"
^XMB(3.9,146098,2,927,0)="""RTN"",""SDES2APTLETTER"",142,0)"
^XMB(3.9,146098,2,928,0)=" . S SDECI=SDECI+1,^TMP(""SDEC_COMP"",$J,""initialParagraph"",SDECI)=$$GET1^DIQ(407.52,INITSEC_"",""_SDLET_"","",.01,""E"")"
^XMB(3.9,146098,2,929,0)="""RTN"",""SDES2APTLETTER"",143,0)"
^XMB(3.9,146098,2,930,0)=" Q"
^XMB(3.9,146098,2,931,0)="""RTN"",""SDES2APTLETTER"",144,0)"
^XMB(3.9,146098,2,932,0)=" ;"
^XMB(3.9,146098,2,933,0)="""RTN"",""SDES2APTLETTER"",145,0)"
^XMB(3.9,146098,2,934,0)="WRAPP(DFN,SDC,SD,LT,SDLET) ;WRITE APPOINTMENT INFORMATION"
^XMB(3.9,146098,2,935,0)="""RTN"",""SDES2APTLETTER"",146,0)"
^XMB(3.9,146098,2,936,0)=" N SDCL,SDDAT,SDHX,SDX,SDX1,X,PTAPPIENS"
^XMB(3.9,146098,2,937,0)="""RTN"",""SDES2APTLETTER"",147,0)"
^XMB(3.9,146098,2,938,0)=" S SDX=SD"
^XMB(3.9,146098,2,939,0)="""RTN"",""SDES2APTLETTER"",148,0)"
^XMB(3.9,146098,2,940,0)=" S SDCL=$$GET1^DIQ(44,+SDC,.01,""E"")"
^XMB(3.9,146098,2,941,0)="""RTN"",""SDES2APTLETTER"",149,0)"
^XMB(3.9,146098,2,942,0)=" S SDCL=""    Clinic:  ""_SDCL D FORM(SDC,SDCL,SDX,,SDLET) ; SD*5.3*622 end changes"
^XMB(3.9,146098,2,943,0)="""RTN"",""SDES2APTLETTER"",150,0)"
^XMB(3.9,146098,2,944,0)=" S SDX1=SDX"
^XMB(3.9,146098,2,945,0)="""RTN"",""SDES2APTLETTER"",151,0)"
^XMB(3.9,146098,2,946,0)=" S PTAPPIENS=SD_"",""_DFN_"","""
^XMB(3.9,146098,2,947,0)="""RTN"",""SDES2APTLETTER"",152,0)"
^XMB(3.9,146098,2,948,0)=" I $$GET1^DIQ(2.98,PTAPPIENS,5,""I"")]"""" D"
^XMB(3.9,146098,2,949,0)="""RTN"",""SDES2APTLETTER"",153,0)"
^XMB(3.9,146098,2,950,0)=" .S SDCL=""LAB"",SDX=$$GET1^DIQ(2.98,PTAPPIENS,5,""I"") D FORM(SDC,SDCL,SDX,1)"
^XMB(3.9,146098,2,951,0)="""RTN"",""SDES2APTLETTER"",154,0)"
