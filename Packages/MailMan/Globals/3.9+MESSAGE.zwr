^XMB(3.9,146056,2,2625,0)="""RTN"",""VPRSDAP"",172,0)"
^XMB(3.9,146056,2,2626,0)=" ;"
^XMB(3.9,146056,2,2627,0)="""RTN"",""VPRSDAP"",173,0)"
^XMB(3.9,146056,2,2628,0)="CODE(MED,FILE) ; -- convert MED=ien^name to national code"
^XMB(3.9,146056,2,2629,0)="""RTN"",""VPRSDAP"",174,0)"
^XMB(3.9,146056,2,2630,0)=" ; Reset MED = code^name^system for RxNorm or VUID"
^XMB(3.9,146056,2,2631,0)="""RTN"",""VPRSDAP"",175,0)"
^XMB(3.9,146056,2,2632,0)=" N Y S MED=$G(MED),FILE=+$G(FILE)"
^XMB(3.9,146056,2,2633,0)="""RTN"",""VPRSDAP"",176,0)"
^XMB(3.9,146056,2,2634,0)=" S Y=$$CODE^VPRSDA(+MED,FILE,""RXN"")"
^XMB(3.9,146056,2,2635,0)="""RTN"",""VPRSDAP"",177,0)"
^XMB(3.9,146056,2,2636,0)=" I Y="""" S Y=$$VUID^VPRD(+MED,FILE) S:$L(Y) Y=Y_U_$P(MED,U,2)_""^VHAT"""
^XMB(3.9,146056,2,2637,0)="""RTN"",""VPRSDAP"",178,0)"
^XMB(3.9,146056,2,2638,0)=" S:$L(Y) MED=Y ;reset to nat'l code string"
