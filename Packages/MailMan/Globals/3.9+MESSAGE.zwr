^XMB(3.9,146018,2,738,0)=" K DIR"
^XMB(3.9,146018,2,739,0)="""RTN"",""DPTLK7"",246,0)"
^XMB(3.9,146018,2,740,0)=" ; Story 338378 (elz) if pseudo, prompt pseudo reason"
^XMB(3.9,146018,2,741,0)="""RTN"",""DPTLK7"",247,0)"
