^XMB(3.9,146011,2,468,0)=" S PSOFROM=""UNHOLD"" ;*488"
^XMB(3.9,146011,2,469,0)="""RTN"",""PSOHLD"",10,0)"
^XMB(3.9,146011,2,470,0)=" I '$D(PSOPAR) D ^PSOLSET G:'$D(PSOPAR) EX"
^XMB(3.9,146011,2,471,0)="""RTN"",""PSOHLD"",11,0)"
^XMB(3.9,146011,2,472,0)=" I $G(PSOBEDT) W $C(7),$C(7) S VALMSG=""Invalid Action at this time !"",VALMBCK="""" Q"
^XMB(3.9,146011,2,473,0)="""RTN"",""PSOHLD"",12,0)"
^XMB(3.9,146011,2,474,0)=" I $G(PSONACT) W $C(7),$C(7) S VALMSG=""No Pharmacy Orderable Item !"",VALMBCK="""" Q"
^XMB(3.9,146011,2,475,0)="""RTN"",""PSOHLD"",13,0)"
^XMB(3.9,146011,2,476,0)=" S PSOPLCK=$$L^PSSLOCK(PSODFN,0) I '$G(PSOPLCK) D LOCK^PSOORCPY S VALMSG=$S($P($G(PSOPLCK),""^"",2)'="""":$P($G(PSOPLCK),""^"",2)_"" is working on this patient."",1:""Another person is entering orders for this patient."") K PSOPLCK S VALMBCK="""" Q"
