^XMB(3.9,146087,2,3226,0)="GETCATA(DOCNAME,RESULTS) ; set ^TMP with doc named and cat"
^XMB(3.9,146087,2,3227,0)="""RTN"",""YTQRQAD4"",100,0)"
^XMB(3.9,146087,2,3228,0)=" N CNT,HIT,NMB,NAME,IENI,IENC,CATN,XSTR,STAFF,OP,ALWN,DARR"
^XMB(3.9,146087,2,3229,0)="""RTN"",""YTQRQAD4"",101,0)"
^XMB(3.9,146087,2,3230,0)=" K ^TMP(""YTQ-JSON"",$J)"
^XMB(3.9,146087,2,3231,0)="""RTN"",""YTQRQAD4"",102,0)"
^XMB(3.9,146087,2,3232,0)=" S CNT=0,NMB="""",NAME="""",HIT="""""
^XMB(3.9,146087,2,3233,0)="""RTN"",""YTQRQAD4"",103,0)"
^XMB(3.9,146087,2,3234,0)=" D SETRES(""{""""Instruments"""":["")"
^XMB(3.9,146087,2,3235,0)="""RTN"",""YTQRQAD4"",104,0)"
^XMB(3.9,146087,2,3236,0)=" S (IENI,NAME)="""""
^XMB(3.9,146087,2,3237,0)="""RTN"",""YTQRQAD4"",105,0)"
^XMB(3.9,146087,2,3238,0)=" F  S NAME=$O(^YTT(601.71,""B"",NAME)) Q:NAME=""""  D"
^XMB(3.9,146087,2,3239,0)="""RTN"",""YTQRQAD4"",106,0)"
^XMB(3.9,146087,2,3240,0)=" . S HIT=1"
^XMB(3.9,146087,2,3241,0)="""RTN"",""YTQRQAD4"",107,0)"
^XMB(3.9,146087,2,3242,0)=" . S IENI="""" S IENI=$O(^YTT(601.71,""B"",NAME,IENI))"
^XMB(3.9,146087,2,3243,0)="""RTN"",""YTQRQAD4"",108,0)"
^XMB(3.9,146087,2,3244,0)=" . S OP=$P($G(^YTT(601.71,IENI,2)),""^"",2)"
^XMB(3.9,146087,2,3245,0)="""RTN"",""YTQRQAD4"",109,0)"
^XMB(3.9,146087,2,3246,0)=" . I OP'=""Y"" Q"
^XMB(3.9,146087,2,3247,0)="""RTN"",""YTQRQAD4"",110,0)"
^XMB(3.9,146087,2,3248,0)=" . I $E(NAME,1,7)=""CAT-CAD"" Q  ;only used for interview"
^XMB(3.9,146087,2,3249,0)="""RTN"",""YTQRQAD4"",111,0)"
^XMB(3.9,146087,2,3250,0)=" . I $$GET^XPAR(""ALL"",""YSCAT DISABLED"",1,""Q"") Q:$E(NAME,1,4)=""CAT-""  Q:$E(NAME,1,4)=""CAD-"""
