^XMB(3.9,146090,2,513,0)="""RTN"",""PSOSPML4"",137,0)"
^XMB(3.9,146090,2,514,0)="ASAPDEF ; - Invokes Listman for ASAP Definitions"
^XMB(3.9,146090,2,515,0)="""RTN"",""PSOSPML4"",138,0)"
^XMB(3.9,146090,2,516,0)=" N STATE"
^XMB(3.9,146090,2,517,0)="""RTN"",""PSOSPML4"",139,0)"
^XMB(3.9,146090,2,518,0)=" S STATE=$$RXSTATE^PSOBPSUT(RXIEN,0)"
^XMB(3.9,146090,2,519,0)="""RTN"",""PSOSPML4"",140,0)"
^XMB(3.9,146090,2,520,0)=" S PSOASVER=$$GET1^DIQ(58.41,STATE,1,""I"") S:PSOASVER="""" PSOASVER=""4.2"""
^XMB(3.9,146090,2,521,0)="""RTN"",""PSOSPML4"",141,0)"
^XMB(3.9,146090,2,522,0)=" D FULL^VALM1 W !"
^XMB(3.9,146090,2,523,0)="""RTN"",""PSOSPML4"",142,0)"
^XMB(3.9,146090,2,524,0)=" D EN^PSOSPML3(PSOASVER,1),INIT S VALMBCK=""R"""
