^XMB(3.9,146052,2,693,0)="""RTN"",""FBAAAUDR"",67,0)"
^XMB(3.9,146052,2,694,0)=" I $D(ZTQUEUED) S ZTREQ=""@"""
^XMB(3.9,146052,2,695,0)="""RTN"",""FBAAAUDR"",68,0)"
^XMB(3.9,146052,2,696,0)=" K DA,DIC,DIR,DR,DIROUT,DTOUT,DUOUT,X,Y"
