^XMB(3.9,146087,2,3580,0)=" I '$D(^XTMP(""YTQASMT-SET-""_ASMT)) Q  ;Assign deleted if RMVTEST"
^XMB(3.9,146087,2,3581,0)="""RTN"",""YTQRQAD4"",277,0)"
