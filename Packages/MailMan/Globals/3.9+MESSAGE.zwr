^XMB(3.9,146057,2,219,0)="""QUES"",""XPZ1"",""??"")"
^XMB(3.9,146057,2,220,0)="^D OPT^XPDH"
^XMB(3.9,146057,2,221,0)="""QUES"",""XPZ1"",""A"")"
^XMB(3.9,146057,2,222,0)="Want to DISABLE Scheduled Options, Menu Options, and Protocols"
^XMB(3.9,146057,2,223,0)="""QUES"",""XPZ1"",""B"")"
^XMB(3.9,146057,2,224,0)="NO"
^XMB(3.9,146057,2,225,0)="""QUES"",""XPZ1"",""M"")"
^XMB(3.9,146057,2,226,0)="D XPZ1^XPDIQ"
^XMB(3.9,146057,2,227,0)="""QUES"",""XPZ2"",0)"
^XMB(3.9,146057,2,228,0)="Y"
^XMB(3.9,146057,2,229,0)="""QUES"",""XPZ2"",""??"")"
^XMB(3.9,146057,2,230,0)="^D RTN^XPDH"
^XMB(3.9,146057,2,231,0)="""QUES"",""XPZ2"",""A"")"
^XMB(3.9,146057,2,232,0)="Want to MOVE routines to other CPUs"
^XMB(3.9,146057,2,233,0)="""QUES"",""XPZ2"",""B"")"
^XMB(3.9,146057,2,234,0)="NO"
^XMB(3.9,146057,2,235,0)="""QUES"",""XPZ2"",""M"")"
^XMB(3.9,146057,2,236,0)="D XPZ2^XPDIQ"
^XMB(3.9,146057,2,237,0)="""RTN"")"
^XMB(3.9,146057,2,238,0)=1
^XMB(3.9,146057,2,239,0)="""RTN"",""HLCS2"")"
^XMB(3.9,146057,2,240,0)="0^1^B53158802"
^XMB(3.9,146057,2,241,0)="""RTN"",""HLCS2"",1,0)"
^XMB(3.9,146057,2,242,0)="HLCS2 ;SF/JC - More Communication Server utilities ; 08/05/2011  11:22"
^XMB(3.9,146057,2,243,0)="""RTN"",""HLCS2"",2,0)"
^XMB(3.9,146057,2,244,0)=" ;;1.6;HEALTH LEVEL SEVEN;**14,40,43,49,57,58,82,84,109,122,157**;Oct 13, 1995;Build 0"
^XMB(3.9,146057,2,245,0)="""RTN"",""HLCS2"",3,0)"
^XMB(3.9,146057,2,246,0)=" ;Per VHA Directive 2004-038, this routine should not be modified."
^XMB(3.9,146057,2,247,0)="""RTN"",""HLCS2"",4,0)"
^XMB(3.9,146057,2,248,0)="FWD ; Add supplemental clients from HLL(""LINKS"") to HLSUP array"
^XMB(3.9,146057,2,249,0)="""RTN"",""HLCS2"",5,0)"
^XMB(3.9,146057,2,250,0)=" ;This enhancement also supports distribution of a message to"
^XMB(3.9,146057,2,251,0)="""RTN"",""HLCS2"",6,0)"
^XMB(3.9,146057,2,252,0)=" ;the same client over multiple logical links."
^XMB(3.9,146057,2,253,0)="""RTN"",""HLCS2"",7,0)"
^XMB(3.9,146057,2,254,0)=" Q:'$D(HLL(""LINKS""))"
^XMB(3.9,146057,2,255,0)="""RTN"",""HLCS2"",8,0)"
^XMB(3.9,146057,2,256,0)=" N CNT,LNK,CLIAP"
^XMB(3.9,146057,2,257,0)="""RTN"",""HLCS2"",9,0)"
^XMB(3.9,146057,2,258,0)=" S CNT=0,ROUTINE=1 F  S CNT=$O(HLL(""LINKS"",CNT)) Q:CNT<1  D"
^XMB(3.9,146057,2,259,0)="""RTN"",""HLCS2"",10,0)"
^XMB(3.9,146057,2,260,0)=" . S PTR=$P(HLL(""LINKS"",CNT),""^""),LNK=$P(HLL(""LINKS"",CNT),""^"",2)"
^XMB(3.9,146057,2,261,0)="""RTN"",""HLCS2"",11,0)"
^XMB(3.9,146057,2,262,0)=" . Q:PTR=""""  I +PTR<1 S PTR=$O(^ORD(101,""B"",PTR,0)) Q:PTR<1"
^XMB(3.9,146057,2,263,0)="""RTN"",""HLCS2"",12,0)"
^XMB(3.9,146057,2,264,0)=" . ;"
^XMB(3.9,146057,2,265,0)="""RTN"",""HLCS2"",13,0)"
^XMB(3.9,146057,2,266,0)=" . ; patch HL*1.6*122: excluding subscribers defined in"
^XMB(3.9,146057,2,267,0)="""RTN"",""HLCS2"",14,0)"
^XMB(3.9,146057,2,268,0)=" . ; HLP(""EXCLUDE SUBSCRIBER"",I) = ien of subscriber"
^XMB(3.9,146057,2,269,0)="""RTN"",""HLCS2"",15,0)"
^XMB(3.9,146057,2,270,0)=" . N I,EXCLUDE"
^XMB(3.9,146057,2,271,0)="""RTN"",""HLCS2"",16,0)"
^XMB(3.9,146057,2,272,0)=" . S (EXCLUDE,I)=0"
^XMB(3.9,146057,2,273,0)="""RTN"",""HLCS2"",17,0)"
^XMB(3.9,146057,2,274,0)=" . F  S I=$O(HLP(""EXCLUDE SUBSCRIBER"",I)) Q:'I  D  Q:EXCLUDE"
^XMB(3.9,146057,2,275,0)="""RTN"",""HLCS2"",18,0)"
^XMB(3.9,146057,2,276,0)=" .. N TEMP"
^XMB(3.9,146057,2,277,0)="""RTN"",""HLCS2"",19,0)"
^XMB(3.9,146057,2,278,0)=" .. S TEMP=HLP(""EXCLUDE SUBSCRIBER"",I)"
^XMB(3.9,146057,2,279,0)="""RTN"",""HLCS2"",20,0)"
^XMB(3.9,146057,2,280,0)=" .. I 'TEMP,TEMP]"""" S TEMP=$O(^ORD(101,""B"",TEMP,0))"
^XMB(3.9,146057,2,281,0)="""RTN"",""HLCS2"",21,0)"
^XMB(3.9,146057,2,282,0)=" .. I TEMP=PTR S EXCLUDE=1"
^XMB(3.9,146057,2,283,0)="""RTN"",""HLCS2"",22,0)"
^XMB(3.9,146057,2,284,0)=" . Q:EXCLUDE"
^XMB(3.9,146057,2,285,0)="""RTN"",""HLCS2"",23,0)"
^XMB(3.9,146057,2,286,0)=" . ; "
^XMB(3.9,146057,2,287,0)="""RTN"",""HLCS2"",24,0)"
^XMB(3.9,146057,2,288,0)=" . Q:LNK=""""  I +LNK<1 S LNK=$O(^HLCS(870,""B"",LNK,0)) Q:LNK<1"
^XMB(3.9,146057,2,289,0)="""RTN"",""HLCS2"",25,0)"
^XMB(3.9,146057,2,290,0)=" . Q:'$D(^HLCS(870,LNK))"
^XMB(3.9,146057,2,291,0)="""RTN"",""HLCS2"",26,0)"
^XMB(3.9,146057,2,292,0)=" . S CLIAP=$$PTR^HLUTIL2(PTR)"
^XMB(3.9,146057,2,293,0)="""RTN"",""HLCS2"",27,0)"
^XMB(3.9,146057,2,294,0)=" . ; patch HL*1.6*122: add the 3rd component as receiving facility"
^XMB(3.9,146057,2,295,0)="""RTN"",""HLCS2"",28,0)"
^XMB(3.9,146057,2,296,0)=" . ; S HLSUP(""S"",PTR,+LNK)=CLIAP_$S(CLIAP<1:U_HLL(""LINKS"",CNT),1:"""")"
^XMB(3.9,146057,2,297,0)="""RTN"",""HLCS2"",29,0)"
^XMB(3.9,146057,2,298,0)=" . S HLSUP(""S"",PTR,+LNK)=CLIAP_U_$S(CLIAP<1:HLL(""LINKS"",CNT),1:$P(HLL(""LINKS"",CNT),""^"",3))"
^XMB(3.9,146057,2,299,0)="""RTN"",""HLCS2"",30,0)"
^XMB(3.9,146057,2,300,0)=" Q"
^XMB(3.9,146057,2,301,0)="""RTN"",""HLCS2"",31,0)"
^XMB(3.9,146057,2,302,0)="ADD ;Deliver message to supplemental client list."
^XMB(3.9,146057,2,303,0)="""RTN"",""HLCS2"",32,0)"
^XMB(3.9,146057,2,304,0)=" ;Invoked by HLTP before and after processing normal clients"
^XMB(3.9,146057,2,305,0)="""RTN"",""HLCS2"",33,0)"
^XMB(3.9,146057,2,306,0)=" ;Only processes remote links. Local clients must be subscribing"
^XMB(3.9,146057,2,307,0)="""RTN"",""HLCS2"",34,0)"
^XMB(3.9,146057,2,308,0)=" ;protocols."
^XMB(3.9,146057,2,309,0)="""RTN"",""HLCS2"",35,0)"
^XMB(3.9,146057,2,310,0)=" Q:'$D(HLSUP(""S""))"
^XMB(3.9,146057,2,311,0)="""RTN"",""HLCS2"",36,0)"
^XMB(3.9,146057,2,312,0)=" N HLTCP,HLTCPI,HLTCPO,ZHLEIDS,ZLCLIENT,ZLOGLINK,ZMTIENS"
^XMB(3.9,146057,2,313,0)="""RTN"",""HLCS2"",37,0)"
^XMB(3.9,146057,2,314,0)=" S ZHLEIDS=0 F  S ZHLEIDS=$O(HLSUP(""S"",ZHLEIDS)) Q:ZHLEIDS<1  D"
^XMB(3.9,146057,2,315,0)="""RTN"",""HLCS2"",38,0)"
^XMB(3.9,146057,2,316,0)=" .S ZLOGLINK=0 F  S ZLOGLINK=$O(HLSUP(""S"",ZHLEIDS,ZLOGLINK)) Q:ZLOGLINK<1  D"
^XMB(3.9,146057,2,317,0)="""RTN"",""HLCS2"",39,0)"
^XMB(3.9,146057,2,318,0)=" ..S ZLCLIENT=+HLSUP(""S"",ZHLEIDS,ZLOGLINK)"
^XMB(3.9,146057,2,319,0)="""RTN"",""HLCS2"",40,0)"
^XMB(3.9,146057,2,320,0)=" ..I ZLCLIENT<1 S:$G(HLERROR)="""" HLERROR=""15^Invalid Subscriber Protocol in HLL('LINKS'): ""_$P(HLSUP(""S"",ZHLEIDS,ZLOGLINK),U,2,9) Q"
^XMB(3.9,146057,2,321,0)="""RTN"",""HLCS2"",41,0)"
^XMB(3.9,146057,2,322,0)=" .. ; patch HL*1.6*122 start"
^XMB(3.9,146057,2,323,0)="""RTN"",""HLCS2"",42,0)"
^XMB(3.9,146057,2,324,0)=" .. ; S HLOGLINK=ZLOGLINK D SEND^HLMA2(ZHLEIDS,HLMTIEN,ZLCLIENT,""D"",.ZMTIENS,ZLOGLINK),STATUS^HLTF0(+ZMTIENS,1)"
^XMB(3.9,146057,2,325,0)="""RTN"",""HLCS2"",43,0)"
^XMB(3.9,146057,2,326,0)=" .. S HLOGLINK=ZLOGLINK"
^XMB(3.9,146057,2,327,0)="""RTN"",""HLCS2"",44,0)"
^XMB(3.9,146057,2,328,0)=" .. ; 3rd component for receiving facility"
^XMB(3.9,146057,2,329,0)="""RTN"",""HLCS2"",45,0)"
^XMB(3.9,146057,2,330,0)=" .. S ZMTIENS(""REC-FACILITY"")=$P(HLSUP(""S"",ZHLEIDS,ZLOGLINK),U,3)"
^XMB(3.9,146057,2,331,0)="""RTN"",""HLCS2"",46,0)"
^XMB(3.9,146057,2,332,0)=" .. D SEND^HLMA2(ZHLEIDS,HLMTIEN,ZLCLIENT,""D"",.ZMTIENS,ZLOGLINK)"
^XMB(3.9,146057,2,333,0)="""RTN"",""HLCS2"",47,0)"
^XMB(3.9,146057,2,334,0)=" .. D STATUS^HLTF0(+ZMTIENS,1)"
^XMB(3.9,146057,2,335,0)="""RTN"",""HLCS2"",48,0)"
^XMB(3.9,146057,2,336,0)=" .. ; patch HL*1.6*122 end"
^XMB(3.9,146057,2,337,0)="""RTN"",""HLCS2"",49,0)"
^XMB(3.9,146057,2,338,0)=" .. ;"
^XMB(3.9,146057,2,339,0)="""RTN"",""HLCS2"",50,0)"
^XMB(3.9,146057,2,340,0)=" K HLL(""LINKS""),HLSUP"
^XMB(3.9,146057,2,341,0)="""RTN"",""HLCS2"",51,0)"
^XMB(3.9,146057,2,342,0)=" Q"
^XMB(3.9,146057,2,343,0)="""RTN"",""HLCS2"",52,0)"
^XMB(3.9,146057,2,344,0)="STALL ;STOP ALL LINKS AND FILERS"
^XMB(3.9,146057,2,345,0)="""RTN"",""HLCS2"",53,0)"
^XMB(3.9,146057,2,346,0)=" N DIR,Y"
^XMB(3.9,146057,2,347,0)="""RTN"",""HLCS2"",54,0)"
^XMB(3.9,146057,2,348,0)=" W ! S DIR(0)=""Y"",DIR(""A"")=""Okay to shut down all Links and Filers"""
^XMB(3.9,146057,2,349,0)="""RTN"",""HLCS2"",55,0)"
^XMB(3.9,146057,2,350,0)=" D ^DIR"
^XMB(3.9,146057,2,351,0)="""RTN"",""HLCS2"",56,0)"
^XMB(3.9,146057,2,352,0)=" I 'Y!($D(DIRUT))!($D(DUOUT)) W !!,""Shutdown Aborted!"" Q"
^XMB(3.9,146057,2,353,0)="""RTN"",""HLCS2"",57,0)"
^XMB(3.9,146057,2,354,0)=" W !,""Shutting down all Links and Filers..."""
^XMB(3.9,146057,2,355,0)="""RTN"",""HLCS2"",58,0)"
^XMB(3.9,146057,2,356,0)=" D CLEAR"
^XMB(3.9,146057,2,357,0)="""RTN"",""HLCS2"",59,0)"
^XMB(3.9,146057,2,358,0)=" D LLP(1)"
^XMB(3.9,146057,2,359,0)="""RTN"",""HLCS2"",60,0)"
^XMB(3.9,146057,2,360,0)=" Q"
^XMB(3.9,146057,2,361,0)="""RTN"",""HLCS2"",61,0)"
^XMB(3.9,146057,2,362,0)="QUE ;Restart Filers and AUTOSTART Logical Links after system re-boot"
^XMB(3.9,146057,2,363,0)="""RTN"",""HLCS2"",62,0)"
^XMB(3.9,146057,2,364,0)=" N DIR,Y"
^XMB(3.9,146057,2,365,0)="""RTN"",""HLCS2"",63,0)"
^XMB(3.9,146057,2,366,0)=" I '$D(ZTQUEUED) D  Q:'Y!($D(DIRUT))!($D(DUOUT))"
^XMB(3.9,146057,2,367,0)="""RTN"",""HLCS2"",64,0)"
^XMB(3.9,146057,2,368,0)=" .W ! S DIR(0)=""Y"",DIR(""A"")=""Shutdown and restart ALL AUTOSTART links and filers. Okay"""
^XMB(3.9,146057,2,369,0)="""RTN"",""HLCS2"",65,0)"
^XMB(3.9,146057,2,370,0)=" .D ^DIR"
^XMB(3.9,146057,2,371,0)="""RTN"",""HLCS2"",66,0)"
^XMB(3.9,146057,2,372,0)=" .I 'Y!($D(DIRUT))!($D(DUOUT)) W !!,""RESTART Aborted!"" Q"
^XMB(3.9,146057,2,373,0)="""RTN"",""HLCS2"",67,0)"
^XMB(3.9,146057,2,374,0)=" .W !,""Restarting all Autostart-Enabled Links and Filers..."""
^XMB(3.9,146057,2,375,0)="""RTN"",""HLCS2"",68,0)"
^XMB(3.9,146057,2,376,0)=" D CLEAR"
^XMB(3.9,146057,2,377,0)="""RTN"",""HLCS2"",69,0)"
^XMB(3.9,146057,2,378,0)=" D STARTF"
^XMB(3.9,146057,2,379,0)="""RTN"",""HLCS2"",70,0)"
^XMB(3.9,146057,2,380,0)=" D LLP(0)"
^XMB(3.9,146057,2,381,0)="""RTN"",""HLCS2"",71,0)"
^XMB(3.9,146057,2,382,0)=" D STRT"
^XMB(3.9,146057,2,383,0)="""RTN"",""HLCS2"",72,0)"
^XMB(3.9,146057,2,384,0)=" Q"
^XMB(3.9,146057,2,385,0)="""RTN"",""HLCS2"",73,0)"
^XMB(3.9,146057,2,386,0)="CLEAR ;Reset state of 869.3"
^XMB(3.9,146057,2,387,0)="""RTN"",""HLCS2"",74,0)"
^XMB(3.9,146057,2,388,0)=" S DA(1)=1,DA=0,DIK=""^HLCS(869.3,1,2,"""
^XMB(3.9,146057,2,389,0)="""RTN"",""HLCS2"",75,0)"
^XMB(3.9,146057,2,390,0)=" F  S DA=$O(^HLCS(869.3,DA(1),2,DA)) Q:DA<1  D ^DIK"
^XMB(3.9,146057,2,391,0)="""RTN"",""HLCS2"",76,0)"
^XMB(3.9,146057,2,392,0)=" S DA=0,DIK=""^HLCS(869.3,1,3,"""
^XMB(3.9,146057,2,393,0)="""RTN"",""HLCS2"",77,0)"
^XMB(3.9,146057,2,394,0)=" F  S DA=$O(^HLCS(869.3,DA(1),3,DA)) Q:DA<1  D ^DIK"
^XMB(3.9,146057,2,395,0)="""RTN"",""HLCS2"",78,0)"
^XMB(3.9,146057,2,396,0)=" Q"
^XMB(3.9,146057,2,397,0)="""RTN"",""HLCS2"",79,0)"
^XMB(3.9,146057,2,398,0)="STARTF ;Start filers"
^XMB(3.9,146057,2,399,0)="""RTN"",""HLCS2"",80,0)"
^XMB(3.9,146057,2,400,0)=" ;Get Defaults"
^XMB(3.9,146057,2,401,0)="""RTN"",""HLCS2"",81,0)"
^XMB(3.9,146057,2,402,0)=" N TMP,PTR,DEFCNT,DA,HLCNT,HLNODE1"
^XMB(3.9,146057,2,403,0)="""RTN"",""HLCS2"",82,0)"
^XMB(3.9,146057,2,404,0)=" S PTR=+$O(^HLCS(869.3,0)) Q:'PTR"
^XMB(3.9,146057,2,405,0)="""RTN"",""HLCS2"",83,0)"
^XMB(3.9,146057,2,406,0)=" ;default # of incoming filers"
^XMB(3.9,146057,2,407,0)="""RTN"",""HLCS2"",84,0)"
^XMB(3.9,146057,2,408,0)=" S HLNODE1=$G(^HLCS(869.3,PTR,1)),DEFCNT=+$P(HLNODE1,U) S:'DEFCNT DEFCNT=1"
^XMB(3.9,146057,2,409,0)="""RTN"",""HLCS2"",85,0)"
^XMB(3.9,146057,2,410,0)=" F HLCNT=1:1:DEFCNT S TMP=$$TASKFLR^HLCS1(""IN"")"
