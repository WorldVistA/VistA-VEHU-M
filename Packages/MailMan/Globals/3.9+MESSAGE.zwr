^XMB(3.9,146096,2,777,0)="""RTN"",""MAGVAQ01"",264,0)"
^XMB(3.9,146096,2,778,0)=" Q"
^XMB(3.9,146096,2,779,0)="""RTN"",""MAGVAQ01"",265,0)"
^XMB(3.9,146096,2,780,0)=" ;"
^XMB(3.9,146096,2,781,0)="""RTN"",""MAGVAQ01"",266,0)"
^XMB(3.9,146096,2,782,0)=" ; ++++  Returns 1 if it meets the criteria, if not returns 0"
^XMB(3.9,146096,2,783,0)="""RTN"",""MAGVAQ01"",267,0)"
^XMB(3.9,146096,2,784,0)=" ; Check if (the EARLIEST DELIVERY DATE/TIME is NULL or the EARLIEST DELIVERY DATE/TIME < NOW) "
^XMB(3.9,146096,2,785,0)="""RTN"",""MAGVAQ01"",268,0)"
^XMB(3.9,146096,2,786,0)=" ;  and (the EXPIRATION DATE/TIME is NULL OR the EXPIRATION DATE/TIME > NOW)"
^XMB(3.9,146096,2,787,0)="""RTN"",""MAGVAQ01"",269,0)"
^XMB(3.9,146096,2,788,0)=" ;  "
^XMB(3.9,146096,2,789,0)="""RTN"",""MAGVAQ01"",270,0)"
^XMB(3.9,146096,2,790,0)=" ; Input Parameters"
^XMB(3.9,146096,2,791,0)="""RTN"",""MAGVAQ01"",271,0)"
^XMB(3.9,146096,2,792,0)=" ; ================"
^XMB(3.9,146096,2,793,0)="""RTN"",""MAGVAQ01"",272,0)"
^XMB(3.9,146096,2,794,0)=" ; FILE = QUEUE MESSAGE file (#2006.928)"
^XMB(3.9,146096,2,795,0)="""RTN"",""MAGVAQ01"",273,0)"
^XMB(3.9,146096,2,796,0)=" ; IEN = IEN in QUEUE MESSAGE file (#2006.928)"
^XMB(3.9,146096,2,797,0)="""RTN"",""MAGVAQ01"",274,0)"
^XMB(3.9,146096,2,798,0)=" ; FLDMINDT = EARLIEST DELIVERY DATE/TIME field number in QUEUE MESSAGE file (#2006.928)"
^XMB(3.9,146096,2,799,0)="""RTN"",""MAGVAQ01"",275,0)"
^XMB(3.9,146096,2,800,0)=" ; FLDEXPDT = EXPIRATION DATE/TIME field number in QUEUE MESSAGE file (#2006.928)"
^XMB(3.9,146096,2,801,0)="""RTN"",""MAGVAQ01"",276,0)"
^XMB(3.9,146096,2,802,0)=" ; "
^XMB(3.9,146096,2,803,0)="""RTN"",""MAGVAQ01"",277,0)"
^XMB(3.9,146096,2,804,0)=" ; Return Values"
^XMB(3.9,146096,2,805,0)="""RTN"",""MAGVAQ01"",278,0)"
^XMB(3.9,146096,2,806,0)=" ; ============="
^XMB(3.9,146096,2,807,0)="""RTN"",""MAGVAQ01"",279,0)"
^XMB(3.9,146096,2,808,0)=" ; if error ERRMSG = Failure status ^ Error message^"
^XMB(3.9,146096,2,809,0)="""RTN"",""MAGVAQ01"",280,0)"
^XMB(3.9,146096,2,810,0)=" ;  "
^XMB(3.9,146096,2,811,0)="""RTN"",""MAGVAQ01"",281,0)"
^XMB(3.9,146096,2,812,0)="CHECKQM(ERRMSG,FILE,IEN,FLDMINDT,FLDEXPDT) ; Returns 1 if it meets the criteria, if not returns 0 "
^XMB(3.9,146096,2,813,0)="""RTN"",""MAGVAQ01"",282,0)"
^XMB(3.9,146096,2,814,0)=" N ERR,FIELDS,OUT,IENS,MAGRESA,FOUND"
^XMB(3.9,146096,2,815,0)="""RTN"",""MAGVAQ01"",283,0)"
^XMB(3.9,146096,2,816,0)=" N NOW"
^XMB(3.9,146096,2,817,0)="""RTN"",""MAGVAQ01"",284,0)"
^XMB(3.9,146096,2,818,0)=" S FOUND=0"
^XMB(3.9,146096,2,819,0)="""RTN"",""MAGVAQ01"",285,0)"
^XMB(3.9,146096,2,820,0)=" S FIELDS=FLDMINDT_"";""_FLDEXPDT"
^XMB(3.9,146096,2,821,0)="""RTN"",""MAGVAQ01"",286,0)"
^XMB(3.9,146096,2,822,0)=" S IENS=IEN_"","""
^XMB(3.9,146096,2,823,0)="""RTN"",""MAGVAQ01"",287,0)"
^XMB(3.9,146096,2,824,0)=" D GETS^DIQ(FILE,IENS,FIELDS,""I"",""OUT"",""ERR"") ; get EARLIEST DELIVERY DATE/TIME and EXPIRATION DATE/TIME values"
^XMB(3.9,146096,2,825,0)="""RTN"",""MAGVAQ01"",288,0)"
^XMB(3.9,146096,2,826,0)=" I $D(ERR(""DIERR"")) D  Q 0"
^XMB(3.9,146096,2,827,0)="""RTN"",""MAGVAQ01"",289,0)"
^XMB(3.9,146096,2,828,0)=" . D MSG^DIALOG(""A"",.MAGRESA,245,5,""ERR"")"
^XMB(3.9,146096,2,829,0)="""RTN"",""MAGVAQ01"",290,0)"
^XMB(3.9,146096,2,830,0)=" . S ERRMSG=$$FAILED^MAGVAF02()_$$RESDEL^MAGVAF02()_""Error getting values: ""_MAGRESA(1) Q  ; Error getting the values"
^XMB(3.9,146096,2,831,0)="""RTN"",""MAGVAQ01"",291,0)"
^XMB(3.9,146096,2,832,0)=" . Q"
^XMB(3.9,146096,2,833,0)="""RTN"",""MAGVAQ01"",292,0)"
^XMB(3.9,146096,2,834,0)=" ;"
^XMB(3.9,146096,2,835,0)="""RTN"",""MAGVAQ01"",293,0)"
^XMB(3.9,146096,2,836,0)=" ; Get the oldest QUEUE MESSAGE where"
^XMB(3.9,146096,2,837,0)="""RTN"",""MAGVAQ01"",294,0)"
^XMB(3.9,146096,2,838,0)=" ;      (the EARLIEST DELIVERY DATE/TIME is NULL OR the EARLIEST DELIVERY DATE/TIME < NOW) "
^XMB(3.9,146096,2,839,0)="""RTN"",""MAGVAQ01"",295,0)"
^XMB(3.9,146096,2,840,0)=" ;  AND (the EXPIRATION DATE/TIME is NULL OR the EXPIRATION DATE/TIME > NOW)"
^XMB(3.9,146096,2,841,0)="""RTN"",""MAGVAQ01"",296,0)"
^XMB(3.9,146096,2,842,0)=" ;  "
^XMB(3.9,146096,2,843,0)="""RTN"",""MAGVAQ01"",297,0)"
^XMB(3.9,146096,2,844,0)=" S NOW=$$NOW^XLFDT"
^XMB(3.9,146096,2,845,0)="""RTN"",""MAGVAQ01"",298,0)"
^XMB(3.9,146096,2,846,0)=" I ((OUT(FILE,IENS,FLDMINDT,""I"")="""")!(OUT(FILE,IENS,FLDMINDT,""I"")<NOW))&((OUT(FILE,IENS,FLDEXPDT,""I"")="""")!(OUT(FILE,IENS,FLDEXPDT,""I"")>NOW)) S FOUND=1"
^XMB(3.9,146096,2,847,0)="""RTN"",""MAGVAQ01"",299,0)"
^XMB(3.9,146096,2,848,0)=" Q FOUND"
^XMB(3.9,146096,2,849,0)="""VER"")"
^XMB(3.9,146096,2,850,0)="8.0^22.2"
^XMB(3.9,146096,2,851,0)="$END KID MAG*3.0*371b"
