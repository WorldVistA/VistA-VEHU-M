^XMB(3.9,146090,2,256,0)=" W ! D ^DIR I X=""""!$D(DIRUT) G EXIT"
^XMB(3.9,146090,2,257,0)="""RTN"",""PSOSPML4"",9,0)"
^XMB(3.9,146090,2,258,0)=" S X=$$UP^XLFSTR(X),PSOQUIT=0"
^XMB(3.9,146090,2,259,0)="""RTN"",""PSOSPML4"",10,0)"
^XMB(3.9,146090,2,260,0)=" I $E(X,1,2)'=""E."" S RXIEN=+$$RXLKP(X) I RXIEN<0 G RX"
^XMB(3.9,146090,2,261,0)="""RTN"",""PSOSPML4"",11,0)"
^XMB(3.9,146090,2,262,0)=" I $E(X,1,2)=""E."" D  I PSOQUIT G RX"
^XMB(3.9,146090,2,263,0)="""RTN"",""PSOSPML4"",12,0)"
^XMB(3.9,146090,2,264,0)=" . I $L(X)'=9 W !?5,""The ECME# must be 7 digits long!"",$C(7) S PSOQUIT=1 Q"
^XMB(3.9,146090,2,265,0)="""RTN"",""PSOSPML4"",13,0)"
^XMB(3.9,146090,2,266,0)=" . S RXIEN=+$$RXNUM^PSOBPSU2($E(X,3,9)) I RXIEN<0 W "" ??"" S PSOQUIT=1"
^XMB(3.9,146090,2,267,0)="""RTN"",""PSOSPML4"",14,0)"
^XMB(3.9,146090,2,268,0)=" ;"
^XMB(3.9,146090,2,269,0)="""RTN"",""PSOSPML4"",15,0)"
^XMB(3.9,146090,2,270,0)=" S FILLNUM=$$RXFILL^PSOSPMU2(RXIEN) I FILLNUM=""^"" G EXIT"
^XMB(3.9,146090,2,271,0)="""RTN"",""PSOSPML4"",16,0)"
^XMB(3.9,146090,2,272,0)=" ;"
^XMB(3.9,146090,2,273,0)="""RTN"",""PSOSPML4"",17,0)"
^XMB(3.9,146090,2,274,0)=" S SCREEN=$$SCREEN^PSOSPMUT(RXIEN,FILLNUM)"
^XMB(3.9,146090,2,275,0)="""RTN"",""PSOSPML4"",18,0)"
^XMB(3.9,146090,2,276,0)=" I +SCREEN D  G RX:$P(SCREEN,""^"",3)=""E"""
^XMB(3.9,146090,2,277,0)="""RTN"",""PSOSPML4"",19,0)"
^XMB(3.9,146090,2,278,0)=" . W !!?1,$S($P(SCREEN,""^"",3)=""E"":""ERROR"",1:""WARNING""),"": "",$P(SCREEN,""^"",2),$C(7) D PAUSE^PSOSPMU1"
^XMB(3.9,146090,2,279,0)="""RTN"",""PSOSPML4"",20,0)"
^XMB(3.9,146090,2,280,0)=" ;"
^XMB(3.9,146090,2,281,0)="""RTN"",""PSOSPML4"",21,0)"
^XMB(3.9,146090,2,282,0)=" ; The legislation allowing VA to report was published on 02/11/2013"
^XMB(3.9,146090,2,283,0)="""RTN"",""PSOSPML4"",22,0)"
^XMB(3.9,146090,2,284,0)=" I $$RXRLDT^PSOBPSUT(RXIEN,FILLNUM),$$RXRLDT^PSOBPSUT(RXIEN,FILLNUM)<3130211 D  G RX"
^XMB(3.9,146090,2,285,0)="""RTN"",""PSOSPML4"",23,0)"
^XMB(3.9,146090,2,286,0)=" . W !!?1,""Only prescription fills dispensed on or after Feb 11, 2013 can be exported."",$C(7)"
^XMB(3.9,146090,2,287,0)="""RTN"",""PSOSPML4"",24,0)"
^XMB(3.9,146090,2,288,0)=" ;"
^XMB(3.9,146090,2,289,0)="""RTN"",""PSOSPML4"",25,0)"
^XMB(3.9,146090,2,290,0)=" D EN(RXIEN,FILLNUM,""N"")"
^XMB(3.9,146090,2,291,0)="""RTN"",""PSOSPML4"",26,0)"
^XMB(3.9,146090,2,292,0)=" ;"
^XMB(3.9,146090,2,293,0)="""RTN"",""PSOSPML4"",27,0)"
^XMB(3.9,146090,2,294,0)=" G RX"
^XMB(3.9,146090,2,295,0)="""RTN"",""PSOSPML4"",28,0)"
^XMB(3.9,146090,2,296,0)=" ;"
^XMB(3.9,146090,2,297,0)="""RTN"",""PSOSPML4"",29,0)"
^XMB(3.9,146090,2,298,0)="EN(RXIEN,FILLNUM,RECTYPE) ; Entry point"
^XMB(3.9,146090,2,299,0)="""RTN"",""PSOSPML4"",30,0)"
^XMB(3.9,146090,2,300,0)=" N ASAP,SITEIEN,PATIEN,FILLIEN,DRUGIEN,PREIEN,RPHIEN,RSTREC,RTSDATA,PSONAME,TRXTYPE,RTSREC"
^XMB(3.9,146090,2,301,0)="""RTN"",""PSOSPML4"",31,0)"
^XMB(3.9,146090,2,302,0)=" N BATCHIEN"
^XMB(3.9,146090,2,303,0)="""RTN"",""PSOSPML4"",32,0)"
^XMB(3.9,146090,2,304,0)=" S BATCHIEN="""""
^XMB(3.9,146090,2,305,0)="""RTN"",""PSOSPML4"",33,0)"
^XMB(3.9,146090,2,306,0)=" ;"
^XMB(3.9,146090,2,307,0)="""RTN"",""PSOSPML4"",34,0)"
^XMB(3.9,146090,2,308,0)=" S:$G(FILLNUM)="""" FILLNUM=0"
^XMB(3.9,146090,2,309,0)="""RTN"",""PSOSPML4"",35,0)"
^XMB(3.9,146090,2,310,0)=" S:$G(STATEIEN)="""" STATEIEN=$$RXSTATE^PSOBPSUT(RXIEN,0)      ;P662"
^XMB(3.9,146090,2,311,0)="""RTN"",""PSOSPML4"",36,0)"
^XMB(3.9,146090,2,312,0)=" S PSOASVER=$$GET1^DIQ(58.41,STATEIEN,1,""I"") S:PSOASVER="""" PSOASVER=""4.2"""
^XMB(3.9,146090,2,313,0)="""RTN"",""PSOSPML4"",37,0)"
^XMB(3.9,146090,2,314,0)=" S SITEIEN=$$RXSITE^PSOBPSUT(RXIEN,0)"
^XMB(3.9,146090,2,315,0)="""RTN"",""PSOSPML4"",38,0)"
^XMB(3.9,146090,2,316,0)=" S (PATIEN,DFN)=$$GET1^DIQ(52,RXIEN,2,""I"")"
^XMB(3.9,146090,2,317,0)="""RTN"",""PSOSPML4"",39,0)"
^XMB(3.9,146090,2,318,0)=" D DEM^VADPT,ADD^VADPT,SETNAME^PSOSPMUT(DFN)"
^XMB(3.9,146090,2,319,0)="""RTN"",""PSOSPML4"",40,0)"
^XMB(3.9,146090,2,320,0)=" S DRUGIEN=$$GET1^DIQ(52,RXIEN,6,""I"")"
^XMB(3.9,146090,2,321,0)="""RTN"",""PSOSPML4"",41,0)"
^XMB(3.9,146090,2,322,0)=" S FILLIEN=$S(FILLNUM[""P"":+$P(FILLNUM,""P"",2),1:+FILLNUM)"
^XMB(3.9,146090,2,323,0)="""RTN"",""PSOSPML4"",42,0)"
^XMB(3.9,146090,2,324,0)=" S TRXTYPE=""S"""
^XMB(3.9,146090,2,325,0)="""RTN"",""PSOSPML4"",43,0)"
^XMB(3.9,146090,2,326,0)=" K RTSDATA S RTSREC=0 I RECTYPE=""V"" S RTSREC=1 D LOADRTS^PSOSPMU1(RXIEN,FILLNUM,.RTSDATA)"
^XMB(3.9,146090,2,327,0)="""RTN"",""PSOSPML4"",44,0)"
^XMB(3.9,146090,2,328,0)=" S PREIEN=$$PREIEN^PSOSPMUT(RECTYPE,RXIEN,FILLNUM)"
^XMB(3.9,146090,2,329,0)="""RTN"",""PSOSPML4"",45,0)"
^XMB(3.9,146090,2,330,0)=" S RPHIEN=$$RPHIEN^PSOSPMUT(RECTYPE,RXIEN,FILLNUM)"
^XMB(3.9,146090,2,331,0)="""RTN"",""PSOSPML4"",46,0)"
^XMB(3.9,146090,2,332,0)=" D EN^VALM(""PSO SPMP VIEW/EXPORT RX"")"
^XMB(3.9,146090,2,333,0)="""RTN"",""PSOSPML4"",47,0)"
^XMB(3.9,146090,2,334,0)=" D FULL^VALM1"
^XMB(3.9,146090,2,335,0)="""RTN"",""PSOSPML4"",48,0)"
^XMB(3.9,146090,2,336,0)=" Q"
^XMB(3.9,146090,2,337,0)="""RTN"",""PSOSPML4"",49,0)"
^XMB(3.9,146090,2,338,0)=" ;"
^XMB(3.9,146090,2,339,0)="""RTN"",""PSOSPML4"",50,0)"
^XMB(3.9,146090,2,340,0)="HDR ; - Builds the Header section"
^XMB(3.9,146090,2,341,0)="""RTN"",""PSOSPML4"",51,0)"
^XMB(3.9,146090,2,342,0)=" N LINE1,LINE2,X"
^XMB(3.9,146090,2,343,0)="""RTN"",""PSOSPML4"",52,0)"
^XMB(3.9,146090,2,344,0)=" K VALMHDR S VALMHDR(1)=""Rx: ""_$$GET1^DIQ(52,RXIEN,.01)_"" - ""_$$GET1^DIQ(52,RXIEN,6)"
^XMB(3.9,146090,2,345,0)="""RTN"",""PSOSPML4"",53,0)"
^XMB(3.9,146090,2,346,0)=" S VALMHDR(1)=VALMHDR(1)_""   (Fill: ""_$S(FILLNUM[""P"":""Partial ""_$E(FILLNUM,2,9),'FILLNUM:""Original"",1:""Refill ""_FILLNUM)_"")"""
^XMB(3.9,146090,2,347,0)="""RTN"",""PSOSPML4"",54,0)"
^XMB(3.9,146090,2,348,0)=" S VALMHDR(2)=""Patient: ""_$$GET1^DIQ(52,RXIEN,2)_""            ASAP Version: ""_PSOASVER"
^XMB(3.9,146090,2,349,0)="""RTN"",""PSOSPML4"",55,0)"
^XMB(3.9,146090,2,350,0)=" Q"
^XMB(3.9,146090,2,351,0)="""RTN"",""PSOSPML4"",56,0)"
^XMB(3.9,146090,2,352,0)=" ;"
^XMB(3.9,146090,2,353,0)="""RTN"",""PSOSPML4"",57,0)"
^XMB(3.9,146090,2,354,0)="INIT ; Builds the Body section "
^XMB(3.9,146090,2,355,0)="""RTN"",""PSOSPML4"",58,0)"
^XMB(3.9,146090,2,356,0)=" N ASAP,LINE"
^XMB(3.9,146090,2,357,0)="""RTN"",""PSOSPML4"",59,0)"
^XMB(3.9,146090,2,358,0)=" ;"
^XMB(3.9,146090,2,359,0)="""RTN"",""PSOSPML4"",60,0)"
^XMB(3.9,146090,2,360,0)=" D CLEAN^VALM10 K ^TMP(""PSOSPML4"",$J) S VALMCNT=0,LINE=0"
^XMB(3.9,146090,2,361,0)="""RTN"",""PSOSPML4"",61,0)"
^XMB(3.9,146090,2,362,0)=" I PSOASVER=""1995"" D"
^XMB(3.9,146090,2,363,0)="""RTN"",""PSOSPML4"",62,0)"
^XMB(3.9,146090,2,364,0)=" . D SETSEG95(""PSOSPML4"",$$ASAP95^PSOASAP0(RXIEN,+FILLNUM)) S VALMCNT=LINE"
^XMB(3.9,146090,2,365,0)="""RTN"",""PSOSPML4"",63,0)"
^XMB(3.9,146090,2,366,0)=" I PSOASVER'=""1995"" D"
^XMB(3.9,146090,2,367,0)="""RTN"",""PSOSPML4"",64,0)"
^XMB(3.9,146090,2,368,0)=" . S (PSOTTCNT,PSOTPCNT)=0"
^XMB(3.9,146090,2,369,0)="""RTN"",""PSOSPML4"",65,0)"
^XMB(3.9,146090,2,370,0)=" . D LOADASAP^PSOSPMU0(PSOASVER,""B"",.ASAP)"
^XMB(3.9,146090,2,371,0)="""RTN"",""PSOSPML4"",66,0)"
^XMB(3.9,146090,2,372,0)=" . D SETSEG(""ASAP"") S VALMCNT=LINE"
^XMB(3.9,146090,2,373,0)="""RTN"",""PSOSPML4"",67,0)"
^XMB(3.9,146090,2,374,0)=" . S VALMSG=""Enter ?? for more actions|* Custom Segment/Element"""
^XMB(3.9,146090,2,375,0)="""RTN"",""PSOSPML4"",68,0)"
^XMB(3.9,146090,2,376,0)=" Q"
^XMB(3.9,146090,2,377,0)="""RTN"",""PSOSPML4"",69,0)"
^XMB(3.9,146090,2,378,0)=" ;"
^XMB(3.9,146090,2,379,0)="""RTN"",""PSOSPML4"",70,0)"
^XMB(3.9,146090,2,380,0)="SETSEG(ARRNAM) ; Sets list body with ASAP (non-1995) info (Uses Recurisivity - Call itself)"
^XMB(3.9,146090,2,381,0)="""RTN"",""PSOSPML4"",71,0)"
^XMB(3.9,146090,2,382,0)=" ;Input: ARRNAM - Name of the Array containing the ASAP Definition ('ASAP')"
^XMB(3.9,146090,2,383,0)="""RTN"",""PSOSPML4"",72,0)"
^XMB(3.9,146090,2,384,0)=" ;"
^XMB(3.9,146090,2,385,0)="""RTN"",""PSOSPML4"",73,0)"
^XMB(3.9,146090,2,386,0)=" N ARRAY,SEGID,DETLN,VALUE,RXLN,COLUMN,I,TMPARR,SEGTXT,LSTELM"
^XMB(3.9,146090,2,387,0)="""RTN"",""PSOSPML4"",74,0)"
^XMB(3.9,146090,2,388,0)=" S ARRAY=$Q(@ARRNAM) I '+$P(ARRAY,""("",2) Q"
^XMB(3.9,146090,2,389,0)="""RTN"",""PSOSPML4"",75,0)"
^XMB(3.9,146090,2,390,0)=" S SEGID=@ARRAY,COLUMN=(($L(ARRAY,"","")-1)*4)"
^XMB(3.9,146090,2,391,0)="""RTN"",""PSOSPML4"",76,0)"
^XMB(3.9,146090,2,392,0)=" ; Segment Not Used by ASAP Version"
^XMB(3.9,146090,2,393,0)="""RTN"",""PSOSPML4"",77,0)"
^XMB(3.9,146090,2,394,0)=" I $P(ASAP(SEGID),""^"",4)=""N"" D SETSEG(ARRAY) Q"
^XMB(3.9,146090,2,395,0)="""RTN"",""PSOSPML4"",78,0)"
^XMB(3.9,146090,2,396,0)=" D SETLN^PSOSPMU1(""PSOSPML4"",$P(ASAP(SEGID),""^"")_$S($$CUSSEG^PSOSPMU3(PSOASVER,SEGID):""*"",1:"""")_"" ""_$P(ASAP(SEGID),""^"",2),0,1)"
^XMB(3.9,146090,2,397,0)="""RTN"",""PSOSPML4"",79,0)"
^XMB(3.9,146090,2,398,0)=" D SEGCOUNT^PSOSPMUT($P(ASAP(SEGID),""^"",6))"
^XMB(3.9,146090,2,399,0)="""RTN"",""PSOSPML4"",80,0)"
^XMB(3.9,146090,2,400,0)=" K TMPARR S SEGTXT=SEGID"
^XMB(3.9,146090,2,401,0)="""RTN"",""PSOSPML4"",81,0)"
^XMB(3.9,146090,2,402,0)=" S LSTELM=+$O(ASAP(SEGID,""""),-1)"
^XMB(3.9,146090,2,403,0)="""RTN"",""PSOSPML4"",82,0)"
^XMB(3.9,146090,2,404,0)=" N $ETRAP,$ESTACK S $ETRAP=""D ERROR^PSOSPML4"""
^XMB(3.9,146090,2,405,0)="""RTN"",""PSOSPML4"",83,0)"
^XMB(3.9,146090,2,406,0)=" F I=1:1:LSTELM D"
^XMB(3.9,146090,2,407,0)="""RTN"",""PSOSPML4"",84,0)"
^XMB(3.9,146090,2,408,0)=" . S VALUE="""" I $P(ASAP(SEGID,I),""^"",6)'=""N"" X ""S VALUE=""_ASAP(SEGID,I,""VAL"",1)"
^XMB(3.9,146090,2,409,0)="""RTN"",""PSOSPML4"",85,0)"
^XMB(3.9,146090,2,410,0)=" . S VALUE=$E(VALUE,1,$P(ASAP(SEGID,I),""^"",4))"
^XMB(3.9,146090,2,411,0)="""RTN"",""PSOSPML4"",86,0)"
^XMB(3.9,146090,2,412,0)=" . S SEGTXT=SEGTXT_$P(ASAP,""^"",2)_VALUE"
^XMB(3.9,146090,2,413,0)="""RTN"",""PSOSPML4"",87,0)"
^XMB(3.9,146090,2,414,0)=" . S RXLN=$S($G(VALUE)'="""":VALUE,1:$P(ASAP,""^"",2))"
^XMB(3.9,146090,2,415,0)="""RTN"",""PSOSPML4"",88,0)"
^XMB(3.9,146090,2,416,0)=" . S $E(RXLN,40)=$P(ASAP(SEGID,I),""^"")_$S($G(ASAP(SEGID,I,""CUS"")):""* "",1:"" "")_$P(ASAP(SEGID,I),""^"",2)_$S($P(ASAP(SEGID,I),""^"",6)=""N"":"" (Not Used)"",1:"""")"
^XMB(3.9,146090,2,417,0)="""RTN"",""PSOSPML4"",89,0)"
^XMB(3.9,146090,2,418,0)=" . S TMPARR(I)=RXLN I $G(ASAP(SEGID,I,""CUS"")) S TMPARR(I,""HIGH"")=1"
^XMB(3.9,146090,2,419,0)="""RTN"",""PSOSPML4"",90,0)"
^XMB(3.9,146090,2,420,0)=" S SEGTXT=SEGTXT_$S(PSOASVER=""3.0"":$$TH13^PSOASAP0(),1:$$TH09^PSOASAP0())"
^XMB(3.9,146090,2,421,0)="""RTN"",""PSOSPML4"",91,0)"
^XMB(3.9,146090,2,422,0)=" ;"
^XMB(3.9,146090,2,423,0)="""RTN"",""PSOSPML4"",92,0)"
^XMB(3.9,146090,2,424,0)=" F I=1:1 Q:SEGTXT=""""  D SETLN^PSOSPMU1(""PSOSPML4"",$E(SEGTXT,1,80)) S SEGTXT=$E(SEGTXT,81,999)"
^XMB(3.9,146090,2,425,0)="""RTN"",""PSOSPML4"",93,0)"
^XMB(3.9,146090,2,426,0)=" F I=1:1 Q:'$D(TMPARR(I))  D SETLN^PSOSPMU1(""PSOSPML4"",TMPARR(I),,,+$G(TMPARR(I,""HIGH"")))"
^XMB(3.9,146090,2,427,0)="""RTN"",""PSOSPML4"",94,0)"
^XMB(3.9,146090,2,428,0)=" ;"
^XMB(3.9,146090,2,429,0)="""RTN"",""PSOSPML4"",95,0)"
^XMB(3.9,146090,2,430,0)=" D SETSEG(ARRAY)"
^XMB(3.9,146090,2,431,0)="""RTN"",""PSOSPML4"",96,0)"
^XMB(3.9,146090,2,432,0)=" Q"
^XMB(3.9,146090,2,433,0)="""RTN"",""PSOSPML4"",97,0)"
^XMB(3.9,146090,2,434,0)=" ;"
^XMB(3.9,146090,2,435,0)="""RTN"",""PSOSPML4"",98,0)"
^XMB(3.9,146090,2,436,0)="ERROR ; Error Trap Handling to catch errors on user-entered M expression"
^XMB(3.9,146090,2,437,0)="""RTN"",""PSOSPML4"",99,0)"
^XMB(3.9,146090,2,438,0)=" D SETLN^PSOSPMU1(""PSOSPML4"",$E($$EC^%ZOSV,1,80))"
^XMB(3.9,146090,2,439,0)="""RTN"",""PSOSPML4"",100,0)"
^XMB(3.9,146090,2,440,0)=" G UNWIND^%ZTER"
^XMB(3.9,146090,2,441,0)="""RTN"",""PSOSPML4"",101,0)"
^XMB(3.9,146090,2,442,0)=" ;"
^XMB(3.9,146090,2,443,0)="""RTN"",""PSOSPML4"",102,0)"
^XMB(3.9,146090,2,444,0)="SETSEG95(LSTSUB,RECORD) ; Sets list body with ASAP 1995 info"
^XMB(3.9,146090,2,445,0)="""RTN"",""PSOSPML4"",103,0)"
^XMB(3.9,146090,2,446,0)=" N DSPL,PSOCOL"
^XMB(3.9,146090,2,447,0)="""RTN"",""PSOSPML4"",104,0)"
^XMB(3.9,146090,2,448,0)=" S PSOCOL=$S(LSTSUB=""PSOSPML3"":1,1:31)"
