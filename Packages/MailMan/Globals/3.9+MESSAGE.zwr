^XMB(3.9,146098,2,973,0)="""RTN"",""SDES2APTLETTER"",165,0)"
^XMB(3.9,146098,2,974,0)=" ;"
^XMB(3.9,146098,2,975,0)="""RTN"",""SDES2APTLETTER"",166,0)"
^XMB(3.9,146098,2,976,0)=" ;  Change display time for noon and midnight from 12:00 PM to 12:00 Noon and 12:00 Midnight"
