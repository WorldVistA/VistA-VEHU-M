^XMB(3.9,146009,2,1180,0)=" I $G(XUARR(FILE,+XUDUZ_"","",7,""I""))'=1,($G(XUARR(FILE,+XUDUZ_"","",9.2,""I""))=""""!($G(XUARR(FILE,+XUDUZ_"","",9.2,""I""))>DT)),($G(XUARR(FILE,+XUDUZ_"","",201,""I""))'="""") S RETURN=1 Q"
