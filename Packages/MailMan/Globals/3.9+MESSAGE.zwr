^XMB(3.9,146100,2,544,0)=" ...;"
^XMB(3.9,146100,2,545,0)="""RTN"",""RGADTP2"",153,0)"
^XMB(3.9,146100,2,546,0)=" ...;**45 don't trigger A31 sync message if A31 was being processed - ack to a31 will sync id elements on MPI"
^XMB(3.9,146100,2,547,0)="""RTN"",""RGADTP2"",154,0)"
^XMB(3.9,146100,2,548,0)=" ...;send the updated fields to the MPI to synch the correlation on the MPI when site receives update from cmor"
^XMB(3.9,146100,2,549,0)="""RTN"",""RGADTP2"",155,0)"
^XMB(3.9,146100,2,550,0)=" ...I HL(""ETN"")'=""A31"" S ZTSAVE(""DFN"")="""",ZTRTN=""MPISYN^RGADTPC"",ZTDESC=""Sending Synchronized Patient Data to MPI..."",ZTIO=""RG QUEUE"",ZTDTH=$H D ^%ZTLOAD"
^XMB(3.9,146100,2,551,0)="""RTN"",""RGADTP2"",156,0)"
^XMB(3.9,146100,2,552,0)=" Q"
