^XMB(3.9,146083,2,215,0)="""QUES"",""XPZ1"",""??"")"
^XMB(3.9,146083,2,216,0)="^D OPT^XPDH"
^XMB(3.9,146083,2,217,0)="""QUES"",""XPZ1"",""A"")"
^XMB(3.9,146083,2,218,0)="Want to DISABLE Scheduled Options, Menu Options, and Protocols"
^XMB(3.9,146083,2,219,0)="""QUES"",""XPZ1"",""B"")"
^XMB(3.9,146083,2,220,0)="NO"
^XMB(3.9,146083,2,221,0)="""QUES"",""XPZ1"",""M"")"
^XMB(3.9,146083,2,222,0)="D XPZ1^XPDIQ"
^XMB(3.9,146083,2,223,0)="""QUES"",""XPZ2"",0)"
^XMB(3.9,146083,2,224,0)="Y"
^XMB(3.9,146083,2,225,0)="""QUES"",""XPZ2"",""??"")"
^XMB(3.9,146083,2,226,0)="^D RTN^XPDH"
^XMB(3.9,146083,2,227,0)="""QUES"",""XPZ2"",""A"")"
^XMB(3.9,146083,2,228,0)="Want to MOVE routines to other CPUs"
^XMB(3.9,146083,2,229,0)="""QUES"",""XPZ2"",""B"")"
