^XMB(3.9,146084,2,2510,0)=" S RET(""PADDRES3"")=$G(SDD(2,DFN_"","",.113,""E""))  ; STREET ADDRESS [LINE 3]"
^XMB(3.9,146084,2,2511,0)="""RTN"",""SDES2GETREGS"",220,0)"
