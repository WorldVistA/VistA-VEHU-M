^XMB(3.9,146084,2,1151,0)="""RTN"",""SDES2CRTCLNAVAL2"",1,0)"
^XMB(3.9,146084,2,1152,0)="SDES2CRTCLNAVAL2 ;ALB/BLB,JDJ/BLB,JDJ,AGW,JDJ,AGW,AGW,AGW,AGW,AGW - SDES2 CREATE CLINIC AVAIL 2 ; JULY 22, 2026"
