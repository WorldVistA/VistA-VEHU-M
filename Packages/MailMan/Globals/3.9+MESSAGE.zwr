^XMB(3.9,146035,2,457,0)="""RTN"",""PSOBBC"",109,0)"
^XMB(3.9,146035,2,458,0)=" D GETRXM D:PSOBBC(""QFLG"") ULK,ULP,ULRX G:PSOBBC(""QFLG"") PROCESSX"
^XMB(3.9,146035,2,459,0)="""RTN"",""PSOBBC"",110,0)"
^XMB(3.9,146035,2,460,0)=" I $G(PSODFN)'=$P(^PSRX(PSOBBC(""IRXN""),0),""^"",2) D  G:PSOBBC(""DFLG"") PROCESS"
^XMB(3.9,146035,2,461,0)="""RTN"",""PSOBBC"",111,0)"
^XMB(3.9,146035,2,462,0)=" .I $G(PSODFN) D ULK,ULP"
^XMB(3.9,146035,2,463,0)="""RTN"",""PSOBBC"",112,0)"
^XMB(3.9,146035,2,464,0)=" .D PT Q:PSOBBC(""DFLG"")"
^XMB(3.9,146035,2,465,0)="""RTN"",""PSOBBC"",113,0)"
^XMB(3.9,146035,2,466,0)=" .D PROFILE^PSORX1"
^XMB(3.9,146035,2,467,0)="""RTN"",""PSOBBC"",114,0)"
^XMB(3.9,146035,2,468,0)=" E  D PTC G:PSOBBC(""DFLG"") PROCESS"
^XMB(3.9,146035,2,469,0)="""RTN"",""PSOBBC"",115,0)"
^XMB(3.9,146035,2,470,0)=" D:'$G(PSOSD) ^PSOBUILD"
^XMB(3.9,146035,2,471,0)="""RTN"",""PSOBBC"",116,0)"
^XMB(3.9,146035,2,472,0)=" S PSOBBC(""DONE"")=PSOBBC(""IRXN"")_"","""
^XMB(3.9,146035,2,473,0)="""RTN"",""PSOBBC"",117,0)"
^XMB(3.9,146035,2,474,0)=" D @PSOBBC1(""FROM"") S:$G(PPL)&$D(BINGRTE) BBRX(1)=$S($D(PSOBBC(""DONE"")):PSOBBC(""DONE""),1:BBRX) D:$D(BINGCRT)&($D(BINGRTE)&($D(DISGROUP))) ^PSOBING1 K BBRX D ULRX G PROCESS"
^XMB(3.9,146035,2,475,0)="""RTN"",""PSOBBC"",118,0)"
^XMB(3.9,146035,2,476,0)="PROCESSX I $G(PPL) D SETX,TRI,Q^PSORXL K PPL,RXFL"
^XMB(3.9,146035,2,477,0)="""RTN"",""PSOBBC"",119,0)"
^XMB(3.9,146035,2,478,0)=" Q"
^XMB(3.9,146035,2,479,0)="""RTN"",""PSOBBC"",120,0)"
^XMB(3.9,146035,2,480,0)="GETRXM ;"
^XMB(3.9,146035,2,481,0)="""RTN"",""PSOBBC"",121,0)"
^XMB(3.9,146035,2,482,0)=" N PRVCHK"
^XMB(3.9,146035,2,483,0)="""RTN"",""PSOBBC"",122,0)"
^XMB(3.9,146035,2,484,0)=" K DIR,PSOBBC(""IRXN""),PSOREFXM"
^XMB(3.9,146035,2,485,0)="""RTN"",""PSOBBC"",123,0)"
^XMB(3.9,146035,2,486,0)=" S DIR(0)=""FO^5:245^K:X'?3N1""""-""""1.N X"""
^XMB(3.9,146035,2,487,0)="""RTN"",""PSOBBC"",124,0)"
^XMB(3.9,146035,2,488,0)=" S DIR(""A"")=""WAND BARCODE"""
^XMB(3.9,146035,2,489,0)="""RTN"",""PSOBBC"",125,0)"
^XMB(3.9,146035,2,490,0)=" S DIR(""?"",1)=""Wand the barcoded number of the prescription to be processed."""
^XMB(3.9,146035,2,491,0)="""RTN"",""PSOBBC"",126,0)"
^XMB(3.9,146035,2,492,0)=" S DIR(""?"",2)=""The number should be of the form NNN-NNNNNN"""
^XMB(3.9,146035,2,493,0)="""RTN"",""PSOBBC"",127,0)"
^XMB(3.9,146035,2,494,0)=" S DIR(""?"",3)=""where the number before the dash is your station number."""
^XMB(3.9,146035,2,495,0)="""RTN"",""PSOBBC"",128,0)"
^XMB(3.9,146035,2,496,0)=" S DIR(""?"")=""Enter """"^"""", or a RETURN to quit."""
^XMB(3.9,146035,2,497,0)="""RTN"",""PSOBBC"",129,0)"
^XMB(3.9,146035,2,498,0)=" D DIR G:PSOBBC(""QFLG"") GETRXMX"
^XMB(3.9,146035,2,499,0)="""RTN"",""PSOBBC"",130,0)"
^XMB(3.9,146035,2,500,0)=" I $P(X,""-"")'=PSOINST W !?7,$C(7),$C(7),$C(7),""Not From this Institution"" G GETRXM"
^XMB(3.9,146035,2,501,0)="""RTN"",""PSOBBC"",131,0)"
^XMB(3.9,146035,2,502,0)=" S (PSOBBC(""IRXN""),PSOBBC(""OIRXN""),BBRX)=$P(X,""-"",2)"
^XMB(3.9,146035,2,503,0)="""RTN"",""PSOBBC"",132,0)"
^XMB(3.9,146035,2,504,0)=" I $G(^PSRX(PSOBBC(""IRXN""),0))']"""" W !,$C(7),""Rx data is not on file !"",! G GETRXM"
^XMB(3.9,146035,2,505,0)="""RTN"",""PSOBBC"",133,0)"
^XMB(3.9,146035,2,506,0)=" I $G(PSOBBC1(""FROM""))=""NEW"" S PRVCHK=$$CHKRXPRV^PSOUTIL(PSOBBC(""IRXN"")) I 'PRVCHK W $C(7),!!,$P(PRVCHK,""^"",2),! G GETRXM"
^XMB(3.9,146035,2,507,0)="""RTN"",""PSOBBC"",134,0)"
^XMB(3.9,146035,2,508,0)=" I $$TITRX^PSOUTL(PSOBBC(""IRXN""))=""t"" D  G GETRXM"
^XMB(3.9,146035,2,509,0)="""RTN"",""PSOBBC"",135,0)"
^XMB(3.9,146035,2,510,0)=" . W $C(7),!!,""Rx# ""_$$GET1^DIQ(52,PSOBBC(""IRXN""),.01)_"" is marked as 'Titration Rx' and cannot be ""_$S(PSOBBC1(""FROM"")=""REFILL"":""refilled."",1:""renewed.""),!"
^XMB(3.9,146035,2,511,0)="""RTN"",""PSOBBC"",136,0)"
^XMB(3.9,146035,2,512,0)=" S PSOXDFN=+$P($G(^PSRX(PSOBBC(""IRXN""),0)),""^"",2) I PSOXDFN S PSOLOUD=1 D:$P($G(^PS(55,PSOXDFN,0)),""^"",6)'=2 EN^PSOHLUP(PSOXDFN) K PSOLOUD"
^XMB(3.9,146035,2,513,0)="""RTN"",""PSOBBC"",137,0)"
^XMB(3.9,146035,2,514,0)=" K PSOXDFN I $P($G(^PSRX(PSOBBC(""IRXN""),""STA"")),""^"")=13 W !,$C(7),""Rx has already been deleted."" G GETRXM"
^XMB(3.9,146035,2,515,0)="""RTN"",""PSOBBC"",138,0)"
^XMB(3.9,146035,2,516,0)=" I $G(PSOBBC(""DONE""))[PSOBBC(""IRXN"")_"","" W !,$C(7),""Rx has already been entered"" G GETRXM"
^XMB(3.9,146035,2,517,0)="""RTN"",""PSOBBC"",139,0)"
^XMB(3.9,146035,2,518,0)=" I $G(PSOBBC1(""FROM""))=""REFILL"" S PSOREFXM=$G(PSOBBC(""IRXN"")) I PSOREFXM D PSOL^PSSLOCK(PSOREFXM) I '$G(PSOMSG) D  K PSOMSG G GETRXM"
^XMB(3.9,146035,2,519,0)="""RTN"",""PSOBBC"",140,0)"
^XMB(3.9,146035,2,520,0)=" .I $P($G(PSOMSG),""^"",2)'="""" W $C(7),!!?5,$P(PSOMSG,""^"",2),! Q"
^XMB(3.9,146035,2,521,0)="""RTN"",""PSOBBC"",141,0)"
^XMB(3.9,146035,2,522,0)=" .W $C(7),!!?5,""Another person is editing Rx ""_$P($G(^PSRX(+$G(PSOBBC(""IRXN"")),0)),""^""),!"
^XMB(3.9,146035,2,523,0)="""RTN"",""PSOBBC"",142,0)"
^XMB(3.9,146035,2,524,0)=" I '$D(PSODFNX(+$P(^PSRX(PSOBBC(""IRXN""),0),""^"",2))),$G(PSOBBC1(""FROM""))=""NEW"" K PSONOERR D  G:'$G(PSOPLCK)!($G(PSONOERR)) GETRXM"
^XMB(3.9,146035,2,525,0)="""RTN"",""PSOBBC"",143,0)"
^XMB(3.9,146035,2,526,0)=" .S PSOPLCK=$$L^PSSLOCK(+$P(^PSRX(PSOBBC(""IRXN""),0),""^"",2),0) I '$G(PSOPLCK) D LOCK^PSOORCPY Q"
^XMB(3.9,146035,2,527,0)="""RTN"",""PSOBBC"",144,0)"
^XMB(3.9,146035,2,528,0)=" .S X=+$P(^PSRX(PSOBBC(""IRXN""),0),""^"",2)_"";DPT("" D LK^ORX2 I 'Y S PSONOERR=1 D UL^PSSLOCK(+$P(^PSRX(PSOBBC(""IRXN""),0),""^"",2)) Q"
^XMB(3.9,146035,2,529,0)="""RTN"",""PSOBBC"",145,0)"
^XMB(3.9,146035,2,530,0)=" .S PSODFNX(+$P(^PSRX(PSOBBC(""IRXN""),0),""^"",2))="""""
^XMB(3.9,146035,2,531,0)="""RTN"",""PSOBBC"",146,0)"
^XMB(3.9,146035,2,532,0)="GETRXMX K X,Y,DIR,PSOOPT"
^XMB(3.9,146035,2,533,0)="""RTN"",""PSOBBC"",147,0)"
^XMB(3.9,146035,2,534,0)=" Q"
^XMB(3.9,146035,2,535,0)="""RTN"",""PSOBBC"",148,0)"
^XMB(3.9,146035,2,536,0)=" ;"
^XMB(3.9,146035,2,537,0)="""RTN"",""PSOBBC"",149,0)"
^XMB(3.9,146035,2,538,0)="PT ;"
^XMB(3.9,146035,2,539,0)="""RTN"",""PSOBBC"",150,0)"
^XMB(3.9,146035,2,540,0)=" S PSOBBC(""DFLG"")=0"
^XMB(3.9,146035,2,541,0)="""RTN"",""PSOBBC"",151,0)"
^XMB(3.9,146035,2,542,0)=" W !,$C(7),""New Patient, please pause"",!"
^XMB(3.9,146035,2,543,0)="""RTN"",""PSOBBC"",152,0)"
^XMB(3.9,146035,2,544,0)=" I $G(PPL) D SETX,TRI,Q^PSORXL K PPL"
^XMB(3.9,146035,2,545,0)="""RTN"",""PSOBBC"",153,0)"
^XMB(3.9,146035,2,546,0)=" K RXFL"
^XMB(3.9,146035,2,547,0)="""RTN"",""PSOBBC"",154,0)"
^XMB(3.9,146035,2,548,0)=" S (DFN,PSODFN)=$P(^PSRX(PSOBBC(""IRXN""),0),""^"",2),PSORX(""NAME"")=$P(^DPT(PSODFN,0),""^"")"
^XMB(3.9,146035,2,549,0)="""RTN"",""PSOBBC"",155,0)"
^XMB(3.9,146035,2,550,0)=" D ICN^PSODPT(DFN)"
^XMB(3.9,146035,2,551,0)="""RTN"",""PSOBBC"",156,0)"
^XMB(3.9,146035,2,552,0)=" ;CHECK FOR BAD ADDRESS/SAB"
^XMB(3.9,146035,2,553,0)="""RTN"",""PSOBBC"",157,0)"
^XMB(3.9,146035,2,554,0)=" S PSOLOUD=1 D:$P($G(^PS(55,PSODFN,0)),""^"",6)'=2 EN^PSOHLUP(PSODFN) K PSOLOUD"
^XMB(3.9,146035,2,555,0)="""RTN"",""PSOBBC"",158,0)"
^XMB(3.9,146035,2,556,0)=" D ^PSOBUILD"
^XMB(3.9,146035,2,557,0)="""RTN"",""PSOBBC"",159,0)"
^XMB(3.9,146035,2,558,0)=" S PSOX=$G(^PS(55,PSODFN,""PS"")) I PSOX]"""" S PSORX(""PATIENT STATUS"")=$P($G(^PS(53,PSOX,0)),""^"")"
^XMB(3.9,146035,2,559,0)="""RTN"",""PSOBBC"",160,0)"
^XMB(3.9,146035,2,560,0)=" K PSOX"
^XMB(3.9,146035,2,561,0)="""RTN"",""PSOBBC"",161,0)"
^XMB(3.9,146035,2,562,0)="PTC S (DFN,PSODFN)=$P(^PSRX(PSOBBC(""IRXN""),0),""^"",2)"
^XMB(3.9,146035,2,563,0)="""RTN"",""PSOBBC"",162,0)"
^XMB(3.9,146035,2,564,0)=" S PSOLOUD=1 D:$P($G(^PS(55,PSODFN,0)),""^"",6)'=2 EN^PSOHLUP(PSODFN) K PSOLOUD"
^XMB(3.9,146035,2,565,0)="""RTN"",""PSOBBC"",163,0)"
^XMB(3.9,146035,2,566,0)=" S PSOBBC(""DFLG"")=0 D GET^PSOPTPST"
^XMB(3.9,146035,2,567,0)="""RTN"",""PSOBBC"",164,0)"
^XMB(3.9,146035,2,568,0)=" I $G(PSOPTPST(2,PSODFN,.351))]"""" S PSOBBC(""DFLG"")=1 D DEAD^PSOPTPST G PTX"
^XMB(3.9,146035,2,569,0)="""RTN"",""PSOBBC"",165,0)"
^XMB(3.9,146035,2,570,0)=" N PSOTPEXT I $G(PSOBBC1(""FROM""))=""NEW"",$D(^PS(52.91,PSODFN,0)) I '$P(^PS(52.91,PSODFN,0),""^"",3)!($P(^(0),""^"",3)>DT) D PDIR^PSOTPCAN(PSODFN) I $G(PSOTPEXT) K PSOTPEXT S PSOBBC(""DFLG"")=1 G PTX"
^XMB(3.9,146035,2,571,0)="""RTN"",""PSOBBC"",166,0)"
^XMB(3.9,146035,2,572,0)=" K PSOTPEXT"
^XMB(3.9,146035,2,573,0)="""RTN"",""PSOBBC"",167,0)"
^XMB(3.9,146035,2,574,0)=" I $G(PSOPTPST(2,PSODFN,.1))]"""" D:'PSOBBC(""INOK"") PID W !,$C(7),?10,""PATIENT IS AN INPATIENT ON WARD "",PSOPTPST(2,PSODFN,.1),"" !!"" I 'PSOBBC(""INOK"") S PSOBBC(""DFLG"")=1 G PTX"
^XMB(3.9,146035,2,575,0)="""RTN"",""PSOBBC"",168,0)"
^XMB(3.9,146035,2,576,0)=" K PSORX(""CNH"")"
^XMB(3.9,146035,2,577,0)="""RTN"",""PSOBBC"",169,0)"
^XMB(3.9,146035,2,578,0)=" I $G(PSOPTPST(2,PSODFN,148))=""YES"" D:'PSOBBC(""CNHOK"") PID W !,$C(7),?10,""PATIENT IS IN A CONTRACT NURSING HOME !!"" S:PSOBBC(""CNHOK"") PSORX(""CNH"")=1 I 'PSOBBC(""CNHOK"") S PSOBBC(""DFLG"")=1 G PTX"
^XMB(3.9,146035,2,579,0)="""RTN"",""PSOBBC"",170,0)"
^XMB(3.9,146035,2,580,0)=" D:PSOBBC1(""FROM"")=""NEW"" COPAY^PSOPTPST"
^XMB(3.9,146035,2,581,0)="""RTN"",""PSOBBC"",171,0)"
^XMB(3.9,146035,2,582,0)="PTX K PSOPTPST W:PSOBBC(""DFLG"") !!,$C(7),""Rx not filled"" W:$G(PSOBBC(""IRXN"")) "" RX IEN ""_PSOBBC(""IRXN"") ;RTW NSR20160206"
^XMB(3.9,146035,2,583,0)="""RTN"",""PSOBBC"",172,0)"
^XMB(3.9,146035,2,584,0)=" Q"
^XMB(3.9,146035,2,585,0)="""RTN"",""PSOBBC"",173,0)"
^XMB(3.9,146035,2,586,0)=" ;"
^XMB(3.9,146035,2,587,0)="""RTN"",""PSOBBC"",174,0)"
^XMB(3.9,146035,2,588,0)="REFILL ;"
^XMB(3.9,146035,2,589,0)="""RTN"",""PSOBBC"",175,0)"
^XMB(3.9,146035,2,590,0)=" ; Titration Rx refill request check from AudioFax/Internet"
^XMB(3.9,146035,2,591,0)="""RTN"",""PSOBBC"",176,0)"
^XMB(3.9,146035,2,592,0)=" N PSORXIEN,PSOPARKED,PSOORIG"
^XMB(3.9,146035,2,593,0)="""RTN"",""PSOBBC"",177,0)"
^XMB(3.9,146035,2,594,0)=" S PSORXIEN=+$G(PSOBBC(""IRXN""))"
^XMB(3.9,146035,2,595,0)="""RTN"",""PSOBBC"",178,0)"
^XMB(3.9,146035,2,596,0)=" S PSOORIG=0"
^XMB(3.9,146035,2,597,0)="""RTN"",""PSOBBC"",179,0)"
^XMB(3.9,146035,2,598,0)=" S PSOPARKED=($G(^PSRX(PSORXIEN,""STA""))=0)&($G(^PSRX(PSORXIEN,""PARK"")))"
^XMB(3.9,146035,2,599,0)="""RTN"",""PSOBBC"",180,0)"
^XMB(3.9,146035,2,600,0)=" I PSOPARKED S PSOORIG=$$CHKPRKORIG^PSOPRKA(PSORXIEN)  ;check if filling original or refill"
^XMB(3.9,146035,2,601,0)="""RTN"",""PSOBBC"",181,0)"
^XMB(3.9,146035,2,602,0)=" ;"
^XMB(3.9,146035,2,603,0)="""RTN"",""PSOBBC"",182,0)"
^XMB(3.9,146035,2,604,0)=" ; p441 PAPI - don't quit here if filling original parked titration"
^XMB(3.9,146035,2,605,0)="""RTN"",""PSOBBC"",183,0)"
^XMB(3.9,146035,2,606,0)=" I PSORXIEN,$D(^PSRX(PSORXIEN,0)),$$TITRX^PSOUTL(PSORXIEN)=""t"",'PSOORIG D  Q"
^XMB(3.9,146035,2,607,0)="""RTN"",""PSOBBC"",184,0)"
^XMB(3.9,146035,2,608,0)=" . W !!,$C(7),""Rx# ""_$$GET1^DIQ(52,PSORXIEN,.01)_"" is marked as 'Titration Rx' and cannot be refilled."",!"
^XMB(3.9,146035,2,609,0)="""RTN"",""PSOBBC"",185,0)"
^XMB(3.9,146035,2,610,0)=" . D PAUSE^VALM1"
^XMB(3.9,146035,2,611,0)="""RTN"",""PSOBBC"",186,0)"
^XMB(3.9,146035,2,612,0)=" N PSOFROM S PSOFROM=""REFILL"",XFROM=""BATCH"""
^XMB(3.9,146035,2,613,0)="""RTN"",""PSOBBC"",187,0)"
^XMB(3.9,146035,2,614,0)=" D EN^PSOREF0(.PSOBBC)"
^XMB(3.9,146035,2,615,0)="""RTN"",""PSOBBC"",188,0)"
^XMB(3.9,146035,2,616,0)=" Q"
^XMB(3.9,146035,2,617,0)="""RTN"",""PSOBBC"",189,0)"
^XMB(3.9,146035,2,618,0)="REFILLX ;"
^XMB(3.9,146035,2,619,0)="""RTN"",""PSOBBC"",190,0)"
^XMB(3.9,146035,2,620,0)=" Q"
^XMB(3.9,146035,2,621,0)="""RTN"",""PSOBBC"",191,0)"
^XMB(3.9,146035,2,622,0)=" ;"
^XMB(3.9,146035,2,623,0)="""RTN"",""PSOBBC"",192,0)"
^XMB(3.9,146035,2,624,0)="NEW ;"
^XMB(3.9,146035,2,625,0)="""RTN"",""PSOBBC"",193,0)"
^XMB(3.9,146035,2,626,0)=" ; Titration Rx Renewal request check from AudioFax"
^XMB(3.9,146035,2,627,0)="""RTN"",""PSOBBC"",194,0)"
^XMB(3.9,146035,2,628,0)=" N PSORXIEN,PSOACT"
^XMB(3.9,146035,2,629,0)="""RTN"",""PSOBBC"",195,0)"
^XMB(3.9,146035,2,630,0)=" S PSORXIEN=+$G(PSOBBC(""IRXN""))"
^XMB(3.9,146035,2,631,0)="""RTN"",""PSOBBC"",196,0)"
^XMB(3.9,146035,2,632,0)=" I PSORXIEN,$D(^PSRX(PSORXIEN,0)),$$TITRX^PSOUTL(PSORXIEN)=""t"" D  Q"
^XMB(3.9,146035,2,633,0)="""RTN"",""PSOBBC"",197,0)"
^XMB(3.9,146035,2,634,0)=" . W !!,$C(7),""Rx# ""_$$GET1^DIQ(52,PSORXIEN,.01)_""    Drug: ""_$$GET1^DIQ(52,PSORXIEN,6),!"
^XMB(3.9,146035,2,635,0)="""RTN"",""PSOBBC"",198,0)"
