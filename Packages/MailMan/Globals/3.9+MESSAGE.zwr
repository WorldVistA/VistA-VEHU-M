^XMB(3.9,146011,2,664,0)=" I $L(PSORX(""PSOL"",PSOX2))+$L(RXIEN)<220 S PSORX(""PSOL"",PSOX2)=PSORX(""PSOL"",PSOX2)_RXIEN_"","""
