^XMB(3.9,146057,2,434,0)=" . ; patch HL*1.6*122"
^XMB(3.9,146057,2,435,0)="""RTN"",""HLCS2"",98,0)"
^XMB(3.9,146057,2,436,0)=" . ; TCP Multi listener: quit if TCP service as GT.M, DSM,"
