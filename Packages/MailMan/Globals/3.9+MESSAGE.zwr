^XMB(3.9,146087,2,698,0)=" N YSID,YSNAM,YSRAW,YSTSC,CNT,YSTSC2,YSTSC3"
^XMB(3.9,146087,2,699,0)="""RTN"",""YTQRCDB"",30,0)"
^XMB(3.9,146087,2,700,0)=" K ^TMP(""YTQ-JSON"",$J),YTQRRSLT"
^XMB(3.9,146087,2,701,0)="""RTN"",""YTQRCDB"",31,0)"
^XMB(3.9,146087,2,702,0)=" K ^TMP($J) N YS"
^XMB(3.9,146087,2,703,0)="""RTN"",""YTQRCDB"",32,0)"
^XMB(3.9,146087,2,704,0)=" S YS(""CODE"")=$G(DATA(""name""))"
