^XMB(3.9,146090,2,631,0)="""RTN"",""PSOSPML4"",196,0)"
^XMB(3.9,146090,2,632,0)=" . S PSOASVER=$$GET1^DIQ(58.41,STATEIEN,1,""I"")"
^XMB(3.9,146090,2,633,0)="""RTN"",""PSOSPML4"",197,0)"
^XMB(3.9,146090,2,634,0)=" . S PSOTXRTS=+$$GET1^DIQ(58.41,STATEIEN,12,""I"")"
^XMB(3.9,146090,2,635,0)="""RTN"",""PSOSPML4"",198,0)"
^XMB(3.9,146090,2,636,0)=" . ;"
^XMB(3.9,146090,2,637,0)="""RTN"",""PSOSPML4"",199,0)"
^XMB(3.9,146090,2,638,0)=" . I 'STATEIEN D  Q"
^XMB(3.9,146090,2,639,0)="""RTN"",""PSOSPML4"",200,0)"
^XMB(3.9,146090,2,640,0)=" . . S VALMSG=""No State on file for Division ""_$$GET1^DIQ(59,$$RXSITE^PSOBPSUT(RXIEN,0),.01) W $C(7)"
^XMB(3.9,146090,2,641,0)="""RTN"",""PSOSPML4"",201,0)"
^XMB(3.9,146090,2,642,0)=" . I $P($$SPOK^PSOSPMUT(STATEIEN),""^"")=-1 D  Q      ;P659"
^XMB(3.9,146090,2,643,0)="""RTN"",""PSOSPML4"",202,0)"
^XMB(3.9,146090,2,644,0)=" . . S VALMSG=$P($$SPOK^PSOSPMUT(STATEIEN),""^"",2) W $C(7)"
^XMB(3.9,146090,2,645,0)="""RTN"",""PSOSPML4"",203,0)"
^XMB(3.9,146090,2,646,0)=" . . I $D(VALMSG) W !!!,VALMSG,""...NO BATCH SENT!"",!"
^XMB(3.9,146090,2,647,0)="""RTN"",""PSOSPML4"",204,0)"
^XMB(3.9,146090,2,648,0)=" . ;"
^XMB(3.9,146090,2,649,0)="""RTN"",""PSOSPML4"",205,0)"
^XMB(3.9,146090,2,650,0)=" . K ^TMP(""PSOSPMRX"",$J) S ^TMP(""PSOSPMRX"",$J,STATEIEN,RXIEN,FILLNUM)=RECTYPE"
^XMB(3.9,146090,2,651,0)="""RTN"",""PSOSPML4"",206,0)"
^XMB(3.9,146090,2,652,0)=" . S BATIEN=$$BLDBAT^PSOSPMU1($S(RECTYPE=""V""&(PSOASVER=""1995""):""VD"",1:""RX""))"
^XMB(3.9,146090,2,653,0)="""RTN"",""PSOSPML4"",207,0)"
^XMB(3.9,146090,2,654,0)=" . I $G(BATCHIEN),$G(BATCHIEN)'=$G(BATIEN) S BATCHIEN=$G(BATIEN)     ;p810"
^XMB(3.9,146090,2,655,0)="""RTN"",""PSOSPML4"",208,0)"
^XMB(3.9,146090,2,656,0)=" . ;"
^XMB(3.9,146090,2,657,0)="""RTN"",""PSOSPML4"",209,0)"
^XMB(3.9,146090,2,658,0)=" . I (($$GET1^DIQ(58.42,BATIEN,2,""I"")=""VD"")&'PSOTXRTS) D"
^XMB(3.9,146090,2,659,0)="""RTN"",""PSOSPML4"",210,0)"
^XMB(3.9,146090,2,660,0)=" . . D EXMSG^PSOSPML2(1) W ! K %ZIS,IOP,POP,ZTSK S %ZIS=""QM"" D ^%ZIS K %ZIS Q:POP  U IO"
^XMB(3.9,146090,2,661,0)="""RTN"",""PSOSPML4"",211,0)"
^XMB(3.9,146090,2,662,0)=" . . W ! D EXPORT^PSOSPMUT(BATIEN,""VIEW"")"
^XMB(3.9,146090,2,663,0)="""RTN"",""PSOSPML4"",212,0)"
^XMB(3.9,146090,2,664,0)=" . . D ^%ZISC N DIE,DA,DR S DIE=""^PS(58.42,"",DA=BATIEN"
^XMB(3.9,146090,2,665,0)="""RTN"",""PSOSPML4"",213,0)"
^XMB(3.9,146090,2,666,0)=" . . S DR=""6///<Manual Web Upload>;7////""_DUZ_"";9///""_$$NOW^XLFDT()"
^XMB(3.9,146090,2,667,0)="""RTN"",""PSOSPML4"",214,0)"
^XMB(3.9,146090,2,668,0)=" . . D ^DIE"
^XMB(3.9,146090,2,669,0)="""RTN"",""PSOSPML4"",215,0)"
^XMB(3.9,146090,2,670,0)=" . E  D EXPORT^PSOSPMUT(BATIEN,""EXPORT"")"
^XMB(3.9,146090,2,671,0)="""RTN"",""PSOSPML4"",216,0)"
^XMB(3.9,146090,2,672,0)=" . Q"
^XMB(3.9,146090,2,673,0)="""RTN"",""PSOSPML4"",217,0)"
^XMB(3.9,146090,2,674,0)=" K DIR S DIR(""A"")=""Press Return to continue"",DIR(0)=""E"" D ^DIR"
^XMB(3.9,146090,2,675,0)="""RTN"",""PSOSPML4"",218,0)"
^XMB(3.9,146090,2,676,0)=" Q"
^XMB(3.9,146090,2,677,0)="""RTN"",""PSOSPML4"",219,0)"
^XMB(3.9,146090,2,678,0)=" ;"
^XMB(3.9,146090,2,679,0)="""RTN"",""PSOSPML4"",220,0)"
^XMB(3.9,146090,2,680,0)="VIEW ; - Rx View Action"
^XMB(3.9,146090,2,681,0)="""RTN"",""PSOSPML4"",221,0)"
^XMB(3.9,146090,2,682,0)=" ; Most of these variables most be NEWed because they are being killed by PSORXVW"
^XMB(3.9,146090,2,683,0)="""RTN"",""PSOSPML4"",222,0)"
^XMB(3.9,146090,2,684,0)=" N VALMCNT,PSOTITLE,PSOLSTLN,QUIT,DIR,DIRUT,DIROUT,Y,X,XX,BPSVRX,PSODFN,DFN,RX2"
^XMB(3.9,146090,2,685,0)="""RTN"",""PSOSPML4"",223,0)"
^XMB(3.9,146090,2,686,0)=" N ST,RFL,RFLL,RFL1,ST,II,J,N,PHYS,L1,DIRUT,PSDIV,PSEXDT,MED,M1,FFX,DTT,DAT,RX0"
^XMB(3.9,146090,2,687,0)="""RTN"",""PSOSPML4"",224,0)"
^XMB(3.9,146090,2,688,0)=" N LBL,I,RFDATE,%H,%I,RN,RFT,%,%I,DFN,GMRA,GMRAL,HDR,POERR,PTST,REFL,RF,RLD,RX3"
^XMB(3.9,146090,2,689,0)="""RTN"",""PSOSPML4"",225,0)"
^XMB(3.9,146090,2,690,0)=" N RXN,RXOR,SG,VA,VADM,VAERR,VALMBCK,VAPA,X,DIC,REA,ZD,PSOHD,PSOBCK,PSODFN,QUIT"
^XMB(3.9,146090,2,691,0)="""RTN"",""PSOSPML4"",226,0)"
^XMB(3.9,146090,2,692,0)=" N Z0,Z1,EXDT,IFN,DIR,DUOUT,DTOUT,PSOELSE,R3,RTN,SIG,STA,P1,PL,P0"
^XMB(3.9,146090,2,693,0)="""RTN"",""PSOSPML4"",227,0)"
^XMB(3.9,146090,2,694,0)=" ;"
^XMB(3.9,146090,2,695,0)="""RTN"",""PSOSPML4"",228,0)"
^XMB(3.9,146090,2,696,0)=" S PSOTITLE=VALM(""TITLE"")"
^XMB(3.9,146090,2,697,0)="""RTN"",""PSOSPML4"",229,0)"
^XMB(3.9,146090,2,698,0)=" ;"
^XMB(3.9,146090,2,699,0)="""RTN"",""PSOSPML4"",230,0)"
^XMB(3.9,146090,2,700,0)=" ; DO structure used to avoid losing variables RXIEN,FILLNUM,LINE,PSOTITLE"
^XMB(3.9,146090,2,701,0)="""RTN"",""PSOSPML4"",231,0)"
^XMB(3.9,146090,2,702,0)=" DO"
^XMB(3.9,146090,2,703,0)="""RTN"",""PSOSPML4"",232,0)"
^XMB(3.9,146090,2,704,0)=" . N PSOVDA,DA,PS"
^XMB(3.9,146090,2,705,0)="""RTN"",""PSOSPML4"",233,0)"
^XMB(3.9,146090,2,706,0)=" . S (PSOVDA,DA)=RXIEN,BPSVRX=0,PS=""REJECT"""
^XMB(3.9,146090,2,707,0)="""RTN"",""PSOSPML4"",234,0)"
^XMB(3.9,146090,2,708,0)=" . N RXIEN,FILLNUM,LINE,PSOTITLE D DP^PSORXVW"
^XMB(3.9,146090,2,709,0)="""RTN"",""PSOSPML4"",235,0)"
^XMB(3.9,146090,2,710,0)=" ;"
^XMB(3.9,146090,2,711,0)="""RTN"",""PSOSPML4"",236,0)"
^XMB(3.9,146090,2,712,0)=" S VALMBCK=""R"",VALM(""TITLE"")=PSOTITLE"
^XMB(3.9,146090,2,713,0)="""RTN"",""PSOSPML4"",237,0)"
^XMB(3.9,146090,2,714,0)=" Q"
^XMB(3.9,146090,2,715,0)="""RTN"",""PSOSPML4"",238,0)"
^XMB(3.9,146090,2,716,0)=" ;"
^XMB(3.9,146090,2,717,0)="""RTN"",""PSOSPML4"",239,0)"
^XMB(3.9,146090,2,718,0)="MP ; - Patient Medication Profile"
^XMB(3.9,146090,2,719,0)="""RTN"",""PSOSPML4"",240,0)"
^XMB(3.9,146090,2,720,0)=" N SITEIEN,PATIENT,SITE,DFN"
^XMB(3.9,146090,2,721,0)="""RTN"",""PSOSPML4"",241,0)"
^XMB(3.9,146090,2,722,0)=" D FULL^VALM1 W !"
^XMB(3.9,146090,2,723,0)="""RTN"",""PSOSPML4"",242,0)"
^XMB(3.9,146090,2,724,0)=" S SITEIEN=+$$RXSITE^PSOBPSUT(RXIEN,0) S:$G(PSOSITE) SITE=PSOSITE"
^XMB(3.9,146090,2,725,0)="""RTN"",""PSOSPML4"",243,0)"
^XMB(3.9,146090,2,726,0)=" S PATIENT=+$$GET1^DIQ(52,RXIEN,2,""I"")"
^XMB(3.9,146090,2,727,0)="""RTN"",""PSOSPML4"",244,0)"
^XMB(3.9,146090,2,728,0)=" D LST^PSOPMP0(SITEIEN,PATIENT) S VALMBCK=""R"""
