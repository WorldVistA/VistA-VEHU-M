^XMB(3.9,146017,2,1357,0)="""RTN"",""SDES2CANCLNAVAIL"",116,0)"
^XMB(3.9,146017,2,1358,0)=" S CANCEL(""START DATE TIME"")=$$VALISODTTM^SDES2VALISODTTM(.ERRORS,$G(CANCEL(""START DATE TIME"")),CLINICIEN,1,9,11)"
^XMB(3.9,146017,2,1359,0)="""RTN"",""SDES2CANCLNAVAIL"",117,0)"
^XMB(3.9,146017,2,1360,0)=" S CANCEL(""END DATE TIME"")=$$VALISODTTM^SDES2VALISODTTM(.ERRORS,$G(CANCEL(""END DATE TIME"")),CLINICIEN,1,10,12)"
^XMB(3.9,146017,2,1361,0)="""RTN"",""SDES2CANCLNAVAIL"",118,0)"
^XMB(3.9,146017,2,1362,0)=" I $G(CANCEL(""START DATE TIME""))>$G(CANCEL(""END DATE TIME"")) D ERRLOG^SDESJSON(.ERRORS,13)"
^XMB(3.9,146017,2,1363,0)="""RTN"",""SDES2CANCLNAVAIL"",119,0)"
^XMB(3.9,146017,2,1364,0)=" ;"
^XMB(3.9,146017,2,1365,0)="""RTN"",""SDES2CANCLNAVAIL"",120,0)"
^XMB(3.9,146017,2,1366,0)=" D VALIDATEFLAG(.ERRORS,FLAG,$G(CANCEL(""START DATE TIME"")),$G(CANCEL(""END DATE TIME"")))"
^XMB(3.9,146017,2,1367,0)="""RTN"",""SDES2CANCLNAVAIL"",121,0)"
^XMB(3.9,146017,2,1368,0)=" I $L(REMARKS),$L(REMARKS)<3!($L(REMARKS)>160) D ERRLOG^SDESJSON(.ERRORS,255)"
^XMB(3.9,146017,2,1369,0)="""RTN"",""SDES2CANCLNAVAIL"",122,0)"
^XMB(3.9,146017,2,1370,0)=" I $D(ERRORS) Q"
^XMB(3.9,146017,2,1371,0)="""RTN"",""SDES2CANCLNAVAIL"",123,0)"
^XMB(3.9,146017,2,1372,0)=" ;"
^XMB(3.9,146017,2,1373,0)="""RTN"",""SDES2CANCLNAVAIL"",124,0)"
^XMB(3.9,146017,2,1374,0)=" D VALCLINICDETAILS(.ERRORS,CLINICIEN,$G(CANCEL(""START DATE TIME"")),$G(CANCEL(""END DATE TIME"")),FLAG) ;"
^XMB(3.9,146017,2,1375,0)="""RTN"",""SDES2CANCLNAVAIL"",125,0)"
