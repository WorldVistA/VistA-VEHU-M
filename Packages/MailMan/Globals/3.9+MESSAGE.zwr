^XMB(3.9,146085,2,598,0)=" . . I '$D(@(XDRDIC_(+YVAL)_"",0)""))!'$D(@(XDRDIC_(+$P(YVAL,U,2))_"",0)"")) Q"
^XMB(3.9,146085,2,599,0)="""RTN"",""XDRMERGB"",161,0)"
^XMB(3.9,146085,2,600,0)=" . . I $P(YVAL,U,4)'=2 S XDRX(+YVAL,+$P(YVAL,U,2))=Y ; get ien numbers from duplicate file"
^XMB(3.9,146085,2,601,0)="""RTN"",""XDRMERGB"",162,0)"
^XMB(3.9,146085,2,602,0)=" . . E  S XDRX(+$P(YVAL,U,2),+YVAL)=Y ; Reverse - merge to switched"
^XMB(3.9,146085,2,603,0)="""RTN"",""XDRMERGB"",163,0)"
^XMB(3.9,146085,2,604,0)=" . . S XNCNT=XNCNT+1"
^XMB(3.9,146085,2,605,0)="""RTN"",""XDRMERGB"",164,0)"
^XMB(3.9,146085,2,606,0)=" W !!,XNCNT,""  Entries Ready to be included in merge"""
^XMB(3.9,146085,2,607,0)="""RTN"",""XDRMERGB"",165,0)"
^XMB(3.9,146085,2,608,0)=" I $O(XDRX(0))'>0 D  Q"
^XMB(3.9,146085,2,609,0)="""RTN"",""XDRMERGB"",166,0)"
^XMB(3.9,146085,2,610,0)=" . W !!?15,$C(7),""No Verified Duplicates included in merge"",$C(7),!!"
^XMB(3.9,146085,2,611,0)="""RTN"",""XDRMERGB"",167,0)"
^XMB(3.9,146085,2,612,0)=" ;"
^XMB(3.9,146085,2,613,0)="""RTN"",""XDRMERGB"",168,0)"
^XMB(3.9,146085,2,614,0)=" K DIR S DIR(0)=""Y"""
^XMB(3.9,146085,2,615,0)="""RTN"",""XDRMERGB"",169,0)"
^XMB(3.9,146085,2,616,0)=" S DIR(""A"",1)=""This process will take a **LONG** time (usually over 15 hours, and sometimes"""
^XMB(3.9,146085,2,617,0)="""RTN"",""XDRMERGB"",170,0)"
^XMB(3.9,146085,2,618,0)=" S DIR(""A"",2)=""considerably longer), but you CAN stop and restart the process when you"""
^XMB(3.9,146085,2,619,0)="""RTN"",""XDRMERGB"",171,0)"
^XMB(3.9,146085,2,620,0)=" S DIR(""A"")=""want using the options.  OK"""
^XMB(3.9,146085,2,621,0)="""RTN"",""XDRMERGB"",172,0)"
^XMB(3.9,146085,2,622,0)=" D ^DIR K DIR Q:Y'>0"
^XMB(3.9,146085,2,623,0)="""RTN"",""XDRMERGB"",173,0)"
^XMB(3.9,146085,2,624,0)="NAME W !! S DIR(0)=""F^2:30"""
^XMB(3.9,146085,2,625,0)="""RTN"",""XDRMERGB"",174,0)"
^XMB(3.9,146085,2,626,0)=" S DIR(""A"")=""Name for Merge Process"""
^XMB(3.9,146085,2,627,0)="""RTN"",""XDRMERGB"",175,0)"
^XMB(3.9,146085,2,628,0)=" S DIR(""?"",1)=""Enter a unique name by which the MERGE PROCESS will be identified"""
^XMB(3.9,146085,2,629,0)="""RTN"",""XDRMERGB"",176,0)"
^XMB(3.9,146085,2,630,0)=" S DIR(""?"")=""This name should be 2 to 30 characters in length"""
^XMB(3.9,146085,2,631,0)="""RTN"",""XDRMERGB"",177,0)"
^XMB(3.9,146085,2,632,0)=" D ^DIR"
^XMB(3.9,146085,2,633,0)="""RTN"",""XDRMERGB"",178,0)"
^XMB(3.9,146085,2,634,0)=" K DIR Q:Y=U  S XDRNAME=Y"
^XMB(3.9,146085,2,635,0)="""RTN"",""XDRMERGB"",179,0)"
^XMB(3.9,146085,2,636,0)=" I $$FIND1^DIC(15.2,"","",""Q"",XDRNAME)>0 D  G NAME"
^XMB(3.9,146085,2,637,0)="""RTN"",""XDRMERGB"",180,0)"
^XMB(3.9,146085,2,638,0)=" . W !!,$C(7),""The name entered has already been used.  The name must be unique."",!!"
^XMB(3.9,146085,2,639,0)="""RTN"",""XDRMERGB"",181,0)"
^XMB(3.9,146085,2,640,0)=" ;"
^XMB(3.9,146085,2,641,0)="""RTN"",""XDRMERGB"",182,0)"
^XMB(3.9,146085,2,642,0)=" ; CREATE PROCESS ENTRY"
^XMB(3.9,146085,2,643,0)="""RTN"",""XDRMERGB"",183,0)"
^XMB(3.9,146085,2,644,0)=" ;"
^XMB(3.9,146085,2,645,0)="""RTN"",""XDRMERGB"",184,0)"
^XMB(3.9,146085,2,646,0)=" S XDRXX(15.2,""+1,"",.01)=XDRNAME"
^XMB(3.9,146085,2,647,0)="""RTN"",""XDRMERGB"",185,0)"
^XMB(3.9,146085,2,648,0)=" S XDRXX(15.2,""+1,"",.02)=XDRFIL"
^XMB(3.9,146085,2,649,0)="""RTN"",""XDRMERGB"",186,0)"
^XMB(3.9,146085,2,650,0)=" D UPDATE^DIE("""",""XDRXX"",""XDRYY"",""XDRMA"")"
^XMB(3.9,146085,2,651,0)="""RTN"",""XDRMERGB"",187,0)"
^XMB(3.9,146085,2,652,0)=" S XDRFDA=$G(XDRYY(1))"
^XMB(3.9,146085,2,653,0)="""RTN"",""XDRMERGB"",188,0)"
^XMB(3.9,146085,2,654,0)=" ;"
^XMB(3.9,146085,2,655,0)="""RTN"",""XDRMERGB"",189,0)"
^XMB(3.9,146085,2,656,0)=" ; NOW MOVE LIST OF DUPLICATES TO BE PROCESSED INTO THIS ENTRY"
^XMB(3.9,146085,2,657,0)="""RTN"",""XDRMERGB"",190,0)"
^XMB(3.9,146085,2,658,0)=" S XDRIENS=""+1,""_XDRFDA_"","""
^XMB(3.9,146085,2,659,0)="""RTN"",""XDRMERGB"",191,0)"
^XMB(3.9,146085,2,660,0)=" F XDRI=0:0 S XDRI=$O(XDRX(XDRI)) Q:XDRI'>0  D"
^XMB(3.9,146085,2,661,0)="""RTN"",""XDRMERGB"",192,0)"
^XMB(3.9,146085,2,662,0)=" . S XDRJ=$O(XDRX(XDRI,0))"
^XMB(3.9,146085,2,663,0)="""RTN"",""XDRMERGB"",193,0)"
^XMB(3.9,146085,2,664,0)=" . S XDRK=XDRX(XDRI,XDRJ)"
^XMB(3.9,146085,2,665,0)="""RTN"",""XDRMERGB"",194,0)"
^XMB(3.9,146085,2,666,0)=" . K XDRXX,XDRYY"
^XMB(3.9,146085,2,667,0)="""RTN"",""XDRMERGB"",195,0)"
^XMB(3.9,146085,2,668,0)=" . S XDRXX(15.22,XDRIENS,.01)=XDRI ; IEN1"
^XMB(3.9,146085,2,669,0)="""RTN"",""XDRMERGB"",196,0)"
^XMB(3.9,146085,2,670,0)=" . S XDRXX(15.22,XDRIENS,.02)=XDRJ ; IEN2"
^XMB(3.9,146085,2,671,0)="""RTN"",""XDRMERGB"",197,0)"
^XMB(3.9,146085,2,672,0)=" . S XDRXX(15.22,XDRIENS,.03)=XDRK ; ENTRY # IN FILE 15"
^XMB(3.9,146085,2,673,0)="""RTN"",""XDRMERGB"",198,0)"
^XMB(3.9,146085,2,674,0)=" . D UPDATE^DIE("""",""XDRXX"",""XDRYY"",""XDRMA"")"
^XMB(3.9,146085,2,675,0)="""RTN"",""XDRMERGB"",199,0)"
^XMB(3.9,146085,2,676,0)=" . K XDRXX,XDRYY,XDRMA"
^XMB(3.9,146085,2,677,0)="""RTN"",""XDRMERGB"",200,0)"
^XMB(3.9,146085,2,678,0)=" . ;    AND MARK THEM AS IN THIS MERGE PROCESS IN FILE 15"
^XMB(3.9,146085,2,679,0)="""RTN"",""XDRMERGB"",201,0)"
^XMB(3.9,146085,2,680,0)=" . S XDRXX(15,XDRK_"","",.05)=3"
^XMB(3.9,146085,2,681,0)="""RTN"",""XDRMERGB"",202,0)"
^XMB(3.9,146085,2,682,0)=" . S XDRXX(15,XDRK_"","",.2)=XDRFDA"
^XMB(3.9,146085,2,683,0)="""RTN"",""XDRMERGB"",203,0)"
^XMB(3.9,146085,2,684,0)=" . D FILE^DIE("""",""XDRXX"")"
^XMB(3.9,146085,2,685,0)="""RTN"",""XDRMERGB"",204,0)"
^XMB(3.9,146085,2,686,0)=" . ; JLI 3/12/98 - FOR SOME REASON THE .05 FIELD STILL DOESN'T SEEM TO BE GETTING SET TO 3, SO CHECK IT AND IF THAT IS THE CASE, HARDSET IT."
^XMB(3.9,146085,2,687,0)="""RTN"",""XDRMERGB"",205,0)"
^XMB(3.9,146085,2,688,0)=" . I $P(^VA(15,XDRK,0),U,5)'=3 S $P(^(0),U,5)=3"
^XMB(3.9,146085,2,689,0)="""RTN"",""XDRMERGB"",206,0)"
^XMB(3.9,146085,2,690,0)=" ;"
^XMB(3.9,146085,2,691,0)="""RTN"",""XDRMERGB"",207,0)"
^XMB(3.9,146085,2,692,0)=" K DR S DR="".03;.04///S;"" ; GET DESIRED START TIME AND MARK PROCESS AS SCHEDULED"
^XMB(3.9,146085,2,693,0)="""RTN"",""XDRMERGB"",208,0)"
^XMB(3.9,146085,2,694,0)=" S DIE=""^VA(15.2,"""
^XMB(3.9,146085,2,695,0)="""RTN"",""XDRMERGB"",209,0)"
^XMB(3.9,146085,2,696,0)=" S DA=XDRFDA"
^XMB(3.9,146085,2,697,0)="""RTN"",""XDRMERGB"",210,0)"
^XMB(3.9,146085,2,698,0)=" D ^DIE"
^XMB(3.9,146085,2,699,0)="""RTN"",""XDRMERGB"",211,0)"
^XMB(3.9,146085,2,700,0)=" S ZTDTH=$P(^VA(15.2,XDRFDA,0),U,3) ; TAKE DESIRED TIME"
^XMB(3.9,146085,2,701,0)="""RTN"",""XDRMERGB"",212,0)"
^XMB(3.9,146085,2,702,0)=" I ZTDTH>0 D  Q:$G(ZTSK)>0  ;         AND SET UP TASK"
^XMB(3.9,146085,2,703,0)="""RTN"",""XDRMERGB"",213,0)"
^XMB(3.9,146085,2,704,0)=" . S ZTRTN=""DQ^XDRMERG0"",ZTDESC=""MERGE PROCESS ""_XDRNAME"
^XMB(3.9,146085,2,705,0)="""RTN"",""XDRMERGB"",214,0)"
^XMB(3.9,146085,2,706,0)=" . S ZTIO=""NULL"",ZTSAVE(""XDRFDA"")="""""
^XMB(3.9,146085,2,707,0)="""RTN"",""XDRMERGB"",215,0)"
^XMB(3.9,146085,2,708,0)=" . D ^%ZTLOAD"
^XMB(3.9,146085,2,709,0)="""RTN"",""XDRMERGB"",216,0)"
^XMB(3.9,146085,2,710,0)=" . I $G(ZTSK)>0 D"
^XMB(3.9,146085,2,711,0)="""RTN"",""XDRMERGB"",217,0)"
^XMB(3.9,146085,2,712,0)=" . . K DR S DR="".08///""_ZTSK_"";"",DIE=""^VA(15.2,"",DA=XDRFDA D ^DIE"
^XMB(3.9,146085,2,713,0)="""RTN"",""XDRMERGB"",218,0)"
^XMB(3.9,146085,2,714,0)=" . . W !!,""Merge process '"",$P(^VA(15.2,XDRFDA,0),U),""' for Verified Duplicates in File "",XDRFIL,"" scheduled"",!,""as task "",ZTSK,""."",!"
^XMB(3.9,146085,2,715,0)="""RTN"",""XDRMERGB"",219,0)"
^XMB(3.9,146085,2,716,0)=" ;"
^XMB(3.9,146085,2,717,0)="""RTN"",""XDRMERGB"",220,0)"
^XMB(3.9,146085,2,718,0)=" ;  TASK INFO, TIME, ETC. NOT COMPLETE - SO REVERSE IT"
^XMB(3.9,146085,2,719,0)="""RTN"",""XDRMERGB"",221,0)"
^XMB(3.9,146085,2,720,0)=" ;"
^XMB(3.9,146085,2,721,0)="""RTN"",""XDRMERGB"",222,0)"
^XMB(3.9,146085,2,722,0)=" F XDRI=0:0 S XDRI=$O(XDRX(XDRI)) Q:XDRI'>0  D"
^XMB(3.9,146085,2,723,0)="""RTN"",""XDRMERGB"",223,0)"
^XMB(3.9,146085,2,724,0)=" . S XDRJ=$O(XDRX(XDRI,0))"
^XMB(3.9,146085,2,725,0)="""RTN"",""XDRMERGB"",224,0)"
^XMB(3.9,146085,2,726,0)=" . S XDRK=XDRX(XDRI,XDRJ)"
^XMB(3.9,146085,2,727,0)="""RTN"",""XDRMERGB"",225,0)"
^XMB(3.9,146085,2,728,0)=" . K XDRXX,XDRYY"
^XMB(3.9,146085,2,729,0)="""RTN"",""XDRMERGB"",226,0)"
^XMB(3.9,146085,2,730,0)=" . S XDRXX(15,XDRK_"","",.2)=""@"" ; UNMARK ENTRY IN FILE 15"
^XMB(3.9,146085,2,731,0)="""RTN"",""XDRMERGB"",227,0)"
^XMB(3.9,146085,2,732,0)=" . S XDRXX(15,XDRK_"","",.05)=1"
^XMB(3.9,146085,2,733,0)="""RTN"",""XDRMERGB"",228,0)"
^XMB(3.9,146085,2,734,0)=" . D UPDATE^DIE("""",""XDRXX"")"
^XMB(3.9,146085,2,735,0)="""RTN"",""XDRMERGB"",229,0)"
^XMB(3.9,146085,2,736,0)=" S DA=XDRFDA"
^XMB(3.9,146085,2,737,0)="""RTN"",""XDRMERGB"",230,0)"
^XMB(3.9,146085,2,738,0)=" S DIK=""^VA(15.2,"""
^XMB(3.9,146085,2,739,0)="""RTN"",""XDRMERGB"",231,0)"
^XMB(3.9,146085,2,740,0)=" D ^DIK"
^XMB(3.9,146085,2,741,0)="""RTN"",""XDRMERGB"",232,0)"
^XMB(3.9,146085,2,742,0)=" W !!,$C(7),""The Merge Process has been aborted, no changes made."""
^XMB(3.9,146085,2,743,0)="""RTN"",""XDRMERGB"",233,0)"
^XMB(3.9,146085,2,744,0)=" Q"
^XMB(3.9,146085,2,745,0)="""RTN"",""XDRMERGB"",234,0)"
^XMB(3.9,146085,2,746,0)=" ;"
^XMB(3.9,146085,2,747,0)="""VER"")"
