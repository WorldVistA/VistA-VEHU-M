^XMB(3.9,146098,2,1157,0)="""RTN"",""SDES2APTLETTER"",257,0)"
^XMB(3.9,146098,2,1158,0)="TST(SDCL,DOW) ; handle scheduled tests"
^XMB(3.9,146098,2,1159,0)="""RTN"",""SDES2APTLETTER"",258,0)"
^XMB(3.9,146098,2,1160,0)=" I ($L(SDCL)=3&($E(SDCL,1,3)=""LAB"")) D"
^XMB(3.9,146098,2,1161,0)="""RTN"",""SDES2APTLETTER"",259,0)"
^XMB(3.9,146098,2,1162,0)=" . S SDECI=SDECI+1"
^XMB(3.9,146098,2,1163,0)="""RTN"",""SDES2APTLETTER"",260,0)"
^XMB(3.9,146098,2,1164,0)=" . S ^TMP(""SDEC_COMP"",$J,""scheduledAppointments"",SDECI)="" ""_SDCL_"" SCHEDULED:  ""_DOW_""  ""_$J(SDDAT,12)_""  ""_$J(SDT0,5)"
^XMB(3.9,146098,2,1165,0)="""RTN"",""SDES2APTLETTER"",261,0)"
^XMB(3.9,146098,2,1166,0)=" I ($L(SDCL)=4&($E(SDCL,1,4)=""XRAY"")) D"
^XMB(3.9,146098,2,1167,0)="""RTN"",""SDES2APTLETTER"",262,0)"
^XMB(3.9,146098,2,1168,0)=" . S SDECI=SDECI+1"
^XMB(3.9,146098,2,1169,0)="""RTN"",""SDES2APTLETTER"",263,0)"
^XMB(3.9,146098,2,1170,0)=" . S ^TMP(""SDEC_COMP"",$J,""scheduledAppointments"",SDECI)=SDCL_"" SCHEDULED:  ""_DOW_""  ""_$J(SDDAT,12)_""  ""_$J(SDT0,5)"
^XMB(3.9,146098,2,1171,0)="""RTN"",""SDES2APTLETTER"",264,0)"
^XMB(3.9,146098,2,1172,0)=" I ($L(SDCL)=3&($E(SDCL,1,3)=""EKG"")) D"
^XMB(3.9,146098,2,1173,0)="""RTN"",""SDES2APTLETTER"",265,0)"
^XMB(3.9,146098,2,1174,0)=" . S SDECI=SDECI+1"
^XMB(3.9,146098,2,1175,0)="""RTN"",""SDES2APTLETTER"",266,0)"
^XMB(3.9,146098,2,1176,0)=" . S ^TMP(""SDEC_COMP"",$J,""scheduledAppointments"",SDECI)="" ""_SDCL_"" SCHEDULED:  ""_DOW_""  ""_$J(SDDAT,12)_""  ""_$J(SDT0,5)"
