^XMB(3.9,146087,2,3766,0)="DATA1 ;"
^XMB(3.9,146087,2,3767,0)="""RTN"",""YTSAUDTC"",9,0)"
^XMB(3.9,146087,2,3768,0)=" ; get DFN and Sex of Patient"
^XMB(3.9,146087,2,3769,0)="""RTN"",""YTSAUDTC"",10,0)"
^XMB(3.9,146087,2,3770,0)=" S DATA=$G(YSDATA(2))"
