^XMB(3.9,146037,2,507,0)="""RTN"",""RCDPEM"",94,0)"
^XMB(3.9,146037,2,508,0)=" ; RCPROC = 1 if called from EFT-EOB automatch, 0 if from manual match"
^XMB(3.9,146037,2,509,0)="""RTN"",""RCDPEM"",95,0)"
^XMB(3.9,146037,2,510,0)=" ;"
^XMB(3.9,146037,2,511,0)="""RTN"",""RCDPEM"",96,0)"
^XMB(3.9,146037,2,512,0)=" N RC0,RCER,RCZ,RCHAC"
^XMB(3.9,146037,2,513,0)="""RTN"",""RCDPEM"",97,0)"
^XMB(3.9,146037,2,514,0)=" I '$O(^RCY(344.31,""AMATCH"",0,0)) D  G MATCHQ"
^XMB(3.9,146037,2,515,0)="""RTN"",""RCDPEM"",98,0)"
^XMB(3.9,146037,2,516,0)=" . ; Send bulletin - no unmatched EFTs found"
^XMB(3.9,146037,2,517,0)="""RTN"",""RCDPEM"",99,0)"
^XMB(3.9,146037,2,518,0)=" . N RCT"
^XMB(3.9,146037,2,519,0)="""RTN"",""RCDPEM"",100,0)"
^XMB(3.9,146037,2,520,0)=" . S RCT=+$O(^TMP($J,""RCXM"","" ""),-1)+1"
^XMB(3.9,146037,2,521,0)="""RTN"",""RCDPEM"",101,0)"
^XMB(3.9,146037,2,522,0)=" . S ^TMP($J,""RCXM"",RCT)=$S('$G(RCMAN):""The nightly job"",1:""The manual option"")_"" to match EFTs has found no EFTs are currently unmatched on your system"""
^XMB(3.9,146037,2,523,0)="""RTN"",""RCDPEM"",102,0)"
^XMB(3.9,146037,2,524,0)=" . I $G(RCMAN) S ^TMP($J,""RCXM"",RCT+1)=""The action was initiated by ""_$P($G(^VA(200,DUZ,0)),U)"
^XMB(3.9,146037,2,525,0)="""RTN"",""RCDPEM"",103,0)"
^XMB(3.9,146037,2,526,0)=" . D SENDBULL^RCDPEM1"
^XMB(3.9,146037,2,527,0)="""RTN"",""RCDPEM"",104,0)"
^XMB(3.9,146037,2,528,0)=" ;"
^XMB(3.9,146037,2,529,0)="""RTN"",""RCDPEM"",105,0)"
^XMB(3.9,146037,2,530,0)=" S RCZ=0 F  S RCZ=$O(^RCY(344.31,""AMATCH"",0,RCZ)) Q:'RCZ  D"
^XMB(3.9,146037,2,531,0)="""RTN"",""RCDPEM"",106,0)"
^XMB(3.9,146037,2,532,0)=" . K RCER"
^XMB(3.9,146037,2,533,0)="""RTN"",""RCDPEM"",107,0)"
^XMB(3.9,146037,2,534,0)=" . S RC0=$G(^RCY(344.31,RCZ,0)),RCHAC=($E($P($G(^RCY(344.3,+RC0,0)),U,6),1,3)=""HAC"")"
^XMB(3.9,146037,2,535,0)="""RTN"",""RCDPEM"",108,0)"
^XMB(3.9,146037,2,536,0)=" . Q:RC0=""""  ; Bad xref"
^XMB(3.9,146037,2,537,0)="""RTN"",""RCDPEM"",109,0)"
^XMB(3.9,146037,2,538,0)=" . Q:$S('RCHAC:'$P(RC0,U,11),1:0)  ; EFT deposit must have been recorded"
^XMB(3.9,146037,2,539,0)="""RTN"",""RCDPEM"",110,0)"
^XMB(3.9,146037,2,540,0)=" . S ^TMP($J,""RCTOT"",""EFT"")=$G(^TMP($J,""RCTOT"",""EFT""))+1"
^XMB(3.9,146037,2,541,0)="""RTN"",""RCDPEM"",111,0)"
^XMB(3.9,146037,2,542,0)=" . I RCHAC S ^TMP($J,""RCTOT"",""EFT_HAC"")=$G(^TMP($J,""RCTOT"",""EFT_HAC""))+1"
^XMB(3.9,146037,2,543,0)="""RTN"",""RCDPEM"",112,0)"
^XMB(3.9,146037,2,544,0)=" . S ^TMP($J,""RCDPETOT"",344.31,RCZ)="""""
^XMB(3.9,146037,2,545,0)="""RTN"",""RCDPEM"",113,0)"
^XMB(3.9,146037,2,546,0)=" . ;"
^XMB(3.9,146037,2,547,0)="""RTN"",""RCDPEM"",114,0)"
^XMB(3.9,146037,2,548,0)=" . D MATCH^RCDPEM0(RCZ,RCPROC)"
^XMB(3.9,146037,2,549,0)="""RTN"",""RCDPEM"",115,0)"
^XMB(3.9,146037,2,550,0)=" ;"
^XMB(3.9,146037,2,551,0)="""RTN"",""RCDPEM"",116,0)"
^XMB(3.9,146037,2,552,0)=" I '$O(^TMP($J,""RCXM"",0)) K RCER S RCER(1)="""",RCER(2)=""NO EXCEPTIONS WHILE MATCHING EFTs-ERAs OR IN RECORDING THE DEPOSITS TO FMS"" D BULL^RCDPEM1("""","""",.RCER) K RCER"
^XMB(3.9,146037,2,553,0)="""RTN"",""RCDPEM"",117,0)"
^XMB(3.9,146037,2,554,0)=" D EN2^RCDPEM1,BULL^RCDPEM1("""","""",.RCER)"
^XMB(3.9,146037,2,555,0)="""RTN"",""RCDPEM"",118,0)"
^XMB(3.9,146037,2,556,0)=" D SENDBULL^RCDPEM1"
^XMB(3.9,146037,2,557,0)="""RTN"",""RCDPEM"",119,0)"
^XMB(3.9,146037,2,558,0)=" ;"
^XMB(3.9,146037,2,559,0)="""RTN"",""RCDPEM"",120,0)"
^XMB(3.9,146037,2,560,0)="MATCHQ K ^TMP($J,""RCDPETOT""),^TMP($J,""RCTOT"")"
^XMB(3.9,146037,2,561,0)="""RTN"",""RCDPEM"",121,0)"
^XMB(3.9,146037,2,562,0)=" Q"
^XMB(3.9,146037,2,563,0)="""RTN"",""RCDPEM"",122,0)"
^XMB(3.9,146037,2,564,0)=" ;"
^XMB(3.9,146037,2,565,0)="""RTN"",""RCDPEM"",123,0)"
^XMB(3.9,146037,2,566,0)="LOCKDEP(RCDEP,LOCK) ; Lock/confirm deposit ien RCDEP file 341.1"
^XMB(3.9,146037,2,567,0)="""RTN"",""RCDPEM"",124,0)"
^XMB(3.9,146037,2,568,0)=" ; If LOCK = 1 lock deposit"
^XMB(3.9,146037,2,569,0)="""RTN"",""RCDPEM"",125,0)"
^XMB(3.9,146037,2,570,0)=" ; If LOCK = 0 unlock deposit"
^XMB(3.9,146037,2,571,0)="""RTN"",""RCDPEM"",126,0)"
^XMB(3.9,146037,2,572,0)=" I $G(LOCK) D"
^XMB(3.9,146037,2,573,0)="""RTN"",""RCDPEM"",127,0)"
^XMB(3.9,146037,2,574,0)=" . L +^RCY(344.1,RCDEP,0):DILOCKTM"
^XMB(3.9,146037,2,575,0)="""RTN"",""RCDPEM"",128,0)"
^XMB(3.9,146037,2,576,0)=" . D CONFIRM^RCDPUDEP(RCDEP) ; confirm to prevent changes"
^XMB(3.9,146037,2,577,0)="""RTN"",""RCDPEM"",129,0)"
^XMB(3.9,146037,2,578,0)=" I '$G(LOCK) L -^RCY(344.1,RCDEP,0)"
^XMB(3.9,146037,2,579,0)="""RTN"",""RCDPEM"",130,0)"
^XMB(3.9,146037,2,580,0)=" Q"
^XMB(3.9,146037,2,581,0)="""RTN"",""RCDPEM"",131,0)"
^XMB(3.9,146037,2,582,0)=" ; PRCA*4.5*326 Add RCDUZ to parameters"
^XMB(3.9,146037,2,583,0)="""RTN"",""RCDPEM"",132,0)"
^XMB(3.9,146037,2,584,0)="RCPTDET(RCRZ,RECTDA1,RCER,RCDUZ) ; Adds detail to a receipt based on file 344.49"
^XMB(3.9,146037,2,585,0)="""RTN"",""RCDPEM"",133,0)"
^XMB(3.9,146037,2,586,0)=" ; RCRZ = ien of ERA entry in file 344.49"
^XMB(3.9,146037,2,587,0)="""RTN"",""RCDPEM"",134,0)"
^XMB(3.9,146037,2,588,0)=" ; RECTDA1 = ien of receipt entry in file 344"
^XMB(3.9,146037,2,589,0)="""RTN"",""RCDPEM"",135,0)"
^XMB(3.9,146037,2,590,0)=" ; RCER = error array returned if passed by reference"
^XMB(3.9,146037,2,591,0)="""RTN"",""RCDPEM"",136,0)"
^XMB(3.9,146037,2,592,0)=" ;"
^XMB(3.9,146037,2,593,0)="""RTN"",""RCDPEM"",137,0)"
^XMB(3.9,146037,2,594,0)=" N DA,DIE,DR,Q,RCR,RCSPL,RCZ0,RCTRANDA,RCQ,X,Y,Z0,Z1,Z ; PRCA*4.5*318"
^XMB(3.9,146037,2,595,0)="""RTN"",""RCDPEM"",138,0)"
^XMB(3.9,146037,2,596,0)=" ;"
^XMB(3.9,146037,2,597,0)="""RTN"",""RCDPEM"",139,0)"
^XMB(3.9,146037,2,598,0)=" S RCR=0 F  S RCR=$O(^RCY(344.49,RCRZ,1,RCR)) Q:'RCR  D"
^XMB(3.9,146037,2,599,0)="""RTN"",""RCDPEM"",140,0)"
^XMB(3.9,146037,2,600,0)=" . S RCZ0=$G(^RCY(344.49,RCRZ,1,RCR,0))"
^XMB(3.9,146037,2,601,0)="""RTN"",""RCDPEM"",141,0)"
^XMB(3.9,146037,2,602,0)=" . I $P(RCZ0,U)'[""."" S RCSPL(+RCZ0)=$P(RCZ0,U,9) Q"
^XMB(3.9,146037,2,603,0)="""RTN"",""RCDPEM"",142,0)"
^XMB(3.9,146037,2,604,0)=" . I $S(+$P(RCZ0,U,3)=0:$P($G(^RCY(344.49,RCRZ,0)),U,3),1:$P(RCZ0,U,3)<0) S RCSPL(RCZ0\1,+RCZ0)=RCZ0 Q"
^XMB(3.9,146037,2,605,0)="""RTN"",""RCDPEM"",143,0)"
^XMB(3.9,146037,2,606,0)=" . S RCTRANDA=$$ADDTRAN^RCDPURET(RECTDA1,$G(RCDUZ)) ; PRCA*4.5*326 Add RCDUZ to parameters"
^XMB(3.9,146037,2,607,0)="""RTN"",""RCDPEM"",144,0)"
^XMB(3.9,146037,2,608,0)=" . ;"
^XMB(3.9,146037,2,609,0)="""RTN"",""RCDPEM"",145,0)"
^XMB(3.9,146037,2,610,0)=" . I RCTRANDA'>0 D  Q  ; Error adding receipt detail - PRCA*4.5*318"
^XMB(3.9,146037,2,611,0)="""RTN"",""RCDPEM"",146,0)"
^XMB(3.9,146037,2,612,0)=" .. S RCER(1)=$$SETERR^RCDPEM0(1) ; PRCA*4.5*318 - pass RCPROC value to $$SETERR"
^XMB(3.9,146037,2,613,0)="""RTN"",""RCDPEM"",147,0)"
^XMB(3.9,146037,2,614,0)=" .. S RCER($O(RCER(""""),-1)+1)=""  NO DETAIL LINE ADDED TO RECEIPT ""_$P($G(^RCY(344,RECTDA1,0)),U)_"" FOR LINE #""_$P(RCZ0,U)_"" IN EEOB WORKLIST SCRATCH PAD"""
^XMB(3.9,146037,2,615,0)="""RTN"",""RCDPEM"",148,0)"
^XMB(3.9,146037,2,616,0)=" . ;"
^XMB(3.9,146037,2,617,0)="""RTN"",""RCDPEM"",149,0)"
^XMB(3.9,146037,2,618,0)=" . ;Store receipt line detail"
^XMB(3.9,146037,2,619,0)="""RTN"",""RCDPEM"",150,0)"
^XMB(3.9,146037,2,620,0)=" . D DET(RCRZ,RCR,RECTDA1,RCTRANDA)"
^XMB(3.9,146037,2,621,0)="""RTN"",""RCDPEM"",151,0)"
^XMB(3.9,146037,2,622,0)=" . S RCSPL(RCZ0\1,+RCZ0)=RCZ0"
^XMB(3.9,146037,2,623,0)="""RTN"",""RCDPEM"",152,0)"
^XMB(3.9,146037,2,624,0)=" ;"
^XMB(3.9,146037,2,625,0)="""RTN"",""RCDPEM"",153,0)"
^XMB(3.9,146037,2,626,0)=" ; Update A/R CORRECTED PAYMENT multiple with apportionment for split lines"
^XMB(3.9,146037,2,627,0)="""RTN"",""RCDPEM"",154,0)"
^XMB(3.9,146037,2,628,0)=" S Z=0 F  S Z=$O(RCSPL(Z)) Q:'Z  S RCQ=+$G(RCSPL(Z)) I RCQ D"
^XMB(3.9,146037,2,629,0)="""RTN"",""RCDPEM"",155,0)"
^XMB(3.9,146037,2,630,0)=" . S Z1=$O(RCSPL(Z,"""")) Q:Z1="""""
^XMB(3.9,146037,2,631,0)="""RTN"",""RCDPEM"",156,0)"
^XMB(3.9,146037,2,632,0)=" . I $O(RCSPL(Z,""""),-1)=Z1,'$$SPLIT(Z,Z1,RCERA) Q  ; No split occurred"
^XMB(3.9,146037,2,633,0)="""RTN"",""RCDPEM"",157,0)"
^XMB(3.9,146037,2,634,0)=" . S Z1=0 F  S Z1=$O(RCSPL(Z,Z1)) Q:'Z1  S Z0=$G(RCSPL(Z,Z1)) D"
^XMB(3.9,146037,2,635,0)="""RTN"",""RCDPEM"",158,0)"
^XMB(3.9,146037,2,636,0)=" .. S Q=+$P($G(^RCY(344.4,RCRZ,1,RCQ,0)),U,2) ; EOB detail rec"
^XMB(3.9,146037,2,637,0)="""RTN"",""RCDPEM"",159,0)"
^XMB(3.9,146037,2,638,0)=" .. Q:'Q"
^XMB(3.9,146037,2,639,0)="""RTN"",""RCDPEM"",160,0)"
^XMB(3.9,146037,2,640,0)=" .. I '$P(Z0,U,7)!($P(Z0,U,2)="""") D  ; Suspensed"
^XMB(3.9,146037,2,641,0)="""RTN"",""RCDPEM"",161,0)"
^XMB(3.9,146037,2,642,0)=" ... D SPL1^IBCEOBAR(Q,$S($P(Z0,U,2)="""":""NO BILL"",1:$P(Z0,U,2)),"""",$P(Z0,U,6)) ; IA 4050"
^XMB(3.9,146037,2,643,0)="""RTN"",""RCDPEM"",162,0)"
^XMB(3.9,146037,2,644,0)=" .. E  D"
^XMB(3.9,146037,2,645,0)="""RTN"",""RCDPEM"",163,0)"
^XMB(3.9,146037,2,646,0)=" ... D SPL1^IBCEOBAR(Q,$P(Z0,U,2),$P(Z0,U,7),$P(Z0,U,6)) ; Add the split bill # ; IA 4050"
^XMB(3.9,146037,2,647,0)="""RTN"",""RCDPEM"",164,0)"
^XMB(3.9,146037,2,648,0)=" . ; BEGIN - PRCA*4.5*321"
^XMB(3.9,146037,2,649,0)="""RTN"",""RCDPEM"",165,0)"
^XMB(3.9,146037,2,650,0)=" . ;Move/Copy/Remove EEOB detail for split line"
^XMB(3.9,146037,2,651,0)="""RTN"",""RCDPEM"",166,0)"
^XMB(3.9,146037,2,652,0)=" . N CLAIM,IEN3611,RCSPLIT,RCSUB,RCZSAV"
^XMB(3.9,146037,2,653,0)="""RTN"",""RCDPEM"",167,0)"
^XMB(3.9,146037,2,654,0)=" . ; Sub-array of split claim detail for individual line"
^XMB(3.9,146037,2,655,0)="""RTN"",""RCDPEM"",168,0)"
^XMB(3.9,146037,2,656,0)=" . M RCSPLIT=RCSPL(Z)"
^XMB(3.9,146037,2,657,0)="""RTN"",""RCDPEM"",169,0)"
^XMB(3.9,146037,2,658,0)=" . ; Protect Z subscript variable from overwrite by triggers"
^XMB(3.9,146037,2,659,0)="""RTN"",""RCDPEM"",170,0)"
^XMB(3.9,146037,2,660,0)=" . S RCZSAV=Z"
^XMB(3.9,146037,2,661,0)="""RTN"",""RCDPEM"",171,0)"
^XMB(3.9,146037,2,662,0)=" . ; Get scratchpad line number for this ERA line"
^XMB(3.9,146037,2,663,0)="""RTN"",""RCDPEM"",172,0)"
^XMB(3.9,146037,2,664,0)=" . S RCSUB=$O(^RCY(344.49,RCRZ,1,""ASEQ"",Z,""""))"
^XMB(3.9,146037,2,665,0)="""RTN"",""RCDPEM"",173,0)"
^XMB(3.9,146037,2,666,0)=" . ; Original claim number from Scratchpad line"
^XMB(3.9,146037,2,667,0)="""RTN"",""RCDPEM"",174,0)"
^XMB(3.9,146037,2,668,0)=" . S CLAIM=$$GET1^DIQ(344.491,RCSUB_"",""_RCRZ_"","",.02)"
^XMB(3.9,146037,2,669,0)="""RTN"",""RCDPEM"",175,0)"
^XMB(3.9,146037,2,670,0)=" . ; EOB for original claim from ERA line"
^XMB(3.9,146037,2,671,0)="""RTN"",""RCDPEM"",176,0)"
^XMB(3.9,146037,2,672,0)=" . S IEN3611=$$GET1^DIQ(344.41,RCQ_"",""_RCRZ_"","",.02,""I"")"
^XMB(3.9,146037,2,673,0)="""RTN"",""RCDPEM"",177,0)"
^XMB(3.9,146037,2,674,0)=" . ; Automatic Move/Copy/Remove EOB"
^XMB(3.9,146037,2,675,0)="""RTN"",""RCDPEM"",178,0)"
^XMB(3.9,146037,2,676,0)=" . I $$AUTO^RCDPEM5(CLAIM,.RCSPLIT,RCERA,""W"",IEN3611)"
^XMB(3.9,146037,2,677,0)="""RTN"",""RCDPEM"",179,0)"
^XMB(3.9,146037,2,678,0)=" . ; Restore Z"
^XMB(3.9,146037,2,679,0)="""RTN"",""RCDPEM"",180,0)"
^XMB(3.9,146037,2,680,0)=" . S Z=RCZSAV"
^XMB(3.9,146037,2,681,0)="""RTN"",""RCDPEM"",181,0)"
^XMB(3.9,146037,2,682,0)=" . ; END  - PRCA*4.5*321"
^XMB(3.9,146037,2,683,0)="""RTN"",""RCDPEM"",182,0)"
^XMB(3.9,146037,2,684,0)=" ;"
^XMB(3.9,146037,2,685,0)="""RTN"",""RCDPEM"",183,0)"
^XMB(3.9,146037,2,686,0)=" Q"
^XMB(3.9,146037,2,687,0)="""RTN"",""RCDPEM"",184,0)"
^XMB(3.9,146037,2,688,0)="SPLIT(Z,Z1,RCERA) ;Check if worklist was split but to to single claim"
^XMB(3.9,146037,2,689,0)="""RTN"",""RCDPEM"",185,0)"
^XMB(3.9,146037,2,690,0)=" N SUB,NBILL,OBILL"
^XMB(3.9,146037,2,691,0)="""RTN"",""RCDPEM"",186,0)"
^XMB(3.9,146037,2,692,0)=" ;Find split line in scratchpad"
^XMB(3.9,146037,2,693,0)="""RTN"",""RCDPEM"",187,0)"
^XMB(3.9,146037,2,694,0)=" S SUB=$O(^RCY(344.49,RCERA,1,""B"",Z1,"""")) Q:'SUB 0"
^XMB(3.9,146037,2,695,0)="""RTN"",""RCDPEM"",188,0)"
^XMB(3.9,146037,2,696,0)=" ;Get original claim number from scratchpad"
^XMB(3.9,146037,2,697,0)="""RTN"",""RCDPEM"",189,0)"
^XMB(3.9,146037,2,698,0)=" S OBILL=$P($G(^RCY(344.49,RCERA,1,SUB-1,0)),U,2)"
^XMB(3.9,146037,2,699,0)="""RTN"",""RCDPEM"",190,0)"
^XMB(3.9,146037,2,700,0)=" ;New claim number"
^XMB(3.9,146037,2,701,0)="""RTN"",""RCDPEM"",191,0)"
^XMB(3.9,146037,2,702,0)=" S NBILL=$P(RCSPL(Z,Z1),U,2)"
^XMB(3.9,146037,2,703,0)="""RTN"",""RCDPEM"",192,0)"
^XMB(3.9,146037,2,704,0)=" ;If new and old claim are not the same this is a move via split"
^XMB(3.9,146037,2,705,0)="""RTN"",""RCDPEM"",193,0)"
^XMB(3.9,146037,2,706,0)=" I OBILL'="""",OBILL'=NBILL Q 1"
^XMB(3.9,146037,2,707,0)="""RTN"",""RCDPEM"",194,0)"
^XMB(3.9,146037,2,708,0)=" ;Otherwise this is not a split"
^XMB(3.9,146037,2,709,0)="""RTN"",""RCDPEM"",195,0)"
^XMB(3.9,146037,2,710,0)=" Q 0"
^XMB(3.9,146037,2,711,0)="""RTN"",""RCDPEM"",196,0)"
^XMB(3.9,146037,2,712,0)=" ;"
^XMB(3.9,146037,2,713,0)="""RTN"",""RCDPEM"",197,0)"
^XMB(3.9,146037,2,714,0)="DET(RCZ,RCR,RECTDA1,RCTRANDA) ; Store receipt detail"
^XMB(3.9,146037,2,715,0)="""RTN"",""RCDPEM"",198,0)"
^XMB(3.9,146037,2,716,0)=" ; RCZ = ien of entry file 344.49"
^XMB(3.9,146037,2,717,0)="""RTN"",""RCDPEM"",199,0)"
^XMB(3.9,146037,2,718,0)=" ; RCR = ien of entry in file 344.491"
^XMB(3.9,146037,2,719,0)="""RTN"",""RCDPEM"",200,0)"
^XMB(3.9,146037,2,720,0)=" ; RCPROC = Function calling this subroutine"
^XMB(3.9,146037,2,721,0)="""RTN"",""RCDPEM"",201,0)"
^XMB(3.9,146037,2,722,0)=" ;        = 1 EFT match to ERA   = 0 manual add receipt"
^XMB(3.9,146037,2,723,0)="""RTN"",""RCDPEM"",202,0)"
^XMB(3.9,146037,2,724,0)=" ; RECTDA1 = ien of entry in file 344"
^XMB(3.9,146037,2,725,0)="""RTN"",""RCDPEM"",203,0)"
^XMB(3.9,146037,2,726,0)=" ; RCTRANDA = ien of entry in subfile 344.01"
^XMB(3.9,146037,2,727,0)="""RTN"",""RCDPEM"",204,0)"
^XMB(3.9,146037,2,728,0)=" ;"
^XMB(3.9,146037,2,729,0)="""RTN"",""RCDPEM"",205,0)"
^XMB(3.9,146037,2,730,0)=" N DIE,DA,DR,X,Y,Z,RCUP,RCCOM,RCZ0,RC0"
^XMB(3.9,146037,2,731,0)="""RTN"",""RCDPEM"",206,0)"
^XMB(3.9,146037,2,732,0)=" S RC0=$G(^RCY(344.49,RCZ,0))"
^XMB(3.9,146037,2,733,0)="""RTN"",""RCDPEM"",207,0)"
^XMB(3.9,146037,2,734,0)=" S RCZ0=$G(^RCY(344.49,RCZ,1,RCR,0))"
^XMB(3.9,146037,2,735,0)="""RTN"",""RCDPEM"",208,0)"
^XMB(3.9,146037,2,736,0)=" S DR="""",RCUP=+$O(^RCY(344.49,RCZ,1,""B"",+RCZ0/1,0)),RCUP=$G(^RCY(344.49,RCZ,1,RCUP,0))"
^XMB(3.9,146037,2,737,0)="""RTN"",""RCDPEM"",209,0)"
^XMB(3.9,146037,2,738,0)=" I $P(RCZ0,U,7) S DR="".09////^S X=""_+$P(RCZ0,U,7)_""_$C(59)_""""PRCA(430,"""";"""
^XMB(3.9,146037,2,739,0)="""RTN"",""RCDPEM"",210,0)"
^XMB(3.9,146037,2,740,0)=" S DR=DR_"".04////""_(+$P(RCZ0,U,3))_"";.27////""_RCR_"";"""
^XMB(3.9,146037,2,741,0)="""RTN"",""RCDPEM"",211,0)"
^XMB(3.9,146037,2,742,0)=" I $P(RC0,U,5)'="""" S DR=DR_"".1////""_$P(RC0,U,5)_"";"""
^XMB(3.9,146037,2,743,0)="""RTN"",""RCDPEM"",212,0)"
^XMB(3.9,146037,2,744,0)=" I $P(RC0,U,6)'="""" S DR=DR_"".08////""_$P(RC0,U,6)_"";"""
^XMB(3.9,146037,2,745,0)="""RTN"",""RCDPEM"",213,0)"
^XMB(3.9,146037,2,746,0)=" S Z=0 F  S Z=$O(^RCY(344.49,RCZ,1,RCR,1,Z)) Q:'Z  I $P($G(^(Z,0)),U,5)=1 S DR=DR_"".28////1;"" Q  ; Update receipt line with dec adj flag"
^XMB(3.9,146037,2,747,0)="""RTN"",""RCDPEM"",214,0)"
^XMB(3.9,146037,2,748,0)=" S RCCOM=$P(RCZ0,U,10)"
^XMB(3.9,146037,2,749,0)="""RTN"",""RCDPEM"",215,0)"
^XMB(3.9,146037,2,750,0)=" I $P(RCUP,U,2)[""**ADJ"" S RCCOM=RCCOM_$S(RCCOM'="""":""/"",1:"""")_$S($P($P(RCUP,U,2),""ADJ"",2):""ERA adjustment - no bill referenced"",1:""Total of EFT mismatched to ERA"")"
^XMB(3.9,146037,2,751,0)="""RTN"",""RCDPEM"",216,0)"
^XMB(3.9,146037,2,752,0)=" I RCCOM]"""" S DR=DR_""1.02////""_$E(RCCOM,1,60)_"";"""
^XMB(3.9,146037,2,753,0)="""RTN"",""RCDPEM"",217,0)"
^XMB(3.9,146037,2,754,0)=" I $P($G(^RCY(344.49,RCZ,0)),U,4)'="""" S DR=DR_"".07////""_$P($G(^RCY(344.49,RCZ,0)),U,4)_"";"""
^XMB(3.9,146037,2,755,0)="""RTN"",""RCDPEM"",218,0)"
^XMB(3.9,146037,2,756,0)=" S DA(1)=RECTDA1,DA=RCTRANDA,DIE=""^RCY(344,""_DA(1)_"",1,"""
^XMB(3.9,146037,2,757,0)="""RTN"",""RCDPEM"",219,0)"
^XMB(3.9,146037,2,758,0)=" D ^DIE"
^XMB(3.9,146037,2,759,0)="""RTN"",""RCDPEM"",220,0)"
^XMB(3.9,146037,2,760,0)=" ;Update comment history - PRCA*4.5*321"
^XMB(3.9,146037,2,761,0)="""RTN"",""RCDPEM"",221,0)"
^XMB(3.9,146037,2,762,0)=" D:RCCOM]"""" AUDIT^RCDPECH(RECTDA1,RCTRANDA,RCZ,RCR)"
^XMB(3.9,146037,2,763,0)="""RTN"",""RCDPEM"",222,0)"
^XMB(3.9,146037,2,764,0)=" Q"
^XMB(3.9,146037,2,765,0)="""RTN"",""RCDPEM"",223,0)"
^XMB(3.9,146037,2,766,0)=" ;"
^XMB(3.9,146037,2,767,0)="""RTN"",""RCDPEM0"")"
^XMB(3.9,146037,2,768,0)="0^6^B101889216"
^XMB(3.9,146037,2,769,0)="""RTN"",""RCDPEM0"",1,0)"
^XMB(3.9,146037,2,770,0)="RCDPEM0 ;ALB/TMK - ERA MATCHING TO EFT (cont) ;Jun 11, 2014@13:04:03"
^XMB(3.9,146037,2,771,0)="""RTN"",""RCDPEM0"",2,0)"
^XMB(3.9,146037,2,772,0)=" ;;4.5;Accounts Receivable;**173,208,220,298,304,345,375,349,409,424,439**;Mar 20, 1995;Build 0"
^XMB(3.9,146037,2,773,0)="""RTN"",""RCDPEM0"",3,0)"
^XMB(3.9,146037,2,774,0)=" ;Per VA Directive 6402, this routine should not be modified."
^XMB(3.9,146037,2,775,0)="""RTN"",""RCDPEM0"",4,0)"
^XMB(3.9,146037,2,776,0)=" Q"
^XMB(3.9,146037,2,777,0)="""RTN"",""RCDPEM0"",5,0)"
^XMB(3.9,146037,2,778,0)=" ;"
^XMB(3.9,146037,2,779,0)="""RTN"",""RCDPEM0"",6,0)"
^XMB(3.9,146037,2,780,0)="MATCH(RCZ,RCPROC) ;EP from RCDPEM"
^XMB(3.9,146037,2,781,0)="""RTN"",""RCDPEM0"",7,0)"
^XMB(3.9,146037,2,782,0)=" ; Match EFT to ERA"
^XMB(3.9,146037,2,783,0)="""RTN"",""RCDPEM0"",8,0)"
^XMB(3.9,146037,2,784,0)=" ; Input:   RCZ     - IEN of file 344.31"
^XMB(3.9,146037,2,785,0)="""RTN"",""RCDPEM0"",9,0)"
^XMB(3.9,146037,2,786,0)=" ;          RCPROC  - 1 if called from EFT-EOB automatch, 0 if from manual match"
^XMB(3.9,146037,2,787,0)="""RTN"",""RCDPEM0"",10,0)"
^XMB(3.9,146037,2,788,0)=" ;"
^XMB(3.9,146037,2,789,0)="""RTN"",""RCDPEM0"",11,0)"
^XMB(3.9,146037,2,790,0)=" ; PRCA*4.5*345 - Alphabetized and added MS1,TIN1,TR1,TTL0,TTL1,XX below"
^XMB(3.9,146037,2,791,0)="""RTN"",""RCDPEM0"",12,0)"
^XMB(3.9,146037,2,792,0)=" ; PRCA*4.5*424 - Removed NAM0,RCERATYP,RCXCLDE,TIN0 to new method PAYEREXC^RCDPEAP2"
^XMB(3.9,146037,2,793,0)="""RTN"",""RCDPEM0"",13,0)"
^XMB(3.9,146037,2,794,0)=" N DA,DIE,DR,MS1,RCER,RCMATCH,RCRZ,RC0,RC3444,RC34431"
^XMB(3.9,146037,2,795,0)="""RTN"",""RCDPEM0"",14,0)"
^XMB(3.9,146037,2,796,0)=" N TIN1,TR1,TTL0,TTL1,X,XX,Y,Z,Z0"
^XMB(3.9,146037,2,797,0)="""RTN"",""RCDPEM0"",15,0)"
^XMB(3.9,146037,2,798,0)=" ;"
^XMB(3.9,146037,2,799,0)="""RTN"",""RCDPEM0"",16,0)"
^XMB(3.9,146037,2,800,0)=" ; Find ERA to match to EFT by trace, date, amt"
^XMB(3.9,146037,2,801,0)="""RTN"",""RCDPEM0"",17,0)"
^XMB(3.9,146037,2,802,0)=" ; PRCA*4.5*345 Begin - Added lines"
^XMB(3.9,146037,2,803,0)="""RTN"",""RCDPEM0"",18,0)"
^XMB(3.9,146037,2,804,0)=" S TIN1=$$GET1^DIQ(344.31,RCZ_"","",.03,""I"")      ; EFT Payer TIN"
^XMB(3.9,146037,2,805,0)="""RTN"",""RCDPEM0"",19,0)"
^XMB(3.9,146037,2,806,0)=" S TR1=$$GET1^DIQ(344.31,RCZ_"","",.04,""I"")       ; EFT Trace Number"
^XMB(3.9,146037,2,807,0)="""RTN"",""RCDPEM0"",20,0)"
^XMB(3.9,146037,2,808,0)=" S TTL1=$$GET1^DIQ(344.31,RCZ_"","",.07,""I"")      ; EFT Amount of Payment"
^XMB(3.9,146037,2,809,0)="""RTN"",""RCDPEM0"",21,0)"
^XMB(3.9,146037,2,810,0)=" S MS1=$$GET1^DIQ(344.31,RCZ_"","",.06,""I"")       ; EFT Match Status"
^XMB(3.9,146037,2,811,0)="""RTN"",""RCDPEM0"",22,0)"
^XMB(3.9,146037,2,812,0)=" ; PRCA*4.5*345 End"
^XMB(3.9,146037,2,813,0)="""RTN"",""RCDPEM0"",23,0)"
^XMB(3.9,146037,2,814,0)=" S RC34431=$G(^RCY(344.31,RCZ,0))               ; EFT record "
^XMB(3.9,146037,2,815,0)="""RTN"",""RCDPEM0"",24,0)"
^XMB(3.9,146037,2,816,0)=" Q:MS1!$O(^RCY(344,""AEFT"",RCZ,0))               ; Already matched"
^XMB(3.9,146037,2,817,0)="""RTN"",""RCDPEM0"",25,0)"
^XMB(3.9,146037,2,818,0)=" I TIN1'="""",TR1'="""" D                           ; Must have Payor TIN and Trace #"
^XMB(3.9,146037,2,819,0)="""RTN"",""RCDPEM0"",26,0)"
^XMB(3.9,146037,2,820,0)=" . ;"
^XMB(3.9,146037,2,821,0)="""RTN"",""RCDPEM0"",27,0)"
^XMB(3.9,146037,2,822,0)=" . ; Loop through all of the ERAs that match the EFT on Trace Number and TIN"
^XMB(3.9,146037,2,823,0)="""RTN"",""RCDPEM0"",28,0)"
^XMB(3.9,146037,2,824,0)=" . S RCRZ=0"
^XMB(3.9,146037,2,825,0)="""RTN"",""RCDPEM0"",29,0)"
^XMB(3.9,146037,2,826,0)=" . F  S RCRZ=$O(^RCY(344.4,""ATRIDUP"",$$UP^XLFSTR(TR1),$$UP^XLFSTR(TIN1),RCRZ)) Q:'RCRZ  S RC3444=$G(^RCY(344.4,RCRZ,0)) I '$O(^RCY(344.31,""AERA"",RCRZ,0)),'$P(RC3444,U,9) D  Q:$D(Z(1))"
^XMB(3.9,146037,2,827,0)="""RTN"",""RCDPEM0"",30,0)"
^XMB(3.9,146037,2,828,0)=" . . S Z($S(+TTL1=+$P(RC3444,U,5):1,1:-1),RCRZ)="""" ; Total Amount Paid match?"
^XMB(3.9,146037,2,829,0)="""RTN"",""RCDPEM0"",31,0)"
^XMB(3.9,146037,2,830,0)=" ;"
^XMB(3.9,146037,2,831,0)="""RTN"",""RCDPEM0"",32,0)"
^XMB(3.9,146037,2,832,0)=" S RCMATCH=+$O(Z(""""),-1),RCRZ=+$O(Z(RCMATCH,0))"
^XMB(3.9,146037,2,833,0)="""RTN"",""RCDPEM0"",33,0)"
^XMB(3.9,146037,2,834,0)=" S $P(^TMP($J,""RCDPETOT"",344.31,RCZ),U)=RCMATCH"
^XMB(3.9,146037,2,835,0)="""RTN"",""RCDPEM0"",34,0)"
^XMB(3.9,146037,2,836,0)=" ;"
^XMB(3.9,146037,2,837,0)="""RTN"",""RCDPEM0"",35,0)"
^XMB(3.9,146037,2,838,0)=" I 'RCMATCH D  Q                                ; Match failure"
^XMB(3.9,146037,2,839,0)="""RTN"",""RCDPEM0"",36,0)"
^XMB(3.9,146037,2,840,0)=" . S ^TMP($J,""RCTOT"",""NO_MATCH"")=$G(^TMP($J,""RCTOT"",""NO_MATCH""))+1"
^XMB(3.9,146037,2,841,0)="""RTN"",""RCDPEM0"",37,0)"
^XMB(3.9,146037,2,842,0)=" ;"
^XMB(3.9,146037,2,843,0)="""RTN"",""RCDPEM0"",38,0)"
^XMB(3.9,146037,2,844,0)=" I RCMATCH<0 D"
^XMB(3.9,146037,2,845,0)="""RTN"",""RCDPEM0"",39,0)"
^XMB(3.9,146037,2,846,0)=" . ;"
^XMB(3.9,146037,2,847,0)="""RTN"",""RCDPEM0"",40,0)"
^XMB(3.9,146037,2,848,0)=" . ; Bulletin for totals don't match warning"
^XMB(3.9,146037,2,849,0)="""RTN"",""RCDPEM0"",41,0)"
^XMB(3.9,146037,2,850,0)=" . S ^TMP($J,""RCTOT"",""TOTMIS"")=$G(^TMP($J,""RCTOT"",""TOTMIS""))+1"
^XMB(3.9,146037,2,851,0)="""RTN"",""RCDPEM0"",42,0)"
^XMB(3.9,146037,2,852,0)=" . N RCER,RCLESS,RCM,RCT,XMB,XMBODY,XMERR,XMFULL,XMINSTR,XMSUBJ,XMTO,XMTYPE,XMZ"
^XMB(3.9,146037,2,853,0)="""RTN"",""RCDPEM0"",43,0)"
^XMB(3.9,146037,2,854,0)=" . S RCT=0"
^XMB(3.9,146037,2,855,0)="""RTN"",""RCDPEM0"",44,0)"
^XMB(3.9,146037,2,856,0)=" . D BLD^RCDPEM1(""RCER"",.RCT,344.31,RC34431)"
^XMB(3.9,146037,2,857,0)="""RTN"",""RCDPEM0"",45,0)"
^XMB(3.9,146037,2,858,0)=" . S RCT=RCT+1,RCER(RCT)="""""
^XMB(3.9,146037,2,859,0)="""RTN"",""RCDPEM0"",46,0)"
^XMB(3.9,146037,2,860,0)=" . K RCM"
^XMB(3.9,146037,2,861,0)="""RTN"",""RCDPEM0"",47,0)"
^XMB(3.9,146037,2,862,0)=" . S RCM=RCT"
^XMB(3.9,146037,2,863,0)="""RTN"",""RCDPEM0"",48,0)"
^XMB(3.9,146037,2,864,0)=" . S TTL0=+$$GET1^DIQ(344.4,RCRZ_"","",.05,""I"")       ; ERA Total Amount Paid - PRCA*4.5*345"
^XMB(3.9,146037,2,865,0)="""RTN"",""RCDPEM0"",49,0)"
^XMB(3.9,146037,2,866,0)=" . S RCLESS=(TTL1<TTL0)"
^XMB(3.9,146037,2,867,0)="""RTN"",""RCDPEM0"",50,0)"
^XMB(3.9,146037,2,868,0)=" . S RCT=RCT+1,RCER(RCT)=""  TOTALS ON ERA AND EFT DON'T MATCH."""
^XMB(3.9,146037,2,869,0)="""RTN"",""RCDPEM0"",51,0)"
^XMB(3.9,146037,2,870,0)=" . S RCT=RCT+1,RCER(RCT)=""  EFT TOTAL IS ""_$S(RCLESS:""LESS"",1:""GREATER"")_"" THAN ERA AMOUNT TOTAL"""
^XMB(3.9,146037,2,871,0)="""RTN"",""RCDPEM0"",52,0)"
^XMB(3.9,146037,2,872,0)=" . I RCLESS D"
^XMB(3.9,146037,2,873,0)="""RTN"",""RCDPEM0"",53,0)"
^XMB(3.9,146037,2,874,0)=" . . S RCT=RCT+1"
^XMB(3.9,146037,2,875,0)="""RTN"",""RCDPEM0"",54,0)"
^XMB(3.9,146037,2,876,0)=" . . S RCER(RCT)=""  DECREASE ADJUSTMENT IS NEEDED BEFORE THE ERA RECEIPT CAN BE PROCESSED."""
^XMB(3.9,146037,2,877,0)="""RTN"",""RCDPEM0"",55,0)"
^XMB(3.9,146037,2,878,0)=" . I 'RCLESS D"
^XMB(3.9,146037,2,879,0)="""RTN"",""RCDPEM0"",56,0)"
^XMB(3.9,146037,2,880,0)=" . . S RCT=RCT+1"
^XMB(3.9,146037,2,881,0)="""RTN"",""RCDPEM0"",57,0)"
^XMB(3.9,146037,2,882,0)=" . . S RCER(RCT)=""  A SUSPENSE LINE IS NEEDED ON THE RECEIPT TO ACCOUNT FOR THE DIFFERENCE."""
^XMB(3.9,146037,2,883,0)="""RTN"",""RCDPEM0"",58,0)"
^XMB(3.9,146037,2,884,0)=" . S RCT=RCT+1"
^XMB(3.9,146037,2,885,0)="""RTN"",""RCDPEM0"",59,0)"
^XMB(3.9,146037,2,886,0)=" . S RCER(RCT)=""  IF YOU USE THE ERA WORKLIST SCRATCH PAD, THIS WILL BE GENERATED FOR YOU."""
^XMB(3.9,146037,2,887,0)="""RTN"",""RCDPEM0"",60,0)"
^XMB(3.9,146037,2,888,0)=" . ;"
^XMB(3.9,146037,2,889,0)="""RTN"",""RCDPEM0"",61,0)"
^XMB(3.9,146037,2,890,0)=" . S RCT=RCT+1,RCER(RCT)=""  EFT WAS MATCHED TO ERA ENTRY #: ""_RCRZ_"" ($""_$J(TTL0,"""",2)_"")."""
^XMB(3.9,146037,2,891,0)="""RTN"",""RCDPEM0"",62,0)"
^XMB(3.9,146037,2,892,0)=" . S XMTO(""I:G.RCDPE PAYMENTS"")="""""
^XMB(3.9,146037,2,893,0)="""RTN"",""RCDPEM0"",63,0)"
^XMB(3.9,146037,2,894,0)=" . S XMBODY=""RCER"""
^XMB(3.9,146037,2,895,0)="""RTN"",""RCDPEM0"",64,0)"
^XMB(3.9,146037,2,896,0)=" . S XMSUBJ=""EDI LBOX TOTALS MISMATCH ON EFT-ERA MATCH"""
^XMB(3.9,146037,2,897,0)="""RTN"",""RCDPEM0"",65,0)"
^XMB(3.9,146037,2,898,0)=" . D"
^XMB(3.9,146037,2,899,0)="""RTN"",""RCDPEM0"",66,0)"
^XMB(3.9,146037,2,900,0)=" . . N DUZ S DUZ=.5,DUZ(0)=""@"""
^XMB(3.9,146037,2,901,0)="""RTN"",""RCDPEM0"",67,0)"
^XMB(3.9,146037,2,902,0)=" . . D SENDMSG^XMXAPI(.5,XMSUBJ,XMBODY,.XMTO,,.XMZ)"
^XMB(3.9,146037,2,903,0)="""RTN"",""RCDPEM0"",68,0)"
^XMB(3.9,146037,2,904,0)=" . ;"
^XMB(3.9,146037,2,905,0)="""RTN"",""RCDPEM0"",69,0)"
^XMB(3.9,146037,2,906,0)=" . ; Update log"
^XMB(3.9,146037,2,907,0)="""RTN"",""RCDPEM0"",70,0)"
^XMB(3.9,146037,2,908,0)=" . F  S RCM=$O(RCER(RCM)) Q:'RCM  S RCT=RCT+1,RCM(RCT)=RCER(RCM)"
^XMB(3.9,146037,2,909,0)="""RTN"",""RCDPEM0"",71,0)"
^XMB(3.9,146037,2,910,0)=" . D STORERR(344.31,RCZ,.RCM)"
^XMB(3.9,146037,2,911,0)="""RTN"",""RCDPEM0"",72,0)"
^XMB(3.9,146037,2,912,0)=" ;"
^XMB(3.9,146037,2,913,0)="""RTN"",""RCDPEM0"",73,0)"
^XMB(3.9,146037,2,914,0)=" ; Many checks done by this are also done AUTOCHK2^RCDPEAP1 so if these are changed, "
^XMB(3.9,146037,2,915,0)="""RTN"",""RCDPEM0"",74,0)"
^XMB(3.9,146037,2,916,0)=" ; AUTOCHK2 may also need to be changed"
^XMB(3.9,146037,2,917,0)="""RTN"",""RCDPEM0"",75,0)"
^XMB(3.9,146037,2,918,0)=" I RCMATCH D"
^XMB(3.9,146037,2,919,0)="""RTN"",""RCDPEM0"",76,0)"
^XMB(3.9,146037,2,920,0)=" . D UPDMATCH^RCDPEU2(RCRZ,RCZ,RCMATCH) ; PRCA*4.5*439"
^XMB(3.9,146037,2,921,0)="""RTN"",""RCDPEM0"",77,0)"
^XMB(3.9,146037,2,922,0)=" . S ^TMP($J,""RCTOT"",""MATCH"")=$G(^TMP($J,""RCTOT"",""MATCH""))+1"
^XMB(3.9,146037,2,923,0)="""RTN"",""RCDPEM0"",78,0)"
^XMB(3.9,146037,2,924,0)=" . ;"
^XMB(3.9,146037,2,925,0)="""RTN"",""RCDPEM0"",79,0)"
^XMB(3.9,146037,2,926,0)=" . ; Lines below are added for Auto-posting - PRCA*4.5*298"
^XMB(3.9,146037,2,927,0)="""RTN"",""RCDPEM0"",80,0)"
^XMB(3.9,146037,2,928,0)=" . ; Quit if this is not nightly job"
^XMB(3.9,146037,2,929,0)="""RTN"",""RCDPEM0"",81,0)"
^XMB(3.9,146037,2,930,0)=" . Q:'RCPROC"
^XMB(3.9,146037,2,931,0)="""RTN"",""RCDPEM0"",82,0)"
^XMB(3.9,146037,2,932,0)=" . Q:+$P($G(^RCY(344.4,RCRZ,0)),U,5)=0       ; Quit if this is a zero value ERA"
^XMB(3.9,146037,2,933,0)="""RTN"",""RCDPEM0"",83,0)"
^XMB(3.9,146037,2,934,0)=" . ;"
^XMB(3.9,146037,2,935,0)="""RTN"",""RCDPEM0"",84,0)"
^XMB(3.9,146037,2,936,0)=" . ; PRCA*4.5*424 Added new method to move code from below to RCDPEAP2 so that it"
^XMB(3.9,146037,2,937,0)="""RTN"",""RCDPEM0"",85,0)"
^XMB(3.9,146037,2,938,0)=" . ; can also be checked when auto-posting ZERO balance ERAs"
^XMB(3.9,146037,2,939,0)="""RTN"",""RCDPEM0"",86,0)"
^XMB(3.9,146037,2,940,0)=" . Q:$$PAYEREXC^RCDPEAP2(RCRZ)               ; Quit if the payer is excluded"
^XMB(3.9,146037,2,941,0)="""RTN"",""RCDPEM0"",87,0)"
^XMB(3.9,146037,2,942,0)=" . ;"
^XMB(3.9,146037,2,943,0)="""RTN"",""RCDPEM0"",88,0)"
^XMB(3.9,146037,2,944,0)=" . ; Ignore ERA with exceptions, zero balance, or ERA-level adjustments"
^XMB(3.9,146037,2,945,0)="""RTN"",""RCDPEM0"",89,0)"
^XMB(3.9,146037,2,946,0)=" . Q:'$$AUTOCHK^RCDPEAP1(RCRZ)"
^XMB(3.9,146037,2,947,0)="""RTN"",""RCDPEM0"",90,0)"
^XMB(3.9,146037,2,948,0)=" . ;"
^XMB(3.9,146037,2,949,0)="""RTN"",""RCDPEM0"",91,0)"
^XMB(3.9,146037,2,950,0)=" . ; Set AUTO-POST STATUS = UNPOSTED this is trigger for auto-post (EN^RCDPEAP)"
^XMB(3.9,146037,2,951,0)="""RTN"",""RCDPEM0"",92,0)"
^XMB(3.9,146037,2,952,0)=" . D SETSTA^RCDPEAP(RCRZ,0,""Auto Matching: Marked as Auto-Post Candidate"")"
^XMB(3.9,146037,2,953,0)="""RTN"",""RCDPEM0"",93,0)"
^XMB(3.9,146037,2,954,0)=" Q"
^XMB(3.9,146037,2,955,0)="""RTN"",""RCDPEM0"",94,0)"
^XMB(3.9,146037,2,956,0)=" ;"
^XMB(3.9,146037,2,957,0)="""RTN"",""RCDPEM0"",95,0)"
^XMB(3.9,146037,2,958,0)="ADDDEP(RCD,RCDDT,RCZ) ; Add deposit"
^XMB(3.9,146037,2,959,0)="""RTN"",""RCDPEM0"",96,0)"
^XMB(3.9,146037,2,960,0)=" ; RCD = deposit #"
^XMB(3.9,146037,2,961,0)="""RTN"",""RCDPEM0"",97,0)"
^XMB(3.9,146037,2,962,0)=" ; RCDDT = deposit date FM format"
^XMB(3.9,146037,2,963,0)="""RTN"",""RCDPEM0"",98,0)"
^XMB(3.9,146037,2,964,0)=" ; RCZ = ien of entry in file 344.3"
^XMB(3.9,146037,2,965,0)="""RTN"",""RCDPEM0"",99,0)"
^XMB(3.9,146037,2,966,0)=" ; Function returns IEN of new deposit entry"
^XMB(3.9,146037,2,967,0)="""RTN"",""RCDPEM0"",100,0)"
^XMB(3.9,146037,2,968,0)=" ;"
^XMB(3.9,146037,2,969,0)="""RTN"",""RCDPEM0"",101,0)"
^XMB(3.9,146037,2,970,0)=" N RCDEP,RC0,DIE,DR,DA,X,Y"
^XMB(3.9,146037,2,971,0)="""RTN"",""RCDPEM0"",102,0)"
^XMB(3.9,146037,2,972,0)=" S RCDEP=+$$ADDDEPT^RCDPUDEP(RCD,RCDDT)"
^XMB(3.9,146037,2,973,0)="""RTN"",""RCDPEM0"",103,0)"
^XMB(3.9,146037,2,974,0)=" I RCDEP D"
^XMB(3.9,146037,2,975,0)="""RTN"",""RCDPEM0"",104,0)"
^XMB(3.9,146037,2,976,0)=" . D LOCKDEP^RCDPEM(RCDEP,1)"
^XMB(3.9,146037,2,977,0)="""RTN"",""RCDPEM0"",105,0)"
^XMB(3.9,146037,2,978,0)=" . S RC0=$G(^RCY(344.3,RCZ,0))"
^XMB(3.9,146037,2,979,0)="""RTN"",""RCDPEM0"",106,0)"
^XMB(3.9,146037,2,980,0)=" . S DIE=""^RCY(344.1,"",DA=RCDEP,DR="".04////""_+$P(RC0,U,8)_$S($P(RC0,U,4)'="""":"";.05////""_$P(RC0,U,4),1:"""")  D ^DIE"
^XMB(3.9,146037,2,981,0)="""RTN"",""RCDPEM0"",107,0)"
^XMB(3.9,146037,2,982,0)=" . S DIE=""^RCY(344.3,"",DR="".03////""_RCDEP,DA=RCZ D ^DIE"
^XMB(3.9,146037,2,983,0)="""RTN"",""RCDPEM0"",108,0)"
^XMB(3.9,146037,2,984,0)=" . S $P(^TMP($J,""RCDPETOT"",344.3,RCZ),U,5)=RCDEP"
^XMB(3.9,146037,2,985,0)="""RTN"",""RCDPEM0"",109,0)"
^XMB(3.9,146037,2,986,0)=" Q RCDEP"
^XMB(3.9,146037,2,987,0)="""RTN"",""RCDPEM0"",110,0)"
^XMB(3.9,146037,2,988,0)=" ;"
^XMB(3.9,146037,2,989,0)="""RTN"",""RCDPEM0"",111,0)"
^XMB(3.9,146037,2,990,0)="ADDREC(RCDEP,RCZ) ; Add receipt, send CR to FUND 528704, Rev src cd 8NZZ for total EFT amt"
^XMB(3.9,146037,2,991,0)="""RTN"",""RCDPEM0"",112,0)"
^XMB(3.9,146037,2,992,0)=" ; Input:   RCDEP   - IEN in AR DEPOSIT file (#344.1)"
^XMB(3.9,146037,2,993,0)="""RTN"",""RCDPEM0"",113,0)"
^XMB(3.9,146037,2,994,0)=" ;          RCZ     - IEN in EDI LOCKBOX DEPOSIT file (#344.3) (same as $P(^RCY(344.31,IEN,0),""^"",1)"
^XMB(3.9,146037,2,995,0)="""RTN"",""RCDPEM0"",114,0)"
^XMB(3.9,146037,2,996,0)=" ; Returns: IEN of new receipt entry"
^XMB(3.9,146037,2,997,0)="""RTN"",""RCDPEM0"",115,0)"
^XMB(3.9,146037,2,998,0)=" ;"
^XMB(3.9,146037,2,999,0)="""RTN"",""RCDPEM0"",116,0)"
^XMB(3.9,146037,2,1000,0)=" ; RCLOCK   - Flag indicating lock success"
^XMB(3.9,146037,2,1001,0)="""RTN"",""RCDPEM0"",117,0)"
^XMB(3.9,146037,2,1002,0)=" ;PRCA*4.5*409 - Added RCPAYTYP description"
^XMB(3.9,146037,2,1003,0)="""RTN"",""RCDPEM0"",118,0)"
^XMB(3.9,146037,2,1004,0)=" ; RCPAYTYP - 14 if the trace number of the EFT does not begin with OGC (EDI LOCKBOX)"
^XMB(3.9,146037,2,1005,0)="""RTN"",""RCDPEM0"",119,0)"
^XMB(3.9,146037,2,1006,0)=" ;            18 if the trace number of the EFT begins with OGC (OGC-EFT)"
^XMB(3.9,146037,2,1007,0)="""RTN"",""RCDPEM0"",120,0)"
^XMB(3.9,146037,2,1008,0)=" ; RCTRANDA - Transaction number"
^XMB(3.9,146037,2,1009,0)="""RTN"",""RCDPEM0"",121,0)"
^XMB(3.9,146037,2,1010,0)=" ; RECTDA   - IEN in file #344"
^XMB(3.9,146037,2,1011,0)="""RTN"",""RCDPEM0"",122,0)"
^XMB(3.9,146037,2,1012,0)=" ;"
^XMB(3.9,146037,2,1013,0)="""RTN"",""RCDPEM0"",123,0)"
^XMB(3.9,146037,2,1014,0)=" ;PRCA*4.5*409 Added RCPAYTYP, XX"
^XMB(3.9,146037,2,1015,0)="""RTN"",""RCDPEM0"",124,0)"
^XMB(3.9,146037,2,1016,0)=" N RCER,RCLOCK,RCTRANDA,RECTDA,RCQUIT,RCDPDATA,RCPAYTYP,RCTOTCT,RC0,DIE,DA,DR,X,XX,Y"
^XMB(3.9,146037,2,1017,0)="""RTN"",""RCDPEM0"",125,0)"
^XMB(3.9,146037,2,1018,0)=" S RC0=$G(^RCY(344.3,RCZ,0))"
^XMB(3.9,146037,2,1019,0)="""RTN"",""RCDPEM0"",126,0)"
^XMB(3.9,146037,2,1020,0)=" S $P(^TMP($J,""RCDPETOT"",344.3,RCZ),U,3)=0"
^XMB(3.9,146037,2,1021,0)="""RTN"",""RCDPEM0"",127,0)"
^XMB(3.9,146037,2,1022,0)=" ;"
^XMB(3.9,146037,2,1023,0)="""RTN"",""RCDPEM0"",128,0)"
^XMB(3.9,146037,2,1024,0)=" ; Single receipt - multiple transactions for EFT payments"
^XMB(3.9,146037,2,1025,0)="""RTN"",""RCDPEM0"",129,0)"
^XMB(3.9,146037,2,1026,0)=" ;"
^XMB(3.9,146037,2,1027,0)="""RTN"",""RCDPEM0"",130,0)"
^XMB(3.9,146037,2,1028,0)=" ;PRCA*4.5*409 - Added lines Begin"
^XMB(3.9,146037,2,1029,0)="""RTN"",""RCDPEM0"",131,0)"
^XMB(3.9,146037,2,1030,0)=" S XX=$O(^RCY(344.31,""B"",RCZ,""""))               ; Get EFT IEN"
^XMB(3.9,146037,2,1031,0)="""RTN"",""RCDPEM0"",132,0)"
^XMB(3.9,146037,2,1032,0)=" S XX=$P(^RCY(344.31,XX,0),""^"",4)               ; EFT Trace Number"
^XMB(3.9,146037,2,1033,0)="""RTN"",""RCDPEM0"",133,0)"
^XMB(3.9,146037,2,1034,0)=" S RCPAYTYP=$S($E(XX,1,3)=""OGC"":18,1:14)        ; IEN in 341.1 AR EVENT TYPE file"
^XMB(3.9,146037,2,1035,0)="""RTN"",""RCDPEM0"",134,0)"
^XMB(3.9,146037,2,1036,0)=" ;PRCA*4.5*409 - Added lines End"
^XMB(3.9,146037,2,1037,0)="""RTN"",""RCDPEM0"",135,0)"
^XMB(3.9,146037,2,1038,0)=" ;"
^XMB(3.9,146037,2,1039,0)="""RTN"",""RCDPEM0"",136,0)"
^XMB(3.9,146037,2,1040,0)=" ;PRCA*4.5*409 - Replaced +$O(^RC(341.1,""AC"",14,0)) with +RCPAYTYP below"
^XMB(3.9,146037,2,1041,0)="""RTN"",""RCDPEM0"",137,0)"
^XMB(3.9,146037,2,1042,0)=" S RECTDA=+$$ADDRECT^RCDPUREC($P(RC0,U,7),RCDEP,+RCPAYTYP)"
^XMB(3.9,146037,2,1043,0)="""RTN"",""RCDPEM0"",138,0)"
^XMB(3.9,146037,2,1044,0)=" ;"
^XMB(3.9,146037,2,1045,0)="""RTN"",""RCDPEM0"",139,0)"
^XMB(3.9,146037,2,1046,0)=" ; Create detail lines for deposit amount, process whole receipt to send"
^XMB(3.9,146037,2,1047,0)="""RTN"",""RCDPEM0"",140,0)"
^XMB(3.9,146037,2,1048,0)=" ; CR document for deposit amount"
^XMB(3.9,146037,2,1049,0)="""RTN"",""RCDPEM0"",141,0)"
^XMB(3.9,146037,2,1050,0)=" I RECTDA D"
^XMB(3.9,146037,2,1051,0)="""RTN"",""RCDPEM0"",142,0)"
^XMB(3.9,146037,2,1052,0)=" . L +^RCY(344,RECTDA):DILOCKTM S RCLOCK=$T Q:'RCLOCK  ; exit if unable to lock"
^XMB(3.9,146037,2,1053,0)="""RTN"",""RCDPEM0"",143,0)"
^XMB(3.9,146037,2,1054,0)=" . N STATUS,RC00,RCT"
^XMB(3.9,146037,2,1055,0)="""RTN"",""RCDPEM0"",144,0)"
^XMB(3.9,146037,2,1056,0)=" . S $P(^TMP($J,""RCDPETOT"",344.3,RCZ),U)=RECTDA"
^XMB(3.9,146037,2,1057,0)="""RTN"",""RCDPEM0"",145,0)"
^XMB(3.9,146037,2,1058,0)=" . S ^TMP($J,""RCTOT"",""EFT_RECPT"")=$G(^TMP($J,""RCTOT"",""EFT_RECPT""))+1"
^XMB(3.9,146037,2,1059,0)="""RTN"",""RCDPEM0"",146,0)"
^XMB(3.9,146037,2,1060,0)=" . ;"
^XMB(3.9,146037,2,1061,0)="""RTN"",""RCDPEM0"",147,0)"
^XMB(3.9,146037,2,1062,0)=" . ; Check to see if receipt has been processed (fms document)"
^XMB(3.9,146037,2,1063,0)="""RTN"",""RCDPEM0"",148,0)"
^XMB(3.9,146037,2,1064,0)=" . D DIQ344^RCDPRPLM(RECTDA,""200;"")"
^XMB(3.9,146037,2,1065,0)="""RTN"",""RCDPEM0"",149,0)"
^XMB(3.9,146037,2,1066,0)=" . ;"
^XMB(3.9,146037,2,1067,0)="""RTN"",""RCDPEM0"",150,0)"
^XMB(3.9,146037,2,1068,0)=" . ; Code sheet already sent once, this is a retransmission, check it"
^XMB(3.9,146037,2,1069,0)="""RTN"",""RCDPEM0"",151,0)"
^XMB(3.9,146037,2,1070,0)=" . I RCDPDATA(344,RECTDA,200,""E"")'="""" S RCQUIT=0 D  Q:RCQUIT"
^XMB(3.9,146037,2,1071,0)="""RTN"",""RCDPEM0"",152,0)"
^XMB(3.9,146037,2,1072,0)=" . . S STATUS=$$STATUS^GECSSGET(RCDPDATA(344,RECTDA,200,""E""))"
^XMB(3.9,146037,2,1073,0)="""RTN"",""RCDPEM0"",153,0)"
^XMB(3.9,146037,2,1074,0)=" . . ;"
^XMB(3.9,146037,2,1075,0)="""RTN"",""RCDPEM0"",154,0)"
^XMB(3.9,146037,2,1076,0)=" . . ; Okay to continue if status is Error, Rejected, or not defined (-1)"
^XMB(3.9,146037,2,1077,0)="""RTN"",""RCDPEM0"",155,0)"
^XMB(3.9,146037,2,1078,0)=" . . I $E(STATUS)=""E""!($E(STATUS)=""R"")!(STATUS=-1) Q"
^XMB(3.9,146037,2,1079,0)="""RTN"",""RCDPEM0"",156,0)"
^XMB(3.9,146037,2,1080,0)=" . . S RCER(1)=$$SETERR(2),RCER(2)=""  Receipt already sent to FMS - No change"""
^XMB(3.9,146037,2,1081,0)="""RTN"",""RCDPEM0"",157,0)"
^XMB(3.9,146037,2,1082,0)=" . . D BULL^RCDPEM1(344.3,RC0,.RCER)"
^XMB(3.9,146037,2,1083,0)="""RTN"",""RCDPEM0"",158,0)"
^XMB(3.9,146037,2,1084,0)=" . . S $P(^TMP($J,""RCDPETOT"",344.3,RCZ),U,4)=+$G(^TMP($J,""RCXM"",0))"
^XMB(3.9,146037,2,1085,0)="""RTN"",""RCDPEM0"",159,0)"
^XMB(3.9,146037,2,1086,0)=" . . D STORERR(344.3,RCZ,.RCER)"
^XMB(3.9,146037,2,1087,0)="""RTN"",""RCDPEM0"",160,0)"
^XMB(3.9,146037,2,1088,0)=" . . L -^RCY(344,RECTDA)"
^XMB(3.9,146037,2,1089,0)="""RTN"",""RCDPEM0"",161,0)"
^XMB(3.9,146037,2,1090,0)=" . . L -^RCY(344.1,RCDEP)"
^XMB(3.9,146037,2,1091,0)="""RTN"",""RCDPEM0"",162,0)"
^XMB(3.9,146037,2,1092,0)=" . . S RCQUIT=1 K RCER"
^XMB(3.9,146037,2,1093,0)="""RTN"",""RCDPEM0"",163,0)"
^XMB(3.9,146037,2,1094,0)=" . ;"
^XMB(3.9,146037,2,1095,0)="""RTN"",""RCDPEM0"",164,0)"
^XMB(3.9,146037,2,1096,0)=" . ; Mark receipt as processed (closed) to prevent editing"
^XMB(3.9,146037,2,1097,0)="""RTN"",""RCDPEM0"",165,0)"
^XMB(3.9,146037,2,1098,0)=" . D MARKPROC^RCDPUREC(RECTDA,"""")"
^XMB(3.9,146037,2,1099,0)="""RTN"",""RCDPEM0"",166,0)"
^XMB(3.9,146037,2,1100,0)=" . ;"
^XMB(3.9,146037,2,1101,0)="""RTN"",""RCDPEM0"",167,0)"
^XMB(3.9,146037,2,1102,0)=" . ;PRCA*4.5*409 - Replaced +$O(^RC(341.1,""AC"",14,0)) with +RCPAYTYP below"
^XMB(3.9,146037,2,1103,0)="""RTN"",""RCDPEM0"",168,0)"
^XMB(3.9,146037,2,1104,0)=" . S DIE=""^RCY(344,"",DR="".04////""_+RCPAYTYP,DA=RECTDA"
^XMB(3.9,146037,2,1105,0)="""RTN"",""RCDPEM0"",169,0)"
^XMB(3.9,146037,2,1106,0)=" . D ^DIE                                       ; Add EDI Lockbox payment type"
^XMB(3.9,146037,2,1107,0)="""RTN"",""RCDPEM0"",170,0)"
^XMB(3.9,146037,2,1108,0)=" . ;"
^XMB(3.9,146037,2,1109,0)="""RTN"",""RCDPEM0"",171,0)"
^XMB(3.9,146037,2,1110,0)=" . ; Add receipt line for each payer's EFT"
^XMB(3.9,146037,2,1111,0)="""RTN"",""RCDPEM0"",172,0)"
^XMB(3.9,146037,2,1112,0)=" . S RCT=0 F  S RCT=$O(^RCY(344.31,""B"",RCZ,RCT)) Q:'RCT  D  Q:$O(RCER(0))"
^XMB(3.9,146037,2,1113,0)="""RTN"",""RCDPEM0"",173,0)"
^XMB(3.9,146037,2,1114,0)=" . . S RC00=$G(^RCY(344.31,RCT,0)),DR="""""
^XMB(3.9,146037,2,1115,0)="""RTN"",""RCDPEM0"",174,0)"
^XMB(3.9,146037,2,1116,0)=" . . S RCTRANDA=$S('$P(RC00,U,14):$$ADDTRAN^RCDPURET(RECTDA),1:$P(RC00,U,14)) ; detail line"
^XMB(3.9,146037,2,1117,0)="""RTN"",""RCDPEM0"",175,0)"
^XMB(3.9,146037,2,1118,0)=" . . I 'RCTRANDA D  Q"
^XMB(3.9,146037,2,1119,0)="""RTN"",""RCDPEM0"",176,0)"
^XMB(3.9,146037,2,1120,0)=" . . . S RCER(1)=$$SETERR(2)"
^XMB(3.9,146037,2,1121,0)="""RTN"",""RCDPEM0"",177,0)"
^XMB(3.9,146037,2,1122,0)=" . . . S RCER(2)=""  The receipt for the EFT deposit was not created correctly"""
^XMB(3.9,146037,2,1123,0)="""RTN"",""RCDPEM0"",178,0)"
^XMB(3.9,146037,2,1124,0)=" . . . S RCER(3)=""  You may have to add the detail manually to send the FMS CR doc to revenue"""
^XMB(3.9,146037,2,1125,0)="""RTN"",""RCDPEM0"",179,0)"
^XMB(3.9,146037,2,1126,0)=" . . . S RCER(4)=""  source code 8NZZ in fund ""_$S(DT<$$ADDPTEDT^PRCAACC():""5287.4"",1:""528704"")"
^XMB(3.9,146037,2,1127,0)="""RTN"",""RCDPEM0"",180,0)"
^XMB(3.9,146037,2,1128,0)=" . . . S RCER(4)=RCER(4)_"".  Receipt # is ""_$P($G(^RCY(344,RECTDA,0)),U)"
^XMB(3.9,146037,2,1129,0)="""RTN"",""RCDPEM0"",181,0)"
^XMB(3.9,146037,2,1130,0)=" . . . S RCER(5)=""  Trace # being processed at time of error was: ""_$P(RC00,U,4)_""."""
^XMB(3.9,146037,2,1131,0)="""RTN"",""RCDPEM0"",182,0)"
^XMB(3.9,146037,2,1132,0)=" . . . D BULL^RCDPEM1(344.3,RC0,.RCER)"
^XMB(3.9,146037,2,1133,0)="""RTN"",""RCDPEM0"",183,0)"
^XMB(3.9,146037,2,1134,0)=" . . . S $P(^TMP($J,""RCDPETOT"",344.3,RCZ),U,4)=+$G(^TMP($J,""RCXM"",0))"
^XMB(3.9,146037,2,1135,0)="""RTN"",""RCDPEM0"",184,0)"
^XMB(3.9,146037,2,1136,0)=" . . . D STORERR(344.3,RCZ,.RCER)"
^XMB(3.9,146037,2,1137,0)="""RTN"",""RCDPEM0"",185,0)"
^XMB(3.9,146037,2,1138,0)=" . . ;"
^XMB(3.9,146037,2,1139,0)="""RTN"",""RCDPEM0"",186,0)"
^XMB(3.9,146037,2,1140,0)=" . . ;PRCA*4.5*409 Added lines Begin"
^XMB(3.9,146037,2,1141,0)="""RTN"",""RCDPEM0"",187,0)"
^XMB(3.9,146037,2,1142,0)=" . . S XX=$P(RC00,""^"",4),RCPAYTYP=$S($E(XX,1,3)=""OGC"":18,1:14)"
^XMB(3.9,146037,2,1143,0)="""RTN"",""RCDPEM0"",188,0)"
^XMB(3.9,146037,2,1144,0)=" . . S XX=$S(RCPAYTYP=14:""Auto added EDI Lockbox deposit"",1:""Auto added OGC-EFT deposit"")"
^XMB(3.9,146037,2,1145,0)="""RTN"",""RCDPEM0"",189,0)"
^XMB(3.9,146037,2,1146,0)=" . . ;"
^XMB(3.9,146037,2,1147,0)="""RTN"",""RCDPEM0"",190,0)"
^XMB(3.9,146037,2,1148,0)=" . . ;PRCA*4.5*409 Added lines End"
^XMB(3.9,146037,2,1149,0)="""RTN"",""RCDPEM0"",191,0)"
^XMB(3.9,146037,2,1150,0)=" . . ;"
^XMB(3.9,146037,2,1151,0)="""RTN"",""RCDPEM0"",192,0)"
^XMB(3.9,146037,2,1152,0)=" . . ;PRCA*4.5*409 Replaced Auto added EDI Lockbox deposit with _XX_"" below"
^XMB(3.9,146037,2,1153,0)="""RTN"",""RCDPEM0"",193,0)"
^XMB(3.9,146037,2,1154,0)=" . . S DR=DR_"";1.02////""_XX_"";.06////""_$P(RC00,U,12)"
^XMB(3.9,146037,2,1155,0)="""RTN"",""RCDPEM0"",194,0)"
^XMB(3.9,146037,2,1156,0)=" . . S DR=DR_"";.04////""_$J(+$P(RC00,U,7),"""",2)_"";.14////""_RCTRANDA"
^XMB(3.9,146037,2,1157,0)="""RTN"",""RCDPEM0"",195,0)"
^XMB(3.9,146037,2,1158,0)=" . . N N S N=+$O(^VA(200,""B"",""EDILOCKBOX,AUTOMATIC"",0)) S:N=0 N=.5"
^XMB(3.9,146037,2,1159,0)="""RTN"",""RCDPEM0"",196,0)"
^XMB(3.9,146037,2,1160,0)=" . . S DR=DR_"";.12////""_N_"";.29////""_$P(RC00,U,16) ;PRCA*4.5*375 - Add Debit/Credit Flag to Receipt Transactions"
^XMB(3.9,146037,2,1161,0)="""RTN"",""RCDPEM0"",197,0)"
^XMB(3.9,146037,2,1162,0)=" . . S DA(1)=RECTDA,DA=RCTRANDA,DIE=""^RCY(344,""_DA(1)_"",1,"""
^XMB(3.9,146037,2,1163,0)="""RTN"",""RCDPEM0"",198,0)"
^XMB(3.9,146037,2,1164,0)=" . . S:$E(DR)="";"" DR=$P(DR,"";"",2,999)"
^XMB(3.9,146037,2,1165,0)="""RTN"",""RCDPEM0"",199,0)"
^XMB(3.9,146037,2,1166,0)=" . . D ^DIE"
^XMB(3.9,146037,2,1167,0)="""RTN"",""RCDPEM0"",200,0)"
^XMB(3.9,146037,2,1168,0)=" . . S DR="".14///""_RCTRANDA_"";.09///""_RECTDA,DIE=""^RCY(344.31,"",DA=RCT"
^XMB(3.9,146037,2,1169,0)="""RTN"",""RCDPEM0"",201,0)"
^XMB(3.9,146037,2,1170,0)=" . . D ^DIE"
^XMB(3.9,146037,2,1171,0)="""RTN"",""RCDPEM0"",202,0)"
^XMB(3.9,146037,2,1172,0)=" . . ;"
^XMB(3.9,146037,2,1173,0)="""RTN"",""RCDPEM0"",203,0)"
^XMB(3.9,146037,2,1174,0)=" . ;"
^XMB(3.9,146037,2,1175,0)="""RTN"",""RCDPEM0"",204,0)"
^XMB(3.9,146037,2,1176,0)=" . ; Post to FUND 528704/RSC 8NZZ"
^XMB(3.9,146037,2,1177,0)="""RTN"",""RCDPEM0"",205,0)"
^XMB(3.9,146037,2,1178,0)=" . D PROCESS^RCDPURE1(RECTDA,2)"
^XMB(3.9,146037,2,1179,0)="""RTN"",""RCDPEM0"",206,0)"
^XMB(3.9,146037,2,1180,0)=" . ;"
^XMB(3.9,146037,2,1181,0)="""RTN"",""RCDPEM0"",207,0)"
^XMB(3.9,146037,2,1182,0)=" . ; Save details for status report"
^XMB(3.9,146037,2,1183,0)="""RTN"",""RCDPEM0"",208,0)"
^XMB(3.9,146037,2,1184,0)=" . N Z,TOT"
^XMB(3.9,146037,2,1185,0)="""RTN"",""RCDPEM0"",209,0)"
^XMB(3.9,146037,2,1186,0)=" . S (TOT,Z)=0 F  S Z=$O(^RCY(344,RECTDA,1,Z)) Q:'Z  S TOT=TOT+$P($G(^RCY(344,RECTDA,1,Z,0)),U,4)"
^XMB(3.9,146037,2,1187,0)="""RTN"",""RCDPEM0"",210,0)"
^XMB(3.9,146037,2,1188,0)=" . S $P(^TMP($J,""RCDPETOT"",344.3,RCZ),U,2)=TOT"
^XMB(3.9,146037,2,1189,0)="""RTN"",""RCDPEM0"",211,0)"
^XMB(3.9,146037,2,1190,0)=" . ;"
^XMB(3.9,146037,2,1191,0)="""RTN"",""RCDPEM0"",212,0)"
^XMB(3.9,146037,2,1192,0)=" . I $P($G(^RCY(344,RECTDA,2)),U)="""" D  ; Receipt not processed fully"
^XMB(3.9,146037,2,1193,0)="""RTN"",""RCDPEM0"",213,0)"
^XMB(3.9,146037,2,1194,0)=" . . N CT,Z"
^XMB(3.9,146037,2,1195,0)="""RTN"",""RCDPEM0"",214,0)"
^XMB(3.9,146037,2,1196,0)=" . . S RCER(1)=$$SETERR(2),RCER(2)=""  The receipt ""_$P($G(^RCY(344,RECTDA,0)),U)"
^XMB(3.9,146037,2,1197,0)="""RTN"",""RCDPEM0"",215,0)"
^XMB(3.9,146037,2,1198,0)=" . . S RCER(1)=RCER(1)_"" for the EFT deposit was not processed fully"""
^XMB(3.9,146037,2,1199,0)="""RTN"",""RCDPEM0"",216,0)"
^XMB(3.9,146037,2,1200,0)=" . . S:TOT RCER(3)=""  You must manually process it to create the FMS CR doc to rev src code 8NZZ"""
^XMB(3.9,146037,2,1201,0)="""RTN"",""RCDPEM0"",217,0)"
^XMB(3.9,146037,2,1202,0)=" . . S Z=0,CT=+$O(RCER("" ""),-1) F  S Z=$O(^TMP($J,""RCDPEMSG"",Z)) Q:'Z  S CT=CT+1,RCER(CT)=$G(^TMP($J,""RCDPEMSG"",Z))"
^XMB(3.9,146037,2,1203,0)="""RTN"",""RCDPEM0"",218,0)"
^XMB(3.9,146037,2,1204,0)=" . . D BULL^RCDPEM1(344.3,RC0,.RCER)"
^XMB(3.9,146037,2,1205,0)="""RTN"",""RCDPEM0"",219,0)"
^XMB(3.9,146037,2,1206,0)=" . . S $P(^TMP($J,""RCDPETOT"",344.3,RCZ),U,4)=+$G(^TMP($J,""RCXM"",0))"
^XMB(3.9,146037,2,1207,0)="""RTN"",""RCDPEM0"",220,0)"
^XMB(3.9,146037,2,1208,0)=" . . D STORERR(344.3,RCZ,.RCER)"
^XMB(3.9,146037,2,1209,0)="""RTN"",""RCDPEM0"",221,0)"
^XMB(3.9,146037,2,1210,0)=" . ;"
^XMB(3.9,146037,2,1211,0)="""RTN"",""RCDPEM0"",222,0)"
^XMB(3.9,146037,2,1212,0)=" . S DIE=""^RCY(344.3,"",DR="".11////^S X=DT;.12////""_$J(+TOT,"""",2),DA=RCZ D ^DIE"
^XMB(3.9,146037,2,1213,0)="""RTN"",""RCDPEM0"",223,0)"
^XMB(3.9,146037,2,1214,0)=" . S ^TMP($J,""RCTOT"",""SUSPAMT"")=$G(^TMP($J,""RCTOT"",""SUSPAMT""))+TOT"
^XMB(3.9,146037,2,1215,0)="""RTN"",""RCDPEM0"",224,0)"
^XMB(3.9,146037,2,1216,0)=" . S $P(^TMP($J,""RCDPETOT"",344.3,RCZ),U,3)=""1"""
^XMB(3.9,146037,2,1217,0)="""RTN"",""RCDPEM0"",225,0)"
^XMB(3.9,146037,2,1218,0)=" ;"
^XMB(3.9,146037,2,1219,0)="""RTN"",""RCDPEM0"",226,0)"
^XMB(3.9,146037,2,1220,0)=" I 'RCLOCK,$G(RECTDA) D  ; couldn't get LOCK send MailMan message and store error"
^XMB(3.9,146037,2,1221,0)="""RTN"",""RCDPEM0"",227,0)"
^XMB(3.9,146037,2,1222,0)=" . N RCBODY,XMINSTR,XMSUBJ,XMTO,XMZ"
^XMB(3.9,146037,2,1223,0)="""RTN"",""RCDPEM0"",228,0)"
^XMB(3.9,146037,2,1224,0)=" . S RCBODY(1)="" > ""_$$FMTE^XLFDT($$NOW^XLFDT,10)"
^XMB(3.9,146037,2,1225,0)="""RTN"",""RCDPEM0"",229,0)"
^XMB(3.9,146037,2,1226,0)=" . S RCBODY(2)=""An exception occurred during Lockbox processing."""
^XMB(3.9,146037,2,1227,0)="""RTN"",""RCDPEM0"",230,0)"
^XMB(3.9,146037,2,1228,0)=" . S RCBODY(3)=""Receipt ""_$P($G(^RCY(344,RECTDA,0)),U)_"" was not processed."""
^XMB(3.9,146037,2,1229,0)="""RTN"",""RCDPEM0"",231,0)"
^XMB(3.9,146037,2,1230,0)=" . S RCBODY(4)=""The ePayments software could not get exclusive access to the entry."""
^XMB(3.9,146037,2,1231,0)="""RTN"",""RCDPEM0"",232,0)"
^XMB(3.9,146037,2,1232,0)=" . S XMSUBJ=""EDI LBOX ""_$$FMTE^XLFDT(DT,10)_"" Receipt Not Processed"""
^XMB(3.9,146037,2,1233,0)="""RTN"",""RCDPEM0"",233,0)"
^XMB(3.9,146037,2,1234,0)=" . S XMTO(""I:G.RCDPE PAYMENTS"")="""",XMTO(DUZ)="""""
^XMB(3.9,146037,2,1235,0)="""RTN"",""RCDPEM0"",234,0)"
^XMB(3.9,146037,2,1236,0)=" . S XMINSTR(""FROM"")=""POSTMASTER"""
^XMB(3.9,146037,2,1237,0)="""RTN"",""RCDPEM0"",235,0)"
^XMB(3.9,146037,2,1238,0)=" . D SENDMSG^XMXAPI(DUZ,XMSUBJ,""RCBODY"",.XMTO,.XMINSTR,.XMZ)"
^XMB(3.9,146037,2,1239,0)="""RTN"",""RCDPEM0"",236,0)"
^XMB(3.9,146037,2,1240,0)=" . I $G(RCZ) D STORERR(344.3,RCZ,.RCBODY)"
^XMB(3.9,146037,2,1241,0)="""RTN"",""RCDPEM0"",237,0)"
^XMB(3.9,146037,2,1242,0)=" ;"
^XMB(3.9,146037,2,1243,0)="""RTN"",""RCDPEM0"",238,0)"
^XMB(3.9,146037,2,1244,0)=" I RCLOCK L -^RCY(344,RECTDA)"
^XMB(3.9,146037,2,1245,0)="""RTN"",""RCDPEM0"",239,0)"
^XMB(3.9,146037,2,1246,0)=" Q $S(RCLOCK:RECTDA,1:0)  ; return new IEN or zero if not processed"
^XMB(3.9,146037,2,1247,0)="""RTN"",""RCDPEM0"",240,0)"
^XMB(3.9,146037,2,1248,0)=" ;"
^XMB(3.9,146037,2,1249,0)="""RTN"",""RCDPEM0"",241,0)"
^XMB(3.9,146037,2,1250,0)="SETERR(RCPROC) ; Set up first line of error message to be stored"
^XMB(3.9,146037,2,1251,0)="""RTN"",""RCDPEM0"",242,0)"
^XMB(3.9,146037,2,1252,0)=" ; RCPROC = 1 if called from EFT-EOB automatch, 0 if from manual match"
^XMB(3.9,146037,2,1253,0)="""RTN"",""RCDPEM0"",243,0)"
^XMB(3.9,146037,2,1254,0)=" ;        = 2 if called from EFT deposit creation"
^XMB(3.9,146037,2,1255,0)="""RTN"",""RCDPEM0"",244,0)"
^XMB(3.9,146037,2,1256,0)=" N LINE1"
^XMB(3.9,146037,2,1257,0)="""RTN"",""RCDPEM0"",245,0)"
^XMB(3.9,146037,2,1258,0)=" I RCPROC S LINE1=$$FMTE^XLFDT($$NOW^XLFDT(),2)_"" - PROCESS TO ""_$S(RCPROC=1:""CREATE RECEIPT FROM ERA"",1:""SEND EFT DEPOSIT TO FMS"")"
^XMB(3.9,146037,2,1259,0)="""RTN"",""RCDPEM0"",246,0)"
^XMB(3.9,146037,2,1260,0)=" Q LINE1"
^XMB(3.9,146037,2,1261,0)="""RTN"",""RCDPEM0"",247,0)"
^XMB(3.9,146037,2,1262,0)=" ;"
^XMB(3.9,146037,2,1263,0)="""RTN"",""RCDPEM0"",248,0)"
^XMB(3.9,146037,2,1264,0)="STORERR(RCFILE,RCZ,RCER) ; Store error text in word processing field"
^XMB(3.9,146037,2,1265,0)="""RTN"",""RCDPEM0"",249,0)"
^XMB(3.9,146037,2,1266,0)=" ; RCFILE = 344.3 or 344.31"
^XMB(3.9,146037,2,1267,0)="""RTN"",""RCDPEM0"",250,0)"
^XMB(3.9,146037,2,1268,0)=" ; RCZ = ien of the entry in file RCFILE"
^XMB(3.9,146037,2,1269,0)="""RTN"",""RCDPEM0"",251,0)"
^XMB(3.9,146037,2,1270,0)=" ; RCER = array containing the error text (passed by ref)"
^XMB(3.9,146037,2,1271,0)="""RTN"",""RCDPEM0"",252,0)"
^XMB(3.9,146037,2,1272,0)=" D WP^DIE(RCFILE,RCZ_"","",2,""A"",""RCER"")"
^XMB(3.9,146037,2,1273,0)="""RTN"",""RCDPEM0"",253,0)"
^XMB(3.9,146037,2,1274,0)=" Q"
^XMB(3.9,146037,2,1275,0)="""RTN"",""RCDPEM0"",254,0)"
^XMB(3.9,146037,2,1276,0)=" ;"
^XMB(3.9,146037,2,1277,0)="""RTN"",""RCDPESR1"")"
^XMB(3.9,146037,2,1278,0)="0^3^B100949554"
^XMB(3.9,146037,2,1279,0)="""RTN"",""RCDPESR1"",1,0)"
^XMB(3.9,146037,2,1280,0)="RCDPESR1 ;ALB/TMP - Server interface to AR from Austin ;Jun 06, 2014@19:11:19"
^XMB(3.9,146037,2,1281,0)="""RTN"",""RCDPESR1"",2,0)"
