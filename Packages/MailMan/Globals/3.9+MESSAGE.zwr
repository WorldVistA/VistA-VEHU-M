^XMB(3.9,146036,2,3360,0)=" S DVBRTN=$G(DVBLIST(1,0))"
^XMB(3.9,146036,2,3361,0)="""RTN"",""DVBUTIL"",125,0)"
^XMB(3.9,146036,2,3362,0)=" I DVBRTN=""ALL"" S DVBDATA=""ALL"""
^XMB(3.9,146036,2,3363,0)="""RTN"",""DVBUTIL"",126,0)"
^XMB(3.9,146036,2,3364,0)=" I DVBRTN=""NONE"" S DVBDATA=0"
^XMB(3.9,146036,2,3365,0)="""RTN"",""DVBUTIL"",127,0)"
^XMB(3.9,146036,2,3366,0)=" I DVBDATA="""" F DVBI=1:1:DVBLEN D"
^XMB(3.9,146036,2,3367,0)="""RTN"",""DVBUTIL"",128,0)"
^XMB(3.9,146036,2,3368,0)=" . S DVBDATA=DVBLEN"
^XMB(3.9,146036,2,3369,0)="""RTN"",""DVBUTIL"",129,0)"
^XMB(3.9,146036,2,3370,0)=" . S DVBSEQ=DVBSEQ+1"
^XMB(3.9,146036,2,3371,0)="""RTN"",""DVBUTIL"",130,0)"
^XMB(3.9,146036,2,3372,0)=" . S DVBDATA(DVBSEQ)=$G(DVBLIST(DVBI,0))"
^XMB(3.9,146036,2,3373,0)="""RTN"",""DVBUTIL"",131,0)"
^XMB(3.9,146036,2,3374,0)=" . Q"
^XMB(3.9,146036,2,3375,0)="""RTN"",""DVBUTIL"",132,0)"
^XMB(3.9,146036,2,3376,0)=" M ^TMP(""DBQLOGIC"",$J)=DVBDATA"
