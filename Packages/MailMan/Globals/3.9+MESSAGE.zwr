^XMB(3.9,146098,2,1125,0)="""RTN"",""SDES2APTLETTER"",241,0)"
^XMB(3.9,146098,2,1126,0)=" ;"
^XMB(3.9,146098,2,1127,0)="""RTN"",""SDES2APTLETTER"",242,0)"
^XMB(3.9,146098,2,1128,0)="BADADD ;Print patients with a Bad Address Indicator"
^XMB(3.9,146098,2,1129,0)="""RTN"",""SDES2APTLETTER"",243,0)"
^XMB(3.9,146098,2,1130,0)=" I '$D(^TMP($J,""BADADD"")) Q"
^XMB(3.9,146098,2,1131,0)="""RTN"",""SDES2APTLETTER"",244,0)"
^XMB(3.9,146098,2,1132,0)=" N SDHDR,SDHDR1,SDNAM,SDDFN"
^XMB(3.9,146098,2,1133,0)="""RTN"",""SDES2APTLETTER"",245,0)"
^XMB(3.9,146098,2,1134,0)=" S SDECI=SDECI+1,^TMP(""SDEC_COMP"",$J,""BadAddress"",SDECI)=$$FILL(79,""*"")"
^XMB(3.9,146098,2,1135,0)="""RTN"",""SDES2APTLETTER"",246,0)"
^XMB(3.9,146098,2,1136,0)=" S SDHDR=""BAD ADDRESS INDICATOR LIST"" S SDECI=SDECI+1,^TMP(""SDEC_COMP"",$J,""BadAddress"",SDECI)=$$FILL((80-$L(SDHDR)/2),"" "")_SDHDR"
^XMB(3.9,146098,2,1137,0)="""RTN"",""SDES2APTLETTER"",247,0)"
^XMB(3.9,146098,2,1138,0)=" S SDHDR1=""** THE LETTER FOR THESE PATIENT(S) DID NOT PRINT DUE TO A BAD ADDRESS INDICATOR."""
^XMB(3.9,146098,2,1139,0)="""RTN"",""SDES2APTLETTER"",248,0)"
^XMB(3.9,146098,2,1140,0)=" S SDECI=SDECI+1,^TMP(""SDEC_COMP"",$J,""BadAddress"",SDECI)=""Last 4"""
^XMB(3.9,146098,2,1141,0)="""RTN"",""SDES2APTLETTER"",249,0)"
^XMB(3.9,146098,2,1142,0)=" S SDECI=SDECI+1,^TMP(""SDEC_COMP"",$J,""BadAddress"",SDECI)=""of SSN   ""_""Patient Name"""
^XMB(3.9,146098,2,1143,0)="""RTN"",""SDES2APTLETTER"",250,0)"
^XMB(3.9,146098,2,1144,0)=" S SDECI=SDECI+1,^TMP(""SDEC_COMP"",$J,""BadAddress"",SDECI)=$$FILL(79,""*"")"
^XMB(3.9,146098,2,1145,0)="""RTN"",""SDES2APTLETTER"",251,0)"
