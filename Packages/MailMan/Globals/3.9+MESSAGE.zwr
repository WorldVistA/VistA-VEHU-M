^XMB(3.9,146047,2,1054,0)=" Q $E($$READ^IBCNBAA(""YA^::E"",""Do you want to Review the CV Y/N? "",""No"",""Enter Yes or No to Review the Coverage Limitations <or> ^ to Quit""))"
^XMB(3.9,146047,2,1055,0)="""RTN"",""IBCNBCD2"",339,0)"
