^XMB(3.9,146043,2,738,0)=" S MDROOT=$NA(^TMP(""MDCLIO"",$J)) K @MDROOT"
^XMB(3.9,146043,2,739,0)="""RTN"",""MDCLIO1"",249,0)"
^XMB(3.9,146043,2,740,0)=" S MDFR=$$FMDT^MDCLIO(P2(1))-.0000001"
^XMB(3.9,146043,2,741,0)="""RTN"",""MDCLIO1"",250,0)"
^XMB(3.9,146043,2,742,0)=" S MDTO=$$FMDT^MDCLIO(P2(2))"
^XMB(3.9,146043,2,743,0)="""RTN"",""MDCLIO1"",251,0)"
^XMB(3.9,146043,2,744,0)=" F  S MDFR=$O(^MDC(704.117,""PT"",MDPT,MDFR)) Q:'MDFR!(MDFR>MDTO)  D"
^XMB(3.9,146043,2,745,0)="""RTN"",""MDCLIO1"",252,0)"
