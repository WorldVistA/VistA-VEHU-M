^XMB(3.9,146011,2,850,0)=" S RESULTS=""PSOPARKX"" D GETPARK^PSORPC01()"
^XMB(3.9,146011,2,851,0)="""RTN"",""PSOHLD"",201,0)"
^XMB(3.9,146011,2,852,0)=" ;PSO*7*780 Do not allow Park when DEA handling contains D"
