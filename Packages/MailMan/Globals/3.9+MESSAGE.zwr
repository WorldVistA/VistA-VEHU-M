^XMB(3.9,146050,2,238,0)=1
^XMB(3.9,146050,2,239,0)="""RTN"",""RAHLO2"")"
^XMB(3.9,146050,2,240,0)="0^1^B26410150"
^XMB(3.9,146050,2,241,0)="""RTN"",""RAHLO2"",1,0)"
^XMB(3.9,146050,2,242,0)="RAHLO2 ;HIRMFO/GJC-File rpt (data from bridge program) ;10 Apr 2019 3:05 PM"
^XMB(3.9,146050,2,243,0)="""RTN"",""RAHLO2"",2,0)"
^XMB(3.9,146050,2,244,0)=" ;;5.0;Radiology/Nuclear Medicine;**55,80,84,144,157**;Mar 16, 1998;Build 0"
^XMB(3.9,146050,2,245,0)="""RTN"",""RAHLO2"",3,0)"
^XMB(3.9,146050,2,246,0)=" ;"
^XMB(3.9,146050,2,247,0)="""RTN"",""RAHLO2"",4,0)"
^XMB(3.9,146050,2,248,0)=" ;Integration Agreements"
^XMB(3.9,146050,2,249,0)="""RTN"",""RAHLO2"",5,0)"
^XMB(3.9,146050,2,250,0)=" ;----------------------"
^XMB(3.9,146050,2,251,0)="""RTN"",""RAHLO2"",6,0)"
^XMB(3.9,146050,2,252,0)=" ;$$FIND1^DIC(2051); UPDATE^DIE(2053); $$DT^XLFDT(10103); $$UP^XLFSTR(10104)"
^XMB(3.9,146050,2,253,0)="""RTN"",""RAHLO2"",7,0)"
^XMB(3.9,146050,2,254,0)=" ;"
^XMB(3.9,146050,2,255,0)="""RTN"",""RAHLO2"",8,0)"
^XMB(3.9,146050,2,256,0)="ADENDUM ; This functions store new lines of text at the end of the existing "
^XMB(3.9,146050,2,257,0)="""RTN"",""RAHLO2"",9,0)"
^XMB(3.9,146050,2,258,0)=" ;impression and report text. If this report is being amended through the"
^XMB(3.9,146050,2,259,0)="""RTN"",""RAHLO2"",10,0)"
^XMB(3.9,146050,2,260,0)=" ;teleradiology service, add the addendum text to the IMPRESSION TEXT (#300)"
^XMB(3.9,146050,2,261,0)="""RTN"",""RAHLO2"",11,0)"
^XMB(3.9,146050,2,262,0)=" ;field only. Note: Only ADENDUM was edited for RA*5.0*84 gjc/09.18.07"
^XMB(3.9,146050,2,263,0)="""RTN"",""RAHLO2"",12,0)"
^XMB(3.9,146050,2,264,0)=" N A,COUNTER,I,J,NODE,ROOT,SUB,X,Y"
^XMB(3.9,146050,2,265,0)="""RTN"",""RAHLO2"",13,0)"
^XMB(3.9,146050,2,266,0)=" ;NODE = ^RARPT(RARPT,""I"" -or- ""R""  -> where the data is to be stored..."
^XMB(3.9,146050,2,267,0)="""RTN"",""RAHLO2"",14,0)"
^XMB(3.9,146050,2,268,0)=" ;ROOT = ^TMP(""RARPT-REC"",$J,RASUB  -> where the addendum data resides..."
^XMB(3.9,146050,2,269,0)="""RTN"",""RAHLO2"",15,0)"
^XMB(3.9,146050,2,270,0)=" F A=""I"",""R"" D  K I,J"
^XMB(3.9,146050,2,271,0)="""RTN"",""RAHLO2"",16,0)"
^XMB(3.9,146050,2,272,0)=" .S SUB=$S(A=""I"":""RAIMP"",1:""RATXT""),ROOT=$NA(^TMP(""RARPT-REC"",$J,RASUB,SUB)) Q:'$O(@ROOT@(0))"
^XMB(3.9,146050,2,273,0)="""RTN"",""RAHLO2"",17,0)"
^XMB(3.9,146050,2,274,0)=" .S NODE=$NA(^RARPT(RARPT,A))"
^XMB(3.9,146050,2,275,0)="""RTN"",""RAHLO2"",18,0)"
^XMB(3.9,146050,2,276,0)=" .S COUNTER=+$O(@NODE@($C(32)),-1) ;last record #"
^XMB(3.9,146050,2,277,0)="""RTN"",""RAHLO2"",19,0)"
^XMB(3.9,146050,2,278,0)=" .;"
^XMB(3.9,146050,2,279,0)="""RTN"",""RAHLO2"",20,0)"
^XMB(3.9,146050,2,280,0)=" .;if there is existing text, add a null line for space."
^XMB(3.9,146050,2,281,0)="""RTN"",""RAHLO2"",21,0)"
^XMB(3.9,146050,2,282,0)=" .I '($D(I)#2),(COUNTER>0) S COUNTER=COUNTER+1,@NODE@(COUNTER,0)=$C(32),I="""""
^XMB(3.9,146050,2,283,0)="""RTN"",""RAHLO2"",22,0)"
^XMB(3.9,146050,2,284,0)=" .;"
^XMB(3.9,146050,2,285,0)="""RTN"",""RAHLO2"",23,0)"
^XMB(3.9,146050,2,286,0)=" .S Y=0 F  S Y=$O(@ROOT@(Y)) Q:'Y  D"
^XMB(3.9,146050,2,287,0)="""RTN"",""RAHLO2"",24,0)"
^XMB(3.9,146050,2,288,0)=" ..S X=@ROOT@(Y)"
^XMB(3.9,146050,2,289,0)="""RTN"",""RAHLO2"",25,0)"
^XMB(3.9,146050,2,290,0)=" ..;if addendum text is to be the original text no spacer is needed ('Addendum:' tag applied)"
^XMB(3.9,146050,2,291,0)="""RTN"",""RAHLO2"",26,0)"
^XMB(3.9,146050,2,292,0)=" ..;if prior report or impression text exist, insert a blank as a spacer"
^XMB(3.9,146050,2,293,0)="""RTN"",""RAHLO2"",27,0)"
^XMB(3.9,146050,2,294,0)=" ..;^RARPT(RARPT,""I"",1,0)=""original impression"""
^XMB(3.9,146050,2,295,0)="""RTN"",""RAHLO2"",28,0)"
^XMB(3.9,146050,2,296,0)=" ..;^RARPT(RARPT,""I"",2,0)="""" <- insert a null line as a spacer"
^XMB(3.9,146050,2,297,0)="""RTN"",""RAHLO2"",29,0)"
^XMB(3.9,146050,2,298,0)=" ..;^RARPT(RARPT,""I"",3,0)=""Addendum: first line of addendum"" ** NOTE 'Addendum:' tag **"
^XMB(3.9,146050,2,299,0)="""RTN"",""RAHLO2"",30,0)"
^XMB(3.9,146050,2,300,0)=" ..;^RARPT(RARPT,""I"",4,0)=""second line of addendum"""
^XMB(3.9,146050,2,301,0)="""RTN"",""RAHLO2"",31,0)"
^XMB(3.9,146050,2,302,0)=" ..;..."
^XMB(3.9,146050,2,303,0)="""RTN"",""RAHLO2"",32,0)"
^XMB(3.9,146050,2,304,0)=" ..;^RARPT(RARPT,""I"",N,0)=""Nth and last line of addendum"""
^XMB(3.9,146050,2,305,0)="""RTN"",""RAHLO2"",33,0)"
^XMB(3.9,146050,2,306,0)=" ..S COUNTER=COUNTER+1"
^XMB(3.9,146050,2,307,0)="""RTN"",""RAHLO2"",34,0)"
^XMB(3.9,146050,2,308,0)=" ..;set the first line of the addendum w/header: 'Addendum: '"
^XMB(3.9,146050,2,309,0)="""RTN"",""RAHLO2"",35,0)"
^XMB(3.9,146050,2,310,0)=" ..I '($D(J)#2) S X=""Addendum: ""_X,J="""""
^XMB(3.9,146050,2,311,0)="""RTN"",""RAHLO2"",36,0)"
^XMB(3.9,146050,2,312,0)=" ..S @NODE@(COUNTER,0)=X"
^XMB(3.9,146050,2,313,0)="""RTN"",""RAHLO2"",37,0)"
^XMB(3.9,146050,2,314,0)=" ..Q"
^XMB(3.9,146050,2,315,0)="""RTN"",""RAHLO2"",38,0)"
^XMB(3.9,146050,2,316,0)=" .S @NODE@(0)=""^^""_COUNTER_""^""_COUNTER_""^""_$$DT^XLFDT()"
^XMB(3.9,146050,2,317,0)="""RTN"",""RAHLO2"",39,0)"
^XMB(3.9,146050,2,318,0)=" .Q"
^XMB(3.9,146050,2,319,0)="""RTN"",""RAHLO2"",40,0)"
^XMB(3.9,146050,2,320,0)=" Q"
^XMB(3.9,146050,2,321,0)="""RTN"",""RAHLO2"",41,0)"
^XMB(3.9,146050,2,322,0)=" ;"
^XMB(3.9,146050,2,323,0)="""RTN"",""RAHLO2"",42,0)"
^XMB(3.9,146050,2,324,0)="ERR(A) ; Invalid impression/report text message."
^XMB(3.9,146050,2,325,0)="""RTN"",""RAHLO2"",43,0)"
^XMB(3.9,146050,2,326,0)=" ; Input: 'A' - either ""I"" for impression, or ""R"" for report"
^XMB(3.9,146050,2,327,0)="""RTN"",""RAHLO2"",44,0)"
^XMB(3.9,146050,2,328,0)=" ; Output: the appropriate error message"
^XMB(3.9,146050,2,329,0)="""RTN"",""RAHLO2"",45,0)"
^XMB(3.9,146050,2,330,0)=" Q ""Invalid ""_$S(A=""I"":""Impression"",1:""Report"")_"" Text"""
^XMB(3.9,146050,2,331,0)="""RTN"",""RAHLO2"",46,0)"
^XMB(3.9,146050,2,332,0)=" ;"
^XMB(3.9,146050,2,333,0)="""RTN"",""RAHLO2"",47,0)"
^XMB(3.9,146050,2,334,0)="DIAG ; Check if the Diagnostic Codes passed are valid.  Set RADX equal"
^XMB(3.9,146050,2,335,0)="""RTN"",""RAHLO2"",48,0)"
^XMB(3.9,146050,2,336,0)=" ; to primary Dx code pntr value.  Set RASECDX(x) to the secondary"
^XMB(3.9,146050,2,337,0)="""RTN"",""RAHLO2"",49,0)"
^XMB(3.9,146050,2,338,0)=" ; Dx code(s) if any."
^XMB(3.9,146050,2,339,0)="""RTN"",""RAHLO2"",50,0)"
^XMB(3.9,146050,2,340,0)=" N RAXFIRST"
^XMB(3.9,146050,2,341,0)="""RTN"",""RAHLO2"",51,0)"
^XMB(3.9,146050,2,342,0)=" S I=0,RAXFIRST=1"
^XMB(3.9,146050,2,343,0)="""RTN"",""RAHLO2"",52,0)"
^XMB(3.9,146050,2,344,0)=" K RASECDX"
^XMB(3.9,146050,2,345,0)="""RTN"",""RAHLO2"",53,0)"
^XMB(3.9,146050,2,346,0)=" ; KLM/p157 Check for primary designation and save position."
^XMB(3.9,146050,2,347,0)="""RTN"",""RAHLO2"",54,0)"
^XMB(3.9,146050,2,348,0)=" I $D(^TMP(""RARPT-REC"",$J,RASUB,""RADX"",""PDX"")) S RAPRIM=$O(^TMP(""RARPT-REC"",$J,RASUB,""RADX"",""PDX"",0))"
^XMB(3.9,146050,2,349,0)="""RTN"",""RAHLO2"",55,0)"
^XMB(3.9,146050,2,350,0)=" I $G(RAPRIM)>0 S RAXFIRST=0 ;if primary designation, don't need RAXFIRST"
^XMB(3.9,146050,2,351,0)="""RTN"",""RAHLO2"",56,0)"
^XMB(3.9,146050,2,352,0)=" F  S I=$O(^TMP(""RARPT-REC"",$J,RASUB,""RADX"",I)) Q:I'>0  D  Q:$D(RAERR)"
^XMB(3.9,146050,2,353,0)="""RTN"",""RAHLO2"",57,0)"
^XMB(3.9,146050,2,354,0)=" . S RADIAG=$G(^TMP(""RARPT-REC"",$J,RASUB,""RADX"",I))"
^XMB(3.9,146050,2,355,0)="""RTN"",""RAHLO2"",58,0)"
^XMB(3.9,146050,2,356,0)=" . ;S:RADIAG']"""" RAERR=""Missing Diagnostic Code"" Q:$D(RAERR)"
^XMB(3.9,146050,2,357,0)="""RTN"",""RAHLO2"",59,0)"
^XMB(3.9,146050,2,358,0)=" . Q:RADIAG']""""  ;Missing Diagnostic Code  Patch 80"
^XMB(3.9,146050,2,359,0)="""RTN"",""RAHLO2"",60,0)"
^XMB(3.9,146050,2,360,0)=" . ; If RADXIEN is a number, set RADXIEN to what is assumed to be a"
^XMB(3.9,146050,2,361,0)="""RTN"",""RAHLO2"",61,0)"
^XMB(3.9,146050,2,362,0)=" . ; valid pointer (ien) for file 78.3"
^XMB(3.9,146050,2,363,0)="""RTN"",""RAHLO2"",62,0)"
^XMB(3.9,146050,2,364,0)=" . I +RADIAG=RADIAG S RADXIEN=RADIAG"
^XMB(3.9,146050,2,365,0)="""RTN"",""RAHLO2"",63,0)"
^XMB(3.9,146050,2,366,0)=" . ; If RADIAG is in a free text format, convert the external value"
^XMB(3.9,146050,2,367,0)="""RTN"",""RAHLO2"",64,0)"
^XMB(3.9,146050,2,368,0)=" . ; into the ien for file 78.3"
^XMB(3.9,146050,2,369,0)="""RTN"",""RAHLO2"",65,0)"
^XMB(3.9,146050,2,370,0)=" . I +RADIAG'=RADIAG S RADXIEN=$$FIND1^DIC(78.3,"""",""X"",RADIAG)"
^XMB(3.9,146050,2,371,0)="""RTN"",""RAHLO2"",66,0)"
^XMB(3.9,146050,2,372,0)=" . I '$D(^RA(78.3,RADXIEN,0)) S RAERR=""Invalid Diagnostic Code"" Q"
^XMB(3.9,146050,2,373,0)="""RTN"",""RAHLO2"",67,0)"
^XMB(3.9,146050,2,374,0)=" . ;KLM/p144 Reject inactive DX codes"
^XMB(3.9,146050,2,375,0)="""RTN"",""RAHLO2"",68,0)"
^XMB(3.9,146050,2,376,0)=" . I $P(^RA(78.3,RADXIEN,0),U,5)=""Y"" S RAERR=""Inactive Diagnostic Code: ""_RADXIEN Q"
^XMB(3.9,146050,2,377,0)="""RTN"",""RAHLO2"",69,0)"
^XMB(3.9,146050,2,378,0)=" . ;p157 Primary may not be the first entry.. check if RAPRIM is the same as count."
^XMB(3.9,146050,2,379,0)="""RTN"",""RAHLO2"",70,0)"
^XMB(3.9,146050,2,380,0)=" . I RAXFIRST!($G(RAPRIM)=I) S RADX=RADXIEN,RAXFIRST=0 Q  ; RADX=pri. Dx Code"
^XMB(3.9,146050,2,381,0)="""RTN"",""RAHLO2"",71,0)"
^XMB(3.9,146050,2,382,0)=" . ; are any of the sec. Dx codes equal to our pri. Dx code?"
^XMB(3.9,146050,2,383,0)="""RTN"",""RAHLO2"",72,0)"
^XMB(3.9,146050,2,384,0)=" . ;S:RADXIEN=RADX RAERR=""Secondary Dx codes must differ from the primary Dx code."" Q:$D(RAERR)"
^XMB(3.9,146050,2,385,0)="""RTN"",""RAHLO2"",73,0)"
^XMB(3.9,146050,2,386,0)=" . Q:RADXIEN=$G(RADX)  ;Secondary Dx codes must differ from the primary Dx code  Patch 80"
^XMB(3.9,146050,2,387,0)="""RTN"",""RAHLO2"",74,0)"
^XMB(3.9,146050,2,388,0)=" . ;S:$D(RASECDX(RADXIEN))#2 RAERR=""Duplicate secondary Dx codes."" Q:$D(RAERR)"
^XMB(3.9,146050,2,389,0)="""RTN"",""RAHLO2"",75,0)"
^XMB(3.9,146050,2,390,0)=" . Q:$D(RASECDX(RADXIEN))#2  ;Duplicate secondary Dx codes. Patch 80"
^XMB(3.9,146050,2,391,0)="""RTN"",""RAHLO2"",76,0)"
^XMB(3.9,146050,2,392,0)=" . S RASECDX(RADXIEN)="""" ; set the sec. Dx array"
^XMB(3.9,146050,2,393,0)="""RTN"",""RAHLO2"",77,0)"
^XMB(3.9,146050,2,394,0)=" . Q"
^XMB(3.9,146050,2,395,0)="""RTN"",""RAHLO2"",78,0)"
^XMB(3.9,146050,2,396,0)=" K I,RADIAG,RADXIEN"
^XMB(3.9,146050,2,397,0)="""RTN"",""RAHLO2"",79,0)"
^XMB(3.9,146050,2,398,0)=" Q"
^XMB(3.9,146050,2,399,0)="""RTN"",""RAHLO2"",80,0)"
^XMB(3.9,146050,2,400,0)="SECDX ; Kill old sec. Dx nodes, and add the new ones into the 70.14 multiple"
^XMB(3.9,146050,2,401,0)="""RTN"",""RAHLO2"",81,0)"
^XMB(3.9,146050,2,402,0)=" ; called from RAHLO.  Needs RADFN,RADTI & RACNI to function."
^XMB(3.9,146050,2,403,0)="""RTN"",""RAHLO2"",82,0)"
^XMB(3.9,146050,2,404,0)=" Q:'$D(RADFN)!('$D(RADTI))!('$D(RACNI))"
^XMB(3.9,146050,2,405,0)="""RTN"",""RAHLO2"",83,0)"
^XMB(3.9,146050,2,406,0)=" I $O(^RADPT(RADFN,""DT"",RADTI,""P"",RACNI,""DX"",0)) D KILSECDG^RAHLO4"
^XMB(3.9,146050,2,407,0)="""RTN"",""RAHLO2"",84,0)"
^XMB(3.9,146050,2,408,0)=" ;K RAFDA N RAX S RAX=0,RAFDA(70,""?1,"",.01)=RADFN"
^XMB(3.9,146050,2,409,0)="""RTN"",""RAHLO2"",85,0)"
^XMB(3.9,146050,2,410,0)=" ;S RAFDA(70.02,""?2,?1,"",.01)=(9999999.9999-RADTI)"
^XMB(3.9,146050,2,411,0)="""RTN"",""RAHLO2"",86,0)"
^XMB(3.9,146050,2,412,0)=" ;S RAFDA(70.03,""?3,?2,?1,"",.01)=$P($G(^RADPT(RADFN,""DT"",RADTI,""P"",RACNI,0)),""^"")"
^XMB(3.9,146050,2,413,0)="""RTN"",""RAHLO2"",87,0)"
^XMB(3.9,146050,2,414,0)=" ;F  S RAX=$O(RASECDX(RAX)) Q:RAX'>0  D"
^XMB(3.9,146050,2,415,0)="""RTN"",""RAHLO2"",88,0)"
^XMB(3.9,146050,2,416,0)=" ;. S RAFDA(70.14,""?""_RAX_""9,?3,?2,?1,"",.01)=RAX"
^XMB(3.9,146050,2,417,0)="""RTN"",""RAHLO2"",89,0)"
^XMB(3.9,146050,2,418,0)=" ;. Q"
^XMB(3.9,146050,2,419,0)="""RTN"",""RAHLO2"",90,0)"
^XMB(3.9,146050,2,420,0)=" ;D UPDATE^DIE("""",""RAFDA"",,""RAERR"")"
^XMB(3.9,146050,2,421,0)="""RTN"",""RAHLO2"",91,0)"
^XMB(3.9,146050,2,422,0)=" ;I $D(RAERR) M ^TMP(""ERR"")=RAERR"
^XMB(3.9,146050,2,423,0)="""RTN"",""RAHLO2"",92,0)"
^XMB(3.9,146050,2,424,0)=" ;"
^XMB(3.9,146050,2,425,0)="""RTN"",""RAHLO2"",93,0)"
^XMB(3.9,146050,2,426,0)=" N RAX S RAX=0"
^XMB(3.9,146050,2,427,0)="""RTN"",""RAHLO2"",94,0)"
^XMB(3.9,146050,2,428,0)=" N RAFDA,RA2"
^XMB(3.9,146050,2,429,0)="""RTN"",""RAHLO2"",95,0)"
^XMB(3.9,146050,2,430,0)=" K RAFDA"
^XMB(3.9,146050,2,431,0)="""RTN"",""RAHLO2"",96,0)"
^XMB(3.9,146050,2,432,0)=" ; K ^TMP(""RAERR"",$J)"
^XMB(3.9,146050,2,433,0)="""RTN"",""RAHLO2"",97,0)"
^XMB(3.9,146050,2,434,0)=" S RA2=RACNI_"",""_RADTI_"",""_RADFN"
^XMB(3.9,146050,2,435,0)="""RTN"",""RAHLO2"",98,0)"
^XMB(3.9,146050,2,436,0)=" F  S RAX=$O(RASECDX(RAX)) Q:RAX'>0  D"
^XMB(3.9,146050,2,437,0)="""RTN"",""RAHLO2"",99,0)"
^XMB(3.9,146050,2,438,0)=" . S RAFDA(70.14,""?+""_RAX_""9,""_RA2_"","",.01)=RAX"
^XMB(3.9,146050,2,439,0)="""RTN"",""RAHLO2"",100,0)"
^XMB(3.9,146050,2,440,0)=" D UPDATE^DIE("""",""RAFDA"",,""RAERR"")"
^XMB(3.9,146050,2,441,0)="""RTN"",""RAHLO2"",101,0)"
^XMB(3.9,146050,2,442,0)=" ; I $D(RAERR) M ^TMP(""RAERR"",$J)=RAERR"
^XMB(3.9,146050,2,443,0)="""RTN"",""RAHLO2"",102,0)"
^XMB(3.9,146050,2,444,0)=" ;"
^XMB(3.9,146050,2,445,0)="""RTN"",""RAHLO2"",103,0)"
^XMB(3.9,146050,2,446,0)=" Q"
^XMB(3.9,146050,2,447,0)="""RTN"",""RAHLO2"",104,0)"
^XMB(3.9,146050,2,448,0)="IMPTXT ; Check if the impression text consists only of the string"
^XMB(3.9,146050,2,449,0)="""RTN"",""RAHLO2"",105,0)"
^XMB(3.9,146050,2,450,0)=" ; 'impression:"".  If 'impression:' is the only set of characters,"
^XMB(3.9,146050,2,451,0)="""RTN"",""RAHLO2"",106,0)"
^XMB(3.9,146050,2,452,0)=" ; (spaces are excluded) then delete the ""RAIMP"" node."
^XMB(3.9,146050,2,453,0)="""RTN"",""RAHLO2"",107,0)"
^XMB(3.9,146050,2,454,0)=" N RA1 S RA1=$O(^TMP(""RARPT-REC"",$J,RASUB,""RAIMP"",0))"
^XMB(3.9,146050,2,455,0)="""RTN"",""RAHLO2"",108,0)"
^XMB(3.9,146050,2,456,0)=" Q:'RA1  N RAIMP S RAIMP=$G(^TMP(""RARPT-REC"",$J,RASUB,""RAIMP"",RA1))"
^XMB(3.9,146050,2,457,0)="""RTN"",""RAHLO2"",109,0)"
^XMB(3.9,146050,2,458,0)=" I $$UP^XLFSTR($E(RAIMP,1,11))=""IMPRESSION:"" D"
^XMB(3.9,146050,2,459,0)="""RTN"",""RAHLO2"",110,0)"
^XMB(3.9,146050,2,460,0)=" . S $E(RAIMP,1,11)="""" ; strip out 'impression:' if it is the first"
^XMB(3.9,146050,2,461,0)="""RTN"",""RAHLO2"",111,0)"
^XMB(3.9,146050,2,462,0)=" . ;                     eleven chars of the impression text"
^XMB(3.9,146050,2,463,0)="""RTN"",""RAHLO2"",112,0)"
^XMB(3.9,146050,2,464,0)=" . ; now strip off leading spaces from the remaining"
^XMB(3.9,146050,2,465,0)="""RTN"",""RAHLO2"",113,0)"
^XMB(3.9,146050,2,466,0)=" . ; text that led with 'impression:' if present"
^XMB(3.9,146050,2,467,0)="""RTN"",""RAHLO2"",114,0)"
^XMB(3.9,146050,2,468,0)=" . F I1=1:1 S:$E(RAIMP,I1)'="" "" RAIMP=$E(RAIMP,I1,99999) Q:$E(RAIMP)'="" """
^XMB(3.9,146050,2,469,0)="""RTN"",""RAHLO2"",115,0)"
^XMB(3.9,146050,2,470,0)=" . S ^TMP(""RARPT-REC"",$J,RASUB,""RAIMP"",RA1)=RAIMP"
^XMB(3.9,146050,2,471,0)="""RTN"",""RAHLO2"",116,0)"
^XMB(3.9,146050,2,472,0)=" . Q"
^XMB(3.9,146050,2,473,0)="""RTN"",""RAHLO2"",117,0)"
^XMB(3.9,146050,2,474,0)=" Q:$O(^TMP(""RARPT-REC"",$J,RASUB,""RAIMP"",RA1))  ; more imp. text follows"
^XMB(3.9,146050,2,475,0)="""RTN"",""RAHLO2"",118,0)"
^XMB(3.9,146050,2,476,0)=" K:$G(^TMP(""RARPT-REC"",$J,RASUB,""RAIMP"",RA1))="""" ^TMP(""RARPT-REC"",$J,RASUB,""RAIMP"",RA1) ; if only ""RAIMP"" node null, delete ""RAIMP"" node"
^XMB(3.9,146050,2,477,0)="""RTN"",""RAHLO2"",119,0)"
^XMB(3.9,146050,2,478,0)=" Q"
^XMB(3.9,146050,2,479,0)="""VER"")"
^XMB(3.9,146050,2,480,0)="8.0^22.2"
^XMB(3.9,146050,2,481,0)="$END KID RA*5.0*230b"
