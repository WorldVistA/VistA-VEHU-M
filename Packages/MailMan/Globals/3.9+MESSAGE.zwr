^XMB(3.9,146055,2,312,0)=" ;"
^XMB(3.9,146055,2,313,0)="""RTN"",""PSOSUCH1"",36,0)"
^XMB(3.9,146055,2,314,0)="NEXT S PSOX(""IRXN"")=RXREC D NEXT^PSOUTIL(.PSOX) S NEXT=$P(PSOX(""RX3""),""^"",2),DA=RXREC,DIE=52,DR=""102///""_NEXT D ^DIE K DIE Q:$D(DTOUT)!($D(DUOUT))"
