^XMB(3.9,146103,2,189,0)="""QUES"",""XPI1"",""??"")"
^XMB(3.9,146103,2,190,0)="^D INHIBIT^XPDH"
^XMB(3.9,146103,2,191,0)="""QUES"",""XPI1"",""A"")"
^XMB(3.9,146103,2,192,0)="Want KIDS to INHIBIT LOGONs during the install"
