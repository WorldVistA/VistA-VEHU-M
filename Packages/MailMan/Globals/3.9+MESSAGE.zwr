^XMB(3.9,146056,2,1525,0)="""RTN"",""VPREVNT"",136,0)"
^XMB(3.9,146056,2,1526,0)=" ;"
^XMB(3.9,146056,2,1527,0)="""RTN"",""VPREVNT"",137,0)"
^XMB(3.9,146056,2,1528,0)="CP(DFN,ID,ACT) ; -- CP Transaction file #702 AVPR index"
^XMB(3.9,146056,2,1529,0)="""RTN"",""VPREVNT"",138,0)"
^XMB(3.9,146056,2,1530,0)=" Q  ; via VPRPROC [no longer used]"
^XMB(3.9,146056,2,1531,0)="""RTN"",""VPREVNT"",139,0)"
^XMB(3.9,146056,2,1532,0)=" S DFN=+$G(DFN),ID=+$G(ID)"
^XMB(3.9,146056,2,1533,0)="""RTN"",""VPREVNT"",140,0)"
^XMB(3.9,146056,2,1534,0)=" N VST S VST=$$GET1^DIQ(702,ID,"".06:.03"",""I"")"
^XMB(3.9,146056,2,1535,0)="""RTN"",""VPREVNT"",141,0)"
^XMB(3.9,146056,2,1536,0)=" D POST^VPRHS(DFN,""Procedure"",ID_"";702"",$G(ACT),VST)"
^XMB(3.9,146056,2,1537,0)="""RTN"",""VPREVNT"",142,0)"
^XMB(3.9,146056,2,1538,0)=" Q"
^XMB(3.9,146056,2,1539,0)="""RTN"",""VPREVNT"",143,0)"
^XMB(3.9,146056,2,1540,0)=" ;"
^XMB(3.9,146056,2,1541,0)="""RTN"",""VPREVNT"",144,0)"
^XMB(3.9,146056,2,1542,0)="TIU(DFN,IEN) ; -- TIU Document file #8925 AEVT index"
^XMB(3.9,146056,2,1543,0)="""RTN"",""VPREVNT"",145,0)"
^XMB(3.9,146056,2,1544,0)=" ;    [expects X, X1, X2 arrays from FM]"
^XMB(3.9,146056,2,1545,0)="""RTN"",""VPREVNT"",146,0)"
^XMB(3.9,146056,2,1546,0)=" N STS,DAD,ACT"
^XMB(3.9,146056,2,1547,0)="""RTN"",""VPREVNT"",147,0)"
^XMB(3.9,146056,2,1548,0)=" S DFN=+$G(DFN),IEN=+$G(IEN) Q:DFN<1  Q:IEN<1"
^XMB(3.9,146056,2,1549,0)="""RTN"",""VPREVNT"",148,0)"
^XMB(3.9,146056,2,1550,0)=" S STS=$G(X(2)),DAD=$G(X(3)) ;X = FM data array for index"
^XMB(3.9,146056,2,1551,0)="""RTN"",""VPREVNT"",149,0)"
^XMB(3.9,146056,2,1552,0)=" I STS<7 Q                   ;not complete"
^XMB(3.9,146056,2,1553,0)="""RTN"",""VPREVNT"",150,0)"
^XMB(3.9,146056,2,1554,0)=" I STS=9 Q                   ;archived, leave in cache unchanged"
^XMB(3.9,146056,2,1555,0)="""RTN"",""VPREVNT"",151,0)"
^XMB(3.9,146056,2,1556,0)=" I STS>13 Q                  ;removed, handled via protocol"
^XMB(3.9,146056,2,1557,0)="""RTN"",""VPREVNT"",152,0)"
^XMB(3.9,146056,2,1558,0)=" S:DAD IEN=DAD               ;if addendum, repull entire note"
^XMB(3.9,146056,2,1559,0)="""RTN"",""VPREVNT"",153,0)"
^XMB(3.9,146056,2,1560,0)=" S ACT=$S(X2(2)&(X1(2)=""""):1,X1&(X2=""""):""@"",1:"""") ;add/remove amendment"
^XMB(3.9,146056,2,1561,0)="""RTN"",""VPREVNT"",154,0)"
^XMB(3.9,146056,2,1562,0)=" D TIU^VPRENC(IEN,ACT)       ;add to ^XTMP(""VPRPX"") encounter list"
^XMB(3.9,146056,2,1563,0)="""RTN"",""VPREVNT"",155,0)"
^XMB(3.9,146056,2,1564,0)=" Q"
^XMB(3.9,146056,2,1565,0)="""RTN"",""VPREVNT"",156,0)"
^XMB(3.9,146056,2,1566,0)=" ;"
^XMB(3.9,146056,2,1567,0)="""RTN"",""VPREVNT"",157,0)"
^XMB(3.9,146056,2,1568,0)="TIUR ; -- TIU DOCUMENT ACTION EVENT listener (removing notes)"
^XMB(3.9,146056,2,1569,0)="""RTN"",""VPREVNT"",158,0)"
^XMB(3.9,146056,2,1570,0)=" N ARY,ACT,DFN,IEN,VST,DAD,X,VPRSQ,CLS"
^XMB(3.9,146056,2,1571,0)="""RTN"",""VPREVNT"",159,0)"
^XMB(3.9,146056,2,1572,0)=" S ARY=$NA(^TMP(""TIUDOCACT"",$J)),ACT=$G(@ARY@(""ACTION""))"
^XMB(3.9,146056,2,1573,0)="""RTN"",""VPREVNT"",160,0)"
^XMB(3.9,146056,2,1574,0)=" I ACT=""RETRACT"" D  Q:IEN<1  G TRQ  ;not DELETE"
^XMB(3.9,146056,2,1575,0)="""RTN"",""VPREVNT"",161,0)"
^XMB(3.9,146056,2,1576,0)=" . S DFN=+$G(@ARY@(""PATIENT"")),VST=$G(@ARY@(""VISIT""))"
^XMB(3.9,146056,2,1577,0)="""RTN"",""VPREVNT"",162,0)"
^XMB(3.9,146056,2,1578,0)=" . S IEN=+$G(@ARY@(""DOCUMENT"")) Q:IEN<1  Q:DFN<1"
^XMB(3.9,146056,2,1579,0)="""RTN"",""VPREVNT"",163,0)"
^XMB(3.9,146056,2,1580,0)=" . S DAD=+$$GET1^DIQ(8925,IEN,.06,""I"") Q:'DAD"
^XMB(3.9,146056,2,1581,0)="""RTN"",""VPREVNT"",164,0)"
^XMB(3.9,146056,2,1582,0)=" . ; update parent unless already retracted"
^XMB(3.9,146056,2,1583,0)="""RTN"",""VPREVNT"",165,0)"
^XMB(3.9,146056,2,1584,0)=" . S IEN=$S($$GET1^DIQ(8925,DAD,.05,""I"")=15:0,1:DAD)"
^XMB(3.9,146056,2,1585,0)="""RTN"",""VPREVNT"",166,0)"
^XMB(3.9,146056,2,1586,0)=" ;"
^XMB(3.9,146056,2,1587,0)="""RTN"",""VPREVNT"",167,0)"
^XMB(3.9,146056,2,1588,0)=" Q:ACT'=""REASSIGN"""
^XMB(3.9,146056,2,1589,0)="""RTN"",""VPREVNT"",168,0)"
^XMB(3.9,146056,2,1590,0)=" S DFN=+$G(@ARY@(""PATIENT"",""OLD"")),VST=$G(@ARY@(""VISIT"",""OLD""))"
^XMB(3.9,146056,2,1591,0)="""RTN"",""VPREVNT"",169,0)"
^XMB(3.9,146056,2,1592,0)=" S IEN=+$G(@ARY@(""DOCUMENT"",""OLD"")) ;DA in NEW if patient unchanged"
^XMB(3.9,146056,2,1593,0)="""RTN"",""VPREVNT"",170,0)"
^XMB(3.9,146056,2,1594,0)=" S:IEN<1 IEN=+$G(@ARY@(""DOCUMENT"",""NEW"")) Q:IEN<1  Q:DFN<1"
^XMB(3.9,146056,2,1595,0)="""RTN"",""VPREVNT"",171,0)"
^XMB(3.9,146056,2,1596,0)=" S DAD=+$$GET1^DIQ(8925,IEN,.06,""I"") I DAD D TIU^VPRENC(DAD) Q"
^XMB(3.9,146056,2,1597,0)="""RTN"",""VPREVNT"",172,0)"
^XMB(3.9,146056,2,1598,0)=" ; new document saved via regular index event"
^XMB(3.9,146056,2,1599,0)="""RTN"",""VPREVNT"",173,0)"
^XMB(3.9,146056,2,1600,0)="TRQ ; remove document from old patient/visit"
^XMB(3.9,146056,2,1601,0)="""RTN"",""VPREVNT"",174,0)"
^XMB(3.9,146056,2,1602,0)=" S ACT=$S($G(DAD):"""",1:""@"") ;update parent if retracting addendum"
^XMB(3.9,146056,2,1603,0)="""RTN"",""VPREVNT"",175,0)"
^XMB(3.9,146056,2,1604,0)=" D POST^VPRHS(DFN,""Document"",IEN_"";8925"",ACT,VST,.VPRSQ)"
^XMB(3.9,146056,2,1605,0)="""RTN"",""VPREVNT"",176,0)"
^XMB(3.9,146056,2,1606,0)=" I ACT=""@"",$G(VPRSQ) D  ;save visit"
^XMB(3.9,146056,2,1607,0)="""RTN"",""VPREVNT"",177,0)"
^XMB(3.9,146056,2,1608,0)=" . S ^XTMP(""VPR-""_VPRSQ,IEN)=DFN_""^Document^""_IEN_"";8925^D^""_VST"
^XMB(3.9,146056,2,1609,0)="""RTN"",""VPREVNT"",178,0)"
^XMB(3.9,146056,2,1610,0)=" . S X=+$$GET1^DIQ(8925,IEN,.01,""I""),^XTMP(""VPR-""_VPRSQ,IEN,0)=X_U_DFN_U_VST"
^XMB(3.9,146056,2,1611,0)="""RTN"",""VPREVNT"",179,0)"
^XMB(3.9,146056,2,1612,0)=" . S ^XTMP(""VPR-""_VPRSQ,0)=$$FMADD^XLFDT(DT,14)_U_DT_""^Deleted record for AVPR"""
^XMB(3.9,146056,2,1613,0)="""RTN"",""VPREVNT"",180,0)"
^XMB(3.9,146056,2,1614,0)=" S CLS=$$GET1^DIQ(8925,IEN,.04,""I"")"
^XMB(3.9,146056,2,1615,0)="""RTN"",""VPREVNT"",181,0)"
^XMB(3.9,146056,2,1616,0)=" D:CLS=27 POST^VPRHS(DFN,""AdvanceDirective"",IEN_"";8925"",ACT)"
^XMB(3.9,146056,2,1617,0)="""RTN"",""VPREVNT"",182,0)"
^XMB(3.9,146056,2,1618,0)=" D:CLS=30!(CLS=31) POST^VPRHS(DFN,""Alert"",IEN_"";8925"",ACT)"
^XMB(3.9,146056,2,1619,0)="""RTN"",""VPREVNT"",183,0)"
^XMB(3.9,146056,2,1620,0)=" Q"
^XMB(3.9,146056,2,1621,0)="""RTN"",""VPREVNT"",184,0)"
^XMB(3.9,146056,2,1622,0)=" ;"
^XMB(3.9,146056,2,1623,0)="""RTN"",""VPREVNT"",185,0)"
^XMB(3.9,146056,2,1624,0)="TIUS(IEN) ; -- TIU MULTIPLE SIGNATURE file #8925.7 AVPR index"
^XMB(3.9,146056,2,1625,0)="""RTN"",""VPREVNT"",186,0)"
^XMB(3.9,146056,2,1626,0)=" S IEN=+$G(IEN) Q:IEN<1"
^XMB(3.9,146056,2,1627,0)="""RTN"",""VPREVNT"",187,0)"
^XMB(3.9,146056,2,1628,0)=" N TIU0,TIUIEN,DFN,VST"
^XMB(3.9,146056,2,1629,0)="""RTN"",""VPREVNT"",188,0)"
^XMB(3.9,146056,2,1630,0)=" S TIU0=$G(^TIU(8925.7,IEN,0)),TIUIEN=+$P(TIU0,U) Q:TIUIEN<1"
^XMB(3.9,146056,2,1631,0)="""RTN"",""VPREVNT"",189,0)"
^XMB(3.9,146056,2,1632,0)=" S DFN=$$GET1^DIQ(8925,TIUIEN,.02,""I"") Q:DFN<1"
^XMB(3.9,146056,2,1633,0)="""RTN"",""VPREVNT"",190,0)"
^XMB(3.9,146056,2,1634,0)=" S VST=$$GET1^DIQ(8925,TIUIEN,.03,""I"") ;Ok if null"
^XMB(3.9,146056,2,1635,0)="""RTN"",""VPREVNT"",191,0)"
^XMB(3.9,146056,2,1636,0)=" ; non-PCE event so post immediately for BMS"
^XMB(3.9,146056,2,1637,0)="""RTN"",""VPREVNT"",192,0)"
^XMB(3.9,146056,2,1638,0)=" D POST^VPRHS(DFN,""Document"",TIUIEN_"";8925"",,VST)"
^XMB(3.9,146056,2,1639,0)="""RTN"",""VPREVNT"",193,0)"
^XMB(3.9,146056,2,1640,0)=" Q"
^XMB(3.9,146056,2,1641,0)="""RTN"",""VPREVNT"",194,0)"
^XMB(3.9,146056,2,1642,0)=" ;"
^XMB(3.9,146056,2,1643,0)="""RTN"",""VPREVNT"",195,0)"
^XMB(3.9,146056,2,1644,0)="IBCN ; -- IBCN NEW INSURANCE EVENTS listener"
^XMB(3.9,146056,2,1645,0)="""RTN"",""VPREVNT"",196,0)"
^XMB(3.9,146056,2,1646,0)=" ; expects IBCDFN, IBEVTACT=""ADD"",""EDT"", or ""DEL"""
^XMB(3.9,146056,2,1647,0)="""RTN"",""VPREVNT"",197,0)"
^XMB(3.9,146056,2,1648,0)=" I '$G(IBCDFN) Q"
^XMB(3.9,146056,2,1649,0)="""RTN"",""VPREVNT"",198,0)"
^XMB(3.9,146056,2,1650,0)=" N ACT,ID,VPRSQ,I S ID=IBCDFN_"",""_DFN"
^XMB(3.9,146056,2,1651,0)="""RTN"",""VPREVNT"",199,0)"
^XMB(3.9,146056,2,1652,0)=" S ACT=$S($G(IBEVTACT)=""DEL"":""@"",$G(IBEVTACT)=""ADD"":"""",1:$$IBDIFF)"
^XMB(3.9,146056,2,1653,0)="""RTN"",""VPREVNT"",200,0)"
^XMB(3.9,146056,2,1654,0)=" D POST^VPRHS(DFN,""MemberEnrollment"",ID_"";2.312"",ACT,,.VPRSQ)"
^XMB(3.9,146056,2,1655,0)="""RTN"",""VPREVNT"",201,0)"
^XMB(3.9,146056,2,1656,0)=" I ACT=""@"",$G(VPRSQ) D  ;save old values for delete msg"
^XMB(3.9,146056,2,1657,0)="""RTN"",""VPREVNT"",202,0)"
^XMB(3.9,146056,2,1658,0)=" . S ^XTMP(""VPR-""_VPRSQ,ID)=DFN_""^MemberEnrollment^""_ID_"";2.312^D^"""
^XMB(3.9,146056,2,1659,0)="""RTN"",""VPREVNT"",203,0)"
^XMB(3.9,146056,2,1660,0)=" . F I=0,1,2,3,7 S ^XTMP(""VPR-""_VPRSQ,ID,I)=$G(@(""IBEVTP""_I))"
^XMB(3.9,146056,2,1661,0)="""RTN"",""VPREVNT"",204,0)"
^XMB(3.9,146056,2,1662,0)=" . S ^XTMP(""VPR-""_VPRSQ,0)=$$FMADD^XLFDT(DT,14)_U_DT_""^Deleted record for AVPR"""
^XMB(3.9,146056,2,1663,0)="""RTN"",""VPREVNT"",205,0)"
^XMB(3.9,146056,2,1664,0)=" I ($G(IBEVTACT)=""EDT"")&(ACT=""@"") D  ;task edit to ensure delete happens first"
^XMB(3.9,146056,2,1665,0)="""RTN"",""VPREVNT"",206,0)"
^XMB(3.9,146056,2,1666,0)=" . N ZTRTN,ZTDTH,ZTDESC,ZTIO,ZTSAVE,ZTUCI,ZTCPU,ZTPRI,ZTKIL,ZTSYNC,ZTSK"
^XMB(3.9,146056,2,1667,0)="""RTN"",""VPREVNT"",207,0)"
^XMB(3.9,146056,2,1668,0)=" . S ZTRTN=""IBTASK^VPREVNT"",ZTDESC=""VPR Insurance Update"",ZTIO="""""
^XMB(3.9,146056,2,1669,0)="""RTN"",""VPREVNT"",208,0)"
^XMB(3.9,146056,2,1670,0)=" . S ZTDTH=$$FMADD^XLFDT($$NOW^XLFDT,,,2),ZTSAVE(""DFN"")="""",ZTSAVE(""ID"")="""""
^XMB(3.9,146056,2,1671,0)="""RTN"",""VPREVNT"",209,0)"
^XMB(3.9,146056,2,1672,0)=" . D ^%ZTLOAD"
^XMB(3.9,146056,2,1673,0)="""RTN"",""VPREVNT"",210,0)"
^XMB(3.9,146056,2,1674,0)=" Q"
^XMB(3.9,146056,2,1675,0)="""RTN"",""VPREVNT"",211,0)"
^XMB(3.9,146056,2,1676,0)="IBDIFF() ; -- return 1 or 0, if key matching values changed"
^XMB(3.9,146056,2,1677,0)="""RTN"",""VPREVNT"",212,0)"
^XMB(3.9,146056,2,1678,0)=" I +$G(IBEVTP0)'=+$G(IBEVTA0) Q 1"
^XMB(3.9,146056,2,1679,0)="""RTN"",""VPREVNT"",213,0)"
^XMB(3.9,146056,2,1680,0)=" I $P($G(IBEVTP0),U,18)'=$P($G(IBEVTA0),U,18) Q 1"
^XMB(3.9,146056,2,1681,0)="""RTN"",""VPREVNT"",214,0)"
^XMB(3.9,146056,2,1682,0)=" I $P($G(IBEVTP7),U,2)'=$P($G(IBEVTA7),U,2) Q 1"
^XMB(3.9,146056,2,1683,0)="""RTN"",""VPREVNT"",215,0)"
^XMB(3.9,146056,2,1684,0)=" Q 0"
