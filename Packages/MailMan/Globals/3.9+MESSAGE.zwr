^XMB(3.9,146091,2,442,0)=" Q"
^XMB(3.9,146091,2,443,0)="""RTN"",""MAGQBUT4"",97,0)"
^XMB(3.9,146091,2,444,0)="FDASET(DDRROOT,DDRFDA) ;"
^XMB(3.9,146091,2,445,0)="""RTN"",""MAGQBUT4"",98,0)"
^XMB(3.9,146091,2,446,0)=" N DDRFILE,DDRIEN,DDRFIELD,DDRVAL,DDRERR,I"
^XMB(3.9,146091,2,447,0)="""RTN"",""MAGQBUT4"",99,0)"
^XMB(3.9,146091,2,448,0)=" S I=0"
^XMB(3.9,146091,2,449,0)="""RTN"",""MAGQBUT4"",100,0)"
^XMB(3.9,146091,2,450,0)=" F  S I=$O(DDRROOT(I)) Q:'I  S X=DDRROOT(I) D"
^XMB(3.9,146091,2,451,0)="""RTN"",""MAGQBUT4"",101,0)"
^XMB(3.9,146091,2,452,0)=" . S DDRFILE=$P(X,U)"
^XMB(3.9,146091,2,453,0)="""RTN"",""MAGQBUT4"",102,0)"
^XMB(3.9,146091,2,454,0)=" . S DDRFIELD=$P(X,U,2)"
^XMB(3.9,146091,2,455,0)="""RTN"",""MAGQBUT4"",103,0)"
^XMB(3.9,146091,2,456,0)=" . S DDRIEN=$P(X,U,3)"
^XMB(3.9,146091,2,457,0)="""RTN"",""MAGQBUT4"",104,0)"
^XMB(3.9,146091,2,458,0)=" . S DDRVAL=$P(X,U,4,99)"
^XMB(3.9,146091,2,459,0)="""RTN"",""MAGQBUT4"",105,0)"
^XMB(3.9,146091,2,460,0)=" . D FDA^DILF(DDRFILE,DDRIEN_$S($E(DDRIEN,$L(DDRIEN))'="","":"","",1:""""),DDRFIELD,"""",DDRVAL,""DDRFDA"",""DDRERR"")"
^XMB(3.9,146091,2,461,0)="""RTN"",""MAGQBUT4"",106,0)"
^XMB(3.9,146091,2,462,0)=" Q"
^XMB(3.9,146091,2,463,0)="""RTN"",""MAGQBUT4"",107,0)"
^XMB(3.9,146091,2,464,0)="DHRPC(RESULTS,FNAME,FLOC) ;[MAG DIRHASH]"
