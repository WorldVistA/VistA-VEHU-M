^XMB(3.9,146047,2,1024,0)=" I $D(IBDATA)>9 D"
^XMB(3.9,146047,2,1025,0)="""RTN"",""IBCNBCD2"",324,0)"
^XMB(3.9,146047,2,1026,0)=" . S IBI="""""
^XMB(3.9,146047,2,1027,0)="""RTN"",""IBCNBCD2"",325,0)"
^XMB(3.9,146047,2,1028,0)=" . F  S IBI=$O(@IBDATA@(IBI)) Q:IBI']""""  S IBIEN=$G(@IBDATA@(IBI)) L -@IBSYS@(IBIEN)"
^XMB(3.9,146047,2,1029,0)="""RTN"",""IBCNBCD2"",326,0)"
