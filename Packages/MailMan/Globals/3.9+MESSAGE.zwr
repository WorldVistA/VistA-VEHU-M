^XMB(3.9,146106,2,3043,0)="""RTN"",""SDES2DELCLNREADT"",47,0)"
^XMB(3.9,146106,2,3044,0)="VALSDPARAM(ERRORS,SDPARAM) ; Check if we are doing a delete inactivation date"
^XMB(3.9,146106,2,3045,0)="""RTN"",""SDES2DELCLNREADT"",48,0)"
^XMB(3.9,146106,2,3046,0)=" N SDCLINICIEN,SDINACTIVE,SDINACTIVEDT,SDREACTIVEDT,SDRESOURCEIEN,SDRESREACTEDT,SDRESINACTEDT"
^XMB(3.9,146106,2,3047,0)="""RTN"",""SDES2DELCLNREADT"",49,0)"
^XMB(3.9,146106,2,3048,0)=" ; Clinic IEN checks"
^XMB(3.9,146106,2,3049,0)="""RTN"",""SDES2DELCLNREADT"",50,0)"
^XMB(3.9,146106,2,3050,0)=" S SDCLINICIEN=$G(SDPARAM(""CLINIC IEN""))"
^XMB(3.9,146106,2,3051,0)="""RTN"",""SDES2DELCLNREADT"",51,0)"
^XMB(3.9,146106,2,3052,0)=" I SDCLINICIEN="""" D ERRLOG^SDESJSON(.ERRORS,18) Q  ; Missing Clinic ID"
^XMB(3.9,146106,2,3053,0)="""RTN"",""SDES2DELCLNREADT"",52,0)"
^XMB(3.9,146106,2,3054,0)=" I SDCLINICIEN'="""",'$D(^SC(SDCLINICIEN,0)) D ERRLOG^SDESJSON(.ERRORS,19) Q  ; Invalid Clinic ID"
^XMB(3.9,146106,2,3055,0)="""RTN"",""SDES2DELCLNREADT"",53,0)"
^XMB(3.9,146106,2,3056,0)=" ; Clinic Reactivate Date checks"
^XMB(3.9,146106,2,3057,0)="""RTN"",""SDES2DELCLNREADT"",54,0)"
^XMB(3.9,146106,2,3058,0)=" S SDINACTIVEDT=$$GET1^DIQ(44,SDCLINICIEN,2505,""I"") ;inactive date/time"
^XMB(3.9,146106,2,3059,0)="""RTN"",""SDES2DELCLNREADT"",55,0)"
^XMB(3.9,146106,2,3060,0)=" S SDREACTIVEDT=$$GET1^DIQ(44,SDCLINICIEN,2506,""I"") ;reactive date/time"
^XMB(3.9,146106,2,3061,0)="""RTN"",""SDES2DELCLNREADT"",56,0)"
^XMB(3.9,146106,2,3062,0)=" I SDREACTIVEDT="""" D ERRLOG^SDESJSON(.ERRORS,659) Q"
^XMB(3.9,146106,2,3063,0)="""RTN"",""SDES2DELCLNREADT"",57,0)"
^XMB(3.9,146106,2,3064,0)=" I SDREACTIVEDT<=DT D ERRLOG^SDESJSON(.ERRORS,660) Q"
^XMB(3.9,146106,2,3065,0)="""RTN"",""SDES2DELCLNREADT"",58,0)"
^XMB(3.9,146106,2,3066,0)=" ; Inactive Clinic checks"
^XMB(3.9,146106,2,3067,0)="""RTN"",""SDES2DELCLNREADT"",59,0)"
