^XMB(3.9,146107,2,378,0)=" ;"
^XMB(3.9,146107,2,379,0)="""RTN"",""PSJORUT2"",70,0)"
^XMB(3.9,146107,2,380,0)="ENREF(PRX) ; Return number of refills remaining."
^XMB(3.9,146107,2,381,0)="""RTN"",""PSJORUT2"",71,0)"
^XMB(3.9,146107,2,382,0)=" ;Input: PRX - Internal prescription number from File #52."
^XMB(3.9,146107,2,383,0)="""RTN"",""PSJORUT2"",72,0)"
^XMB(3.9,146107,2,384,0)=" ;Output: Number of refills remaining."
^XMB(3.9,146107,2,385,0)="""RTN"",""PSJORUT2"",73,0)"
^XMB(3.9,146107,2,386,0)=" ;"
^XMB(3.9,146107,2,387,0)="""RTN"",""PSJORUT2"",74,0)"
^XMB(3.9,146107,2,388,0)=" N X,COUNT,CNT S PRX=$P(PRX,""^""),COUNT=0,X=$P(^PSRX(PRX,0),""^"",9)"
^XMB(3.9,146107,2,389,0)="""RTN"",""PSJORUT2"",75,0)"
^XMB(3.9,146107,2,390,0)=" D:$O(^PSRX(PRX,1,0))"
^XMB(3.9,146107,2,391,0)="""RTN"",""PSJORUT2"",76,0)"
^XMB(3.9,146107,2,392,0)=" .F CNT=0:0 S CNT=$O(^PSRX(PRX,1,CNT)) Q:'CNT  S COUNT=COUNT+1"
^XMB(3.9,146107,2,393,0)="""RTN"",""PSJORUT2"",77,0)"
^XMB(3.9,146107,2,394,0)=" S:$G(COUNT) X=X-COUNT"
^XMB(3.9,146107,2,395,0)="""RTN"",""PSJORUT2"",78,0)"
^XMB(3.9,146107,2,396,0)=" Q X"
^XMB(3.9,146107,2,397,0)="""RTN"",""PSJORUT2"",79,0)"
^XMB(3.9,146107,2,398,0)=" ;"
^XMB(3.9,146107,2,399,0)="""RTN"",""PSJORUT2"",80,0)"
^XMB(3.9,146107,2,400,0)="ENCHK(DFN,PSJINX)     ; Return dispense drug check array."
^XMB(3.9,146107,2,401,0)="""RTN"",""PSJORUT2"",81,0)"
^XMB(3.9,146107,2,402,0)=" ;Input: DFN      - Patient internal entry number"
^XMB(3.9,146107,2,403,0)="""RTN"",""PSJORUT2"",82,0)"
^XMB(3.9,146107,2,404,0)=" ;       PSJINX   - Index number so duplicate drugs will be returned."
^XMB(3.9,146107,2,405,0)="""RTN"",""PSJORUT2"",83,0)"
^XMB(3.9,146107,2,406,0)=" ;       PSGOCHK  - Check should include dispense drugs in 53.45"
^XMB(3.9,146107,2,407,0)="""RTN"",""PSJORUT2"",84,0)"
^XMB(3.9,146107,2,408,0)=" ;       PSIVOCHK - Check should include entries in DRG array"
^XMB(3.9,146107,2,409,0)="""RTN"",""PSJORUT2"",85,0)"
^XMB(3.9,146107,2,410,0)=" ;Output: ^TMP($J,""ORDERS"",PSJINX)=DRUG CLASS^NATIONAL DRUG FILE ENTRY"
^XMB(3.9,146107,2,411,0)="""RTN"",""PSJORUT2"",86,0)"
^XMB(3.9,146107,2,412,0)=" ;        _""A""_PSNDFA PRODUCT NAME ENTRY_DISPENSE DRUG NAME^OE/RR #"
^XMB(3.9,146107,2,413,0)="""RTN"",""PSJORUT2"",87,0)"
^XMB(3.9,146107,2,414,0)=" ;        _ORDER NUMBER(P/I/V)_"";I"""
^XMB(3.9,146107,2,415,0)="""RTN"",""PSJORUT2"",88,0)"
^XMB(3.9,146107,2,416,0)=" ;"
^XMB(3.9,146107,2,417,0)="""RTN"",""PSJORUT2"",89,0)"
^XMB(3.9,146107,2,418,0)=" NEW BDT,DDRUG,DDRUG0,DDRUGND,EDT,F,ON,ON1,PST,WBDT,X,PSJORIEN"
^XMB(3.9,146107,2,419,0)="""RTN"",""PSJORUT2"",90,0)"
^XMB(3.9,146107,2,420,0)=" D NOW^%DTC S (BDT,WBDT)=%,EDT=9999999"
^XMB(3.9,146107,2,421,0)="""RTN"",""PSJORUT2"",91,0)"
^XMB(3.9,146107,2,422,0)=" S F=""^PS(55,DFN,5,"" F  S WBDT=$O(^PS(55,DFN,5,""AUS"",WBDT)) Q:'WBDT  F ON=0:0 S ON=$O(^PS(55,DFN,5,""AUS"",WBDT,ON)) Q:'ON  D UD"
^XMB(3.9,146107,2,423,0)="""RTN"",""PSJORUT2"",92,0)"
^XMB(3.9,146107,2,424,0)=" S F=""^PS(53.1,"" F PST=""P"",""N"" F ON=0:0 S ON=$O(^PS(53.1,""AS"",PST,DFN,ON)) Q:'ON  D"
^XMB(3.9,146107,2,425,0)="""RTN"",""PSJORUT2"",93,0)"
^XMB(3.9,146107,2,426,0)=" . I $O(^PS(53.1,+ON,""AD"",0))!$O(^PS(53.1,+ON,""SOL"",0)) D PIV Q"
^XMB(3.9,146107,2,427,0)="""RTN"",""PSJORUT2"",94,0)"
^XMB(3.9,146107,2,428,0)=" . D UD"
^XMB(3.9,146107,2,429,0)="""RTN"",""PSJORUT2"",95,0)"
^XMB(3.9,146107,2,430,0)=" S WBDT=BDT F  S WBDT=$O(^PS(55,DFN,""IV"",""AIS"",WBDT)) Q:'WBDT  F ON=0:0 S ON=$O(^PS(55,DFN,""IV"",""AIS"",WBDT,ON)) Q:'ON  D IV"
^XMB(3.9,146107,2,431,0)="""RTN"",""PSJORUT2"",96,0)"
^XMB(3.9,146107,2,432,0)=" I '$G(PSIVOCON) D NEWIV ; Don't do this when Finishing orders (FN)"
^XMB(3.9,146107,2,433,0)="""RTN"",""PSJORUT2"",97,0)"
^XMB(3.9,146107,2,434,0)=" Q"
^XMB(3.9,146107,2,435,0)="""RTN"",""PSJORUT2"",98,0)"
^XMB(3.9,146107,2,436,0)="UD ;*** Get the dispense drugs for the Unit Dose orders."
^XMB(3.9,146107,2,437,0)="""RTN"",""PSJORUT2"",99,0)"
^XMB(3.9,146107,2,438,0)=" S PSJORIEN=$P(@(F_ON_"",0)""),U,21),DDRUG=0"
^XMB(3.9,146107,2,439,0)="""RTN"",""PSJORUT2"",100,0)"
^XMB(3.9,146107,2,440,0)=" I F=""^PS(53.1,"",($P(@(F_ON_"",0)""),U,4)=""I"") D  Q"
^XMB(3.9,146107,2,441,0)="""RTN"",""PSJORUT2"",101,0)"
^XMB(3.9,146107,2,442,0)=" . NEW PSJPD S COD=ON_""P"""
^XMB(3.9,146107,2,443,0)="""RTN"",""PSJORUT2"",102,0)"
^XMB(3.9,146107,2,444,0)=" . S PSJPD=+$G(^PS(53.1,ON,.2)) D:$D(^PS(52.6,""AOI"",PSJPD)) ENDDIV^PSJORUTL(PSJPD,""A"","""",.DDRUG) S DDRUG=+DDRUG D:DDRUG DDRUG"
^XMB(3.9,146107,2,445,0)="""RTN"",""PSJORUT2"",103,0)"
^XMB(3.9,146107,2,446,0)=" S ON1=0 F  S ON1=$O(@(F_ON_"",1,""_ON1_"")"")) Q:'ON1  S DDRUG=@(F_ON_"",1,""_ON1_"",0)"") I $P(DDRUG,U,3)=""""!($P(DDRUG,U,3)>BDT) S COD=ON_$S(F[""^PS(53.1"":""P"",1:""U"") D DDRUG"
^XMB(3.9,146107,2,447,0)="""RTN"",""PSJORUT2"",104,0)"
^XMB(3.9,146107,2,448,0)=" I $D(PSGOCHK) F ON1=0:0 S ON1=$O(^PS(53.45,+PSJSYSP,1,ON1)) Q:'ON1  S DDRUG=$G(^PS(53.45,+PSJSYSP,1,ON1,0)) I $P(DDRUG,U,3)=""""!@($P(DDRUG,U,3)>BDT) S (COD,PSJORIEN)="""" D DDRUG"
^XMB(3.9,146107,2,449,0)="""RTN"",""PSJORUT2"",105,0)"
^XMB(3.9,146107,2,450,0)=" I '$O(@(F_ON_"",1,""_0_"")"")) N OI S OI=+$G(@(F_ON_"",.2)"")) I OI D"
^XMB(3.9,146107,2,451,0)="""RTN"",""PSJORUT2"",106,0)"
^XMB(3.9,146107,2,452,0)=" .S DDRUG="""" F  S DDRUG=$O(^PSDRUG(""ASP"",OI,DDRUG)) Q:'DDRUG  D"
^XMB(3.9,146107,2,453,0)="""RTN"",""PSJORUT2"",107,0)"
^XMB(3.9,146107,2,454,0)=" ..I ($P(DDRUG,U,3)=""""!($P(DDRUG,U,3)>BDT)) S COD=ON_$S(F[""^PS(53.1"":""P"",1:""U"") D DDRUG"
^XMB(3.9,146107,2,455,0)="""RTN"",""PSJORUT2"",108,0)"
^XMB(3.9,146107,2,456,0)=" Q"
^XMB(3.9,146107,2,457,0)="""RTN"",""PSJORUT2"",109,0)"
^XMB(3.9,146107,2,458,0)="PIV ;*** Get the dispense drugs for the Pending IV orders."
^XMB(3.9,146107,2,459,0)="""RTN"",""PSJORUT2"",110,0)"
^XMB(3.9,146107,2,460,0)=" S X=^PS(53.1,+ON,0),PSJORIEN=$P(X,U,21) Q:$P(X,U,27)=""R"""
^XMB(3.9,146107,2,461,0)="""RTN"",""PSJORUT2"",111,0)"
^XMB(3.9,146107,2,462,0)=" S ON1=0 F  S ON1=$O(^PS(53.1,+ON,""AD"",ON1)) Q:'ON1  S X=+^PS(53.1,+ON,""AD"",ON1,0),DDRUG=$P($G(^PS(52.6,X,0)),U,2) S COD=+ON_""P"" D DDRUG"
^XMB(3.9,146107,2,463,0)="""RTN"",""PSJORUT2"",112,0)"
^XMB(3.9,146107,2,464,0)=" S ON1=0 F  S ON1=$O(^PS(53.1,+ON,""SOL"",ON1)) Q:'ON1  S X=+^PS(53.1,+ON,""SOL"",ON1,0),DDRUG=$P($G(^PS(52.7,X,0)),U,2) S COD=+ON_""P"" D DDRUG"
^XMB(3.9,146107,2,465,0)="""RTN"",""PSJORUT2"",113,0)"
^XMB(3.9,146107,2,466,0)=" Q"
^XMB(3.9,146107,2,467,0)="""RTN"",""PSJORUT2"",114,0)"
^XMB(3.9,146107,2,468,0)="IV ;*** Get the dispense drugs for the IV orders."
^XMB(3.9,146107,2,469,0)="""RTN"",""PSJORUT2"",115,0)"
^XMB(3.9,146107,2,470,0)=" NEW X S X=^PS(55,DFN,""IV"",ON,0),PSJORIEN=$P(X,U,21) Q:$P(X,U,17)=""R"""
^XMB(3.9,146107,2,471,0)="""RTN"",""PSJORUT2"",116,0)"
^XMB(3.9,146107,2,472,0)=" S ON1=0 F  S ON1=$O(^PS(55,DFN,""IV"",ON,""AD"",ON1)) Q:'ON1  S X=+^PS(55,DFN,""IV"",ON,""AD"",ON1,0),DDRUG=$P($G(^PS(52.6,X,0)),U,2) S COD=ON_""V"" D DDRUG"
^XMB(3.9,146107,2,473,0)="""RTN"",""PSJORUT2"",117,0)"
^XMB(3.9,146107,2,474,0)=" S ON1=0 F  S ON1=$O(^PS(55,DFN,""IV"",ON,""SOL"",ON1)) Q:'ON1  S X=+^PS(55,DFN,""IV"",ON,""SOL"",ON1,0),DDRUG=$P($G(^PS(52.7,X,0)),U,2) S COD=ON_""V"" D DDRUG"
^XMB(3.9,146107,2,475,0)="""RTN"",""PSJORUT2"",118,0)"
^XMB(3.9,146107,2,476,0)=" Q"
^XMB(3.9,146107,2,477,0)="""RTN"",""PSJORUT2"",119,0)"
^XMB(3.9,146107,2,478,0)="NEWIV ;*** Get the dispense drugs for the newly entered IV order."
