^XMB(3.9,146036,2,2060,0)=" ;Made changes for CAPRI-11238.  JD - 6/17/24"
^XMB(3.9,146036,2,2061,0)="""RTN"",""DVBCTXML"",8,0)"
^XMB(3.9,146036,2,2062,0)="FAILIST(DVBFAIL,DVBDUZ) ; RPC entry to return list of failed xml transmissions"
^XMB(3.9,146036,2,2063,0)="""RTN"",""DVBCTXML"",9,0)"
^XMB(3.9,146036,2,2064,0)=" ;RPC: DVBA CAPRI DBQ TRANS FAIL LIST"
^XMB(3.9,146036,2,2065,0)="""RTN"",""DVBCTXML"",10,0)"
^XMB(3.9,146036,2,2066,0)=" ;Added DVBWOI and DVBWON to the list for CAPRI-11238."
^XMB(3.9,146036,2,2067,0)="""RTN"",""DVBCTXML"",11,0)"
^XMB(3.9,146036,2,2068,0)=" N DVBNCT,DVBAUTH,DVBALL,DVBLIST,DVBSTA,DVBNAME,DVBORG,DVBNOW,DVBCOMP,DVBEXIEN"
^XMB(3.9,146036,2,2069,0)="""RTN"",""DVBCTXML"",12,0)"
^XMB(3.9,146036,2,2070,0)=" N DVBPT,DVBIEN,DVBCT,DVBFLAG,DVBDATE,DVBPATCH,DVBWOI,DVBWON,DVBCMT,DVBCTFLAG"
^XMB(3.9,146036,2,2071,0)="""RTN"",""DVBCTXML"",13,0)"
^XMB(3.9,146036,2,2072,0)=" K ^TMP(""CAPRI XML LIST"",$J) S DVBNCT="""""
^XMB(3.9,146036,2,2073,0)="""RTN"",""DVBCTXML"",14,0)"
^XMB(3.9,146036,2,2074,0)=" S DVBALL=1 I '$D(DVBDUZ) S DVBALL=0"
^XMB(3.9,146036,2,2075,0)="""RTN"",""DVBCTXML"",15,0)"
^XMB(3.9,146036,2,2076,0)=" ;CAPRI-22082 CP 9/17/25"
^XMB(3.9,146036,2,2077,0)="""RTN"",""DVBCTXML"",16,0)"
^XMB(3.9,146036,2,2078,0)=" S DVBPATCH=3250901,DVBIEN="""""
^XMB(3.9,146036,2,2079,0)="""RTN"",""DVBCTXML"",17,0)"
^XMB(3.9,146036,2,2080,0)=" S DVBDATE=DVBPATCH F  S DVBDATE=$O(^DVB(396.17,""C"",DVBDATE)) Q:DVBDATE=""""  D"
^XMB(3.9,146036,2,2081,0)="""RTN"",""DVBCTXML"",18,0)"
^XMB(3.9,146036,2,2082,0)=" .S DVBIEN="""" F  S DVBIEN=$O(^DVB(396.17,""C"",DVBDATE,DVBIEN)) Q:DVBIEN=""""  D"
^XMB(3.9,146036,2,2083,0)="""RTN"",""DVBCTXML"",19,0)"
^XMB(3.9,146036,2,2084,0)=" ..I '$D(^DVB(396.17,DVBIEN,14,""B"")) Q"
^XMB(3.9,146036,2,2085,0)="""RTN"",""DVBCTXML"",20,0)"
^XMB(3.9,146036,2,2086,0)=" ..;Add CMT toggle parameter check CAPRI-10630 RJA 06/26/24"
^XMB(3.9,146036,2,2087,0)="""RTN"",""DVBCTXML"",21,0)"
^XMB(3.9,146036,2,2088,0)=" ..S DVBCMT=0 D TOGGLE^DVBUTIL(.DVBCMT)"
^XMB(3.9,146036,2,2089,0)="""RTN"",""DVBCTXML"",22,0)"
^XMB(3.9,146036,2,2090,0)=" ..S DVBCTFLAG=0 D PASCALCHK^DVBCTPDF(.DVBCTFLAG,DVBIEN)"
^XMB(3.9,146036,2,2091,0)="""RTN"",""DVBCTXML"",23,0)"
^XMB(3.9,146036,2,2092,0)=" ..Q:DVBCMT=1&(DVBCTFLAG=""P"")!(DVBCMT=2&(DVBCTFLAG=""C""))"
^XMB(3.9,146036,2,2093,0)="""RTN"",""DVBCTXML"",24,0)"
^XMB(3.9,146036,2,2094,0)=" ..;Next 2 lines added for CAPRI-11238."
^XMB(3.9,146036,2,2095,0)="""RTN"",""DVBCTXML"",25,0)"
^XMB(3.9,146036,2,2096,0)=" ..S DVBWOI=$$GET1^DIQ(396.17,DVBIEN,""13"",""I"")  ;Worksheet originator IEN"
^XMB(3.9,146036,2,2097,0)="""RTN"",""DVBCTXML"",26,0)"
^XMB(3.9,146036,2,2098,0)=" ..S DVBWON=$$GET1^DIQ(396.17,DVBIEN,""13"",""E"")  ;Worksheet originator name"
^XMB(3.9,146036,2,2099,0)="""RTN"",""DVBCTXML"",27,0)"
^XMB(3.9,146036,2,2100,0)=" ..;Added the Worksheet Originator IEN (DVBWOI) check for CAPRI-11238."
^XMB(3.9,146036,2,2101,0)="""RTN"",""DVBCTXML"",28,0)"
^XMB(3.9,146036,2,2102,0)=" ..S DVBAUTH=$$GET1^DIQ(396.17,DVBIEN,""2"",""I"") I (DVBALL=1),($G(DVBDUZ)'=DVBAUTH),($G(DVBDUZ)'=DVBWOI) Q"
^XMB(3.9,146036,2,2103,0)="""RTN"",""DVBCTXML"",29,0)"
^XMB(3.9,146036,2,2104,0)=" ..S DVBPT=$$GET1^DIQ(396.17,DVBIEN,"".01"",""E"")"
