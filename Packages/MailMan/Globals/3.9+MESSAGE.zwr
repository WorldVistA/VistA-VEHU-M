^XMB(3.9,146056,2,1381,0)="""RTN"",""VPREVNT"",64,0)"
^XMB(3.9,146056,2,1382,0)=" ;"
^XMB(3.9,146056,2,1383,0)="""RTN"",""VPREVNT"",65,0)"
^XMB(3.9,146056,2,1384,0)="DGPM ; -- DGPM MOVEMENT EVENTS protocol listener"
^XMB(3.9,146056,2,1385,0)="""RTN"",""VPREVNT"",66,0)"
^XMB(3.9,146056,2,1386,0)=" ;    [expects DFN,DGPM* variables]"
^XMB(3.9,146056,2,1387,0)="""RTN"",""VPREVNT"",67,0)"
^XMB(3.9,146056,2,1388,0)=" I $$NEWINPT,$$ON^VPRHS,'$$SUBS^VPRHS(DFN),$$VALID^VPRHS(DFN) D NEW^VPRHS(DFN) Q"
^XMB(3.9,146056,2,1389,0)="""RTN"",""VPREVNT"",68,0)"
^XMB(3.9,146056,2,1390,0)=" N ADM,VST,ADMA,ADMP"
^XMB(3.9,146056,2,1391,0)="""RTN"",""VPREVNT"",69,0)"
^XMB(3.9,146056,2,1392,0)=" I DGPMT'=1 D  ;update related admission if not in ^UTILITY"
^XMB(3.9,146056,2,1393,0)="""RTN"",""VPREVNT"",70,0)"
^XMB(3.9,146056,2,1394,0)=" . S ADM=$S(DGPMA:+$P(DGPMA,U,14),1:+$P(DGPMP,U,14))"
^XMB(3.9,146056,2,1395,0)="""RTN"",""VPREVNT"",71,0)"
^XMB(3.9,146056,2,1396,0)=" . Q:$D(^UTILITY(""DGPM"",$J,1,ADM))"
^XMB(3.9,146056,2,1397,0)="""RTN"",""VPREVNT"",72,0)"
^XMB(3.9,146056,2,1398,0)=" . S VST=$$VNUM^VPRSDAV(ADM) Q:'VST"
^XMB(3.9,146056,2,1399,0)="""RTN"",""VPREVNT"",73,0)"
^XMB(3.9,146056,2,1400,0)=" . D POST^VPRHS(DFN,""Encounter"",ADM_""~""_VST_"";405"")"
^XMB(3.9,146056,2,1401,0)="""RTN"",""VPREVNT"",74,0)"
^XMB(3.9,146056,2,1402,0)=" ; process all updated admissions"
^XMB(3.9,146056,2,1403,0)="""RTN"",""VPREVNT"",75,0)"
^XMB(3.9,146056,2,1404,0)=" S ADM=0 F  S ADM=$O(^UTILITY(""DGPM"",$J,1,ADM)) Q:ADM<1  D"
^XMB(3.9,146056,2,1405,0)="""RTN"",""VPREVNT"",76,0)"
^XMB(3.9,146056,2,1406,0)=" . S ADMA=$G(^UTILITY(""DGPM"",$J,1,ADM,""A"")),ADMP=$G(^(""P""))"
^XMB(3.9,146056,2,1407,0)="""RTN"",""VPREVNT"",77,0)"
^XMB(3.9,146056,2,1408,0)=" . I ADMP,ADMA="""" D CKVST Q  ;deleted (still has Visit#)"
^XMB(3.9,146056,2,1409,0)="""RTN"",""VPREVNT"",78,0)"
^XMB(3.9,146056,2,1410,0)=" . S VST=$$VNUM^VPRSDAV(ADM) Q:'VST"
^XMB(3.9,146056,2,1411,0)="""RTN"",""VPREVNT"",79,0)"
^XMB(3.9,146056,2,1412,0)=" . D POST^VPRHS(DFN,""Encounter"",ADM_""~""_VST_"";405"")"
^XMB(3.9,146056,2,1413,0)="""RTN"",""VPREVNT"",80,0)"
^XMB(3.9,146056,2,1414,0)=" Q"
^XMB(3.9,146056,2,1415,0)="""RTN"",""VPREVNT"",81,0)"
^XMB(3.9,146056,2,1416,0)="CKVST ; -- delete visit if unused [from DGPM]"
^XMB(3.9,146056,2,1417,0)="""RTN"",""VPREVNT"",82,0)"
^XMB(3.9,146056,2,1418,0)=" N HLOC,VPRSQ"
^XMB(3.9,146056,2,1419,0)="""RTN"",""VPREVNT"",83,0)"
^XMB(3.9,146056,2,1420,0)=" S HLOC=+$G(^DIC(42,+$P(ADMP,U,6),44))"
^XMB(3.9,146056,2,1421,0)="""RTN"",""VPREVNT"",84,0)"
^XMB(3.9,146056,2,1422,0)=" S VST=$O(^AUPNVSIT(""AET"",DFN,+ADMP,HLOC,""P"",0)) Q:'VST"
^XMB(3.9,146056,2,1423,0)="""RTN"",""VPREVNT"",85,0)"
^XMB(3.9,146056,2,1424,0)=" Q:$P($G(^AUPNVSIT(VST,0)),U,9)>0  ;D POST^VPRHS(DFN,""Encounter"",VST_"";9000010"")"
^XMB(3.9,146056,2,1425,0)="""RTN"",""VPREVNT"",86,0)"
^XMB(3.9,146056,2,1426,0)=" ; save deleted encounter in ^XTMP - see DELALL^VPRENC"
