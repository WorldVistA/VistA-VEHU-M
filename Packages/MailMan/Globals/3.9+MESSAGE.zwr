^XMB(3.9,146101,2,705,0)="""RTN"",""PSSPGXPR"",24,0)"
^XMB(3.9,146101,2,706,0)=" ....S PSSPH9="""" F  S PSSPH9=$O(^TMP(""PSSPGXBS"",$J,PSSPH1,PSSPH7,""C"",PSSPH9)) Q:PSSPH9=""""  D"
^XMB(3.9,146101,2,707,0)="""RTN"",""PSSPGXPR"",25,0)"
^XMB(3.9,146101,2,708,0)=" .....Q:^TMP(""PSSPGXBS"",$J,PSSPH1,PSSPH7,""C"",PSSPH9)'=""pgxDrugChecks"""
^XMB(3.9,146101,2,709,0)="""RTN"",""PSSPGXPR"",26,0)"
^XMB(3.9,146101,2,710,0)=" .....S PSSPH3="""" F  S PSSPH3=$O(^TMP(""PSSPGXBS"",$J,PSSPH1,PSSPH9,""C"",PSSPH3)) Q:PSSPH3=""""  D"
^XMB(3.9,146101,2,711,0)="""RTN"",""PSSPGXPR"",27,0)"
^XMB(3.9,146101,2,712,0)=" ......Q:$G(^TMP(""PSSPGXBS"",$J,PSSPH1,PSSPH3))'=""pgxDrugCheck"""
^XMB(3.9,146101,2,713,0)="""RTN"",""PSSPGXPR"",28,0)"
^XMB(3.9,146101,2,714,0)=" ......S PSSPHQTT=$$COUNT Q:PSSPHQTT<0  S PSSPHQ=$P(PSSPHQTT,""^"",2),PSSSUB1=$P(PSSPHQTT,""^""),PSSGCTR=0,PSSGCTRV="""""
