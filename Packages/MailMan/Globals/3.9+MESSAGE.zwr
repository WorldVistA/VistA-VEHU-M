^XMB(3.9,146047,2,2955,0)="""RTN"",""IBCNEUT2"",275,0)"
^XMB(3.9,146047,2,2956,0)="ISMCARE(RIEN) ;check if response is from eIV Medicare Payer defined in file 350.9"
^XMB(3.9,146047,2,2957,0)="""RTN"",""IBCNEUT2"",276,0)"
