^XMB(3.9,146037,2,2794,0)=" D HEADER(RCNOW,.RCPG,RCHR,RCDT1,RCDT2,RCEXCEL,"""","""")  ; PRCA*4.5*380 - Added dep. number & date to hearder call"
^XMB(3.9,146037,2,2795,0)="""RTN"",""RCDPTAR1"",241,0)"
