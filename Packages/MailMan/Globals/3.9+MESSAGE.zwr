^XMB(3.9,146098,2,1472,0)=" ;S SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the calling application."
^XMB(3.9,146098,2,1473,0)="""RTN"",""SDES2DISPRECALL"",17,0)"
^XMB(3.9,146098,2,1474,0)=" ;S SDCONTEXT(""PATIENT DFN"") = The DFN/IEN of the target patient from the calling application."
^XMB(3.9,146098,2,1475,0)="""RTN"",""SDES2DISPRECALL"",18,0)"
^XMB(3.9,146098,2,1476,0)=" ;S SDCONTEXT(""PATIENT ICN"") = The ICN of the target patient from the calling application."
