^XMB(3.9,146102,2,473,0)="""QUES"",""XPM1"",0)"
^XMB(3.9,146102,2,474,0)="PO^VA(200,:EM"
^XMB(3.9,146102,2,475,0)="""QUES"",""XPM1"",""??"")"
^XMB(3.9,146102,2,476,0)="^D MG^XPDH"
^XMB(3.9,146102,2,477,0)="""QUES"",""XPM1"",""A"")"
^XMB(3.9,146102,2,478,0)="Enter the Coordinator for Mail Group '|FLAG|'"
