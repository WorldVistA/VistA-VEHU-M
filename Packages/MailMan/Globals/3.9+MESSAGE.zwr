^XMB(3.9,146036,2,2122,0)=" ...;;Update Reports to remove version on display CAPRI-9567 CP 5/14/24"
^XMB(3.9,146036,2,2123,0)="""RTN"",""DVBCTXML"",39,0)"
^XMB(3.9,146036,2,2124,0)=" ...I DVBNAME[""_"" S DVBNAME=$$NAMEUPD^DVBCTPD2(DVBNAME)"
^XMB(3.9,146036,2,2125,0)="""RTN"",""DVBCTXML"",40,0)"
^XMB(3.9,146036,2,2126,0)=" ...I DVBNAME?.N S DVBNAME=$$GET1^DIQ(396.1726,DVBINN,"".03"",""E"")"
^XMB(3.9,146036,2,2127,0)="""RTN"",""DVBCTXML"",41,0)"
^XMB(3.9,146036,2,2128,0)=" ...S DVBNOW=$$NOW^XLFDT S DVBDT=$$FMDIFF^XLFDT(DVBNOW,DVBORG,3)"
