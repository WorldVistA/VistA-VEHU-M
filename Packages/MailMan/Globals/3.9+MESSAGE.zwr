^XMB(3.9,146047,2,1041,0)="""RTN"",""IBCNBCD2"",332,0)"
^XMB(3.9,146047,2,1042,0)=" Q"
^XMB(3.9,146047,2,1043,0)="""RTN"",""IBCNBCD2"",333,0)"
^XMB(3.9,146047,2,1044,0)=" ;"
^XMB(3.9,146047,2,1045,0)="""RTN"",""IBCNBCD2"",334,0)"
^XMB(3.9,146047,2,1046,0)="CVASK() ; Prompt to ask user to Save Changes"
^XMB(3.9,146047,2,1047,0)="""RTN"",""IBCNBCD2"",335,0)"
^XMB(3.9,146047,2,1048,0)=" Q $E($$READ^IBCNBAA(""YA^::E"",""Save Changes to Coverage Limitations File Y/N? "",""No"",""Enter Yes or No to Save the Changes to the CV File <or> ^ to Quit""))"
^XMB(3.9,146047,2,1049,0)="""RTN"",""IBCNBCD2"",336,0)"
